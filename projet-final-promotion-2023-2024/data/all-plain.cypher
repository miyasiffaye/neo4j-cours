UNWIND [{tmdbId:"12657", properties:{bornIn:"Stoke Newington, London, UK", imdbId:"0550577", born:date('1934-07-01'), name:"Jean Marsh", bio:"Born in London, Jean Marsh became interested in show business while taking dancing and mime classes as therapy for a childhood illness.  After attending a charm school and working as a model, she started acting in repertory and took voice lessons.  Her repertory work was supplemented by a number of film appearances as a dancer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x4ZPhTWCn0BTLiTz2YnXUSRJJxT.jpg", url:"https://themoviedb.org/person/12657"}}, {tmdbId:"25578", properties:{bornIn:"East Los Angeles, California, USA", imdbId:"0346186", born:date('1949-02-24'), name:"Evelyn Guerrero", bio:"From Wikipedia, the free encyclopedia. \n\nEvelyn Guerrero (born February 24, 1949 in East Los Angeles, California, U. S. ) is an American actress.  She was married to actor Pat Morita. \n\nDescription above from the Wikipedia article Evelyn Guerrero, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/25578"}}, {tmdbId:"86399", properties:{imdbId:"0447926", name:"Betty Kennedy", url:"https://themoviedb.org/person/86399"}}, {tmdbId:"76136", properties:{bornIn:"Marvell, Arkansas, United States", imdbId:"0375629", born:date('1940-05-26'), name:"Levon Helm", bio:"From Wikipedia, the free encyclopedia. \n\nMark Lavon \"Levon\" Helm (born May 26, 1940), is an American rock multi-instrumentalist and actor who achieved fame as the drummer and frequent lead and backing vocalist for The Band.  Helm is known for his deeply soulful, country-accented voice, and creative drumming style highlighted on many of The Band's recordings, such as \"The Weight\", \"Up on Cripple Creek\", \"Ophelia\" and \"The Night They Drove Old Dixie Down\"...", died:date('2012-04-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qKefyS0QZaGufJwSzdw3u5I9bct.jpg", url:"https://themoviedb.org/person/76136"}}, {tmdbId:"97787", properties:{imdbId:"0101992", name:"Phyllis Boyens", url:"https://themoviedb.org/person/97787"}}, {tmdbId:"31186", properties:{bornIn:"New York City, New York, USA", imdbId:"0185210", born:date('1948-05-06'), name:"Richard Cox", url:"https://themoviedb.org/person/31186"}}, {tmdbId:"18778", properties:{bornIn:"Paris, France", imdbId:"0688497", born:date('1926-08-17'), name:"Jean Poiret", bio:"From Wikipedia, the free encyclopedia\n\nJean Poiret, born Jean Poiré, (17 August 1926 – 14 March 1992) was a French actor, director, and screenwriter.  He is primarily known as the author of the original play La Cage Aux Folles.  Jean Poiret was born in Paris, France, where he died of a heart attack in 1992.  He is buried at the Cimetière du Montparnasse in Paris. \n\nDescription above from the Wikipedia article Jean Poiret, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1992-03-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4QiinOcwo4WUrH9nPDf6lDE9H0E.jpg", url:"https://themoviedb.org/person/18778"}}, {tmdbId:"10262", properties:{bornIn:"Aix-en-Provence, France", imdbId:"0275138", born:date('1947-01-06'), name:"Andréa Ferréol", bio:"Andréa Ferréol is a French stage, film and television actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l2JBvxmFHXAMXsSxK7x18LVykOe.jpg", url:"https://themoviedb.org/person/10262"}}, {tmdbId:"146714", properties:{imdbId:"0587608", born:date('1929-12-23'), name:"Hugh Millais", died:date('2009-07-04'), url:"https://themoviedb.org/person/146714"}}, {tmdbId:"44038", properties:{bornIn:"New York City, New York, USA", imdbId:"0000262", born:date('1950-06-24'), name:"Nancy Allen", bio:"Nancy Anne Allen is a Golden Globe nominated American actress and cancer activist. \n\nAllen began an acting and modelling career as a child, and from the mid-1970s appeared in small film roles, most notably the anchor of Robert Zemeckis's ensemble comedy I Wanna Hold Your Hand (1978).  A pivotal supporting role in Carrie (1976) brought her recognition, and after marrying the director Brian De Palma, she appeared in several of his films, including Dressed to Kill (1980) and Blow Out (1981)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d8lcXUCuQmOeGJwNakAiafGi2c1.jpg", url:"https://themoviedb.org/person/44038"}}, {tmdbId:"32384", properties:{bornIn:"Philadelphia, Pennsylvania, USA ", imdbId:"0058532", born:date('1931-09-29'), name:"Eddie Barth", bio:"Eddie Barth was born on September 29, 1931 in Philadelphia, Pennsylvania, USA as Edward Bartholetti.  He was an actor, known for Fame (1980), Babe: Pig in the City (1998) and Bananas (1971).  He was married to Sally Hada.  He died on May 28, 2010 in Los Angeles, California, USA...", died:date('2010-05-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kvrF0mE9051KhhOD05D7rTYYtw5.jpg", url:"https://themoviedb.org/person/32384"}}, {tmdbId:"32385", properties:{bornIn:"The Bronx, New York City, New York, United States", imdbId:"0001011", born:date('1959-03-18'), name:"Irene Cara", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uHwGNd7UgYwl7ItYqm5kB9ljfzc.jpg", url:"https://themoviedb.org/person/32385"}}, {tmdbId:"32386", properties:{bornIn:"The Bronx, New York, USA", imdbId:"0001087", born:date('1961-01-04'), name:"Lee Curreri", url:"https://themoviedb.org/person/32386"}}, {tmdbId:"32387", properties:{imdbId:"0212847", born:date('1963-05-27'), name:"Laura Dean", url:"https://themoviedb.org/person/32387"}}, {tmdbId:"33322", properties:{bornIn:"Edmonton, Alberta, Canada", imdbId:"0000758", born:date('1955-12-03'), name:"Melody Anderson", bio:"From Wikipedia, the free encyclopedia. \n\nMelody Anderson (born December 3, 1955) is a Canadian American social worker and public speaker specializing in the impact of addiction on families.  She is also known as an actress, with her most high-profile role being Dale Arden in the 1980 adaptation of Flash Gordon.  Born in Edmonton, Alberta, Anderson started off as a performer and entertainer.  She made her debut at age five on a radio show...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4im7LOHeXHZyTq2mh19afKJ02ZU.jpg", url:"https://themoviedb.org/person/33322"}}, {tmdbId:"11782", properties:{bornIn:"Sacramento, California, USA", imdbId:"0000105", born:date('1945-06-11'), name:"Adrienne Barbeau", bio:"An American actress and the author of three books.  Barbeau came to prominence in the 1970s as Broadway's original Rizzo in the musical Grease, and as Carol Traynor, the divorced daughter of Maude Findlay (played by Beatrice Arthur) in the sitcom Maude.  In the early 1980s Barbeau was a sex symbol, starring in several horror and science fiction films, including The Fog, Creepshow, Swamp Thing, and Escape from New York...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pXzL9YhpavVCXf4z0huyZLvP2Ob.jpg", url:"https://themoviedb.org/person/11782"}}, {tmdbId:"10343", properties:{bornIn:"Paris, France", imdbId:"0898199", born:date('1943-04-23'), name:"Hervé Villechaize", bio:"Hervé Jean-Pierre Villechaize was a French actor and painter of English and Filipino descent.  He achieved worldwide recognition for various roles including that of the evil henchman Nick Nack in the James Bond film, The Man with the Golden Gun, as well as Mr.  Roarke's assistant, Tattoo, in the television series Fantasy Island...", died:date('1993-09-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9zDzeE1WSBqLcS5DAIQz3UAbDSR.jpg", url:"https://themoviedb.org/person/10343"}}, {tmdbId:"1065724", properties:{imdbId:"0511974", name:"Gisele Lindley", url:"https://themoviedb.org/person/1065724"}}, {tmdbId:"188724", properties:{imdbId:"0777263", name:"Jan Stuart Schwartz", url:"https://themoviedb.org/person/188724"}}, {tmdbId:"37470", properties:{bornIn:"Oyster Bay, New York, USA", imdbId:"0454415", born:date('1955-07-21'), name:"Adrienne King", bio:"From Wikipedia, the free encyclopedia. \n\nAdrienne King (born January 4, 1960) is an American actress, dancer and painter.  She is mostly known for her starring role in the original Friday the 13th...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2ClURorxbBtgHHcAodlFhc3vk7d.jpg", url:"https://themoviedb.org/person/37470"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"37473", properties:{bornIn:"Hartford, Connecticut, USA", imdbId:"0852551", born:date('1954-06-02'), name:"Jeannine Taylor", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kSppKOe6ESbEDgJ79EghdVVB6Td.jpg", url:"https://themoviedb.org/person/37473"}}, {tmdbId:"1011510", properties:{imdbId:"0604987", born:date('1961-07-16'), name:"Robbi Morgan", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gm9rPn4wZheBPsI7PRkmewYJTAl.jpg", url:"https://themoviedb.org/person/1011510"}}, {tmdbId:"27584", properties:{bornIn:"Millburn, New Jersey, USA", imdbId:"0138388", born:date('1954-04-04'), name:"Julie Carmen", bio:"Julie Carmen (born April 4, 1954, Millburn, New Jersey) is an American actress and a licensed psychotherapist. \n\nShe came to prominence onscreen in the 1980s, winning the Venice Film Festival Best Supporting Actress Award for her role in John Cassavetes' Gloria.  Her acting training was with Sanford Meisner at Neighborhood Playhouse and with Uta Hagen at HB Studios.  Carmen was on the Board of Directors of both Women in Film for three years and IFP/West for six years...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o8PSFlMyIAj6edruQNyf3JvoVA.jpg", url:"https://themoviedb.org/person/27584"}}, {tmdbId:"16758", properties:{imdbId:"0923366", born:date('1945-02-03'), name:"Marius Weyers", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tKgcFsfy9StwWj6vfNaJyxlRNEY.jpg", url:"https://themoviedb.org/person/16758"}}, {tmdbId:"55676", properties:{imdbId:"0697865", born:date('1947-09-15'), name:"Sandra Prinsloo", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jsTq0HMXINYjGaneR7pckLoIPsY.jpg", url:"https://themoviedb.org/person/55676"}}, {tmdbId:"55674", properties:{bornIn:"Namibia", imdbId:"0618452", born:date('1944-12-16'), name:"N!xau", bio:"Nǃxau ǂToma(short: Nǃxau, alternative spelling Gcao Tekene Çoma; 16 December 1944 – 1 July 2003) was a Namibian bush farmer and actor who was made famous by his roles in the 1980 movie The Gods Must Be Crazy and its sequels, in which he played the Kalahari Bushman Xixo.  The Namibian called him \"Namibia's most famous actor\". \n\nOn 5 July 2003, he died from multiple-drug-resistant tuberculosis while he was out on an excursion for hunting guinea fowl...", died:date('2003-07-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ujlyT43y5Uh6T721s6ErZPbyoyU.jpg", url:"https://themoviedb.org/person/55674"}}, {tmdbId:"55677", properties:{imdbId:"0895116", name:"Louw Verwey", url:"https://themoviedb.org/person/55677"}}, {tmdbId:"1442631", properties:{bornIn:"London, England  United Kingdom", imdbId:"0572229", born:date('1946-01-22'), name:"Malcolm McLaren", bio:"Malcolm Robert Andrew McLaren (22 January 1946 – 8 April 2010) was a British musician, impresario, visual artist, performer, clothes designer and boutique owner, notable for combining these activities in an inventive and provocative way...", died:date('2010-04-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xE2qbGWapFXjJgTrNJGs9j8smuJ.jpg", url:"https://themoviedb.org/person/1442631"}}, {tmdbId:"38667", properties:{bornIn:"Shepherd's Bush, London, England, UK", imdbId:"0429289", born:date('1955-09-03'), name:"Steve Jones", bio:"Stephen Philip Jones (born 3 September 1955) is an English rock guitarist, singer, actor and radio DJ, best known as a guitarist with the Sex Pistols and Iggy Pop.  Following the split of the Sex Pistols, he formed The Professionals with former bandmate Paul Cook.  He has also released two solo albums, and worked with the likes of Johnny Thunders, Iggy Pop, Bob Dylan and Thin Lizzy.  In 1995, he formed the short lived supergroup Neurotic Outsiders with members of Guns N' Roses and Duran Duran...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p82A0EEApjvRsr9KgqGThEoMehs.jpg", url:"https://themoviedb.org/person/38667"}}, {tmdbId:"79628", properties:{bornIn:"Shepherd's Bush, London, England, UK", imdbId:"0177222", born:date('1956-07-20'), name:"Paul Cook", bio:"Paul Thomas Cook (born 20 July 1956 in Shepherd's Bush, London) is an English drummer and member of the punk rock band the Sex Pistols.  He was also called \"Cookie\" by his friends on the punk music scene.  Cook was raised in Hammersmith and attended the Christopher Wren School, now Phoenix High School, London in White City Estate, Shepherds Bush, where he met Steve Jones.  The pair became good friends and while bunking off school...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/k1z00YC9PdhGgLM1uj7LjT1fBni.jpg", url:"https://themoviedb.org/person/79628"}}, {tmdbId:"79629", properties:{bornIn:"Lewisham, London, England United Kingdom", imdbId:"0895965", born:date('1957-05-10'), name:"Sid Vicious", bio:"Sid Vicious, born John Simon Ritchie, was an English musician and vocalist.  He achieved fame as a member of the punk rock band the Sex Pistols, replacing Glen Matlock, who had fallen out of favour with the rest of the group.  American expatriate Chrissie Hynde, before she formed the Pretenders,  tried to convince Ritchie to join her in a sham marriage so she could get a work permit in the UK.  John Lydon nicknamed Ritchie \"Sid Vicious\" after Lydon's pet hamster Sid...", died:date('1979-02-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/s5dk16sAKA4lR3zruISthoSbTEj.jpg", url:"https://themoviedb.org/person/79629"}}, {tmdbId:"8659", properties:{bornIn:"USA", imdbId:"0856012", born:date('1950-01-25'), name:"John Terry", bio:"From Wikipedia, the free encyclopedia. \n\nJohn Terry (born January 25, 1950) is an American film, television, and stage actor. \n\nDescription above from the Wikipedia article John Terry, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2paelsnx3mEZam5ZJZMmUuurgJq.jpg", url:"https://themoviedb.org/person/8659"}}, {tmdbId:"12815", properties:{imdbId:"0107805", born:date('1934-02-25'), name:"Bernard Bresslaw", died:date('1993-06-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h8ZglTWetH0DDBmzG6VaRVJwx1S.jpg", url:"https://themoviedb.org/person/12815"}}, {tmdbId:"59692", properties:{imdbId:"0153186", name:"Ray Charleson", url:"https://themoviedb.org/person/59692"}}, {tmdbId:"71391", properties:{bornIn:"Elkins Park, Pennsylvania, U.S.", imdbId:"0122881", born:date('1954-11-15'), name:"Stephen W. Burns", bio:"​From Wikipedia, the free encyclopedia.   \n\nStephen W.  Burns (November 15, 1954–February 22, 1990) was an American actor. \n\nDescription above from the Wikipedia article Stephen W.  Burns  licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1990-02-22'), url:"https://themoviedb.org/person/71391"}}, {tmdbId:"2337907", properties:{imdbId:"2908064", name:"Steve Ballard", url:"https://themoviedb.org/person/2337907"}}, {tmdbId:"1271904", properties:{imdbId:"0075540", name:"Phil Berle", url:"https://themoviedb.org/person/1271904"}}, {tmdbId:"8975", properties:{bornIn:"Cambridge, Massachusetts, USA", imdbId:"0001832", born:date('1940-11-15'), name:"Sam Waterston", bio:"Samuel Atkinson \"Sam\" Waterston (born November 15, 1940) is an American actor and occasional producer and director.  Among other roles, he is noted for his Academy Award-nominated portrayal of Sydney Schanberg in 1984's The Killing Fields, and his Golden Globe- and Screen Actors Guild Award-winning portrayal of Jack McCoy on the NBC television series Law & Order...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fKmtS6OdDWPiAdxZflbJGz1eWml.jpg", url:"https://themoviedb.org/person/8975"}}, {tmdbId:"21519", properties:{bornIn:"Tazewell, Virginia, USA", imdbId:"0002130", born:date('1950-08-02'), name:"Kathryn Harrold", bio:"An American television and movie actress. \n\nDescription above from the Wikipedia article Kathryn Harrold, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cdqZk1ovgYRWzbDamu4WGzfLoBg.jpg", url:"https://themoviedb.org/person/21519"}}, {tmdbId:"2390", properties:{bornIn:"Landstuhl, Rhineland Palatinate, Germany", imdbId:"0000996", born:date('1957-02-16'), name:"LeVar Burton", bio:"From Wikipedia, the free encyclopedia. \n\nLevardis Robert Martyn Burton, Jr.  (born February 16, 1957, height 5' 7\" (1,70 m)) professionally known as LeVar Burton, is an American actor, director, producer and author who first came to prominence portraying Kunta Kinte in the 1977 award-winning ABC television miniseries Roots, based on the novel by Alex Haley...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2aHTYPGJCuKfAasirbUP2APmP7Q.jpg", url:"https://themoviedb.org/person/2390"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"80502", properties:{bornIn:" Los Angeles, California, USA", imdbId:"0565907", born:date('1955-06-21'), name:"Leigh McCloskey", bio:"From Wikipedia, the free encyclopedia  Leigh Joseph McCloskey (born June 21, 1955) is an American actor.   Description above from the Wikipedia article Leigh McCloskey, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uglCQ1phvY36J8MZGJbKfOZDXYm.jpg", url:"https://themoviedb.org/person/80502"}}, {tmdbId:"24612", properties:{bornIn:"Roma, Italy", imdbId:"0320395", born:date('1953-10-21'), name:"Eleonora Giorgi", bio:"Eleonora Giorgi è un'attrice e regista italiana...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hbhh6dqIXgWdgHLLsQhUoQNRNZp.jpg", url:"https://themoviedb.org/person/24612"}}, {tmdbId:"69669", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0004871", born:date('1941-01-24'), name:"Neil Diamond", bio:"​From Wikipedia, the free encyclopedia.   \n\nNeil Leslie Diamond (born January 24, 1941) is an American singer-songwriter.  As a successful pop music performer, Diamond scored a number of hits worldwide in the 1960s, 1970s, and 1980s.  According to David Wild, common themes in Diamond's songs are \"a deep sense of isolation and an equal desire for connection.  A yearning for home – and at the same time, the allure of greater freedom...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/geiwcAPT3xJDiNAeAGP929wq9LO.jpg", url:"https://themoviedb.org/person/69669"}}, {tmdbId:"61880", properties:{bornIn:"Hollywood, Los Angeles, California, USA", imdbId:"0036109", born:date('1951-07-17'), name:"Lucie Arnaz", bio:"Lucie Arnaz is the daughter of Desi Arnaz and Lucille Ball...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1PSZQRZ4vp5nVCzIk8VSRnCb0eB.jpg", url:"https://themoviedb.org/person/61880"}}, {tmdbId:"71027", properties:{bornIn:"Omiya, Saitama Prefecture, Japan", imdbId:"0353714", born:date('1950-07-26'), name:"Ken'ichi Hagiwara", bio:"​From Wikipedia, the free encyclopedia.   \n\nKenichi Hagiwara ( born 26 July 1950 in Omiya, Saitama, Japan), also known as Sho-Ken, was the lead singer of The Tempters, the \"bad boys\" of the Group Sounds Japan pop scene in the mid and late 1960s.  A teen idol with a legion of loyal fans, Hagiwara was known for his good looks and arrogance, which appealed to both young male and female Japanese fans...", died:date('2019-03-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qPn54rKCuQu3zfelPtFiFCRxXmc.jpg", url:"https://themoviedb.org/person/71027"}}, {tmdbId:"70133", properties:{bornIn:"Yamanashi, Japan", imdbId:"0628704", born:date('1947-12-01'), name:"Jinpachi Nezu", bio:"​From Wikipedia, the free encyclopedia.   \n\nJinpachi Nezu  (根津 甚八, Nezu Jinpachi, 1 December 1947 – 29 December 2016) was a Japanese actor.  He has appeared in 56 films and television shows since 1974.  He starred in the 1982 film Farewell to the Land, which was entered into the 32nd Berlin International Film Festival. \n\nDescription above from the Wikipedia article Jinpachi Nezu, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2016-12-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wMGQ7RgZ1vf6siHhnnqbb63Yks0.jpg", url:"https://themoviedb.org/person/70133"}}, {tmdbId:"382", properties:{bornIn:"Bury St. Edmunds, Suffolk, England, UK", imdbId:"0001364", born:date('1942-10-26'), name:"Bob Hoskins", bio:"From Wikipedia, the free encyclopedia\n\nRobert William \"Bob\" Hoskins, Jr.  (born 26 October 1942 – 29 April 2014) is an English actor, known for playing Cockney rough diamonds, psychopaths and gangsters, in films such as The Long Good Friday (1980), and Mona Lisa (1986), and lighter roles in Who Framed Roger Rabbit (1988) and Hook (1991)...", died:date('2014-04-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i6urQzI3HG4WpGJLnDNbWbn13Mb.jpg", url:"https://themoviedb.org/person/382"}}, {tmdbId:"74043", properties:{bornIn:"Twickenham, Middlesex, England, UK", imdbId:"0454622", born:date('1929-06-23'), name:"Dave King", bio:"Dave King was an English comedian, actor and vocalist of popular songs.  He is remembered for screen roles such as the corrupt policeman 'Parky' in the British gangster film The Long Good Friday and Clifford Duckworth in the soap opera Coronation Street...", died:date('2002-04-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jbUSb6QRGx8p3lnyaAX1YwVl4c3.jpg", url:"https://themoviedb.org/person/74043"}}, {tmdbId:"76184", properties:{bornIn:"Battersea, London, England, UK", imdbId:"0550789", born:date('1938-05-19'), name:"Bryan Marshall", died:date('2019-06-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7g6rBCW7N49J9wwuFxoUr3KSeFk.jpg", url:"https://themoviedb.org/person/76184"}}, {tmdbId:"16525", properties:{bornIn:"Manhattan, New York", imdbId:"0818874", born:date('1936-10-28'), name:"Joe Spinell", bio:"​Joe Spinell was born Joseph J.  Spagnuolo in Manhattan, New York of Italian immigrant parents, and the last of six children.  His father, Pelegrino Spagnuolo (b.  1892, d.  1950), died from liver and kidney disease.  His mother Filomena Spagnuolo (b.  1903, d.  1987) was a bit-part actress who acted in a few movies, some of them alongside her son.  Spinell stood 5 foot and 11 inches.  He was born at his family's apartment in Manhattan's Little Italy on 2nd Avenue in Manhattan...", died:date('1989-01-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rGte4YnpHaZctUtheSradJ1blLX.jpg", url:"https://themoviedb.org/person/16525"}}, {tmdbId:"101609", properties:{bornIn:"New York City, New York, USA", imdbId:"0492765", name:"Abigail Clayton", bio:"Beautiful and capable adult-film actress Abigail Clayton was born in New York City.  Her father was a doctor.  She gave an impressive lead performance in her film debut as the eager innocent adolescent who experiences a sexual awakening in the excellent and highly erotic teen coming-of-age feature Dixie (1976)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dPV417wxMAW00Q0fgAoz2AozJdJ.jpg", url:"https://themoviedb.org/person/101609"}}, {tmdbId:"101610", properties:{imdbId:"0684908", born:date('1950-09-01'), name:"Kelly Piper", died:date('2009-12-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hfxy6TECf5rkv9xgWqq70WiEYo.jpg", url:"https://themoviedb.org/person/101610"}}, {tmdbId:"118487", properties:{bornIn:"Burbank, California, USA", imdbId:"0156187", born:date('1967-03-03'), name:"Elizabeth Cheshire", url:"https://themoviedb.org/person/118487"}}, {tmdbId:"47417", properties:{bornIn:"Radlett, Hertfordshire, England, UK", imdbId:"0605088", born:date('1958-01-01'), name:"Wendy Morgan", bio:"Wendy Morgan is an English stage, television, and film actress...", url:"https://themoviedb.org/person/47417"}}, {tmdbId:"47418", properties:{imdbId:"0183819", born:date('1923-11-14'), name:"Margaret Courtenay", died:date('1996-02-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hnpbn0MjqvBMg5uxhnjrLkFC20s.jpg", url:"https://themoviedb.org/person/47418"}}, {tmdbId:"24485", properties:{bornIn:"Oran, French Algeria", imdbId:"0305368", born:date('1946-04-22'), name:"Nicole Garcia", bio:"From Wikipedia, the free encyclopedia. \n\nNicole Garcia (born in Oran, French Algeria, on 22 April 1946) is a French actress, film director and writer.  Her film Selon Charlie was entered into the 2006 Cannes Film Festival. \n\nDescription above from the Wikipedia article Nicole Garcia, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/miV8I6kNb0rMjSn6bADw5ms08Il.jpg", url:"https://themoviedb.org/person/24485"}}, {tmdbId:"123130", properties:{imdbId:"0682655", born:date('1923-08-20'), name:"Roger Pierre", died:date('2010-01-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3zAUJjV4OzNMO8V8Kb8jZmD0tJv.jpg", url:"https://themoviedb.org/person/123130"}}, {tmdbId:"17029", properties:{bornIn:"Geneva, Switzerland", imdbId:"0096501", born:date('1931-11-29'), name:"Nelly Borgeaud", bio:"From Wikipedia, the free encyclopedia. \n\nNelly Borgeaud (29 November 1931 – 14 July 2004) was a French film actress.  She appeared in 43 films between 1955 and 2001. \n\nDescription above from the Wikipedia article Nelly Borgeaud, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2004-07-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kRp5lZ4yulhLGNxFVQecUYhJSLN.jpg", url:"https://themoviedb.org/person/17029"}}, {tmdbId:"19181", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0001983", born:date('1922-08-08'), name:"Rory Calhoun", bio:"Rory Calhoun (1922–1999) was an American television and film actor, screenwriter, and producer best known for his roles in Westerns...", died:date('1999-04-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wKhLE3w02NYqNeLUuId4OUylqZN.jpg", url:"https://themoviedb.org/person/19181"}}, {tmdbId:"107308", properties:{bornIn:"New York City, New York, USA", imdbId:"0512912", born:date('1948-05-06'), name:"Paul Linke", bio:"From Wikipedia, the free encyclopedia. \n\nPaul Linke (born May 6, 1948) is an American actor, known for his role as Officer Artie Grossman in CHiPs, a television series about the motorcycle officers of the California Highway Patrol.  Linke has worked in film and extensively in television, mostly portraying mild-mannered everyman roles. \n\nLinke was born in New York, New York, the son of Richard O.  Linke, a personal manager, producer, and partner of Andy Griffith...", url:"https://themoviedb.org/person/107308"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"91842", properties:{bornIn:"St. Paul, Minnesota, USA", imdbId:"0663878", born:date('1942-01-17'), name:"Nancy Parsons", bio:"From Wikipedia, the free encyclopedia. \n\nNancy Anne Parsons (January 17, 1942 — January 5, 2001) was an American actress.  She was best-known for her role as Beulah Balbricker in the 1982 cult film Porky's and its sequels.  She also played Ida in Motel Hell (1980)...", died:date('2001-01-05'), url:"https://themoviedb.org/person/91842"}}, {tmdbId:"27241", properties:{bornIn:"New York City, New York, USA", imdbId:"0043497", born:date('1955-07-28'), name:"Nina Axelrod", bio:"From Wikipedia, the free encyclopedia. \n\nNina Kether Axelrod is an American actress who appeared in television and films mainly during the late 1970s through the early 1980s.  Since the early 1990s, she has worked as a casting director on films. \n\nSeveral of her family members have worked in the film industry.  She is the daughter of Joan Stanton and George Axelrod, who was a screenwriter, producer, playwright and film director. \n\nHer television appearances have included Charlie's Angels and CHiPs...", url:"https://themoviedb.org/person/27241"}}, {tmdbId:"112158", properties:{bornIn:"Montreal, Quebec, Canada", imdbId:"0538485", born:date('1964-04-22'), name:"Chris Makepeace", bio:"​From Wikipedia, the free encyclopedia.   \n\nChristopher Makepeace (born April 22, 1964) is a Canadian film and television actor. \n\nDescription above from the Wikipedia article Chris Makepeace, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cWogFoU5zqhG3pxHrhhU6JPfoKd.jpg", url:"https://themoviedb.org/person/112158"}}, {tmdbId:"2059", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0000284", born:date('1962-02-27'), name:"Adam Baldwin", bio:"Appearing in dozens of films since 1980, Baldwin rose to prominence as the troubled outcast Ricky Linderman in My Bodyguard (1980) and moved on to bigger roles in D. C.  Cab (1983), Full Metal Jacket (1987), Independence Day (1996), The Patriot (2000) and Serenity (2005)—in which he reprises his role as the mercenary Jayne Cobb from the television series Firefly...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yHLEi9iWA1pWF794f3lkw7zqOJ8.jpg", url:"https://themoviedb.org/person/2059"}}, {tmdbId:"1024594", properties:{imdbId:"0702861", born:date('1966-11-02'), name:"Paul Quandt", died:date('2006-09-09'), url:"https://themoviedb.org/person/1024594"}}, {tmdbId:"21736", properties:{imdbId:"0588553", born:date('1939-04-22'), name:"Jason Miller", died:date('2001-05-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4dwatFQJnBvS51SjsqnG4ZC4ItZ.jpg", url:"https://themoviedb.org/person/21736"}}, {tmdbId:"70746", properties:{imdbId:"0281130", born:date('1934-12-29'), name:"Ed Flanders", died:date('1995-02-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1DTd3YtDYtYzZr6iPOYl3fizsMj.jpg", url:"https://themoviedb.org/person/70746"}}, {tmdbId:"14397", properties:{bornIn:"Heidelberg, Germany", imdbId:"0115010", born:date('1948-10-09'), name:"Jackson Browne", bio:"Browne was born October 9, 1948, in Heidelberg, Germany, where his father Clyde Jack Browne, an American serviceman, was stationed for his job assignment with the Stars and Stripes newspaper.  Browne's mother, Beatrice Amanda (née Dahl), was a Minnesota native of Norwegian ancestry.  Browne has three siblings.  Roberta \"Berbie\" Browne was born in 1946 in Nuremberg, Germany; and Edward Severin Browne was born in 1949 in Frankfurt am Main, Germany...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/XRpzEKODkSpOPRRsYIJfJOAj8l.jpg", url:"https://themoviedb.org/person/14397"}}, {tmdbId:"165802", properties:{imdbId:"0004849", born:date('1941-08-14'), name:"David Crosby", url:"https://themoviedb.org/person/165802"}}, {tmdbId:"1053799", properties:{imdbId:"0355747", name:"John Hall", url:"https://themoviedb.org/person/1053799"}}, {tmdbId:"92826", properties:{bornIn:"Roma, Lazio, Italy", imdbId:"0874004", born:date('1945-01-01'), name:"Karin Well", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ge1nUDkPy6CgNFlwlVR3TMvqK2O.jpg", url:"https://themoviedb.org/person/92826"}}, {tmdbId:"92827", properties:{imdbId:"0158162", name:"Gianluigi Chirizzi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7gcZgNBZ4BsheokPJbONEyZgOiJ.jpg", url:"https://themoviedb.org/person/92827"}}, {tmdbId:"1191688", properties:{imdbId:"0560348", name:"Simone Mattioli", url:"https://themoviedb.org/person/1191688"}}, {tmdbId:"1191689", properties:{imdbId:"0031085", name:"Antonella Antinori", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xVEvXsKNbSzSvkXChToy5QOzfKp.jpg", url:"https://themoviedb.org/person/1191689"}}, {tmdbId:"6167", properties:{bornIn:" New York City, USA", imdbId:"0002139", born:date('1935-03-15'), name:"Judd Hirsch", bio:"Judd Hirsch (born March 15, 1935) is an American actor most known for playing Alex Rieger on the television comedy series Taxi, John Lacey on the NBC series Dear John, and Alan Eppes on the CBS series Numb3rs...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7rJ0TZfMoPLTcO203tHhE6tcPKP.jpg", url:"https://themoviedb.org/person/6167"}}, {tmdbId:"16327", properties:{bornIn:"Malibu, California, USA", imdbId:"0000459", born:date('1960-08-16'), name:"Timothy Hutton", bio:"Timothy Tarquin Hutton (born August 16, 1960) is an American actor.  He is the youngest actor to win the Academy Award for Best Supporting Actor, which he won at the age of 20 for his performance as Conrad Jarrett in Ordinary People (1980).  He currently stars as Nathan \"Nate\" Ford on the TNT series Leverage. \n\nDescription above from the Wikipedia article Timothy Hutton, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yc4ZNGM1zsycfQtSDsxOtKdaLgO.jpg", url:"https://themoviedb.org/person/16327"}}, {tmdbId:"2157", properties:{bornIn:"Chicago - Illinois - USA", imdbId:"0000245", born:date('1951-07-21'), name:"Robin Williams", bio:"Robin McLaurin Williams (July 21, 1951 – August 11, 2014) was an  American actor and stand-up comedian.  Rising to fame with his role as  the alien Mork in the TV series Mork & Mindy  (1978–1982), Williams  went on to establish a successful career in both  stand-up comedy and  feature film acting...", died:date('2014-08-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iYdeP6K0qz44Wg2Nw9LPJGMBkQ5.jpg", url:"https://themoviedb.org/person/2157"}}, {tmdbId:"23346", properties:{bornIn:"New York City, New York, U.S", imdbId:"0000800", born:date('1949-10-04'), name:"Armand Assante", bio:"Armand Anthony Assante is an American actor.  He is best known for his roles as mobster John Gotti in the 1996 HBO television film Gotti, Nietzsche in When Nietzsche Wept and Mickey Spillane's Mike Hammer in 1982's I, the Jury...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9HbbWAJacTHguO2InDVHKGnaasm.jpg", url:"https://themoviedb.org/person/23346"}}, {tmdbId:"117451", properties:{bornIn:"Marrickville - New South Wales - Australia", imdbId:"0633682", born:date('1944-02-03'), name:"Trisha Noble", bio:"Patricia \"Trisha\" Ann Ruth Noble (born 3 February 1944) is an Australian singer and actress.  Initially performing as Patsy Ann Noble, she was a teenage pop singer in the early 1960s, with regular appearances on the music and variety television series Bandstand.  In November 1961, she released her biggest hit single, \"Good Looking Boy\", which reached the Top 10 in Melbourne and Top 20 in Sydney.  At the Logie Awards for 1961, she won the 'Best Female Singer' from TV Week...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jBaJOkMgXJ76TwHwXmSvXcCtDYo.jpg", url:"https://themoviedb.org/person/117451"}}, {tmdbId:"8545", properties:{bornIn:"Port Talbot, West Glamorgan, Wales, UK", imdbId:"0288882", born:date('1927-05-11'), name:"Bernard Fox", died:date('2016-12-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9LFpXETNoCLbXORh1TurrN4subZ.jpg", url:"https://themoviedb.org/person/8545"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"1184781", properties:{imdbId:"0828309", name:"Casey Stevens", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/140ZjZTCQWot3L0lJ79zwtRMDnn.jpg", url:"https://themoviedb.org/person/1184781"}}, {tmdbId:"9986", properties:{bornIn:" Toronto, Ontario, Canada ", imdbId:"0551926", born:date('1957-11-11'), name:"Anne-Marie Martin", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/txE1j7v7BakV0DXippLa1wnGl5e.jpg", url:"https://themoviedb.org/person/9986"}}, {tmdbId:"14702", properties:{bornIn:"The Bronx, New York, USA", imdbId:"0001550", born:date('1960-11-29'), name:"Cathy Moriarty", bio:"Cathy Moriarty-Gentile (born November 29, 1960) is an American actress.  \n\nHer first film credit was Martin Scorsese's Raging Bull in 1980, as Vikki LaMotta, the wife of Robert De Niro's lead character.  Her performance earned her a nomination for the Academy Award for Best Supporting Actress.  She also appeared opposite Andrew Dice Clay in the short-lived CBS sitcom Bless This House (1995)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/g5pXUDGH30egsCq9eTDrsikFAYk.jpg", url:"https://themoviedb.org/person/14702"}}, {tmdbId:"4517", properties:{bornIn:"Newark, New Jersey, USA ", imdbId:"0000582", born:date('1943-02-09'), name:"Joe Pesci", bio:"Joseph Frank “Joe” Pesci (born February 9, 1943) is an American actor, comedian, singer and musician.  He is known for his roles as violent mobsters, funnymen, comic foils and quirky sidekicks.  Pesci has starred in a number of high profile films such as Goodfellas, Casino, Raging Bull, Once Upon a Time in America, My Cousin Vinny, Easy Money, JFK, Moonwalker, Home Alone, Home Alone 2: Lost in New York, and the 2nd, 3rd, and 4th Lethal Weapon films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7ecSqd7GXYbK3sJw1lvLWLiJ6fh.jpg", url:"https://themoviedb.org/person/4517"}}, {tmdbId:"7164", properties:{bornIn:"North Adams, Massachusetts, USA", imdbId:"0898634", born:date('1939-08-04'), name:"Frank Vincent", bio:"From Wikipedia, the free encyclopedia\n\nFrank Vincent (born August 4, 1939) was an American actor, musician, author and entrepreneur.  He was a favorite performer of director Martin Scorsese, having played important roles in three of Scorsese's most acclaimed films: Raging Bull (1980), Goodfellas (1990) and Casino (1995).  He often played a gangster and worked both in features and television.  He also lent his voice talents to video games...", died:date('2017-09-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fa1gikNsPKvX1roWUo2bBmixnvp.jpg", url:"https://themoviedb.org/person/7164"}}, {tmdbId:"144528", properties:{imdbId:"0531638", name:"Bruce MacDonald", url:"https://themoviedb.org/person/144528"}}, {tmdbId:"20835", properties:{bornIn:"USA", imdbId:"0719964", born:date('1951-01-01'), name:"Maggie Renzi", url:"https://themoviedb.org/person/20835"}}, {tmdbId:"61607", properties:{bornIn:"Albany - New York - USA", imdbId:"0480775", born:date('1950-08-11'), name:"Adam LeFevre", bio:"Adam LeFevre is an actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gr1mq2bF1k5JfZK2sQIeO1kIbde.jpg", url:"https://themoviedb.org/person/61607"}}, {tmdbId:"144529", properties:{imdbId:"0184064", name:"Maggie Cousineau", url:"https://themoviedb.org/person/144529"}}, {tmdbId:"57880", properties:{bornIn:"Montréal, Québec, Canada", imdbId:"0480099", born:date('1946-01-01'), name:"Stephen Lack", bio:"Stephen Lack (born 1946) is a Canadian painter and a film actor best known for his role as Cameron Vale in David Cronenberg's film Scanners...", url:"https://themoviedb.org/person/57880"}}, {tmdbId:"36173", properties:{bornIn:"Masson, Quebec, Canada", imdbId:"0199325", born:date('1937-04-03'), name:"Lawrence Dane", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dQx4BZD1OneoGfeaw0zndWD85IH.jpg", url:"https://themoviedb.org/person/36173"}}, {tmdbId:"8294", properties:{bornIn:"St. Louis, Missouri, USA", imdbId:"0347039", born:date('1927-11-30'), name:"Robert Guillaume", bio:"​From Wikipedia, the free encyclopedia.   \n\nRobert \"Bob\" Guillaume (November 30, 1927 – October 24, 2017) was an American stage and television actor, best known for his role as Benson Du Bois on the TV-series Soap and the spin-off Benson, voicing the mandrill Rafiki in The Lion King and as Isaac Jaffe on Sports Night.  In a career that  spanned more than 50 years he worked extensively on stage (including a Tony Award nomination), television (including winning two Emmy Awards), and film...", died:date('2017-10-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/S6ZFjW9aeKRb7ilifmfl1VzIJb.jpg", url:"https://themoviedb.org/person/8294"}}, {tmdbId:"80742", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0611898", born:date('1943-08-18'), name:"Martin Mull", bio:"Offbeat funnyman Martin Mull was born in Chicago, Illinois, the oldest of three children, and raised in Ohio.  The blond-maned, blue-eyed comedian with the sad, droopy mustache first came in contact with the arts by honing in on his innate talents as a painter.  In order to pay his art school tuition, he started organizing bands.  At around the same time, he discovered that stand-up comedy was another way to allow his creative juices to flow...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6XjisWyfvi4r35naeIAvy7i3Gix.jpg", url:"https://themoviedb.org/person/80742"}}, {tmdbId:"1762609", properties:{bornIn:"Los Angeles, California, USA", born:date('1964-04-15'), name:"Jennifer McAllister", url:"https://themoviedb.org/person/1762609"}}, {tmdbId:"105622", properties:{bornIn:"Philadelphia, Pennsylvania, USA ", imdbId:"0156780", born:date('1942-08-20'), name:"Sam Chew Jr.", url:"https://themoviedb.org/person/105622"}}, {tmdbId:"62414", properties:{bornIn:"Hong Kong, China", imdbId:"0950707", born:date('1957-07-26'), name:"Biao Yuen", bio:"Yuen Biao (Chinese: 元彪, born 26 July 1957) is a Hong Kong actor and martial artist.  He specialises in acrobatics and Chinese martial arts and has worked on over 80 films as actor, stuntman and action choreographer.  Along with Peking Opera School \"brothers\" at the China Drama Academy, Sammo Hung and Jackie Chan, he was one of the Seven Little Fortunes...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4mydCEXUU7baXHuITriaZS8GXNy.jpg", url:"https://themoviedb.org/person/62414"}}, {tmdbId:"10410", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0515950", born:date('1973-01-01'), name:"Danny Lloyd", bio:"​From Wikipedia, the free encyclopedia\n\nDanny Lloyd (born January 1, 1973) is an American former child actor. \n\nLloyd's first and best-known role is that of Danny Torrance in Stanley Kubrick's The Shining, starring Jack Nicholson and Shelley Duvall. \n\nHe was selected for the role due to his ability to maintain his concentration for extended periods of time...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sFhJokeMkwD46Gsiy4Bjv26aiqZ.jpg", url:"https://themoviedb.org/person/10410"}}, {tmdbId:"142463", properties:{bornIn:"Shimomeguro, Tokyo, Japan", imdbId:"0559607", born:date('1943-03-17'), name:"Kayo Matsuo", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7SZI0fH6Ft8JyAt91DGiPQBqzOi.jpg", url:"https://themoviedb.org/person/142463"}}, {tmdbId:"230787", properties:{bornIn:"Osaka, Japan", imdbId:"0645011", born:date('1923-12-16'), name:"Minoru Ôki", died:date('2009-03-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aVKV4mPRBf0ofLGRAP5jguEBnrG.jpg", url:"https://themoviedb.org/person/230787"}}, {tmdbId:"1088157", properties:{bornIn:"Tokushima Prefecture, Japan", imdbId:"0633028", born:date('1934-08-13'), name:"Shôgen Nitta", died:date('2004-11-18'), url:"https://themoviedb.org/person/1088157"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"47441", properties:{bornIn:"Baltimore, Maryland, United States", imdbId:"0662321", born:date('1947-11-18'), name:"Jameson Parker", bio:"From Wikipedia, the free encyclopedia.   Francis Jameson Parker Jr.  (born November 18, 1947, Baltimore, Maryland) is an American actor, best known as the co-star of the 1980s television series Simon &amp; Simon. \n\nDescription above from the Wikipedia article Jameson Parker, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hQeGaeTGATTDFDvC13FFnHruV2c.jpg", url:"https://themoviedb.org/person/47441"}}, {tmdbId:"56881", properties:{bornIn:"Fort Wayne, Indiana, USA", imdbId:"0001480", born:date('1949-08-23'), name:"Shelley Long", bio:"Shelley Long is an American stage, film and television actress, best known for playing series regular Diane Chambers on the television sitcom \"Cheers\", for which she won one Emmy Award for Outstanding Lead Actress and two Golden Globe Awards for Best Actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mJuDa3tiF1d34phattCVWVrFKIq.jpg", url:"https://themoviedb.org/person/56881"}}, {tmdbId:"14065", properties:{bornIn:"Havana, Cuba", imdbId:"0113617", born:date('1943-06-24'), name:"Georg Stanford Brown", bio:"From Wikipedia, the free encyclopedia. \n\nGeorg Stanford Brown (born June 24, 1943 in Havana, Cuba) is a Cuban-American actor and director, perhaps best known as one of the stars of the ABC police television series The Rookies from 1972–76.  On the show, Brown played the character of Officer Terry Webster. \n\nDuring the 1960s, Brown had a variety of roles in television and film, including a portrayal of Henri Philipot in 1967's The Comedians, and playing Dr.  Willard in 1968's Bullitt...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hTd8786Av81F8Slb5HIkuyfy3BI.jpg", url:"https://themoviedb.org/person/14065"}}, {tmdbId:"10080", properties:{bornIn:"Houston - Texas - USA", imdbId:"0001851", born:date('1948-12-06'), name:"JoBeth Williams", bio:"JoBeth Williams (born December 6, 1948) is an Academy Award, Golden Globe, and Emmy nominated American film and television actress and director, and current President of the Screen Actors Guild Foundation...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/As6PDqSwJjLEtYnUBcigGBrcxUZ.jpg", url:"https://themoviedb.org/person/10080"}}, {tmdbId:"55278", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0178114", born:date('1922-09-15'), name:"Jackie Cooper", bio:"Served with the Navy in the South Pacific toward the end of World War  II.  Then, quietly and without publicity or fanfare, compiled one of the  most distinguished peacetime military careers of anyone in his  profession.  In 1961, as his weekly TV series Hennesey  (1959) was enhancing naval recruiting efforts, accepted a commission as  a line officer in the Naval Reserve with duties in recruitment,  training films, and public relations...", died:date('2011-05-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fl5lxpTZZGnMmZZj8F68BtLY5Ii.jpg", url:"https://themoviedb.org/person/55278"}}, {tmdbId:"381", properties:{bornIn:"Galveston, Texas, USA", imdbId:"0001340", born:date('1929-07-05'), name:"Katherine Helmond", bio:"From Wikipedia, the free encyclopedia\n\nKatherine Marie Helmond (July 5, 1929 – February 23, 2019) was an American film, theater, and television actress and director. \n\nOver her five decades of television acting, she was known for her starring role as ditzy matriarch Jessica Tate on the ABC prime time soap opera sitcom Soap (1977–1981) and her co-starring role as feisty mother Mona Robinson on Who's the Boss? (1984–1992)...", died:date('2019-02-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ewqxAgTyclJLwQi4WWU5QZiCM0Q.jpg", url:"https://themoviedb.org/person/381"}}, {tmdbId:"535705", properties:{bornIn:"New York City, New York, USA", imdbId:"0023013", born:date('1941-12-03'), name:"Walter George Alton", url:"https://themoviedb.org/person/535705"}}, {tmdbId:"57380", properties:{bornIn:"Tlacotepec, Oaxaca, Mexico", imdbId:"0297450", born:date('1953-09-29'), name:"Miguel Ángel Fuentes", bio:"Miguel Ángel Fuentes was born on September 29, 1953 in Tlacotepec, Oaxaca, Mexico.  He is an actor, known for Fitzcarraldo (1982), The Pumaman (1980) and The Mexican (2001)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5vK6pOHpavXyP7AGlUREnSK4r40.jpg", url:"https://themoviedb.org/person/57380"}}, {tmdbId:"105350", properties:{bornIn:"Akron, Ohio, USA", imdbId:"0739185", born:date('1951-03-17'), name:"Sydne Rome", bio:"Sydne Rome is a United States-born, Italy-based film actress.  Her first name is often misspelled Sydney or Sidney. \n\nBorn in Akron, Rome grew up in a wealthy family in Upper Sandusky, Ohio.  Her father was president of a plastics corporation in the Akron area.  She started her career in 1969 in the British movie Some Girls Do.  She then appeared in Italian films, often playing the young, seemingly innocent American abroad, and also in spaghetti westerns...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1Yyk3Xp8jvfiLKKvku0LTMWF52x.jpg", url:"https://themoviedb.org/person/105350"}}, {tmdbId:"26513", properties:{bornIn:"Cleveland Heights, Ohio, USA", imdbId:"0000700", born:date('1955-05-16'), name:"Debra Winger", bio:"Mary Debra Winger (born May 16, 1955) is an American actress.  A three-time Oscar nominee, she received awards for acting in Terms of Endearment, for which she won the National Society of Film Critics Award for Best Actress in 1983, and in A Dangerous Woman, for which she won the Tokyo International Film Festival Award for Best Actress in 1993. \n\nDescription above from the Wikipedia article Debra Winger, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/g97Ngw6WLkgOeVcUSDrOhexbyhQ.jpg", url:"https://themoviedb.org/person/26513"}}, {tmdbId:"349", properties:{bornIn:"Pittsburgh - Pennsylvania - USA", imdbId:"0001277", born:date('1939-01-26'), name:"Scott Glenn", bio:"Theodore Scott Glenn (born January 26, 1941) is an American actor.  His roles have included Wes Hightower in Urban Cowboy (1980), astronaut Alan Shepard in The Right Stuff (1983), Commander Bart Mancuso in The Hunt for Red October (1990), and Jack Crawford in The Silence of the Lambs (1991). \n\nDescription above from the Wikipedia article Scott Glenn, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4Uz4ZnoR90dxjgqJo09ekFPii8U.jpg", url:"https://themoviedb.org/person/349"}}, {tmdbId:"66079", properties:{bornIn:"Albuquerque, New Mexico, U.S.", imdbId:"0001750", born:date('1957-01-01'), name:"Madolyn Smith Osborne", bio:"Madolyn Smith Osborne (born January 1, 1957, Albuquerque, New Mexico) is an American actress. \n\nMadolyn Smith Osborne may be best-known for her roles in the TV miniseries If Tomorrow Comes and the feature film Funny Farm, which co-starred Chevy Chase.  In 1984, she appeared in 2010, with Roy Scheider.  She portrayed Jehan Al Sadat, wife of Egyptian president Anwar Al Sadat, in the TV miniseries Sadat...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/r9GAro6MqbU9MtWYsxuJqAutzN8.jpg", url:"https://themoviedb.org/person/66079"}}, {tmdbId:"1735", properties:{bornIn:"Memphis, Tennessee", imdbId:"0574433", born:date('1942-06-03'), name:"Frank McRae", bio:"Frank McRae (born June 3, 1942) is an American actor and former professional football player. \n\nMcRae was born in Memphis, Tennessee.  McRae graduated from Tennessee State University with a double major in drama and history.  He was a defensive tackle for the Chicago Bears in the 1967 NFL season. \n\nAmong his acting roles are the history teacher, Mr...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/t8EJyrhoe2zSjqzLBK63KsDyQJO.jpg", url:"https://themoviedb.org/person/1735"}}, {tmdbId:"50871", properties:{imdbId:"0524855", name:"Tom Luddy", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4vy26LEfgfMMNeMK5pbPyX3KdZx.jpg", url:"https://themoviedb.org/person/50871"}}, {tmdbId:"9257", properties:{bornIn:"New York City, New York, USA", imdbId:"0456124", born:date('1949-04-28'), name:"Bruno Kirby", bio:"From Wikipedia, the free encyclopedia. \n\nBruno Kirby (April 28, 1949 – August 14, 2006) was an American film and television actor.  He was perhaps best known for his roles in the Hollywood films City Slickers, When Harry Met Sally. . . , Good Morning, Vietnam, and The Godfather Part II...", died:date('2006-08-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jhzDyVIXoccsSmhkNgrneLAeUYG.jpg", url:"https://themoviedb.org/person/9257"}}, {tmdbId:"35159", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0628170", born:date('1952-03-02'), name:"Laraine Newman", bio:"Newman was born on March 2, 1952, in Los Angeles, California, the granddaughter of a cattle rancher from Arizona.  Her family is Jewish.  She is the youngest of four children and a twin (brother Paul).  Her sister, Tracy Newman, is an Emmy Award-winning television writer.  Newman attended Beverly Hills High School in Beverly Hills, California and graduated from there in 1970.  Newman married actor-writer-director Chad Einbinder (born 1963) in 1991...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kbUjMuhuUMXlfPpAHnrGGQf4uRn.jpg", url:"https://themoviedb.org/person/35159"}}, {tmdbId:"101752", properties:{imdbId:"0788829", born:date('1952-11-14'), name:"Ray Sharkey", died:date('1993-06-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5PS5ZXshTW9pZAbiT4uZ22aKmJx.jpg", url:"https://themoviedb.org/person/101752"}}, {tmdbId:"157936", properties:{bornIn:"Indianapolis, Indiana, USA", imdbId:"0806277", born:date('1940-02-24'), name:"James Sloyan", url:"https://themoviedb.org/person/157936"}}, {tmdbId:"24902", properties:{imdbId:"0549087", born:date('1944-08-26'), name:"Louise Marleau", url:"https://themoviedb.org/person/24902"}}, {tmdbId:"35826", properties:{bornIn:"Landsberg am Lech, Germany", imdbId:"0712022", born:date('1932-04-02'), name:"Siegfried Rauch", bio:"Born in 1932, Siegfried Rauch originally wanted to be an architect.  He started his career as an actor in the 1950s...", died:date('2018-03-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zciVfVyQmiVQ2c9uOEZ84kKdnqN.jpg", url:"https://themoviedb.org/person/35826"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"161383", properties:{bornIn:"Louisville, Kentucky, USA", imdbId:"0860658", born:date('1941-01-31'), name:"Ron Thompson", bio:"Ron Thompson is an American film, television, theatre actor, singer and songwriter.  Born in Louisville, Kentucky, Thompson is perhaps best known for his dual lead roles in Ralph Bakshi's critically acclaimed rotoscope film American Pop and the 1970s TV series Baretta in the role of Detective Nopke...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/t17shRpLgzAYAsWS7gF8pFcsOZa.jpg", url:"https://themoviedb.org/person/161383"}}, {tmdbId:"133774", properties:{bornIn:"Pasadena, California, USA", imdbId:"0806500", born:date('1942-03-20'), name:"Mews Small", url:"https://themoviedb.org/person/133774"}}, {tmdbId:"2462365", properties:{imdbId:"0390723", name:"Jerry Holland", url:"https://themoviedb.org/person/2462365"}}, {tmdbId:"14467", properties:{imdbId:"0067643", name:"Joe Belcher", url:"https://themoviedb.org/person/14467"}}, {tmdbId:"14463", properties:{bornIn:"Hartford, Connecticut, USA", imdbId:"0622544", born:date('1951-02-13'), name:"David Naughton", bio:"From Wikipedia, the free encyclopedia.   \n\nDavid Walsh Naughton (born February 13, 1951) is an American actor and singer best known for his starring roles in the 1981 horror film An American Werewolf in London and the 1980 Walt Disney comedy, Midnight Madness. \n\nDescription above from the Wikipedia article David Walsh Naughton  licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ixAZbVAL2ZfEfVNqXHyxnTwAPFZ.jpg", url:"https://themoviedb.org/person/14463"}}, {tmdbId:"939", properties:{bornIn:"Manchester, Greater Manchester, England, UK", imdbId:"0774516", born:date('1951-01-01'), name:"David Schofield", bio:"From Wikipedia, the free encyclopedia. \n\nDavid Schofield is an English actor who born in Manchester, Lancashire in 1951.  He has appeared in numerous television programmes and feature films during his career. \n\nDescription above from the Wikipedia article David Schofield (actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/on5V05LXlkU2kiu4TjaDvpp0jBn.jpg", url:"https://themoviedb.org/person/939"}}, {tmdbId:"18841", properties:{bornIn:"Napoli - Campania - Italy", imdbId:"0817881", born:date('1929-10-31'), name:"Bud Spencer", bio:"Bud Spencer was an Italian actor, filmmaker and a former professional swimmer.  He was known for past roles in action-comedy films together with his long-time film partner Terence Hill.  Growing from a successful swimmer in his youth, he got a degree in law, and has registered several patents.  Bud also became a certified commercial airline and helicopter pilot, Bud Spencer also supported and funded many children's charities, including the Spencer Scholarship Fund...", died:date('2016-06-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cVbBoKxRDFOdDKwdpRmxVazDWlE.jpg", url:"https://themoviedb.org/person/18841"}}, {tmdbId:"69066", properties:{bornIn:"Düsseldorf, Germany", imdbId:"0486639", born:date('1954-05-21'), name:"Marina Langner", url:"https://themoviedb.org/person/69066"}}, {tmdbId:"69067", properties:{imdbId:"0769265", born:date('1953-12-04'), name:"Mario Scarpetta", died:date('2004-11-14'), url:"https://themoviedb.org/person/69067"}}, {tmdbId:"69068", properties:{bornIn:"Rome - Lazio - Italy", imdbId:"0056593", born:date('1940-04-05'), name:"Gianfranco Barra", bio:"Gianfranco Barra was born on April 5, 1940 in Rome, Lazio, Italy.  He is an actor, known for Le talentueux Mr.  Ripley (1999), Heaven (2002) and Avanti! (1972)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hwCfyLfnbsx98Fz3nyWlsVrMFyA.jpg", url:"https://themoviedb.org/person/69068"}}, {tmdbId:"127889", properties:{imdbId:"0078769", born:date('1965-11-14'), name:"Ariel Besse", url:"https://themoviedb.org/person/127889"}}, {tmdbId:"7280", properties:{bornIn:"Cuffies, Aisne, France", imdbId:"0594885", born:date('1942-02-19'), name:"Geneviève Mnich", bio:"From Wikipedia, the free encyclopedia\n\nGeneviève Mnich (born 19 February 1942), is a French actress.  She has appeared in 80 films since 1972. \n\nShe was born in Cuffies, Aisne, France. \n\nDescription above from the Wikipedia article Geneviève Mnich, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/7280"}}, {tmdbId:"66811", properties:{bornIn:"Berwyn, Illinois, USA", imdbId:"0400267", born:date('1945-05-10'), name:"David Huffman", bio:"David Huffman (1945–1985) was a longtime character actor with many television, film and stage credits.  He was married to award winning casting director Phyllis Huffman until he was murdered in 1985. \n\nDescription the Wikipedia article David Huffman, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1985-02-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6Pw8Cmangckqiwo7atzkXaUEkNJ.jpg", url:"https://themoviedb.org/person/66811"}}, {tmdbId:"12074", properties:{bornIn:"Rochester, New York, USA", imdbId:"0001475", born:date('1945-10-19'), name:"John Lithgow", bio:"John Lithgow (born October 19, 1945) is an American actor, musician, poet, author, and singer.   Presently, he is involved with a wide range of media projects, including stage, television, film, and radio.  He also has written and published several books of poetry and children's literature.  He appeared in the films The World According to Garp (1982) and Terms of Endearment (1983), receiving an Academy Award nomination for Best Actor in a Supporting Role for each...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8Y1sjBdnVR483S8PrnAQzlESwhx.jpg", url:"https://themoviedb.org/person/12074"}}, {tmdbId:"11901", properties:{bornIn:" Maywood, Illinois, United States", imdbId:"0001240", born:date('1944-10-28'), name:"Dennis Franz", bio:"​From Wikipedia, the free encyclopedia.   \n\nDennis Franz (born October 28, 1944) is an American actor best known for his role as Andy Sipowicz, a hard boiled police detective in the television series NYPD Blue.  He previously appeared as Lt.  Norman Buntz on Hill Street Blues, and earlier played Detective Benedetto, a corrupt cop also on HSB. \n\nDescription above from the Wikipedia article Dennis Franz  licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nsH6IzL8AivpgBN0oQdYgunYhSy.jpg", url:"https://themoviedb.org/person/11901"}}, {tmdbId:"3391", properties:{bornIn:"Springfield, Missouri, USA", imdbId:"0000678", born:date('1954-06-19'), name:"Kathleen Turner", bio:"​From Wikipedia, the free encyclopedia.   \n\nMary Kathleen Turner (born June 19, 1954) is an American actress.  She came to fame during the 1980s, after roles in the Hollywood films Body Heat, Peggy Sue Got Married, Romancing the Stone, The War of the Roses, Who Framed Roger Rabbit and Prizzi's Honor.  She also was a guest star in Californication on Showtime. \n\nDescription above from the Wikipedia article Kathleen Turner, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fI8r9Hs0hlQuB0FVGDFMkNsLSc.jpg", url:"https://themoviedb.org/person/3391"}}, {tmdbId:"920", properties:{bornIn:"Berlin, Germany", imdbId:"0001638", born:date('1941-06-10'), name:"Jürgen Prochnow", bio:"Jürgen Prochnow is a German actor.  His most well-known roles internationally have been as the sympathetic submarine captain in Das Boot (1981), Duke Leto Atreides I in Dune (1984), the minor, but important role of Kazakh dictator General Ivan Radek in Air Force One and the antagonist Maxwell Dent in Beverly Hills Cop II. \n\nProchnow was born in Berlin and brought up in Düsseldorf, the son of an engineer.  He has an elder brother, Dieter.  He studied acting at the Folkwang Hochschule in Essen...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AsZfwwsEkhFk5XZCjkLjqYFnyPE.jpg", url:"https://themoviedb.org/person/920"}}, {tmdbId:"5228", properties:{bornIn:"Göttingen, Lower Saxony, Germany", imdbId:"0344963", born:date('1956-04-12'), name:"Herbert Grönemeyer", bio:"Herbert Arthur Wiglev Clamor Grönemeyer (born 12 April 1956) is a German musician and actor, popular in Germany, Austria and Switzerland.  He starred as war correspondent Lieutenant Werner in Wolfgang Petersen's movie Das Boot, but later concentrated on his musical career...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/19avUAKjoVMChb2xh4Sxl4garAR.jpg", url:"https://themoviedb.org/person/5228"}}, {tmdbId:"5229", properties:{bornIn:"Bad Aibling, Bavière, Germany", imdbId:"0921044", born:date('1940-12-18'), name:"Klaus Wennemann", bio:"From Wikipedia, the free encyclopedia\n\nKlaus Wennemann (18 December 1940 – 7 January 2000) was a German television and film actor. \n\nWenneman was born in Oer-Erkenschwick, North Rhine-Westphalia.  He is perhaps best known for his leading roles as the Chief Engineer, (the LI), in Das Boot, and as Faber in the TV series Der Fahnder.  As an actor, he appeared in nine movies, and ten television series.  He died in Bad Aibling, Bavaria, at the age of 59, from lung cancer...", died:date('2000-01-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xHF0akCqkKjIiiSOn79MquMuNMk.jpg", url:"https://themoviedb.org/person/5229"}}, {tmdbId:"5230", properties:{bornIn:"Berlin, Germany", imdbId:"0071059", born:date('1952-07-10'), name:"Hubertus Bengsch", bio:"From Wikipedia, the free encyclopedia  Hubertus Bengsch (born 10 July 1952 in Berlin) is a German actor, best known for his role as the German First Officer (1WO) in Das Boot.  He also is well known for being the German voice of American actor Richard Gere...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/40aPO2JuzEblUPwi8ebfw4xi6HA.jpg", url:"https://themoviedb.org/person/5230"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"60451", properties:{bornIn:"Philadelphia, Pennsylvania, USA", imdbId:"2286602", born:date('1953-02-24'), name:"Brian Matthews", bio:"​From Wikipedia, the free encyclopedia\n\nBrian Matthews is an actor, best known for acting in daytime soap operas in the 1980s. \n\nMatthews and co-stars Holly Hunter, Jason Alexander, and Fisher Stevens all made their film debuts in The Burning (1981).  He then played Eric Garrison on the soap opera The Young and the Restless from 1983-1985.  He went on to portray Brother Martin on Days of our Lives from 1985–1986 and David Laurent on Santa Barbara in 1986...", url:"https://themoviedb.org/person/60451"}}, {tmdbId:"114809", properties:{bornIn:"Baltimore, Maryland", imdbId:"0043994", born:date('1957-05-28'), name:"Leah Ayres", bio:"​From Wikipedia, the free encyclopedia\n\nLeah Ayres (born May 28, 1957) is an American actress who played Valerie Bryson on the daytime serial, The Edge of Night, in the early 1980s.  Ayres is well known for her role in Bloodsport, alongside Jean-Claude Van Damme.  Ayres is also known for portraying Marcia Brady (in lieu of Maureen McCormick) in The Bradys, the 1990 dramatic revival of The Brady Bunch. \n\nAyres was born Leah Simpson in Baltimore, Maryland...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pj3NBBJgXg7oWwsAgSk1GNR7fwB.jpg", url:"https://themoviedb.org/person/114809"}}, {tmdbId:"118946", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0045637", born:date('1956-12-05'), name:"Brian Backer", bio:"​From Wikipedia, the free encyclopedia\n\nBrian Backer (born December 5, 1956) is an American actor who has starred in film and on television.  He is best known for his role in the 1982 hit comedy film Fast Times at Ridgemont High as shy teenager Mark \"Rat\" Ratner.  His other films include the 1985 comedy film Moving Violations (playing the role of Scott Greeber) and the 1987 comedy film Police Academy 4: Citizens on Patrol...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fdQzbnesWMQarCRYSWnaPgDcZT2.jpg", url:"https://themoviedb.org/person/118946"}}, {tmdbId:"21380", properties:{bornIn:"New York City, New York USA", imdbId:"0430829", born:date('1952-02-12'), name:"Larry Joshua", bio:"​From Wikipedia, the free encyclopedia\n\nLarry Joshua (born February 12, 1952) is an American actor who has appeared in over 50 productions since 1981.  Some of his more famous films include The Burning (1981), Sea of Love (1989), Quick Change (1990), A Midnight Clear (1992), Romeo is Bleeding (1993), The X Files (1998), For Love of the Game (1999) and Spider-Man (2002).  He appeared in two Academy Award for Best Picture winners: Dances with Wolves (1990) and Unforgiven (1992)...", url:"https://themoviedb.org/person/21380"}}, {tmdbId:"28768", properties:{bornIn:"Corpus Christi, Texas, USA", imdbId:"0000396", born:date('1947-02-02'), name:"Farrah Fawcett", bio:"From Wikipedia, the free encyclopedia. \n\nFarrah Fawcett (February 2, 1947 – June 25, 2009, height 5' 6½\" (1,69 m)) was an American actress and artist.  A multiple Golden Globe and Emmy Award nominee, Fawcett rose to international fame when she first appeared as private investigator Jill Munroe in the first season of the TV series Charlie's Angels, in 1976...", died:date('2009-06-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v1osF8x0G4OiXfGmElnyymyrUCn.jpg", url:"https://themoviedb.org/person/28768"}}, {tmdbId:"83974", properties:{imdbId:"0756634", born:date('1946-08-14'), name:"Susan Saint James", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a11j7RDuaaT5sstL7qLjv5Cd148.jpg", url:"https://themoviedb.org/person/83974"}}, {tmdbId:"87769", properties:{imdbId:"0552189", born:date('1922-01-30'), name:"Dick Martin", died:date('2008-05-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iruFycctHNstPJ2dOD3P4SRaDey.jpg", url:"https://themoviedb.org/person/87769"}}, {tmdbId:"32357", properties:{bornIn:"Essex, England, UK", imdbId:"0268297", born:date('1955-01-01'), name:"Nicholas Farrell", bio:"From Wikipedia, the free encyclopedia.  Nicholas Farrell (born Nicholas Frost, in 1955) is an English stage, film and television actor.  His early screen career included the role of Aubrey Montague in the 1981 film Chariots of Fire.  In 1983, he starred as Edmund Bertram in a television adaptation of the Jane Austen novel, Mansfield Park.  In 1984, he appeared in Greystoke: The Legend of Tarzan, Lord of the Apes and The Jewel in the Crown...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5W1m0oVHKb9AE1r6L3mdO2crrZC.jpg", url:"https://themoviedb.org/person/32357"}}, {tmdbId:"53517", properties:{bornIn:"London, England", imdbId:"0369814", born:date('1949-11-06'), name:"Nigel Havers", bio:"​From Wikipedia, the free encyclopedia.   \n\nNigel Allan Havers (born 6 November 1951) is an English actor.  He is probably best known for his BAFTA-nominated role as Lord Andrew Lindsay in the 1981 British film Chariots of Fire, and for his role as Dr.  Tom Latimer in the British TV comedy series Don't Wait Up.  He portrayed the role of Lewis Archer in Coronation Street from 2009 to 2010...", url:"https://themoviedb.org/person/53517"}}, {tmdbId:"11854", properties:{bornIn:"Edinburgh, Scotland, UK", imdbId:"0153182", born:date('1949-08-11'), name:"Ian Charleson", bio:"From Wikipedia, the free encyclopedia. \n\nIan Charleson (11 August 1949 – 6 January 1990) was a Scottish stage and film actor.  He is best known internationally for his starring role as Olympic athlete and missionary Eric Liddell, in the Oscar-winning 1981 film Chariots of Fire.  He is also well known for his portrayal of Rev.  Charlie Andrews in the 1982 Oscar-winning film Gandhi...", died:date('1990-01-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ajjETMq3zGvABN7tmB8AA4nYLOi.jpg", url:"https://themoviedb.org/person/11854"}}, {tmdbId:"29068", properties:{bornIn:"London, England, UK", imdbId:"0002027", born:date('1947-12-16'), name:"Ben Cross", bio:"Ben Cross (born 16 December 1947) is a British actor of the stage and screen, best known for his portrayal of the British Olympic athlete Harold Abrahams in the 1981 movie Chariots of Fire. \n\nDescription above from the Wikipedia article Ben Cross, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/11gObExUG7lFCA7WeYgHabnZjDg.jpg", url:"https://themoviedb.org/person/29068"}}, {tmdbId:"3664", properties:{bornIn:"Flint, Michigan, USA", imdbId:"0000928", born:date('1955-06-06'), name:"Sandra Bernhard", bio:"Sandra Bernhard (born June 6, 1955) is an American comedian, singer, actress and author.  She first gained attention in the late 1970s with her stand-up comedy in which she often bitterly critiques celebrity culture and political figures.  Bernhard is number 97 on Comedy Central's list of the 100 greatest standups of all time. \n\nDescription above from the Wikipedia article  Sandra Bernhard , licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dzGZIdOKWewJnFOxEh7KH8QQezV.jpg", url:"https://themoviedb.org/person/3664"}}, {tmdbId:"1221838", properties:{bornIn:"Somerville - Massachusetts - USA", imdbId:"0135899", born:date('1963-03-23'), name:"Paul Carafotes", bio:"Paul Carafotes is an actor...", url:"https://themoviedb.org/person/1221838"}}, {tmdbId:"83453", properties:{bornIn:"Santa Barbara, California, USA", imdbId:"0294229", born:date('1934-12-04'), name:"Victor French", bio:"From Wikipedia, the free encyclopedia\n\nVictor Edwin French (December 4, 1934 – June 15, 1989) was an American actor and director.  He is remembered for roles on the television programs Little House on the Prairie, Highway to Heaven and Carter Country, cl...", died:date('1989-06-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mtvywlfKrr0DgY72CONUmWcCYwV.jpg", url:"https://themoviedb.org/person/83453"}}, {tmdbId:"41284", properties:{imdbId:"0325959", born:date('1936-10-01'), name:"Lelia Goldoni", bio:"Lelia Goldoni (born 1 October 1936) is an American actress who appeared in a number of motion pictures and television shows starting in the late-1940s, beginning with uncredited cameo roles in Joseph L.  Mankiewicz's House of Strangers (1949) and John Huston's We Were Strangers (1949).  She costarred on an episode of the British television series Danger Man \"Fair Exchange\" (1964) with Patrick MacGoohan...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kgDTvRacNm5AY9kIUKSjqYnCYeY.jpg", url:"https://themoviedb.org/person/41284"}}, {tmdbId:"3014", properties:{bornIn:"Philadelphia, Pennsylvania, USA", imdbId:"0043088", born:date('1924-07-14'), name:"Val Avery", bio:"Val Avery was an American film and television actor...", died:date('2009-12-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jqstekVs471L1eFJ9Omz2n2BqEf.jpg", url:"https://themoviedb.org/person/3014"}}, {tmdbId:"15152", properties:{bornIn:"Arkabutla, Mississippi, USA", imdbId:"0000469", born:date('1931-01-17'), name:"James Earl Jones", bio:"James Earl Jones (born January 17, 1931) is a multi-award-winning American actor of theater and film, well known for his distinctive bass voice and for his portrayal of characters of substance, gravitas and leadership.  He is known for providing the voice of Darth Vader in the Star Wars franchise and the tagline for CNN.   James Earl Jones was born in Arkabutla, Mississippi, the son of Ruth (née Connolly) and Robert Earl Jones...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oqMPIsXrl9SZkRfIKN08eFROmH6.jpg", url:"https://themoviedb.org/person/15152"}}, {tmdbId:"45378", properties:{bornIn:"Kansas City, Missouri, USA ", imdbId:"0000922", born:date('1951-11-14'), name:"Sandahl Bergman", bio:"Stunning and statuesque blonde dancer and actress who first set male hearts racing as the key dancer in the sexually charged \"Airotica\" dance sequence in All That Jazz (1979). \n\nBergman appeared then in Xanadu (1980), before landing the role for which she is best remembered, as the never say die female warrior/thief \"Valeria\" in the Hyborean Age action of Conan the Barbarian (1982)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cFpHHCopLAH9PDmqc7iTgRf5wxX.jpg", url:"https://themoviedb.org/person/45378"}}, {tmdbId:"14848", properties:{bornIn:"Oklahoma City, Oklahoma, United States", imdbId:"0358996", born:date('1936-07-09'), name:"James Hampton", bio:"From Wikipedia, the free encyclopedia\n\nJames Wade Hampton (born July 9, 1936) is an American actor, television director, and screenwriter. \n\nDescription above from the Wikipedia article James Hampton (actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iXb1NEbCz07GSTPb6yns9d0ZEm8.jpg", url:"https://themoviedb.org/person/14848"}}, {tmdbId:"203731", properties:{imdbId:"0323344", name:"Carlin Glynn", url:"https://themoviedb.org/person/203731"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"17882", properties:{bornIn:"Paris, France", imdbId:"0001376", born:date('1953-03-16'), name:"Isabelle Huppert", bio:"A French actress who has appeared in over 90 film and television productions since 1971.  She has had 14 films in official competition at the Cannes Film Festival, and won the Best Actress Award twice, for Violette Nozière (1978) and La pianiste (2001).  She is also the most nominated actress for the César Award, with 13 nominations.  She won a César Award for Best Actress in 1996 for her performance in La Cérémonie...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3YQwWkpNKQeV5NUmdCH76Ne1gDP.jpg", url:"https://themoviedb.org/person/17882"}}, {tmdbId:"20795", properties:{bornIn:"Dijon, France", imdbId:"0547339", born:date('1932-04-12'), name:"Jean-Pierre Marielle", bio:"​From Wikipedia, the free encyclopedia\n\nJean-Pierre Marielle (born April 12, 1932) is a French actor...", died:date('2019-04-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l56lXHVUUO2bMeTjEaB0tzYuW8.jpg", url:"https://themoviedb.org/person/20795"}}, {tmdbId:"19092", properties:{bornIn:"Versailles, Seine-et-Oise, France", imdbId:"0000804", born:date('1932-11-08'), name:"Stéphane Audran", bio:"From Wikipedia, the free encyclopedia. \n\nStéphane Audran (born Colette Suzanne Dacheville 8 November 1932 in Versailles, Yvelines) was a French film and television actress, known for her performances in Oscar winning movies such as Le charme discret de la bourgeoisie (1972) and Babette's Feast (1987) and in critically acclaimed films like The Big Red One (1980) and Violette Nozière (1978)...", died:date('2018-03-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nsDewAkYIclnQR06ZYuwb57Yiwm.jpg", url:"https://themoviedb.org/person/19092"}}, {tmdbId:"28950", properties:{bornIn:"Glens Falls, New York, U.S.", imdbId:"0002059", born:date('1952-02-04'), name:"Lisa Eichhorn", bio:"From Wikipedia, the free encyclopedia.   Lisa Eichhorn (born February 4, 1952) is an American actress, writer and producer.  She made her film debut in 1979 in the John Schlesinger film Yanks for which she received two Golden Globe nominations.  Her international career has included film, theatre and television. \n\nDescription above from the Wikipedia article Lisa Eichhorn, licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gMKTeKne8A3E8p5HxwOCX5Wts1A.jpg", url:"https://themoviedb.org/person/28950"}}, {tmdbId:"16197", properties:{bornIn:"Tucson, Arizona, USA", imdbId:"0244619", born:date('1953-09-13'), name:"Ann Dusenberry", bio:"As a young child Ann’s desire to work in the theatre was deeply nurtured at the local YWCA in Tucson, Arizona where she studied classical theatre with Mary MacMurtrie, performing in plays twice a year until she was 14.  She came west to Los Angeles to complete her bachelor’s degree in theatre arts at Occidental College.  With 8 years of summer repertory theatre at Occidental and her degree in hand Ann made her foray into Hollywood...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/koNcdFcYoIpVT8zXlX1oHamlywF.jpg", url:"https://themoviedb.org/person/16197"}}, {tmdbId:"1515136", properties:{imdbId:"0046506", name:"Alice Bag", url:"https://themoviedb.org/person/1515136"}}, {tmdbId:"1515140", properties:{imdbId:"1504768", name:"Black Flag", url:"https://themoviedb.org/person/1515140"}}, {tmdbId:"95788", properties:{bornIn:"New York City, New York, U.S.", imdbId:"0000769", born:date('1942-11-23'), name:"Susan Anspach", bio:"Susan Florence Anspach (November 23, 1942 – April 2, 2018) was an American actress...", died:date('2018-04-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o9PqTDLsktDUoaweBBLZj666G32.jpg", url:"https://themoviedb.org/person/95788"}}, {tmdbId:"75353", properties:{imdbId:"0723589", born:date('1968-10-12'), name:"Adam Rich", url:"https://themoviedb.org/person/75353"}}, {tmdbId:"38515", properties:{imdbId:"0273061", name:"Wilhelmenia Fernandez", url:"https://themoviedb.org/person/38515"}}, {tmdbId:"38514", properties:{imdbId:"0029268", name:"Frédéric Andréi", url:"https://themoviedb.org/person/38514"}}, {tmdbId:"1977", properties:{bornIn:"Moulins, France", imdbId:"0092184", born:date('1942-01-16'), name:"Richard Bohringer", bio:"Richard Bohringer (born 16 January 1941) is a French actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/t6JoIDWVHyFAf7dzk3KHjyObtMh.jpg", url:"https://themoviedb.org/person/1977"}}, {tmdbId:"1478039", properties:{imdbId:"0527626", name:"Thuy An Luu", url:"https://themoviedb.org/person/1478039"}}, {tmdbId:"12688", properties:{bornIn:"Dallas, Texas, USA", imdbId:"0001493", born:date('1954-04-10'), name:"Peter MacNicol", bio:"Peter MacNicol (born April 10, 1954) is an American actor. \n\nIn film he is best known for Ghostbusters II and Sophie's Choice.  For television he is best known for Ally McBeal, 24, Chicago Hope, and Numbers...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xo09hN0cqYh1V7z986yFOTdaKhU.jpg", url:"https://themoviedb.org/person/12688"}}, {tmdbId:"2275", properties:{bornIn:"Pittsburgh, Pennsylvania, USA", imdbId:"0164680", born:date('1952-05-03'), name:"Caitlin Clarke", bio:"​From Wikipedia, the free encyclopedia.   \n\nCaitlin Clarke (May 3, 1952 – September 9, 2004) was an American theater and film actress best known for her role as Valerian in the 1981 fantasy film Dragonslayer and for her role as Charlotte Cardoza in the 1998–1999 Broadway musical Titanic. \n\nDescription above from the Wikipedia article Caitlin Clarke  licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2004-09-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/59PKSNwM5Czk3XWDIsHnBMbiIOz.jpg", url:"https://themoviedb.org/person/2275"}}, {tmdbId:"12690", properties:{bornIn:" Lisburn, Northern Ireland United Kingdom", imdbId:"0356268", born:date('1941-10-28'), name:"John Hallam", bio:"​From Wikipedia, the free encyclopedia.   \n\nJohn William Francis Hallam (28 October 1941 – 14 November 2006[1]) was a Northern Irish character actor...", died:date('2006-11-14'), url:"https://themoviedb.org/person/12690"}}, {tmdbId:"101330", properties:{bornIn:"London, England", imdbId:"0531529", born:date('1954-10-03'), name:"Catriona MacColl", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AiKf5vkiHOQqErPvxfc0w7usrqU.jpg", url:"https://themoviedb.org/person/101330"}}, {tmdbId:"5570", properties:{bornIn:"Christchurch, New Zealand", imdbId:"0911285", born:date('1941-11-17'), name:"David Warbeck", bio:"From Wikipedia, the free encyclopedia\n\nDavid Warbeck (17 November 1941 in Christchurch, New Zealand – 23 July 1997 in London, England) was an actor best known for his film roles throughout Europe. \n\nDescription above from the Wikipedia article David Warbeck, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1997-07-23'), url:"https://themoviedb.org/person/5570"}}, {tmdbId:"31780", properties:{bornIn:"Genoa, Liguria, Italy", imdbId:"0598443", born:date('1957-06-22'), name:"Cinzia Monreale", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z9gbWNGlonGpqFDQOjnTa7diX0M.jpg", url:"https://themoviedb.org/person/31780"}}, {tmdbId:"5568", properties:{bornIn:"Avignone, Vaucluse, Francia", imdbId:"0231452", born:date('1940-08-11'), name:"Antoine Saint-John", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3zpEJnvKvLReF6pG5HDjibYpsak.jpg", url:"https://themoviedb.org/person/5568"}}] AS row
