UNWIND [{tmdbId:"124652", properties:{imdbId:"0238741", name:"Sally Dryer", url:"https://themoviedb.org/person/124652"}}, {tmdbId:"4514", properties:{bornIn:"New York City, New York, USA", imdbId:"0001839", born:date('1943-08-27'), name:"Tuesday Weld", bio:"Tuesday Weld (born August 27, 1943) is an American actress. \n\nWeld began her acting career as a child, and progressed to more mature roles during the late 1950s.  She won a Golden Globe Award for Most Promising Female Newcomer in 1960.  Over the following decade she established a career playing dramatic roles in films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tGnitvqumkoHxYoh0a6HtRdQ5HY.jpg", url:"https://themoviedb.org/person/4514"}}, {tmdbId:"16926", properties:{bornIn:"Paris, France", imdbId:"0021691", born:date('1946-04-16'), name:"Catherine Allégret", bio:"Catherine Allégret (born 16 April 1946) is a French actress.  She is the daughter of Simone Signoret and Yves Allégret. \n\nIn 2004, she published a book titled World Upside Down (Un monde à l'envers) in which she contended that she had been sexually abused by her stepfather Yves Montand since the age of 5.  In 2007, she portrayed Édith Piaf's grandmother Louise Gassion in Olivier Dahan's biopic La Vie En Rose (La Môme in French). \n\nAllégret has been married twice...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q542SMCN3yoo8bq1jmAM6B0J3OU.jpg", url:"https://themoviedb.org/person/16926"}}, {tmdbId:"1666", properties:{bornIn:"Chabua, Assam, India", imdbId:"0001046", born:date('1941-04-14'), name:"Julie Christie", bio:"Julie Frances Christie (born 14 April 1941) is a British actress.  Born in British India to English parents, at the age of six Christie moved to England where she attended boarding school.  In 1961, she began her acting career in a BBC television series, and the following year, she had her first major film role in a romantic comedy.  In 1965, she became known to international audiences as the model \"Diana Scott\" in the film Darling...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sSZxtDBRCZO3Sg5wVXVV8hCmqJd.jpg", url:"https://themoviedb.org/person/1666"}}, {tmdbId:"1942", properties:{bornIn:"  Madrid, Spain", imdbId:"0897808", born:date('1920-01-29'), name:"José Luis de Vilallonga", bio:"José Luis de Vilallonga y Cabeza de Vaca, 9th Marquess of Castellbell, (29 January 1920 – 30 August 2007) was a Spanish actor, author and aristocrat who rose to prominence when he co-starred with Audrey Hepburn in Breakfast at Tiffany's, and Julie Christie in Darling.  . . . \n\nSource: Article \"José Luis de Vilallonga, 9th Marquess of Castellbell\" from Wikipedia in english, licensed under CC-BY-SA 3. 0...", died:date('2007-08-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/t839BL2ATwMtud1aZynu6v7W4J3.jpg", url:"https://themoviedb.org/person/1942"}}, {tmdbId:"5004", properties:{bornIn:"Alexandria, Egypt", imdbId:"0001725", born:date('1932-04-10'), name:"Omar Sharif", bio:"Omar Sharif, the Franco-Arabic actor best known for playing Sherif Ali in Lawrence of Arabia (1962) and the title role in Doctor Zhivago (1965), was born Michel Demitri Shalhoub on April 10, 1932 in Alexandria, Egypt to Joseph Shalhoub, a lumber merchant, and his wife, Claire.  Of Lebanese and Syrian extraction, the young Michel was raised a Roman Catholic.  He was educated at Victoria College in Alexandria and took a degree in mathematics and physics from Cairo University with a major...", died:date('2015-07-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pnDxqehpEwmJhXdS3SMxKCfDuHD.jpg", url:"https://themoviedb.org/person/5004"}}, {tmdbId:"400", properties:{bornIn:"Santa Monica, California, United States", imdbId:"0001036", born:date('1944-07-31'), name:"Geraldine Chaplin", bio:" Geraldine Leigh Chaplin is an English-American actress and writer.  The daughter of Charlie Chaplin and Oona O'Neill.   Geraldine has appeared in a large number of critically acclaimed English, French, and Spanish language films.  Her film debut was in \"Limelight\" (1952) and breakthrough in David Lean's  \"Doctor Zhivago\" (1965) as Tonya...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/teiPgoY0Fgyw4Xs07IGDsJmcsjL.jpg", url:"https://themoviedb.org/person/400"}}, {tmdbId:"113656", properties:{bornIn:"Wenatchee, Washington, USA", imdbId:"0366537", born:date('1941-06-02'), name:"Susan Hart", bio:"Susan Hart (born June 2, 1941) is an American actress, and the widow of American International Pictures (AIP) co-founder James H.  Nicholson...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AjR6cE8Hkm4d0XheRBSmlqspQ5t.jpg", url:"https://themoviedb.org/person/113656"}}, {tmdbId:"4592", properties:{bornIn:"Hokkaido, Japan", imdbId:"0766100", born:date('1938-07-10'), name:"Tura Satana", bio:"From Wikipedia, the free encyclopedia. \n\nTura Satana (July 10, 1938 – February 4, 2011) was a Japanese-born American actress and former exotic dancer.  She was best known for her role as \"Varla\" in Russ Meyer's 1965 cult film, Faster, Pussycat! Kill! Kill!. \n\nDescription above from the Wikipedia article Tura Satana, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2011-02-04'), url:"https://themoviedb.org/person/4592"}}, {tmdbId:"4593", properties:{bornIn:"Québec, Canada", imdbId:"0354486", born:date('1946-01-24'), name:"Haji", bio:"From Wikipedia, the free encyclopedia. \n\nHaji (born January 24, 1946 ) is a Canadian-born actress and former exotic dancer known for her role in the Russ Meyer's 1965 cult classic Faster, Pussycat! Kill! Kill!.  She has made significant contributions to her work by introducing new elements of psychedelia and witchcraft as well as writing most of her own dialogue. \n\nDescription above from the Wikipedia article Haji(actress), licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2013-08-09'), url:"https://themoviedb.org/person/4593"}}, {tmdbId:"4594", properties:{bornIn:"Pittsburgh, Pennsylvania, USA", imdbId:"0931186", born:date('1946-03-23'), name:"Lori Williams", bio:"Lori Williams is an American actress best known for her performance in the 1965 cult film \"Faster, Pussycat! Kill! Kill!\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ifd9tLK9Gf8Nb3T7EB0U9oDl45J.jpg", url:"https://themoviedb.org/person/4594"}}, {tmdbId:"4599", properties:{imdbId:"0055274", name:"Ray Barlow", url:"https://themoviedb.org/person/4599"}}, {tmdbId:"21461", properties:{bornIn:"Minneapolis, Minnesota", imdbId:"0821651", born:date('1940-05-20'), name:"Joan Staley", died:date('2019-11-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/797rTn855MrssomdrwOiKjtV4vR.jpg", url:"https://themoviedb.org/person/21461"}}, {tmdbId:"83827", properties:{bornIn:"Limerick, Ireland, UK [now Republic of Ireland]", imdbId:"0715068", born:date('1913-07-27'), name:"Liam Redmond", died:date('1989-10-31'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/teRUJ5ZQ7wnACrhTeVtL9VBPdNY.jpg", url:"https://themoviedb.org/person/83827"}}, {tmdbId:"41250", properties:{bornIn:"Carmel-by-the-Sea, California, USA", imdbId:"0765102", born:date('1930-04-19'), name:"Dick Sargent", bio:"Dick Sargent (April 19, 1930 – July 8, 1994) was an American actor, notable as the second actor to portray Darrin Stephens on Bewitched...", died:date('1994-07-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gMTyoOSBdDdMoITSmM8IgkHYfyc.jpg", url:"https://themoviedb.org/person/41250"}}, {tmdbId:"39019", properties:{bornIn:"Montecchio Emilia", imdbId:"0685609", born:date('1910-05-21'), name:"Mario Pisu", died:date('1976-07-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9nEleEKOn0IVbRINF9vmywBgKBr.jpg", url:"https://themoviedb.org/person/39019"}}, {tmdbId:"24499", properties:{bornIn:"Milan, Lombardy, Italy", imdbId:"0181305", born:date('1923-01-01'), name:"Valentina Cortese", bio:"From Wikipedia, the free encyclopedia\n\nValentina Cortese (January 1, 1923 - July 10, 2019) was an Italian film actress. \n\nThe Milan-born actress starred in The House on Telegraph Hill (1951) directed by Robert Wise, and costarring Richard Basehart and William Lundigan.  Cortese, aged 28, married Basehart in 1951, and had one son with him before they divorced in 1960...", died:date('2019-07-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a4prl8bh38RmHhEywH512VKvHVb.jpg", url:"https://themoviedb.org/person/24499"}}, {tmdbId:"2314", properties:{bornIn:"New York City, New York, USA", imdbId:"0000393", born:date('1927-09-16'), name:"Peter Falk", bio:"Peter Michael Falk  (September 16, 1927 – June 23, 2011) was an American actor and comedian.  He best known for his role as Lieutenant Columbo in the television series Columbo (1968–2003), which earned him four Primetime Emmy Awards and a Golden Globe Award. \n\nFalk was twice nominated for the Academy Award for Best Supporting Actor, for Murder, Inc.  (1960) and Pocketful of Miracles (1961)...", died:date('2011-06-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5HhzU8ErKK5tUSRMUAE8P4n26C0.jpg", url:"https://themoviedb.org/person/2314"}}, {tmdbId:"24808", properties:{bornIn:"Hillingdon, Middlesex, England, UK", imdbId:"0026295", born:date('1943-08-06'), name:"Michael Anderson Jr.", bio:"​From Wikipedia, the free encyclopedia.   \n\nMichael Joseph Anderson, Jr.  (born 6 August 1943) is an English actor.  He was born in Hillingdon, Middlesex, into a theatrical family.  His grandparents and great-great-aunt were acclaimed actors.  His father is the film director Michael Anderson, Sr.  Anderson trained at the Arts Educational School in drama and ballet...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Qxish60xARThkvt939V7wnFE1F.jpg", url:"https://themoviedb.org/person/24808"}}, {tmdbId:"52754", properties:{bornIn:"Biloxi, Mississippi, U.S.", imdbId:"0595039", born:date('1939-02-17'), name:"Mary Ann Mobley", bio:"From Wikipedia, the free encyclopedia. \n\nMary Ann Mobley (born February 17, 1939) is a former Miss America, actress, and television personality. \n\nDescription above from the Wikipedia article Mary Ann Mobley, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2014-12-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/u1eEInod9iDWzbZLc7C27PerJn5.jpg", url:"https://themoviedb.org/person/52754"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"52755", properties:{bornIn:"San Jose, California, United States", imdbId:"0420364", born:date('1937-05-18'), name:"Fran Jeffries", bio:"From Wikipedia, the free encyclopedia. \n\nFran Jeffries (born May 18, 1937) is an American singer, actress, and model. \n\nDescription above from the Wikipedia article Fran Jeffries, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2016-12-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qrIHfF1Myis2pxgPxhNrLVuWI3e.jpg", url:"https://themoviedb.org/person/52755"}}, {tmdbId:"7192", properties:{bornIn:"Sydney, New South Wales, Australia", imdbId:"0571674", born:date('1920-03-16'), name:"Leo McKern", bio:"From Wikipedia, the free encyclopedia\n\nReginald \"Leo\" McKern, AO (16 March 1920 – 23 July 2002) was an Australian-born English actor who appeared in numerous British and Australian television programmes and movies, and more than 200 stage roles. \n\nDescription above from the Wikipedia article leo McKern, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2002-07-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gcqIJDivizystkS4cwPBQKod2eU.jpg", url:"https://themoviedb.org/person/7192"}}, {tmdbId:"45453", properties:{bornIn:"Stanmore, Middlesex, England, UK", imdbId:"0111376", born:date('1938-03-14'), name:"Eleanor Bron", bio:"From Wikipedia, the free encyclopedia.   Eleanor Bron (born 14 March 1938 ) is an English stage, film and television actress and author. \n\nDescription above from the Wikipedia article Eleanor Bron, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xwU4UyXG92RpJ4ptbklkT8TtiX.jpg", url:"https://themoviedb.org/person/45453"}}, {tmdbId:"10598", properties:{bornIn:"Cwm, Ebbw Vale, Monmouthshire, Wales", imdbId:"0818920", born:date('1933-09-02'), name:"Victor Spinetti", bio:"Victor Sinetti (born Vittorio Giorgio Andre Spinetti) was a Welsh comedy actor, author and poet.  He appeared in dozens of films and stage plays throughout his 50-year career, including the three 1960s Beatles films \"A Hard Day's Night\", \"Help!\" and \"Magical Mystery Tour\". \n\nBorn in Cwm, Ebbw Vale, Wales, Spinetti was educated at Monmouth School and the Royal Welsh College of Music and Drama in Cardiff, of which he became a Fellow...", died:date('2012-06-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bcanHW2duY9o0k724FhYa4D4a6h.jpg", url:"https://themoviedb.org/person/10598"}}, {tmdbId:"9865", properties:{bornIn:"Alameda, California, USA", imdbId:"0002063", born:date('1911-10-27'), name:"Leif Erickson", bio:"From Wikipedia, the free encyclopedia\n\nLeif Erickson (born William Wycliffe Anderson) was an American stage, film, and television actor. \n\nErickson was born in Alameda, California, near San Francisco.  He worked as a soloist in a band as vocalist and trombone player, performed in Max Reinhardt's productions, and then gained a small amount of stage experience in a comedy vaudeville act...", died:date('1986-01-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tQGDVHClfK6KRwBowcfZfwnvjOk.jpg", url:"https://themoviedb.org/person/9865"}}, {tmdbId:"153754", properties:{imdbId:"0485542", born:date('1949-03-12'), name:"Sara Lane", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/66U2syRat57pX0IEjge7v06xLKQ.jpg", url:"https://themoviedb.org/person/153754"}}, {tmdbId:"3895", properties:{bornIn:"Rotherhithe, London, England, UK", imdbId:"0000323", born:date('1933-03-14'), name:"Michael Caine", bio:"Sir Michael Caine is an English film actor.  He became known for several notable critically acclaimed performances, particularly in films such as Zulu (1964), The Italian Job (1969), Get Carter (1971), Educating Rita (1983) and more recently Batman Begins and The Dark Knight.  Caine was knighted in 2000 by Queen Elizabeth II, in recognition of his contribution to cinema...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9u3wXvlMROOF5FpC0ITasQVLJHX.jpg", url:"https://themoviedb.org/person/3895"}}, {tmdbId:"29909", properties:{bornIn:"Pretoria, South Africa", imdbId:"0338210", born:date('1924-10-15'), name:"Nigel Green", bio:"From Wikipedia, the free encyclopedia. \n\nNigel Green (15 October 1924 – 15 May 1972) was a South African-born British character actor.  Because of his strapping build and commanding demeanour he would often be found playing military types and men of action in such classic sixties films as Jason and the Argonauts, Zulu, Tobruk and The Ipcress File. \n\nDescription above from the Wikipedia article Nigel Green, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1972-05-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aBiU6YMvmzlpw97IhGlm0q7B8y.jpg", url:"https://themoviedb.org/person/29909"}}, {tmdbId:"9923", properties:{imdbId:"0230934", born:date('1923-11-22'), name:"Guy Doleman", died:date('1996-01-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/711aHwTIEAflJQAiSd3DR1MVW53.jpg", url:"https://themoviedb.org/person/9923"}}, {tmdbId:"47849", properties:{imdbId:"0516145", born:date('1939-08-07'), name:"Sue Lloyd", died:date('2011-10-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/18yoxnx7jVNnUJfVV2Mz4Ex7fei.jpg", url:"https://themoviedb.org/person/47849"}}, {tmdbId:"18364", properties:{bornIn:"Great Neck, New York, USA", imdbId:"0001719", born:date('1934-02-13'), name:"George Segal", bio:"George Segal (born February 13, 1934) is an American actor and musician. \n\nSegal became popular in the 1960s and 1970s for playing both dramatic and comedic roles.  Some of his most acclaimed roles are in films such as Ship of Fools (1965), King Rat (1965), Who's Afraid of Virginia Woolf? (1966), The St...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3igs7Zt50q0rRjlbEA9si0bteOd.jpg", url:"https://themoviedb.org/person/18364"}}, {tmdbId:"54123", properties:{bornIn:"Ocala, Florida USA", imdbId:"0641929", born:date('1927-09-26'), name:"Patrick O'Neal", bio:"Patrick O'Neal (September 26, 1927 – September 9, 1994) was an American television, stage and film actor.  He was also a successful New York restaurateur. \n\nDescription above from the Wikipedia article Patrick O'Neal, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1994-09-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/65jCII8zQwkYrhDGdz0ZSshWPsc.jpg", url:"https://themoviedb.org/person/54123"}}, {tmdbId:"233289", properties:{imdbId:"0436706", born:date('1899-09-18'), name:"Ida Kaminska", bio:"From Wikipedia\n\nIda Kamińska (September 18, 1899 – May 21, 1980) was an\n\nAcademy Award-nominated actress. \n\nIda Kamińska began a stage career at the age of five.  Her\n\nfirst theater role was in 1912 in Mirele Efros, with her mother and her sister\n\nin other roles in the play. \n\nIn 1965, she starred in the Czechoslovak movie The Shop on\n\nMain Street (Obchod na korze, directed by Ján Kadár and Elmar Klos), and she\n\nreceived a 1966 nomination for the Academy Award for Best Actress in a Leading\n\nRole...", died:date('1980-05-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ySylg2YgF0ARAepvfz3yN4ELja0.jpg", url:"https://themoviedb.org/person/233289"}}, {tmdbId:"124143", properties:{bornIn:"Staškov, Czechoslovakia", imdbId:"0472166", born:date('1924-03-20'), name:"Jozef Kroner", bio:"Pochádza z dvanástich detí.  Začínal ako robotník v Trenčíne, neskôr ako vedúci dielne v Považskej Bystrici.  Popri práci sa venoval ochotníckemu divadlu.  Začínal v Armádnom divadle v Martine (1948 - 1956).  Od roku 1956 pôsobil v činohre SND v Bratislave až do roku 1984, keď odišiel do dôchodku...", died:date('1998-03-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8HVMJuNljHbSbmFbd66geNQygfr.jpg", url:"https://themoviedb.org/person/124143"}}, {tmdbId:"1290919", properties:{bornIn:"Rajec, Czechoslovakia", imdbId:"0805908", born:date('1923-08-21'), name:"Hana Slivková", died:date('1984-01-03'), url:"https://themoviedb.org/person/1290919"}}, {tmdbId:"2388515", properties:{imdbId:"0391411", born:date('1904-06-08'), name:"Martin Hollý", died:date('1965-10-01'), url:"https://themoviedb.org/person/2388515"}}, {tmdbId:"86690", properties:{bornIn:"Sverdlovsk, Sverdlovskaya oblast, RSFSR, USSR [now Ekaterinburg, Russia]", imdbId:"0218849", born:date('1937-05-30'), name:"Aleksandr Demyanenko", bio:"Aleksandr S.  Demyanenko (May 30, 1937 – August 22, 1999) was a Russian film and theater actor.  He was given the honorary distinction of People's Artist of the RSFSR.  He began his acting career with the film \"Veter\" in 1958, and is well known for playing the character Shurik in a number of films, beginning with the 1965 comedy \"Operation Y and Other Shurik's Adventures\", and ending with the 1997 film \"Old Songs of the Main Things 2\"...", died:date('1999-08-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/b9nqCzPYFYrESqBHkVTIkUVXBmF.jpg", url:"https://themoviedb.org/person/86690"}}, {tmdbId:"1190217", properties:{bornIn:"Danilov, Yaroslavl Governorate, RSFSR [now Yaroslavl Oblast, Russia]", imdbId:"0807032", born:date('1920-02-28'), name:"Aleksei Smirnov", died:date('1979-05-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qryxfxW2jDkVLj4rcuseEG65F4K.jpg", url:"https://themoviedb.org/person/1190217"}}, {tmdbId:"1190398", properties:{bornIn:"Urazovo, Kurskaya guberniya, RSFSR, USSR", imdbId:"0060002", born:date('1923-06-28'), name:"Vladimir Basov", bio:"Soviet film director, screenwriter, actor.  Honored Artist of the RSFSR (03. 17. 1964).  People's Artist of the RSFSR (7. 01. 1977).  People's Artist of the USSR (10/14/1983).  Vladimir Basov went to the front in July 1941.  First, the lieutenant of the quartermaster’s service, Basov served as the head of the club of the 4th Separate Rifle Brigade, for the excellent organization of amateur performances in combat conditions, he was awarded the medal \"For Military Merit\"...", died:date('1987-09-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wll2eZHIBamgv1b3F7h4OwGmgcQ.jpg", url:"https://themoviedb.org/person/1190398"}}, {tmdbId:"86699", properties:{bornIn:"Yekaterinoslav, Yekaterinoslav uyezd, Yekaterinoslav Governorate, Russian Empire [now Dnipropetrovsk, Dnipropetrovsk Oblast, Ukraine]", imdbId:"0312374", born:date('1898-08-08'), name:"Emmanuil Geller", died:date('1990-05-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fJ1N2ZgMdF1eKQ7jAUCZI9R57Uv.jpg", url:"https://themoviedb.org/person/86699"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"70286", properties:{bornIn:"Youngstown, Ohio, U.S.", imdbId:"0366946", born:date('1943-12-23'), name:"Elizabeth Hartman", bio:"From Wikipedia, the free encyclopedia\n\nMary Elizabeth Hartman (December 23, 1943 – June 10, 1987) was an American actress, best known for her performance in the 1965 film A Patch of Blue, playing a blind girl named Selina D'Arcy, opposite Sidney Poitier, a role for which she won the Golden Globe Award for New Star Of The Year - Actress and was nominated for the Academy Award for Best Actress and Golden Globe Award for Best Actress – Motion Picture Drama...", died:date('1987-06-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gEgpys9T1L9hZg2CfFq9WnFNcgJ.jpg", url:"https://themoviedb.org/person/70286"}}, {tmdbId:"2112", properties:{bornIn:"New York City, New York, USA", imdbId:"0676349", born:date('1927-07-02'), name:"Brock Peters", bio:"Brock Peters or Brock G.  Peters (born George Fisher; July 2, 1927 – August 23, 2005) was an American actor, best known for playing the role of Tom Robinson in the 1962 film To Kill a Mockingbird and for his role as \"Crown\" in the 1959 film version of Porgy and Bess.  In later years, he gained recognition among Star Trek fans for his portrayals of Fleet Admiral Cartwright in two of the Star Trek feature films and Joseph Sisko, father of Benjamin Sisko, in Star Trek: Deep Space Nine...", died:date('2005-08-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/k1aKUkQD7LLfitgbhCAlxyUjcSY.jpg", url:"https://themoviedb.org/person/2112"}}, {tmdbId:"8257", properties:{bornIn:"Rincón, Puerto Rico", imdbId:"0844969", born:date('1938-12-19'), name:"Jaime Sánchez", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jqqdVlOGVNokKXz6NTrlM7cuOOr.jpg", url:"https://themoviedb.org/person/8257"}}, {tmdbId:"4078", properties:{bornIn:"Somerville, New Jersey, USA", imdbId:"0001812", born:date('1925-01-09'), name:"Lee Van Cleef", bio:"Was an American actor best known for his roles in Spaghetti Westerns such as For A Few Dollars More and The Good, the Bad and the Ugly.  Hatchet-faced with piercing eyes, he had declined to have his nose altered to play a sympathetic character in his film debut, High Noon, and was relegated to a non-speaking outlaw as a result.  For a decade he was typecast as a minor villain, his sinister features[peacock term] overshadowing his acting skills...", died:date('1989-12-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/prcDQR2pp0b92j0G8rnX5kQeQk0.jpg", url:"https://themoviedb.org/person/4078"}}, {tmdbId:"16318", properties:{imdbId:"0103828", born:date('1923-03-05'), name:"Mario Brega", bio:"Mario Brega (25 March 1923 – 23 July 1994) was an Italian actor.  His heavy build meant that he regularly portrayed a thug in his films, particularly earlier in his career in westerns.  Later in his career, however, he featured in numerous Italian comedy films.  Brega stood at 6 feet 2 inches (1. 88 m) and well over 250 pounds (110 kg) at his heaviest but after the 1960s slimmed down significantly...", died:date('1994-07-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/anV1dBcJDSkL8OaUoSqBoAU7FPK.jpg", url:"https://themoviedb.org/person/16318"}}, {tmdbId:"12773", properties:{imdbId:"0303413", born:date('1931-06-27'), name:"Graziella Galvani", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2DQ7oKEtVaEDewcILSmpgh9hx7L.jpg", url:"https://themoviedb.org/person/12773"}}, {tmdbId:"32827", properties:{bornIn:"Bogotá, Colombia", imdbId:"0144589", born:date('1943-05-28'), name:"Lou Castel", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dDgmPiktEDdqVM7irx9bHwWZZb3.jpg", url:"https://themoviedb.org/person/32827"}}, {tmdbId:"36909", properties:{bornIn:"Parma, Emilia-Romagna, Italy", imdbId:"0685632", born:date('1941-08-24'), name:"Paola Pitagora", url:"https://themoviedb.org/person/36909"}}, {tmdbId:"39151", properties:{bornIn:"Triestre, Italy", imdbId:"0166706", born:date('1939-03-21'), name:"Marino Masé", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1rd8gmQnjvYFXjnrfYEpuOZzYUB.jpg", url:"https://themoviedb.org/person/39151"}}, {tmdbId:"620108", properties:{imdbId:"0313838", name:"Liliana Gerace", url:"https://themoviedb.org/person/620108"}}, {tmdbId:"69555", properties:{bornIn:"Glasgow, Scotland, UK", imdbId:"0292159", born:date('1931-03-18'), name:"John Fraser", bio:"From Wikipedia, the free encyclopedia\n\nJohn Alexander Fraser (born 18 March 1931) is a retired Scottish actor and author.  He is best known for his performances in the films The Good Companions (1957), The Trials of Oscar Wilde (1960), El Cid (1961), Repulsion (1965), and Isadora (1968). \n\nOne of his earliest roles was as Inigo Jollifant in the second film version of J.  B.  Priestley's The Good Companions (1957)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jt0zvelWHNjg6sWYO75kvg0IDMa.jpg", url:"https://themoviedb.org/person/69555"}}, {tmdbId:"88811", properties:{bornIn:"Calcutta, West Bengal, India", imdbId:"0004434", born:date('1938-03-18'), name:"Shashi Kapoor", bio:"From Wikipedia, the free encyclopedia  \n\n  Shashi Kapoor (born Balbir Raj Prithviraj Kapoor on 18 March 1938 in Calcutta (now Kolkata), was an award-winning Indian film actor and film producer.  He was also a film director and assistant director in Hindi Films.  He was a member of the Kapoor family, a film dynasty in India's Bollywood cinema...", died:date('2017-12-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3VNvZHYnvqz0IKYl3QRyqlVW2AN.jpg", url:"https://themoviedb.org/person/88811"}}, {tmdbId:"200632", properties:{bornIn:"Olton, West Midlands, England, UK", imdbId:"0447555", born:date('1946-09-25'), name:"Felicity Kendal", bio:"Felicity Ann Kendal CBE is an English actress, working in television and theatre.  She has appeared in numerous stage and screen roles over a more than 50-year career, but the role that brought attention to her career was that of Barbara Good in the 1975 television series The Good Life...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a1xyqfXKoMHfuFqZCAtjBFLyqmZ.jpg", url:"https://themoviedb.org/person/200632"}}, {tmdbId:"1013094", properties:{imdbId:"0447556", name:"Geoffrey Kendal", url:"https://themoviedb.org/person/1013094"}}, {tmdbId:"1581090", properties:{imdbId:"0509174", name:"Laura Liddell", url:"https://themoviedb.org/person/1581090"}}, {tmdbId:"50967", properties:{bornIn:"Glendale, California, U.S.", imdbId:"0565982", born:date('1935-05-11'), name:"Doug McClure", bio:"Douglas Osborne \"Doug\" McClure was an American actor whose career in film and television extended from the 1950s to the 1990s.  He is best known for his role as the cowboy Trampas during the entire run from 1962 to 1971 of the NBC western television series, The Virginian, loosely based on the Owen Wister novel...", died:date('1995-02-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ptIQMQhw5h5Rra0gefzF8OfS2JF.jpg", url:"https://themoviedb.org/person/50967"}}, {tmdbId:"15968", properties:{imdbId:"0179148", born:date('1933-08-17'), name:"Glenn Corbett", died:date('1993-01-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eP1tCSppXS51gYysmVAFJvKliCF.jpg", url:"https://themoviedb.org/person/15968"}}, {tmdbId:"30560", properties:{bornIn:" Los Angeles, California, United States", imdbId:"0915618", born:date('1939-07-15'), name:"Patrick Wayne", bio:"​From Wikipedia, the free encyclopedia.   \n\nPatrick John Morrison, better known by his stage name Patrick Wayne (born July 15, 1939), is an American actor, the second son of movie star John Wayne and his first wife, Josephine Alicia Saenz.  He made over 40 films in his career, including nine with his father.  In addition, Patrick Wayne held a role as the host of a 1990 revival of the television game show Tic-Tac-Dough and hosted the short-lived \"Monte Carlo Show\" in 1980...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gyxXHnl7YvkKhdWakr3IXu0nK62.jpg", url:"https://themoviedb.org/person/30560"}}, {tmdbId:"145272", properties:{bornIn:" Guadalajara, Jalisco, Mexico", imdbId:"0959341", born:date('1935-04-05'), name:"Enrique Álvarez Félix", bio:"Enrique Álvarez Félix was born in 1934 in Mexico.  He was the son of Mexican actress María Félix and her first husband, Enrique Álvarez Alatorre.  When his parents divorced in 1938, his mother lived for a time at home with her own parents until 1939, when she traveled with Enrique to Mexico City.  Soon after, her ex-husband took Enrique.  He never married, but was a stepson of Jorge Negrete and stepbrother of Diana Negrete...", died:date('1996-05-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/orpt4yggeQIaWaIq7QwIpJgSGZg.jpg", url:"https://themoviedb.org/person/145272"}}, {tmdbId:"145273", properties:{imdbId:"0764326", name:"Hortensia Santoveña", url:"https://themoviedb.org/person/145273"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"290", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"0001626", born:date('1929-12-13'), name:"Christopher Plummer", bio:"Arthur Christopher Orme Plummer CC (born December 13, 1929) is a Canadian theatre, film and television actor.  He made his film debut in 1958's Stage Struck, and notable film performances include The Night of the Generals, The Return of the Pink Panther, Star Trek VI: The Undiscovered Country, The Man Who Would Be King, and The Insider...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iZh3s9Vy9vYD4DYnAda6C1kdeco.jpg", url:"https://themoviedb.org/person/290"}}, {tmdbId:"40393", properties:{bornIn:"Decatur, Alabama, USA", imdbId:"0427894", born:date('1931-01-25'), name:"Dean Jones", bio:"Dean Jones (1931–2015) was an American actor.  Jones is best known for his leading roles in several Walt Disney movies between 1965 and 1977, most notably The Love Bug...", died:date('2015-09-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dZKNpJxKSWFyBf03URGD3UrtiRd.jpg", url:"https://themoviedb.org/person/40393"}}, {tmdbId:"29717", properties:{bornIn:"Deadwood, South Dakota, USA", imdbId:"0699063", born:date('1937-01-20'), name:"Dorothy Provine", bio:"Dorothy Provine (1935–2010) was an American singer, dancer, actress, and comedienne...", died:date('2010-04-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4mOVRmJDkrlag2ogWhQnfwtlprc.jpg", url:"https://themoviedb.org/person/29717"}}, {tmdbId:"30618", properties:{bornIn:"Evanston, Illinois, USA", imdbId:"0364455", born:date('1935-07-25'), name:"Barbara Harris", bio:"From Wikipedia, the free encyclopedia\n\nBarbara Harris (July 25, 1935-August 21, 2018) was an American actress who was a Broadway stage star and later became a film actress.  She appeared in such films as A Thousand Clowns, Plaza Suite, Nashville, Family Plot, Freaky Friday, Peggy Sue Got Married, and Grosse Pointe Blank.  Harris won a Tony Award,  was nominated for an Academy Award and received four Golden Globe Award nominations...", died:date('2018-08-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lbXPbbbSWb8KZKKU3R84Mss4c2.jpg", url:"https://themoviedb.org/person/30618"}}, {tmdbId:"9919", properties:{bornIn:" Paris, France", imdbId:"0000805", born:date('1941-04-26'), name:"Claudine Auger", bio:"From Wikipedia, the free encyclopedia\n\nClaudine Auger (born Claudine Oger; 26 April 1941 – 18 December 2019) was a French actress best known for her role as Bond girl Dominique \"Domino\" Derval in the James Bond film Thunderball (1965).  She earned the title of Miss France Monde (the French representative of Miss World) and was also the first runner-up in the 1958 Miss World contest. \n\nAuger was born in Paris, France.  She made her film debut when still in school...", died:date('2019-12-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1KAAUhgfVxdI5g2t0YFCG9ITrvi.jpg", url:"https://themoviedb.org/person/9919"}}, {tmdbId:"9920", properties:{bornIn:"Messina, Sicily, Italy", imdbId:"0148041", born:date('1922-07-27'), name:"Adolfo Celi", bio:"From Wikipedia, the free encyclopedia\n\nAdolfo Celi (27 July 1922 –19 February 1986) was an Italian film actor and director...", died:date('1986-02-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wliSD0lORE0Ow7Vb0WotHzYnEWB.jpg", url:"https://themoviedb.org/person/9920"}}, {tmdbId:"9921", properties:{bornIn:"Rome, Italy", imdbId:"0658885", born:date('1937-06-10'), name:"Luciana Paluzzi", bio:"Luciana Paluzzi (born June 10, 1937 in Rome, Italy) is an Italian actress.  She is best known for playing SPECTRE assassin Fiona Volpe in the fourth James Bond film, Thunderball. \n\nDescription above from the Wikipedia article Luciana Paluzzi, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cmmcMZGO5RlA32Btw07GzutK2nb.jpg", url:"https://themoviedb.org/person/9921"}}, {tmdbId:"66610", properties:{bornIn:" London, England, UK", imdbId:"0791774", born:date('1936-08-12'), name:"Elizabeth Shepherd", bio:"​From Wikipedia, the free encyclopedia. \n\nElizabeth Shepherd  (born 12 August 1936) is an English character actress whose work has spanned the stage and both the big and small screens.  Her surname has been alternately billed as \"Shephard\" and \"Sheppard\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3PdsbzGJ2zokEhSOgNl8dO74Uja.jpg", url:"https://themoviedb.org/person/66610"}}, {tmdbId:"101512", properties:{bornIn:"Teignmouth, England, UK", imdbId:"0922462", born:date('1922-11-01'), name:"John Westbrook", bio:"​From Wikipedia, the free encyclopedia. \n\nJohn Westbrook  (1 November 1922 - 16 June 1989) was an English actor. \n\nBorn in Teignmouth, Devon, John Westbrook worked mainly in theatre and in radio.  He also made occasional film and television appearances.  His most famous role was as Christopher Gough in Roger Corman's The Tomb of Ligeia...", died:date('1989-06-16'), url:"https://themoviedb.org/person/101512"}}, {tmdbId:"101529", properties:{bornIn:"Brighton, East Sussex, England, UK", imdbId:"0290136", born:date('1923-11-07'), name:"Derek Francis", bio:"​From Wikipedia, the free encyclopedia. \n\nDerek Francis  (born 7 November 1923 in Brighton - died 27 March 1984 in Wimbledon, London) was an English comedy and character actor...", died:date('1984-03-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eE02sSKBJ5kgkS3f2tdtXoUpB68.jpg", url:"https://themoviedb.org/person/101529"}}, {tmdbId:"93124", properties:{bornIn:"Bologna, Italy", imdbId:"0141123", born:date('1943-06-18'), name:"Raffaella Carrà", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hJKizkJSge1BL38CDoGQnIcP8LS.jpg", url:"https://themoviedb.org/person/93124"}}, {tmdbId:"6250", properties:{bornIn:"Vienna, Austria", imdbId:"0002769", born:date('1938-09-23'), name:"Romy Schneider", bio:"Romy Schneider (born Rosemarie Magdalena Albach, 23 September 1938 – 29 May 1982) was a German-French actress.  She began her career in the German Heimatfilm genre in the early 1950s when she was 15.  From 1955 to 1957, she played the central character of Empress Elisabeth of Austria in the Austrian Sissi trilogy, and later reprised the role in a more mature version in Visconti's Ludwig (1973)...", died:date('1982-05-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lAH90VMs5iU7kGJR3LSkre2Jxhe.jpg", url:"https://themoviedb.org/person/6250"}}, {tmdbId:"162896", properties:{bornIn:"Romford, Essex, England, UK", imdbId:"0552815", born:date('1934-06-08'), name:"Millicent Martin", bio:"Millicent Martin is an English actress, singer and comedienne...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/thRIWICkmqm1ejtDPrGGbCSeRug.jpg", url:"https://themoviedb.org/person/162896"}}, {tmdbId:"79361", properties:{bornIn:"Lewes, Sussex, England, UK", imdbId:"0287905", born:date('1943-08-02'), name:"Julia Foster", bio:"From Wikipedia, the free encyclopedia\n\nJulia Foster (born 2 August 1943 in Lewes, Sussex, England) is a British actress. \n\nFoster's credits include the films The Bargee (1964) with Harry H.  Corbett, Alfie (1966) with Michael Caine, Half a Sixpence (1967) with Tommy Steele, and Percy (1971) with Hywel Bennett...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kr45R39ia0pZ9nLfCIuUr444WaG.jpg", url:"https://themoviedb.org/person/79361"}}, {tmdbId:"8475", properties:{bornIn:"Bogorodsk, Gorkovskaya oblast, RSFSR, USSR", imdbId:"0813463", born:date('1934-08-30'), name:"Anatoliy Solonitsyn", bio:"From Wikipedia, the free encyclopedia\n\nAnatoly Alekseyevich Solonitsyn (30 August 1934, Bogorodsk – 11 June 1982, Moscow) was a Soviet actor. \n\nDescription above from the Wikipedia article Anatoly Solonitsyn, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1982-06-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dE4Q10xL0DGS2u8ISkoxTSRQKub.jpg", url:"https://themoviedb.org/person/8475"}}, {tmdbId:"13706", properties:{imdbId:"0487553", born:date('1922-07-07'), name:"Ivan Lapikov", died:date('1993-05-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/neIQgfxYvSl2ZBzXfKgV8BqyWeq.jpg", url:"https://themoviedb.org/person/13706"}}, {tmdbId:"1190992", properties:{bornIn:"Kherson, USSR (Ukraine)", imdbId:"0342458", born:date('1920-05-22'), name:"Nikolay Grinko", bio:"Nikolai Grigoryevich Grinko or Mykola Hryhorovych Hrynko (Ukrainian: Микола Григорович Гринько; Russian: Николай Григорьевич Гринько) was a Soviet and Ukrainian actor. \n\nHis film debut was in the role of a rebel in the film \"Taras Shevchenko\" by Igor Savchenko.  He is best known for his roles in the films of Andrei Tarkovsky, including: Ivan's Childhood, Andrei Rubliov, Solaris, Mirror, and Stalker, as well as Sergei Parajanov's \"Shadows of Forgotten Ancestors\"...", died:date('1989-04-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dvX2MO5Ewbymaz6CUl0egFulPaB.jpg", url:"https://themoviedb.org/person/1190992"}}, {tmdbId:"13707", properties:{imdbId:"0785108", born:date('1894-12-04'), name:"Nikolay Sergeev", died:date('1988-01-08'), url:"https://themoviedb.org/person/13707"}}, {tmdbId:"18227", properties:{bornIn:"Berlin, West Germany", imdbId:"0926723", born:date('1947-05-14'), name:"Anne Wiazemsky", bio:"From Wikipedia, the free encyclopedia. \n\nPrincess Anne Wiazemsky (14 May 1947 - 5 October 2017) was a French actress, of the Russian Rurikid family of Princes Vyazemsky-Counts Levashov.  Through her mother, she is the granddaughter of François Mauriac.  She appeared in Robert Bresson's Au hasard Balthazar (1966) and in Godard's films La Chinoise (1967) and Week End (1967).  She was married to Jean-Luc Godard between 1967 and 1979; they divorced. \n\nWiazemsky is also an author...", died:date('2017-10-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mASxFjP3nO94adABKOTlZOutpAP.jpg", url:"https://themoviedb.org/person/18227"}}, {tmdbId:"143032", properties:{imdbId:"0338398", name:"Walter Green", url:"https://themoviedb.org/person/143032"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"143033", properties:{imdbId:"0480711", name:"François Lafarge", url:"https://themoviedb.org/person/143033"}}, {tmdbId:"17590", properties:{imdbId:"0346903", born:date('1942-01-01'), name:"Jean-Claude Guilbert", url:"https://themoviedb.org/person/17590"}}, {tmdbId:"26847", properties:{bornIn:"Walla Walla, Washington, USA", imdbId:"0001842", born:date('1928-09-19'), name:"Adam West", bio:"Adam West (September 19, 1928 - June 9, 2017) was an American actor best known for his lead role in the Batman (1966–68) TV series and the film of the same name.  He was also known for portraying eccentric characters, as well as his voice work on animated series such as The Fairly OddParents and as the fictionalized version of himself on Family Guy. \n\nDescription above from the Wikipedia article Adam West, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2017-06-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a3Yw8bb6AF7a8Zr7IyEZhZxWVWN.jpg", url:"https://themoviedb.org/person/26847"}}, {tmdbId:"35192", properties:{bornIn:" Los Angeles, California, USA", imdbId:"0911431", born:date('1945-07-06'), name:"Burt Ward", bio:"An American television actor and activist.  He is best known for his portrayal of Robin in the television series Batman (1966–68) and its theatrical film spin-off. \n\nDescription above from the Wikipedia article Burt Ward, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9mXSBunzhcx239hy23s7dQrKcP.jpg", url:"https://themoviedb.org/person/35192"}}, {tmdbId:"16108", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0580886", born:date('1935-05-27'), name:"Lee Meriwether", bio:"Lee Ann Meriwether (5' 8½\" or 1. 74 m) was born on May 27, 1935 (Gemini) in Los Angeles, California, USA is an American actress, former model, and the winner of the 1955 Miss America pageant.  Her trademarks are Natural Auburn hair, Light blue eyes, and a seductive deep voice.  She married Frank Aletter on April 20, 1958, had two daughters, actresses Kyle Aletter and Lesley Aletter, then divorced sometime in 1974...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8KMAQXWV3dUBThivDqvpiUjAM8B.jpg", url:"https://themoviedb.org/person/16108"}}, {tmdbId:"4355", properties:{bornIn:"New York City, New York, USA", imdbId:"0003110", born:date('1907-02-15'), name:"Cesar Romero", bio:"Cesar Julio Romero, Jr.  (February 15, 1907 – January 1, 1994) was a Cuban-American film and television actor who was active in film, radio, and television for almost sixty years.  His wide range of screen roles included Latin lovers, historical figures in costume dramas, characters in light domestic comedies, and as The Joker in television's Batman series...", died:date('1994-01-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1UMk0r2rcMSpglnxd2QJMVgqZtI.jpg", url:"https://themoviedb.org/person/4355"}}, {tmdbId:"13333", properties:{bornIn:"Greenwich, London, England, UK", imdbId:"0000603", born:date('1937-01-30'), name:"Vanessa Redgrave", bio:"Vanessa Redgrave CBE (born 30 January 1937) is an English actress and political activist.   Redgrave rose to prominence in 1961 playing Rosalind in the Shakespeare comedy As You Like It with the Royal Shakespeare Company and has since starred in more than 35 productions in London's West End and on Broadway, winning the 1984 Olivier Award for Best Actress in a Revival for The Aspern Papers, and the 2003 Tony Award for Best Actress in a Play for the revival of Long Day's Journey into Night...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uJiEKgjfvdyikrPc3ukLXULGQfq.jpg", url:"https://themoviedb.org/person/13333"}}, {tmdbId:"15196", properties:{bornIn:"Guildford, Surrey, England, UK", imdbId:"0376101", born:date('1941-11-18'), name:"David Hemmings", bio:"David Edward Leslie Hemmings (18 November 1941 – 3 December 2003) was an English film, theatre and television actor as well as a film and television director and producer. \n\nHe is noted for his role as the photographer in the drama mystery-thriller film Blowup (1966), directed by Michelangelo Antonioni.  Early in his career, Hemmings was a boy soprano appearing in operatic roles.  In his later acting career, he was known for his distinctive eyebrows and gravelly voice...", died:date('2003-12-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xWnuSxOyOqPeSEii63PmjQvtubU.jpg", url:"https://themoviedb.org/person/15196"}}, {tmdbId:"15198", properties:{bornIn:"Croydon, Surrey, England, UK", imdbId:"0145284", born:date('1940-01-14'), name:"John Castle", bio:"John Castle (born 14 January 1940) is an English actor.  Castle has acted in theatre, film and television.  He is well known for his role as Postumus in the 1976 BBC television adaptation of I, Claudius and for playing Geoffrey in the 1968 film, The Lion in Winter.  He also played Dr.  Carrasco as well as the prisoner called The Duke in the film Man of La Mancha. \n\nDescription above from the Wikipedia article John Castle, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bC2KfRuMflJTDegbLJYawM5t2fS.jpg", url:"https://themoviedb.org/person/15198"}}, {tmdbId:"55037", properties:{bornIn:"Chesterfield, Derbyshire, England, UK", imdbId:"0447305", born:date('1935-01-03'), name:"Jeremy Kemp", bio:"From Wikipedia, the free encyclopedia\n\nJeremy Kemp (3 January 1935 - 19 July 2019) was an English actor.  He was known for his roles in the miniseries The Winds of War, The Blue Max and Z-Cars. \n\nKemp was born Jeremy Walker in Chesterfield, Derbyshire, the son of Elsa May (née Kemp) and Edmund Reginald Walker, an engineer, and studied acting at the Central School of Speech and Drama...", died:date('2019-07-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lXKzFH9PM3H0JDlRcgMkw6FWq3i.jpg", url:"https://themoviedb.org/person/55037"}}, {tmdbId:"77165", properties:{bornIn:"London, England, UK", imdbId:"0571441", born:date('1931-06-07'), name:"Virginia McKenna", bio:"From Wikipedia, the free encyclopedia\n\nVirginia A.  McKenna OBE (born 7 June 1931, London) is a British stage and screen actress, author and wildlife campaigner. \n\nDescription above from the Wikipedia article Virginia McKenna, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5JJtj0ghfr57HGHDcmuktzuWXlT.jpg", url:"https://themoviedb.org/person/77165"}}, {tmdbId:"16898", properties:{bornIn:"Newcastle-upon-Tyne, England, UK", imdbId:"0871272", born:date('1922-01-03'), name:"Bill Travers", bio:"From Wikipedia, the free encyclopedia\n\nWilliam Lindon-Travers (3 January 1922 – 29 March 1994) was an English actor, screenwriter, director and an animal rights activist, known professionally as Bill Travers. \n\nDescription above from the Wikipedia article Bill Travers, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1994-03-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bJ1ibStu0jK98uoAJrRlRXRJe0w.jpg", url:"https://themoviedb.org/person/16898"}}, {tmdbId:"10462", properties:{bornIn:"Wallingford, Oxfordshire, England, UK", imdbId:"0444584", born:date('1916-08-21'), name:"Geoffrey Keen", bio:"From Wikipedia, the free encyclopedia\n\nGeoffrey Keen (21 August 1916 – 3 November 2005) was an English actor who appeared in supporting roles in many famous films. \n\nDescription above from the Wikipedia article Geoffrey Keen, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2005-11-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dvxVrI845NAKGGekU95FNcF5ysv.jpg", url:"https://themoviedb.org/person/10462"}}, {tmdbId:"78161", properties:{imdbId:"0525736", name:"Peter Lukoye", died:date('2004-02-04'), url:"https://themoviedb.org/person/78161"}}, {tmdbId:"5813", properties:{bornIn:"Naples - Campania - Italy", imdbId:"0321294", born:date('1924-04-10'), name:"Aldo Giuffrè", bio:"From Wikipedia, the free encyclopedia\n\nAldo Giuffrè (10 April 1924 – 26 June 2010) was an Italian film actor and comedian who appeared in over 90 films between 1948 and 2001.  He was born in Naples. \n\nHe is known for his roles in The Four Days of Naples, and as the alcoholic Union Army captain in the Sergio Leone film The Good, the Bad and the Ugly in 1966. \n\nGiuffrè died in Rome in 2010 of peritonitis...", died:date('2010-06-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lhCobXoExhtZneHpt00IdHcVOsN.jpg", url:"https://themoviedb.org/person/5813"}}, {tmdbId:"9221", properties:{bornIn:"Worksop, Nottinghamshire, England, UK", imdbId:"0000587", born:date('1919-10-05'), name:"Donald Pleasence", bio:"Donald Henry Pleasence, OBE, (5 October 1919 – 2 February 1995) was an English actor who gained more than 200 screen credits during a career which spanned over four decades.  Often typecast as villainous and/or psychopathic characters, Pleasence is arguably best-known for his work in two of cinema's most successful franchises - James Bond and Halloween. \n\nDescription above from the Wikipedia article Donald Pleasence, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1995-02-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eVJGFCd8ikP6w0XjkuiTbsm65eD.jpg", url:"https://themoviedb.org/person/9221"}}, {tmdbId:"18809", properties:{bornIn:"Paris, France", imdbId:"0233753", born:date('1942-03-21'), name:"Françoise Dorléac", bio:"Françoise Dorléac (21 March 1942 – 26 June 1967) was a French actress. \n\nBorn in Paris, she was the daughter of screen actor Maurice Dorléac and Renée Deneuve, and was the elder sister of Catherine Deneuve.  The two sisters starred together in the 1967 musical, Les Demoiselles de Rochefort. \n\nHer films include Philippe de Broca's movie L'homme de Rio, François Truffaut's La peau douce and Roman Polanski's Cul-de-sac...", died:date('1967-06-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zPAmgTqb1NWBN7NMU1EqnR7PQB.jpg", url:"https://themoviedb.org/person/18809"}}, {tmdbId:"14016", properties:{bornIn:"Dublin, Ireland", imdbId:"0532290", born:date('1918-10-13'), name:"Jack MacGowran", bio:"From Wikipedia, the free encyclopedia.   John Joseph \"Jack\" MacGowran (October 13, 1918 – January 31, 1973) was an Irish character actor, whose last film role was as the alcoholic director Burke Dennings in The Exorcist.  He was probably best known for his work with Samuel Beckett. \n\nDescription above from the Wikipedia article Jack MacGowran , licensed under CC-BY-SA,full list of contributors on Wikipedia...", died:date('1973-01-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rpQ8woHjo3ZzsJNT3RJSfJGDNIQ.jpg", url:"https://themoviedb.org/person/14016"}}, {tmdbId:"85308", properties:{bornIn:"Kamisu, Ibaraki prefecture, Japan", imdbId:"0619824", born:date('1950-05-28'), name:"Yôko Naitô", bio:"Yôko Naitô (內藤洋子) was born on May 28, 1950 in Ibaraki, Japan.  She is an actress, known for The Sword of Doom (1966), Red Beard (1965) and Izu no odoriko (1967)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wMCwrggGInEsOggodikizcvAzrl.jpg", url:"https://themoviedb.org/person/85308"}}, {tmdbId:"53911", properties:{imdbId:"0311788", name:"Joseph Gehrard", url:"https://themoviedb.org/person/53911"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"14813", properties:{bornIn:"Clichy, Hauts-de-Seine, France", imdbId:"0900557", born:date('1938-05-10'), name:"Marina Vlady", bio:"Marina Vlady, born Marina de Poliakoff-Baidaroff,  is a French actress who made her film debut at 11.   She has appeared in more than 100 feature films and television productions.  She arrived as the blond bombshell and was the main attraction in \"La sorcière\" (1956)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zb6pWsjtLsr5BHRlkKAVpu28ShW.jpg", url:"https://themoviedb.org/person/14813"}}, {tmdbId:"24475", properties:{bornIn:"Rouen, Seine-Maritime, France", imdbId:"0243175", born:date('1947-06-28'), name:"Anny Duperey", bio:"From Wikipedia, the free encyclopedia. \n\nAnny Duperey (born Annie Legras on June 28, 1947 in Rouen, Seine-Maritime, France) is a French stage, film and television actress and best-selling author.  She is a Chevalier of the Légion d'honneur. \n\nDescription above from the Wikipedia article Anny Duperey, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tVoWb0rvzVno3ksyf7WFV9YnwmE.jpg", url:"https://themoviedb.org/person/24475"}}, {tmdbId:"53912", properties:{imdbId:"0600331", name:"Roger Montsoret", url:"https://themoviedb.org/person/53912"}}, {tmdbId:"12422", properties:{bornIn:"Joplin, Missouri, USA", imdbId:"0915840", born:date('1924-06-04'), name:"Dennis Weaver", bio:"From Wikipedia, the free encyclopedia. \n\nWilliam Dennis Weaver (June 4, 1924 – February 24, 2006) was an American actor, best known for his work in television, including roles on Gunsmoke, as Marshal Sam McCloud on the NBC police drama McCloud, and the 1971 TV movie Duel. \n\nDescription above from the Wikipedia article Dennis Weaver, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2006-02-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1uHHqfZNjxrm6g2MJbNsTuHeLXA.jpg", url:"https://themoviedb.org/person/12422"}}, {tmdbId:"1487339", properties:{name:"Michael Hynson", url:"https://themoviedb.org/person/1487339"}}, {tmdbId:"92", properties:{imdbId:"0041875", born:date('1945-06-06'), name:"Robert August", bio:"​From Wikipedia, the free encyclopedia.   \n\nRobert August (born 1945) is an American surfer and surfboard shaper.  Raised in Huntington Beach, CA he attended Huntington Beach High School where we was ASB President his senior year.  He is most famous as one of the subjects of Bruce Brown's 1966 surf documentary The Endless Summer, along with his friend Mike Hynson...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j0pmh39b2UyQsVsWVMn4hQwUkOe.jpg", url:"https://themoviedb.org/person/92"}}, {tmdbId:"1487342", properties:{imdbId:"0088060", name:"Lord 'Tally Ho' Blears", url:"https://themoviedb.org/person/1487342"}}, {tmdbId:"97935", properties:{bornIn:"Koblenz, Germany", imdbId:"0226446", born:date('1918-10-20'), name:"Anton Diffring", bio:"From Wikipedia, the free encyclopedia\n\nAnton Diffring (born Alfred Pollack; October 20, 1918 – May 20, 1989) was a German actor. \n\nDescription above from the Wikipedia article Anton Diffring, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1989-05-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/s8F9KMn19frd92s62pxW3lBMTxY.jpg", url:"https://themoviedb.org/person/97935"}}, {tmdbId:"21462", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0000079", born:date('1940-09-05'), name:"Raquel Welch", bio:"More a sex goddess than an actress, the statuesque Raquel Welch was one of the most popular celebrities of the 1960s and 1970s.  While she appeared in dozens of films, they earned little notice, her success depending almost exclusively on her stature as a buxom pin-up.  Born Raquel Tejada on September 5, 1940, in Chicago, she began taking dancing lessons as a child and by her teens was already winning beauty contests...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pdABN45R9SwjbTnODI4yDr1WuVk.jpg", url:"https://themoviedb.org/person/21462"}}, {tmdbId:"19779", properties:{imdbId:"0723707", born:date('1938-10-29'), name:"Ron Rich", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p4CKQI6Avoesx3d1X7iibiqhNaz.jpg", url:"https://themoviedb.org/person/19779"}}, {tmdbId:"19780", properties:{imdbId:"0922165", born:date('1942-12-15'), name:"Judi West", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/A4mGuW46bG5zG6LyPguDLDsK9OA.jpg", url:"https://themoviedb.org/person/19780"}}, {tmdbId:"83457", properties:{bornIn:"Pride Louisiana USA", imdbId:"0235031", born:date('1933-09-26'), name:"Donna Douglas", bio:"From Wikipedia, the free encyclopedia\n\nDonna Douglas (born Doris Ione Smith; September 26, 1932 – January 1, 2015) was an American actress and singer, known for her role as Elly May Clampett in CBS's The Beverly Hillbillies (1962–1971).  Following her acting career, Douglas became a real estate agent, gospel singer, inspirational speaker, and author of books for children and adults...", died:date('2015-01-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/m81iRXtKxiNjyztDW3Cyde7lFMF.jpg", url:"https://themoviedb.org/person/83457"}}, {tmdbId:"21459", properties:{imdbId:"0486057", born:date('1936-03-08'), name:"Sue Ane Langdon", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xm2GGYwGYyppYtSkeua42lusP4c.jpg", url:"https://themoviedb.org/person/21459"}}, {tmdbId:"118861", properties:{bornIn:"Schoenenwerd, Switzerland", imdbId:"0007098", born:date('1917-07-20'), name:"Paul Hubschmid", bio:"From Wikipedia, the free encyclopedia. \n\nPaul Hubschmid (20 July 1917 – 31 December 2001) was a Swiss actor.  He appeared as Henry Higgins in a production of My Fair Lady.  In some Hollywood films he used the name Paul Christian.  He appeared in dozens of films and some television series between 1938 and 1991: many were German productions and some were produced abroad. \n\nDescription above from the Wikipedia article Paul Hubschmid, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2001-12-31'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/UHZ6SXP7YkaHRGnA6UZEMgdTyl.jpg", url:"https://themoviedb.org/person/118861"}}, {tmdbId:"129431", properties:{bornIn:"Berlin, Germany", imdbId:"0719960", born:date('1944-11-03'), name:"Eva Renzi", bio:"Tall, blonde, busty and radiant, Eva Renzi created a sensation when she rose to stardom in her native West Germany in the mid-60s.  Born to a 17-year-old French mother and a 49-year-old Danish father, Eva's childhood was everything but happy.  Her parents got divorced when she was three, and her mother put her into an orphanage run by nuns.  Eva was 14 when she returned to live with her abusive father.  She later claimed that \"he beat the daylights out of me on a daily basis\"...", died:date('2005-08-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mjJLMsNG0T6W3UxxEEFQiYrrOkP.jpg", url:"https://themoviedb.org/person/129431"}}, {tmdbId:"40178", properties:{bornIn:"Brooklyn, New York, United States", imdbId:"0799014", born:date('1911-05-11'), name:"Phil Silvers", bio:"Phil Silvers (1911–1985) was an American entertainer and comedy actor.  He is best known for starring in The Phil Silvers Show...", died:date('1985-11-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sux8zZHuksqp0A2gPHBPCCC2LTl.jpg", url:"https://themoviedb.org/person/40178"}}, {tmdbId:"19610", properties:{bornIn:"Salisbury, Wiltshire, England, UK", imdbId:"0186903", born:date('1942-01-19'), name:"Michael Crawford", bio:"From Wikipedia, the free encyclopedia.   Michael Crawford OBE (born 19 January 1942) is an English actor and singer.  He has garnered great critical acclaim and won numerous awards during his career, which covers radio, television, film, and stagework on both London's West End and on Broadway in New York City...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/81cAX1ghOMKBpvVtoo7ya5wuno0.jpg", url:"https://themoviedb.org/person/19610"}}, {tmdbId:"29791", properties:{bornIn:"London, England, UK", imdbId:"0001655", born:date('1943-03-08'), name:"Lynn Redgrave", bio:"Lynn Rachel Redgrave, OBE (8 March 1943 – 2 May 2010) was an English actress.  A member of the well-known British family of actors, Redgrave trained in London before making her theatrical debut in 1962.  By the mid-1960s she had appeared in several films, including Tom Jones (1963), and Georgy Girl (1966) which won her a New York Film Critics Award and nominations for an Academy Award and a Golden Globe Award...", died:date('2010-05-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q21JNdifHtboIMB5KLpmeTr1UX1.jpg", url:"https://themoviedb.org/person/29791"}}, {tmdbId:"44079", properties:{bornIn:"Sturmer, England, UK", imdbId:"0001648", born:date('1946-02-05'), name:"Charlotte Rampling", bio:"Tessa Charlotte Rampling OBE (born 5 February 1946) is an English actress, model and singer, known for her work in European arthouse films in English, French, and Italian.  An icon of the Swinging Sixties, she began her career as a model and later became a fashion icon and muse...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5U35yScoao1hf6SibbMZcld2CJd.jpg", url:"https://themoviedb.org/person/44079"}}, {tmdbId:"111191", properties:{bornIn:"New York City, New York, USA", imdbId:"0323960", born:date('1903-08-31'), name:"Arthur Godfrey", bio:"From Wikipedia, the free encyclopedia\n\nArthur Morton Godfrey (August 31, 1903 – March 16, 1983) was an American radio and television broadcaster and entertainer who was sometimes introduced by his nickname, \"The Old Redhead\"...", died:date('1983-03-16'), url:"https://themoviedb.org/person/111191"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"11850", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0000298", born:date('1946-05-09'), name:"Candice Bergen", bio:"Candice Patricia Bergen (born May 9, 1946) is an American actress and former fashion model. \n\nShe is known for starring in two TV series, as the title character on the situation comedy Murphy Brown (1988–1998), for which she won five Emmy Awards and two Golden Globe Awards; and as Shirley Schmidt on the comedy-drama Boston Legal (2004–2008), for which she was nominated for two Emmys, a Golden Globe, and a Screen Actors Guild Award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yDthvXPRkcwSVcPj9QZz3Z7ZH5B.jpg", url:"https://themoviedb.org/person/11850"}}, {tmdbId:"18588", properties:{bornIn:"East Harlem, New York City, New York, U.S.", imdbId:"0352466", born:date('1934-03-01'), name:"Joan Hackett", bio:"Joan Hackett (1934—1983) was an American actress who appeared on stage and television as well as films...", died:date('1983-10-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ripA7qXbSoFzHvxmehNNoyV7MIZ.jpg", url:"https://themoviedb.org/person/18588"}}, {tmdbId:"65505", properties:{bornIn:"Melfort, Saskatchewan, Canada", imdbId:"0384050", born:date('1922-08-01'), name:"Arthur Hill", bio:"​From Wikipedia, the free encyclopedia.   \n\nArthur Edward Spence Hill (August 1, 1922 – October 22, 2006) was a Canadian actor best known for appearances in British and American theater, movies and television.  He attended the University of British Columbia and continued his acting studies in Seattle, Washington...", died:date('2006-10-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7j7FUkRWb3aMiwxzkmRoZwPwvXq.jpg", url:"https://themoviedb.org/person/65505"}}, {tmdbId:"34665", properties:{imdbId:"0730435", born:date('1956-08-10'), name:"Peter Robbins", url:"https://themoviedb.org/person/34665"}}, {tmdbId:"124651", properties:{bornIn:"Los Angeles County, California, USA", imdbId:"0790259", born:date('1958-02-05'), name:"Christopher Shea", died:date('2010-08-19'), url:"https://themoviedb.org/person/124651"}}, {tmdbId:"124653", properties:{imdbId:"0825777", name:"Kathy Steinberg", url:"https://themoviedb.org/person/124653"}}, {tmdbId:"86694", properties:{imdbId:"0890046", born:date('1947-06-22'), name:"Natalya Varley", bio:"Natalya V.  Varley (born June 22, 1947) is a Soviet and Russian film and theater actress, who became famous in 1966 for her part in the comedy \"Kidnapping, Caucasian Style\".  In 1989 she was designated as a Meritorious Artist of RSFSR...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cEqp8K3c8by72us9fpPZfTWYAhI.jpg", url:"https://themoviedb.org/person/86694"}}, {tmdbId:"86697", properties:{imdbId:"0015273", name:"Ruslan Akhmetov", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i20TfWLwIlS5s0eCZGIdn8sKNH.jpg", url:"https://themoviedb.org/person/86697"}}, {tmdbId:"86680", properties:{bornIn:"Demidov, Smolensk Region, USSR", imdbId:"0631994", born:date('1921-12-18'), name:"Yuriy Nikulin", bio:"From Wikipedia, the free encyclopedia. \n\nYuri Vladimirovich Nikulin (Russian: Юрий Владимирович Никулин; 18 December 1921 – 21 August 1997) was a well-known Soviet and Russian actor and clown who starred in many popular films.  He was awarded the title of People's Artist of the USSR in 1973 andHero of Socialist Labour in 1990.  He also received a number of state awards, including the prestigious Order of Lenin, which he received twice in his lifetime...", died:date('1997-08-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sxiwVxrO5VHtdIieeQH8m14JE2k.jpg", url:"https://themoviedb.org/person/86680"}}, {tmdbId:"83442", properties:{bornIn:"Akron, Ohio, USA", imdbId:"0017030", born:date('1925-07-20'), name:"Lola Albright", bio:"From Wikipedia, the free encyclopedia\n\nLola Jean Albright (born July 20, 1925, Akron, Ohio) was an American singer and actress. \n\nAlbright worked as a model before moving to Hollywood.  She began her motion picture career with a bit part in the 1948 film The Pirate, and followed it with an important role in the acclaimed 1949 hit Champion.  For the next ten years, she appeared in secondary roles in over twenty films, including several 'B' Westerns...", died:date('2017-03-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/23OMtkxAnHH9cmWqWZgQLJgtbap.jpg", url:"https://themoviedb.org/person/83442"}}, {tmdbId:"109945", properties:{bornIn:"Southampton, New York, USA", imdbId:"0922229", born:date('1937-08-28'), name:"Martin West", died:date('2019-12-31'), url:"https://themoviedb.org/person/109945"}}, {tmdbId:"13324", properties:{bornIn:"Hurstpierpoint, West Sussex, England, UK", imdbId:"0006890", born:date('1922-01-21'), name:"Paul Scofield", bio:"From Wikipedia, the free encyclopedia\n\nDavid Paul Scofield, CH, CBE (21 January 1922 – 19 March 2008), better known as Paul Scofield, was an English actor of stage and screen.  Noted for his distinctive voice and delivery, Scofield received an Academy Award and a BAFTA Award for his performance as Sir Thomas More in the 1966 film A Man for All Seasons, a reprise of the role he played in the stage version at the West End and on Broadway for which he received a Tony Award...", died:date('2008-03-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sbx0PIwGvLstTPsoUQgDnyeVmpI.jpg", url:"https://themoviedb.org/person/13324"}}, {tmdbId:"8606", properties:{bornIn:"Westhoughton, Lancashire, England, UK", imdbId:"0001727", born:date('1927-08-09'), name:"Robert Shaw", bio:"Robert Archibald Shaw (9 August 1927 – 28 August 1978) was an English stage and film actor and novelist, remembered for his performances in The Sting, From Russia with Love, A Man for All Seasons, the original The Taking of Pelham One Two Three (1974), Black Sunday (1977), The Deep (1977) and Jaws, where he played the shark hunter Quint...", died:date('1978-08-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bU4IJ4J1mgrriRTdQ4BOemoHvtt.jpg", url:"https://themoviedb.org/person/8606"}}, {tmdbId:"88575", properties:{imdbId:"0628667", name:"Tom Neyman", url:"https://themoviedb.org/person/88575"}}, {tmdbId:"1634509", properties:{born:date('1941-09-15'), name:"John Reynolds", died:date('1966-10-16'), url:"https://themoviedb.org/person/1634509"}}, {tmdbId:"24801", properties:{bornIn:"Saigon, Vietnam", imdbId:"0333014", born:date('1942-06-10'), name:"Chantal Goya", bio:"From Wikipedia, the free encyclopedia. \n\nChantal Goya (born Chantal Deguerre on June 10, 1942 in Saigon) is a French singer and actress. \n\nChantal Goya started her career as a yé-yé girl, singing a catchy mid-'60s hybrid of girl-group pop and French chanson.  She also enjoyed a career as a French New Wave actress; she had a starring role as Madeleine in the 1966 Jean-Luc Godard film Masculin, féminin and in Jean-Daniel Pollet's L'amour c'est gai, l'amour c'est triste (Love is joy, love is sad)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9TZijV2pQYYspyI0Kj100hzYulI.jpg", url:"https://themoviedb.org/person/24801"}}, {tmdbId:"35000", properties:{bornIn:"Algiers, Alger, France", imdbId:"0423381", born:date('1940-11-04'), name:"Marlène Jobert", bio:"From Wikipedia, the free encyclopedia. \n\nMarlène Jobert (born 4 November 1943) is a French Pied-Noir actress and author. \n\nJobert was born in Algiers, Algeria (then French territory), the daughter of Andrée (née Azoulay) and a father who flew for the French Air Force.  She came to Metropolitan France when aged 8.  Besides acting, she has been the author and/or narrator of (mainly children's) audio books...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qNdptSUnLuWKV0vw0QMdYk5IwBi.jpg", url:"https://themoviedb.org/person/35000"}}, {tmdbId:"39067", properties:{imdbId:"0213502", name:"Michel Debord", url:"https://themoviedb.org/person/39067"}}, {tmdbId:"2076", properties:{bornIn:"Manchester, England, UK", imdbId:"0001831", born:date('1941-07-29'), name:"David Warner", bio:"David Hattersley Warner (born 29 July 1941) is an English actor.  He attended the Royal Academy of Dramatic Art and worked in the theatre before attaining prominence on screen in the early 1960s through his lead performance in the Karel Reisz film Morgan: A Suitable Case for Treatment, for which he was nominated for the BAFTA Award for Best Actor in a Leading Role...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sJ5NyKkTmFGyiTrpCnZ1v0DSnQG.jpg", url:"https://themoviedb.org/person/2076"}}, {tmdbId:"41957", properties:{bornIn:"Bristol, England, UK", imdbId:"0827137", born:date('1931-07-14'), name:"Robert Stephens", bio:"Sir Robert Stephens  (14 July 1931 – 12 November 1995) was a leading English actor in the early years of England's Royal National Theatre.  He was one of the most respected actors of his generation and was at one time regarded as the natural successor to Laurence Olivier.  While very acting on stage his whole life, he also participated in more than 100 theatrical films and TV series episodes.  \n\nHe was married to actress Maggie Smith between 1967 and 1974...", died:date('1995-11-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4pVgu3tfMX2KkTryvSpJKHMdEzI.jpg", url:"https://themoviedb.org/person/41957"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"79641", properties:{bornIn:"Maida Vale, London, England, UK", imdbId:"0359566", born:date('1901-12-27'), name:"Irene Handl", bio:"Irene Handl (27 December 1901 - 29 November 1987) was a British character actress...", died:date('1987-11-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iSjHKjDORDffzTQcJdAhuw9N6KT.jpg", url:"https://themoviedb.org/person/79641"}}, {tmdbId:"11916", properties:{bornIn:"Tokyo, Japan", imdbId:"0880521", born:date('1938-12-16'), name:"Liv Ullmann", bio:"Liv Johanne Ullmann (born 16 December 1938) is a Norwegian actress and film director, as well as one of the muses of the Swedish director Ingmar Bergman.  A winner of the Golden Globe, Ullmann has also been nominated for the Palme d'Or, two times for the Academy Award, and a BAFTA Award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7IJimLbXIOYpLAS4UaHcNYWRsJe.jpg", url:"https://themoviedb.org/person/11916"}}, {tmdbId:"11917", properties:{bornIn:" Stockholm, Stockholms län, Sweden", imdbId:"0472234", born:date('1925-10-15'), name:"Margaretha Krook", died:date('2001-05-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eIfMDQG8oaU2Vt5xbYt4vS6ftja.jpg", url:"https://themoviedb.org/person/11917"}}, {tmdbId:"102661", properties:{bornIn:"London, England, UK", imdbId:"0163493", born:date('1938-07-08'), name:"Diane Clare", died:date('2013-06-21'), url:"https://themoviedb.org/person/102661"}}, {tmdbId:"102663", properties:{imdbId:"0930180", born:date('1938-01-22'), name:"Brook Williams", died:date('2005-04-29'), url:"https://themoviedb.org/person/102663"}}, {tmdbId:"102665", properties:{bornIn:"Byfleet, Woking, Surrey, England, UK", imdbId:"0668940", born:date('1943-12-20'), name:"Jacqueline Pearce", died:date('2018-09-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AoeWQ3EM9RcpQT8WSWJC9tJXrme.jpg", url:"https://themoviedb.org/person/102665"}}, {tmdbId:"24299", properties:{bornIn:"Aumale, French Algeria", imdbId:"0108400", born:date('1933-03-30'), name:"Jean-Claude Brialy", bio:"Jean-Claude Brialy (born 30 March 1933, Aumale, French Algeria (now Sour El-Ghozlane), Algeria) was a French actor, director, and socialite...", died:date('2007-05-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d8fGz1JBFPlHSDts5c4TKvT5F5L.jpg", url:"https://themoviedb.org/person/24299"}}, {tmdbId:"35341", properties:{bornIn:"Montréal, Québec, Canada", imdbId:"0000991", born:date('1942-07-01'), name:"Geneviève Bujold", bio:"Geneviève Bujold (born July 1, 1942) is a Canadian actress best known for her portrayal of Anne Boleyn in the 1969 film Anne of the Thousand Days, for which she won a Golden Globe Award for best actress and was nominated for an Academy Award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wqA4wFes9TWpqbAgYygD4oXNBcd.jpg", url:"https://themoviedb.org/person/35341"}}, {tmdbId:"1903", properties:{bornIn:"New York City, New York, USA", imdbId:"0000273", born:date('1934-03-26'), name:"Alan Arkin", bio:"Alan Wolf Arkin (born March 26, 1934) is an American actor, director, musician and singer.  He is known for starring in such films as Wait Until Dark, The Russians Are Coming, the Russians Are Coming, The Heart is a Lonely Hunter, Catch-22, The In-Laws, Edward Scissorhands, Glengarry Glen Ross, Marley & Me, Argo and Little Miss Sunshine, for which he won an Academy Award for Best Supporting Actor in 2006.  He is the father of actors Adam Arkin, Anthony Arkin, and Matthew Arkin...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lTMMpkqL0G3WeFNfbtdP5COZEiX.jpg", url:"https://themoviedb.org/person/1903"}}, {tmdbId:"16554", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0001077", born:date('1926-11-30'), name:"Richard Crenna", bio:"Richard Donald Crenna (November 30, 1926 – January 17, 2003) was an American motion picture, television, and radio actor and occasional television director.  He starred in such motion pictures as The Sand Pebbles, Wait Until Dark, Body Heat, the first three Rambo movies, Hot Shots! Part Deux, and The Flamingo Kid...", died:date('2003-01-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bMCkVr25CBMuwI9vE7AUnCHdzLJ.jpg", url:"https://themoviedb.org/person/16554"}}, {tmdbId:"159555", properties:{bornIn:"New York City, New York, USA ", imdbId:"0132100", born:date('1919-03-12'), name:"Frank Campanella", died:date('2006-12-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aFKBOIqvarf31YnPlXn8H4OtzAd.jpg", url:"https://themoviedb.org/person/159555"}}, {tmdbId:"18649", properties:{bornIn:"New York City, New York, U.S.", imdbId:"0709907", born:date('1915-06-01'), name:"John Randolph", bio:"John Randolph (1915–2004) was an American film, television and stage actor...", died:date('2004-02-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pPDfKLnhnovdfbCOxW854zSumlP.jpg", url:"https://themoviedb.org/person/18649"}}, {tmdbId:"86344", properties:{bornIn:"Wichita Falls, Texas, USA", imdbId:"0717265", born:date('1914-12-09'), name:"Frances Reid", bio:"Frances Reid was an American stage and screen actress.  Her Broadway debut was as Juliette Lecourtois in \"Where There's a Will There's a Way\" at the John Golden Theatre in 1939.  She was a member of The Actors Studio from its inception in 1947...", died:date('2010-02-03'), url:"https://themoviedb.org/person/86344"}}, {tmdbId:"83454", properties:{bornIn:"Mount Vernon, New York, USA", imdbId:"0921303", born:date('1928-10-06'), name:"Barbara Werle", died:date('2013-01-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8rxKhKP9X1RSMpSgVOhWHNkk83r.jpg", url:"https://themoviedb.org/person/83454"}}, {tmdbId:"83433", properties:{bornIn:"Santa Monica, California, USA", imdbId:"0001193", born:date('1944-01-19'), name:"Shelley Fabares", bio:"Vibrant, increasingly lovely teen fave Shelley Fabares withstood the test of time by transitioning successfully into adult parts unlike many of her 1960s \"teen queen\" peers who faded quickly into the memory books.  She was born Michele Marie Fabares on January 19, 1944, in sunny Santa Monica, Californnia.  As the niece of singer/comedienne Nanette Fabray, she was indoctrinated early into the show biz life...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nuZ0DyCd90fnAolznVBr8h2uALT.jpg", url:"https://themoviedb.org/person/83433"}}, {tmdbId:"83462", properties:{bornIn:"Cleveland, Ohio U.S.", imdbId:"0564223", born:date('1941-05-18'), name:"Diane McBain", bio:"From Wikipedia, the free encyclopedia.   Diane McBain (born May 18, 1941) is an American actress who, as a Warner Brothers contract player, reached a brief peak of popularity during the early 1960s.  She is best known for playing an adventurous socialite in the 1960-62 TV series Surfside 6 and as one of Elvis Presley's leading ladies in 1966's Spinout. \n\nDescription above from the Wikipedia article  Diane McBain, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Eg8pFxKaOlPo3BA3UDJu3qWOEP.jpg", url:"https://themoviedb.org/person/83462"}}, {tmdbId:"138251", properties:{bornIn:"USA", imdbId:"0550847", born:date('1934-12-22'), name:"Dodie Marshall", url:"https://themoviedb.org/person/138251"}}, {tmdbId:"29718", properties:{bornIn:"Fresno, California, USA", imdbId:"0175528", born:date('1925-08-15'), name:"Mike Connors", died:date('2017-01-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9PK3rmPiW6NupYHPnz5mIOuQua0.jpg", url:"https://themoviedb.org/person/29718"}}, {tmdbId:"45206", properties:{bornIn:"Floral Park, New York", imdbId:"0179376", born:date('1933-05-03'), name:"Alex Cord", bio:"From Wikipedia, the free encyclopedia. \n\nAlex Cord (May 3, 1933) is an American actor who is perhaps best known for portraying the role of Archangel on the television series Airwolf. \n\nDescription above from the Wikipedia article Alex Cord, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/auyeofs0g8y9KIzWzMoALUFs6TK.jpg", url:"https://themoviedb.org/person/45206"}}, {tmdbId:"45524", properties:{bornIn:"Berlin, Germany", imdbId:"0271544", born:date('1931-01-31'), name:"Hansjörg Felmy", died:date('2007-08-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dMaF556BNPc3QZQzdKY2zRR2hKn.jpg", url:"https://themoviedb.org/person/45524"}}] AS row
