UNWIND [{tmdbId:"93377", properties:{bornIn:"Oahu, Hawaii, U.S.", imdbId:"0663546", born:date('1988-10-30'), name:"Janel Parrish", bio:"From Wikipedia, the free encyclopedia. \n\nJanel Meilani Parrish (born October 30, 1988) is an American actress, singer, Broadway performer, songwriter and pianist.  She is best known for playing Jade in the 2007 film Bratz: The Movie and her recurring role as Mona Vanderwaal on the ABC Family series Pretty Little Liars. \n\nDescription above from the Wikipedia article Janel Parrish, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2MZ3c8rnLC8E1mrOXVZ0v1bi7BR.jpg", url:"https://themoviedb.org/person/93377"}}, {tmdbId:"93378", properties:{bornIn:"  Madrid, Spain", imdbId:"2062561", born:date('1992-07-03'), name:"Nathalia Ramos", bio:"Born Nathalia Norah Ramos Cohen in Madrid, Spain.  Her father is Spanish and her mother is Australian with a Sephardi Jewish background.  Nathalia attended school in Miami Beach, FL where she moved from Australia at the age of 4.   She lives in both California and Miami with her family.  She has a younger brother named Michael.  Her first role was in Arrested Development in 2005...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2SfoN1S1f4RBvi4pIHEWC3os2vS.jpg", url:"https://themoviedb.org/person/93378"}}, {tmdbId:"70643", properties:{imdbId:"1408531", born:date('1992-12-17'), name:"Jordan Garrett", bio:"From Wikipedia, the free encyclopedia\n\nJordan Garrett (born December 17, 1992) is an American actor. \n\nGarrett has made guest appearances in numerous television shows, including Law &amp; Order: SVU, Crossing Jordan, Criminal Minds, Six Feet Under, Angel, Medium, Hidden Hills, ER, and Without a Trace.  He auditioned for the lead role in the 2006 movie Saving Shiloh, but lost the part to Jason Dolley, instead being cast in a supporting role...", url:"https://themoviedb.org/person/70643"}}, {tmdbId:"132712", properties:{bornIn:"London, England, UK", imdbId:"1507857", born:date('1992-09-28'), name:"Keir Gilchrist", bio:"Keir David Peters Gilchrist (born September 28, 1992) is a Canadian actor.  Gilchrist is known for playing teen Marshall Gregson on Showtime's original series United States of Tara, and for starring in the 2010 drama-comedy It's Kind of a Funny Story. \n\nDescription above from the Wikipedia article Keir Gilchrist, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vFrziqS1PDoHYFs2Vn9ro3577Ry.jpg", url:"https://themoviedb.org/person/132712"}}, {tmdbId:"560118", properties:{imdbId:"2911881", name:"Dana DeVestern", url:"https://themoviedb.org/person/560118"}}, {tmdbId:"84407", properties:{bornIn:"Chesterton, Indiana, USA", imdbId:"0300712", born:date('1966-07-07'), name:"Jim Gaffigan", bio:"Jim  has proven himself a major talent  beloved to a wide range of audiences after achieving milestones in stand-up, acting and writing.  As approachable as he is edgy, JIm is responsible for some of the funniest and most memorable moment in recent television (primetime, cable and late-night circuit and film...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vjsNoFWoTCXaBZ59qq6A03BeQs8.jpg", url:"https://themoviedb.org/person/84407"}}, {tmdbId:"91251", properties:{bornIn:"Mexico City, Distrito Federal, Mexico", imdbId:"0679213", born:date('1982-09-27'), name:"Luis Fernando Peña", bio:"Luis Fernando Peña is an actor, known for Sin Nombre (2009), Sleep Dealer (2008) and De la calle (2001)...", url:"https://themoviedb.org/person/91251"}}, {tmdbId:"1310905", properties:{name:"Metztli Adamina", url:"https://themoviedb.org/person/1310905"}}, {tmdbId:"1361547", properties:{imdbId:"1450561", name:"José Concepción Macías", url:"https://themoviedb.org/person/1361547"}}, {tmdbId:"87265", properties:{bornIn:"Mexico City, Mexico", imdbId:"2204178", born:date('1981-01-29'), name:"Tenoch Huerta", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3wGFejGaiDp65z4CrDZaItsPKgC.jpg", url:"https://themoviedb.org/person/87265"}}, {tmdbId:"9290", properties:{bornIn:"Washington, District of Columbia, USA", imdbId:"0738433", born:date('1961-02-13'), name:"Henry Rollins", bio:"Henry Rollins (born Henry Lawrence Garfield; February 13, 1961) is an American singer-songwriter, spoken word artist, writer, publisher, actor, radio DJ, and activist. \n\nAfter performing for the short-lived Washington D. C. -based band State of Alert in 1980, Rollins fronted the California hardcore punk band Black Flag from August 1981 until early 1986.  Following the band's breakup, Rollins soon established the record label and publishing company 2. 13...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2E0cZdoJsdt1Lv4waG3s6fsfJeU.jpg", url:"https://themoviedb.org/person/9290"}}, {tmdbId:"53185", properties:{imdbId:"1564024", born:date('1976-08-09'), name:"Texas Battle", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zPzagAtKxbHKrQLAQ69KSYLZxjA.jpg", url:"https://themoviedb.org/person/53185"}}, {tmdbId:"560325", properties:{imdbId:"1408780", name:"Joe Wagner", url:"https://themoviedb.org/person/560325"}}, {tmdbId:"1219297", properties:{bornIn:"Granville - Ohio - USA", imdbId:"0881131", born:date('1965-07-12'), name:"Brian Unger", bio:"Brian Unger is an actor and producer...", url:"https://themoviedb.org/person/1219297"}}, {tmdbId:"78042", properties:{bornIn:"Georgia, USA", imdbId:"2814621", born:date('1982-08-12'), name:"Erin Bethea", bio:"Erin Bethea is an American stage, film and television actress, writer and producer.  She holds a BA in Theatre from the University of Mobile, Prichard, Alabama...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5xFkd3BepC87fPHP9ONH7wH1feV.jpg", url:"https://themoviedb.org/person/78042"}}, {tmdbId:"83902", properties:{imdbId:"0085917", name:"James Blackwell", url:"https://themoviedb.org/person/83902"}}, {tmdbId:"2738285", properties:{name:"Bailey Cave", url:"https://themoviedb.org/person/2738285"}}, {tmdbId:"135798", properties:{bornIn:"Albany, Georgia, USA", imdbId:"2266388", name:"Shannen Fields", bio:"Shannen Fields is a gifted actress, producer, model, and inspirational speaker.  In her late twenties, Shannen began to grow a deep desire to accomplish something in life much larger than herself.  This aspiration first transpired in 2003 when she and her family moved back to her hometown of Albany, Georgia and met the faith-based filmmakers Alex and Stephen Kendrick.  She is known for \"Facing the Giants (2006)\", \"Suing the Devil (2011)\" and \"Rumors of Wars (2014)\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1m8B3GAIGCqJUr82t4Rhzu66oev.jpg", url:"https://themoviedb.org/person/135798"}}, {tmdbId:"201811", properties:{bornIn:"Canada ", born:date('1944-09-22'), name:"R.D. Reid", died:date('2017-06-20'), url:"https://themoviedb.org/person/201811"}}, {tmdbId:"17270", properties:{bornIn:"Rome, Italy", imdbId:"1935292", born:date('1985-09-02'), name:"Allison Miller", bio:"Allison Miller (born September 2, 1985) is an American actress.  She is best known for her role as Michelle Benjamin on the NBC series Kings. \n\nDescription above from the Wikipedia article Allison Miller, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/17270"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"30710", properties:{bornIn:"Boulder - Colorado - USA", imdbId:"0270625", born:date('1978-04-01'), name:"JJ Feild", bio:"Actor /Performer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8YIIH6ebWmIhWWJC3RGe16Z1biK.jpg", url:"https://themoviedb.org/person/30710"}}, {tmdbId:"17441", properties:{bornIn:"Seaside Heights, New Jersey, USA", imdbId:"1086384", born:date('1985-07-27'), name:"Lou Taylor Pucci", bio:"From Wikipedia, the free encyclopedia.   Lou Taylor Pucci (born July 27, 1985) is an American actor who first appeared on film in Rebecca Miller's well received Personal Velocity: Three Portraits in 2002.   Pucci was born in Seaside Heights, New Jersey and at 2 years old, moved to Keansburg, New Jersey.  A graduate of Christian Brothers Academy in Lincroft, he currently lives in Venice, California.  He first acted at the age of ten in a hometown production of Oliver!...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/elxDksMOanfrCxBczqnQEMd7hmZ.jpg", url:"https://themoviedb.org/person/17441"}}, {tmdbId:"84247", properties:{bornIn:"Port Perry, Ontario, Canada", imdbId:"0885840", born:date('1986-05-12'), name:"Emily VanCamp", bio:"Emily Irene VanCamp (born May 12, 1986) is a Canadian actress born in Port Perry, Ontario.  She is best known for her roles as Amy Abbott on the WB series Everwood, which ran from 2002 to 2006, and more recently for her role as Rebecca Harper in the ABC series Brothers and Sisters since 2007.  In 2011, she will star in the ABC drama Revenge...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zTl2KVglr7D7jnBLjbqe1BbbJiV.jpg", url:"https://themoviedb.org/person/84247"}}, {tmdbId:"8309", properties:{bornIn:"Leigh-on-Sea, Essex, England, UK", imdbId:"1663573", born:date('1978-01-07'), name:"Kierston Wareing", bio:"Kierston Wareing is an English actress.  Her first film role was the lead in Ken Loach's It's a Free World. . . , followed by a supporting role in Andrea Arnold's Fish Tank – which won the BAFTA award for \"Best British Film\" and the Jury Prize at the Cannes Film Festival...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lcPlix0o1cQxOWG0YbeshdvGzfj.jpg", url:"https://themoviedb.org/person/8309"}}, {tmdbId:"8325", properties:{imdbId:"0254927", name:"Juliet Ellis", url:"https://themoviedb.org/person/8325"}}, {tmdbId:"8324", properties:{imdbId:"2022053", name:"Leslaw Zurek", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hFAxHvAm3QYAAhUoUsBUX21oSbg.jpg", url:"https://themoviedb.org/person/8324"}}, {tmdbId:"8732", properties:{imdbId:"2739469", name:"Joe Siffleet", url:"https://themoviedb.org/person/8732"}}, {tmdbId:"26973", properties:{bornIn:" Toronto, Ontario, Canada ", imdbId:"0924986", born:date('1981-06-10'), name:"John White", bio:"John White is a Canadian film and television actor and producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3iaiCj09Kl8JnMNVEzQUCB6n0eM.jpg", url:"https://themoviedb.org/person/26973"}}, {tmdbId:"26974", properties:{bornIn:"Skokie, Illinois, USA", imdbId:"1789336", born:date('1986-01-15'), name:"Jessy Schram", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gL46VK7Qt6OBasK6HV7VzsC2Jk3.jpg", url:"https://themoviedb.org/person/26974"}}, {tmdbId:"26975", properties:{bornIn:"Indianapolis - Indiana - USA", imdbId:"1883440", born:date('1981-08-12'), name:"Steve Talley", bio:"Steve Talley is an actor and producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bY9OTcMxmJokUNmMLCUAFlppWb1.jpg", url:"https://themoviedb.org/person/26975"}}, {tmdbId:"8786", properties:{bornIn:" Tel Aviv, Israel", imdbId:"0957909", born:date('1969-06-28'), name:"Ayelet Zurer", bio:"Ayelet Zurer ( born 28 June 1969) is an Israeli actress, perhaps best known for her roles in Nina’s Tragedies, Adam Resurrected, Munich, and Angels &amp; Demons. \n\nZurer, who has appeared in many Israeli films and television series, is one of the most acclaimed Israeli actresses of her day.  She was nominated for awards at the Jerusalem Film Festival, the Israeli Academy Awards and the Israeli Television Academy Awards...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gXHf34CJswgm29eyPlZTbvAUc3G.jpg", url:"https://themoviedb.org/person/8786"}}, {tmdbId:"85151", properties:{bornIn:"Fetsund, Norway", imdbId:"0042212", born:date('1972-12-02'), name:"Trond Fausa", bio:"Trond Fausa Aurvåg (born 2 December 1972) is a Norwegian actor and film director.  After graduating from the Norwegian National Academy of Theatre in 2001, he has acted at Oslo Nye Teater since 2001.  Here he has acted in plays such as Amadeus, Manndomsprøven and Tatt av kvinnen.  As a film actor he is best known for his leading roles in the films Andreaskorset (2004), Den brysomme mannen (2006) and Tatt av kvinnen (2007)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rFWC22ZScaQwA85NBo7l1j9XQdo.jpg", url:"https://themoviedb.org/person/85151"}}, {tmdbId:"85152", properties:{imdbId:"0054970", born:date('1965-10-29'), name:"Petronella Barker", bio:"Petronella Barker (born 29 October 1965) is a British-born Norwegian actress.  She was born in Colchester, England, but grew up in Fredrikstad, Norway.  While still studying at the Theatre Academy in Oslo (1985–1988), she had her debut in the Russian-Norwegian co-production Dragens fange (Trees Grow on the Stones Too, 1985).  Her breakthrough as a movie actress came with the dystopic Sweetwater (1988), followed by Havet stiger (The Ocean Rises, 1990)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bXg6uMqGr5i1kBhkrlztGlfJU6x.jpg", url:"https://themoviedb.org/person/85152"}}, {tmdbId:"1479081", properties:{name:"Per Schaanning", url:"https://themoviedb.org/person/1479081"}}, {tmdbId:"85153", properties:{imdbId:"2277357", name:"Birgitte Larsen", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lhVlKeIr7sxSurZgz4l42gmWDcc.jpg", url:"https://themoviedb.org/person/85153"}}, {tmdbId:"55493", properties:{bornIn:"Scottsdale, Arizona, USA", imdbId:"1227232", born:date('1988-08-17'), name:"Brady Corbet", bio:"An American actor.  Corbet is known for playing Mason Freeland in the film Thirteen, Brian Lackey in the film Mysterious Skin, Alan Tracy in the 2004 film Thunderbirds, and Peter in the 2008 film Funny Games.  He has made guest appearances on many American television shows.  His most recent television role was in Fox TV's award winning drama series 24, playing Derek Huxley, the son of Jack Bauer's (Kiefer Sutherland) new girlfriend.  Brady appeared in the first six episodes of the fifth season...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oZtrpo2tEQsO0gpoR6nrmyyOqxy.jpg", url:"https://themoviedb.org/person/55493"}}, {tmdbId:"134184", properties:{imdbId:"0910966", born:date('1976-05-17'), name:"Leehom Wang", bio:"Leehom Wang (born May 17, 1976) is an American-born singer-songwriter,  record producer, actor and film director of Chinese descent based in  Taiwan.  Formally trained at the Eastman School of Music, Williams  College and Berklee College of Music, his musical style is known for  fusing Chinese elements (such as Beijing opera, traditional styles of  ethnic minorities, Chinese classical orchestra) with hip-hop and  R&amp;B.  Wang has been active since 1995 and contributed in 25 albums...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/73FJCr95j0cwvIQhOglSJakbQS8.jpg", url:"https://themoviedb.org/person/134184"}}, {tmdbId:"10917", properties:{bornIn:"Gonesse, Val d'Oise, France", imdbId:"0008787", born:date('1962-03-05'), name:"Simon Abkarian", bio:"Simon Abkarian (born 5 March 1962) is a French-Armenian actor. \n\nBorn in Gonesse, Val d'Oise, of Armenian descent, Abkarian spent his childhood in Lebanon.  He moved to Los Angeles, where he joined an Armenian theater company managed by Gerald Papazian.  He returned to France in 1985, settling in Paris.  He took classes at the Acting International school, then he joined Ariane Mnouchkine's Théâtre du Soleil...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rpw1AujIl0vJD6cyMDo2ykJ8rZA.jpg", url:"https://themoviedb.org/person/10917"}}, {tmdbId:"122468", properties:{bornIn:"Nagasaki, Japan", imdbId:"2337578", born:date('1989-10-18'), name:"Riisa Naka", bio:"Riisa Naka (born on October 18, 1989 in Nagasaki prefecture) is a Japanese actress.  She was given a Best New Talent award at the 2009 Yokohama Film Festival.  Naka became famous for appearing in Hachi One Diver...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kqWd06a0m28Y3sPnZ28xJfmG9Tb.jpg", url:"https://themoviedb.org/person/122468"}}, {tmdbId:"122469", properties:{imdbId:"1897007", name:"Takuya Ishida", url:"https://themoviedb.org/person/122469"}}] AS row
