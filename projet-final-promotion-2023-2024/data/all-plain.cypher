UNWIND [{tmdbId:"175829", properties:{bornIn:"Saginaw, Michigan, USA", imdbId:"0195421", born:date('1968-06-29'), name:"Brian d'Arcy James", bio:"Brian d'Arcy James (born June 29, 1968) is an American actor and musician...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2Gz3b0A20Vrq7aadGfjZekdgGFK.jpg", url:"https://themoviedb.org/person/175829"}}, {tmdbId:"18460", properties:{bornIn:"Mexico City, Distrito Federal, Mexico", imdbId:"1739844", born:date('1994-04-06'), name:"Adrián Alonso Barona", url:"https://themoviedb.org/person/18460"}}, {tmdbId:"1545769", properties:{name:"Antanas Mockus", url:"https://themoviedb.org/person/1545769"}}, {tmdbId:"109553", properties:{imdbId:"0362985", name:"Alyne Hargroder", url:"https://themoviedb.org/person/109553"}}, {tmdbId:"77071", properties:{bornIn:"Notting Hill, London, England, UK", imdbId:"1053148", born:date('1975-09-04'), name:"Mark Ronson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2xmMlZ7LLlojzSMqNVzwqB5YEsd.jpg", url:"https://themoviedb.org/person/77071"}}, {tmdbId:"138986", properties:{bornIn:"Astoria, Queens, New York City, New York, USA", imdbId:"0004746", born:date('1926-08-03'), name:"Tony Bennett", bio:"From Wikipedia, the free encyclopedia. \n\nTony Bennett (born Anthony Dominick Benedetto; August 3, 1926) is an American singer of popular music, standards, show tunes, and jazz. \n\nRaised in New York City, Bennett began singing at an early age.  He fought in the final stages of World War II as an infantryman with the U. S.  Army in the European Theatre.  Afterwards, he developed his singing technique, signed with Columbia Records, and had his first number one popular song with \"Because of You\" in 1951...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gcbLJMKNsbhkvOobTDOT7DfdDZF.jpg", url:"https://themoviedb.org/person/138986"}}, {tmdbId:"121569", properties:{bornIn:"Beijing, China", imdbId:"0523735", born:date('1981-09-30'), name:"Li Xiaolu", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7zuamJHh4WEAffOz0tn0KbjHpJz.jpg", url:"https://themoviedb.org/person/121569"}}, {tmdbId:"110388", properties:{bornIn:"Seoul, South Korea", imdbId:"2339825", born:date('1981-03-13'), name:"Kim Nam-gil", bio:"Kim Nam-gil  is a South Korean actor, producer, singer and philanthropist.  He is best known from leading roles in disaster blockbuster Pandora (2016); crime thriller The Shameless (2015); adventure film The Pirates (2014) and period drama Portrait of a Beauty (2008).  His breakthrough role was Bidam in the hit television period drama Queen Seondeok (2009)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7UkGczJhdGBzBVV01HFVieDZ8TQ.jpg", url:"https://themoviedb.org/person/110388"}}, {tmdbId:"80984", properties:{bornIn:"Gwangju, South Korea", imdbId:"2608040", born:date('1982-12-14'), name:"Lee Young-hoon", bio:"Lee Young-hoon is a South Korean actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4GswQ6NBVqVVIYSgqqf7qvAbPnP.jpg", url:"https://themoviedb.org/person/80984"}}, {tmdbId:"1686692", properties:{imdbId:"8427114", name:"Angelo Josue Lozano Corzo", url:"https://themoviedb.org/person/1686692"}}, {tmdbId:"81516", properties:{bornIn:"Los Angeles, California, U.S.", imdbId:"0479612", born:date('1966-12-08'), name:"Matthew Charles Laborteaux", bio:"Matthew Laborteaux (born December 8, 1966) is an American actor who has starred in television and film.  He is perhaps best known for portraying the character Albert Quinn Ingalls on the hit NBC series Little House on the Prairie from 1976 to 1983. \n\nDescription above from the Wikipedia article Matthew Laborteaux, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/igvf3w0EeCAQnkFuBLoC58xhq8.jpg", url:"https://themoviedb.org/person/81516"}}, {tmdbId:"1137025", properties:{imdbId:"3140158", name:"Bessie Lou Cornett", url:"https://themoviedb.org/person/1137025"}}, {tmdbId:"1727842", properties:{imdbId:"1303622", name:"Tiffany Taylor", url:"https://themoviedb.org/person/1727842"}}, {tmdbId:"235038", properties:{bornIn:"Chiba, Japan", imdbId:"1398053", born:date('1978-07-22'), name:"Kyoko Hasegawa", bio:"Kyoko Hasegawa is a Japanese actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/65ePdLa8j47s6WMy01wdfsaMFS7.jpg", url:"https://themoviedb.org/person/235038"}}, {tmdbId:"31657", properties:{imdbId:"1927243", name:"Patrick Lichty", url:"https://themoviedb.org/person/31657"}}, {tmdbId:"112580", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0255281", born:date('1931-04-07'), name:"Daniel Ellsberg", bio:"From Wikipedia, the free encyclopedia. \n\nDaniel Ellsberg, PhD, (born April 7, 1931) is a former United States military analyst who, while employed by the RAND Corporation, precipitated a national political controversy in 1971 when he released the Pentagon Papers, a top-secret Pentagon study of U. S.  government decision-making in relation to the Vietnam War, to The New York Times and other newspapers.  He was awarded the Right Livelihood Award in 2006...", url:"https://themoviedb.org/person/112580"}}, {tmdbId:"113390", properties:{bornIn:"Hanoi, Vietnam", imdbId:"0451369", born:date('1963-07-14'), name:"Khanh Lê", bio:"Her older sister is actress Lê Van and her younger sister is actress Lê Vi. \n\nThere exists also a second actress with the name Le Khánh, but is younger than her...", url:"https://themoviedb.org/person/113390"}}, {tmdbId:"32682", properties:{bornIn:"Copenhague,Danemark", imdbId:"0159907", born:date('1985-02-03'), name:"Stine Fischer Christensen", url:"https://themoviedb.org/person/32682"}}, {tmdbId:"33321", properties:{bornIn:"Chicago, Illinois, United States", imdbId:"0429207", born:date('1954-08-12'), name:"Sam Jones", bio:"Sam J.  Jones is the stage name of Samuel Gerald Jones (born August 12, 1954), an American actor also credited as Sam Jones...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ptHE53oef03sXzQ3ZvERw568FVB.jpg", url:"https://themoviedb.org/person/33321"}}, {tmdbId:"115138", properties:{imdbId:"0565372", name:"Liz McCartney", url:"https://themoviedb.org/person/115138"}}] AS row
