UNWIND [{tmdbId:"1413155", properties:{bornIn:"Itararé, São Paulo, Brazil", imdbId:"0142762", born:date('1968-10-16'), name:"Carlos Casagrande", url:"https://themoviedb.org/person/1413155"}}, {tmdbId:"59254", properties:{imdbId:"1032567", born:date('1978-04-26'), name:"Pablo Schreiber", bio:"Pablo Tell Schreiber (born April 26, 1978) is a Canadian actor known for his dramatic stage work and for his portrayal of Nick Sobotka on The Wire and for his Emmy nominated role of George Mendez on Orange Is the New Black.  He was nominated for a Tony Award for his performance in Awake and Sing! on Broadway.  He also narrated the American Psycho audiobook...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1IhXVbbeLQxuyYRNT4M2KWi9ehr.jpg", url:"https://themoviedb.org/person/59254"}}, {tmdbId:"53650", properties:{bornIn:"New Orleans, Louisiana, USA", imdbId:"1107001", born:date('1979-09-23'), name:"Anthony Mackie", bio:"Anthony Mackie (born September 23, 1979) is an American actor.  He has been featured in feature films, television series and Broadway and Off-Broadway plays, including Ma Rainey's Black Bottom, Drowning Crow, McReele, A Soldier's Play, and Talk, by Carl Hancock Rux, for which he won an Obie Award in 2002. \n\nHe was nominated for Best Supporting Actor at the 2009 Independent Spirit Awards for his role in The Hurt Locker...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kfTwOYr3iUucmYz8kPjhYy07G2Z.jpg", url:"https://themoviedb.org/person/53650"}}, {tmdbId:"26718", properties:{bornIn:"East Orange, New Jersey, USA", imdbId:"0592923", born:date('1976-01-15'), name:"Dorian Missick", bio:"Dorian Missick (born January 15, 1976) is an American actor, best known for his roles as Damian in Six Degrees and Victor Vance in Grand Theft Auto: Vice City Stories.  Missick was born in East Orange, NJ, but grew up mainly in Plainfield, NJ, and Decatur, Georgia.  His film Premium and his parts in movies such as The Manchurian Candidate and Lucky Number Slevin have won him critical acclaim and various other accolades...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n1Wsh7AZjsWcanQrTLwjZvGKw66.jpg", url:"https://themoviedb.org/person/26718"}}, {tmdbId:"81917", properties:{bornIn:"Fort Smith, Arkansas, USA", imdbId:"1382799", born:date('1980-12-08'), name:"Juliette Danielle", url:"https://themoviedb.org/person/81917"}}, {tmdbId:"81918", properties:{bornIn:"Walnut Creek, California, USA", imdbId:"0802995", born:date('1978-07-15'), name:"Greg Sestero", bio:"Greg Sestero was born and raised in the San Francisco Bay Area.  With European parental influence, Greg speaks both French and English.  He traveled extensively early on, and holds dual citizenship between France and the United States. \n\nAt 17 years old, Greg signed with a prominent San Francisco talent agency.  The same year, he left for Milan and Paris to work for designers such as Giorgio Armani and Gian Franco Ferre.  Greg returned focused on acting...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ySLUoDUVQB1IjgsaX9ktPaz58Rh.jpg", url:"https://themoviedb.org/person/81918"}}, {tmdbId:"81919", properties:{imdbId:"1223979", name:"Philip Haldiman", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sNJdUfzX8cryH1rnkez2MVacP10.jpg", url:"https://themoviedb.org/person/81919"}}, {tmdbId:"64064", properties:{bornIn:"Bronx, New York", imdbId:"0020248", born:date('1991-04-28'), name:"Aleisha Allen", bio:"From Wikipedia, the free encyclopedia. \n\nAleisha LaNaé Allen (born April 28, 1991; Bronx, New York) is an American actress and singer...", url:"https://themoviedb.org/person/64064"}}, {tmdbId:"64066", properties:{bornIn:"New Orleans, Louisiana, USA", imdbId:"0092774", born:date('1995-03-19'), name:"Philip Bolden", bio:"From Wikipedia, the free encyclopedia. \n\nPhilip Daniel Bolden (born March 19, 1995), known professionally as Philip D.  Bolden, Philip Bolden is a young American actor...", url:"https://themoviedb.org/person/64066"}}, {tmdbId:"40665", properties:{imdbId:"0404332", name:"Derek Hutchinson", url:"https://themoviedb.org/person/40665"}}, {tmdbId:"94677", properties:{bornIn:"Chelmsford, Essex, UK", imdbId:"0504675", name:"Mark Letheren", bio:"​From Wikipedia, the free encyclopedia.   \n\nMark Letheren (born 1971, Chelmsford, Essex, UK) is an English actor possibly best known for his role as journalist Simon Kitson in ITV1s drama The Bill and for his recurring role as DS Kevin Geoffries in Wire in the Blood. \n\nDescription above from the Wikipedia article  Mark Letheren, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jQV8Jn0OvKjSSH1DT5J9ji66As0.jpg", url:"https://themoviedb.org/person/94677"}}, {tmdbId:"67923", properties:{bornIn:"New Jersey - USA", imdbId:"1586885", born:date('1967-09-05'), name:"Romanthony", died:date('2013-05-07'), url:"https://themoviedb.org/person/67923"}}, {tmdbId:"14598", properties:{bornIn:"Paris,France", imdbId:"0051939", born:date('1975-01-03'), name:"Thomas Bangalter", bio:"Thomas Bangalter is a French musician, record producer, singer, songwriter, DJ, composer and film director.  He is best known as one half of the French house music duo Daft Punk, alongside Guy-Manuel de Homem-Christo...", url:"https://themoviedb.org/person/14598"}}, {tmdbId:"17064", properties:{bornIn:"Clifton, Bedfordshire, England, UK", imdbId:"0924210", born:date('1980-10-14'), name:"Ben Whishaw", bio:"Benjamin John \"Ben\" Whishaw (born 14 October 1980) is an English actor who trained at the Royal Academy of Dramatic Art.  Whishaw is best known for his breakthrough role as Hamlet, his roles in the television series Nathan Barley, Criminal Justice, The Hour and London Spy; and film roles including Perfume: The Story of a Murderer (2006), I'm Not There (2007), Bright Star (2009), Brideshead Revisited (2008), Cloud Atlas (2012), The Lobster (2015) and Suffragette (2015)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e74Cz65ifeNb9zHfUTvF5rTix0d.jpg", url:"https://themoviedb.org/person/17064"}}, {tmdbId:"21180", properties:{bornIn:"Fort Lauderdale, Florida, USA", imdbId:"0058581", born:date('1978-07-21'), name:"Justin Bartha", bio:"Justin Bartha is an American film and television actor, best known for his co-starring role as Riley Poole in the National Treasure feature films and as Doug Billings in The Hangover...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6vj8ilsMp9rfXJ1ad6y1xg2Gx1P.jpg", url:"https://themoviedb.org/person/21180"}}, {tmdbId:"57208", properties:{bornIn:"Yasothon Province, Thailand", imdbId:"1002207", born:date('1965-06-24'), name:"Petchtai Wongkamlao", bio:"Petchtai Wongkamlao, (born June 24, 1965, Yasothon Province, Thailand), is a Thai comedian, actor and film director.  He is best known in Thailand by his stage name, Mum Jokmok and is a popular Thai television personality.  He is variously credited as Mom Jok Mok or Mom Jokmok. \n\nDescription above from the Wikipedia article Petchtai Wongkamlao, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3hmcqU1OfLZ5kbvl7url63VuWMJ.jpg", url:"https://themoviedb.org/person/57208"}}, {tmdbId:"57272", properties:{imdbId:"1438146", born:date('1982-02-09'), name:"Pumwaree Yodkamol", url:"https://themoviedb.org/person/57272"}}, {tmdbId:"57273", properties:{bornIn:"Lopburi, Thailand", imdbId:"0690422", name:"Suchao Pongwilai", url:"https://themoviedb.org/person/57273"}}, {tmdbId:"77274", properties:{bornIn:"Kabul, Afghanistan", imdbId:"1385208", born:date('1990-03-10'), name:"Marina Golbahari", bio:"​From Wikipedia, the free encyclopedia\n\nMarina Golbahari (born March 10,1990 Kabul, Afghanistan) is an Afghan actress who earned international fame for her role as the title character in the 2003 film Osama, playing a girl who had to dress and act as a boy to support her family during the Taliban years. \n\nShe was cast as Osama by the Afghan film director Siddiq Barmak...", url:"https://themoviedb.org/person/77274"}}, {tmdbId:"77276", properties:{imdbId:"1387181", name:"Zubaida Sahar", url:"https://themoviedb.org/person/77276"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"1413842", properties:{imdbId:"6268309", name:"Mohammad Nadir Khwaja", url:"https://themoviedb.org/person/1413842"}}, {tmdbId:"43775", properties:{bornIn:"Evergreen Park, Illinois, USA", imdbId:"0528331", born:date('1960-07-14'), name:"Jane Lynch", bio:"Jane Lynch is an American comedian, actress , singer and writer, best known for her portrayal of Sue Sylvester in the FOX musical-comedy series \"Glee\".  She holds a BA in Theater from Illinois State University, Normal, Illinois, and an MFA in Theater from Cornell University, Ithaca, New York...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dti0cp3PkJzZG3EMR0Qui8DKwYm.jpg", url:"https://themoviedb.org/person/43775"}}, {tmdbId:"132993", properties:{bornIn:"London, England", imdbId:"0635820", born:date('1967-02-12'), name:"Hermione Norris", bio:"Hermione Norris is an English actress. \n\nNorris attended the London Academy of Music and Dramatic Art in the 1980s before taking small roles in theatre and on television.  In 1996, she was cast in her breakout role of Karen Marsden in the comedy drama television series Cold Feet.  She appeared in every episode of the series from 1998 to 2003 and was nominated for a British Comedy Award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x2qg33wx8d3A7pYPiKtkJHxwhKQ.jpg", url:"https://themoviedb.org/person/132993"}}, {tmdbId:"183180", properties:{imdbId:"0912353", name:"John Warnaby", url:"https://themoviedb.org/person/183180"}}, {tmdbId:"12672", properties:{bornIn:"Suzhou, Jiangsu, China", imdbId:"0490500", born:date('1965-12-08'), name:"Carina Lau", bio:"Carina Lau is a Hong Kong-based Chinese film actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5Va4jk69gkdAcABtkTtcUz85RLA.jpg", url:"https://themoviedb.org/person/12672"}}, {tmdbId:"63584", properties:{bornIn:"Hong Kong, British Crown Colony [now China]", imdbId:"0628757", born:date('1961-12-21'), name:"Francis Ng", bio:"Francis Ng Chun-yu (born 21 December 1961) is a Hong Kong actor and director.  He is known for his roles in the TVB series Triumph in the Skies and in films such as Young and Dangerous, Once Upon a Time in Triad Society and The Mission...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nu46zSuc3Kr7GQVIQHOgZD5P2s9.jpg", url:"https://themoviedb.org/person/63584"}}, {tmdbId:"73457", properties:{bornIn:"Virginia, Minnesota, USA", imdbId:"0695435", born:date('1979-06-21'), name:"Chris Pratt", bio:"Christopher Michael Pratt, better know as Chris Pratt is an American actor, known for his roles as Harold Brighton \"Bright\" Abbott in the television series Everwood, the recurring character Winchester \"Ché\" Cook in season 4 of The OC, and Andy Dwyer in the television series Parks and Recreation. \n\nPratt is most known for portraying Peter Quill/Star Lord in the Marvel Cinematic Universe.  He has portrayed the character in Guardians of the Galaxy (2014), Guardians of the Galaxy Vol...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gXKyT1YU5RWWPaE1je3ht58eUZr.jpg", url:"https://themoviedb.org/person/73457"}}, {tmdbId:"76793", properties:{bornIn:"Jaipur, Rajasthan, India", imdbId:"0451234", born:date('1967-01-07'), name:"Irrfan Khan", bio:"Saahabzaade Irfan Ali Khan credited as Irrfan Khan or simply Irrfan, was an Indian film actor, known for his work predominantly in Hindi cinema, as well as his works in British films and Hollywood.  In a film career spanning almost thirty years and featuring in more than fifty domestic films, Khan received numerous awards, including a National Film Award and Filmfare Awards in four categories...", died:date('2020-04-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qkA9PpWJRw3rNjVkWfNZdwLvRZx.jpg", url:"https://themoviedb.org/person/76793"}}, {tmdbId:"19907", properties:{bornIn:"Madrid, Spain", imdbId:"0749104", born:date('1965-03-16'), name:"Belén Rueda", bio:"​Rueda was born in Madrid.  Her father was a civil engineer and her mother was a ballet instructor.  She is the second of three children; her siblings are named Chus and Violeta (Ms.  Rodal).  She and her family moved to San Juan, Alicante when she was a child because of her younger sister's asthmatic problems.  She was married to Daniel Écija and had three children with him, Beliá (b. 1994), María (b. 1996) and Lucía (b. 1998); unfortunately, their second child died of a heart disease as a baby...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1J3Wy42UCkCR77iF3P1PTC8yWTs.jpg", url:"https://themoviedb.org/person/19907"}}, {tmdbId:"2759", properties:{bornIn:"Barcelona, Spain", imdbId:"0240318", born:date('1971-10-06'), name:"Lola Dueñas", bio:"Lola Dueñas (born October 6, 1971) is a Spanish actress.  She is the daughter of Nicolás Dueñas and studied in the Institut del Teatre of Barcelona...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4ZnqM9bHq7W4j3Z7qLON9qM5sRG.jpg", url:"https://themoviedb.org/person/2759"}}, {tmdbId:"33409", properties:{imdbId:"0729345", born:date('1952-06-20'), name:"Mabel Rivera", url:"https://themoviedb.org/person/33409"}}, {tmdbId:"171075", properties:{bornIn:"Houston, Texas, USA", imdbId:"0933156", born:date('1969-08-27'), name:"Chandra Wilson", bio:"Chandra Danette Wilson (born August 27, 1969) is an American actress and director, best known as Dr.  Miranda Bailey on the ABC television drama, Grey's Anatomy. \n\nDescription above from the Wikipedia article Chandra Wilson, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/83Ynxlv3jV4ahkOiAEfunM7Rez2.jpg", url:"https://themoviedb.org/person/171075"}}, {tmdbId:"60526", properties:{imdbId:"1669663", born:date('1978-05-04'), name:"Sebastien Andrieu", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2hrdVtAlhLK8CdrscLbc48MSuuy.jpg", url:"https://themoviedb.org/person/60526"}}, {tmdbId:"64148", properties:{bornIn:"Reno, Nevada, U.S.", imdbId:"0255175", born:date('1993-09-22'), name:"Chase Ellison", bio:"From Wikipedia, the free encyclopedia\n\nChase Ellison (born September 22, 1993) is an American actor.  He is best known for his roles in Mysterious Skin and Tooth Fairy. \n\nDescription above from the Wikipedia article Chase Ellison, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/64148"}}, {tmdbId:"25347", properties:{bornIn:"Sablé-sur-Sarthe, Sarthe, France", imdbId:"0222088", born:date('1975-10-27'), name:"Lorànt Deutsch", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/57e6k74zTnZPx95nKOLPNw8VpBk.jpg", url:"https://themoviedb.org/person/25347"}}, {tmdbId:"17074", properties:{bornIn:"Copenhagen, Denmark", imdbId:"1271759", born:date('1986-10-04'), name:"Sara Forestier", bio:"Sara Forestier (born 4 October 1986 in Copenhagen, Denmark) is a French actress and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xtNEa5vbzZ8IWI5bTn5zlMy6Cz2.jpg", url:"https://themoviedb.org/person/17074"}}, {tmdbId:"39884", properties:{bornIn:"Dijon, Côte-d'Or, France", imdbId:"0291790", born:date('1947-04-04'), name:"Jacques Frantz", bio:"Jacques Frantz est un acteur français, né le 4 avril 1947 à Dijon, en Côte-d'Or.  Il est surtout célèbre pour sa voix, qu'il prête de façon régulière à des grands comédiens américains, tels que Robert De Niro, Mel Gibson,John Goodman et Nick Nolte.  Jacques Frantz a également joué dans de nombreux longs-métrages.  Il est le père de Marjorie Frantz, actrice spécialisée également dans le doublage.  On l'entend également dans de nombreuses publicités, radio et télévision...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tGa8DHACbaDKnNRBGWSJjgEf2KS.jpg", url:"https://themoviedb.org/person/39884"}}, {tmdbId:"24265", properties:{bornIn:"Bath, Somerset, England, UK [now Bath and North East Somerset, England, UK]", imdbId:"0047155", born:date('1964-01-13'), name:"Bill Bailey", bio:"From Wikipedia, the free encyclopedia. \n\nBill Bailey (born Mark Bailey 13 January 1964, Bath, Somerset) is an English stand-up comedian, musician and actor.  As well as his extensive stand-up work, Bailey is well known for his appearances on Have I Got News for You, Never Mind the Buzzcocks, QI and Black Books. \n\nBailey was listed by The Observer as one of the 50 funniest acts in British comedy in 2003...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hA3vK90snmnt1xtuJR4Iac0YRXe.jpg", url:"https://themoviedb.org/person/24265"}}, {tmdbId:"44185", properties:{bornIn:"Fort Bragg, North Carolina, USA", imdbId:"0779399", born:date('1965-12-22'), name:"Judith Scott", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h1oDVb4GuihdB1hgrr8Zqm9kagm.jpg", url:"https://themoviedb.org/person/44185"}}, {tmdbId:"76137", properties:{imdbId:"0399838", name:"Garth Hudson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nUfj7MKyylQXlY7zLGPFXhHK8gt.jpg", url:"https://themoviedb.org/person/76137"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"9273", properties:{bornIn:"Vicenza, Veneto, Italy", imdbId:"0010736", born:date('1974-08-20'), name:"Amy Adams", bio:"Amy Lou Adams (born: August 20, 1974) in Vicenza, Veneto, Italy, to American parents Kathryn (Hicken) and Richard Kent Adams, while her father was a U. S.  serviceman.  She was raised in a Mormon family of seven children in Castle Rock, Colorado, and has English, as well as smaller amounts of Danish, Swiss-German, and Norwegian, ancestry. \n\nAdams sang in the school choir at Douglas County High School and was an apprentice dancer at a local dance company, with the ambition of becoming a ballerina...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ErcpRbDpYMvtskakR8pklpa7rF.jpg", url:"https://themoviedb.org/person/9273"}}, {tmdbId:"1709", properties:{bornIn:"Suffolk, England, UK", imdbId:"0202603", born:date('1973-03-01'), name:"Jack Davenport", bio:"Jack Davenport is a British film and television actor, best known for his roles in television series' such as \"This Life\" and \"Coupling\", as well as the \"Pirates of the Caribbean\" franchise of feature films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4asp2xBJS98Tx8yKTLyWn7fjLKj.jpg", url:"https://themoviedb.org/person/1709"}}, {tmdbId:"34519", properties:{bornIn:"Manhattan Beach - California - USA", imdbId:"0588766", born:date('1976-08-20'), name:"Kristen Miller", bio:"From Wikipedia, the free encyclopedia. \n\nKristen Miller (born August 20, 1976) is an American actress who has appeared in guest and in leading roles in many television shows, including USA High, That's My Bush!, Two and a Half Men, Charmed, She Spies and Undressed.  She also has appeared in The Fallen Ones, Reality Check, I hate my 30s, Las Vegas, Team America: World Police, Single White Female 2: The Psycho; and provided the voice-over for the character Rio in the video game Lifeline...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/plgKgewVheRyAPbWZSGzo9Zksfq.jpg", url:"https://themoviedb.org/person/34519"}}, {tmdbId:"34520", properties:{imdbId:"0556089", name:"Masasa Moyo", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9TvAkxkLGsnREVqzg7JRHtSVzZW.jpg", url:"https://themoviedb.org/person/34520"}}, {tmdbId:"21171", properties:{bornIn:" Paris, France", imdbId:"0432040", born:date('1951-05-04'), name:"Gérard Jugnot", bio:"From Wikipedia, the free encyclopedia\n\nGérard Jugnot (born 4 May 1951 in Paris) is a French actor, film director, screenwriter and producer. \n\nJugnot was one of the founders of the comedy troupe Le Splendid in the 1970s, along with, among others, his high-school friends Christian Clavier, Thierry Lhermitte, and Michel Blanc...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jsr3DLxv74DCpVIZPPspoh10q1N.jpg", url:"https://themoviedb.org/person/21171"}}, {tmdbId:"22306", properties:{bornIn:"Sidi Bel Abbes, Algeria", imdbId:"0580101", born:date('1964-03-27'), name:"Kad Merad", bio:"Kad Merad is a French-Algerian filmmaker and actor who has acted both on stage and on screen. \n\nKad Merad was born in Sidi Bel Abbès, Algeria, on March 27, 1964 to an Algerian father and a French mother. \n\nDuring his teens, he played drums and sang with various rock bands.  Soon afterwards, he started playing as an animator in Club Med alongside the Gigolo Brothers troop. \n\nIn 1990, he was hired by Ouï FM, the Paris Rock genre station where he met Olivier Baroux...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n4hjy7VFVgzRx5WVsElv4AKdotB.jpg", url:"https://themoviedb.org/person/22306"}}, {tmdbId:"43998", properties:{bornIn:"Chaux, Côte-d'Or, France", imdbId:"0094786", born:date('1943-10-03'), name:"Jean-Paul Bonnaire", bio:"Jean-Paul Bonnaire (3 October 1943 - 28 March 2013) was a French actor.  He appeared in more than one hundred films from 1975 to 2013. \n\nSource: Article \"Jean-Paul Bonnaire\" from Wikipedia in english, licensed under CC-BY-SA 3. 0...", died:date('2013-03-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hyFymjmG0HPeEH9gTVTHodkbKec.jpg", url:"https://themoviedb.org/person/43998"}}, {tmdbId:"20386", properties:{bornIn:"Minneapolis, Minnesota, U.S.", imdbId:"0004736", born:date('1973-12-30'), name:"Jason Behr", bio:"From Wikipedia, the free encyclopedia. \n\nJason Nathaniel Behr (born December 30, 1973) is an American film and television actor.  He first starred in the American television series Roswell, for which he was twice nominated for a Saturn Award, followed by roles in the films The Shipping News and the American remake of the Japanese horror film The Grudge...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/f5MY20huXGVDQbRHpKeobV6H6wS.jpg", url:"https://themoviedb.org/person/20386"}}, {tmdbId:"64341", properties:{bornIn:"New York, New York, USA", imdbId:"1107178", born:date('1981-06-22'), name:"Amanda Brooks", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x8WndbTvjbG6Z4QeDv0Knh8jLvS.jpg", url:"https://themoviedb.org/person/64341"}}, {tmdbId:"64342", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0732497", born:date('1971-10-25'), name:"Craig Robinson", bio:"From Wikipedia, the free encyclopedia.   \n\nCraig Phillip Robinson (born October 25, 1971) is an actor and stand-up comedian.  He is best known for his roles on The Office as Darryl Philbin and in the films Pineapple Express, Zack and Miri Make a Porno and Hot Tub Time Machine. \n\nDescription above from the Wikipedia article Craig Robinson(actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vieAPkgyYKHN6NyIIRj2Cvne8zT.jpg", url:"https://themoviedb.org/person/64342"}}, {tmdbId:"70785", properties:{bornIn:"Iceland", imdbId:"1715194", born:date('1982-05-29'), name:"Anita Briem", bio:"Anita Briem (born 29 May 1982) is an Icelandic actress.  She is known for her role as Jane Seymour on The Tudors and her role as Hannah in Journey to the Center of the Earth. \n\nDescription above from the Wikipedia article Anita Briem, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8M6MkLKpAXKRoYlhOH5LzBhBGFv.jpg", url:"https://themoviedb.org/person/70785"}}, {tmdbId:"62856", properties:{bornIn:"Bedford, New Hampshire, USA", imdbId:"1024878", born:date('1973-12-28'), name:"Seth Meyers", bio:"Seth Adam Meyers (born December 28, 1973) is an American comedian, writer, political commentator, actor, and television host.  He is best known for serving as cast member and later head writer as well on Saturday Night Live from 2001 to 2014.  He notably anchored its news parody segment Weekend Update.  After leaving Saturday Night Live, Meyers became the host of late-night talk show Late Night with Seth Meyers.  Meyers has also appeared in various films and hosted several awards shows...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nCcvpJFHWYHfu5oPxTOyA1uSdqA.jpg", url:"https://themoviedb.org/person/62856"}}, {tmdbId:"1287732", properties:{bornIn:"Beijing, China", imdbId:"0271815", born:date('1958-03-18'), name:"Xiaogang Feng", bio:"From Wikipedia, the free encyclopedia.   \n\nFeng Xiaogang (born 1958) is a Chinese film director.  He is famous in China as being perhaps the most successful \"commercialized\" filmmaker whose comedy films do consistently well in the box office, although Feng has attempted to break out from that mold by making drama or period drama films recently. \n\nDescription above from the Wikipedia article Feng Xiaogang, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yk7r8HI9KtrVt9pTcLAZpTvrRPg.jpg", url:"https://themoviedb.org/person/1287732"}}, {tmdbId:"57610", properties:{imdbId:"1784503", name:"Zhi Hua Dong", url:"https://themoviedb.org/person/57610"}}, {tmdbId:"1873133", properties:{name:"Edmund Bacon", url:"https://themoviedb.org/person/1873133"}}, {tmdbId:"1758524", properties:{name:"Balkrishna Doshi", url:"https://themoviedb.org/person/1758524"}}, {tmdbId:"236074", properties:{name:"Frank O. Gehry", url:"https://themoviedb.org/person/236074"}}, {tmdbId:"63492", properties:{bornIn:"Salt Lake City, Utah, U.S", imdbId:"0021607", born:date('1979-05-25'), name:"Corbin Allred", bio:"​From Wikipedia, the free encyclopedia.   \n\nCorbin Michael Allred (born May 25, 1979) is an American actor, most notably as starring in the 2003 award-winning motion picture Saints and Soldiers, and the 1997–1998 television series Teen Angel. \n\nHe was also in Josh Kirby. . .  Time Warrior!, Quest of the Delta Knights and known for his role in Robin Hood: Men in Tights.  He has also appeared on an episode of CSI: Crime Scene Investigation and in an episode of NCIS...", url:"https://themoviedb.org/person/63492"}}, {tmdbId:"63493", properties:{bornIn:"San Francisco, California, U.S.", imdbId:"0689168", born:date('1974-10-07'), name:"Alexander Polinsky", bio:"​From Wikipedia, the free encyclopedia.   \n\nAlexander Polinsky (born October 7, 1974) is an American actor, voice actor, and singer who is perhaps best known for his role as Adam Powell on Charles in Charge.  After the show ended, he has made TV, voice, and movie appearances, as well as working as a mold-maker at a movie prop design studio.  He works with the Walt Disney Company, Cartoon Network, Warner Brothers, and Nickelodeon...", url:"https://themoviedb.org/person/63493"}}, {tmdbId:"63494", properties:{bornIn:"Evanston, Wyoming, USA", imdbId:"1109458", born:date('1977-10-08'), name:"Kirby Heyborne", bio:"Kirby Heyborne (born October 8, 1977) is an actor, musician, singer-songwriter, and comedian known for his work in LDS films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5tR4b8OjeqPps7a5I7ogqjsachv.jpg", url:"https://themoviedb.org/person/63494"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"426", properties:{bornIn:"Marysville, California, USA", imdbId:"0046541", born:date('1974-03-07'), name:"Larry Bagby", bio:"​From Wikipedia, the free encyclopedia.   \n\nLarry Bagby (born March 7, 1974) is an American actor and a musician. \n\nBagby was born Lawrence Bagby III in Marysville, California.  His father was a member of a dance band.  Bagby's most notable roles include:\n\nFrank Ellis, Young and the Restless, 2008\n\nAdam Pendon, Believe The Movie, 2007\n\nMarshall Grant (upright bass player), Walk the Line, 2005\n\nPvt...", url:"https://themoviedb.org/person/426"}}, {tmdbId:"11705", properties:{bornIn:"Winthrop, Iowa, USA", imdbId:"1157358", born:date('1976-03-23'), name:"Michelle Monaghan", bio:"American actress Michelle Lynn Monaghan's first notable roles were in episodes of Young Americans, and Law & Order: Special Victims Unit, both in 2001.  That year she also her big screen debut in the movie \"Perfume\" (2001), followed by another small role in \"Unfaithful\" (2002). \n\nMonaghan had her big break in 2002 when she co-starred in the television series Boston Public...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jB47BoGdudHELszn9ZAZqnnUy8N.jpg", url:"https://themoviedb.org/person/11705"}}, {tmdbId:"9832", properties:{bornIn:"Saskatchewan, Canada", imdbId:"0541932", born:date('1966-12-08'), name:"Tyler Mane", bio:"From Wikipedia, the free encyclopedia. \n\nDaryl Karolat (born December 8, 1966) is a Canadian actor and former professional wrestler, better known by the stage name Tyler Mane.  He is also known for playing Michael Myers In Halloween and Halloween II and Sabretooth in X-Men. \n\nDescription above from the Wikipedia article Tyler Mane, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h5knoBWStVv7a0FKPwfKV7f7Ez1.jpg", url:"https://themoviedb.org/person/9832"}}, {tmdbId:"21317", properties:{bornIn:"San Diego, California, USA", imdbId:"1698761", born:date('1996-09-27'), name:"Daeg Faerch", bio:"From Wikipedia, the free encyclopedia\n\nDaeg Faerch (born September 27, 1996) is an American actor.  His credits include a comedic role in Peter Berg's Hancock (2008) and, most notably, in the horror remake Halloween (2007).  Faerch has also played in theatrical productions of Grapes of Wrath in which he played the role of Winfield, Marat/Sade in which he played the role of young Herald, Waiting for Godot playing the messenger, and Shakespeare Unabridged as a musical guest rapper...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x6bSk6Wy98RZGqrt3nyhdp4Da4c.jpg", url:"https://themoviedb.org/person/21317"}}, {tmdbId:"10982", properties:{bornIn:"London, England, UK", imdbId:"0577982", born:date('1989-03-13'), name:"Harry Melling", bio:"Harry Edward Melling (born 13 March 1989) is an English actor, best known for his role as Dudley Dursley in the Harry Potter film series...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/b0pHwi2MeqxEpeWnF4Llihu53aJ.jpg", url:"https://themoviedb.org/person/10982"}}, {tmdbId:"1093972", properties:{imdbId:"2144593", name:"Jason Boyd", url:"https://themoviedb.org/person/1093972"}}, {tmdbId:"1093973", properties:{imdbId:"2178650", name:"Richard Macklin", url:"https://themoviedb.org/person/1093973"}}, {tmdbId:"2244", properties:{bornIn:"Copenhagen, Denmark", imdbId:"0159802", born:date('1948-05-16'), name:"Jesper Christensen", bio:"From Wikipedia, the free encyclopedia. \n\nJesper Christensen (born 16 May 1948) is a Danish actor.  A veteran of European cinema, he has more recently made the transition to English language projects, including The Interpreter and Revelations.  He has also appeared as the mysterious villain Mr.  White in the James Bond film Casino Royale and its sequel, Quantum of Solace...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bRLisbUkTCvn4mO50EBIWMb197T.jpg", url:"https://themoviedb.org/person/2244"}}, {tmdbId:"42067", properties:{bornIn:"Budapest, Hungary", imdbId:"0190800", born:date('1975-12-19'), name:"Sándor Csányi", bio:"Csányi Sándor (Budapest, 1975.  december 19.  – ) Jászai Mari-díjas magyar színész. \n\nGyermekkora óta színésznek készült.  Az általános iskola elvégzése után épületgépészeti szakközépiskolában tanult.  Érettségi után a kaposvári Csiky Gergely Színházban segédszínészként tanulta a színészmesterséget.  1997-ben negyedik felvételije sikeres volt a Színház- és Filmművészeti Főiskolára, Marton László osztályába.  A főiskola elvégzése után, 2001-ben, a Krétakör Színház tagja lett...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/67kSNXXWLpyVRDkFiRXzzRBHMvG.jpg", url:"https://themoviedb.org/person/42067"}}, {tmdbId:"42069", properties:{bornIn:"Abony, Pest, Hungary", imdbId:"0610904", born:date('1957-09-08'), name:"Zoltán Mucsi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wMJGYAVZFcCwWVGdrq6u1pxNfWf.jpg", url:"https://themoviedb.org/person/42069"}}, {tmdbId:"42068", properties:{imdbId:"0683950", name:"Csaba Pindroch", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lfXlnyuUgnjRhVhWKNxICstNflY.jpg", url:"https://themoviedb.org/person/42068"}}, {tmdbId:"42070", properties:{bornIn:"Jászberény, Hungary", imdbId:"0046269", born:date('1964-02-08'), name:"Sándor Badár", bio:"Badár Sándor (Jászberény, 1964.  február 8.  –) Karinthy-gyűrűs magyar színész, humorista. \n\nA szentesi Horváth Mihály Gimnázium drámatagozatára járt, Hevesi Tamás, Ternyák Zoltán, Jantyik Csaba osztálytársa volt.  Az iskola után 12 évig a vasútnál dolgozott, először bakterként, majd forgalomirányítóként.  Horányban él, gyereklovagoltatással foglalkozik. \n\nHa hívják, filmekben játszik, utánozhatatlan karakter...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pRhBhFqeC1fzAlomVblOsYj6FSx.jpg", url:"https://themoviedb.org/person/42070"}}, {tmdbId:"644", properties:{bornIn:"Boston - Massachusetts - USA", imdbId:"0752436", born:date('1967-01-12'), name:"Blanchard Ryan", bio:"From Wikipedia, the free encyclopedia\n\nSusan Blanchard Ryan (born January 12, 1967) is an American actress.  Since a \"Susan Ryan\" was previously registered with the Screen Actors Guild, Ryan used her middle name instead...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7dLq8Yo8ZuxaE34p9XZhQpPXtSJ.jpg", url:"https://themoviedb.org/person/644"}}, {tmdbId:"646", properties:{bornIn:"Clarkston, Michigan, USA", imdbId:"1047403", born:date('1968-03-10'), name:"Daniel Travis", bio:"From Wikipedia, the free encyclopedia\n\nDaniel Travis (born March 10, 1968) is an American actor. \n\nTravis was born and raised in Clarkston, Michigan.  He received a BFA in theater from Miami University in Oxford, Ohio.  He went on to receive an MFA at The Mason Gross School of the Arts at Rutgers University.  His early work was on the stage, playing John Buchanan in Summer and Smoke, The Earl of Richmond in Richard III and Paul in Barefoot in the Park...", url:"https://themoviedb.org/person/646"}}, {tmdbId:"1420204", properties:{imdbId:"1677525", name:"Michael E. Williamson", url:"https://themoviedb.org/person/1420204"}}, {tmdbId:"1219536", properties:{bornIn:"Kerala - India", imdbId:"0558598", name:"Suleka Mathew", bio:"From Wikipedia, the free encyclopedia\n\nSuleka \"Sue\" Mathew is a Canadian actress, known for her portrayal of Dr.  Sunita Ramen on the Canadian television series Da Vinci's Inquest. \n\nShe was born in India and raised in Vancouver, Canada, since the age of two.  Her most recent work was in Men in Trees playing the character Sara Jackson.  She was playing a nurse named Bobbie Jackson in the TNT series Hawthorne,  which began in 2009...", url:"https://themoviedb.org/person/1219536"}}, {tmdbId:"76931", properties:{bornIn:"Setagaya, Tokyo, Japan", imdbId:"0620018", born:date('1961-09-18'), name:"Kiichi Nakai", bio:"​From Wikipedia, the free encyclopedia\n\nKiichi Nakai (born 18 September 1961) is a Japanese actor.  His father, Keiji Sada, also a movie actor, died when Nakai was only two years old.  Nakai started his acting career while he was still in university and was awarded the Rookie of the Year of Japan Academy Awards in 1981. \n\nHe won the Japan Academy Best Supporting Actor award in 1994 (for 47 Ronin) and Best Actor award in 2003 (for Mibu gishi den (When the Last Sword is Drawn)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5ztRTQSsoEKwTbMNe4Cpo0SWXt.jpg", url:"https://themoviedb.org/person/76931"}}, {tmdbId:"2411123", properties:{imdbId:"3319591", name:"Sebastian Bertoli", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i1lQ9EoBtC9C7BxfVEAgTD9Jbu.jpg", url:"https://themoviedb.org/person/2411123"}}, {tmdbId:"19154", properties:{bornIn:"Winnipeg, Manitoba, Canada", imdbId:"0319171", born:date('1976-03-14'), name:"Daniel Gillies", bio:"Daniel Gillies (born March 14, 1976) is a Canadian-born New Zealand actor. \n\nDescription above from the Wikipedia article Daniel Gillies, licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zasTOfb8TNyVGwRfb4jNdHnsZ2m.jpg", url:"https://themoviedb.org/person/19154"}}, {tmdbId:"1214447", properties:{bornIn:"Bronx, New York, USA", imdbId:"0363669", born:date('1946-08-29'), name:"Michael Harney", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j64sglNnGc5fAHPEkJ1TmKOITQP.jpg", url:"https://themoviedb.org/person/1214447"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"17289", properties:{bornIn:"Petrópolis, Rio de Janeiro, Brazil", imdbId:"0763928", born:date('1975-08-22'), name:"Rodrigo Santoro", bio:"Rodrigo Junqueira dos Reis Santoro is a Brazilian actor.  He has appeared in many successful movies, including Brainstorm (2001), Carandiru (2003), 300 (2007), Che (2008), I Love You Phillip Morris (2009) and Rio (2011).  He was also a series regular on the Television series Lost portraying the character Paulo...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d3MaF9SPHDn2PMYHuqdnO0Csik6.jpg", url:"https://themoviedb.org/person/17289"}}, {tmdbId:"5887", properties:{bornIn:"Bogotá, Colombia", imdbId:"1503432", born:date('1981-04-19'), name:"Catalina Sandino Moreno", bio:"Catalina Sandino Moreno (born April 19, 1981) is a Colombian actress.  She was nominated for an Academy Award for Best Actress for her role in Maria Full of Grace (2004)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4nLPgs0v1rFZz3c0p9e5Euk0VkU.jpg", url:"https://themoviedb.org/person/5887"}}, {tmdbId:"69221", properties:{bornIn:"Paris, France", imdbId:"0077622", born:date('1983-02-01'), name:"Marilou Berry", bio:"Marilou Berry (born 1 February 1983 in Paris) is a French actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eogHGpLeRVVxdenpGYZR2lG1T3u.jpg", url:"https://themoviedb.org/person/69221"}}, {tmdbId:"53926", properties:{bornIn:"Fort Collins, Colorado, USA", imdbId:"1417647", born:date('1977-10-26'), name:"Jon Heder", bio:"Jonathan Joseph \"Jon\" Heder (born October 26, 1977) is an American screenwriter, actor, and filmmaker.  His feature film debut came in 2004 as the title character of the comedy film Napoleon Dynamite.  He has also acted in the films The Benchwarmers, School for Scoundrels, Blades of Glory, Mama's Boy, and When in Rome, and provided voice talents in the animated films Monster House and Surf's Up...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xGLRJEKKmNsDpz6MefPMU4gqQj1.jpg", url:"https://themoviedb.org/person/53926"}}, {tmdbId:"53927", properties:{bornIn:"Fresno, California, USA", imdbId:"1088052", born:date('1976-06-23'), name:"Aaron Ruell", bio:"From Wikipedia, the free encyclopedia. \n\nAaron Ruell is an American director and photographer.  He is also noted for his performance as Kipland Ronald Dynamite (or Kip) in the indie movie Napoleon Dynamite. \n\nDescription above from the Wikipedia article Aaron Ruell, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9Fa7aDaH64KdziSLEn4gqC2s6bc.jpg", url:"https://themoviedb.org/person/53927"}}, {tmdbId:"20190", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0708293", born:date('1973-10-02'), name:"Efren Ramirez", bio:"From Wikipedia, the free encyclopedia. \n\nEfren Antonio Ramirez (born October 2, 1973) is an American actor. \n\nDescription above from the Wikipedia article Efren Ramirez, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w0bOPRmE84EFeYpl22uGgbKo1Ul.jpg", url:"https://themoviedb.org/person/20190"}}, {tmdbId:"56105", properties:{imdbId:"0853041", born:date('1933-03-19'), name:"Renée Taylor", bio:"Renée Adorée Taylor (born March 19, 1933) is an American actress, screenwriter, playwright, producer and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/XSPvLgklOxoTQZNso2sEsawQdU.jpg", url:"https://themoviedb.org/person/56105"}}, {tmdbId:"29071", properties:{imdbId:"0362327", name:"Jeff Harding", url:"https://themoviedb.org/person/29071"}}, {tmdbId:"162606", properties:{imdbId:"0830198", born:date('1959-04-22'), name:"Ryan Stiles", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/awUGig6kHCKlZ0oXunMxvGwNFEt.jpg", url:"https://themoviedb.org/person/162606"}}, {tmdbId:"18282", properties:{bornIn:"Colombia", imdbId:"0037410", born:date('1969-07-16'), name:"Karina Arroyave", bio:"From Wikipedia, the free encyclopedia\n\nKarina Arroyave (born July 16, 1969) is a Colombian television and film actress, likely best known as Jamey Farrell in 24. \n\nShe has appeared in a total of 3 \"dedicated teacher\" films where the teacher tries to get the inner city students to want to learn (One Eight Seven, Dangerous Minds and Lean on Me).  She also had a role in Crash as wife of Daniel, the Latino locksmith...", url:"https://themoviedb.org/person/18282"}}, {tmdbId:"18283", properties:{bornIn:"Tbilisi, Georgia SSR, USSR", imdbId:"0049079", born:date('1966-05-20'), name:"Dato Bakhtadze", bio:"Dato Bakhtadze was born on May 20, 1966 in Tbilisi, Georgian SSR, USSR...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1iittoHHIZtIalNt3DYsDu86FwL.jpg", url:"https://themoviedb.org/person/18283"}}, {tmdbId:"2524", properties:{bornIn:"Hammersmith, London, England, UK", imdbId:"0362766", born:date('1977-09-15'), name:"Tom Hardy", bio:"Edward Thomas \"Tom\" Hardy (born 15 September 1977) is an English actor.  He is best known for playing the title character in the 2009 British film Bronson, and for his roles in the films Star Trek Nemesis, RocknRolla, and Inception.  He has been cast in the Christopher Nolan film The Dark Knight Rises as Bane.   Description above from the Wikipedia Tom Hardy, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yVGF9FvDxTDPhGimTbZNfghpllA.jpg", url:"https://themoviedb.org/person/2524"}}, {tmdbId:"3543", properties:{bornIn:"Bermondsey, South London", imdbId:"0286044", born:date('1958-05-25'), name:"Jamie Foreman", bio:"From Wikipedia, the free encyclopedia\n\nJamie Foreman (born 1958) is an English actor best known for his roles as Duke in Layer Cake (2004) and Bill Sikes in Roman Polanski's Oliver Twist (2005).  He played opposite Ray Winstone and Kathy Burke in Gary Oldman's Nil by Mouth and also featured in Elizabeth, Gangster No.  1 and Sleepy Hollow.  He appeared in the 2006 Doctor Who episode \"The Idiot's Lantern\".  He also featured as a racist taxi driver in The Football Factory...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yKUHNdA0Oe9JJqHJDLUMRx9Bnfa.jpg", url:"https://themoviedb.org/person/3543"}}, {tmdbId:"39658", properties:{bornIn:"London, England, UK", imdbId:"1020089", born:date('1976-04-27'), name:"Sally Hawkins", bio:"Sally Cecilia Hawkins (born 27 April 1976) is an English actress.  Her breakthrough performance as Poppy Cross in the 2008 film Happy-Go-Lucky won her several international awards, including the Golden Globe Award for Best Actress – Motion Picture Musical or Comedy.  Other significant roles include Susan Wells in Vera Drake (2004), Sue Trinder in the BBC serial Fingersmith (2005), Anne Elliot in Persuasion (2007), Rita O'Grady in Made in Dagenham (2010), Ginger in Blue Jasmine (2013), Dr...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/osYgwtQIiNbPFc8JkFDxreBgqxZ.jpg", url:"https://themoviedb.org/person/39658"}}, {tmdbId:"52116", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0733185", born:date('1967-07-25'), name:"Wendy Raquel Robinson", bio:"Wendy Raquel Robinson (born July 25, 1967) is an American actress.  She is best known for her roles as high school principal Regina Grier on the WB sitcom The Steve Harvey Show, and as sports agent Tasha Mack on the CW/BET comedy-drama The Game. \n\nDescription above from the Wikipedia article Wendy Raquel Robinson, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3yaBYcN0BtlX9rTaatBQJxXOVPx.jpg", url:"https://themoviedb.org/person/52116"}}, {tmdbId:"55085", properties:{bornIn:"Austin, Texas, USA", imdbId:"1720028", born:date('1986-04-22'), name:"Amber Heard", bio:"Amber Laura Heard (born April 22, 1986) is an American actress.  She played the lead and title character in All the Boys Love Mandy Lane, which debuted at the Toronto International Film Festival in 2006.  Heard's first starring role came in 2007 on the CW television show Hidden Palms.  Her breakthrough came in 2008 with roles in Never Back Down and Pineapple Express.  In 2009, Heard starred in The Stepfather and also had a small role in the horror-comedy Zombieland...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1cb5mGzGB6Sj2JPkWt9W16B19Bf.jpg", url:"https://themoviedb.org/person/55085"}}, {tmdbId:"76621", properties:{bornIn:"Hartford, Connecticut, USA", imdbId:"0295115", born:date('1976-08-11'), name:"Will Friedle", bio:"William Alan \"Will\" Friedle is an American actor, voice actor and comedian.  He is best known for his comedic roles, most notably the underachieving elder brother Eric Matthews on the long-running TV sitcom Boy Meets World from 1993 to 2000.  More recently, he has voiced a number of animated characters such as Terry McGinnis, the titular character of Batman Beyond, and Ron Stoppable of Kim Possible...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Ao3fp9f4loVQ1Vvk6ph8HU5p0Lu.jpg", url:"https://themoviedb.org/person/76621"}}, {tmdbId:"68515", properties:{bornIn:"Leningrad, USSR", imdbId:"1426607", born:date('1987-01-25'), name:"Vladimir Garin", died:date('2003-06-24'), url:"https://themoviedb.org/person/68515"}}, {tmdbId:"68516", properties:{bornIn:"Voronezh, Voronezhskaya oblast, RSFSR, USSR, [now Russia]", imdbId:"1424720", born:date('1989-06-02'), name:"Ivan Dobronravov", url:"https://themoviedb.org/person/68516"}}, {tmdbId:"68517", properties:{bornIn:"Rostov-on-Don, Russia", imdbId:"0492249", born:date('1961-04-20'), name:"Konstantin Lavronenko", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lCLKV6DSw7xKvIByWPIBr52tV1k.jpg", url:"https://themoviedb.org/person/68517"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"68518", properties:{bornIn:"Belogorsk, Crimean Oblast, Ukrainian SSR, USSR [now Bilohirsk, Crimea, Ukraine]", imdbId:"0891502", born:date('1969-01-12'), name:"Nataliya Vdovina", bio:"Nataliya Vdovina was born on January 12, 1969 in Belogorsk, Crimean Oblast, Ukrainian SSR, USSR.  She is an actress, known for The Return (2003), Z odzysku (2006) and The Man Who Saved the World (2014)...", url:"https://themoviedb.org/person/68518"}}, {tmdbId:"23891", properties:{bornIn:"Glen Ellyn, Illinois, USA", imdbId:"0445987", born:date('1986-08-31'), name:"Ryan Kelley", bio:"Ryan Jonathan Kelley (born August 31, 1986) is an American actor known for his Independent Spirit Award winning performance in Mean Creek and his work on the hit television series Smallville.  He also starred as Ben Tennyson in Ben 10: Alien Swarm.  He had a major supporting role in Stolen Summer, which was the film made during the Project Greenlight documentary series.  He has appeared in over 50 commercials since he was 2 years old.  Ryan has 14 brothers and sisters; nine are adopted...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dn7R7p0YIY3VjCIRwIzRrEuwPwq.jpg", url:"https://themoviedb.org/person/23891"}}, {tmdbId:"4940", properties:{bornIn:"Chicago - Illinois - USA", imdbId:"0605080", born:date('1986-11-26'), name:"Trevor Morgan", bio:"From Wikipedia, the free encyclopedia. \n\nTrevor John Morgan (born November 26, 1986) is an American actor.  He has appeared in the films Genius, The Sixth Sense, The Patriot, A Rumor of Angels, Jurassic Park III, The Glass House, Chasing 3000, Mean Creek, Barney's Great Adventure, Local Color, Family Plan and Uncle Nino...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/txZ59fUmdyyv5cowmFDu85HiBeF.jpg", url:"https://themoviedb.org/person/4940"}}, {tmdbId:"56323", properties:{bornIn:"Upper Darby, Pennsylvania, USA", imdbId:"0275486", born:date('1970-05-18'), name:"Tina Fey", bio:"Elizabeth Stamatina \"Tina\" Fey (born May 18, 1970) is an American actress, comedian, writer and producer, known for her work on the NBC sketch comedy series Saturday Night Live (SNL, 1997–2006), the critically acclaimed NBC comedy series 30 Rock (2006–2013), and such films as Mean Girls (2004), Baby Mama (2008), Date Night (2010), and Admission (2013). \n\nFey first broke into comedy as a featured player in the Chicago-based improvisational comedy group The Second City...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AaCVR6bdt0sl3qIc6miynsYwceJ.jpg", url:"https://themoviedb.org/person/56323"}}, {tmdbId:"59145", properties:{imdbId:"1180243", name:"Danny McCarthy", url:"https://themoviedb.org/person/59145"}}, {tmdbId:"1284159", properties:{bornIn:"Launceston, Tasmania, Australia", imdbId:"0048932", born:date('1969-07-30'), name:"Simon Baker", bio:"Simon Baker (born 30 July 1969, height 5' 9¾\" (1,77 m)) is an Australian actor and director.  In his television acting career, he is best known for his lead role in the CBS television series The Mentalist as Patrick Jane and as Nicholas Fallin in The Guardian. \n\nIn his film acting career, he is best known for the lead role of Riley Denbo in Land of the Dead and Christian Thompson in the film adaptation of The Devil Wears Prada, based on the 2003 novel of the same name...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oay0Lo2zl0lJdguptxgx1BK9Xq7.jpg", url:"https://themoviedb.org/person/1284159"}}, {tmdbId:"38561", properties:{bornIn:"Rochester, Kent, UK", imdbId:"0111639", born:date('1979-11-23'), name:"Kelly Brook", bio:"Kelly Brook (born Kelly Ann Parsons; 23 November 1979(1979-11-23)) is an English model, actress, entrepreneur, television presenter and Playboy model. \n\nDescription above from the Wikipedia article  Kelly Brook, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vCCQUa7XkVgkcoN3s78aag0Rpi2.jpg", url:"https://themoviedb.org/person/38561"}}, {tmdbId:"58970", properties:{bornIn:"Buenos Aires, Argentina", imdbId:"1591620", born:date('1979-07-25'), name:"Juan Pablo Di Pace", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eivzmoiT15tJ1JjZIuP3Q5SAiRs.jpg", url:"https://themoviedb.org/person/58970"}}, {tmdbId:"58971", properties:{imdbId:"0172714", name:"Todd Collins", url:"https://themoviedb.org/person/58971"}}, {tmdbId:"3065", properties:{imdbId:"1380882", name:"Jack McElhone", url:"https://themoviedb.org/person/3065"}}, {tmdbId:"56473", properties:{imdbId:"0726635", name:"Mary Riggans", url:"https://themoviedb.org/person/56473"}}, {tmdbId:"52050", properties:{bornIn:"Walnut Creek, California, USA", imdbId:"1445490", born:date('1986-02-06'), name:"Alice Greczyn", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jTF9XXkGDRBel8IIBCYqQ5RTdnW.jpg", url:"https://themoviedb.org/person/52050"}}, {tmdbId:"52051", properties:{bornIn:"New York City", imdbId:"0501399", born:date('1968-11-13'), name:"Steve Lemme", bio:"From Wikipedia, the free encyclopedia\n\nSteven \"Steve\" Lemme (born November 13, 1968) is an American actor, writer, and producer, and one of the members of the Broken Lizard comedy group.  He attended The Dalton School, a high school in New York, but after one year transferred to Fountain Valley School in Colorado, graduating in 1987.  He attended Colgate University and was a member of the Beta Theta Pi fraternity...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iQnIsjeUA34B2w4EuM8mR1TglJZ.jpg", url:"https://themoviedb.org/person/52051"}}, {tmdbId:"5081", properties:{bornIn:"Wandsworth, London, England, UK", imdbId:"1289434", born:date('1983-02-23'), name:"Emily Blunt", bio:"Emily Olivia Leah Blunt (born 23 February 1983) is a British-American film and stage actress.  Her first major film role was in the British production My Summer of Love (2004).  After which she appeared in numerous American and British movies...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nPJXaRMvu1vh3COG16GzmdsBySQ.jpg", url:"https://themoviedb.org/person/5081"}}, {tmdbId:"55398", properties:{bornIn:"Annan, Dumfries and Galloway, Scotland, UK", imdbId:"0421332", born:date('1969-08-11'), name:"Ashley Jensen", bio:"From Wikipedia, the free encyclopedia. \n\nAshley Jensen (born 10 August 1969) is a Scottish actress who is best known for her roles in the television series Extras and ABC's Ugly Betty.  From September 2009 to May 2010, she also co-starred in the CBS sitcom Accidentally on Purpose as Olivia. \n\nDescription above from the Wikipedia article Ashley Jensen, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ukGtNrFyiVV21ScQvyeORWCtk5Z.jpg", url:"https://themoviedb.org/person/55398"}}, {tmdbId:"71128", properties:{bornIn:"Metairie, Louisiana, USA", imdbId:"1008709", born:date('1977-07-13'), name:"Ashley Scott", bio:"Ashley McCall Scott (born July 13, 1977) is an American actress.  She is known for her work on television and in film, including her roles in the television series Birds of Prey, Dark Angel and Jericho.  Description above from the Wikipedia article Ashley Scott, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eKMcubmUjNHgAp5qBaEucPtOtZX.jpg", url:"https://themoviedb.org/person/71128"}}, {tmdbId:"4026", properties:{imdbId:"1549953", name:"Ambrosia Kelley", url:"https://themoviedb.org/person/4026"}}, {tmdbId:"58538", properties:{imdbId:"0672495", born:date('1963-06-23'), name:"Neil Pepe", url:"https://themoviedb.org/person/58538"}}, {tmdbId:"19511", properties:{bornIn:"Tucson, Arizona, USA", imdbId:"0683978", born:date('1945-03-03'), name:"Larry Pine", bio:"Larry Pine (born March 3, 1945) is an American film, television and theatre actor. \n\nHe began his professional acting career Off-Broadway, then appeared in Cyrano de Bergerac at the Vivian Beaumont Theatre in 1968 as Fop.  A founding member of the avant-garde theater company the Manhattan Project, Pine appeared with the group in Alice in Wonderland, directed by Andre Gregory, in 1970 (Manhattan Project 1973)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wJRarkKBRVxDzKIB5O22tLd3wAT.jpg", url:"https://themoviedb.org/person/19511"}}, {tmdbId:"112951", properties:{bornIn:"Columbus, Mississippi, USA", imdbId:"1468936", born:date('1990-06-12'), name:"Alyson Morgan", url:"https://themoviedb.org/person/112951"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"3214", properties:{bornIn:"New York City, New York, USA", imdbId:"0942833", born:date('1955-12-06'), name:"Steven Wright", bio:"From Wikipedia, the free encyclopedia.   \n\nSteven Alexander Wright (born December 6, 1955) is an American comedian, actor and writer.  He is known for his distinctly lethargic voice and slow, deadpan delivery of ironic, philosophical and sometimes nonsensical jokes and one-liners with contrived situations. \n\nDescription above from the Wikipedia article Steven Wright, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9Q9buDjfm6uq0VE86MZ01o96lyG.jpg", url:"https://themoviedb.org/person/3214"}}, {tmdbId:"13602", properties:{bornIn:"Brooklyn, New York City, New York, USA", imdbId:"0497578", born:date('1962-06-22'), name:"Joie Lee", bio:"From Wikipedia, the free encyclopedia\n\nJoie Susannah Lee (born June 22, 1962) is an American screenwriter, film producer, film director and actress.  She has appeared in many of the films directed by her brother, Spike Lee, including She's Gotta Have It (1986), School Daze (1988), Do the Right Thing (1989), and Mo' Better Blues (1990).  She also wrote and produced the film Crooklyn...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jv3l0csEmVVOMNSmhKrOT543vqm.jpg", url:"https://themoviedb.org/person/13602"}}, {tmdbId:"1403153", properties:{imdbId:"0586326", name:"Mikela Jay", url:"https://themoviedb.org/person/1403153"}}, {tmdbId:"1403157", properties:{imdbId:"3950227", name:"Rob Beckwermert", url:"https://themoviedb.org/person/1403157"}}, {tmdbId:"1403159", properties:{imdbId:"0329745", name:"Christopher Gora", url:"https://themoviedb.org/person/1403159"}}, {tmdbId:"1403160", properties:{imdbId:"1970214", name:"Nina Jones", url:"https://themoviedb.org/person/1403160"}}, {tmdbId:"68534", properties:{imdbId:"1035692", name:"Brendan Mackey", bio:"Brendan Mackey is an Irish film and television actor who studied at RADA in London, England...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4VsohTAiMb9k671QGOG0X1EF8lm.jpg", url:"https://themoviedb.org/person/68534"}}, {tmdbId:"68535", properties:{imdbId:"1056790", name:"Nicholas Aaron", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rMBLVlFDfOr6ZoU1iHF6QARv9VP.jpg", url:"https://themoviedb.org/person/68535"}}, {tmdbId:"68536", properties:{imdbId:"1501209", name:"Richard Hawking", url:"https://themoviedb.org/person/68536"}}, {tmdbId:"68538", properties:{imdbId:"1440698", name:"Joe Simpson", url:"https://themoviedb.org/person/68538"}}, {tmdbId:"5348", properties:{imdbId:"1738584", name:"Allie Mickelson", url:"https://themoviedb.org/person/5348"}}, {tmdbId:"5364", properties:{imdbId:"0827274", name:"Kelci Stephenson", url:"https://themoviedb.org/person/5364"}}, {tmdbId:"5349", properties:{bornIn:"Saskatoon, Saskatchewan, Canada", imdbId:"0033758", name:"Craig Archibald", url:"https://themoviedb.org/person/5349"}}, {tmdbId:"51797", properties:{bornIn:"Edmonton - Alberta - Canada", imdbId:"0277213", born:date('1971-03-27'), name:"Nathan Fillion", bio:"Nathan Fillion (born March 27, 1971, height 6' 1½\" (1,87 m)) is a Canadian actor, currently starring as Richard Castle on the ABC series Castle.  He is also known for his portrayal of the lead role of Captain Malcolm Reynolds in the television series Firefly and its film continuation Serenity, and to a lesser extent for his regular role as Johnny Donnelly on the sitcom Two Guys and a Girl...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aW6vCxkUZtwb6iH2Wf88Uq0XNVv.jpg", url:"https://themoviedb.org/person/51797"}}, {tmdbId:"9576", properties:{bornIn:"New York City - New York - USA", imdbId:"0868659", born:date('1969-04-25'), name:"Gina Torres", bio:"Gina Torres (born April 25, 1969) is an American television and movie actress.  She is known for her roles in science fiction and fantasy.  She has appeared in many television series, including Hercules: The Legendary Journeys (as Nebula), Xena: Warrior Princess (as Cleopatra), the short-lived Cleopatra 2525, as well as Alias (as Anna Espinosa), Firefly (as series regular Zoe Washburne), Angel (as Jasmine), The Matrix sequels in a supporting role, and The Shield...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kX3jrrV057ioehfQ7OnSQtoIvcM.jpg", url:"https://themoviedb.org/person/9576"}}, {tmdbId:"54882", properties:{bornIn:"Rio de Janeiro, Rio de Janeiro, Brazil", imdbId:"1072555", born:date('1979-06-02'), name:"Morena Baccarin", bio:"Morena Baccarin (born June 2, 1979) is a Brazilian-born American actress most widely known for roles in several American science fiction television shows: as Inara Serra in the series Firefly; as Adria in the series Stargate SG-1; and as Anna in the 2009 version of the series V. \n\nBaccarin was born in Rio de Janeiro, Brazil.  Her mother is Brazilian stage and TV actress Vera Setta, and her father is Italian journalist Fernando Baccarin...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/u8oQ5JvM1oBYt5i9432sPboLhx5.jpg", url:"https://themoviedb.org/person/54882"}}, {tmdbId:"17697", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"1024677", born:date('1979-10-20'), name:"John Krasinski", bio:"John Burke Krasinski (born October 20, 1979) is an American actor, film director and writer.  He is widely known for playing Jim Halpert on the NBC sitcom The Office from 2005 to 2013.  He has also appeared in several films including License to Wed (2007), Leatherheads (2008), Away We Go (2009), It's Complicated (2009), Something Borrowed (2011), Aloha (2015), 13 Hours: The Secret Soldiers of Benghazi (2016), Detroit (2017), and A Quiet Place (2018), which he also directed and co-wrote...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/t6Aq1dAnxtlOtdevIMqQg5ZMCpl.jpg", url:"https://themoviedb.org/person/17697"}}, {tmdbId:"114634", properties:{bornIn:"Binghampton, New York, USA", imdbId:"0212278", born:date('1958-08-28'), name:"David de Vries", bio:"David de Vries is an American actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5dhZVrTfNFpJZP5qvbiaaYrC7Z4.jpg", url:"https://themoviedb.org/person/114634"}}, {tmdbId:"1411187", properties:{imdbId:"0286742", name:"Rick Forrester", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3VZzdWnx6SUF2a6gbZ1AyGCO7ky.jpg", url:"https://themoviedb.org/person/1411187"}}, {tmdbId:"21044", properties:{bornIn:"Houston, Texas, USA", imdbId:"1211488", born:date('1977-05-16'), name:"Lynn Collins", bio:"Viola Lynn Collins (born May 16, 1977), better known as Lynn Collins, is an American actress.  She is best known for her role as Kayla Silverfox in the live-action film X-Men Origins: Wolverine...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1ailMJrDO8hskoFjhWcX1zZVc4f.jpg", url:"https://themoviedb.org/person/21044"}}] AS row
