UNWIND [{tmdbId:"87082", properties:{bornIn:"Pottsville, Pennsylvania, USA", imdbId:"0585344", born:date('1979-01-01'), name:"Jim Mickle", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wtvG5IcGtCTlY3UoxA1Rm1vVoAe.jpg", url:"https://themoviedb.org/person/87082"}}, {tmdbId:"20031", properties:{bornIn:"Syracuse, New York, USA ", imdbId:"1207904", born:date('1965-02-17'), name:"Samuel Bayer", url:"https://themoviedb.org/person/20031"}}, {tmdbId:"123132", properties:{imdbId:"2356614", name:"Jac Schaeffer", bio:"From Wikipedia, the free encyclopedia\n\nJac Schaeffer (born 1978) is a film director, producer and screenwriter who came to fame with her feature film debut TiMER. \n\nSchaeffer holds a B. A.  from Princeton University. \n\nDescription above from the Wikipedia article Jac Schaeffer, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/123132"}}, {tmdbId:"90591", properties:{bornIn:"Ramat Gan, Israel", imdbId:"2305431", born:date('1970-01-21'), name:"Oren Peli", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1GQMVWW2G7CpR3kSZMe348CZoQh.jpg", url:"https://themoviedb.org/person/90591"}}, {tmdbId:"568322", properties:{bornIn:" Philadelphia, Pennsylvania, U.S", imdbId:"0870469", born:date('1981-05-11'), name:"Dan Trachtenberg", bio:"Dan Trachtenberg is a filmmaker and podcaster.   He was formerly a host on The Totally Rad Show and Geekdrome, both of which were hosted on Revision3.  He has also directed several commercials and public service announcements...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ce3rCLjSPyvq89D9kd2pyIlLny1.jpg", url:"https://themoviedb.org/person/568322"}}, {tmdbId:"134856", properties:{imdbId:"2907093", name:"Matt Harlock", url:"https://themoviedb.org/person/134856"}}, {tmdbId:"145612", properties:{bornIn:"Israele", imdbId:"1679136", name:"Guy Moshe", url:"https://themoviedb.org/person/145612"}}, {tmdbId:"78108", properties:{imdbId:"0282708", name:"Isaac Florentine", bio:"From Wikipedia, the free encyclopedia. \n\nIsaac Florentine is an Israeli-born movie director and martial arts expert.  Florentine earned a degree in Film & Television from Tel Aviv University...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4PJrg3l105M2GMNazhu2DXZ1Wce.jpg", url:"https://themoviedb.org/person/78108"}}, {tmdbId:"224644", properties:{bornIn:"Texas, USA", imdbId:"1677210", name:"Alex Stapleton", url:"https://themoviedb.org/person/224644"}}, {tmdbId:"1422815", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0853753", born:date('1961-03-11'), name:"Denny Tedesco", url:"https://themoviedb.org/person/1422815"}}, {tmdbId:"71538", properties:{bornIn:"Mt. Lebanon, Pennsylvania, United States", imdbId:"1396048", born:date('1974-06-07'), name:"Dave Filoni", bio:"Dave Filoni is an American film director, writer, and animator.  He's most known for his work on Avatar: The Last Airbender and Star Wars: The Clone Wars. \n\nDescription above from the Wikipedia article Dave Filoni, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iMpXDe7D3eimy3Y8esJcF9czVbm.jpg", url:"https://themoviedb.org/person/71538"}}, {tmdbId:"85675", properties:{bornIn:"Nagpur, Maharashtra", imdbId:"0386246", born:date('1962-11-20'), name:"Rajkumar Hirani", bio:"From Wikipedia, the free encyclopedia. \n\nRajkumar Hirani (born 1962) is a National Award and Filmfare Award winning Indian Director, screenwriter and film editor of Hindi films, best known for the films Munna Bhai MBBS (2003), Lage Raho Munnabhai (2006) and 3 Idiots (2009), considered the highest-grossing hit Hindi film by distributor-share\n\nDescription above from the Wikipedia article Rajkumar Hirani, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/85675"}}, {tmdbId:"144221", properties:{imdbId:"1026778", name:"Brad Furman", bio:"Brad Furman is an American film director, producer, and writer.  In 2011 he directed the The Lincoln Lawyer which starred Matthew McConaughey. \n\nDescription above from the Wikipedia article Brad Furman, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/144221"}}, {tmdbId:"109857", properties:{bornIn:"West Berlin, West Germany", imdbId:"0294457", born:date('1972-10-20'), name:"Thor Freudenthal", bio:"From Wikipedia, the free encyclopedia\n\nThor Freudenthal (born c.  1972/1973) is a German director, screenwriter and generally works with films. \n\nFreudenthal was born and raised in Berlin, Germany.  He attended the Berlin Academy of Arts, and later moved to Southern California as an exchange student at CalArts.  He started out as an animation director on short films like Mind the Gap, Monkey Business and The Tenor...", url:"https://themoviedb.org/person/109857"}}, {tmdbId:"1140271", properties:{imdbId:"0093934", name:"Fredrik Bond", url:"https://themoviedb.org/person/1140271"}}, {tmdbId:"40476", properties:{bornIn:"Karlsruhe, Germany", imdbId:"0011752", born:date('1976-12-12'), name:"Maren Ade", bio:"Maren Ade began studying at the HFF Munich  in 1998 majoring in Production and Media Economics and then changed to the Film and Television Department in 2000 at the HFF Munich.  In 2001 she founded the film production company Komplizen Film with Janine Jackowski and together they produced Maren Ade’s film The Forest for the Trees (2003).  The film received several honours, including the Special Jury Award at the Sundance Film Festival in 2005...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4zeOpAVDxTto67ZELmiUCBsm976.jpg", url:"https://themoviedb.org/person/40476"}}, {tmdbId:"113225", properties:{bornIn:"Atlanta - Georgia - USA", imdbId:"0693561", born:date('1954-05-01'), name:"Alan Poul", bio:"From Wikipedia, the free encyclopedia\n\nAlan Mark Poul (born May 1, 1954) is an American film and television producer and director...", url:"https://themoviedb.org/person/113225"}}, {tmdbId:"34510", properties:{bornIn:"Boston, Massachusetts, U.S.", imdbId:"1184258", born:date('1960-11-03'), name:"William Monahan", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eqpsbq6zBEnT8b8ayDYUvubJbCQ.jpg", url:"https://themoviedb.org/person/34510"}}, {tmdbId:"32532", properties:{imdbId:"0506977", name:" Brad Lewis", bio:"From Wikipedia, the free encyclopedia. \n\nBradford \"Brad\" Lewis  (born c.  1958) is an American film producer and local politician.  He produced DreamWorks' Antz and, for Pixar, the Oscar winning Ratatouille.  He is a former mayor of the city of San Carlos, California...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vNLowLsybQndFzQH1FKNMgVXjqf.jpg", url:"https://themoviedb.org/person/32532"}}, {tmdbId:"76325", properties:{bornIn:"Stockholm, Stockholms län, Sweden", imdbId:"0019242", born:date('1959-05-23'), name:"Daniel Alfredson", bio:"From Wikipedia, the free encyclopedia. \n\nHans Daniel Björn Alfredson (born 23 May 1959 in Stockholm, Sweden) is a Swedish film director who is best known for directing film versions of two parts of the Millennium Trilogy: The Girl Who Played with Fire and The Girl Who Kicked the Hornets' Nest.  He is the older brother of Tomas Alfredson (director of Let the Right One In) and the son of Hasse Alfredson...", url:"https://themoviedb.org/person/76325"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"227936", properties:{bornIn:"Budapest, Hungary", imdbId:"1212903", born:date('1974-08-15'), name:"Benedek Fliegauf", url:"https://themoviedb.org/person/227936"}}, {tmdbId:"137262", properties:{name:" Steve Purcell", bio:"From Wikipedia, the free encyclopedia. \n\nSteve Ross Purcell is an American cartoonist, animator and game designer.  He is most widely known as the creator of Sam &amp; Max, an independent comic book series about a pair of anthropomorphic animal vigilantes and private investigators, for which Purcell received an Eisner Award in 2007.  The series has since grown to incorporate an animated television series and several video games...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8wdCJVDq7v4g5N9Qkv8D87B3Xne.jpg", url:"https://themoviedb.org/person/137262"}}, {tmdbId:"62369", properties:{imdbId:"1069989", born:date('1977-10-23'), name:"Olatunde Osunsanmi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8Hg3t3VLGXzovwO0TiTW4n61fR9.jpg", url:"https://themoviedb.org/person/62369"}}, {tmdbId:"87494", properties:{imdbId:"2099491", born:date('1979-06-12'), name:"Paul Solet", bio:"From Wikipedia, the free encyclopedia. \n\nPaul Solet (born June 13, 1979) is an American film director, film producer, writer and actor...", url:"https://themoviedb.org/person/87494"}}, {tmdbId:"63571", properties:{bornIn:"Hong Kong", imdbId:"0948159", born:date('1963-10-23'), name:"Wilson Yip", bio:"From Wikipedia, the free encyclopedia. \n\nWilson Yip (born Yip Wai-Shun) is a Hong Kong actor, filmmaker and screenwriter.  \n\nHis films include \"SPL: Sha Po Lang\" , \"Dragon Tiger Gate\" , \"Flash Point\" and \"Ip Man\" 1+2+3. \n\nDescription above from the Wikipedia article Wilson Yip, see full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tDAr3QsLT4vTqHotRM0kChtVKDk.jpg", url:"https://themoviedb.org/person/63571"}}, {tmdbId:"103150", properties:{imdbId:"0893473", name:"Malcolm Venville", url:"https://themoviedb.org/person/103150"}}, {tmdbId:"67589", properties:{bornIn:"London the United Kingdom", imdbId:"0288144", born:date('1960-04-10'), name:"Alastair Fothergill", bio:"From Wikipedia, the free encyclopedia.   Alastair Fothergill (born 10 April 1960 in London the United Kingdom) is a producer of nature documentaries for television and cinema.  He is the executive producer of the multi-award winning series The Blue Planet (2001) and Planet Earth (2006) and the co-director of the associated feature films Deep Blue and Earth. \n\nFothergill attended Harrow...", url:"https://themoviedb.org/person/67589"}}, {tmdbId:"88926", properties:{bornIn:"Glasgow, Scotland, UK", imdbId:"0406334", born:date('1963-11-28'), name:"Armando Iannucci", bio:"Armando Giovanni Iannucci is a Scottish-Italian comedian, satirist, writer, director, performer and radio producer.  Born in Glasgow, he studied at Oxford University and left graduate work on a PhD about John Milton to pursue a career in comedy. \n\nRising quickly through BBC Scotland and BBC Radio 4, his early work with Chris Morris on the radio series On the Hour was transferred to television as The Day Today...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uyDppm3bNkT7Q8Zsirz9Puu3ssX.jpg", url:"https://themoviedb.org/person/88926"}}, {tmdbId:"103041", properties:{bornIn:"New York", imdbId:"1557909", born:date('1971-11-12'), name:"Robert D. Siegel", bio:"Robert D.  Siegel is an American screenwriter for The Onion\n\nMovie and The Wrestler, as well as the writer and director of Big Fan. \n\nThe Wrestler won the Golden Lion at the 2008 Venice Film\n\nFestival and has earned several Best Picture nominations. \n\nBig Fan premiered at the Sundance Film Festival in 2009...", url:"https://themoviedb.org/person/103041"}}, {tmdbId:"56370", properties:{bornIn:"Styrsö, Gothenburg, Sweden", imdbId:"1128037", born:date('1974-04-13'), name:"Ruben Östlund", bio:"Ruben Östlund, directed films on skiing in the late 90s, some of them now world-famous.  After a documentary 2000 he made his award-winning feature debut, The Guitar Mongoloid, in 2004.  Involuntary (2008) was selected for Cannes 2008 and has since been in major festivals worldwide.  It was also Sweden's nominee for Best Foreign Language Oscar that year.  His short Incident by a Bank won the Golden Bear at the Berlin Film Festival 2010...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kD2GQaROZYBRic7A99imCN67IaD.jpg", url:"https://themoviedb.org/person/56370"}}, {tmdbId:"2150", properties:{bornIn:"Pasadena, California, USA", imdbId:"0340436", born:date('1965-03-31'), name:"Kevin Greutert", bio:"From Wikipedia, the free encyclopedia. \n\nKevin Greutert (born March 31, 1965) is an American film director, film editor and writer, best known for his work on the Saw film series.  He is married to actress Elizabeth Rowin. \n\nDescription above from the Wikipedia article Kevin Greutert, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/2150"}}, {tmdbId:"87438", properties:{bornIn:"Durham, North Carolina, USA", imdbId:"0343713", born:date('1975-09-19'), name:"Seth Grossman", url:"https://themoviedb.org/person/87438"}}, {tmdbId:"139847", properties:{bornIn:"Australia", imdbId:"0255334", born:date('1961-07-20'), name:"Alison Ellwood", bio:"Alison Ellwood is a director, producer, and editor whose work spans documentary and narrative film and television.  Among her credits are AMERICAN JIHAD, which she directed, the Academy Award®-nominated documentary ENRON: THE SMARTEST GUYS IN THE ROOM, for which she served as editor and producer, and the Emmy®-winning series AMERICAN HIGH, which she directed...", url:"https://themoviedb.org/person/139847"}}, {tmdbId:"562365", properties:{bornIn:"Buenos Aires, Argentina", imdbId:"1391924", born:date('1965-01-01'), name:"Gustavo Taretto", bio:"Gustavo Taretto was born in Buenos Aires in 1965.  In 1983 he started attending different photography workshops, black &amp; white and color.  At the same time, he studied music and started to attend to script and direction workshops.  In 1993 he started working as a creative in an advertising agency.   After 14 years, he reached the executive creative direction in Ogilvy Argentina.  He received several awards in festivals arround the world, among others the Gold Lion in 2002...", url:"https://themoviedb.org/person/562365"}}, {tmdbId:"120572", properties:{bornIn:"Manchester, New Hampshire, USA", imdbId:"2254920", born:date('1984-01-27'), name:"Dan Eckman", url:"https://themoviedb.org/person/120572"}}, {tmdbId:"124470", properties:{imdbId:"1835153", name:"Scott Culver", url:"https://themoviedb.org/person/124470"}}, {tmdbId:"54734", properties:{bornIn:"Vancouver, British Columbia, Canada", imdbId:"1698571", born:date('1982-05-11'), name:"Evan Goldberg", bio:"Evan Goldberg (born 1982) is a Canadian film screenwriter and producer.  Goldberg attended Point Grey Secondary School and McGill University before joining the staff of Da Ali G Show along with his childhood friend and comedy partner Seth Rogen.  Rogen and Goldberg collaborated the films Knocked Up, Superbad, Pineapple Express, Funny People, and The Green Hornet.  In a strategy to garner interest and funding, Goldberg created a pre-production trailer for Jay and Seth vs...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uKZFcTB7FS47WvRFcp5wv3f7hJM.jpg", url:"https://themoviedb.org/person/54734"}}, {tmdbId:"78146", properties:{imdbId:"0018133", born:date('1965-05-17'), name:"Patrick Alessandrin", url:"https://themoviedb.org/person/78146"}}, {tmdbId:"124830", properties:{imdbId:"2443600", name:"Lisa Barros D'Sa", url:"https://themoviedb.org/person/124830"}}, {tmdbId:"124831", properties:{imdbId:"2441296", name:" Glenn Leyburn", url:"https://themoviedb.org/person/124831"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"46802", properties:{bornIn:"Texas, USA", imdbId:"0711807", born:date('1968-11-10'), name:"George Ratliff", url:"https://themoviedb.org/person/46802"}}, {tmdbId:"78914", properties:{imdbId:"1729171", name:"Noam Murro", bio:"Though he eventually built a trademark reputation as a director of offbeat feature films, Noam Murro undertook a most circuitous route into Hollywood.  Born in Israel, Murro originally trained as an architect in his boyhood town of Jerusalem, NY, then entered the advertising industry, with a lengthy tenure in the creative department of Gotham's Goldsmith/Jeffrey Agency...", url:"https://themoviedb.org/person/78914"}}, {tmdbId:"11641", properties:{bornIn:"Birmingham, Michigan, USA", imdbId:"0818547", born:date('1957-12-24'), name:"Scott Spiegel", bio:"From Wikipedia, the free encyclopedia\n\nScott Spiegel (born December 24, 1957) is an American screenwriter, film director, producer and actor.  He is best known for co-writing the screenplay for the movie Evil Dead II with longtime friend, film director Sam Raimi, with whom he attended Wylie E.  Groves High School in Birmingham, Michigan.  Spiegel played the role of Scotty in Raimi's Within the Woods, which served as a precursor to The Evil Dead...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3dKveWiEUeQbAxC7o9AKkIUymPQ.jpg", url:"https://themoviedb.org/person/11641"}}, {tmdbId:"105239", properties:{bornIn:"United Kingdom", imdbId:"0371955", born:date('1971-06-10'), name:"Stuart Hazeldine", bio:"From Wikipedia, the free encyclopedia. \n\nStuart Hazeldine (born June 10, 1971 in Surrey, England) is a British screenwriter, film producer and director.  He lives in London. \n\nDescription above from the Wikipedia article Stuart Hazeldine, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/105239"}}, {tmdbId:"47506", properties:{bornIn:"Houston - Texas - USA", imdbId:"1206844", born:date('1975-02-26'), name:"Drew Goddard", bio:"Andrew Brion Hogan Goddard (born February 26, 1975), better known as Drew Goddard, is an American film and television screenwriter, director, and producer.  He made his feature film directorial debut with the 2012 dark comedy horror-thriller The Cabin in the Woods.  In 2015, he penned the film adaption of Andy Weir's book The Martian, for which he won the National Board of Review Award for Best Adapted Screenplay and received an Academy Award nomination for Best Adapted Screenplay...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rcxxyIGDgPkXVgAQb9LLXfR89pv.jpg", url:"https://themoviedb.org/person/47506"}}, {tmdbId:"1137903", properties:{bornIn:"London, England, UK", imdbId:"0853374", born:date('1967-03-04'), name:"Sam Taylor-Johnson", bio:"Sam Taylor-Johnson was born on March 4, 1967 in London, England as Samantha Louise Taylor-Wood.  She is a director and producer, known for Nowhere Boy (2009), Fifty Shades of Grey (2015) and Love You More (2008)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4iWEBM7B4nANVZcRaID9XHo4tPl.jpg", url:"https://themoviedb.org/person/1137903"}}, {tmdbId:"1013608", properties:{imdbId:"0356502", name:" Karen Harley", url:"https://themoviedb.org/person/1013608"}}, {tmdbId:"237137", properties:{imdbId:"1065588", name:" João Jardim", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mk2iWbu5efZcniMN5QCEeuwDAnm.jpg", url:"https://themoviedb.org/person/237137"}}, {tmdbId:"222470", properties:{bornIn:"Forest Hills, New York, USA", imdbId:"0833889", born:date('1980-06-24'), name:"Todd Strauss-Schulson", bio:"Todd Strauss-Schulson (born June 24, 1980) is an American film director, screenwriter, producer, editor, and cinematographer, best known for directing the 2011 comedy film A Very Harold & Kumar 3D Christmas, and the 2015 horror comedy film The Final Girl...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ebACQB0WKup42JE6epPJMdcLT0I.jpg", url:"https://themoviedb.org/person/222470"}}, {tmdbId:"74752", properties:{bornIn:"Copenhagen, Denmark", imdbId:"1064048", born:date('1972-08-25'), name:"Nikolaj Arcel", bio:"Nikolaj Arcel is a Danish screenwriter and film director. \n\nNikolaj graduated from The Danish Film School and has had breakthrough success in the United States as a writer with screenplays such as The Girl with the Dragon Tattoo and Island of Lost Souls.  The Island of Lost Souls was actually written and directed by Nikolaj.   He has also directed successful feature films such as Truth about Men and A Royal Affair...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/79JljyWnfjqE87UyTo7xgFQa5fy.jpg", url:"https://themoviedb.org/person/74752"}}, {tmdbId:"76927", properties:{bornIn:"Alta, Norway", imdbId:"2482088", born:date('1979-12-06'), name:"Tommy Wirkola", bio:"Tommy Wirkola (born 1979 in Alta, Norway) is a Norwegian filmmaker...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/90Tq9GYih9viOI825KgeV7PKIKG.jpg", url:"https://themoviedb.org/person/76927"}}, {tmdbId:"140391", properties:{imdbId:"0800800", name:"Ola Simonsson", url:"https://themoviedb.org/person/140391"}}, {tmdbId:"140390", properties:{imdbId:"0632312", name:" Johannes Stjärne Nilsson", url:"https://themoviedb.org/person/140390"}}, {tmdbId:"126910", properties:{bornIn:"Frankfurt, Germany", imdbId:"0097517", born:date('1967-12-07'), name:"Derrick Borte", bio:"Derrick Stacey Borte (born December 7, 1967) is an American filmmaker known for the dark comedy, The Joneses (2010), which he wrote, directed, and produced. \n\nDescription above from the Wikipedia article Derrick Borte, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/126910"}}, {tmdbId:"95687", properties:{bornIn:"\tCalifornia, U.S.", imdbId:"0448422", name:"Robert Kenner", bio:"From Wikipedia, the free encyclopedia. \n\nRobert Kenner is an American film and television screenwriter, television director, film director, film producer, and television producer. \n\nHis career began in 1971 as an assistant cinematographer, and produced his first motion picture, 3:15 - The Moment of Truth, in 1984 (although it was not released until 1986).  His second feature film did not come until 1991's Lonely Hearts...", url:"https://themoviedb.org/person/95687"}}, {tmdbId:"12099", properties:{imdbId:"0401203", name:"Raman Hui", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i7s94zyQ7Jq4U8b3xVOlVbIhtFr.jpg", url:"https://themoviedb.org/person/12099"}}, {tmdbId:"1032011", properties:{imdbId:"4139472", name:"Afonso Poyart", url:"https://themoviedb.org/person/1032011"}}, {tmdbId:"63820", properties:{bornIn:"Giessen, Hesse, Germany", imdbId:"0228542", born:date('1977-03-09'), name:"Christian Ditter", bio:"Christian Ditter (born 1977) is an award winning director, producer and screenwriter who has worked on films, television and commercials.  He is best known for his films The Crocodiles (2009), Love, Rosie (2014), How to Be Single (2016), and the Netflix series Girlboss (2017). \n\nDitter was born on March 9, 1977, in Giessen, Hesse.  He graduated from the Evangelisch Stiftisches Gymnasium Gütersloh in 1996 and went to the University of Lüneburg from 1997 to 1998, majoring in Applied Cultural Studies...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o8waU0Go2YEgq6YFcDQf5dph5zP.jpg", url:"https://themoviedb.org/person/63820"}}, {tmdbId:"114597", properties:{bornIn:"Gran Bretagna", imdbId:"1455688", born:date('1945-08-08'), name:"Julie Anne Robinson", bio:"From Wikipedia, the free encyclopedia. \n\nJulie Anne Robinson is a British theatre, television, and film director perhaps best known for her work on British television.  She earned BAFTA and Golden Globe nominations for directing the first half of the BBC miniseries Blackpool.  In 2009, Robinson completed work on her first feature film, the American Touchstone Pictures film The Last Song...", url:"https://themoviedb.org/person/114597"}}, {tmdbId:"1201684", properties:{imdbId:"2819891", name:"Daniel DelPurgatorio", url:"https://themoviedb.org/person/1201684"}}] AS row
