UNWIND [{tmdbId:"61952", properties:{bornIn:"Florida - USA", imdbId:"0086431", born:date('1968-01-01'), name:"Aaron Blaise", bio:"Disney studios animator specializing in animals...", url:"https://themoviedb.org/person/61952"}}, {tmdbId:"145446", properties:{imdbId:"0857130", name:"Kirk R. Thatcher", url:"https://themoviedb.org/person/145446"}}, {tmdbId:"108214", properties:{imdbId:"1085552", name:"C.B. Harding", bio:"From Wikipedia, the free encyclopedia. \n\nC.  B.  Harding (sometimes credited as CB Harding) is an American film director, screenwriter, producer and cinematographer. \n\nDescription above from the Wikipedia article C.  B.  Harding, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/108214"}}, {tmdbId:"1205076", properties:{imdbId:"0025955", name:"Adam Thomas Anderegg", url:"https://themoviedb.org/person/1205076"}}, {tmdbId:"6980", properties:{bornIn:"Jonquière, Quebec, Canada", imdbId:"0309996", born:date('1964-03-06'), name:"Émile Gaudreault", bio:"From Wikipedia, the free encyclopedia. \n\nÉmile Gaudreault (born 1964 in Jonquière, Quebec) is a Canadian film director and screenwriter, whose credits include the films Louis 19, le roi des ondes, Nuit de noces, Mambo Italiano, Surviving My Mother and De père en flic. \n\nHe is openly gay...", url:"https://themoviedb.org/person/6980"}}, {tmdbId:"876", properties:{bornIn:"USA", imdbId:"0378144", born:date('1959-02-13'), name:"Jonathan Hensleigh", bio:"From Wikipedia, the free encyclopedia\n\nJonathan Blair Hensleigh (born February 1959) is an American screenwriter and film director, working primarily in the action/adventure genre of films. \n\nDescription above from the Wikipedia article Jonathan Hensleigh, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/876"}}, {tmdbId:"57125", properties:{bornIn:"Concord, Massachusetts, USA", imdbId:"1009775", born:date('1976-08-12'), name:"Greg Marcks", bio:"​From Wikipedia, the free encyclopedia. \n\nGreg Marcks  (born Concord, Massachusetts, August 12, 1976) is a writer/director of motion pictures who lives in Silver Lake, Los Angeles, California...", url:"https://themoviedb.org/person/57125"}}, {tmdbId:"74259", properties:{bornIn:"Würzburg, Germania", imdbId:"0200380", born:date('1963-09-18'), name:"Brian Dannelly", bio:"From Wikipedia, the free encyclopedia\n\nBrian Dannelly is an American film director and screenwriter best known for his work on the 2004 film Saved!. \n\nDescription above from the Wikipedia article Brian Dannelly, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/74259"}}, {tmdbId:"89576", properties:{imdbId:"0998825", name:"Jeffrey Blitz", bio:"​From Wikipedia, the free encyclopedia.   \n\nJeffrey Blitz is an American film director, producer and screenwriter from Bergen County, New Jersey.  He was nominated for an Academy Award for his 2002 documentary, Spellbound and he won the Dramatic Directing Prize at the Sundance Film Festival for his 2007 film, Rocket Science. \n\nBlitz won the 2009 Primetime Emmy for Outstanding Directing for a Comedy Series, for The Office episode \"Stress Relief\"...", url:"https://themoviedb.org/person/89576"}}, {tmdbId:"160", properties:{bornIn:"New York City, New York, USA", imdbId:"0297202", born:date('1964-08-21'), name:"Eytan Fox", bio:"From Wikipedia, the free encyclopedia.   Eytan Fox   (born on August 21, 1964) is an Israeli film director. \n\nDescription above from the Wikipedia article Eytan Fox, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/160"}}, {tmdbId:"16785", properties:{bornIn:"United Kingdom", imdbId:"0916424", name:"Peter Webber", bio:"Peter Webber (born 1968) is a British director who is best known for his debut feature film Girl with a Pearl Earring and Hannibal Rising...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7X50ruC3Ti3lDvfj7ZrLrquvSZk.jpg", url:"https://themoviedb.org/person/16785"}}, {tmdbId:"16919", properties:{bornIn:"La Ciotat, Bouches-du-Rhône, France", imdbId:"0196860", born:date('1967-06-26'), name:"Olivier Dahan", bio:"From Wikipedia, the free encyclopedia\n\nOlivier Dahan (born June 26, 1967) is a French film director and screenwriter.  His third directed film, La Vie En Rose, was the first French cinema film ever to win two Academy Awards, including its first acting Oscar in the French language. \n\nDescription above from the Wikipedia article Olivier Dahan, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hhyIXwzW7zI70SobaH4zbTvCyAX.jpg", url:"https://themoviedb.org/person/16919"}}, {tmdbId:"17046", properties:{bornIn:"New York City, New York, USA", imdbId:"0935095", born:date('1961-03-31'), name:"Gary Winick", bio:"From Wikipedia, the free encyclopedia\n\nGary Winick (March 31, 1961 – February 27, 2011) was an American film director and producer who directed films such as Tadpole (2002) and 13 Going on 30 (2004)...", died:date('2011-02-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/65IlEyU6HWKTglfAk7cQRelYAbx.jpg", url:"https://themoviedb.org/person/17046"}}, {tmdbId:"59291", properties:{bornIn:"Paris, France", imdbId:"0014960", born:date('1978-08-07'), name:"Alexandre Aja", bio:"Alexandre Aja is a French film director who rose to international stardom for his 2003 horror film Haute Tension (known as High Tension in the US, and known as Switchblade Romance in the UK)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5uiPUg3mclsr6Ee3DXPsW1O1ric.jpg", url:"https://themoviedb.org/person/59291"}}, {tmdbId:"1216735", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0007708", born:date('1958-09-13'), name:"Paul Abascal", url:"https://themoviedb.org/person/1216735"}}, {tmdbId:"31073", properties:{bornIn:" Tokyo, Japan", imdbId:"0297934", born:date('1972-09-15'), name:"Kenta Fukasaku", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pDSPbVTCaypO2046mJTgaRWgk4H.jpg", url:"https://themoviedb.org/person/31073"}}, {tmdbId:"1011158", properties:{bornIn:"Lorraine, France", imdbId:"0802807", born:date('1965-03-02'), name:"Florent-Emilio Siri", bio:" From Wikipedia. \n\nFlorent Emilio Siri is a French is a video game and film director and screenwriter born in Lorraine. \n\nHe studied cinema at the Sorbonne University and ESRA in Paris...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hf4DqvDE09BODiCYawHxej3RZ6e.jpg", url:"https://themoviedb.org/person/1011158"}}, {tmdbId:"52576", properties:{bornIn:"Rio de Janeiro, Rio de Janeiro, Brazil", imdbId:"0655683", born:date('1967-08-01'), name:"José Padilha", bio:"José Padilha is an award-winning Brazilian director of the Brazilian films Bus 174,Tropa de Elite - which earned him a Golden Bear award at the 2008 Berlin International Film Festival - and Tropa de Elite 2. \n\nThe films form part of a trilogy, looking at the influence of media, police and, finally, polticians.   His film Secrets of the Tribe premiered at the 2010 Sundance Film Festival to critical acclaim...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1v2CvKDLEqxNjZk26Zby0dpasnC.jpg", url:"https://themoviedb.org/person/52576"}}, {tmdbId:"10040", properties:{bornIn:"Rio de Janeiro, Brazil", imdbId:"0479884", born:date('1969-08-13'), name:" Felipe Lacerda", url:"https://themoviedb.org/person/10040"}}, {tmdbId:"6884", properties:{bornIn:"Victorville - California - USA", imdbId:"0420941", born:date('1971-07-24'), name:"Patty Jenkins", bio:"Patricia Lea \"Patty\" Jenkins (born July 24, 1971) is an American director and screenwriter.  She is best known for directing Monster (2003) and the Wonder Woman film series by DC...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9zdvRFn2iapRqG6OzrE7E92ByHw.jpg", url:"https://themoviedb.org/person/6884"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"981142", properties:{imdbId:"1285607", name:"Mark Decena", url:"https://themoviedb.org/person/981142"}}, {tmdbId:"130141", properties:{imdbId:"0796903", name:" Bill Siegel", url:"https://themoviedb.org/person/130141"}}, {tmdbId:"15045", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0501185", born:date('1948-06-25'), name:"Michael Lembeck", bio:"From Wikipedia, the free encyclopedia.   Michael Lembeck (born June 25, 1948) is an actor, television and film director. \n\nLembeck was born in Brooklyn, New York, the son of Caroline and Harvey Lembeck, an actor and comedian.  He began acting in the late-1960s and directing in the 1970s.  His most notable acting role was as Julie Cooper's husband, Max Horvath, on the sitcom, One Day at a Time.  He also played \"Kaptain Kool\" of Kaptain Kool and the Kongs on The Krofft Supershow from 1976 to 1978...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/f1Bf2p9YvPIaTZMUhYxhCx5yxLP.jpg", url:"https://themoviedb.org/person/15045"}}, {tmdbId:"69991", properties:{bornIn:"Bangkok, Thailandia", imdbId:"0711579", born:date('1962-03-08'), name:"Pen-Ek Ratanaruang", bio:"(Thai: เป็นเอก รัตนเรือง)  A Thai film director and screenwriter best known for his arthouse work \"Last Life in the Universe\", and is considered to be one of Thai cinema's leading \"new wave\" auteurs, alongside Wisit Sasanatieng and Apichatpong Weerasethakul.  He goes by the nickname Tom and is sometimes credited as Tom Pannet...", url:"https://themoviedb.org/person/69991"}}, {tmdbId:"69737", properties:{imdbId:"0184947", born:date('1962-01-01'), name:"C. Jay Cox", bio:"​From Wikipedia, the free encyclopedia. \n\nC.  Jay Cox (born 1962 in Nevada) is an American director and screenwriter. \n\nDescription above from the Wikipedia article C...", url:"https://themoviedb.org/person/69737"}}, {tmdbId:"70651", properties:{bornIn:"Fort Sill, Oklahoma, United States", imdbId:"0384864", born:date('1961-08-21'), name:"Stephen Hillenburg", bio:"Stephen McDannell Hillenburg (August 21, 1961 – November 26, 2018) was an American animator, cartoonist, and marine-biology teacher.  He was the creator of the Nickelodeon animated television series SpongeBob SquarePants (1999–), which he also directed, produced, and wrote.  It has gone on to become the fifth longest-running American animated series...", died:date('2018-11-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vDTwuiqM6BR9xv3eNOCXbEZl1gg.jpg", url:"https://themoviedb.org/person/70651"}}, {tmdbId:"1285799", properties:{imdbId:"1294237", name:"Richard Ray Perez", url:"https://themoviedb.org/person/1285799"}}, {tmdbId:"1437435", properties:{imdbId:"1294771", name:" Joan Sekler", url:"https://themoviedb.org/person/1437435"}}, {tmdbId:"56214", properties:{bornIn:"Istanbul, Turkey", imdbId:"0149196", born:date('1959-01-26'), name:"Nuri Bilge Ceylan", bio:"​From Wikipedia\n\nNuri Bilge Ceylan (Turkish pronunciation: [ˈnuːri ˈbilɟe ˈdʒejlan], born 26 January 1959) is a Turkish film director, photographer, screenwriter and actor.  He was the winner of the Palme d'Or, the highest prize at the Cannes Film Festival, in 2014.  He is married to filmmaker, photographer, and actress Ebru Ceylan, with whom he co-starred in Climates (2006)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5jH5pWhdE0Xe0renmFjCBdJV9aQ.jpg", url:"https://themoviedb.org/person/56214"}}, {tmdbId:"41378", properties:{bornIn:"Flint, Michigan", imdbId:"0175775", born:date('1964-11-06'), name:"Kerry Conran", bio:"​From Wikipedia, the free encyclopedia.   \n\nKerry Scott Conran (born November 6, 1964 in Flint, Michigan) is an American filmmaker, educated at the California Institute of Arts.  He created and directed the 2004 pulp science fiction film Sky Captain and the World of Tomorrow. \n\nDescription above from the Wikipedia article  Kerry Scott Conran, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/41378"}}, {tmdbId:"70235", properties:{bornIn:"Milano, Italy", imdbId:"0320285", born:date('1950-10-01'), name:"Marco Tullio Giordana", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uJBDzGa9Cv6z8kNE6ryXdj4afxC.jpg", url:"https://themoviedb.org/person/70235"}}, {tmdbId:"126292", properties:{imdbId:"0448588", name:"J.M. Kenny", url:"https://themoviedb.org/person/126292"}}, {tmdbId:"78173", properties:{bornIn:"Fukuoka - Japan", imdbId:"1293863", born:date('1964-06-26'), name:"Hiroyuki Morita", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5tqP0LxEHIv5z7znlhnnZ4JD1CM.jpg", url:"https://themoviedb.org/person/78173"}}, {tmdbId:"52941", properties:{imdbId:"1301035", name:"Rob McKittrick", url:"https://themoviedb.org/person/52941"}}, {tmdbId:"72343", properties:{bornIn:"Århus, Denmark", imdbId:"0504654", born:date('1937-06-14'), name:"Jørgen Leth", bio:"Jørgen Leth is a Danish poet and film director who is considered a leading figure in experimental documentary film making.  Most notable are his epic documentary A Sunday in Hell and his surrealistic short film The Perfect Human.  He is also a sports commentator for Danish television and is represented by the film production company, Sunset Productions...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qNYYt61o85vf6Zhoa5OSTwZU9bw.jpg", url:"https://themoviedb.org/person/72343"}}, {tmdbId:"57405", properties:{imdbId:"0769840", name:"Jeff Schaffer", url:"https://themoviedb.org/person/57405"}}, {tmdbId:"57406", properties:{imdbId:"0073688", name:" Alec Berg", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8qCkqxlyxrSybMnUWf85XQ11qMB.jpg", url:"https://themoviedb.org/person/57406"}}, {tmdbId:"2689", properties:{bornIn:"Los Angeles, U.S.A", imdbId:"0622288", born:date('1965-10-12'), name:"Jeff Nathanson", bio:"From Wikipedia, the free encyclopedia.   Jeff Nathanson is an American film writer, film producer, and director. \n\nHe is best known for his work on the Rush Hour series, Catch Me If You Can, The Terminal, and The Last Shot, and has also co-written a story draft for the film Indiana Jones and the Kingdom of the Crystal Skull with George Lucas.  The screenplay for that film was written by David Koepp; it was released on May 22, 2008...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/t7147mBhYbYJqmkuWzm7UzVmAGU.jpg", url:"https://themoviedb.org/person/2689"}}, {tmdbId:"55710", properties:{bornIn:"Philadelphia, Pennsylvania, USA", imdbId:"0570912", born:date('1968-04-17'), name:"Adam McKay", bio:"Adam McKay (born April 17, 1968) is an American screenwriter, director, producer, comedian and actor.  He began his career as a writer for NBC sketch comedy series Saturday Night Live from 1995 to 2001.  He is well-known for his partnership with comedian and Will Ferrell, with whom he co-wrote the films Anchorman, Talladega Nights, Step Brothers, and Anchorman 2...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vOyZXNJq7Oo01LPtSD5AZHjctgH.jpg", url:"https://themoviedb.org/person/55710"}}, {tmdbId:"3893", properties:{bornIn:"Ann Arbor, Michigan, USA", imdbId:"0333060", born:date('1965-12-22'), name:"David S. Goyer", bio:"David Samuel Goyer (born December 22, 1965) is an American screenwriter, film director and comic book writer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gf44Hr3HJuWK7ZMHQKzDNBe0ylI.jpg", url:"https://themoviedb.org/person/3893"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"58573", properties:{bornIn:"Esbjerg, Danimarca", imdbId:"0975026", born:date('1972-01-01'), name:"Nicole Kassell", bio:"From Wikipedia, the free encyclopedia. \n\nNicole Kassell is an American film director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/s304Fh0bsACKkCTNKdOq9RgCZRQ.jpg", url:"https://themoviedb.org/person/58573"}}, {tmdbId:"42274", properties:{bornIn:"London, England, United Kingdom", imdbId:"0403541", born:date('1959-01-01'), name:"Nick Hurran", bio:"From Wikipedia, the free encyclopedia\n\nNick Hurran (born 1959) is a British film and television director. \n\nHurran is married to the television producer Michele Buck, with whom he has two children. \n\nDescription above from the Wikipedia article Nick Hurran, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/42274"}}, {tmdbId:"63447", properties:{imdbId:"0384862", name:"David Hillenbrand", bio:"From Wikipedia, the free encyclopedia. \n\nDavid Hillenbrand is an American writer, director, and composer.  He often collaborates with his brother Scott Hillenbrand on projects. \n\nDescription above from the Wikipedia article David Hillenbrand, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/63447"}}, {tmdbId:"63452", properties:{imdbId:"0384863", name:" Scott Hillenbrand", bio:"From Wikipedia, the free encyclopedia. \n\nScott Hillenbrand is an American director, actor and screenwriter.  He often collaborates with his brother David Hillenbrand on projects.  He is usually credited under the name \"Scott Brandon\" when he acts. \n\nDescription above from the Wikipedia article Scott Hillenbrand, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/63452"}}, {tmdbId:"66571", properties:{bornIn:"Knoxville, Tennessee, USA", imdbId:"0745861", born:date('1964-08-06'), name:"Mitch Rouse", bio:"Mitch Rouse (born August 6, 1964) is an American film and television actor, director, and screenwriter.  He is a well known vet in the world of improvisation.  Rouse grew up in Oak Ridge, Tennessee.  He dropped out of college and moved to Chicago to study improvisation under the late, great Del Close.  While there he was asked to join the Second City Theatre, birthplace of his idols John Belushi, Dan Aykroyd and Bill Murray...", url:"https://themoviedb.org/person/66571"}}, {tmdbId:"110338", properties:{imdbId:"1364168", name:" Donnacha O'Briain", url:"https://themoviedb.org/person/110338"}}, {tmdbId:"15217", properties:{bornIn:"Green Bay, Wisconsin, USA", imdbId:"0811583", born:date('1966-03-01'), name:"Zack Snyder", bio:"Zachary Edward 'Zack' Snyder (born March 1, 1966) is an American film director, producer, and screenwriter.  He made his feature film debut in 2004 with a remake of the 1978 horror film Dawn of the Dead...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iD0GDqkvJXDXiNEZej198hjt3Tt.jpg", url:"https://themoviedb.org/person/15217"}}, {tmdbId:"20310", properties:{bornIn:"Maebashi City, Gunma Prefecture, Japan", imdbId:"1234345", born:date('1972-07-27'), name:"Takashi Shimizu", bio:"From Wikipedia, the free encyclopedia. \n\nTakashi Shimizu ( born 27 July 1972 in Maebashi City, Gunma Prefecture, Japan) is a Japanese film director, best known for the Ju-on series of horror films. \n\nDescription above from the Wikipedia article Takashi Shimizu, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fXpW0Cx0dLEtWpJvsKHOIDaSFn7.jpg", url:"https://themoviedb.org/person/20310"}}, {tmdbId:"55379", properties:{bornIn:"France", imdbId:"1367933", born:date('1965-06-07'), name:"Yann Samuell", bio:"Yann Samuell (born June 7, 1965 in France), is a French film director, and screenwriter...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x5rNtn8OkegkvcC8Lfkzwd7wSAS.jpg", url:"https://themoviedb.org/person/55379"}}, {tmdbId:"57633", properties:{bornIn:"San Francisco, California, USA", imdbId:"1098493", born:date('1975-02-09'), name:"Rawson Marshall Thurber", bio:"Rawson Marshall Thurber is an American writer and director...", url:"https://themoviedb.org/person/57633"}}, {tmdbId:"116791", properties:{imdbId:"0161443", name:" Joan Churchill", bio:"Joan Churchill is an American cinematographer and filmmaker.  She is a graduate of UCLA Film School...", url:"https://themoviedb.org/person/116791"}}, {tmdbId:"44740", properties:{bornIn:"New York City, New York, USA", imdbId:"0791672", born:date('1965-01-01'), name:"Richard Shepard", bio:"​From Wikipedia, the free encyclopedia.   \n\nRichard Shepard (born 1965 New York City, New York) is an American film and television director and screenwriter.  In 2007 Shepard received a Directors Guild of America Award and an Emmy Award for Outstanding Directing for the television pilot Ugly Betty. \n\nDescription above from the Wikipedia article  Richard Shepard, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/44740"}}, {tmdbId:"11090", properties:{bornIn:"Poole, Dorset, England, UK", imdbId:"0942367", born:date('1974-04-18'), name:"Edgar Wright", bio:"Edgar Howard Wright (born 18 April 1974) is an English director, screenwriter and producer. \n\nHe began making independent short films before making his first feature film A Fistful of Fingers (1995).  Wright created and directed the comedy series Asylum in 1996, written with David Walliams.  After directing several other television shows, Wright directed the sitcom Spaced (1999–2001), which aired for two series and starred Simon Pegg and Nick Frost...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dQzv5Ml2SkelS33hgl7E2oh0a9S.jpg", url:"https://themoviedb.org/person/11090"}}, {tmdbId:"123558", properties:{imdbId:"0693648", name:"Jean-François Pouliot", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/r0vGRLr7YE6kdoe9JQOv3xuKuB0.jpg", url:"https://themoviedb.org/person/123558"}}, {tmdbId:"59767", properties:{imdbId:"0171253", name:" Warren Coleman", bio:"From Wikipedia, the free encyclopedia\n\nWarren Coleman (1901–1968) was an American operatic baritone.  He created the roles of Crown in Gershwin's Porgy and Bess and the role of John Kumalo in Weill's Lost in the Stars, in the premiere of both shows on Broadway. \n\nColeman was regularly seen on the Broadway stage from 1934 until 1950.  In addition to Lost in the Stars and two productions of Porgy and Bess, Coleman also starred in Roll, Sweet Chariot, Sing Out the News and Anna Lucasta...", url:"https://themoviedb.org/person/59767"}}, {tmdbId:"97579", properties:{bornIn:"Winnipeg, Manitoba, Canada", imdbId:"0534665", born:date('1956-02-28'), name:"Guy Maddin", bio:"From Wikipedia, the free encyclopedia\n\nGuy Maddin, CM OM (born February 28, 1956) is a Canadian screenwriter, director, author, cinematographer and film editor of both features and short films, as well as an installation artist, from Winnipeg, Manitoba.  His most distinctive quality is his penchant for recreating the look and style of silent or early sound era films which has solidified his popularity and acclaim in alternative film circles...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5oX4GZzjt2suSnwvkKSRRNAnbku.jpg", url:"https://themoviedb.org/person/97579"}}, {tmdbId:"73832", properties:{bornIn:"Dominican Republic", imdbId:"0855843", born:date('1975-07-03'), name:"Jessy Terrero", bio:"From Wikipedia, the free encyclopedia. \n\nJessy Terrero (born July 3, 1975) is a Dominican film and music video director. \n\nDescription above from the Wikipedia article Jessy Terrero, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/73832"}}, {tmdbId:"7727", properties:{imdbId:"0864138", name:"Phil Tippett", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qIjrlRrM6MwNkbCYwRbPYbvq9P7.jpg", url:"https://themoviedb.org/person/7727"}}, {tmdbId:"69498", properties:{imdbId:"1600805", name:"Mike Bigelow", url:"https://themoviedb.org/person/69498"}}, {tmdbId:"96199", properties:{bornIn:"USA", imdbId:"0305017", born:date('1970-04-11'), name:"Liz Garbus", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8iMNA3Wqx3wbDwojoYJknXAwLk8.jpg", url:"https://themoviedb.org/person/96199"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"57214", properties:{bornIn:"Nakhon Ratchasima Province, Thailand", imdbId:"1272773", born:date('1962-09-02'), name:"Prachya Pinkaew", bio:"Prachya Pinkaew (born September 2, 1962) is a Thai film director, film producer and screenwriter.  His films include Ong-Bak: Muay Thai Warrior and Tom-Yum-Goong, both martial arts films starring Tony Jaa. \n\nDescription above from the Wikipedia article Prachya Pinkaew, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/57214"}}, {tmdbId:"77273", properties:{bornIn:"Panjshir, Afghanistan", imdbId:"1383995", born:date('1962-09-07'), name:"Siddiq Barmak", bio:"​From Wikipedia, the free encyclopedia\n\nSiddiq Barmak (Born September 7, 1962) in Panjshir, Afghanistan, is a film director and producer.  He received an M. A degree in cinema direction from the Moscow Film Institute (VGIK) in 1987. \n\nHe has written a few screenplays and has made a few short films.  His first feature film Osama, won the Golden Globe for Best Foreign Language Film in 2004...", url:"https://themoviedb.org/person/77273"}}, {tmdbId:"54597", properties:{bornIn:"Saint Louis Park, Minnesota", imdbId:"0638271", born:date('1973-01-10'), name:"Joe Nussbaum", bio:"From Wikipedia, the free encyclopedia. \n\nJoe Nussbaum is an American film director.  A graduate of the University of Southern California, he got his break into the movie industry by passing around Hollywood offices his short film George Lucas in Love.  The success of the film eventually got him a deal with Dreamworks, and he has since directed films such as the 2004 production Sleepover, the 2006 film American Pie Presents: The Naked Mile and the 2007 film Sydney White starring Amanda Bynes...", url:"https://themoviedb.org/person/54597"}}, {tmdbId:"71600", properties:{bornIn:"Evanston, Illinois", imdbId:"1164861", born:date('1974-07-20'), name:"Seth Gordon", bio:"Seth Gordon has produced and edited the critically lauded films NEW YORK DOLL and CRY WOLF, which grossed $10m at the US box office, and was the cinematographer on the Oscar-nominated SHUT UP AND SING. \n\nMost recently, Seth directed the critically acclaimed THE KING OF KONG: A FISTFUL OF QUARTERS.  The film was noted on a host of critics; and publicationsʼ Best of the Year lists.  He is currently set to direct HORRIBLE BOSSES starring Jennifer Aniston, Jason Bateman and Kevin Spacey...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3V2gHFkbez8iGTdlYyS9NxMujfw.jpg", url:"https://themoviedb.org/person/71600"}}, {tmdbId:"930707", properties:{bornIn:"San Francisco, California, USA", imdbId:"1119880", born:date('1976-09-13'), name:"Colin Trevorrow", bio:"Colin T.  Trevorrow (US: /trəˈvɑːroʊ/; born September 13, 1976) is an American film director and screenwriter.  He directed the indie film Safety Not Guaranteed (2012) and the blockbuster film Jurassic World (2015), and also co-wrote the script to Jurassic World and its 2018 sequel. \n\nTrevorrow was born on September 13, 1976 in San Francisco, California.  He was raised in Oakland, California...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i0HBClPMPKn3aq8QeQqyThS67EK.jpg", url:"https://themoviedb.org/person/930707"}}, {tmdbId:"60860", properties:{imdbId:"0300015", name:"Shainee Gabel", url:"https://themoviedb.org/person/60860"}}, {tmdbId:"58268", properties:{imdbId:"0280745", born:date('1964-01-06'), name:"Stefan Fjeldmark", url:"https://themoviedb.org/person/58268"}}, {tmdbId:"52842", properties:{bornIn:"Epping, Essex, England, UK", imdbId:"1134029", born:date('1972-03-04'), name:"Garth Jennings", bio:"Garth Jennings is an English film director, screenwriter, producer, actor and writer.  Films he has directed include The Hitchhiker's Guide to the Galaxy, Son of Rambow, and Sing.  He co-founded the production company Hammer & Tongs.   Description above from the Wikipedia article Hammer & Tongs, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zl6ZWijGySSIYJRFalleAiGkxyQ.jpg", url:"https://themoviedb.org/person/52842"}}, {tmdbId:"231537", properties:{bornIn:"Newcastle, Regno Unito", imdbId:"0806736", name:"Bob Smeaton", url:"https://themoviedb.org/person/231537"}}, {tmdbId:"51600", properties:{imdbId:"0453270", name:"Clare Kilner", bio:"​From Wikipedia, the free encyclopedia\n\nClare Kilner is a British film director.  She is best known for directing the films How to Deal (2002) and The Wedding Date (2005). \n\nDescription above from the Wikipedia article Clare Kilner, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/51600"}}, {tmdbId:"43993", properties:{bornIn:"Paris, France", imdbId:"0056725", born:date('1963-06-17'), name:"Christophe Barratier", bio:"Christophe Barratier (born 17 June 1963 in Paris) is a French film producer, director and screenwriter, and lyricist. \n\nBarratier is the son of the actress Eva Simonet and M.  Barratier.  He is the nephew of the film director Jacques Perrin, who was an influence on his choice of career. \n\nBefore being a filmmaker, Barratier studied a university course in classical music and guitar lessons...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4DQK2jkHYvWtJhXkgo2SwSB4ZVo.jpg", url:"https://themoviedb.org/person/43993"}}, {tmdbId:"64331", properties:{bornIn:"Seoul, South Korea", imdbId:"0405374", born:date('1958-01-03'), name:"Hyung-rae Shim", bio:"Shim Hyung-rae (심형래) is a former comedian and actor, and current filmmaker...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8Z20ysMqGzRkvASNkHwQl8Qlhwj.jpg", url:"https://themoviedb.org/person/64331"}}, {tmdbId:"9622", properties:{imdbId:"0108094", name:"Eric Brevig", bio:"​From Wikipedia, the free encyclopedia\n\nEric Brevig (born 1957) is a film director and visual effects supervisor known for his work in several major theatrical films and television shows.  He was Visual Effects Supervisor and Second Unit Director on the 2001 Jerry Bruckheimer/Michael Bay action drama Pearl Harbor. \n\nSince his film school days at UCLA Brevig had been fascinated with the potential of 3D for live-action movie production, and he learned everything he could about it...", url:"https://themoviedb.org/person/9622"}}, {tmdbId:"230987", properties:{imdbId:"0434896", name:"Nathaniel Kahn", bio:"Nathaniel Kahn is an award-winning filmmaker.  His documentary My Architect was nominated for an Academy Award in 2003 as well as being nominated for two Independent Spirit Awards and an Emmy.  Kahn also won the 2004 Directors Guild of America award for outstanding direction of a documentary.  His short films include the Oscar and Emmy nominated Two Hands (2006)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bCmZu0MGfdCyIyD1OmJcgKVJ34E.jpg", url:"https://themoviedb.org/person/230987"}}, {tmdbId:"1108", properties:{bornIn:"Pittsburgh, Pennsylvania, USA", imdbId:"0000948", born:date('1961-12-16'), name:"Shane Black", bio:"Shane Black (born December 16, 1961) is an American actor, screenwriter and film director.  He contributed to some of the biggest blockbuster action films of the late 1980s and early 1990s, including work on Lethal Weapon and The Last Boy Scout...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fafBg8LjtQqsXyFg8ZgW7DHQXKt.jpg", url:"https://themoviedb.org/person/1108"}}, {tmdbId:"41671", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0030735", born:date('1973-11-30'), name:"Nimród Antal", bio:"Nimród E.  Antal is a Hungarian American film director, screenwriter and actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x0fSNFKlhcAbbuvFPHPuTSUvOBY.jpg", url:"https://themoviedb.org/person/41671"}}, {tmdbId:"640", properties:{bornIn:"New York, USA", imdbId:"0448900", born:date('1962-10-23'), name:"Chris Kentis", url:"https://themoviedb.org/person/640"}}, {tmdbId:"61357", properties:{bornIn:"England, UK", imdbId:"0768249", name:"Geoffrey Sax", bio:"​From Wikipedia, the free encyclopedia. \n\nGeoffrey Sax  (sometimes credited as Geoff Sax) is a British film and television director, who has worked on a variety of critically acclaimed and popular drama productions in both the UK and the United States...", url:"https://themoviedb.org/person/61357"}}, {tmdbId:"83957", properties:{imdbId:"1419060", name:"Sue Kramer", url:"https://themoviedb.org/person/83957"}}, {tmdbId:"957", properties:{bornIn:"London, England, UK", imdbId:"0891216", born:date('1971-03-07'), name:"Matthew Vaughn", bio:"Matthew Vaughn is an English film producer and director known for producing such films as Lock, Stock and Two Smoking Barrels (1998) and Snatch (2000) and directing the films Layer Cake (2004), Stardust (2007) and Kick-Ass (2010)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Dnbz3B7yy4u0abixuD5LakZgsy.jpg", url:"https://themoviedb.org/person/957"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"130405", properties:{imdbId:"0695844", name:"Gary Preisler", url:"https://themoviedb.org/person/130405"}}, {tmdbId:"72034", properties:{bornIn:"Tulare County, California, USA", imdbId:"1096524", born:date('1972-09-06'), name:"Jacob Aaron Estes", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1vph0gSVNBDeuqtcnRTBixLUtvE.jpg", url:"https://themoviedb.org/person/72034"}}, {tmdbId:"56474", properties:{imdbId:"0994254", name:"Shona Auerbach", url:"https://themoviedb.org/person/56474"}}, {tmdbId:"12891", properties:{bornIn:"New York City, New York, USA", imdbId:"0923736", born:date('1964-06-23'), name:"Joss Whedon", bio:"Joseph Hill \"Joss\" Whedon is an American screenwriter, executive producer, director, occasional composer and actor, and founder of Mutant Enemy Productions.  He is best known as the creator and showrunner of the television series Buffy the Vampire Slayer (1997–2003), Angel (1999–2004), Firefly (2002) and Dollhouse (2009–2010), as well as the short film Dr.  Horrible's Sing-Along Blog (2008).  He is also notable for his work in film, comic books, and online media...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mVvpZnKYKSCtkOQixQnOonV5kv3.jpg", url:"https://themoviedb.org/person/12891"}}, {tmdbId:"1008377", properties:{imdbId:"0043675", name:"Dunia Ayaso", url:"https://themoviedb.org/person/1008377"}}, {tmdbId:"1008378", properties:{imdbId:"0754931", name:" Félix Sabroso", url:"https://themoviedb.org/person/1008378"}}, {tmdbId:"93286", properties:{bornIn:"Temora, New South Wales, Australia", imdbId:"0795153", born:date('1968-08-10'), name:"Cate Shortland", bio:"Cate Shortland is an Australian writer and director of film and television. \n\nShe was born 10 August 1968 in Temora, New South Wales.  She graduated from the Australian Film Television and Radio School, where she received the Southern Star Award for most promising student. \n\nShe has created several award winning short films:\n\nStrap on Olympia (1995); Pentuphouse (1998); Flower Girl (2000); Joy (2000)\n\nCate spent three years directing episodes of the television series, The Secret Life Of Us...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4XvyAyqYH8QDMbo0OwZtRHtbLti.jpg", url:"https://themoviedb.org/person/93286"}}, {tmdbId:"64194", properties:{bornIn:"Warsaw, Mazowieckie, Poland", imdbId:"0667734", born:date('1957-09-15'), name:"Pawel Pawlikowski", bio:"From Wikipedia, the free encyclopedia. \n\nPaweł Pawlikowski (born 1957) is a Polish-born, Oxford-based, BAFTA Award-winning filmmaker and academic.  He garnered much acclaim for his BAFTA Award-winning Last Resort which he wrote and directed in 2000 and My Summer of Love, loosely based on Helen Cross' novel, which also won a BAFTA and a string of other awards at festivals around the world...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q21Igd2cSUjlKVjTLxZz0eWvp0p.jpg", url:"https://themoviedb.org/person/64194"}}, {tmdbId:"86255", properties:{bornIn:"Quito, Ecuador", imdbId:"0179542", born:date('1972-05-23'), name:"Sebastián Cordero", bio:"From Wikipedia, the free encyclopedia. \n\nSebastián Cordero (born May 23, 1972 in Quito, Ecuador) is a film director, writer and editor, often recognized for his work in Ratas, Ratones, Rateros, his debut film which portrays the life in a poverty-stricken Ecuador.  His films have been exhibited in festivals such as the Sundance Film Festival and Cannes Film Festival among others. \n\nHe first became interested in filmmaking when he saw Raiders of the Lost Ark at the age of 9...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lUbSYRsPNZoJkkjx2H9WATPetDn.jpg", url:"https://themoviedb.org/person/86255"}}, {tmdbId:"202", properties:{bornIn:"New York City, New York", imdbId:"0442109", born:date('1958-11-19'), name:"Charlie Kaufman", bio:"From Wikipedia, the free encyclopedia\n\nCharles Stuart \"Charlie\" Kaufman (born November 19, 1958) is an American screenwriter, producer, and director.  His works include Being John Malkovich, Human Nature, Adaptation, Eternal Sunshine of the Spotless Mind and Synecdoche, New York.  He won the Academy Award for Best Original Screenplay for Eternal Sunshine of the Spotless Mind...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wLBw80lgTmo91eg0DHbKU5WuPEY.jpg", url:"https://themoviedb.org/person/202"}}, {tmdbId:"60962", properties:{bornIn:"Cole Harbour, Nova Scotia, Canada", imdbId:"0154104", name:"Mike Clattenburg", bio:"From Wikipedia, the free encyclopedia. \n\nMike Clattenburg is a Canadian TV and film director best known as creator/director of the TV comedy series Trailer Park Boys (and the 2006 film, Trailer Park Boys: The Movie, based on the TV series), and This Hour Has 22 Minutes (January - November 2004). \n\nDescription above from the Wikipedia article Mike Clattenburg, licensed under CC-BY-SA, full list of contributors on Wikipedia ...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/f4OZIN70GtBUJpb4slvBQ19rVKp.jpg", url:"https://themoviedb.org/person/60962"}}, {tmdbId:"106782", properties:{bornIn:"Ankara, Turkey", imdbId:"0814716", born:date('1964-04-27'), name:"Ömer Faruk Sorak", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9nFBb0RRHrOBlJS0jV8cGnHd4ou.jpg", url:"https://themoviedb.org/person/106782"}}, {tmdbId:"52961", properties:{bornIn:"Hanover, Lower Saxony, Germany", imdbId:"0304541", born:date('1973-10-04'), name:"Dennis Gansel", bio:"Dennis Gansel (born 4 October 1973) is a German film director, writer and actor. \n\nGansel was born in 1973 in Hanover, Germany.  He grew up in East Berlin and started making films when he was 17.  Gansel worked in the festivals for film and television and with disabled people.  During this time, he prepared himself for film school.  He studied at Munich Film School HFF where he studied for 5 years...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tf34YKOXKKzE3ib21FSFiACCWi2.jpg", url:"https://themoviedb.org/person/52961"}}, {tmdbId:"56359", properties:{bornIn:"Mannheim, Germany", imdbId:"0591994", born:date('1974-08-23'), name:"Lexi Alexander", bio:"From Wikipedia, the free encyclopedia. \n\nLexi Alexander (born in Mannheim) is a German film director and martial artist. \n\nDescription above from the Wikipedia article Lexi Alexander, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/56359"}}, {tmdbId:"9660", properties:{imdbId:"0634602", born:date('1971-06-19'), name:"Tetsuya Nomura", url:"https://themoviedb.org/person/9660"}}, {tmdbId:"9661", properties:{imdbId:"1481959", name:" Takeshi Nozue", url:"https://themoviedb.org/person/9661"}}, {tmdbId:"60496", properties:{imdbId:"1595280", name:"James Gartner", url:"https://themoviedb.org/person/60496"}}, {tmdbId:"57193", properties:{bornIn:"London, England", imdbId:"1481493", born:date('1976-10-16'), name:"Gil Kenan", bio:"Gil Kenan (born October 16, 1976 in London, England) is a British-American film director.  Kenan received his MFA degree from the UCLA Film School in 2002. \n\nDescription above from the Wikipedia article Gil Kenan, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/57193"}}, {tmdbId:"57557", properties:{imdbId:"1466691", name:"Christian Volckman", bio:"From Wikipedia, the free encyclopedia\n\nChristian Volckman, a graduate of Ecole Supérieure d'Arts Graphiques in Paris, is a French painter, graphic designer, photographer, author and producer. \n\nHe is mostly known for his motion capture animation effort Renaissance, which was internationally released in 2006 and received mixed reviews from movie critics. [1] It was awarded the Feature Film Award at the Annecy International Animated Film Festival in 2006...", url:"https://themoviedb.org/person/57557"}}, {tmdbId:"1456608", properties:{imdbId:"1561203", name:" Shôgo Furuya", url:"https://themoviedb.org/person/1456608"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"53385", properties:{imdbId:"1502104", name:" Ross Kauffman", bio:"Ross Kauffman is an American director, producer, cinematographer and editor...", url:"https://themoviedb.org/person/53385"}}, {tmdbId:"19416", properties:{bornIn:"Miami, Florida, USA", imdbId:"0863756", born:date('1972-12-06'), name:"Ondi Timoner", bio:"From Wikipedia, the free encyclopedia. \n\nOndi Timoner (born December 6, 1972) is an American film director, producer and editor. \n\nDescription above from the Wikipedia article Ondi Timoner, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/19416"}}, {tmdbId:"44114", properties:{imdbId:"0971239", name:" Simon J. Smith", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/puCP7MQ8Gm9aKGcQiOcLiKIKcpJ.jpg", url:"https://themoviedb.org/person/44114"}}, {tmdbId:"91585", properties:{imdbId:"0932551", born:date('1959-08-31'), name:"Kevin Willmott", url:"https://themoviedb.org/person/91585"}}, {tmdbId:"5872", properties:{bornIn:"Los Angeles County, California ", imdbId:"0551358", born:date('1968-08-13'), name:"Joshua Marston", url:"https://themoviedb.org/person/5872"}}, {tmdbId:"93561", properties:{bornIn:"Helsinki, Finland", imdbId:"0617407", born:date('1969-11-20'), name:"Aleksi Mäkelä", url:"https://themoviedb.org/person/93561"}}, {tmdbId:"579303", properties:{imdbId:"1519306", name:"Tom Kuntz", url:"https://themoviedb.org/person/579303"}}, {tmdbId:"1172930", properties:{imdbId:"1512429", name:" Mike Maguire", url:"https://themoviedb.org/person/1172930"}}, {tmdbId:"2589", properties:{bornIn:"Belfast, Northern Ireland, UK", imdbId:"0313623", born:date('1952-12-20'), name:"Terry George", bio:"From Wikipedia, the free encyclopedia. \n\nTerry George (born December 20, 1952) is an Irish screenwriter and director.  Born and raised in Belfast, Northern Ireland much of his film work (e. g.  The Boxer, Some Mother's Son, and In the Name of the Father) involves the Troubles in Northern Ireland.  He has been nominated for two Oscars; Best Writing, Screenplay Based on Material from Another Medium in 1993 for In the Name of the Father and Best Writing, Original Screenplay for Hotel Rwanda in 2004...", url:"https://themoviedb.org/person/2589"}}, {tmdbId:"60129", properties:{bornIn:"Wilmington, Delaware, USA", imdbId:"0834893", born:date('1954-10-17'), name:"Susan Stroman", bio:"From Wikipedia, the free encyclopedia\n\nSusan Stroman (born 17 October 1954) is an American theatre director, choreographer, film director, and performer. \n\nDescription above from the Wikipedia article Susan Stroman, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/60129"}}, {tmdbId:"6340", properties:{bornIn:"New York City, New York, U.S.", imdbId:"0335666", born:date('1963-01-04'), name:"Susannah Grant", bio:"From Wikipedia, the free encyclopedia\n\nSusannah Grant (born January 4, 1963) is an American screenwriter and director. \n\nDescription above from the Wikipedia article Susannah Grant, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/6340"}}, {tmdbId:"16842", properties:{bornIn:"Atlanta, Georgia, USA", imdbId:"0027459", born:date('1970-06-05'), name:"Stephen J. Anderson", bio:"Stephen J.  Anderson is an American animator, film director, screenwriter and voice actor who made his feature-film directorial debut with Meet The Robinsons.  He joined Walt Disney Feature Animation in 1995 as a story artist on Tarzan.  Prior to joining Disney, Anderson worked as an animator at Hyperion Animation...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8U2ySIcq9LRzbAh6Tdq1yAySEBK.jpg", url:"https://themoviedb.org/person/16842"}}, {tmdbId:"125544", properties:{imdbId:"0299563", born:date('1951-10-03'), name:"Tim Fywell", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jdZBmm9noJh37Ri1aXZyOzaGpAI.jpg", url:"https://themoviedb.org/person/125544"}}, {tmdbId:"59521", properties:{bornIn:"Sant Iscle de Vallalta, Provinz Barcelona", imdbId:"1429471", born:date('1974-03-23'), name:"Jaume Collet-Serra", bio:"Jaume Collet-Serra (born March 23, 1974 in Sant Iscle de Vallalta, Spain) is a Spanish film director and producer. \n\nCollet-Serra is most famous for the 2005 remake House of Wax, and 2009's Orphan.  In 2010 he directed the Dark Castle drama-thriller Unknown which stars Frank Langella, Liam Neeson, January Jones and Diane Kruger. \n\nDescription above from the Wikipedia article Jaume Collet-Serra, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/s1MdlS2wnzfKevPfXK63V1qkwfI.jpg", url:"https://themoviedb.org/person/59521"}}, {tmdbId:"78176", properties:{imdbId:"0109273", name:"Dominic Brigstocke", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/15PVtHTavIAvAibjNdYc8g6kcwR.jpg", url:"https://themoviedb.org/person/78176"}}, {tmdbId:"76595", properties:{bornIn:"Misawa, Japan", imdbId:"0397174", born:date('1968-12-26'), name:"Byron Howard", bio:"From Wikipedia, the free encyclopedia. \n\nByron P.  Howard (born 1968) is an American motion picture director and story artist at Walt Disney Feature Animation, and is best known as the lead character animator on Lilo & Stitch and Brother Bear and the director on Bolt and Tangled. \n\nByron Howard is one of the most notable animators working for Walt Disney and has had the chance to work several famous figures within the industry such as John Lasseter...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ePJXkxrD44nM0VB7Xx9Q4ityzfT.jpg", url:"https://themoviedb.org/person/76595"}}, {tmdbId:"70238", properties:{bornIn:"Missouri, USA", imdbId:"0930261", born:date('1967-11-02'), name:" Chris Williams", bio:"Chris Williams is an American film director, screenwriter and animator at Walt Disney Animation Studios.  He is well known for have directing Glago's Guest and Bolt. \n\nWilliams previously worked in the story department for Mulan, The Emperor's New Groove, Brother Bear and Bolt in which he later directed replacing Chris Sanders as director. \n\nHe is set to direct the upcoming animated feature film, King of the Elves based on the story by Philip K.  Dick...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eE2NDdeKN1DC3XuV6L4xuEbVaS.jpg", url:"https://themoviedb.org/person/70238"}}, {tmdbId:"121830", properties:{bornIn:"Kenosha, Wisconsin, USA", imdbId:"1977355", name:"Nathan Greno", bio:"Director/writer  Nathan Greno is best known for co-directing the blockbuster animation feature, Tangled (2010).  \n\n \n\nAs a child Greno spent most of his time reading comic books and watching cartoons.   He doodled on any surface he could trying to mimic his animation idols.    In the late 1980s Greno joined the Walt Disney Company as a professional animator...", url:"https://themoviedb.org/person/121830"}}, {tmdbId:"58324", properties:{bornIn:"Paris, France", imdbId:"0724938", born:date('1966-07-02'), name:"Jean-François Richet", bio:"From Wikipedia, the free encyclopedia. \n\nJean-Francois Richet is a French screenwriter, director, and producer, born on July 2, 1966 in Paris.  He grew up in Meaux, a suburb east of Paris. \n\nDescription above from the Wikipedia article Jean-Francois Richet, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/PipS4XiDbV0hDfhydX9p8PkqZh.jpg", url:"https://themoviedb.org/person/58324"}}, {tmdbId:"36697", properties:{bornIn:"Budapest, Hungary", imdbId:"0190780", born:date('1952-09-29'), name:"Gabor Csupo", bio:"​From Wikipedia, the free encyclopedia\n\nGábor Csupó (born 29 September 1952) is a Hungarian-born animator and co-founder of the animation studio Klasky Csupo, which has produced shows like Rugrats, Duckman, and Aaahh!!! Real Monsters. \n\nHe was born in Budapest, Hungary, in 1952, and after four years at the Pannónia animation studios, emigrated to the West in 1975.  While working in Sweden he met Arlene Klasky, an American-born animator...", url:"https://themoviedb.org/person/36697"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"307546", properties:{imdbId:"1268721", name:"Jim Hanon", url:"https://themoviedb.org/person/307546"}}, {tmdbId:"55420", properties:{imdbId:"0036802", name:"William Arntz", url:"https://themoviedb.org/person/55420"}}, {tmdbId:"55421", properties:{imdbId:"0153912", name:" Betsy Chasse", url:"https://themoviedb.org/person/55421"}}, {tmdbId:"55429", properties:{imdbId:"0895917", name:" Mark Vicente", url:"https://themoviedb.org/person/55429"}}, {tmdbId:"7881", properties:{imdbId:"0191717", name:" Jill Culton", bio:"From Wikipedia, the free encyclopedia. \n\nJill Culton is an American animator, who is best known for her directorial debut on Sony's first animated movie, Open Season. \n\nPreviously, she studied at the Character Animation program at the California Institute of the Arts. \n\nShe was also a storyboard artist for various Pixar films such as Toy Story and Toy Story 2 and also co-wrote the original treatment for Monsters Inc...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mtEH7qmhT4jJMWBukJ7G7ql5M7b.jpg", url:"https://themoviedb.org/person/7881"}}, {tmdbId:"52691", properties:{imdbId:"0820934", name:" Anthony Stacchi", bio:"From Wikipedia, the free encyclopedia. \n\nAnthony F.  Stacchi is an American effects animator and film director. \n\nStacchi graduated from California Institute of the Arts with a BFA in Film then went on to be an Animator and Commercial Director at San Francisco's Colossal Pictures and an effects animator at Industrial Light and Magic on Back to the Future, Hook, The Rocketeer and Ghost, and James and the Giant Peach...", url:"https://themoviedb.org/person/52691"}}, {tmdbId:"69371", properties:{bornIn:"Montreal, Quebec, Canada", imdbId:"0885249", born:date('1963-03-09'), name:"Jean-Marc Vallée", bio:"Jean-Marc Vallée (born March 9, 1963) is a Canadian film director and screenwriter from Quebec.  He is best known for the film C. R. A. Z. Y.  (2005) which is one of the most successful films in Quebec history, both financially and critically.  At the 26th Genie Awards it was nominated for 13 awards of which it won 11...", url:"https://themoviedb.org/person/69371"}}, {tmdbId:"70100", properties:{bornIn:"Fukuoka, Japan", imdbId:"0032925", born:date('1960-10-02'), name:"Shinji Aramaki", bio:"From Wikipedia, the free encyclopedia. \n\nShinji Aramaki (born October 2, 1960) is a Japanese anime director and mechanical designer, born in Fukuoka Prefecture.  He was a member of Artmic. \n\nHe is noted for work on powered exoskeletons and his mecha and CG design on several anime series...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d6c73QNxB8qE9A7Ouk3sjvgORwh.jpg", url:"https://themoviedb.org/person/70100"}}, {tmdbId:"31161", properties:{bornIn:"Newark, New Jersey, USA ", imdbId:"0569479", born:date('1966-10-16'), name:" Mary Elizabeth McGlynn", bio:"​From Wikipedia, the free encyclopedia\n\nMary Elizabeth McGlynn (born October 16, 1966) is an American voice actress, ADR director, writer, and singer best known for her extensive English-language dubbing of various anime, and her singing in multiple games from the Silent Hill series, as well as the movie adaptation and Dance Dance Revolution EXTREME.  She has also had several movie roles.  She is married to noted voice actor Daran Norris...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ppflguXpUbtHM01ryaZAigaBHYe.jpg", url:"https://themoviedb.org/person/31161"}}, {tmdbId:"21126", properties:{imdbId:"0041474", name:" Frédéric Auburtin", url:"https://themoviedb.org/person/21126"}}, {tmdbId:"23382", properties:{imdbId:"1440846", name:" Emmanuel Benbihy", url:"https://themoviedb.org/person/23382"}}, {tmdbId:"6220", properties:{bornIn:"Nairobi, Kenya", imdbId:"0149446", born:date('1960-01-10'), name:" Gurinder Chadha", bio:"From Wikipedia, the free encyclopedia. \n\nGurinder Chadha (born 10 January 1960), OBE, is a British film director of Indian origin.  Most of her films explore the lives of Indians living in the United Kingdom.  She is best known for the hit films Bhaji on the Beach (1993), Bend It Like Beckham (2002), Bride and Prejudice (2004) and Angus, Thongs and Perfect Snogging (2008).  Her most recent project is the comedy film It's a Wonderful Afterlife released on 21 April 2010...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/giMqMKMIu9e9ieQoHRoqZqnWGwr.jpg", url:"https://themoviedb.org/person/6220"}}, {tmdbId:"21683", properties:{bornIn:"Cape Town, South Africa", imdbId:"0005628", born:date('1960-01-01'), name:" Oliver Schmitz", bio:"From Wikipedia, the free encyclopedia. \n\nOliver Schmitz (born 1960) is a South African film director and screenwriter. \n\nHis film Mapantsula was screened in the Un Certain Regard section at the 1988 Cannes Film Festival.  His 2010 film Life, Above All was selected as the South African entry for the Best Foreign Language Film at the 83rd Academy Awards.  It made the shortlist of nominations announced in January 2011...", url:"https://themoviedb.org/person/21683"}}, {tmdbId:"21681", properties:{bornIn:"Hiroshima, Japan", imdbId:"0840485", born:date('1960-05-28'), name:" Nobuhiro Suwa", bio:"From Wikipedia, the free encyclopedia. \n\nNobuhiro Suwa (born May 28, 1960 in Hiroshima, Hiroshima Prefecture) is a Japanese film director working in Japan and France.  His directorial works and screenplays often make use of improvisation techniques.  Currently, Suwa is the President of Tokyo Zokei University...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rTLKzj1dS20S5qbOGUAxYswFcwb.jpg", url:"https://themoviedb.org/person/21681"}}, {tmdbId:"2293", properties:{bornIn:"Olney, Maryland, USA", imdbId:"0588340", born:date('1957-01-27'), name:"Frank Miller", bio:"Frank Miller (born January 27, 1957) is an American comic book artist, writer and film director best known for his dark, film noir-style comic book stories and graphic novels Ronin, Daredevil: Born Again, Batman: The Dark Knight Returns, Sin City and 300.  He also directed the film version of The Spirit, shared directing duties with Robert Rodriguez on Sin City and produced the film 300...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2eqqLG9Sv4i1ZlM14wY2LTTEbld.jpg", url:"https://themoviedb.org/person/2293"}}, {tmdbId:"441778", properties:{imdbId:"1150657", born:date('1973-05-05'), name:" Filip Remunda", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ypMRhjfGgMZ0MCIkdba61bsyfui.jpg", url:"https://themoviedb.org/person/441778"}}, {tmdbId:"42712", properties:{bornIn:"Medford, Massachusetts, United States", imdbId:"0317638", born:date('1971-06-03'), name:"Tony Giglio", bio:"From Wikipedia, the free encyclopedia. \n\nTony Giglio is an American film director (born June 3, 1971) from Medford, Massachusetts.  He graduated from Seton Hall University in 1993 with a Bachelor of Arts degree. \n\nDescription above from the Wikipedia article Tony Giglio, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/42712"}}, {tmdbId:"23430", properties:{bornIn:"Guryev, Kazakh SSR, USSR [now Atyrau, Kazakhstan]", imdbId:"0067457", born:date('1961-06-25'), name:"Timur Bekmambetov", bio:"From Wikipedia, the free encyclopedia. \n\nTimur Nuruakhitovich Bekmambetov (born 25 June 1961) is a Kazakh-Russian director, producer and screenwriter who has worked on films and commercials.  He is mostly popular for the Russian film Night Watch (2004) and its sequel Day Watch (2006), and the American film Wanted (2008)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w4C8qeeWRvD7rbIj3elTvhdxjT.jpg", url:"https://themoviedb.org/person/23430"}}, {tmdbId:"110575", properties:{imdbId:"0575136", name:"Joseph Mealey", url:"https://themoviedb.org/person/110575"}}, {tmdbId:"110576", properties:{imdbId:"0794848", name:" Michael Shoob", url:"https://themoviedb.org/person/110576"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"55499", properties:{bornIn:"Denver, Colorado, USA", imdbId:"0220600", born:date('1966-07-16'), name:"Scott Derrickson", bio:"Scott Derrickson is an American screenwriter, producer, and director.  He lives in Los Angeles, California. \n\nDescription above from the Wikipedia article Scott Derrickson, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/55499"}}, {tmdbId:"8193", properties:{bornIn:"Cologne, Germany", imdbId:"0003697", born:date('1973-05-02'), name:"Florian Henckel von Donnersmarck", bio:"From Wikipedia, the free encyclopedia.   \n\nFlorian Maria Georg Christian, Graf Henckel von Donnersmarck (born May 2, 1973) is a German film director, best known for writing and directing the 2007 Oscar-winning film The Lives of Others and the 2010 film The Tourist...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eZw6oQ9xvSgoN2NHvnEopc6S8Mw.jpg", url:"https://themoviedb.org/person/8193"}}, {tmdbId:"233451", properties:{imdbId:"0562676", name:"Michael Mayhew", url:"https://themoviedb.org/person/233451"}}, {tmdbId:"223806", properties:{imdbId:"0144018", born:date('1965-09-21'), name:"Xan Cassavetes", url:"https://themoviedb.org/person/223806"}}, {tmdbId:"76009", properties:{imdbId:"1242062", name:"Arie Posin", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kG00Bm098iTtK6RJRowss7QMRZ7.jpg", url:"https://themoviedb.org/person/76009"}}, {tmdbId:"7426", properties:{bornIn:"Phoenix, Arizona, U.S.", imdbId:"1053371", born:date('1953-06-28'), name:"Duncan Tucker", bio:"Duncan Tucker is an American film director and screenwriter.  He was born in Arizona and graduated from New York University.  After the short subject film The Mountain King, which was screened at over 31 international festivals, he wrote and directed his first feature film, Transamerica.  Tucker's hobbies include writing and painting.  His tale Many Fish is published by Ascent, and his photos and pictures are exhibited at many New York art galleries...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xBvBBI1stPasRPn9z4l4eJxtjjc.jpg", url:"https://themoviedb.org/person/7426"}}, {tmdbId:"57270", properties:{bornIn:"Stuttgart, Germany", imdbId:"0777881", born:date('1968-02-15'), name:"Robert Schwentke", bio:"​From Wikipedia, the free encyclopedia\n\nRobert Schwentke (born 1968) is a German film director best known for the films Tattoo and Flightplan. \n\nHe was a graduate of Columbia College Hollywood in 1992. \n\nSchwentke directed 2009's The Time Traveler's Wife, based on the best-selling novel, and starring Eric Bana and Rachel McAdams...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/awPMXTPvBQFlUWVt8I7WOv8ajYg.jpg", url:"https://themoviedb.org/person/57270"}}, {tmdbId:"62157", properties:{bornIn:" Columbia, South Carolina, USA", imdbId:"0831457", born:date('1971-03-07'), name:"Josh Stolberg", bio:"​From Wikipedia, the free encyclopedia.   \n\nJosh Stolberg (born March 7, 1971) is an American film director, screenwriter, and photographer.  He won the Seashore Award and the Queen Spirit Award as a director of the film The Life Coach.  He also wrote and directed the 2005 film Kids in America, as well as made a cameo appearance as a security guard in the film.  Stolberg is the screenwriter of the film Good Luck Chuck, starring Dane Cook, Jessica Alba and Dan Fogler...", url:"https://themoviedb.org/person/62157"}}, {tmdbId:"53267", properties:{bornIn:"Virginia, U.S.", imdbId:"0108132", born:date('1971-12-06'), name:"Craig Brewer", bio:"Craig Brewer is an American film director and screenwriter.  His 2005 movie Hustle & Flow won the Audience Award at the 2005 Sundance Film Festival and achieved commercial success, along with an Academy award for Best Original Song, \"It's Hard Out Here for a Pimp\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Cbsn9TlW7vKOxHUodKVNPtLrlq.jpg", url:"https://themoviedb.org/person/53267"}}, {tmdbId:"66218", properties:{imdbId:"0280814", name:"Jennifer Flackett", bio:"From Wikipedia, the free encyclopedia\n\nJennifer Flackett is an American film director and screen/television writer. \n\nIn television, she has written for series Beverly Hills, 90210, L. A.  Law and Earth 2. \n\nAs a screenwriter, she worked on the films Madeline (1998), Wimbledon (2004), Little Manhattan (2005), Nim's Island (2008) and Journey to the Center of the Earth (2008).  All of the aforementioned films she worked with husband, fellow director and screenwriter Mark Levin...", url:"https://themoviedb.org/person/66218"}}, {tmdbId:"32415", properties:{born:date('1976-01-01'), name:"Hendrik Hölzemann", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/beT4wBpFpxioP8Y5m3YAAgmom5l.jpg", url:"https://themoviedb.org/person/32415"}}, {tmdbId:"131186", properties:{bornIn:"Prefettura di Fukuoka, Giappone", imdbId:"0620363", born:date('1959-09-02'), name:"Tetsuya Nakashima", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wgssLzeRaqpNxMIrncKuTHNyWno.jpg", url:"https://themoviedb.org/person/131186"}}, {tmdbId:"59998", properties:{bornIn:" Australia", imdbId:"0572562", name:"Greg McLean", bio:"Greg McLean is an Australian film director, producer and writer.  He came to world attention in 2005 with his debut feature film, Wolf Creek, creating one of Australia's most memorable and horrific characters, Mick Taylor (played by John Jarratt).  The long-awaited sequel to his first feature, Wolf Creek 2 was released February 2013.  Mclean also wrote, directed and produced Rogue (2007) and was executive producer of Red Hill (2010) and Crawlspace (2012)...", url:"https://themoviedb.org/person/59998"}}, {tmdbId:"20307", properties:{bornIn:"Sandefjord, Norway", imdbId:"1461392", born:date('1972-05-30'), name:"Joachim Rønning", bio:"Joachim Rønning is a Norwegian film director who usually works in a team with Espen Sandberg - both natives of Sandefjord, Norway.  As a directing team, they go under the name of Roenberg (their last names put together).  They co-own one of Scandinavia's largest production companies for commercials called Motion Blur.  In 2006 their feature film debut, Bandidas, starring Penelope Cruz and Salma Hayek, was released worldwide through EuropaCorp and Twentieth Century Fox...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6Ngvvc3WIPgg7L0vvMUYs4uHYjR.jpg", url:"https://themoviedb.org/person/20307"}}, {tmdbId:"20308", properties:{bornIn:"Sandefjord, Norway", imdbId:"1650283", born:date('1971-06-17'), name:" Espen Sandberg", bio:"Espen Sandberg is a Norwegian film director and advertising producer, well known to work with his childhood friend Joachim Rønning on several projects such as Bandidas (2006), Max Manus (2008), Kon-Tiki (2012) and Pirates of the Caribbean: Dead Men Tell No Tales (2017)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/meoiaU4mxGVHFHLIedATpqROEnz.jpg", url:"https://themoviedb.org/person/20308"}}, {tmdbId:"29226", properties:{bornIn:"Norwich, Norfolk, England, UK", imdbId:"0418982", born:date('1960-05-15'), name:"Julian Jarrold", bio:"From Wikipedia, the free encyclopedia\n\nJulian Edward Peter Jarrold, born in Norwich, is a BAFTA Award-nominated English film and television director. \n\nHe is a member of the family which founded Jarrolds of Norwich in 1823 and was educated in Norfolk at Gresham's School, Holt.  He now lives in North London. \n\nDescription above from the Wikipedia article Julian Jarrold, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/29226"}}, {tmdbId:"1308941", properties:{imdbId:"0065404", name:"Edith Becker", url:"https://themoviedb.org/person/1308941"}}, {tmdbId:"70738", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0325204", born:date('1944-06-25'), name:"Gary David Goldberg", bio:"From Wikipedia, the free encyclopedia. \n\nGary David Goldberg (born June 25, 1944) is a United States writer and producer for television and film.  Goldberg is best known for his work on Family Ties (1982–89), Spin City (1996–2002), and his semi-autobiographical series Brooklyn Bridge (1991–93)...", url:"https://themoviedb.org/person/70738"}}, {tmdbId:"53176", properties:{bornIn:"Manhattan, New York, Stato di New York, Stati Uniti", imdbId:"0309691", born:date('1968-04-16'), name:"John Gatins", url:"https://themoviedb.org/person/53176"}}, {tmdbId:"5192", properties:{bornIn:"Rosenheim, Germany", imdbId:"0471086", born:date('1977-03-11'), name:"Marco Kreuzpaintner", bio:"From Wikipedia, the free encyclopedia. \n\nMarco Kreuzpaintner (born March 11, 1977) is a German film director and screenwriter...", url:"https://themoviedb.org/person/5192"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"58897", properties:{imdbId:"0271402", name:"Sam Fell", url:"https://themoviedb.org/person/58897"}}, {tmdbId:"64152", properties:{imdbId:"0828207", name:" Robert Stevenhagen", url:"https://themoviedb.org/person/64152"}}, {tmdbId:"56865", properties:{bornIn:"Guangdong, China", imdbId:"0150897", born:date('1959-04-15'), name:"Fruit Chan", bio:"From Wikipedia, the free encyclopedia. \n\nFruit Chan Gor (born April 15, 1959 in Guangdong, China, is an independent Hong Kong Second Wave screenwriter, filmmaker and producer, who is best known for his style of film reflecting the everyday life of Hong Kong people.  He is well known for using amateur actors (such as Sam Lee in Made in Hong Kong, Wong Yau-Nam in Hollywood Hong Kong) in his films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j1Xktbs6M6kNIwaLUps9swSEdVs.jpg", url:"https://themoviedb.org/person/56865"}}, {tmdbId:"229482", properties:{bornIn:"Miami, Florida, USA", imdbId:"1547859", born:date('1983-05-19'), name:"Kyle Patrick Alvarez", url:"https://themoviedb.org/person/229482"}}, {tmdbId:"19769", properties:{bornIn:"Champaign, Illinois, USA", imdbId:"0043742", born:date('1968-01-18'), name:"David Ayer", bio:"David Ayer (born January 18, 1968) is an American film director, producer and screenwriter.  He is best known for being the writer of Training Day (2001) and the director of Harsh Times (2005), Street Kings (2008), End of Watch (2012), Sabotage (2014), Fury (2014), Suicide Squad (2016) and Bright (2017). \n\nDescription above from the Wikipedia article  David Ayer, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2oBT2jQbsV8IWPMr3Cm87YBJxGu.jpg", url:"https://themoviedb.org/person/19769"}}, {tmdbId:"45052", properties:{bornIn:"Strijen, Zuid-Holland, Netherlands", imdbId:"0179221", born:date('1955-05-20'), name:"Anton Corbijn", bio:"From Wikipedia, the free encyclopedia. \n\nAnton Corbijn (born 20 May 1955) is a Dutch photographer, music video and film director.  He is the creative director behind the visual output of Depeche Mode and U2, having handled the principal promotion and sleeve photography for both for more than a decade.  Some of his works include music videos for Depeche Mode's \"Enjoy the Silence\" (1990) and Nirvana's \"Heart-Shaped Box\" (1993), as well as the Ian Curtis biopic Control...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tBr98AlA0vYHX1s2faMeatfab5O.jpg", url:"https://themoviedb.org/person/45052"}}, {tmdbId:"106518", properties:{imdbId:"0192741", name:"Martin Curland", url:"https://themoviedb.org/person/106518"}}, {tmdbId:"53333", properties:{bornIn:"Queensland, Australia", imdbId:"0384825", born:date('1961-08-14'), name:"John Hillcoat", bio:"From Wikipedia, the free encyclopedia. \n\nJohn Hillcoat (born 1961) is an Australian screenwriter and film director. \n\nHillcoat was born in Queensland, Australia, and was raised in Hamilton, Ontario, Canada.  As a child, his paintings were featured in the Art Gallery of Hamilton.  He has repeatedly worked with Nick Cave and also the band Depeche Mode.  His film The Road, based on the novel by Cormac McCarthy, premiered at the 2009 Toronto Film Festival, and was released in the U. S.  in November 2009...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/doH9hSWTBcPJhX7QzxhseKQWbqT.jpg", url:"https://themoviedb.org/person/53333"}}, {tmdbId:"17510", properties:{bornIn:"Londra, Regno Unito", imdbId:"0662530", born:date('1969-06-02'), name:"Ol Parker", bio:"From Wikipedia, the free encyclopedia. \n\nOl Parker (born 1969, London) is an English TV writer and director. \n\nIn 1997, he married actress Thandie Newton, who starred in his first film, It Was an Accident (2000). \n\nHis birth name was Oliver Parker, but he changed his first name to Ol, to avoid confusion with Oliver Parker who directed the 1999 film An Ideal Husband. \n\nDescription above from the Wikipedia article Ol Parker, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/17510"}}, {tmdbId:"938146", properties:{imdbId:"0823088", name:"Wladyslaw Starewicz", bio:"Vladislav Starevich (Russian: Владисла́в Алекса́ндрович Старе́вич, Polish: Władysław Starewicz; August 8, 1882 – February 26, 1965) was a Russian, Polish and French stop-motion animator notable as the author of the first puppet-animated film (i. e.  The Beautiful Lukanida (1912)).  He also used insects and other animals as protagonists of his films...", url:"https://themoviedb.org/person/938146"}}, {tmdbId:"96222", properties:{bornIn:"Mountainside, New Jersey", imdbId:"0172877", name:"Laurie Collyer", bio:"Laurie Collyer is an American film director.  She grew up in Mountainside, New Jersey and attended Oberlin College.  She is best known for writing and directing Sherrybaby, for which actress Maggie Gyllenhaal received a Golden Globe nomination.  She also directed the film Nuyorican Dream in 1999.  She is in development to direct a film based on the story of Julia Butterfly Hill and Luna which is to star Rachel Weisz. \n\nCollyer is a graduate of Oberlin College...", url:"https://themoviedb.org/person/96222"}}, {tmdbId:"12905", properties:{bornIn:"Columbus, Georgia, USA", imdbId:"0105169", name:"Ash Brannon", bio:"​From Wikipedia, the free encyclopedia.   \n\nAsh Brannon (born 1969 in Columbus, Georgia) is an American animator, writer and director.  He was a story artist and directing animator on Toy Story and co-director on Toy Story 2.  Besides working at Pixar he has also worked with Dreamworks Animation on Over the Hedge and Sony Pictures Animation on Surf's Up. \n\nStudying in CalArts Character Animation program, Brannon likewise practiced his skills in animation as a trainee for Disney's The Little Mermaid...", url:"https://themoviedb.org/person/12905"}}, {tmdbId:"15774", properties:{bornIn:"Wichita, Kansas", imdbId:"0118333", born:date('1960-10-25'), name:" Chris Buck", bio:"Chris Buck is a film director known for directing Tarzan and Surf's Up.  He also worked as supervising animator on Home on the Range and Chicken Little. \n\nBuck's other credits at Disney include the 1995 animated feature Pocahontas, where he oversaw the animation of three central characters: Percy, Grandmother Willow and Wiggins...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ponaYm3Xr1Pki8JVDSIzfA4NkNw.jpg", url:"https://themoviedb.org/person/15774"}}, {tmdbId:"107147", properties:{imdbId:"0258355", name:"Petra Epperlein", url:"https://themoviedb.org/person/107147"}}, {tmdbId:"70221", properties:{bornIn:"Cambrai, France", imdbId:"0137228", born:date('1963-01-04'), name:"Christian Carion", bio:"​From Wikipedia, the free encyclopedia\n\nChristian Carion (born January 4, 1963 in Cambrai, Nord) is a French film director, dialogue writer and screenwriter. \n\nDescription above from the Wikipedia article Christian Carion, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j98lo83uBn3JxlDiB6nPXEYTn8Z.jpg", url:"https://themoviedb.org/person/70221"}}, {tmdbId:"1134304", properties:{imdbId:"0410294", name:"Judy Irving", url:"https://themoviedb.org/person/1134304"}}, {tmdbId:"58603", properties:{imdbId:"0070482", name:"Joel Bender", url:"https://themoviedb.org/person/58603"}}, {tmdbId:"47364", properties:{bornIn:"Redbank, New Jersey, USA", imdbId:"0177637", born:date('1972-12-28'), name:"Greg Coolidge", url:"https://themoviedb.org/person/47364"}}, {tmdbId:"54472", properties:{bornIn:"Camberwell, London, England, UK", imdbId:"1732981", born:date('1970-03-26'), name:"Martin McDonagh", bio:"Martin McDonagh (born 26 March 1970) is an Irish playwright, filmmaker, and screenwriter.  Although he has lived in London his entire life, he is considered one of the most important living Irish playwrights. \n\nMcDonagh prefers writing films to plays, claiming to hold a \"respect for the whole history of films and a slight disrespect for theater. \" In a conversation with Irish drama critic Fintan O'Toole in BOMB Magazine, McDonagh said, \"It's not that I don't respect theater...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xYRS5sSB1HaLdyykRYMoxk1vqDo.jpg", url:"https://themoviedb.org/person/54472"}}, {tmdbId:"21737", properties:{bornIn:"Germany", imdbId:"0745131", born:date('1968-08-26'), name:"Marc Rothemund", bio:"Marc Rothemund is a German film and television director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gSlf3Rt5MuieXMYoJi9KKG1oztV.jpg", url:"https://themoviedb.org/person/21737"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"11266", properties:{bornIn:" Sydney, Australia", imdbId:"0574625", born:date('1967-12-29'), name:" James McTeigue", bio:"James McTeigue is an Australian film director.  He has been an assistant director on many films, including No Escape (1994), the Matrix trilogy (1999–2003) and Star Wars Episode II: Attack of the Clones (2002), and made his directorial debut in the 2006 film V for Vendetta. \n\nBorn on Sydney's North Shore, he grew up in Collaroy Plateau, a suburb on the Northern Beaches of Sydney, Australia...", url:"https://themoviedb.org/person/11266"}}, {tmdbId:"52443", properties:{bornIn:"Montreal, Canada", imdbId:"0718646", born:date('1977-10-19'), name:"Jason Reitman", bio:"Jason Reitman is a Canadian/American film director, screenwriter, producer, and actor, best known for directing the films Thank You for Smoking (2005), Juno (2007), and Up in the Air (2009).  As of February 2, 2010, he has received five Academy Award nominations, two of which are for Best Director.  Reitman is a dual citizen of Canada and the United States...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eNNN1dwfB6b6p2hoEG1xyoa7H2p.jpg", url:"https://themoviedb.org/person/52443"}}, {tmdbId:"11011", properties:{bornIn:"New York, United States", imdbId:"0672015", born:date('1968-03-23'), name:"Zak Penn", bio:"Zak Penn (born March 23, 1968) is an American screenwriter.  Penn wrote and directed Incident at Loch Ness and The Grand, and co-wrote the scripts for X2, X-Men: The Last Stand, and the story for The Avengers.  With Michael Karnow, Penn is the co-creator of the TV series Alphas on the Syfy network. \n\nPenn was born in New York.  He graduated from Wesleyan University in 1990.  His screenplay for PCU was based on his experiences at the Eclectic Society house...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5Zx3o1Fmlu4sIYq4xn5WLyK2GNM.jpg", url:"https://themoviedb.org/person/11011"}}, {tmdbId:"1117455", properties:{imdbId:"1743280", name:"Wendy Apple", url:"https://themoviedb.org/person/1117455"}}, {tmdbId:"18525", properties:{bornIn:"Bourg-en-Bresse, Ain, France", imdbId:"0415207", born:date('1967-12-05'), name:"Luc Jacquet", bio:"From Wikipedia, the free encyclopedia. \n\nLuc Jacquet (5 December 1967 in Bourg-en-Bresse) is a French film director from Paris.  He wrote and directed the movie March of the Penguins, which won an Oscar for best documentary feature in 2005.  His current film is called The Fox And the Child.  It has been released in Britain and Ireland in slightly re-edited dubbed English-language version with narration by Kate Winslet, and was released in the United States on 29 February 2008...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/PMUEEMNnzZx3ToiK2SZPWzsL1M.jpg", url:"https://themoviedb.org/person/18525"}}, {tmdbId:"1223175", properties:{imdbId:"0020491", name:"Elizabeth Allen Rosenbaum", url:"https://themoviedb.org/person/1223175"}}, {tmdbId:"672", properties:{bornIn:"Starnberg, Germany", imdbId:"0753912", born:date('1959-01-21'), name:"Oskar Roehler", bio:"Oskar Roehler is a German film director, screenwriter and journalist.  He grew up with his father in Berlin.  From the beginning of the 1980s on, Roehler worked as a writer and published \"Abschnappuniversum\", a collection of stories, in 1984.  He wrote screenplays for Christoph Schlingensief \"Terror 2000\" (1992) and for Niklaus Schilling \"Deutschfieber\" (1992).  In 1995, Roehler made his debut as a director with the low budget production \"Gentleman\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jqAQDH19vOQU5crqqTn3OY6mWa6.jpg", url:"https://themoviedb.org/person/672"}}, {tmdbId:"1371893", properties:{imdbId:"1358613", name:"Christopher Browne", url:"https://themoviedb.org/person/1371893"}}, {tmdbId:"53014", properties:{bornIn:"Oak Park, Illinois, USA", imdbId:"0070566", born:date('1966-11-10'), name:"Jessica Bendinger", bio:"​From Wikipedia, the free encyclopedia.   \n\nJessica Bendinger (born November 10, 1966) is an American screenwriter and novelist. \n\nShe has written several films, including 2000's Bring It On, 2004's First Daughter and 2006's Aquamarine.  She was also a writer and creative consultant for Sex and the City as well as a producer of the 2005 film The Wedding Date starring Debra Messing.  She also wrote and directed Stick It, released in April 2006 as her directorial debut...", url:"https://themoviedb.org/person/53014"}}, {tmdbId:"76230", properties:{bornIn:"Buffalo, New York, USA", imdbId:"0257606", born:date('1948-05-18'), name:"Diane English", bio:"From Wikipedia, the free encyclopedia\n\nDiane English (born May 18, 1948) is an American film director, screenwriter and producer, known for creating the sitcom Murphy Brown.  She also served as writer and executive producer of the sitcom My Sister Sam. \n\nDescription above from the Wikipedia article Diane English, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/76230"}}, {tmdbId:"78009", properties:{imdbId:"0103595", name:"Colin Brady", bio:"From Wikipedia, the free encyclopedia\n\nColin Brady is an American animator and film director.  He graduate of the California Institute of the Arts (CalArts), has worked as lead animator, animation director, supervising animator and co-director with animated film powerhouses Pixar and Industrial Light &amp; Magic.  His credits have included Toy Story, Toy Story 2, A Bug's Life, Men in Black 2, Lemony Snicket's A Series of Unfortunate Events, and many others...", url:"https://themoviedb.org/person/78009"}}, {tmdbId:"15780", properties:{imdbId:"0820800", name:" Daniel St. Pierre", bio:"From Wikipedia, the free encyclopedia\n\nDaniel St.  Pierre (aka Dan St.  Pierre) is an American film director, art director, production designer, actor, animation artist, and musician.  For his work in bring the Deep Canvas technique to the film Tarzan (1999), he received a 1999 Annie Award nomination for \"Outstanding Individual Achievement for Production Design in an Animated Feature Production\". \n\nDescription above from the Wikipedia article Daniel St...", url:"https://themoviedb.org/person/15780"}}, {tmdbId:"2675", properties:{bornIn:"Overland Park, Kansas, USA", imdbId:"1135423", born:date('1979-01-11'), name:"Darren Lynn Bousman", bio:"Darren Lynn Bousman is an American film director and screenwriter...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AoUgTCOrqWd8sNTjZGYihgTFiik.jpg", url:"https://themoviedb.org/person/2675"}}, {tmdbId:"53603", properties:{imdbId:"0110654", name:"Q. Allan Brocka", bio:"​From Wikipedia, the free encyclopedia. \n\nQuenton Allan Brocka  (born 1972) is an award-winning American television and film director based in West Hollywood, California.  He has directed and written a number of feature films while creating an animated television series for the Logo cable network.  He also writes a column for The Advocate. \n\nBrocka is of Filipino heritage and is openly gay\n\nDescription above from the Wikipedia article Q...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lPK4Tak3P1l91MZnZ5EeRPKjF6F.jpg", url:"https://themoviedb.org/person/53603"}}, {tmdbId:"56501", properties:{bornIn:"Germany", imdbId:"1294961", born:date('1976-04-29'), name:"Michael Spierig", bio:"From Wikipedia, the free encyclopedia. \n\nThe Spierig Brothers is the collective name for Australian twin brothers and film directors, producers and writers Michael and Peter Spierig...", url:"https://themoviedb.org/person/56501"}}, {tmdbId:"56502", properties:{bornIn:"Buchholz in der Nordheide, Germany", imdbId:"1294962", born:date('1976-04-29'), name:" Peter Spierig", bio:"From Wikipedia, the free encyclopedia. \n\nThe Spierig Brothers is the collective name for Australian twin brothers and film directors, producers and writers Michael and Peter Spierig...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1M1FX7YR9Dq0DhawzQ0vT0tx678.jpg", url:"https://themoviedb.org/person/56502"}}, {tmdbId:"8", properties:{bornIn:"Cleveland, Ohio, USA", imdbId:"0881279", born:date('1967-08-08'), name:"Lee Unkrich", bio:"Lee Unkrich is an American director and film editor.  He is a longtime member of the creative team at Pixar, where he started in 1994 as a film editor.  He later began directing, first as co-director of Toy Story 2.  After co-directing Monsters, Inc. , and Finding Nemo, Unkrich made his solo directorial debut with Toy Story 3, for which he won the Academy Award for Best Animated Feature in 2011...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oeUkLlak2lqKRYZmJZZv5gI87Ok.jpg", url:"https://themoviedb.org/person/8"}}, {tmdbId:"83339", properties:{imdbId:"0699037", born:date('1957-07-31'), name:"Paul Provenza", bio:"From Wikipedia, the free encyclopedia. \n\nPaul Provenza (born July 31, 1957) is an actor, comedian and filmmaker.  Provenza is currently based in Los Angeles...", url:"https://themoviedb.org/person/83339"}}, {tmdbId:"74295", properties:{bornIn:"USA", imdbId:"0275418", name:"Jeff Feuerzeig", bio:"From Wikipedia, the free encyclopedia\n\nJeff Feuerzeig (born 1964) is an American film director and screenwriter best known for The Devil and Daniel Johnston, his profile of cult musician and outsider artist Daniel Johnston, for which he was awarded the Directing prize for Documentary at the 2005 Sundance Film Festival and which was released theatrically in March 2006 by Sony Pictures Classics...", url:"https://themoviedb.org/person/74295"}}, {tmdbId:"84851", properties:{bornIn:"San Francisco, California, USA", imdbId:"0947087", born:date('1955-01-23'), name:"Hoyt Yeatman", bio:"​From Wikipedia, the free encyclopedia\n\nHoyt Yeatman (born January 23, 1955 in San Francisco, California, USA) is a visual effects artist and supervisor.  He has worked with Jerry Bruckheimer on a number of films, including Armageddon, Con Air, and The Rock.  He made his directorial debut with the film G-Force. \n\nYeatman is an alumnus of the UCLA School of Theater, Film and Television...", url:"https://themoviedb.org/person/84851"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"82839", properties:{imdbId:"0748066", name:"Henry Alex Rubin", bio:"From Wikipedia, the free encyclopedia. \n\nHenry-Alex Rubin studied film at Phillips Academy, Andover and Columbia University.  The son of a French mother and American father (art historian James H.  Rubin), he spent his life between Europe and the United States...", url:"https://themoviedb.org/person/82839"}}, {tmdbId:"82840", properties:{imdbId:"1785691", name:" Dana Adam Shapiro", bio:"From Wikipedia, the free encyclopedia. \n\nDana Adam Shapiro is an American film director, best known for his directorial work on the 2006 Academy Award nominated documentary Murderball. \n\nDescription above from the Wikipedia article Dana Adam Shapiro, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/82840"}}, {tmdbId:"23590", properties:{bornIn:"Fairfield, Connecticut, USA", imdbId:"0479999", born:date('1963-03-11'), name:"David LaChapelle", bio:"​From Wikipedia, the free encyclopedia. \n\nDavid LaChapelle  (born March 11, 1963 in Fairfield, Connecticut) is a photographer and director who works in the fields of fashion, advertising, and fine art photography, and is noted for his surreal, unique, sexualized, and often humorous style...", url:"https://themoviedb.org/person/23590"}}, {tmdbId:"229130", properties:{imdbId:"1224879", name:"Pradeep Sarkar", url:"https://themoviedb.org/person/229130"}}, {tmdbId:"56988", properties:{imdbId:"0109658", name:"Robert Brinkmann", url:"https://themoviedb.org/person/56988"}}, {tmdbId:"109640", properties:{imdbId:"0040328", name:"Doug Atchison", bio:"​From Wikipedia, the free encyclopedia. \n\nDoug Atchison is an American motion picture director and screenwriter.  He received the Academy of Motion Picture Arts and Sciences Nicholl Fellowship for Akeelah and the Bee in 2000. \n\nAfter winning the Nicholl Fellowship, former ICM superagent Lou Pitt guided Doug's screenplay into production in partnership with Lions Gate Entertainment, 2929 Entertainment, and Starbucks Productions...", url:"https://themoviedb.org/person/109640"}}, {tmdbId:"5714", properties:{bornIn:"Rio de Janeiro, Rio de Janeiro, Brazil", imdbId:"0757858", born:date('1965-01-24'), name:"Carlos Saldanha", bio:"From Wikipedia, the free encyclopedia. \n\nCarlos Saldanha (born July 20, 1968) is a Brazilian director of animated films.  He was the director of Ice Age: The Meltdown (2006) and Ice Age: Dawn of the Dinosaurs (2009), and the co-director of Ice Age (2002) and Robots (2005). \n\nSaldanha was born in Rio de Janeiro, Brazil.  He left his hometown in 1991 to follow his artistic instinct and passion for animation...", url:"https://themoviedb.org/person/5714"}}, {tmdbId:"229374", properties:{imdbId:"1802009", name:"Marilyn Agrelo", url:"https://themoviedb.org/person/229374"}}, {tmdbId:"109191", properties:{imdbId:"0408043", born:date('1971-10-04'), name:"Hiroyuki Imaishi", bio:"Hiroyuki Imaishi (今石 洋之, born October 4, 1971) is a Japanese key animator and anime/anime influenced animation director and one of the co-founders of Trigger.  His style is marked by fast and frantic animation combined with elaborate storyboarding and punchy direction.  Prior to founding Trigger, he was an animator and director at Gainax. \n\nHis series director debut was Tengen Toppa Gurren Lagann (2007)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2N7vGWiNy7yvCEhoc0kmElFdVET.jpg", url:"https://themoviedb.org/person/109191"}}, {tmdbId:"15218", properties:{bornIn:"St. Louis, Missouri, USA", imdbId:"0348181", born:date('1966-08-05'), name:"James Gunn", bio:"James Gunn is an American writer, filmmaker, actor, musician and cartoonist...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nHr6yzPF15jQz5eBke1SDNWectu.jpg", url:"https://themoviedb.org/person/15218"}}, {tmdbId:"57742", properties:{imdbId:"0828970", name:" John Stevenson", bio:"​From Wikipedia, the free encyclopedia.   \n\nJohn Stevenson is a British animation filmmaker and puppeteer known for directing the 2008 animated feature film, Kung Fu Panda with Mark Osborne.  Stevenson has over 30 years of experence with animation, a veteran of DreamWorks PDI who got his start in the entertainment industry via Jim Henson's The Muppet Show. \n\nHe worked on shows like The Dreamstone, Count Duckula, and FernGully 2: The Magical Rescue...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/em9Aqc2tv8s8fdCjBSyrSx5vQm3.jpg", url:"https://themoviedb.org/person/57742"}}, {tmdbId:"62768", properties:{bornIn:"Lexington, Kentucky, U.S.", imdbId:"0068587", born:date('1970-09-17'), name:"William Brent Bell", bio:"American film director, screenwriter, and producer.  He is known for his work on horror films such as Stay Alive, The Devil Inside, Wer, The Boy, and Brahms: The Boy II...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/f7BvvN72ZhESBQ7wrCVw8M4D9by.jpg", url:"https://themoviedb.org/person/62768"}}, {tmdbId:"71923", properties:{bornIn:"Wheaton, Illinois", imdbId:"0009942", name:"Shane Acker", bio:"From Wikipedia, the free encyclopedia\n\nShane Acker (born 1971, Wheaton, Illinois) is an American film director and screenwriter well known for directing 9 which is based on his 2005 student award-winning film, 9.  He also known for directing several short films for the UCLA as well as animating them. \n\nDescription above from the Wikipedia article Shane Acker, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wEon8gP1cHk4JAjAEHO8lyoRD6H.jpg", url:"https://themoviedb.org/person/71923"}}, {tmdbId:"6767", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0153078", born:date('1956-02-20'), name:"Larry Charles", bio:"Larry Charles (born February 20, 1956) is an American writer, director, and producer.  He is best known as a staff writer for the American sitcom Seinfeld for its first 5 seasons, contributing some of the show's darkest and most absurd storylines.  He has also directed the films Borat, Religulous, Brüno, and The Dictator. \n\nDescription above from the Wikipedia article Larry Charles, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/6767"}}, {tmdbId:"83985", properties:{bornIn:"Granville, Ohio, USA", imdbId:"0007045", born:date('1970-07-22'), name:"Scott Wiper", bio:"From Wikipedia, the free encyclopedia\n\nScott Wiper (born July 22, 1970) is an American writer, film director, and actor. \n\nHe wrote, directed, and starred in A Better Way to Die.  Wiper's was the co-writer and director of the action thriller, The Condemned, starring WWE's \"Stone Cold\" Steve Austin. [1] Wiper wrote the screenplay for the upcoming film version of The Cold Light of Day, starring Bruce Willis and Sigourney Weaver.  Wiper is slated to direct the film...", url:"https://themoviedb.org/person/83985"}}, {tmdbId:"61373", properties:{bornIn:"Anderson, Indiana, USA", imdbId:"0249897", born:date('1968-08-21'), name:"Cory Edwards", bio:"Cory Edwards (born August 21, 1968) is an American film director, screenwriter, and stand-up comedian.  He is probably best known for directing, co-writing, and voice acting in Hoodwinked (2005), and for co-writing and voice acting in the 2011 sequel Hoodwinked Too! Hood vs.  Evil.  He is the older brother of screenwriter/director Todd Edwards and film producer Katie Hooten.  . . . \n\nSource: Article \"Cory Edwards\" from Wikipedia in english, licensed under CC-BY-SA 3. 0...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iSQcrlj71pjtI18ii0TdN2TOgs5.jpg", url:"https://themoviedb.org/person/61373"}}, {tmdbId:"61372", properties:{imdbId:"0498555", name:" Tony Leech", url:"https://themoviedb.org/person/61372"}}, {tmdbId:"12524", properties:{bornIn:"Bellflower, California", imdbId:"0004810", born:date('1956-10-13'), name:"Chris Carter", bio:"Born and raised in Bellflower, California, Chris Carter graduated from the California State University at Long Beach with a degree in journalism.  Formerly a freelance journalist and editor of \"Surfing\"  magazine, Carter began his career as a screenwriter in 1985 at The Walt Disney Studios.  In 1992 Carter began developing projects for Twentieth Century Fox Television...", url:"https://themoviedb.org/person/12524"}}, {tmdbId:"58547", properties:{imdbId:"0425894", name:"Niall Johnson", url:"https://themoviedb.org/person/58547"}}, {tmdbId:"123186", properties:{bornIn:"Montreal, Canada", imdbId:"0343898", born:date('1967-08-19'), name:"Daniel Grou", bio:"From Wikipedia, the free encyclopedia\n\nDaniel Grou, frequently credited as Podz, is a Canadian film and television director.  His credits include the films 10½ and Les 7 jours du Talion, as well as episodes of the television series Drop the Beat, The Hunger, Big Wolf on Campus, Vampire High, Les Bougon, Minuit, le soir and Au nom de la loi. \n\nDescription above from the Wikipedia article Daniel Grou, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/123186"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"357", properties:{bornIn:"Nazareth, Israel", imdbId:"0009463", born:date('1961-10-11'), name:"Hany Abu-Assad", bio:"From Wikipedia, the free encyclopedia.   Hany Abu-Assad (  born 11 October 1961) is a Dutch-Palestinian film director.  His film Paradise Now, about two Palestinian men preparing for a suicide attack in Israel, was nominated for an Academy Award for Best Foreign Language Film in 2006\n\nDescription above from the Wikipedia article Hany Abu-Assad, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/357"}}, {tmdbId:"60923", properties:{imdbId:"0817447", name:" Will Speck", bio:"Will Speck is an American film director...", url:"https://themoviedb.org/person/60923"}}, {tmdbId:"60024", properties:{imdbId:"0295107", name:"Liz Friedlander", bio:"Liz Friedlander is an American film, music video and television director. \n\nOriginally from New York, Friedlander moved to Pennsylvania to attend the Drama Conservatory school at Carnegie Mellon University.  She then moved to Los Angeles where she attended the University of California Santa Cruz followed by the UCLA School of Theater, Film and Television, where she graduated as the valedictorian of her class.  She also won the Frank S.  Glicksman Award for her short film Eleven-Twenty...", url:"https://themoviedb.org/person/60024"}}, {tmdbId:"25453", properties:{bornIn:"El Paso, Texas, USA", imdbId:"0266777", born:date('1960-12-09'), name:"Stefen Fangmeier", bio:"​From Wikipedia, the free encyclopedia.   \n\nStefen Markus Fangmeier (born 9 December 1960 in El Paso, Texas, USA) has been a visual effects supervisor of numerous major feature films, including Lemony Snicket's A Series of Unfortunate Events, Saving Private Ryan, Terminator 2: Judgment Day, Twister, Perfect Storm and Master and Commander.  He also has been a second unit director for two films, Dreamcatcher (2003) and Galaxy Quest (1999)...", url:"https://themoviedb.org/person/25453"}}, {tmdbId:"30053", properties:{bornIn:"Encino, California, USA", imdbId:"0490375", born:date('1966-05-28'), name:"David Michael Latt", url:"https://themoviedb.org/person/30053"}}, {tmdbId:"16959", properties:{bornIn:"Alameda County, California", imdbId:"0206760", born:date('1957-07-07'), name:"Jonathan Dayton", bio:"Jonathan Dayton (born 7 July 1957) and Valerie Faris (born 20 October 1958) are a team of American music video directors, also husband and wife, that received critical acclaim for their feature film directorial debut, Little Miss Sunshine. \n\nDescription above from the Wikipedia article  Jonathan Dayton and Valerie Faris, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7sKsTeeiVjpAIujAw86NStfZvFM.jpg", url:"https://themoviedb.org/person/16959"}}, {tmdbId:"16960", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0267512", born:date('1958-10-20'), name:" Valerie Faris", bio:"Valerie Faris (born October 20, 1958) is American music video and film director, married to Jonathan Dayton...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bHxIbrHwSI5RWdahw21euXm2hjv.jpg", url:"https://themoviedb.org/person/16960"}}, {tmdbId:"62926", properties:{imdbId:"2845421", name:"Steven Cantor", bio:"Steven Cantor is an American film/television director and film/television producer.  Notable works include the films “What Remains”(2006), “loudQUIETloud”(2006), \"Devil's Playground (film)\" and “Blood Ties”(1994).  Cantor has also directed and executive produced the HBO series “Family Bonds”(2003), and has executive produced \"Amish in the City\" (2005 UPN), “#1 Single”(2006 E! Network), and “Kimora: Life in the Fab Lane”(2007 Style Channel).  He is a founding partner in Stick Figure Productions...", url:"https://themoviedb.org/person/62926"}}, {tmdbId:"88825", properties:{imdbId:"0302266", name:" Matthew Galkin", bio:"From Wikipedia, the free encyclopedia. \n\nMatthew Galkin is an American film director and producer, best known for his work in documentaries. \n\nGalkin directed the 2010 HBO documentary Kevorkian, about the controversial right-to-die advocate Jack Kevorkian and his ill-fated 2008 run for Congress...", url:"https://themoviedb.org/person/88825"}}, {tmdbId:"8029", properties:{bornIn:"Kingston - Ontario - Canada", imdbId:"0371755", born:date('1970-09-17'), name:"Jimmy Hayward", bio:"James Hayward (born September 17, 1970) is a Canadian-born, American based film director, screenwriter, animator and guitarist...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iUPWT3m14xpl3WSLm8LblKHRmwy.jpg", url:"https://themoviedb.org/person/8029"}}, {tmdbId:"93107", properties:{bornIn:"Fukuoka, Japan", imdbId:"1482702", born:date('1965-03-16'), name:"Masaaki Yuasa", bio:"Masaaki Yuasa is an anime television and film director, screenwriter, storyboard artist and animator known for his wild free form style.  He was born on March 16, 1965, in Fukuoka, Japan. \n\nIn June 2014, he announced that he, along with his close affiliate Eunyoung Choi, had founded an animation studio by the name of Science Saru.  Yuasa retired as the president of Science Saru on March 25, 2020...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/y1x9421vZ9DkdTHbL105iFW4n21.jpg", url:"https://themoviedb.org/person/93107"}}, {tmdbId:"1098", properties:{imdbId:"0375068", name:"Mark Helfrich", bio:"​From Wikipedia, the free encyclopedia.   \n\nMark Helfrich is an ACE (American Cinema Editor)-certified film editor.  He has edited over thirty films, such as the cult classic Showgirls (1995) with Mark Goldblatt.  Helfrich is also the primary editor for director Brett Ratner's films, such as Money Talks (1997), Rush Hour (1998), The Family Man (2000), Rush Hour 2 (2001), Red Dragon (2002), and After the Sunset (2004), X-Men: The Last Stand (2006) with Mark Goldblatt and Julia Wong...", url:"https://themoviedb.org/person/1098"}}, {tmdbId:"34017", properties:{bornIn:"  Madrid, Spain", imdbId:"0998110", born:date('1970-06-24'), name:"Daniel Sánchez Arévalo", bio:"Daniel Sánchez Arévalo is a Spanish film and television writer, director and producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o3Gnj0HaIoGd2YOh929kjq5SsC3.jpg", url:"https://themoviedb.org/person/34017"}}, {tmdbId:"16356", properties:{imdbId:"0070436", name:"Steve Bendelack", bio:"​From Wikipedia, the free encyclopedia\n\nSteve Bendelack is a British film and television director, who has worked primarily on a range of highly-acclaimed comedy programmes. \n\nOriginally an assistant to Peter Fluck and Roger Law on satirical TV puppet show Spitting Image, he went on to direct the show in later years.  He also directed The Mary Whitehouse Experience, The Royle Family, The League of Gentlemen, Dark Ages, Randall and Hopkirk (Deceased), Cowards and the first season of Little Britain...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rmNl92VXrO2yqoeqW2vX5rqmdKo.jpg", url:"https://themoviedb.org/person/16356"}}, {tmdbId:"19499", properties:{bornIn:"Bathurst, New Brunswick", imdbId:"1083489", born:date('1972-10-26'), name:"Kevin Munroe", bio:"​From Wikipedia, the free encyclopedia\n\nKevin Andrew Munroe is a Canadian filmmaker, now an American citizen.  His best known work is that of writer and director of TMNT (2007).  He also had a cameo appearance as a diner patron in the same film.  His most recent film was Dead of Night. \n\nDescription above from the Wikipedia article Kevin Munroe, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/19499"}}, {tmdbId:"58514", properties:{imdbId:"0814517", name:"Jim Sonzero", bio:"From Wikipedia, the free encyclopedia.   Jim Sonzero is a music video and film director.  He co-directed Mariah Carey's \"Can't Let Go. \" His feature length directorial debut was Pulse, a horror film starring Kristen Bell.  He recently directed Biohazard 5, or Resident Evil 5. \n\nDescription above from the Wikipedia article Jim Sonzero, licensed under CC-BY-SA,full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/58514"}}, {tmdbId:"58375", properties:{imdbId:"0275698", name:"Andy Fickman", bio:"From Wikipedia, the free encyclopedia.   \n\nAndy Fickman is a film and stage director and screenwriter.  His credits as a theater director include the premiere of the Reefer Madness! musical and the first Los Angeles production of the play Jewtopia. \n\nHe made his screen directing debut in 2001 with the teen sex comedy Who's Your Daddy?.  The film was released directly to DVD in 2005...", url:"https://themoviedb.org/person/58375"}}, {tmdbId:"74341", properties:{bornIn:"Pensacola, Florida, U.S.A.", imdbId:"0537410", born:date('1966-08-17'), name:"Matt Maiellaro", bio:"​From Wikipedia, the free encyclopedia\n\nMatthew Gerard Maiellaro (Born August 17, 1966) is the co-creator and writer of the cult television animated Adult Swim shows, Aqua Teen Hunger Force and Perfect Hair Forever, and creator of 12 Oz.  Mouse.  He is a native of Pensacola, Florida, and a graduate of Pensacola Catholic High School. \n\nPrior to his work on Aqua Teen Hunger Force, Maiellaro was a producer and writer for Space Ghost Coast to Coast since the show's inception in 1994...", url:"https://themoviedb.org/person/74341"}}, {tmdbId:"74159", properties:{bornIn:"Orange County, California, USA", imdbId:"0004332", born:date('1959-06-20'), name:"Robert B. Weide", bio:"From Wikipedia, the free encyclopedia.   Robert B.  Weide (born June 20, 1959)  is an American screenwriter, producer, and director, perhaps best known for his Emmy-winning work on documentaries and Curb Your Enthusiasm. \n\nDescription above from the Wikipedia article Robert B.  Weide, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/74159"}}, {tmdbId:"54827", properties:{bornIn:"Berkeley, California", imdbId:"0583515", born:date('1972-10-19'), name:"Dave Meyers", bio:"From Wikipedia, the free encyclopedia\n\nDavid \"Dave\" Meyers is an American music video director. \n\nDescription above from the Wikipedia article Dave Meyers (director), licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/54827"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"60149", properties:{bornIn:"Tarzana, California", imdbId:"0329650", born:date('1978-08-18'), name:"Nicholaus Goossen", bio:"From Wikipedia, the free encyclopedia\n\nNicholaus Edward Goossen (born August 18, 1978 Tarzana, California) is a director, and a photographer. \n\nGoossen's first feature film was \"Grandma's Boy\" for Happy Madison Productions and 20th Century Fox.  He collaborated with Adam Sandler (executive producer of \"Grandma's Boy\") on the album \"Shhh. . . Don't Tell\" as a writer and co-producer in addition to performing on the track \"Gay Robot\"...", url:"https://themoviedb.org/person/60149"}}, {tmdbId:"131239", properties:{bornIn:"Summit, New Jersey, USA", imdbId:"1903582", name:"Marshall Curry", bio:"Marshall Curry (born c.  1970) is an American documentary director, producer, cinematographer and editor.  His films include Street Fight, Racing Dreams, If a Tree Falls: A Story of the Earth Liberation Front, Point and Shoot, and A Night at the Garden...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e0JjVZQ02r1diqUhQafSopFWq1w.jpg", url:"https://themoviedb.org/person/131239"}}, {tmdbId:"13079", properties:{bornIn:"Johannesburg, South Africa", imdbId:"0004303", born:date('1963-05-12'), name:"Gavin Hood", bio:"Gavin Hood (born 12 May 1963) is a South African filmmaker, screenwriter, producer and actor, best known for writing and directing the Academy Award-winning Foreign Language Film Tsotsi (2005).  He is the director of the 20th Century Fox film X-Men Origins: Wolverine, released on 1 May 2009.  He is currently working on a film about the 1925 serum run to Nome of Alaska and Balto, the sled dog that became a celebrity because of the run.  Called Kings of the Trail.  Film released in 2012...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2y2eX4m7qsDgbo51XAK6TE6dJon.jpg", url:"https://themoviedb.org/person/13079"}}, {tmdbId:"74062", properties:{bornIn:"New York City, New York, USA", imdbId:"0796864", born:date('1969-06-08'), name:"Marcos Siega", bio:"Marcos Siega (born June 8, 1969 in New York City, New York) is a film, television, commercial, and music video director.  He has also worked as a producer and a musician. \n\nIn the late 1980s he helped form the New York based punk band Bad Trip, releasing two full length records and numerous EPs.  When he began directing music videos, many bands and musicians noted that Siega's background in rock music was beneficial.  He has worked with bands such as Weezer, System of a Down, P. O. D...", url:"https://themoviedb.org/person/74062"}}, {tmdbId:"78054", properties:{bornIn:"United Kingdom", imdbId:"1031790", name:"Louise Osmond", bio:"Louise Osmond is a British documentary filmmaker famous for the films Deep Water, Dark Horse and Versus: The Life and Films of Ken Loach.   A Modern History  graduate of Oxford University, Osmond initially worked as a print  journalist in Brussels, Paris, Rome and Africa...", url:"https://themoviedb.org/person/78054"}}, {tmdbId:"78055", properties:{imdbId:"1935753", name:" Jerry Rothwell", url:"https://themoviedb.org/person/78055"}}, {tmdbId:"81199", properties:{imdbId:"0003152", name:"Sean McGinly", bio:"From Wikipedia, the free encyclopedia.  Sean McGinly is an American film director and screenwriter.  His film Two Days, starring Paul Rudd and Donal Logue piqued the interest of Tom Hanks, who then agreed to produce McGinly's latest project, The Great Buck Howard through his Playtone production company.  The film stars Hanks himself along with his son Colin Hanks, John Malkovich and Emily Blunt...", url:"https://themoviedb.org/person/81199"}}, {tmdbId:"65525", properties:{imdbId:"0564586", name:"Howard McCain", url:"https://themoviedb.org/person/65525"}}, {tmdbId:"591600", properties:{bornIn:"Ramos Mejía, Argentina", imdbId:"1167933", born:date('1975-07-09'), name:"Damián Szifrón", bio:"Damián Szifron (born 9 July 1975) is an Argentine film and television director and screenwriter, best known as the creator of the TV series Los Simuladores (2002), the most successful TV series in the history of Argentina, and writer-director of Wild Tales (2014), the most successful film in the history of Argentina...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8RRWUHXhnTzqGBJELI70UfcrSpv.jpg", url:"https://themoviedb.org/person/591600"}}, {tmdbId:"29214", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"0281945", born:date('1966-05-01'), name:"Anne Fletcher", bio:"Anne Fletcher (born May 1, 1966) is an American film director and choreographer. \n\nFletcher took dance lessons as a child.  At the age of 15, she appeared on the show Salute to the Superstars; later she moved to California, where she was trained by Joe Tremaine.  She worked as a choreographer and worked in this capacity for six years with Jeff Andrews.  The duo worked among other things on television work and music videos...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yAhFS3NZjQU8zExfJQ3SXEYGMfP.jpg", url:"https://themoviedb.org/person/29214"}}, {tmdbId:"51894", properties:{bornIn:"Barcelona, Catalonia, Spain", imdbId:"1291105", born:date('1975-05-09'), name:"J.A. Bayona", bio:"J.  A.  Bayona was born as Juan Antonio García Bayona.  He is a director, known for “The Impossible” (2012), “The Orphanage” (2007) and “A Monster Calls” (2016)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cnbbnS7K8Uu6yohAfSRHv5Kxc7r.jpg", url:"https://themoviedb.org/person/51894"}}, {tmdbId:"56736", properties:{imdbId:"0658837", name:" Xavier Palud", url:"https://themoviedb.org/person/56736"}}, {tmdbId:"29078", properties:{bornIn:"Melbourne, Victoria, Australia", imdbId:"0362738", name:"Rod Hardy", bio:"From Wikipedia, the free encyclopedia. \n\nRod Hardy (born in Melbourne, Australia) is an Australian television and film director. \n\nHis interest in film began before the age of 12, when he shot several short films on his brother’s 8 mm film camera.  Rod has over 350 hours of credits directing television drama in his native Australia. \n\nHis first feature film, Thirst, won Best Picture in its category at the 1980 Asia Pacific Film Festival...", url:"https://themoviedb.org/person/29078"}}, {tmdbId:"18184", properties:{bornIn:"Dunkerque, France", imdbId:"1164755", born:date('1975-04-27'), name:"Xavier Gens", bio:"From Wikipedia, the free encyclopedia\n\nXavier Gens (born on April 27, 1975 in Dunkirk, France) is a French film director. \n\nDescription above from the Wikipedia article Xavier Gens, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/18184"}}, {tmdbId:"19242", properties:{bornIn:"Manhattan, New York, USA", imdbId:"0006904", born:date('1956-09-11'), name:"Tony Gilroy", bio:"Anthony Joseph \"Tony\" Gilroy (born September 11, 1956) is an American screenwriter and filmmaker.  He wrote the screenplays for the Bourne series starring Matt Damon, among other successful films.  He has been nominated for Academy Awards for his direction and script for Michael Clayton, starring George Clooney.  Gilroy recently wrote and directed Duplicity, starring Julia Roberts and Clive Owen...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tjKPe7Yq68p2IaaCAdSOmXStOKq.jpg", url:"https://themoviedb.org/person/19242"}}, {tmdbId:"35734", properties:{bornIn:"Mississauga, Ontario, Canada", imdbId:"0783536", born:date('1974-01-12'), name:"Aaron Seltzer", bio:"​From Wikipedia, the free encyclopedia\n\nJason Friedberg (born October 13, 1971 in Newark, New Jersey, USA) and Aaron Seltzer (born January 12, 1974 in Mississauga, Ontario, Canada) are a film director and screenwriter team known for making parody films.  They were part of the writing team for Scary Movie and Spy Hard and have written and directed films such as Date Movie, Epic Movie, Meet the Spartans, Disaster Movie and Vampires Suck...", url:"https://themoviedb.org/person/35734"}}, {tmdbId:"35694", properties:{bornIn:"Newark, New Jersey, USA", imdbId:"0294997", born:date('1971-10-13'), name:" Jason Friedberg", bio:"​From Wikipedia, the free encyclopedia\n\nJason Friedberg (born October 13, 1971 in Newark, New Jersey, USA) and Aaron Seltzer (born January 12, 1974 in Mississauga, Ontario, Canada) are a film director and screenwriter team known for making parody films.  They were part of the writing team for Scary Movie and Spy Hard and have written and directed films such as Date Movie, Epic Movie, Meet the Spartans, Disaster Movie and Vampires Suck...", url:"https://themoviedb.org/person/35694"}}, {tmdbId:"71570", properties:{bornIn:"Salford, Lancashire, England, UK", imdbId:"0149491", born:date('1968-12-06'), name:"Justin Chadwick", bio:"Justin Chadwick is a British film and television actor and director, best known for directing the majority of the episodes of the television series \"Bleak House\" as well as the feature films \"The Other Boleyn Girl\" and \"Tulip Fever\".  He's a graduate from the University of Leicester, England, UK...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zrKoTfiSU7yhCmIKVWbkfLgnLWy.jpg", url:"https://themoviedb.org/person/71570"}}, {tmdbId:"53068", properties:{bornIn:"Berkeley, California, USA", imdbId:"0281396", born:date('1976-09-20'), name:"Ryan Fleck", bio:"Ryan K.  Fleck (born September 20, 1976) is an American film director, cinematographer, editor, and screenwriter best known for directing and writing the 2006 film Half Nelson and the 2008 film Sugar.  He is known for his collaborations with fellow filmmaker Anna Boden. \n\nDescription above from the Wikipedia article Ryan Fleck, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vAxcwNOqaQMhldPVXGXTMXKhadk.jpg", url:"https://themoviedb.org/person/53068"}}, {tmdbId:"56383", properties:{bornIn:"Miami, Florida", imdbId:"0716980", born:date('1964-01-01'), name:"Kelly Reichardt", bio:"Kelly Reichardt is a screenwriter and film director.  Her debut film River of Grass was released in 1994.  It was nominated for three Independent Spirit Awards, as well as the Grand Jury Prize at the Sundance Film Festival.  Her other credits include Old Joy, Wendy and Lucy, Meek's Cutoff, Night Moves and Certain Women...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j97hMhlRhcaHWgn9MQ78E0ft57U.jpg", url:"https://themoviedb.org/person/56383"}}] AS row
