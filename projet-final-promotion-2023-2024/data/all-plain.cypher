UNWIND [{tmdbId:"1285197", properties:{imdbId:"1745389", name:"Rob Pearlstein", url:"https://themoviedb.org/person/1285197"}}, {tmdbId:"1046489", properties:{bornIn:"McLean, Virginia, United States", imdbId:"3160595", name:"Richard Bates Jr.", bio:"Richard Bates Jr...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/28LbZozHmM6btjbaIIONOOCFXYz.jpg", url:"https://themoviedb.org/person/1046489"}}, {tmdbId:"57408", properties:{bornIn:"Olathe - Kansas - USA", imdbId:"1415801", born:date('1980-07-12'), name:"Jerusha Hess", bio:"​From Wikipedia, the free encyclopedia. \n\nJared Lawrence Hess  (born July 18, 1979) and Jerusha Elizabeth Hess (née Demke; born May 12, 1980) are husband-and-wife American filmmakers known for their work Napoleon Dynamite (2004) and Nacho Libre (2006), both of which they co-wrote and directed (Nacho Libre was co-written with Mike White).  They also produced the video for The Postal Service's third single, \"We Will Become Silhouettes\"...", url:"https://themoviedb.org/person/57408"}}, {tmdbId:"12095", properties:{bornIn:"United States", imdbId:"0970606", born:date('1965-02-28'), name:"Cody Cameron", bio:"From Wikipedia, the free encyclopedia\n\nCody Cameron is an American voice actor, writer, animator, director, artist, and screenwriter, best known for voicing Pinocchio, the Three Little Pigs, and an Ogre Baby in the Shrek series. \n\nDescription above from the Wikipedia article Cody Cameron,licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9mbcBkcoY64szMdBROVEQE7mn75.jpg", url:"https://themoviedb.org/person/12095"}}, {tmdbId:"1046494", properties:{imdbId:"2329165", name:" Kris Pearn", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9n4eSesg9gGZNrnYDhr6LIVbPZC.jpg", url:"https://themoviedb.org/person/1046494"}}, {tmdbId:"199939", properties:{imdbId:"0868650", name:"Gabe Torres", url:"https://themoviedb.org/person/199939"}}, {tmdbId:"836732", properties:{imdbId:"1500577", name:"Jake Schreier", bio:"Jake Schreier is an American director of short and feature films.  He has also directed music videos and commercials.  He was a founding member of Waverly Films, a Brooklyn-based filmmaking collective, and joined Park Pictures in 2006, releasing his first feature film Robot & Frank in 2012...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fjspp1Tw7z1k5VhTTmMhjvg5Iew.jpg", url:"https://themoviedb.org/person/836732"}}, {tmdbId:"930629", properties:{bornIn:"Vancouver, British Columbia, Canada", imdbId:"1637474", born:date('1979-08-13'), name:"Jamie Travis", bio:"Jamie Travis is a Canadian filmmaker who has directed award-winning films, music videos and television commercials.  He received international recognition for his two short film trilogies: The Patterns Trilogy and the Saddest Children in the World trilogy.  His six shorts, all of which premiered at the Toronto International Film Festival, have drawn comparisons to filmmakers such as David Lynch, Todd Solondz, Peter Greenaway and Wes Anderson.  Travis' first feature film For a Good Time, Call. . ...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9sJniqmYze2yJlGTh0pWN9YLLio.jpg", url:"https://themoviedb.org/person/930629"}}, {tmdbId:"543842", properties:{imdbId:"1428946", name:"David Guy Levy", bio:"From Wikipedia, the free encyclopedia\n\nDavid Guy Levy is President/CEO of Periscope Entertainment. \n\nIn 2004, David Guy Levy founded Periscope Entertainment, a Los Angeles based company dedicated to discovering innovative and original material and developing it into a compelling and unprecedented cinematic experience...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bynvjZ0V5YIM2wcLbMRMrqXMNTQ.jpg", url:"https://themoviedb.org/person/543842"}}, {tmdbId:"1055220", properties:{bornIn:"Londra, Regno Unito", imdbId:"1553775", born:date('1973-01-18'), name:"Crispian Mills", url:"https://themoviedb.org/person/1055220"}}, {tmdbId:"1055221", properties:{imdbId:"4577742", name:" Chris Hopewell", url:"https://themoviedb.org/person/1055221"}}, {tmdbId:"71203", properties:{bornIn:"Santiago, Chile", imdbId:"0939540", born:date('1965-09-14'), name:"Andrés Wood", bio:"Andrés Wood (1965, Chile).  After studying economics at the University of  Chile he left for New York, where he attended a film course.  When he  returned to Chile he made his first feature film 'Historias de fútbol'  which was a box-office hit...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5HfXcNhAGv1j8crUOmpDmkWi5WM.jpg", url:"https://themoviedb.org/person/71203"}}, {tmdbId:"1113116", properties:{bornIn:"Buenos Aires, Argentina", imdbId:"0615592", born:date('1973-08-26'), name:"Andrés Muschietti", bio:"Andrés Muschietti is an Argentine film director and screenwriter, best known for directing the 2013 horror film Mama and the eponymous 2017 adaptation of Stephen King's novel It.  He is the brother of Barbara Muschietti, who works as producer on his films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vWiAwINWnwr3sZWdLJ7pt6LrUkb.jpg", url:"https://themoviedb.org/person/1113116"}}, {tmdbId:"239672", properties:{bornIn:"Ghent, Belgium, EU", imdbId:"0886976", born:date('1977-11-01'), name:"Felix van Groeningen", bio:"Felix van Groeningen is a director and writer from Belgium.  He is known for his film The Broken Circle Breakdown (2012) which earned and Academy Award nomination for Best Foreign Language Film.  In 2018, he made his English-language debut with biographical drama Beautiful Boy...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yU4ufqZgQoFsnr1MQeU87LaatvY.jpg", url:"https://themoviedb.org/person/239672"}}, {tmdbId:"938587", properties:{imdbId:"3286105", name:"Neil Berkeley", url:"https://themoviedb.org/person/938587"}}, {tmdbId:"1404685", properties:{imdbId:"1629378", name:"Bill Filipiak", url:"https://themoviedb.org/person/1404685"}}, {tmdbId:"1404686", properties:{imdbId:"3849677", name:" Louise Palanker", url:"https://themoviedb.org/person/1404686"}}, {tmdbId:"1172509", properties:{bornIn:"Columbus, Ohio, USA", imdbId:"1976847", born:date('1986-09-22'), name:"Chadd Harbold", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/psCDwnIrwaOPLSm5k3ffu09FheY.jpg", url:"https://themoviedb.org/person/1172509"}}, {tmdbId:"163784", properties:{imdbId:"0057592", name:" Seth Barrish", bio:"Seth Barrish is an actor and director...", url:"https://themoviedb.org/person/163784"}}, {tmdbId:"556141", properties:{imdbId:"2244239", name:"Craig Viveiros", url:"https://themoviedb.org/person/556141"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"1085916", properties:{imdbId:"3307527", name:"Gabriela Pichler", url:"https://themoviedb.org/person/1085916"}}, {tmdbId:"930706", properties:{bornIn:"USA", imdbId:"0038896", name:"Rodney Ascher", url:"https://themoviedb.org/person/930706"}}, {tmdbId:"1098037", properties:{imdbId:"2816706", name:"Katherine Fairfax Wright", url:"https://themoviedb.org/person/1098037"}}, {tmdbId:"1098038", properties:{imdbId:"4729613", name:" Malika Zouhali-Worrall", url:"https://themoviedb.org/person/1098038"}}, {tmdbId:"1236458", properties:{bornIn:"Philippines", imdbId:"0215455", born:date('1959-12-31'), name:" Ronnie Del Carmen", bio:"Ronnie del Carmen joined Pixar Animation Studios in the summer of 2000 during the production of \"Finding Nemo\" and became a story supervisor on the film.  He did production design on the Academy Award®-nominated short film, \"One Man Band\" and story work on Oscar®-winning, \"Ratatouille. \" Del Carmen was Head of Story on Disney/Pixar's Academy Award winning feature, \"Up\" and is the co-director of Disney/Pixar's \"Inside Out...", url:"https://themoviedb.org/person/1236458"}}, {tmdbId:"66681", properties:{bornIn:"Oakland, California, USA", imdbId:"2366012", born:date('1978-02-19'), name:"Matt Bettinelli-Olpin", bio:"(born February 19 in California) is an American director, writer, actor and musician.  He is a founding member of the punk band Link 80 and co-creator of the filmmaking collectives Chad, Matt & Rob and Radio Silence.  His films include V/H/S, Devil's Due, Southbound and the thriller Ready or Not...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/segVE2POL8uJ13j29nZdIoF7RSU.jpg", url:"https://themoviedb.org/person/66681"}}, {tmdbId:"1039527", properties:{bornIn:"Flagstaff, Arizona, USA", imdbId:"2419470", born:date('1982-03-06'), name:" Tyler Gillett", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/puopb3xK23iJPQHmgJW0o2iggjh.jpg", url:"https://themoviedb.org/person/1039527"}}, {tmdbId:"1039529", properties:{imdbId:"2318753", name:" Chad Villella", url:"https://themoviedb.org/person/1039529"}}, {tmdbId:"216366", properties:{imdbId:"1892220", name:"Josh C. Waller", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jMIluy350MSLIL9FD65B4ssD9Lj.jpg", url:"https://themoviedb.org/person/216366"}}, {tmdbId:"228311", properties:{imdbId:"2978815", name:"Keith Parmer", url:"https://themoviedb.org/person/228311"}}, {tmdbId:"74730", properties:{bornIn:"Stockholm, Stockholms län, Sweden", imdbId:"0379773", born:date('1967-02-04'), name:"Felix Herngren", bio:"Felix Herngren is a Swedish director, actor, writer and comedian.  He is known for creating and acting in Sweden's most well-known drama-comedy series \"Solsidan\".  He is the younger brother of director and actor Måns Herngren...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hKZcphTUNIRhpYiWHgOSxhNnvuw.jpg", url:"https://themoviedb.org/person/74730"}}, {tmdbId:"1181355", properties:{imdbId:"1862206", name:"Lawrence Shapiro", url:"https://themoviedb.org/person/1181355"}}, {tmdbId:"92436", properties:{bornIn:"Honolulu, Hawaii", imdbId:"0915394", born:date('1968-06-30'), name:"Keoni Waxman", bio:"Keoni is an award winning writer, director and producer who was born in Honolulu, Hawaii.  He is known for his frequent collaboration with Steven Seagal and for the many different movies he has made around the world for his company ActionHouse Pictures...", url:"https://themoviedb.org/person/92436"}}, {tmdbId:"223516", properties:{bornIn:"Manhattan, New York, Stato di New York, Stati Uniti", imdbId:"1022455", born:date('1982-10-14'), name:"Benh Zeitlin", bio:"Born in New York City and raised in Sunnyside, Queens and then Westchester County, Benh Zeitlin began his career as a filmmaker at the tender age of 6 when he and a friend made a Batman movie.  He continued making films as a child before attending Wesleyan University, where he majored in film.  After graduation, Benh spent a summer in Prague working with a prominent animation artist.  Returning to the U. S. , he worked in a private school in Manhattan helping elementary students create short films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xUBFe5fRgIuCq9lAFcBVUfOAlyl.jpg", url:"https://themoviedb.org/person/223516"}}, {tmdbId:"930708", properties:{bornIn:"Ystad, Svezia", imdbId:"0070594", born:date('1977-09-14'), name:"Malik Bendjelloul", died:date('2014-05-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uSaIvsfguot1sxSwH5xX5Jq6Afs.jpg", url:"https://themoviedb.org/person/930708"}}, {tmdbId:"930705", properties:{imdbId:"1132362", name:"Lauren Greenfield", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7lcA7e6PWs2Kr4wf8kQqhHXHF6m.jpg", url:"https://themoviedb.org/person/930705"}}, {tmdbId:"1331991", properties:{imdbId:"2489573", name:"Justin Reardon", url:"https://themoviedb.org/person/1331991"}}, {tmdbId:"1141683", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0577647", born:date('1971-01-01'), name:"Theodore Melfi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hn2z28ofSNRxx4UTo6qOqzYCx0u.jpg", url:"https://themoviedb.org/person/1141683"}}, {tmdbId:"1041418", properties:{imdbId:"1038286", name:"Jonathan Sobol", url:"https://themoviedb.org/person/1041418"}}, {tmdbId:"1150763", properties:{imdbId:"1203596", name:"Kim Mordaunt", url:"https://themoviedb.org/person/1150763"}}] AS row
