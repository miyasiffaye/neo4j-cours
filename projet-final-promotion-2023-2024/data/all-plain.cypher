UNWIND [{tmdbId:"2141", properties:{bornIn:" Dayton, Ohio, USA", imdbId:"0068709", born:date('1957-05-07'), name:"Ned Bellamy", bio:"​From Wikipedia, the free encyclopedia\n\nNed Bellamy (born May 7, 1957) is an American actor.  Bellamy was born in Dayton, Ohio.  After graduating UCLA, he founded the Los Angeles based theater company The Actors' Gang with fellow actor Tim Robbins.  He was featured on a role on an episode of Seinfeld entitled The Fatigues.  His brother, Mark Bellamy, was the United States Ambassador to Kenya from 2003-2006...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uTVy2aJkcLTYxPwLt8dpYxsEZul.jpg", url:"https://themoviedb.org/person/2141"}}, {tmdbId:"20234", properties:{bornIn:"Saumur, Maine-et-Loire, France", imdbId:"0000272", born:date('1949-03-22'), name:"Fanny Ardant", bio:"Fanny Marguerite Judith Ardant (born 22 March 1949 in Saumur, Maine-et-Loire) is a French actress.  She has appeared in more than fifty motion pictures since 1976.  Ardant won the César Award for Best Actress in 1997 for her performance in Pédale douce...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9JQB8r7D2pSiRD4TQCKdW3dhQsK.jpg", url:"https://themoviedb.org/person/20234"}}, {tmdbId:"28255", properties:{bornIn:"Paris, France", imdbId:"0524528", born:date('1951-11-01'), name:"Fabrice Luchini", bio:"Fabrice Luchini was born in Île-de-France, Paris, into an Italian immigrant family, who were fruit and vegetable vendors.  He grew up around the neighbourhood of Goutte d'Or in Paris's 18th arrondissement.  When he was 13, his mother apprenticed him to a hairdresser in a trendy parlor on Avenue Matignon, where he would take the name of the hairdresser's son, Fabrice, in place of his real name, Robert.  At the same time he developed a great interest for literature (Balzac, Flaubert, Proust)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ycAUdyF80ipYe1evd7JtITdWojQ.jpg", url:"https://themoviedb.org/person/28255"}}, {tmdbId:"18177", properties:{bornIn:"Annecy, Haute-Savoie, France", imdbId:"0244707", born:date('1946-02-17'), name:"André Dussollier", bio:"André Dussollier (born 17 February 1946; Annecy, Haute-Savoie, France) is a French actor. \n\nDescription above from the Wikipedia article André Dussollier, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hDROAFwZG5F7eduBQEbR1QXOwj2.jpg", url:"https://themoviedb.org/person/18177"}}, {tmdbId:"93518", properties:{imdbId:"0362970", born:date('1945-11-28'), name:"John Hargreaves", died:date('1996-01-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mu5r3chR06UG3rCY5w2gyU66hDc.jpg", url:"https://themoviedb.org/person/93518"}}, {tmdbId:"18792", properties:{bornIn:"Eltham, London, England, UK", imdbId:"0005148", born:date('1952-11-18'), name:"Delroy Lindo", bio:"Delroy Lindo is an English director, writer and actor for stage and screen, best known for his film roles as West Indian Archie in Spike Lee's \"Malcolm X\", Catlett in \"Get Shorty\", Detective Castlebeck in \"Gone in 60 Seconds\", and Woody Carmichael in \"Crooklyn\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kLwUBBmEIdchrLqwsYzgLB2B6q5.jpg", url:"https://themoviedb.org/person/18792"}}, {tmdbId:"112037", properties:{bornIn:"New York City, New York, USA", imdbId:"0365450", born:date('1985-02-17'), name:"Zelda Harris", bio:"From Wikipedia, the free encyclopedia\n\nZelda Harris (born February 17, 1985) is an American actress. \n\nHarris was born in New York City, New York to Karen and Philip Harris.  She has a sister, Kenya.  She attended Princeton University, where she was a member of the Class of 2007. \n\nDescription above from the Wikipedia article Zelda Harris, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/112037"}}, {tmdbId:"57700", properties:{bornIn:"Oakland, California, USA", imdbId:"0000488", born:date('1965-02-01'), name:"Brandon Lee", bio:"Brandon Bruce Lee was an American actor and martial artist.  He was the only son of martial artist and actor Bruce Lee and teacher Linda Lee Cadwell, the grandson of Cantonese opera singer Lee Hoi-chuen, and brother of Shannon Lee. \n\nDescription above from the Wikipedia article Brandon Lee, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1993-03-31'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tvixDeEzSFc8cN0OYNsWBGICdJ0.jpg", url:"https://themoviedb.org/person/57700"}}, {tmdbId:"57701", properties:{bornIn:"Philadelphia, Pennsylvania, USA", imdbId:"0205373", born:date('1980-06-13'), name:"Rochelle Davis", url:"https://themoviedb.org/person/57701"}}, {tmdbId:"7486", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"0000699", born:date('1958-01-21'), name:"Michael Wincott", bio:"Michael Anthony Claudio Wincott is a Canadian actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lHXibYd6X8tQxgLXAcPxpJ5sedi.jpg", url:"https://themoviedb.org/person/7486"}}, {tmdbId:"73033", properties:{bornIn:"Philadelphia, Pennsylvania, USA", imdbId:"0190054", born:date('1943-08-30'), name:"Robert Crumb", bio:"From Wikipedia, the free encyclopedia. \n\nRobert Dennis Crumb (born August 30, 1943)—known as Robert Crumb and R.  Crumb—is an American artist, illustrator, and musician recognized for the distinctive style of his drawings and his critical, satirical, subversive view of the American mainstream. \n\nCrumb was a founder of the underground comix movement and is regarded as its most prominent figure...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pcdC4hBjHI4zLTGOlnoHABzOlq8.jpg", url:"https://themoviedb.org/person/73033"}}, {tmdbId:"95663", properties:{bornIn:"Long Beach, New York, U.S.", imdbId:"0464642", name:"Aline Kominsky", bio:"From Wikipedia, the free encyclopedia. \n\nAline Kominsky-Crumb (born Aline Goldsmith, August 1948, Long Beach, New York) is an American underground comics artist best known as the wife of cartoonist R.  Crumb. \n\nShe was born to a middle class Jewish family in the Five Towns area of Long Island.  Her father was a largely unsuccessful businessman and organized crime associate...", url:"https://themoviedb.org/person/95663"}}, {tmdbId:"1369235", properties:{imdbId:"0190047", name:"Charles Crumb", url:"https://themoviedb.org/person/1369235"}}, {tmdbId:"1369236", properties:{imdbId:"0190052", name:"Maxon Crumb", url:"https://themoviedb.org/person/1369236"}}, {tmdbId:"49824", properties:{bornIn:"Newton, Massachusetts, USA", imdbId:"0002062", born:date('1965-07-05'), name:"Kathryn Erbe", bio:"Kathryn Erbe is an American actress, known for her role on Law & Order: Criminal Intent and on Oz...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gJ3hlTzTjpTVBsGadvUQGiBgjsV.jpg", url:"https://themoviedb.org/person/49824"}}, {tmdbId:"37422", properties:{bornIn:"Volyně, Czechoslovakia", imdbId:"0747962", born:date('1920-06-06'), name:"Jan Rubes", bio:"Born in Czechoslovakia.  After graduating in 1945 from the Conservatory of Music in Prague, Jan Rubes went on to join the Prague Opera House as their youngest basso singer.  He also performed at the Pilsen Opera House in leading roles in his early years.  By 1948, he was chosen to represent Czechoslovakia at the International Music Festival held in Geneva and won first prize in his category.  He emigrated to Canada on New Year's Eve 1948 with hopes of creating a greater musical career...", died:date('2009-06-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w5SCEdSz6FJIBvGWjWxufvjTZnb.jpg", url:"https://themoviedb.org/person/37422"}}, {tmdbId:"77624", properties:{bornIn:"Katy, Texas, U.S.", imdbId:"0640488", born:date('1971-02-15'), name:"Renée O'Connor", bio:"From Wikipedia, the free encyclopedia.   Renée O'Connor (born Evelyn Renée O'Connor; February 15, 1971) is an American actress, producer and director best known for playing the role of Gabrielle on the TV series Xena: Warrior Princess from 1995 to 2001. \n\nDescription above from the Wikipedia article Renee O'Connor, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vrhotcdzXbPuYRJlzI8YDxZIkt.jpg", url:"https://themoviedb.org/person/77624"}}, {tmdbId:"2536", properties:{bornIn:"Corona, California, USA", imdbId:"0662981", born:date('1940-04-24'), name:"Michael Parks", bio:"From Wikipedia, the free encyclopedia. \n\nMichael Parks (born Harry Samuel Parks; April 24, 1940) was an American actor and singer.  He appeared in almost fifty films and made frequent TV appearances, but is probably best known for his work in recent years with Quentin Tarantino, Robert Rodriguez, and Kevin Smith as well as the 1969 television series Then Came Bronson. \n\nParks died on 9 May 2017...", died:date('2017-05-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sXK8vnVNyYzJl2oE6lxKLtxG9px.jpg", url:"https://themoviedb.org/person/2536"}}, {tmdbId:"14905", properties:{imdbId:"0787825", name:"Chuck Shamata", bio:"Chuck Shamata's career spans four decades in film, television and theatre.  Among his most recent credits are the feature films One Week, The Sentinal, Cinderella Man and War Games 2; the cable movies Tipping Point,The Engagement Ring and Kojak (and the ensuing series)...", url:"https://themoviedb.org/person/14905"}}, {tmdbId:"65537", properties:{imdbId:"0610210", name:"Krystia Mova", url:"https://themoviedb.org/person/65537"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"77904", properties:{bornIn:" Paris, France", imdbId:"0352847", born:date('1956-06-22'), name:"François Hadji-Lazaro", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mSwNnb09uLwXFO6YqlKQkZ0zi8n.jpg", url:"https://themoviedb.org/person/77904"}}, {tmdbId:"87679", properties:{bornIn:"Tampere, Finland", imdbId:"0001197", born:date('1972-04-22'), name:"Anna Falchi", bio:"Anna Falchi was born Anna Kristiina Palomäki on 22 April 1972 in Tampere, Finland, the daughter of an Italian father Benito (Tito) and Finnish mother Karina.  Anna has a brother Saro and a half brother in Sweden Peter (same father).  In 1978, at the age of six, she moved to Italy with her family.  She started her career as a model.  She first appeared on television in a commercial for an Italian bank in 1992.  The ad starred Paolo Villaggio, and was directed by the celebrated Federico Fellini...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vONWkjgXg1mGIajmGYLkOAnRUmL.jpg", url:"https://themoviedb.org/person/87679"}}, {tmdbId:"46418", properties:{bornIn:"New York, New York, U.S.A.", imdbId:"0461658", born:date('1921-12-12'), name:"Mickey Knox", bio:"Mickey Knox was an American actor and good friend of Lee Strasburg.  When the McCarthy hearings blacklisted Knox as a possible Communist sympathizer, he found his career in ruins and subsequently moved to Italy where he became central in their dubbing industry.   He found work as a dialog director, dubber, producer, voice actor, and writer as he would often be charged with translating scripts for the numerous Italian films to be shot in English...", died:date('2013-11-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/s5cRx4lsSlpvBW7U2sybfHqf5HZ.jpg", url:"https://themoviedb.org/person/46418"}}, {tmdbId:"42325", properties:{imdbId:"0257414", born:date('1972-10-09'), name:"Audie England", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tz1Csoa9Q3EdnaHq1y6ekZXmMhn.jpg", url:"https://themoviedb.org/person/42325"}}, {tmdbId:"36055", properties:{bornIn:"Melbourne, Victoria, Australia", imdbId:"0541908", born:date('1965-09-03'), name:"Costas Mandylor", bio:"Costas Mandylor is a Greek Australian film and television actor, best known for his role as Officer Kenny Lacos in the television series _Picket Fences_, and for portraying Mark Hoffman in the feature film franchise _Saw_...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/urGJrOnb6mEPmqZnkhwd0bXg2U5.jpg", url:"https://themoviedb.org/person/36055"}}, {tmdbId:"1048570", properties:{imdbId:"0196230", name:"Eric Da Silva", url:"https://themoviedb.org/person/1048570"}}, {tmdbId:"1048572", properties:{imdbId:"0811311", name:"Raven Snow", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aNUpW8BvhvZPaH0IeuycZdxTg23.jpg", url:"https://themoviedb.org/person/1048572"}}, {tmdbId:"33448", properties:{bornIn:"Sheffield, South Yorkshire", imdbId:"0661407", born:date('1935-11-07'), name:"Judy Parfitt", bio:"From Wikipedia, the free encyclopedia\n\nJudith C.  C.  Parfitt, known as Judy Parfitt (born 7 November 1935) is a BAFTA-nominated English theatre, film and television actress who began her career on stage in 1954. \n\nDescription above from the Wikipedia article Judy Parfitt, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n0kfpBOHCEWjUdXfzRaYaIjVBg4.jpg", url:"https://themoviedb.org/person/33448"}}, {tmdbId:"25540", properties:{bornIn:"Nepean, Ontario, Canada", imdbId:"0644897", born:date('1971-07-20'), name:"Sandra Oh", bio:"From Wikipedia, the free encyclopedia. \n\nSandra Oh (born July 20, 1971) is a Canadian actress.  She is primarily known for portraying the role of Dr.  Cristina Yang on ABC's Grey's Anatomy, for which she has won a Golden Globe and Screen Actors Guild award.  She also played notable roles in the feature films Under the Tuscan Sun and Sideways, and had a supporting role on the HBO original series Arli$$...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zU8vjebHxcP60ESEL5Ok68KWZvj.jpg", url:"https://themoviedb.org/person/25540"}}, {tmdbId:"158567", properties:{imdbId:"0151822", name:"Stephen Chang", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lSC0PZHByaTBs7O4vZuggLh0TGZ.jpg", url:"https://themoviedb.org/person/158567"}}, {tmdbId:"158522", properties:{imdbId:"0648628", name:"Alannah Ong", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rlpzfmtQw0hF1oTgqiGNZwpOcHS.jpg", url:"https://themoviedb.org/person/158522"}}, {tmdbId:"86766", properties:{imdbId:"0284557", name:"Donald Fong", url:"https://themoviedb.org/person/86766"}}, {tmdbId:"20759", properties:{bornIn:"New York City, New York, USA", imdbId:"0000319", born:date('1970-07-02'), name:"Yancy Butler", bio:"An American television and movie actress known for her roles as Natasha Binder in the 1993 John Woo film Hard Target and as Detective Sara Pezzini on the TNT supernatural drama Witchblade...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z4IbPBVF4GHJq7IWdLQg71zRcyd.jpg", url:"https://themoviedb.org/person/20759"}}, {tmdbId:"2169", properties:{bornIn:"Lawrenceburg, Tennessee, USA", imdbId:"0005052", born:date('1952-08-26'), name:"Michael Jeter", bio:"From Wikipedia, the free encyclopedia. \n\nMichael Jeter (August 26, 1952 – March 30, 2003) was an American actor. \n\nDescription above from the Wikipedia article Michael Jeter, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2003-03-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pNBf8X56wCOHH7cArsMYJuke4fO.jpg", url:"https://themoviedb.org/person/2169"}}, {tmdbId:"108343", properties:{imdbId:"1262727", name:"Robert 'Wingnut' Weaver", url:"https://themoviedb.org/person/108343"}}, {tmdbId:"2603790", properties:{name:"Patrick O'Connell", url:"https://themoviedb.org/person/2603790"}}, {tmdbId:"55926", properties:{bornIn:"Pau, France", imdbId:"0136597", born:date('1967-03-29'), name:"Nathalie Cardone", poster:"https:/