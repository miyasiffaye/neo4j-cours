UNWIND [{tmdbId:"76134", properties:{imdbId:"0200313", born:date('1942-12-29'), name:"Rick Danko", died:date('1999-12-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nC1AZmvzUUblGVeCvA02kCJSGAr.jpg", url:"https://themoviedb.org/person/76134"}}, {tmdbId:"72861", properties:{imdbId:"0005371", born:date('1943-07-05'), name:"Robbie Robertson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x2X4FrMqIYlEVKqNSp5zhvnskyM.jpg", url:"https://themoviedb.org/person/72861"}}, {tmdbId:"76135", properties:{imdbId:"0544274", born:date('1943-04-03'), name:"Richard Manuel", died:date('1986-03-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nn3bt0ZlxuZDwJioTY3IZLL7rlT.jpg", url:"https://themoviedb.org/person/76135"}}, {tmdbId:"16270", properties:{bornIn:"London - England - UK", imdbId:"0345295", born:date('1953-12-05'), name:"Christopher Guard", bio:"Christopher Guard (born 5 December 1953 in London) is an English actor.   Educated at Latymer Upper School, Guard was a member of the National Theatre aged 20.  He has appeared inVienna 1900 (1973), Memoirs of a Survivor and Return to Treasure Island (1986)...", url:"https://themoviedb.org/person/16270"}}, {tmdbId:"16271", properties:{bornIn:"Neath - Glamorgan - Wales - UK", imdbId:"0820109", born:date('1916-04-29'), name:"William Squire", bio:"William Squire (29 April 1917 – 3 May 1989) was a Welsh actor of stage, film and television.   Squire was born in Neath, South Wales, the son of William Squire and his wife Martha (née Bridgeman).   As a stage actor, Squire performed at Stratford-upon-Avon and at the Old Vic, and notably replaced his fellow-countryman Richard Burton as King Arthur in Camelot at the Majestic Theatre on Broadway...", died:date('1989-05-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/k3HPWslxIahGKovuQLgvk3CuB8i.jpg", url:"https://themoviedb.org/person/16271"}}, {tmdbId:"16272", properties:{imdbId:"0774578", name:"Michael Scholes", url:"https://themoviedb.org/person/16272"}}, {tmdbId:"5049", properties:{bornIn:"Shirebrook, Derbyshire, England, UK", imdbId:"0000457", born:date('1940-01-22'), name:"John Hurt", bio:"John Vincent Hurt, CBE (22 January 1940 - 25 January 2017) was an English actor, known for his leading roles as John Merrick in The Elephant Man, Winston Smith in Nineteen Eighty-Four, Mr.  Braddock in The Hit, Stephen Ward in Scandal and Quentin Crisp in The Naked Civil Servant, Caligula in the television series, I, Claudius (TV series), and An Englishman in New York...", died:date('2017-01-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kLW1Q53NRuB0EihduBFX3Lbtcl6.jpg", url:"https://themoviedb.org/person/5049"}}, {tmdbId:"15057", properties:{imdbId:"0025355", name:"John Amplas", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ikLsiyNsmWiqRxXH58Xcf42LIkg.jpg", url:"https://themoviedb.org/person/15057"}}, {tmdbId:"95603", properties:{imdbId:"0531042", name:"Lincoln Maazel", url:"https://themoviedb.org/person/95603"}}, {tmdbId:"100507", properties:{imdbId:"0286611", name:"Christine Forrest", url:"https://themoviedb.org/person/100507"}}, {tmdbId:"100508", properties:{imdbId:"0618797", name:"Elyane Nadeau", url:"https://themoviedb.org/person/100508"}}, {tmdbId:"69010", properties:{bornIn:"Tallahassee, Florida, U.S.", imdbId:"0001113", born:date('1949-11-06'), name:"Brad Davis", bio:"Robert Creel \"Brad\" Davis (November 6, 1949 – September 8, 1991) was an American actor, known for starring in the 1978 film Midnight Express and 1982 film Querelle...", died:date('1991-09-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kFbFYfWiUxyWAGJeg4NBQpTmIdF.jpg", url:"https://themoviedb.org/person/69010"}}, {tmdbId:"69011", properties:{bornIn:"Stillwater, Oklahoma, U.S.", imdbId:"0591968", born:date('1954-01-24'), name:"Irene Miracle", bio:"From Wikipedia, the free encyclopedia.   Irene Miracle (born January 24, 1954 in Stillwater, Oklahoma) is an American film and television actress and director. \n\n \n\nDescription above from the Wikipedia article Irene Miracle, licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4lK6wPnosubEuBAih8LkYIfa66a.jpg", url:"https://themoviedb.org/person/69011"}}, {tmdbId:"3999", properties:{bornIn:"Whitewater, Wisconsin, USA", imdbId:"0001371", born:date('1953-12-06'), name:"Tom Hulce", bio:"From Wikipedia, the free encyclopedia. \n\nTom Hulce (born Thomas Edward Hulce on December 6, 1953) is an American actor and theater producer.  As an actor, he is perhaps best known for his Oscar-nominated portrayal of Mozart in the movie Amadeus and his role as \"Pinto\" in National Lampoon's Animal House.  Additional acting awards included a total of four Golden Globe nominations, an Emmy Award, and a Tony Award nomination...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ufgpuuU900NOi1vKupCmWpq7UgW.jpg", url:"https://themoviedb.org/person/3999"}}, {tmdbId:"52304", properties:{bornIn:"Norfolk, Virginia, USA", imdbId:"0299122", born:date('1955-05-08'), name:"Stephen Furst", bio:"Stephen Furst (1955 - 2017) was an American actor and film and television director.  He was a regular in the science fiction series Babylon 5 playing Centauri diplomatic attaché Vir Cotto and as Dr.  Elliot Axelrod on St.  Elsewhere, and featured in the film National Lampoon's Animal House...", died:date('2017-06-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ya5sNoy59M7OwywmlbnIhONk72u.jpg", url:"https://themoviedb.org/person/52304"}}, {tmdbId:"55194", properties:{bornIn:"Findlay, Ohio, USA", imdbId:"0582420", born:date('1946-03-11'), name:"Mark Metcalf", bio:"Mark Metcalf was born on March 11, 1946 in Findlay, Ohio, USA. \n\nHe had supporting roles in the films Animal House, Drive Me Crazy and The Stupids as well as the the television series Seinfeld and Buffy the Vampire Slayer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oEtVysd2D05g2UHEZi2IbJRPxVX.jpg", url:"https://themoviedb.org/person/55194"}}, {tmdbId:"55196", properties:{bornIn:"New York City, New York, USA", imdbId:"0919875", born:date('1946-09-01'), name:"Mary Louise Weller", bio:"Lovely, shapely and appealing blonde actress Mary Louise Weller was born on September 1, 1946 and raised in Los Angeles.  The onetime top New York model made her film debut with an uncredited tiny role in the superbly gritty cop drama Serpico (1973)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5SYmsari6g7xNnohwuTJWDLNf8f.jpg", url:"https://themoviedb.org/person/55196"}}, {tmdbId:"162168", properties:{bornIn:" Brooklyn, New York, USA", imdbId:"0322239", born:date('1942-12-16'), name:"Eugene Robert Glazer", url:"https://themoviedb.org/person/162168"}}, {tmdbId:"108700", properties:{bornIn:"Bayside, New York, USA", imdbId:"0226326", born:date('1944-01-11'), name:"Eileen Dietz", bio:"From Wikipedia, the free encyclopedia. \n\nEileen Dietz (born 11 January 1945, Bayside, New York) is an American actress who is best known for her appearances in many horror films and for her portrayal of characters on the soap operas Guiding Light and General Hospital. \n\nDescription above from the Wikipedia article Eileen Dietz, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/108700"}}, {tmdbId:"92691", properties:{bornIn:"Toronto, Ontario,  Canada", imdbId:"0579991", born:date('1949-12-03'), name:"Heather Menzies-Urich", died:date('2017-12-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dqvVyBGvfelVSSHR6azFAUn4Xfu.jpg", url:"https://themoviedb.org/person/92691"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"15110", properties:{bornIn:"New York City - New York - USA", imdbId:"0000222", born:date('1965-05-31'), name:"Brooke Shields", bio:"From Wikipedia, the free encyclopedia\n\nBrooke Christa Shields (born May 31, 1965, height 6' (1,83 m)) is an American actress, author and model.  Some of her better-known movies include Pretty Baby and The Blue Lagoon, as well as TV shows such as Suddenly Susan, That '70s Show and Lipstick Jungle. \n\nDescription above from the Wikipedia article Brooke Shields, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qpLcTp5D6t0S0TtNK85VOYwDmTL.jpg", url:"https://themoviedb.org/person/15110"}}, {tmdbId:"115187", properties:{bornIn:" Brooklyn, New York, USA", imdbId:"0269662", born:date('1912-11-04'), name:"Frances Faye", died:date('1991-11-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6OWG7NPkFUsiuXg8xkGJeOdB00m.jpg", url:"https://themoviedb.org/person/115187"}}, {tmdbId:"17576", properties:{bornIn:"Shawinigan, Quebec, Canada", imdbId:"0491021", born:date('1948-08-05'), name:"Carole Laure", bio:"From Wikipedia, the free encyclopedia. \n\nCarole Laure (born on August 5, 1951, in Shawinigan) is an actress and singer from the province of Quebec in Canada. \n\nDescription above from the Wikipedia article Carole Laure, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eNUI1ECYTYoCYXP1tZmOu5PEURo.jpg", url:"https://themoviedb.org/person/17576"}}, {tmdbId:"87066", properties:{bornIn:"Houston, Texas, USA ", imdbId:"0252055", born:date('1962-07-21'), name:"Ike Eisenmann", url:"https://themoviedb.org/person/87066"}}, {tmdbId:"103733", properties:{bornIn:"Iowa, USA", imdbId:"0093780", born:date('1924-10-31'), name:"Ivan Bonar", died:date('1988-12-08'), url:"https://themoviedb.org/person/103733"}}, {tmdbId:"164859", properties:{imdbId:"0473594", name:"Bernie Kuby", url:"https://themoviedb.org/person/164859"}}, {tmdbId:"562708", properties:{bornIn:"Beckenham, London, England, United Kingdom", imdbId:"0289759", born:date('1950-04-22'), name:"Peter Frampton", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/93RYZ65upD8GAYoqUcjtzlg2qM0.jpg", url:"https://themoviedb.org/person/562708"}}, {tmdbId:"66885", properties:{bornIn:"Douglas, Isle of Man, UK", imdbId:"0002956", born:date('1946-09-01'), name:"Barry Gibb", bio:"From Wikipedia, the free encyclopedia. \n\nBarry Alan Crompton Gibb, CBE (born 1 September 1946), is a singer, songwriter and producer.  He was born on the Isle of Man to English parents.  With his brothers Robin and Maurice, he formed the Bee Gees, one of the most successful pop groups of all time.  The trio got their start in Australia, and found their major success when they returned to England...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tFhhYU0Kgjc5ytPWRHV3zcAYPs5.jpg", url:"https://themoviedb.org/person/66885"}}, {tmdbId:"66886", properties:{bornIn:"Douglas, Isle of Man, UK", imdbId:"0316471", born:date('1949-12-22'), name:"Robin Gibb", bio:"From Wikipedia, the free encyclopedia. \n\nRobin Hugh Gibb, CBE (born 22 December 1949) is an English singer and songwriter.  He is best known as a member of the Bee Gees, co-founded with his twin brother Maurice (1949–2003), and elder brother Barry. \n\nBorn to English parents, the trio started their musical career in Australia, and found major success when they returned to England...", died:date('2012-05-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1VgBolXppg0sLwMKtYVaiDNnJHN.jpg", url:"https://themoviedb.org/person/66886"}}, {tmdbId:"66887", properties:{bornIn:"Douglas, Isle of Man, UK", imdbId:"0316465", born:date('1949-12-22'), name:"Maurice Gibb", bio:"From Wikipedia, the free encyclopedia. \n\nMaurice Ernest Gibb, CBE (22 December 1949 – 12 January 2003) was a musician and singer-songwriter.  He was born in the Isle of Man, the twin brother of Robin Gibb, and younger brother to Barry.  He is best known as a member of the singing/songwriting trio the Bee Gees, formed with his brothers Robin and Barry.  The trio got their start in Australia, and found major success when they returned to England...", died:date('2003-01-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yEavlJatl1hLiz2aNZlb9ZMlo0y.jpg", url:"https://themoviedb.org/person/66887"}}, {tmdbId:"70673", properties:{bornIn:"Pematang Siantar, Indonesia", imdbId:"0516316", born:date('1939-06-29'), name:"Lieh Lo", bio:"Wang Lap Tat (June 29, 1939 – November 2, 2002), better known by his stage name Lo Lieh, was an Indonesian-born Hong Kong actor, best known as Chao Chih-Hao in King Boxer (1972, aka Five Fingers of Death), Miyamoto in Fist of Fury II (1977) and General Tien Ta in The 36th Chamber of Shaolin (1978)...", died:date('2002-11-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cUZZlI9m1JnxmCvOWDtDu5hqO3p.jpg", url:"https://themoviedb.org/person/70673"}}, {tmdbId:"70674", properties:{bornIn:"Xinhui, Guangdong, China", imdbId:"0160865", born:date('1955-10-16'), name:"Norman Chu", bio:"Norman Chu (Chinese: 徐少強, born 16 October 1955) is a Hong Kong actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jkBpEt6ia5EvWoUke8EtW3fttvY.jpg", url:"https://themoviedb.org/person/70674"}}, {tmdbId:"26727", properties:{imdbId:"0790925", born:date('1950-10-17'), name:"Dean Shek", bio:"Dean Shek (sometimes written Shek Tien, Chinese: 石天) a. k. a.  Dean Shek Tin (born 17 May 1950) is a veteran Hong Kong feature film actor and film producer with over 92 films acting credits to his name.  Shek is perhaps best known as Professor Kai-hsien in the 1978 film, Drunken Master, Lung Sei in the 1987 film, A Better Tomorrow 2, and Snooker in the 1990 film, The Dragon from Russia...", url:"https://themoviedb.org/person/26727"}}, {tmdbId:"19183", properties:{bornIn:"Queens, New York City, New York, USA", imdbId:"0331054", born:date('1936-10-13'), name:"Cliff Gorman", bio:"Cliff Gorman was an American stage and screen actor.  He won an Obie award in 1968 for the stage presentation of The Boys in the Band, and went on to reprise his role in the 1970 film version...", died:date('2002-09-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8piJCUHSm6TCVUdfYFvj8FgAMT.jpg", url:"https://themoviedb.org/person/19183"}}, {tmdbId:"29859", properties:{bornIn:"Raynes Park, Surrey, England, UK", imdbId:"0001972", born:date('1934-01-14'), name:"Richard Briers", bio:"Richard David Briers, CBE was an English actor.  His fifty-year career encompassed television, stage, film and radio. \n\nBriers first came to prominence as George Starling in Marriage Lines (1961–66), but it was a decade later, when he narrated Roobarb and Noah and Nelly in. . .  SkylArk (1974–76) and when he played Tom Good in the BBC sitcom The Good Life (1975–78), that he became a household name...", died:date('2013-02-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9nMVm8XxelrqBSjvgL93847hv6F.jpg", url:"https://themoviedb.org/person/29859"}}, {tmdbId:"16380", properties:{bornIn:"London, England, UK", imdbId:"0185163", born:date('1938-01-08'), name:"Michael Graham Cox", died:date('1995-04-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oALXq1Y6wtdj3ArdmAwYRvAn5XX.jpg", url:"https://themoviedb.org/person/16380"}}, {tmdbId:"47547", properties:{bornIn:"Beckenham, Kent, England, UK", imdbId:"0071838", born:date('1928-05-08'), name:"John Bennett", died:date('2005-04-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/arSkPpoGcRyqSdx4iAE9DtBc2Z8.jpg", url:"https://themoviedb.org/person/47547"}}, {tmdbId:"14837", properties:{bornIn:"San Antonio, Texas, USA", imdbId:"0000993", born:date('1933-04-26'), name:"Carol Burnett", bio:"​From Wikipedia, the free encyclopedia. \n\nCarol Creighton Burnett (born April 26, 1933) is an American actress, comedienne, singer, dancer and writer.  Burnett started her career in New York.  After becoming a hit on Broadway, she made her television debut.  After successful appearances on The Garry Moore Show, Carol moved to Los Angeles and began an eleven-year run on The Carol Burnett Show which was aired on CBS television from 1967 to 1978...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/edrfJbdr9cK3Yo60yXatRGdZWua.jpg", url:"https://themoviedb.org/person/14837"}}, {tmdbId:"15900", properties:{bornIn:"Parkersburg, West Virginia, U.S.", imdbId:"0233209", born:date('1928-02-22'), name:"Paul Dooley", bio:"Dooley was born Paul Brown in Parkersburg, West Virginia, the son of Ruth Irene (née Barringer), a homemaker, and Peter James Brown, a factory worker.  Dooley was a keen cartoonist as a youth and drew a strip for a local paper in Parkersburg.  He joined the Navy before discovering acting while at college.  He is married to writer Winnie Holzman, with whom he has one daughter, Savannah Dooley (born 1985).   Moving to New York, he soon found success as a regular on the stage...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7nTdbpU4wIsSDZ8WCPXNJOG9KPI.jpg", url:"https://themoviedb.org/person/15900"}}, {tmdbId:"136990", properties:{imdbId:"0835425", name:"Amy Stryker", url:"https://themoviedb.org/person/136990"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"82702", properties:{bornIn:"Gary, Indiana, USA", imdbId:"0001391", born:date('1958-08-29'), name:"Michael Jackson", bio:"Michael Joseph Jackson (August 29, 1958 – June 25, 2009) was an American recording artist, dancer, singer-songwriter, musician, and philanthropist.  Referred to as the King of Pop, Jackson is recognized as the most successful entertainer of all time by Guinness World Records.  His contribution to music, dance, and fashion, along with a much-publicized personal life, made him a global figure in popular culture for over four decades...", died:date('2009-06-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tWHyifIcUEc1E0ufIZq5JqyeF6R.jpg", url:"https://themoviedb.org/person/82702"}}, {tmdbId:"92899", properties:{bornIn:"Atlanta, Georgia, USA", imdbId:"0751369", born:date('1918-09-15'), name:"Nipsey Russell", bio:"From Wikipedia, the free encyclopedia\n\nJulius \"Nipsey\" Russell (September 15, 1918 – October 2, 2005) was an American comedian, best known today for his appearances as a guest panelist on game shows from the 1960s through the 1990s, especially Match Game, Password, Hollywood Squares, To Tell the Truth and Pyramid.  His appearances were distinguished in part by the short, humorous poems he would recite during the broadcast...", died:date('2005-10-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oYA1JBxrfajLksjG6nGh0ExEPA0.jpg", url:"https://themoviedb.org/person/92899"}}, {tmdbId:"583424", properties:{imdbId:"2163821", name:"Ted Ross", url:"https://themoviedb.org/person/583424"}}, {tmdbId:"3171", properties:{bornIn:"Budzanów, Austria-Hungary", imdbId:"0833448", born:date('1901-09-17'), name:"Lee Strasberg", bio:"​From Wikipedia, the free encyclopedia.   \n\nLee Strasberg (November 17, 1901 – February 17, 1982) was an American actor, director and acting teacher.   He cofounded, with directors Harold Clurman and Cheryl Crawford, the Group Theatre in 1931, which was hailed as \"America's first true theatrical collective\".   In 1951, he became director of the non-profit Actors Studio, in New York City, considered \"the nation's most prestigious acting school\"...", died:date('1982-02-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/niSM7ejzddgaTcxjgJMYEFCr9Y2.jpg", url:"https://themoviedb.org/person/3171"}}, {tmdbId:"37995", properties:{bornIn:"Long Beach, California, USA", imdbId:"0000137", born:date('1956-11-20'), name:"Bo Derek", bio:"Bo Derek is an American film actress and model. \n\nAn aspiring model, 16-year-old Bo Derek was introduced to actor/director/cinematographer John Derek in 1971.  Just as he'd done with previous \"protegés\" Ursula Andress and Linda Evans, Derek literally molded her into a highly desirable superstar.  In 1974, the 48-year-old Derek capped his makeover by marrying the 18-year-old Bo.  In her first film, the Jaws rip-off Orca, Bo showed up long enough to have her lovely leg chewed off by a killer whale...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vvUbn3ihXT8UjTcxPQwf0niUPJw.jpg", url:"https://themoviedb.org/person/37995"}}, {tmdbId:"7171", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0000004", born:date('1949-01-24'), name:"John Belushi", bio:"From Wikipedia, the free encyclopedia\n\nJohn Adam Belushi (January 24, 1949 – March 5, 1982) was an American comedian, actor, and musician best known as one of the original cast members of the NBC sketch comedy show Saturday Night Live and for his roles in the films National Lampoon's Animal House and The Blues Brothers.  He was the older brother of Jim Belushi. \n\nDescription above from the Wikipedia article John Belushi, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1982-03-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9VmVattp8htG3GJnkPsPuhVIca2.jpg", url:"https://themoviedb.org/person/7171"}}, {tmdbId:"22553", properties:{bornIn:"Frankfurt, Germany", imdbId:"0086806", born:date('1948-09-07'), name:"Susan Blakely", bio:"From Wikipedia, the free encyclopedia.   Susan Blakely is an American film actress and actress, who has mainly played supporting roles.  She is best known for her leading role in the 1976 miniseries Rich Man, Poor Man, for which she received a Golden Globe Award for Best Actress – Television Series Drama.  Blakely also has appeared in films including The Towering Inferno, Report to the Commissioner, Capone, The Concorde . . .  Airport '79, and Over the Top...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xfl66Wa4LYdcRwoXd9ojn8V55eF.jpg", url:"https://themoviedb.org/person/22553"}}, {tmdbId:"10205", properties:{bornIn:"Manhattan, New York City, New York, USA", imdbId:"0000244", born:date('1949-10-08'), name:"Sigourney Weaver", bio:"Sigourney Weaver (born October 8, 1949) is an American actress best known for her role as Ellen Ripley in the Alien film series, a role for which she has received worldwide recognition.  Other notable roles include the Ghostbusters films, Gorillas in the Mist, The Ice Storm, Working Girl, Death and the Maiden, Prayers for Bobby and Avatar...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/flfhep27iBxseZIlxOMHt6zJFX1.jpg", url:"https://themoviedb.org/person/10205"}}, {tmdbId:"5048", properties:{bornIn:"West Irvine, Kentucky, USA", imdbId:"0001765", born:date('1926-07-14'), name:"Harry Dean Stanton", bio:"Harry Dean Stanton (July 14, 1926 - September 15, 2017) was an American actor, musician, and singer.  Stanton's career spanned over fifty years, which saw him star in such films as Cool Hand Luke, Kelly's Heroes, Dillinger, Alien, Repo Man, The Last Temptation of Christ, Wild at Heart, The Green Mile and The Pledge.  In the late 2000s, he played a recurring role in the HBO television series Big Love.   Mr.  Stanton died on September 15, 2017.  He was 91...", died:date('2017-09-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/197UiLVdxPOv8196sqmUpJzOQB5.jpg", url:"https://themoviedb.org/person/5048"}}, {tmdbId:"80927", properties:{bornIn:"Port Washington, New York, U.S.", imdbId:"0658336", born:date('1945-06-16'), name:"Leland Palmer", bio:"From Wikipedia, the free encyclopedia. \n\nLeland Palmer (born June 16, 1945, Port Washington, New York) is an American actress, dancer, and singer who has appeared on stage, in motion pictures, and on television.  She appeared on Broadway in Bajour, A Joyful Noise, Hello, Dolly!, Applause, and Pippin.  Palmer received two Tony Award nominations: in 1967 for featured actress in a musical (Miss Jimmie in A Joyful Noise), and in 1973 for actress in a musical (Fastrada in Pippin). \n\nHer U. S...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/YJKhptxL9dHdWY7nVKsAA9fe5r.jpg", url:"https://themoviedb.org/person/80927"}}, {tmdbId:"80928", properties:{bornIn:"Seattle, Washington, U.S.", imdbId:"0718237", born:date('1949-11-10'), name:"Ann Reinking", bio:"From Wikipedia, the free encyclopedia. \n\nAnn Reinking (born November 10, 1949) is an American actress, dancer, and choreographer.  She has worked extensively in musical theatre, both as a dancer and choreographer, as well as appearing in film. \n\nDescription above from the Wikipedia article Ann Reinking, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sFZqoa0A1Ge8jVnDQhUs5jWgjAE.jpg", url:"https://themoviedb.org/person/80928"}}, {tmdbId:"21561", properties:{bornIn:"Glendale, California, USA", imdbId:"0001513", born:date('1947-12-31'), name:"Tim Matheson", bio:"From Wikipedia, the free encyclopedia\n\nTim Matheson (born Timothy Lewis Matthieson; December 31, 1947) is an American actor, director and producer.  He is perhaps best known for his portrayal of the smooth-talking Eric 'Otter' Stratton in the 1978 comedy Animal House and has had a variety of other well-known roles, including providing the voice of the lead character in the cartoon TV program Jonny Quest...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/trZ4QaDidCOPNy7HK9cYnmKHkg9.jpg", url:"https://themoviedb.org/person/21561"}}, {tmdbId:"58003", properties:{bornIn:"Santa Barbara, California, USA", imdbId:"0098733", born:date('1954-04-22'), name:"Joseph Bottoms", bio:"An actor, known for The Dove (1974), The Black Hole (1979) and Santa Barbara (1984).  Brother of Sam Bottoms, Ben Bottoms and Timothy Bottoms...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lsEFX7phliV1M3WFC8onFGlLX5W.jpg", url:"https://themoviedb.org/person/58003"}}, {tmdbId:"81544", properties:{bornIn:"Pueblo, Colorado, USA", imdbId:"0719738", born:date('1966-06-19'), name:"Kelly Reno", bio:"From Wikipedia, the free encyclopedia\n\nKelly Reno, born (June 19, 1966) to cattle ranchers in Pueblo, Colorado is a former juvenile actor who was cast in the role of Alec Ramsey, the young boy who is marooned on a deserted island along with a horse, in The Black Stallion (based on the novel by Walter Farley) at age 13. \n\nReno also appeared in the 1983 film adaptation of The Black Stallion Returns, alongside Vincent Spano...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/42wZeE1tEvr9StI3JYLNJvlJF8A.jpg", url:"https://themoviedb.org/person/81544"}}, {tmdbId:"87825", properties:{bornIn:"Baltimore, Maryland, USA", imdbId:"0615617", born:date('1889-10-14'), name:"Clarence Muse", bio:"From Wikipedia, the free encyclopedia\n\nClarence Muse (October 14, 1889 – October 13, 1979) was an American actor, screenwriter, director, composer, and lawyer.  He was inducted in the Black Filmmakers Hall of Fame in 1973.  Muse was the first Negro to \"star\" in a film.  He acted for more than sixty years appearing in more than 150 movies...", died:date('1979-10-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9k5D1LxHU7C0MhErSiY1uVt0mm8.jpg", url:"https://themoviedb.org/person/87825"}}, {tmdbId:"10254", properties:{bornIn:"Zurich, Switzerland", imdbId:"0000728", born:date('1930-09-08'), name:"Mario Adorf", bio:"Mario Adorf (born 8 September 1930) is an Italian-German film and stage actor, best known for his lead role in the 1978 film The Tin Drum...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dCusK8NWuHzrI3Abf8nDNfe3DfA.jpg", url:"https://themoviedb.org/person/10254"}}, {tmdbId:"10255", properties:{bornIn:"Templin, Germany", imdbId:"0935190", born:date('1944-01-22'), name:"Angela Winkler", bio:"From Wikipedia, the free encyclopedia. \n\nAngela Winkler (born 22 January 1944) is a German actress. \n\nDescription above from the Wikipedia article Angela Winkler, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zFLhmkw38SeQAijXcKtZPtDkWwO.jpg", url:"https://themoviedb.org/person/10255"}}, {tmdbId:"10256", properties:{bornIn:"Lausanne, Switzerland", imdbId:"0000908", born:date('1966-09-09'), name:"David Bennent", bio:"From Wikipedia, the free encyclopedia\n\nDavid Bennent (born September 9, 1966) is a Swiss actor. \n\nHe was born in Lausanne, Switzerland.  His parents are actor Heinz Bennent and former dancer Diane Mansart.  His sister Anne is also an actress. \n\nHe has lived in Germany and France as well as Switzerland and speaks fluent French and English. \n\nWhen he was 12 he starred in The Tin Drum, which caused much controversy because David was allegedly shown in sex scenes with an adult...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cy4DNG2FIrEGdoiKwhYt1KC6pqz.jpg", url:"https://themoviedb.org/person/10256"}}, {tmdbId:"10257", properties:{bornIn:"Berlin, Germany", imdbId:"0856918", born:date('1954-01-19'), name:"Katharina Thalbach", bio:"Katharina Thalbach entstammt einer Theaterfamilie, ihr Vater war der Regisseur Benno Besson, ihre Mutter war die Schauspielerin Sabine Thalbach...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/anr7QnKmnG4hucA3PVmYySd8xxH.jpg", url:"https://themoviedb.org/person/10257"}}, {tmdbId:"27770", properties:{bornIn:"Philadelphia - Pennsylvania - USA", imdbId:"0160550", born:date('1955-12-02'), name:"Dennis Christopher", bio:"From Wikipedia, the free encyclopedia. \n\nDennis Christopher (born Dennis Carrelli on December 2, 1955) is an American actor.  He was born in Philadelphia, Pennsylvania.  He is known for playing Dave Stoller in Breaking Away and tragic film buff psychopath Eric Binford in Fade to Black. \n\nHis Golden Globe-nominated breakthrough role was as Dave Stohler in the coming-of-age classic Breaking Away (1979)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/izYfd86mlERW5EtyNna4aKMXKOW.jpg", url:"https://themoviedb.org/person/27770"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"6065", properties:{bornIn:"Houston, Texas, USA", imdbId:"0000598", born:date('1954-04-09'), name:"Dennis Quaid", bio:"Dennis William Quaid (born April 9, 1954) is an American actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/J2kSTVummEBXczpFavGmEpxlBA.jpg", url:"https://themoviedb.org/person/6065"}}, {tmdbId:"41256", properties:{bornIn:"Halifax, Nova Scotia, Canada", imdbId:"0385543", born:date('1948-07-21'), name:"Art Hindle", bio:"From Wikipedia, the free encyclopedia\n\nArthur Hindle (born July 21, 1948) is a Canadian actor and director. \n\nHindle was born in Halifax.  His family moved to Toronto while he was a child.  Although shy as a youngster, he grew to be a rebellious and independent teenager.  This led him to travel, mostly via hitchhiking, while picking up odd jobs and meeting people from varied walks of life. \n\nBy the time he was 21, he was a father, a stockbroker and an amateur photographer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lhoh2KGtDfSjiIJSKT9ymTypPCf.jpg", url:"https://themoviedb.org/person/41256"}}, {tmdbId:"33479", properties:{bornIn:"Halifax, Nova Scotia, Canada", imdbId:"0065798", born:date('1921-11-26'), name:"Henry Beckman", died:date('2008-06-17'), url:"https://themoviedb.org/person/33479"}}, {tmdbId:"55648", properties:{bornIn:"Brooklyn, New York City, New York, USA", imdbId:"0449404", born:date('1947-12-16'), name:"Robert Kerman", bio:"Robert Kerman is an American former film actor and adult film performer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gu3ZW2hzWzEdrv4ghbil2NlUz0M.jpg", url:"https://themoviedb.org/person/55648"}}, {tmdbId:"55652", properties:{imdbId:"0161889", name:"Francesca Ciardi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/64nUFHTxPXutoTtxq3GrwLoCcDT.jpg", url:"https://themoviedb.org/person/55652"}}, {tmdbId:"55649", properties:{imdbId:"0685194", name:"Perry Pirkanen", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hs2nBKpa4OwKEahMFkhTxtJdfa4.jpg", url:"https://themoviedb.org/person/55649"}}, {tmdbId:"55650", properties:{bornIn:"Montevideo, Uruguay", imdbId:"0053230", born:date('1956-07-28'), name:"Luca Barbareschi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fREMNtoQqVWLA8hG3JbqD9ALxvP.jpg", url:"https://themoviedb.org/person/55650"}}, {tmdbId:"76546", properties:{bornIn:"Staten Island, New York, U.S.", imdbId:"0005401", born:date('1970-04-13'), name:"Ricky Schroder", bio:"Ricky Schroder, Jr.  (born April 13, 1970) is an American Golden Globe Award-winning actor and film director. \n\nHe made is film in The Champ before starring on Silver Spoons.  He has continued acting as an adult, notably on Lonesome Dove and NYPD Blue...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/g1PRiuBhWPE4Yn9BynfoPFb4tKD.jpg", url:"https://themoviedb.org/person/76546"}}, {tmdbId:"18794", properties:{bornIn:"London, Ontario, Canada", imdbId:"0625075", born:date('1950-03-16'), name:"Kate Nelligan", bio:"Patricia Colleen \"Kate\" Nelligan (born March 16, 1951) is a Canadian stage, film and television actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4GpQvniLNMKF19qtHMb0tBBgNce.jpg", url:"https://themoviedb.org/person/18794"}}, {tmdbId:"74640", properties:{imdbId:"0555758", name:"Carolyn Marz", url:"https://themoviedb.org/person/74640"}}, {tmdbId:"1076182", properties:{imdbId:"0206345", name:"Baybi Day", url:"https://themoviedb.org/person/1076182"}}, {tmdbId:"2492107", properties:{name:"Harry Schultz", url:"https://themoviedb.org/person/2492107"}}, {tmdbId:"9927", properties:{bornIn:"Berlin, Germany", imdbId:"0530594", born:date('1936-04-08'), name:"Klaus Löwitsch", bio:"Klaus Löwitsch (8 April 1936 – 3 December 2002) was a German actor, best known in Germany for his starring role in the television detective series Peter Strohm.  He appeared in several films directed by Rainer Werner Fassbinder, beginning with Pioneers in Ingolstadt (1971) and notably including World on a Wire (1973) and The Marriage of Maria Braun (1979).  His English language films include Cross of Iron (1977), The Odessa File (1974), Firefox (1982) and Fassbinder's Despair (1978)...", died:date('2002-12-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tmOmeWgdAvhM3xMD87h3KxX2K44.jpg", url:"https://themoviedb.org/person/9927"}}, {tmdbId:"9928", properties:{bornIn:"Peking, China", imdbId:"0221527", born:date('1922-12-28'), name:"Ivan Desny", died:date('2002-04-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cf2mRMgj9XpWEHfBqRRc6h88vDz.jpg", url:"https://themoviedb.org/person/9928"}}, {tmdbId:"9930", properties:{bornIn:"Leipzig, Germany", imdbId:"0880187", born:date('1919-05-16'), name:"Gisela Uhlen", died:date('2007-01-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hyJZOH7iWQOkXVr1KtSq1cGkSkp.jpg", url:"https://themoviedb.org/person/9930"}}, {tmdbId:"8261", properties:{bornIn:"Abbott, Texas, USA", imdbId:"0005268", born:date('1933-04-30'), name:"Willie Nelson", bio:"Willie Hugh Nelson (born April 30, 1933) is an American country singer-songwriter, author, poet, actor, and activist.  Nelson was one of the main figures of the Outlaw Movement, a subgenre of Country music that developed between the end of 1960s and early 1980s.  The critical success of the albums Shotgun Willie, Phases and Stages, and the commercial success of Red Headed Stranger made Nelson one of the most recognized artists in country music...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fWhRNZUSkEaq5jvCpNZf7YqZEU5.jpg", url:"https://themoviedb.org/person/8261"}}, {tmdbId:"14320", properties:{bornIn:"Perth, Perthshire, Scotland, UK", imdbId:"0857806", born:date('1946-06-12'), name:"Jack Thibeau", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cKJ2ck7NfxY7KXS9jZInnluKMig.jpg", url:"https://themoviedb.org/person/14320"}}, {tmdbId:"38085", properties:{bornIn:"Mount Vernon, New York, USA", imdbId:"0001574", born:date('1955-04-24'), name:"Michael O'Keefe", bio:"Michael Raymond O'Keefe is an American film and television actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wQsTL887RWvAJljzLhiPP52kjec.jpg", url:"https://themoviedb.org/person/38085"}}, {tmdbId:"9259", properties:{bornIn:"New York City, New York", imdbId:"0675484", born:date('1955-05-05'), name:"Lisa Jane Persky", bio:"​From Wikipedia, the free encyclopedia.   \n\nLisa Jane Persky (born May 5, 1955) is an American actress. \n\nPersky was born in New York City, New York, the daughter of Jane Holley (née Wilson) and Mort Persky.  She grew up in New York's Greenwich Village and attended the High School of Art and Design. \n\nShe debuted as Robert Duvall's daughter in The Great Santini and went on to act in such movies as American Pop, The Big Easy, When Harry Met Sally. . ...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bURqr4uN7kKyC3kcVae8OQlAQjR.jpg", url:"https://themoviedb.org/person/9259"}}, {tmdbId:"14820", properties:{bornIn:"York, England, UK", imdbId:"0916001", born:date('1906-07-02'), name:"Alan Webb", bio:"From Wikipedia, the free encyclopedia. \n\nAlan Webb (2 July 1906 - 22 June 1982) was an English stage and film actor...", died:date('1982-06-22'), url:"https://themoviedb.org/person/14820"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"200298", properties:{bornIn:"Pasadena, California, USA", born:date('1953-11-16'), name:"Susan Kiger", bio:"Susan Lynn Kiger (born November 16, 1953 in Pasadena, California) is an American model and actress.  Her centerfold was photographed by Pompeo Posar and Ken Marcus.  In addition, she appeared in the cover of Playboy three times: March 1977, November 1977, April 1978. \n\nAfter she was in Playboy, she went on to star in several films, including the sex comedy H. O. T. S.  alongside fellow Playmate Pamela Bryant, and eventual Playboy model KC Winkler, and Angels Revenge...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bsUgKBBYn23EMSOd6b0FarMaOIG.jpg", url:"https://themoviedb.org/person/200298"}}, {tmdbId:"60152", properties:{bornIn:" Santa Monica, California, USA", imdbId:"0518739", born:date('1957-01-01'), name:"Lisa London", bio:"Lisa London is an accomplished actress &amp; singer who hails from Palm Springs CA USA.  Lisa has basked in the limelight since a teen.  In high school she was a Bob Hope Classic Girl and had her own weekly column in the Desert Sun newspaper and interviewed local and international entertainment &amp; sports celebrities for CBS radio.  Lisa has starred in many films &amp; TV roles and produced critically acclaimed theater productions she also acted in...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/usx86aa47muVpEDZv48foShbhrW.jpg", url:"https://themoviedb.org/person/60152"}}, {tmdbId:"228958", properties:{bornIn:"Indianapolis, Indiana[", born:date('1959-02-08'), name:"Pamela Jean Bryant", bio:"Pamela Jean Bryant (born February 8, 1959, in Indianapolis, Indiana; died December 4, 2010) was an American model and actress.  She was Playboy magazine's Playmate of the Month for its April 1978 issue.  Her centerfold was photographed by Richard Fegley. \n\nBryant first appeared in Playboy in the September 1977 pictorial \"The Girls of the Big Ten\".  (She was attending Indiana University at the time).  She went on to have an extensive acting career, appearing in films such as H. O. T. S...", died:date('2010-12-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/43sR31ONqcjYhLkFr4LtVTm8OKy.jpg", url:"https://themoviedb.org/person/228958"}}, {tmdbId:"228959", properties:{imdbId:"2774445", name:"Kimberly Cameron", url:"https://themoviedb.org/person/228959"}}, {tmdbId:"4515", properties:{bornIn:"Rowayton, Connecticut, USA", imdbId:"0001852", born:date('1951-12-01'), name:"Treat Williams", bio:"A Screen Actors Guild Award-nominated American actor who has appeared on film, stage and television.  From 2002 to 2006, he was the star of the television series Everwood...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bQ3zECF7TRpF8cwCmxqn4Qv2zHD.jpg", url:"https://themoviedb.org/person/4515"}}, {tmdbId:"66094", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0325390", born:date('1951-10-19'), name:"Annie Golden", bio:"​From Wikipedia, the free encyclopedia.   \n\nAnnie Golden (born October 19, 1951) is an American actress and singer. \n\nBorn in Brooklyn, New York, Golden began her career as the lead singer of The Shirts (which headlined CBGB's in the late seventies).  During the early 90s she performed as part of the duo Golden Carillo with Frank Carillo.  They released 3 albums, Fire in Newtown, Toxic Emotion, and Back for More.  She then returned to The Shirts.  Since then she has performed solo and with a band...", url:"https://themoviedb.org/person/66094"}}, {tmdbId:"47456", properties:{bornIn:"New York City", imdbId:"0399530", born:date('1951-03-14'), name:"Season Hubley", bio:"From Wikipedia, the free encyclopedia. \n\nSeason Hubley (born March 14, 1951) is an American actress. \n\nDescription above from the Wikipedia article Season Hubley , licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/g0DhUCqvlRwftlKZDUuPswJNDjR.jpg", url:"https://themoviedb.org/person/47456"}}, {tmdbId:"11512", properties:{bornIn:"Washington, District of Columbia, USA", imdbId:"0001334", born:date('1945-03-07'), name:"John Heard", bio:"John Heard (1946-2017) established himself as an up-and-coming actor in the late 1970s through his performances in the Joan Micklin Silver films Between the Lines (1978) and Chilly Scenes of Winter (1979).  He appeared in a number of successful movies, including Heart Beat (1980), Cutter's Way (1981), Cat People (1982), C. H. U. D.  (1984), and After Hours (1985), and later became known for playing the father, Peter McCallister, the Home Alone films...", died:date('2017-07-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bWu50bW6wF4zZUaOgbuRApYjm7D.jpg", url:"https://themoviedb.org/person/11512"}}, {tmdbId:"20899", properties:{bornIn:"New York City, New York, USA", imdbId:"0726200", born:date('1947-04-11'), name:"Peter Riegert", bio:"Peter Riegert is an American stage and screen actor, writer, and director, best known for his portrayal of crooked New Jersey State Assemblyman Ronald Zellman on the HBO television series \"The Sopranos\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yPgaRZBMVy9eoNNuiPIm0wzG9sD.jpg", url:"https://themoviedb.org/person/20899"}}, {tmdbId:"12521", properties:{bornIn:"Brooklyn, NY", imdbId:"0573299", born:date('1932-07-02'), name:"Kenneth McMillan", died:date('1989-01-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iGRcxZOLPMCsgg06kYW1aVfxGqi.jpg", url:"https://themoviedb.org/person/12521"}}, {tmdbId:"20163", properties:{bornIn:"Cambridge, Massachusetts, USA", imdbId:"0508844", born:date('1933-05-21'), name:"Richard Libertini", died:date('2016-01-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tpkGxVaGzAiY8kWmCWyeV2bjeNB.jpg", url:"https://themoviedb.org/person/20163"}}, {tmdbId:"1217271", properties:{bornIn:"Pensacola - Florida - USA", imdbId:"0244684", born:date('1936-06-30'), name:"Nancy Dussault", url:"https://themoviedb.org/person/1217271"}}, {tmdbId:"67773", properties:{bornIn:"Waco, Texas, USA", imdbId:"0000188", born:date('1945-08-14'), name:"Steve Martin", bio:"Stephen Glenn \"Steve\" Martin (born August 14, 1945) is an American actor, comedian, writer, playwright, producer, musician and composer. \n\nMartin was born in Waco, Texas, and raised in Southern California, where his early influences were working at Disneyland and Knott's Berry Farm and working magic and comedy acts at these and other smaller venues in the area...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d0KthX8hVWU9BxTCG1QUO8FURRm.jpg", url:"https://themoviedb.org/person/67773"}}, {tmdbId:"40389", properties:{bornIn:"Queens, New York, USA", imdbId:"0001613", born:date('1948-02-28'), name:"Bernadette Peters", bio:"Bernadette Peters is an American actress, singer and children's book author; she has starred in musical theatre, films and television, as well as performing in solo concerts and recordings...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kfb3VyXiHcUIzCWL7SevU9kgEAj.jpg", url:"https://themoviedb.org/person/40389"}}, {tmdbId:"52030", properties:{bornIn:" Los Angeles, California, USA", imdbId:"0010818", born:date('1950-10-11'), name:"Catlin Adams", url:"https://themoviedb.org/person/52030"}}, {tmdbId:"52031", properties:{bornIn:"Charleston, South Carolina, USA", imdbId:"0455028", born:date('1932-12-25'), name:"Mabel King", died:date('1999-11-09'), url:"https://themoviedb.org/person/52031"}}, {tmdbId:"5064", properties:{bornIn:"Summit, New Jersey, USA", imdbId:"0000658", born:date('1949-06-22'), name:"Meryl Streep", bio:"Mary Louise \"Meryl\" Streep (born June 22, 1949) is an American actress who has worked in theatre, television and film.  She is widely regarded as one of the most talented and respected actresses of the modern era.  Streep made her professional stage debut in 1971's The Playboy of Seville, before her screen debut in the television movie The Deadliest Season in 1977.  In that same year, she made her film debut with Julia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xqL5IJxV0fDeD3OfkS3eWqwJoGV.jpg", url:"https://themoviedb.org/person/5064"}}, {tmdbId:"13724", properties:{bornIn:"Boston - Massachusetts - USA", imdbId:"0000737", born:date('1939-10-28'), name:"Jane Alexander", bio:"From Wikipedia, the free encyclopedia. \n\nJane Alexander (born October 28, 1939) is an American actress, author, and former director of the National Endowment for the Arts.  Although perhaps best known for playing the female lead in The Great White Hope on both stage and screen, Alexander has played a wide array of roles in both theater and film, and has committed herself to a variety of charitable causes...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bwplL1jFpXyLJptsmKp7Nuok9ix.jpg", url:"https://themoviedb.org/person/13724"}}, {tmdbId:"71241", properties:{bornIn:"Rye, New York, USA", imdbId:"0377888", born:date('1971-05-25'), name:"Justin Henry", bio:"From Wikipedia, the free encyclopedia. \n\nJustin Henry (born May 25, 1971; Rye, New York) is a former child actor, who since 2000 has been a new media business professional.  He appeared in the 1979 film Kramer vs.  Kramer, his first role, in a performance that earned him a nomination for Academy Award for Best Supporting Actor, the youngest actor to ever be nominated in any category.  The performance later earned him a spot (#80) on VH1's 100 Greatest Kid Stars...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9wp0WZZSbXzYqmQVwsFfnfDpAT6.jpg", url:"https://themoviedb.org/person/71241"}}, {tmdbId:"2882", properties:{bornIn:"New York City, New York, USA", imdbId:"0000178", born:date('1965-01-22'), name:"Diane Lane", bio:"Diane Lane (born January 22, 1965) is an American film actress.  Born and raised in New York City, Lane made her screen debut at the age of 13 in George Roy Hill's 1979 film A Little Romance, starring opposite Sir Laurence Olivier.  Soon after, she was featured on the cover of Time magazine.  She has since appeared in several notable films, including the 2002 film Unfaithful, which earned her Academy Award, Golden Globes and Screen Actors Guild Award nominations...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tUPAKAtstqeQrAKhkQge9jV7Owz.jpg", url:"https://themoviedb.org/person/2882"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"87215", properties:{bornIn:"France", imdbId:"0076400", born:date('1964-03-06'), name:"Thelonious Bernard", bio:"From Wikipedia, the free encyclopedia\n\nThelonious Bernard (born 6 March 1964) is a French actor.  In 1979, he starred opposite Laurence Olivier and Diane Lane in A Little Romance, a film about a romance between two young teenagers in France.  His only other film role was in 1981's Allons z'enfants, a French film. \n\nBernard decided he did not wish to remain in the film industry, and went back to his studies. \n\nToday he is a dentist in Nantes and leads a very normal life with his wife &amp; children...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9KgU0ShBM3Kc68J9UvwELDC7LUn.jpg", url:"https://themoviedb.org/person/87215"}}, {tmdbId:"545", properties:{bornIn:"New York City, New York, USA", imdbId:"0058089", born:date('1962-09-05'), name:"Matthew Barry", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4e6T3cZL6V8clMj9mTGQndQ9OsB.jpg", url:"https://themoviedb.org/person/545"}}, {tmdbId:"18339", properties:{bornIn:"Bucharest, Romania", imdbId:"0493691", born:date('1938-10-06'), name:"Veronica Lazar", died:date('2014-05-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dnKrX2ICWB4Pe4EsbCpA8O6Nard.jpg", url:"https://themoviedb.org/person/18339"}}, {tmdbId:"58401", properties:{bornIn:"Sydney, Australia", imdbId:"0760394", born:date('1957-01-01'), name:"Joanne Samuel", bio:"From Wikipedia, the free encyclopedia.  Joanne Samuel (born 1957 in Camperdown, Sydney, Australia) is an actress who remains best known for her role as the screen wife of Mel Gibson in the 1979 film Mad Max. \n\nPrior to her appearance in the film, Samuel had made guest appearances in police procedurals Matlock Police and Homicide.  She was then a regular cast member in television soap operas Class of '74, The Sullivans and The Young Doctors...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yPfmjEFndWZNaCnLpWimjQOkPB9.jpg", url:"https://themoviedb.org/person/58401"}}, {tmdbId:"26060", properties:{bornIn:"Kashmir, India", imdbId:"0117412", born:date('1947-05-18'), name:"Hugh Keays-Byrne", bio:"From Wikipedia, the free encyclopedia.  Hugh Keays-Byrne (born 18th May 1947 in Kashmir, India) is an English character actor who moved to Australia in 1973.  He is well-known in Australia as a television and film actor.  Outside of Australia, he is best known for his role as a gang leader in the late 1970s Mad Max and, in the 2000s, for his role in the science fiction television series Farscape.  He has been cast in George Miller's live action film adaptation of the Justice League...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rkDIHG6gZnFwOJjDwnhFV81YmqL.jpg", url:"https://themoviedb.org/person/26060"}}, {tmdbId:"45211", properties:{bornIn:"Lake Munmorah, New South Wales, Australia", imdbId:"0001950", born:date('1951-12-26'), name:"Steve Bisley", bio:"From Wikipedia, the free encyclopedia.   Steve Bisley (born 26 December 1951 at Lake Munmorah, New South Wales) is an Australian film and television actor, who attended the National Institute of Dramatic Art (NIDA). \n\nDescription above from the Wikipedia article Steve Bisley, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9KE407G6yIItUDlduj9MWAz392o.jpg", url:"https://themoviedb.org/person/45211"}}, {tmdbId:"78416", properties:{bornIn:"Santa Monica, California, U.S.", imdbId:"0761190", born:date('1935-03-05'), name:"Paul Sand", bio:"​From Wikipedia, the free encyclopedia\n\nPaul Sand (born March 5, 1935) is an American comedic actor. \n\nDescription above from the Wikipedia article Paul Sand, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h6PTXhdiAH94dSrs5UutrzZZhH6.jpg", url:"https://themoviedb.org/person/78416"}}, {tmdbId:"156806", properties:{born:date('1930-11-15'), name:"Whitman Mayo", bio:"​From Wikipedia, the free encyclopedia\n\nWhitman B.  Mayo (November 15, 1930 – May 22, 2001) was an American actor best known for his character Grady Wilson on the 1970s television sitcom Sanford and Son. \n\nNoted for portraying characters older than his actual age, Mayo was in his 40s when he played Grady on Sanford and Son. \n\nDescription above from the Wikipedia article Whitman Mayo, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2001-05-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/b1tTY5UHKZ2zhZXPwq46fDmEnsE.jpg", url:"https://themoviedb.org/person/156806"}}, {tmdbId:"10447", properties:{bornIn:"Mill Valley, California, U.S", imdbId:"0000446", born:date('1961-11-22'), name:"Mariel Hemingway", bio:"From Wikipedia, the free encyclopedia\n\nMariel Hadley Hemingway (born November 22, 1961) is an American actress and writer. \n\nDescription above from the Wikipedia article Mariel Hemingway, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9pSpX0oBlnSaF3JFxBd3oEl1KSG.jpg", url:"https://themoviedb.org/person/10447"}}, {tmdbId:"108890", properties:{bornIn:" Toronto, Ontario, Canada ", imdbId:"0040539", born:date('1942-12-18'), name:"Harvey Atkin", died:date('2017-07-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4mPAx1XpJwPAeaVOaabM1AHSapZ.jpg", url:"https://themoviedb.org/person/108890"}}, {tmdbId:"102760", properties:{imdbId:"0528367", born:date('1959-06-29'), name:"Kate Lynch", bio:"From Wikipedia, the free encyclopedia. \n\nKate Lynch (born June 29, 1959) is a Genie Award-winning actress whose career spans four decades.  In 1980 she won the Genie Award for Best Performance by an Actress in a Leading Role for Meatballs.  She was nominated for the same award in 1988 for her role in Taking Care though she did not win on that occasion. \n\nDescription above from the Wikipedia article Kate Lynch, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/102760"}}, {tmdbId:"119775", properties:{imdbId:"0051994", born:date('1955-09-20'), name:"Russ Banham", url:"https://themoviedb.org/person/119775"}}, {tmdbId:"68455", properties:{bornIn:"Tulsa, Oklahoma, U.S.", imdbId:"0625456", born:date('1934-07-10'), name:"Jerry Nelson", bio:"From Wikipedia, the free encyclopedia\n\nJerry Nelson (born July 10, 1934) is an American Muppet puppeteer, known for his wide range of characters, singing abilities, and his frequent partnership with Richard Hunt. \n\nDescription above from the Wikipedia article Jerry Nelson, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2012-08-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/daCTg4kX7AjrWj54qmRH2Po3znW.jpg", url:"https://themoviedb.org/person/68455"}}, {tmdbId:"68456", properties:{imdbId:"0402611", born:date('1951-08-16'), name:"Richard Hunt", died:date('1992-01-07'), url:"https://themoviedb.org/person/68456"}}, {tmdbId:"1733", properties:{bornIn:"Omaha, Nebraska, USA", imdbId:"0000560", born:date('1941-02-08'), name:"Nick Nolte", bio:"Nick Nolte is an American actor, film producer, voice artist, comedian, and former model.  He won the Golden Globe Award for Best Actor – Motion Picture Drama and was nominated for the Academy Award for Best Actor for the 1991 film The Prince of Tides.  He went on to receive Academy Award nominations for Affliction and Warrior. \n\nNolte was a model in the late 1960s and early 1970s...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jpYzFBi6zfn8CHVaXmqgiOTas4V.jpg", url:"https://themoviedb.org/person/1733"}}, {tmdbId:"104872", properties:{bornIn:"Lubbock, Texas, USA", imdbId:"0205067", born:date('1942-01-21'), name:"Mac Davis", bio:"From Wikipedia, the free encyclopedia. \n\nScott \"Mac\" Davis (born January 21, 1942), is a country music singer and songwriter originally from Lubbock, Texas who has enjoyed much pop music crossover success.  He became one of the most successful country singers of the 1970s and 1980s.  He is also an actor. \n\nDescription above from the Wikipedia article Mac Davis, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/104872"}}, {tmdbId:"63936", properties:{bornIn:"Montréal, Québec, Canada", imdbId:"0352731", born:date('1948-05-26'), name:"Dayle Haddon", bio:"Dayle Haddon is a Canadian model and actress, presently known for promoting anti-aging products manufactured by L'Oréal.  Additionally, she is credited as author of Ageless Beauty: A Woman's Guide to Lifelong Beauty and Well-Being...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wUiuju4aFcUw3zQHx3JaIISGa7v.jpg", url:"https://themoviedb.org/person/63936"}}, {tmdbId:"49505", properties:{bornIn:"Paris, France", imdbId:"0867718", born:date('1938-01-07'), name:"Roland Topor", bio:"Roland Topor was a French illustrator, cartoonist, comics artist, painter, novelist, playwright, film and TV writer, filmmaker and actor, known for the surreal nature of his work.  He gained notoriety as one of the home cartoonists of the subversive French magazine Hara-Kiri, renamed later Charlie-Hebdo.  \n\nRoland Topor wrote the novel The Tenant (Le Locataire chimérique, 1964), which was adapted to film by Roman Polanski in 1976...", died:date('1997-04-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uuIWPTbW2DvSpG8MXfOtoIdMkLV.jpg", url:"https://themoviedb.org/person/49505"}}, {tmdbId:"4512", properties:{bornIn:"Vernal, Utah, USA", imdbId:"0000249", born:date('1947-04-18'), name:"James Woods", bio:"James Howard Woods (born April 18, 1947) is an American film, stage and television actor.  Woods is known for starring in critically acclaimed films such as Once Upon a Time in America, Salvador, Nixon, Ghosts of Mississippi, Casino, Hercules, and in the television legal drama Shark.  He has won two Emmy Awards, and has gained two Academy Award nominations...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tLH7mpH4KqkWL5VgjueTbewGsfK.jpg", url:"https://themoviedb.org/person/4512"}}, {tmdbId:"72658", properties:{imdbId:"0780546", born:date('1952-07-15'), name:"Franklyn Seales", died:date('1990-05-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q05W5niteild9kcYik9hoHLncWg.jpg", url:"https://themoviedb.org/person/72658"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"12836", properties:{bornIn:"San Diego, California, USA", imdbId:"0001101", born:date('1947-12-29'), name:"Ted Danson", bio:"From Wikipedia, the free encyclopedia. \n\nEdward Bridge “Ted” Danson III (born December 29, 1947) is an American actor best known for his role as central character Sam Malone in the sitcom Cheers, and his role as Dr.  John Becker on the series Becker.  He also plays a recurring role on Larry David's HBO sitcom Curb Your Enthusiasm, starred alongside Glenn Close in legal drama Damages and is now a regular on the HBO comedy series Bored to Death...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j8q9UbJgfgyqpunhWNJ5BqfF7SZ.jpg", url:"https://themoviedb.org/person/12836"}}, {tmdbId:"1200840", properties:{imdbId:"0469617", name:"Michael Eric Kramer", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2JluTOzrs0zYVWGnTaFbD3zhhl7.jpg", url:"https://themoviedb.org/person/1200840"}}, {tmdbId:"554192", properties:{imdbId:"0525041", name:"Pamela Ludwig", url:"https://themoviedb.org/person/554192"}}, {tmdbId:"2876", properties:{bornIn:"New Rochelle, New York, USA", imdbId:"0000369", born:date('1964-02-18'), name:"Matt Dillon", bio:"Matthew Raymond \"Matt\" Dillon (born February 18, 1964) is an American actor and film director.  He began acting in the late 1970s, gaining fame as a teenage idol during the 1980s. \n\nDescription above from the Wikipedia article Matt Dillon, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wVoSUexYH79igPgxIXKWRlV2uBk.jpg", url:"https://themoviedb.org/person/2876"}}, {tmdbId:"147119", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0001759", born:date('1962-10-18'), name:"Vincent Spano", bio:"Vincent M.  Spano (born October 18, 1962) is an American actor. \n\nSpano was born in Brooklyn, New York to Italian American parents.  In 1976, he made his stage debut in a production of The Shadow Box at Long Wharf Theatre and Broadway.  His film debut was in 1979's The Double McGuffin...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9AihuKDx06IvR9nxdSH7FyXEw47.jpg", url:"https://themoviedb.org/person/147119"}}, {tmdbId:"58240", properties:{bornIn:"Los Angeles, California", imdbId:"0049853", born:date('1963-04-04'), name:"A. Michael Baldwin", bio:"From Wikipedia, the free encyclopedia.   A.  Michael Baldwin (born April 4, 1963) is an American actor, producer, and screenwriter. \n\nHe is the son of animator Gerard Baldwin, who worked on classic shows such as The Jetsons, Rocky and Bullwinkle, George of the Jungle and many more. [1] Michael Baldwin began acting in his teens and was also a member of the Teenage Drama Workshop at California State University.  He is best known for his roles as Mike in the Phantasm films (except for Phantasm II)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gGOWFGVokrYR6u36CKrb24OwdQT.jpg", url:"https://themoviedb.org/person/58240"}}, {tmdbId:"58241", properties:{imdbId:"0861332", born:date('1952-05-24'), name:"Bill Thornbury", bio:"A lover of music and scenic arts since his childhood, Bill Thornbury graduated from the California State University at Fresno with a teaching degree in music and nowadays teaches in Northern California...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2NxCvwkJdpEuZ995uE3PPzoW93X.jpg", url:"https://themoviedb.org/person/58241"}}, {tmdbId:"97939", properties:{bornIn:"Long Beach, California, USA", imdbId:"0052410", born:date('1945-09-29'), name:"Reggie Bannister", bio:"From Wikipedia, the free encyclopedia.   \n\nReginald Horace \"Reggie\" Bannister (born September 29, 1945) is an American actor, musician and director, best-known for his role as Reggie, an ex-ice cream man, in director Don Coscarelli's Phantasm series\n\nDescription above from the Wikipedia article Reggie Bannister, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gvhAdg4OdEFalVIcK553zNvwwaQ.jpg", url:"https://themoviedb.org/person/97939"}}, {tmdbId:"58243", properties:{imdbId:"0504477", name:"Kathy Lester", bio:"Kathy Lester is very well-known in the Phantasm world due to her erotic performance as \"The Lady in Lavender\", The Tall Man's female alter ego in Phantasm (1979).  She portrayed a very mysterious femme-fatale, who could be as seductive as dangerous, becoming a favorite of many fans.  Fifteen years later, she returned to the Phantasm universe in Phantasm III: Lord of the Dead (1994), making a cameo appearance as a sexy nurse during the opening sequence...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ySprO1AURFOEyVhPYc7zzeEvru.jpg", url:"https://themoviedb.org/person/58243"}}, {tmdbId:"65301", properties:{bornIn:"Islington, London, England, UK", imdbId:"0200057", born:date('1958-10-25'), name:"Phil Daniels", bio:"From Wikipedia, the free encyclopedia. \n\nPhilip \"Phil\" Daniels (born 25 October 1958, Islington) is an English actor, most noted for film roles as \"cockneys\" such as Jimmy in Quadrophenia, Richards in Scum, Stewart in The Class of Miss MacMichael, Mark in Meantime, Kevin Wicks in EastEnders, DCS Frank Patterson in New Tricks and Edward Kitchener \"Ted\" Trotter, or Grandad, in the prequel Only Fools and Horses spin-off, Rock &amp; Chips in 2010 until 2011...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6yNFNjo3cWEcuAUrl0CNQnAnQ5M.jpg", url:"https://themoviedb.org/person/65301"}}, {tmdbId:"65302", properties:{bornIn:"Henley on Thames, Oxfordshire, England, UK", imdbId:"0038650", born:date('1960-02-19'), name:"Leslie Ash", bio:"Leslie Ash is an English actress.  She is best known for her role as Deborah Burton in the BBC sitcom Men Behaving Badly, Vanessa Lytton in the BBC medical drama Holby City from 2009 to 2010 and Karen Buckley in the ITV drama Where the Heart Is from 2000 to 2003.  Her book My Life Behaving Badly: The Autobiography was published in 2007.  Ash appeared in BBC Radio 4's comic radio series, Vent (2007), alongside Neil Pearson, Fiona Allen and Josie Lawrence...", url:"https://themoviedb.org/person/65302"}}, {tmdbId:"65303", properties:{bornIn:"Melton Mowbray, Leicestershire, England, UK", imdbId:"0935047", born:date('1961-01-01'), name:"Mark Wingett", url:"https://themoviedb.org/person/65303"}}, {tmdbId:"98831", properties:{imdbId:"0371441", born:date('1911-01-09'), name:"Dick Haynes", died:date('1980-11-25'), url:"https://themoviedb.org/person/98831"}}, {tmdbId:"1729744", properties:{name:"Matthew Tobin", url:"https://themoviedb.org/person/1729744"}}, {tmdbId:"1352413", properties:{bornIn:"Washington, District of Columbia, USA", born:date('1932-11-13'), name:"J.A. Preston", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6snJo3CAPBrZz3WrPA620w2lepD.jpg", url:"https://themoviedb.org/person/1352413"}}, {tmdbId:"45473", properties:{bornIn:" Liverpool, England", imdbId:"0567135", born:date('1939-11-18'), name:"Ian McCulloch", bio:"Ian McCulloch (born 18 November 1939) is a Scottish actor of stage, film, and television. \n\nMcCulloch is perhaps best known for his role as Greg Preston in the post-apocalyptic 1975–77 TV series Survivors and for his work in European genre cinema. \n\nMcCulloch debuted in the second episode, \"Genesis\", of Survivors and went on to appear regularly throughout the series...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yX6zZaG1W0aJJpsZqNOIG2QYQU3.jpg", url:"https://themoviedb.org/person/45473"}}, {tmdbId:"52060", properties:{bornIn:"Italy", imdbId:"0217493", born:date('1957-09-12'), name:"Alexandra Delli Colli", bio:"Attractive and seductive looking blonde Italian actress who is well known to fans of 1980's European horror cinema as the leading lady in two key cult films of the period.  She co-starred in the ultra-bloody Zombie Holocaust (1980) aka.  Zombi 3 directed by Marino Girolami.  Two years later she again co-starred in the serial killer tale The New York Ripper (1982) directed by Italian gore master Lucio Fulci...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i85Ju6w8nmtgM6uWX2Hb7BhlKth.jpg", url:"https://themoviedb.org/person/52060"}}, {tmdbId:"52061", properties:{bornIn:"Biloxi, Mississippi, United States", imdbId:"0118076", born:date('1954-01-01'), name:"Sherry Buchanan", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wzGAR50na3gFhu0V2yd6DeSGPwz.jpg", url:"https://themoviedb.org/person/52061"}}, {tmdbId:"52062", properties:{imdbId:"0641933", name:"Peter O'Neal", url:"https://themoviedb.org/person/52062"}}, {tmdbId:"75634", properties:{imdbId:"0479458", born:date('1944-05-24'), name:"Patti LaBelle", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5x7Rs4vRWbHK2LJU764z3vnnwUF.jpg", url:"https://themoviedb.org/person/75634"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"98569", properties:{bornIn:"Bellerose, New York, U.S.", imdbId:"0887701", born:date('1957-10-17'), name:"Vincent Van Patten", bio:"​From Wikipedia, the free encyclopedia.   \n\nVincent Van Patten (born October 17, 1957) is an American actor and former tour professional tennis player. \n\nDescription above from the Wikipedia article Vincent Van Patten, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gERUs5qeSQidcudH1sC4Uv2OpWe.jpg", url:"https://themoviedb.org/person/98569"}}, {tmdbId:"15661", properties:{bornIn:"Burbank, California, USA", imdbId:"0397212", born:date('1959-04-20'), name:"Clint Howard", bio:"An American film and television actor.  He is a character actor with numerous brief appearances on television and films, usually noted for his unusual appearance.  He has played many bit parts in movies directed by his brother, actor-turned-director Ron Howard.  He is also the uncle of actress Bryce Dallas Howard. \n\nDescription above from the Wikipedia article Clint Howard, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6tugb8rz1hj8tYlSaSmUBD741fw.jpg", url:"https://themoviedb.org/person/15661"}}, {tmdbId:"39568", properties:{bornIn:"Bloomfield Hills, Michigan, USA", imdbId:"0949477", born:date('1955-07-28'), name:"Dey Young", url:"https://themoviedb.org/person/39568"}}, {tmdbId:"73931", properties:{bornIn:"Honolulu, Hawaii, USA", imdbId:"0000541", born:date('1945-12-01'), name:"Bette Midler", bio:"Bette Midler (born December 1, 1945) is an American singer, songwriter, actress, comedian, and film producer.  Born in Honolulu, Hawaii, Midler began her professional career in several Off-Off-Broadway plays, prior to her engagements in Fiddler on the Roof and Salvation on Broadway in the late 1960s.  She came to prominence in 1970 when she began singing in the Continental Baths, a local gay bathhouse where she managed to build up a core following...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ylGKhmHKUa1fBvvbA0kvdn3eFNn.jpg", url:"https://themoviedb.org/person/73931"}}, {tmdbId:"109746", properties:{bornIn:" Tokyo, Japan", imdbId:"0945280", born:date('1932-09-10'), name:"Yasuo Yamada", died:date('1995-03-19'), url:"https://themoviedb.org/person/109746"}}, {tmdbId:"109747", properties:{imdbId:"0557968", name:"Eiko Masuyama", url:"https://themoviedb.org/person/109747"}}, {tmdbId:"82508", properties:{bornIn:" Tokyo, Japan", imdbId:"0462017", born:date('1933-01-11'), name:"Kiyoshi Kobayashi", bio:"is a Japanese actor, voice actor and narrator from Tokyo.  He is attached to the Tokyo Actor's Consumer's Cooperative Society.  He is a graduate of the Tokyo Metropolitan Koishikawa High School and the arts department of Nihon University. \n\nHe is best known for his roles in Yōkai Ningen Bem (as Bem), the Lupin III series (as Daisuke Jigen), the Droopy cartoons (as the Wolf) and Shazzan (as Shazzan)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qG191adRhhI71NiF8ikRFz3hadF.jpg", url:"https://themoviedb.org/person/82508"}}, {tmdbId:"1222049", properties:{bornIn:"Yamanashi Prefecture, Japan", imdbId:"0409296", born:date('1940-11-30'), name:"Makio Inoue", bio:"From Wikipedia:\n\nMakio Inoue (井上 真樹夫 Inoue Makio, born November 30, 1940) is a Japanese voice actor.  He began voice acting in the 1960s, landing small roles in Astroboy,  and was the actor of choice for deep-voiced, serious males in the  1970s.  These days, he rarely takes on new roles (but he does have a  cameo in Samurai Champloo, playing Mariya Enshirou in episodes 24-26)...", died:date('2019-11-29'), url:"https://themoviedb.org/person/1222049"}}, {tmdbId:"7673", properties:{bornIn:"New York City, New York, USA", imdbId:"0000889", born:date('1948-03-25'), name:"Bonnie Bedelia", bio:"Bonnie Bedelia (born March 25, 1948) is an American actress, known for her supporting roles in Die Hard and Presumed Innocent as well as on Parenthood...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/10JhoIaKHQGG0DNbQECTI4gHNn9.jpg", url:"https://themoviedb.org/person/7673"}}, {tmdbId:"5538", properties:{bornIn:"Hackney, London, England, UK", imdbId:"0935653", born:date('1957-02-19'), name:"Ray Winstone", bio:"An British film and television actor.  He is mostly known for his \"tough guy\" roles, beginning with that of Carlin in the 1979 film Scum and as Will Scarlet in the cult television adventure series Robin of Sherwood.  He has also become well known as a voice over actor.  More recently he has branched out into film production.  His film résumé includes Cold Mountain, King Arthur, The Proposition, The Departed, Beowulf, Indiana Jones and the Kingdom of the Crystal Skull and Edge of Darkness...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tycHZh88ZF0Uv81ZJV3xuTXSrQP.jpg", url:"https://themoviedb.org/person/5538"}}, {tmdbId:"93847", properties:{bornIn:"Croydon, Surrey, England, UK", imdbId:"0285795", born:date('1952-08-01'), name:"Mick Ford", bio:"From Wikipedia, the free encyclopedia. \n\nMick Ford (born 1 August 1952; in Croydon, Surrey, England, United Kingdom) is a British actor, screenwriter and playwright, best known for his portrayal of intellectual convict Archer in the cinema version of Scum.  He also played Chico Barnes in the TV series based on the Dick Francis racing thrillers...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/595XhmvAkkQNLDTtH0mRtFKogGk.jpg", url:"https://themoviedb.org/person/93847"}}, {tmdbId:"93848", properties:{bornIn:"London, England, UK", imdbId:"0278747", born:date('1960-03-12'), name:"Julian Firth", bio:"Julian Firth (born 8 January 1961) is a British actor, best known for his roles in the film Scum and the television series Cadfael. \n\nFirth has enjoyed a consistent acting career in the theatre as well as in television productions, including Jeeves and Wooster, The Bill, The Young Indiana Jones Chronicles and Margaret...", url:"https://themoviedb.org/person/93848"}}, {tmdbId:"1105086", properties:{imdbId:"0089884", name:"John Blundell", url:"https://themoviedb.org/person/1105086"}}, {tmdbId:"28079", properties:{bornIn:"Leningrad, Russian SFSR, Soviet Union", imdbId:"0293981", born:date('1934-12-08'), name:"Alisa Freyndlikh", bio:"Alisa Brunovna Freindlich (Russian: Али́са Бру́новна Фре́йндлих, born 8 December 1934 in Leningrad, Soviet Union) is a Soviet and Russian actress, People's Artist of the Soviet Union. \n\nAlisa Freindlich was born into the family of Bruno Freindlich, a prominent actor and People's Artist of the Soviet Union.  She is of German and Russian ancestry.  Her father and paternal relatives were ethnic Germans living in Russia for more than a century...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/psK6Vqmz2e6DAjxfZb9HJuBbtWd.jpg", url:"https://themoviedb.org/person/28079"}}, {tmdbId:"28078", properties:{bornIn:"Rostov-na-Donu, Rostovskaya oblast, RSFSR, USSR [now Russia]", imdbId:"0435289", born:date('1946-07-23'), name:"Aleksandr Kaydanovskiy", died:date('1995-12-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yHYfkxQu3GVKxx5ibFmEom8qAS6.jpg", url:"https://themoviedb.org/person/28078"}}, {tmdbId:"1750", properties:{bornIn:"Atlanta, Georgia, USA", imdbId:"0001420", born:date('1920-01-20'), name:"DeForest Kelley", bio:"From Wikipedia, the free encyclopedia\n\nJackson DeForest Kelley  (January 20, 1920 – June 11, 1999) was an American actor, screenwriter,  poet and singer known for his iconic roles in Westerns and as Dr.  Leonard \"Bones\" McCoy of the USS Enterprise in the television and film series Star Trek. \n\nKelley was delivered by his uncle at his parents' home in Atlanta, the son of Clora (née Casey) and Ernest David Kelley, who was a Baptist minister of Irish and Southern ancestry...", died:date('1999-06-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nR6jNh0tkVmygVUnkaveKF7Pj1E.jpg", url:"https://themoviedb.org/person/1750"}}, {tmdbId:"1751", properties:{bornIn:"Vancouver, British Columbia, Canada", imdbId:"0001150", born:date('1920-03-03'), name:"James Doohan", bio:"From Wikipedia, the free encyclopedia.   James Montgomery \"Jimmy\" Doohan ( March 3, 1920 – July 20, 2005) was a Canadian character and voice actor best known for his role as Montgomery \"Scotty\" Scott in the television and film series Star Trek.  Doohan's characterization of the Scottish Chief Engineer of the Starship Enterprise was one of the most recognizable elements in the Star Trek franchise, for which he also made several contributions behind the scenes...", died:date('2005-07-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x1ZXt0747378bSfvgXwBJF12Wo4.jpg", url:"https://themoviedb.org/person/1751"}}, {tmdbId:"68884", properties:{imdbId:"0172014", born:date('1931-01-01'), name:"John Collin", died:date('1987-02-25'), url:"https://themoviedb.org/person/68884"}}, {tmdbId:"12818", properties:{imdbId:"0161398", born:date('1930-05-11'), name:"Tony Church", died:date('2008-03-25'), url:"https://themoviedb.org/person/12818"}}, {tmdbId:"2630", properties:{bornIn:"Berlin - Germany", imdbId:"0000176", born:date('1959-01-24'), name:"Nastassja Kinski", bio:"Nastassja Kinski (born January 24, 1961, Nastassja Aglaia Nakszynski ) is a German-born American-based actress who has appeared in more than 60 films.   Daughter of German actor Klaus Kinski. \n\nHer starring roles include her Golden Globe Award-winning portrayal of the title character in Tess and her roles in two erotic films (Stay As You Are and Cat People), as well as parts in Wim Wenders' films The Wrong Move; Paris, Texas; and Faraway, So Close!...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tPhBfSrLrmAe0qlfUr7sKhuSOeu.jpg", url:"https://themoviedb.org/person/2630"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"1317005", properties:{imdbId:"0060862", name:"Brigid Erin Bates", url:"https://themoviedb.org/person/1317005"}}, {tmdbId:"2453", properties:{bornIn:"Newport, Arkansas, USA", imdbId:"0005460", born:date('1953-02-08'), name:"Mary Steenburgen", bio:"Mary Nell Steenburgen (born February 8, 1953) is an American actress.  She was most successful for playing the role of Lynda Dummar in Jonathan Demme's Melvin and Howard, which earned her an Academy Award and a Golden Globe...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yJhfuqS3yXW7kLSyvRU6n3b35mq.jpg", url:"https://themoviedb.org/person/2453"}}, {tmdbId:"5605", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0002070", born:date('1920-09-01'), name:"Richard Farnsworth", bio:"From Wikipedia, the free encyclopedia\n\nRichard W.  Farnsworth (September 1, 1920 – October 6, 2000) was an American actor and stuntman.  His film career began in 1937; however, he achieved his greatest success for his performances in The Grey Fox (1982) and The Straight Story (1999), for which he received a nomination for an Academy Award for Best Actor. \n\nDescription above from the Wikipedia article Richard Farnsworth, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2000-10-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lh0xeO6CUXg7ZzqXd54rwjxjoQY.jpg", url:"https://themoviedb.org/person/5605"}}, {tmdbId:"52063", properties:{bornIn:"Alessandria, Egitto", imdbId:"0166986", born:date('1951-07-16'), name:"Al Cliver", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lQTPaWTC4yjVDzMGvBj9Nl2k73w.jpg", url:"https://themoviedb.org/person/52063"}}, {tmdbId:"3002", properties:{imdbId:"0906261", born:date('1954-10-31'), name:"Ken Wahl", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bKvHfbOWOC6TX4hsyU5UAilVaim.jpg", url:"https://themoviedb.org/person/3002"}}, {tmdbId:"3004", properties:{bornIn:"LA, California, USA", imdbId:"0295440", born:date('1958-03-15'), name:"John Friedrich", bio:"John Friedrich (b.  March 15, 1958, California) is an American film actor.   A talented and enigmatic character actor of the 1970s and early 1980s, John Friedrich is probably best known for his portrayal of Joey Capra in The Wanderers (1979), Philip Kaufman's film adaption of Richard Price's novel.   A familiar face on television throughout the '70s, Friedrich made guest starring appearances on the police drama series, Baretta, and The Streets of San Francisco...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j8zAiXfRYH1179wFYvxqLsHAfGm.jpg", url:"https://themoviedb.org/person/3004"}}, {tmdbId:"650", properties:{bornIn:"Carrollton, Illinois, USA", imdbId:"0000261", born:date('1951-10-05'), name:"Karen Allen", bio:"From Wikipedia, the free encyclopedia. \n\nKaren Jane Allen (born October 5, 1951) is an American actress best known for her role as Marion Ravenwood in Raiders of the Lost Ark (1981) and Indiana Jones and the Kingdom of the Crystal Skull (2008). [1] Allen has also had roles in films including National Lampoon's Animal House (1978), The Wanderers (1979), Cruising (1980), Starman (1984), Scrooged (1988), The Sandlot (1993), and Poster Boy (2004)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hj1RlVnieS4jp9fKmiSirjKhA0a.jpg", url:"https://themoviedb.org/person/650"}}, {tmdbId:"3006", properties:{bornIn:"Springfield, New Jersey, USA", imdbId:"0435677", born:date('1950-08-29'), name:"Toni Kalem", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/m5PpCV3QTpTNR9KdKsnQnZo2Iof.jpg", url:"https://themoviedb.org/person/3006"}}, {tmdbId:"110589", properties:{bornIn:"Newark, New Jersey, USA ", imdbId:"0320091", born:date('1926-06-03'), name:"Allen Ginsberg", bio:"Irwin Allen Ginsberg (June 3, 1926 – April 5, 1997) was an American poet.  He is considered to be one of the leading figures of both the Beat Generation during the 1950s and the counterculture that soon followed.  He vigorously opposed militarism, economic materialism and sexual repression and was known as embodying various aspects of this counterculture, such as his views on drugs, hostility to bureaucracy and openness to Eastern religions...", died:date('1997-04-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w7qQvokS1lp7IRgefiJdALaaiIi.jpg", url:"https://themoviedb.org/person/110589"}}, {tmdbId:"36409", properties:{bornIn:"Memphis, Tennessee, USA", imdbId:"1453281", born:date('1949-02-04'), name:"Michael Beck", bio:"​From Wikipedia, the free encyclopedia.   \n\nJohn Michael Beck Taylor (born February 4, 1949), commonly known as Michael Beck, is an American actor, perhaps best known for his role as Swan in the 1979 film, The Warriors. \n\nDescription above from the Wikipedia article Michael Beck, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xWZtbKcLcerfXdprxnA67WluqBz.jpg", url:"https://themoviedb.org/person/36409"}}, {tmdbId:"1736", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0001664", born:date('1953-12-31'), name:"James Remar", bio:"James Remar (born December 31, 1953) is an American actor.  He has appeared in movies, video games, and TV shows.  He is perhaps best known as Richard, the on-off tycoon boyfriend of Kim Cattrall's character in Sex and the City, as Ajax in The Warriors, as the homicidal maniac Albert Ganz in the 1982 comedy/thriller 48 Hrs. , Dutch Shultz in The Cotton Club, Lord Raiden in Mortal Kombat: Annihilation and more recently as Harry Morgan in Dexter...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kSRfynHJO2VVFyzT4tsoTPwfHKL.jpg", url:"https://themoviedb.org/person/1736"}}, {tmdbId:"69564", properties:{imdbId:"0942352", born:date('1957-06-15'), name:"Dorsey Wright", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nRr24krQFYm8k3RU9WRE2BSp9VY.jpg", url:"https://themoviedb.org/person/69564"}}, {tmdbId:"1080553", properties:{imdbId:"0878784", name:"Brian Tyler", url:"https://themoviedb.org/person/1080553"}}, {tmdbId:"80135", properties:{bornIn:"Riga - Latvia", imdbId:"0017377", born:date('1942-10-13'), name:"Rutanya Alda", bio:"Rutanya Alda (born October 13, 1942) is a Latvian-American actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qSNz7ZRKkHCdwyShapgm8aqibx.jpg", url:"https://themoviedb.org/person/80135"}}, {tmdbId:"28413", properties:{bornIn:"Sharon, Pennsylvania, USA", imdbId:"0034492", born:date('1943-10-27'), name:"Carmen Argenziano", bio:"Carmen Argenziano (October 27, 1943 - February 9, 2019) was an American actor and producer...", died:date('2019-02-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aiHWJmsVn7iWuohSg6lzF23XYVr.jpg", url:"https://themoviedb.org/person/28413"}}, {tmdbId:"1081854", properties:{imdbId:"0488303", name:"Kirsten Larkin", url:"https://themoviedb.org/person/1081854"}}, {tmdbId:"2550", properties:{bornIn:"New York City, New York, USA", imdbId:"0794890", born:date('1956-11-16'), name:"Dan Shor", bio:"From Wikipedia, the free encyclopedia\n\nDaniel Shor (born November 16, 1956) is an American veteran actor, director, writer and teacher with a career spanning over 30 years. \n\nDescription above from the Wikipedia article Dan Shor, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xsdNaTwcqogHFKBipxtiAZJFAlX.jpg", url:"https://themoviedb.org/person/2550"}}, {tmdbId:"9932", properties:{bornIn:"Berlin, Germany", imdbId:"0483945", born:date('1930-01-21'), name:"Günter Lamprecht", bio:"From Wikipedia, the free encyclopedia\n\nGünter Lamprecht (born 21 January 1930) is a German actor, known for his leading role in the Fassbinder miniseries Berlin Alexanderplatz (1980) and as a ship captain in the epic war film Das Boot (1981)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mQO1g8rpR9QtJfjirhAMbDqOdOz.jpg", url:"https://themoviedb.org/person/9932"}}, {tmdbId:"38140", properties:{imdbId:"0391485", born:date('1918-08-04'), name:"Claus Holm", died:date('1996-09-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/peTyr3F1QNl4hBBagFIZhkQZ2HU.jpg", url:"https://themoviedb.org/person/38140"}}, {tmdbId:"49175", properties:{imdbId:"0118268", born:date('1937-12-26'), name:"Franz Buchrieser", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ga156qrb6x7kupHBojE1jNHGRsw.jpg", url:"https://themoviedb.org/person/49175"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"29069", properties:{bornIn:"Nottingham, Nottinghamshire, England, UK", imdbId:"0419785", born:date('1935-10-29'), name:"Michael Jayston", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xDbJvDU1rlI0PiwmaDvqQCSeKWT.jpg", url:"https://themoviedb.org/person/29069"}}, {tmdbId:"12536", properties:{bornIn:"Sydney, New South Wales, Australia", imdbId:"0860233", born:date('1940-08-31'), name:"Jack Thompson", bio:"​From Wikipedia, the free encyclopedia. \n\nJack Thompson, AM (born 31 August 1940) is an Australian actor and one of the major figures of Australian cinema.  He was educated at the University of Queensland, before embarking on his acting career.  In 2002, he was made an honorary member of the Australian Cinematographers Society (ACS)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aqIViuyx2RBfUHeIvyEbxNYKLXg.jpg", url:"https://themoviedb.org/person/12536"}}, {tmdbId:"29092", properties:{bornIn:"Sydney, New South Wales, Australia", imdbId:"0000986", born:date('1947-06-23'), name:"Bryan Brown", bio:"Bryan Neathway Brown (born 23 June 1947) is an Australian actor. \n\nEarly life\n\nBrown was born in Sydney, the son of John (Jack) Brown and Molly Brown, a house cleaner and pianist in the early days of the Langshaw School of Ballet.  He grew up in the south-western Sydney suburb of Bankstown, and began working at AMP as an actuarial student.  He started to act in amateur theatre performances, where he discovered a passion for acting...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x0NqVqpJSET0oVdJxbbwwd7hrFA.jpg", url:"https://themoviedb.org/person/29092"}}, {tmdbId:"67274", properties:{bornIn:"Sevierville, Tennessee, USA", imdbId:"0000573", born:date('1946-01-19'), name:"Dolly Parton", bio:"Dolly Rebecca Parton (born January 19, 1946) is an American singer-songwriter, author, multi-instrumentalist, actress and philanthropist, best known for her work in country music. \n\nShe is one of the most successful female country artists, garnering the title of \"The Queen of Country Music,\" with 25 number-one singles.  and a record forty-one top-10 country albums...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uLFZgrfSqAxLj3UM7dkTPdlCKkc.jpg", url:"https://themoviedb.org/person/67274"}}, {tmdbId:"12850", properties:{bornIn:"Austin, Texas, USA", imdbId:"0001056", born:date('1932-01-03'), name:"Dabney Coleman", bio:"Dabney Wharton Coleman (born January 3, 1932) is an American actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wfYLBxqwRUB15FaDGEolL0lgSA5.jpg", url:"https://themoviedb.org/person/12850"}}, {tmdbId:"14414", properties:{bornIn:"Harlem, New York City, New York, USA", imdbId:"0000717", born:date('1947-04-17'), name:"Kareem Abdul-Jabbar", bio:"Kareem Abdul-Jabbar (born Ferdinand Lewis Alcindor Jr. ; April 16, 1947) is an American former professional basketball player who played 20 seasons in the National Basketball Association (NBA) for the Milwaukee Bucks and the Los Angeles Lakers.  NBA coach Pat Riley and players Isiah Thomas and Julius Erving have called him the greatest basketball player of all time...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cEXdttZo0jukQakV4vwscbexbeO.jpg", url:"https://themoviedb.org/person/14414"}}, {tmdbId:"14415", properties:{bornIn:"Cincinnati, Ohio, USA", imdbId:"0353546", born:date('1955-06-15'), name:"Julie Hagerty", bio:"Julie Hagerty (born June 15, 1955) is an American actress and former model. \n\nDescription above from the Wikipedia article Julie Hagerty, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bQZ0bcFNyE4a3GDNfYMmfO7eWMl.jpg", url:"https://themoviedb.org/person/14415"}}, {tmdbId:"38711", properties:{bornIn:"New York City - New York - USA", imdbId:"0726939", born:date('1952-10-02'), name:"Robin Riker", bio:"A third-generation actress on both sides of her family, Robin was born in a trunk.  Actually, she was almost born in a taxi on the Brooklyn Bridge but traffic was good that day so she made her actual debut at Beth Israel hospital in New York City.  Her parents, both professional actors, owned and ran legit theaters, in Aspen, Atlanta and Syracuse and had a very practical philosophy: \"If you have children, use them...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/805H8McgVzm2zzd5MSeF7MmUqET.jpg", url:"https://themoviedb.org/person/38711"}}, {tmdbId:"227", properties:{bornIn:"Washington, District of Columbia, USA", imdbId:"0000458", born:date('1950-03-20'), name:"William Hurt", bio:"William Hurt is an American stage, film and television actor, trained at the Juilliard School, Manhattan, New York, USA.  For his leading role in the feature film \"Kiss of the Spider Woman\", he received an Academy Award in 1986, followed by 3 more nominations for roles in the movies \"Children of a Lesser God\", \"Broadcast News\", and \"A History of Violence\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j3mjmuHLBW4XQSw53C8Sh0Lh3ZQ.jpg", url:"https://themoviedb.org/person/227"}}, {tmdbId:"7571", properties:{bornIn:"Washington, D.C., USA", imdbId:"0001974", born:date('1946-04-23'), name:"Blair Brown", bio:"Blair Brown is an American stage, film and television actress.  She was the leading actress in feature films such as \"Altered States\", \"Continental Divide\" and \"Strapless\", and she played the title character in the television comedy-drama \"The Days and Nights of Molly Dodd\", as well as supporting characters Nina Sharp \"Fringe\" and Judy King \"Orange Is the New Black\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hnVybZLBUJNr93gCTwgRQRCkjpm.jpg", url:"https://themoviedb.org/person/7571"}}, {tmdbId:"98102", properties:{bornIn:"Columbia, Missouri, USA", imdbId:"0810342", born:date('1933-03-24'), name:"William Smith", bio:"William Smith is an American film and television actor who has appeared in more than 300 feature films and television productions, best known for playing Anthony Falconetti on the TV mini series \"Rich Man, Poor Man\".  He holds a BA from Syracuse and an MA in Russian Studies from UCLA. \n\nBorn in Columbia, Missouri, Smith began his acting career at the age of eight in 1942; he entered films as a child actor in such films as The Ghost of Frankenstein, The Song of Bernadette and Meet Me in St.  Louis...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gFtKkMnReK7qTgVnToqP8VqbEFb.jpg", url:"https://themoviedb.org/person/98102"}}, {tmdbId:"27587", properties:{imdbId:"0933443", name:"George Wilson", url:"https://themoviedb.org/person/27587"}}, {tmdbId:"22355", properties:{imdbId:"0853171", name:"Sharon Taylor", bio:"Sharon Taylor is an actress...", url:"https://themoviedb.org/person/22355"}}, {tmdbId:"22356", properties:{bornIn:"San Diego, California, USA", imdbId:"0668699", born:date('1953-03-30'), name:"J. Stephen Peace", bio:"J.  Stephen Peace, auch Steve Peace ist ein US-amerikanischer Politiker, Schauspieler, Drehbuchautor und Filmproduzent...", url:"https://themoviedb.org/person/22356"}}, {tmdbId:"9207", properties:{bornIn:"San Diego, California, USA", imdbId:"0000622", born:date('1957-03-20'), name:"Theresa Russell", bio:"Theresa Russell (born March 20, 1957) is an American actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gMu7VNZVDhjcyuDzAKU9prUwAFY.jpg", url:"https://themoviedb.org/person/9207"}}, {tmdbId:"656", properties:{bornIn:"Ealing, London, England, UK", imdbId:"0001186", born:date('1922-05-31'), name:"Denholm Elliott", bio:"​From Wikipedia, the free encyclopedia.    Denholm Mitchell Elliott, CBE (31 May 1922 – 6 October 1992) was an English actor of stage and screen, with over 120 major film and TV credits.  In the nineteen eighties, he won the BAFTA Award for Best Actor in a Supporting Role in three consecutive years.  Description above from the Wikipedia article Denholm  Elliott, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1992-10-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/knXXDDYckQ0yQsR0OFbEL8O8RtF.jpg", url:"https://themoviedb.org/person/656"}}, {tmdbId:"19576", properties:{bornIn:"Manhattan, New York City, New York, USA", imdbId:"0001796", born:date('1951-06-13'), name:"Richard Thomas", bio:"From Wikipedia, the free encyclopedia. \n\nRichard Earl Thomas (born June 13, 1951 height 5' 8½\" (1,74 m)) is an American actor, best known as budding author John-Boy Walton in the CBS drama The Waltons.  During his career, Thomas won an Emmy Award, and received nominations for another Emmy Award and two Golden Globe Awards. \n\nDuring his career, Thomas won an Emmy Award, and received nominations for another Emmy Award and two Golden Globe Awards...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yLV41csipJfb7qF135vD4Wu7VQH.jpg", url:"https://themoviedb.org/person/19576"}}, {tmdbId:"40621", properties:{bornIn:"Chatham, New York, U.S.", imdbId:"0213374", born:date('1954-12-10'), name:"Kristine DeBell", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dBKtruDKBCfO0lndcdetWvboJKA.jpg", url:"https://themoviedb.org/person/40621"}}, {tmdbId:"10134", properties:{bornIn:"Kobe, Japan", imdbId:"0538683", born:date('1933-12-10'), name:"Mako", bio:"Mako was born in Kobe, Japan, the son of noted children's book author and illustrator Taro Yashima.  His parents moved to the United States when he was a small child.  He joined them there after World War II, in 1949, joining the military in the 1950s.  He became a naturalized American citizen in 1956.  When Mako first joined his parents in the USA, he studied architecture.  During his military service, he discovered his theatrical talent, and trained at the Pasadena Community Playhouse...", died:date('2006-07-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qrt9yI5sEEemzVAEh8mtI6E68L0.jpg", url:"https://themoviedb.org/person/10134"}}, {tmdbId:"62036", properties:{bornIn:"Hollywood, California, USA", imdbId:"0001019", born:date('1954-03-24'), name:"Robert Carradine", bio:"Robert Reed Carradine (born March 24, 1954) is an American actor.  He is probably best known for portraying Lewis Skolnick in the successful Revenge of the Nerds series of comedy films and Sam McGuire on the Disney Channel sitcom Lizzie McGuire...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kQrhmy4WKxFP8Zz8H3CUosHrhPp.jpg", url:"https://themoviedb.org/person/62036"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"27516", properties:{bornIn:"Itasca, Illinois, USA", imdbId:"0223738", born:date('1954-06-07'), name:"Bobby Di Cicco", bio:"An American actor.  He has starred in several films since the 1970s, but has mostly been involved in television work such as The A-Team.  His early work includes the film 1941 by Steven Spielberg, in which he plays one of the main characters, 'Wally Stephens'.  He also had a part in Samuel Fullers movie, The Big Red One, where he played a young private in the first squad.  He was again a private in the 1990 comedy A Man Called Sarge...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n9EWsixiSdklExdUoX3zhnbyrmJ.jpg", url:"https://themoviedb.org/person/27516"}}, {tmdbId:"42740", properties:{bornIn:"Rye, New York, USA", imdbId:"0000803", born:date('1961-02-21'), name:"Christopher Atkins", bio:"Christopher Atkins (born Christopher Atkins Bomann on February 21, 1961) is an American actor, who became famous with his costarring debut role in the 1980 film The Blue Lagoon. \n\nDescription above from the Wikipedia article Christopher Atkins, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jLuwUuLaPaLYHUJ8pqzNwnr2IyG.jpg", url:"https://themoviedb.org/person/42740"}}, {tmdbId:"7173", properties:{bornIn:"Rochester, New York, USA", imdbId:"0130572", born:date('1907-12-25'), name:"Cab Calloway", bio:"From Wikipedia, the free encyclopedia\n\nCabell \"Cab\" Calloway III (December 25, 1907 – November 18, 1994) was an American jazz singer and bandleader. \n\nCalloway was a master of energetic scat singing and led one of the United States' most popular African American big bands from the start of the 1930s through the late 1940s...", died:date('1994-11-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hJYCgRoSPZ3dzqubti1mwjTkeeK.jpg", url:"https://themoviedb.org/person/7173"}}, {tmdbId:"42223", properties:{imdbId:"0026560", name:"Daniel Anderson", url:"https://themoviedb.org/person/42223"}}, {tmdbId:"3044", properties:{imdbId:"0063502", born:date('1931-01-13'), name:"Scott Beach", died:date('1996-02-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5Y3SbZeqOcw2w5KUUwnUjGoir6b.jpg", url:"https://themoviedb.org/person/3044"}}, {tmdbId:"569864", properties:{imdbId:"1313870", name:"Casey Carlson", url:"https://themoviedb.org/person/569864"}}, {tmdbId:"3198", properties:{bornIn:"Babylon, New York, U.S.", imdbId:"0001098", born:date('1921-11-22'), name:"Rodney Dangerfield", bio:"Rodney Dangerfield was an American comedian, and actor, known for the catchphrases \"I don't get no respect\" or \"I get no respect, I tell ya\" and his monologues on that theme.  He is also famous for his 1980s film roles, notably in Easy Money, Caddyshack and Back To School...", died:date('2004-10-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/szBltzA7vmkuv0V9SXACxSahxzo.jpg", url:"https://themoviedb.org/person/3198"}}, {tmdbId:"71146", properties:{bornIn:"Terryville, Connecticut, USA", imdbId:"0461095", born:date('1923-12-07'), name:"Ted Knight", bio:"Ted Knight (1923–1986) was an American actor best known for The Mary Tyler Moore Show, Too Close for Comfort, and Caddyshack...", died:date('1986-08-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/KQ1T3PD20c238GYwBQt6Ph7sFZ.jpg", url:"https://themoviedb.org/person/71146"}}, {tmdbId:"15184", properties:{bornIn:"Rennes, France", imdbId:"0102566", born:date('1928-10-28'), name:"Marcel Bozzuffi", died:date('1988-02-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/m1U5WSvkhfqJx00jPKvZXXuAk0p.jpg", url:"https://themoviedb.org/person/15184"}}, {tmdbId:"24629", properties:{bornIn:"Safi, French Protectorate of Morocco [now Morocco]", imdbId:"0301556", born:date('1922-10-27'), name:"Michel Galabru", bio:"Michel Galabru (born October 27, 1922) is a French actor...", died:date('2016-01-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/f6uvYIfc6cgQkn713rViFXIUCn0.jpg", url:"https://themoviedb.org/person/24629"}}, {tmdbId:"58026", properties:{bornIn:"London, England, UK", imdbId:"0767930", born:date('1955-07-18'), name:"Teresa Ann Savoy", bio:"From Wikipedia, the free encyclopedia. \n\nTeresa Ann Savoy was a British-born actress.  She has appeared in a number of Italian films...", died:date('2017-01-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ds1Ca21IpL9VgVGNdAw2jMCainJ.jpg", url:"https://themoviedb.org/person/58026"}}, {tmdbId:"27388", properties:{imdbId:"0543054", born:date('1944-12-13'), name:"Guido Mannari", died:date('1988-07-10'), url:"https://themoviedb.org/person/27388"}}, {tmdbId:"1047317", properties:{imdbId:"0801163", name:"Ray Simpson", url:"https://themoviedb.org/person/1047317"}}, {tmdbId:"1047313", properties:{imdbId:"0388317", name:"David Hodo", url:"https://themoviedb.org/person/1047313"}}, {tmdbId:"1047316", properties:{imdbId:"0741377", name:"Felipe Rose", url:"https://themoviedb.org/person/1047316"}}, {tmdbId:"1047315", properties:{imdbId:"0429063", name:"Randy Jones", url:"https://themoviedb.org/person/1047315"}}, {tmdbId:"41229", properties:{bornIn:"Reading, Pennsylvania, USA", imdbId:"0001236", born:date('1948-05-10'), name:"Meg Foster", bio:"From Wikipedia, the free encyclopedia. \n\nMegan \"Meg\" Foster (born on May 10, 1948) is an American actress who starred as Hester Prynne in The Scarlet Letter (1979), Ingrid in Ticket to Heaven and Holly in They Live (1988)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fGIeR5uPwPf9CF7uQPj9ReVD2IV.jpg", url:"https://themoviedb.org/person/41229"}}, {tmdbId:"101576", properties:{bornIn:"Parigi, Francia", imdbId:"0068792", born:date('1956-12-10'), name:"Annie Belle", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rvEGORjrir8Whp53S5k3lGSJPJ8.jpg", url:"https://themoviedb.org/person/101576"}}, {tmdbId:"101578", properties:{imdbId:"0097392", name:"Christian Borromeo", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ypvCH46eTJvsBTlMd8D74AGru6z.jpg", url:"https://themoviedb.org/person/101578"}}, {tmdbId:"27277", properties:{bornIn:"Roma, Italy", imdbId:"0518422", born:date('1954-09-23'), name:"Giovanni Lombardo Radice", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2CNIb3EZuLNP695fawIAEbRtRXT.jpg", url:"https://themoviedb.org/person/27277"}}] AS row
