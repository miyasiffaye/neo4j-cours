UNWIND [{tmdbId:"3272", properties:{bornIn:"Santa Ana, California, USA ", imdbId:"0068166", born:date('1986-06-27'), name:"Drake Bell", bio:"Jared Drake Bell (born June 27, 1986), better known as Drake Bell, is an American actor, comedian, guitarist, singer/songwriter, producer, and occasional television director.  Bell is commonly associated with his real-life best friend Josh Peck, who co-starred with him in both The Amanda Show, with Amanda Bynes, and Drake & Josh...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6KxFiHrqiniS3oxV4NCz0sYNTuo.jpg", url:"https://themoviedb.org/person/3272"}}, {tmdbId:"60072", properties:{bornIn:"Woodland Hills, Los Angeles, California, USA", imdbId:"0668139", born:date('1988-04-25'), name:"Sara Paxton", bio:"Sara Paxton is an American film and television actress, model and singer, best known for playing the title role in the television series \"Darcy's Wild Life\" and character Sarah Borden in the show \"Summerland\".  She also starred in feature films such as \"Sleepover\", \"Aquamarine\", \"The Last House on the Left\", and \"Sydney White\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vzhcKMTUeC2I7irokkwQij9UQH6.jpg", url:"https://themoviedb.org/person/60072"}}, {tmdbId:"52645", properties:{bornIn:"Oxnard, California, USA", imdbId:"1470934", born:date('1977-12-07'), name:"Fernando Vargas", bio:"From Wikipedia, the free encyclopedia. \n\nFernando Vargas (born December 7, 1977) is a retired Mexican American boxer and two-time world champion, who won a bronze medal as an amateur at the 1995 Pan American Games in Mar del Plata.  His nicknames include \"Ferocious\", \"The Aztec Warrior\" and \"El Feroz\".  Vargas is the youngest Jr. Middleweight Champion in the history of the sport...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2tuv3NVqFcDxzVfCQ3rZNtMtKY3.jpg", url:"https://themoviedb.org/person/52645"}}, {tmdbId:"77277", properties:{bornIn:"Norfolk, Virginia, USA", imdbId:"1676649", born:date('1979-11-18'), name:"Nate Parker", bio:"​From Wikipedia, the free encyclopedia. \n\nNate Parker (born November 18, 1979) is an American actor and musical performer who has appeared in The Secret Life of Bees, The Great Debaters, and Pride.  In his recent roles, he has performed alongside Denzel Washington, Forest Whitaker and Terrence Howard.  Parker has overcome turbulence and turmoil in his life both as a youth and a collegian...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4f9O8ROSDCBwGaGKsSjbB92w7TB.jpg", url:"https://themoviedb.org/person/77277"}}, {tmdbId:"77278", properties:{bornIn:"Torrance - California - USA", imdbId:"1091701", born:date('1990-06-15'), name:"Denzel Whitaker", bio:"Denzel Dominique Whitaker (born June 15, 1990) is an American actor, playing key roles in the films The Great Debaters and Training Day, as well as TV shows ER, Brothers &amp; Sisters and The War At Home.  He later went on to be a featured cast member during the tenth and final season of the Nickelodeon sketch-comedy series All That.  He was also in the Disney Channel Original Movie, Dadnapped...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8l5y5UDtkKJ13WQybqRXUEma7nm.jpg", url:"https://themoviedb.org/person/77278"}}, {tmdbId:"6823", properties:{imdbId:"2148838", name:"Sam Egli", url:"https://themoviedb.org/person/6823"}}, {tmdbId:"39728", properties:{bornIn:"Lino Lakes, Minnesota, USA", imdbId:"2044796", born:date('1996-04-03'), name:"Jackson Bond", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mNNXKVUjmvcBKRokwlQrGvw595m.jpg", url:"https://themoviedb.org/person/39728"}}, {tmdbId:"52848", properties:{bornIn:"Muscat, Oman", imdbId:"0279545", born:date('1976-02-03'), name:"Isla Fisher", bio:"Isla Lang Fisher (born February 3, 1976) is an actress and author.  She began acting on Australian television, on the short-lived soap opera Paradise Beach before playing Shannon Reed on the soap opera Home and Away.  She has since been known for her comedic roles in Wedding Crashers (2005), Hot Rod (2007), Definitely, Maybe (2008), and Confessions of a Shopaholic (2009). \n\nFisher was born in Muscat, Oman, to Scottish parents from Bathgate and Stranraer, and was raised in Perth, Western Australia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vVeKcMyFMPcIDLYNAnGSGnQrJ3k.jpg", url:"https://themoviedb.org/person/52848"}}, {tmdbId:"57554", properties:{bornIn:"Sacramento, California, USA", imdbId:"0526406", born:date('1950-09-19'), name:"Joan Lunden", bio:"From Wikipedia, the free encyclopedia\n\nJoan Lunden (born September 19, 1950) is an American journalist, author and television host.  She was the co-host of ABC's Good Morning America (GMA) from 1980 through 1997 and is the author of 8 books.  Lunden has appeared on the Biography program and Biography Channel. \n\nDescription above from the Wikipedia article Joan Lunden, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/57554"}}, {tmdbId:"57555", properties:{imdbId:"1836658", name:"Eric Haberman", url:"https://themoviedb.org/person/57555"}}, {tmdbId:"2537686", properties:{name:"Bongkoj Khongmalai", url:"https://themoviedb.org/person/2537686"}}, {tmdbId:"57854", properties:{bornIn:"Miami Beach, Florida, USA", imdbId:"0385644", born:date('1965-09-21'), name:"Cheryl Hines", bio:"Cheryl Hines is an American actress and television director, best known for her role as Larry David's wife Cheryl on HBO's Curb Your Enthusiasm.  In 2009 she made her directorial debut at the Tribeca Film Festival with Serious Moonlight...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jUW4xdla64Vtq1o2Ob8Oc7MjT9C.jpg", url:"https://themoviedb.org/person/57854"}}, {tmdbId:"4671", properties:{imdbId:"0821205", name:"Zach Staenberg", url:"https://themoviedb.org/person/4671"}}, {tmdbId:"908", properties:{imdbId:"0873531", name:"Michael Tronick", url:"https://themoviedb.org/person/908"}}, {tmdbId:"24502", properties:{bornIn:"Les Lilas, Seine-Saint-Denis, France", imdbId:"0803262", born:date('1990-04-16'), name:"Jules Sitruk", bio:"Jules commence la comédie à 8 ans après une annonce de casting chez son coiffeur.  Par la suite, il décroche plusieurs rôles importants dans des téléfilms et films.  Il fait son premier long-métrage à l'âge de 11 ans, en 2001, dans Monsieur Batignole (avec Gérard Jugnot).  Il est ensuite César dans Moi César, 10 ans ½, 1m39 en 2003.  Puis il joue dans Vipère au poing en 2004 et dans Les Aiguilles rouges en 2005...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gTGtF6UZpDYGw87rCfCXBL5nRAN.jpg", url:"https://themoviedb.org/person/24502"}}, {tmdbId:"51329", properties:{bornIn:"Philadelphia, Pennsylvania, USA", imdbId:"0177896", born:date('1975-01-05'), name:"Bradley Cooper", bio:"Bradley Charles Cooper (born January 5, 1975) is an American actor, producer and director.  He was one of the world's highest-paid actors for three years, and has been nominated for various accolades, including four Academy Awards for his performances in Silver Linings Playbook (2012), American Hustle (2013) and American Sniper (2014), also receiving a Best Picture nomination as a producer for the latter.  Cooper is also known for his voice work as Rocket Raccoon in the Marvel Cinematic Universe...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/re5ZIguJw1LuddH9rqScU649fdP.jpg", url:"https://themoviedb.org/person/51329"}}, {tmdbId:"78811", properties:{bornIn:"Memphis, Tennessee, USA", imdbId:"1961693", born:date('1978-06-20'), name:"Quinton 'Rampage' Jackson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1FcZPbXNJRAUJTN2U6choOgaq51.jpg", url:"https://themoviedb.org/person/78811"}}, {tmdbId:"34847", properties:{bornIn:"Rhinebeck, New York, USA", imdbId:"0731075", born:date('1991-02-10'), name:"Emma Roberts", bio:"Emma Rose Roberts (born February 10, 1991) is an American actress, model and singer.  She is the daughter of actor Eric Roberts and niece of Julia Roberts.  Roberts became known for her role as Addie Singer in the Nickelodeon television series Unfabulous.  She released her debut album, which also served as the show's soundtrack, Unfabulous and More.  Roberts then began to focus on her acting career, starring in the film Aquamarine and later as the title character in the 2007 film Nancy Drew...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gn5rf7Nh0X0855n07XkuEn27n0n.jpg", url:"https://themoviedb.org/person/34847"}}, {tmdbId:"94791", properties:{bornIn:"Dallas, Texas, USA", imdbId:"1416330", born:date('1986-07-08'), name:"Jake McDorman", bio:"​Jake McDorman is an American film and television actor, best known for playing character Evan Chambers on the television series \"Greek\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9Gc3sRBTWtxfq6oL9AEH1K8C0o0.jpg", url:"https://themoviedb.org/person/94791"}}, {tmdbId:"675", properties:{bornIn:"Neuwied, Germany", imdbId:"1214637", born:date('1975-09-22'), name:"Christian Ulmen", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8zfEVZWTiqNciCNS31ALxJQzmbY.jpg", url:"https://themoviedb.org/person/675"}}] AS row
