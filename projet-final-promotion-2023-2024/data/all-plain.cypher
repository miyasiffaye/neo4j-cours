UNWIND [{tmdbId:"128859", properties:{bornIn:"Maastricht, Netherlands", imdbId:"0591389", born:date('1977-01-05'), name:"Hadewych Minis", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fYx0AoafmCqpzF3UWGf5MMNujli.jpg", url:"https://themoviedb.org/person/128859"}}, {tmdbId:"236901", properties:{bornIn:"Belgium, EU", imdbId:"2334765", born:date('1978-01-01'), name:"Jeroen Perceval", bio:"Jeroen Perceval (born in 1978) is a belgium actor and writer.  He is the son of actor Luk Perceval...", url:"https://themoviedb.org/person/236901"}}, {tmdbId:"2343", properties:{bornIn:"Köln, Germany", imdbId:"0778348", born:date('1979-10-20'), name:"Katharina Schüttler", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/flIGG4GZ1r8IsrpvsuVV0LegK59.jpg", url:"https://themoviedb.org/person/2343"}}, {tmdbId:"5646", properties:{bornIn:"Lübeck, Germany", imdbId:"0230649", born:date('1960-12-06'), name:"Justus von Dohnányi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fuYtxNjlzzS0WPS4mm6XnovrEjS.jpg", url:"https://themoviedb.org/person/5646"}}, {tmdbId:"144346", properties:{bornIn:"Mönchengladbach, Germany", imdbId:"0775709", born:date('1967-06-26'), name:"Andreas Schröders", url:"https://themoviedb.org/person/144346"}}, {tmdbId:"1381550", properties:{bornIn:"New Haven, Connecticut, USA", imdbId:"0139389", born:date('1950-03-02'), name:"Karen Carpenter", bio:"From Wikipedia, the free encyclopedia\n\nKaren Anne Carpenter (March 2, 1950 – February 4, 1983) was an American singer and drummer who was part of the duo the Carpenters alongside her older brother Richard.  She was praised for her contralto vocals, and her drumming abilities were viewed positively by other musicians and critics.  Her struggles with eating disorders would later raise awareness of anorexia and body dysmorphia...", died:date('1983-02-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nCRV8I1JgClhjD2y7ku5l8sKt91.jpg", url:"https://themoviedb.org/person/1381550"}}, {tmdbId:"475512", properties:{bornIn:"Kansas City, Missouri, USA", imdbId:"2608689", born:date('1980-05-02'), name:"Ellie Kemper", bio:"Elizabeth Claire \"Ellie\" Kemper (born May 2, 1980) is an American actress, comedian, and writer.  She is best known for her role as Erin Hannon in the NBC series The Office, as well as her supporting roles in the films Bridesmaids and 21 Jump Street.  She is currently attached to star in the upcoming NBC comedy Unbreakable Kimmy Schmidt, created by Tina Fey...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dYs1Wn7uCSTFaYqHGXgS3BX4Ww1.jpg", url:"https://themoviedb.org/person/475512"}}, {tmdbId:"9145", properties:{bornIn:"London - England - UK", imdbId:"0130536", born:date('1971-06-04'), name:"James Callis", bio:"From Wikipedia, the free encyclopedia. \n\nJames Callis (born 4 June 1971) is a British actor.  He is best known for playing Dr.  Gaius Baltar in the re-imagined Battlestar Galactica miniseries and television series, and Bridget Jones' best friend in Bridget Jones's Diary and Bridget Jones: The Edge of Reason.  He joined the cast of the TV Series Eureka, on Syfy, in 2010...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dLmmQU5hA0J6Jxi20aS8kdN6k3o.jpg", url:"https://themoviedb.org/person/9145"}}, {tmdbId:"101034", properties:{bornIn:"Winnipeg, Manitoba, Canada", imdbId:"0787715", born:date('1958-06-17'), name:"Kerry Shale", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7IrOqC44j27MtUGjn3UwB2FRFWK.jpg", url:"https://themoviedb.org/person/101034"}}, {tmdbId:"205258", properties:{bornIn:"London, England", imdbId:"0516003", born:date('1983-11-17'), name:"Harry Lloyd", bio:"Harry Lloyd is an English actor.  He played Will Scarlet in the first two seasons of the BBC drama Robin Hood which began in 2006. \n\nDescription above from the Wikipedia article Harry Lloyd, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qZSf6OzRpDaZdOCX6pynSRp6jVV.jpg", url:"https://themoviedb.org/person/205258"}}, {tmdbId:"96555", properties:{bornIn:"Vancouver - Canada", imdbId:"1182955", born:date('1978-01-10'), name:"Antonio Cupo", bio:"Antonio Cupo was born in Vancouver, Canada, on 10 January 1978.  His ethnicity is Italian and Latino.  He has worked for many years in Italy and Canada and now permanently resides in the USA.  He graduated in English Literature and Theatre at the University of British Columbia.  He is an actor, songwriter, has fronted many bands and won national songwriting competitions...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/db3XLwGe84srhkmvj4SFFglxmrF.jpg", url:"https://themoviedb.org/person/96555"}}, {tmdbId:"1083260", properties:{bornIn:"Vancouver, British Columbia, Canada", imdbId:"2021381", born:date('1980-11-02'), name:"Tristan Risk", bio:"Corsetier, chocolatier, baker, ta-ta shaker, hip swayer, tight lacer, troublemaker, red lipstick, magic tricks, swizzle sticks, voodoo kicks, and a urban myth.  Tristan Risk aka Little Miss Risk, has been a burlesque/sideshow/fetish performance artist for over ten years, touring North America and Europe with her heathen charms.  Recently, she has made the move into genre film including her breakout role in the Soska sisters film, \"American Mary\" as surgically altered stripper Beatress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3yxxf6MK803dOPjt8etldSCxjq4.jpg", url:"https://themoviedb.org/person/1083260"}}, {tmdbId:"61544", properties:{bornIn:"Vancouver, Canada", imdbId:"0522704", born:date('1969-11-04'), name:"David Lovgren", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hFJ2K2QApj0XEPeqkhIiHigIK2s.jpg", url:"https://themoviedb.org/person/61544"}}, {tmdbId:"1055230", properties:{bornIn:"Worsley, Manchester, England, UK", imdbId:"3864163", born:date('2001-11-12'), name:"Raffey Cassidy", bio:"Raffey Cassidy (12 November 2001) is an English actress born in Worsley, Manchester, UK.  She is known for her roles in Snow White and the Huntsman (2012), Tomorrowland (2015), The Killing of a Sacred Deer (2017) and Vox Lux (2018)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iIPH3YHFOz8wXfj4uLQnzOX2Kpa.jpg", url:"https://themoviedb.org/person/1055230"}}, {tmdbId:"107722", properties:{bornIn:"Rybachiy, Vilyuchinsk, Kamchatskaya oblast, RSFSR, USSR (now Kamchatskiy kray, Russia)", imdbId:"3732046", born:date('1986-02-17'), name:"Grigoriy Dobrygin", bio:"Dobrygin was born in February 17, 1986 in Rybachiy, Vilyuchinsk, Kamchatskaya oblast, RSFSR, USSR (now Kamchatskiy kray, Russia).  He studied at a school in Zelenograd, Moscow Oblast.  He graduated from the Moscow State Academy of Choreography in the Bolshoi Theatre.  In 2010, he graduated from the Russian Academy of Theatre Arts.  \n\nHis first movies were Black Lightning (2009) and How I Ended This Summer (2010), which got him worldwide recognition...", url:"https://themoviedb.org/person/107722"}}, {tmdbId:"146358", properties:{bornIn:"Liège, Belgium", imdbId:"1304635", born:date('1985-12-05'), name:"Mehdi Dehbi", bio:"Mehdi Dehbi (born December 5, 1985, Liège) is a Belgian actor, of Moroccan origin, most known for his roles in the 2012 film The Other Sonand the 2014 film A Most Wanted Man. \n\nMehdi Dehbi was born in Liège in a family whose father, of Moroccan origin, is a worker and a homemaker mother.  He showed an early inclination for the arts, takes acting classes, singing, music theory, of dance . . .  and at twelve years he began his secondary education at the Académie Grétry in Liege...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/38VUxFJXs0W4hfxu99UKgAngTUn.jpg", url:"https://themoviedb.org/person/146358"}}, {tmdbId:"972356", properties:{bornIn:"Sydney - Australia", imdbId:"3478396", born:date('1989-04-26'), name:"Luke Bracey", bio:"An Australian actor, best known for his role on Home and Away as Trey Palmer.  He also appeared in the 2011 film Monte Carlo, and as Aaron on Dance Academy.   In 2013 Luke played Cobra Commander in G. I.  Joe: Retaliation replacing Joseph Gordon-Levitt from the first film.  In March 2013, Bracey signed on for the male lead role in the ABC drama pilot Westside produced by McG and developed by Ilene Chaiken.  He starred in the 2014 films The November Man and The Best of Me...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/18mfKOJhNnXcLNT2jsxbrYpwHlr.jpg", url:"https://themoviedb.org/person/972356"}}, {tmdbId:"74930", properties:{imdbId:"1887429", born:date('1977-04-16'), name:"Hayes MacArthur", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fpXNZheFBcvp2ICQijBOR8GE13Q.jpg", url:"https://themoviedb.org/person/74930"}}, {tmdbId:"1540680", properties:{imdbId:"5558187", name:"Maleah Nipay-Padilla", url:"https://themoviedb.org/person/1540680"}}, {tmdbId:"1540681", properties:{imdbId:"4455823", name:"Ryan Teeple", url:"https://themoviedb.org/person/1540681"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"73128", properties:{bornIn:"New York City - New York - USA", imdbId:"2799457", born:date('1987-09-23'), name:"Skylar Astin", bio:"Skylar Astin is an American actor and singer.  He is known for playing Georg in the Tony Award–winning stage musical Spring Awakening, and for his roles in the films Hamlet 2 (2008), Taking Woodstock (2009), Pitch Perfect (2012), and 21 &amp; Over (2013). \n\nAstin was born in New York City and grew up in Rockland County, New York.  He is the son of Meryl and Barry Lipstein.   He has a sister, Brielle, and two brothers, Milan and Jace.   Astin is Jewish...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9fUil5Nei21o0WHB2P4oPWJiAph.jpg", url:"https://themoviedb.org/person/73128"}}, {tmdbId:"1107296", properties:{bornIn:"Los Angeles, California, USA", imdbId:"4805317", born:date('1993-09-24'), name:"Ben Platt", bio:"Ben Platt is an American actor and singer known for originating the role of the title character in the Broadway musical Dear Evan Hansen, a performance for which he has won numerous awards, including the 2017 Tony Award for Best Actor in a Musical.  Platt's credits also include the role of Benji Applebaum in the musical films Pitch Perfect (2012) and Pitch Perfect 2 (2015)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dmZ5Y8ajfF3K5R90EpVg8kFEukT.jpg", url:"https://themoviedb.org/person/1107296"}}, {tmdbId:"82662", properties:{bornIn:"Atlanta, Georgia, USA", imdbId:"1715118", born:date('1987-07-21'), name:"AnnaLynne McCord", bio:"AnnaLynne McCord (born July 16, 1987) is an American actress.  Known for playing a range of vixen-type roles, McCord first gained prominence in 2007 as the scheming Eden Lord on the FX television series Nip/Tuck, and as the pampered Loren Wakefield on the MyNetworkTV telenovela American Heiress.  In film, she has appeared in the action feature Transporter 2, as well as the thriller Day of the Dead...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9YwWXerGltqjqSDpXBuaik4mYWi.jpg", url:"https://themoviedb.org/person/82662"}}, {tmdbId:"42160", properties:{bornIn:"Los Angeles, California, USA", imdbId:"1736769", born:date('1998-01-28'), name:"Ariel Winter", bio:"Ariel Winter (born January 28, 1998) is an American actress and singer.  She is best known for her role on Modern Family...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1h0XaXnieP5CdTAeRGuALBJmD4R.jpg", url:"https://themoviedb.org/person/42160"}}, {tmdbId:"10826", properties:{bornIn:"Steubenville, Ohio, USA", imdbId:"0000183", born:date('1968-05-07'), name:"Traci Lords", bio:"Traci Lords (born Nora Louise Kuzma; May 7, 1968), also known as Traci Elizabeth Lords and Tracy Lords, is an American film actress, producer, film director, writer and singer.  She first achieved notoriety for her underage appearances in pornographic films and Penthouse magazine (she was 16 years old in her first film), later becoming a successful television and B-movie actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xcHV0zuDDYX5TZfJAd6osXfzLWC.jpg", url:"https://themoviedb.org/person/10826"}}, {tmdbId:"105584", properties:{bornIn:"Wellington, New Zealand", imdbId:"1235366", born:date('1976-06-29'), name:"Bret McKenzie", bio:"From Wikipedia, the free encyclopedia\n\nBret Peter Tarrant McKenzie (born 29 June 1976 in Wellington, New Zealand) is a comedian, actor, musician and producer, best known for being one half of the musical comedy duo Flight of the Conchords along with Jemaine Clement. \n\nDescription above from the Wikipedia article Bret McKenzie, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/105584"}}, {tmdbId:"54716", properties:{bornIn:"Lakeland, Florida, USA", imdbId:"1601643", born:date('1982-01-01'), name:"Lauren Miller", url:"https://themoviedb.org/person/54716"}}, {tmdbId:"222129", properties:{bornIn:"Farmington Hills - Michigan - USA", imdbId:"2312345", born:date('1985-03-22'), name:"James Wolk", bio:"James Wok is an actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/89a7ZeiV8nvDWer8fyix19iuka2.jpg", url:"https://themoviedb.org/person/222129"}}, {tmdbId:"1323612", properties:{bornIn:"Inghilterra, Regno Unito", imdbId:"0185431", name:"Jonny Coyne", bio:"Coyne's earliest performances were in school plays.  He played leading roles in two outstanding productions: ‘The Judge’ in Oscar Wilde's 'Hang of the Gaol' and 'Phaeton' in Ovid's Chariot of the Sun.  He won rave reviews for his performances in the national press and decided to pursue a career as an actor. He won a place at the Royal Academy of Dramatic Art in London and upon his graduation, he received the Hannam Clarke Award. \n\nHis first role on TV was on an episode of London's Burning in 1990...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fsnJsaehM5iLrn6NGApJQ99W9A9.jpg", url:"https://themoviedb.org/person/1323612"}}, {tmdbId:"37947", properties:{bornIn:"New York City, New York, USA ", imdbId:"0319142", born:date('1971-09-22'), name:"Lawrence Gilliard Jr.", bio:"Lawrence Gilliard Jr.  is an American actor working in both television and films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p4dVX4Svzu0zDqMgvAbsA1PDpMP.jpg", url:"https://themoviedb.org/person/37947"}}, {tmdbId:"1581096", properties:{imdbId:"5746224", name:"Elise Vargas", url:"https://themoviedb.org/person/1581096"}}, {tmdbId:"1581097", properties:{imdbId:"5746225", name:"Zoey Vargas", url:"https://themoviedb.org/person/1581097"}}, {tmdbId:"1277052", properties:{imdbId:"2367998", name:"Alan Drake", url:"https://themoviedb.org/person/1277052"}}, {tmdbId:"205854", properties:{bornIn:"New York City, New York, USA", imdbId:"2185539", born:date('1983-01-01'), name:"Zachary Booth", bio:"Zachary Booth is an American stage and screen actor...", url:"https://themoviedb.org/person/205854"}}, {tmdbId:"227612", properties:{bornIn:"Tottori, Japan", imdbId:"3768523", born:date('1991-10-16'), name:"Miori Takimoto", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6EBEo0Z8IuQMOKZDPL1U0L3B3UL.jpg", url:"https://themoviedb.org/person/227612"}}, {tmdbId:"20333", properties:{bornIn:"Toyama, Japan", imdbId:"0632761", born:date('1960-12-12'), name:"Masahiko Nishimura", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2fXvxAI4KySYgp9KZMzkK4q2TkY.jpg", url:"https://themoviedb.org/person/20333"}}, {tmdbId:"3769", properties:{bornIn:"Berlin, Germany", imdbId:"0000841", born:date('1935-08-05'), name:"Michael Ballhaus", died:date('2017-04-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pMto0iHZb67YaSP9cTgKbAPcaYU.jpg", url:"https://themoviedb.org/person/3769"}}, {tmdbId:"647", properties:{imdbId:"0066244", name:"Dion Beebe", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q24Jkyu8VclqhdYhPpti7fXoSkS.jpg", url:"https://themoviedb.org/person/647"}}, {tmdbId:"932457", properties:{name:"Francisco Acuña", url:"https://themoviedb.org/person/932457"}}, {tmdbId:"2650838", properties:{name:"Juan Alfaro", url:"https://themoviedb.org/person/2650838"}}] AS row
