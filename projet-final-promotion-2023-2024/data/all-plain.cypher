UNWIND [{tmdbId:"20304", properties:{imdbId:"0190190", name:"Jeremy Crutchley", bio:"Jeremy Crutchley is an actor and producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cXFWc8L1CyCfzpiBCzmSH5OAzgI.jpg", url:"https://themoviedb.org/person/20304"}}, {tmdbId:"19901", properties:{bornIn:"Hampshire, England, UK", imdbId:"0751085", born:date('1945-12-07'), name:"Clive Russell", bio:"Clive Russell was raised in Fife, Scotland, from 3 months old.  He originally trained as a teacher, but when his drama lecturer resigned and took over a theatre in the provincial town of Bolton, Lancaster, Russell joined him.  Russell has been working solely in film and television since 1991...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n9oyhZ4LWCs6NHhK88dCVAdxu7x.jpg", url:"https://themoviedb.org/person/19901"}}, {tmdbId:"198287", properties:{bornIn:"Halifax, Nova Scotia, Canada", imdbId:"0646241", born:date('1979-06-01'), name:"Craig Anthony Olejnik", url:"https://themoviedb.org/person/198287"}}, {tmdbId:"105816", properties:{bornIn:"Kikuchi, Kumamoto, Japan", imdbId:"0157133", born:date('1954-02-04'), name:"Shigeru Chiba", bio:"known by the stage name Shigeru Chiba (千葉 繁 Chiba Shigeru), is a Japanese actor and voice actor.   He has also worked as a sound effects director and music director.  He is affiliated with the talent management firm 81 Produce. \n\nHe is most known for the roles of the narrator of Fist of the North Star, Megane (Urusei Yatsura), Rei Ichidō (High School! Kimengumi), Kazuma Kuwabara (Yu Yu Hakusho), Pilaf (Dragon Ball), Raditz and Garlic Jr...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9oajq1i3qzkA2MTDH3ciLOEenS9.jpg", url:"https://themoviedb.org/person/105816"}}, {tmdbId:"122654", properties:{imdbId:"0250752", born:date('1962-09-13'), name:"Hisao Egawa", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gXRe4o7SqdLsPbjSL6PmeeZfKF9.jpg", url:"https://themoviedb.org/person/122654"}}, {tmdbId:"1241867", properties:{imdbId:"0297715", born:date('1961-04-21'), name:"Kayoko Fujii", url:"https://themoviedb.org/person/1241867"}}, {tmdbId:"1242034", properties:{bornIn:"Nagasaki - Japan", imdbId:"0297983", born:date('1950-12-18'), name:"Nobuaki Fukuda", url:"https://themoviedb.org/person/1242034"}}, {tmdbId:"1661612", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0147503", born:date('1953-04-07'), name:"Rene Ceballos", url:"https://themoviedb.org/person/1661612"}}, {tmdbId:"23893", properties:{bornIn:"New York City, New York, USA", imdbId:"0209340", born:date('1955-12-09'), name:"George De La Pena", bio:"​From Wikipedia, the free encyclopedia.   \n\nGeorge de la Peña (b.  1955 or 1956) is an American ballet dancer, musical theatre performer, choreographer, actor, and teacher.  He was born in New York City, New York, U. S. \n\nOriginally trained as a concert pianist, de la Peña switched to ballet while studying at the High School for the Performing Arts in New York City.  He graduated from George Balanchine’s School of American Ballet...", url:"https://themoviedb.org/person/23893"}}, {tmdbId:"536099", properties:{born:date('1975-09-28'), name:"Karan Ashley", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lXfsZLudyBFnMFmPhCEttXyQsWD.jpg", url:"https://themoviedb.org/person/536099"}}, {tmdbId:"50096", properties:{bornIn:"Kansas City, Missouri, United States", imdbId:"0097765", born:date('1976-01-06'), name:"Johnny Yong Bosch", bio:"​From Wikipedia, the free encyclopedia\n\nJohnny Yong Bosch (born January 6, 1976, Kansas City, Missouri) is an American actor, voice actor, martial artist, and musician. \n\nHe may be best-known for portraying Lelouch Lamperouge in Code Geass: Lelouch of the Rebellion, Adam Park in Mighty Morphin Power Rangers, and being the English voice of Ichigo Kurosaki in the hit anime series Bleach and Vash the Stampede in Trigun.  He is also a two time American Anime Award nominee...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a0JtdXCVw8HIkWNq2rqlWs1A8CR.jpg", url:"https://themoviedb.org/person/50096"}}, {tmdbId:"56897", properties:{bornIn:"Langley Air Force Base, Virginia, U.S.", imdbId:"0136399", born:date('1974-05-29'), name:"Steve Cardenas", bio:"From Wikipedia, the free encyclopedia\n\nStephen Antonio Cardenas (born May 29, 1974) is a former Mexican-American actor and martial artist, perhaps most noted for playing Rocky DeSantos in the Mighty Morphin Power Rangers TV series. \n\nCardenas was born at Langley Air Force Base, in Hampton, Virginia, U. S.  and is of half Mexican descent. [1] His character, Rocky, replaced Jason Lee Scott (played by Austin St...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w6UfCoXzbiRWq9HLSdAzxTjk60X.jpg", url:"https://themoviedb.org/person/56897"}}, {tmdbId:"50098", properties:{bornIn:"Covina, California, USA", imdbId:"0290969", born:date('1973-09-04'), name:"Jason David Frank", bio:"​From Wikipedia, the free encyclopedia\n\nJason David Frank (born September 4, 1973) is an American actor, martial artist and professional mixed martial arts fighter, best known for playing Tommy Oliver in Power Rangers. \n\nDescription above from the Wikipedia article Jason David Frank, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lR7VkHYktJTgim0UGpafC1t8gLS.jpg", url:"https://themoviedb.org/person/50098"}}, {tmdbId:"119263", properties:{bornIn:"Soka, Saitama Prefecture, Japan", imdbId:"0393365", born:date('1979-01-07'), name:"Youko Honna", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/g3rdj5AR2lsl8cpDj99LsKfl6DH.jpg", url:"https://themoviedb.org/person/119263"}}, {tmdbId:"87662", properties:{bornIn:"Tokyo Prefecture, Japan", born:date('1980-12-09'), name:"Issei Takahashi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jqkJuGDh2qWeji1A1O5R6dWzSIi.jpg", url:"https://themoviedb.org/person/87662"}}, {tmdbId:"555255", properties:{imdbId:"0846181", name:"Takashi Tachibana", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c4zx0X9CE8ogyg2f55LxiLUtjFL.jpg", url:"https://themoviedb.org/person/555255"}}, {tmdbId:"135025", properties:{bornIn:"Namerikawa, Toyama, Japan", imdbId:"0614026", born:date('1960-10-22'), name:"Shigeru Muroi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/83lMnQ6vW1ZhzNH4xOVPcwA5su2.jpg", url:"https://themoviedb.org/person/135025"}}, {tmdbId:"121139", properties:{imdbId:"0029068", name:"James Andronica", url:"https://themoviedb.org/person/121139"}}, {tmdbId:"35211", properties:{bornIn:"Tunis, Tunisia", imdbId:"0099378", born:date('1952-11-03'), name:"Michel Boujenah", bio:"Michel Boujenah (born 2 November 1952) is a French actor, comedian, film director and screenwriter...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nXJfSRszZQW5SHUhz2nRErxH2B6.jpg", url:"https://themoviedb.org/person/35211"}}, {tmdbId:"63895", properties:{bornIn:"Roma, Italy", imdbId:"0553402", born:date('1963-09-19'), name:"Alessandra Martines", bio:"Extrait de Wikipedia, l'Encyclopedie libre. \n\nDès l'enfance, Alessandra Martines suit des cours de danse et devient ballerine.  Elle débute au cinéma en 1987 et obtient le rôle principal de la série italienne à succès La Caverne de la Rose d'Or (1991-1996), avec Kim Rossi Stuart, Ursula Andress, Nicholas Rogers et Brigitte Nielsen. \n\nÀ partir de 2011, elle est jurée lors des deux premières saisons de l'émission Danse avec les stars sur TF1...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xMfeR8rsf7wwYBG3JYFlcFzYgGR.jpg", url:"https://themoviedb.org/person/63895"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"141054", properties:{imdbId:"0500992", name:"Salomé Lelouch", url:"https://themoviedb.org/person/141054"}}, {tmdbId:"16866", properties:{bornIn:"The Bronx, New York City, New York, USA", imdbId:"0000182", born:date('1969-07-24'), name:"Jennifer Lopez", bio:"Jennifer Lopez (born July 24, 1969),  also known by her nickname J. Lo, is an American actress, singer, record producer, dancer, television personality, fashion designer and television producer.  Lopez began her career as a dancer on the television comedy program In Living Color.  Subsequently venturing into acting, she gained recognition in the 1995 action-thriller Money Train...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vNs45IZmVpBQF8uBdovQcwBHqWV.jpg", url:"https://themoviedb.org/person/16866"}}, {tmdbId:"57250", properties:{bornIn:"Hong Kong, British Crown Colony [now China]", imdbId:"0795225", born:date('1960-07-17'), name:"Robin Shou", bio:"Shou Wan Por  (born July 17, 1960), known professionally as Robin Shou, is a Hong Kong martial artist and actor.  Frequently appearing in numerous martial arts films, Shou was most successful for playing the role of Liu Kang in Mortal Kombat & Gobei with the late Chris Farley in Beverly Hills Ninja...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cnL8HqBowYu9ssTkShDfEmxTgdZ.jpg", url:"https://themoviedb.org/person/57250"}}, {tmdbId:"57251", properties:{bornIn:" Atlantic Beach, Florida, USA", imdbId:"0000798", born:date('1960-05-23'), name:"Linden Ashby", bio:"Clarence Linden Garnett Ashby III  (born May 23, 1960) is an American film/television actor and martial artist...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nflhvj2uJAr2S9aWvnbQWCUXC9a.jpg", url:"https://themoviedb.org/person/57251"}}, {tmdbId:"21105", properties:{bornIn:"Kermit, Texas, USA", imdbId:"0858988", born:date('1948-07-12'), name:"Jay Thomas", died:date('2017-08-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/daWSrAYJtCi2qiwq6BYZfiUWVIY.jpg", url:"https://themoviedb.org/person/21105"}}, {tmdbId:"129871", properties:{imdbId:"0181576", name:"Rafael Cortes", url:"https://themoviedb.org/person/129871"}}, {tmdbId:"1318723", properties:{imdbId:"0953173", name:"Amelia Zapata", url:"https://themoviedb.org/person/1318723"}}, {tmdbId:"99351", properties:{bornIn:"Sumatra, Indonesia", imdbId:"0536723", born:date('1953-06-16'), name:"Valerie Mahaffey", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d4Oc12PuuhTevEGjKEhs95XrVIl.jpg", url:"https://themoviedb.org/person/99351"}}, {tmdbId:"18325", properties:{bornIn:"Cambridge, Cambridgeshire, England, UK", imdbId:"0000562", born:date('1961-12-01'), name:"Jeremy Northam", bio:"From Wikipedia, the free encyclopedia\n\nJeremy Philip Northam (born 1 December 1961) is an English actor.  He is best known for his roles as Ivor Novello in the 2001 film Gosford Park, as Dean Martin in the 2002 television movie Martin and Lewis, and as Thomas More on the Showtime series The Tudors.  Most recently, he starred in the now-canceled CBS drama Miami Medical. \n\nDescription above from the Wikipedia article Jeremy Northam, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bhM9wdwR6ecx4qyKgpAbBB6p624.jpg", url:"https://themoviedb.org/person/18325"}}, {tmdbId:"18326", properties:{bornIn:"Pittsburgh, Pennsylvania, USA", imdbId:"0588222", born:date('1953-11-03'), name:"Dennis Miller", bio:"Dennis Miller is an American stand-up comedian, political commentator, actor, sports commentator, and television and radio personality.  He is known for his critical assessments laced with pop culture references.   He rose to fame as a cast member of Saturday Night Live in 1985, and subsequently hosted a string of his own talk shows on HBO, CNBC and in syndication.  He currently hosts a daily, three-hour, self-titled talk radio program, nationally syndicated by Westwood One...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AdO5Dm8xyuYvXIQEuzpBi6nG9QF.jpg", url:"https://themoviedb.org/person/18326"}}, {tmdbId:"122712", properties:{imdbId:"0179982", name:"Shar-Ron Corley", url:"https://themoviedb.org/person/122712"}}, {tmdbId:"18272", properties:{bornIn:"New York, New York, USA", imdbId:"0144133", born:date('1972-04-28'), name:"Gabriel Casseus", bio:"From Wikipedia, the free encyclopedia.  Randy Bruce Traywick (born May 4, 1959), better known as Randy Travis, is an American country singer and actor.  Active since 1985, he has recorded more than a dozen studio albums to date, in addition to charting more than thirty singles on the Billboard Hot Country Songs charts, of which sixteen have reached Number One...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sQ8IhQEVT7TFtfPucg47UCI7RqS.jpg", url:"https://themoviedb.org/person/18272"}}, {tmdbId:"1187", properties:{imdbId:"0825627", name:"Saul Stein", url:"https://themoviedb.org/person/1187"}}, {tmdbId:"42296", properties:{imdbId:"0569076", name:"Gwen McGee", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4DNpaqk6l8xa7qCmoAKi9RC6CSN.jpg", url:"https://themoviedb.org/person/42296"}}, {tmdbId:"21365", properties:{bornIn:"New York, USA", imdbId:"0153733", born:date('1988-03-24'), name:"Courtney Chase", url:"https://themoviedb.org/person/21365"}}, {tmdbId:"938895", properties:{bornIn:"Cologne, Germany", imdbId:"0630113", born:date('1938-10-16'), name:"Nico", bio:"Christa Päffgen, better known by her stage name Nico, was a German singer, songwriter, musician, model, and actress who came to prominence in the 1960s as a Warhol superstar...", died:date('1988-07-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aedJ0lIZWao7k8OnnReaCk4MYey.jpg", url:"https://themoviedb.org/person/938895"}}, {tmdbId:"109142", properties:{bornIn:"Hollywood, California, U.S.", imdbId:"0042106", born:date('1946-02-14'), name:"Tina Aumont", bio:"Maria Christina Aumont best known as Tina Aumont, was an American actress of French and Dominican descent. \n\nShe was born in Hollywood, California, the daughter of actors Jean-Pierre Aumont and Maria Montez.  She married actor and film director Christian Marquand in 1963, at the age of 17. \n\nShe made her debut as Tina Marquand in Joseph Losey's 1966 movie Modesty Blaise...", died:date('2006-10-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dg8VhEYHh5QD1tDeILKivbng0LO.jpg", url:"https://themoviedb.org/person/109142"}}, {tmdbId:"2362269", properties:{name:"Christian Päffgen", url:"https://themoviedb.org/person/2362269"}}, {tmdbId:"2155", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0000301", born:date('1982-03-11'), name:"Thora Birch", bio:"Thora Birch (born March 11, 1982) is an American actress.  She was a child actor in the 1990s, starring in movies such as All I Want for Christmas (1991), Patriot Games (1992), Hocus Pocus (1993), Now and Then (1995), and Alaska (1996).  She came to prominence in 1999 after earning worldwide attention and praise for her performance in American Beauty.  She then starred in the well received film Ghost World (2001), which earned her a Golden Globe nomination...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/m5jrrJEPkVAiZFijCpZ6nh2VBOo.jpg", url:"https://themoviedb.org/person/2155"}}, {tmdbId:"119598", properties:{bornIn:"Houston, Texas, USA", imdbId:"0711118", born:date('1948-06-19'), name:"Phylicia Rashad", bio:"Phylicia Rashād (born Phylicia Ayers-Allen; June 19, 1948) is an American Tony Award winning actress and singer, best known for her role as Clair Huxtable on the long-running NBC sitcom The Cosby Show. \n\nIn 2004, Rashād became the first African-American actress to win the Tony Award for Best Performance by a Leading Actress in a Play, for her role in the revival of A Raisin in the Sun...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nJrxvrzxRCh0if5pJVrCcugrEMG.jpg", url:"https://themoviedb.org/person/119598"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"157439", properties:{bornIn:"Jacksonville, Florida, USA", imdbId:"0446780", born:date('1943-10-21'), name:"Paula Kelly", died:date('2020-02-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/igSDPexYnhoeoiUPp17dOBwwyEd.jpg", url:"https://themoviedb.org/person/157439"}}, {tmdbId:"27631", properties:{bornIn:"London, England, UK", imdbId:"0662511", born:date('1962-05-18'), name:"Nathaniel Parker", bio:"From Wikipedia, the free encyclopedia\n\nNathaniel Parker (born 18 May 1962) is an English stage and screen actor best known for playing the lead in the BBC crime drama series The Inspector Lynley Mysteries, and Agravaine de Bois in the fourth series of Merlin...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gnAqDpkOHT0mqoBmyiKptnSM3wL.jpg", url:"https://themoviedb.org/person/27631"}}, {tmdbId:"7489", properties:{bornIn:"Baltimore, Maryland, USA", imdbId:"0000205", born:date('1968-11-08'), name:"Parker Posey", bio:"Parker Posey is an American film and television actress, best known for her supporting roles in many independent feature films such as \"Party Girl\", \"Kicking and Screaming\", and \"The House of Yes\", which led to her nickname \"Queen of the Indies\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hvD6VB7l8uC4CeUEVQsBWtnDCT6.jpg", url:"https://themoviedb.org/person/7489"}}, {tmdbId:"176628", properties:{bornIn:"Jersey City, New Jersey, USA", imdbId:"0220867", born:date('1965-12-04'), name:"Anthony DeSando", url:"https://themoviedb.org/person/176628"}}, {tmdbId:"8695", properties:{imdbId:"0246585", born:date('1975-03-22'), name:"Guillermo Díaz", bio:"​From Wikipedia, the free encyclopedia.   \n\nGuillermo Díaz is an American actor.  He has starred in movies such as Half Baked (1998), 200 Cigarettes (1999) and Stonewall (1995).  Díaz has had several TV guest appearances on such shows as Chappelle's Show, Law &amp; Order, Weeds and ER.  In 2006, he joined the cast of a series of improv-based commercials for Sierra Mist titled Mist Takes...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7DkDGhEXAuVdOlI8AYRf7vqeA3o.jpg", url:"https://themoviedb.org/person/8695"}}, {tmdbId:"56694", properties:{imdbId:"0593291", name:"Donna Mitchell", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oN7mKyne73jiU7fkuvQwxYQFb0I.jpg", url:"https://themoviedb.org/person/56694"}}, {tmdbId:"230275", properties:{bornIn:"Tunisie", imdbId:"0067845", born:date('1968-12-22'), name:"Sondos Belhassen", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uaTys0Fx45hfowMAECWYwnpFgV3.jpg", url:"https://themoviedb.org/person/230275"}}, {tmdbId:"266350", properties:{imdbId:"0101247", name:"Paul Bowles", url:"https://themoviedb.org/person/266350"}}, {tmdbId:"30318", properties:{bornIn:"Chelmsford, Essex, England", imdbId:"0740500", born:date('1963-01-01'), name:"Amanda Root", bio:"Amanda Root (born 1963 in Chelmsford, Essex) is an English stage and screen actor and a former voice actor for children's programmes. \n\nMs Root is possibly best known for her starring role in the 1995 BBC film adaptation of Jane Austen's Persuasion and the British TV comedy All About Me, as Miranda, alongside Richard Lumsden in 2004 and when she was a voice actor, best known for voicing Sophie in BFG. \n\nShe trained for the stage at Webber Douglas Academy of Dramatic Art...", url:"https://themoviedb.org/person/30318"}}, {tmdbId:"8785", properties:{bornIn:"Belfast, Northern Ireland, UK", imdbId:"0001354", born:date('1953-02-09'), name:"Ciarán Hinds", bio:"From Wikipedia, the free encyclopedia\n\nCiarán Hinds (born 9 February 1953) is an Irish actor.  A versatile character actor, he has appeared in feature films such as The Sum of All Fears, Road to Perdition, Munich, There Will Be Blood, Harry Potter and the Deathly Hallows – Part 2, Tinker Tailor Soldier Spy, Frozen, Silence, Red Sparrow, Justice League, First Man, and Frozen II...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/udj9q0p3NSxolvaIcu32O25sRjH.jpg", url:"https://themoviedb.org/person/8785"}}, {tmdbId:"13328", properties:{bornIn:"Marylebone, London, England", imdbId:"0714874", born:date('1939-07-16'), name:"Corin Redgrave", bio:"English actor, far left activist and a prominent member of the Workers' Revolutionary Party, Corin Redgrave was part of the third generation of a theatrical dynasty spanning four generations,  the only son and middle child of Michael Redgrave and Rachel Kempson, and brother of Vanessa and Lynn Redgrave.  He was the father of Jemma Redgrave and was married to Kika Markham from 1985 until his death in 2010...", died:date('2010-04-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/moHo95qvkgkXLnWNO93Qxdnnt2U.jpg", url:"https://themoviedb.org/person/13328"}}, {tmdbId:"1333696", properties:{imdbId:"0847425", name:"Akira Takayama", url:"https://themoviedb.org/person/1333696"}}, {tmdbId:"8256", properties:{bornIn:"Aurora, Ohio, USA", imdbId:"0000162", born:date('1969-05-25'), name:"Anne Heche", bio:"Anne Celeste Heche ( born May 25, 1969) is an American actress, director, and screenwriter.  She is a three-time Emmy Award nominee, winning the Daytime Emmy award for \"Outstanding Younger Actress in a Drama Series\" for her role on Another World, nominated again for the same role, and then again nominated for \"Outstanding Supporting Actress in a Miniseries or Movie\" for her role in Gracie's Choice...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a3wORGDRT4tMo684Tu78hrDaqmM.jpg", url:"https://themoviedb.org/person/8256"}}, {tmdbId:"69033", properties:{bornIn:"Shanghai, China", imdbId:"0943180", born:date('1966-02-05'), name:"Vivian Wu", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v50qUbxFnVclo3rhZZNQy74wL19.jpg", url:"https://themoviedb.org/person/69033"}}, {tmdbId:"21663", properties:{bornIn:"Kobe, Hyōgo, Japan", imdbId:"0645224", born:date('1933-07-26'), name:"Yoshi Oida", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/A1ow9mQH5lbOaha9XCn27LAB2s9.jpg", url:"https://themoviedb.org/person/21663"}}, {tmdbId:"95345", properties:{bornIn:"Tokyo, Tokyo Prefecture, Japan", imdbId:"0644523", born:date('1937-07-20'), name:"Ken Ogata", bio:"From Wikipedia, the free encyclopedia. \n\nKen Ogata (緒形 拳 Ogata Ken, 20 July 1937-5 October 2008) was a Japanese actor. \n\nOgata was born in Tokyo, Japan.  Ogata is well known for his roles in Peter Greenaway's The Pillow Book, Paul Schrader's Mishima: A Life in Four Chapters and Shohei Imamura's The Ballad of Narayama.  He won the award for best actor at the 26th Blue Ribbon Awards for Okinawan Boys...", died:date('2008-10-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8ZBIIbm5jZz9G97TYl9JnYzBmCn.jpg", url:"https://themoviedb.org/person/95345"}}, {tmdbId:"95346", properties:{imdbId:"0948876", name:"Hideko Yoshida", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uAqSrx4Nyo5NsmrTOnydNsntLQ6.jpg", url:"https://themoviedb.org/person/95346"}}, {tmdbId:"110316", properties:{imdbId:"0474122", born:date('1958-05-20'), name:"Judy Kuhn", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ulEgSz7BTsCAYERFDdmPgJ0clqf.jpg", url:"https://themoviedb.org/person/110316"}}, {tmdbId:"24967", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0000192", born:date('1972-12-19'), name:"Alyssa Milano", bio:"Alyssa Jayne Milano (born December 19, 1972) is an American actress and former singer.  Her childhood role as Samantha Micelli in the sitcom Who's the Boss? made her famous, and an eight-year stint as Phoebe Halliwell on the supernatural series Charmed brought her a new round of fame.  She was also a series regular on the original Melrose Place portraying the role of Jennifer Mancini.  Milano has a female sports apparel line, Touch...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q5RAaX57dLvlpigAhbX3lCb2dkZ.jpg", url:"https://themoviedb.org/person/24967"}}, {tmdbId:"54789", properties:{bornIn:"Lake Charles, Louisiana, USA", imdbId:"0001218", born:date('1965-10-11'), name:"Sean Patrick Flanery", bio:"Sean Patrick Flanery (born October 11, 1965) is an American actor known for such roles as Connor MacManus in The Boondock Saints, Greg Stillson in The Dead Zone and for portraying Indiana Jones in The Young Indiana Jones Chronicles, as well as Bobby Dagen in Saw 3D. \n\nDescription above from the Wikipedia article Sean Patrick Flanery , licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aHQtxIjMEDWdXqvFJplx0Kcwdn6.jpg", url:"https://themoviedb.org/person/54789"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"87956", properties:{imdbId:"0595631", born:date('1954-10-26'), name:"D.W. Moffett", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/97qSJNLdVfWBh1W2wd51M2CvM6O.jpg", url:"https://themoviedb.org/person/87956"}}, {tmdbId:"35598", properties:{bornIn:"Grand Rapids, Michigan, USA", imdbId:"0444832", born:date('1972-10-15'), name:"Matt Keeslar", bio:"From Wikipedia, the free encyclopedia\n\nMatt Keeslar (born October 15, 1972) is an American actor. \n\nKeeslar was born in Grand Rapids, Michigan, the son of Fred Keeslar and Ann Ferguson, who divorced in 1977. \n\nKeeslar is known for his roles in Waiting for Guffman, The Last Days of Disco, and Scream 3, and the miniseries Frank Herbert's Dune and Stephen King's Rose Red.  Keeslar starred in the 2008 ABC Family series The Middleman...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p55KGalkHFOxeSQeI1dWOJs4HBp.jpg", url:"https://themoviedb.org/person/35598"}}, {tmdbId:"3315", properties:{bornIn:"Dublin - Ireland", imdbId:"0810729", born:date('1974-01-01'), name:"Victoria Smurfit", bio:"Victoria Smurfit is an actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/euQ9BQJPtx0E9IipbxCSzabkTSd.jpg", url:"https://themoviedb.org/person/3315"}}, {tmdbId:"120006", properties:{bornIn:"London, UK", imdbId:"0112390", name:"Anthony Brophy", url:"https://themoviedb.org/person/120006"}}, {tmdbId:"17141", properties:{bornIn:"Logansport - Indiana - USA", imdbId:"0001427", born:date('1963-06-17'), name:"Greg Kinnear", bio:"Gregory \"Greg\" Kinnear (born June 17, 1963) is an American actor and television personality, who first rose to stardom as the first host of E!'s Talk Soup.  He has appeared in more than 20 motion pictures.  Kinnear was nominated for an Academy Award for his role in As Good as It Gets. \n\nDescription above from the Wikipedia article Greg Kinnear, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iJezGc9XjY0DFPs00SypkuKImFK.jpg", url:"https://themoviedb.org/person/17141"}}, {tmdbId:"12957", properties:{bornIn:"Buffalo, New York, USA", imdbId:"0545408", born:date('1928-06-19'), name:"Nancy Marchand", died:date('2000-06-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pIpv6wtSo5gP3cM90ivq0vqlJsi.jpg", url:"https://themoviedb.org/person/12957"}}, {tmdbId:"14329", properties:{bornIn:"South Bend, Indiana, USA", imdbId:"0606487", born:date('1963-04-10'), name:"Dean Norris", bio:"Dean Joseph Norris (born April 10, 1963 height 5' 7\" (1,70 m)) is an American actor, best known for portraying DEA agent Hank Schrader on the AMC series Breaking Bad (2008–2013) and town selectman James \"Big Jim\" Rennie on the CBS series Under the Dome (2013–present).  He has also appeared in films such as Lethal Weapon 2 (1989), Total Recall (1990), Terminator 2: Judgment Day (1991), Starship Troopers (1997), Little Miss Sunshine (2006), and Evan Almighty (2007)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fXbHgZxCEclcTxV8MpeBXhe2OJS.jpg", url:"https://themoviedb.org/person/14329"}}, {tmdbId:"1397377", properties:{imdbId:"0121313", name:"Julie Burgess", url:"https://themoviedb.org/person/1397377"}}, {tmdbId:"65543", properties:{imdbId:"0427104", name:"Lisa Andoh", url:"https://themoviedb.org/person/65543"}}, {tmdbId:"56977", properties:{bornIn:"New Liskeard, Ontario, Canada", imdbId:"0001163", born:date('1963-04-21'), name:"Roy Dupuis", bio:"From Wikipedia, the free encyclopedia. \n\nRoy Dupuis (born April 21, 1963) is a Canadian actor best known for his role as counterterrorism operative Michael Samuelle in the television series La Femme Nikita.  He portrayed Maurice Richard on television and in film and Roméo Dallaire in the 2007 film Shake Hands with the Devil. \n\nDescription above from the Wikipedia article Roy Dupuis, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7qexPVkYCzKadLu8DUsQ6zSfMgI.jpg", url:"https://themoviedb.org/person/56977"}}, {tmdbId:"56979", properties:{bornIn:"Santa Monica, California, USA", imdbId:"0490774", born:date('1965-06-19'), name:"Andrew Lauer", bio:"From Wikipedia, the free encyclopedia. \n\nAndrew (Andy) Lauer is a filmmaker and actor...", url:"https://themoviedb.org/person/56979"}}, {tmdbId:"12047", properties:{bornIn:"Altoona, Pennsylvania, USA", imdbId:"0001825", born:date('1964-08-14'), name:"Andrew Kevin Walker", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kgMKoXmY8AiyHWpQInKoRInU10V.jpg", url:"https://themoviedb.org/person/12047"}}, {tmdbId:"12054", properties:{bornIn:"Tegucigalpa, Honduras", imdbId:"0669254", born:date('1951-07-19'), name:"Daniel Zacapa", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oiqkan5Gflsf8wKd6Zn9YHk2I0Y.jpg", url:"https://themoviedb.org/person/12054"}}, {tmdbId:"17477", properties:{bornIn:"London, England, UK", imdbId:"0910040", born:date('1950-09-24'), name:"Harriet Walter", bio:"Harriet Walter is a British film and television actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pMBIjsM2U5xPMJ09k5X7XQZspwn.jpg", url:"https://themoviedb.org/person/17477"}}, {tmdbId:"19189", properties:{bornIn:"Farmington Hills, Michigan, USA", imdbId:"0000924", born:date('1972-07-28'), name:"Elizabeth Berkley", bio:"From Wikipedia, the free encyclopedia. \n\nElizabeth Berkley (born July 28, 1972) is an American television, movie, and theatre actress.  Berkley's most notable roles were in the television series Saved by the Bell, as brainy feminist Jessie Spano, and the 1995 Paul Verhoeven movie Showgirls, as exotic dancer Nomi Malone...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ibYmq9qTMV3haM9ITDmUpbl45Qu.jpg", url:"https://themoviedb.org/person/19189"}}, {tmdbId:"11150", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0000153", born:date('1962-06-10'), name:"Gina Gershon", bio:"Gina L.  Gershon (born June 10, 1962) is an American film, television and stage actress, singer and author.  She is known for her roles in the films Cocktail (1988), Showgirls (1995), Bound (1996), Face/Off (1997), The Insider (1999), Demonlover (2002), P. S.  I Love You (2007), Five Minarets in New York (2010), Killer Joe (2011) and House of Versace (2013).  She has also had supporting roles in FX's Rescue Me and HBO's How to Make It in America...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/puxZ3IXYa7jmOfzU5X3lkYUO6Iy.jpg", url:"https://themoviedb.org/person/11150"}}, {tmdbId:"2683", properties:{bornIn:"Richmond, California, USA", imdbId:"0687625", born:date('1961-08-18'), name:"Glenn Plummer", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lNfRFcxD7bhqKLZwOqdpumA83TL.jpg", url:"https://themoviedb.org/person/2683"}}, {tmdbId:"30437", properties:{bornIn:" Glasgow, Scotland, UK", imdbId:"0731869", born:date('1981-05-27'), name:"Iain Robertson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dBGMlQM2grvmepYpXKMdBM2QZLC.jpg", url:"https://themoviedb.org/person/30437"}}, {tmdbId:"128649", properties:{imdbId:"0240537", name:"Steven Duffy", url:"https://themoviedb.org/person/128649"}}, {tmdbId:"42279", properties:{bornIn:"Glasgow, Scotland, UK", imdbId:"0292182", born:date('1976-07-24'), name:"Laura Fraser", bio:"​Laura Fraser (born 24 July 1976 in Glasgow) is a Scottish actress.   From Wikipedia, the free encyclopedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hOgkyPtP5WOjcQjc7RmmKJl3OGE.jpg", url:"https://themoviedb.org/person/42279"}}] AS row
