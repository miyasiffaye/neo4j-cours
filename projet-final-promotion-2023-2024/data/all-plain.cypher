UNWIND [{tmdbId:"34199", properties:{bornIn:"Las Vegas, Nevada, USA", imdbId:"0215281", born:date('1987-12-28'), name:"Thomas Dekker", bio:"Thomas Alexander Dekker (born December 28, 1987) is an American film and television actor and a musician.  He is also a singer and has written and produced two albums.  He is best known for his roles as John Connor in Terminator: The Sarah Connor Chronicles, Nick Szalinski on Honey, I Shrunk the Kids: The TV Show, and Zach on Heroes...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vnvau503DLJOXxLkBaDCoX5iTwY.jpg", url:"https://themoviedb.org/person/34199"}}, {tmdbId:"58754", properties:{bornIn:"Fort Myers, Florida, USA", imdbId:"2247245", born:date('1988-01-07'), name:"Haley Bennett", bio:"Haley Bennett (born Haley Loraine Keeling; January 7, 1988) is an American actress and singer.  She made her film debut as pop star Cora Corman in the rom-com Music and Lyrics (2007) and has since appeared in The Haunting of Molly Hartley (2008),  The Hole (2009),  The Equalizer (2014), Kristy (2014), Hardcore Henry (2015), The Magnificent Seven (2016), The Girl on the Train (2016), Thank You for Your Service (2017) and Swallow (2019)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8HRgGypSwHeI27ffmcAELNoxIOw.jpg", url:"https://themoviedb.org/person/58754"}}, {tmdbId:"231547", properties:{bornIn:"Warren, Ohio, USA", imdbId:"3024712", born:date('1985-05-09'), name:"Chris Zylka", bio:"Chris Zylka (born May 9, 1985) is an American actor and model.  He has played a recurring role as Gabe Lammotti on Disney Channel's Hannah Montana.  Zylka appeared in the Dangerous Muse music video for \"The Rejection. \" Zylka will portray Flash Thompson in the upcoming Spider-Man reboot...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wxV6WMIdsvwXkMaCqe7WpRE0EM7.jpg", url:"https://themoviedb.org/person/231547"}}, {tmdbId:"7706", properties:{bornIn:"Marseille, France", imdbId:"0581953", born:date('1981-10-01'), name:"Roxane Mesquida", bio:"Roxane Mesquida (born 1 October 1981) is a French actress. \n\nBorn in Marseille, Bouches-du-Rhône, France, Mesquida grew up in Le Pradet though, a little town located between Hyères and Toulon in the Var département.  She was discovered at the age of 13, while walking on a road in her region, by the director Manuel Pradal who was in the middle of the casting process for his movie Marie Baie des Anges (Mary from the Bay of Angels with Vahina Giocante and Emmanuelle Béart) at the time...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9Au2cGIJKxLXbqvOTZTObUuEAXd.jpg", url:"https://themoviedb.org/person/7706"}}, {tmdbId:"61263", properties:{bornIn:"Palm Beach County, Florida, USA", imdbId:"1711114", born:date('1996-07-22'), name:"Skyler Gisondo", bio:"Skyler Gisondo (July 22, 1996 in Palm Beach County, Florida, USA) is an actor known for the Air Bud movies, The Amazing Spider-Man (2012), Night at the Museum: Secret of the Tomb (2014), Vacation (2015), Santa Clarita Diet (2017-2019) and Feast of the Seven Fishes (2019)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lJ6Sh5duegwjpoKF0QmiFHbBDXr.jpg", url:"https://themoviedb.org/person/61263"}}, {tmdbId:"1286744", properties:{bornIn:"Orange County, California, USA", imdbId:"4347315", born:date('2003-08-19'), name:"Steele Stebbins", url:"https://themoviedb.org/person/1286744"}}, {tmdbId:"114725", properties:{bornIn:"Sendai City, Miyagi Prefecture, Japan", imdbId:"1959800", born:date('1990-11-15'), name:"Kanata Hongô", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5BUmrqD3nbER1XV3ASSwFZitwwv.jpg", url:"https://themoviedb.org/person/114725"}}, {tmdbId:"144591", properties:{bornIn:"Seoul, South Korea", imdbId:"3393343", born:date('2000-07-31'), name:"Sae-ron Kim", bio:"From Wikipedia, the free encyclopedia. \n\nKim Sae-ron  (born July 31, 2000) is South Korean actress who best known for her roles A Brand New Life (2009) and The Man From Nowhere (2010) which she won Best New Actress at Korean Film Awards. \n\nDescription above from the Wikipedia article Kim Sae-ron, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8lV5HPb6M8gvbYLQ03nRMBTipwQ.jpg", url:"https://themoviedb.org/person/144591"}}, {tmdbId:"36594", properties:{bornIn:"Hammersmith, London, England, UK", imdbId:"1017334", born:date('1989-07-21'), name:"Juno Temple", bio:"Juno Violet Temple (born 21 July 1989) is an English actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mQJoYCY25X3Vnp8yct8AeDVHrT3.jpg", url:"https://themoviedb.org/person/36594"}}, {tmdbId:"573773", properties:{bornIn:"Wigan, UK", imdbId:"4030776", born:date('1970-07-17'), name:"Laurence R. Harvey", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/creAwfzRydEocUpWklkXHswsT6U.jpg", url:"https://themoviedb.org/person/573773"}}, {tmdbId:"1080026", properties:{imdbId:"4498683", name:"Maddi Black", url:"https://themoviedb.org/person/1080026"}}, {tmdbId:"1080027", properties:{imdbId:"4498656", name:"Kandace Caine", url:"https://themoviedb.org/person/1080027"}}, {tmdbId:"82163", properties:{bornIn:"New York City, New York, USA", imdbId:"3246926", born:date('1996-10-29'), name:"Christopher Jordan Wallace", bio:"C. J.  Wallace is an American actor and musician.  He is the son of the late Notorious BIG and singer Faith Evans...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iZgRYqidCRFB3JQQZ0C2jT0qRTf.jpg", url:"https://themoviedb.org/person/82163"}}, {tmdbId:"1261694", properties:{bornIn:"Mogadischu", imdbId:"5831542", born:date('1985-04-10'), name:"Barkhad Abdi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/utfeg8GnGyW3aVNcRfhII9RCXB6.jpg", url:"https://themoviedb.org/person/1261694"}}, {tmdbId:"1266859", properties:{bornIn:"Nairobi, Kenya", imdbId:"5831543", born:date('1994-06-05'), name:"Barkhad Abdirahman", url:"https://themoviedb.org/person/1266859"}}, {tmdbId:"141373", properties:{imdbId:"4148609", name:"David Bierend", url:"https://themoviedb.org/person/141373"}}, {tmdbId:"87220", properties:{imdbId:"1705210", name:"Brian Boland", url:"https://themoviedb.org/person/87220"}}, {tmdbId:"141374", properties:{bornIn:"Philadelphia, Pennsylvania, USA", imdbId:"1454378", born:date('1986-05-22'), name:"Molly Ephraim", bio:"Molly Ephraim (born May 22, 1986) is an American actress who has appeared in films, on television and in Broadway, off-Broadway and regional theatre productions.  She is best known for playing the role of Wendy Greenhut in the 2008 film College Road Trip, and as Ali in Paranormal Activity 2 and Paranormal Activity: The Marked Ones...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a1lr7LFEVqoOCBrUmmo9I3wyB6i.jpg", url:"https://themoviedb.org/person/141374"}}, {tmdbId:"112561", properties:{bornIn:"Guildford, Surrey, England, UK", imdbId:"2934314", born:date('1989-03-18'), name:"Lily Collins", bio:"An English and American actress, model, and writer, known for her roles in the films The Blind Side, Stuck In Love, Mirror Mirror, Love, Rosie, To The Bone, Okja and Extremely Wicked, Shockingly Evil and Vile.   Description above from the Wikipedia article Lily Collins, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kXx7w4MyCzpsSQb40mVJMd2f2ek.jpg", url:"https://themoviedb.org/person/112561"}}, {tmdbId:"83356", properties:{bornIn:"London, England, UK", imdbId:"2570429", born:date('1988-11-22'), name:"Jamie Campbell Bower", bio:"An English actor who is best known for his role as Anthony Hope in Tim Burton's Sweeney Todd: The Demon Barber of Fleet Street, his role of Caius in The Twilight Saga: New Moon and his role of King Arthur in the Starz original series Camelot.  He also appeared as the young Gellert Grindelwald in the two-part Harry Potter and the Deathly Hallows and will play Jace Wayland in the upcoming film adaption of the Mortal Instruments (series)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wzuENDUCak8HKRh72Jj7p3BQ7NY.jpg", url:"https://themoviedb.org/person/83356"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"1075355", properties:{bornIn:"Paris, France", imdbId:"0922136", born:date('1987-08-11'), name:"Jemima West", bio:"An Anglo-French actress.  She is bilingual, growing up most of her life in Paris, France.  She is best known for her role as Isabelle Lightwood in the The Mortal Instruments series City of Bones...", url:"https://themoviedb.org/person/1075355"}}, {tmdbId:"567269", properties:{bornIn:"Berkshire, England, UK", imdbId:"3726887", born:date('1989-09-14'), name:"Jessica Brown Findlay", bio:"Jessica Rose Brown Findlay (born 14 September 1989), known professionally as Jessica Brown Findlay, is an English actress, best known for playing Lady Sybil Crawley in the ITV series Downton Abbey and Emelia Conan Doyle in the British comedy-drama film Albatross.  In 2014, she starred as Beverly Penn in the film adaptation of the Mark Helprin novel Winter's Tale.  The following year, she co-starred in Paul McGuigan's Victor Frankenstein (2015)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xrvuOGSkS0ufxQohk2DhUV57QmE.jpg", url:"https://themoviedb.org/person/567269"}}, {tmdbId:"72855", properties:{bornIn:"Birmingham, West Midlands, England, UK", imdbId:"0428065", born:date('1983-10-17'), name:"Felicity Jones", bio:"Felicity Jones (born 17 October 1983) is an English actress from Birmingham.  She is best known to television audiences for her role as the school bully Ethel Hallow in the first series of The Worst Witch (she was replaced by Katie Allen for series two and three) and its sequel Weirdsister College.  Jones also co-starred in Ricky Gervais &amp; Stephen Merchant's feature Cemetery Junction...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/35KdWSfTldNEdsn4MUGFIRoxJEu.jpg", url:"https://themoviedb.org/person/72855"}}, {tmdbId:"142182", properties:{imdbId:"2505304", name:"Sean Bott", url:"https://themoviedb.org/person/142182"}}, {tmdbId:"84667", properties:{bornIn:"Buenos Aires, Argentina", imdbId:"1089900", born:date('1978-10-28'), name:"Martina Gusman", bio:"From Wikipedia, the free encyclopedia\n\nMartina Gusmán (born 28 October 1978) is an Argentine actress and film producer.  She starred in the 2010 film Carancho, which was entered into the Un Certain Regard section at the 2010 Cannes Film Festival.  In 2011 she was a member of the jury for the main competition at the 2011 Cannes Film Festival...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/15My37mfaK8IV7CM5SsqfIxe2Zq.jpg", url:"https://themoviedb.org/person/84667"}}, {tmdbId:"970399", properties:{imdbId:"0916352", name:"Carlos Weber", url:"https://themoviedb.org/person/970399"}}, {tmdbId:"1445128", properties:{imdbId:"3437258", name:"José Luis Arias", url:"https://themoviedb.org/person/1445128"}}, {tmdbId:"154091", properties:{bornIn:"Los Angeles, California, USA ", imdbId:"0932831", born:date('1961-10-30'), name:"Larry Wilmore", bio:"Elister L.  Wilmore is an American comedian, writer, producer, and actor.  Wilmore served as the \"Senior Black Correspondent\" on The Daily Show from 2006 to 2014, and hosted The Nightly Show with Larry Wilmore in 2015 and 2016.  He is also the creator of the sitcom The Bernie Mac Show...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6Z55cIMHa50Wy3EEP8uCaK2sVGM.jpg", url:"https://themoviedb.org/person/154091"}}, {tmdbId:"1572043", properties:{name:"Bettina Bresnan", url:"https://themoviedb.org/person/1572043"}}, {tmdbId:"516722", properties:{imdbId:"2516622", name:"D.R. Anderson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2KFgJCOdkdYKtGkdG4pPpbdaNef.jpg", url:"https://themoviedb.org/person/516722"}}, {tmdbId:"6951", properties:{bornIn:"Murray, Kentucky, USA", imdbId:"0114868", born:date('1963-09-07'), name:"W. Earl Brown", url:"https://themoviedb.org/person/6951"}}, {tmdbId:"1081511", properties:{imdbId:"0673662", name:"Kym Perfetto", url:"https://themoviedb.org/person/1081511"}}, {tmdbId:"222330", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"1779870", born:date('1983-08-07'), name:"Brit Marling", bio:"Brit Heyworth Marling (born August 7, 1983) is an American writer, producer, director, and actress.  After majoring in economics at Georgetown University, Brit moved to Los Angeles with friends Mike Cahil and Zal Batmanglij to pursue screenplay writing and acting.  Marling was born in Chicago, Illinois.  She was named \"Brit\" after her Norwegian maternal great-grandmother.  She graduated from Georgetown University in 2005 with degrees in economics and studio art, and was her class Valedictorian...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xeHQUIDSDFPWmvIbn9iIl98j9ih.jpg", url:"https://themoviedb.org/person/222330"}}, {tmdbId:"1114903", properties:{imdbId:"3211972", name:"Matthew-Lee Erlbach", url:"https://themoviedb.org/person/1114903"}}, {tmdbId:"1301641", properties:{imdbId:"4544251", name:"DJ Flava", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2Zb5mSAlYFLifHPRcRbSzVuv0UN.jpg", url:"https://themoviedb.org/person/1301641"}}, {tmdbId:"130782", properties:{bornIn:"Milwaukee, Wisconsin, USA", imdbId:"1221906", born:date('1985-03-31'), name:"Jessica Szohr", bio:"Jessica Karen Szohr (born March 31, 1985) is an American actress.  Szohr began her screen career starring on television shows such as CSI: Miami and What About Brian.  She gained recognition in 2007 with her breakthrough role as Vanessa Abrams on The CW series Gossip Girl. \n\nDescription above from the Wikipedia article Jessica Szohr, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bFhRVdzOj3zVbtNARmEL50wyz7J.jpg", url:"https://themoviedb.org/person/130782"}}, {tmdbId:"223286", properties:{bornIn:"Barreiros, Pernambuco, Brazil", imdbId:"2046691", born:date('1978-08-22'), name:"Irandhir Santos", bio:"Irandhir Gleriston Santos Pinto is a Brazilian actor.  Born in Barreiros, Pernambuco, Irandhir lived in several cities in the countryside of Pernambuco during his childhood.  In 2003, he graduated in performing arts degree course at the Federal University of Pernambuco.  Since then, acted in some plays,  television mini-series and several movies...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8YgE3x1YFHvd6nrPIUEdOTuyR0R.jpg", url:"https://themoviedb.org/person/223286"}}, {tmdbId:"74266", properties:{bornIn:"Lincoln, Nebraska, U.S.", imdbId:"0155515", born:date('1941-01-30'), name:"Dick Cheney", bio:"From Wikipedia, the free encyclopedia. \n\nRichard Bruce \"Dick\" Cheney (born January 30, 1941) served as the 46th Vice President of the United States (2001-2009), under George W.  Bush. \n\nCheney was born in Lincoln, Nebraska, but was primarily raised in Sumner, Nebraska and Casper, Wyoming.  He began his political career as an intern for Congressman William A...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jxvy9xjtKVa5EE51mp5jYqtJki0.jpg", url:"https://themoviedb.org/person/74266"}}, {tmdbId:"587823", properties:{bornIn:"Sydney, Australia", imdbId:"2129444", born:date('1994-08-15'), name:"Alice Englert", bio:"New Zealand-born Alice Allegra Englert was born on June 15, 1994.  She made her screen debut in the short films ‘Listen’ by Paula Maling in 2001 and ‘The Water Diary’, written and directed by Englert’s mother, Academy Award-winner Jane Campion.  Her father is film-maker Colin Englert and she has a young half-brother named Gabriel. \n\nEarly in Englert’s career, she managed to land a supporting role in the romantic comedy ‘Singularity’, starring Josh Hartnett and Neve Campbell...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lEXLJpH29u2fTTqOIEsxEtSQP8C.jpg", url:"https://themoviedb.org/person/587823"}}, {tmdbId:"550839", properties:{bornIn:"Neiva, Huila, Colombia", imdbId:"4318679", born:date('1986-10-07'), name:"Juan 'Doc Restrepo", died:date('2007-07-22'), url:"https://themoviedb.org/person/550839"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"550840", properties:{imdbId:"4317669", name:"Dan Kearney", url:"https://themoviedb.org/person/550840"}}, {tmdbId:"550841", properties:{imdbId:"4317871", name:"LaMonta Caldwell", url:"https://themoviedb.org/person/550841"}}, {tmdbId:"122765", properties:{bornIn:"New Zealand", imdbId:"2034752", born:date('1997-06-08'), name:"James Rolleston", bio:"James Rolleston (born 8 June 1997) is a New Zealand actor known for the films Boy and The Dark Horse...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ybHxB4pBDsq5LJOnvwT9JIOiEmH.jpg", url:"https://themoviedb.org/person/122765"}}, {tmdbId:"122757", properties:{bornIn:"Minginui, New Zeland", imdbId:"3725110", born:date('2000-04-03'), name:"Te Aho Eketone-Whitu", bio:"Te Aho Eketone-Whitu is an actor, known for Boy (2010) and Weekend Graffiti (2012)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/reA7HtZNg6X6BQTcwzu8lUoRcOF.jpg", url:"https://themoviedb.org/person/122757"}}, {tmdbId:"1753255", properties:{name:"Moerangi Tihore", url:"https://themoviedb.org/person/1753255"}}, {tmdbId:"36060", properties:{imdbId:"0141307", name:"Price Carson", bio:"Price Carson is an American film and television actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7ChPwx8czQcWaBAfou0bCnF5AO5.jpg", url:"https://themoviedb.org/person/36060"}}, {tmdbId:"1149894", properties:{imdbId:"3424741", name:"Mike Howard", url:"https://themoviedb.org/person/1149894"}}, {tmdbId:"75073", properties:{bornIn:"Woking - Surrey - England", imdbId:"2070427", born:date('1982-07-23'), name:"Tom Mison", bio:"From Wikipedia, the free encyclopedia\n\nThomas James \"Tom\" Mison (born 23 July 1982 height 6' 1\" (1,85 m)) is an English actor and writer.  He is best known for his work in the European premiere of Andrew Bovell's When the Rain Stops Falling at the Almeida Theatre, Posh at the Royal Court Theatre and the Duke of York's Theatre, and Prince Hal in Henry IV Parts 1 and 2.  Mison is currently starring as Ichabod Crane on the Fox series Sleepy Hollow. \n\nMison was raised in the town of Woking, Surrey...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aBDtRCCGgE3Zug2krAhL2IfyvWO.jpg", url:"https://themoviedb.org/person/75073"}}, {tmdbId:"18052", properties:{bornIn:"Tacoma, Washington, USA", imdbId:"1997480", born:date('1998-01-12'), name:"Nathan Gamble", bio:"From Wikipedia, the free encyclopedia. \n\nNathan Gamble (born January 12, 1998) is an American child actor who made his feature film debut in Babel (2006), for which he was nominated for a 2007 Young Artist Award. \n\nGamble was born in Tacoma, Washington, the son of theater directors who run a drama camp for children.  His additional screen credits include Dry Rain (2007), Saving Sam (2007), Diggers (2007), The Mist (2007), The Dark Knight (2008), and Marley & Me (2008)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/utbynIWozMtWsRZH9nt1BE2ae5P.jpg", url:"https://themoviedb.org/person/18052"}}, {tmdbId:"128628", properties:{bornIn:"Richmond, Virginia, USA", imdbId:"2174090", born:date('1981-11-09'), name:"Scottie Thompson", bio:"Susan Scott \"Scottie\" Thompson (born November 9, 1981, height 5' 7\" (1,70 m)) is an American film, television and stage actress. \n\nThompson grew up in Richmond, Virginia, where she attended Collegiate School.  From an early age she began learning ballet, jazz and modern dance.  She danced with the Richmond Ballet for many years, took a year off after graduating to dance with the company, and then went on to study for a degree in Performance Studies and Literature at Harvard University...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/k1O50oeKg2pfvkTGgSCErkKAzdI.jpg", url:"https://themoviedb.org/person/128628"}}, {tmdbId:"128629", properties:{bornIn:"Detroit, Michigan, U.S.", imdbId:"3706952", born:date('1985-02-06'), name:"Crystal Reed", bio:"Crystal Reed is an American actress.  She is perhaps best known for her role as Denise in the feature film Skyline and as Allison Argent in the MTV series Teen Wolf. \n\nDescription above from the Wikipedia article Crystal Reed, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/884tMEhSdzV7I8BpvIYLvhFnyYP.jpg", url:"https://themoviedb.org/person/128629"}}, {tmdbId:"2112237", properties:{name:"Jonathan Alter", url:"https://themoviedb.org/person/2112237"}}, {tmdbId:"1262638", properties:{imdbId:"4130317", name:"Matthew Lederman", url:"https://themoviedb.org/person/1262638"}}, {tmdbId:"1262639", properties:{imdbId:"4130015", name:"Alona Pulde", url:"https://themoviedb.org/person/1262639"}}, {tmdbId:"577674", properties:{imdbId:"3224338", name:"T. Colin Campbell", url:"https://themoviedb.org/person/577674"}}, {tmdbId:"14670", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0001672", born:date('1933-06-08'), name:"Joan Rivers", bio:"Joan Alexandra Molinsky, known professionally as Joan Rivers, was an American comedian, actress, writer, producer, and television host.  She was noted for her often controversial comedic persona—heavily self-deprecating and sharply acerbic, especially towards celebrities and politicians...", died:date('2014-09-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uIDEnLdh5ofM4nX5etIYUXxpLZH.jpg", url:"https://themoviedb.org/person/14670"}}, {tmdbId:"1545967", properties:{name:"Larry A. Thompson", url:"https://themoviedb.org/person/1545967"}}, {tmdbId:"222274", properties:{bornIn:"San Jose, California, USA", imdbId:"2188369", born:date('1976-11-06'), name:"Pat Tillman", bio:"From Wikipedia, the free encyclopedia. \n\nPatrick Daniel \"Pat\" Tillman Jr. (November 6, 1976 – April 22, 2004) was an American football player who left his professional career and enlisted in the United States Army in June 2002 in the aftermath of the September 11, 2001, attacks.  He joined the Army Rangers and served several tours in combat before he died in the mountains of Afghanistan.  The Army at first reported that Tillman had been killed by enemy fire, and Lieutenant General Stanley A...", died:date('2004-04-22'), url:"https://themoviedb.org/person/222274"}}, {tmdbId:"1539574", properties:{imdbId:"0046382", name:"Russell Baer", url:"https://themoviedb.org/person/1539574"}}, {tmdbId:"1085462", properties:{bornIn:"Los Angeles, California, USA", imdbId:"1861781", name:"Mandy Gonzalez", url:"https://themoviedb.org/person/1085462"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"1618184", properties:{bornIn:"Detroit, Michigan, USA", name:"Barbara Marineau", url:"https://themoviedb.org/person/1618184"}}, {tmdbId:"225692", properties:{bornIn:"Gamlingay, Cambridgeshire, England, United Kingdom", imdbId:"3528539", born:date('1990-06-18'), name:"Jeremy Irvine", bio:"Jeremy William Fredric Smith (born 18 June 1990), better known as Jeremy Irvine, is an English actor who made his film debut in the epic war film War Horse (2011).  In 2012, he portrayed Philip \"Pip\" Pirrip in the film adaptation of Great Expectations, and earned widespread critical acclaim for his role in the independent film Now Is Good (2012). \n\nDescription above from the Wikipedia article Jeremy Irvine licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nPeBcyemdjH7zu8fL8gu9O0lnsb.jpg", url:"https://themoviedb.org/person/225692"}}, {tmdbId:"85176", properties:{bornIn:"Washington, D.C., United States", imdbId:"1847099", born:date('1992-12-18'), name:"Bridgit Mendler", bio:"Bridgit Claire Mendler (born December 18, 1992) is an American actress, singer, musician and songwriter.  She is best known for her lead role as Teddy Duncan on the Disney Channel Original Series Good Luck Charlie and her recurring role as Juliet Van Heusen on Wizards of Waverly Place.  She has also appeared in Labor Pains, Alvin and the Chipmunks: The Squeakquel, Beverly Hills Chihuahua 2, starred in the Disney Channel Original Movie Lemonade Mouth...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8ZsU2RQpzUZ8580tkctAgU7nuXI.jpg", url:"https://themoviedb.org/person/85176"}}, {tmdbId:"95136", properties:{bornIn:"Mission Viejo, California, USA", imdbId:"1273708", born:date('1989-07-11'), name:"David Henrie", bio:"From Wikipedia, the free encyclopedia\n\nDavid Clayton Henrie (born July 11, 1989) is an American actor, rally driver, musician, and film producer.  He is noted for playing Justin Russo in Wizards of Waverly Place and Larry on That's So Raven.  He is the brother of actor Lorenzo Henrie. \n\nDescription above from the Wikipedia article David Henrie, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1NuD0ltILDRRCMfmLPHM8bSfzhb.jpg", url:"https://themoviedb.org/person/95136"}}, {tmdbId:"139147", properties:{imdbId:"2419914", name:"Laurie Simmons", url:"https://themoviedb.org/person/139147"}}, {tmdbId:"139148", properties:{imdbId:"2420346", name:"Grace Dunham", url:"https://themoviedb.org/person/139148"}}, {tmdbId:"139149", properties:{imdbId:"1852529", name:"Rachel Howe", url:"https://themoviedb.org/person/139149"}}, {tmdbId:"114461", properties:{bornIn:"  Madrid, Spain", imdbId:"1693112", born:date('1976-03-27'), name:"Carlos Areces", bio:"Actor, cantante e historietista español.  Como dibujante, ha ganado los premios Mejor Serie de Animación en Animadrid 2001, Josep Toutain al Autor Revelación 2007 otorgado en el Salón Internacional del Cómic de Barcelona y el Premio Ivá 2009.  Como actor, ha ganado en 2011 el Sant Jordi de interpretación ex-aequo con Antonio de la Torre, el premio Un Futuro de Cine de Cinema Jove, el Vicious Best Actor en el festival esloveno de Grossmann...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aLir4uS9YBSXdLsGU7qSl3gC51G.jpg", url:"https://themoviedb.org/person/114461"}}, {tmdbId:"512958", properties:{bornIn:"Santa Cruz de Tenerife, Canary Islands, Spain", imdbId:"3016653", born:date('1985-09-21'), name:"Carolina Bang", bio:"Carolina Herrera Bang is a Spanish actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hpiFsBwB2L1KDQZrQoAsFA1pl5d.jpg", url:"https://themoviedb.org/person/512958"}}, {tmdbId:"269695", properties:{bornIn:"Cádiz, Spain", imdbId:"0848110", born:date('1963-07-05'), name:"Manuel Tallafé", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3K3OQVM7LcF0TKz0NP6AKinLMX3.jpg", url:"https://themoviedb.org/person/269695"}}, {tmdbId:"144650", properties:{bornIn:"Nagoya, Aichi Prefecture, Japan", imdbId:"1435774", born:date('1987-10-08'), name:"Aya Hirano", bio:"Aya Hirano is a Japanese voice actress and singer.  After graduating from high school, she began seriously pursuing her voice actress and solo singing career.  Her big break came in 2006, when she was cast as the voice of Suzumiya Haruhi, the title character of The Melancholy of Haruhi Suzumiya...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eHnM9NL0WKm977YIrpmmuCyHu5k.jpg", url:"https://themoviedb.org/person/144650"}}, {tmdbId:"144655", properties:{bornIn:"Saitama Prefecture, Japan", imdbId:"0837523", born:date('1980-10-11'), name:"Tomokazu Sugita", bio:"Sugita Tomokazu is a voice actor (seiyuu) who was born on October 11, 1980 in Saitama Prefecture, Japan.  He is employed by Atomic Monkey; his bloodtype is B. \n\nSugita and fellow seiyuu Narita Ken are sometimes referred to as \"brothers\" due to a joke made during Live Pastel Collection 2003.  During an Omaera No Tame Darou event, hosts Morikawa Toshiyuki and Hiyama Nobuyuki asked Sugita how they were similar...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tW9VGnxmdhy3XTWfssk8ySrDu7K.jpg", url:"https://themoviedb.org/person/144655"}}, {tmdbId:"144648", properties:{bornIn:"Utsunomiya, Tochigi Prefecture, Japan", imdbId:"2276741", born:date('1980-11-18'), name:"Minori Chihara", bio:"Chihara Minori was born November 18, 1980 in in the city of Utsunomiya, Tochigi Prefecture, Japan and was raised in Saitama Prefecture, Japan.  She is a voice actress (seiyuu) who has had roles in several anime series, and a J-pop singer.  As a seiyuu, she works under the agency Avex Planning & Development while in her musical career, she has been signed under King Records, Avex Trax, and is now currently with Lantis...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wjcbKo6zxakENOqR6PfaXgKO0uO.jpg", url:"https://themoviedb.org/person/144648"}}, {tmdbId:"144649", properties:{bornIn:"Aichi Prefecture, Japan", imdbId:"1785238", born:date('1980-08-28'), name:"Yûko Gotô", bio:"Gotou Yuuko, born August 28, 1975 in Aichi Prefecture, Japan, is a voice actress (seiyuu) who formerly worked for Production Baobab.  In direct contrast to her cute-and-vulnerable moé typecasting, Gotou in real life is a devotee of biker culture who dresses and acts as such when not working, right down to her motorcycle.  This is parodied in the 23rd episode of Lucky Star, in which she appears as a masculine Bousouzoku-styled caricature of herself called Gottouuza-sama...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/muO7vb0SbsmJQqo174rlZUG9mYv.jpg", url:"https://themoviedb.org/person/144649"}}, {tmdbId:"1263732", properties:{imdbId:"2798376", name:"Timo Aalto", url:"https://themoviedb.org/person/1263732"}}, {tmdbId:"1263733", properties:{imdbId:"4006042", name:"Pekka Ahonen", url:"https://themoviedb.org/person/1263733"}}, {tmdbId:"1263734", properties:{imdbId:"4005603", name:"Aarne Aksila", url:"https://themoviedb.org/person/1263734"}}, {tmdbId:"1263735", properties:{imdbId:"4005843", name:"Mauno Alasuutari", url:"https://themoviedb.org/person/1263735"}}, {tmdbId:"204588", properties:{imdbId:"2089529", name:"Sarah Mahoney", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zyKubTKrEDIWuhCGDFm2ZOGhLPp.jpg", url:"https://themoviedb.org/person/204588"}}, {tmdbId:"98292", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0650945", born:date('1973-08-11'), name:"Roxana Ortega", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tAkMeufq6ruljugyHhjvtIe72H4.jpg", url:"https://themoviedb.org/person/98292"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"79082", properties:{bornIn:"Los Angeles, California, USA", imdbId:"1320827", born:date('1974-03-23'), name:"Randall Park", bio:"Randall Park (born March 23, 1974) is an American actor, comedian, writer, and director.   Park was born and raised in Los Angeles, California, to South Korean parents.  Park graduated from Hamilton High School's Humanities Magnet Program.  Park attended UCLA and finished with an undergraduate degree in English and creative writing and a master’s degree in Asian–American studies.   While attending UCLA, Park co-founded the LCC Asian American Theater Group...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/GpERQxWcT3TXLHpH8b6hIyUazK.jpg", url:"https://themoviedb.org/person/79082"}}, {tmdbId:"78147", properties:{bornIn:" Paris, France", imdbId:"1392388", born:date('1981-02-22'), name:"Elodie Yung", bio:"Yung was born in Paris on February 22, 1986.  Her mother is French and her father is of Cambodian origin.  She graduated from The London Academy of Music and Dramatic Art and also has a Master Degree in Law from La Sorbonne.  She has practiced Karate for over ten years.  Her first roles were on TV.  Following her 2004 film debut as female lead Tsu in Les fils du vent she played the gang lord Tao in District 13: Ultimatum...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vW3o4X2N8ABk6nvoKWZXd9UEQ1A.jpg", url:"https://themoviedb.org/person/78147"}}, {tmdbId:"1208782", properties:{imdbId:"4240793", name:"Angela Wesselman-Pierce", url:"https://themoviedb.org/person/1208782"}}, {tmdbId:"60899", properties:{bornIn:"Lubbock, Texas, USA", imdbId:"2003700", born:date('1985-07-18'), name:"Chace Crawford", bio:"Christopher Chace Crawford (born July 18, 1985) is an American actor, known for his portrayal of Nate Archibald on The CW's teen drama series Gossip Girl.  He is also known for starring in the films The Covenant (2006), The Haunting of Molly Hartley (2008), Twelve (2010), and What to Expect When You're Expecting (2012).  In 2015, he portrayed Billy LeFever in ABC's short-lived drama series Blood & Oil...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n1rsT0D8O1P5soZqzOn3PeGuHJU.jpg", url:"https://themoviedb.org/person/60899"}}, {tmdbId:"18050", properties:{bornIn:"Conyers, Georgia, USA", imdbId:"1102577", born:date('1998-04-09'), name:"Elle Fanning", bio:"Mary Elle Fanning (born April 9, 1998) is an American actress and singer.  She is the younger sister of actress Dakota Fanning and mainly known for her starring roles in Phoebe in Wonderland, Somewhere, Maleficent, About Ray, and as Jesse in 2016's The Neon Demon. \n\nIn 2011, Fanning starred in her breakout role as Alice Dainard in J.  J.  Abrams' sci-fi-drama, Super 8.  For this role, she received positive reviews and was often cited as one of the film's best aspects...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e8CUyxQSE99y5IOfzSLtHC0B0Ch.jpg", url:"https://themoviedb.org/person/18050"}}, {tmdbId:"2665595", properties:{name:"Debora Guetta", url:"https://themoviedb.org/person/2665595"}}, {tmdbId:"124644", properties:{bornIn:"Minneapolis, Minnesota, USA", imdbId:"3006818", born:date('1988-11-09'), name:"Analeigh Tipton", bio:"Analeigh Christian Tipton (born November 9, 1988) is an American figure skater, actress, and fashion model, most noted for placing third onCycle 11 of America's Next Top Model and for her roles in the films Crazy, Stupid, Love and Warm Bodies...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sEo8EO1JeutUldCTsQnDefXRmcT.jpg", url:"https://themoviedb.org/person/124644"}}, {tmdbId:"111690", properties:{bornIn:"Tokyo, Japan", imdbId:"0559381", born:date('1977-06-10'), name:"Takako Matsu", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/igsX8umKa85ddcEGHs10IUAYAU1.jpg", url:"https://themoviedb.org/person/111690"}}, {tmdbId:"72764", properties:{bornIn:"日本・東京都", imdbId:"0454128", born:date('1976-04-10'), name:"Yoshino Kimura", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7oaPKv7lPmeFa2XhNLg3T1E07wC.jpg", url:"https://themoviedb.org/person/72764"}}, {tmdbId:"124402", properties:{bornIn:"Tokyo, Japan", imdbId:"2347861", born:date('1989-08-15'), name:"Masaki Okada", bio:"Masaki Okada (岡田 将生 Okada Masaki, born August 15, 1989 in Tokyo) is a Japanese actor.  He is best known for his roles as Sekime Kyogo in the drama Hanazakari no Kimitachi e and as Takuma Kakinouchi in the 2009 film I Give My First Love to You...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dgcuWtceAE5lLmJs6D4rhkMKWH3.jpg", url:"https://themoviedb.org/person/124402"}}, {tmdbId:"559411", properties:{imdbId:"3945747", born:date('1995-06-14'), name:"Yukito Nishii", url:"https://themoviedb.org/person/559411"}}, {tmdbId:"17181", properties:{bornIn:"New York, New York City, USA", imdbId:"1339223", born:date('2001-08-06'), name:"Ty Simpkins", bio:"Ty Keegan Simpkins (born August 6, 2001) is an American teen actor.  His major film roles include Iron Man 3 (2013), alongside James Wan's horror stories Insidious its sequel Insidious: Chapter 2, and Jurassic World (2015).  He appeared with his real life sister, Ryan Simpkins, in the films Pride and Glory, Revolutionary Road, and Arcadia. \n\nDescription above from the Wikipedia Ty Simpkins licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8FyJcMFmPdCSfz2Zc5ZcAKrIorj.jpg", url:"https://themoviedb.org/person/17181"}}, {tmdbId:"7401", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"0005417", born:date('1943-10-12'), name:"Lin Shaye", bio:"Actress / Performer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4exPdae0idE2sYHMewimMFGNmsd.jpg", url:"https://themoviedb.org/person/7401"}}, {tmdbId:"225610", properties:{bornIn:"Chorley, Lancashire, England, UK", imdbId:"0318543", born:date('1984-03-09'), name:"Joseph Gilgun", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/A8wFwzX8ejdfgeNG7OPbz87ZCrs.jpg", url:"https://themoviedb.org/person/225610"}}, {tmdbId:"90777", properties:{bornIn:"New York City - New York - USA", imdbId:"0058772", born:date('1971-07-14'), name:"Alison Bartlett", bio:"Alison Bartlett O'Reilly (b.  July 14, 1971) is a New York-based actress who has portrayed Gina Jefferson on Sesame Street since 1987, and has reprised the role in various related specials, direct-to-video productions, and The Adventures of Elmo in Grouchland. \n\nBartlett began her career as a child actress, appearing at the age of 12 in the 1984 stage production of Landscape of The Body, co-starring Dann Florek and directed by Gary Sinise...", url:"https://themoviedb.org/person/90777"}}, {tmdbId:"1614459", properties:{imdbId:"3638077", name:"Jake Ryan", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5r50ybNPDsYIhk8mlcLeUTi1mnZ.jpg", url:"https://themoviedb.org/person/1614459"}}, {tmdbId:"1651953", properties:{bornIn:"Baltimore, Maryland, United States", imdbId:"5647921", born:date('1965-01-01'), name:"Rudy Eisenzopf", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1pDV75qlQwWZ7wLWoE5zenedYBe.jpg", url:"https://themoviedb.org/person/1651953"}}, {tmdbId:"1651954", properties:{imdbId:"2517511", name:"Casey Groves", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6jtWCb1LvJbLhcmtcWaf97PkK3H.jpg", url:"https://themoviedb.org/person/1651954"}}, {tmdbId:"175630", properties:{bornIn:"Kenosha, Wisconsin, USA", imdbId:"0847857", born:date('1978-12-13'), name:"Charlie Talbert", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4OHHVt0BtpfSYcOTbQTejplFEtD.jpg", url:"https://themoviedb.org/person/175630"}}, {tmdbId:"127432", properties:{bornIn:"British Hong Kong", imdbId:"1239049", born:date('1983-05-16'), name:"Tien You Chui", bio:"Chui Man-kin (born May 16, 1983), better known as Chui Tien-you or Tien You or \"TY\", is an Hong Kong actor, singer, writer and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zX1WToT0vYqecAtHHuyoZPfB4v5.jpg", url:"https://themoviedb.org/person/127432"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"1106973", properties:{bornIn:"Moscow, Soviet Union [now Russia]", imdbId:"4586999", born:date('1990-09-25'), name:"Daria Strokous", url:"https://themoviedb.org/person/1106973"}}, {tmdbId:"1709183", properties:{imdbId:"1004662", name:"Charlotte Marshall-Fricker", url:"https://themoviedb.org/person/1709183"}}, {tmdbId:"1358760", properties:{bornIn:"Melbourne - Australia", imdbId:"1934381", name:"Fiona Choi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8yk4lu0lNkMOldYtcUkGJkJOGtA.jpg", url:"https://themoviedb.org/person/1358760"}}, {tmdbId:"183812", properties:{imdbId:"0641816", born:date('1972-08-06'), name:"Jason O'Mara", bio:"Jason O'Mara (born August 6, 1972) is an Irish actor.  He has starred in the American television network dramas In Justice, Life on Mars, Terra Nova and Vegas.  He is also known for voicing DC Comics' superhero Batman in the animated films Son of Batman, Batman vs.  Robin, and Batman: Bad Blood as well as Justice League: War and Justice League: Throne of Atlantis.   Description above from the Wikipedia Jason O'Mara licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hYylPvwMALoQU09r7tvCU24thh0.jpg", url:"https://themoviedb.org/person/183812"}}, {tmdbId:"10582", properties:{bornIn:"Evanston, Illinois, USA", imdbId:"0839326", born:date('1971-12-30'), name:"Daniel Sunjata", bio:"From Wikipedia, the free encyclopedia. \n\nDaniel Sunjata (born Daniel Sunjata Condon, December 30, 1971) is an American actor who performs in film, television and in the theater. \n\nDescription above from the Wikipedia article Daniel Sunjata, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w3Wa0d7j2auA2R8FQvjrgfB3ozo.jpg", url:"https://themoviedb.org/person/10582"}}, {tmdbId:"206177", properties:{bornIn:"Great Britain", name:"Abhin Galeya", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wrQlWBswRyWZXUyNBLpsDSbi2gO.jpg", url:"https://themoviedb.org/person/206177"}}, {tmdbId:"52891", properties:{bornIn:"Kent, England, UK", imdbId:"0121895", born:date('1981-06-30'), name:"Tom Burke", bio:"​From Wikipedia, the free encyclopedia. \n\nTom Liam Benedict Burke (born 1981) is an English actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9L2O1mAwFQcfEbaB5CHIZUvnqUW.jpg", url:"https://themoviedb.org/person/52891"}}, {tmdbId:"132217", properties:{imdbId:"1362962", name:"Jake Andolina", url:"https://themoviedb.org/person/132217"}}, {tmdbId:"1432979", properties:{imdbId:"4670877", name:"Oriah Acima Andrews", url:"https://themoviedb.org/person/1432979"}}, {tmdbId:"572038", properties:{bornIn:"Atco, New Jersey, USA", imdbId:"1290135", name:"Ken Arnold", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yxQGYkRsx2MxKNEplZsGpWXckH1.jpg", url:"https://themoviedb.org/person/572038"}}, {tmdbId:"73381", properties:{bornIn:"Antwerp, Belgium", imdbId:"0774386", born:date('1977-12-08'), name:"Matthias Schoenaerts", bio:"Matthias Schoenaerts is a Belgian actor, film producer, and graffiti artist of Flemish origin.  He made his film debut at the age of 13 in Daens, which was nominated for the Academy Award for Best Foreign Language Film...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/56abqjiihp8XS2kiktfRHXNat7w.jpg", url:"https://themoviedb.org/person/73381"}}, {tmdbId:"81685", properties:{bornIn:"New York City - New York - USA", imdbId:"0342029", born:date('1965-06-08'), name:"Frank Grillo", bio:"Frank Anthony Grillo is an American actor known for his roles in films such as Warrior (2011), The Grey (2012), End of Watch (2012) and Zero Dark Thirty (2012).  He had his first leading role in The Purge: Anarchy (2014), portraying Sergeant Leo Barnes; he reprises this role in The Purge: Election Year (2016).  He also plays the Marvel supervillain Brock Rumlow / Crossbones in the Marvel Cinematic Universe...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wqUXoQjO1RMamOWGW0YYWwybGTM.jpg", url:"https://themoviedb.org/person/81685"}}, {tmdbId:"17022", properties:{bornIn:"Derry, County Londonderry, Northern Ireland", imdbId:"2063982", born:date('1982-09-07'), name:"Antonia Campbell-Hughes", bio:"Antonia Campbell-Hughes is a Northern Irish actress and former fashion designer, best known for appearing in Jack Dee's sitcom Lead Balloon and for portraying Natascha Kampusch in 3096 Days. \n\nAfter the success of series one of Lead Balloon, Campbell-Hughes went on to be cast in a variety of comedy shows on British television, alongside Jennifer Saunders and Alex Macqueen, and went on to create her own one-woman show Bluebell Welch for MTV...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4UchUG3qoUmOZcF74WuPFuogKe5.jpg", url:"https://themoviedb.org/person/17022"}}, {tmdbId:"3730", properties:{bornIn:"Saigon, Vietnam", imdbId:"0217817", born:date('1940-09-13'), name:"Albert Delpy", bio:"Albert Delpy (born 13 September 1941) is a French actor and writer.  He has appeared in more than one hundred films since 1970. \n\nHe is the father of Julie Delpy and has appeared as her on-screen father in 2 Days in Paris and 2 Days in New York. \n\nSource: Article \"Albert Delpy\" from Wikipedia in english, licensed under CC-BY-SA 3. 0...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8j9s2hCN0IEdr7QCeHoxo5cbHTf.jpg", url:"https://themoviedb.org/person/3730"}}, {tmdbId:"1102621", properties:{imdbId:"3307918", born:date('1959-08-11'), name:"Vithaya Pansringarm", bio:"Vithaya Pansringarm (Thai: วิทยา ปานศรีงาม; born 11 August 1959) is a Thai actor best known for appearing in Only God Forgives.  He is also known in Thailand as \"Pu Vithaya\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rGEyRPrs3d9r4NHcHijzzGjP2p9.jpg", url:"https://themoviedb.org/person/1102621"}}, {tmdbId:"1840", properties:{imdbId:"1446625", name:"Gordon Brown", bio:"Scottish actor Gordon Brown following the death of his daughter from cancer in 2010.  Brown has appeared in major feature films, television, and on stage...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tKnkIuEUr2U4MKtm0opQUfkv7q.jpg", url:"https://themoviedb.org/person/1840"}}, {tmdbId:"2602385", properties:{bornIn:"Paris, France", imdbId:"1225096", born:date('1968-12-09'), name:"Alexandre Tharaud", bio:"Alexandre Tharaud (born 9 December 1968) is a French pianist.  He is active on the concert stage and has released a large and diverse discography. \n\nBorn in Paris, Tharaud discovered the music scene through his mother who was a dance teacher at the Opéra de Paris, and his father, an amateur director and singer of operettas.  Tharaud thus appeared as a child in theatres around northern France, where the family spent many weekends.  His grandfather was a violinist in Paris in the 1920s and 1930s...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hxzdqnBOYp6z9oAyWbDIWXKVwlt.jpg", url:"https://themoviedb.org/person/2602385"}}, {tmdbId:"145836", properties:{bornIn:"Downey, California, USA", imdbId:"1631435", born:date('1989-10-10'), name:"Aimee Teegarden", bio:"Aimee Richelle Teegarden (born October 10, 1989) is an American actress.  She is best known for starring as Julie Taylor in the NBC series Friday Night Lights and Jenny Randall in the horror film Scream 4. \n\nDescription above from the Wikipedia article Aimee Teegarden, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lgQjewwOl45yxmL16xuTp07es3p.jpg", url:"https://themoviedb.org/person/145836"}}, {tmdbId:"234984", properties:{bornIn:"New York City - New York - USA", imdbId:"2973459", born:date('1986-05-02'), name:"Thomas McDonell", bio:"Thomas McDonell was born on May 2, 1986.  He is an actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iR0ElrLlagBaGSsOZVphTLbU8TE.jpg", url:"https://themoviedb.org/person/234984"}}, {tmdbId:"114372", properties:{bornIn:"Hinsdale - Illinois - USA", imdbId:"2836740", born:date('1995-01-30'), name:"Danielle Campbell", bio:"Danielle Campbell (born January 30, 1995) is an American actress known for her role as Jessica Olson in the 2010 Disney Channel Original Movie Starstruck. \n\nCampbell is from Hinsdale, Illinois.  Her parents are Georganne and John Campbell.  She was discovered in a hair salon in Chicago.  Her first big break was as a guest star on Prison Break appearing in four episodes...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h3kLxMJT1SL8zfTtQPTd7mYRm8S.jpg", url:"https://themoviedb.org/person/114372"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"1212899", properties:{bornIn:"Croyden, England, UK", imdbId:"0111757", name:"Moira Brooker", bio:"Moira Brooker is an English actress.  She played Judith Hanson in the British sitcom As Time Goes By.  The programme lasted for nine series and was popular in the United Kingdom, Canada, Australia and the United States, where it is still broadcast weekdays on PBS...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/76fEu31tjRWdR8ji8ewoTLBn2Cc.jpg", url:"https://themoviedb.org/person/1212899"}}, {tmdbId:"1335635", properties:{imdbId:"0125348", name:"Paul Butterworth", url:"https://themoviedb.org/person/1335635"}}, {tmdbId:"1780254", properties:{name:"Phil Kingston", url:"https://themoviedb.org/person/1780254"}}, {tmdbId:"908548", properties:{bornIn:"Krynica-Zdrój, Poland", imdbId:"2251846", born:date('1982-06-24'), name:"Joanna Kulig", bio:"Joanna Kulig (born June 24, 1982) is a Polish film, stage, and television actress.  Kulig was born in Krynica-Zdrój, Poland.  She graduated at Ludwik Solski Academy for the Dramatic Arts...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cgeszBdZ8Z8rcEOo9wAVMZsaGmd.jpg", url:"https://themoviedb.org/person/908548"}}, {tmdbId:"62447", properties:{bornIn:"Paris, France", imdbId:"0346363", born:date('1967-10-07'), name:"Samir Guesmi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7x6FO6FGZgQAVz543d2F8Ra1Kjs.jpg", url:"https://themoviedb.org/person/62447"}}, {tmdbId:"91495", properties:{bornIn:"Rochester - New York - USA", imdbId:"0448252", born:date('1948-09-25'), name:"Mimi Kennedy", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7Nsu0AngAeUEawRUm72Qgg8RUL6.jpg", url:"https://themoviedb.org/person/91495"}}, {tmdbId:"150810", properties:{bornIn:"Stratford, Ontario, Canada", imdbId:"3595501", born:date('1994-03-01'), name:"Justin Bieber", bio:"Justin Drew Bieber  (born March 1, 1994)  is a Canadian pop/R&amp;B singer-songwriter and actor.    Bieber was discovered in 2008 by Scooter Braun,  who happened to come across Bieber's videos on YouTube and later became his manager.  Braun arranged for him to meet with Usher in Atlanta, Georgia, and Bieber was soon signed to Raymond Braun Media Group (RBMG), a joint venture between Braun and Usher, and then to a recording contract with Island Records offered by L. A.  Reid...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rLT50KKQkZnD4DFROMqkMgc4ECc.jpg", url:"https://themoviedb.org/person/150810"}}, {tmdbId:"239996", properties:{bornIn:"Georgia, USA", imdbId:"0907548", born:date('1982-06-21'), name:"Benjamin Walker", bio:"From Wikipedia, the free encyclopedia\n\nBenjamin Walker (born 1982) is an American actor, best known for his film appearances in Kinsey (as Alfred Kinsey at age 19), Harlon Block in Clint Eastwood's Flags of Our Fathers, and his critically acclaimed portrayal of Andrew Jackson in the Off- and On Broadway incarnations of Bloody Bloody Andrew Jackson. \n\nDescription above from the Wikipedia article Benjamin Walker (actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kyuRJBieEsgskbAUikDyabe4Oxh.jpg", url:"https://themoviedb.org/person/239996"}}, {tmdbId:"933383", properties:{imdbId:"4816345", name:"Gregory Berns", url:"https://themoviedb.org/person/933383"}}, {tmdbId:"933384", properties:{imdbId:"4815328", name:"Roy Blanchard", url:"https://themoviedb.org/person/933384"}}, {tmdbId:"933385", properties:{imdbId:"4816323", name:"Mihaly Csikszentmihalyi", url:"https://themoviedb.org/person/933385"}}, {tmdbId:"76556", properties:{bornIn:"Stavanger, Norway", imdbId:"1914298", born:date('1980-11-06'), name:"Pål Sverre Hagen", bio:"Pål Sverre Hagen (born 6 November 1980) is a Norwegian stage and screen actor.  He appeared in the hit Norwegian film Max Manus and played Thor Heyerdahl in the Oscar-nominated 2012 film Kon-Tiki...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gGIChTUBuNnrN8pAx4ZRhr0DOJB.jpg", url:"https://themoviedb.org/person/76556"}}, {tmdbId:"77976", properties:{bornIn:"Hamar, Norway", imdbId:"0471601", born:date('1976-01-29'), name:"Anders Baasmo Christiansen", bio:"Anders Baasmo Christiansen, born 29 January 1976 is a Norwegian actor from Hamar, Norway. \n\nHe earned his breakthrough in 2003 when he received the Amanda-price for his performance in the Norwegian picture Buddy. \n\nHe also won the TV award Gullruten in 2007 for his portrait of Henrik Ibsen in the TV-series An immortal man (\"En udødelig mann\") on NRK. \n\nChristiansen graduated from the Norwegian Acting Academy in 2000.  He started his professional career at the Trøndelag Teater in Trondheim, Norway...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/y7jFUGAIQkHyREMd12Tfrpl1iPp.jpg", url:"https://themoviedb.org/person/77976"}}, {tmdbId:"559195", properties:{bornIn:"Freiburg im Breisgau, Germany", imdbId:"4083737", born:date('1980-08-08'), name:"Tobias Santelmann", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wDsLQNsG4WWvwE6pwtV0FhL5JZt.jpg", url:"https://themoviedb.org/person/559195"}}, {tmdbId:"76547", properties:{bornIn:"Oslo, Norway", imdbId:"0377336", born:date('1975-10-29'), name:"Aksel Hennie", bio:"Aksel Hennie (born 29 October 1975) is a Norwegian actor, director and writer.  He has acted in a number of successful Norwegian movies, and has received several awards. \n\nHennie grew up in Lambertseter in Oslo.  In his late teens he was sentenced for graffiti, and became an outcast in the community for confessing to the police.  This personal story contributed much of the background for the movie Uno.  The conviction against Hennie was in fact one of the first such cases in Norway...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sceuNjVXtsHOS3cn0MsLfZRkAQx.jpg", url:"https://themoviedb.org/person/76547"}}, {tmdbId:"559207", properties:{imdbId:"4033934", name:"Synnøve Macody Lund", url:"https://themoviedb.org/person/559207"}}, {tmdbId:"77981", properties:{imdbId:"1102198", born:date('1973-03-26'), name:"Eivind Sander", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lXCE9C9OpRS49UrxrzFwswJWjb6.jpg", url:"https://themoviedb.org/person/77981"}}, {tmdbId:"2004564", properties:{name:"Jana Banker", url:"https://themoviedb.org/person/2004564"}}, {tmdbId:"169449", properties:{imdbId:"0493179", name:"Cheryl Lawson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ogZLCulgn3ErV3sTyi4lPwxDJrD.jpg", url:"https://themoviedb.org/person/169449"}}, {tmdbId:"1223793", properties:{bornIn:"Aberdeen, Aberdeenshire, Scotland, UK", imdbId:"3310211", born:date('1987-02-09'), name:"Rose Leslie", bio:"Rose Leslie is a Scottish actress, best known for playing Ygritte in the HBO fantasy series \"Game of Thrones\" and Gwen Dawson in the ITV drama series \"Downton Abbey\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2nvuHudgrf8FCwLz81ONCByJNd3.jpg", url:"https://themoviedb.org/person/1223793"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"110902", properties:{bornIn:"Connecticut, USA", imdbId:"0959963", born:date('1973-03-13'), name:"Ólafur Darri Ólafsson", bio:"He has lived in Iceland for most of his life and works full time as an actor.  He does a lot of theatre work as well as films and he is one of the founders of the Vesturport theatre company, which has performed around the world...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qNs7mUyqWFRocJ4X22Zy1fAhL4x.jpg", url:"https://themoviedb.org/person/110902"}}, {tmdbId:"90130", properties:{bornIn:"Richmond, British Columbia, Canada", imdbId:"0039148", born:date('1979-10-07'), name:"Aaron Ashmore", bio:"Aaron Ashmore (born October 7, 1979) is a Canadian film and television actor, best known for Smallville...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mxr5s0mVsV0eEI7JhdcMVRatEh9.jpg", url:"https://themoviedb.org/person/90130"}}, {tmdbId:"143640", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"2537780", born:date('1940-05-10'), name:"Wayne Dyer", bio:"Wayne W.  Dyer, Ph. D. , is an internationally renowned author and speaker in the field of self-development.  He’s the author of 30 books, has created many audio programs and videos, and has appeared on thousands of television and radio shows...", died:date('2015-08-29'), url:"https://themoviedb.org/person/143640"}}, {tmdbId:"98953", properties:{bornIn:"New York City, New York, USA", imdbId:"1483196", born:date('1979-11-25'), name:"Jerry Ferrara", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yGziAkYkdtBmYolQg7MNkK5XP7J.jpg", url:"https://themoviedb.org/person/98953"}}, {tmdbId:"213612", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"3846623", born:date('1929-03-13'), name:"Bill Cunningham", bio:"William John \"Bill\" Cunningham Jr.  (March 13, 1929 – June 25, 2016) was an American fashion photographer for the New York Times, known for his candid and street photography. \n\nDescription above from the Wikipedia article Bill Cunningham (American photographer), licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2016-06-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/75oNbVQ5wEfwKISRinClJ3jlazw.jpg", url:"https://themoviedb.org/person/213612"}}, {tmdbId:"1301353", properties:{imdbId:"0792426", name:"Editta Sherman", url:"https://themoviedb.org/person/1301353"}}, {tmdbId:"131820", properties:{bornIn:"Woodstown, New Jersey, USA", imdbId:"0068187", born:date('1986-12-17'), name:"Emma Bell", bio:"Emma Bell is an American film and television actress, best known for playing Amy Harrison in season 1 of the television series \"The Walking Dead\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/44pK49GPg93it63ALnw91Z0waK2.jpg", url:"https://themoviedb.org/person/131820"}}, {tmdbId:"1223185", properties:{bornIn:" Dallas, Texas, USA", imdbId:"0279702", born:date('1983-06-23'), name:"Miles Fisher", bio:"Actor / Performer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/shf8LrQ1hmXut0PoYjNHjFuOwqk.jpg", url:"https://themoviedb.org/person/1223185"}}, {tmdbId:"223124", properties:{imdbId:"3455503", born:date('1988-06-07'), name:"Ellen Wroe", bio:"Ellen Wroe is an actress and writer...", url:"https://themoviedb.org/person/223124"}}, {tmdbId:"125025", properties:{bornIn:"Los Angeles, California, USA", imdbId:"1428821", born:date('1999-07-30'), name:"Joey King", bio:"Joey King (born July 30, 1999) is an American teen actress widely known for her starring role as Ramona Quimby in Ramona and Beezus, the 2010 adaption of Beverly Cleary's book series with the same title with Disney star Selena Gomez.  King was featured in Battle: Los Angeles, where she played a girl named Kirsten, who was battling for her life with the help of many courageous Marines.  Also in 2011 she co-starred in Crazy, Stupid, Love...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jUuKlP1hjPJ6R0d6MhUytr85oRL.jpg", url:"https://themoviedb.org/person/125025"}}, {tmdbId:"235548", properties:{bornIn:"Visalia, California", imdbId:"0235948", name:"Kevin Downes", bio:"​From Wikipedia, the free encyclopedia.   \n\nKevin Downes is an American actor, writer, producer and director.  Downes grew up in Visalia, 3 hours north of Los Angeles.  Most of the Christians films he participated in were shot there. \n\nHe has over 15 years’ writing, directing, acting and producing experience, much of it in the faith-based market.  His vision is to produce quality motion pictures to share strong messages of hope, faith and love that come through a personal relationship with God...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nrCeOB2G2AmZrvMqWUHzKGAiqv4.jpg", url:"https://themoviedb.org/person/235548"}}, {tmdbId:"971814", properties:{imdbId:"3153688", name:"Renee Jewell", url:"https://themoviedb.org/person/971814"}}, {tmdbId:"27271", properties:{bornIn:"Martin, Czechoslovakia", imdbId:"0090469", born:date('1974-04-29'), name:"Barbora Bobulova", bio:"Barbora Bobuľová (born April 29, 1974) is a Slovak actress.  Born in Martin, Slovakia, Bobuľová trained at the National Drama Academy in Bratislava before moving to Italy in 1995.  She made her feature film debut in the Italian film The Prince von Homburg, that was selected to represent Italy at the 1997 Cannes Film Festival. \n\nFor her work in the 2005 film Cuore Sacro (Sacred Heart), she won Best Actress Awards at the David di Donatello awards, the Ciak d'Oro awards and the Flaiano Film Festival...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dCUMZhPuTtQo259uWKMSRhb9g3F.jpg", url:"https://themoviedb.org/person/27271"}}, {tmdbId:"88710", properties:{bornIn:" Rome, Italy", imdbId:"0029846", born:date('1977-04-22'), name:"Ambra Angiolini", bio:"From Wikipedia, the free encyclopedia. \n\nAmbra Angiolini (born in Rome, 22 April 1977) is a former Italian TV host and singer in the 1990s, who nowadays mainly works as an actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wNUCviAu6EPNJ328xRoFzjdzl2W.jpg", url:"https://themoviedb.org/person/88710"}}, {tmdbId:"47827", properties:{bornIn:"Genova, Italy", imdbId:"0084709", born:date('1971-07-13'), name:"Luca Bizzarri", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2STmjs7N8w5rnHMvMh3uyK2Rqgp.jpg", url:"https://themoviedb.org/person/47827"}}, {tmdbId:"53117", properties:{bornIn:"Yellowknife, Northwest Territories, Canada", imdbId:"1682420", born:date('1985-07-28'), name:"Dustin Milligan", bio:"Dustin Milligan is a Canadian film and television actor best known for his role as Ethan Ward in the first season of \"90210\" and Ted Mullens in \"Schitt's Creek\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v1OtMBknzIUPXd0sQU6P0LA57V7.jpg", url:"https://themoviedb.org/person/53117"}}, {tmdbId:"77088", properties:{bornIn:"Los Angeles, California, USA", imdbId:"1897713", born:date('1984-03-25'), name:"Katharine McPhee", bio:"Katharine Hope McPhee (born March 25, 1984) is an American pop singer, songwriter and actress.  She gained fame as the runner-up on the fifth season of American Idol.  Her self-titled debut album was released on RCA Records on January 30, 2007, and debuted at number two on the Billboard 200, selling 381,000 copies (as of December 2010).  The album's first single, \"Over It\", was a Pop Top 30 hit and was certified gold in 2008...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/monrkPe0xrdfwZo32LMS9xTYDqb.jpg", url:"https://themoviedb.org/person/77088"}}, {tmdbId:"550312", properties:{imdbId:"0054087", name:"Roger Barclay", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/edEAhoLoGMte94lPfwNCKyyFRFW.jpg", url:"https://themoviedb.org/person/550312"}}, {tmdbId:"1186694", properties:{imdbId:"0141422", name:"Eric Carte", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h06zIHhepxWkoFOZNyX8rKBZ7J4.jpg", url:"https://themoviedb.org/person/1186694"}}, {tmdbId:"177099", properties:{bornIn:"Skokie, Illinois, USA", imdbId:"0678931", born:date('1958-12-31'), name:"David Pevsner", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ofxzAlHQi4mGgRRgqFdD7CxK5XZ.jpg", url:"https://themoviedb.org/person/177099"}}] AS row
