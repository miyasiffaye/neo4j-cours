UNWIND [{tmdbId:"78297", properties:{bornIn:"Muscatine, Iowa", imdbId:"1008415", born:date('1966-06-16'), name:"Phil Vischer", bio:"From Wikipedia, the free encyclopedia. \n\nPhillip \"Phil\" Vischer (born June 16, 1966) is an American voice actor, animator, director, writer and puppeteer known for creating the computer-animated video series VeggieTales with partner and friend Mike Nawrocki.  He is famous for providing the voice of Bob the Tomato in the series. \n\nDescription above from the Wikipedia article Phil Vischer, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/78297"}}, {tmdbId:"78298", properties:{bornIn:"Dayton, Ohio", imdbId:"1007740", born:date('1966-07-08'), name:"Mike Nawrocki", bio:"From Wikipedia, the free encyclopedia. \n\nMichael \"Mike\" Nawrocki (born July 8 1966 , Dayton, Ohio) is an American voice actor, writer and director.  He is the co-founder (along with Phil Vischer) of Big Idea Productions, the company best known for bringing computer-animated vegetables to life in the popular VeggieTales series.  Nawrocki is a voice actor who performs several of the VeggieTales characters, including Larry the Cucumber...", url:"https://themoviedb.org/person/78298"}}, {tmdbId:"14887", properties:{bornIn:"Buton-on-Trent, Staffordshire, England, UK", imdbId:"0175916", born:date('1974-09-05'), name:"Paddy Considine", bio:"Patrick \"Paddy\" George Considine (born 5 September 1973) is an English actor, director, screenwriter and frequent collaborator with Shane Meadows. \n\nHis directorial debut, the short film Dog Altogether, won a number of awards including the 2008 BAFTA Award for Best Short Film. \n\nDescription above from the Wikipedia article Paddy Considine, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uIKOm4w2wtUegxratSHj2KPFF7i.jpg", url:"https://themoviedb.org/person/14887"}}, {tmdbId:"91610", properties:{imdbId:"0088392", name:"Michael Blieden", url:"https://themoviedb.org/person/91610"}}, {tmdbId:"23724", properties:{bornIn:"Lezigne, France", imdbId:"0161717", born:date('1944-11-02'), name:"Patrice Chéreau", bio:"Patrice Chéreau (1944-2013) was a French opera and theatre director, filmmaker, actor, and producer...", died:date('2013-10-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8Qbylwv2JLQVQsEYz9u1oUnVruf.jpg", url:"https://themoviedb.org/person/23724"}}, {tmdbId:"105648", properties:{imdbId:"0269542", born:date('1975-01-01'), name:"Nat Faxon", bio:"Nathaniel \"Nat\" Faxon (born 1975) is an American actor, comedian and Academy Award-winning screenwriter.  Though a frequent presence on comedic films and TV series, he is best known for winning the Academy Award for Best Adapted Screenplay for co-writing The Descendants (2011) and for his starring role in the FOX comedy series, Ben and Kate (2012-2013).  He also co-wrote and co-directed the acclaimed The Way, Way Back (2013) with writing partner Jim Rash...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/y0zLB7zVDztJLc2XW9Rg3f7dZvQ.jpg", url:"https://themoviedb.org/person/105648"}}, {tmdbId:"19359", properties:{bornIn:" France", imdbId:"0888418", born:date('1971-08-02'), name:"Marina de Van", bio:"​From Wikipedia, the free encyclopedia.   \n\nMarina de Van (born 2 August 1971) is a French film director, screenwriter and actress.  Her film, Don't Look Back, was screened out of competition at the 2009 Cannes Film Festival. \n\nDescription above from the Wikipedia article Marina de Van, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/19359"}}, {tmdbId:"26724", properties:{bornIn:"Hong Kong, British Crown Colony [now China]", imdbId:"0874676", born:date('1953-04-14'), name:"Eric Tsang", bio:"From Wikipedia, the free encyclopedia\n\nEric Tsang Chi-wai, MH (Chinese: 曾志偉; born 14 April 1953 in Hong Kong with family roots in Xinhui, Guangdong, China) is a prolific Hong Kong actor, film director, film producer and television host best known for hosting the Super Trio series on TVB over the course of 10 years. \n\nDescription above from the Wikipedia article Eric Tsang, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nbdxUnQeHlpjEmm0XAqlqqA3BJD.jpg", url:"https://themoviedb.org/person/26724"}}, {tmdbId:"1152", properties:{bornIn:"New York City, New York, USA", imdbId:"0000231", born:date('1946-09-15'), name:"Oliver Stone", bio:"William Oliver Stone is an American film director and screenwriter.  Stone became known in the late 1980s and the early 1990s for directing a series of films about the Vietnam War, in which he had participated as an American infantry soldier.  His work frequently focuses on contemporary political and cultural issues, often controversially...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nPFtjueZHmU56boVKXEvAoQOTWf.jpg", url:"https://themoviedb.org/person/1152"}}, {tmdbId:"9789", properties:{bornIn:"Kansas City, Missouri, USA", imdbId:"0000265", born:date('1925-02-20'), name:"Robert Altman", bio:"Robert Bernard Altman was an American film director and screenwriter known for making films that are highly naturalistic, but with a stylized perspective.  In 2006, the Academy of Motion Picture Arts and Sciences recognized his body of work with an Academy Honorary Award. \n\nHis films MASH, Nashville and McCabe and Mrs.  Miller have been selected for preservation in the United States National Film Registry...", died:date('2006-11-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lMg5MHRd8ATRPN8uem9Nojo6WLY.jpg", url:"https://themoviedb.org/person/9789"}}, {tmdbId:"16513", properties:{bornIn:"Oak Park, Illinois, USA", imdbId:"0000814", born:date('1935-12-21'), name:"John G. Avildsen", bio:"John Guilbert Avildsen was an American film director.   He won the Academy Award for Best Director in 1977 for Rocky.  Other films he directed include Joe, Save the Tiger, Fore Play, The Formula, Neighbors, For Keeps, Lean on Me, The Power of One, 8 Seconds, Inferno, Rocky V and the first three The Karate Kid films. \n\nAvildsen was born in Oak Park, Illinois, the son of Ivy (née Guilbert) and Clarence John Avildsen.  He was educated at The Hotchkiss School and New York University...", died:date('2017-06-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vDroEhmg2LLLKvReiHRwVvhtxh0.jpg", url:"https://themoviedb.org/person/16513"}}, {tmdbId:"33192", properties:{bornIn:"Blacktown, New South Wales, Australia", imdbId:"0249291", born:date('1974-06-23'), name:"Joel Edgerton", bio:"Joel Edgerton (born 23 June 1974) is an Australian actor, director, writer, and producer.  He has appeared in the films Star Wars: Episode II – Attack of the Clones (2002), Star Wars: Episode III – Revenge of the Sith (2005), Warrior (2011), Zero Dark Thirty (2012), The Great Gatsby (2013), Black Mass (2015), Loving (2016), It Comes at Night (2017), and Red Sparrow (2018) and The King (2019)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uFLxGHmPaNoTD6EMpMmu5bfP9Fr.jpg", url:"https://themoviedb.org/person/33192"}}, {tmdbId:"17835", properties:{bornIn:"Whitley, Berkshire, Reading, England, UK", imdbId:"0315041", born:date('1961-06-25'), name:"Ricky Gervais", bio:"Ricky Dene Gervais (born 25 June 1961) is an English comedian, actor, director, producer, musician and writer. \n\nGervais achieved mainstream fame with his television series The Office and the subsequent series Extras, both of which he co-wrote and co-directed with friend and frequent collaborator Stephen Merchant.  In addition to writing and directing the shows, Gervais also played the lead roles of David Brent in The Office and Andy Millman in Extras...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2mAjcq9AQA9peQxNoeEW76DPIju.jpg", url:"https://themoviedb.org/person/17835"}}, {tmdbId:"16847", properties:{bornIn:"Newton, Massachusetts, USA", imdbId:"0744834", born:date('1972-04-18'), name:"Eli Roth", bio:"Eli Raphael Roth is an American film director, producer, writer and actor.  He is part of the group of filmmakers dubbed the Splat Pack, because of their association and their focus on the horror genre. \n\nRoth is known for making violent, low-budget horror films that are box office hits worldwide, and for bringing back the R-rating to horror at a time when studios believed only PG-13 horror would work...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eHBxgJXeDKiYZMbL3VgAf7i9wor.jpg", url:"https://themoviedb.org/person/16847"}}, {tmdbId:"19866", properties:{bornIn:"Boulogne Billancourt, France", imdbId:"0133899", born:date('1973-04-10'), name:"Guillaume Canet", bio:"Guillaume Canet (born 10 April 1973) is a French actor and film director. \n\nCanet began his career in theatre and television before moving to film.  He starred in several films like Joyeux Noël, Love Me If You Dare and The Beach.  In 2006, he turned to writing and directing with Tell No One and won a César Award for Best Director. \n\nCanet has also received attention because of his personal life.  He was formerly married to actress Diane Kruger...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qy0xe5k8tz2K7HYArBIfyKN90Vj.jpg", url:"https://themoviedb.org/person/19866"}}, {tmdbId:"19766", properties:{imdbId:"0498271", name:"Sook-Yin Lee", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eYv8kisLPUmjEGoB89FNojUkOBg.jpg", url:"https://themoviedb.org/person/19766"}}, {tmdbId:"7465", properties:{bornIn:"Macon, Georgia, USA", imdbId:"0696387", born:date('1967-06-21'), name:"Carrie Preston", bio:"Carrie Preston is an American stage and screen actress, producer and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cxqAk6PaZJ92mb9taka3XlcVlUU.jpg", url:"https://themoviedb.org/person/7465"}}, {tmdbId:"81916", properties:{bornIn:"Poznań, Poland", imdbId:"1382072", born:date('1955-10-03'), name:"Tommy Wiseau", bio:"Tommy Wiseau is an American actor, director, screenwriter & producer.  He trained to be an actor at: American Conservatory Theater, Vince Chase Workshop, Jean Shelton Acting Lab, Laney College and Stella Adler Academy of Acting. \n\nIn 2001 he wrote, produced, directed and starred in The Room (2003), a feature film that received the 2003 Audience Award at the New York International Film Festival.  In 2004, he produced the documentary \"Homeless in America,\" which received the 2004 Social Award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mDiPtAoCFOM2NoHI0Jx1Zh2t5rV.jpg", url:"https://themoviedb.org/person/81916"}}, {tmdbId:"57207", properties:{bornIn:"Surin Thailand", imdbId:"1388074", born:date('1976-02-05'), name:"Tony Jaa", bio:"Panom Yeerum was born on February 5, 1976, in the northeastern province of Surin, Thailand.  His parents were elephant herders.  Panom watched martial arts films as a young kid and began to emulate some of his idols, from Bruce Lee to Jackie Chan to Jet Li.  After seeing the Thai action film Kerd ma lui (2004) (\"Born to Fight\"), Panom met and studied martial arts and stunt work as a teen under the director of that film, Panna Rittikrai...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/anBSs0nh4n4cpiwRl5QmjT5zRrt.jpg", url:"https://themoviedb.org/person/57207"}}, {tmdbId:"1201", properties:{bornIn:"New York City, New York, USA", imdbId:"0005190", born:date('1934-11-13'), name:"Garry Marshall", bio:"Garry Kent Marshall (November 13, 1934 – July 19, 2016) was an American actor, director, writer and producer.  His notable credits include creating Happy Days and The Odd Couple and directing Nothing In Common, Pretty Woman, Runaway Bride, Valentine's Day, and The Princess Diaries. \n\nDescription above from the Wikipedia article Garry Marshall, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2016-07-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/az6Hm9QyS1tkCXXppa6bXsIDArW.jpg", url:"https://themoviedb.org/person/1201"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor:Director;
UNWIND [{tmdbId:"31655", properties:{imdbId:"1724413", born:date('1968-04-15'), name:"Mike Bonanno", bio:"From Wikipedia, the free encyclopedia. \n\nIgor Vamos, born April 15, 1968, is an internationally known multimedia artist, leading member of The Yes Men (using the alias Mike Bonanno), and an associate professor of media arts at Rensselaer Polytechnic Institute...", url:"https://themoviedb.org/person/31655"}}, {tmdbId:"31656", properties:{imdbId:"1722405", name:"Andy Bichlbaum", bio:"From Wikipedia, the free encyclopedia. \n\nJacques Servin (also known as Andy Bichlbaum) is one of the leading members of The Yes Men, a culture jamming activist group.  Their exploits in \"identity correction\" are documented in the films The Yes Men and The Yes Men Fix the World.  As Ray Thomas, he is a co-founder of RTMark...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tkYLhys0XBsdQAiUoiUwMVR7BAW.jpg", url:"https://themoviedb.org/person/31656"}}, {tmdbId:"60971", properties:{bornIn:" Halifax, Nova Scotia", imdbId:"1033215", born:date('1968-01-01'), name:"John Paul Tremblay", bio:"From Wikipedia, the free encyclopedia. \n\nJohn Paul Tremblay (born January 1, 1968) is a Canadian actor who stars in the hit Canadian TV show Trailer Park Boys, playing Julian, a newly released ex-con returning to his home in a trailer park in Nova Scotia.  The show is written by Tremblay along with co-stars Robb Wells and Mike Smith.  The Trailer Park Boys released a film in 2006, most of it being filmed in the municipality of Halifax...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o0yFQYhYY8fm1sybGjqJscIrhzr.jpg", url:"https://themoviedb.org/person/60971"}}, {tmdbId:"60966", properties:{bornIn:" Moncton, New Brunswick", imdbId:"1036211", born:date('1971-10-28'), name:"Robb Wells", bio:"From Wikipedia, the free encyclopedia. \n\nRobb Wells (born October 28, 1971) is a Canadian actor and screenwriter who portrayed Ricky on Trailer Park Boys. \n\nDescription above from the Wikipedia article Robb Wells, licensed under CC-BY-SA, full list of contributors on Wikipedia ...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zwpMgBzwwgatHBnyvaxUG2VWfoX.jpg", url:"https://themoviedb.org/person/60966"}}, {tmdbId:"52139", properties:{bornIn:"Kent, Connecticut, USA", imdbId:"0532235", born:date('1973-10-26'), name:"Seth MacFarlane", bio:"Seth Woodbury MacFarlane (born October 26, 1973) is an American animator, writer, comedian, producer, actor, singer, voice actor, and director best known for creating the animated sitcoms Family Guy, American Dad! and The Cleveland Show, for which he also voices many of the shows' various characters. \n\nA native of Kent, Connecticut, MacFarlane is a graduate of the Rhode Island School of Design, where he studied animation, earning a Bachelor of Fine Arts Degree...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ui6n1Aa7kTiE2gIgoEXWoqDIkBY.jpg", url:"https://themoviedb.org/person/52139"}}, {tmdbId:"76624", properties:{bornIn:"Myrtle Beach, South Carolina, USA", imdbId:"1503403", name:"Shane Carruth", bio:"Carruth was born in Myrtle Beach, South Carolina.  He attended Stephen F.  Austin State University as a math major.  Before becoming a filmmaker, he used to be a developer of flight simulation software.  Carruth wrote, directed, produced, and performed one of the two main roles, and composed the music for his independent film Primer, which was honored at the 2004 Sundance Film Festival with the Grand Jury Prize and the Alfred P.  Sloan Award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zytHHEqP385IHKUW7t8JKg85atg.jpg", url:"https://themoviedb.org/person/76624"}}, {tmdbId:"17108", properties:{bornIn:"Houston, Texas, USA", imdbId:"1503401", name:"Jonathan Caouette", bio:"Jonathan Caouette (born 1973) is an American film director, writer, editor and actor.  Caouette is the director and editor of Tarnation (2003), an autobiographical documentary, and director of All Tomorrow's Parties about a cult music festival...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/941V5y5VnvT0ZpjVA5xECNDRs6x.jpg", url:"https://themoviedb.org/person/17108"}}, {tmdbId:"7918", properties:{bornIn:"Billings, Montana, USA", imdbId:"0524726", born:date('1934-07-28'), name:"Bud Luckey", bio:"From Wikipedia, the free encyclopedia. \n\nWilliam \"Bud\" Luckey (born July 28, 1934) is an American cartoonist, animator, singer, musician, and composer.  He is best known for his work at Pixar as a character designer for Toy Story, Boundin', Toy Story 2, A Bug's Life, Monsters, Inc. , Finding Nemo, Cars, The Incredibles, and Ratatouille.  He is also beloved by generations of Sesame Street viewers for his numerous short animated films on that program...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/csLjHwg7x1OFTiHjJAPpqNjjDiH.jpg", url:"https://themoviedb.org/person/7918"}}, {tmdbId:"231977", properties:{imdbId:"1533823", name:"Joe Lia", url:"https://themoviedb.org/person/231977"}}, {tmdbId:"19859", properties:{imdbId:"1789162", name:"Samantha Futerman", url:"https://themoviedb.org/person/19859"}}, {tmdbId:"21769", properties:{bornIn:"Versailles, France", imdbId:"0687913", born:date('1961-03-11'), name:"Bruno Podalydès", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wu2GLE6bZiWh8x61eRwX4JTgYh1.jpg", url:"https://themoviedb.org/person/21769"}}, {tmdbId:"574389", properties:{imdbId:"1109731", born:date('1980-03-24'), name:"Vít Klusák", bio:"Vít Klusák was graduated of the Department of Documentary Film at FAMU Prague, since 2005 he has been teaching in the same department.  In 2004 he co-directed with Filip Remunda  the successful film Czech Dream, broadcasted by more than 30 international TV channels.  He studied photography at the Industrial Graphic Arts School in Prague and has had two solo exhibitions of his photography.  He runs the independent production company Hypermarket Film ltd...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7RDYb4TDygwFUv1Ef0LQbtap3TU.jpg", url:"https://themoviedb.org/person/574389"}}, {tmdbId:"488", properties:{bornIn:"Cincinnati, Ohio, USA", imdbId:"0000229", born:date('1946-12-18'), name:"Steven Spielberg", bio:"Steven Allan Spielberg KBE (born December 18, 1946) is an American film director, producer, and screenwriter.  He is considered one of the founding pioneers of the New Hollywood era and one of the most popular directors and producers in film history.  Spielberg started in Hollywood directing television and several minor theatrical releases.  He became a household name as the director of Jaws (1975), which was critically and commercially successful and is considered the first summer blockbuster...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mzU57RmCxwZUC0tOFC8DQPZM7Uk.jpg", url:"https://themoviedb.org/person/488"}}, {tmdbId:"16860", properties:{bornIn:"Barre, Vermont, USA", imdbId:"0432380", born:date('1974-02-15'), name:"Miranda July", bio:"Miranda July (born February 15, 1974) is a performing artist, musician, writer, actress and film director.  Born Miranda Jennifer Grossinger, she works under the surname of \"July,\" which can be traced to a character from a \"girlzine\" Miranda created with high school friend Johanna Fateman, called \"Snarla\". \n\nDescription above from the Wikipedia article Miranda July, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fs32oVyHtwWV4czdTaNzCMFaEe4.jpg", url:"https://themoviedb.org/person/16860"}}, {tmdbId:"1", properties:{bornIn:"Modesto, California, USA", imdbId:"0000184", born:date('1944-05-14'), name:"George Lucas", bio:"George Walton Lucas Jr.  (born May 14, 1944) is an American filmmaker and entrepreneur.  Lucas is known for creating the Star Wars and Indiana Jones franchises and founding Lucasfilm, LucasArts and Industrial Light & Magic.  He served as chairman of Lucasfilm before selling it to The Walt Disney Company in 2012. \n\nAfter graduating from the University of Southern California in 1967, Lucas co-founded American Zoetrope with filmmaker Francis Ford Coppola...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d0ZMdgMz1mVcWWctyF7sbymSlv4.jpg", url:"https://themoviedb.org/person/1"}}, {tmdbId:"8262", properties:{bornIn:"Beaumont, Texas, USA", imdbId:"0428618", born:date('1927-08-19'), name:"L.Q. Jones", bio:"​From Wikipedia, the free encyclopedia.   \n\nL. Q.  Jones (born August 19, 1927) is an American character actor and film director, known for his work in the films of Sam Peckinpah. \n\nDescription above from the Wikipedia article L.  Q.  Jones, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vSGLFloekrgC8eIaqxCiKe7VW0u.jpg", url:"https://themoviedb.org/person/8262"}}, {tmdbId:"59410", properties:{bornIn:"Naperville, Illinois, USA", imdbId:"0644022", born:date('1962-10-22'), name:"Bob Odenkirk", bio:"Robert \"Bob\" Odenkirk (born October 22, 1962) is an American actor, comedian, writer, director and producer.  He is best known as the co-creator and co-star of the HBO sketch comedy series Mr.  Show with Bob and David. \n\nIn the 1980s and 1990s, he worked as a writer for such notable shows as Saturday Night Live, Get A Life, The Ben Stiller Show, and The Dennis Miller Show.  In the mid-1990s, Odenkirk and David Cross created the Emmy-winning sketch comedy program Mr...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nJLcRRqq9JTQTgVYrFn7vPDgAsK.jpg", url:"https://themoviedb.org/person/59410"}}, {tmdbId:"55936", properties:{bornIn:"New Zealand", imdbId:"1318596", born:date('1974-01-10'), name:"Jemaine Clement", bio:"From Wikipedia, the free encyclopedia. \n\nJemaine Clement (born 10 January 1974) is a New Zealand comedian, actor and musician, best known as one half of the musical comedy duo Flight of the Conchords along with Bret McKenzie. \n\nDescription above from the Wikipedia article Jemaine Clement, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6eiNbeurpHb2fxIeT0RrJ0wRI25.jpg", url:"https://themoviedb.org/person/55936"}}, {tmdbId:"23532", properties:{bornIn:"Rye, New York, USA", imdbId:"0000867", born:date('1969-01-14'), name:"Jason Bateman", bio:"Jason Kent Bateman (born January 14, 1969) is an American television and film actor.  After appearing in several 1980s and 1990s sitcoms including Silver Spoons, It's Your Move, and The Hogan Family, Bateman came to prominence in the early 2000s for playing Michael Bluth on Arrested Development, for which he won a TV Land, a Golden Globe, and two Satellite Awards...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8e6mt0vGjPo6eW52gqRuXy5YnfN.jpg", url:"https://themoviedb.org/person/23532"}}, {tmdbId:"14911", properties:{bornIn:"The Bronx, New York City, New York, USA", imdbId:"0001508", born:date('1943-10-15'), name:"Penny Marshall", bio:"​From Wikipedia, the free encyclopedia\n\nCarole Penny Marshall (October 15, 1943 - December 17, 2018) was an American actress, producer and director.  After playing several small roles for television, she was cast as Laverne DeFazio in the sitcom Laverne & Shirley.  A ratings success, the show ran from 1976 until 1983, and Marshall received three Golden Globe award nominations for her performance...", died:date('2018-12-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hjLwmV68zqXQnvm5UiUptHRePLh.jpg", url:"https://themoviedb.org/person/14911"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor:Director;
UNWIND [{tmdbId:"113807", properties:{bornIn:"England, UK", imdbId:"1783716", born:date('1969-05-28'), name:"Rupert Murray", bio:"From Wikipedia, the free encyclopedia. \n\nRupert Murray (born 28 May 1969) is a film director working in London.  Murray began by making television documentaries for Channel Four's Cutting Edge series including Playing For England and Seconds To Impact (cameraman and editor), and short films Outsiders and This Was My War, co-directed with Beadie Finzi...", url:"https://themoviedb.org/person/113807"}}, {tmdbId:"74339", properties:{bornIn:"Wichita Falls, Texas,  United States", imdbId:"0932302", born:date('1970-05-01'), name:"Dave Willis", bio:"​From Wikipedia, the free encyclopedia\n\nDavid Wayne \"Dave\" Willis (born May 1, 1970) is an American voice actor, writer, and producer mostly known as one of the creators, writers, directors, and actors of the adult humored animated series Aqua Teen Hunger Force.  Dave Willis has worked on various Adult Swim shows that are created primarily by Williams Street, an animation-centered, Atlanta-based production division of Cartoon Network...", url:"https://themoviedb.org/person/74339"}}, {tmdbId:"62863", properties:{bornIn:"Berkeley, California, USA", imdbId:"1672246", born:date('1977-03-19'), name:"Jorma Taccone", bio:"Jorma Christopher Taccone (pronounced yorma tuh-cone-nee) (born March 19, 1977) is an American comedy writer-actor-director.  Taccone is one third of the sketch comedy troupe The Lonely Island along with childhood friends Andy Samberg and Akiva Schaffer.  He most recently co-wrote and directed the SNL spin-off film MacGruber. \n\nDescription above from the Wikipedia article Jorma Taccone, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iPltx6SxbIFi0qib22RkLV3oHYo.jpg", url:"https://themoviedb.org/person/62863"}}, {tmdbId:"121867", properties:{imdbId:"1965113", name:"Justin Lo", url:"https://themoviedb.org/person/121867"}}, {tmdbId:"66212", properties:{bornIn:"Helsinki, Finland", imdbId:"1993322", born:date('1979-11-29'), name:"Timo Vuorensola", bio:"From Wikipedia, the free encyclopedia\n\nTimo Vuorensola (born 29 November 1979) is a Finnish film director and actor.  He has directed Star Wreck movies Star Wreck V: Lost Contact, and Star Wreck: In the Pirkinning, created by Samuli Torssonen.  Vuorensola plays Lieutenant Dwarf in the films, and is currently directing the film Iron Sky.  He is also the lead vocalist and co-founder of dark industrial band Älymystö...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pMxmMdBh5JyV5Uevy4eaAsrJiM7.jpg", url:"https://themoviedb.org/person/66212"}}, {tmdbId:"19274", properties:{bornIn:"Vancouver, British Columbia, Canada", imdbId:"0736622", born:date('1982-04-15'), name:"Seth Rogen", bio:"Seth Rogen (born April 15, 1982) is a Canadian actor, comedian, voice artist, screenwriter, and film producer.  Rogen began his career doing stand-up comedy for four years during his teens, coming in second place in the Vancouver Amateur Comedy Contest in 1998.  While still living in his native Vancouver, he landed a supporting role in Freaks and Geeks.  Shortly after Rogen moved to Los Angeles for his role, Freaks and Geeks was canceled after one season due to poor ratings...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xCt0MWnPkk1tJIYYPT6fekgQRMg.jpg", url:"https://themoviedb.org/person/19274"}}, {tmdbId:"1093136", properties:{imdbId:"0035229", name:"Ralph Arlyck", url:"https://themoviedb.org/person/1093136"}}, {tmdbId:"118303", properties:{bornIn:"Cabezón de la Sal, Cantabria, Spain", imdbId:"1443023", born:date('1977-04-06'), name:"Nacho Vigalondo", bio:"Ignacio Vigalondo Palacios (born 6 April 1977), better known as Nacho Vigalondo, is a Spanish filmmaker. \n\nVigalondo's first film was the 2003 Spanish-language short film 7:35 in the Morning, about a suicide bomber who terrorizes a cafe, which was only eight minutes long...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ydoLch061IWUMdIi5CkbKnFIph8.jpg", url:"https://themoviedb.org/person/118303"}}, {tmdbId:"2836", properties:{bornIn:"Harrisburg, Pennsylvania, USA", imdbId:"0005303", born:date('1967-09-08'), name:"Kimberly Peirce", bio:"From Wikipedia, the free encyclopedia\n\nKimberly Peirce (born September 6, 1967) is an American feature film director, notable for her debut feature film, Boys Don't Cry (1999).  Her second feature, Stop-Loss, was released by Paramount Pictures in 2008. \n\nDescription above from the Wikipedia article Kimberly Peirce, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lRnwxog6xUZV26mxCVuMFM006CV.jpg", url:"https://themoviedb.org/person/2836"}}, {tmdbId:"59413", properties:{bornIn:"Cookeville, Tennessee, USA", imdbId:"0304830", born:date('1970-09-14'), name:"Robert Ben Garant", bio:"From Wikipedia, the free encyclopedia.   \n\nRobert Ben Garant (born 14 September 1970) is an American actor, comedian, writer, director and producer. \n\nGarant was born in Cookeville, Tennessee, and grew up in Farragut, Tennessee.  He lived in New York City for several years and currently resides in Los Angeles, California. \n\nHe is known for his work on Reno 911!, in which he plays Deputy Travis Junior, and for being a cast member on the MTV sketch comedy series The State...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/s9rT8CYCv9ID77GPTKQnNfksIFT.jpg", url:"https://themoviedb.org/person/59413"}}, {tmdbId:"234836", properties:{imdbId:"2078319", name:"Eric Zala", url:"https://themoviedb.org/person/234836"}}, {tmdbId:"170820", properties:{bornIn:"Carbondale, USA", imdbId:"1229520", born:date('1973-08-25'), name:"Ben Falcone", bio:"Benjamin Scott \"Ben\" Falcone is an American actor, comedian, director, producer and screenwriter.  He is married to actress Melissa McCarthy, and the couple have two children.  He appeared in supporting roles of McCarthy's films Bridesmaids, Identity Thief and The Heat, and co-starred in What to Expect When You're Expecting and Enough Said.  Tammy, his directorial debut starring McCarthy, was released on July 2, 2014...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jsRsK14OBLd8rqVaBB1IdLyvxN7.jpg", url:"https://themoviedb.org/person/170820"}}, {tmdbId:"98103", properties:{bornIn:"Hammersmith, London, England", imdbId:"1547964", born:date('1977-05-23'), name:"Richard Ayoade", bio:"British comedian, actor, writer, and TV personality...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fp73YQYzhk2hfvdpvbwYxYL1vKz.jpg", url:"https://themoviedb.org/person/98103"}}, {tmdbId:"2746", properties:{bornIn:"Constantinople, Ottoman Empire", imdbId:"0001415", born:date('1909-09-07'), name:"Elia Kazan", bio:"Elia Kazan ( September 7 , 1909, Kayseri – September 28, 2003) was a Greek-American director and actor, described as \"one of the most honored and influential directors in Broadway and Hollywood history\".  He also produced, and wrote screenplays and novels.  Born in the Kayseri, Ottoman Empire to Greek parents, they emigrated to New York when he was four.  After two years studying acting at Yale, he acted professionally for eight years before becoming a stage and film director...", died:date('2003-09-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/njnM3C3JtqTgqR6Q4Huahcpaa8a.jpg", url:"https://themoviedb.org/person/2746"}}, {tmdbId:"39189", properties:{bornIn:"Bristol, England, UK", imdbId:"0580351", born:date('1974-11-24'), name:"Stephen Merchant", bio:"Stephen Merchant is a British writer, director, radio presenter, stand-up comedian, and actor, best known for his work on The Office, Extras, andThe Ricky Gervais Show...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6WM2rK6390Nwk398syJbGcPvRct.jpg", url:"https://themoviedb.org/person/39189"}}, {tmdbId:"53431", properties:{bornIn:"Baabdat, Lebanon", imdbId:"1701024", born:date('1974-02-18'), name:"Nadine Labaki", bio:"Nadine Labaki (born February 18, 1974) is a Lebanese actress and director.  She is one of the well known directors in the Arabic music video industry.  Nadine is usually credited for bringing artists into the scene. \n\nIn 2007, Labaki co-wrote, directed, and starred in her feature-film debut, Caramel, which became an international sensation at film festivals and went on to achieve box office success.  It showcases a Beirut that most are not familiar with...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mV1JAlM4CAdzosSqZs2ch2TPKLS.jpg", url:"https://themoviedb.org/person/53431"}}, {tmdbId:"71797", properties:{bornIn:"New York City, New York USA", imdbId:"0316795", born:date('1953-10-23'), name:"Alex Gibney", bio:"​From Wikipedia, the free encyclopedia.   \n\nAlex Gibney is an American documentary film director and producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kJp2tfLlg0smYgnhA8Fw5LBbRwC.jpg", url:"https://themoviedb.org/person/71797"}}, {tmdbId:"80602", properties:{bornIn:"New Orleans, Louisiana, USA", imdbId:"1347153", born:date('1969-09-13'), name:"Tyler Perry", bio:"Tyler Perry (born Emmitt Perry, Jr. ; September 13, 1969) is an African-American actor, director, playwright, screenwriter, producer, author, and songwriter.  Already a successful artist in Southern theater, Perry began to make national celebrity status in 2005 with the release of his first film, Diary of a Mad Black Woman.  In 2009, Perry was ranked by Forbes magazine as the sixth highest-paid man in Hollywood...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5bbMzlH63dLVYoMYWm61sv1Y3fW.jpg", url:"https://themoviedb.org/person/80602"}}, {tmdbId:"91452", properties:{bornIn:"Berkeley, California", imdbId:"0052737", name:"Amir Bar-Lev", bio:"From Wikipedia, the free encyclopedia. \n\nAmir Bar-Lev (born in 1972) is an American film director, producer and writer from Berkeley, California. \n\nBar-Lev is noted for his work in directing documentary films.  He has directed such films as Fighter, a documentary film released August 24, 2001.  The film received a Special Jury Citation in the 2000 Karlovy Vary International Film Festival...", url:"https://themoviedb.org/person/91452"}}, {tmdbId:"65569", properties:{bornIn:"Marseille, France", imdbId:"0609981", born:date('1970-06-30'), name:"Emmanuel Mouret", bio:"From Wikipedia, the free encyclopedia  \n\n  Emmanuel Mouret (born 30 June 1970) is a French actor, director and screenwriter.   \n\n  Description above from the Wikipedia article Emmanuel Mouret, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tC9VyFdSnCH1TAM24m7f8nl0P8w.jpg", url:"https://themoviedb.org/person/65569"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor:Director;
UNWIND [{tmdbId:"52849", properties:{bornIn:" Washington, District of Columbia, USA", imdbId:"0127373", born:date('1967-09-12'), name:"Louis C.K.", bio:"Louis Székely, known professionally as Louis C.  K. , is an American stand-up comedian, Emmy-winning television and film writer, actor, producer, and director from Boston, Massachusetts.  He currently stars in the FX comedy series Louie, which he also writes, directs, and edits...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/faKr66V0EzJVMXwr0kIlSr9vfp7.jpg", url:"https://themoviedb.org/person/52849"}}, {tmdbId:"4610", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0000484", born:date('1950-08-03'), name:"John Landis", bio:"John Landis (born August 3, 1950) is an American film director, screenwriter, actor, and producer.  He is known for his comedies, his horror films, and his music videos with singer Michael Jackson...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nXKdxxELgAaGecCpxAWCoj6TV3f.jpg", url:"https://themoviedb.org/person/4610"}}, {tmdbId:"66150", properties:{bornIn:"Paris, France", imdbId:"0037867", born:date('1946-03-13'), name:"Yann Arthus-Bertrand", bio:"From Wikipedia, the free encyclopedia\n\nYann Arthus-Bertrand (born March 13, 1946 in Paris) is a French photographer, journalist, reporter and environmentalist. \n\nDescription above from the Wikipedia article Yann Arthus-Bertrand,licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oeIMYmpav5yWsihrkizHR80gtY2.jpg", url:"https://themoviedb.org/person/66150"}}, {tmdbId:"25703", properties:{bornIn:"New York City, New York, USA", imdbId:"1128572", born:date('1979-03-24'), name:"Lake Bell", bio:"Lake Siegel Bell is an American actress, director, and screenwriter...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h2nJCkL9HNhTw42Ig5fve8aEux2.jpg", url:"https://themoviedb.org/person/25703"}}, {tmdbId:"87055", properties:{imdbId:"0228327", born:date('1972-08-06'), name:"Karen Disher", bio:"Karen Beth Disher (born August 7, 1972) is an American storyboard artist and film director.  She has played in many voice over roles in cartoons, TV, movies, video games.  She is an artist at Blue Sky Studios, an in-house studio at 20th Century Fox Animation...", url:"https://themoviedb.org/person/87055"}}, {tmdbId:"56251", properties:{bornIn:"West Haven, Connecticut, U.S.", imdbId:"0373571", born:date('1968-05-25'), name:"Kevin Heffernan", bio:"From Wikipedia, the free encyclopedia\n\nKevin Heffernan (born May 25, 1968) is an American actor, writer, producer, and director, and member of the Broken Lizard comedy group. \n\nHeffernan was born West Haven, Connecticut.  He is a graduate of Fairfield College Preparatory School and later Colgate University, the latter where he was a part of comedy group Charred Goosebeak with the other Lizards, and a member of the Beta Theta Pi fraternity.  Heffernan is a graduate of Brooklyn Law School.  J. D...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2FgG3oPF1A7d6W4KaNNZV7kJ83g.jpg", url:"https://themoviedb.org/person/56251"}}, {tmdbId:"78720", properties:{bornIn:"Poughkeepsie, New York, USA", imdbId:"0068106", born:date('1972-11-03'), name:"Chris Bell", bio:"Chris Bell is an American director, producer and writer, known for his documentaries Bigger, Stronger, Faster*, Trophy Kids, and Prescription Thugs.  His work is focused on the impact that society has on our consumption and addictions, especially to prescription drugs...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bCirEu4GYzWXXOQxK98sC2M2qgt.jpg", url:"https://themoviedb.org/person/78720"}}, {tmdbId:"80207", properties:{imdbId:"0473936", name:"Kurt Kuenne", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nEI6CQTtyk0NDJbn7ErGCv49msf.jpg", url:"https://themoviedb.org/person/80207"}}, {tmdbId:"57492", properties:{bornIn:"Parkersburg, West Virginia, USA", imdbId:"1041597", born:date('1970-11-07'), name:"Morgan Spurlock", bio:"Oscar® nominated Morgan Spurlock became a household name after the runaway success of 2004’s SUPER SIZE ME.  The feature length documentary film, Spurlock's first, was named to more than 35 \"Top Ten\" lists and is one of the highest-grossing documentaries of all time...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/umV7q1bhSeDosEWpS3MhgdwZIXk.jpg", url:"https://themoviedb.org/person/57492"}}, {tmdbId:"16376", properties:{bornIn:"Brooklyn, New York City, New York, USA", imdbId:"0202970", born:date('1947-07-02'), name:"Larry David", bio:"Producer, writer, actor.  Born July 2, 1947 in Brooklyn, New York.  David attended the University of Maryland and started doing stand-up comedy in New York night clubs in 1974.  In 1979, he was hired to write and perform for the comedy variety show Fridays, which was modelled after Saturday Night Live.  He stayed with the show until 1982 when he was hired as a writer for Saturday Night Live, where he worked for a year...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iuqDxOO6DBGFJAmqCAITmYbGuEt.jpg", url:"https://themoviedb.org/person/16376"}}, {tmdbId:"16328", properties:{bornIn:"Toronto - Ontario - Canada", imdbId:"0111845", born:date('1956-09-03'), name:"Adam Brooks", bio:"From Wikipedia, the free encyclopedia\n\nAdam Brooks (b.  1956) is a Canadian film director, screenwriter and actor...", url:"https://themoviedb.org/person/16328"}}, {tmdbId:"4014", properties:{bornIn:"Newcastle-upon-Tyne, England, UK", imdbId:"0027271", born:date('1965-03-04'), name:"Paul W.S. Anderson", bio:"Paul William Scott Anderson (born 4 March 1965), also known as Paul WS Anderson or Paul Anderson, is an English film director who regularly works in science fiction movies and video game adaptations...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AeYYSi30WCkowdk04Awa0kr1E4S.jpg", url:"https://themoviedb.org/person/4014"}}, {tmdbId:"83198", properties:{bornIn:"Jersey City, New Jersey, U.S.", imdbId:"0035106", born:date('1948-04-30'), name:"Allan Arkush", bio:"From Wikipedia, the free encyclopedia. \n\nAllan Arkush (born April 30, 1948 in Jersey City, New Jersey) is an American cult film and television director and frequent collaborator of Joe Dante. \n\nArkush grew up in Fort Lee, New Jersey.  He got his start in the industry working in the trailer department for Roger Corman.  He later went on to direct the Corman produced films Hollywood Boulevard, Deathsport, and Rock 'n' Roll High School...", url:"https://themoviedb.org/person/83198"}}, {tmdbId:"56198", properties:{bornIn:"Israel Haifa, Israel", imdbId:"0284369", born:date('1962-12-17'), name:"Ari Folman", bio:"Ari Folman (born December 17, 1962) is an Israeli film director, screenwriter and film score composer...", url:"https://themoviedb.org/person/56198"}}, {tmdbId:"54424", properties:{bornIn:"St. Louis, Missouri, USA", imdbId:"0029723", born:date('1928-04-04'), name:"Maya Angelou", bio:"Maya Angelou was an American poet, memoirist, and civil rights activist.  She published seven autobiographies, three books of essays, several books of poetry, and is credited with a list of plays, movies, and television shows spanning over 50 years.  She received dozens of awards and more than 50 honorary degrees...", died:date('2014-05-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9dDY1bDRF7GnGlOEY5t9LrAdzw8.jpg", url:"https://themoviedb.org/person/54424"}}, {tmdbId:"8010", properties:{bornIn:"State College, Pennsylvania, Stati Uniti", imdbId:"0842339", name:"Doug Sweetland", bio:"From Wikipedia, the free encyclopedia\n\nDouglas Sweetland is an American animator/director, he grew up watching Disney films and classic Saturday morning cartoons.  As a child, Doug drew cartoons for the Central Pennsylvania Festival of the Arts for several years.  After graduating high school in 1992, Doug opted to attend California Institute of the Arts (CalArts) and pursue his life-long love and passion for animation. \n\nIn 1994, he decided to leave school in his final year to join Pixar...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zYxgikK0IBkMUmUBXBppJJDK4ZD.jpg", url:"https://themoviedb.org/person/8010"}}, {tmdbId:"225034", properties:{imdbId:"0954722", name:"Joshua Zeman", url:"https://themoviedb.org/person/225034"}}, {tmdbId:"225035", properties:{imdbId:"3104145", name:"Barbara Brancaccio", url:"https://themoviedb.org/person/225035"}}, {tmdbId:"94815", properties:{bornIn:"Dubuque, Iowa, USA", imdbId:"3174775", name:"Louie Psihoyos", bio:"From Wikipedia, the free encyclopedia. \n\nLouis (Louie) Psihoyos (born 1957) is an American photographer and documentary film director known for his still photography and contributions to National Geographic.  Psihoyos, a licensed scuba-diver, has become increasingly concerned with bringing awareness to underwater life.  In 2009 he directed and appeared in the feature-length documentary The Cove, which won an Oscar for Best Documentary Feature...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cRyShOW3sFmDK75lX0kfP2HTSwQ.jpg", url:"https://themoviedb.org/person/94815"}}, {tmdbId:"7929", properties:{bornIn:"America", imdbId:"0533691", born:date('1975-01-01'), name:"Angus MacLane", bio:"Angus MacLane is an American director, animator, screenwriter, and voice actor currently working at Pixar...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3gRkw0mgWeIWkxOQ5G073hmckYB.jpg", url:"https://themoviedb.org/person/7929"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor:Director;
UNWIND [{tmdbId:"109978", properties:{bornIn:"Dublin, Ireland", imdbId:"0280416", name:"Ian Fitzgibbon", url:"https://themoviedb.org/person/109978"}}, {tmdbId:"142195", properties:{imdbId:"2403032", name:"Ben Steinbauer", bio:"​From Wikipedia, the free encyclopedia.   \n\nBen Steinbauer is an American documentary film director, based in Austin, Texas.  Steinbauer’s films have premiered at South by Southwest and the Austin Film Festival, played on PBS, won awards including top prize at the 2006 Cinematexas Film Festival and screened at the Directors Guild Theatre in Los Angeles. \n\nSteinbauer won the Princess Grace Award for his 2009 documentary feature, Winnebago Man...", url:"https://themoviedb.org/person/142195"}}, {tmdbId:"56205", properties:{bornIn:"Cairo, Egypt", imdbId:"0000382", born:date('1960-07-19'), name:"Atom Egoyan", bio:"Atom Egoyan, OC is a critically acclaimed Armenian-Canadian independent film maker.  His work often explores themes of alienation and isolation, featuring characters whose interactions are mediated through technology, bureaucracy or other power structures.  Egoyan's films often follow non-linear plot-structures, in which events are placed out of sequence in order to elicit specific emotional reactions from the audience by withholding key information...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tcC1xvYTnoVPwzVVpPkHJ2oPLb4.jpg", url:"https://themoviedb.org/person/56205"}}, {tmdbId:"585182", properties:{imdbId:"1366561", born:date('1972-06-24'), name:"Mads Brügger", url:"https://themoviedb.org/person/585182"}}, {tmdbId:"124294", properties:{imdbId:"1068198", name:"Josh Fox", url:"https://themoviedb.org/person/124294"}}, {tmdbId:"55934", properties:{bornIn:"Wellington, New Zealand", imdbId:"0169806", born:date('1975-08-16'), name:"Taika Waititi", bio:"Taika David Cohen (born 16 August 1975), known professionally as Taika Waititi, is a New Zealand filmmaker and actor.  He is the recipient of an Academy Award as well as two further nominations. \n\nHis feature films Boy (2010) and Hunt for the Wilderpeople (2016) have each been the top-grossing New Zealand film, with the latter still holding that title as of April 2020.  He co-directed and starred in the horror comedy film What We Do in the Shadows (2014) with Jemaine Clement...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zCLBXGo5BS2e27srDBa5WpRnKul.jpg", url:"https://themoviedb.org/person/55934"}}, {tmdbId:"214413", properties:{imdbId:"0298132", name:"Lee Fulkerson", url:"https://themoviedb.org/person/214413"}}, {tmdbId:"139135", properties:{bornIn:"New York City, New York, U.S.", imdbId:"2501633", born:date('1986-05-13'), name:"Lena Dunham", bio:"Lena graduated from Oberlin College in 2008, where she studied Creative Writing.  Her first short film, Dealing, premiered at the 2007 Slamdance Film Festival.  Her first feature, Creative Nonfiction,  premiered at SXSW 2009 and enjoyed a theatrical premiere at Anthology Film Archives.  She has made two webseries, Tight Shots and Delusional Downtown Divas...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zeat3H7eonT5CuUl0SQMk2XcKKN.jpg", url:"https://themoviedb.org/person/139135"}}, {tmdbId:"142276", properties:{bornIn:"New York, New York, USA", imdbId:"1413364", born:date('1981-10-01'), name:"Ariel Schulman", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rvQFxqTWnwlGnpI8ezwOJBPMvAQ.jpg", url:"https://themoviedb.org/person/142276"}}, {tmdbId:"142272", properties:{bornIn:"USA", imdbId:"1160962", born:date('1981-07-25'), name:"Henry Joost", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/90gxclYdhTWtdT1LI9L5dKjLgNd.jpg", url:"https://themoviedb.org/person/142272"}}, {tmdbId:"131617", properties:{bornIn:"Redland, Bristol, England, UK", imdbId:"2612991", name:"Banksy", bio:"Anonymous British graffiti artist, political activist, film director and painter Banksy whose real name is believed to be Robert Banks, is best known for his artistic works of political and social commentary.   Banksy began as a freehand graffiti artist 1992–1994 inspired by local artists and his work was part of the larger Bristol underground scene.  \n\nBanksy's first film “Exit Through the Gift Shop” (2010) made its debut at the 2010 Sundance Film Festival...", url:"https://themoviedb.org/person/131617"}}, {tmdbId:"78040", properties:{imdbId:"1731937", name:"Alex Kendrick", bio:"Alex Kendrick serves as Associate Pastor of Media for Sherwood Baptist Church and teaches a televised Bible study seen in Southwest Georgia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uNsOtdi7oGuWmDVufKyhMuRCSTm.jpg", url:"https://themoviedb.org/person/78040"}}, {tmdbId:"1136406", properties:{bornIn:"Kingston upon Thames, Surrey, England, UK", imdbId:"4043618", born:date('1996-06-01'), name:"Tom Holland", bio:"Thomas \"Tom\" Stanley Holland is an English actor and dancer.  He is best known for playing the title role in Billy Elliot the Musical at the Victoria Palace Theatre, London, as well as for starring in the 2012 film The Impossible...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ip7aXVH8s6wXv8cY6KI14OZgCI8.jpg", url:"https://themoviedb.org/person/1136406"}}, {tmdbId:"41039", properties:{bornIn:"Flushing, New York, U.S.", imdbId:"0031976", born:date('1967-12-06'), name:"Judd Apatow", bio:"Judd Apatow (born December 6, 1967) is an American film producer, director, and screenwriter.  He is well known for his work in comedy, especially for films he has been involved with throughout the latter half of the 2000s.  He is the founder of Apatow Productions, a film production company that also developed the cult television series Freaks and Geeks and Undeclared.   Description above from the Wikipedia article Judd Apatow, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iXlnv4NvZkmhB7bJBXea5T21gBT.jpg", url:"https://themoviedb.org/person/41039"}}, {tmdbId:"45407", properties:{bornIn:"New Orleans, Louisiana, USA", imdbId:"0243233", born:date('1976-12-07'), name:"Mark Duplass", bio:"Mark David Duplass  (born 7 December 1976) is an American film director, film producer, actor and screenwriter. \n\nDuplass was born in New Orleans, Louisiana.  He is the brother of director and writer Jay Duplass.  He is also the lead singer of the rock band Volcano, I'm Still Excited!!. \n\nDuplass is one of the founders of the mumblecore aesthetic.  He co-wrote the film The Puffy Chair and co-directed the film Baghead with his brother Jay...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lRDf99rAfcdqt8Cqk4LsIT7XSD2.jpg", url:"https://themoviedb.org/person/45407"}}, {tmdbId:"113373", properties:{bornIn:"Shrewsbury, Massachusetts, United States", imdbId:"1898126", born:date('1978-06-20'), name:"Mike Birbiglia", bio:"Mike Birbiglia (born June 20, 1978) is an American comedian, writer, and actor. \n\nDescription above from the Wikipedia article Mike Birbiglia, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kK7dXCSPMRx9EYAFvZ0ugA1sMUZ.jpg", url:"https://themoviedb.org/person/113373"}}, {tmdbId:"144009", properties:{bornIn:"Columbus, Ohio, USA", imdbId:"1102140", born:date('1974-07-29'), name:"Josh Radnor", bio:"​From Wikipedia, the free encyclopedia. \n\nJoshua Michael \"Josh\" Radnor (born July 29, 1974, height 6' (1,83 m)) is an American actor, writer and director.  He is best known for portraying the main character Ted Mosby on the popular, Emmy Award-winning CBS sitcom How I Met Your Mother.  He made his writing and directorial debut with the 2010 comedy-drama film Happythankyoumoreplease, for which won the Sundance Film Festival Audience Award and was nominated the Grand Jury Prize...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uraUtmQtOMvxZxlMg9Qe9Umf1b5.jpg", url:"https://themoviedb.org/person/144009"}}, {tmdbId:"18864", properties:{bornIn:"Lynnwood, Washington, USA", imdbId:"0569891", born:date('1964-08-07'), name:"Tom McGrath", bio:"From Wikipedia, the free encyclopedia. \n\nThomas \"Tom\" McGrath (born August 7, 1965) is an American voice actor and animator who co-directed (with Eric Darnell) the 2005 feature Madagascar and its sequel, Madagascar: Escape 2 Africa in 2008.  He has also worked as a voice actor on other DreamWorks animated features like Flushed Away in 2006 and Shrek the Third in 2007.  He also stepped in on Flushed Away to help make improvements prior to its release...", url:"https://themoviedb.org/person/18864"}}, {tmdbId:"12098", properties:{bornIn:"Roslyn, NY Long Island", imdbId:"3735491", born:date('1975-09-23'), name:"Chris Miller", bio:"From Wikipedia, the free encyclopedia  Chris Miller is an American animator, director, screenwriter, television producer, and voice actor.  He studied animation at the California Institute of Arts, and joined Dreamworks SKG in 1998 as a storyboard artist for the studio's first animated comedy, Antz.  Miller, again working as a story artist for Shrek, also wrote additional dialogue and provided the voice of the Magic Mirror and Geppetto characters for the film...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qKdbhP9amIRlydcoivWlTx3szuS.jpg", url:"https://themoviedb.org/person/12098"}}, {tmdbId:"12080", properties:{bornIn:"Lubbock, Texas, USA", imdbId:"0970447", born:date('1968-07-11'), name:"Conrad Vernon", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c7MIz3sy6UPhBh9YnThd7j8ypdl.jpg", url:"https://themoviedb.org/person/12080"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor:Director;
UNWIND [{tmdbId:"77921", properties:{bornIn:"Ube, Yamaguchi, Japan", imdbId:"0030417", born:date('1960-05-22'), name:"Hideaki Anno", bio:"​From Wikipedia, the free encyclopedia\n\nHideaki Anno (born May 22, 1960 in Ube, Yamaguchi) is a Japanese animation and film director.  Anno is best known for his work on the popular anime series Neon Genesis Evangelion...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vdqUa18A8D2lIVgxpzWS4ldU3PL.jpg", url:"https://themoviedb.org/person/77921"}}, {tmdbId:"10765", properties:{bornIn:"Lódz, Lódzkie, Poland", imdbId:"0005647", born:date('1950-03-06'), name:"Andrzej Bartkowiak", bio:"​From Wikipedia, the free encyclopedia\n\nAndrzej Bartkowiak, A. S. C.  (born 1950 in Łódź, Poland) is a Polish cinematographer and director.  In the early 1980s, Bartkowiak was cinematographer on three films that received Academy Award nominations for Best Picture: The Verdict, Terms of Endearment, and Prizzi's Honor.  Bartkowiak has directed the films Romeo Must Die, Cradle 2 the Grave, Exit Wounds, and Doom (based on the computer game)...", url:"https://themoviedb.org/person/10765"}}, {tmdbId:"98631", properties:{bornIn:"Oak Ridge, Tennessee", imdbId:"1417392", born:date('1982-10-03'), name:"Adam Wingard", bio:"​From Wikipedia, the free encyclopedia.   \n\nAdam Wingard (born December 3, 1982 in Oak Ridge, Tennessee) is an American film director, editor, cinematographer, and writer whose films are known for their emphasis on horror, extreme violence, and psychedelic imagery.  Wingard graduated from Full Sail University in 2002 and was featured on the premiere episode of Fox Reality Show On the Lot.  He frequently collaborates with screenwriter/producer E. L...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/GbBJGw5yDrS3laSCB61usDA1fq.jpg", url:"https://themoviedb.org/person/98631"}}, {tmdbId:"84369", properties:{imdbId:"0418659", name:"Eugene Jarecki", bio:"​From Wikipedia, the free encyclopedia.   \n\nEugene Jarecki is an author and a dramatic and documentary filmmaker based in New York. \n\nHis works include Why We Fight, which won the 2005 Grand Jury Prize at the Sundance Film Festival, The Trials of Henry Kissinger, Reagan, Freakonomics, Quest of the Carib Canoe, and Season of the Lifterbees. \n\nDescription above from the Wikipedia article Eugene Jarecki, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/84369"}}, {tmdbId:"10781", properties:{bornIn:"Aylesbury, Buckinghamshire, England, UK", imdbId:"0000776", born:date('1941-02-10'), name:"Michael Apted", bio:"Michael David Apted, CMG (born 10 February 1941) is an English director, producer, writer and actor.  He is one of the most prolific British film directors of his generation but is best known for his work on the Up Series of documentaries and the James Bond film The World Is Not Enough. \n\nOn 29 June 2003 he was elected president of the Directors Guild of America.  He returned to television, directing the first three episodes of the TV series Rome...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8ZLhPKz9CDZdbvFCIBAJMfd9IxE.jpg", url:"https://themoviedb.org/person/10781"}}, {tmdbId:"929825", properties:{bornIn:"Long Beach, California, USA", imdbId:"1148550", born:date('1972-08-24'), name:"Ava DuVernay", bio:"Ava Marie DuVernay (born August 24, 1972) is an American director, screenwriter, film marketer, and film distributor.  At the 2012 Sundance Film Festival, DuVernay won the Best Director Prize for her second feature film Middle of Nowhere, becoming the first African-American woman to win the award.  For her work in Selma (2014), DuVernay was the first black female director to be nominated for a Golden Globe Award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/84rc8I3Wf5zkCWGMNeTtmRekHW0.jpg", url:"https://themoviedb.org/person/929825"}}, {tmdbId:"45730", properties:{bornIn:"North Carolina, USA", imdbId:"1023919", born:date('1975-03-20'), name:"Ramin Bahrani", bio:"Ramin Bahrani is an American director and screenwriter.  Film critic Roger Ebert listed Bahrani's film Chop Shop as the 6th best film of the decade and hailed Bahrani as \"the director of the decade. \"  Bahrani was the recipient of the prestigious 2009 Guggenheim Fellowship, and was the subject of several international retrospectives including the MoMA in New York City, Harvard University, and the La Rochelle Film Festival in France...", url:"https://themoviedb.org/person/45730"}}, {tmdbId:"40863", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"1846132", born:date('1981-08-31'), name:"Joe Swanberg", bio:"Joe Swanberg (born August 31, 1981) is an American independent film director, producer, writer, and actor.  Known for micro-budget films which make extensive use of improvisation, Swanberg is considered a major figure in the mumblecore film movement...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z71ZaA01Gje5MyMGe5EWqfb74gf.jpg", url:"https://themoviedb.org/person/40863"}}, {tmdbId:"8020", properties:{bornIn:"Cornwall, Stato di New York, Stati Uniti", imdbId:"0434969", born:date('1967-01-01'), name:"John Kahrs", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4rIHgaFUG5pMiqawXKNiLe9GXSj.jpg", url:"https://themoviedb.org/person/8020"}}, {tmdbId:"109314", properties:{bornIn:"Fremont, California, USA", imdbId:"0381116", born:date('1976-08-01'), name:"Don Hertzfeldt", bio:"Don Hertzfeldt (born August 1, 1976) is a two-time Academy Award-nominated animator, artist, writer, and independent filmmaker.  He is the creator of many animated films, including It's Such a Beautiful Day, World of Tomorrow, The Meaning of Life, and Rejected.  His films have received over 250 awards and have been presented around the world. \n\nDescription above from the Wikipedia article Don Hertzfeldt, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/khM0yJLnKGqv2jCeTiVMZ48chng.jpg", url:"https://themoviedb.org/person/109314"}}, {tmdbId:"69500", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0004693", born:date('1933-12-13'), name:"Lou Adler", bio:"From Wikipedia, the free encyclopedia. \n\nLou Adler (born December 13, 1933) is an American record producer, manager, and director. \n\nDescription above from the Wikipedia article Lou Adler, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/69500"}}, {tmdbId:"1155547", properties:{bornIn:"Grass Valley, California, Stati Uniti", imdbId:"2674307", born:date('1983-04-23'), name:"Patrick Brice", bio:"Patrick Brice (born April 23, 1983) is an American film director, actor, and screenwriter, known for the films The Overnight and Creep...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8Jf2hG2L0vjvS1SFHI9NO7spbQU.jpg", url:"https://themoviedb.org/person/1155547"}}, {tmdbId:"1271317", properties:{imdbId:"5525244", name:"John Maloof", url:"https://themoviedb.org/person/1271317"}}, {tmdbId:"71551", properties:{bornIn:"Holmdel, New Jersey, USA", imdbId:"1032521", born:date('1978-05-01'), name:"Lorene Scafaria", bio:"Lorene Scafaria (born May 1, 1978) is an American screenwriter, playwright, actress, singer, and film director.  She is best known for her work on the films Nick & Norah's Infinite Playlist and Seeking a Friend for the End of the World, the latter her debut as director in 2012...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uToUw9I39wMiBWkCdcYO6gnz4S8.jpg", url:"https://themoviedb.org/person/71551"}}, {tmdbId:"1325836", properties:{bornIn:"California, - USA", imdbId:"0606442", born:date('1958-01-01'), name:"Christopher Morris", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kiwARGrffEwYr4KlZv9luXx1v4k.jpg", url:"https://themoviedb.org/person/1325836"}}, {tmdbId:"98251", properties:{imdbId:"2928364", born:date('1979-04-09'), name:"Sebastián Silva", bio:"Sebastián Silva is a Chilean director, screenwriter, painter and musician.  After graduating from the Catholic Colegio del Verbo Divino school in Santiago, he spent a year studying filmmaking at the Escuela de Cine de Chile before leaving to study animation in Montreal, Canada.  Here, he mounted the first gallery exhibition of his illustrations and started the band CHC, which went on to record three albums...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uvRKkoWqzTIxxSSEfK4f5com6TB.jpg", url:"https://themoviedb.org/person/98251"}}, {tmdbId:"45405", properties:{bornIn:"New Orleans, Louisiana, USA", imdbId:"0243231", born:date('1973-03-07'), name:"Jay Duplass", bio:"An American film director.  He is best known for his debut film The Puffy Chair and Baghead.  His brother Mark Duplass has worked with him on both films.  Duplass attributes much of his and his brother's love for film to his appreciation for Raising Arizona.  In an interview with Robert K.  Elder for The Film That Changed My Life , Duplass speculates on what might have happened had he not seen the film in his youth.  I probably wouldn’t be making movies—seriously.  It held over for so long...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zDaNqdtchFBGmT6yR6prTm0rd4V.jpg", url:"https://themoviedb.org/person/45405"}}, {tmdbId:"1462214", properties:{imdbId:"6247887", born:date('1985-12-23'), name:"David Sandberg", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/giUEJuTCiCKAz6FDmy3jbMN0eIn.jpg", url:"https://themoviedb.org/person/1462214"}}, {tmdbId:"1219130", properties:{bornIn:"Thorburn, Nova Scotia, Canada", imdbId:"1034266", born:date('1972-08-27'), name:"Mike Smith", bio:"Mike Smith is a Canadian actor and musician born in New Glasgow, Nova Scotia, and raised in Thorburn.  He earned a degree in English from St.  Francis Xavier University in Antigonish, Nova Scotia.  He played hockey for the Pictou County Weeks of the Nova Scotia Midget AAA Hockey League when he was in high school.  For a short time in 2006, he was engaged to actress Nichole Hiltz...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/36FbgvqpEUyrpTpW4qxcXI91ZVs.jpg", url:"https://themoviedb.org/person/1219130"}}, {tmdbId:"47640", properties:{bornIn:"Philadelphia, Pennsylvania, USA ", imdbId:"0424800", born:date('1954-09-10'), name:"Clark Johnson", bio:"Clark Johnson  (born September 10, 1954), sometimes credited as Clark 'Slappy' Jackson, Clarque Johnson, and J.  Clark Johnson, is an American actor and director who has worked in both television and film...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ejNR1am9cDQOEaJ555IsvXo7XPO.jpg", url:"https://themoviedb.org/person/47640"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor:Director;
UNWIND [{tmdbId:"455", properties:{bornIn:"London, Ontario, Canada", imdbId:"0353673", born:date('1953-03-10'), name:"Paul Haggis", bio:"Paul Edward Haggis (born March 10, 1953) is a Canadian screenwriter, producer, and director.  He spent his early career producing and directing various American and Canadian television network series...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bO2CPKFOtv1uigPM8crWTC071wr.jpg", url:"https://themoviedb.org/person/455"}}, {tmdbId:"11523", properties:{bornIn:"Paris, France", imdbId:"0617588", born:date('1861-12-08'), name:"Georges Méliès", bio:"Georges Méliès, full name Marie-Georges-Jean Méliès, was a French illusionist and filmmaker famous for leading many technical and narrative developments in the earliest days of cinema.  One of the first filmmakers to use multiple exposures, time-lapse photography, tracking shots, dissolves, and hand-painted color in his work, Méliès pioneered effects that would define cinematic special effects for decades to come...", died:date('1938-01-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ba3Kfc01Dbigt41lyuFoZR7gmv1.jpg", url:"https://themoviedb.org/person/11523"}}, {tmdbId:"13848", properties:{bornIn:"Walworth, London, England, UK", imdbId:"0000122", born:date('1889-04-16'), name:"Charlie Chaplin", bio:"Charles “Charlie” Chaplin (16 April 1889 – 25 December 1977) was an English comic actor, film director and composer best-known for his work during the silent film era.  He used mime, slapstick and other visual comedy routines, and continued well into the era of the talkies, though his films decreased in frequency by the end of the 1920s.  His most famous role was that of The Tramp, which he first played in Kid Auto Races (1914)...", died:date('1977-12-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lRI9Ky1SMOehn04OqhYJ5hQfgIK.jpg", url:"https://themoviedb.org/person/13848"}}, {tmdbId:"793", properties:{bornIn:"Calanda, Teruel, Aragón, España", imdbId:"0000320", born:date('1900-02-21'), name:"Luis Buñuel", bio:"Luis Buñuel Portolés was a Spanish filmmaker who worked in Spain, Mexico, and France.  When Luis Buñuel died at age 83, his obituary in the New York Times called him \"an iconoclast, moralist, and revolutionary who was a leader of avant-garde surrealism in his youth and a dominant international movie director half a century later\"...", died:date('1983-07-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a7wib1eRG6TyonDXpAbF7PZd0f8.jpg", url:"https://themoviedb.org/person/793"}}, {tmdbId:"1150", properties:{bornIn:"Newark, New Jersey, USA", imdbId:"0000361", born:date('1940-09-11'), name:"Brian De Palma", bio:"Brian Russell De Palma is an American film director and writer.  In a career spanning over 40 years, he is probably best known for his suspense and crime thriller films, including such box office successes as Carrie, Dressed to Kill, Scarface, The Untouchables, and Mission: Impossible...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rQNkUdKRKv1A4s7N4xcFnJior6n.jpg", url:"https://themoviedb.org/person/1150"}}, {tmdbId:"18533", properties:{bornIn:"Hewlett, Long Island, New York, USA", imdbId:"0001554", born:date('1948-02-05'), name:"Errol Morris", bio:"From Wikipedia, the free encyclopedia. \n\nErrol Morris (born February 5, 1948) is an American director.  In 2003, The Guardian put him seventh in its list of the world's 40 best directors.  As of 2010, Morris has won one Academy Award for Best Documentary Film. \n\nDescription above from the Wikipedia article Errol Morris, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x72lW3qu7RovWvtJRJNuDVeU8Hz.jpg", url:"https://themoviedb.org/person/18533"}}, {tmdbId:"608", properties:{bornIn:"Tokyo, Japan", imdbId:"0594503", born:date('1941-01-05'), name:"Hayao Miyazaki", bio:"Hayao Miyazaki (Miyazaki Hayao, born January 5, 1941) is a Japanese manga artist and prominent film director and animator of many popular anime feature films.  Through a career that has spanned nearly five decades, Miyazaki has attained international acclaim as a maker of animated feature films and, along with Isao Takahata, co-founded Studio Ghibli, an animation studio and production company...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1OBQPIwR88n49oAEzk47k0fhhOV.jpg", url:"https://themoviedb.org/person/608"}}, {tmdbId:"127491", properties:{bornIn:"Paris, Ile-de-France, France", imdbId:"0487351", born:date('1925-11-27'), name:"Claude Lanzmann", died:date('2018-07-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2BXL67HvITmcUXiGHxfTWtVDZrt.jpg", url:"https://themoviedb.org/person/127491"}}, {tmdbId:"1884", properties:{bornIn:"Atlanta, Georgia, USA", imdbId:"0001752", born:date('1963-01-14'), name:"Steven Soderbergh", bio:"Steven Andrew Soderbergh is an American film producer, screenwriter, cinematographer, editor, and an Academy Award-winning film director.  He is best known for directing commercial Hollywood films like Erin Brockovich, Traffic, and Ocean's Eleven, but he has also directed smaller less conventional and commercialized works such as Sex, Lies, and Videotape, Schizopolis, Bubble, and Che...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/y8JlSDcQzd7gAaKyxFpExupMwDz.jpg", url:"https://themoviedb.org/person/1884"}}, {tmdbId:"1188", properties:{bornIn:"Bonghwa, North Gyeongsang, South Korea", imdbId:"1104118", born:date('1960-12-20'), name:"Kim Ki-duk", bio:"Kim Ki-duk (born December 20, 1960) is a South Korean filmmaker noted for his idiosyncratic \"art-house\" cinematic works.  His films have received many distinctions in the festival circuit.  He is not related to the Kim Ki-duk who directed Yonggary in the 1960s.  He has given scripts to several of his former assistant directors including Jeon Jae-hong (Beautiful) and Jang Hun (Rough Cut)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jvDwwSEtcPfxcUB1NlLbMHFB5ze.jpg", url:"https://themoviedb.org/person/1188"}}, {tmdbId:"65310", properties:{bornIn:"Palo Alto, California, USA", imdbId:"0650905", born:date('1950-04-18'), name:"Kenny Ortega", bio:"Kenneth John \"Kenny\" Ortega (born April 18, 1950) is an American producer, director, and choreographer.  He is known for directing the High School Musical trilogy and Michael Jackson's This Is It concert tour...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cZrsOBr1tp1nNPJ5xj3uao2XQbJ.jpg", url:"https://themoviedb.org/person/65310"}}, {tmdbId:"52049", properties:{bornIn:"Chicago - Illinois - USA", imdbId:"0151540", born:date('1968-04-09'), name:"Jay Chandrasekhar", bio:"From Wikipedia, the free encyclopedia\n\nJayanth Jambulingam \"Jay\" Chandrasekhar ( born April 9, 1968) is an American actor, comedian, writer, and film director with the comedy team Broken Lizard...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gkY7ObdU0PMNW6sOFLb3At7SSsT.jpg", url:"https://themoviedb.org/person/52049"}}, {tmdbId:"40250", properties:{bornIn:"Chicago, Illinois", imdbId:"0227576", born:date('1962-11-28'), name:"Paul Dinello", bio:"From Wikipedia, the free encyclopedia. \n\nPaul Dinello (born November 28, 1962) is an American actor, comedian, writer, director, and an alumnus of Chicago-based The Second City, Improv Institute, and Annoyance Theatre.  He is best known for his role on Comedy Central's Strangers with Candy as Geoffrey Jellineck, the closeted gay art teacher at Flatpoint High, who carries on a not-so-secret relationship with his colleague Chuck Noblet (Stephen Colbert)...", url:"https://themoviedb.org/person/40250"}}, {tmdbId:"53384", properties:{bornIn:"London, England, UK", imdbId:"1498640", born:date('1968-01-10'), name:"Zana Briski", bio:"From Wikipedia, the free encyclopedia. \n\nZana Briski  is an English artist (photographer, filmmaker) and activist. \n\nBriski's interest in photography began at age 10.  After earning a master's degree at the University of Cambridge, Briski studied documentary photography at International Center of Photography in New York.  In 1995, she made her first trip to India, producing a story on female infanticide...", url:"https://themoviedb.org/person/53384"}}, {tmdbId:"126638", properties:{bornIn:"Los Angeles County, California, USA", imdbId:"0028764", born:date('1968-09-12'), name:"Mark Andrews", bio:"From Wikipedia, the free encyclopedia\n\nMark Andrews is a Pixar employee.  He was the story supervisor for The Incredibles, directed the short film One Man Band and co-wrote the short films Jack-Jack Attack and One Man Band. \n\nHe studied animation at the Character Animation Program at CalArts.  He is also considered to be Brad Bird's \"right-hand man\".  Some of his student films have been featured at MOMA's exhibition TOMORROWLAND: CalArts in Moving Pictures...", url:"https://themoviedb.org/person/126638"}}, {tmdbId:"150385", properties:{imdbId:"1202568", name:"Abby Epstein", url:"https://themoviedb.org/person/150385"}}, {tmdbId:"1426405", properties:{imdbId:"3672532", name:"Amy S. Weber", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iikbUXDvjz8GGToOLl5gNkmYdxS.jpg", url:"https://themoviedb.org/person/1426405"}}, {tmdbId:"1081559", properties:{imdbId:"0003786", name:"Marc Singer", url:"https://themoviedb.org/person/1081559"}}, {tmdbId:"77301", properties:{bornIn:"Tangshan, Hebei, China", imdbId:"0422638", born:date('1963-01-05'), name:"Jiang Wen", bio:"Jiang Wen (born 5 January 1963) is a Chinese film actor, screenwriter, and director.  As a director, he is sometimes grouped with the \"Sixth Generation\" that emerged in the 1990s.  Jiang is also well known internationally as an actor, having starred with Gong Li in Zhang Yimou's debut film Red Sorghum (1986), and more recently as Baze Malbus in the Star Wars film Rogue One (2016).  He is the older brother of fellow actor Jiang Wu...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i9LPPa6JgQ42AHZS6BxOHwWtDmL.jpg", url:"https://themoviedb.org/person/77301"}}, {tmdbId:"26775", properties:{bornIn:"Xinhui, Guangdong, China", imdbId:"0514906", born:date('1936-08-01'), name:"Liu Chia-Liang", bio:"Lau Kar-leung (Chinese: 劉家良, 28 July 1934 – 25 June 2013), also known as Liu Chia-liang, was a Hong Kong-based Chinese actor, filmmaker, choreographer and martial artist.  Lau is best known for the films he made in the 1970s and 1980s for the Shaw Brothers Studio.  One of his most famous works is The 36th Chamber of Shaolin which starred Gordon Liu, as well as Drunken Master II which starred Jackie Chan...", died:date('2013-06-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1cKWtvMp0onUAn4OfuclM1693gn.jpg", url:"https://themoviedb.org/person/26775"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor:Director;
UNWIND [{tmdbId:"86325", properties:{bornIn:"Onyang, South Chungcheong, South Korea", imdbId:"0753423", born:date('1973-12-15'), name:"Ryoo Seung-wan", bio:"Ryoo Seung-wan (류승완) is a South Korean film writer, director, and actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kSCf7Mctlhyy1epTUMP5LvmLpmq.jpg", url:"https://themoviedb.org/person/86325"}}, {tmdbId:"14674", properties:{bornIn:"Lower East Side, Manhattan, New York City, New York, USA", imdbId:"0002030", born:date('1899-07-07'), name:"George Cukor", bio:"From Wikipedia, the free encyclopedia\n\nGeorge Dewey Cukor was an American film director.  He mainly concentrated on comedies and literary adaptations.  His career flourished at RKO and later MGM, where he directed What Price Hollywood? (1932), A Bill of Divorcement (1932), Dinner at Eight (1933), Little Women (1933), David Copperfield (1935), Romeo and Juliet (1936) and Camille (1936)...", died:date('1983-01-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vN3htY1yJULUwIqdA6v97uPM6aA.jpg", url:"https://themoviedb.org/person/14674"}}, {tmdbId:"584527", properties:{bornIn:"Wuxi, Jiangsu Province, China", born:date('1944-03-28'), name:"Jimmy Wang Yu", bio:"Wang Zhengquan (born March 28, 1943), better known as Jimmy Wang Yu (Chinese: 王羽) and Wong Yu-lung, is a Chinese actor, film director, producer and screenwriter.  Wang rose to fame in 1967 with his starring role in The One-Armed Swordsman, a martial arts film produced by the Shaw Brothers Studio.  The Chinese Boxer (1969), another film he acted in, is credited as the first Hong Kong action film that kickstarted the unarmed combat genre that took Asia by storm in the 1970s...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dkQhkl14MHtakKPZ48HNES2hN3f.jpg", url:"https://themoviedb.org/person/584527"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor:Director;
UNWIND [{tmdbId:"119672", properties:{bornIn:"Glasgow, Scotland", imdbId:"0665737", born:date('1883-07-23'), name:"Stuart Paton", bio:"​From Wikipedia, the free encyclopedia.   \n\nStuart Paton (23 July 1883 – 16 December 1944) was a British director, screenwriter and actor of the silent era.  He directed 67 films between 1915 and 1938.  He also wrote for 24 films between 1914 and 1927.  Despite a sizable list of credits, Paton was never well-regarded, especially as a director. \n\nHe was born in Glasgow, Scotland and died in Woodland Hills, Los Angeles.  His remains are buried at Chapel of the Pines Crematory...", died:date('1944-12-16'), url:"https://themoviedb.org/person/119672"}}, {tmdbId:"29168", properties:{bornIn:"Berlin, Germany", imdbId:"0091380", born:date('1887-08-26'), name:"Carl Boese", died:date('1958-07-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qGa9J3Z5XrZbsFfVY5G3nhYhrZz.jpg", url:"https://themoviedb.org/person/29168"}}, {tmdbId:"89674", properties:{bornIn:"Viborg, Denmark", imdbId:"0159725", born:date('1879-09-28'), name:"Benjamin Christensen", bio:"From Wikipedia, the free encyclopedia. \n\nBenjamin Christensen (28 September 1879 - 2 April 1959) was a Danish film director, screenwriter and an actor both in film and on the stage.  As a director he is most well known for the 1922 film Häxan and as an actor, he is best known for his performance in the film Michael (1924), in which he plays Claude Zoret, the jilted lover of the film's title character...", died:date('1959-04-02'), url:"https://themoviedb.org/person/89674"}}, {tmdbId:"10092", properties:{bornIn:"Iron Mountain, Michigan, USA", imdbId:"0280904", born:date('1884-02-16'), name:"Robert J. Flaherty", bio:"Robert Joseph Flaherty, FRGS (/ˈflæ. ərti, ˈflɑː-/; February 16, 1884 – July 23, 1951) was an American filmmaker who directed and produced the first commercially successful feature-length documentary film, Nanook of the North (1922).  The film made his reputation and nothing in his later life fully equaled its success, although he continued the development of this new genre of narrative documentary with Moana (1926), set in the South Seas, and Man of Aran (1934), filmed in Ireland's Aran Islands...", died:date('1951-07-23'), url:"https://themoviedb.org/person/10092"}}, {tmdbId:"9076", properties:{bornIn:"Bielefeld, North-Rhine-Westphalia, Germany", imdbId:"0003638", born:date('1888-12-28'), name:"F.W. Murnau", bio:"Friedrich Wilhelm \"F.  W. \" Murnau was one of the most influential German film directors of the silent era, and a prominent figure in the expressionist movement in German cinema during the 1920s.  Although some of Murnau's films have been lost, most still survive...", died:date('1931-03-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dYsDlJg7XMM8knC7y8ndeIHMA9F.jpg", url:"https://themoviedb.org/person/9076"}}, {tmdbId:"10516", properties:{bornIn:"Rice Lake, Wisconsin, USA", imdbId:"0090007", born:date('1892-12-02'), name:"John G. Blystone", died:date('1938-08-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/isOUSJrLtcqY5wlMd4997g8KJ9G.jpg", url:"https://themoviedb.org/person/10516"}}, {tmdbId:"143385", properties:{imdbId:"0628345", born:date('1888-08-09'), name:"Fred C. Newmeyer", died:date('1967-04-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/enAo4JvvixXKDxLGRB4lzEOT5aH.jpg", url:"https://themoviedb.org/person/143385"}}, {tmdbId:"8823", properties:{bornIn:"New York City, New York, USA", imdbId:"0909825", born:date('1887-03-11'), name:"Raoul Walsh", bio:"​From Wikipedia, the free encyclopedia.   \n\nRaoul Walsh (March 11, 1887 – December 31, 1980) was an American film director, actor, founding member of the Academy of Motion Picture Arts and Sciences (AMPAS) and the brother of silent screen actor George Walsh...", died:date('1980-12-31'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vNB6VjOdw3MLJG4AsBe2IGYrjdo.jpg", url:"https://themoviedb.org/person/8823"}}, {tmdbId:"9603", properties:{bornIn:"Riga, Russian Empire", imdbId:"0001178", born:date('1898-01-23'), name:"Sergei M. Eisenstein", bio:"Sergei Mikhailovich Eisenstein was a pioneering Soviet Russian film director and film theorist, often considered to be the \"Father of Montage. \" He is noted in particular for his silent films Strike (1924), Battleship Potemkin (1925) and October (1927), as well as the historical epics Alexander Nevsky (1938) and Ivan the Terrible (1944, 1958).  His work profoundly influenced early filmmakers owing to his innovative use of and writings about montage...", died:date('1948-02-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ks9uuDtKu9m9w50t18PamLZ91to.jpg", url:"https://themoviedb.org/person/9603"}}, {tmdbId:"29250", properties:{bornIn:"Minneapolis, Minnesota, USA", imdbId:"0398464", born:date('1885-08-06'), name:"Harry O. Hoyt", bio:"From Wikipedia, the free encyclopedia. \n\nHarry O.  Hoyt (6 August 1885 - 29 July 1961) was an American screenwriter and film director whose career began in the silent era.  His 1925 film The Lost World, based on the book by Arthur Conan Doyle, is notable as a pioneering effort in the use of stop-motion animation.  He was a brother of actor Arthur Hoyt who appeared in The Lost World. \n\nDescription above from the Wikipedia article Harry O...", died:date('1961-07-29'), url:"https://themoviedb.org/person/29250"}}, {tmdbId:"14473", properties:{bornIn:"Whangaroa, New Zealand", imdbId:"0432216", born:date('1879-01-25'), name:"Rupert Julian", bio:"​From Wikipedia, the free encyclopedia\n\nRupert Julian (25 January 1879 – 27 December 1943) was the first New Zealand cinema actor, director, writer and producer. \n\nBorn Thomas Percival Hayes in Whangaroa, New Zealand, Son of John Daly Hayes (JNR)and Eliza Harriet Hayes.  Rupert Julian performed on stage and in film both in his native country and Australia before emigrating to the United States in 1911, where he started his career as an actor in Universal silent movies...", died:date('1943-12-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aCHl67x31chy9vRTs7EoGOF6J7l.jpg", url:"https://themoviedb.org/person/14473"}}, {tmdbId:"1167523", properties:{imdbId:"0480677", name:" Ernst Laemmle", url:"https://themoviedb.org/person/1167523"}}, {tmdbId:"122969", properties:{bornIn:"Galveston, Texas, USA", imdbId:"0781292", born:date('1891-11-07'), name:" Edward Sedgwick", bio:"Edward Sedgwick was an American film director, actor, writer, and producer, his career spanning from 1914 to the year of his death...", died:date('1953-05-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4miRlnWpeUBMw1hH4weEcOlUTs8.jpg", url:"https://themoviedb.org/person/122969"}}, {tmdbId:"1098541", properties:{bornIn:"New York City, New York, USA", imdbId:"0169905", born:date('1895-12-03'), name:" J.J. Cohn", died:date('1996-01-12'), url:"https://themoviedb.org/person/1098541"}}, {tmdbId:"2636", properties:{bornIn:"Leytonstone, London, England, UK", imdbId:"0000033", born:date('1899-08-13'), name:"Alfred Hitchcock", bio:"Sir Alfred Joseph Hitchcock, KBE (13 August 1899 – 29 April 1980) was an English director and producer.  He pioneered many techniques in the suspense and psychological thriller genres.  After a successful career in his native United Kingdom in both silent films and early talkies, Hitchcock moved to Hollywood.  In 1956 he became an American citizen while remaining a British subject...", died:date('1980-04-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/108fiNM6poRieMg7RIqLJRxdAwG.jpg", url:"https://themoviedb.org/person/2636"}}, {tmdbId:"114337", properties:{bornIn:"Paris - France", imdbId:"0280463", born:date('1885-02-13'), name:"George Fitzmaurice", bio:"From Wikipedia\n\nGeorge Fitzmaurice (13 February 1885 – 13 June 1940) was a French-born film director and producer. \n\nFitzmaurice's career first started as a set designer on stage.  Beginning in 1914 until his death in 1940, he directed over 80 films, including several successful movies such as The Son of the Sheik, Raffles, Mata Hari, and Suzy...", died:date('1940-06-13'), url:"https://themoviedb.org/person/114337"}}, {tmdbId:"2798", properties:{bornIn:"Frankfurt-on-Main, Germany", imdbId:"0752193", born:date('1887-12-28'), name:"Walter Ruttmann", bio:"Walter Ruttmann was a German film director and along with Hans Richter, Viking Eggeling and Oskar Fischinger was an early German practitioner of experimental film.  Ruttmann was born in Frankfurt am Main; His film career began in the early 1920s.  His first abstract short films, Lichtspiel: Opus I (1921) and Opus II (1923), were experiments with new forms of film expression...", died:date('1941-07-15'), url:"https://themoviedb.org/person/2798"}}, {tmdbId:"131405", properties:{bornIn:"San Francisco, California, USA", imdbId:"0395023", born:date('1880-12-14'), name:"James W. Horne", bio:"From Wikipedia, the free encyclopedia.  James Wesley Horne (December 14, 1880 – June 29, 1942) was an early American actor, screenwriter and film director.  He began his career as an actor under director Sidney Olcott at Kalem Studios in 1913 and directed his first film for the company two years later.  Description above from the Wikipedia article James W.  Horne, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1942-06-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wCa2S3XAzLzyVCTNCxVVlfJTuIK.jpg", url:"https://themoviedb.org/person/131405"}}, {tmdbId:"10517", properties:{bornIn:"San Bernardino, California, USA", imdbId:"0115669", born:date('1894-06-30'), name:"Clyde Bruckman", died:date('1955-01-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/b5drnn4Fzof0NBkrz7HFVJ7WfAy.jpg", url:"https://themoviedb.org/person/10517"}}, {tmdbId:"143559", properties:{imdbId:"0397834", name:" J.A. Howe", url:"https://themoviedb.org/person/143559"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"2000", properties:{bornIn:"Kishinev, Russian Empire", imdbId:"0587277", born:date('1895-09-30'), name:" Lewis Milestone", bio:"From Wikipedia, the free encyclopedia. \n\nLewis Milestone (born Lev Milstein) (September 30, 1895 – September 25, 1980) was a Russian-American motion picture director.  He is known for directing Two Arabian Knights (1927) and All Quiet on the Western Front (1930), both of which received Academy Awards for Best Director.  He also directed The Front Page (1931 - nomination), The General Died at Dawn (1936), Of Mice and Men (1940), Ocean's Eleven (1960), and Mutiny on the Bounty (1962)...", died:date('1980-09-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zcbvWlJTkFcVJ86Yjsvx82Mjgul.jpg", url:"https://themoviedb.org/person/2000"}}, {tmdbId:"29720", properties:{bornIn:"Paris, France", imdbId:"0304098", born:date('1889-10-25'), name:"Abel Gance", bio:"Abel Gance was a French film director, producer, writer and actor.  A pioneer in the theory and practice of montage, he is best known for three major silent films: J'accuse (1919), La Roue (1923), and Napoléon (1927).  \n\nHe was born in Paris in 1889.  In 1909, he acted in his first film.  He also wrote scenarios, and often sold them to Gaumont.  During this period he was diagnosed with tuberculosis, fatal at the time, but he recovered...", died:date('1981-11-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fVtRZuYJkt9YFgK4Y2OnCfGFsAu.jpg", url:"https://themoviedb.org/person/29720"}}, {tmdbId:"14643", properties:{bornIn:"Brookline, Massachusetts, USA", imdbId:"0920074", born:date('1896-02-29'), name:"William A. Wellman", bio:"William Augustus Wellman was an American film director.  Although Wellman began his film career as an actor, he worked on over 80 films, as director, producer and consultant but most often as a director, notable for his work in crime, adventure and action genre films, often focusing on aviation themes, a particular passion.  He also directed several well regarded satirical comedies...", died:date('1975-12-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rHkFOPzdJGimnC4yRqophK9tvEO.jpg", url:"https://themoviedb.org/person/14643"}}, {tmdbId:"1147553", properties:{imdbId:"0195496", name:" Harry d'Abbadie d'Arrast", url:"https://themoviedb.org/person/1147553"}}, {tmdbId:"13899", properties:{bornIn:"Raudnitz, Bohemia, Austria-Hungary (now Roudnice, Czech Republic)", imdbId:"0655065", born:date('1885-08-25'), name:"Georg Wilhelm Pabst", bio:"Georg Wilhelm Pabst (25 August 1885 – 29 May 1967), known professionally as G.  W.  Pabst, was an Austrian theatre and film director...", died:date('1967-05-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j3E2joC0UzP5ftZpFsp1SqOK1Xt.jpg", url:"https://themoviedb.org/person/13899"}}, {tmdbId:"11572", properties:{bornIn:"Copenhagen, Denmark", imdbId:"0003433", born:date('1889-02-03'), name:"Carl Theodor Dreyer", bio:"Carl Theodor Dreyer (3 February 1889 – 20 March 1968), commonly known as Carl Th.  Dreyer, was a Danish film director. \n\nHe is regarded by many critics and filmmakers as one of the greatest directors in cinema.  His best known films include The Passion of Joan of Arc (1928), Vampyr (1932), Day of Wrath (1943), Ordet (1955), and Gertrud (1964). \n\nDreyer was born illegitimate in Copenhagen, Denmark...", died:date('1968-03-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hRfidNCKvzM7y86JocRXUJxH8H0.jpg", url:"https://themoviedb.org/person/11572"}}, {tmdbId:"123192", properties:{bornIn:"Kansas City, Missouri, USA", imdbId:"0412650", born:date('1901-03-24'), name:"Ub Iwerks", bio:"American animator, cartoonist, character designer, inventor, and special effects technician, who co-created Oswald the Lucky Rabbit and Mickey Mouse with Walt Disney.  The works Iwerks produced alongside Disney went on to win numerous awards, including multiple Academy Awards.   He was born in Kansas City, Missouri.  His father, Eert Ubbe Iwerks, emigrated to the U. S.  in 1869 from the village of Uttum in East Frisia (northwest Germany, today part of the municipality of Krummhörn)...", died:date('1971-07-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2AKgtZJiB9ySvbsN6KcwKBvEuop.jpg", url:"https://themoviedb.org/person/123192"}}, {tmdbId:"95111", properties:{bornIn:"Bialystok, Grodno Province, Russian Empire", imdbId:"0895048", born:date('1896-01-03'), name:"Dziga Vertov", bio:"Dziga Vertov (born David Abelevich Kaufman) was a Soviet pioneer documentary film and newsreel director, as well as a cinema theorist.  His filming practices and theories influenced the cinéma vérité style of documentary movie-making and the Dziga Vertov Group, a radical film-making cooperative which was active from 1968 to 1972.  The independent, exploratory style of Vertov influenced and inspired many filmmakers and directors.  The Dziga Vertov Group borrowed his name...", died:date('1954-02-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6CvXGGtNiF3ofSe1MFtGwgJnCVo.jpg", url:"https://themoviedb.org/person/95111"}}, {tmdbId:"29808", properties:{bornIn:"Paris, France", imdbId:"0282984", born:date('1900-09-14'), name:"Robert Florey", died:date('1979-05-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cRX6qkTniwyr1Kt0yTWIlqHO25F.jpg", url:"https://themoviedb.org/person/29808"}}, {tmdbId:"130087", properties:{bornIn:"Salt Lake City, Utah, USA", imdbId:"0763798", born:date('1890-01-10'), name:" Joseph Santley", bio:"From Wikipedia, the free encyclopedia\n\nJoseph Mansfield Santley (born Joseph Ishmael Mansfield, January 10, 1890 – August 8, 1971) was an American actor, singer, dancer, writer, director, and producer of musical theatrical plays motion pictures and television shows.  He adopted the stage name of his stepfather, actor Eugene Santley. \n\nJoseph Santley was born in Salt Lake City, Utah...", died:date('1971-08-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xbh7KVy3Fqe6gEDg5WaXtLVxGOX.jpg", url:"https://themoviedb.org/person/130087"}}, {tmdbId:"93905", properties:{imdbId:"0245385", born:date('1885-04-03'), name:"Allan Dwan", bio:"Allan Dwan was born on April 3, 1885 in Toronto, Ontario, Canada as Joseph Aloysius Dwan.  He was a director and writer, known for A Perfect Crime (1921), Bound in Morocco (1918) and A Broken Doll (1921).  He was married to Marie Shelton and Pauline Bush.  He died on December 28, 1981 in Woodland Hills, Los Angeles, California, USA...", died:date('1981-12-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kAvLKEkjOpOzQSEpvFrjF0b5Nq9.jpg", url:"https://themoviedb.org/person/93905"}}, {tmdbId:"144063", properties:{bornIn:"Surrey, England, UK", imdbId:"0373511", born:date('1893-08-27'), name:"Victor Heerman", bio:"From Wikipedia, the free encyclopedia\n\nVictor Heerman (August 27, 1893 – November 3, 1977) was an English-American film director, screenwriter and film producer. [1] After writing and directing short comedies for Mack Sennett, Heerman teamed with his wife Sarah Y.  Mason to win the Academy Award for Best Adapted Screenplay of Louisa May Alcott's novel Little Women in 1933.  He directed the Marx Brothers' second film, Animal Crackers, in 1930...", died:date('1977-11-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wCrucMpJZAUMJsF1KJafCfrZyhu.jpg", url:"https://themoviedb.org/person/144063"}}, {tmdbId:"9054", properties:{bornIn:"San Francisco, California, USA", imdbId:"0503777", born:date('1900-10-15'), name:"Mervyn LeRoy", bio:"Mervyn LeRoy was an American film director, producer, and sometime actor. \n\nLeRoy worked in costumes, processing labs and as a camera assistant until he became a gag writer and actor in silent films, including The Ten Commandments in 1923.  LeRoy credits Ten Commandments director, Cecil B.  DeMille, for inspiring him to become a director: \"As the top director of the era, DeMille had been the magnet that had drawn me to his set as often as I could go...", died:date('1987-09-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xRdJwuUptfFYVR8K6yyMhPgOVmP.jpg", url:"https://themoviedb.org/person/9054"}}, {tmdbId:"21311", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0749484", born:date('1889-06-11'), name:"Wesley Ruggles", bio:"Wesley Ruggles (June 11, 1889 – January 8, 1972) was an American film director. \n\nHe was born in Los Angeles, a younger brother of actor Charles Ruggles.  He began his career in 1915 as an actor, appearing in a dozen or so silent films, on occasion with Charles Chaplin. \n\nIn 1917, he turned his attention to directing, making more than 50 mostly forgettable films — including a silent film version of Edith Wharton's novel The Age of Innocence (1924) — before he won acclaim with Cimarron in 1931...", died:date('1972-01-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8nXwqF6KknxeAxMkdMJ9TrRLQ4D.jpg", url:"https://themoviedb.org/person/21311"}}, {tmdbId:"1496", properties:{bornIn:"Louisville, Kentucky, USA", imdbId:"0115218", born:date('1880-07-12'), name:"Tod Browning", bio:"From Wikipedia, the free encyclopedia. \n\nTod Browning (12 July 1880 – 6 October 1962) was an American motion picture actor, director and screenwriter. \n\nBrowning's career spanned the silent and talkie eras.  Best-known as the director of Dracula (1931), the cult classic Freaks (1932), and classic silent film collaborations with Lon Chaney, Browning directed many movies in a wide range of genres...", died:date('1962-10-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rNbA1xBxMTBznQ8JAYxd7NIjXz6.jpg", url:"https://themoviedb.org/person/1496"}}, {tmdbId:"55335", properties:{bornIn:"Brussels, Belgium", imdbId:"0670643", born:date('1908-03-25'), name:"Mario Peixoto", bio:"From Wikipedia\n\nMário Rodrigues Breves Peixoto (Brussels, Belgium March 3, 1908 – Rio de Janeiro, Brazil February 3, 1992) was a Brazilian film director, mainly known for his only film Limite, a silent experimental film filmed in 1930 and premiered in Rio de Janeiro on 17 May 1931.  Peixoto wrote, directed and took up a minor role in the film...", died:date('1992-02-03'), url:"https://themoviedb.org/person/55335"}}, {tmdbId:"94218", properties:{bornIn:"New Castle, Delaware, USA", imdbId:"0215877", born:date('1893-10-18'), name:"Roy Del Ruth", bio:"​From Wikipedia, the free encyclopedia\n\nRoy Del Ruth (October 18, 1893 – April 27, 1961) was a Hollywood film director.  Del Ruth, who started out as a screenwriter in 1915 writing gags for Mack Sennett, began directing feature films in the 1920s.  He became known for directing urban and crime dramas including the 1931 version of The Maltese Falcon.  He also directed the universally panned The Babe Ruth Story (1948) and the 20th Century Fox B-movie Alligator People (1959)...", died:date('1961-04-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/josjquajOYMHTwljkhTzQRragsh.jpg", url:"https://themoviedb.org/person/94218"}}, {tmdbId:"82389", properties:{bornIn:"Grayling, Michigan, USA", imdbId:"0572851", born:date('1898-09-20'), name:"Norman Z. McLeod", bio:"Norman Zenos McLeod (September 20, 1898, Grayling, Michigan – January 27, 1964, Hollywood, California) was an American film director, cartoonist and writer.  He is considered one of the best directors of comedy films of all time. \n\nMcLeod made several successful and influential movies such as Taking A Chance (1928), Monkey Business (1931), Horse Feathers (1932), Topper (1937) and Merrily We Live (1938).  Other memorable films directed by McLeod includes It's a Gift (1934) with W. C...", died:date('1964-01-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qJgtwcMOU3CtrZx9cdXTVrWpecH.jpg", url:"https://themoviedb.org/person/82389"}}, {tmdbId:"14855", properties:{bornIn:"Salt Lake City, Utah, USA", imdbId:"0097648", born:date('1894-04-23'), name:"Frank Borzage", bio:"From Wikipedia, the free encyclopedia\n\nFrank Borzage (April 23, 1894 – June 19, 1962) was an Academy Award-winning American film director and actor, known for directing 7th Heaven (1927), Street Angel (1928), Bad Girl (1931), A Farewell to Arms (1932), Man's Castle (1933), History Is Made at Night (1937), The Mortal Storm (1940) and Moonrise (1948). \n\nIn 1912 Borzage found employment as an actor in Hollywood; he continued to work as an actor until 1917...", died:date('1962-06-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qRfPaRdyZLug0I8YOWVQ4ykmnbj.jpg", url:"https://themoviedb.org/person/14855"}}, {tmdbId:"34740", properties:{bornIn:"Feltham, Middlesex, England, UK", imdbId:"0332539", born:date('1891-03-20'), name:"Edmund Goulding", bio:"From Wikipedia, the free encyclopedia. \n\nEdmund Goulding (20 March 1891 – 24 December 1959) was a British film writer and director.  Goulding is best remembered for directing cultured dramas and such as Grand Hotel (1932) with Greta Garbo and Joan Crawford, Dark Victory (1939) with Bette Davis, and The Razor's Edge (1946) with Gene Tierney and Tyrone Power.  He also directed the classic film noir Nightmare Alley (1947) with Tyrone Power and Joan Blondell, and the action drama The Dawn Patrol...", died:date('1959-12-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l4h95dSKe2CGNfSuAIRZn7mnwma.jpg", url:"https://themoviedb.org/person/34740"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"70", properties:{bornIn:"Königinhof, Bohemia, Austria-Hungary [now Dvur Kralove, Czech Republic]", imdbId:"0005713", born:date('1890-01-16'), name:"Karl Freund", bio:"​From Wikipedia, the free encyclopedia.   \n\nKarl W.  Freund, A. S. C.  (January 16, 1890-May 3, 1969) was a cinematographer and film director.  Born in Dvůr Králové (Königinhof), Bohemia, his career began in 1905 when, at age 15, he got a job as an assistant projectionist for a film company in Berlin where his family moved in 1901.  He worked as a cinematographer on over 100 films, including the German Expressionist films The Golem (1920), The Last Laugh (1924) and Metropolis (1927)...", died:date('1969-05-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/radUQdNeGHtn7vhQOTnHBVPH2vE.jpg", url:"https://themoviedb.org/person/70"}}, {tmdbId:"9049", properties:{bornIn:"La Cañada, California, USA", imdbId:"0281808", born:date('1889-02-23'), name:"Victor Fleming", bio:"Victor Fleming was an American film director, cinematographer, and producer.  His most popular films were The Wizard of Oz (1939), and Gone with the Wind (1939), for which he won an Academy Award for Best Director...", died:date('1949-01-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gGj58Yj3vIEdevFei01XoqvQYVl.jpg", url:"https://themoviedb.org/person/9049"}}, {tmdbId:"11435", properties:{bornIn:"Goshen, Indiana, USA", imdbId:"0001328", born:date('1896-05-30'), name:"Howard Hawks", bio:"From Wikipedia, the free encyclopedia\n\nHoward Winchester Hawks (May 30, 1896 – December 26, 1977) was an American film director, producer and screenwriter of the classic Hollywood era.  He is popular for his films from a wide range of genres such as Scarface (1932), Bringing Up Baby (1938), Only Angels Have Wings (1939), His Girl Friday (1940), Sergeant York (1941), The Big Sleep (1946), Red River (1948), Gentlemen Prefer Blondes (1953), Rio Bravo (1959), and El Dorado (1967)...", died:date('1977-12-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qIckyax6e9dp0Ic4wj7oG4UY4Oc.jpg", url:"https://themoviedb.org/person/11435"}}, {tmdbId:"226631", properties:{bornIn:"New York City, New York, USA", imdbId:"0744514", born:date('1893-04-04'), name:" Richard Rosson", died:date('1953-05-31'), url:"https://themoviedb.org/person/226631"}}, {tmdbId:"2428", properties:{bornIn:"Berlin, Germany", imdbId:"0523932", born:date('1892-01-28'), name:"Ernst Lubitsch", bio:"Ernst Lubitsch was a German-born  film director.  His urbane comedies of manners gave him the reputation of being Hollywood's most elegant and sophisticated director; as his prestige grew, his films were promoted as having \"the Lubitsch touch. \"\n\nIn 1947 he received an Honorary Academy Award for his distinguished contributions to the art of the motion picture, and he was nominated 3 times for Best Director...", died:date('1947-11-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tAsEhwiu3oqDgzCZSYN2xu0dEdD.jpg", url:"https://themoviedb.org/person/2428"}}, {tmdbId:"95501", properties:{bornIn:"Tokyo, Tokyo Prefecture, Japan", imdbId:"0654868", born:date('1903-12-11'), name:"Yasujirô Ozu", bio:"Yasujirō Ozu was a Japanese film director and screenwriter.  He began his career during the era of silent films.  Ozu first made a number of short comedies, before turning to more serious themes in the 1930s.  Marriage and family, especially the relationships between the generations, are prominent themes in Ozu's work.  His most lauded films include Late Spring (1949), Tokyo Story (1953), Floating Weeds (1959), and An Autumn Afternoon (1962)...", died:date('1963-12-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/s0KBnwAxr6Aujbi6cA3inDqH8Fe.jpg", url:"https://themoviedb.org/person/95501"}}, {tmdbId:"90064", properties:{imdbId:"0356931", name:"Victor Halperin", url:"https://themoviedb.org/person/90064"}}, {tmdbId:"30008", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0564970", born:date('1896-10-03'), name:"Leo McCarey", bio:"From Wikipedia, the free encyclopedia.   \n\nThomas Leo McCarey (October 3, 1898 – July 5, 1969) was an American film director, screenwriter and producer.  During his lifetime he was involved in nearly 200 movies, especially comedies.  French director Jean Renoir once said that \"Leo McCarey understood people better than any other Hollywood director. \"\n\nDescription above from the Wikipedia article Leo McCarey, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1969-07-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dvcnN9ILz8F0OEh24LtvWFyExck.jpg", url:"https://themoviedb.org/person/30008"}}, {tmdbId:"3238", properties:{bornIn:"Jacksonville, Florida, USA", imdbId:"0178260", born:date('1893-10-24'), name:"Merian C. Cooper", bio:"From Wikipedia, the free encyclopedia. \n\nMerian Caldwell Cooper (October 24, 1893 – April 21, 1973) was an American aviator, United States Air Force and Polish Air Force officer, adventurer, screenwriter, film director, and producer.  Cooper was the founder of the Kościuszko Squadron during the Polish–Soviet War and was a Soviet prisoner of war for a time.  He was a notable movie producer, and got his start with film as part of the Explorers Club, traveling the world and documenting adventures...", died:date('1973-04-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sK5FUDK9CXW5pHtNRwTTp5T8Vxn.jpg", url:"https://themoviedb.org/person/3238"}}, {tmdbId:"3239", properties:{bornIn:"Council Bluffs, Iowa, USA", imdbId:"0774325", born:date('1893-06-08'), name:" Ernest B. Schoedsack", bio:"From Wikipedia, the free encyclopedia. \n\nErnest Beaumont Schoedsack (June 8, 1893 – December 23, 1979) was an American motion picture cinematographer, director, and producer. \n\nBorn in Council Bluffs, Iowa, Schoedsack is probably best remembered for being the co-director of the 1933 film, King Kong. \n\nHis eyesight was severely damaged in World War II, yet he continued to direct films afterwards...", died:date('1979-12-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ctSgJ0lEYFRjrDrGcp5wh1RPBZU.jpg", url:"https://themoviedb.org/person/3239"}}, {tmdbId:"29595", properties:{bornIn:"Tiflis, Russian Empire [now Tbilisi, Republic of Georgia]", imdbId:"0541149", born:date('1897-10-07'), name:"Rouben Mamoulian", bio:"Rouben Zachary Mamoulian (October 8, 1897 – December 4, 1987) was an Armenian-American film and theatre director.  In the interview compilation book Directing the Film (Acrobat Books), Mamoulian declared a strong preference for a stylized look to his scenes, stating that he was more interested in creating a poetic look to his films than in showing ordinary realism...", died:date('1987-12-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cTNDfNgGaBtoGbcrZ9CsNcQyjxW.jpg", url:"https://themoviedb.org/person/29595"}}, {tmdbId:"116186", properties:{bornIn:"San Francisco, California, USA", imdbId:"0792514", born:date('1888-10-11'), name:"Lowell Sherman", bio:"Lowell Sherman was an American stage and screen actor, as well as a film director...", died:date('1934-12-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bMx2wmajGgn7tkUZSV2AYkyz38h.jpg", url:"https://themoviedb.org/person/116186"}}, {tmdbId:"976028", properties:{bornIn:"Galesburg, Illinois, USA", imdbId:"0163786", born:date('1898-08-31'), name:"Colbert Clark", died:date('1960-05-04'), url:"https://themoviedb.org/person/976028"}}, {tmdbId:"90070", properties:{bornIn:"Tavistock, Ontario, Canada", imdbId:"0769585", born:date('1898-08-05'), name:" Armand Schaefer", bio:"From Wikipedia, the free encyclopedia\n\nArmand Schaefer (5 August 1898 – 26 September 1967) was a Canadian film producer and director.  He produced over 100 films between 1932 and 1953.  He also directed 24 films between 1931 and 1946.  He was born in Tavistock, Ontario, Canada. \n\nFrom 1955-1956, he joined Gene Autry as co-executive producers of the Dickie Jones western television series Buffalo Bill, Jr...", died:date('1967-09-26'), url:"https://themoviedb.org/person/90070"}}, {tmdbId:"34799", properties:{bornIn:"San Francisco, California", imdbId:"0292134", born:date('1889-03-31'), name:"Harry L. Fraser", bio:"From Wikipedia, the free encyclopedia. \n\nHarry L.  Fraser (31 March 1889 - 8 April 1974) was an American film director.  He directed over 80 films between 1925 and 1951, including the 1934 John Wayne film Randy Rides Alone and the Frank Buck cliffhanger serial Jungle Menace (1937).  He had a small acting role in the John Wayne film 'Neath the Arizona Skies.  He also wrote screenplays, including Chick Carter, Detective (1946)...", died:date('1974-04-08'), url:"https://themoviedb.org/person/34799"}}, {tmdbId:"142865", properties:{imdbId:"0897118", born:date('1905-04-26'), name:"Jean Vigo", bio:"Jean Vigo was a French film director who helped establish poetic realism in film in the 1930s; he was a posthumous influence on the French New Wave of the late 1950s and early 1960s. \n\nVigo was born to Emily Clero and the prominent Catalan militant anarchist Eugeni Bonaventura de Vigo i Sallés (who adopted the name Miguel Almereyda—an anagram of \"y'a la merde\", which translates as \"there's shit\").  Much of Jean's early life was spent on the run with his parents...", died:date('1934-10-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zhrrNzuGZgUVY5sz5RdpPlrQral.jpg", url:"https://themoviedb.org/person/142865"}}, {tmdbId:"131443", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0576940", born:date('1893-03-06'), name:"Gus Meins", died:date('1940-08-01'), url:"https://themoviedb.org/person/131443"}}, {tmdbId:"131406", properties:{bornIn:"Birmingham, England, UK", imdbId:"0736778", born:date('1887-01-15'), name:" Charley Rogers", died:date('1956-12-20'), url:"https://themoviedb.org/person/131406"}}, {tmdbId:"82678", properties:{bornIn:"La Salle, Illinois, USA", imdbId:"0480046", born:date('1886-06-29'), name:"Harry Lachman", bio:"From Wikipedia, the free encyclopedia\n\nHarry B.  Lachman (June 29, 1886 – March 19, 1975) was an American artist, set designer, and film director. \n\nHe was born in La Salle, Illinois on June 29, 1886.  Lachman was educated at the University of Michigan before becoming a magazine and book illustrator, contributing 4 colour illustrations to the 1907 work John Smith, Gentleman Adventurer by Charles Harcourt Ainslie Forbes-Lindsay...", died:date('1975-03-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zLFvGhzcidfGcEIMYrTLv1xQeYh.jpg", url:"https://themoviedb.org/person/82678"}}, {tmdbId:"5030", properties:{bornIn:"Olmütz, Moravia, Austria-Hungary [now Olomouc, Czech Republic]", imdbId:"0880618", born:date('1904-09-17'), name:"Edgar G. Ulmer", bio:"​From Wikipedia, the free encyclopedia.   \n\nEdgar Georg Ulmer (September 17, 1904 – September 30, 1972) was an Austrian-American film director.  He is best remembered for the movies The Black Cat (1934) and Detour (1945).  These stylish and eccentric works have achieved cult status, whereas Ulmer's other films remain relatively unknown. \n\nThe first feature he directed in North America, Damaged Lives (1933), was a low-budget exploitation film exposing the horrors of venereal disease...", died:date('1972-09-30'), url:"https://themoviedb.org/person/5030"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"30165", properties:{bornIn:"New York City, New York, USA", imdbId:"0762263", born:date('1901-10-26'), name:"Mark Sandrich", bio:"From Wikipedia, the free encyclopedia.   Mark Sandrich (birth name: Mark Rex Goldstein) (October 26, 1900 – March 4, 1945) was a Jewish American film director, writer and producer. \n\nOne of the most gifted and least heralded directors of the 1930s and early 1940s, Sandrich was an engineering student at Columbia University when he started the movie business by accident.  When visiting a friend on a film set, he saw that the director had a problem in setting up a shot; Sandrich offered his advice...", died:date('1945-03-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/77Gh9XVPbWT68eoOGzOwu4e1gUC.jpg", url:"https://themoviedb.org/person/30165"}}, {tmdbId:"120529", properties:{imdbId:"0532187", born:date('1901-04-26'), name:"Hamilton MacFadden", url:"https://themoviedb.org/person/120529"}}, {tmdbId:"9062", properties:{bornIn:"Dublin, Ireland", imdbId:"0316539", born:date('1893-03-23'), name:"Cedric Gibbons", bio:"From Wikipedia, the free encyclopedia\n\nAustin Cedric Gibbons (March 23, 1893 – July 26, 1960) was an Irish art director and production designer for the film industry.  He also made a significant contribution to motion picture theater architecture from the 1930s to 1950s.  He is credited as the designer of the Oscar statuette in 1928. \n\nGibbons was born in Dublin, Ireland and studied at the Art Students League of New York and worked for his architect father...", died:date('1960-07-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4490hNfDKQPh0pIn8GBSQ0UARMX.jpg", url:"https://themoviedb.org/person/9062"}}, {tmdbId:"82413", properties:{bornIn:"Graceville, Minnesota, USA", imdbId:"0176699", born:date('1887-07-17'), name:" Jack Conway", bio:"​From Wikipedia, the free encyclopedia\n\nHe was born as Hugh Ryan Conway, on July 17, 1887, in Graceville, Minnesota, US. \n\nConway started out as an actor, joining a repertory theater group straight out of high school.  He then moved into films and, in 1911, became a member of D. W.  Griffith's stock company, appearing primarily in westerns.  Four years later, he made his mark as a director and gained valuable experience at Universal (1916–17 and 1921–23), before moving on to MGM in 1925...", died:date('1952-10-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xftx369DCHKm0pA9dW0ZDUDZnQ2.jpg", url:"https://themoviedb.org/person/82413"}}, {tmdbId:"1313118", properties:{imdbId:"0570985", name:" James C. McKay", url:"https://themoviedb.org/person/1313118"}}, {tmdbId:"32427", properties:{bornIn:"San Diego, California, USA", imdbId:"0886754", born:date('1889-03-21'), name:"W.S. Van Dyke", bio:"From Wikipedia, the free encyclopedia\n\nWoodbridge Strong \"W.  S. \" Van Dyke II (Woody) (March 21, 1889 – February 5, 1943) was an American film director and writer who made several successful early sound films, including Tarzan the Ape Man in 1932, The Thin Man in 1934, San Francisco in 1936, and six popular musicals with Nelson Eddy and Jeanette MacDonald...", died:date('1943-02-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xejTNkwrM0r5hXZ0x2WKnUnn4VY.jpg", url:"https://themoviedb.org/person/32427"}}, {tmdbId:"4109", properties:{bornIn:"Budapest, Austria-Hungary [now Hungary]", imdbId:"0002031", born:date('1886-12-24'), name:"Michael Curtiz", bio:"Michael Curtiz was a Hungarian-American film director.  He had early credits as Mihály Kertész and Michael Kertész.  He directed more than fifty films in Europe and more than one hundred in the United States.  The best-known were The Adventures of Robin Hood, Angels with Dirty Faces, Casablanca, Yankee Doodle Dandy, and White Christmas.  He thrived in the heyday of the Warner Bros.  studio in the 1930s and '40s...", died:date('1962-04-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uGNh4uO7rUQzWmwfutckGgsADr5.jpg", url:"https://themoviedb.org/person/4109"}}, {tmdbId:"108987", properties:{bornIn:"New York City, New York, USA", imdbId:"0782682", born:date('1890-06-10'), name:"William A. Seiter", bio:"From Wikipedia, the free encyclopedia\n\nWilliam A.  Seiter (June 10, 1890 - July 26, 1964) was an American film director.  He was born in New York City.  After attending Hudson River Military Academy, Seiter broke into films in 1915 as a bit player at Mack Sennett's Keystone Studios, doubling a cowboy.  He graduated to director in 1918...", died:date('1964-07-26'), url:"https://themoviedb.org/person/108987"}}, {tmdbId:"10001", properties:{bornIn:"Mülhausen, Alsace, Germany [now Mulhouse, Haut-Rhin, France]", imdbId:"0943758", born:date('1902-07-01'), name:"William Wyler", bio:"From Wikipedia, the free encyclopedia. \n\nWilliam Wyler (July 1, 1902 – July 27, 1981) was a leading American motion picture director, producer, and screenwriter. \n\nNotable works include Ben-Hur (1959), The Best Years of Our Lives (1946), and Mrs.  Miniver (1942), all which won Wyler Academy Awards for Best Director, and also won Best Picture.  He earned his first Oscar nomination for directing Dodsworth in 1936, sparking a 20-year run of almost unbroken greatness...", died:date('1981-07-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iJ3pqrklebAlED8FNPfRc0XLgiH.jpg", url:"https://themoviedb.org/person/10001"}}, {tmdbId:"93906", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0502752", born:date('1889-10-07'), name:"Robert Z. Leonard", bio:"From Wikipedia, the free encyclopedia\n\nRobert Zigler Leonard (October 7, 1889, Chicago, Illinois - August 27, 1968, Beverly Hills, California) was an American film director, actor, producer and screenwriter. \n\nAt one time he was married to silent superstar Mae Murray, with the two forming Tiffany Pictures to film eight motion pictures that were released by MGM. \n\nHe was nominated for the Academy Award for Best Director for The Divorcee and The Great Ziegfeld...", died:date('1968-08-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cZ0eavFDT07uPFBKzXSyvbwcKFp.jpg", url:"https://themoviedb.org/person/93906"}}, {tmdbId:"74659", properties:{bornIn:"Towanda, Pennsylvania, USA", imdbId:"0478441", born:date('1892-03-10'), name:"Gregory La Cava", bio:"​From Wikipedia, the free encyclopedia. \n\nGregory La Cava (March 10, 1892 – March 1, 1952) was an American film director best known for his films of the 1930s, including My Man Godfrey and Stage Door...", died:date('1952-03-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AgwwMJokMN6yWdwHe1kwJRy9nJh.jpg", url:"https://themoviedb.org/person/74659"}}, {tmdbId:"81165", properties:{bornIn:"New York City, New York, USA", imdbId:"0562845", born:date('1891-01-29'), name:"Archie Mayo", bio:"​From Wikipedia, the free encyclopedia.   \n\nArchie Mayo (29 January 1891, New York City – 4 December 1968, Guadalajara, Mexico) was a movie director and stage actor who moved to Hollywood in 1915 and began working as a director in 1917...", died:date('1968-12-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/s4xz3GN0RBxQkZgDWgidXZeFq32.jpg", url:"https://themoviedb.org/person/81165"}}, {tmdbId:"18738", properties:{bornIn:"Oakland, California, USA", imdbId:"0828419", born:date('1904-12-18'), name:"George Stevens", bio:"From Wikipedia, the free encyclopedia. \n\nGeorge Stevens (December 18, 1904 – March 8, 1975) was an American film director, producer, screenwriter and cinematographer. \n\nAmong his most notable films were Diary of Anne Frank (1959), nominated for Best Director, Giant (1956), winner of Oscar for Best Director, Shane (1953), Oscar nominated, and A Place in the Sun (1951), winner of Oscar for Best Director...", died:date('1975-03-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mblM3Kg4YbD4Jxil1aCs9qBNt7s.jpg", url:"https://themoviedb.org/person/18738"}}, {tmdbId:"121402", properties:{bornIn:"Paris, France", imdbId:"0309163", born:date('1875-09-13'), name:"Louis J. Gasnier", bio:"From Wikipedia, the free encyclopedia\n\nLouis J.  Gasnier (15 September 1875 - 15 February 1963) was a French film director. \n\nBorn in Paris, Gasnier was working in theatre when Pathé hired him to direct films in the earliest days of cinema.  He directed comedian Max Linder in many of his early short comedies...", died:date('1963-02-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bpuPD6VCKgRq3FwMNDlJdTAUEQI.jpg", url:"https://themoviedb.org/person/121402"}}, {tmdbId:"101374", properties:{imdbId:"0532561", born:date('1901-03-09'), name:" Gustav Machatý", died:date('1963-12-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aY3DmNmHBlYNAGPflWrgfoYzPTC.jpg", url:"https://themoviedb.org/person/101374"}}, {tmdbId:"11528", properties:{bornIn:"Paris, France", imdbId:"0719756", born:date('1894-09-15'), name:"Jean Renoir", bio:"Jean Renoir was a French film director, screenwriter, actor, producer and author.  As a film director and actor, he made more than forty films from the silent era to the end of the 1960s.  As an author, he wrote the definitive biography of his father, the painter, Pierre-Auguste Renoir, Renoir, My Father (1962). \n\nDuring the 1930s Renoir enjoyed great success as a filmmaker.  In 1931 he directed his first sound films, On purge bébé and La Chienne (The Bitch)...", died:date('1979-02-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oN93wdY94BIVDQVbFfHGOBCk3L.jpg", url:"https://themoviedb.org/person/11528"}}, {tmdbId:"49214", properties:{bornIn:"Ludwigshafen am Rhein, Germany", imdbId:"0226189", born:date('1893-07-15'), name:"William Dieterle", bio:"From Wikipedia, the free encyclopedia. \n\nWilliam Dieterle (July 15, 1893 – December 9, 1972) was a German actor and film director, who worked in Hollywood for much of his career.  His best known films include The Devil and Daniel Webster, The Story of Louis Pasteur and The Hunchback of Notre Dame.  His 1937 film The Life of Emile Zola won the Academy Award for Best Picture...", died:date('1972-12-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9xJgBwpVs7O55AH1jPt5DLioWUF.jpg", url:"https://themoviedb.org/person/49214"}}, {tmdbId:"100131", properties:{imdbId:"0437717", born:date('1912-11-24'), name:"Garson Kanin", died:date('1999-03-13'), url:"https://themoviedb.org/person/100131"}}, {tmdbId:"39058", properties:{bornIn:"Lille, Nord, Nord-Pas-de-Calais, France", imdbId:"0245213", born:date('1896-10-03'), name:"Julien Duvivier", bio:"From Wikipedia, the free encyclopedia. \n\nJulien Duvivier (8 October 1896, Lille – 29 October 1967, Paris) was a French film director.  He was prominent in French cinema in the years 1930-1960.  Amongst his most original films, chiefly notable are La Bandera, Pépé le Moko, Panique, Voici le temps des assassins and Marianne de ma jeunesse. \n\nDescription above from the Wikipedia article Julien Duvivier, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1967-10-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4ONn2acnbF1alGicHVHYqPfM4r1.jpg", url:"https://themoviedb.org/person/39058"}}, {tmdbId:"564042", properties:{bornIn:"Los Angeles, California, USA ", imdbId:"0604392", born:date('1905-03-26'), name:" Larry Morey", bio:"American lyricist and author chiefly noted for co-writing (with the composer and songwriter Frank Churchill) the musical numbers for Disney's Snow White and the Seven Dwarfs (1937), including \"Heigh-Ho\", \"I'm Wishing\" and \"Whistle While You Work\".  He also worked on the picture as a sequence director.  His second claim to fame was adapting Felix Salten's 1923 book, \"Bambi, a Life in the Woods\", for the screen (as well as co-writing the score with Churchill)...", died:date('1971-05-08'), url:"https://themoviedb.org/person/564042"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"52218", properties:{imdbId:"0668998", born:date('1899-09-07'), name:" Perce Pearce", bio:"Trusted producer went Walt Disney decided to go oversees to England...", died:date('1955-07-04'), url:"https://themoviedb.org/person/52218"}}, {tmdbId:"29962", properties:{bornIn:"Galveston, Texas, USA", imdbId:"0896542", born:date('1894-02-08'), name:"King Vidor", bio:"King Wallis Vidor (February 8, 1894 – November 1, 1982) was an American film director, film producer, and screenwriter whose career spanned nearly seven decades.  In 1979, he was awarded an Honorary Academy Award for his \"incomparable achievements as a cinematic creator and innovator. \" He was nominated five times for the Academy Award for Best Director, and won eight international film awards during his career...", died:date('1982-11-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4BXcoAHxGx4IcS48yYVQVDzAchJ.jpg", url:"https://themoviedb.org/person/29962"}}, {tmdbId:"67426", properties:{bornIn:" Philadelphia, Pennsylvania, USA", imdbId:"0445033", born:date('1889-08-04'), name:" William Keighley", bio:"​From Wikipedia, the free encyclopedia. \n\nWilliam Jackson Keighley  (August 4, 1889, Philadelphia, Pennsylvania - June 24, 1984, New York, New York) was an American stage actor and Hollywood film director. \n\nAfter graduating from the Ludlum School of Dramatic Art, Keighley began acting at the age of 23.  By the 1910s and 1920s, he was acting and directing on Broadway.  With the advent of talking pictures, he relocated to Hollywood.  He eventually signed with Warner Bros...", died:date('1984-06-24'), url:"https://themoviedb.org/person/67426"}}, {tmdbId:"78053", properties:{bornIn:"Jersey City, New Jersey, USA", imdbId:"0547446", born:date('1899-02-21'), name:"Edwin L. Marin", bio:"​From Wikipedia, the free encyclopedia\n\nEdwin L.  Marin (February 21, 1899 – May 2, 1951) was an American film director who directed 58 films between 1932 and 1951, working with Anna May Wong, John Wayne, Peter Lorre, George Raft, Bela Lugosi, Judy Garland, Eddie Cantor, and Hoagy Carmichael, among many others.  Marin was born in Jersey City, New Jersey, and died in Los Angeles, California. \n\nDescription above from the Wikipedia article Edwin L...", died:date('1951-05-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cxSIKO744okrLzSL99Y3UV3RLxN.jpg", url:"https://themoviedb.org/person/78053"}}, {tmdbId:"32919", properties:{bornIn:" London, England", imdbId:"0002190", born:date('1902-11-09'), name:"Anthony Asquith", bio:"From Wikipedia, the free encyclopedia. \n\nAnthony Asquith (9 November 1902 –20 February 1968) was a leading English film director.  He collaborated successfully with playwright Terence Rattigan on The Winslow Boy (1948) and The Browning Version (1951), among other adaptations.  His other notable films include Pygmalion (1938), French Without Tears (1940), The Way to the Stars (1945), and a 1952 adaptation of Oscar Wilde's The Importance of Being Earnest...", died:date('1968-02-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7iYYG7Z6Y0Hgp4MwCfTyI01Quph.jpg", url:"https://themoviedb.org/person/32919"}}, {tmdbId:"77101", properties:{bornIn:"Brooklyn, New York City, New York, USA", imdbId:"0125636", born:date('1900-11-13'), name:"Edward Buzzell", bio:"​From Wikipedia, the free encyclopedia\n\nEdward Buzzell (November 13, 1900 - January 11, 1985) was an American film director whose credits for Metro-Goldwyn-Mayer included Honolulu (1939), the Marx Brothers films At the Circus (1939) and Go West (1940), the musicals Best Foot Forward (1943) with Lucille Ball and Neptune's Daughter (1949) with Esther Williams, and Easy to Wed, starring Van Johnson, Williams, and Ball. \n\nBuzzell was born in Brooklyn...", died:date('1985-01-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rJIp8s3dQfosC3m8KGzJEhRvLd3.jpg", url:"https://themoviedb.org/person/77101"}}, {tmdbId:"253716", properties:{bornIn:"Bristol, England, UK", imdbId:"0225555", born:date('1903-11-16'), name:"Thorold Dickinson", died:date('1984-04-14'), url:"https://themoviedb.org/person/253716"}}, {tmdbId:"143463", properties:{bornIn:"New York City, New York, USA", imdbId:"0281487", born:date('1894-07-14'), name:"Dave Fleischer", bio:"From Wikipedia, the free encyclopedia. \n\nDavid \"Dave\" Fleischer (July 14, 1894 – June 25, 1979) was an American animator film director and film producer, best known as a co-owner of Fleischer Studios with his older brother Max Fleischer.  He was a native of New York City...", died:date('1979-06-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9RGAhYbsMH3URnGZKEU0UrcbURt.jpg", url:"https://themoviedb.org/person/143463"}}, {tmdbId:"97017", properties:{imdbId:"0485647", born:date('1898-04-20'), name:"Sidney Lanfield", died:date('1972-06-20'), url:"https://themoviedb.org/person/97017"}}, {tmdbId:"30146", properties:{bornIn:"Findlay, Ohio, USA", imdbId:"0498174", born:date('1891-09-05'), name:"Rowland V. Lee", bio:"From Wikipedia, the free encyclopedia\n\nRowland Vance Lee (born September 6, 1891, Findlay, Ohio — died December 21, 1975, Palm Desert, California) was a U. S.  film actor, director, writer, and producer.  His acting profession was fairly short lived.  His main profession was directing, but he would write scripts on occasion.  He worked at Fox, Paramount , Warners and RKO. \n\nLee directed the 1940 black-and-white film The Son of Monte Cristo, starring Louis Hayward, Joan Bennett and George Sanders...", died:date('1975-12-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4zdGa2JLvjxlag4NVjr6UgfFIiT.jpg", url:"https://themoviedb.org/person/30146"}}, {tmdbId:"95293", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0000923", born:date('1895-11-29'), name:"Busby Berkeley", bio:"From Wikipedia, the free encyclopedia. \n\nBusby Berkeley (November 29, 1895 – March 14, 1976) was a highly influential Hollywood movie director and musical choreographer.  Berkeley was famous for his elaborate musical production numbers that often involved complex geometric patterns.  Berkeley's works used large numbers of showgirls and props as fantasy elements in kaleidoscopic on-screen performances...", died:date('1976-03-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5iOmpxriRiZPHqxTDv2aqSp9Mk.jpg", url:"https://themoviedb.org/person/95293"}}, {tmdbId:"82800", properties:{bornIn:"Chicago, Illinois, USA ", imdbId:"0851537", born:date('1899-02-23'), name:" Norman Taurog", bio:"From Wikipedia, the free encyclopedia. \n\nNorman Rae Taurog (February 23, 1899 - April 7, 1981) was an American film director and screenwriter.  Between 1920 and 1968, Taurog directed over 140 films, and directed Elvis Presley in more movies than any other director (nine, starting with G. I.  Blues (1960)).  He won the 1931 Academy Award for Best Director for the film Skippy and still holds the record as the youngest director (32) to win it...", died:date('1981-04-07'), url:"https://themoviedb.org/person/82800"}}, {tmdbId:"226599", properties:{bornIn:"Manhattan, New York City, New York, USA", imdbId:"0272568", born:date('1902-09-02'), name:"Norman Ferguson", bio:"“I was born on the East Side of New York in 1902.  Played games in and out family entrances of saloon on Second Avenue until chased by bartender.  Sold newspapers on Fifth Avenue at the age of ten.  Had ambition to become fireman but moved across the bridge to the wide open spaces of Brooklyn and decided to be a cowboy instead.  Was transferred from public school to high school in Brooklyn by mistake and much to every one’s surprise became a stenographer...", died:date('1957-11-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fp0NPNlKl08kKbEgrlgvmxJJC7L.jpg", url:"https://themoviedb.org/person/226599"}}, {tmdbId:"5690", properties:{bornIn:"Modesto, California, USA", imdbId:"0019282", born:date('1912-06-11'), name:" James Algar", bio:"James Algar studied at Stanford where he developed his skills as a cartoonist by drawing for the university's satirical magazine, The Chaparral.  He joined the Disney Organisation in 1934, initially as animator.  He directed the classic \"Sorcerer's Apprentice\" segment ofFantasia (1940), as well as several sequences of Bambi (1942).  Algar was one of several key personnel to whom Walt Disney delegated higher executive functions...", died:date('1998-02-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/awqwWqAZ4b6rBhivYfLDbnsxLQe.jpg", url:"https://themoviedb.org/person/5690"}}, {tmdbId:"5691", properties:{bornIn:"Minneapolis, Minnesota, USA", imdbId:"0035899", born:date('1893-02-05'), name:" Samuel Armstrong", bio:"Samuel Armstrong was an American animation director...", died:date('2976-09-29'), url:"https://themoviedb.org/person/5691"}}, {tmdbId:"1094239", properties:{imdbId:"1968474", name:" Ford Beebe Jr.", url:"https://themoviedb.org/person/1094239"}}, {tmdbId:"11432", properties:{bornIn:"Oklahoma - USA", imdbId:"0373429", born:date('1911-03-26'), name:" T. Hee", bio:"American animator, director, and teacher.  He taught character design and caricature.   Hee worked at Leon Schlesinger Productions from 1935–36 as a character designer.  He designed many of the celebrity caricatures used in The Coo Coo Nut Grove (1936) and The Woods Are Full of Cuckoos (1937).  A 1936 Christmas card that he drew, featuring caricatures of the Schlesinger animators, was used to design the gremlins in the 1944 animated short Russian Rhapsody...", died:date('1998-10-30'), url:"https://themoviedb.org/person/11432"}}, {tmdbId:"148849", properties:{bornIn:"Mahanoy City, Pennsylvania, USA", imdbId:"0006276", born:date('1888-04-08'), name:"Victor Schertzinger", bio:"​From Wikipedia, the free encyclopedia.   \n\nVictor L.  Schertzinger (April 8, 1888 - October 26, 1941) was an American composer, film director, film producer, and screenwriter.  His films include Paramount on Parade (co-director, 1930), Something to Sing About (1937), and the first two \"Road\" pictures, Road to Singapore (1940) and Road to Zanzibar (1941)...", died:date('1941-10-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7wR8zyg35twNJRlrboe1bN3kAza.jpg", url:"https://themoviedb.org/person/148849"}}, {tmdbId:"68424", properties:{bornIn:"Bekesbourne, Kent, England", imdbId:"0003836", born:date('1905-09-30'), name:"Michael Powell", bio:"Michael Latham Powell (30 September 1905 – 19 February 1990) was a renowned English film director, celebrated for his partnership with Emeric Pressburger.  They worked together under the name of \"The Archers\" and produced a series of classic British films, notably The Thief of Bagdad (1940), 49th Parallel (1941), The Life and Death of Colonel Blimp (1943), A Matter of Life and Death (1946, also called Stairway to Heaven), Black Narcissus (1947) and The Red Shoes (1948)...", died:date('1990-02-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gkHgrKa834PZVqAQ5kSs8Cn0pXv.jpg", url:"https://themoviedb.org/person/68424"}}, {tmdbId:"30129", properties:{bornIn:"New York City, New York, USA", imdbId:"0905729", born:date('1894-09-07'), name:"George Waggner", bio:"​From Wikipedia, the free encyclopedia. \n\nGeorge Waggner  (September 7, 1894 - December 11, 1984) was an American film director, producer and actor. \n\nBorn in New York City, he made his film debut as Yousayef in The Sheik (1921).  He later went on to appearances in Western films.  The first film he directed was Western Trails (1938) and his most well-known directorial effort arguably remains The Wolf Man (1941)...", died:date('1984-12-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mXPDqaZCPjFBioLN1IJCltrD4Za.jpg", url:"https://themoviedb.org/person/30129"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"81930", properties:{bornIn:"Deadwood, South Dakota, USA", imdbId:"0921288", born:date('1896-12-02'), name:"Alfred L. Werker", bio:"​From Wikipedia, the free encyclopedia\n\nAlfred L.  Werker (December 2, 1896 – July 28, 1975) was a film director whose work in movies spanned from 1917 through 1957.  After a number of film production jobs and assistant directing, Werker co-directed his first film, Ridin' the Wind in 1925 alongside director Del Andrews.  He was brought in by Fox Film Corporation executives to re-shoot and re-edit Erich von Stroheim's film Hello, Sister! (1933), co-starring Boots Mallory and ZaSu Pitts...", died:date('1975-07-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pt9YwqMlPXcETPhmzav43BvrPPo.jpg", url:"https://themoviedb.org/person/81930"}}, {tmdbId:"150003", properties:{imdbId:"0373871", born:date('1909-11-14'), name:" Graham Heid", died:date('1976-03-01'), url:"https://themoviedb.org/person/150003"}}, {tmdbId:"10146", properties:{bornIn:"Paris, France", imdbId:"0869664", born:date('1904-11-12'), name:"Jacques Tourneur", bio:"Jacques Tourneur (also known as Jack Turner; November 12, 1904 – December 19, 1977) was a French film director known for the classic film noir Out of the Past and a series of low-budget horror films he made for RKO Studios, including Cat People, I Walked with a Zombie and The Leopard Man...", died:date('1977-12-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fzVtRZzfCdFRz26vsNrRNvJdVEU.jpg", url:"https://themoviedb.org/person/10146"}}, {tmdbId:"29755", properties:{bornIn:"Norborne, Missouri, USA", imdbId:"0448915", born:date('1896-08-01'), name:"Erle C. Kenton", bio:"From Wikipedia, the free encyclopedia\n\nErle C.  Kenton (August 1, 1896 – January 28, 1980) was an American film director.  He directed 131 films between 1916 and 1957.  He was born in Norborne, Missouri and died in Glendale, California from Parkinson's disease. \n\nKenton and Edward Ludwig were the principal directors of the 1958-1960 CBS television series, The Texan, starring Rory Calhoun as Bill Longley, a \"Robin Hood of the West\", who drifts through the region helping persons in need...", died:date('1980-01-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zGONdRCeQO7RKJ0UV8aGdzbAjKF.jpg", url:"https://themoviedb.org/person/29755"}}, {tmdbId:"81285", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0374702", born:date('1896-12-05'), name:"Stuart Heisler", bio:"From Wikipedia, the free encyclopedia. \n\nStoops Heisler (December 5, 1896 - August 21, 1979) was an American film and television director.  He worked as a motion picture editor from 1921 to 1936, then dedicated the rest of his career to that of a film director. \n\nDirector of 1944 propaganda film The Negro Soldier, a documentary style recruitment piece targeting African-Americans. \n\nHe received an Oscar nomination in 1949 for his contribution to the visual effects of the film Tulsa...", died:date('1979-08-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kdNAwG8DWEW09m0Q4WtJnW2p4U6.jpg", url:"https://themoviedb.org/person/81285"}}, {tmdbId:"19528", properties:{bornIn:"Vienna, Georgia, USA", imdbId:"0792605", born:date('1906-07-16'), name:"Vincent Sherman", bio:"From Wikipedia, the free encyclopedia\n\nVincent Sherman (July 16, 1906 – June 18, 2006) was an American director, and actor, who worked in Hollywood.  His movies include Mr.  Skeffington (1944), Nora Prentiss (1947), and The Young Philadelphians (1959). \n\nHe began his career as an actor on Broadway and later films.  He directed B-movies for Warner Bros.  before moving up to A-pictures.  He was a good friend of actor Errol Flynn, whom he directed in Adventures of Don Juan (1949)...", died:date('2006-06-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6p2urgk6KsbnBOwGFVvTzAefWFA.jpg", url:"https://themoviedb.org/person/19528"}}, {tmdbId:"65852", properties:{bornIn:"Pusztaturpaszto, Túrkeve, Austria-Hungary [now Hungary]", imdbId:"0466113", born:date('1895-06-03'), name:"Zoltan Korda", bio:"From Wikipedia, the free encyclopedia\n\nZoltan Korda (3 June 1895 – 13 October 1961) was a Hungarian-born motion picture screenwriter, director and producer. \n\nBorn Zoltán Kellner, Kellner Zoltán in Hungarian name order, of Jewish heritage in Pusztatúrpásztó, Túrkeve in Hungary (Austria-Hungary), he was the middle brother of filmmakers Alexander and Vincent Korda...", died:date('1961-10-13'), url:"https://themoviedb.org/person/65852"}}, {tmdbId:"14511", properties:{bornIn:"New York City, New York, USA", imdbId:"0281381", born:date('1892-06-04'), name:" Fred Fleck", bio:"Fred Fleck was born on June 4, 1892 in New York City, New York, USA.  He was an assistant director and production manager, known for Jet Pilot (1957), The Littlest Rebel (1914) and The Window (1949)...", died:date('1961-11-09'), url:"https://themoviedb.org/person/14511"}}, {tmdbId:"3146", properties:{bornIn:"Sucha, Galicia, Austria-Hungary", imdbId:"0000697", born:date('1906-06-22'), name:"Billy Wilder", bio:"From Wikipedia, the free encyclopedia.   Billy Wilder (22 June 1906 – 27 March 2002) was an Austria/Hungarian-born American filmmaker, screenwriter, producer, artist, and journalist, whose career spanned more than 50 years and 60 films.  He is regarded as one of the most brilliant and versatile filmmakers of Hollywood's golden age.  Wilder is one of only five people who have won Academy Awards as producer, director, and writer for the same film (The Apartment)...", died:date('2002-03-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nWV9BDDCbRegP7etiPjl3vYnJEq.jpg", url:"https://themoviedb.org/person/3146"}}, {tmdbId:"93904", properties:{bornIn:" London, England, UK", imdbId:"0710924", born:date('1898-01-16'), name:"Irving Rapper", bio:"From Wikipedia, the free encyclopedia\n\nIrving Rapper (16 January 1898, or 1902 – 20 December 1999) was an England-born American film director. \n\nBorn to a Jewish family in London, England, Rapper emigrated to the United States and became an actor and stage director on Broadway while studying at New York University.  In 1936, he went to Hollywood, where he was hired by Warner Bros.  as an assistant director and dialogue coach...", died:date('1999-02-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lNJb2uowtdBpkVf3g7UWMvr2OzK.jpg", url:"https://themoviedb.org/person/93904"}}, {tmdbId:"13980", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0591486", born:date('1903-02-28'), name:"Vincente Minnelli", bio:"Vincente Minnelli, born in Chicago, was an American stage director and film director, famous for directing such classic movie musicals as Meet Me in St.  Louis (1944), Gigi (1958), The Band Wagon (1953), and An American in Paris (1951).  An American in Paris and Gigi both won the Academy Award for Best Picture, with Minnelli winning Best Director for Gigi.  In addition to having directed some of the most famous and well-remembered musicals of his time, Minnelli made many comedies and melodramas...", died:date('1986-07-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fmlq7RMQdWsrPBAskIezf22e8Mv.jpg", url:"https://themoviedb.org/person/13980"}}, {tmdbId:"76981", properties:{bornIn:"San Francisco, California, USA", imdbId:"0202681", born:date('1904-07-24'), name:"Delmer Daves", bio:"Delmer Daves was an American actor, screenwriter, director, and producer...", died:date('1977-08-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vD8HCP04NbxS4Tb6AoRjBtHb3qA.jpg", url:"https://themoviedb.org/person/76981"}}, {tmdbId:"25165", properties:{bornIn:"Ireland, United Kingdom", imdbId:"0624756", born:date('1887-09-04'), name:"Roy William Neill", bio:"From Wikipedia, the free encyclopedia.   Roy William Neill (4 September 1887 – 14 December 1946) was a film director best known today for directing several of the Sherlock Holmes films starring Basil Rathbone and Nigel Bruce, made between 1943 and 1946 and released by Universal Studios. \n\nWith his father as the captain, Neill was born on a ship off the coast of Ireland named Roland de Gostrie.  He began directing silent movies in 1917 and went on to helm 107 films, 40 of them silent...", died:date('1946-12-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rFdj73VUiNBJJtmq4C4BQKW3kJE.jpg", url:"https://themoviedb.org/person/25165"}}, {tmdbId:"84641", properties:{bornIn:"New York City, New York, USA", imdbId:"0782597", born:date('1890-09-30'), name:"Lewis Seiler", bio:"From Wikipedia, the free encyclopedia\n\nLewis Seiler (September 30, 1890 – January 8, 1964) was an American film director.  He directed 88 films between 1923 and 1958.  He was born in New York, New York and died in Hollywood, California...", died:date('1964-01-08'), url:"https://themoviedb.org/person/84641"}}, {tmdbId:"12300", properties:{bornIn:"Tazewell, Virginia, USA", imdbId:"0928208", born:date('1907-12-22'), name:"Fred M. Wilcox", bio:"From Wikipedia, the free encyclopedia\n\nFred McLeod Wilcox (December 22, 1907 – September 23, 1964) was an American motion picture director.  He worked for Metro-Goldwyn-Mayer for many years best remembered for directing Lassie Come Home (1943) and Forbidden Planet (1956).  These films were entered in the National Film Preservation Board's National Film Registry in 1993 and 2013 respectively...", died:date('1964-09-23'), url:"https://themoviedb.org/person/12300"}}, {tmdbId:"37846", properties:{bornIn:"Miskolc, Hungary", imdbId:"0696247", born:date('1902-12-05'), name:" Emeric Pressburger", bio:"Emeric Pressburger (born Imre József Pressburger; 5 December 1902 – 5 February 1988) was a Hungarian British screenwriter, film director, and producer...", died:date('1988-02-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/byPJw21EY1pUWHJtthCs7wUtvoA.jpg", url:"https://themoviedb.org/person/37846"}}, {tmdbId:"78845", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0523893", born:date('1898-07-25'), name:"Arthur Lubin", bio:"​From Wikipedia, the free encyclopedia\n\nArthur Lubin (July 25, 1898 – May 12, 1995) was an American film director and producer who directed several Abbott &amp; Costello films and created the TV series Mr.  Ed. \n\nArthur Lubin was born Arthur William Lubovsky in Los Angeles, California in 1898.  Lubin created his own film and music studio, Lubin Studios, in the 1920s, where he acted in silent films in the later half of the decade...", died:date('1995-05-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/b7E0lIlYv0C0S3l165hPjLWqu2X.jpg", url:"https://themoviedb.org/person/78845"}}, {tmdbId:"5029", properties:{bornIn:"Dresden, Germany", imdbId:"0802563", born:date('1900-08-08'), name:"Robert Siodmak", bio:"​From Wikipedia, the free encyclopedia.   \n\nRobert Siodmak (8 August 1900 - 10 March 1973) was a German born American film director.  He is best remembered as a thriller specialist and for the series of Hollywood film noirs he made in the 1940s. \n\nDescription above from the Wikipedia article Robert Siodmak, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1973-03-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6Az7VLGpET7wtVLQPfsrCJGPaL8.jpg", url:"https://themoviedb.org/person/5029"}}, {tmdbId:"33414", properties:{bornIn:"Pola, Küstenland, Austria-Hungary [now Pula, Istria, Croatia]", imdbId:"0902270", born:date('1906-07-15'), name:"Gunther von Fritsch", died:date('1988-08-27'), url:"https://themoviedb.org/person/33414"}}, {tmdbId:"103346", properties:{bornIn:"London, England", imdbId:"0329574", born:date('1899-09-17'), name:"Leslie Goodwins", bio:"From Wikipedia, the free encyclopedia.   Leslie Goodwins (17 September 1899 – 8 January 1969) was an English film director and screenwriter.  He directed nearly 100 films between 1926 and 1967.  His 1936 film Dummy Ache was nominated for an Academy Award in 1936 for Best Short Subject (Two-Reel).   He was born in London, England and he died in Hollywood, California...", died:date('1969-01-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e3942phwO7JQorBskeUhJWMtNuj.jpg", url:"https://themoviedb.org/person/103346"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"100793", properties:{bornIn:"Vienna, Austria", imdbId:"0494110", born:date('1902-12-11'), name:"Reginald Le Borg", bio:"​From Wikipedia, the free encyclopedia.   \n\nReginald Le Borg (11 December 1902 – 25 March 1989) was an Austrian film director.  He directed 68 films between 1936 and 1974.  He was born in Vienna, Austria as Reginald Grobel and died in Los Angeles, California from a heart attack. \n\nAlthough he worked in a variety of genres, he is perhaps best remembered today for the series of low-budget horror films he made at Universal Studios in the 1940s...", died:date('1989-03-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iWAwwc6fpWBJxUN3b9D9ZnTHGH9.jpg", url:"https://themoviedb.org/person/100793"}}, {tmdbId:"64114", properties:{bornIn:"Grand Forks, British Columbia, Canada", imdbId:"0229424", born:date('1908-09-04'), name:"Edward Dmytryk", bio:"Edward Dmytryk (September 4, 1908 – July 1, 1999) was an American film director who was amongst the Hollywood Ten, a group of blacklisted film industry professionals who served time in prison for being in contempt of Congress during the McCarthy-era 'red scare'. \n\nAlthough born in Grand Forks, British Columbia, Canada, Dmytryk grew up in San Francisco when his Ukrainian parents moved to the United States.  At the age of 31, he became a naturalized citizen...", died:date('1999-07-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jFJg3ddu0LJlcOeBCaSLVQLgzHy.jpg", url:"https://themoviedb.org/person/64114"}}, {tmdbId:"12238", properties:{bornIn:"Croydon, Surrey, England, UK", imdbId:"0000180", born:date('1908-03-25'), name:"David Lean", bio:"Sir David Lean CBE (25 March 1908 – 16 April 1991) was an English film director, producer, screenwriter, and editor, best remembered for bringing Charles Dickens's novels to the screen with films such as Great Expectations (1946) and Oliver Twist (1948), and for his big-screen epics such as The Bridge on the River Kwai (1957), Lawrence of Arabia (1962), Doctor Zhivago (1965), Ryan's Daughter (1970), and A Passage to India (1984)...", died:date('1991-04-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yuEUFHLcjsURniy67XekWDbV2TS.jpg", url:"https://themoviedb.org/person/12238"}}, {tmdbId:"25161", properties:{bornIn:"Paris, France", imdbId:"0138893", born:date('1906-08-18'), name:"Marcel Carné", bio:"Born in Paris, France, the son of a cabinet maker whose wife died when their son was five, Marcel Carné began his career as a film critic, becoming editor of the weekly publication, Hebdo-Films, and working for Cinémagazine and Cinémonde between 1929 and 1933.  In the same period he worked in silent film as a camera assistant with director Jacques Feyder.  By age 25, Carné had already directed his first short film, Nogent, Eldorado du dimanche (1929)...", died:date('1996-10-31'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6ZFHCA0MlQDLIMUzUykmA1Nx08G.jpg", url:"https://themoviedb.org/person/25161"}}, {tmdbId:"117773", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0800373", born:date('1910-03-09'), name:"S. Sylvan Simon", died:date('1951-05-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4SrnnvwsWAvAwvnZ2042DNkv8y1.jpg", url:"https://themoviedb.org/person/117773"}}, {tmdbId:"32134", properties:{bornIn:"Budapest, Austria-Hungary [now Hungary]", imdbId:"0896533", born:date('1900-07-26'), name:"Charles Vidor", bio:"Charles Vidor (July 27, 1900 – June 4, 1959) was a film director.  Born Károly Vidor to a Jewish family in Budapest, Hungary, he served in the Hungarian Army during World War I.  He first came to prominence during the final years of the silent film era.  Among his film successes are The Bridge (1929), Cover Girl (1944), A Song to Remember (1945), Gilda (1946), The Loves of Carmen (1948), Love Me or Leave Me (1955), The Swan (1956), The Joker Is Wild (1957), and A Farewell to Arms (1957)...", died:date('1959-06-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iLZxqxrLquOhRThV6iqgcb0LgET.jpg", url:"https://themoviedb.org/person/32134"}}, {tmdbId:"64864", properties:{bornIn:"Chiavenna, Lombardy, Italy", imdbId:"0314671", born:date('1901-06-12'), name:" Clyde Geronimi", bio:"From Wikipedia, the free encyclopedia. \n\nClyde \"Gerry\" Geronimi (June 12, 1901 - April 24, 1989) was an Italian-American animation director.  He is best known for his work at Walt Disney Productions. \n\nGeronimi was born in Chiavenna, Italy, immigrating to the United States as a young child.  Geronimi's earliest work in the animation field was for the J. R.  Bray Studios, where he worked with Walter Lantz.  Geronimi left Bray in 1931 to join Walt Disney Productions, where he remained until 1959...", died:date('1989-04-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vRoKAQ8Wb1nTymH6VqOfhbqL3H9.jpg", url:"https://themoviedb.org/person/64864"}}, {tmdbId:"9730", properties:{bornIn:"Maisons-Laffitte, France", imdbId:"0168413", born:date('1889-07-05'), name:"Jean Cocteau", bio:"From Wikipedia, the free encyclopedia\n\nJean Maurice Eugène Clément Cocteau (French pronunciation: [ʒɑ̃ kɔkto]; 5 July 1889 – 11 October 1963) was a French poet, novelist, dramatist, designer, boxing manager, playwright, artist and filmmaker.  Along with other avant-garde artists of his generation (Jean Anouilh and René Char for example) Cocteau grappled with the algebra of verbal codes old and new, mise en scène language and technologies of modernism to create a paradox: a classical avant-garde...", died:date('1963-10-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vD73WSmN0hH3ZDjlh6n73CJI5sC.jpg", url:"https://themoviedb.org/person/9730"}}, {tmdbId:"9740", properties:{bornIn:"Bordeaux, Gironde, Aquitaine, France", imdbId:"0167496", born:date('1913-03-18'), name:" René Clément", bio:"​From Wikipedia, the free encyclopedia\n\nRené Clément (March 18, 1913, Bordeaux – March 17, 1996, Monte Carlo, Monaco) was a French film director and screenwriter.  Clément studied architecture at the Ecole des Beaux-Arts where he developed an interest in filmmaking.  In 1936, he directed his first film, a 20 minute short written and featuring Jacques Tati.  Clément spent the latter part of the 1930s making documentaries in parts of the Middle East and Africa...", died:date('1996-03-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z8mgHCLlND5B0rNaTdm9Ag1AtKz.jpg", url:"https://themoviedb.org/person/9740"}}, {tmdbId:"233136", properties:{imdbId:"0112897", born:date('1895-12-02'), name:" Otto Brower", died:date('1946-01-25'), url:"https://themoviedb.org/person/233136"}}, {tmdbId:"11489", properties:{bornIn:"New Haven, Connecticut, USA", imdbId:"0580017", born:date('1896-07-29'), name:" William Cameron Menzies", bio:"From Wikipedia, the free encyclopedia. \n\nWilliam Cameron Menzies (July 29, 1896 – March 5, 1957) was an Academy Award-winning American film production designer (a job title he invented) and art director who also worked as a director, producer, and screenwriter during a career spanning five decades.  He earned acclaim for his work in silent movies, and later pioneered the use of color in film for dramatic effect...", died:date('1957-03-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ydx0eRPERKg6oD9r3horgYGJkaK.jpg", url:"https://themoviedb.org/person/11489"}}, {tmdbId:"14292", properties:{bornIn:"Edgeley, Stockport, Cheshire, England, UK", imdbId:"0319148", born:date('1908-02-15'), name:"Sidney Gilliat", bio:"From Wikipedia, the free encyclopedia\n\nSidney Gilliat (15 February 1908 – 31 May 1994) was an English film director, producer and writer. \n\nHe was born in the district of Edgeley in Stockport, Cheshire.  In the 1930s he worked as a scriptwriter, most notably with Frank Launder on The Lady Vanishes (1938) for Alfred Hitchcock, and its sequel Night Train to Munich (1940), directed by Carol Reed.  He and Launder made their directorial debut co-directing the home front drama Millions Like Us (1943)...", died:date('1994-05-31'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qLjqxmoQHBzaxerI2gm2SMtPRYG.jpg", url:"https://themoviedb.org/person/14292"}}, {tmdbId:"142526", properties:{bornIn:"California, USA", imdbId:"0179994", born:date('1909-04-01'), name:"Robert Cormack", died:date('1952-03-25'), url:"https://themoviedb.org/person/142526"}}, {tmdbId:"222238", properties:{bornIn:"Greenwood, Mississippi, USA", imdbId:"0575008", born:date('1911-03-12'), name:" Joshua Meador", bio:"Known for his work on Fantasia (1940), Cinderella (1950) and Sleeping Beauty (1959).  He was married to Libby Meador...", died:date('1965-08-01'), url:"https://themoviedb.org/person/222238"}}, {tmdbId:"74878", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0307819", born:date('1894-06-13'), name:"Tay Garnett", bio:"From Wikipedia, the free encyclopedia. \n\nTay Garnett  (born William Taylor Garnett 13 June 1894 – 3 October 1977) was an American film director and writer. \n\nBorn in Los Angeles, California, Garnett served as a naval aviator in World War I and entered films as a screenwriter in 1920.  He was a gagwriter for Mack Sennett and Hal Roach, then joined Pathé and began to direct films in 1928...", died:date('1977-10-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rJ8BLFlddNDRIgIPcvxTaTuOitu.jpg", url:"https://themoviedb.org/person/74878"}}, {tmdbId:"275022", properties:{imdbId:"0287836", name:" Harve Foster", url:"https://themoviedb.org/person/275022"}}, {tmdbId:"50302", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0335455", born:date('1905-07-02'), name:"James Edward Grant", bio:"From Wikipedia, the free encyclopedia\n\nJames Edward Grant (July 2, 1905 - February 19, 1966) was an American short story writer and screenwriter who contributed to more than fifty films between 1935 and 1971. \n\nBorn in Chicago, Grant began his career in the mid-1930s developing stories or writing scripts for mostly B movies.  He collaborated with John Wayne on twelve projects, starting with Angel and the Badman (which he also directed) in 1947 through Circus World in 1964...", died:date('1966-02-19'), url:"https://themoviedb.org/person/50302"}}, {tmdbId:"94880", properties:{bornIn:"New York City, New York, USA", imdbId:"0718321", born:date('1906-05-07'), name:"Irving Reis", bio:"From Wikipedia, the free encyclopedia\n\nIrving Reis, (born May 7, 1906, in New York City – died July 3, 1953, in Woodland Hills, California) was a radio program producer and director, and a film director. \n\nving Reis was born into a Jewish family. \n\nReis began his career as a motion picture photographer.  The most notable of his screen efforts was being one of the photographers for The Hollywood Revue of 1929. \n\nA 1931 notice in Variety declared that he was transitioning into a playwright...", died:date('1953-07-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/klk22CCF54ewmvDfpPDLwdvL1AM.jpg", url:"https://themoviedb.org/person/94880"}}, {tmdbId:"33064", properties:{bornIn:"Berlin, Germany", imdbId:"0467396", born:date('1905-05-01'), name:"Henry Koster", bio:"From Wikipedia, the free encyclopedia\n\nHenry Koster (May 1, 1905 – September 21, 1988) was born Hermann Kosterlitz in Berlin, Germany.  He became a film director and later moved to Hollywood.  Koster's father, a salesman, left home when Henry was a young man.  Koster still managed to finish gymnasium (high school) in Berlin while working as short story writer and cartoonist. \n\nDescription above from the Wikipedia article Henry Koster, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1988-09-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vmIiFgDzZUAiZQIKpEF5QMimlRj.jpg", url:"https://themoviedb.org/person/33064"}}, {tmdbId:"14875", properties:{bornIn:"New York City, New York, USA", imdbId:"0744035", born:date('1908-03-16'), name:"Robert Rossen", bio:"From Wikipedia, the free encyclopedia.   Robert Rossen (March 16, 1908 – February 18, 1966) was an American screenwriter, film director, and producer whose film career spanned almost three decades.  His 1949 film All the King's Men won Oscars for Best Actor and Best Supporting Actress, while Rossen was nominated for an Oscar as Best Director.  He won the Golden Globe for Best Director and the film won the Golden Globe Award for Best Picture...", died:date('1966-02-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cCHbCefgvZ5abJTXTyp2sKch6rT.jpg", url:"https://themoviedb.org/person/14875"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"83399", properties:{bornIn:"New York City, New York, USA ", imdbId:"0693281", born:date('1904-11-13'), name:"H.C. Potter", bio:"​From Wikipedia, the free encyclopedia3\n\nHenry Codman Potter II (November 13, 1904 - August 31, 1977) was an American theatrical producer/director and a motion picture director. \n\nDescription above from the Wikipedia article H.  C.  Potter, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1977-08-31'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a7afmHobTSV9yY5w3p8NfOE7S2v.jpg", url:"https://themoviedb.org/person/83399"}}, {tmdbId:"10601", properties:{bornIn:"Wilkes-Barre, Pennsylvania, USA", imdbId:"0000581", born:date('1909-02-11'), name:"Joseph L. Mankiewicz", bio:"Joseph Leo Mankiewicz was an American film director, screenwriter, and producer.  Mankiewicz had a long Hollywood career and is best known as the writer-director of the Oscar-winning All About Eve (1950).  He was brother to screenwriter and drama critic Herman J.  Mankiewicz who also won an Oscar for co-writing Citizen Kane (1941)...", died:date('1993-02-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1zqHOZQlevCE2ld15qUt24Nxr7u.jpg", url:"https://themoviedb.org/person/10601"}}, {tmdbId:"37360", properties:{bornIn:"Sacramento, California, United States", imdbId:"0368871", born:date('1898-03-13'), name:"Henry Hathaway", bio:"​From Wikipedia, the free encyclopedia.   \n\nHenry Hathaway (March 13, 1898 – February 11, 1985) was an American film director and producer.  He is best known as a director of Westerns, especially starring John Wayne. \n\nDescription above from the Wikipedia article  Henry Hathaway, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1985-02-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pXnCjOCLAXWf1hE1tdVA4ANR6BB.jpg", url:"https://themoviedb.org/person/37360"}}, {tmdbId:"46712", properties:{bornIn:"Hamburg, Germany", imdbId:"0802862", born:date('1897-04-26'), name:"Douglas Sirk", bio:"Douglas Sirk (born Hans Detlef Sierck; April 26, 1897 – January 14, 1987) was a Danish-German film director best known for his work in Hollywood melodramas in the 1950s...", died:date('1987-01-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fB3zoAXmVwgQqBMcAmbTDnNRjxf.jpg", url:"https://themoviedb.org/person/46712"}}, {tmdbId:"24939", properties:{bornIn:"South Bend, Indiana", imdbId:"0780833", born:date('1911-04-17'), name:"George Seaton", bio:"From Wikipedia, the free encyclopedia. \n\nGeorge Seaton (April 17, 1911 – July 28, 1979) was an American screenwriter, playwright, film director and producer, and theatre director. \n\nBorn George Stenius in South Bend, Indiana, Seaton moved to Detroit after graduating from college to work as an actor on radio station WXYZ.  John L...", died:date('1979-07-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ynH63JLcuHEf1xnNSBXULzLDgkJ.jpg", url:"https://themoviedb.org/person/24939"}}, {tmdbId:"89914", properties:{bornIn:"Dover, Ohio, USA", imdbId:"0637790", born:date('1896-09-20'), name:"Elliott Nugent", bio:"​From Wikipedia, the free encyclopedia. \n\nElliott Nugent (September 20, 1896, Dover, Ohio - August 9, 1980, New York City) was an American actor, writer, and film director.  He successfully made the transition from silent film to sound.  He directed The Cat and the Canary (1939), starring Bob Hope and Paulette Goddard.  He also directed the Hope films Never Say Die (1939) and My Favorite Brunette (1947). \n\nNugent was a college classmate (and lifelong friend) of fellow Ohioan James Thurber...", died:date('1980-08-09'), url:"https://themoviedb.org/person/89914"}}, {tmdbId:"15378", properties:{bornIn:"Putney, London, England, UK", imdbId:"0715346", born:date('1906-12-30'), name:"Carol Reed", bio:"From Wikipedia, the free encyclopedia\n\nSir Carol Reed (30 December 1906 – 25 April 1976) was an English film director best known for Odd Man Out (1947), The Fallen Idol (1948), and The Third Man (1949).  He won the Palme d'Or for The Third Man and the 1968 Academy Award for Best Director for Oliver!. \n\nDescription above from the Wikipedia article Carol Reed, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1976-04-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lARwFIU3XBroITGbjKgZVBhRbtg.jpg", url:"https://themoviedb.org/person/15378"}}, {tmdbId:"33062", properties:{bornIn:"Worms, Germany", imdbId:"0076779", born:date('1899-04-15'), name:"Curtis Bernhardt", bio:"​From Wikipedia, the free encyclopedia\n\nCurtis Bernhardt (Kurt Bernhardt) (15 April 1899 – 22 February 1981) was a German film director born in Worms, Germany.  Some of his American films were called \"woman's films\" including the Joan Crawford film Possessed (1947).  Bernhardt trained as an actor in Germany, and performed on the stage, before starting as a film director in 1926.  Other films include A Stolen Life (1946) starring Bette Davis and Sirocco (1951) starringHumphrey Bogart...", died:date('1981-02-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6eVNSKjZvbcqMLYygHA6ejs8zYh.jpg", url:"https://themoviedb.org/person/33062"}}, {tmdbId:"2559", properties:{bornIn:"Niort, Deux-Sèvres, Poitou-Charentes, France", imdbId:"0167241", born:date('1907-11-20'), name:"Henri-Georges Clouzot", bio:"​From Wikipedia, the free encyclopedia. \n\nHenri-Georges Clouzot (August 18, 1907 – January 12, 1977) was a French film director, screenwriter and producer.  He is best remembered for his work in the thriller film genre, having directed The Wages of Fear and Les Diaboliques, which are critically recognized to be among the greatest films from the 1950s.  Clouzot also directed documentary films, including The Mystery of Picasso, which was declared a national treasure by the government of France...", died:date('1977-01-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lKljbdReVkqhwTsjBcuqt1Uwiiq.jpg", url:"https://themoviedb.org/person/2559"}}, {tmdbId:"30099", properties:{bornIn:"San Francisco, California, U.S.", imdbId:"0059106", born:date('1902-05-25'), name:"Charles Barton", bio:"From Wikipedia, the free encyclopedia. \n\nCharles Barton (May 25, 1902 – December 5, 1981) was a film and vaudeville actor and film director.  He won an Oscar for best assistant director in 1933.  His first film as a director was the Zane Grey feature Wagon Wheels. \n\nDescription above from the Wikipedia article Charles Barton, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1981-12-05'), url:"https://themoviedb.org/person/30099"}}, {tmdbId:"81976", properties:{bornIn:"New York, New York, U.S.", imdbId:"0689796", born:date('1910-12-05'), name:"Abraham Polonsky", bio:"From Wikipedia, the free encyclopedia\n\nAbraham Lincoln Polonsky (December 5, 1910 - October 26, 1999) was an American film director, Academy-Award-nominated screenwriter, essayist, and novelist blacklisted by the Hollywood movie studios in the 1950s, in the midst of the McCarthy era. \n\nDescription above from the Wikipedia article Abraham Polonsky, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1999-10-26'), url:"https://themoviedb.org/person/81976"}}, {tmdbId:"19606", properties:{bornIn:"Craiova, Dolj, Romania", imdbId:"0624535", born:date('1900-02-26'), name:"Jean Negulesco", bio:"From Wikipedia, the free encyclopedia. \n\nJean Negulesco (26 February 1900 – 18 July 1993) was a Romanian-born American film director and screenwriter. \n\nBorn in Craiova, he attended Carol I High School.  In 1915 he moved to Vienna, in 1919 to Bucharest, where he worked as a painter, before becoming a stage decorator in Paris.  In 1927 he went to New York City for an exhibition of his paintings, and settled there...", died:date('1993-07-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eF9ziWzUCPAh83g9W4paa5HnOaX.jpg", url:"https://themoviedb.org/person/19606"}}, {tmdbId:"14353", properties:{bornIn:"Saarbrücken, Saarland, Germany", imdbId:"0649097", born:date('1902-05-06'), name:"Max Ophüls", bio:"​From Wikipedia, the free encyclopedia.   \n\nMaximillian Oppenheimer (6 May 1902, Saarbrücken, Germany - 26 March 1957, Hamburg, Germany) — known as Max Ophüls — was an influential German-born film director who worked in Germany (1931–33), France (1933–40), the United States (1947–50), and France again (1950–57).  He made nearly 30 films altogether, those from the last period being especially noted: La Ronde (1950), Le Plaisir (1952), The Earrings of Madame de. . .  (1953) and Lola Montès (1955)...", died:date('1957-03-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/m1e8TJOJs57IS5A0SJw4NFN1IQO.jpg", url:"https://themoviedb.org/person/14353"}}, {tmdbId:"37361", properties:{bornIn:"Kiev, Russian Empire", imdbId:"0514822", born:date('1902-05-10'), name:"Anatole Litvak", bio:"From Wikipedia, the free encyclopedia. \n\nAnatole Litvak  (May 10, 1902 – December 15, 1974) was a Ukrainian-born filmmaker of Jewish heritage who wrote, directed, and produced films in a various countries and languages.  He was nominated for an Academy Award for Best Director for the film The Snake Pit (1948). \n\nDescription above from the Wikipedia article Anatole Litvak, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1974-12-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pgd4ixBODEMwwzyf705Ki7sOOlG.jpg", url:"https://themoviedb.org/person/37361"}}, {tmdbId:"2765", properties:{bornIn:"Galesville, Wisconsin, USA", imdbId:"0712947", born:date('1911-08-07'), name:"Nicholas Ray", bio:"Nicholas Ray (born Raymond Nicholas Kienzle; 7 August 1911 – 16 June 1979) was an American film director best known for the movie Rebel Without a Cause and Johnny Guitar...", died:date('1979-06-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zQZXpN0c2qGnPgFWV8oMbg9hgmH.jpg", url:"https://themoviedb.org/person/2765"}}, {tmdbId:"5026", properties:{bornIn:"Shinagawa, Tóquio, Japão", imdbId:"0000041", born:date('1910-03-23'), name:"Akira Kurosawa", bio:"​From Wikipedia, the free encyclopedia.   \n\nAkira Kurosawa (Kyūjitai: 黒澤 明, Shinjitai: 黒沢 明 Kurosawa Akira; March 23, 1910 – September 6, 1998) was a Japanese film director, producer, screenwriter and editor.  Regarded as one of the most important and influential filmmakers in the history of cinema, Kurosawa directed 30 films in a career spanning 57 years.  Kurosawa entered the Japanese film industry in 1936, following a brief stint as a painter...", died:date('1998-09-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uCFWmYXu0EqF5Bd6zWaOS4FxvEB.jpg", url:"https://themoviedb.org/person/5026"}}, {tmdbId:"13284", properties:{bornIn:"Columbia, South Carolina, USA", imdbId:"0002045", born:date('1924-04-13'), name:"Stanley Donen", bio:"Stanley Donen (April 13, 1924-February 23, 2019) was an American film director and choreographer hailed by David Quinlan as \"the King of the Hollywood musicals\".  His most celebrated work was Singin' in the Rain (1952), which he co-directed with Gene Kelly. \n\nDescription above from the Wikipedia article Stanley Donen, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2019-02-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ds7TffqzWhnW9kndY1hnOajkpEA.jpg", url:"https://themoviedb.org/person/13284"}}, {tmdbId:"9082", properties:{bornIn:"Cherokee, Iowa, USA", imdbId:"0776838", born:date('1902-08-01'), name:"Harold D. Schuster", bio:"A highly regarded editor (he cut the classic Sunrise (1927) ), Harold D.  Schuster started out in films as an actor.  It didn't take him long to abandon that career, and he turned to the production side of the business, working his way up to editor and eventually taking the reins as a director.  While much of his directorial output is routine, there are some real gems scattered throughout...", died:date('1986-07-19'), url:"https://themoviedb.org/person/9082"}}, {tmdbId:"11593", properties:{bornIn:"Krakau, Galicia, Austria-Hungary [now Kraków, Malopolskie, Poland]", imdbId:"0005789", born:date('1898-01-21'), name:"Rudolph Maté", bio:"​From Wikipedia, the free encyclopedia\n\nRudolph Maté, A. S. C.  (21 January 1898 – 27 October 1964), born Rudolf Matheh or Mayer, was an accomplished cinematographer and film director. \n\nBorn in Kraków (then in Austria-Hungary, now in Poland), Maté started in the film business after his graduation from the University of Budapest.  He went on to work as an assistant cameraman in Hungary and later throughout Europe, sometimes with noted colleague Karl Freund...", died:date('1964-10-27'), url:"https://themoviedb.org/person/11593"}}, {tmdbId:"86004", properties:{bornIn:"New York City, New York, USA", imdbId:"0507390", born:date('1907-04-06'), name:"Joseph H. Lewis", bio:"​From Wikipedia, the free encyclopedia. \n\nJoseph H.  Lewis  (April 6, 1907–August 30, 2000), was an American B-movie film director. \n\nAlthough he worked with both Béla Lugosi (The Invisible Ghost) and Lionel Atwill in early 1940s horror, he is best known for his work in film noir from the late 40s and the 1950s.  His most acclaimed feature, Gun Crazy (1949), is a dark romance about gun-obsession, and notable for its use of location photography...", died:date('2000-08-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zwVcEawngwpxAL7698Fb8w6xL6a.jpg", url:"https://themoviedb.org/person/86004"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"142297", properties:{bornIn:"Turnbridge Wells, Kent, U.K.", imdbId:"0071682", born:date('1900-01-15'), name:"Compton Bennett", died:date('1974-08-13'), url:"https://themoviedb.org/person/142297"}}, {tmdbId:"57142", properties:{bornIn:"Budapest, Austria-Hungary (now Budapest, Hungary)", imdbId:"0554249", born:date('1904-01-26'), name:" Andrew Marton", bio:"​From Wikipedia, the free encyclopedia. \n\nAndrew Marton  (born Endre Marton, 26 January 1904 Budapest, Hungary - 7 January 1992 Santa Monica, California) was a Hungarian-American director, producer and editor.  In his career he directed 39 films and television programs solo, and 16 as an assistant director...", died:date('1997-01-07'), url:"https://themoviedb.org/person/57142"}}, {tmdbId:"14227", properties:{bornIn:"Middletown, Connecticut, USA", imdbId:"0202088", born:date('1911-12-18'), name:"Jules Dassin", bio:"From Wikipedia, the free encyclopedia\n\nJulius \"Jules\" Dassin (December 18, 1911 – March 31, 2008) was an American film director, producer, writer and actor.  He was a subject of the Hollywood blacklist in the McCarthy era, and subsequently moved to France, where he revived his career. \n\nDassin quickly became better known for his noir films Brute Force (1947), The Naked City (1948), and Thieves' Highway (1949), which helped him to become \"one of the leading American filmmakers of the postwar era...", died:date('2008-03-31'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rpGBy8c99OkJom3uT7s1UGGrsKR.jpg", url:"https://themoviedb.org/person/14227"}}, {tmdbId:"51000", properties:{bornIn:"Portland, Oregon, USA", imdbId:"0005738", born:date('1899-04-22'), name:"Byron Haskin", bio:"Byron Conrad Haskin was an American film and television director.  He was born in Portland, Oregon. \n\nHe is remembered today for directing 1953's The War of the Worlds, one of many films where he teamed with producer George Pal.  In his early career, he was a special effects artist, with a number of credits on Warner Bros.  films, an asset when directing the killer ants film The Naked Jungle and the science fiction film Robinson Crusoe on Mars.  Haskin also worked as a cinematographer and producer...", died:date('1984-04-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sQQDcR6jYQiFyYFE2oEVhNGAQS6.jpg", url:"https://themoviedb.org/person/51000"}}, {tmdbId:"29627", properties:{bornIn:"St. Petersburg, Russia", imdbId:"0006943", born:date('1895-05-05'), name:"Charles Lamont", bio:"From Wikipedia, the free encyclopedia. \n\nCharles Lamont (5 May 1895 – 12 September 1993) was a prolific film director of over 200 titles, and the producer and writer of many others.  He was born in St.  Petersburg, Russia, and died in Los Angeles, California, USA. \n\nDescription above from the Wikipedia article Charles Lamont, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1993-11-12'), url:"https://themoviedb.org/person/29627"}}, {tmdbId:"96071", properties:{bornIn:"Paris, France", imdbId:"0934827", born:date('1906-01-20'), name:"Bretaigne Windust", bio:"From Wikipedia, the free encyclopedia\n\nErnest Bretaigne Windust (January 20, 1906 – March 19, 1960) was a US-based French-born theater, film, and television director. \n\nCareer\n\nPlanning to become an actor, Windust co-founded with Charles Leatherbee the University Players in 1928 on Cape Cod in Falmouth, Massachusetts...", died:date('1960-03-18'), url:"https://themoviedb.org/person/96071"}}, {tmdbId:"261224", properties:{imdbId:"0221423", name:"Brian Desmond Hurst", url:"https://themoviedb.org/person/261224"}}, {tmdbId:"97573", properties:{bornIn:"Paris, Illinois, USA", imdbId:"0794793", born:date('1913-05-25'), name:"Lee Sholem", bio:"​From Wikipedia, the free encyclopedia.   \n\nLee Tabor Sholem (born 25 May 1913 in Paris, Illinois and died 19 August 2000 in Los Angeles, California) was an American television and film director.  Nicknamed \"\"Roll 'Em\" Sholem\", he is identified more than anyone else in the industry with speed and efficiency.  He directed more than 1300 shows, including both features and TV episodes, without ever going over schedule...", died:date('2000-08-19'), url:"https://themoviedb.org/person/97573"}}, {tmdbId:"103910", properties:{bornIn:"New York City, New York, USA", imdbId:"0270765", born:date('1910-02-28'), name:"Felix E. Feist", bio:"​From Wikipedia, the free encyclopedia\n\nFelix E.  Feist (February 28, 1910 - September 2, 1965) was a film and television director born in New York City.  Feist was the son of MGM sales executive, Felix F.  Fiest (1884–1936), and nephew of publishing house magnate, Leo Feist.  He was educated at Columbia University...", died:date('1965-09-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5rTu745BE6PASvH39rhkXUVUdPM.jpg", url:"https://themoviedb.org/person/103910"}}, {tmdbId:"8636", properties:{bornIn:"Ashfield, Massachusetts, USA", imdbId:"0001124", born:date('1881-08-12'), name:"Cecil B. DeMille", bio:"Cecil Blount DeMille (August 12, 1881 – January 21, 1959) was an American film director and Academy Award-winning film producer in both silent and sound films.  He was renowned for the flamboyance and showmanship of his movies.  Among his best-known films are The Ten Commandments (1956), Cleopatra (1934), and The Greatest Show on Earth (1952), which won the Academy Award for Best Picture. \n\nDescription above from the Wikipedia article Cecil B...", died:date('1959-01-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xMh7QPEm6bohkpmyGIvbWaq6097.jpg", url:"https://themoviedb.org/person/8636"}}, {tmdbId:"29907", properties:{bornIn:"Chicago, Illinois", imdbId:"0439597", born:date('1908-07-02'), name:"Phil Karlson", bio:"From Wikipedia, the free encyclopedia\n\nPhil Karlson (July 2, 1908, Chicago, Illinois – December 12, 1985, Los Angeles, California) was a film director known for his no-nonsense film noirs.  Karlson directed 99 River Street, Kansas City Confidential and Hell's Island all with actor John Payne in the early 1950s.  Other films include Rocky (1948), The Phenix City Story (1955), 5 Against the House (1955) and The Young Doctors (1961). \n\nPhil Karlson was the son of popular Irish actress Lillian O'Brien...", died:date('1985-12-12'), url:"https://themoviedb.org/person/29907"}}, {tmdbId:"8929", properties:{bornIn:"Wallasey, Merseyside, England", imdbId:"0187769", born:date('1910-08-06'), name:"Charles Crichton", bio:"Charles Crichton was an English film director and film editor.  He became best known for directing comedies produced at Ealing Studios.  Crichton enjoyed an extremely long career, editing and directing many films and television programmes over a period exceeding 40 years...", died:date('1999-09-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bRGHjlOGvyCRsXojDLbevDujrUo.jpg", url:"https://themoviedb.org/person/8929"}}, {tmdbId:"14566", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0533241", born:date('1912-09-08'), name:"Alexander Mackendrick", bio:"Alexander Mackendrick was a Scottish-American director and teacher...", died:date('1993-12-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3fJxxUvtaOOnwkCbOfcrHxDhdcD.jpg", url:"https://themoviedb.org/person/14566"}}, {tmdbId:"26134", properties:{bornIn:"London, England", imdbId:"0001928", born:date('1916-12-19'), name:" Roy Ward Baker", bio:"Roy Ward Baker is an English film director born in London on 19 December 1916.  His best known film is A Night to Remember which won a Golden Globe for best foreign English language film in 1959.  His later career was varied, and included many horror films and television shows. \n\nBaker's early career, from 1934 to 1939, was spent working for Gainsborough Pictures, a British film production company based in Islington, North London, famous for its prestige productions...", died:date('2010-10-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8y7ip2Nhos2I0UfLOFz3kSlmoJp.jpg", url:"https://themoviedb.org/person/26134"}}, {tmdbId:"46307", properties:{bornIn:"Brooklyn, New York City, New York, USA", imdbId:"0746740", born:date('1910-12-31'), name:"Roy Rowland", bio:"From Wikipedia, the free encyclopedia\n\nRoy Rowland (December 31, 1910 – June 29, 1995) was an American film director.  He helmed a number of films in the 1940s, 1950s and 1960s, including Our Vines Have Tender Grapes, Meet Me in Las Vegas, Rogue Cop, The 5000 Fingers of Doctor T, and The Girl Hunters.  Rowland was the husband of Ruth Cummings, niece of Louis B.  Mayer and sister of MGM producer/director Jack Cummings...", died:date('1995-06-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9b6DUS03ryhWWYrF5WUupVM3bMD.jpg", url:"https://themoviedb.org/person/46307"}}, {tmdbId:"146964", properties:{bornIn:"Santa Monica, California, USA", imdbId:"0001910", born:date('1927-02-03'), name:"Kenneth Anger", bio:"Kenneth Anger (born Kenneth Wilbur Anglemeyer; February 3, 1927) is an American underground experimental filmmaker, actor and author.  Working exclusively in short films, he has produced almost forty works since 1937, nine of which in particular have been grouped together as the \"Magick Lantern Cycle,\" and form the basis of Anger's reputation as one of the most influential independent filmmakers in cinema history...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gspoSoEjQSpBKBQx3g9frjFOM7f.jpg", url:"https://themoviedb.org/person/146964"}}, {tmdbId:"44763", properties:{bornIn:"Poughkeepsie, New York, USA", imdbId:"0000248", born:date('1924-10-10'), name:"Edward D. Wood Jr.", bio:"From Wikipedia, the free encyclopedia\n\nEdward Davis Wood, Jr.  (October 10, 1924 – December 10, 1978), better known as Ed Wood, was an American screenwriter, director, producer, actor, author, and editor, who often performed many of these functions simultaneously...", died:date('1978-12-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3QFtMpm5yrlRMdo1reKDHnfsZM2.jpg", url:"https://themoviedb.org/person/44763"}}, {tmdbId:"81799", properties:{bornIn:"Makó, Csanád County, Austria-Hungary (now Hungary)", imdbId:"0211964", born:date('1915-05-15'), name:"André De Toth", bio:"From Wikipedia, the free encyclopedia. \n\nAndré de Toth (May 15, circa 1912 – October 27, 2002) was a Hungarian-American filmmaker, born and raised in Makó, Csongrád, Kingdom of Hungary Austro-Hungarian Empire.  He directed the 3-D film House of Wax, despite being unable to see in 3-D himself, having lost an eye at an early age.  He is known for his gritty B movies in the western and crime genres...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jnEkn2AUZknoXDeUiJdsQDvClaJ.jpg", url:"https://themoviedb.org/person/81799"}}, {tmdbId:"26959", properties:{bornIn:"Worcester, Massachusetts, US", imdbId:"0002087", born:date('1912-08-12'), name:"Samuel Fuller", bio:"Samuel Michael Fuller (August 12, 1912 – October 30, 1997) was an American screenwriter, novelist and film director known for low-budget genre movies with controversial themes. \n\nHe was born Samuel Michael Fuller in Worcester, Massachusetts, the son of Benjamin Rabinovitch, a Jewish immigrant  from Russia, and Rebecca Baum, a Jewish immigrant from Poland...", died:date('1997-10-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yC1rWSkV8crevItmlRz056GOTMf.jpg", url:"https://themoviedb.org/person/26959"}}, {tmdbId:"6648", properties:{bornIn:"Uppsala, Uppsala län, Sweden", imdbId:"0000005", born:date('1918-07-14'), name:"Ingmar Bergman", bio:"Ernst Ingmar Bergman (14 July 1918 – 30 July 2007) was a Swedish director, writer and producer for film, stage and television.  His influential body of work dealt with bleakness and despair as well as comedy and hope.  Described by Woody Allen as \"probably the greatest film artist, all things considered, since the invention of the motion picture camera\", he is recognized as one of the most accomplished and influential film directors of all time...", died:date('2007-07-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nkmOaXNRoioViN9OQf2n9Iu6akA.jpg", url:"https://themoviedb.org/person/6648"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"97202", properties:{bornIn:"Asakusa, Tokyo, Japan", imdbId:"0003226", born:date('1898-05-16'), name:"Kenji Mizoguchi", bio:"From Wikipedia, the free encyclopedia\n\nKenji Mizoguchi (May 16, 1898 – August 24, 1956) was a Japanese film director and screenwriter.  His film Ugetsu (1953) won the Silver Lion at the Venice Film Festival, and appeared in the Sight &amp; Sound Critics' Top Ten Poll in 1962 and 1972.  Mizoguchi is renowned for his mastery of the long take and mise-en-scène.  \"His films have an extraordinary force and purity...", died:date('1956-08-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ngKRZZPKh8d7GaeMgcM0eXbzMte.jpg", url:"https://themoviedb.org/person/97202"}}, {tmdbId:"85758", properties:{imdbId:"0760170", name:" Edward Sampson", url:"https://themoviedb.org/person/85758"}}, {tmdbId:"18598", properties:{bornIn:"Yamagata, Japan", imdbId:"0393094", born:date('1911-05-07'), name:"Ishirô Honda", bio:"Ishirō Honda (Honda Ishirō), sometimes miscredited in foreign releases as \"Inoshiro Honda\", (May 7, 1911, in Yamagata Prefecture – February 28, 1993) was a Japanese film director.  His early film career included working as an assistant under the famed director Akira Kurosawa. \n\nAlongside his film duties, he was drafted into the Imperial Japanese Army during World War II in China and was a prisoner there when the war ended...", died:date('1993-02-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4IAWgBpHCsfrEBbDzK47W4QthuD.jpg", url:"https://themoviedb.org/person/18598"}}, {tmdbId:"108012", properties:{bornIn:"Tokyo, Tokyo, Japan", imdbId:"0408348", born:date('1905-12-30'), name:"Hiroshi Inagaki", bio:"From Wikipedia, the free encyclopedia\n\nHiroshi Inagaki (稲垣 浩 Inagaki Hiroshi, 30 December 1905 – 21 May 1980) was a Japanese filmmaker most known for the Academy Award-winning Samurai I: Musashi Miyamoto, which he directed in 1954. \n\nBorn in Tokyo as the son of a shinpa actor, Inagaki appeared on stage in his childhood before joining the Nikkatsu studio as an actor in 1922...", died:date('1980-05-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1w8ZE9L7db2Io1sJ3soAlPSw6Wc.jpg", url:"https://themoviedb.org/person/108012"}}, {tmdbId:"12327", properties:{bornIn:"Logan, Utah, USA", imdbId:"0628149", born:date('1909-08-07'), name:"Joseph M. Newman", bio:"​​From Wikipedia\n\nJoseph M.  Newman was an American film director most famous for his 1955 film This Island Earth.  He was nominated for two Academy Awards in the now defunct category of Assistant Director, for David Copperfield (1935) and San Francisco (1936).  Newman's credits include episodes of The Twilight Zone and The Alfred Hitchcock Hour television series...", died:date('2006-01-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/m061oWEleJ7fiJPQksvBqKOm6Z8.jpg", url:"https://themoviedb.org/person/12327"}}, {tmdbId:"47399", properties:{bornIn:"Weehawken, New Jersey, USA", imdbId:"0850895", born:date('1913-02-19'), name:"Frank Tashlin", bio:"From Wikipedia, the free encyclopedia. \n\nFrank Tashlin, born Francis Fredrick von Taschlein, also known as Tish Tash or Frank Tash (February 19, 1913 – May 5, 1972) was an American animator, screenwriter, and film director. \n\nDescription above from the Wikipedia article Frank Tashlin, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1972-05-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zpEGkj8N06vLpne4SMN8YM1oF8F.jpg", url:"https://themoviedb.org/person/47399"}}, {tmdbId:"65481", properties:{bornIn:"New York City, New York, USA", imdbId:"0204016", born:date('1905-08-25'), name:"Valentine Davies", died:date('1961-07-23'), url:"https://themoviedb.org/person/65481"}}, {tmdbId:"3831", properties:{bornIn:"Paris, France", imdbId:"0578483", born:date('1917-10-20'), name:"Jean-Pierre Melville", bio:"Jean-Pierre Melville, born Jean-Pierre Grumbach (October 20, 1917 – August 2, 1973), was a French filmmaker.  While with the French Resistance during World War II, he adopted the pseudonym Melville as a tribute to his favorite American author, Herman Melville.  He kept it as his stage name once the war was over. \n\nDescription above from the Wikipedia article Jean-Pierre Melville, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1973-08-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2Xu99MNnzqL5gwKzsidQQatGTb3.jpg", url:"https://themoviedb.org/person/3831"}}, {tmdbId:"15705", properties:{bornIn:"New York City, New York, United States", imdbId:"0678928", born:date('1911-09-15'), name:"Joseph Pevney", bio:"From Wikipedia, the free encyclopedia\n\nJoseph Pevney (September 15, 1911 – May 18, 2008) was an American film and television director. \n\nDescription above from the Wikipedia article Joseph Pevney, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2008-05-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/50Oka9ksYwgddoKCQWnmMcNEy28.jpg", url:"https://themoviedb.org/person/15705"}}, {tmdbId:"67451", properties:{bornIn:"Lawrence, Kansas, USA", imdbId:"0542720", born:date('1920-01-30'), name:"Delbert Mann", bio:"From Wikipedia, the free encyclopedia\n\nDelbert Martin Mann, Jr.  (January 30, 1920 – November 11, 2007) was an American television and film director.  He won the Palme d'Or (Golden Palm) at the Cannes Film Festival and the Academy Award for Best Director for the film Marty.  It was the first Best Picture winner to be based on a television program, being adapted from a 1953 teleplay of the same name which he had also directed...", died:date('2007-11-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pbCYJrkx3oiFNS5wR0jqVIk8aL4.jpg", url:"https://themoviedb.org/person/67451"}}, {tmdbId:"11983", properties:{bornIn:"Vannes, Morbihan, Bretagne, France", imdbId:"0720297", born:date('1922-06-03'), name:"Alain Resnais", bio:"Alain Resnais (3 June 1922 – 1 March 2014) was a French film director and screenwriter whose career extended over more than six decades.  After training as a film editor in the mid-1940s, he went on to direct a number of short films which included Night and Fog (1955), an influential documentary about the Nazi concentration camps...", died:date('2014-03-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hWwXv568JsVCGBDyaZvfaQclVwS.jpg", url:"https://themoviedb.org/person/11983"}}, {tmdbId:"12160", properties:{bornIn:"Calcutta, Bengal Presidency, British India [now India]", imdbId:"0006249", born:date('1921-05-02'), name:"Satyajit Ray", bio:"Satyajit Ray (2 May 1921 – 23 April 1992) was an Indian filmmaker, widely regarded as one of the greatest filmmakers of the 20th century.  Ray was born in the city of Calcutta into a Bengali family prominent in the world of arts and literature.  Starting his career as a commercial artist, Ray was drawn into independent filmmaking after meeting French filmmaker Jean Renoir and viewing Vittorio De Sica's Italian neorealist film Bicycle Thieves (1948) during a visit to London...", died:date('1992-04-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zscxYk8UFenZYJMtTULfbCUdm2k.jpg", url:"https://themoviedb.org/person/12160"}}, {tmdbId:"80568", properties:{bornIn:"Normal, Illinois, USA", imdbId:"0382529", born:date('1906-01-11'), name:"Jesse Hibbs", died:date('1985-02-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zOtfTzc2LqAeqk0iblsHsRG90Xt.jpg", url:"https://themoviedb.org/person/80568"}}, {tmdbId:"150977", properties:{bornIn:"Iisalmi, Grand Duchy of Finland, Russian Empire [now Finland]", imdbId:"0481838", born:date('1905-07-13'), name:"Edvin Laine", bio:"Edvin Laine (13 July 1905 – 18 November 1989) was a Finnish film director.  Laine was born Bovellán. \n\nLaine directed Aaltoska orkaniseeraa, a comedy, in 1949. \n\nThe Unknown Soldier, a film Laine directed in 1955 based on Väinö Linna's novel, was a big sensation in Finland.  There have later been two other film adaptations of the same novel but Laine's version remains the best known...", died:date('1989-11-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xJIWwkCqVuYRfX97kpjs44tpks0.jpg", url:"https://themoviedb.org/person/150977"}}, {tmdbId:"78185", properties:{bornIn:"Paris, France", imdbId:"0483738", born:date('1922-01-13'), name:"Albert Lamorisse", bio:"From Wikipedia, the free encyclopedia\n\nAlbert Lamorisse (13 January 1922 – 2 June 1970) was a French filmmaker, film producer, and writer, who is best known for his award winning short films which he began making in the late 1940s, and also for inventing the famous strategic board game Risk in 1957.  He was born in Paris, France...", died:date('1970-06-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/krhOEQjEneF7O8Hom719LBMN7em.jpg", url:"https://themoviedb.org/person/78185"}}, {tmdbId:"97205", properties:{bornIn:"Mie, Japan", imdbId:"0406728", born:date('1915-11-20'), name:"Kon Ichikawa", bio:"From Wikipedia, the free encyclopedia\n\nKon Ichikawa (November 20, 1915 – February 13, 2008) was a Japanese film director. \n\nDescription above from the Wikipedia article Kon Ichikawa, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2008-02-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9GGPmWKdBo0JCZYepj0NSZCuciU.jpg", url:"https://themoviedb.org/person/97205"}}, {tmdbId:"50577", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0659085", born:date('1914-04-21'), name:" Norman Panama", bio:"From Wikipedia, the free encyclopedia\n\nNorman Panama (April 21, 1914 – January 13, 2003) was an American screenwriter and film director born in Chicago, Illinois.  He collaborated with a former school friend, Melvin Frank, to form a writing partnership which endured for three decades.  He also wrote gags for comedians such as Bob Hope's radio program and for Groucho Marx...", died:date('2003-01-13'), url:"https://themoviedb.org/person/50577"}}, {tmdbId:"53767", properties:{bornIn:"Paris, France", imdbId:"0671862", born:date('1928-01-26'), name:"Roger Vadim", bio:"Roger Vadim, born Roger Vladimir Plémiannikov,  was a French journalist, author, actor, screenwriter, director, and producer who launched Brigitte Bardot's career in the film \"And God Created Woman\".  He was married five times, to Birgitte Bardot, Annette Stroyberg, Jane Fonda, Catherine Schneider and Marie-Christine Barrault...", died:date('2000-02-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4XSfnQquQ56Wn0dvlVC8m60lzNA.jpg", url:"https://themoviedb.org/person/53767"}}, {tmdbId:"41704", properties:{bornIn:"San Diego, California, USA", imdbId:"0689565", born:date('1908-06-10'), name:"Jack Pollexfen", bio:"From Wikipedia, the free encyclopedia\n\nJack Pollexfen (1908–2003) was an American writer and producer best known for his work in science fiction and monster movies of the 1950s with Aubrey Wisberg.  Before entering the film industry he worked as a journalist...", died:date('2003-11-23'), url:"https://themoviedb.org/person/41704"}}, {tmdbId:"14773", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0796923", born:date('1912-10-26'), name:"Don Siegel", bio:"Donald Siegel (October 26, 1912 - April 20, 1991) was an influential American film director and producer...", died:date('1991-04-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wjhr8oJr3fVfOphN7lIlr0R6nF9.jpg", url:"https://themoviedb.org/person/14773"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"8626", properties:{bornIn:"Berlin, Germany", imdbId:"0652631", born:date('1919-06-09'), name:"Gerd Oswald", bio:"From Wikipedia, the free encyclopedia. \n\nGerd Oswald (June 9, 1919 - May 22, 1989) was a director of American films and television.  The son of German film director Richard Oswald, he was born in Berlin and died in Los Angeles, California. \n\nOswald's film credits include A Kiss Before Dying (1956), Brainwashed (1960), and Bunny O'Hare (1971).  His television credits include Perry Mason, Bonanza, The Outer Limits, The Fugitive, Star Trek, Gentle Ben, It Takes a Thief, and The Twilight Zone...", died:date('1989-05-22'), url:"https://themoviedb.org/person/8626"}}, {tmdbId:"10346", properties:{bornIn:"Bromont-Lamothe, Puy-de-Dôme, Auvergne, France", imdbId:"0000975", born:date('1901-09-25'), name:"Robert Bresson", bio:"Robert Bresson (25 September 1901 – 18 December 1999) was a French film director known for his spiritual, ascetic style...", died:date('1999-12-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vgQWc59n5tnlHMD1FdKOoRe2iP7.jpg", url:"https://themoviedb.org/person/10346"}}, {tmdbId:"39996", properties:{bornIn:"Philadelphia, Pennsylvania, USA", imdbId:"0001486", born:date('1924-06-25'), name:"Sidney Lumet", bio:"Sidney Lumet (June 25, 1924 – April 9, 2011) was an American director, producer and screenwriter with over 50 films to his name.  He was nominated for the Academy Award as Best Director for 12 Angry Men (1957), Dog Day Afternoon (1975), Network (1976) and The Verdict (1982).  He did not win an individual Academy Award, although he did receive an Academy Honorary Award and 14 of his films were nominated for various Oscars, such as Network, which was nominated for 10, winning 4...", died:date('2011-04-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/boygOB4WxxfvucKirmTK6KNiGRM.jpg", url:"https://themoviedb.org/person/39996"}}, {tmdbId:"39743", properties:{bornIn:"Trenton, New Jersey, USA", imdbId:"0505610", born:date('1909-06-05'), name:"Henry Levin", bio:"Henry Levin (5 June 1909 - 1 May 1980) began as a stage actor and director but was most notable as an American film director of over fifty feature films.  He broke into film in 1943 as a dialogue director for the films Dangerous Blondes and Appointment in Berlin for Columbia Pictures.  He then was contracted to Columbia Pictures as a director along with several other \"potentials\" who began as dialogue directors: Fred Sears, William Castle, Mel Ferrer and Robert Gordon...", died:date('1980-05-01'), url:"https://themoviedb.org/person/39743"}}, {tmdbId:"101225", properties:{bornIn:"Kenosha, Wisconsin, USA", imdbId:"0330026", born:date('1922-09-24'), name:"Bert I. Gordon", bio:"From Wikipedia, the free encyclopedia. \n\nBert I.  Gordon (born Bert Ira Gordon, September 24, 1922 in Kenosha, WI) is an American film director most famous for such science fiction and horror B-movies as The Amazing Colossal Man and Village of the Giants. \n\nMost of Gordon's work is in the idiom of giant monster films, for which he used rear-projection to create the special effects.  His nickname \"Mister B. I. G...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8byrlHGMgdg4YFz5hUk0Vbfy1pa.jpg", url:"https://themoviedb.org/person/101225"}}, {tmdbId:"29662", properties:{bornIn:"Maida Vale, London, England", imdbId:"0279807", born:date('1904-02-23'), name:"Terence Fisher", bio:"From Wikipedia, the free encyclopedia.   Terence Fisher (23 February 1904 – 18 June 1980) was a film director who worked for Hammer Films.  He was born in Maida Vale, a district of London, England. \n\nFisher was one of the most prominent horror directors of the second half of the 20th century.  He was the first to bring gothic horror alive in full colour, and the sexual overtones and explicit horror in his films, while mild by modern standards, were unprecedented in his day...", died:date('1980-06-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ey0BKlj59dZw0rtZmbxY5oyi1Hi.jpg", url:"https://themoviedb.org/person/29662"}}, {tmdbId:"44623", properties:{bornIn:"Manhattan, New York City, New York, USA", imdbId:"0313434", born:date('1920-02-08'), name:" George W. George", bio:"​From Wikipedia, the free encyclopedia.   \n\nGeorge W.  George (born George Warren Goldberg, February 8, 1920 – November 7, 2007) was an American theater, Broadway and film producer.  His credits included the 1981 film My Dinner With Andre and several hit Broadway productions. \n\nDescription above from the Wikipedia article  George W.  George, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2007-11-07'), url:"https://themoviedb.org/person/44623"}}, {tmdbId:"108764", properties:{bornIn:"Tiflis, Russian Empire [now Tbilisi, Republic of Georgia]", imdbId:"0435563", born:date('1903-12-28'), name:"Mikhail Kalatozov", bio:"Mikhail Konstantinovich Kalatozov (28 December 1903 – 27 March 1973), born Mikheil Kalatozishvili, was a Soviet film director of Georgian origin who contributed to both Georgian and Russian cinema.  He is most well known for his films The Cranes Are Flying and Soy Cuba.  In 1969, he received the People's Artist of the USSR accolade.  His film The Cranes Are Flying won the Palme d'Or at the 1958 Cannes Film Festival...", died:date('1973-03-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1RTm958MhWTNjD8CHFx7Z8u2gU7.jpg", url:"https://themoviedb.org/person/108764"}}, {tmdbId:"3376", properties:{bornIn:"Savannah, Georgia, USA", imdbId:"0437900", born:date('1918-12-18'), name:"Hal Kanter", bio:"From Wikipedia, the free encyclopedia.   Hal Kanter (born December 18, 1918) is a veteran writer, producer and director, principally for comedy actors such as Bob Hope, Jerry Lewis, and Elvis Presley (in Loving You and Blue Hawaii), for both feature films and television.  Kanter helped Tennessee Williams turn the play by Williams into the film version of The Rose Tattoo.  Since 1991, he has been regularly credited as a writer for the Academy Award broadcasts...", died:date('2011-11-06'), url:"https://themoviedb.org/person/3376"}}, {tmdbId:"39853", properties:{bornIn:"London, England, UK", imdbId:"0346436", born:date('1911-12-11'), name:"Val Guest", bio:"​From Wikipedia, the free encyclopedia.   \n\nVal Guest (11 December 1911 – 10 May 2006) was a British film director, best known for his science-fiction films for Hammer Film Productions in the 1950s, but who also enjoyed a long, varied and active career in the film industry from the early 1930s up until the early 1980s. \n\nDescription above from the Wikipedia article Val Guest  licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2006-05-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gL8FZhBCVl8a9V7JGHI6DvwIGKU.jpg", url:"https://themoviedb.org/person/39853"}}, {tmdbId:"8501", properties:{bornIn:"Columbus, Georgia", imdbId:"0425913", born:date('1897-12-05'), name:"Nunnally Johnson", bio:"​From Wikipedia, the free encyclopedia.   \n\nNunnally Hunter Johnson (December 5, 1897 – March 25, 1977) was an American filmmaker who wrote, produced, and directed motion pictures. \n\nJohnson was born in Columbus, Georgia.  He began his career as a journalist, writing for the Columbus Enquirer Sun, the Savannah Press, the Brooklyn Daily Eagle, and the New York Herald Tribune.  He also wrote short stories and a collection of these, There Ought To Be a Law, was published in 1930...", died:date('1977-03-27'), url:"https://themoviedb.org/person/8501"}}, {tmdbId:"44878", properties:{bornIn:"Gurahumora, Bukovina, Austria-Hungary (now Gura Humorului, Romania)", imdbId:"0432846", born:date('1907-09-01'), name:"Nathan Juran", bio:"​From Wikipedia, the free encyclopedia.   \n\nNaftuli \"Nathan\" Hertz Juran (September 1, 1907 - October 23, 2002) was an American film art director and film director who is most noted for winning the Academy Award for Best Art Direction for How Green Was My Valley and for directing science fiction and fantasy films such as Attack of the 50 Foot Woman.  He was also the brother of quality guru Joseph M.  Juran...", died:date('2002-10-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hwvJYzy9o87gDKeL430BwStUPWI.jpg", url:"https://themoviedb.org/person/44878"}}, {tmdbId:"87521", properties:{bornIn:"Philadelphia, Pennsylvania, USA", imdbId:"0196536", born:date('1914-03-07'), name:"Morton DaCosta", bio:"From Wikipedia, the free encyclopedia.   Morton DaCosta (March 7, 1914 - January 26, 1989) was an American theatre and film director, film producer, writer, and actor. \n\nDescription above from the Wikipedia article Morton DaCosta, licensed under CC-BY-SA,full list of contributors on Wikipedia...", died:date('1989-01-29'), url:"https://themoviedb.org/person/87521"}}, {tmdbId:"18907", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"0703689", born:date('1920-11-12'), name:"Richard Quine", bio:"From Wikipedia, the free encyclopedia\n\nRichard Quine (November 12, 1920 – June 10, 1989) was an American stage, film, and radio actor and film director. \n\nQuine was born in Detroit.  He made his Broadway debut in the Jerome Kern/Oscar Hammerstein II musical Very Warm for May in 1939 and appeared in My Sister Eileen the following year...", died:date('1989-06-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6GgNKUTs8ElPPqi3FC7Jg3GUQd8.jpg", url:"https://themoviedb.org/person/18907"}}, {tmdbId:"56141", properties:{bornIn:"Berlin, Germany", imdbId:"0947105", born:date('1926-02-14'), name:"Irvin S. Yeaworth Jr.", bio:"From Wikipedia, the free encyclopedia. \n\nIrvin Shortess \"Shorty\" Yeaworth, Jr.  (February 14, 1926 in Berlin, Germany – July 19, 2004, in Amman, Jordan) was an American film director, producer, screenwriter and theme park builder.  He began his career singing at age 10 at KDKA, the world's first radio station in Pittsburgh, Pennsylvania.  He later became a radio producer.  He directed more than 400 films for motivational, educational, and religious purposes...", died:date('2004-07-19'), url:"https://themoviedb.org/person/56141"}}, {tmdbId:"1023352", properties:{imdbId:"0234893", born:date('1927-02-16'), name:" Russell S. Doughten Jr.", bio:"Russell S.  Doughten Jr.  (February 16, 1927 – August 19, 2013) was an American film-maker and producer of numerous short and feature-length Christian films.  His film work is credited under numerous variations of his name: with or without the \"Jr. \" suffix or middle initial, and sometimes using the informal \"Russ\" instead of \"Russell\".  Nearly all of his Christian films were shot in various locales in his home state of Iowa...", died:date('2013-08-19'), url:"https://themoviedb.org/person/1023352"}}, {tmdbId:"4081", properties:{bornIn:"Brooklyn, New York, United States", imdbId:"0006452", born:date('1913-09-29'), name:"Stanley Kramer", bio:"From Wikipedia, the free encyclopedia. \n\nStanley Earl Kramer (September 29, 1913 – February 19, 2001) was an American film director and producer responsible for some of Hollywood's most famous \"message\" movies.  His notable films include The Defiant Ones (1958), On the Beach (1959), Inherit the Wind (1960), Judgment at Nuremberg (1961), It's a Mad, Mad, Mad, Mad World (1963), Ship of Fools (1965) and Guess Who's Coming to Dinner (1967).  His work was recognized with the Irving G...", died:date('2001-02-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fNbpcXaHD0xTrekOxPDvTBMdmin.jpg", url:"https://themoviedb.org/person/4081"}}, {tmdbId:"12011", properties:{bornIn:"New York City, New York, USA", imdbId:"0145336", born:date('1914-04-25'), name:"William Castle", bio:"William Castle  (April 24, 1914 – May 31, 1977) was an American film director, producer, screenwriter, and actor.  Castle was known for directing films with many gimmicks which were ambitiously promoted, despite being reasonably low budget B-movies.  Castle began directing films in the early 1940s, and later television, before moving on to the \"gimmick films\"...", died:date('1977-06-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4oQICnob3SUnWlNcsc4M9SNY0LN.jpg", url:"https://themoviedb.org/person/12011"}}, {tmdbId:"16745", properties:{bornIn:"New York City, New York, USA", imdbId:"0789520", born:date('1917-04-01'), name:"Melville Shavelson", bio:"From Wikipedia, the free encyclopedia\n\nMelville Shavelson (April 1, 1917 – August 8, 2007) was an American film director, producer, screenwriter, and author.  He was President of the Writers Guild of America, West (WGAw) from 1969 to 1971, 1979 to 1981, and 1985 to 1987.  He came to Hollywood in 1938 as one of comedian Bob Hope's joke writers, a job he held for the next five years...", died:date('2007-08-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fRUXwYduZGGfrsOhypzhUbcUfWK.jpg", url:"https://themoviedb.org/person/16745"}}, {tmdbId:"19708", properties:{bornIn:"Paris, France", imdbId:"0051649", born:date('1924-05-07'), name:"Albert Band", bio:"​From Wikipedia, the free encyclopedia.   \n\nAlbert Band (May 7, 1924 – June 14, 2002), was an American film director and film producer.  He was the son of artist Max Band, father of filmmaker Charles Band and of film composer Richard Band.  He is the grandfather of Alex Band and Taryn Band. \n\nDescription above from the Wikipedia article Albert Band, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2002-06-14'), url:"https://themoviedb.org/person/19708"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"18854", properties:{bornIn:"New York City, New York, USA", imdbId:"0728688", born:date('1914-03-02'), name:"Martin Ritt", bio:"From Wikipedia, the free encyclopedia. \n\nMartin Ritt (March 2, 1914 – December 8, 1990) was an American director, actor, and playwright who worked in both film and theater.  He was born in New York City...", died:date('1990-12-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2lz95mrGjNgpK6Tzu1B99g7pQx5.jpg", url:"https://themoviedb.org/person/18854"}}, {tmdbId:"587603", properties:{bornIn:"Shizuoka, Japan", imdbId:"0455839", born:date('1912-12-03'), name:"Keisuke Kinoshita", bio:"Keisuke Kinoshita (木下 惠介, Kinoshita Keisuke, December 5, 1912 – December 30, 1998) was a Japanese film director. \n\nHugely popular in his home country of Japan, Keisuke Kinoshita worked tirelessly as a director for nearly half a century, making lyrical, sentimental films that often center on the inherent goodness of people, especially in times of distress...", died:date('1998-12-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rBvoGMzVBciqvfheRXcHKpdBRRL.jpg", url:"https://themoviedb.org/person/587603"}}, {tmdbId:"2801", properties:{bornIn:"Suwałki, Poland", imdbId:"0906667", born:date('1926-03-06'), name:"Andrzej Wajda", bio:"From Wikipedia, the free encyclopedia. \n\nAndrzej Wajda (born 6 March 1926) is a Polish film director.  Recipient of an honorary Oscar, he is possibly the most prominent member of the unofficial \"Polish Film School\" (active circa 1955 to 1963).  He is known especially for a trilogy of war films: A Generation (1954), Kanał (1956) and Ashes and Diamonds (1958)...", died:date('2016-10-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/okI5WEqZIwFnnUmox1XgSlHDRNn.jpg", url:"https://themoviedb.org/person/2801"}}, {tmdbId:"73150", properties:{bornIn:"Philadelphia, Pennsylvania", imdbId:"0920862", born:date('1925-09-20'), name:"Paul Wendkos", bio:"From Wikipedia, the free encyclopedia. \n\nPaul Wendkos (September 20, 1922; Philadelphia, Pennsylvania – November 12, 2009; Malibu, California) was an American television and film director. \n\nFollowing wartime service in the US Navy and attending Columbia University on the GI Bill Wendkos made his first feature, a documentary on a school for the blind called Dark Interlude in 1953. \n\nWendkos's first feature film was The Burglar ...", died:date('2009-11-12'), url:"https://themoviedb.org/person/73150"}}, {tmdbId:"76978", properties:{bornIn:"Otaru, Hokkaidō, Japan", imdbId:"0462030", born:date('1916-02-14'), name:"Masaki Kobayashi", bio:"From Wikipedia, the free encyclopedia. \n\nMasaki Kobayashi (February 14, 1916–October 4, 1996) was a Japanese director. \n\nAmong his films is Kwaidan (1965), a collection of four ghost stories drawn from the book by Lafcadio Hearn, each of which has a surprise ending. \n\nKobayashi also directed The Human Condition, a trilogy on the effects of World War II on a Japanese pacifist and socialist.  The total length of the films is over 9 hours...", died:date('1996-10-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5epZ39mf1Ii7xOjqYx2YYq39y5X.jpg", url:"https://themoviedb.org/person/76978"}}, {tmdbId:"1927", properties:{bornIn:"Tulsa, Oklahoma, USA", imdbId:"0001175", born:date('1922-07-26'), name:"Blake Edwards", bio:"Blake Edwards was an American film director, screenwriter and producer. \n\nEdwards' career began in the 1940s as an actor but he soon turned to writing radio scripts at Columbia Pictures.  He used his writing skills to begin producing and directing, with some of his best films including: Experiment in Terror, The Great Race, and the hugely successful Pink Panther film series with the British comedian Peter Sellers...", died:date('2010-12-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/f8Gw9Y8dtZW66ZrFu9jW4KlpSs6.jpg", url:"https://themoviedb.org/person/1927"}}, {tmdbId:"14567", properties:{bornIn:"Philadelphia, Pennsylvania, USA ", imdbId:"0644048", born:date('1906-07-18'), name:"Clifford Odets", died:date('1963-08-18'), url:"https://themoviedb.org/person/14567"}}, {tmdbId:"37302", properties:{bornIn:"Fougères, France", imdbId:"0290802", born:date('1912-04-12'), name:"Georges Franju", bio:"From Wikipedia, the free encyclopedia.  \n\nGeorges Franju was a French filmmaker.  \n\nHe was born in Fougères, Ille-et-Vilaine.  Before working in French cinema, Franju had several different jobs.  Franju was also briefly in the military in Algeria and was discharged in 1932.  On his return, Franju studied to become a set designer and later created backdrops for music halls including Casino de Paris and the Folles Bergère...", died:date('1987-11-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hk68FxLtf2w2engFzH8dLVh89Rr.jpg", url:"https://themoviedb.org/person/37302"}}, {tmdbId:"89157", properties:{imdbId:"0468609", born:date('1929-08-02'), name:"Bernard L. Kowalski", died:date('2007-10-26'), url:"https://themoviedb.org/person/89157"}}, {tmdbId:"15189", properties:{bornIn:"Ferrara, Emilia-Romagna, Italy", imdbId:"0000774", born:date('1912-09-29'), name:"Michelangelo Antonioni", bio:"Michelangelo Antonioni, Cavaliere di Gran Croce OMRI (29 September 1912 – 30 July 2007) was an Italian modernist film director, screenwriter, editor, and short story writer.   Best known for his \"trilogy on modernity and its discontents\" — L'Avventura (1960), La Notte (1961), and L'Eclisse (1962), as well as the English-language Blowup (1966), Antonioni \"redefined the concept of narrative cinema\" and challenged traditional approaches to storytelling, realism, drama, and the world at large...", died:date('2007-07-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aGrzCeNCEZEI1DhLS8HjWDKNude.jpg", url:"https://themoviedb.org/person/15189"}}, {tmdbId:"102429", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"0000339", born:date('1926-04-05'), name:"Roger Corman", bio:"Roger William Corman is an American film producer, director and actor.  He has mostly worked on low-budget films.  Some of Corman's work has an established critical reputation, such as his cycle of films derived from the tales of Edgar Allan Poe, and he has won an Honorary Academy Award for his body of work.  Corman is also an occasional actor, taking minor roles in such films as The Silence of the Lambs, The Godfather Part II, Apollo 13 and Philadelphia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kWvtdBp4AVSOwluWwZ1WhsKlAfk.jpg", url:"https://themoviedb.org/person/102429"}}, {tmdbId:"52140", properties:{imdbId:"0341458", born:date('1930-09-23'), name:" Charles B. Griffith", died:date('2007-09-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tLDw8ioMJysFcl5jgSW2u0u95yQ.jpg", url:"https://themoviedb.org/person/52140"}}, {tmdbId:"25826", properties:{bornIn:"Sanremo, Liguria, Italy", imdbId:"0000878", born:date('1914-07-31'), name:"Mario Bava", bio:"​From Wikipedia, the free encyclopedia.   \n\nMario Bava (July 31, 1914 – April 25, 1980) was an Italian director, screenwriter, and cinematographer remembered as one of the greatest names from the \"golden age\" of Italian horror films. \n\nDescription above from the Wikipedia article  Mario Bava, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1980-04-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7IAC3ab2HeveW537a3bymiDrVce.jpg", url:"https://themoviedb.org/person/25826"}}, {tmdbId:"29715", properties:{bornIn:"Minneapolis, Minnesota, USA", imdbId:"0842582", born:date('1919-07-27'), name:"David Swift", bio:"From Wikipedia, the free encyclopedia\n\nDavid \"Dave\" Swift (July 27, 1919 – December 31, 2001) was an American screenwriter, animator, director, and producer.  He is best known for writing the screenplay for the 1967 film How to Succeed in Business Without Really Trying.  Swift also worked as an animator and filmmaker at The Walt Disney Studios where he adapted the story of Pollyanna for the screen and wrote and directed The Parent Trap (1961)...", died:date('2001-12-31'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pJj8kzfOriano9MziBDLaWuGjZB.jpg", url:"https://themoviedb.org/person/29715"}}, {tmdbId:"72709", properties:{bornIn:"Ostrava, Czechoslovakia", imdbId:"0718554", born:date('1926-07-21'), name:"Karel Reisz", bio:"From Wikipedia, the free encyclopedia. \n\nKarel Reisz (21 July 1926 – 25 November 2002) was a Czech-born British filmmaker who was active in post–war Britain, and one of the pioneers of the new realist strain in 1950s and 1960s British cinema. \n\nDescription above from the Wikipedia article Karel Reisz, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2002-11-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7bjqPQhwG10zANg8YKtQSlY1jNy.jpg", url:"https://themoviedb.org/person/72709"}}, {tmdbId:"143635", properties:{name:" Cyril Frankel", url:"https://themoviedb.org/person/143635"}}, {tmdbId:"35318", properties:{bornIn:"Beverley, Yorkshire, England, UK", imdbId:"0002175", born:date('1914-08-10'), name:"Ken Annakin", bio:"From Wikipedia, the free encyclopedia. \n\nKenneth Cooper Annakin, OBE (10 August 1914 – 22 April 2009) was an English film director...", died:date('2009-04-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5KKdodVlzI0aXmhw54i1Nsc37Z7.jpg", url:"https://themoviedb.org/person/35318"}}, {tmdbId:"70448", properties:{bornIn:"Berlin - Germany", imdbId:"0727211", born:date('1920-03-16'), name:"Wolf Rilla", bio:"From Wikipedia, the free encyclopedia\n\nWolf Rilla (1920–2005) was a film director and writer of German background, although he worked mainly in English. \n\nHe worked on both versions of Village of the Damned, in the first as director and in the second as a writer.  he wrote many influential books for students.  the Writer and the Screen: On Writing for Film and Television and the A to Z of Movie Making...", died:date('2005-10-19'), url:"https://themoviedb.org/person/70448"}}, {tmdbId:"5970", properties:{bornIn:"Bologna, Emilia-Romagna, Italy", imdbId:"0001596", born:date('1922-03-05'), name:"Pier Paolo Pasolini", bio:"Pier Paolo Pasolini (March 5, 1922 – November 2, 1975) was an Italian film director, poet, writer, and intellectual.  Pasolini distinguished himself as a poet, journalist, philosopher, linguist, novelist, playwright, filmmaker, newspaper and magazine columnist, actor, painter and political figure.  He demonstrated a unique and extraordinary cultural versatility, becoming a highly controversial figure in the process...", died:date('1975-11-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1qFLfYpTvBXqeMuVYfZzDgtc1zx.jpg", url:"https://themoviedb.org/person/5970"}}, {tmdbId:"76882", properties:{bornIn:"Scranton, Pennsylvania, USA", imdbId:"0256831", born:date('1914-11-10'), name:"Cy Endfield", bio:"From Wikipedia, the free encyclopedia\n\nCyril Raker Endfield (November 10, 1914 – April 16, 1995) was an American screenwriter, film director, theatre director, author, magician and inventor, based in Britain from 1953...", died:date('1995-04-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jrYeWyXZPgwMHTfYKMc8A6VoREC.jpg", url:"https://themoviedb.org/person/76882"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"29504", properties:{bornIn:"Westcliff-on-Sea, Essex, England", imdbId:"0213136", born:date('1911-01-01'), name:"Basil Dearden", bio:"Basil Dearden (born Basil Clive Dear; 1 January 1911 – 23 March 1971) was an English film director...", died:date('1971-03-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gFhx34eqzkRbdAdyq8shK1X5sE5.jpg", url:"https://themoviedb.org/person/29504"}}, {tmdbId:"13776", properties:{bornIn:"New York City, New York, USA", imdbId:"0001239", born:date('1930-02-19'), name:"John Frankenheimer", bio:"John Michael Frankenheimer (February 19, 1930 – July 6, 2002) was an American film and television director known for social dramas.  He won four consecutive Emmy Awards in the 1990s for the television movies Against the Wall, The Burning Season, Andersonville and George Wallace, which also received a Golden Globe award.  He was considered one of the last remaining directors who insisted on having complete control over all elements of production, making his style unique in Hollywood...", died:date('2002-07-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1OItNQH1RaKV7nPluKTw2TwR9Rh.jpg", url:"https://themoviedb.org/person/13776"}}, {tmdbId:"79294", properties:{bornIn:"Fort Collins, Colorado, USA", imdbId:"0367547", born:date('1924-06-03'), name:"Herk Harvey", bio:"​From Wikipedia, the free encyclopedia.   \n\nHarold Arnold \"Herk\" Harvey (June 3, 1924 – April 3, 1996) was an American film director, actor, and film producer. \n\nHarvey is best known for his sole feature film, Carnival of Souls, a low budget 1962 horror film starring Candace Hilligoss.  It was produced and directed by Harvey for an estimated $33,000.  Harvey had witnessed the recent success of Elmer Rhoden Jr...", died:date('1996-04-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/paJTVNJK99AH5NpwGus5hnBzDj9.jpg", url:"https://themoviedb.org/person/79294"}}, {tmdbId:"94069", properties:{bornIn:"Budapest - Hungary", imdbId:"0782804", born:date('1899-02-25'), name:"Steve Sekely", died:date('1979-03-09'), url:"https://themoviedb.org/person/94069"}}, {tmdbId:"5629", properties:{bornIn:"Islington, London, England, UK", imdbId:"0005711", born:date('1917-12-22'), name:" Freddie Francis", bio:"Frederick William (Freddie) Francis BSC (22 December 1917 – 17 March 2007) was an English cinematographer and film director. \n\nHe achieved his greatest successes as a cinematographer, including winning two Academy Awards, for Sons and Lovers (1960) and Glory (1989).  As a director, he has cult status on account of his association with the British production companies Amicus and Hammer in the 1960s and 1970s...", died:date('2007-03-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d942c3b11cJJQF0alz3CNoG2GQs.jpg", url:"https://themoviedb.org/person/5629"}}, {tmdbId:"1638759", properties:{name:" Eduard Abalov", url:"https://themoviedb.org/person/1638759"}}, {tmdbId:"9956", properties:{bornIn:"Neuilly-sur-Seine, Hauts-de-Seine, Île-de-France, France", imdbId:"0003408", born:date('1921-07-29'), name:"Chris Marker", bio:"Chris Marker (born 29 July 1921) was a French writer, photographer, film director, multimedia artist and documentary maker. \n\nHis best known films are La jetée (1962), A Grin Without a Cat (1977), Sans Soleil (1983) and AK (1985), a documentary on the Japanese filmmaker Akira Kurosawa...", died:date('2012-07-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vGF16epucEwlZfnsVdSyI2xtrlz.jpg", url:"https://themoviedb.org/person/9956"}}, {tmdbId:"8502", properties:{bornIn:"Wahoo, Nebraska, USA", imdbId:"0953123", born:date('1902-09-05'), name:" Darryl F. Zanuck", died:date('1979-12-22'), url:"https://themoviedb.org/person/8502"}}, {tmdbId:"29664", properties:{bornIn:"Wandsworth, London, England, UK", imdbId:"0140257", born:date('1927-12-21'), name:"Michael Carreras", died:date('1994-04-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e0MawnOmsD0PcYeceopaxklz7yK.jpg", url:"https://themoviedb.org/person/29664"}}, {tmdbId:"16888", properties:{bornIn:"New York City, New York", imdbId:"0625680", born:date('1916-08-12'), name:"Ralph Nelson", bio:"From Wikipedia, the free encyclopedia. \n\nElseen Leo Ralph Nelson (August 12, 1916 – December 21, 1987) was an American movie and television director, producer, writer, and actor. \n\nDescription above from the Wikipedia article Ralph Nelson, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1987-12-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wRdZgmwmRkUH0GbfAZTQl9RRXdm.jpg", url:"https://themoviedb.org/person/16888"}}, {tmdbId:"8482", properties:{bornIn:"The Bronx, New York City, New York, ", imdbId:"0612322", born:date('1925-08-23'), name:"Robert Mulligan", bio:"From Wikipedia, the free encyclopedia\n\nRobert Mulligan (August 23, 1925 – December 20, 2008) was an American film and television director. \n\nDescription above from the Wikipedia article Robert Mulligan, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2008-12-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/m9iX4S0WHf43BIAxIu6hp4R5Cp9.jpg", url:"https://themoviedb.org/person/8482"}}, {tmdbId:"114433", properties:{imdbId:"0127168", born:date('1902-08-07'), name:"Fritz Böttger", died:date('1981-11-01'), url:"https://themoviedb.org/person/114433"}}, {tmdbId:"95526", properties:{bornIn:"New York, USA", imdbId:"0038906", born:date('1921-08-08'), name:"William Asher", bio:"​From Wikipedia, the free encyclopedia.   \n\nWilliam Asher (born August 8, 1921) is an American television and film producer, film director, and screenwriter.  He was one of the most prolific early directors in the budding television industry, producing or directing over two dozen of the leading television series...", died:date('2012-07-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/r7ykHmmpE8vJ1V9OQOUQ5h89eLt.jpg", url:"https://themoviedb.org/person/95526"}}, {tmdbId:"19304", properties:{bornIn:"London, England, UK", imdbId:"0772259", born:date('1926-02-16'), name:"John Schlesinger", bio:"John Richard Schlesinger, CBE, was an English film and stage director, and actor.  He won an Academy Award for Best Director for Midnight Cowboy, and was nominated for two other films (Darling and Sunday Bloody Sunday). \n\nSchlesinger was born in London, into a middle class Jewish family.  His acting career began in the 1950s and consisted of supporting roles in British films and television productions...", died:date('2003-07-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pN9COwowU7v7dmslrPpQrjNRBBJ.jpg", url:"https://themoviedb.org/person/19304"}}, {tmdbId:"99916", properties:{bornIn:"Pittsburgh, Pennsylvania, USA", imdbId:"0504496", born:date('1929-06-15'), name:"Herschell Gordon Lewis", died:date('2016-09-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1uirIZta44WlWjVkq37jNhDE4rN.jpg", url:"https://themoviedb.org/person/99916"}}, {tmdbId:"105822", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0494903", born:date('1913-12-23'), name:"Anton Leader", died:date('1988-07-01'), url:"https://themoviedb.org/person/105822"}}, {tmdbId:"100890", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0506187", born:date('1922-07-02'), name:"Abe Levitow", bio:"​From Wikipedia, the free encyclopedia.   \n\nAbraham \"Abe\" Levitow (July 2, 1922 - May 8, 1975) was an American animator who worked at Warner Bros.  Cartoons, UPA and Metro-Goldwyn-Mayer (MGM). \n\nLevitow was born in Los Angeles, California.  He began working as an in-betweener at Warner Brothers Studios in 1940.  Levitow briefly left Warner Brothers when he was drafted during World War II, returning in 1945.  He first received animation credit in 1953 while working under the direction of Chuck Jones...", died:date('1975-05-08'), url:"https://themoviedb.org/person/100890"}}, {tmdbId:"89685", properties:{imdbId:"0548529", born:date('1921-03-27'), name:"Fletcher Markle", died:date('1991-05-23'), url:"https://themoviedb.org/person/89685"}}, {tmdbId:"39009", properties:{bornIn:"La Crosse, Wisconsin, USA", imdbId:"0521334", born:date('1909-01-14'), name:"Joseph Losey", bio:"From Wikipedia, the free encyclopedia\n\nJoseph Walton Losey (January 14, 1909, La Crosse, Wisconsin – June 22, 1984, London, England) was an American theater and film director.  After studying in Germany with Bertolt Brecht, Losey returned to the United States, eventually making his way to Hollywood. \n\nIn the 1950s Losey was blacklisted in the United States and moved to Europe, where he made the remainder of his films, mostly in the United Kingdom...", died:date('1984-06-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x5lqylB6kxPT0wfB4LMRmLSGcmA.jpg", url:"https://themoviedb.org/person/39009"}}, {tmdbId:"20921", properties:{bornIn:"Greenpoint, Brooklyn, New York City, New York, USA", imdbId:"0375494", born:date('1932-07-12'), name:" Monte Hellman", bio:"Monte Hellman (born July 12, 1932) ​is an American film director, producer, writer, and editor.  Hellman began his career as an editor's apprentice at ABC TV, and made his directorial debut with the horror film Beast from Haunted Cave (1959), produced by Roger Corman. \n\nHe would later gain critical recognition for the Westerns The Shooting and Ride in the Whirlwind (both 1966) starring Jack Nicholson, and the independent road movie Two-Lane Blacktop (1971) starring James Taylor and Dennis Wilson...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2EIGgmdiPMJf64qvM24Vuj0aBGs.jpg", url:"https://themoviedb.org/person/20921"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"13563", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"0422484", born:date('1926-07-21'), name:"Norman Jewison", bio:"From Wikipedia, the free encyclopedia\n\nNorman Frederick Jewison, CC, O. Ont (born 21 July 1926) is a Canadian film director, producer, actor and founder of the Canadian Film Centre.  Highlights of his directing career include In the Heat of the Night (1967), The Thomas Crown Affair (1968), Fiddler on the Roof (1971), Jesus Christ Superstar (1973), Moonstruck (1987), The Hurricane (1999) and The Statement (2003)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bpTJK9fbbyKHL5n1NpOM7A7ltE2.jpg", url:"https://themoviedb.org/person/13563"}}, {tmdbId:"82461", properties:{bornIn:"Nihonbashi, Tokyo, Japan", imdbId:"0840671", born:date('1923-05-24'), name:"Seijun Suzuki", bio:"Seijun Suzuki born Seitaro Suzuki (24 May 1923 – 13 February 2017) was a Japanese filmmaker, actor, and screenwriter.   His films are renowned by film enthusiasts worldwide for their jarring visual style, irreverent humour, nihilistic cool and entertainment-over-logic sensibility.  He made 40 predominately B-movies for the Nikkatsu Company between 1956 and 1967, working most prolifically in the yakuza genre...", died:date('2017-02-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sETA9BVSVcUP8BglwQGoFZQsEqb.jpg", url:"https://themoviedb.org/person/82461"}}, {tmdbId:"83360", properties:{bornIn:"Tokyo, Japan", imdbId:"0946638", born:date('1911-02-15'), name:"Kimiyoshi Yasuda", died:date('1983-07-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6qaVlK5rk0a3ZBQ1ovVPo1B1FA.jpg", url:"https://themoviedb.org/person/83360"}}, {tmdbId:"65843", properties:{bornIn:"Limassol, Cyprus", imdbId:"0128050", born:date('1922-06-11'), name:"Mihalis Kakogiannis", bio:"Mihalis Kakogiannis or Michael Cacoyannis (Greek: Μιχάλης Κακογιάννης, Michalis Kakogiannis; 11 June 1922 – 25 July 2011) was a Greek Cypriot filmmaker, best known for his 1964 film Zorba the Greek.  He directed the 1983 Broadway revival of the musical based on the film.  Much of his work was rooted in classical texts, especially those of the Greek tragedian Euripides.  He was nominated for an Academy Award five times, a record for any Cypriot film artist...", died:date('2011-07-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oq9sYdhZgSQGPyZ9j5wN2T36fMf.jpg", url:"https://themoviedb.org/person/65843"}}, {tmdbId:"86659", properties:{bornIn:"Hampstead, London, England", imdbId:"0322706", born:date('1913-10-28'), name:"Peter Glenville", bio:"From Wikipedia, the free encyclopedia. \n\nPeter Glenville (28 October 1913 – 3 June 1996), born Peter Patrick Brabazon Browne, was an English film and stage actor and director...", died:date('1996-06-03'), url:"https://themoviedb.org/person/86659"}}, {tmdbId:"544845", properties:{bornIn:"Vitória da Conquista, Bahia, Brazil", imdbId:"0733790", born:date('1939-03-14'), name:"Glauber Rocha", bio:"Glauber Rocha, motion-picture director who was a leading figure in Brazil’s Cinema Novo (“New Cinema”).  Rocha’s avant-garde films depict Brazil’s history and upheavals in its social and political scene in a stylized, often violent manner.  He began his career as a journalist and film critic, and his first short film, Pátio (1959), caught the attention of critics and prompted his rise to fame.  He studied Law...", died:date('1981-08-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nwVImGorDvvrcXCclOljal6CP6b.jpg", url:"https://themoviedb.org/person/544845"}}, {tmdbId:"1114891", properties:{imdbId:"0171747", name:"Bill Colleran", url:"https://themoviedb.org/person/1114891"}}, {tmdbId:"33727", properties:{bornIn:"Hiroshima, Japan", imdbId:"0793881", born:date('1912-04-22'), name:"Kaneto Shindô", bio:"Kaneto Shindo (新藤 兼人, Shindō Kaneto, April 22, 1912 – May 29, 2012) was a Japanese film director, screenwriter, film producer, and author.  He was married to actress Nobuko Otowa (1925–1994), who appeared in several of his films.  He directed 48 films and wrote scripts for 238.  His best known films as a director include Children of Hiroshima, The Naked Island, Onibaba, Kuroneko and A Last Note...", died:date('2012-05-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/slPRV7aV1R2W15HeVztiapjRdOH.jpg", url:"https://themoviedb.org/person/33727"}}, {tmdbId:"148601", properties:{bornIn:"Milwaukee, Wisconsin, USA", imdbId:"0918659", born:date('1922-05-13'), name:"Don Weis", bio:"From Wikipedia, the free encyclopedia. \n\nDon Weis (May 13, 1922 - July 26, 2000) was an American film and television director. \n\nWeis was born in Milwaukee, Wisconsin.  He graduated from the University of Southern California where he studied film.  During World War II, Weis served in the Air Force as a film technician.  After the war, he began working at MGM directing such films as Bannerline (1951), Just This Once (1952), You for Me (1952) and The Affairs of Dobie Gillis (1953)...", died:date('2000-07-26'), url:"https://themoviedb.org/person/148601"}}, {tmdbId:"24882", properties:{bornIn:"Pontchâteau, Loire-Atlantique, France", imdbId:"0218840", born:date('1931-06-05'), name:"Jacques Demy", bio:"From Wikipedia, the free encyclopedia\n\nJacques Demy was a French director and screenwriter.  He appeared in the wake of the French New Wave alongside contemporaries like Jean-Luc Godard and François Truffaut.  Demy's films are well known for their sumptuous look, drawing on Hollywood musicals, fairy tales, jazz, and opera.  His films are also distinguishable by their overlapping continuity (i. e...", died:date('1990-10-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e01xXR9nxtEupIfrWaEqiLBxiGE.jpg", url:"https://themoviedb.org/person/24882"}}, {tmdbId:"4385", properties:{bornIn:"Rome, Italy", imdbId:"0001466", born:date('1929-01-03'), name:"Sergio Leone", bio:"Sergio Leone (January 3, 1929 – April 30, 1989) was an Italian film director, producer and screenwriter most associated with the \"Spaghetti Western\" genre.  Leone's film-making style includes juxtaposing extreme close-up shots with lengthy long shots.  His movies include The Colossus of Rhodes, the Dollars Trilogy (A Fistful of Dollars; For a Few Dollars More; and The Good, the Bad and the Ugly), Once Upon a Time in the West; Duck, You Sucker!; and Once Upon a Time in America...", died:date('1989-04-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rwNuspKZpJnuypQQJsPoAAfLbPh.jpg", url:"https://themoviedb.org/person/4385"}}, {tmdbId:"144977", properties:{imdbId:"0736392", name:"Larry Roemer", url:"https://themoviedb.org/person/144977"}}, {tmdbId:"144778", properties:{bornIn:"Montreal, Quebec, Canada", imdbId:"0021975", born:date('1931-04-26'), name:"Paul Almond", died:date('2015-04-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xdLSNc1UmbIYOfSe2SCxV5VUePX.jpg", url:"https://themoviedb.org/person/144778"}}, {tmdbId:"96801", properties:{bornIn:"Chiyoda, Tokyo, Japan", imdbId:"0856267", born:date('1927-01-28'), name:"Hiroshi Teshigahara", bio:"From Wikipedia, the free encyclopedia. \n\nHiroshi Teshigahara (January 28, 1927 – April 14, 2001) was an avant-garde Japanese filmmaker. \n\nHe was born in Tokyo, son of Sofu Teshigahara, founder and grand master of the Sogetsu School of ikebana.  He graduated in 1950 from the Tokyo National University of Fine Arts and Music and began working in documentary film.  He directed his first feature film, Pitfall (1962), in collaboration with author Kōbō Abe and musician Tōru Takemitsu...", died:date('2001-04-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yz6G5YUkbq4NKw7sAjmo74JzuEb.jpg", url:"https://themoviedb.org/person/96801"}}, {tmdbId:"90694", properties:{bornIn:"Pisa, Italy", imdbId:"0690597", born:date('1919-11-19'), name:"Gillo Pontecorvo", bio:"​From Wikipedia, the free encyclopedia.   \n\nGillo Pontecorvo (19 November 1919 – 12 October 2006) was an Italian filmmaker.  He worked as a film director for more than a decade before his best known film La battaglia di Algeri (The Battle of Algiers, 1966) was released.  For this he was nominated for the Best Director Oscar in 1969 and won the Golden Lion at the Venice Film Festival in that year...", died:date('2006-10-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oMuhLYJd1HzdQE2KI8K4JjJvwhl.jpg", url:"https://themoviedb.org/person/90694"}}, {tmdbId:"70262", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0799033", born:date('1927-08-03'), name:"Elliot Silverstein", bio:"From Wikipedia, the free encyclopedia. \n\nElliot Silverstein, born in Boston, Massachusetts, USA, on August 3, 1927, is best known for being the director of the movie Cat Ballou...", url:"https://themoviedb.org/person/70262"}}, {tmdbId:"27436", properties:{bornIn:"Loutra-Iraias, Greece", imdbId:"0002020", born:date('1933-02-12'), name:"Costa-Gavras", bio:"​From Wikipedia, the free encyclopedia\n\nCosta-Gavras, (short for Constantinos Gavras) born 12 February 1933 is a Greek filmmaker, who lives and works in France, best known for films with overt political themes, most famously the fast-paced thriller, Z (1969).  Most of his movies were made in French; starting with Missing (1982), several were made in English. \n\nDescription above from the Wikipedia article Costa-Gavras, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bl1btgToPWi51bakxv2Gze8N4p3.jpg", url:"https://themoviedb.org/person/27436"}}, {tmdbId:"4590", properties:{bornIn:"Oakland, California, USA", imdbId:"0000540", born:date('1922-03-21'), name:"Russ Meyer", bio:"Russell Albion \"Russ\" Meyer was a U. S.  motion picture director, producer, screenwriter, cinematographer, editor, actor and photographer. \n\nMeyer is known primarily for writing and directing a series of successful low-budget sexploitation films that featured campy humor, sly satire and large breasted women...", died:date('2004-09-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zNVAAdgIk9q3SQadZuQKr6wHlXM.jpg", url:"https://themoviedb.org/person/4590"}}, {tmdbId:"85840", properties:{imdbId:"0706347", name:"Alan Rafkin", bio:"From Wikipedia, the free encyclopedia. \n\nAlan Rafkin (23 July 1928, New York City, New York – 6 August 2001, Los Angeles, California) was an American Emmy Award-winning director, producer, and actor for television. \n\nDescription above from the Wikipedia article Alan Rafkin, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/85840"}}, {tmdbId:"544700", properties:{bornIn:"Budapest, Austria-Hungary [now Hungary]", imdbId:"0434443", born:date('1918-04-01'), name:"Ján Kadár", died:date('1979-06-01'), url:"https://themoviedb.org/person/544700"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"1190421", properties:{bornIn:"Svobodny, Amur Governorate, Russian SFSR, USSR [now Amur Oblast, Russia]", imdbId:"0301145", born:date('1923-01-30'), name:"Leonid Gayday", bio:"Leonid I.  Gaidai (30 January 1923 – 19 November 1993) was one of the most popular Soviet comedy directors, enjoying immense popularity and broad public recognition in the former USSR and modern Russia.  His movies broke theatre attendance records and are still some of the top-selling DVDs in Russia...", died:date('1993-11-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cpOU6ajiRFPfqiYjbEdpBUDjg5Q.jpg", url:"https://themoviedb.org/person/1190421"}}, {tmdbId:"105866", properties:{bornIn:"Bobbio, Piacenza, Italia", imdbId:"0069166", born:date('1939-11-09'), name:"Marco Bellocchio", bio:"Marco Bellocchio (Italian: [ˈmarko belˈlɔkkjo]; born 9 November 1939) is an Italian film director, screenwriter, and actor. \n\nBorn in Bobbio, near Piacenza, Marco Bellocchio had a strict Catholic upbringing – his father was a lawyer, his mother a schoolteacher...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oWTqhEVf4iLLEf11JnBH2waIhRh.jpg", url:"https://themoviedb.org/person/105866"}}, {tmdbId:"51875", properties:{bornIn:"London, England, UK", imdbId:"0572132", born:date('1920-07-28'), name:"Andrew V. McLaglen", bio:"​From Wikipedia, the free encyclopedia.   \n\nAndrew Victor McLaglen (born 28 July 1920) is a British-American film and television director and former actor.  Andrew McLaglen was born in London, the son of British actor Victor McLaglen and Enid Lamont.  He was from a film family that included eight uncles and an aunt, and he grew up on movie sets with his parents as well as John Wayne and John Ford...", died:date('2014-08-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4Lxdxg5akHhsHoZToFe62L8RM9B.jpg", url:"https://themoviedb.org/person/51875"}}, {tmdbId:"15671", properties:{imdbId:"0168641", born:date('1914-12-23'), name:"Fred Coe", died:date('1979-04-29'), url:"https://themoviedb.org/person/15671"}}, {tmdbId:"33513", properties:{bornIn:"London, England, UK", imdbId:"0232795", born:date('1926-01-21'), name:"Clive Donner", bio:"Clive Stanley Donner was a British film director who was a defining part of the British New Wave, directing films such as The Caretaker, Nothing But the Best, Here We Go Round the Mulberry Bush and What's New Pussycat? He also directed television movies and commercials through the mid-1990s...", died:date('2010-09-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cf8F3UtYkIQE8nYQoLg53AQIoTi.jpg", url:"https://themoviedb.org/person/33513"}}, {tmdbId:"94988", properties:{imdbId:"0848234", born:date('1892-12-03'), name:" Richard Talmadge", bio:"From Wikipedia\n\nRichard Talmadge (Sylvester Alphonse Metz, Camburg, Germany, December 3, 1892 – January 25, 1981) was a German-born American actor, stuntman and film director.  Alberta Vaughn and Richard Talmadge share a cigar in The Live Wire (1935) When he arrived in Hollywood in 1910, he began his career as a stuntman for Douglas Fairbanks, before becoming an actor himself.  His films include American Manners, Dancing Dynamite, Speed Madness, and the Pirate Treasure series...", died:date('1981-01-25'), url:"https://themoviedb.org/person/94988"}}, {tmdbId:"27728", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0554169", born:date('1915-01-16'), name:"Leslie H. Martinson", bio:"​From Wikipedia, the free encyclopedia.   \n\nLeslie \"Les\" H.  Martinson (born January 16, 1915) is an American television and film director.  He is married to television host and writer Connie Martinson. \n\nDescription above from the Wikipedia article Leslie H.  Martinson, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2016-09-03'), url:"https://themoviedb.org/person/27728"}}, {tmdbId:"6778", properties:{bornIn:"London, England, UK", imdbId:"0347086", born:date('1925-11-11'), name:"John Guillermin", bio:"From Wikipedia, the free encyclopedia.   John Guillermin (born 11 November 1925) is a British film director, writer, and producer who was most active in big budget, action adventure movies throughout his lengthy career.  He was born in London and attended Cambridge University...", died:date('2015-09-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3MR0AOdquJhgXHRvkew5wbfgYAZ.jpg", url:"https://themoviedb.org/person/6778"}}, {tmdbId:"85309", properties:{bornIn:"Yonago, Tottori Prefecture, Japan", imdbId:"0645477", born:date('1923-02-17'), name:"Kihachi Okamoto", bio:"From Wikipedia, the free encyclopedia\n\nKihachi Okamoto (岡本 喜八 Okamoto Kihachi) was a Japanese film director who worked in several different genres, most memorably in action genres such as jidaigeki and war films...", died:date('2005-02-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yYPY0Rzdc8SOeDs7aFxYQ06mcc8.jpg", url:"https://themoviedb.org/person/85309"}}, {tmdbId:"100888", properties:{bornIn:"Spokane, Washington, USA", imdbId:"0005062", born:date('1912-09-21'), name:"Chuck Jones", bio:"Charles Martin \"Chuck\" Jones (September 21, 1912 – February 22, 2002) was an American animator, cartoon artist, screenwriter, producer, and director of animated films, most memorably of Looney Tunes and Merrie Melodies shorts for the Warner Bros.  Cartoons studio.  He directed many of the classic short animated cartoons starring Bugs Bunny, Daffy Duck, the Road Runner and Wile E.  Coyote, Sylvester, Pepé Le Pew and a slew of other Warner characters...", died:date('2002-02-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6goktoglUBWZIZzaCJ3UeeO42CM.jpg", url:"https://themoviedb.org/person/100888"}}, {tmdbId:"113285", properties:{bornIn:"Arkansas, USA", imdbId:"0913326", born:date('1915-03-17'), name:" Ben Washam", died:date('1984-03-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7qyzNgVAcuzgtOjqYffkGp7YzpO.jpg", url:"https://themoviedb.org/person/113285"}}, {tmdbId:"83413", properties:{bornIn:"Newark, New Jersey, USA", imdbId:"0865709", born:date('1919-11-25'), name:"Norman Tokar", bio:"From Wikipedia, the free encyclopedia.   Norman Tokar (November 25, 1919 in Newark, New Jersey - April 6, 1979 in Hollywood) was a prolific director (and occasionally writer and producer) of serial television and feature films, who directed many of the early episodes of Leave it to Beaver, and found his greatest success directing over a dozen films for Walt Disney Productions, spanning the 1950s to the 1970s...", died:date('1979-04-06'), url:"https://themoviedb.org/person/83413"}}, {tmdbId:"43816", properties:{bornIn:"New York City, New York", imdbId:"0208111", born:date('1910-10-27'), name:"Frederick De Cordova", bio:"From Wikipedia, the free encyclopedia. \n\nFrederick \"Fred\" Timmins de Cordova (October 27, 1910 - September 15, 2001) was an American stage, motion picture and television director and producer.  He is best known for his work on The Tonight Show Starring Johnny Carson. \n\nDescription above from the Wikipedia article Frederick De Cordova, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2001-09-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xOhvTodv5fsEWjfNqm3Wbtodb1C.jpg", url:"https://themoviedb.org/person/43816"}}, {tmdbId:"146225", properties:{bornIn:"Montréal, Québec, Canada", imdbId:"0621469", born:date('1927-02-08'), name:"Silvio Narizzano", died:date('2011-07-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tig4RSH7sgtPzQeNbivaCm47HCR.jpg", url:"https://themoviedb.org/person/146225"}}, {tmdbId:"1931", properties:{bornIn:"New York, New York, USA", imdbId:"0043480", born:date('1922-06-09'), name:"George Axelrod", died:date('2003-06-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8WXlbXdMmk6fVB5EgqkSV5001Te.jpg", url:"https://themoviedb.org/person/1931"}}, {tmdbId:"34613", properties:{bornIn:"Paris, France", imdbId:"0003606", born:date('1933-03-15'), name:"Philippe de Broca", died:date('2004-11-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/78DpaNfRB0kSDVzWeeOxYiYHBjt.jpg", url:"https://themoviedb.org/person/34613"}}, {tmdbId:"87543", properties:{bornIn:"Tokyo, Japan", imdbId:"0849474", born:date('1912-02-19'), name:" Senkichi Taniguchi", bio:"From Wikipedia, the free encyclopedia. \n\nSenkichi Taniguchi (February 19, 1912 – October 29, 2007) was a Japanese film director and screenwriter. \n\nBorn in Tokyo, Japan, he attended Waseda University but left before graduating due to his involvement in a left-wing theater troupe.  He joined P. C. L.  (a precursor to Toho) in 1933 and began working as an assistant director to Kajirō Yamaguchi alongside his longtime friend, acclaimed Japanese filmmaker, Akira Kurosawa...", died:date('2007-10-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mgdhL8fNN0ef2kSsEaAzDxu0sTX.jpg", url:"https://themoviedb.org/person/87543"}}, {tmdbId:"107333", properties:{bornIn:"Birmingham, West Midlands, England, UK", imdbId:"0640226", born:date('1926-02-23'), name:"Jim O'Connolly", bio:"From Wikipedia, the free encyclopedia. \n\nJim O'Connolly (born 1924 Birmingham - died 1987 Hythe) was an English actor and director. \n\nDescription above from the Wikipedia article Jim O'Connolly, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1986-12-01'), url:"https://themoviedb.org/person/107333"}}, {tmdbId:"24657", properties:{bornIn:"Florence, Tuscany, Italy", imdbId:"0001874", born:date('1923-02-12'), name:"Franco Zeffirelli", bio:"Gian Franco Corsi Zeffirelli KBE, Grande Ufficiale OMRI (12 February 1923 – 15 June 2019), commonly known as Franco Zeffirelli (Italian pronunciation: [ˈfraŋko dzeffiˈrɛlli]), was an Italian director and producer of operas, films and television.  He was also a senator from 1994 until 2001 for the Italian centre-right Forza Italia party. \n\nSome of his operatic designs and productions have become worldwide classics...", died:date('2019-06-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/NTfHT0b0ibF6n9A9bBtgF71oYZ.jpg", url:"https://themoviedb.org/person/24657"}}, {tmdbId:"161267", properties:{imdbId:"0618834", born:date('1921-04-25'), name:"Arthur H. Nadel", died:date('1990-02-22'), url:"https://themoviedb.org/person/161267"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"13859", properties:{bornIn:"Brooklyn, New York City, New York, USA", imdbId:"0742341", born:date('1927-08-11'), name:"Stuart Rosenberg", bio:"Stuart Rosenberg  was an American film and television director whose notable works included the movies Cool Hand Luke (1967), Voyage of the Damned (1976), The Amityville Horror (1979), and The Pope of Greenwich Village (1984).  He was noted for his work with actor Paul Newman. \n\nRosenberg was born in Brooklyn, New York City, the son of Sara (née Kaminsky) and David Rosenberg...", died:date('2007-03-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5FyiyMgFqG1v7NH5i6iVAm0GhVe.jpg", url:"https://themoviedb.org/person/13859"}}, {tmdbId:"21113", properties:{bornIn:"Evanston, Illinois, USA", imdbId:"0672060", born:date('1925-07-15'), name:"D.A. Pennebaker", bio:"Donn Alan Pennebaker (July 15, 1925 – August 1, 2019) was an American documentary filmmaker...", died:date('2019-08-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ck0VifZWw8Z0mOR7Usx3LlmuSX9.jpg", url:"https://themoviedb.org/person/21113"}}, {tmdbId:"18635", properties:{bornIn:"New York, New York", imdbId:"0692872", born:date('1918-03-31'), name:"Ted Post", bio:"From Wikipedia, the free encyclopedia\n\nTed Post (born March 31, 1918) is an American TV and film director. \n\nBorn in Brooklyn, New York, he started his career in show business in 1938 working as an usher at Loew's Pitkin Theater.  He abandoned plans to become an actor after training with Tamara Daykarhanova, and turned to directing summer theater.  Ted Post taught Acting and Drama at New York's well-known High School of Performing Arts in 1950.  He persuaded his friend, Sidney Lumet,to do likewise...", url:"https://themoviedb.org/person/18635"}}, {tmdbId:"89745", properties:{bornIn:"Marianna, Arkansas, USA", imdbId:"0946391", born:date('1900-08-22'), name:"Jean Yarbrough", bio:"Jean Yarbrough was an American film director...", died:date('1975-08-02'), url:"https://themoviedb.org/person/89745"}}, {tmdbId:"3974", properties:{bornIn:"Čáslav, Československo", imdbId:"0001232", born:date('1932-02-18'), name:"Milos Forman", bio:"Born Jan Tomas Forman, Milos Forman lost his parents in the Nazi concentration camp at Auschwitz.  He studied filmmaking in Prague and made several films in his native country during the 1960s, including his first, Magic Lantern II (1960), before leaving for America.  His first American film, Taking Off (1971), received little attention.  But the follow-up, One Flew Over the Cuckoo's Nest (1975), was an unqualified success and earned Forman a Best Director Oscar...", died:date('2018-04-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/O2Crxh0l3u1mxHvjA6003gEpi7.jpg", url:"https://themoviedb.org/person/3974"}}, {tmdbId:"3606", properties:{bornIn:"Manchester, Lancashire, England, UK", imdbId:"0461497", born:date('1900-02-20'), name:" Bernard Knowles", bio:"From Wikipedia, the free encyclopedia\n\nBernard Knowles (20 February 1900 - 12 February 1975) was an English film director, producer, cinematographer and screenwriter.  Born in Manchester, Knowles worked with Alfred Hitchcock on numerous occasions before the director emigrated to Hollywood.  He later graduated as a director and screenwriter and worked much on TV, including Fabian of the Yard, Dial 999, Ivanhoe and The Adventures of Robin Hood...", died:date('1975-02-12'), url:"https://themoviedb.org/person/3606"}}, {tmdbId:"1477275", properties:{imdbId:"0169716", name:"Robert Carl Cohen", bio:"Robert Carl Cohen is a director and writer, known for Mondo Hollywood (1967), Committee on UnAmerican Activities (1962) and Jennie: Wife/Child (1968)...", url:"https://themoviedb.org/person/1477275"}}, {tmdbId:"19665", properties:{bornIn:"London, England, UK", imdbId:"0000958", born:date('1933-01-18'), name:"John Boorman", bio:"John Boorman (born 18 January 1933) is an English filmmaker who is a long time resident of Ireland and is best known for his feature films such as Point Blank, Deliverance, Excalibur, The Emerald Forest, Hope and Glory, The General and The Tailor of Panama...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/87ai7VFmxbLtUzcvrpQ1qHFVE7a.jpg", url:"https://themoviedb.org/person/19665"}}, {tmdbId:"55692", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0491852", born:date('1922-02-23'), name:"Arnold Laven", bio:"Arnold Laven was an American film and television director and producer.  He was one of the founders and principals of the American film and television production company Levy-Gardner-Laven.  Laven was a producer of, among other things, the long-running western television series The Rifleman and The Big Valley.  He also directed motion pictures, including Without Warning!, The Rack, The Monster That Challenged the World, Geronimo, Rough Night in Jericho, and Sam Whiskey...", died:date('2009-09-13'), url:"https://themoviedb.org/person/55692"}}, {tmdbId:"138006", properties:{bornIn:"Boston, Massachusetts, U.S.", imdbId:"0936464", born:date('1930-01-01'), name:"Frederick Wiseman", bio:"Frederick Wiseman is an American filmmaker, documentarian, and theatre director.  Documentarian Frederick Wiseman has been noted for his ability to capture the nuances of life in American institutions such as prisons, hospitals, welfare offices, and high schools.  He started out in 1963 by producing a fictional feature film, The Cool World, an examination of the lives of Harlem teenagers.  In the beginning, Wiseman was a staunch social reformist, and his films were calls for change...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h0SIW7kP02MUFv8bqIhXZlibUvM.jpg", url:"https://themoviedb.org/person/138006"}}, {tmdbId:"46611", properties:{bornIn:" Sydney, Australia", imdbId:"0165412", born:date('1924-10-10'), name:"James Clavell", bio:"​From Wikipedia, the free encyclopedia.   \n\nJames Clavell, born Charles Edmund Dumaresq Clavell (10 October 1924 – 7 September 1994) was an Australian (later naturalized American) novelist, screenwriter, director and World War II veteran and prisoner of war.  Clavell is best known for his epic Asian Saga series of novels and their televised adaptations, along with such films as The Great Escape and To Sir, with Love...", died:date('1994-09-07'), url:"https://themoviedb.org/person/46611"}}, {tmdbId:"38914", properties:{imdbId:"0549650", born:date('1927-03-15'), name:"Christian Marquand", died:date('2000-11-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sDmro3JOBKUHBkC08UVhjNpBugR.jpg", url:"https://themoviedb.org/person/38914"}}, {tmdbId:"88458", properties:{bornIn:"New York, New York, USA", imdbId:"0589228", born:date('1932-07-18'), name:"Robert Ellis Miller", bio:"Robert Ellis Miller (July 18, 1927 – January 27, 2017) was an American director. \n\nDescription above from the Wikipedia article Robert Ellis Miller, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2017-01-27'), url:"https://themoviedb.org/person/88458"}}, {tmdbId:"12009", properties:{bornIn:"London, England, UK", imdbId:"0367431", born:date('1931-06-03'), name:"Anthony Harvey", bio:"From Wikipedia, the free encyclopedia. \n\nAnthony Harvey (born 3 June 1931) was a British filmmaker who started his career in the 1950s as a film editor, and moved into directing in the mid 1960s.  Harvey had fifteen film credits as an editor, and he directed thirteen films.  The second film that Harvey directed, The Lion in Winter (1968), earned him a Directors Guild of America Award and a nomination for the Academy Award for Directing...", died:date('2017-11-23'), url:"https://themoviedb.org/person/12009"}}, {tmdbId:"14999", properties:{bornIn:"New York City, New York, USA", imdbId:"0001681", born:date('1940-02-04'), name:"George A. Romero", bio:"George Andrew Romero (February 4, 1940 - July 16, 2017) was an American-Canadian film director, screenwriter, and editor best known for his gruesome and satirical horror films about a hypothetical zombie apocalypse.  He is nicknamed \"Godfather of all Zombies. \"\n\nDescription above from the Wikipedia George A.  Romero, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2017-07-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1Yw5WCVzreBHKbYL5dLXY2NEhhW.jpg", url:"https://themoviedb.org/person/14999"}}, {tmdbId:"51313", properties:{bornIn:"Dublin, Ireland", imdbId:"0641400", born:date('1928-04-01'), name:"Michael O'Herlihy", bio:"​From Wikipedia, the free encyclopedia.   \n\nMichael O'Herlihy (April 1, 1929 - June 16, 1997) was an Irish television producer and director who directed shows like Gunsmoke (1955), Maverick (1957), Star Trek (1965), Hawaii Five-O (1968), M*A*S*H (1972) and The A-Team (1983).  Born in Dublin, Ireland, O'Herlihy was the younger brother of actor Dan O'Herlihy.  O'Herlihy died in Dublin, Ireland on June 16, 1997 at age 68...", died:date('1997-06-16'), url:"https://themoviedb.org/person/51313"}}, {tmdbId:"18592", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0340981", born:date('1922-12-20'), name:"Tom Gries", bio:"From Wikipedia, the free encyclopedia. \n\nThomas S.  \"Tom\" Gries (20 December 1922; Chicago, Illinois – 3 January 1977; Pacific Palisades, California) was an American TV and film director, writer and producer. \n\nEducated at the Loyola Academy and Georgetown University, Gries began working in TV in the 1950s as a writer and director, on such programmes as Bronco,\"Rat Patrol\", Wanted: Dead or Alive, The Westerner, The Rifleman, East Side/West Side, Mission: Impossible, Route 66, Batman and I Spy...", died:date('1977-01-03'), url:"https://themoviedb.org/person/18592"}}, {tmdbId:"29646", properties:{bornIn:"Woodland Hills, California, United States", imdbId:"0418986", born:date('1927-06-16'), name:"Charles Jarrott", bio:"From Wikipedia, the free encyclopedia. \n\nCharles Jarrott (16 June 1927 – 4 March 2011) was a British film and television director.  He was best known for costume dramas he directed for producer Hal B.  Wallis, among them Anne of the Thousand Days, which earned him a Golden Globe for Best Director in 1970. \n\nAlthough Anne was nominated for several awards, critic Pauline Kael wrote in her book Reeling (Warner Books, p...", died:date('2011-03-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/glWUlZidfXmHc2PnGeUwxDVvUuh.jpg", url:"https://themoviedb.org/person/29646"}}, {tmdbId:"31022", properties:{imdbId:"0627954", name:"Marv Newland", url:"https://themoviedb.org/person/31022"}}, {tmdbId:"51373", properties:{bornIn:"The Bronx, New York, U.S.", imdbId:"0670282", born:date('1930-04-19'), name:"Larry Peerce", bio:"From Wikipedia, the free encyclopedia\n\nLawrence \"Larry\" Peerce (born April 19, 1930) is an American film and TV director whose work includes the theatrical feature Goodbye, Columbus, the early rock and roll concert film The Big T. N. T.  Show, One Potato, Two Potato (1964), The Other Side of the Mountain (1975), and Oscar nominee Two-Minute Warning (1976). \n\nThe son of operatic tenor Jan Peerce and talent agent Alice (Kalmanowitz) Peerce, Larry Peerce was born in The Bronx, New York City, New York...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1Vv3subCB4Jp8GM6KLPY8mVOEfm.jpg", url:"https://themoviedb.org/person/51373"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"39779", properties:{bornIn:"Lincolnshire, England, UK", imdbId:"0172772", born:date('1936-04-01'), name:"Peter Collinson", bio:"From Wikipedia, the free encyclopedia\n\nPeter Collinson (1 April 1936 – 16 December 1980) was a British film director probably best known for directing the 1969 movie The Italian Job. \n\nDescription above from the Wikipedia article Peter Collinson (film director), licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1980-12-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oSDx2b8rJ9Cd8bflKHSuN02fSON.jpg", url:"https://themoviedb.org/person/39779"}}, {tmdbId:"131565", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0383733", born:date('1914-06-23'), name:"Nat Hiken", died:date('1968-12-07'), url:"https://themoviedb.org/person/131565"}}, {tmdbId:"28615", properties:{bornIn:"Tulle, Corrèze, France", imdbId:"0006445", born:date('1920-03-20'), name:"Éric Rohmer", bio:"Éric Rohmer (French pronunciation: [eʁik ʁomɛʁ]; 20 March 1920 – 11 January 2010) was a French film director, film critic, journalist, novelist, screenwriter and teacher.  A figure in the post-war New Wave cinema, he was a former editor of Cahiers du cinéma. \n\nRohmer was the last of the French New Wave directors to become established...", died:date('2010-01-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4VUnQk2yA6m58uak9LguIAzZ8Re.jpg", url:"https://themoviedb.org/person/28615"}}, {tmdbId:"7067", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0005549", born:date('1926-02-06'), name:"Haskell Wexler", bio:"From Wikipedia, the free encyclopedia. \n\nHaskell Wexler, A. S. C.  (born February 6, 1922 in Chicago, Illinois) is an American cinematographer, and a film producer and director.  Wexler was judged to be one of film history's ten most influential cinematographers in a survey of the members of the International Cinematographers Guild. \n\nDescription above from the Wikipedia article Haskell Wexler, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/k3JSEg2tildKuFl6F6T1gLQSwgf.jpg", url:"https://themoviedb.org/person/7067"}}, {tmdbId:"9868", properties:{bornIn:"London, England, UK", imdbId:"0402597", born:date('1925-03-11'), name:"Peter R. Hunt", bio:"Was an English film editor, television producer and director.  Hunt was known for his work on the James Bond films with his innovative editing style. \n\nDescription above from the Wikipedia article Peter R.  Hunt , licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2002-08-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xoHuOpPGOqA3MxsNvqhQCPq0h8r.jpg", url:"https://themoviedb.org/person/9868"}}, {tmdbId:"7501", properties:{bornIn:"London, England, UK", imdbId:"0623768", born:date('1911-04-23'), name:"Ronald Neame", bio:"From Wikipedia, the free encyclopedia\n\nRonald Elwin Neame CBE, BSC (23 April 1911 – 16 June 2010) was an English film cinematographer, producer, screenwriter and director. \n\nDescription above from the Wikipedia article Ronald Neame, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2010-06-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4BFCDD3GG5woHmxy6o7fny4NDYc.jpg", url:"https://themoviedb.org/person/7501"}}, {tmdbId:"114269", properties:{imdbId:"0183307", born:date('1924-12-07'), name:"Jack Couffer", url:"https://themoviedb.org/person/114269"}}, {tmdbId:"1418", properties:{bornIn:"Brookline, Massachusetts, USA", imdbId:"0563099", born:date('1926-11-26'), name:"Albert Maysles", bio:"From Wikipedia, the free encyclopedia\n\nAlbert (born November 26, \n\n1926, Boston, Massachusetts) and David Maysles (rhymes with \"hazels\", \n\nborn 10 January 1932, Boston, Massachusetts) were a documentary \n\nfilmmaking team whose cinéma vérité works include Salesman (1968), Gimme\n\n Shelter (1970) and Grey Gardens (1976).  Their 1964 film on The Beatles \n\nforms the backbone of the DVD, The Beatles: The First U. S.  Visit...", url:"https://themoviedb.org/person/1418"}}, {tmdbId:"139002", properties:{bornIn:"Brookline, Massachusetts, USA", imdbId:"0563100", born:date('1931-01-10'), name:" David Maysles", bio:"From Wikipedia, the free encyclopedia\n\nAlbert (born November 26, 1926, Boston, Massachusetts) and David Maysles (rhymes with \"hazels\", born 10 January 1932, Boston, Massachusetts) were a documentary filmmaking team whose cinéma vérité works include Salesman (1968), Gimme Shelter (1970) and Grey Gardens (1976).  Their 1964 film on The Beatles forms the backbone of the DVD, The Beatles: The First U. S.  Visit...", died:date('1987-01-03'), url:"https://themoviedb.org/person/139002"}}, {tmdbId:"1477", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"0959020", born:date('1931-08-15'), name:" Charlotte Zwerin", bio:"From Wikipedia, the free encyclopedia\n\nCharlotte Zwerin (born Charlotte Mitchell, August 15, 1931, Detroit, Michigan – January 22, 2004, Manhattan) was a documentary film director and editor best known for work concerning artists or musicians, although she also made films concerning other subjects. \n\nDescription above from the Wikipedia article Charlotte Zwerin, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2004-01-22'), url:"https://themoviedb.org/person/1477"}}, {tmdbId:"18579", properties:{bornIn:"Muskegon, Michigan, USA", imdbId:"0447944", born:date('1922-09-03'), name:"Burt Kennedy", bio:"From Wikipedia, the free encyclopedia. \n\nBurt Kennedy (September 3, 1922 - February 15, 2001) was an American screenwriter and director known for mainly directing film Westerns.  After World War II service in the 1st Cavalry Division, Muskegon, Michigan-born Kennedy found work writing for radio, then used his training as a cavalry officer to secure a job as a fencing trainer and fencing stunt doubles in films...", died:date('2001-02-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yGiQBjT14SqKVEcVEF7WURWKfug.jpg", url:"https://themoviedb.org/person/18579"}}, {tmdbId:"66777", properties:{bornIn:"Chicago, Illinois, U.S", imdbId:"0002080", born:date('1927-06-23'), name:"Bob Fosse", bio:"​From Wikipedia, the free encyclopedia\n\nRobert Louis “Bob” Fosse (June 23, 1927 – September 23, 1987) was an American actor, dancer, musical theater choreographer, director, screenwriter, film editor and film director.  He won an unprecedented eight Tony Awards for choreography, as well as one for direction.  He was nominated for an Academy Award four times, winning for his direction of Cabaret (beating Francis Ford Coppola for The Godfather)...", died:date('1987-09-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sCndI9C9hIOrca9751M2gMy4Rmz.jpg", url:"https://themoviedb.org/person/66777"}}, {tmdbId:"7767", properties:{bornIn:"Fresno, California, United States", imdbId:"0001603", born:date('1925-02-21'), name:"Sam Peckinpah", bio:"From Wikipedia, the free encyclopedia. \n\nDavid Samuel \"Sam\" Peckinpah (February 21, 1925 – December 28, 1984) was an American filmmaker and screenwriter who achieved prominence following the release of the Western epic The Wild Bunch (1969).  He was known for the innovative and explicit depiction of action and violence, as well as his revisionist approach to the Western genre...", died:date('1984-12-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hXrHVHdNivFu8dMbyp40ds5YXYD.jpg", url:"https://themoviedb.org/person/7767"}}, {tmdbId:"96909", properties:{bornIn:"New York City, New York, USA", imdbId:"0761522", born:date('1929-01-21'), name:"Denis Sanders", bio:"From Wikipedia, the free encyclopedia\n\nDenis Sanders (21 January 1929 – 10 December 1987) was an American film director, screenwriter and producer who directed the debut performances of Robert Redford, George Hamilton, Sydney Pollack and Tom Skerritt in the critically acclaimed 1962 film War Hunt.  He won two Academy Awards, the first for Best Short Subject in 1955 for A Time Out of War that had served as his master's degree thesis at U. C. L. A...", died:date('1987-12-10'), url:"https://themoviedb.org/person/96909"}}, {tmdbId:"41222", properties:{imdbId:"0782381", name:"Arthur Allan Seidelman", bio:"From Wikipedia, the free encyclopedia. \n\nArthur Allan Seidelman is an award-winning American television, film, and theatre director and an occasional writer, producer and actor. \n\nBorn in New York City, he received his BA from Whittier College and an MA in Theatre from UCLA.   He subsequently studied with Sanford Meisner, who became a life-long friend and mentor.  Seidelman made his screen directorial debut with Hercules in New York, a 1970 comedy-action film starring Arnold Schwarzenegger...", url:"https://themoviedb.org/person/41222"}}, {tmdbId:"45791", properties:{bornIn:"Gothenburg, Västra Götalands län, Sweden", imdbId:"0027815", born:date('1943-03-31'), name:"Roy Andersson", bio:"Roy Andersson (born 31 March 1943) is a Swedish film director, best known for his films A Swedish Love Story (1970) and Songs from the Second Floor (2000).  More than any other, Songs from the Second Floor succeeded in cementing his personal style – a style characterized by long takes, absurdist comedy, stiff caricaturing of Swedish culture and Felliniesque grotesque...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/559f9FWfPpUhaziYZ4kpP9fwGIZ.jpg", url:"https://themoviedb.org/person/45791"}}, {tmdbId:"4964", properties:{bornIn:"Ogden, Utah, USA", imdbId:"0000797", born:date('1929-09-02'), name:"Hal Ashby", bio:"From Wikipedia, the free encyclopedia\n\nHal Ashby was an American film director and editor associated with the New Hollywood wave of filmmaking. \n\nBefore his career as a director Ashby edited films for Norman Jewison, notably The Russians Are Coming, the Russians Are Coming (1966), which earned Ashby an Oscar nomination for Best Editing, and In the Heat of the Night (1967), which earned him his only Oscar for the same category...", died:date('1988-12-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9vctTo3QwSZmeALbeWlNXmUu8cB.jpg", url:"https://themoviedb.org/person/4964"}}, {tmdbId:"125543", properties:{bornIn:"New York City, New York, USA", imdbId:"0512327", born:date('1940-05-05'), name:"Michael Lindsay-Hogg", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Ank3e1SAM971JSaO2f0SPopO4Lb.jpg", url:"https://themoviedb.org/person/125543"}}, {tmdbId:"14132", properties:{bornIn:" London, England", imdbId:"0001676", born:date('1928-08-15'), name:" Nicolas Roeg", bio:"Nicolas Jack Roeg (15 August 1928 – 23 November 2018) was an English film director and cinematographer, best known for directing Performance (1970), Walkabout (1971), Don't Look Now (1973), The Man Who Fell to Earth (1976), Bad Timing (1980), and The Witches (1990).  Making his directorial debut 23 years after his entry into the film business, Roeg quickly became known for an idiosyncratic visual and narrative style, characterized by the use of disjointed and disorienting editing...", died:date('2018-11-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wZlBca27Ssn1SWVKKTMEuUacGOA.jpg", url:"https://themoviedb.org/person/14132"}}, {tmdbId:"30956", properties:{bornIn:"Madrid, Spain", imdbId:"0001238", born:date('1930-05-12'), name:"Jesús Franco", bio:"Jesús \"Jess\" Franco was a Spanish film director, writer, cinematographer and actor.  His career took off in 1961 with his cult classic The Awful Dr.  Orloff, which received wide distribution in the United States and England.  Though he had some American box office success with Necronomicon, his first women-in-prison film Ninety-Nine Women, and his two Christopher Lee films, The Bloody Judge and Count Dracula, he never achieved wide commercial success...", died:date('2013-04-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sVhaKFvmqD80EbWLTu7sGMbGDt0.jpg", url:"https://themoviedb.org/person/30956"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"69946", properties:{bornIn:"Washington, Pennsylvania, USA", imdbId:"0005570", born:date('1926-02-22'), name:"Bud Yorkin", bio:"From Wikipedia, the free encyclopedia. \n\nBud Yorkin (born February 22, 1926) is an American film and television producer, director, writer and actor.  He directed and produced the 1958 TV special An Evening With Fred Astaire, which won nine Emmy Awards. \n\nYorkin was born Alan David Yorkin in Washington, Pennsylvania.  He earned a degree in engineering from Carnegie Tech, now Carnegie Mellon University in Pittsburgh...", died:date('2015-08-18'), url:"https://themoviedb.org/person/69946"}}, {tmdbId:"32327", properties:{bornIn:"Southampton, Hampshire, England, UK", imdbId:"0001692", born:date('1927-07-03'), name:"Ken Russell", bio:"From Wikipedia, the free encyclopedia. \n\nHenry Kenneth Alfred \"Ken\" Russell (3 July 1927 – 27 November 2011) was an English film director.  He is known for his pioneering work in television and film and for his controversial style.  He has been criticized as being over-obsessed with sexuality and the church.  His subject matter is often about famous composers, or based on other works of art which he adapts loosely...", died:date('2011-11-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5C3jSx8PQQ2ivHksovxUeCmLTCd.jpg", url:"https://themoviedb.org/person/32327"}}, {tmdbId:"57885", properties:{bornIn:"Akron, Ohio, USA", imdbId:"0905579", born:date('1939-09-24'), name:"Michael Wadleigh", bio:"From Wikipedia, the free encyclopedia. \n\nMichael Wadleigh (born September 24, 1942) is an American movie director and cinematographer renowned for his groundbreaking documentary of the 1969 Woodstock Festival, Woodstock. \n\nA native of Akron, Ohio, Wadleigh entered films in his early twenties as a cinematographer on independently-produced low-budget films David Holtzman's Diary and I Call First (both 1967), and My Girlfriend's Wedding (1969)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/g30d3Pqd3y3p1steDmX8eshZ65D.jpg", url:"https://themoviedb.org/person/57885"}}, {tmdbId:"98539", properties:{bornIn:"Baltimore, Maryland, U.S.", imdbId:"0953261", born:date('1940-12-21'), name:" Frank Zappa", bio:"From Wikipedia, the free encyclopedia.   Frank Vincent Zappa  ( December 21, 1940 – December 4, 1993) was an American composer, singer-songwriter, electric guitarist, record producer and film director.  In a career spanning more than 30 years, Zappa wrote rock, jazz, electronic, orchestral and musique concrète works.  He also directed feature-length films and music videos, and designed album covers...", died:date('1993-12-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pWZexMqPpGeGX7VaPHUt1vnmH5G.jpg", url:"https://themoviedb.org/person/98539"}}, {tmdbId:"20937", properties:{bornIn:"London, England, UK", imdbId:"0297523", born:date('1927-09-30'), name:"Robert Fuest", bio:"From Wikipedia, the free encyclopedia\n\nRobert Fuest (born in 1927 in London) is an English film director, screenwriter, and production designer who has worked mostly in the horror, fantasy and suspense genres. \n\nFuest's most highly praised and popular films, which feature strong black comedy undertones, include perennial cult favorites The Abominable Dr.  Phibes (1971), Dr.  Phibes Rises Again (1972), and The Final Programme (aka The Last Days of Man on Earth) (1973)...", died:date('2012-03-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w7wmTbPWYL7vkrF0ZNVBJDhOVYW.jpg", url:"https://themoviedb.org/person/20937"}}, {tmdbId:"32154", properties:{imdbId:"0353592", born:date('1939-03-18'), name:"Piers Haggard", url:"https://themoviedb.org/person/32154"}}, {tmdbId:"19789", properties:{bornIn:"Frankfurt am Main, Germany", imdbId:"0649096", born:date('1927-11-01'), name:"Marcel Ophüls", bio:"Documentary filmmaker and former actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/euSUNCBbdb2RnnPJ2sfwTWaK14w.jpg", url:"https://themoviedb.org/person/19789"}}, {tmdbId:"15175", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0001243", born:date('1935-08-29'), name:"William Friedkin", bio:"William Friedkin is an American film director, producer and screenwriter best known for directing The French Connection in 1971 and The Exorcist in 1973; for the former, he won the Academy Award for Best Director.  Some of his other films include Sorcerer, Cruising, To Live and Die in L. A. , Jade, Rules of Engagement, The Hunted, Bug, and Killer Joe...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1iBd92izRHpkSH4hOhcUBmF2cv7.jpg", url:"https://themoviedb.org/person/15175"}}, {tmdbId:"545675", properties:{bornIn:"Montréal - Québec - Canada", imdbId:"0433267", born:date('1930-03-11'), name:"Claude Jutra", died:date('1986-11-05'), url:"https://themoviedb.org/person/545675"}}, {tmdbId:"12112", properties:{bornIn:"Los Angeles, CA", imdbId:"0874320", born:date('1942-04-08'), name:"Douglas Trumbull", bio:"From Wikipedia, the free encyclopedia.   \n\nDouglas Huntley Trumbull (born April 8, 1942, Los Angeles) is an American film director, special effects supervisor, and inventor.  He contributed to, or was responsible for, the special photographic effects of 2001: A Space Odyssey, Close Encounters of the Third Kind, Star Trek: The Motion Picture and Blade Runner, and directed the movies Silent Running and Brainstorm...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wVDG2FBqenOpVwNUySqhXfBjifr.jpg", url:"https://themoviedb.org/person/12112"}}, {tmdbId:"72433", properties:{imdbId:"0156927", name:" Chia-Hsiang Wu", url:"https://themoviedb.org/person/72433"}}, {tmdbId:"21544", properties:{bornIn:"New York City, New York", imdbId:"0764781", born:date('1930-04-28'), name:"Richard C. Sarafian", bio:"Richard Caspar Sarafian (April 28, 1930 – September 18, 2013) was an American television and film director and actor.  He compiled a versatile career that spanned over five decades as a director, actor, and writer.  Sarafian is best known as the director of the 1971 film Vanishing Point...", died:date('2013-09-18'), url:"https://themoviedb.org/person/21544"}}, {tmdbId:"40402", properties:{imdbId:"0474539", born:date('1922-07-23'), name:"Buzz Kulik", died:date('1999-01-13'), url:"https://themoviedb.org/person/40402"}}, {tmdbId:"213341", properties:{imdbId:"0441501", name:"Milton Katselas", url:"https://themoviedb.org/person/213341"}}, {tmdbId:"12964", properties:{bornIn:"Waukesha, Wisconsin, USA", imdbId:"0006916", born:date('1938-11-28'), name:"Michael Ritchie", bio:"From Wikipedia, the free encyclopedia\n\nMichael Brunswick Ritchie (November 28, 1938 - April 16, 2001) was an American film director. \n\nRitchie was born in Waukesha, Wisconsin, the son of Patricia (née Graney) and Benbow Ferguson Ritchie.  His family later moved to Berkeley, California, where his father was a professor of experimental psychology at the University of California at Berkeley and his mother was the art and music librarian for the city...", died:date('2001-04-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sUJcMxe1w6NtxKNHtik0N3Xul1J.jpg", url:"https://themoviedb.org/person/12964"}}, {tmdbId:"96423", properties:{imdbId:"0785877", born:date('1927-10-27'), name:"Aleksandr Seryj", died:date('1987-10-16'), url:"https://themoviedb.org/person/96423"}}, {tmdbId:"1645807", properties:{name:" Howard Ziehm", url:"https://themoviedb.org/person/1645807"}}, {tmdbId:"16384", properties:{bornIn:" Haifa, British Mandate for Palestine (now Israel", imdbId:"0000835", born:date('1938-10-29'), name:"Ralph Bakshi", bio:"Ralph Bakshi (born October 29, 1938) is an American director of animated and live-action films.  In the 1970s, he established an alternative to mainstream animation through independent and adult-oriented productions.  Between 1972 and 1992, he directed nine theatrically released feature films, five of which he wrote.  He has been involved in numerous television projects as director, writer, producer and animator...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qnEd6krjpW9blCNA90iw0AR58dR.jpg", url:"https://themoviedb.org/person/16384"}}, {tmdbId:"25182", properties:{bornIn:"Saumur, France", imdbId:"0002216", born:date('1920-06-21'), name:"Yves Robert", bio:"Yves Robert (19 June 1920 – 10 May 2002) was a French actor, screenwriter, director, and producer. \n\nRobert was born in Saumur, Maine-et-Loire.  In his teens, he went to Paris to pursue a career in acting, starting with unpaid parts on stage in the city's various theatre workshops.  From ages 12–20 he set type as a typographer, then studied mime in his early 20s.  In 1948 he made his motion picture debut with one of the secondary roles in the film, Les Dieux du dimanche...", died:date('2002-05-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lv3f0e23sHuZ3B1KFb98nRe3WYR.jpg", url:"https://themoviedb.org/person/25182"}}, {tmdbId:"80702", properties:{bornIn:"Kyoto, Japan", imdbId:"0593014", born:date('1921-03-02'), name:"Kenji Misumi", bio:"From Wikipedia, the free encyclopedia\n\nKenji Misumi (三隅 研次 Misumi Kenji) (2 March 1921, Kyoto, Japan - 24 September 1975) was a notable Japanese film director.  He created films such as Lone Wolf and Cub and the initial film in the long-running Zatoichi (座頭市, Zatōichi) series. \n\nHe died at age 53. \n\nDescription above from the Wikipedia article Kenji Misumi, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1975-09-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Aw8ji1DkR1WgP5uv0TpL3vfuvmI.jpg", url:"https://themoviedb.org/person/80702"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"5140", properties:{bornIn:"Cleveland, Ohio, USA", imdbId:"0000127", born:date('1939-08-02'), name:"Wes Craven", bio:"Wesley Earl \"Wes\" Craven (August 2, 1939 – August 30, 2015) was a prolific and influential American film director, writer, producer, and actor known for his pioneering work in the genre of horror films, particularly slasher films.  Due to the success and cultural impact of his works in the horror film genre, Craven has been called the \"Master of Horror\". \n\nDescription above from the Wikipedia article Jeremy Renner, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2015-08-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/blQ0LWf54PJLmxMnFFdh7n1as7V.jpg", url:"https://themoviedb.org/person/5140"}}, {tmdbId:"21377", properties:{bornIn:"Budapest, Hungary", imdbId:"0575389", born:date('1937-12-23'), name:"Peter Medak", bio:"From Wikipedia, the free encyclopedia. \n\nPeter Medak (born 23 December 1937) is a Hungarian-born film director of British and American films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oUPjJXMOSomwrqFx4eobxROVZOV.jpg", url:"https://themoviedb.org/person/21377"}}, {tmdbId:"88148", properties:{imdbId:"0662899", born:date('1934-12-07'), name:"Gordon Parks Jr.", bio:"​From Wikipedia, the free encyclopedia.   \t\n\nGordon Roger Parks, Jr.  (December 7, 1934 – April 3, 1979) was an American film director best known for the film Super Fly. \n\nParks was the son of Sally Alvis and late photographer and director Gordon Parks.  The younger Parks followed in his father's footsteps after his father had success with the blaxploitation hit Shaft. \n\nHe was killed with three others when their small airplane crashed on takeoff near Nairobi, Kenya...", died:date('1979-04-03'), url:"https://themoviedb.org/person/88148"}}, {tmdbId:"30715", properties:{bornIn:"Waco, Texas, USA", imdbId:"0000517", born:date('1943-11-30'), name:"Terrence Malick", bio:"Terrence Malick (born November 30, 1943) is an American film director, screenwriter, and producer.  In a career spanning almost four decades, Malick has directed nine feature films. \n\nMalick is known for his singular style that combines loose narrative and editing structure with spiritual themes.  Many of his films are critically acclaimed, with some considering The Tree of Life to be a 21st century masterpiece...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8tDvBf4TrY6RhT96XA4nj8WVuOC.jpg", url:"https://themoviedb.org/person/30715"}}, {tmdbId:"79726", properties:{bornIn:"Kansas City, Missouri, USA", imdbId:"0359386", born:date('1939-02-12'), name:"John D. Hancock", bio:"From Wikipedia, the free encyclopedia\n\nJohn D.  Hancock (born 12 February 1939, Kansas City, Missouri) is an American stage and film director, producer and writer.  He is the son of Ralph and Ella Mae Rosenthal Hancock.  His father was a musician with the NBC Symphony Orchestra in Chicago, Illinois and his mother a school teacher.  Hancock spent his youth between their home in Chicago and their fruit farm in La Porte, Indiana...", url:"https://themoviedb.org/person/79726"}}, {tmdbId:"106834", properties:{bornIn:"Milford, Utah, USA", imdbId:"0629363", born:date('1910-09-15'), name:"Charles A. Nichols", bio:"From Wikipedia, the free encyclopedia\n\nCharles August \"Nick\" Nichols (September 15, 1910 - August 1992) was an American animator and film director. \n\nDescription above from the Wikipedia article Charles August Nichols, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1992-08-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jtURYTRJn7H5JXoeXf0LNEAeemo.jpg", url:"https://themoviedb.org/person/106834"}}, {tmdbId:"106835", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0847314", born:date('1925-04-29'), name:" Iwao Takamoto", bio:"From Wikipedia, the free encyclopedia\n\nIwao Takamoto (April 29, 1925 – January 8, 2007) was a Japanese-American animator, television producer, and film director.  He was most famous as being a production and character designer for Hanna-Barbera Productions shows such as Scooby-Doo. \n\nDescription above from the Wikipedia article Charles Iwao Takamoto, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2007-01-08'), url:"https://themoviedb.org/person/106835"}}, {tmdbId:"95134", properties:{bornIn:"\tChicago, Illinois", imdbId:"0345899", born:date('1945-07-28'), name:"James William Guercio", bio:"James William Guercio (born July 18, 1945) is an American music producer, musician and songwriter.  He is well known for his work as the producer of Chicago's early albums as well as early recordings of The Buckinghams and Blood Sweat & Tears.  He has worked briefly in the motion picture industry as a producer and director.  In the mid 1970s, Guercio managed the Beach Boys and was a member of their backing band...", url:"https://themoviedb.org/person/95134"}}, {tmdbId:"57727", properties:{bornIn:"Wisconsin, USA", imdbId:"0167195", born:date('1928-03-06'), name:"Robert Clouse", bio:"From Wikipedia, the free encyclopedia\n\nRobert Clouse (March 6, 1928 – February 4, 1997) was an American film director and producer, known primarily for his work in the action/adventure and martial arts genres.  He died on February 4, 1997 in Oregon of kidney failure. \n\nClouse directed Bruce Lee in Lee's only English-speaking starring role, in 1973's Enter the Dragon...", died:date('1997-02-04'), url:"https://themoviedb.org/person/57727"}}, {tmdbId:"34264", properties:{bornIn:"Milan, Lombardy, Italy", imdbId:"0274659", born:date('1928-05-11'), name:"Marco Ferreri", bio:"​From Wikipedia, the free encyclopedia.   \n\nMarco Ferreri (11 May 1928 – 9 May 1997) was an Italian film director, screenwriter and actor.  He was born in Milan and died in Paris of a myocardial infarction.  Upon his death, Gilles Jacob, artistic director of the Cannes International Film Festival, said: The Italian cinema has lost one of its most original artists, one of its most personal authors (. . ...", died:date('1997-05-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c7almvKiadRxPrcoZtmICNsZ8Bs.jpg", url:"https://themoviedb.org/person/34264"}}, {tmdbId:"52837", properties:{bornIn:"Annotto Bay, St. Mary's, Jamaica", imdbId:"0378320", born:date('1936-03-07'), name:"Perry Henzell", bio:"From Wikipedia, the free encyclopedia. \n\nPerry Henzell (March 7, 1936, Annotto Bay, St.  Mary's, Jamaica – November 30, 2006, Treasure Beach, St.  Elizabeth's, Jamaica) was most famous for being the director of the first Jamaican feature film, The Harder They Come (1972), starring Jimmy Cliff. \n\nDescription above from the Wikipedia article Perry Henzell, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2006-11-30'), url:"https://themoviedb.org/person/52837"}}, {tmdbId:"57639", properties:{bornIn:"Teramo, Abruzzi, Italy", imdbId:"0884547", born:date('1934-05-20'), name:"Tonino Valerii", bio:"​From Wikipedia, the free encyclopedia.   \n\nTonino Valerii (born 20 May 1934) is an Italian film director, most known for his Spaghetti Westerns.  Valerii started his film career as an assistant director on Sergio Leone's A Fistful of Dollars, before moving on to direct by himself.  Among his best known films are Day of Anger (1968) The Price of Power (1969), A Reason to Live, a Reason to Die (1972) and My Name Is Nobody (1973), starring Henry Fonda...", died:date('2016-10-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ypBjRtxTowFUZQ1gy1Hng1VNwKS.jpg", url:"https://themoviedb.org/person/57639"}}, {tmdbId:"53914", properties:{bornIn:"Pessac, Gironde, France", imdbId:"0262402", born:date('1938-11-30'), name:"Jean Eustache", bio:"Jean Eustache was born on November 30, 1938 in Pessac, Gironde, France.  He was a director and editor, known for The Mother and the Whore (1973), Mes Petites Amoureuses (1974) and Les photos d'Alix (1980).  He died on November 3, 1981 in Paris, France...", died:date('1981-11-05'), url:"https://themoviedb.org/person/53914"}}, {tmdbId:"49552", properties:{bornIn:"Milano, Lombardia, Italia", imdbId:"0116663", born:date('1922-08-04'), name:"Franco Brusati", died:date('1993-02-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3FS1JWTtUDdJ2Cn8GVI1stt7wYV.jpg", url:"https://themoviedb.org/person/49552"}}, {tmdbId:"80260", properties:{bornIn:"Paris, France", imdbId:"0482537", born:date('1929-07-13'), name:"René Laloux", bio:"From Wikipedia, the free encyclopedia. \n\nRené Laloux was born in Paris in 1929 and went to art school to study painting.  After some time working in advertising, he got a job in a psychiatric institution where he began experimenting in animation with the interns.  It is at the psychiatric institution that he made 1960's Monkey's Teeth (Les Dents du Singe), in collaboration with Paul Grimault's studio, and using a script written by the Cour Cheverny's interns...", died:date('2004-03-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vbI3IWgNzGWAYEaUqdAhxHA9OTr.jpg", url:"https://themoviedb.org/person/80260"}}, {tmdbId:"98199", properties:{bornIn:"Bronx, New York", imdbId:"0770234", born:date('1927-06-26'), name:"Jerry Schatzberg", bio:"​From Wikipedia, the free encyclopedia.   \n\nJerry Schatzberg (born June 26, 1927 in Bronx, New York) is a photographer and film director. \n\nSchatzberg was born to a Jewish family of furriers and grew up in the Bronx.  He photographed for magazines such as Vogue, Esquire and McCalls.  He made his debut as a feature film director with 1970's Puzzle of a Downfall Child starring Faye Dunaway...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8rCnIrvgd4BvExqLwb200D9kIUU.jpg", url:"https://themoviedb.org/person/98199"}}, {tmdbId:"116155", properties:{bornIn:"Savonlinna, Finland", imdbId:"0463740", born:date('1938-07-07'), name:"Ere Kokkonen", died:date('2008-10-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vYGdKHdBHITw8mZ6cqLfmaYbAkW.jpg", url:"https://themoviedb.org/person/116155"}}, {tmdbId:"15663", properties:{bornIn:"Jersey City, New Jersey, USA", imdbId:"0765121", born:date('1925-07-22'), name:"Joseph Sargent", bio:"From Wikipedia, the free encyclopedia\n\nJoseph Sargent (born July 22, 1925) is an American film director.  He has directed many television movies, but his best known feature film works are probably White Lightning, MacArthur, Nightmares and Jaws: The Revenge, with his most popular film being The Taking of Pelham One Two Three.  He has won four Emmy Awards.  He is the father of anime dubbing voice actress Lia Sargent...", died:date('2014-12-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dE6fzbXZX1ImRw8gOcuvMNa66g5.jpg", url:"https://themoviedb.org/person/15663"}}, {tmdbId:"80261", properties:{bornIn:"Surrey, England, UK", imdbId:"0362736", born:date('1929-10-10'), name:"Robin Hardy", bio:"Robin Hardy was an English author and film director.  His most famous directorial work was The Wicker Man, and his final project was a film adaptation of his book Cowboys for Christ, which was retitled as The Wicker Tree.  Hardy lived in London and Somerset...", died:date('2016-07-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d2tm32CAjnwij7ueeZRE5qNxCjP.jpg", url:"https://themoviedb.org/person/80261"}}, {tmdbId:"55668", properties:{bornIn:"Boksburg, South Africa", imdbId:"0371059", born:date('1921-05-30'), name:"Jamie Uys", bio:"​From Wikipedia, the free encyclopedia.   \n\nJacobus Johannes Uys (30 May 1921 – 29 January 1996), better known as Jamie Uys, was a South African film director. \n\nDescription above from the Wikipedia article Jamie Uys, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1996-01-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7jFL0M1zvrZZYxeN3jxrZmMvLcD.jpg", url:"https://themoviedb.org/person/55668"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"16544", properties:{bornIn:"Toronto, Canada", imdbId:"0467646", born:date('1931-04-07'), name:"Ted Kotcheff", bio:"From Wikipedia, the free encyclopedia. \n\nTed Kotcheff (born April 7, 1931), sometimes credited as William Kotcheff or William T.  Kotcheff, is a Canadian film and television director, who is well known for his work on several high-profile British television productions and as a director of films such as First Blood. \n\nDescription above from the Wikipedia article Ted Kotcheff, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kbayJIuimvJJUvMBgKWZz3KGjPa.jpg", url:"https://themoviedb.org/person/16544"}}, {tmdbId:"12698", properties:{bornIn:"New Orleans, Louisiana, U.S.", imdbId:"0163706", born:date('1939-08-05'), name:"Bob Clark", bio:"From Wikipedia, the free encyclopedia. \n\nBenjamin \"Bob\" Clark (August 5, 1939 – April 4, 2007) was an American actor, director, screenwriter and producer best known for directing and writing the script with Jean Shepherd to the 1983 Christmas film A Christmas Story...", died:date('2007-04-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Q6xgkXn37OhdzgXQcOh5981B6j.jpg", url:"https://themoviedb.org/person/12698"}}, {tmdbId:"19244", properties:{bornIn:"London, England, UK", imdbId:"0935382", born:date('1935-10-30'), name:"Michael Winner", bio:"Michael  Winner (1935-2013) was a British film director, producer and food critic.  He is perhaps best known for directing several movies starring Charles Bronson, including three of the five Death Wish films...", died:date('2013-01-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hxRlptqgGWLDNf5IxSn7lwkFl2W.jpg", url:"https://themoviedb.org/person/19244"}}, {tmdbId:"38007", properties:{bornIn:"Vichy, Allier, France", imdbId:"0415333", born:date('1940-08-08'), name:"Just Jaeckin", bio:"From Wikipedia, the free encyclopedia. \n\nJust Jaeckin (August 8, 1940, Vichy, Allier) is a French film director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vThqn3MAJBXdGVZG6B49JjmpWj.jpg", url:"https://themoviedb.org/person/38007"}}, {tmdbId:"5561", properties:{bornIn:" Rome, Italy", imdbId:"0546672", born:date('1930-09-19'), name:" Antonio Margheriti", bio:"​From Wikipedia, the free encyclopedia.   \n\nAntonio Margheriti (19 September 1930 – 4 November 2002), also known under the pseudonym Anthony M.  Dawson, was a prolific Italian filmmaker.  He was born in Rome and died in 2002 from a heart attack in Monterosi, Viterbo, near Rome at the age of 72. \n\nMargheriti started out in the Italian film industry in 1956 as a screenwriter.  He started directing in 1960, his first film being \"Spacemen\" (aka \"Assignment Outer Space\")...", died:date('2002-11-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eKjqeCy8eLkC7v3MGGLf8DC031I.jpg", url:"https://themoviedb.org/person/5561"}}, {tmdbId:"82505", properties:{bornIn:"Berlin, Germany", imdbId:"0381638", born:date('1925-12-12'), name:"Gordon Hessler", bio:"​From Wikipedia, the free encyclopedia.   \n\nGordon Hessler (born 12 December 1930 in Berlin, Germany) is a British film and television director, screenwriter, and producer. \n\nHe was raised in England and studied at the University of Reading.  While a teenager, he moved to the United States and directed a series of short films and documentaries.  Universal Studios hired Hessler as a story reader for the Alfred Hitchcock Presents television series...", died:date('2014-01-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vOGFMTg2XQpYR5Nn5AVXEucKPwG.jpg", url:"https://themoviedb.org/person/82505"}}, {tmdbId:"184008", properties:{imdbId:"0203431", name:"Martin Davidson", url:"https://themoviedb.org/person/184008"}}, {tmdbId:"121643", properties:{imdbId:"0894776", name:" Stephen Verona", url:"https://themoviedb.org/person/121643"}}, {tmdbId:"67750", properties:{bornIn:"Carpi, Modena, Emilia-Romagna, Italy", imdbId:"0146960", born:date('1933-01-12'), name:"Liliana Cavani", bio:"​From Wikipedia, the free encyclopedia\n\nLiliana Cavani (born 12 January 1937) is an Italian director and screenwriter, best known for her 1974 feature film Il portiere di notte (The Night Porter) which launched actress Charlotte Rampling to international stardom.  According to the Filmografia di Liliana Cavani, different biographers dispute the year of her birth, however: \"According to the date given by Áine O’Healy (in the Encyclopedia of Italian Literary Studies, 2007, p...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/840kv5t9eE9lW8jnf7o18unPsxd.jpg", url:"https://themoviedb.org/person/67750"}}, {tmdbId:"10051", properties:{bornIn:"Austin, Texas, USA", imdbId:"0001361", born:date('1943-01-25'), name:"Tobe Hooper", bio:"Tobe Hooper (January 25, 1943 – August 26, 2017) was an American film director and screenwriter, best known for his work in the horror film genre.  His works include the cult classic The Texas Chain Saw Massacre (1974), along with its first sequel, The Texas Chainsaw Massacre 2 (1986); the three-time Emmy-nominated Stephen King film adaptation Salem's Lot (1979); and the three-time Academy Award-nominated, Steven Spielberg-produced Poltergeist (1982)...", died:date('2017-08-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rE5TqnAvgaKjWwWZ9AsoU9KcUGU.jpg", url:"https://themoviedb.org/person/10051"}}, {tmdbId:"145797", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0355074", born:date('1933-10-25'), name:"Jack Haley Jr.", bio:"From Wikipedia, the free encyclopedia. \n\nJack Haley, Jr (October 25, 1933 - April 21, 2001) was an American film director, producer and writer, twice winner of the Emmy Award. \n\nHaley was born in Los Angeles, the son of actor Jack Haley and his wife Florence.  He was best known as the director of the 1974 compilation film That's Entertainment! and as the husband of Liza Minnelli, who was the daughter of Haley's father's co-star in The Wizard of Oz, Judy Garland...", died:date('2001-04-21'), url:"https://themoviedb.org/person/145797"}}, {tmdbId:"34262", properties:{bornIn:"Paris, France", imdbId:"0088397", born:date('1939-03-14'), name:"Bertrand Blier", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2xd1VtwC1bEb40udl7TPO05lzrg.jpg", url:"https://themoviedb.org/person/34262"}}, {tmdbId:"210193", properties:{imdbId:"0006621", born:date('1925-09-23'), name:"Jean-Charles Tacchella", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9adH25RXGg8HZtht11YDQ0mWGCN.jpg", url:"https://themoviedb.org/person/210193"}}, {tmdbId:"114518", properties:{bornIn:"Riga, Latvia", imdbId:"0714215", born:date('1937-02-08'), name:"Bill Rebane", bio:"From Wikipedia, the free encyclopedia. \n\nWilliam \"Ito\" Rebane (born February 8, 1937 in Riga, Latvia) is a film director, producer, screenwriter, and author.  He is best known for low budget horror movies such as Monster A Go-Go and The Giant Spider Invasion. \n\nRebane also ran for governor of Wisconsin in 2002 as the American Reform Party candidate.  He had previously run for the position in 1979...", url:"https://themoviedb.org/person/114518"}}, {tmdbId:"1002594", properties:{imdbId:"0396985", name:"Ellen Hovde", url:"https://themoviedb.org/person/1002594"}}, {tmdbId:"2562524", properties:{name:" Muffie Meyer", url:"https://themoviedb.org/person/2562524"}}, {tmdbId:"97646", properties:{bornIn:"Omaha, Nebraska, United States", imdbId:"0798717", born:date('1935-05-24'), name:"Joan Micklin Silver", bio:"Joan Micklin Silver (born May 24, 1935) is an American director. \n\nShe was born in Omaha, Nebraska and received her B. A.  From Sarah Lawrence College. \n\nHer early low budget film Hester Street received Best Actress Oscar nomination for actress Carol Kane.  Her 1977 film Between the Lines was entered into the 27th Berlin International Film Festival.  She is also known for the film Crossing Delancey which was released in 1988 and stars Amy Irving.  She also conceived and directed the musical revue A. . ...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dLF3GSlCHT0PSnA7DaYU85Sl4VU.jpg", url:"https://themoviedb.org/person/97646"}}, {tmdbId:"4955", properties:{bornIn:"Roma, Lazio, Italia", imdbId:"0000783", born:date('1940-09-07'), name:"Dario Argento", bio:"Dario Argento was born in Rome, Italy on September 7 1940.  He is the son of producer Salvatore Argento.  He began his career as a movie critic for the Rome daily newspaper \"Paese Sera\".  A professional screenwriter by the tender age of 20, he joined Bernardo Bertolucci to write the screenplay for Sergio Leone's epic western \"Once Upon A Time In The West\" in 1967...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2WjQlcLxhvmO9NtCfNh2npMVYqp.jpg", url:"https://themoviedb.org/person/4955"}}, {tmdbId:"13484", properties:{bornIn:"Sydney, Australia", imdbId:"0788940", born:date('1945-03-12'), name:"Jim Sharman", bio:"James \"Jim\" Sharman is a director and writer for film and stage with over 70 productions to his credit.  He is renowned in Australia for his work as a theatre director from the 1960s to the present, but is probably best known internationally as the director of the 1973 theatrical hit The Rocky Horror Show, its film adaptation The Rocky Horror Picture Show and the film's follow-up Shock Treatment...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Av2m8wJkKOZnlpedE4YXteTXjLE.jpg", url:"https://themoviedb.org/person/13484"}}, {tmdbId:"85446", properties:{bornIn:"Karachi, Pakistan", imdbId:"0802693", born:date('1947-11-24'), name:"Ramesh Sippy", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AdPZKtCyZTiRLiqg2ZQ5bjo4Ebf.jpg", url:"https://themoviedb.org/person/85446"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"141130", properties:{bornIn:"Nagano Prefecture, Japan", imdbId:"0654725", born:date('1922-08-29'), name:"Shigehiro Ozawa", bio:"Director...", died:date('2004-10-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fwdPrwY0axDRuDuKZQZWptSsqvj.jpg", url:"https://themoviedb.org/person/141130"}}, {tmdbId:"26265", properties:{bornIn:"Rome, Italy", imdbId:"0921631", born:date('1926-08-14'), name:"Lina Wertmüller", bio:"From Wikipedia, the free encyclopedia\n\nLina Wertmüller (born 14 August 1926) is an Italian film writer and director of aristocratic Swiss descent.  In 1976, she became the first woman ever to be nominated for an Academy Award for Directing with the film Seven Beauties. \n\nDescription above from the Wikipedia article Lina Wertmüller, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rgFXiwGq8qCLWGQNl35hJaBRb0V.jpg", url:"https://themoviedb.org/person/26265"}}, {tmdbId:"11770", properties:{bornIn:"Carthage, New York, USA", imdbId:"0000118", born:date('1948-01-16'), name:"John Carpenter", bio:"An American film director, screenwriter, producer, editor, composer, and occasional actor.  Although Carpenter has worked in numerous film genres in his four-decade career, his name is most commonly associated with horror and science fiction.  Most films in Carpenter's career were initially commercial and critical failures, with the notable exceptions of Halloween (1978), The Fog (1980), Escape from New York (1981), and Starman (1984)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3Qp0mg61u1qSZNJh30BFEUZrIMG.jpg", url:"https://themoviedb.org/person/11770"}}, {tmdbId:"68457", properties:{bornIn:"Houston, Texas, USA", imdbId:"0292419", born:date('1936-09-29'), name:"James Frawley", bio:"From Wikipedia, the free encyclopedia. \n\nJames Frawley (born 1937) is an American director and actor.  Frawley was born in Houston, Texas.  He has worked on Smallville, The Ghost Whisperer, Judging Amy and The Monkees, as well as many other programs.  He is the youngest son of actor William Frawley. \n\nDescription above from the Wikipedia article James Frawley, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qMG0tZVWuS2mkLbMSM97JrEJTTm.jpg", url:"https://themoviedb.org/person/68457"}}, {tmdbId:"9168", properties:{bornIn:"Islington, London, England, UK", imdbId:"0000570", born:date('1944-02-14'), name:"Alan Parker", bio:"Sir Alan Parker was a director, writer and producer.  His feature films have won nineteen BAFTA awards, ten Golden Globes and ten Oscars.  His films include Bugsy Malone, Midnight Express, Mississippi Burning, The Commitments, Evita, Fame, Birdy, Angel Heart and Angela’s Ashes.  He was founding chairman of the UK Film Council, a position he held for five years, and prior to that was chairman of the BFI.  Sir Alan received the CBE in 1995 and a knighthood in 2002...", died:date('2020-07-31'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pdpFqPNq4HZiPax1WSMbEDpND2I.jpg", url:"https://themoviedb.org/person/9168"}}, {tmdbId:"66222", properties:{bornIn:"Republic, Washington, USA", imdbId:"0267309", born:date('1938-08-14'), name:"James Fargo", bio:"From Wikipedia, the free encyclopedia. \n\nJames Fargo (born August 14, 1938) is an American film director.  He directed numerous films from 1976 to 1998.  After serving as assistant director on many movies starring Clint Eastwood, he was then given the chance to direct the third Dirty Harry film, The Enforcer, in 1976.  Later he also directed Eastwood in 1978's Every Which Way But Loose.  It would be the final film in working with Eastwood...", url:"https://themoviedb.org/person/66222"}}, {tmdbId:"5602", properties:{bornIn:"Missoula, Montana, USA", imdbId:"0000186", born:date('1946-01-20'), name:"David Lynch", bio:"David Keith Lynch (born January 20, 1946) is an American filmmaker, television director, visual artist, musician and occasional actor.  Known for his surrealist films, he has developed his own unique cinematic style, which has been dubbed \"Lynchian\", and which is characterized by its dream imagery and meticulous sound design.  Indeed, the surreal and in many cases violent elements to his films have earned them the reputation that they \"disturb, offend or mystify\" their audiences...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/b6TnSpuqeOlbq7aHH9G4inmQ1v9.jpg", url:"https://themoviedb.org/person/5602"}}, {tmdbId:"1069525", properties:{imdbId:"0353587", name:"Mark Haggard", url:"https://themoviedb.org/person/1069525"}}, {tmdbId:"22020", properties:{bornIn:"New York City, New York", imdbId:"0465932", born:date('1946-07-30'), name:"Barbara Kopple", bio:"From Wikipedia, the free encyclopedia. \n\nBarbara Kopple (born July 30, 1946) is an American film director, primarily known for her work in documentary film. \n\nDescription above from the Wikipedia article Barbara Kopple, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/22020"}}, {tmdbId:"107276", properties:{imdbId:"0308524", name:"Sergio Garrone", url:"https://themoviedb.org/person/107276"}}, {tmdbId:"29494", properties:{bornIn:"Budapest, Hungary", imdbId:"0004654", born:date('1931-08-17'), name:"Nicolas Gessner", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9wQW9UlBfKqxqKyNOxFNnxB0PCy.jpg", url:"https://themoviedb.org/person/29494"}}, {tmdbId:"7187", properties:{bornIn:"New York City, New York, USA", imdbId:"0001149", born:date('1930-04-24'), name:"Richard Donner", bio:"From Wikipedia, the free encyclopedia. \n\nRichard Donner (born April 24, 1930) is an American film director, film producer, and comic book writer.  The production company The Donners' Company is owned by Donner and his wife, producer Lauren Shuler Donner.  After directing the horror film The Omen, Donner became famous for the hailed creation of the first modern superhero film, Superman, starring Christopher Reeve...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sAXmO0GTe3OuOfUrjxpn7sFH4Wx.jpg", url:"https://themoviedb.org/person/7187"}}, {tmdbId:"13861", properties:{bornIn:"Chappaqua, New York, USA", imdbId:"0682757", born:date('1925-05-12'), name:"Frank Pierson", bio:"Frank Pierson was an American writer, producer and director for film and television, honoured with an Academy Award in the category \"Best Writing, Original Screenplay\" for the movie \"Dog Day Afternoon\".  He was a Harvard graduate with an BA in Cultural Anthropology...", died:date('2012-07-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qB5v6C0gt4wa8tlxcuG90fF0Ye9.jpg", url:"https://themoviedb.org/person/13861"}}, {tmdbId:"52094", properties:{imdbId:"0417054", name:"Jerry Jameson", bio:"​From Wikipedia, the free encyclopedia\n\nJerry Jameson is an American Film Director and Producer. \n\nDescription above from the Wikipedia article Jerry Jameson, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/52094"}}, {tmdbId:"59649", properties:{bornIn:"New York City - New York - USA", imdbId:"0696309", born:date('1950-07-01'), name:"Michael Pressman", bio:"From Wikipedia, the free encyclopedia. \n\nMichael Pressman (born July 1, 1950 in New York City, New York) is an American director and producer of film and television. \n\nSome of the films he has directed are The Great Texas Dynamite Chase (1976), Doctor Detroit (1983), Teenage Mutant Ninja Turtles II: The Secret of the Ooze (1991), To Gillian on Her 37th Birthday (1996)...", url:"https://themoviedb.org/person/59649"}}, {tmdbId:"578", properties:{bornIn:"South Shields, County Durham, England, UK", imdbId:"0000631", born:date('1937-11-30'), name:"Ridley Scott", bio:"Scott was born in South Shields, Tyne and Wear, England, the son of Elizabeth and Colonel Francis Percy Scott.  He was raised in an Army family, meaning that for most of his early life, his father — an officer in the Royal Engineers — was absent.  Ridley's older brother, Frank, joined the Merchant Navy when he was still young and the pair had little contact.  During this time the family moved around, living in (among other areas) Cumbria, Wales and Germany...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zABJmN9opmqD4orWl3KSdCaSo7Q.jpg", url:"https://themoviedb.org/person/578"}}, {tmdbId:"47893", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0625379", born:date('1934-01-01'), name:"Gary Nelson", bio:"An American television and film director.  He has directed many well-know television series, including Gunsmoke, The Patty Duke Show, Gilligan's Island and Happy Days among dozens of others.  In addition, Nelson has directed five films, including two for Walt Disney Pictures.  In 1978, Nelson was nominated for an Emmy for Outstanding Directoral Achievement for Washington: Behind Closed Doors.  He was married to actress Judi Meredith and has two sons...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sE2UvaBWf8qi6v8s4nJwloUxwT7.jpg", url:"https://themoviedb.org/person/47893"}}, {tmdbId:"132305", properties:{bornIn:"Onomichi, Hiroshima Prefecture, Japan", imdbId:"0643171", born:date('1938-01-09'), name:"Nobuhiko Ôbayashi", bio:"From Wikipedia, the free encyclopedia. \n\nNobuhiko Obayashi (January 9, 1938 - April 10, 2020) was a Japanese director, screenwriter and editor of films and television advertisements who is well known for his surreal visual style.  He began his career as a pioneering figure in Japanese experimental film during the 1960s before transitioning to directing more mainstream works such as television and feature films...", died:date('2020-04-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/r0VbfQh53j5ByKVT6xbogfvh24d.jpg", url:"https://themoviedb.org/person/132305"}}, {tmdbId:"24279", properties:{bornIn:"San Miniato, Tuscany, Italy", imdbId:"0851752", born:date('1931-11-08'), name:"Paolo Taviani", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/y4yxmcbHyaxLxxbf3ykpjqjaGHG.jpg", url:"https://themoviedb.org/person/24279"}}, {tmdbId:"24281", properties:{bornIn:"San Miniato, Pisa", imdbId:"0851754", born:date('1929-09-20'), name:" Vittorio Taviani", died:date('2018-04-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gQb8aZQO8K0GicAS8U8808hcbBd.jpg", url:"https://themoviedb.org/person/24281"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"50739", properties:{bornIn:"Roma, Lazio, Italia", imdbId:"0144758", born:date('1938-07-29'), name:"Enzo G. Castellari", bio:"From Wikipedia, the free encyclopedia\n\nEnzo G.  Castellari (born July 29, 1938) is an Italian film director.  He became famous during the 1960s by directing several spaghetti westerns with such titles as Go Kill and Come Back (Vado. . .  l'ammazzo e torno, 1967) , One Dollar Too Many (1968), Seven Winchesters for a Massacre (Sette winchester per un massacro, 1967) and Go Kill Everybody and Come Back Alone (Ammazzali tutti e torna solo, 1968)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jNjMY47EBwLc1k2BKVuMvwofxBK.jpg", url:"https://themoviedb.org/person/50739"}}, {tmdbId:"12840", properties:{bornIn:"Luton, Bedfordshire, England, UK", imdbId:"0000824", born:date('1939-08-25'), name:"John Badham", bio:"From Wikipedia, the free encyclopedia. \n\nJohn MacDonald Badham is an English-born American director of film and television, best known for the films Saturday Night Fever (1977), Blue Thunder (1983), WarGames (1983), Short Circuit (1986), and Stakeout (1987). \n\nBadham worked in television for years, before his breakthrough in 1977 with Saturday Night Fever, a massive worldwide hit starring John Travolta...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hh0EssedcgUOICkZywbVuwVOJO4.jpg", url:"https://themoviedb.org/person/12840"}}, {tmdbId:"72427", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0748928", born:date('1943-12-18'), name:"Alan Rudolph", bio:"Alan Steven Rudolph (born 18 December 1943) is an American film director and screenwriter. \n\nDescription above from the Wikipedia article Alan Rudolph, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AmV3Sr5yN3KCvqL2X6dGZ3hqGjS.jpg", url:"https://themoviedb.org/person/72427"}}, {tmdbId:"239180", properties:{bornIn:"Brooklyn, New York City, New York, USA", imdbId:"0715485", born:date('1933-12-20'), name:"Joel M. Reed", bio:"From Wikipedia, the free encyclopedia. \n\nJoel M.  Reed is an American film director, producer and writer. \n\nReed is best known for directing the controversial Blood Sucking Freaks.  Blood Sucking Freaks was a notorious horror comedy that has since achieved cult status but upon its initial release was the subject of protests. \n\nReed is also known for the films The G. I.  Executioner, Career Bed, Blood Bath, and Night of the Zombies...", died:date('2020-04-12'), url:"https://themoviedb.org/person/239180"}}, {tmdbId:"24380", properties:{bornIn:"Bordeaux, France", imdbId:"0596850", born:date('1928-05-13'), name:"Édouard Molinaro", bio:"He was born in Bordeaux, Gironde. \n\nHe is best known for his comedies with Louis de Funès (Oscar, etc. ), My Uncle Benjamin (with Jacques Brel and Claude Jade), Dracula and Son (with Christopher Lee), and the Academy Award-nominated La Cage aux Folles (with Michel Serrault and Ugo Tognazzi).  Molinaro was active as a director until a few years before his death, although he had almost exclusively been producing works for television...", died:date('2013-12-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i0TSDPTyO2ZUFE1Ornrp5ioV8Pw.jpg", url:"https://themoviedb.org/person/24380"}}, {tmdbId:"10930", properties:{bornIn:"Philadelphia, Pennsylvania, USA", imdbId:"0449984", born:date('1923-04-29'), name:"Irvin Kershner", bio:"​From Wikipedia, the free encyclopedia.   \n\nIrvin Kershner (April 29, 1923 – November 27, 2010) was an American film director and occasional actor, best known for directing quirky, independent films early in his career, and then Star Wars Episode V: The Empire Strikes Back. \n\nDescription above from the Wikipedia article Irvin Kershner , licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2010-11-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/imtFUtcASoh2e1Emtt62UuFkIWA.jpg", url:"https://themoviedb.org/person/10930"}}, {tmdbId:"72172", properties:{imdbId:"0777291", name:"John Alan Schwartz", url:"https://themoviedb.org/person/72172"}}, {tmdbId:"56381", properties:{bornIn:"New York City, New York, USA", imdbId:"0864812", born:date('1944-11-23'), name:"James Toback", bio:"​From Wikipedia, the free encyclopedia. \n\nJames Lee Toback  (born November 23, 1944) is an American screenwriter and film director...", url:"https://themoviedb.org/person/56381"}}, {tmdbId:"16411", properties:{bornIn:"New York City", imdbId:"0710230", born:date('1924-07-19'), name:" Arthur Rankin Jr.", bio:"From Wikipedia, the free encyclopedia. \n\nArthur Rankin, Jr.  (born July 19, 1924 in New York City) is an American-born, Bermudian director, producer and writer, mostly working in animation. \n\nThe son of actor Arthur Rankin, in the early 1960s he founded the film production company Videocraft International (now called Rankin/Bass) with Jules Bass...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ea8EC04C9VhDd0iMpIyCmZHnMak.jpg", url:"https://themoviedb.org/person/16411"}}, {tmdbId:"93410", properties:{imdbId:"0953392", name:"Meir Zarchi", url:"https://themoviedb.org/person/93410"}}, {tmdbId:"110922", properties:{bornIn:"Riverside - California - USA", imdbId:"0943044", born:date('1934-09-24'), name:"Donald Wrye", died:date('2015-05-15'), url:"https://themoviedb.org/person/110922"}}, {tmdbId:"164641", properties:{imdbId:"0434211", name:"George Kaczender", url:"https://themoviedb.org/person/164641"}}, {tmdbId:"648", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0442241", born:date('1936-10-23'), name:"Philip Kaufman", bio:"Philip Kaufman (born October 23, 1936) is an American film director and screenwriter.  Although not noted for directing a large number of films, the films he has worked on have been recognized for their intelligence and independence.  He is noted for directing films of eclectic subjects, ranging from realism to fantasy, and often incorporating satire or subtle humor as part of his “artistic signature. ” He was born in Chicago, Illinois.   Kaufman has been considered a “risk taker...", url:"https://themoviedb.org/person/648"}}, {tmdbId:"16187", properties:{bornIn:" Paris, France", imdbId:"0844358", born:date('1939-11-21'), name:"Jeannot Szwarc", bio:"​From Wikipedia, the free encyclopedia. \n\nJeannot Szwarc (born 21 November 1939) is a French film director.  Szwarc was born in Paris.  He began working as a director in US television during the 1960s, in particular on Ironside.  He is also associated with The Rockford Files, Kojak, Night Gallery, JAG, Bones, Numb3rs, and Columbo.  His feature films include Bug (1975), Jaws 2 (1978), Somewhere in Time (1980), Supergirl (1984), and Santa Claus: The Movie (1985)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aiyRwN4gCQbmJVrBSGK1ZsIpQUH.jpg", url:"https://themoviedb.org/person/16187"}}, {tmdbId:"1018959", properties:{bornIn:"Winnipeg, Manitoba, Canada", imdbId:"0280691", born:date('1947-06-15'), name:"Robert S. Fiveson", url:"https://themoviedb.org/person/1018959"}}, {tmdbId:"2648917", properties:{name:"Chia-Liang Liu", url:"https://themoviedb.org/person/2648917"}}, {tmdbId:"40187", properties:{imdbId:"0723629", name:"David Lowell Rich", url:"https://themoviedb.org/person/40187"}}, {tmdbId:"10249", properties:{bornIn:"Wiesbaden, Germany", imdbId:"0772522", born:date('1939-03-31'), name:"Volker Schlöndorff", bio:"Volker Schlöndorff is a Berlin-based German filmmaker.  He won an Oscar as well as the Palme d'or at the 1979 Cannes Film Festival for The Tin Drum (1979), the film version of the novel by Nobel Prize-winning author Günter Grass.  In 1991, he was the Head of the Jury at the 41st Berlin International Film Festival.  Schlöndorff has adapted many literary works for his movies, including some critically well-received US productions, but he is also engaged in post-war German politics...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sin8gep9PEL3DDOzszOWKOqCwCO.jpg", url:"https://themoviedb.org/person/10249"}}, {tmdbId:"45572", properties:{bornIn:"Potenza, Basilicata, Italy", imdbId:"0219959", born:date('1939-05-07'), name:"Ruggero Deodato", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/75rYAmAgE4Ga5KxQvgGiZWFHRve.jpg", url:"https://themoviedb.org/person/45572"}}, {tmdbId:"84657", properties:{bornIn:"New York City, New York, USA", imdbId:"0137573", born:date('1932-01-01'), name:"Lewis John Carlino", bio:"From Wikipedia, the free encyclopedia. \n\nLewis John Carlino is best known as the director of The Great Santini starring Robert Duvall, Blythe Danner and Michael O'Keefe.  He has worked as a director and screenwriter on a number of movies during a career which has spanned five decades and includes such works as The Fox, The Brotherhood, I Never Promised You a Rose Garden, Resurrection, The Mechanic, and The Sailor Who Fell from Grace with the Sea...", url:"https://themoviedb.org/person/84657"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"1129542", properties:{imdbId:"0801780", name:"Gerald Seth Sindell", url:"https://themoviedb.org/person/1129542"}}, {tmdbId:"8858", properties:{bornIn:"Komárno, Czechoslovakia [now Slovak Republic]", imdbId:"0718645", born:date('1946-10-27'), name:"Ivan Reitman", bio:"​From Wikipedia, the free encyclopedia. \n\nIvan Reitman, OC (born October 27, 1946) is a Canadian film producer and director.  He is known for the comedies he has directed and produced, especially in the 1980s and 1990s. \n\nHe is the owner of The Montecito Picture Company, founded in 2000...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qMyAjmRVihGFbJPhMTsqvpeOKfX.jpg", url:"https://themoviedb.org/person/8858"}}, {tmdbId:"58245", properties:{bornIn:"Tripoli, Libya", imdbId:"0181741", born:date('1954-02-17'), name:"Don Coscarelli", bio:"From Wikipedia, the free encyclopedia.   \n\nDon Coscarelli (born February 17, 1954) is an American film director, producer and screenwriter best known for horror films.  His credits include the Phantasm series, The Beastmaster, and Bubba Ho-Tep. \n\nDescription above from the Wikipedia article Don Coscarelli , licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4aeuE7CzT2Inrq4cZyKpCyucXdo.jpg", url:"https://themoviedb.org/person/58245"}}, {tmdbId:"38585", properties:{bornIn:"Roma", imdbId:"0320946", born:date('1914-02-01'), name:"Marino Girolami", died:date('1994-02-20'), url:"https://themoviedb.org/person/38585"}}, {tmdbId:"4600", properties:{bornIn:"Morristown, New Jersey, USA", imdbId:"0001102", born:date('1946-11-28'), name:" Joe Dante", bio:"Joseph \"Joe\" Dante, Jr.  is an American film director and producer of films generally with humorous and science fiction content...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AghJPGRamlgJCPJYgX92Utehcak.jpg", url:"https://themoviedb.org/person/4600"}}, {tmdbId:"29433", properties:{bornIn:"Rome, Italy", imdbId:"0002086", born:date('1927-06-17'), name:"Lucio Fulci", bio:"Lucio Fulci (17 June 1927 – 13 March 1996) was an Italian film director, screenwriter, producer and actor. \n\nAlthough he worked in a wide array of genres through a career spanning nearly five decades, including comedy, Spaghetti Western, adventure, science fiction and erotica, he garnered an international cult following for his giallo and horror films...", died:date('1996-03-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iD0pHMUN5tQkuOZAG8NX6LUAGFB.jpg", url:"https://themoviedb.org/person/29433"}}, {tmdbId:"1870930", properties:{name:"Glenn Silber", url:"https://themoviedb.org/person/1870930"}}, {tmdbId:"5289", properties:{bornIn:"Warrington, UK", imdbId:"0113084", born:date('1960-11-28'), name:" Barry Alexander Brown", bio:"Barry Alexander Brown is an English born-American film director and editor.  As a film editor, he is best known for collaborations with film director Spike Lee, editing some of Lee's best known films including Do the Right Thing, Malcolm X, He Got Game, 25th Hour, Inside Man, and BlacKkKlansman...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rSFpYvWaBONyOhveFnEx0I56zOx.jpg", url:"https://themoviedb.org/person/5289"}}, {tmdbId:"12936", properties:{bornIn:"Shorewood, Wisconsin, USA", imdbId:"0000720", born:date('1944-05-10'), name:"Jim Abrahams", bio:"​From Wikipedia, the free encyclopedia. \n\nJim Abrahams  (born 10 May 1944) is an American movie director and writer.  Abrahams was born in Shorewood, Wisconsin, to a Jewish family, and attended Shorewood High School. [1] He is known for the spoof movies that he co-wrote and produced with brothers Jerry Zucker and David Zucker, such as Airplane! (for which he was nominated for a BAFTA Award for Best Screenplay) and The Naked Gun series...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/22B24mvWEkorhoxEOPCxNcYdcTX.jpg", url:"https://themoviedb.org/person/12936"}}, {tmdbId:"3415", properties:{bornIn:"Milwaukee, Wisconsin, U.S.", imdbId:"0958387", born:date('1950-03-11'), name:" Jerry Zucker", bio:"Jerry Zucker is an American movie director known for his role in directing comedy spoof films, and the hit film Ghost. \n\nZucker was born in Milwaukee, Wisconsin, the son of Charlotte (d.  2007) and Burton Zucker, who was a real estate developer.  He graduated from Shorewood High School...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iSzdnge16GBKLkBoTM4mqUIWIxi.jpg", url:"https://themoviedb.org/person/3415"}}, {tmdbId:"21819", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0853546", born:date('1938-03-08'), name:"Lewis Teague", bio:"Lewis Teague (born 8 March 1938 in Brooklyn, New York) is a film director, whose work includes Alligator, Cat's Eye, Cujo, The Dukes of Hazzard: Reunion!, Navy SEALs and The Triangle.  He apprenticed with Sydney Pollack at Universal Television, and was a production manager on the rock concert documentary Woodstock (1970)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jZt7b3bE7WODnLDJ1vKGoM4fTOb.jpg", url:"https://themoviedb.org/person/21819"}}, {tmdbId:"66226", properties:{imdbId:"0887174", born:date('1929-08-20'), name:"Buddy Van Horn", bio:"From Wikipedia, the free encyclopedia\n\nBuddy Van Horn (b.  August 20, 1929) is a Hollywood stunt coordinator.  A long-time stunt double for Clint Eastwood, he directed such Eastwood films as Any Which Way You Can, The Dead Pool, and Pink Cadillac.  He doubled for Gregory Peck and Guy Williams on Disney's Zorro and, more recently, on the 2004 Oscar-winning Best Picture Million Dollar Baby, directed by Eastwood...", url:"https://themoviedb.org/person/66226"}}, {tmdbId:"22353", properties:{imdbId:"0207357", born:date('1952-01-01'), name:"John De Bello", url:"https://themoviedb.org/person/22353"}}, {tmdbId:"58021", properties:{bornIn:"Milan, Lombardy, Italy", imdbId:"0000972", born:date('1933-03-26'), name:"Tinto Brass", bio:"Giovanni Brass better known as Tinto Brass, is an Italian filmmaker.  He is noted especially for his work in the erotic genre, with films such as Così fan tutte (released under the English title All Ladies Do It), Paprika, Monella (Frivolous Lola) and Trasgredire.  On Sunday, 18 April 2010, he suffered an intracranial hemorrhage...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/80Uuq79rcYL1FgBPHAEHzAACQFa.jpg", url:"https://themoviedb.org/person/58021"}}, {tmdbId:"58022", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0345579", born:date('1930-12-17'), name:" Bob Guccione", bio:"Robert Charles Joseph Edward Sabatini Guccione (December 17, 1930 – October 20, 2010) was an American photographer and the founder of the adult magazine Penthouse in 1965.  This was aimed at competing with Hugh Hefner's Playboy, but with more extreme erotic content, a special style of soft-focus photography, and in-depth reporting of government corruption scandals.  By 1982 Guccione was listed in the Forbes 400 wealth list, and owned one of the biggest mansions in Manhattan...", died:date('2010-10-20'), url:"https://themoviedb.org/person/58022"}}, {tmdbId:"1458870", properties:{imdbId:"0525319", name:" Giancarlo Lui", url:"https://themoviedb.org/person/1458870"}}, {tmdbId:"47503", properties:{imdbId:"0908055", born:date('1922-05-10'), name:"Nancy Walker", died:date('1992-03-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6ifidaJPTm9pDuVjEnqRsifnlgR.jpg", url:"https://themoviedb.org/person/47503"}}, {tmdbId:"1022680", properties:{imdbId:"0443445", name:"Robert Kaylor", url:"https://themoviedb.org/person/1022680"}}, {tmdbId:"1229721", properties:{imdbId:"0000713", born:date('1935-10-11'), name:"Joel Oliansky", died:date('2002-07-29'), url:"https://themoviedb.org/person/1229721"}}, {tmdbId:"127614", properties:{bornIn:" Los Angeles, California, USA", imdbId:"0253320", born:date('1949-03-06'), name:"Richard Elfman", url:"https://themoviedb.org/person/127614"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"35475", properties:{bornIn:"New York City, New York, USA", imdbId:"0192446", born:date('1941-12-31'), name:"Sean S. Cunningham", bio:"From Wikipedia, the free encyclopedia. \n\nSean Sexton Cunningham (born December 31, 1941, in New York City) is an American film director, producer, and writer.  He is best known for creating the Friday the 13th series of horror films, which introduced the fictional killer Jason Voorhees.  He also produced many horror films, such as Wes Craven's debut feature and House film series. \n\nDescription above from the Wikipedia article Sean S...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kPELY44haoAnj0D7dxAo3jDsCmU.jpg", url:"https://themoviedb.org/person/35475"}}, {tmdbId:"152000", properties:{imdbId:"0545169", born:date('1942-06-10'), name:"Terry Marcel", url:"https://themoviedb.org/person/152000"}}, {tmdbId:"67834", properties:{imdbId:"0616152", born:date('1941-06-24'), name:"Floyd Mutrux", bio:"​From Wikipedia, the free encyclopedia.   \n\nFloyd Mutrux (born June 21, 1941) is an American stage and film director, writer, producer, and screenwriter. \n\nDescription above from the Wikipedia article Floyd Mutrux, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/67834"}}, {tmdbId:"44765", properties:{bornIn:"The Bronx, New York, USA", imdbId:"0527350", born:date('1955-02-01'), name:"William Lustig", bio:"From Wikipedia, the free encyclopedia\n\nWilliam Lustig (born February 1, 1955 in The Bronx, New York), also known as Bill Lustig, is an American film director and producer who has worked primarily in the horror film genre. \n\nDescription above from the Wikipedia article William Lustig,licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pMNLUxnqBJrNlZYW5FFosOycoKU.jpg", url:"https://themoviedb.org/person/44765"}}, {tmdbId:"57922", properties:{bornIn:"New York, New York, U.S", imdbId:"0087861", born:date('1928-01-07'), name:"William Peter Blatty", died:date('2017-01-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5AWZXT3hBhM6M5NbiGmC3cPFAVC.jpg", url:"https://themoviedb.org/person/57922"}}, {tmdbId:"552212", properties:{imdbId:"0772431", name:" Julian Schlossberg", url:"https://themoviedb.org/person/552212"}}, {tmdbId:"108129", properties:{imdbId:"0254527", name:"Lang Elliott", url:"https://themoviedb.org/person/108129"}}, {tmdbId:"102445", properties:{bornIn:"Schenectady, New York, USA", imdbId:"0000626", born:date('1950-09-28'), name:"John Sayles", bio:"From Wikipedia, the free encyclopedia\n\nJohn Thomas Sayles (born September 28, 1950) is an American independent film director, screenwriter and author. \n\nDescription above from the Wikipedia article John Sayles, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rrpKYYsCYaAddfjNgUv3KRbkWpV.jpg", url:"https://themoviedb.org/person/102445"}}, {tmdbId:"51760", properties:{imdbId:"0004105", born:date('1932-02-24'), name:"Jay Sandrich", url:"https://themoviedb.org/person/51760"}}, {tmdbId:"18878", properties:{bornIn:"Cornwall, New York, USA", imdbId:"0003418", born:date('1949-03-12'), name:"Rob Cohen", bio:"Rob Cohen is an American film director, writer and producer, best known as the creator of Universal Pictures' The Fast and the Furious movie franchise.  He's a graduate in Anthropology and Visual Studies from Harvard University, Cambridge, Massachusetts, USA...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qMtAaURL6aE3GgALVQlxKGGL5AC.jpg", url:"https://themoviedb.org/person/18878"}}, {tmdbId:"101108", properties:{bornIn:"Roma", imdbId:"0210130", born:date('1929-06-12'), name:"Alberto De Martino", died:date('2015-06-02'), url:"https://themoviedb.org/person/101108"}}, {tmdbId:"24", properties:{bornIn:"Chicago, Illinois, USA ", imdbId:"0000709", born:date('1952-05-14'), name:"Robert Zemeckis", bio:"Robert Lee Zemeckis is an American film director, producer and screenwriter.  Zemeckis first came to public attention in the 1980s as the director of the comedic time-travel Back to the Future film series, as well as the Academy Award-winning live-action/animation epic Who Framed Roger Rabbit (1988), though in the 1990s he diversified into more dramatic fare, including 1994's Forrest Gump, for which he won an Academy Award for Best Director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4tWfclPQ3WAUwotZl2hIneQwWXR.jpg", url:"https://themoviedb.org/person/24"}}, {tmdbId:"142594", properties:{bornIn:"Tampa, Florida, USA", imdbId:"0087511", born:date('1935-11-27'), name:"Les Blank", bio:"From Wikipedia, the free encyclopedia.    \n\nLes Blank (b.  27 November 1935, Tampa, Florida, United States) is an American documentary filmmaker best known for his portraits of American traditional musicians. \n\nBlank attended Tulane University in New Orleans, where he received a B. A.  in English literature and an M. F. A.  in theater.  He had also studied communications at the University of Southern California...", died:date('2013-04-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4OmIKGuTHiHY5HqSMCfZnbwq4j8.jpg", url:"https://themoviedb.org/person/142594"}}, {tmdbId:"1254", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0513165", name:"Art Linson", bio:"From Wikipedia, the free encyclopedia\n\nArt Linson (born 1942) is an American film producer, director and screenwriter. \n\nHe was born in Chicago, Illinois.  His directorial debut was the 1980 comedy, Where the Buffalo Roam, which was loosely based on stories by Hunter S.  Thompson and starred Bill Murray as the writer.  He also directed 1984's The Wild Life...", url:"https://themoviedb.org/person/1254"}}, {tmdbId:"51521", properties:{bornIn:"New York City, U.S.", imdbId:"0339254", born:date('1945-08-28'), name:"Robert Greenwald", bio:"​From Wikipedia, the free encyclopedia.   \n\nRobert Greenwald (born August 28, 1945) is an American film director, film producer, and political activist, noted in the 2000s for his documentaries critical of Fox News and of the George W.  Bush administration, as well as numerous award-winning television movies from the 1980s and 1990s. \n\nDescription above from the Wikipedia article Robert Greenwald, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/51521"}}, {tmdbId:"8844", properties:{bornIn:"Miami, Florida, USA", imdbId:"0001410", born:date('1949-01-14'), name:"Lawrence Kasdan", bio:"From Wikipedia, the free encyclopedia.   \n\nLawrence Edward \"Larry\" Kasdan (born January 14, 1949) is an American film producer, director and screenwriter.  He is best known as co-writer of the films The Empire Strikes Back, Raiders of the Lost Ark, and Return of the Jedi.  Kasdan co-wrote the Star Wars sequel trilogy film Star Wars: The Force Awakens, and will co-write the series' Han Solo spin-off film...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hZAQC6MLyR1oLHRKEZ1oUEvh0Sy.jpg", url:"https://themoviedb.org/person/8844"}}, {tmdbId:"5231", properties:{bornIn:"Emden, Germany", imdbId:"0000583", born:date('1941-03-14'), name:"Wolfgang Petersen", bio:"​From Wikipedia, the free encyclopedia. \n\nWolfgang Petersen  (born 14 March 1941) is a German film director and screenwriter.  His films include The NeverEnding Story, Enemy Mine, Outbreak, In the Line of Fire, Air Force One, The Perfect Storm, Troy, and Poseidon.  He was nominated for two Academy Awards for the 1981 World War II submarine warfare film Das Boot...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/whnyJpavNvYOqylpgMXZ1ocsOId.jpg", url:"https://themoviedb.org/person/5231"}}, {tmdbId:"70415", properties:{bornIn:"London, England, UK", imdbId:"0562699", born:date('1943-05-26'), name:"Tony Maylam", bio:"​From Wikipedia, the free encyclopedia\n\nTony Maylam (1943) is an English-born filmmaker for cinema and television. \n\nDescription above from the Wikipedia article Tony Maylam, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/70415"}}, {tmdbId:"20556", properties:{bornIn:"Lyon, Rhône, France", imdbId:"0851724", born:date('1941-04-25'), name:"Bertrand Tavernier", bio:"Bertrand Tavernier is a French director, screenwriter, actor and producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e0TVSBL8cTiw2Uc5CE5uiPi6GrL.jpg", url:"https://themoviedb.org/person/20556"}}, {tmdbId:"51516", properties:{bornIn:"Timmins, Ontario, Canada", imdbId:"0827854", born:date('1937-11-01'), name:"Steven Hilliard Stern", bio:"​From Wikipedia, the free encyclopedia\n\nSteven Hilliard Stern (born in Timmins, Ontario, Canada on 1 November 1937) is a Canadian television and documentary director, producer and writer.  He attended the Ryerson University's Institute of Technology and served in the Canadian Infantry before inaugurating his directing career.  The bulk of Stern's output has been in the field of made-for-TV movies, both in the United States and Canada.  Some film credits may appear as Steve Stern and Steven H...", url:"https://themoviedb.org/person/51516"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"37451", properties:{bornIn:" Paris, France", imdbId:"0000894", born:date('1946-10-08'), name:"Jean-Jacques Beineix", url:"https://themoviedb.org/person/37451"}}, {tmdbId:"19800", properties:{bornIn:"Cardiff, Wales, UK", imdbId:"0549658", born:date('1937-09-22'), name:"Richard Marquand", bio:"Richard Marquand was a Welsh film director best known for directing the blockbuster Star Wars film, Star Wars Episode VI: Return of the Jedi (1983)...", died:date('1987-09-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eEalDQpLsXJqejPDQ3MWGe95UHT.jpg", url:"https://themoviedb.org/person/19800"}}, {tmdbId:"167786", properties:{imdbId:"0080601", born:date('1942-04-24'), name:"Ed Bianchi", url:"https://themoviedb.org/person/167786"}}, {tmdbId:"58712", properties:{bornIn:"Westport, Connecticut, USA", imdbId:"0591171", born:date('1951-06-18'), name:"Steve Miner", bio:"Stephen C.  \"Steve\" Miner is an American film and television director.  Miner was born in Westport, Connecticut.  Television programs Miner have directed include The Wonder Years, Jake 2. 0, Felicity, Dawson's Creek (including the pilot and four of the other episodes of the first season), and Diagnosis: Murder.  However, Miner first made his big splash as an associate-producer on the 1980 hit, Friday the 13th...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c1Hh9siM4OnpDp3C6qCtYqcD8Oy.jpg", url:"https://themoviedb.org/person/58712"}}, {tmdbId:"102334", properties:{imdbId:"0163736", name:"Bruce D. Clark", url:"https://themoviedb.org/person/102334"}}, {tmdbId:"33341", properties:{bornIn:"New York City, New York, USA", imdbId:"0742819", born:date('1949-06-15'), name:"Rick Rosenthal", bio:"​From Wikipedia, the free encyclopedia.   \n\nRichard L.  \"Rick\" Rosenthal, Jr.  (born June 15, 1949) is an American film and television director.  He is also a producer, actor, and writer. \n\nDescription above from the Wikipedia article Rick Rosenthal, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wObA3tDXNPNnz7UQrIuFTkIZmvI.jpg", url:"https://themoviedb.org/person/33341"}}, {tmdbId:"70616", properties:{bornIn:"London, England, UK", imdbId:"0693376", born:date('1931-03-08'), name:"Gerald Potterton", bio:"From Wikipedia, the free encyclopedia. \n\nGerald Potterton (born March 8, 1931) is a British/Canadian director, producer and animator.  He is best known for directing the cult classic Heavy Metal and his animation work on Yellow Submarine. \n\nPotterton has been nominated three times for an Academy Award for Best Animated Short Film: as director on the National Film Board of Canada animated shorts My Financial Career and Christmas Cracker, and as producer for The Selfish Giant...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/g2k5PGQpNP8oEhjY8i6IzynbgYP.jpg", url:"https://themoviedb.org/person/70616"}}, {tmdbId:"930633", properties:{bornIn:"Kansas City, Missouri, USA ", imdbId:"0293989", born:date('1906-08-21'), name:"Friz Freleng", bio:"Isadore \"Friz\" Freleng, sometimes credited as I.  Freleng, was an American animator, cartoonist, director, and producer best known for his work on the Looney Tunes and Merrie Melodies series of cartoons from Warner Bros.  He introduced and/or developed several of the studio's biggest stars, including Bugs Bunny, Porky Pig, Tweety Bird, Sylvester the cat, Yosemite Sam (to whom he was said to bear more than a passing resemblance) and Speedy Gonzales...", died:date('1995-05-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bdaKcuiKHtT633KEQbAwb2Ely5u.jpg", url:"https://themoviedb.org/person/930633"}}, {tmdbId:"225898", properties:{bornIn:"Budapest, Hungary", imdbId:"5697473", born:date('1938-02-18'), name:"István Szabó", bio:"From Wikipedia, the free encyclopedia\n\nIstván Szabó (born 18 February 1938, Budapest) is a Hungarian film director. \n\nDescription above from the Wikipedia article István Szabó, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xoKtSZvgW3rp6YfFzxQk8bhc7nI.jpg", url:"https://themoviedb.org/person/225898"}}, {tmdbId:"100807", properties:{imdbId:"0685034", born:date('1935-02-16'), name:"Juan Piquer Simón", died:date('2011-01-08'), url:"https://themoviedb.org/person/100807"}}, {tmdbId:"2710", properties:{bornIn:"Kapuskasing, Ontario, Canada", imdbId:"0000116", born:date('1954-08-16'), name:"James Cameron", bio:"James Cameron was born in Kapuskasing, Ontario, Canada, on August 16, 1954.  He moved to the USA in 1971.  The son of an engineer, he majored in physics at California State University but, after graduating, drove a truck to support his screen-writing ambition...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9NAZnTjBQ9WcXAQEzZpKy4vdQto.jpg", url:"https://themoviedb.org/person/2710"}}, {tmdbId:"103129", properties:{bornIn:"Alexandria, Egypt", imdbId:"0039890", born:date('1943-01-18'), name:" Ovidio G. Assonitis", bio:"​From Wikipedia, the free encyclopedia.   \n\nOvidio Assonitis (born on January 18, 1943 in Alexandria, Egypt) is an independent film producer and businessman with over 35 years of experience in the entertainment industry. \n\nDescription above from the Wikipedia article Ovidio Assonitis,   licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/103129"}}, {tmdbId:"40542", properties:{bornIn:"Buenos Aires City, Buenos Aires, Argentina", imdbId:"0002199", born:date('1946-02-07'), name:"Hector Babenco", bio:"Héctor Eduardo Babenco (born February 7, 1946 in Buenos Aires but raised in Mar del Plata) was an Argentine-born Brazilian film director, screenwriter, producer and actor.  He has worked in several countries including Argentina, Brazil and the United States...", died:date('2016-07-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5VRnOXoHU2FoMBwy2HhJ7FBGksQ.jpg", url:"https://themoviedb.org/person/40542"}}, {tmdbId:"32082", properties:{bornIn:"Lviv, Poland (Ukraine)", imdbId:"0958558", born:date('1940-11-22'), name:"Andrzej Zulawski", bio:"Andrzej Żuławski (November 22, 1940 – February 17, 2016) was a Polish film director.  He was born in Lwów, Poland (now Lviv, Ukraine).  Żuławski often went against mainstream commercialism in his films, and enjoyed success mostly with European art-house audiences.  In the late 1950s, he studied cinema in France.  His second feature The Devil (1972) was banned in Poland, and Żuławski went to France...", died:date('2016-02-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3mZEly1H2hoFNMxJDa9hh5ER0oA.jpg", url:"https://themoviedb.org/person/32082"}}, {tmdbId:"18563", properties:{bornIn:"Nice, Alpes-Maritimes, Provence-Alpes-Côte d'Azur, France", imdbId:"0491626", born:date('1926-01-24'), name:"Georges Lautner", bio:"Georges Lautner (24 January 1926 – 22 November 2013) was a French film director and screenwriter, known primarily for his comedies created in collaboration with screenwriter Michel Audiard. \n\nLautner's ventures into other genres were less successful though the thriller Le Professionnel starring Jean-Paul Belmondo was a big commercial hit in France in 1981. \n\nHe was born in Nice, the son of actress Renée Saint-Cyr...", died:date('2013-11-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9eX5ACCAv7nroWLValxB5qxgUt7.jpg", url:"https://themoviedb.org/person/18563"}}, {tmdbId:"5632", properties:{bornIn:"Canton, Illinois, U.S.", imdbId:"0279926", born:date('1945-12-19'), name:"Jack Fisk", bio:"From Wikipedia, the free encyclopedia. \n\nJack Fisk (born December 19, 1945) is an American movie industry professional, frequently working as either a production designer or art director on Hollywood movies. \n\nFisk met Sissy Spacek when working on Terrence Malick's 1973 movie Badlands.  The couple married on April 12, 1974; their daughter Schuyler Fisk is also an actress. \n\nFisk was art director on Brian De Palma's Carrie (1976), in which Spacek stars...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5T0M4HdNTKkTzY7kkNYIotegJtq.jpg", url:"https://themoviedb.org/person/5632"}}, {tmdbId:"41550", properties:{bornIn:"Queens, New York City, New York, USA", imdbId:"0000921", born:date('1945-02-20'), name:"Andrew Bergman", bio:"From Wikipedia, the free encyclopedia. \n\nAndrew Bergman (20 February 1945) is an American screenwriter, film director, and novelist.  New York magazine in 1985 dubbed him \"The Unknown King of Comedy\". \n\nHe graduated from Binghamton University and earned a Ph. D.  in American history from the University of Wisconsin.  His dissertation, a study of Depression-era Hollywood films, was published in 1971 by NYU Press under the title We're In the Money: Depression America and Its Films...", url:"https://themoviedb.org/person/41550"}}, {tmdbId:"108128", properties:{imdbId:"0502422", name:"Malcolm Leo", url:"https://themoviedb.org/person/108128"}}, {tmdbId:"140354", properties:{bornIn:"Antwerp, Belgium", imdbId:"0343260", born:date('1929-01-09'), name:"Ulu Grosbard", bio:"From Wikipedia, the free encyclopedia\n\nUlu Grosbard (born 9 January 1929) is a Belgian-born, naturalized American theatre and film director and film producer. \n\nBorn in Antwerp, Grosbard emigrated to Havana with his family in 1942.  In 1948, they moved to the United States, where he earned Bachelor of Arts and Master of Arts degrees from the University of Chicago...", died:date('2012-03-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hqTLWKs9oyQA8nKgZPnQH5NnkoQ.jpg", url:"https://themoviedb.org/person/140354"}}, {tmdbId:"236545", properties:{bornIn:"Stockholm, Stockholms län, Sweden", imdbId:"0180260", born:date('1938-11-08'), name:"Jonas Cornell", bio:"Bengt Henrik Jonas Cornell is a Swedish stage and screen director, writer and producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o3DyGf6BnERgdvK4cJUhtGnTev4.jpg", url:"https://themoviedb.org/person/236545"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"27746", properties:{imdbId:"0277946", name:"Ken Finkleman", url:"https://themoviedb.org/person/27746"}}, {tmdbId:"35256", properties:{bornIn:"Pasiano di Pordenone, Friuli, Italy", imdbId:"0198765", born:date('1922-07-23'), name:"Damiano Damiani", bio:"From Wikipedia, the free encyclopedia.   Damiano Damiani (born 23 July 1922) is an Italian screenwriter, film director, actor and writer.  He was born in Pasiano di Pordenone, Friuli. \n\nDescription above from the Wikipedia article Damiano Damiani, licensed under CC-BY-SA,full list of contributors on Wikipedia...", died:date('2013-03-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4auovOZubl6v6wM37heY2X1a5qq.jpg", url:"https://themoviedb.org/person/35256"}}, {tmdbId:"96445", properties:{imdbId:"0516363", name:"Jayne Loader", bio:"From Wikipedia, the free encyclopedia. \n\nJayne Loader (born 1951) is an American director and writer.  She co-directed The Atomic Cafe (1982) with Pierce Rafferty and Kevin Rafferty.  She is the author of Between Pictures (1986, ISBN 0-312-91345-1), a novel, and Wild America (1989, ISBN 0-8021-1106-8), a collection of short stories.  In 1995, Jayne created the CD-ROM and Website Public Shelter.  From 1995 - 1997, she wrote World Wide Wench, one of the first blogs...", url:"https://themoviedb.org/person/96445"}}, {tmdbId:"96447", properties:{imdbId:"0706274", name:" Pierce Rafferty", bio:"From Wikipedia, the free encyclopedia. \n\nFilmmaker Pierce Rafferty (born 1952) grew up in Connecticut and moved to New York City in 1982.  Some of his relatives include grandfather Marvin Pierce, president and later chairman of McCall Corporation, the publisher of the popular women's magazines Redbook and McCall's; and an early New England colonist named Thomas Pierce, also an ancestor to Franklin Pierce, the 14th President of the United States...", url:"https://themoviedb.org/person/96447"}}, {tmdbId:"86250", properties:{bornIn:"New York City, New York, USA", imdbId:"0376963", born:date('1950-08-29'), name:"Frank Henenlotter", bio:"Frank Henenlotter, is an American screenwriter, director and film historian.  He is known primarily for his horror comedies, though he would prefer to be classified as an \"exploitation\" filmmaker (rather than horror).  \"I never felt that I made ‘horror films’, he has said.  \"I always felt that I made exploitation films.  Exploitation films have an attitude more than anything – an attitude that you don’t find with mainstream Hollywood productions...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/486XOXhFYTKYBSzNm473g3ODwvh.jpg", url:"https://themoviedb.org/person/86250"}}, {tmdbId:"8246", properties:{bornIn:"Baltimore, Maryland, U.S.", imdbId:"0001469", born:date('1942-04-06'), name:"Barry Levinson", bio:"Barry Levinson is an American screenwriter, film director, actor, and producer of film and television.  His films include Bugsy, The Natural and Rain Man...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eExpAfhNjwrWDH9QC9PKuKoy11Y.jpg", url:"https://themoviedb.org/person/8246"}}, {tmdbId:"7623", properties:{bornIn:"Royal Oak, Michigan, USA", imdbId:"0000600", born:date('1959-10-23'), name:"Sam Raimi", bio:"Samuel Marshall \"Sam\" Raimi is an American film director, producer, actor and writer.  He is best known for directing cult horror films like the Evil Dead series, Darkman and Drag Me to Hell, as well as the blockbuster Spider-Man films and the producer of the successful TV series Hercules: The Legendary Journeys, Xena: Warrior Princess, Legend of the Seeker and Spartacus: Blood and Sand...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8gssvwiPrFRuFRlr5ruKx68k1Jl.jpg", url:"https://themoviedb.org/person/7623"}}, {tmdbId:"138167", properties:{imdbId:"0240439", born:date('1922-07-10'), name:"Peter Duffell", died:date('2017-12-12'), url:"https://themoviedb.org/person/138167"}}, {tmdbId:"57434", properties:{bornIn:"The Bronx, New York, USA", imdbId:"0002132", born:date('1954-05-07'), name:"Amy Heckerling", bio:"Amy Heckerling is an American film director best known for the box-office hits FAST TIMES AT RIDGEMONT HIGH (1982) and CLUELESS (1995)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hIc3bQxLOPAcpGJ1CVFuzpzJRZ0.jpg", url:"https://themoviedb.org/person/57434"}}, {tmdbId:"13488", properties:{bornIn:"Sydney, Australia", imdbId:"0166625", name:"Graeme Clifford", bio:"From Wikipedia, the free encyclopedia.    \n\n \n\nGraeme Clifford is an acclaimed Australian film director, his directing credits include the Academy Award nominated film Frances, Gleaming the Cube and the mini-series The Last Don, which received two Emmy nominations...", url:"https://themoviedb.org/person/13488"}}, {tmdbId:"56755", properties:{bornIn:"Englewood, New Jersey, USA", imdbId:"0083279", name:"Patricia Birch", bio:"From Wikipedia, the free encyclopedia. \n\nPatricia Birch is an American choreographer and director for musical theatre and film. \n\nBorn in Englewood, New Jersey, Birch began her career as a dancer in Broadway musicals, including Brigadoon, Goldilocks, and West Side Story (playing \"Anybodys\").  She has directed and choreographed music videos for Cyndi Lauper, the Rolling Stones, and Carly Simon...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a8J8OIvba7SJsxsPEsgTuzs2Jqi.jpg", url:"https://themoviedb.org/person/56755"}}, {tmdbId:"309", properties:{bornIn:"Calzada de Calatrava, Ciudad Real, Castilla-La Mancha, Spain", imdbId:"0000264", born:date('1949-09-24'), name:"Pedro Almodóvar", bio:"Pedro Almodóvar Caballero (born 25 September 1949) is a Spanish film director, screenwriter and producer. \n\nAlmodóvar is arguably the most successful and internationally known Spanish filmmaker of his generation.  His films, marked by complex narratives, employ the codes of melodrama and use elements of pop culture, popular songs, irreverent humor, strong colors, glossy décor and LGBT themes.  Desire, passion, family and identity are among Almodóvar’s most prevalent themes...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dKlaXJk3NLcsC1CKMx6xmyW5BZD.jpg", url:"https://themoviedb.org/person/309"}}, {tmdbId:"16830", properties:{bornIn:"Tel Aviv, Palestine [now Israel]", imdbId:"0203246", born:date('1943-11-08'), name:"Boaz Davidson", bio:"​From Wikipedia, the free encyclopedia\n\nBoaz Davidson (born 8 November 1943) is an Israeli film director, producer and screenwriter.  He was born in Tel Aviv, British Mandate of Palestine and studied film in London.  He started his career by directing the television show Lool (1969) and the movie Shablul (1971).  Later he directed Israeli cult films such as Charlie Ve'hetzi (1974) and Hagiga B'Snuker (1975).  In 1974 he directed the film Mishpahat Tzan'ani...", url:"https://themoviedb.org/person/16830"}}, {tmdbId:"57073", properties:{bornIn:"Glasgow, Scotland, UK", imdbId:"0534084", born:date('1925-12-30'), name:" Ian MacNaughton", bio:"From Wikipedia, the free encyclopedia. \n\nEdward Ian Macnaughton (30 December 1925 – 10 December 2002) was a Scottish former actor-turned-television producer/director, best known for his work with the Monty Python team.  He was born and brought up in Glasgow, educated at Strathallan School, and died in a car accident in Munich...", died:date('2002-12-10'), url:"https://themoviedb.org/person/57073"}}, {tmdbId:"18596", properties:{bornIn:"Santa Barbara, California, U.S.", imdbId:"0000431", born:date('1944-12-31'), name:"Taylor Hackford", bio:"Taylor Edwin Hackford is an American film director, and the current president of the Directors Guild of America...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aAP9RYT7XxUiC2NZL9Hi2gEdxGB.jpg", url:"https://themoviedb.org/person/18596"}}, {tmdbId:"101750", properties:{imdbId:"0210472", name:"Pierre De Moro", url:"https://themoviedb.org/person/101750"}}, {tmdbId:"40345", properties:{bornIn:"El Paso, Texas, USA", imdbId:"0089940", born:date('1937-09-13'), name:"Don Bluth", bio:"From Wikipedia, the free encyclopedia. \n\nDonald Virgil \"Don\" Bluth (born September 13, 1937) is an American animator and independent studio owner.  He is best known for his departure from The Walt Disney Company in 1979 and his subsequent directing of animated classics such as The Secret of NIMH (1982), An American Tail (1986),The Land Before Time (1988), and All Dogs Go to Heaven (1989), as well as his involvement in the laserdisc game Dragon's Lair...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vzeIEidWO7v2Dfw7iMv3Xjnmfwd.jpg", url:"https://themoviedb.org/person/40345"}}, {tmdbId:"21371", properties:{imdbId:"0427468", name:"Amy Holden Jones", url:"https://themoviedb.org/person/21371"}}, {tmdbId:"67268", properties:{bornIn:"San Jose, California, Stati Uniti", imdbId:"0613471", born:date('1933-06-05'), name:" Jimmy T. Murakami", died:date('2014-02-16'), url:"https://themoviedb.org/person/67268"}}, {tmdbId:"12859", properties:{bornIn:"New York City, New York, USA", imdbId:"0513974", born:date('1951-04-24'), name:"Steven Lisberger", bio:"Steven M.  Lisberger (born April 24, 1951) is an American film director, producer and screenwriter. \n\nBorn in New York City and raised in Hazleton, Pennsylvania, he is known for directing the 1982 cult movie Tron.  His film Hot Pursuit features one of Ben Stiller's first speaking roles. \n\nDescription above from the Wikipedia article Steven Lisberger, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oqj8OeDAzvQtfCUogbj127DJinq.jpg", url:"https://themoviedb.org/person/12859"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"44807", properties:{imdbId:"0797526", name:"James Signorelli", url:"https://themoviedb.org/person/44807"}}, {tmdbId:"16395", properties:{bornIn:"San Diego, California, USA", imdbId:"0622695", born:date('1949-04-10'), name:"Gregory Nava", bio:"From Wikipedia, the free encyclopedia. \n\nGregory Nava (born April 10, 1949 in San Diego, California) is a film director, producer and screenplay writer, of Mexican and Basque heritage. \n\nDescription above from the Wikipedia article Gregory Nava, licensed under CC-BY-SA, full list of contributors on Wikipedia ...", url:"https://themoviedb.org/person/16395"}}, {tmdbId:"11777", properties:{bornIn:"Somerset, Kentucky, USA", imdbId:"0908890", born:date('1949-09-06'), name:"Tommy Lee Wallace", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ujNZLV2M8FF97tQ6X7pHM1aa0VM.jpg", url:"https://themoviedb.org/person/11777"}}, {tmdbId:"67411", properties:{bornIn:"New York, New York", imdbId:"0236769", born:date('1932-10-04'), name:"Stan Dragoti", bio:"​From Wikipedia, the free encyclopedia\n\nStan Dragoti (born October 4, 1932 in New York, New York) is an Albanian American film director, whose work includes the comedies Mr.  Mom and Love at First Bite. \n\nDragoti was born in New York city to Albanian parents, both having emigrated in the 1920's from the village of Dragot in the county of Tepelena, in Southern Albania. \n\nHis interest in cinematography led him to Cooper College in New York and later to the Visual Arts College...", url:"https://themoviedb.org/person/67411"}}, {tmdbId:"109876", properties:{bornIn:"Chicago, Illinois, United States", imdbId:"0085457", born:date('1937-06-30'), name:"Noel Black", bio:"From Wikipedia, the free encyclopedia.   Noel Black (born June 30, 1937) is an American film and television director. \n\nBlack was born in Chicago, Illinois.  He won awards at the 1966 Cannes Film Festival for an 18-minute short subject filmed in 1965 called Skaterdater.  It had no dialogue, but used music and sound effects to advance the plot.  It was nominated for an Academy Award for best short film in 1966...", died:date('2014-07-05'), url:"https://themoviedb.org/person/109876"}}, {tmdbId:"57383", properties:{imdbId:"0001887", name:"Paul Brickman", bio:"​From Wikipedia, the free encyclopedia. \n\nPaul Brickman  (April 23, 1949) is an American screenwriter and film director, born in Chicago, Illinois.  He is best known for the film Risky Business where he served as director and screenwriter. \n\nBefore transitioning to directing, Brickman began his career penning offbeat films such as The Bad News Bears in Breaking Training and Jonathan Demme's Handle with Care.  In 1983 he made his directorial debut with Risky Business starring Tom Cruise...", url:"https://themoviedb.org/person/57383"}}, {tmdbId:"74671", properties:{imdbId:"0385349", born:date('1957-01-01'), name:"Robert Hiltzik", url:"https://themoviedb.org/person/74671"}}, {tmdbId:"33880", properties:{bornIn:"Oklahoma, USA", imdbId:"0523310", born:date('1944-09-15'), name:"Dick Lowry", bio:"From Wikipedia, the free encyclopedia. \n\nDick Lowry (15 September 1944 in Oklahoma) is an American director and film producer. \n\nDescription above from the Wikipedia article Dick Lowry, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pv6A0SVgY3AiRC12wKa1BwPtnWy.jpg", url:"https://themoviedb.org/person/33880"}}, {tmdbId:"128947", properties:{bornIn:"Mount Vernon, New York, USA", imdbId:"0434571", born:date('1945-12-14'), name:"Jeremy Kagan", bio:"From Wikipedia, the free encyclopedia. \n\nJeremy Paul Kagan (born December 14, 1945) is an American film and television director, screenwriter and television producer. \n\nDescription above from the Wikipedia article Jeremy Kagan, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/128947"}}, {tmdbId:"92443", properties:{imdbId:"0003313", born:date('1941-06-26'), name:"Lynne Littman", url:"https://themoviedb.org/person/92443"}}, {tmdbId:"27846", properties:{bornIn:"New Jersey, USA ", imdbId:"0381273", name:"John Herzfeld", bio:"​From Wikipedia, the free encyclopedia.   \n\nJohn Herzfeld is an American motion picture and television director, screenwriter, actor and producer.  His feature film directing credits include Two of a Kind (1983), 2 Days in the Valley (1996), 15 Minutes (2001) and The Death and Life of Bobby Z (2007)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/opDaQuBZwM0p8K6HFw8mRbspT8S.jpg", url:"https://themoviedb.org/person/27846"}}, {tmdbId:"57359", properties:{bornIn:"New York, New York", imdbId:"0411477", born:date('1945-07-27'), name:"Neal Israel", url:"https://themoviedb.org/person/57359"}}, {tmdbId:"769", properties:{bornIn:"The Bronx, New York City, New York", imdbId:"0000976", born:date('1951-08-08'), name:"Martin Brest", bio:"His major studio debut was Going in Style (1979), which starred George Burns, Art Carney, and Lee Strasberg.  Brest was then hired to direct WarGames (1983), which starred Matthew Broderick, but he was fired during production and replaced with John Badham.   Brest then directed Beverly Hills Cop (1984), starring Eddie Murphy...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/A5AWIRG18i9JIFGkDM0mUUggsmU.jpg", url:"https://themoviedb.org/person/769"}}, {tmdbId:"21370", properties:{bornIn:"Ballarat, Australia", imdbId:"0002044", born:date('1945-11-15'), name:"Roger Donaldson", bio:"​From Wikipedia, the free encyclopedia\n\nRoger Donaldson (born 15 November 1945) is an Australian-born New Zealand film producer, director and writer who has made numerous successful movies.  He was a co-founder of the New Zealand Film Commission. \n\nDescription above from the Wikipedia Roger Donaldson, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pPFxPo05qMvZSJ3Rs3YwD3tcUvb.jpg", url:"https://themoviedb.org/person/21370"}}, {tmdbId:"1027168", properties:{imdbId:"0797854", name:"Joel Silberg", url:"https://themoviedb.org/person/1027168"}}, {tmdbId:"72543", properties:{bornIn:"Poland", imdbId:"0278735", born:date('1950-03-13'), name:"Sam Firstenberg", bio:"From Wikipedia, the free encyclopedia.   Sam Firstenberg (born March 13, 1950, Poland) is an American film director.  Born in Poland, Sam Firstenberg grew up in Jerusalem, and obtained his higher education in Los Angeles, California.  He is best known for American ninja movie serial.  Sam Firstenberg has directed films ranging from comedy to action, musical to drama, science fiction, thrillers and horror...", url:"https://themoviedb.org/person/72543"}}, {tmdbId:"90525", properties:{imdbId:"0154877", name:"Douglas Cheek", url:"https://themoviedb.org/person/90525"}}, {tmdbId:"66987", properties:{bornIn:"Alpine, Texas, USA", imdbId:"0452607", born:date('1951-07-23'), name:"Fritz Kiersch", bio:"​From Wikipedia, the free encyclopedia.   \n\nFritz Kiersch, real name George Keith Kiersch (born July 23, 1951 in Alpine, Texas) is an American filmmaker, writer and producer.  He is best known for directing the horror classic, Children of the Corn and Tuff Turf. \n\nDescription above from the Wikipedia article Fritz Kiersch, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/66987"}}, {tmdbId:"52194", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0709752", born:date('1956-05-29'), name:" Tony Randel", bio:"Tony Randel is an American film director, screenwriter, editor and producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gyDJpk5CBU5UuKVrezdwwbeFg25.jpg", url:"https://themoviedb.org/person/52194"}}, {tmdbId:"64195", properties:{bornIn:"New York, U.S.", imdbId:"0957263", born:date('1946-05-14'), name:"Joseph Zito", bio:"Joseph Zito is an American film director.  He is perhaps well known for directing many low budget action B-movies of the 1980s such as, Missing in Action, Invasion U. S. A. , Red Scorpion, and many others.  In the mid-1980s, Zito spent a year of pre-production on the Cannon version of Spider-Man.  The film was never made...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6A6l55ZlV9Ri8mZ9KTy19KZpdD9.jpg", url:"https://themoviedb.org/person/64195"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"52193", properties:{imdbId:"0457970", born:date('1952-09-27'), name:" R.J. Kizer", url:"https://themoviedb.org/person/52193"}}, {tmdbId:"59023", properties:{bornIn:"UK", imdbId:"0706296", born:date('1942-01-27'), name:"Stewart Raffill", bio:"Stewart Raffill is an American director and writer of many films. \n\nRaffill's The Philadelphia Experiment, won the \"Best Film\" award of the 1985 Fantafestival.  While You Were Waiting, won the Silver Award in the Short Dramatic category of the 2002 Atlantic City Film Festival.  In 2009, he directed and wrote a musical called Standing Ovation.  The film was released on July 16, 2010 to negative reviews...", url:"https://themoviedb.org/person/59023"}}, {tmdbId:"8965", properties:{bornIn:"London, England, UK", imdbId:"0423646", born:date('1945-11-17'), name:"Roland Joffé", bio:"From Wikipedia, the free encyclopedia. \n\nRoland Joffé (born 17 November 1945) is an English film director who is known for his Oscar nominated movies, The Killing Fields and The Mission.  He began his career in television.  His early television credits included episodes of Coronation Street and an adaptation of The Stars Look Down for Granada.  He gained a reputation for hard-hitting political stories with the series Bill Brand and factual dramas for Play for Today...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kis74mAa2ZsccFr1ToDsrkMy7Gn.jpg", url:"https://themoviedb.org/person/8965"}}, {tmdbId:"92851", properties:{bornIn:"  United States", imdbId:"0927296", name:"Ken Wiederhorn", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jOmwnKParRnmnfntFFyExGmVzEc.jpg", url:"https://themoviedb.org/person/92851"}}, {tmdbId:"58094", properties:{bornIn:"Melbourne, Victoria, Australia", imdbId:"0000788", born:date('1950-12-18'), name:"Gillian Armstrong", bio:"Gillian Armstrong is an award-winning Australian feature film and documentary director, who specializes in period drama.  Her films often feature female perspectives and protagonists...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ysSAJdM0iQvLvWqJigidRkiUK54.jpg", url:"https://themoviedb.org/person/58094"}}, {tmdbId:"68381", properties:{bornIn:"Los Angeles, California, U.S.", imdbId:"0248054", born:date('1947-03-07'), name:"Thom Eberhardt", bio:"From Wikipedia, the free encyclopedia. \n\nThom Eberhardt (born March 7, 1947) is an American film director, producer and writer.  Eberhardt has won two awards and two nominations.  He is most noted for his work on Captain Ron, Honey, I Blew Up the Kid, and the cult classic Night of the Comet. \n\nDescription above from the Wikipedia article Thom Eberhardt, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/68381"}}, {tmdbId:"28904", properties:{bornIn:"Miami, Florida, USA", imdbId:"0933505", born:date('1943-08-21'), name:"Hugh Wilson", bio:"​From Wikipedia, the free encyclopedia.   \n\nHugh Wilson (August 21, 1943 - January 14, 2018) is an American director, writer and actor.  He is best known as the creator and executive producer of the TV series WKRP in Cincinnati and Frank's Place. \n\nHugh is a distinguished alumnus from the College of Journalism and Communications at the University of Florida in Gainesville.  He is currently a guest professor of Media Studies at the University of Virginia...", died:date('2018-01-14'), url:"https://themoviedb.org/person/28904"}}, {tmdbId:"58729", properties:{imdbId:"0536299", born:date('1954-01-01'), name:"Albert Magnoli", url:"https://themoviedb.org/person/58729"}}, {tmdbId:"15890", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0001226", born:date('1953-12-28'), name:"James Foley", bio:"James Foley (born December 28, 1953) is an American film director and screenwriter.  He was born in Bay Ridge, Brooklyn, New York, the son of a lawyer. His 1986 film At Close Range was entered into the 36th Berlin International Film Festival. \n\nDescription above from the Wikipedia article  James Foley, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ujAhQvNNnBqa6ZP2C46DMdAp09w.jpg", url:"https://themoviedb.org/person/15890"}}, {tmdbId:"31493", properties:{bornIn:"Liverpool, England, UK", imdbId:"0184896", born:date('1954-12-15'), name:"Alex Cox", bio:"Alexander Cox (born in Bebington, Merseyside, 15 December 1954) is a British film director, screenwriter, nonfiction author and sometime actor, notable for his idiosyncratic style and approach to scripts...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z6EfePu3eDjgvws8IiwzYqzD1Wr.jpg", url:"https://themoviedb.org/person/31493"}}, {tmdbId:"107639", properties:{bornIn:"Olsztyn, Poland", imdbId:"0532702", born:date('1955-03-10'), name:"Juliusz Machulski", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q3Mrka12NV2ts1gSAMBG8dKJk45.jpg", url:"https://themoviedb.org/person/107639"}}, {tmdbId:"11505", properties:{bornIn:"Lansing, Michigan, USA", imdbId:"0000455", born:date('1950-02-18'), name:"John Hughes", bio:"John Hughes (February 18, 1950 – August 6, 2009) was an American film director, producer and screenwriter.  He directed and scripted some of the most successful films of the 1980s and 1990s, including National Lampoon's Vacation, Ferris Bueller's Day Off, Weird Science, The Breakfast Club, Some Kind of Wonderful, Sixteen Candles, Pretty in Pink; Planes, Trains and Automobiles; Uncle Buck, Career Opportunities, 101 Dalmatians, Home Alone, and its sequels, Home Alone 2 and Home Alone 3...", died:date('2009-08-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dFVgYYRY1R0aUCYvfEah00Iwzlt.jpg", url:"https://themoviedb.org/person/11505"}}, {tmdbId:"27538", properties:{imdbId:"0829343", name:"Douglas Day Stewart", url:"https://themoviedb.org/person/27538"}}, {tmdbId:"87565", properties:{imdbId:"0390822", name:"Savage Steve Holland", bio:"Savage Steve Holland (born 1960) is an animator and director who wrote and directed the cult films Better Off Dead (1985) and One Crazy Summer (1986), starring John Cusack.  He also directed the film How I Got Into College (1989), and animated the \"Whammy\" on the game show Press Your Luck.  He later went on to create and produce Eek! the Cat for Fox Kids.  Now, he manages his own studio, Savage Studios Ltd.  and directs shows for Disney Channel and Nickelodeon...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3GADF4j8wNAxPJIsipQnrd2ieTt.jpg", url:"https://themoviedb.org/person/87565"}}, {tmdbId:"17554", properties:{bornIn:"Belgrade, Kingdom of Yugoslavia", imdbId:"0538445", born:date('1932-10-13'), name:"Dusan Makavejev", bio:"Dušan Makavejev is a Serbian film director and screenwriter, famous for his groundbreaking films of Yugoslav cinema in the late 1960s and early 1970s...", died:date('2019-01-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rZgZFhxrleabFpxIAeK3XI2HR5z.jpg", url:"https://themoviedb.org/person/17554"}}, {tmdbId:"18254", properties:{bornIn:"Sydney, New South Wales, Australia", imdbId:"0934578", name:"Simon Wincer", bio:"Simon Wincer (born 1943 in Sydney) is an Australian film director and film producer.  He attended Cranbrook School, Bellevue Hill, Sydney from 1950 to 1961.  On leaving school he worked as a stage hand at TV Station Channel 7.  By the 1980s he directed over 200 hours of television.  In 1986 he directed the made for TV movie The Last Frontier and also won a Christopher Award. \n\nHis most successful film to date is the 1993 film Free Willy...", url:"https://themoviedb.org/person/18254"}}, {tmdbId:"10723", properties:{bornIn:"St. Albans, Hertfordshire, England, UK ", imdbId:"0001565", born:date('1942-03-28'), name:"Mike Newell", bio:"Michael Cormac \"Mike\" Newell (born 28 March 1942) is an English director and producer of motion pictures for the screen and for television.  After the release of Harry Potter and the Goblet of Fire in 2005, Newell became the third most commercially successful British director in recent years, behind Christopher Nolan and David Yates, as confirmed by the UK Film Council in their 2010 Statistical Yearbook...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zeLnvLZtyJaBP1wWceRM7HWkm0E.jpg", url:"https://themoviedb.org/person/10723"}}, {tmdbId:"4163", properties:{bornIn:"San Francisco, California, USA", imdbId:"0215123", born:date('1945-06-08'), name:"Donna Deitch", bio:"From Wikipedia, the free encyclopedia.   \n\nDonna Deitch (born June 8, 1945 in San Francisco, California) is an American film and television director best known for her 1986 film Desert Hearts.  The film was groundbreaking as one of the first releases to depict a lesbian love story in a generally mainstream, albeit art house, vein but with positive and respectful themes.  Deitch also directed the mini-series The Women of Brewster Place.  Her partner is writer Terri Jentz...", url:"https://themoviedb.org/person/4163"}}, {tmdbId:"134114", properties:{imdbId:"0587669", born:date('1938-01-11'), name:"Gavin Millar", url:"https://themoviedb.org/person/134114"}}, {tmdbId:"58822", properties:{bornIn:"New York, New York", imdbId:"0826164", born:date('1942-01-07'), name:"Danny Steinmann", died:date('2012-12-18'), url:"https://themoviedb.org/person/58822"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"69801", properties:{imdbId:"0582635", name:"Alan Metter", bio:"From Wikipedia, the free encyclopedia. \n\nAlan Metter is an American film director.  He has directed numerous films from 1983 to 2005.  He also produced The Winds of Whoopie(1983)...", url:"https://themoviedb.org/person/69801"}}, {tmdbId:"69315", properties:{imdbId:"0699933", name:"Luis Puenzo", url:"https://themoviedb.org/person/69315"}}, {tmdbId:"91727", properties:{imdbId:"0331989", name:"Lisa Gottlieb", bio:"From Wikipedia, the free encyclopedia. \n\nLisa Gottlieb is an American film, television director and college professor.  She is best known for directing the 1985 film Just One of the Guys.  She went on to direct the films Across the Moon (1995) starring Christina Applegate and Elizabeth Peña and Cadillac Ranch (1996) starring Christopher Lloyd and Suzy Amis...", url:"https://themoviedb.org/person/91727"}}, {tmdbId:"5216", properties:{bornIn:"Louisville, Kentucky, USA", imdbId:"0001814", born:date('1952-07-24'), name:"Gus Van Sant", bio:"Gus Green Van Sant, Jr.  (born July 24, 1952) is an American director, screenwriter, painter, photographer, musician, and author.  He was nominated for an Academy Award for Achievement in Directing for his 1997 film Good Will Hunting and his 2008 film Milk, and won the Palme d'Or at the 2003 Cannes Film Festival for his film Elephant.  He lives in Portland, Oregon. \n\nHis early career was devoted to directing television commercials in the Pacific Northwest...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kICHgrSh4eiICjz8piy9fTXIgph.jpg", url:"https://themoviedb.org/person/5216"}}, {tmdbId:"70835", properties:{imdbId:"0079471", name:"Jonathan R. Betuel", url:"https://themoviedb.org/person/70835"}}, {tmdbId:"148119", properties:{bornIn:"Hobart, Tasmania", imdbId:"0097491", born:date('1953-05-05'), name:"Phillip Borsos", bio:"​From Wikipedia, the free encyclopedia\n\nPhillip Borsos (May 5, 1953 - February 13, 1995) was Canadian film director and film producer. \n\nBorsos showed an early interest in film-making while attending high school in Maple Ridge, B. C.  He studied film at the Banff Centre School for Fine Arts and at the Vancouver School of Art, now the Emily Carr Institute of Art and Design. \n\nHis early work included several shorts notable for their cinematography and pacing...", died:date('1995-02-13'), url:"https://themoviedb.org/person/148119"}}, {tmdbId:"64061", properties:{bornIn:"Melbourne, Victoria, Australia", imdbId:"0770961", born:date('1939-12-26'), name:"Fred Schepisi", bio:"From Wikipedia, the free encyclopedia. \n\nFred Schepisi AO (born 26 December 1939) is an Australian film director and screenwriter.  His credits include: Last Orders, Roxanne, Plenty, and Six Degrees of Separation. \n\nSchepisi was born Frederic Alan Schepisi in Melbourne, Victoria, the son of fruit dealer Frederic Thomas Schepisi and Loretto Ellen (née Hare)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9W1St7ZYiMY8tsx2vx4bPfy1TaY.jpg", url:"https://themoviedb.org/person/64061"}}, {tmdbId:"41720", properties:{bornIn:"San Francisco, California, U.S.", imdbId:"0661577", born:date('1925-07-25'), name:"Jerry Paris", bio:"​From Wikipedia, the free encyclopedia\n\nJerry Paris (July 25, 1925 – March 31, 1986) was an American actor and director best known for playing Jerry Helper, the dentist and next door neighbor of Rob and Laura Petrie, on The Dick Van Dyke Show. \n\nDescription above from the Wikipedia article Jerry Paris, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1986-03-31'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2AcHNiDrVNUzgWT6KxZM4VvRPAy.jpg", url:"https://themoviedb.org/person/41720"}}, {tmdbId:"16008", properties:{imdbId:"0464506", born:date('1924-08-03'), name:"James Komack", died:date('1997-12-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qC2YuxzIQHwoQDRuWoJeW2RmuQm.jpg", url:"https://themoviedb.org/person/16008"}}, {tmdbId:"32277", properties:{bornIn:"New Zealand", imdbId:"0614276", born:date('1946-06-13'), name:"Geoff Murphy", bio:"​From Wikipedia, the free encyclopedia.   \n\nGeoff Murphy (born 13 June 1946) is a successful New Zealand filmmaker best-known for his work during the renaissance of New Zealand cinema that began in the last half of the 1970s. \n\nHe directed a string of big-budget Hollywood features during the 1990s, before returning to New Zealand as second unit director on all three movies of The Lord of the Rings film trilogy...", url:"https://themoviedb.org/person/32277"}}, {tmdbId:"16566", properties:{bornIn:"Florence, Tuscany, Italy", imdbId:"0181902", born:date('1941-01-04'), name:"George P. Cosmatos", bio:"From Wikipedia, the free encyclopedia. \n\nGeorge Pan Cosmatos (January 4, 1941 in Florence, Italy - April 19, 2005 in Victoria, Canada) was a Greek/Italian film director.  After studying film in London, he became assistant director to Otto Preminger on Exodus (1960), Leon Uris's epic about the birth of Israel.  Thereafter he worked on Zorba the Greek (1964), in which Cosmatos had a small part as Boy with Acne.  Cosmatos grew up in Egypt and Cyprus and is said to have spoken six languages...", died:date('2005-04-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/A6ZzR1kSLnrI0BJZxkVAJ6F4EaB.jpg", url:"https://themoviedb.org/person/16566"}}, {tmdbId:"5045", properties:{imdbId:"0639321", born:date('1946-09-30'), name:"Dan O'Bannon", bio:"From Wikipedia, the free encyclopedia. \n\nDaniel Thomas \"Dan\" O'Bannon (September 30, 1946 – December 17, 2009) was an American motion picture screenwriter, director and occasional actor, usually in the science fiction and horror genres. \n\nDescription above from the Wikipedia article Dan O'Bannon, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2009-12-17'), url:"https://themoviedb.org/person/5045"}}, {tmdbId:"154", properties:{bornIn:"New York, New York, U.S.A.", imdbId:"0004555", born:date('1943-07-12'), name:"Walter Murch", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7ZUPk0aT7IBm4xPeILzm8dUrl48.jpg", url:"https://themoviedb.org/person/154"}}, {tmdbId:"58728", properties:{bornIn:"Moscow, USSR [now Russia]", imdbId:"0464846", born:date('1937-08-20'), name:"Andrey Konchalovskiy", bio:"Andrei Mikhalkov-Konchalovsky (Russian) (born August 20 1937, in Moscow) is a Soviet, American and Russian director and screenwriter.  He is the son of Natalia Konchalovskaya and Sergey Mikhalkov, and brother to Nikita Mikhalkov who is also a well known Russian film director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Utw2YAYrLxZNvdlC83YbIdCrWt.jpg", url:"https://themoviedb.org/person/58728"}}, {tmdbId:"29009", properties:{bornIn:"Belleville - Illinois - USA", imdbId:"0477129", born:date('1957-08-17'), name:"Ken Kwapis", bio:"From Wikipedia, the free encyclopedia. \n\nKen Kwapis (born August 17, 1957) is an American film and television director and screenwriter.  He specialized in the single-camera sitcom in the 1990s and 2000s and has directed feature films such as Sisterhood of the Traveling Pants and He's Just Not That Into You...", url:"https://themoviedb.org/person/29009"}}, {tmdbId:"1223735", properties:{imdbId:"0003733", name:"Daniel Attias", bio:"Daniel Attias is director, producer and assistant director...", url:"https://themoviedb.org/person/1223735"}}, {tmdbId:"5572", properties:{bornIn:"New York City, New York, USA", imdbId:"0001708", born:date('1939-08-28'), name:"Joel Schumacher", bio:"Joel T.  Schumacher (August 28th, 1939 - June 22nd, 2020) was an American film director, screenwriter and producer.  Schumacher was raised in New York City by his mother and suffered from substance abuse at a young age.  He became a fashion designer after graduating from Parsons School of Design, but would continue suffering from substance abuse and high levels of debt until the early 1970s...", died:date('2020-06-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qJnC9ezRzyXNsJGDFTTiJ8EfvC.jpg", url:"https://themoviedb.org/person/5572"}}, {tmdbId:"64877", properties:{bornIn:"Nashville, Tennessee", imdbId:"0199722", born:date('1942-08-04'), name:"Rod Daniel", bio:"From Wikipedia, the free encyclopedia. \n\nRod Daniel (born 1942 in Nashville, Tennessee) is an American film director.  He has directed the films Teen Wolf, Home Alone 4: Taking Back The House, Like Father Like Son, K-9, The Super, and Beethoven's 2nd. \n\nDescription above from the Wikipedia article Rod Daniel, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2016-04-16'), url:"https://themoviedb.org/person/64877"}}, {tmdbId:"58453", properties:{imdbId:"0265363", name:"Peter Faiman", bio:"​From Wikipedia, the free encyclopedia. \n\nPeter Leonard Faiman is a well known Australian television producer with experience in film, live television and events.  He has had a long standing working relationship with the Nine Network...", url:"https://themoviedb.org/person/58453"}}, {tmdbId:"78514", properties:{bornIn:"Poole, Dorset, England, UK", imdbId:"0427880", born:date('1934-02-19'), name:"David Hugh Jones", bio:"​From Wikipedia, the free encyclopedia. \n\nDavid Hugh Jones (19 February 1934 – 19 September 2008) was a British stage, television, and film director...", died:date('2008-09-18'), url:"https://themoviedb.org/person/78514"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"9181", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0001880", born:date('1952-10-08'), name:"Edward Zwick", bio:"Edward M.  Zwick (born October 8, 1952) is an American filmmaker and film producer noted for his sprawling war films.  He has been described as a \"throwback to an earlier era, an extremely cerebral director whose movies consistently feature fully rounded characters, difficult moral issues, and plots that thrive on the ambiguity of authority. \"\n\nDescription above from the Wikipedia article Edward Zwick, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xN7GHXkzCK2y9P16g6n3a7uhNAk.jpg", url:"https://themoviedb.org/person/9181"}}, {tmdbId:"85365", properties:{imdbId:"0774927", name:"Dale Schott", url:"https://themoviedb.org/person/85365"}}, {tmdbId:"19798", properties:{bornIn:"Los Angeles, California, United States", imdbId:"0354279", born:date('1945-02-20'), name:"Randa Haines", bio:"From Wikipedia, the free encyclopedia. \n\nRanda Haines (born February 20, 1945 in Los Angeles, California) is a film and television director and producer.  She is perhaps most famous for directing the critically acclaimed feature film Children of a Lesser God (1986), which starred William Hurt and Marlee Matlin, for which Matlin won the 1987 Academy Award as best actress.  Haines also won the Silver Bear at the 37th Berlin International Film Festival...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ndsn7FhgVDbixDqZGFWAgVPiGTd.jpg", url:"https://themoviedb.org/person/19798"}}, {tmdbId:"107482", properties:{imdbId:"0354286", name:"Richard W. Haines", url:"https://themoviedb.org/person/107482"}}, {tmdbId:"70974", properties:{bornIn:"London, England, UK", imdbId:"0602454", born:date('1929-07-09'), name:"Christopher Morahan", bio:"​From Wikipedia, the free encyclopedia.   \n\nChristopher Morahan (born 9 July 1929, London) was an English stage and television director and producing manager.  Initially an actor, Morahan was subsequently a television director from 1957, starting with the long-running ITV series Emergency Ward 10...", died:date('2017-04-07'), url:"https://themoviedb.org/person/70974"}}, {tmdbId:"28283", properties:{bornIn:" New York City, New York, U.S.", imdbId:"0320546", born:date('1957-05-05'), name:"Buddy Giovinazzo", bio:"From Wikipedia, the free encyclopedia. \n\nBuddy Giovinazzo is an independent filmmaker and author who is known for his gritty-low budget debut film, Combat Shock, and his collection of harrowing short stories of low urban life in his 1993 novel, Life is Hot in Cracktown. \n\nBorn May 5, 1957 in New York City, Buddy grew up in Staten Island.  He went to the College of Staten Island where he graduated with a Masters in Cinema, later teaching film there as well...", url:"https://themoviedb.org/person/28283"}}, {tmdbId:"18356", properties:{bornIn:"San Antonio, Texas, USA", imdbId:"0378893", born:date('1958-11-10'), name:"Stephen Herek", bio:"From Wikipedia, the free encyclopedia.   Stephen Robert Herek (born November 10, 1958) is an American film director. \n\nHerek was born in San Antonio, Texas.  He attended the University of Texas at Austin.  His career as film director took off in 1986 with Critters followed by Bill and Ted's Excellent Adventure where he worked with Keanu Reeves in 1989.  He directed Don't Tell Mom the Babysitter's Dead in 1991, followed by The Mighty Ducks in 1992, The Three Musketeers in 1993, Mr...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ni2MxgHBvzzYj9OzHpQ3yHkar79.jpg", url:"https://themoviedb.org/person/18356"}}, {tmdbId:"1077287", properties:{imdbId:"0180644", name:"Eugene Corr", url:"https://themoviedb.org/person/1077287"}}, {tmdbId:"38516", properties:{bornIn:"Deschambault, Quebec, Canada", imdbId:"0000780", born:date('1941-06-25'), name:"Denys Arcand", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jYqHVVAHbhNvFCMmi2wUm8IanRp.jpg", url:"https://themoviedb.org/person/38516"}}, {tmdbId:"15810", properties:{bornIn:"Sioux City, Iowa, USA", imdbId:"0166256", born:date('1953-04-25'), name:"Ron Clements", bio:"​From Wikipedia, the free encyclopedia\n\nRonald Francis \"Ron\" Clements (born April 25, 1953) is an American animation director and producer.  He is one half of America's leading contemporary animation team with John Musker. \n\nDescription above from the Wikipedia article Ron Clements, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/u9k9yg2EGlDsxYo3ehf35yRUfcD.jpg", url:"https://themoviedb.org/person/15810"}}, {tmdbId:"61677", properties:{bornIn:"San Francisco, California, USA", imdbId:"0560329", born:date('1935-05-13'), name:" Burny Mattinson", url:"https://themoviedb.org/person/61677"}}, {tmdbId:"61678", properties:{imdbId:"0585150", name:" David Michener", bio:"Norwegian-born writer who worked for the Disney Studios...", url:"https://themoviedb.org/person/61678"}}, {tmdbId:"15811", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0615780", born:date('1953-11-08'), name:" John Musker", bio:"​From Wikipedia, the free encyclopedia\n\nJohn Musker (born November 8, 1953) is an American animation director.  Along with Ron Clements, he makes up the duo of one of the Walt Disney Animation Studio's leading director teams. \n\nDescription above from the Wikipedia article John Musker, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vSn1d9JpEpECu9cQbRGTFWZdLhA.jpg", url:"https://themoviedb.org/person/15811"}}, {tmdbId:"129692", properties:{bornIn:"Evanston, Illinois, USA", imdbId:"0841456", born:date('1943-11-02'), name:"Bob Swaim", url:"https://themoviedb.org/person/129692"}}, {tmdbId:"52968", properties:{bornIn:"Melbourne, Victoria, Australia", imdbId:"0611683", born:date('1953-06-23'), name:"Russell Mulcahy", bio:"From Wikipedia, the free encyclopedia\n\nRussell Mulcahy (born 23 June 1953 in Melbourne, Victoria) is an Australian film director.  His work is easily recognized by his use of fast cuts, tracking shots and use of glowing lights. \n\n \n\nDescription above from the Wikipedia article Russell Mulcahy, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/61VZ3twvslKZir66aLCi5Z5TE2Y.jpg", url:"https://themoviedb.org/person/52968"}}, {tmdbId:"44847", properties:{bornIn:"Decatur, Indiana, USA", imdbId:"0000770", born:date('1946-09-24'), name:"David Anspaugh", bio:"From Wikipedia, the free encyclopedia.   David Anspaugh (born September 24, 1946) is an American television and film director.   Born in Decatur, Indiana, Anspaugh studied at Indiana University and the USC School of Cinematic Arts, after which he taught high school in Colorado.  His work as an associate producer on television movies led to his producing and directing Hill Street Blues, for which he won two Emmy Awards.  He followed this with St...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vUH2KjFr9EAc1fKcZaemEcHvBwK.jpg", url:"https://themoviedb.org/person/44847"}}, {tmdbId:"686", properties:{imdbId:"0404754", born:date('1945-09-08'), name:"Willard Huyck", bio:"From Wikipedia, the free encyclopedia\n\nWillard Huyck (born September 8, 1945) is an American screenwriter, director and producer, best known for his association with George Lucas.  They met as students at the USC School of Cinematic Arts, and along with others, they became members of a renowned group of amateur filmmakers called The Dirty Dozen...", url:"https://themoviedb.org/person/686"}}, {tmdbId:"93406", properties:{bornIn:"Stalingrad, Soviet Union", imdbId:"0459552", born:date('1933-07-09'), name:"Elem Klimov", bio:"Elem Germanovich Klimov (Russian: Эле́м Ге́рманович Кли́мов; 9 July 1933 – 26 October 2003) was a Soviet Russian film director.  He studied at VGIK, and was married to film director Larisa Shepitko.  Klimov is best known in the West for his final film, 1985's Come and See (Иди и смотри), which follows a teenage boy in German-occupied Belarus during the German-Soviet War and is often considered one of the greatest war films ever made...", died:date('2003-10-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tB7F8OpDLa1bwVmB8prMRmg9C4U.jpg", url:"https://themoviedb.org/person/93406"}}, {tmdbId:"20718", properties:{bornIn:"Paris, France", imdbId:"0001945", born:date('1934-07-01'), name:"Claude Berri", bio:"Claude Berri (1 July 1934 – 12 January 2009) was a French film director, writer, producer, actor and distributor. \n\nBorn Claude Berel Langmann in Paris, Berri was the son of Jewish immigrant parents.  His mother, Beila (née Bercu), was from Romania, and his father, Hirsch Langmann, was a furrier from Poland.  His sister was the screenwriter and editor Arlette Langmann. \n\nBerri won the \"Best Film\" BAFTA for Jean de Florette, and was also nominated for twelve César Awards, though he never won...", died:date('2009-01-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6XwAO01dSxYrb8Zc1lbbvEgIxK7.jpg", url:"https://themoviedb.org/person/20718"}}, {tmdbId:"98750", properties:{bornIn:"Ipswich, Suffolk, England", imdbId:"0638080", born:date('1940-01-14'), name:"Trevor Nunn", bio:"​From Wikipedia, the free encyclopedia.   \n\nSir Trevor Robert Nunn, CBE (born 14 January 1940) is an English theatre and film director. \n\nDescription above from the Wikipedia article Trevor Nunn, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/98750"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"7879", properties:{bornIn:"Hollywood, California, USA", imdbId:"0005124", born:date('1957-01-12'), name:"John Lasseter", bio:"John Alan Lasseter is an American animator, director and the chief creative officer at Pixar and Walt Disney Animation Studios.  He is also currently the Principal Creative Advisor for Walt Disney Imagineering. \n\nLasseter's first job was with The Walt Disney Company, where he became an animator.  Next, he joined Lucasfilm, where he worked on the then-groundbreaking use of CGI animation...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/snqz1JZY3xPzZF1PqFUgxzpv2sN.jpg", url:"https://themoviedb.org/person/7879"}}, {tmdbId:"3027", properties:{bornIn:"Portland, Maine, USA", imdbId:"0000175", born:date('1947-09-21'), name:"Stephen King", bio:"An American author of contemporary horror, suspense, science fiction and fantasy fiction.  His books have sold more than 350 million copies, which have been adapted into a number of feature films, television movies and comic books.  As of 2011, King has written and published 49 novels, including seven under the pen name Richard Bachman, five non-fiction books, and nine collections of short stories.  Many of his stories are set in his home state of Maine...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7r5nEzNanuEhmxtpsKE1uCBU5Jd.jpg", url:"https://themoviedb.org/person/3027"}}, {tmdbId:"121760", properties:{imdbId:"0063581", name:"David Beaird", url:"https://themoviedb.org/person/121760"}}, {tmdbId:"44056", properties:{bornIn:"San Francisco, California, USA", imdbId:"0215269", born:date('1959-04-09'), name:"Fred Dekker", bio:"​From Wikipedia, the free encyclopedia.   \n\nFred Dekker is the writer and director of the cult classic films Night of the Creeps and The Monster Squad (written with Shane Black).  He contributed the story ideas for both House (1986) and Ricochet (1991).  He also directed and wrote RoboCop 3 (co-written with Frank Miller).  Dekker was born on April 9, 1959 in San Francisco, California.  One of his earliest movies was a short film he made in college titled Starcruisers directed in the early 1980s...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kH5OoVnZm0LmO6pFfOcyq7bjbva.jpg", url:"https://themoviedb.org/person/44056"}}, {tmdbId:"59622", properties:{imdbId:"0131840", name:"Augusto Caminito", url:"https://themoviedb.org/person/59622"}}, {tmdbId:"100053", properties:{bornIn:"Rome, Lazio, Italy", imdbId:"0128764", born:date('1933-02-13'), name:" Mario Caiano", bio:"Mario Caiano (February 13, 1933-September 20, 2015) was an Italian film director, screenwriter and second unit director. \n\nBorn in Rome, he directed nearly 50 films since 1961 and 27 films and TV scripts since 1954. \n\nCaiano directed and wrote the script to the 1965 horror film starring Barbara Steele, Nightmare Castle (Amanti d'oltretomba) and for the 1972 horror film Eye in the Labyrinth...", died:date('2015-09-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/t78auekqU3ek3A9pPrav8B6ZccM.jpg", url:"https://themoviedb.org/person/100053"}}, {tmdbId:"88164", properties:{bornIn:"Busto Arsizio, Italy", imdbId:"0185524", born:date('1947-09-07'), name:" Luigi Cozzi", bio:"From Wikipedia, the free encyclopedia.  Luigi Cozzi (born September 7, 1947) is an Italian movie director and screenwriter who directed mainly science fiction and horror films in the mid-1970s and throughout the 1980s.  He was born in 1947 in Busto Arsizio, Italy. \n\nDescription above from the Wikipedia article Luigi Cozzi, licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/81MLlK0zwQuhRkiqKrpskea8yNn.jpg", url:"https://themoviedb.org/person/88164"}}, {tmdbId:"100054", properties:{bornIn:"Firenze, Toscana, Italia", imdbId:"0524621", born:date('1932-01-01'), name:" Maurizio Lucidi", url:"https://themoviedb.org/person/100054"}}, {tmdbId:"26502", properties:{bornIn:"New York City, New York, USA", imdbId:"0222043", born:date('1950-09-14'), name:"Howard Deutch", bio:"Howard Deutch is an American film and television director, best known for his collaboration with screenwriter John Hughes on the feature length films \"Pretty in Pink\" and \"Some Kind of Wonderful\"...", url:"https://themoviedb.org/person/26502"}}, {tmdbId:"74590", properties:{imdbId:"0667767", name:"George Pavlou", url:"https://themoviedb.org/person/74590"}}, {tmdbId:"92554", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"0934863", born:date('1947-05-04'), name:"Harry Winer", bio:"​From Wikipedia, the free encyclopedia.   \n\nHarry Winer (born May 4, 1947 in Detroit, Michigan, U. S. ) is an American television director, television producer, and television writer.  He is married to former actress Shelley Hack, with whom he has a daughter. \n\nDescription above from the Wikipedia article Yvette Harry Winer, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/92554"}}, {tmdbId:"69167", properties:{bornIn:"Kyoto, Japan", imdbId:"0411631", born:date('1933-05-15'), name:"Jûzô Itami", bio:"From Wikipedia, the free encyclopedia  Jūzō Itami ( May 15, 1933 – December 20, 1997), was an actor and (later) a popular modern Japanese film director.  Many critics came to regard him as Japan's greatest director since Akira Kurosawa.  His 10 movies, all of which he wrote himself, are comic satires on elements of Japanese culture.   Description above from the Wikipedia article Jūzō Itami, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1997-12-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lFzVLsLjlPMpNAWC4UlozmUSndD.jpg", url:"https://themoviedb.org/person/69167"}}, {tmdbId:"19542", properties:{imdbId:"0793802", born:date('1939-01-01'), name:"Nelson Shin", url:"https://themoviedb.org/person/19542"}}, {tmdbId:"64722", properties:{bornIn:"Belleville, Illinois, USA", imdbId:"0119106", born:date('1952-06-18'), name:"John Carl Buechler", bio:"John Carl Buechler (pronounced Beekler) is an American director, actor, and special effects and makeup artist.  He was born in Belleville, Illinois, and is probably best known for directing Friday the 13th Part VII: The New Blood...", died:date('2019-03-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8QpPW75b3Cs32sZh5K1hemSDiii.jpg", url:"https://themoviedb.org/person/64722"}}, {tmdbId:"11401", properties:{bornIn:"Guangzhou, China", imdbId:"0000247", born:date('1946-09-22'), name:"John Woo", bio:"John Woo Yu-Sen SBS is a Hong Kong film director and producer.   Recognized for his stylised films of highly choreographed action sequences, Mexican standoffs, and use of slow-motion, Woo has directed several notable Hong Kong action films, among them, A Better Tomorrow, The Killer, Hard Boiled and Red Cliff.   His Hollywood films include Hard Target, Broken Arrow, Face/Off and Mission: Impossible 2.  He also created the comic series Seven Brothers, published by Virgin Comics...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/SOFK6i5RqXjhkK0lMXR3tKnime.jpg", url:"https://themoviedb.org/person/11401"}}, {tmdbId:"10965", properties:{bornIn:"Spangler, Pennsylvania, USA", imdbId:"0001060", born:date('1958-09-10'), name:"Chris Columbus", bio:"Christopher Joseph Columbus is an American film director, producer and screenwriter.  Columbus had most success with the first film in the Harry Potter series, Harry Potter and the Sorcerer's Stone, along with Home Alone, winning a British Comedy Award for Best Comedy Film...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p7VSWFQ6V99p3jLJOrNI1NlnTrg.jpg", url:"https://themoviedb.org/person/10965"}}, {tmdbId:"253869", properties:{imdbId:"0389311", name:"Tamar Simon Hoffs", url:"https://themoviedb.org/person/253869"}}, {tmdbId:"8555", properties:{bornIn:"New York City, New York, USA", imdbId:"0331956", born:date('1938-03-18'), name:" Carl Gottlieb", bio:"​From Wikipedia, the free encyclopedia.   \n\nCarl Gottlieb (born March 18, 1938) is an American screenwriter, actor, comedian and executive.  He is probably best known for co-writing the screenplay for Jaws, as well as directing the 1981 low-budget cult film Caveman. \n\nDescription above from the Wikipedia article Carl Gottlieb, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/8555"}}, {tmdbId:"7181", properties:{imdbId:"0919154", name:" Robert K. Weiss", url:"https://themoviedb.org/person/7181"}}, {tmdbId:"937110", properties:{imdbId:"0661919", name:"Woo-sang Park", url:"https://themoviedb.org/person/937110"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"147095", properties:{bornIn:"Greenock, Scotland", imdbId:"0117317", born:date('1942-04-12'), name:" Bill Bryden", bio:"From Wikipedia, the free encyclopedia\n\nWilliam Campbell Rough Bryden CBE (born 12 April 1942, Greenock, Scotland) is a British stage- and film director and screenwriter. \n\nDescription above from the Wikipedia article Bill Bryden, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/147095"}}, {tmdbId:"3776", properties:{bornIn:"Paris, France", imdbId:"0000419", born:date('1930-12-03'), name:" Jean-Luc Godard", bio:"Jean-Luc Godard is a French-Swiss film director, screenwriter and film critic.  He rose to prominence as a pioneer of the 1960s French New Wave film movement and was arguably the most influential French filmmaker of the post-war era...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7bwENE8X0A8xcLTUswKoIgh9ubk.jpg", url:"https://themoviedb.org/person/3776"}}, {tmdbId:"86290", properties:{bornIn:"London, England, UK", imdbId:"0418746", born:date('1942-01-31'), name:" Derek Jarman", bio:"Michael Derek Elworthy Jarman (31 January 1942 – 19 February 1994) was an English film director, stage designer, diarist, artist, gardener and author...", died:date('1994-02-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gugxHlnYmeNVyrB9lA2TVmzFObV.jpg", url:"https://themoviedb.org/person/86290"}}, {tmdbId:"65304", properties:{bornIn:"Norton, Stockton-on-Tees, Cleveland, England, UK", imdbId:"0734466", born:date('1946-04-29'), name:" Franc Roddam", bio:"From Wikipedia, the free encyclopedia\n\nFranc Roddam (born 29 April 1946, Norton, Stockton-on-Tees, County Durham) is an English film director, screenwriter, TV producer, format creator and book publisher.  He is married to photographer, Leila Ansari, and has six children from previous marriages.  He currently lives in London. \n\nDescription above from the Wikipedia article Franc Roddam, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/65304"}}, {tmdbId:"77104", properties:{bornIn:"London, England, UK", imdbId:"0836430", born:date('1951-06-24'), name:" Charles Sturridge", bio:"From Wikipedia, the free encyclopedia\n\nCharles B.  G.  Sturridge (born 24 June 1951) is an English screenwriter, producer, stage, television and film director. \n\nDescription above from the Wikipedia article Charles Sturridge, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n9RJIf51rmcptp2kS1TcmfyKbj1.jpg", url:"https://themoviedb.org/person/77104"}}, {tmdbId:"22669", properties:{bornIn:"London, England, UK", imdbId:"0854697", born:date('1953-11-26'), name:" Julien Temple", bio:"Julien Temple (born 26 November 1953 and educated at St Marylebone Grammar School ) is an English film, documentary and music video director.  He began his career with films featuring the Sex Pistols, and has continued with various off-beat projects. \n\nDescription above from the Wikipedia article Julien Temple, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/22669"}}, {tmdbId:"95489", properties:{bornIn:"Melbourne, Australia ", imdbId:"0387605", name:"Lyndall Hobbs", bio:"From Wikipedia, the free encyclopedia.   Lyndall Georgina Hobbs is an Australian film director and producer.  She was born in Melbourne, Australia in March 1952.  She was a close childhood friend of the journalist Amanda Zachariah of the Geelong Advertiser.  She spent a considerable period of her life in the United Kingdom during which time she directed 'Steppin' Out' featuring top UK act Secret Affair before moving to Hollywood in the United States...", url:"https://themoviedb.org/person/95489"}}, {tmdbId:"23393", properties:{bornIn:"Tehran - Iran", imdbId:"0775447", born:date('1941-08-26'), name:"Barbet Schroeder", bio:"Barbet Schroeder (born 26 August 1941) is a Franco-Swiss movie director and producer who started his career in French cinema in the 1960s, working together with directors such as Jean-Luc Godard and Jacques Rivette...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5uBKjaIcxAaq70v2RPBAvb9qcgM.jpg", url:"https://themoviedb.org/person/23393"}}, {tmdbId:"70250", properties:{bornIn:"Palo Alto, California, USA", imdbId:"0036582", born:date('1922-02-22'), name:"Newt Arnold", died:date('2000-02-12'), url:"https://themoviedb.org/person/70250"}}, {tmdbId:"108217", properties:{imdbId:"0715916", name:"Jerry Rees", url:"https://themoviedb.org/person/108217"}}, {tmdbId:"84906", properties:{imdbId:"0208923", name:"Steve De Jarnatt", bio:"​From Wikipedia, the free encyclopedia.   \n\nSteve De Jarnatt is an American film and television director, screenwriter, and short story author. \n\nHe is best known for writing and directing the 1988 nuclear apocalypse thriller Miracle Mile and the film Cherry 2000. \n\nDe Jarnatt is also a television director and has worked on such programs as Lizzie McGuire, Flight 29 Down, ER and Alfred Hitchcock Presents...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gLg6YvT67i9LvfFsICYC9dESwS4.jpg", url:"https://themoviedb.org/person/84906"}}, {tmdbId:"15056", properties:{imdbId:"0331193", name:"Michael Gornick", url:"https://themoviedb.org/person/15056"}}, {tmdbId:"1088198", properties:{imdbId:"0217546", name:"Jeffrey Delman", url:"https://themoviedb.org/person/1088198"}}, {tmdbId:"716", properties:{bornIn:"Maspeth, New York, USA", imdbId:"0001915", born:date('1943-05-09'), name:"Emile Ardolino", bio:"From Wikipedia, the free encyclopedia. \n\nEmile Ardolino (May 9, 1943 in Maspeth, New York – November 20, 1993) was an American film director, choreographer, and producer, best known for his films Dirty Dancing (1987) and Sister Act (1992). \n\nDescription above from the Wikipedia article Emile Ardolino, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1993-11-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zWQ87XisfPtlSHjnfl9XMCYZcu6.jpg", url:"https://themoviedb.org/person/716"}}, {tmdbId:"75286", properties:{bornIn:"Melbourne, Australia", imdbId:"0523154", born:date('1959-03-01'), name:"Richard Lowenstein", bio:"Richard Lowenstein (born 1 March 1959 in Melbourne, Australia) is an Australian film director.  He has written, produced and directed the feature films He Died With A Felafel In His Hand, Dogs In Space, Say a Little Prayer, Strikebound and Ghost Story, as well as numerous ground-breaking and award-winning music videos for bands such as INXS and U2, concert performance films and TV commercials...", url:"https://themoviedb.org/person/75286"}}, {tmdbId:"7190", properties:{bornIn:"Los Angeles, California, United States", imdbId:"0542539", born:date('1942-06-01'), name:"Tom Mankiewicz", bio:"​From Wikipedia, the free encyclopedia.   \n\nThomas Frank Mankiewicz (June 1, 1942 – July 31, 2010) was a screenwriter/director/producer of motion pictures and television, perhaps best known for his work on the James Bond films and his contributions to Superman: The Movie and the television series, Hart to Hart. \n\nDescription above from the Wikipedia article Tom Mankiewicz, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2010-07-31'), url:"https://themoviedb.org/person/7190"}}, {tmdbId:"83961", properties:{imdbId:"0156047", name:"John R. Cherry III", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AldEE2bVPtq3rqFjzjtYE4G9vmZ.jpg", url:"https://themoviedb.org/person/83961"}}, {tmdbId:"51809", properties:{bornIn:"New York, New York, United States", imdbId:"0024120", born:date('1923-12-20'), name:"Rod Amateau", bio:"From Wikipedia, the free encyclopedia. \n\nRodney \"Rod\" Amateau (December 20, 1923 – June 29, 2003) was an American screenwriter, film and television director. \n\nAmong programs that he directed were NBC's The Dennis Day Show, CBS's sitcoms The Many Loves of Dobie Gillis, starring Dwayne Hickman, and The New Phil Silvers Show, an unsuccessful attempt by comedian Phil Silvers to return to a regular series. \n\nRod also directed a few episodes of the Dukes of Hazzards.  He even appeared in a few of them...", died:date('2003-06-29'), url:"https://themoviedb.org/person/51809"}}, {tmdbId:"42309", properties:{bornIn:"Budapest, Hungary", imdbId:"0847749", born:date('1954-09-11'), name:"Tibor Takács", bio:"From Wikipedia, the free encyclopedia.   Tibor Takács (born September 11, 1954 in Budapest), is an Hungarian director, noted for directing The Gate (1987), and it's sequel, The Gate II: Trespassers.  He was the recording engineer behind Toronto punk band The Viletones's recording sessions in the spring of 1977  and producer of the Cardboard Brains, \"White EP\" (1977) and the Cardboard Brains \"Black EP\" (1978).  Cardboard Brains were also featured in the \"Last Pogo\" punk documentary by Colin Brunton...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6W3KQ7vcNEs1hOFCkGq9TyeXLFo.jpg", url:"https://themoviedb.org/person/42309"}}, {tmdbId:"92438", properties:{bornIn:"Toronto, Canada", imdbId:"0685923", born:date('1950-11-04'), name:"Bruce Pittman", url:"https://themoviedb.org/person/92438"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"31211", properties:{bornIn:"Liverpool, England, UK", imdbId:"0000850", born:date('1952-10-05'), name:"Clive Barker", bio:"From Wikipedia, the free encyclopedia. \n\nClive Barker (born 5 October 1952) is an English author, film director and visual artist best known for his work in both fantasy and horror fiction.  Barker came to prominence in the mid-1980s with a series of short stories which established him as a leading young horror writer.  He has since written many novels and other works, and his fiction has been adapted into motion pictures, notably the Hellraiser and Candyman series...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3056HPGCQHE7FmIputLldocuibY.jpg", url:"https://themoviedb.org/person/31211"}}, {tmdbId:"89467", properties:{bornIn:"Paterson, New Jersey, USA", imdbId:"0320588", born:date('1939-01-17'), name:"Bob Giraldi", bio:"From Wikipedia, the free encyclopedia. \n\nBob Giraldi (born January 17, 1939) is an American film and television director best known for directing the music video for Michael Jackson's song \"Beat It. \" His work has garnered many accolades, including several London International Awards, Cannes Advertising Awards, NY International Awards, Addy Awards, Chicago Film Festival Awards and hundreds of Clio Awards.  He has also been named one of the \"101 Stars Behind 100 Years of Advertising...", url:"https://themoviedb.org/person/89467"}}, {tmdbId:"607", properties:{bornIn:"Xi'an, Shaanxi, China", imdbId:"0955443", born:date('1951-11-14'), name:"Yimou Zhang", bio:"Zhang Yimou (born November 14, 1950 or 1951)  is a Chinese film director, producer, writer and actor, and former cinematographer.  He is counted amongst the Fifth Generation of Chinese filmmakers, having made his directorial debut in 1987 with Red Sorghum...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uU5vECl94jDQYjiRk4eOpVRMEi9.jpg", url:"https://themoviedb.org/person/607"}}, {tmdbId:"69331", properties:{imdbId:"0928832", name:"Ethan Wiley", bio:"From Wikipedia\n\nThe Free Encyclopedia\n\nWiley wrote the screenplay for the 1986 film House and has written and directed several other horror films, including, House II: The Second Story, Children of the Corn V: Fields of Terror, starring David Carradine and Eva Mendes, Blackwater Valley Exorcism and Brutal, starring Jeffrey Combs, Michael Berryman and Sarah Thompson.  In 2006, Wiley formed Wiseacre Films, an independent production company...", url:"https://themoviedb.org/person/69331"}}, {tmdbId:"35452", properties:{bornIn:"Hong Kong, British Crown Colony [now China]", imdbId:"0477035", born:date('1951-12-16'), name:"Corey Yuen", bio:"Corey Yuen Kwai ( born 1951) is a Hong Kong actor, filmmaker and producer.  He was a member of the Peking Opera Schools and one of the Seven Little Fortunes. \n\nDescription above from the Wikipedia article Corey Yuen Kwai, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9y23Y7euINslLeoz2jbu2pQvkQj.jpg", url:"https://themoviedb.org/person/35452"}}, {tmdbId:"78523", properties:{bornIn:"London, England", imdbId:"0437709", born:date('1952-11-30'), name:"Marek Kanievska", bio:"From Wikipedia, the free encyclopedia. \n\nMarek Kanievska (born 30 November 1952) is a British film director.  His films have won various awards at the Cannes Film Festival and the Florence Film Festival. \n\nDescription above from the Wikipedia article Marek Kanievska, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/78523"}}, {tmdbId:"70737", properties:{bornIn:"Blythe, California, USA", imdbId:"0323787", born:date('1954-07-18'), name:"Gary Goddard", bio:"From Wikipedia, the free encyclopedia. \n\nGary Goddard (born July 18, 1954) is the Founder and CEO of The Goddard Group- an entertainment design firm based in North Hollywood, California...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4Lz3MkIa68p8ycPSJdSIRWyziwq.jpg", url:"https://themoviedb.org/person/70737"}}, {tmdbId:"105294", properties:{imdbId:"0578899", born:date('1948-03-20'), name:"George Mendeluk", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hUuc10huzcdYOtIW6VoV32TZxaA.jpg", url:"https://themoviedb.org/person/105294"}}, {tmdbId:"16157", properties:{bornIn:"New York - USA", imdbId:"0386443", born:date('1943-01-01'), name:"Tina Hirsch", url:"https://themoviedb.org/person/16157"}}, {tmdbId:"70602", properties:{bornIn:"Berlin, Germany", imdbId:"0125367", born:date('1963-12-20'), name:"Jörg Buttgereit", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vVyXQqwSfLuMSCCpV5lkonBokOl.jpg", url:"https://themoviedb.org/person/70602"}}, {tmdbId:"82579", properties:{bornIn:"Honolulu, Hawaii, USA", imdbId:"0855107", born:date('1955-10-16'), name:"Kevin Tenney", bio:"From Wikipedia, the free encyclopedia. \n\nKevin S.  Tenney (born October 16, 1955) is a film director and screenwriter. \n\nDescription above from the Wikipedia article Kevin Tenney, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/r4ryNTNtrxXuXkpFHZZrrRfYO3O.jpg", url:"https://themoviedb.org/person/82579"}}, {tmdbId:"33008", properties:{bornIn:"Tiberias, Palestine [now Israel]", imdbId:"0324875", born:date('1929-05-31'), name:"Menahem Golan", bio:"​From Wikipedia, the free encyclopedia.   \n\nMenahem Golan (born 31 October, 1929 - died 8 August, 2014) was an Israeli director and producer.  He has produced movies for such stars as Sean Connery, Sylvester Stallone, Chuck Norris, Jean-Claude Van Damme, and Charles Bronson, and was known for a period as a producer of comic book-style movies like Masters of the Universe, Superman IV: The Quest for Peace, Captain America, and his aborted attempt to bring Spider-Man to the silver screen...", died:date('2014-08-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qGtHMLd4E7tRyw75H4lWTRelW7B.jpg", url:"https://themoviedb.org/person/33008"}}, {tmdbId:"65688", properties:{imdbId:"0236930", name:"Jim Drake", bio:"From Wikipedia, the free encyclopedia\n\nJim Drake is an American film and television director. \n\nDrake's career began in 1974, working as an associate director for the Norman Lear sitcoms All in the Family and Good Times, he made is solo directorial debut in the series Mary Hartman, Mary Hartman which was executive produced by Lear...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2a4iZ2zlCcGzKGwoUQlSWRs6iXl.jpg", url:"https://themoviedb.org/person/65688"}}, {tmdbId:"67259", properties:{bornIn:"Anhui, China", imdbId:"0157889", name:"Siu-Tung Ching", bio:"Tony Ching Siu-Tung (traditional Chinese: 程小東 (born 1953) is a Hong Kong action choreographer, film director, actor and film producer, who has directed over 20 films, including the critically acclaimed supernatural fantasy A Chinese Ghost Story (1987). \n\nDescription above from the Wikipedia article Ching Siu-tung, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iqw8vUPyZ5TMbk9G2XPYHTTyxZN.jpg", url:"https://themoviedb.org/person/67259"}}, {tmdbId:"112921", properties:{bornIn:" Austin, Texas, USA", imdbId:"0110564", name:"Deborah Brock", url:"https://themoviedb.org/person/112921"}}, {tmdbId:"21118", properties:{bornIn:"New York City, New York, USA", imdbId:"0614013", born:date('1966-01-01'), name:"James M. Muro", bio:"J.  Michael Muro is an American cinematographer and director working in both the film and television industries.  Muro lives in New Orleans with his family...", url:"https://themoviedb.org/person/21118"}}, {tmdbId:"16863", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0001331", born:date('1961-01-02'), name:"Todd Haynes", bio:"Todd Haynes (born January 2, 1961) is an American film director, screenwriter and producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wBDazO2j49uoquoHTEDxcniyGGC.jpg", url:"https://themoviedb.org/person/16863"}}, {tmdbId:"18500", properties:{bornIn:"La Cañada, California, USA", imdbId:"0423333", born:date('1961-11-20'), name:"Phil Joanou", bio:"Phil Joanou is an American film director.  He is also well known for his work with Irish rock band U2, having directed their rockumentary/live tape Rattle and Hum, one of three videos filmed for \"One\", and the video for \"All Because of You\".  Married to Ford Model Breann Nelson. \n\nThe film Entropy (1999) was Joanou's own autobiography, wherein the director played by Stephen Dorff passes through many of the incidents of Joanou's own life...", url:"https://themoviedb.org/person/18500"}}, {tmdbId:"69982", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0088121", born:date('1943-08-12'), name:"Jeff Bleckner", bio:"Jeff Bleckner is a director and producer...", url:"https://themoviedb.org/person/69982"}}, {tmdbId:"28169", properties:{bornIn:"Pittsburgh, Pennsylvania, USA", imdbId:"0280901", born:date('1945-09-19'), name:"Paul Flaherty", url:"https://themoviedb.org/person/28169"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"63709", properties:{bornIn:" Los Angeles, California, U.S.", imdbId:"0062644", born:date('1949-10-20'), name:"Craig R. Baxley", bio:"Craig Redding Baxley is an American actor, director and stunt performer.  He is best known for his work in the action and thriller genres. \n\nBeginning his career as a stunt performer, he was hired to perform stunts in number of notable television series namely Police Story, Harry O, Rich Man, Poor Man Book II, Gemini Man, Roots, M*A*S*H, The Dukes of Hazzard and The A-Team (his head directorial debut)...", url:"https://themoviedb.org/person/63709"}}, {tmdbId:"185", properties:{bornIn:"Miyagi Prefecture, Japan", imdbId:"0960028", born:date('1954-04-14'), name:"Katsuhiro Ôtomo", bio:"Katsuhiro Otomo is a Japanese comic book creator, screenwriter and film director.  He is best known as the creator of the manga Akira and its animated film adaptation.  He also directed several live-action movies...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hMxQlQa0cKLx086va8KDIyOdxO1.jpg", url:"https://themoviedb.org/person/185"}}, {tmdbId:"170258", properties:{imdbId:"0090877", name:"Richard Boden", url:"https://themoviedb.org/person/170258"}}, {tmdbId:"51572", properties:{bornIn:"Gardena, California, USA", imdbId:"0635760", born:date('1951-11-23'), name:"Aaron Norris", bio:"From Wikipedia, the free encyclopedia\n\nAaron Norris (b.  November 23, 1951 in Gardena, California) is an American film producer, director, actor. \n\nDescription above from the Wikipedia article Aaron Norris, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/51572"}}, {tmdbId:"58463", properties:{imdbId:"0139111", name:"Glenn Gordon Caron", bio:"​From Wikipedia, the free encyclopedia.   \n\nGlenn Gordon Caron (born 1954) (sometimes credited as Glenn Caron) is an American television writer, director and producer.  He lives in Los Angeles, CA. \n\nDescription above from the Wikipedia article Glenn Gordon Caron, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/58463"}}, {tmdbId:"61824", properties:{bornIn:"Santa Monica, California, USA", imdbId:"0308376", born:date('1951-12-04'), name:"Mick Garris", bio:"From Wikipedia, the free encyclopedia. \n\nMick Garris (born December 4, 1951) is an American filmmaker and screenwriter born in Santa Monica, California...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mZUsXhL7H5DgaQL98qslFrgp1yl.jpg", url:"https://themoviedb.org/person/61824"}}, {tmdbId:"58164", properties:{bornIn:"London, England", imdbId:"0417708", born:date('1955-06-01'), name:"Annabel Jankel", bio:"From Wikipedia, the free encyclopedia\n\nAnnabel Jankel is an award-winning British film and TV director who first came to prominence as a music video director and the co-creator and director of the pioneering cyber-character Max Headroom.  She is the sister of musician and songwriter Chaz Jankel, who is best known as a member of the British New Wave band Ian Dury & The Blockheads...", url:"https://themoviedb.org/person/58164"}}, {tmdbId:"58165", properties:{imdbId:"0608084", name:" Rocky Morton", url:"https://themoviedb.org/person/58165"}}, {tmdbId:"59", properties:{bornIn:"Paris, France", imdbId:"0000108", born:date('1959-03-18'), name:"Luc Besson", bio:"Luc Besson is a French film director, writer, and producer known for making highly visual thriller and action films.   Besson has been nominated for, and won, numerous awards and honors from the foreign press, and is often credited as inventing the so-called \"Cinema du look\" movement in French film.   \n\nBorn in Paris, Besson spent his childhood traveling Europe with his parents and developing an enthusiasm for ocean diving, before an accident would push him toward the world of cinema...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p7QoPAMP6wfkgcwELkM5VtdGYHU.jpg", url:"https://themoviedb.org/person/59"}}, {tmdbId:"628", properties:{bornIn:"Ujiyamada, Mie prefecture, Japan", imdbId:"0847223", born:date('1935-10-29'), name:"Isao Takahata", bio:"Isao Takahata (October 29, 1935 - April 5, 2018), co-founder of Studio Ghibli, was one of the most famous directors of Japanese animated films.  Unlike most anime directors, he did not draw and never worked as an animator before becoming a director. \n\nFor the first two decades of his career from the 1960s to the 1980s, Takahata worked primarily as director for anime television...", died:date('2018-04-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bdkzoNTQnZIy7UJxsEdFlhY34gi.jpg", url:"https://themoviedb.org/person/628"}}, {tmdbId:"23914", properties:{bornIn:"Tulsa, Oklahoma, USA", imdbId:"0807573", name:"Bud S. Smith", url:"https://themoviedb.org/person/23914"}}, {tmdbId:"17309", properties:{bornIn:"Honolulu - Hawaii - USA", imdbId:"0066439", born:date('1962-01-01'), name:"Greg Beeman", bio:"​From Wikipedia, the free encyclopedia. \n\nGreg Beeman (born 1962 in Honolulu, Hawaii) is an American director and producer best known for his work with television series Smallville, JAG, Heroes and numerous comedy films...", url:"https://themoviedb.org/person/17309"}}, {tmdbId:"83784", properties:{bornIn:"Prague, Czechoslovakia [now Czech Republic]", imdbId:"0840905", born:date('1934-09-04'), name:"Jan Svankmajer", bio:"​From Wikipedia, the free encyclopedia.   \n\nJan Švankmajer (born 4 September 1934) is a Czech surrealist artist and filmmaker.  His work spans several media.  He is known for his surreal animations and features, which have greatly influenced other artists such as Tim Burton, Terry Gilliam, the Brothers Quay, and many others. \n\nDescription above from the Wikipedia article Jan Švankmajer, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yU9pXfrklm9GLg6II7Tr0LH5PE7.jpg", url:"https://themoviedb.org/person/83784"}}, {tmdbId:"16938", properties:{bornIn:"Riihimäki, Finland", imdbId:"0001317", born:date('1959-03-15'), name:"Renny Harlin", bio:"Renny Harlin born Lauri Mauritz Harjola, is a Finnish film director and producer, known for directing many action and horror movies.  Harlin, best known for directing Die Hard 2, is a 4-time nominee for the infamous Golden Raspberry Award for worst film directing.  He is, however, 86th on the list of highest grossing directors of all time (based on U. S.  domestic gross revenue)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/S9fYTvF1wHDiTYadR5MRrbcnot.jpg", url:"https://themoviedb.org/person/16938"}}, {tmdbId:"65314", properties:{bornIn:"Bagheria, Sicilia, Italia", imdbId:"0868153", born:date('1956-05-27'), name:"Giuseppe Tornatore", bio:"Giuseppe Tornatore (born 27 May 1956) is an Italian film director and screenwriter.   Born in Bagheria near Palermo, Tornatore developed an interest in acting and the theatre from at least the age of 16 and put on works by Luigi Pirandello and Eduardo De Filippo.   He worked initially as a freelance photographer.  Then, switching to cinema, he made his debut with Le minoranze etniche in Sicilia (The Ethnic Minorities in Sicily), a collaborative documentary film which won a Salerno Festival prize...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/t5PurTT9QuvV5Xs9Q2JzVui5oqF.jpg", url:"https://themoviedb.org/person/65314"}}, {tmdbId:"71792", properties:{imdbId:"0780117", name:"George Scribner", url:"https://themoviedb.org/person/71792"}}, {tmdbId:"32632", properties:{bornIn:" Munich, Bavaria, Germany", imdbId:"0000727", born:date('1935-06-01'), name:"Percy Adlon", url:"https://themoviedb.org/person/32632"}}, {tmdbId:"14995", properties:{bornIn:"Edinburgh, Scotland, UK", imdbId:"0002887", born:date('1940-07-01'), name:"Alan Myerson", bio:"From Wikipedia, the free encyclopedia  Alan Myerson (born 1940), is an American film and television director.   Description above from the Wikipedia article Alan Myerson, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/14995"}}, {tmdbId:"33094", properties:{bornIn:"Chicago, IL, USA", imdbId:"0792446", born:date('1945-01-01'), name:"Gary Sherman", bio:"From Wikipedia, the free encyclopedia. \n\nGary Sherman, (born 1945), is an American film director, producer, and writer from Chicago, Illinois.  He began his career directing short films, commercials, industrials, and documentaries while still an undergraduate at IIT's Institute of Design.  After graduating, Gary moved to London, England, where he continued directing commercials and also co-wrote and directed his first feature film, Death Line starring Donald Pleasence...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h1Y6yF33SIYHv96rTyOVrSyYfLK.jpg", url:"https://themoviedb.org/person/33094"}}, {tmdbId:"60261", properties:{bornIn:"Arlington, Virginia, USA", imdbId:"0935644", born:date('1946-04-07'), name:"Stan Winston", bio:"From Wikipedia, the free encyclopedia.   Stanley Winston (April 7, 1946 – June 15, 2008) was an American visual effects supervisor, makeup artist, and film director.  He was best known for his work in the Terminator series, the Jurassic Park series, Aliens, the Predator series, Iron Man, Edward Scissorhands, Avatar and Enthiran.  He won four Academy Awards for his work. \n\nWinston, a frequent collaborator with director James Cameron, owned several effects studios, including Stan Winston Digital...", died:date('2008-06-15'), url:"https://themoviedb.org/person/60261"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"76193", properties:{imdbId:"0123236", name:"Geoff Burrowes", url:"https://themoviedb.org/person/76193"}}, {tmdbId:"6495", properties:{bornIn:"Rourkela, Orissa, India", imdbId:"0619762", born:date('1957-10-15'), name:"Mira Nair", bio:"Mira Nair (born October 15, 1957) is an Indian film director and producer based in New York.  Her production company is Mirabai Films. \n\nShe was educated at Delhi University and Harvard University.  Her debut feature film, Salaam Bombay! (1988), won the Golden Camera award at the Cannes Film Festival and also earned the nomination for Academy Award for Best Foreign Language Film...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nhlVK31Lom6xvzVz3wYlVAE5sPm.jpg", url:"https://themoviedb.org/person/6495"}}, {tmdbId:"1724", properties:{bornIn:"Ottawa, Ontario, Canada", imdbId:"0006854", born:date('1945-01-05'), name:"Roger Spottiswoode", bio:"Roger Spottiswoode is a Canadian-born film director and writer, who began his career as an editor in the 1970s.  He was born in Ottawa, Ontario.  He has directed a number of notable films and television productions, including Under Fire (1983) and the 1997 James Bond film Tomorrow Never Dies starring Pierce Brosnan.  Spottiswoode was one of the writing team responsible for 48 Hrs.  starring Eddie Murphy and Nick Nolte...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kUokVPeqIETfRodYWZEEJ3yujYM.jpg", url:"https://themoviedb.org/person/1724"}}, {tmdbId:"18335", properties:{bornIn:"Paris, France", imdbId:"0806293", born:date('1932-06-25'), name:"George Sluizer", bio:"From Wikipedia, the free encyclopedia\n\nGeorge Sluizer (born 25 June 1932 in Paris, of Dutch and Norwegian parents), is a Dutch filmmaker whose credits include features as well as documentary films. \n\nHe is best known for directing two versions of The Vanishing, a 1988 Dutch-language release, originally titled Spoorloos, and a 1992 American version...", died:date('2014-09-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1HlwIkG0HgzEdM0DZywCPW2ChFy.jpg", url:"https://themoviedb.org/person/18335"}}, {tmdbId:"95653", properties:{bornIn:"Philadelphia, Pennsylvania", imdbId:"0436950", born:date('1947-05-31'), name:"Steven Kampmann", bio:"From Wikipedia, the free encyclopedia\n\nSteven Kampmann (born May 31, 1947) is an American actor, writer, and director.  He was born in Philadelphia, Pennsylvania.  He is best known for his role as Kirk Devane on the first two seasons of Newhart. \n\nKampmann also had roles in The Rodney Dangerfield Show: It's Not Easy Bein' Me, L. A.  Law, The Richest Cat in the World, Multiplicity, and Analyze That.  Additionally, he was a writer for WKRP in Cincinnati...", url:"https://themoviedb.org/person/95653"}}, {tmdbId:"93806", properties:{imdbId:"0279863", name:"Bill Fishman", bio:"From Wikipedia, the free encyclopedia. \n\nBill Fishman is an American film director, whose work includes the cult film Tapeheads, starring Tim Robbins and John Cusack, as well as the film version of the TV classic Car 54, Where Are You?.  He won an award at the 1999 New York International Independent Film &amp; Video Festival and has also directed numerous music videos for such artists as They Might Be Giants, George Clinton and Suicidal Tendencies...", url:"https://themoviedb.org/person/93806"}}, {tmdbId:"42113", properties:{bornIn:"Trenton, New Jersey, USA", imdbId:"0455394", born:date('1942-05-23'), name:"Zalman King", bio:"​From Wikipedia, the free encyclopedia\n\nZalman King (born Zalman King Lefkowitz; May 23, 1942 – February 3, 2012) was an American film director, writer, actor and producer.  His films are known for incorporating sexuality, and are often categorized as erotica. \n\nHe was born Zalman Lefkovitz in Trenton, New Jersey, U. S.  As a young man in 1963 he played a gang member on Alfred Hitchcock Presents (\"Memo from Purgatory\" written by Harlan Ellison) with James Caan and Walter Koenig...", died:date('2012-02-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7nB4hQFfqMAvW1U1glPOOkrihwK.jpg", url:"https://themoviedb.org/person/42113"}}, {tmdbId:"82033", properties:{imdbId:"2215502", name:"Jon Hess", url:"https://themoviedb.org/person/82033"}}, {tmdbId:"48965", properties:{bornIn:"Hampstead, London, England, UK", imdbId:"0382776", born:date('1959-01-01'), name:"Anthony Hickox", bio:"​From Wikipedia, the free encyclopedia\n\nAnthony Hickox (born 1964) is an English film director, actor, film producer and screenwriter. \n\nHis works include Waxwork and its sequel, Waxwork II: Lost in Time, Sundown: The Vampire in Retreat, and Hellraiser III: Hell on Earth. \n\nDescription above from the Wikipedia article Anthony Hickox, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tWAG2uZS9B9QTSzZJRTgWHFlbOs.jpg", url:"https://themoviedb.org/person/48965"}}, {tmdbId:"69605", properties:{bornIn:"Hillsboro, Oregon", imdbId:"0473941", born:date('1955-04-04'), name:" Dan Kuenster", bio:"From Wikipedia, the free encyclopedia. \n\nDan Kuenster (born April 4, 1955 in Hillsboro, Oregon) is known as a character animator, who worked with Don Bluth until he left traditional animation to work on multimedia projects.  He also made a voice cameo of the Doberman bookie in Don Bluth's All Dogs Go To Heaven...", url:"https://themoviedb.org/person/69605"}}, {tmdbId:"93923", properties:{imdbId:"0839233", name:"Cedric Sundstrom", bio:"Born in Johannesburg, South Africa.  Started making 8mm films at the age of thirteen.  He has been in the film industry for 35 years now and worked in the USA, England and South Africa.  His credits include Suffer Little Children. . ...", url:"https://themoviedb.org/person/93923"}}, {tmdbId:"550477", properties:{bornIn:"Hildesheim, Germany", imdbId:"0490771", born:date('1962-03-20'), name:"Christoph Lauenstein", url:"https://themoviedb.org/person/550477"}}, {tmdbId:"550478", properties:{bornIn:"Hildesheim, Germany", imdbId:"0490773", born:date('1962-03-20'), name:" Wolfgang Lauenstein", url:"https://themoviedb.org/person/550478"}}, {tmdbId:"82443", properties:{imdbId:"0705675", name:"Robert Radler", url:"https://themoviedb.org/person/82443"}}, {tmdbId:"186518", properties:{imdbId:"0090015", name:"Jeff Blyth", url:"https://themoviedb.org/person/186518"}}, {tmdbId:"10702", properties:{bornIn:"Hastings, New Zealand", imdbId:"0132709", born:date('1943-10-24'), name:"Martin Campbell", bio:"Martin Campbell is a New Zealand TV and film director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vPT3FJrBE35yRpbbkLWQthhEDcr.jpg", url:"https://themoviedb.org/person/10702"}}, {tmdbId:"13015", properties:{bornIn:"Griffith - New South Wales - Australia", imdbId:"0637518", born:date('1950-04-29'), name:"Phillip Noyce", bio:"From Wikipedia, the free encyclopedia. \n\nPhillip Noyce (born 29 April 1950) is an Australian film director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/t41FK8X4egnSLNDexVUZ5yGq3XB.jpg", url:"https://themoviedb.org/person/13015"}}, {tmdbId:"54971", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0733692", born:date('1965-06-07'), name:"Marc Rocco", bio:"From Wikipedia, the free encyclopedia.   Marc Rocco (June 19, 1962 - May 1, 2009) was an American film director, film producer and screenwriter. \n\nHe was born in Los Angeles, California, to Harvey King and Sandra Elaine Garrett (1942-2002).  Garrett married actor Alex Rocco in 1964, who adopted Marc.   Movies directed include Where the Day Takes You and Murder in the First.   He died at his home in Los Angeles, aged 46, leaving a widow, Lisa...", died:date('2009-05-01'), url:"https://themoviedb.org/person/54971"}}, {tmdbId:"10967", properties:{bornIn:"Austin - Texas - USA", imdbId:"0460141", born:date('1960-03-18'), name:"Steve Kloves", bio:"Steve Kloves, born in Austin, Texas, grew up in Sunnyvale, California, where he graduated from Fremont High School.  He attended the University of California, Los Angeles but dropped out when he was not admitted into the film school in his third year.  As an unpaidintern for a Hollywood agent, he gained attention for a screenplay he wrote called Swings.  This led to a meeting where he successfully pitched Racing with the Moon (1984)...", url:"https://themoviedb.org/person/10967"}}, {tmdbId:"23968", properties:{bornIn:"Long Beach, New York, USA", imdbId:"0004675", born:date('1950-03-01'), name:"Phil Alden Robinson", bio:"​Phil Alden Robinson is an American director and screenwriter for film and television, best known for \"Field of Dreams\", \"Sneakers\", and \"The Sum of All Fears\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cYgEgM3MxDb0I1olvrZNHXjuC6I.jpg", url:"https://themoviedb.org/person/23968"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"64875", properties:{imdbId:"0906901", name:"Chris Walas", url:"https://themoviedb.org/person/64875"}}, {tmdbId:"7854", properties:{bornIn:"Tokyo, Giappone", imdbId:"0718031", born:date('1947-01-01'), name:"Al Reinert", url:"https://themoviedb.org/person/7854"}}, {tmdbId:"64735", properties:{bornIn:"California, USA", imdbId:"0373154", name:"Rob Hedden", url:"https://themoviedb.org/person/64735"}}, {tmdbId:"64681", properties:{imdbId:"0228262", name:"Mark DiSalle", url:"https://themoviedb.org/person/64681"}}, {tmdbId:"15868", properties:{bornIn:"Neuenburg am Rhein, Germany", imdbId:"0248942", born:date('1947-04-11'), name:"Uli Edel", bio:"​From Wikipedia, the free encyclopedia\n\nUli Edel (born April 11, 1947 in Neuenburg am Rhein, Germany) is a German film director. \n\nDescription above from the Wikipedia article Uli Edel , licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d4UsOWPEgbNsuaQ7MUMPW11MYbe.jpg", url:"https://themoviedb.org/person/15868"}}, {tmdbId:"23677", properties:{bornIn:"Pittsburgh, Pennsylvania, USA", imdbId:"0701592", born:date('1938-11-04'), name:"Joe Pytka", url:"https://themoviedb.org/person/23677"}}, {tmdbId:"15106", properties:{bornIn:"Houston, Texas, USA", imdbId:"0772095", born:date('1950-05-22'), name:"Thomas Schlamme", bio:"Thomas Schlamme (born May 22, 1950) is an American television director and producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fTKKdVt16KeE5sJWAutnEvv2gC8.jpg", url:"https://themoviedb.org/person/15106"}}, {tmdbId:"37626", properties:{bornIn:"Paris, France", imdbId:"0496312", born:date('1947-11-12'), name:"Patrice Leconte", bio:"​From Wikipedia, the free encyclopedia.   \n\nPatrice Leconte (born November 12, 1947, in Paris, France) is a French film director, actor, comic strip writer, and screenwriter. \n\nDescription above from the Wikipedia article Patrice Leconte, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6ybiEcJLFbf2ctyxK8bqYa1cXYy.jpg", url:"https://themoviedb.org/person/37626"}}, {tmdbId:"53334", properties:{bornIn:"Dublin, Ireland", imdbId:"0006487", born:date('1949-02-06'), name:"Jim Sheridan", bio:"Jim Sheridan (born 6 February 1949) is an Irish film director.  A six-time Academy Award nominee, Sheridan is perhaps best known for his films My Left Foot, In the Name of the Father, Get Rich or Die Tryin' and In America...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w1tj1v02jDQMc9M56qJC5UymVoU.jpg", url:"https://themoviedb.org/person/53334"}}, {tmdbId:"80523", properties:{imdbId:"0646987", name:"Ron Oliver", bio:"​From Wikipedia, the free encyclopedia\n\nRon Oliver is a Canadian-born writer, director, producer, and actor who started with the cult hit Hello Mary Lou: Prom Night II.  He was also a host on Canada's YTV.  He has gone on to direct various television and motion picture scripts.  He has been nominated twice for the Directors Guild of America Award. \n\nHe received an Emmy nomination for producing the NBC children's series \"Scout's Safari\" filmed on location in South Africa...", url:"https://themoviedb.org/person/80523"}}, {tmdbId:"35329", properties:{imdbId:"0801157", name:" Peter R. Simpson", url:"https://themoviedb.org/person/35329"}}, {tmdbId:"52268", properties:{bornIn:"Louisville, Kentucky, USA", imdbId:"0773541", born:date('1947-12-08'), name:"David Schmoeller", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qXfp7TR5E0nFpKBpoL41rOOP3MK.jpg", url:"https://themoviedb.org/person/52268"}}, {tmdbId:"98132", properties:{bornIn:"Glen Cove, Long Island, New York, USA", imdbId:"0691061", born:date('1950-08-14'), name:"Jim Wynorski", bio:"An American screenwriter, director, and producer.  Wynorski has been making B-movies and exploitation movies since the early 1980s, and has directed over 75 feature films.  His earliest films were released to movie theaters, but his later works have predominantly been released to cable or the straight-to-video market.  He often works under pseudonyms such as \"Jay Andrews,\" \"Arch Stanton,\" \"H. R.  Blueberry,\" \"Tom Popatopolis,\" and \"Noble Henry...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Swxvvs1HmAxEEdmucCrgqfHpuG.jpg", url:"https://themoviedb.org/person/98132"}}, {tmdbId:"11649", properties:{bornIn:"Palm Springs, California, USA", imdbId:"0001081", born:date('1957-07-13'), name:"Cameron Crowe", bio:"Cameron Bruce Crowe (born July 13, 1957) is an American screenwriter and film director. \n\nBefore moving into the film industry, Crowe was a contributing editor at Rolling Stone magazine, for which he still frequently writes.  Crowe has made his mark with character-driven, personal films that have been generally hailed as refreshingly original and devoid of cynicism...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iBCN51wrmnSUr2mkQBuN9E2AZK.jpg", url:"https://themoviedb.org/person/11649"}}, {tmdbId:"30365", properties:{bornIn:"Broxburn, West Lothian, Scotland, UK", imdbId:"0001994", born:date('1957-10-15'), name:"Michael Caton-Jones", bio:"Michael Caton-Jones (born Michael Jones; 15 October 1957) is the director of such films as Scandal, Rob Roy, Memphis Belle and The Jackal.  Caton-Jones was born in Broxburn, Lothian, Scotland...", url:"https://themoviedb.org/person/30365"}}, {tmdbId:"119476", properties:{imdbId:"0057733", name:"Zelda Barron", url:"https://themoviedb.org/person/119476"}}, {tmdbId:"6011", properties:{bornIn:" Munich, Bavaria, Germany", imdbId:"0359734", born:date('1942-03-23'), name:"Michael Haneke", bio:"Michael Haneke (born 23 March 1942) is an Austrian filmmaker and writer best known for his bleak and disturbing style.  His films often document problems and failures in modern society.  Haneke has worked in television‚ theatre and cinema.  He is also known for raising social issues in his work.  Besides working as filmmaker he also teaches directing at the Filmacademy Vienna...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6HuUIn0bg9h6kfE5gJnX7tWTXdv.jpg", url:"https://themoviedb.org/person/6011"}}, {tmdbId:"222545", properties:{bornIn:"Helsinki, Finland", imdbId:"0661502", born:date('1939-05-02'), name:"Pekka Parikka", died:date('1997-03-21'), url:"https://themoviedb.org/person/222545"}}, {tmdbId:"38507", properties:{bornIn:"Neuilly-sur-Seine, Hauts-de-Seine, France", imdbId:"0891554", born:date('1937-07-28'), name:"Francis Veber", bio:"From Wikipedia, the free encyclopedia.  Francis Paul Veber (born 28 July 1937) is a French film director, screenwriter and producer.  Many of his comedies feature recurring types of characters, named François Pignon and François Perrin. \n\nVeber was born in Neuilly-sur-Seine, Hauts-de-Seine to a Jewish father and an Armenian mother.  His grand uncle was writer Tristan Bernard. \n\nDescription above from the Wikipedia article Francis Veber, licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tz0Rm7SgvhIIxPUve9mqSfvLEvH.jpg", url:"https://themoviedb.org/person/38507"}}, {tmdbId:"71042", properties:{imdbId:"0505409", name:"Jay Levey", bio:"Jay Levey is a producer and director, known for UHF (1989), Blues Story (2003) and 'Weird Al' Yankovic: Eat It (1984)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kOx3UZ0lYVs7j73iY6Sgf2ba1cj.jpg", url:"https://themoviedb.org/person/71042"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"157301", properties:{born:date('1938-07-24'), name:"Will Mackenzie", url:"https://themoviedb.org/person/157301"}}, {tmdbId:"929918", properties:{imdbId:"0135199", name:" Cathy Caplan", url:"https://themoviedb.org/person/929918"}}, {tmdbId:"1198886", properties:{imdbId:"0359735", name:" Thomas Haneke", url:"https://themoviedb.org/person/1198886"}}, {tmdbId:"929920", properties:{imdbId:"0798023", name:" Lawrence Silk", url:"https://themoviedb.org/person/929920"}}, {tmdbId:"27992", properties:{bornIn:"Manila, Philippines", imdbId:"0951206", born:date('1949-08-30'), name:"Brian Yuzna", bio:"From Wikipedia, the free encyclopedia. \n\nBrian Yuzna (born in the Philippines in 1949) is a director, writer and producer of films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qDChdKxDHwYiQyRZ4B0BEIovbhS.jpg", url:"https://themoviedb.org/person/27992"}}, {tmdbId:"25950", properties:{bornIn:"Auxerre, Francia", imdbId:"0710919", born:date('1932-04-08'), name:"Jean-Paul Rappeneau", url:"https://themoviedb.org/person/25950"}}, {tmdbId:"22151", properties:{bornIn:"Knebworth, England, UK", imdbId:"0610261", name:"Malcolm Mowbray", bio:"From Wikipedia, the free encyclopedia. \n\nMalcolm Mowbray (born 1949) is a British screenwriter and television and film director. \n\nMowbray began his career in television, directing episodes of Premiere, BBC2 Playhouse, and Objects of Affection.  In 1984 he turned to feature films with A Private Function, which he directed and co-wrote with Alan Bennett, with whom he shared the Evening Standard British Film Award for Best Screenplay...", url:"https://themoviedb.org/person/22151"}}, {tmdbId:"18855", properties:{imdbId:"0802326", born:date('1940-03-22'), name:"Ralph S. Singleton", url:"https://themoviedb.org/person/18855"}}, {tmdbId:"1214034", properties:{imdbId:"0663489", born:date('1950-11-14'), name:"James D. Parriott", url:"https://themoviedb.org/person/1214034"}}, {tmdbId:"9200", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0573796", born:date('1950-01-13'), name:"John McNaughton", bio:"John McNaughton (born January 13, 1950) is an American film and television director, originally from Chicago, Illinois...", url:"https://themoviedb.org/person/9200"}}, {tmdbId:"6111", properties:{bornIn:"Carlisle, Cumberland, England, UK", imdbId:"0001214", born:date('1948-02-28'), name:"Mike Figgis", bio:"​From Wikipedia, the free encyclopedia. \n\nMichael \"Mike\" Figgis (born 28 February 1948) is an English film director, writer, and composer...", url:"https://themoviedb.org/person/6111"}}, {tmdbId:"26095", properties:{bornIn:"The Bronx, New York, USA", imdbId:"0788234", born:date('1950-10-03'), name:"John Patrick Shanley", bio:"John Patrick Shanley is an American playwright, screenwriter, and director.  He also contributed articles on the performing arts to The New York Times among other publications...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oUEWmrs3OlEOfsGB87ygxaiSWa.jpg", url:"https://themoviedb.org/person/26095"}}, {tmdbId:"146095", properties:{imdbId:"0271835", name:" Fengliang Yang", url:"https://themoviedb.org/person/146095"}}, {tmdbId:"61019", properties:{imdbId:"0393591", name:"Harry Hook", url:"https://themoviedb.org/person/61019"}}, {tmdbId:"78188", properties:{bornIn:"Washington, District of Columbia, USA", imdbId:"0001775", born:date('1952-01-25'), name:"Whit Stillman", bio:"Whit Stillman (born John Whitney Stillman on January 25, 1952) is an American writer-director known for his sly depictions of the \"urban haute bourgeoisie\" (as a character in Metropolitan terms the upper-class WASPs of the U. S.  socio-cultural elite). \n\nDescription above from the Wikipedia article Whit Stillman, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/95CNDCxxPPwG12eTe4wtGPz7rbl.jpg", url:"https://themoviedb.org/person/78188"}}, {tmdbId:"58294", properties:{imdbId:"0000786", name:"George Armitage", bio:"From Wikipedia, the free encyclopedia\n\nGeorge Armitage (born 1942) is an American film director, screenwriter, and producer who got his start as part of the stable of up-and-coming filmmakers who broke into the business thru Roger Corman's New World Pictures.  He's most well-known as the director of the films Miami Blues and Grosse Pointe Blank. \n\nDescription above from the Wikipedia article George Armitage, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rsVlCNOHKLUyo2xrA1jUlQmUUdx.jpg", url:"https://themoviedb.org/person/58294"}}, {tmdbId:"32640", properties:{bornIn:" Vienna, Austria", imdbId:"0003464", born:date('1941-04-11'), name:"Bernt Amadeus Capra", url:"https://themoviedb.org/person/32640"}}, {tmdbId:"107831", properties:{bornIn:"Dallas, TX", imdbId:"0515255", born:date('1962-02-24'), name:"Jennie Livingston", bio:"Jennie Livingston is a groundbreaking filmmaker, known for her lively storytelling, nuanced character portraits, and thoughtful explorations of identity, class, race, death, sex, and gender.  She works in both fiction and nonfiction.   Jennie's taught at Yale, Connecticut College, and Brooklyn College, lectured widely, written for national magazines, and appeared as a subject or speaker in a number of documentaries and cultural programs...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qNLze0JF7cWzhvKMgfqLOusnuOs.jpg", url:"https://themoviedb.org/person/107831"}}, {tmdbId:"12180", properties:{bornIn:"Tokyo Prefecture, Japan", imdbId:"0651900", born:date('1951-08-08'), name:"Mamoru Oshii", bio:"Mamoru Oshii is a filmmaker, television director, and scriptwriter, famous for his philosophy-oriented storytelling...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q4wbzJlxRv0WREdbZngiqLP0uEC.jpg", url:"https://themoviedb.org/person/12180"}}, {tmdbId:"55790", properties:{bornIn:"Shawinigan, Québec, Canada", imdbId:"0610496", born:date('1947-01-01'), name:"Allan Moyle", bio:"​From Wikipedia, the free encyclopedia. \n\nAllan Moyle  (born 1947 in Shawinigan, Quebec) is a Canadian film director.  He is best known for directing the films Pump Up the Volume (1990) and New Waterford Girl (1999)...", url:"https://themoviedb.org/person/55790"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"2357", properties:{imdbId:"0291442", name:"Howard Franklin", bio:"From Wikipedia, the free encyclopedia. \n\nHoward Franklin is an American screenwriter and film director.  He wrote and directed the (now-cult) '90's comedy Quick Change, starring Bill Murray, Geena Davis and Jason Robards and The Public Eye, a thinly-veiled biography of the tabloid photographer, Weegee (starring Joe Pesci)...", url:"https://themoviedb.org/person/2357"}}, {tmdbId:"87213", properties:{bornIn:"London, England, UK", imdbId:"0726000", born:date('1967-12-29'), name:"Philip Ridley", bio:"From Wikipedia, the free encyclopedia\n\nPhilip Ridley (born 1967 in East London) is a British artist working with various media. \n\nDescription above from the Wikipedia article Philip Ridley, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hBwWDP1zK1Pu6RuU2ueM7Yl77aH.jpg", url:"https://themoviedb.org/person/87213"}}, {tmdbId:"372", properties:{bornIn:"Zlín, Czechoslovakia", imdbId:"0001779", born:date('1937-07-03'), name:"Tom Stoppard", bio:"From Wikipedia, the free encyclopedia.   Sir Tom Stoppard OM, CBE, FRSL (born Tomáš Straussler 3 July 1937) is a British playwright, knighted in 1997.  He has written prolifically for TV, radio, film and stage, finding prominence with plays such as Arcadia, The Coast of Utopia, Every Good Boy Deserves Favour, Professional Foul, The Real Thing, and Rosencrantz and Guildenstern Are Dead...", url:"https://themoviedb.org/person/372"}}, {tmdbId:"110496", properties:{imdbId:"0251057", name:"Jan Egleson", url:"https://themoviedb.org/person/110496"}}, {tmdbId:"98939", properties:{imdbId:"0560370", name:"Sally Mattison", url:"https://themoviedb.org/person/98939"}}, {tmdbId:"33485", properties:{bornIn:"Glendale, California, USA", imdbId:"0881038", born:date('1953-11-06'), name:"Ron Underwood", bio:"Ron Underwood is an American film director, producer and television director...", url:"https://themoviedb.org/person/33485"}}, {tmdbId:"91343", properties:{bornIn:"Lindenhurst, Long Island, New York, USA", imdbId:"0001325", born:date('1959-11-03'), name:"Hal Hartley", bio:"​From Wikipedia, the free encyclopedia\n\nHal Hartley (born November 3, 1959) is an American film director, screenwriter and composer, who became a key figure in the American independent film movement of the 1980s and 1990s.  He is best known for his films Trust, Amateur and Henry Fool, which are notable for deadpan humour and offbeat characters quoting philosophical dialogue...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rs4UzLbTqmqs5r02UiD54fq6kgx.jpg", url:"https://themoviedb.org/person/91343"}}, {tmdbId:"56477", properties:{bornIn:"Hamburg, Germany", imdbId:"0769405", born:date('1957-01-01'), name:" Michael Schaack", url:"https://themoviedb.org/person/56477"}}, {tmdbId:"5174", properties:{bornIn:"New York City, New York, USA", imdbId:"0001756", born:date('1953-04-01'), name:"Barry Sonnenfeld", bio:"From Wikipedia, the free encyclopedia. \n\nBarry Sonnenfeld (born April 1, 1953) is an American filmmaker and television director.  He worked as cinematographer for the Coen Brothers, then later he directed and produced big budget films such as Men in Black. \n\nDescription above from the Wikipedia article Barry Sonnenfeld, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n6y6vaAFfSqsJodgkwTxAey4NoG.jpg", url:"https://themoviedb.org/person/5174"}}, {tmdbId:"64949", properties:{imdbId:"0629216", name:"Phil Nibbelink", url:"https://themoviedb.org/person/64949"}}, {tmdbId:"62047", properties:{bornIn:"La Crescenta, California, USA", imdbId:"0873779", born:date('1960-06-08'), name:"Gary Trousdale", bio:"From Wikipedia, the free encyclopedia. \n\nGary A.  Trousdale (born June 8, 1960) is an American film director known for directing movies such as Beauty and the Beast, The Hunchback of Notre Dame and Atlantis: The Lost Empire.  He frequently directs films with Kirk Wise. \n\nTrousdale planned to become an architect, but decided instead to study animation at CalArts, where he studied for three years.  He was hired in 1982 to design storyboards and do other animation...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lb6bmg1S6tpLIvxVN3Q6gP72h0f.jpg", url:"https://themoviedb.org/person/62047"}}, {tmdbId:"62048", properties:{bornIn:"San Francisco, California, USA", imdbId:"0936374", born:date('1958-11-09'), name:" Kirk Wise", bio:"From Wikipedia, the free encyclopedia. \n\nKirk Wise is an American animator, director and producer known for his work at Disney\n\nWise graduated from Palo Alto High School and went on to study character animation at California Institute of the Arts.  Wise worked as an animator on The Brave Little Toaster, and Steven Spielberg's Amazing Stories episode \"Family Dog\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7UjxOiWuIXGUrxHNSNZ7eaUCgHm.jpg", url:"https://themoviedb.org/person/62048"}}, {tmdbId:"18357", properties:{bornIn:"Brighton, England, UK", imdbId:"0382072", born:date('1962-10-09'), name:"Peter Hewitt", bio:"Peter Hewitt (b.  October, 9 1962, Brighton, England, United Kingdom) is an English film director and writer, known for Garfield (2004) (credited as Pete Hewitt), Thunderpants (2002), Bill & Ted's Bogus Journey (1991) and The Candy Show (1989).   Upon graduating from England's National Film and Television School in 1990, Hewitt flew to Hollywood with his BAFTA award-winning short film, The Candy Show, in hand.  Once there, he called executives from major U. S...", url:"https://themoviedb.org/person/18357"}}, {tmdbId:"6482", properties:{bornIn:"Los Angeles - California - USA", imdbId:"0005436", born:date('1968-01-06'), name:"John Singleton", bio:"​John Daniel Singleton (January 6, 1968-April 29, 2019) was an American film director, screenwriter, and producer.  A native of South Los Angeles, many of his films consider the implications of inner-city violence like the critically acclaimed and popular Boyz n the Hood, Poetic Justice, Higher Learning and Baby Boy.  He later branched out into mainstream territory with the blockbuster 2 Fast 2 Furious and Four Brothers...", died:date('2019-04-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/akcugIHTLKZajrsq51uGGGzHEdv.jpg", url:"https://themoviedb.org/person/6482"}}, {tmdbId:"550819", properties:{imdbId:"0406842", name:"Yasunori Ide", url:"https://themoviedb.org/person/550819"}}, {tmdbId:"2603286", properties:{name:" Matt Greenfield", url:"https://themoviedb.org/person/2603286"}}, {tmdbId:"2630532", properties:{name:"David Kellogg", url:"https://themoviedb.org/person/2630532"}}, {tmdbId:"13680", properties:{bornIn:"Paris, France", imdbId:"0001988", born:date('1956-04-02'), name:"Marc Caro", bio:"​From Wikipedia, the free encyclopedia.   \n\nMarc Caro, born April 2, 1956, is a French filmmaker and cartoonist, best known for his co-directing projects with Jean-Pierre Jeunet.  The two of them met at an animation festival in Annecy in 1974.   Together, Jeunet and Caro directed award-winning animations.  Their first live action film was The Bunker of the Last Gunshots (1981), a short film about soldiers in a bleak futuristic world...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/efDW1xahbkZYBiZRVf8nMS2UfjU.jpg", url:"https://themoviedb.org/person/13680"}}, {tmdbId:"93025", properties:{bornIn:"Bronx, New York, USA", imdbId:"0001700", born:date('1959-07-23'), name:"Nancy Savoca", bio:"From Wikipedia, the free encyclopedia. \n\nNancy Savoca (July 23, 1959), is an American film screenwriter, director, and producer.  Born and raised in the Bronx, New York, she is the daughter of Sicilian and Argentine immigrants Calogero Savoca and Maria Elvira Savoca.  Married to Richard Guay (pronounced as \"gay\"), also a writer and producer, they have three children: two sons and a daughter...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7BkuX3MtvbX5jmKbYl3HZrHRxCp.jpg", url:"https://themoviedb.org/person/93025"}}, {tmdbId:"16590", properties:{bornIn:"New York", imdbId:"0504802", born:date('1951-01-14'), name:"Sheldon Lettich", bio:"From Wikipedia, the free encyclopedia.   Sheldon Lettich (born 14 January 1951) is a screenwriter, film director and producer. \n\nDescription above from the Wikipedia article Sheldon Lettich, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eTwzTAJ4X48FalI9eDDsyvpooOP.jpg", url:"https://themoviedb.org/person/16590"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"16672", properties:{bornIn:"Aardenburg, Zeeland, Netherlands", imdbId:"0429517", born:date('1953-01-01'), name:"Ate de Jong", bio:"Ate de Jong is a Dutch film director.  He has directed Dutch, German, British and American movies and tv shows...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7CccV2n5Xe1RtRRImezylYLPYZS.jpg", url:"https://themoviedb.org/person/16672"}}, {tmdbId:"42", properties:{bornIn:"Kongens Lyngby, Denmark", imdbId:"0001885", born:date('1956-04-30'), name:"Lars von Trier", bio:"Lars von Trier ( born Lars Trier; 30 April 1956) is a Danish film director and screenwriter.  He is closely associated with the Dogme 95 collective, although his own films have taken a variety of different approaches.  He is known for his female-centric parables and his exploration of controversial subject matter...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nIgsB2yZJqWOd4c2jsS82InpcsD.jpg", url:"https://themoviedb.org/person/42"}}, {tmdbId:"18250", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0000816", born:date('1949-11-17'), name:"Jon Avnet", bio:"From Wikipedia, the free encyclopedia\n\nJonathan Michael \"Jon\" Avnet (born November 17, 1949) is an American director, writer and producer. \n\nDescription above from the Wikipedia article Jon Avnet, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/18250"}}, {tmdbId:"36804", properties:{bornIn:"Blackpool, Lancashire, England, UK", imdbId:"0155093", born:date('1956-04-20'), name:"Peter Chelsom", bio:"​From Wikipedia, the free encyclopedia.   \n\nPeter Chelsom (born April 20, 1956) is a British actor and film director.  He has directed among others such films as Shall We Dance? and Hannah Montana: The Movie\n\nChelsom was born in Blackpool, Lancashire, the son of antiques shop owners Kay and Reginald Chelsom.  He studied at the Central School of Drama in London...", url:"https://themoviedb.org/person/36804"}}, {tmdbId:"37850", properties:{imdbId:"0046943", name:"Fax Bahr", url:"https://themoviedb.org/person/37850"}}, {tmdbId:"37852", properties:{bornIn:"St. Louis, Missouri, US", imdbId:"0382584", born:date('1963-05-25'), name:" George Hickenlooper", bio:"George Hickenlooper (May 25, 1963 – October 29, 2010) was an American narrative and documentary filmmaker...", died:date('2010-10-29'), url:"https://themoviedb.org/person/37852"}}, {tmdbId:"67896", properties:{imdbId:"0570408", name:" Doug McHenry", bio:"​From Wikipedia, the free encyclopedia.   \n\nDoug McHenry is an American film director and producer. \n\nHe graduated from Stanford University in 1973 with a degree in Economics, and from Harvard University with a degree in law and business administration. \n\nHe worked for film producer Peter Guber at Casablanca Records before starting his own production company \"Elephant Walk Entertainment\" with partner George Jackson...", url:"https://themoviedb.org/person/67896"}}, {tmdbId:"14089", properties:{imdbId:"0490958", name:"Dale Launer", url:"https://themoviedb.org/person/14089"}}, {tmdbId:"50949", properties:{bornIn:"Beirut, Lebanon", imdbId:"0450194", born:date('1964-07-30'), name:"Alek Keshishian", bio:"From Wikipedia, the free encyclopedia.   Alek Keshishian (born 30 July 1964 in Beirut, Lebanon) is a Lebanese-born American film director.  He is best known for his 1991 film Madonna: Truth or Dare, which for a time was the highest-grossing documentary of all time.   Alek was raised in Manchester, New Hampshire in the USA along with his sister, Aleen, a successful talent manager who represents actors such as Orlando Bloom and Natalie Portman, by their Armenian parents Dr...", url:"https://themoviedb.org/person/50949"}}, {tmdbId:"55916", properties:{bornIn:"Napoli, Italy", imdbId:"0759368", born:date('1950-07-30'), name:"Gabriele Salvatores", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qRBui7fB2dxaChy2cf1msFT52qJ.jpg", url:"https://themoviedb.org/person/55916"}}, {tmdbId:"196769", properties:{imdbId:"0905237", name:"Jonathan Wacks", url:"https://themoviedb.org/person/196769"}}, {tmdbId:"175726", properties:{bornIn:"Puente Alto, Cordillera, Metropolitan Region, Chile", imdbId:"0599624", born:date('1949-01-01'), name:"Jorge Montesi", url:"https://themoviedb.org/person/175726"}}, {tmdbId:"53387", properties:{imdbId:"0332392", name:"Heywood Gould", url:"https://themoviedb.org/person/53387"}}, {tmdbId:"13581", properties:{bornIn:"Highland Park, Illinois, USA", imdbId:"0505152", born:date('1952-08-06'), name:"Brian Levant", bio:"From Wikipedia, the free encyclopedia. \n\nBrian Michael Levant (born August 6, 1952) is an American television and film director, writer and producer. \n\nLevant was born in Highland Park, Illinois.  He started his career in 1977 as a writer for the TV series \"The Jeffersons\".  He also wrote for, among other TV shows, Mork &amp; Mindy, Still the Beaver, and Happy Days. \n\nHe is best known for directing the films Beethoven, The Flintstones, Jingle All the Way and Are We There Yet?...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w5i30CI5PekRZry3AgME1ntEQSP.jpg", url:"https://themoviedb.org/person/13581"}}, {tmdbId:"3047", properties:{bornIn:"\tMelbourne, Australia", imdbId:"0602104", born:date('1960-09-04'), name:"Jocelyn Moorhouse", url:"https://themoviedb.org/person/3047"}}, {tmdbId:"97618", properties:{bornIn:"Portland, Oregon, USA", imdbId:"0213983", born:date('1962-01-05'), name:"David DeCoteau", bio:"​A dual citizen of Canada and the USA, David DeCoteau has worked professionally in the movie business since he was 18 years old.  He got his start through a generous offer from movie legend Roger Corman, who hired him in 1980 as a production assistant at New World Pictures.  In 1986, DeCoteau directed and produced his first feature film for another generous film legend, Charles Band.  DeCoteau has gone on to produce and direct more than fifty motion pictures over the past twenty years...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qFHX5E3M54ZXhLw4Bd7NcWGsUte.jpg", url:"https://themoviedb.org/person/97618"}}, {tmdbId:"16939", properties:{bornIn:"New York City, New York, USA", imdbId:"0866062", born:date('1950-10-17'), name:"Michael Tolkin", bio:"From Wikipedia, the free encyclopedia. \n\nMichael L.  Tolkin (born October 17, 1950) is an American filmmaker and novelist.  He has written numerous screenplays, including The Player (1992), which he adapted from his 1988 book by the same name, and for which he received the 1993 Edgar Award for Best Motion Picture Screenplay.  A follow-up book, The Return of the Player, was published in 2006...", url:"https://themoviedb.org/person/16939"}}, {tmdbId:"83467", properties:{bornIn:" New York City, New York, USA", imdbId:"0334353", born:date('1926-05-15'), name:"William A. Graham", bio:"William A.  Graham is an American television and film director.  Graham directed episodes of many TV series including The Fugitive, Twelve O'Clock High, The Big Valley, Batman and Ironside.  He also produced and directed the romance adventure sequel Return to the Blue Lagoon (1991).  Graham was the director of Elvis Presley's final acting in a motion picture, Change of Habit in 1969.  \n\nDescription above from the Wikipedia article  William A...", died:date('2013-09-12'), url:"https://themoviedb.org/person/83467"}}, {tmdbId:"5707", properties:{imdbId:"0005572", born:date('1954-04-02'), name:"Lili Fini Zanuck", url:"https://themoviedb.org/person/5707"}}, {tmdbId:"774", properties:{bornIn:"Canada", imdbId:"0677943", born:date('1952-10-30'), name:"Daniel Petrie Jr.", bio:"From Wikipedia, the free encyclopedia.  Daniel Petrie, Jr.  (born 1952), the son of Daniel Petrie, Sr. , is perhaps best known as the one of the screenwriters of the mid-1980s hit movie, Beverly Hills Cop and The Big Easy as well as the director of Toy Soldiers. \n\nHe is currently (October 2004) president of the western chapter of the Writers Guild of America. \n\nDescription above from the Wikipedia article Daniel Petrie, Jr. , licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/774"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"46085", properties:{bornIn:"Mexico City, Distrito Federal, Mexico", imdbId:"0001502", name:"Luis Mandoki", bio:"From Wikipedia, the free encyclopedia. \n\nLuis Mandoki (born in 1954 in Mexico City) is a Mexican film director working in Mexico and Hollywood. \n\nLuis Mandoki studied Fine Arts in Mexico and at the San Francisco Art Institute, the London College of Printing, and the London International Film School.  While attending this last institution he directed his first short film Silent Music which won an award at the International Amateur Film Festival of Cannes Film Festival in 1976...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5UEo6jE5X3uknDVoCLPsXZdnphT.jpg", url:"https://themoviedb.org/person/46085"}}, {tmdbId:"26760", properties:{bornIn:"Saigon, Vietnam", imdbId:"0007139", born:date('1950-02-15'), name:"Hark Tsui", bio:"From Wikipedia, the free encyclopedia\n\nTsui Hark (Chinese: 徐克, Vietnamese: Từ Khắc, born 15 February 1950), born Tsui Man-kong, is a New Wave film director in Hong Kong and an influential film producer.  He is viewed as a major figure in the Golden Age of Hong Kong cinema (typically early 1980s to mid 1990s). \n\nDescription above from the Wikipedia article Tsui Hark, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9WTG1Feva6S7n09dxON40KHBsuk.jpg", url:"https://themoviedb.org/person/26760"}}, {tmdbId:"12962", properties:{bornIn:"New York City, New York, USA", imdbId:"0005509", born:date('1963-08-08'), name:"Jon Turteltaub", bio:"Jonathan Charles \"Jon\" Turteltaub is an American film director and producer.  He is a graduate of Wesleyan University and the USC School of Cinematic Arts.  He is the son of television comedy writer Saul Turteltaub...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rajguVIeJ5fF68zZNW45ij9OgDh.jpg", url:"https://themoviedb.org/person/12962"}}, {tmdbId:"7467", properties:{bornIn:"Denver, Colorado, USA", imdbId:"0000399", born:date('1962-08-28'), name:"David Fincher", bio:"David Andrew Leo Fincher (born August 28, 1962) is an American film director and music video director.  Known for his dark and stylish thrillers, such as Seven (1995), The Game (1997), Fight Club (1999), Panic Room (2002), and Zodiac (2007), Fincher received Academy Award nominations for Best Director for his 2008 film The Curious Case of Benjamin Button and his 2010 film The Social Network, which also won him the Golden Globe and the BAFTA for best director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wdBeQXDNbbjkIKXHeEZtQShwSDM.jpg", url:"https://themoviedb.org/person/7467"}}, {tmdbId:"68994", properties:{bornIn:"USA", imdbId:"0294825", name:"Ron Fricke", bio:"From Wikipedia, the free encyclopedia.   Ron Fricke is an American film director and cinematographer, considered to be a master of time-lapse photography and large format cinematography.  He was the director of photography for Koyaanisqatsi (1982) and directed the purely cinematic non-verbal non-narrative feature Baraka (1992).  He designed and used his own 65 mm camera equipment for Baraka and his later projects.  He also directed the IMAX films Chronos (1985) and Sacred Site (1986)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iowDlYDiew3P2sRvJdIZ1VWW1jF.jpg", url:"https://themoviedb.org/person/68994"}}, {tmdbId:"37526", properties:{bornIn:"  Madrid, Spain", imdbId:"0874096", born:date('1955-01-18'), name:"Fernando Trueba", bio:"Trueba studied Cinematography at the Facultad de Ciencias de la Información, was cinema critic for the newspaper 'El País' and for 'La Guía del Ocio' and also founded the journal \"Casablanca\".  At the movies his first success was 'Opera Prima' (1980) following the style of the \"comedia madrileña\".  He had major success with 'Sé infiel y no mires con quién' (1985) starting a longer colaboration with the producer Andrés Vicente Gómez...", url:"https://themoviedb.org/person/37526"}}, {tmdbId:"69237", properties:{bornIn:"Boca Raton, Florida, USA", imdbId:"0075666", born:date('1961-10-30'), name:"Joe Berlinger", bio:"Joseph \"Joe\" Berlinger (born October 30, 1961) is an American documentary film-maker who, in collaboration with Bruce Sinofsky, has created such films as Paradise Lost about the West Memphis 3, Brother's Keeper, Some Kind of Monster, and Crude...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yvCTSlShNLmaq9NNlFKpFOLrVeJ.jpg", url:"https://themoviedb.org/person/69237"}}, {tmdbId:"69238", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0802501", born:date('1956-03-31'), name:" Bruce Sinofsky", bio:"Bruce Sinofsky (March 31, 1956 – February 21, 2015) was an American documentary film director, particularly known for his films the Paradise Lost trilogy, Brother's Keeper and Some Kind of Monster, all created with Joe Berlinger. \n\nSinofsky was born in Boston, Massachusetts.  As Senior Editor for Maysles, he worked on commercials and feature films until 1991, when he and Joe Berlinger formed their own production company, Creative Thinking International...", died:date('2015-02-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1q3XNj3QSLgthnmZKX8lXIhyxIB.jpg", url:"https://themoviedb.org/person/69238"}}, {tmdbId:"64170", properties:{imdbId:"0476900", name:"Fran Rubel Kuzui", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6puK1iTlKTlE4Q1dbNZFcdoQJAG.jpg", url:"https://themoviedb.org/person/64170"}}, {tmdbId:"63174", properties:{bornIn:"Namur, Belgium", imdbId:"0069715", born:date('1966-11-10'), name:"Rémy Belvaux", bio:"From Wikipedia, the free encyclopedia.   \n\nRémy Nicolas Lucien Belvaux (10 November 1966, Namur, Belgium – 4 September 2006, Orry-la-Ville, France) was a Belgian actor, director, producer and screenwriter.  He was the brother of Lucas Belvaux, also an actor and film director, and of Bruno Belvaux, a theater director.  In 1992, he was with André Bonzel and Benoît Poelvoorde, director, producer and actor of the feature film Man Bites Dog...", died:date('2006-09-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3skpi3kUNnMThADdzSFOIJ49iPp.jpg", url:"https://themoviedb.org/person/63174"}}, {tmdbId:"63175", properties:{bornIn:"Namur, Belgium", imdbId:"0095298", born:date('1966-11-10'), name:" André Bonzel", bio:"From Wikipedia, the free encyclopedia. \n\nAndré Bonzel is a Belgian film director, screenwriter and producer.  He directed alongside Rémy Belvaux and Benoît Poelvoorde the 1992 black comedy film Man Bites Dog, which was met with high praise from film critics and has soon become a cult film.  It received the André Cavens Award for Best Film given by the Belgian Film Critics Association (UCC)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jZkiL0Lmx4jaoVqjJOnSBvHRC8z.jpg", url:"https://themoviedb.org/person/63175"}}, {tmdbId:"57851", properties:{bornIn:"London, England, UK", imdbId:"0741262", born:date('1960-08-04'), name:"Bernard Rose", bio:"Bernard Rose (born 4 August 1960) is an English actor and film director most famous for his direction of the 1992 urban horror film Candyman and the 1994 historical romance film Immortal Beloved. \n\nRose was born in London, England.  He began making super 8 films when he was 9.  By 1975, he won an amateur movie competition hosted by BBC which led to the broadcasting of his works.  He worked for Jim Henson on the last season of The Muppet Show and then again on The Dark Crystal in 1981...", url:"https://themoviedb.org/person/57851"}}, {tmdbId:"10828", properties:{bornIn:"Guadalajara, Jalisco, Mexico", imdbId:"0868219", born:date('1964-10-09'), name:"Guillermo del Toro", bio:"Guillermo del Toro (born October 9, 1964) is a Mexican director, producer, screenwriter, novelist and designer.  He is mostly known for his acclaimed films, Pan's Labyrinth and the Hellboy film franchise.  He is a frequent collaborator with Ron Perlman, Federico Luppi and Doug Jones.  His films draw heavily on sources as diverse as weird fiction, fantasy and war...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gldeyCtKcaqnK1v4Vu9vqayhzUQ.jpg", url:"https://themoviedb.org/person/10828"}}, {tmdbId:"74300", properties:{bornIn:"Chicago, Illinois, Stati Uniti", imdbId:"0472386", born:date('1950-11-25'), name:"Bill Kroyer", bio:"From Wikipedia, the free encyclopedia\n\nWilliam \"Bill\" Kroyer is an award-winning director of animation and computer graphics commercials, short films, movie titles and theatrical films.  He and Jerry Rees were the main animators for the CGI sequences in Tron.  He currently the head of the Digital Arts department at Lawrence and Kristina Dodge College of Film and Media Arts at Chapman University...", url:"https://themoviedb.org/person/74300"}}, {tmdbId:"27614", properties:{imdbId:"0912224", born:date('1948-04-18'), name:"Régis Wargnier", url:"https://themoviedb.org/person/27614"}}, {tmdbId:"6400", properties:{bornIn:"Camp Lejeune, North Carolina", imdbId:"0001139", born:date('1953-08-14'), name:"Tom DiCillo", bio:"Tom DiCillo is an American director, cinematographer, writer and actor born in Camp Le Jeune, North Carolina, and who studied film at New York University.  During his early career he began working with director Jim Jarmusch as a cinematographer on films that include Permanent Vacation and Stranger Than Paradise.  His experience as cinematographer proved invaluable and he was soon writing and directing his own films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z8XD6BdliptWiaGP49yYNR2OTTR.jpg", url:"https://themoviedb.org/person/6400"}}, {tmdbId:"99875", properties:{imdbId:"0368674", name:"Masami Hata", url:"https://themoviedb.org/person/99875"}}, {tmdbId:"118472", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0403774", born:date('1919-04-07'), name:" William T. Hurtz", died:date('2000-10-14'), url:"https://themoviedb.org/person/118472"}}, {tmdbId:"56872", properties:{bornIn:"Duluth, Minnesota, USA", imdbId:"0322865", born:date('1938-03-12'), name:"Arne Glimcher", bio:"​From Wikipedia, the free encyclopedia. \n\nArnold \"Arne\" Glimcher  (born March 12, 1938) is an American art dealer, film producer and director.  He is the founder of The Pace Gallery and is widely known as one of the art world's most powerful dealers.  Glimcher has also produced and directed several films, including The Mambo Kings and Just Cause...", url:"https://themoviedb.org/person/56872"}}, {tmdbId:"125677", properties:{imdbId:"0936092", name:" Peter Wintonick", url:"https://themoviedb.org/person/125677"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"51952", properties:{imdbId:"0793522", name:"Barry Shils", url:"https://themoviedb.org/person/51952"}}, {tmdbId:"65298", properties:{bornIn:"New York City, New York, USA", imdbId:"0005008", born:date('1962-11-30'), name:"Brian Henson", bio:"​From Wikipedia, the free encyclopedia.   \n\nBrian Henson (born November 3, 1963) is an Academy Award-winning puppeteer, director, producer, and technician.  The son of puppeteers Jane and Jim Henson, Brian was born in New York City, New York.  His sister Lisa is the CEO and he is chairman of The Jim Henson Company. \n\nDescription above from the Wikipedia article Brian Henson, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/65298"}}, {tmdbId:"102634", properties:{bornIn:" Detroit, Michigan, USA", imdbId:"0002240", born:date('1957-01-01'), name:"Katt Shea", bio:"American actress, film director and teacher best known for directing the film Poison Ivy (1992) and The Rage: Carrie 2...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nnR9HxsMstKj0iGdA2c3C4ERWxt.jpg", url:"https://themoviedb.org/person/102634"}}, {tmdbId:"180868", properties:{imdbId:"0097379", name:"Clay Borris", url:"https://themoviedb.org/person/180868"}}, {tmdbId:"226513", properties:{imdbId:"0941067", name:"Abbe Wool", url:"https://themoviedb.org/person/226513"}}, {tmdbId:"26767", properties:{bornIn:"Hong Kong", imdbId:"0482681", born:date('1955-12-08'), name:"Ringo Lam", bio:"​From Wikipedia, the free encyclopedia\n\nRingo Lam Ling-Tung (1955-2018) was a Hong Kong film director, producer and scriptwriter. \n\nHe was known for gritty, dark and realistic action thrillers.  He was born in Hong Kong and studied film at York University film school in Toronto.  Quentin Tarantino's Reservoir Dogs (1992) was reworked from Lam's City on Fire (1987), and critics have indicated that there are shot-by-shot copies of certain action sequences...", died:date('2018-12-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dhhKyUt47FnTvASWiqomVz2ViSp.jpg", url:"https://themoviedb.org/person/26767"}}, {tmdbId:"2520940", properties:{name:"Barnet Kellman", url:"https://themoviedb.org/person/2520940"}}, {tmdbId:"6201", properties:{bornIn:"New South Wales, Australia", imdbId:"0525303", born:date('1962-09-17'), name:"Baz Luhrmann", bio:"Mark Anthony \"Baz\" Luhrmann (born 17 September 1962) is an Australian film director, screenwriter, and producer best known for The Red Curtain Trilogy, which includes his films Strictly Ballroom, William Shakespeare's Romeo + Juliet and Moulin Rouge!.  In 2008, he released his film Australia, starring Hugh Jackman and Nicole Kidman. \n\nDescription above from the Wikipedia article Patricia Baz Luhrmann, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cJoAnNeK1lxysKEee8T77Fmy0JE.jpg", url:"https://themoviedb.org/person/6201"}}, {tmdbId:"45577", properties:{bornIn:"Rome, Lazio, Italy", imdbId:"0289576", born:date('1951-10-02'), name:"Claudio Fragasso", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jMy0qtNMF1mocC68NNysZQDGL0S.jpg", url:"https://themoviedb.org/person/45577"}}, {tmdbId:"6046", properties:{bornIn:"Stuttgart, Baden-Württemberg, West Germany", imdbId:"0000386", born:date('1955-11-10'), name:"Roland Emmerich", bio:"Roland Emmerich is a German film director, screenwriter, and producer who is known for his work on disaster and action flicks.  He made a name for himself with The Noah's Ark Principle (1981) and co-founded Centropolis Entertainment in 1985 with his sister.   Besides his work in the entertainment industry, he is a collector of art and an active campaigner for the LGBT community, global warming awareness and equal rights...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5zegR2csDWGpnCwDReKNqDsduKY.jpg", url:"https://themoviedb.org/person/6046"}}, {tmdbId:"71353", properties:{bornIn:"Olivos, Buenos Aires, Argentina", imdbId:"0812625", born:date('1963-02-16'), name:"Fernando E. Solanas", bio:"Fernando Ezequiel 'Pino' Solanas is an Argentine film director, screenwriter and politician.  His films include La hora de los hornos (The Hour of the Furnaces) (1968), Tangos: el exilio de Gardel (1985), Sur (1988), El viaje (1992), La nube (1998) and Memoria del saqueo (2004), among many others.  Since 2013, he has been a National Senator representing the Autonomous City of Buenos Aires...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/t4vMWVZZa1VbrUJYiION1Cn4GEu.jpg", url:"https://themoviedb.org/person/71353"}}, {tmdbId:"71466", properties:{imdbId:"0322083", name:"Arnold Glassman", url:"https://themoviedb.org/person/71466"}}, {tmdbId:"87386", properties:{imdbId:"0422791", name:"Neal Jimenez", url:"https://themoviedb.org/person/87386"}}, {tmdbId:"7775", properties:{bornIn:"Indianapolis, Indiana, USA", imdbId:"0814085", born:date('1962-03-20'), name:"Stephen Sommers", bio:"Born and raised in Minnesota, Stephen Sommers went on to attend St.  John’s University before transferring to the University of Seville in Spain.   After graduating, he spent the next several years managing rock bands throughout Europe.   Relocating to Los Angeles, Sommers enrolled in the University of Southern California’s School of Cinematic Arts and spent the next three years earning a Masters Degree in Film Production...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tJnKptsBvswmRivPSq8NCsIquI4.jpg", url:"https://themoviedb.org/person/7775"}}, {tmdbId:"68928", properties:{bornIn:"Oregon, USA", imdbId:"0296861", name:"E. Max Frye", bio:"From Wikipedia, the free encyclopedia. \n\nEric Max Frye, is an American screenwriter from Oregon.  His mother was Helen J.  Frye, a federal judge.  Born in Oregon and raised in Eugene, Eric directed and wrote the film Amos & Andrew.  He attended Lewis & Clark College in Portland for one year before moving to Europe where he lived in Paris and worked as a male model in Austria.  After returning to the United States, Frye settled in New York City where he attended New York University Film School...", url:"https://themoviedb.org/person/68928"}}, {tmdbId:"1978", properties:{bornIn:"London, England, UK", imdbId:"0812200", born:date('1956-11-30'), name:"Iain Softley", bio:"From Wikipedia, the free encyclopedia  Iain Softley (born November 30, 1956) is an English film director.  He was educated at St Benedict's School, Ealing, where he played the part of Thomas Becket in its 1975 production of T.  S.  Eliot's play, Murder in the Cathedral, and Queens' College, Cambridge.   His movies include the Beatles film Backbeat (1994), Hackers (1995), The Wings of the Dove (1997), K-PAX (2001), The Skeleton Key (2005) and Inkheart (2008)...", url:"https://themoviedb.org/person/1978"}}, {tmdbId:"112674", properties:{bornIn:"Heemskerk, The Netherlands", imdbId:"0208854", born:date('1951-05-04'), name:"Rolf de Heer", bio:"From Wikipedia, the free encyclopedia. \n\nRolf de Heer (born 4 May 1951 in Heemskerk, North Holland) is an Australian film director, writer and producer living in Australia.  De Heer was born in Heemskerk in The Netherlands but migrated to Sydney when he was eight years old.  He attended the Australian Film Television and Radio School in Sydney.  His company is called Vertigo Productions and is based in Adelaide.  De Heer primarily makes alternative or arthouse films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fgG98FnZv7ZnE5NrLPTUkg1DyYH.jpg", url:"https://themoviedb.org/person/112674"}}, {tmdbId:"94831", properties:{imdbId:"0339245", born:date('1955-06-23'), name:"Maggie Greenwald", url:"https://themoviedb.org/person/94831"}}, {tmdbId:"35270", properties:{imdbId:"0705779", name:"Eric Radomski", url:"https://themoviedb.org/person/35270"}}, {tmdbId:"34934", properties:{bornIn:"Oklahoma, USA", imdbId:"0863622", born:date('1961-02-05'), name:" Bruce W. Timm", bio:"Bruce Walter Timm (born on February 5, 1961) is an American character designer, animator and producer.  He is also a writer and artist working in comics, and is known for his contributions building the modern DC Comics animated franchise, the DC animated universe. \n\nDescription above from the Wikipedia article Bruce Timm, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4G64qCUGFQ1Sfwa6MK7CzwAaHyL.jpg", url:"https://themoviedb.org/person/34934"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"35266", properties:{imdbId:"0022828", name:" Kevin Altieri", bio:"Kevin Altieri is an American television director of animated cartoons.  Altieri's directorial works include episodes of C. O. P. S. , Batman: The Animated Series and Stripperella. \n\nDescription above from the Wikipedia article Kevin Altieri, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/35266"}}, {tmdbId:"35267", properties:{imdbId:"0456631", born:date('1950-11-04'), name:" Boyd Kirkland", died:date('2011-01-27'), url:"https://themoviedb.org/person/35267"}}, {tmdbId:"35268", properties:{imdbId:"0667469", name:" Frank Paur", url:"https://themoviedb.org/person/35268"}}, {tmdbId:"34921", properties:{imdbId:"0722713", name:" Dan Riba", url:"https://themoviedb.org/person/34921"}}, {tmdbId:"70905", properties:{imdbId:"0419884", born:date('1963-12-09'), name:"Vadim Jean", bio:"From Wikipedia, the free encyclopedia. \n\nVadim Jean (born Bristol, 9 December 1963) is an award-winning English film director, producer, and executive producer. \n\nAfter graduating with a degree in History from Warwick University, he found work on Mike Figgis' Stormy Monday, before establishing his own production company in 1989 covering a wide variety of subjects, from sport to corporate videos...", url:"https://themoviedb.org/person/70905"}}, {tmdbId:"3349", properties:{imdbId:"0364805", name:"James B. Harris", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l5HbEfXAhkccClLaJ8P5XpUjEu.jpg", url:"https://themoviedb.org/person/3349"}}, {tmdbId:"122602", properties:{imdbId:"0540542", name:" Darren Moloney", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9szTbdhVjMzgDZR6qz8t5Cf1WvJ.jpg", url:"https://themoviedb.org/person/122602"}}, {tmdbId:"2355", properties:{bornIn:"London, England, UK", imdbId:"0001949", born:date('1945-12-09'), name:"Andrew Birkin", url:"https://themoviedb.org/person/2355"}}, {tmdbId:"58838", properties:{bornIn:" Milan, Italy", imdbId:"0104193", name:"Marco Brambilla", bio:"From Wikipedia, the free encyclopedia. \n\nMarco Brambilla (born 1960, Milan, Italy) is an Italian-born Canadian artist and filmmaker who works in the United States.  Educated at Ryerson University, Toronto, Canada, where he studied film, he first worked in commercials and feature films, directing the successful 1993 science fiction film Demolition Man...", url:"https://themoviedb.org/person/58838"}}, {tmdbId:"41521", properties:{imdbId:"0603294", name:"Gérard Mordillat", url:"https://themoviedb.org/person/41521"}}, {tmdbId:"72646", properties:{bornIn:"Havana, Cuba", imdbId:"0349425", born:date('1928-12-11'), name:"Tomás Gutiérrez Alea", bio:"From Wikipedia, the free encyclopedia  Tomás Gutiérrez Alea  (December 11, 1928 – April 16, 1996) was a Cuban filmmaker.  He wrote and directed more than 20 features, documentaries, and short films, which are known for his sharp insight into post-Revolutionary Cuba, and possess a delicate balance between dedication to the revolution and criticism of the social, economic, and political conditions of the country...", died:date('1996-04-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aM8rdpELmKeSGVakP2aM2I9vqMI.jpg", url:"https://themoviedb.org/person/72646"}}, {tmdbId:"50651", properties:{bornIn:"Tokyo, Japan", imdbId:"0645549", born:date('1949-12-20'), name:"Takao Okawara", bio:"​From Wikipedia, the free encyclopedia\n\nTakao Okawara (born December 20, 1949 in Tokyo, Japan) is a Japanese film director, writer and producer. \n\nDescription above from the Wikipedia article Takao Okawara, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fsYErii5tvkyesitPfSqv8UqCEd.jpg", url:"https://themoviedb.org/person/50651"}}, {tmdbId:"57130", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0680846", born:date('1970-12-20'), name:"Todd Phillips", bio:"American screenwriter and film director Todd Phillips made his first while a junior at NYU and it went on to become one of the biggest grossing student films at the time, even getting a limited theatrical release. ; the feature-length documentary “Hated: GG Allin and the Murder Junkies” He is best known for directing the comedy films Road Trip, Old School, The Hangover, and Due Date...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/A6FPht87DiqXzp456WjakLi2AtP.jpg", url:"https://themoviedb.org/person/57130"}}, {tmdbId:"6592", properties:{bornIn:"Los Angeles County, California, USA", imdbId:"0242271", born:date('1952-11-17'), name:"Duwayne Dunham", url:"https://themoviedb.org/person/6592"}}, {tmdbId:"1614", properties:{bornIn:"Chaojhou, Pingtung, Taiwan", imdbId:"0000487", born:date('1954-10-23'), name:"Ang Lee", bio:"Ang Lee is a Taiwanese American film director.  Lee has directed a diverse set of films such as Eat Drink Man Woman (1994), Sense and Sensibility (1995), Crouching Tiger, Hidden Dragon (2000), Hulk (2003), and Brokeback Mountain (2005), for which he won an Academy Award for Best Director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8LRbYPUVLnFQMs86tg2YbmsGyKB.jpg", url:"https://themoviedb.org/person/1614"}}, {tmdbId:"58498", properties:{bornIn:"Niles, Ohio, USA", imdbId:"0784061", born:date('1949-04-26'), name:"Dominic Sena", bio:"Dominic Sena is an American film director...", url:"https://themoviedb.org/person/58498"}}, {tmdbId:"19305", properties:{imdbId:"0740568", name:"Tom Ropelewski", url:"https://themoviedb.org/person/19305"}}, {tmdbId:"96627", properties:{bornIn:"Valence-d'Agen, Francia", imdbId:"0029242", born:date('1943-03-13'), name:"André Téchiné", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4Yzsjz2PMg6d6vTnZnbKAGp0nVX.jpg", url:"https://themoviedb.org/person/96627"}}, {tmdbId:"226963", properties:{imdbId:"0618284", name:"Ray Müller", url:"https://themoviedb.org/person/226963"}}, {tmdbId:"11448", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"0400441", born:date('1972-04-01'), name:" Allen Hughes", bio:"Albert Hughes and Allen Hughes (born April 1, 1972), known together professionally as the Hughes brothers, are American film directors, producers and screenwriters.  The pair, who are twins, are known for co-directing such visceral, and often violent, movies as Menace II Society, From Hell and The Book of Eli...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cenYyg8GR89817xnAHU6hNiFZ2x.jpg", url:"https://themoviedb.org/person/11448"}}] AS row
