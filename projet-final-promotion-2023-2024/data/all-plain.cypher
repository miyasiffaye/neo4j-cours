UNWIND [{tmdbId:"83768", properties:{bornIn:"Kobe, Hyogo Prefecture, Japan", imdbId:"0594436", born:date('1972-12-04'), name:"Yûko Miyamura", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dVfbS1oiGuzXk5IZLNSsfoLNjUR.jpg", url:"https://themoviedb.org/person/83768"}}, {tmdbId:"77931", properties:{bornIn:" Tokyo, Japan", imdbId:"0594074", born:date('1967-12-08'), name:"Kotono Mitsuishi", bio:"is a Japanese voice actress and narrator from Tokyo. [1] She was affiliated with Arts Vision and Lasley Arrow.  As a young girl, Mitsuishi lived in Nagareyama, Chiba.  Mitsuishi graduated from high school in 1986, and entered the Katsuta Voice Actor's Academy. \n\nIn 1988, Mitsuishi made her voice acting debut as Tomoyo in the OVA Ace wo Nerae! 2...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1kqWHBmMGEjdyySvRPjh4ZHAnrm.jpg", url:"https://themoviedb.org/person/77931"}}, {tmdbId:"20480", properties:{bornIn:"St. Louis, Missouri, USA", imdbId:"0597410", born:date('1993-07-26'), name:"Taylor Momsen", bio:"Taylor Michel Momsen is an American screen actress, musician, songwriter and model.  She is a member of the rock band The Pretty Reckless...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/u0RWIWMVaUNFYnDflWIJGJ3fzWt.jpg", url:"https://themoviedb.org/person/20480"}}, {tmdbId:"66589", properties:{imdbId:"0443559", name:"Morio Kazama", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x0DzJzdivusbFzNs0KNPXqhiH3M.jpg", url:"https://themoviedb.org/person/66589"}}, {tmdbId:"120918", properties:{bornIn:"Aomori, Japan", imdbId:"0297956", born:date('1965-02-17'), name:"Mitsuru Fukikoshi", bio:"Mitsuru Fukikoshi (吹越 満 Fukikoshi Mitsuru, born 17 February 1965) is a Japanese actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yxOvrBhUtptt2xCDZHlFbhKhtSV.jpg", url:"https://themoviedb.org/person/120918"}}, {tmdbId:"66591", properties:{bornIn:"Takasaki City, Gunma Prefecture, Japan", imdbId:"0396231", born:date('1962-02-01'), name:"Tomoyasu Hotei", url: