UNWIND [{tmdbId:"53764", properties:{imdbId:"0043170", name:"Angel Aviles", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d3GzpFRHpsXlHzf2DqqQCV7EXDk.jpg", url:"https://themoviedb.org/person/53764"}}, {tmdbId:"104380", properties:{bornIn:"Mérida - Yucatán - Mexico", imdbId:"0520203", name:"Seidy Lopez", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yucTzwkIHZeCGR74AT377JI5M5B.jpg", url:"https://themoviedb.org/person/104380"}}, {tmdbId:"16429", properties:{bornIn:"Michoacan, Mexico", imdbId:"0889846", born:date('1971-08-18'), name:"Jacob Vargas", bio:"Jacob Vargas (born August 18, 1971) is a Mexican actor. \n\nDescription above from the Wikipedia article Jacob Vargas, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jYGD9OcN0Qgn9DLv7WgaDuZuZx2.jpg", url:"https://themoviedb.org/person/16429"}}, {tmdbId:"27544", properties:{bornIn:"Peoria - Illinois - USA", imdbId:"0410464", born:date('1956-06-01'), name:"Tom Irwin", bio:"Tom Irwin (born June 1, 1956) is an American film, television, and stage actor...", url:"https://themoviedb.org/person/27544"}}, {tmdbId:"3967", properties:{bornIn:"Chiswick, London, England, UK", imdbId:"0000295", born:date('1973-07-26'), name:"Kate Beckinsale", bio:"Kathryn Bailey \"Kate\" Beckinsale is an English actress.  Born in Finsbury Park, London, Beckinsale is the daughter of actor Richard Beckinsale, who died from a heart attack in 1979, and actress Judy Loe.  She has a paternal half-sister, Samantha, who is also an actress.  Her paternal grandfather was half Burmese, and she has said that she was \"very oriental-looking\" as a child...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pRNpPfvZy4bePDgQzQFrxTVIUfa.jpg", url:"https://themoviedb.org/person/3967"}}, {tmdbId:"11356", properties:{bornIn:"Archway, London, England, UK", imdbId:"0001767", born:date('1956-01-09'), name:"Imelda Staunton", bio:"Imelda Mary Philomena Bernadette Staunton, CBE (born 9 January 1956) is an English stage and screen actress.  She is best known for her performances in the British comedy television series Up the Garden Path and the films Harry Potter and the Order of the Phoenix and Vera Drake.  For the latter, she drew widespread critical acclaim as Vera Drake, earning her a Best Actress Oscar nomination and a number of wins including the BAFTA and Venice Film Festival Awards for best actress in a leading role...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/95KKeFajyuRlqc65mBBKgXkXGpL.jpg", url:"https://themoviedb.org/person/11356"}}, {tmdbId:"151797", properties:{bornIn:"Golspie, Scotland", imdbId:"0950788", born:date('1956-01-01'), name:"Jimmy Yuill", bio:"Jimmy Yuill is an actor, born in 1959, in Golspie, Scotland.  He is a member of the Royal Shakespeare Company and later joined the Renaissance Theatre Company.  He has appeared in many of Kenneth Branagh's films.  His most recent work saw him play the Chief Constable in \"The Raven\"  along side John Cusack.  Yuill was also the music composer for A Midwinter's Tale and Swan Song...", url:"https://themoviedb.org/person/151797"}}, {tmdbId:"65704", properties:{imdbId:"0523198", born:date('1970-01-04'), name:"Andrew Lowery", url:"https://themoviedb.org/person/65704"}}, {tmdbId:"108098", properties:{bornIn:"New York City, New York, USA", imdbId:"0957955", born:date('1972-07-14'), name:"Danny Zorn", died:date('2012-10-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jGvuaukRRv1VL1yH0ROn7cxasXn.jpg", url:"https://themoviedb.org/person/108098"}}, {tmdbId:"11367", properties:{bornIn:"Madison, Wisconsin, USA", imdbId:"0925966", born:date('1959-10-10'), name:"Bradley Whitford", bio:"Bradley Whitford (born October 10, 1959) is an American film and television actor.  He is best known for his roles as Deputy White House Chief of Staff Josh Lyman on the NBC television drama The West Wing, as Danny Tripp on Studio 60 on the Sunset Strip, as Dan Stark in the Fox police buddy-comedy The Good Guys, as Red John in the CBS series The Mentalist, and as antagonist Eric Gordon in the film Billy Madison...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hy3jwrcpmEpM7jLkrhlqQb1TfGN.jpg", url:"https://themoviedb.org/person/11367"}}, {tmdbId:"15758", properties:{bornIn:"Newark, New Jersey, USA ", imdbId:"0001451", born:date('1970-03-18'), name:"Queen Latifah", bio:"Dana Elaine Owens was born on March 18, 1970 in Newark, New Jersey.  Better known by her stage name Queen Latifah, she is a rapper, actress and singer.  Queen Latifah's work in music, film and television has earned her a Golden Globe award, two Screen Actors Guild Awards, two Image Awards, a Grammy Award, six additional Grammy nominations, an Emmy Award nomination and an Academy Award nomination.  From 1993-1998, Latifah had a starring role on Living Single...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gepSjc0zYXGEJi0GUUaHq2fdlGi.jpg", url:"https://themoviedb.org/person/15758"}}, {tmdbId:"35075", properties:{bornIn:"France", imdbId:"0560808", name:"Julie Mauduech", url:"https://themoviedb.org/person/35075"}}, {tmdbId:"5418", properties:{bornIn:" France", imdbId:"0468003", born:date('1970-12-30'), name:"Hubert Koundé", bio:"Hubert Koundé is a French actor and film director.  Koundé is best known for his role as Hubert in the film La Haine by Mathieu Kassovitz.  He is also the author of a play: \"Cagoule: Valentine and Yamina,\" performed in 2003 (Cagoule: Valentin et Yamina, montée en 2003).  He made two short films: Qui se ressemble s'assemble and Menhir, and co-directed a feature film: Paris, la métisse.  He has also worked on English language films such as The Constant Gardener...", url:"https://themoviedb.org/person/5418"}}, {tmdbId:"1925", properties:{bornIn:"Paris, France", imdbId:"0001993", born:date('1966-11-23'), name:"Vincent Cassel", bio:"A French actor.  Cassel has starred in many films, and is well known for portraying villains or violent characters in many of the roles...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ljhVeYVlcO7IERkhu3E62HD5mzO.jpg", url:"https://themoviedb.org/person/1925"}}, {tmdbId:"11207", properties:{bornIn:"Blackpool, Lancashire, England, UK", imdbId:"0000667", born:date('1963-03-20'), name:"David Thewlis", bio:"Thewlis had a minor role in an episode of the 1980s sitcom Up the Elephant and Round the Castle.  He also appeared in an episode of popular sitcom Only Fools and Horses (1985) as a friend of Rodney.  His first professional role was in the play Buddy Holly at the Regal in Greenwich. \n\nThewlis's breakout role was Naked (1993; dir...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sNuYyT8ocLlQr3TdAW9CoKVbCU8.jpg", url:"https://themoviedb.org/person/11207"}}, {tmdbId:"80366", properties:{bornIn:"Manchester, Lancashire, England, UK", imdbId:"0789093", born:date('1960-04-03'), name:"Lesley Sharp", bio:"Lesley Sharp is an English stage, screen, and television actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oujHtdmwMCyppe9b7QHWJeNFN7i.jpg", url:"https://themoviedb.org/person/80366"}}, {tmdbId:"1641", properties:{bornIn:"London, England", imdbId:"0001020", born:date('1961-05-15'), name:"Katrin Cartlidge", bio:"Katrin Juliet Cartlidge was an English actress.  She first appeared on screen as Lucy Collins in the Channel 4 soap opera Brookside, before going on to win the 1997 Evening Standard Film Award for Best Actress for the Mike Leigh film Career Girls...", died:date('2002-09-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cAG4WHKsLV2g08hnuZncy94HGOK.jpg", url:"https://themoviedb.org/person/1641"}}, {tmdbId:"58090", properties:{bornIn:"London - England - UK", imdbId:"0190208", born:date('1962-01-01'), name:"Greg Cruttwell", bio:"From Wikipedia, the free encyclopedia\n\nGreg Cruttwell (born in 1962 in London) is an English actor, screenwriter, director and film producer.  He is the son of actress Geraldine McEwan and Hugh Cruttwell, former principal of the Royal Academy of Dramatic Art. \n\nCruttwell attended the London Academy of Music and Dramatic Art.  Before branching out as director and producer, Cruttwell had performed in over 20 theatre productions throughout Great Britain...", url:"https://themoviedb.org/person/58090"}}, {tmdbId:"99", properties:{bornIn:"New York City, New York, USA", imdbId:"0001625", born:date('1957-03-23'), name:"Amanda Plummer", bio:"Amanda Michael Plummer is an American actress.  Plummer was born in New York City, New York, the daughter of actors Tammy Grimes and Christopher Plummer.  Plummer attended Middlebury College in Vermont and acting classes at the Neighborhood Playhouse in New York.  Early in life, her interest was in riding and tending to horses on the East Coast and in Ireland. \n\nPlummer began appearing in small to mid size roles in television and films in the early 1980s...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/joHGUtEmXzJkH6ogEliiUKT9MNa.jpg", url:"https://themoviedb.org/person/99"}}, {tmdbId:"531", properties:{bornIn:" Los Angeles, California, United States", imdbId:"0000384", born:date('1953-05-29'), name:"Danny Elfman", bio:"Daniel Elfman is a composer.  Elfman is famous for creating The Simpsons main title theme as well as the Batman theme, and his role as Jack Skellington's singing voice in The Nightmare Before Christmas.   He is a frequent collaborator with long-time friend Tim Burton and has scored most of his films.  He also sang for the character Bonejangles in the movie Corpse Bride...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zFladKAPypbzp26Tfyeiy23vanH.jpg", url:"https://themoviedb.org/person/531"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"1340665", properties:{imdbId:"0032151", name:"Stephen Apostolina", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lzArKp0G0PNYQ3VrTHFzEigK63e.jpg", url:"https://themoviedb.org/person/1340665"}}, {tmdbId:"157632", properties:{imdbId:"0254219", born:date('1948-03-02'), name:"Dean Wein", url:"https://themoviedb.org/person/157632"}}, {tmdbId:"26664", properties:{bornIn:"Miami, Florida, USA", imdbId:"0893965", born:date('1946-10-10'), name:"Ben Vereen", bio:"​From Wikipedia, the free encyclopedia.   \n\nBen Vereen (born October 10, 1946) is an American actor, dancer, and singer who has appeared in numerous Broadway theatre shows.  Vereen graduated from Manhattan's High School of Performing Arts...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aWCdsQz6tp6A8gRTpzZ7BjggObC.jpg", url:"https://themoviedb.org/person/26664"}}, {tmdbId:"156853", properties:{imdbId:"0086111", name:"Ellen Blain", url:"https://themoviedb.org/person/156853"}}, {tmdbId:"193978", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0339745", born:date('1978-05-26'), name:"Benji Gregory", bio:"Benjamin Gregory Hertzberg (born May 26, 1978), known professionally as Benji Gregory is former American actor.  He is best known for playing the role of Brian Tanner on the sitcom ALF...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/b7jJsM2daZ7KG72VzwSUj7fCOiI.jpg", url:"https://themoviedb.org/person/193978"}}, {tmdbId:"18702", properties:{bornIn:"Honolulu, Hawaii, USA", imdbId:"0001092", born:date('1964-02-26'), name:"Mark Dacascos", bio:"​From Wikipedia, the free encyclopedia.   \n\nMark Alan Dacascos (born February 26, 1964) is an American actor and martial artist.  He won numerous karate and various styles of kung fu championships between the ages of 7 and 18.  Beginning in January 2005, Dacascos has portrayed \"the Chairman\" on Food Network's television series Iron Chef America...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/trOACuJz1KzhB51qe6asaxRuxrh.jpg", url:"https://themoviedb.org/person/18702"}}, {tmdbId:"31714", properties:{bornIn:"Dallas, Texas, USA", imdbId:"0006826", born:date('1964-08-29'), name:"Stacey Travis", bio:"From Wikipedia, the free encyclopedia\n\nStacey Travis (born August 29, 1966) is an American actress whose films include Earth Girls Are Easy (1988), Hardware (1990), The Super (1991), Traffic (2000), and Ghost World (2001). \n\nTravis starred on the comedy television series Just Say Julie from 1989–1992 where she played a variety of characters.  She also starred on the short-lived 1998 television series The Love Boat: The Next Wave as \"Cruise Director Suzanne Zimmerman\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hVuilLYZlGkZFoAXQaNaCywaGih.jpg", url:"https://themoviedb.org/person/31714"}}, {tmdbId:"1181001", properties:{bornIn:"Mexico City, Mexico", imdbId:"0697431", born:date('1955-03-08'), name:"Paco Christian Prieto", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mu0GlKsssBmsskUVuqOmevnr0zl.jpg", url:"https://themoviedb.org/person/1181001"}}, {tmdbId:"57459", properties:{bornIn:"Sutton, Surrey, England, UK", imdbId:"0187998", born:date('1908-12-25'), name:"Quentin Crisp", died:date('1999-11-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9kp2xAPdUtZnmSTmpiNxoBQz5Tj.jpg", url:"https://themoviedb.org/person/57459"}}, {tmdbId:"57460", properties:{bornIn:"Glasgow, Scotland, United Kingdom", imdbId:"0813896", born:date('1961-06-22'), name:"Jimmy Somerville", bio:"James William Somerville is a Scottish pop singer and songwriter.  He sang in the 1980s with the pop groups Bronski Beat and The Communards, and has also had a solo career.  He is known in particular for his falsetto singing voice...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pWbwkFScMuhtEVNapvtNE6AqKBx.jpg", url:"https://themoviedb.org/person/57460"}}, {tmdbId:"1636040", properties:{name:"John Bott", url:"https://themoviedb.org/person/1636040"}}, {tmdbId:"12978", properties:{bornIn:"Toronto, Ontario,  Canada", imdbId:"0653660", born:date('1966-06-30'), name:"Peter Outerbridge", bio:"Peter Outerbridge is a Canadian film and televison actor, best known for his television roles as Dr.  David Sandström in \"ReGenesis\", and as Ari Tasarov in \"Nikita\", as well as in the movies \"Saw VI\" as William Easton, and as transsexual Judy in \"Better Than Chocolate\".  He holds a BFA in Acting from the University of Victoria, British Columbia, Canada...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a3OpOcxpBWi30MsgFTYLsWFwFoV.jpg", url:"https://themoviedb.org/person/12978"}}, {tmdbId:"166476", properties:{imdbId:"0259923", name:"Victor Ertmanis", url:"https://themoviedb.org/person/166476"}}, {tmdbId:"180683", properties:{imdbId:"0504683", name:"Dan Lett", bio:"Dan Lett is an actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/johOG5hLcJTIn47TzYYW9FN6TNp.jpg", url:"https://themoviedb.org/person/180683"}}, {tmdbId:"64025", properties:{bornIn:"Salt Lake City, Utah, U.S.", imdbId:"0412901", born:date('1986-05-17'), name:"T.J. Lowther", bio:"From Wikipedia, the free encyclopedia.   T. J.  Lowther (born May 17, 1986 in Salt Lake City, Utah in the United States) is an American actor.  He started as a child star, appearing in Neon City in 1991 at the age of 5.  In 1993, he appeared in his most famous role, as Philip Perry in Clint Eastwood's film A Perfect World, alongside Kevin Costner, for which he received significant praise.  Lowther has moved into more roles on television, including a cameo on the successful Grey's Anatomy...", url:"https://themoviedb.org/person/64025"}}, {tmdbId:"59329", properties:{imdbId:"0453248", name:"Buzz Kilman", url:"https://themoviedb.org/person/59329"}}, {tmdbId:"54421", properties:{bornIn:"Gary, Indiana, USA", imdbId:"0001390", born:date('1966-05-16'), name:"Janet Jackson", bio:"Janet Damita Jo Jackson is an American  singer, songwriter, dancer and actress.  Known for a series of sonically  innovative, socially conscious and sexually provocative records, as  well as elaborate stage shows, television and film roles, she has been a  prominent figure in popular culture for over 30 years...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xsjnmQ8n0ndaT44jeA0oR6pMbbt.jpg", url:"https://themoviedb.org/person/54421"}}, {tmdbId:"54422", properties:{bornIn:"East Harlem, New York City, New York, U.S.A", imdbId:"0000637", born:date('1971-06-16'), name:"Tupac Shakur", bio:"Tupac Amaru Shakur, best known by his stage names 2Pac and Makaveli was  an American rapper and actor.  Shakur has sold over 75 million albums  worldwide as of 2010, making him one of the best-selling music artists  in the world...", died:date('1996-09-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/crsSAJRf8XdIOZ6scXihi6R81ZB.jpg", url:"https://themoviedb.org/person/54422"}}, {tmdbId:"19265", properties:{bornIn:"New York City, New York, USA", imdbId:"0018554", born:date('1957-09-04'), name:"Khandi Alexander", bio:"Khandi Alexander (born September 4, 1957) is an American dancer, choreographer, and film and television actress.  She is perhaps best known for the roles of Dr.  Alexx Woods on CSI: Miami and as Catherine Duke on NewsRadio.  She also had a major recurring role on ER as Jackie Robbins, sister to Dr.  Peter Benton.  She is currently appearing in the HBO series Treme...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lpeq1v2I7Ix4wrXaKJCBg7llWz7.jpg", url:"https://themoviedb.org/person/19265"}}, {tmdbId:"54425", properties:{imdbId:"0043021", name:"Ché J. Avery", url:"https://themoviedb.org/person/54425"}}] AS row
