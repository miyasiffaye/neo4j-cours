UNWIND [{tmdbId:"45210", properties:{bornIn:"Wongawilli, New South Wales, Australia", imdbId:"0418877", born:date('1951-08-05'), name:"John Jarratt", bio:"Jarratt was born and grew up in Wongawilli, a small rural town near Wollongong, New South Wales and later in the Snowy Mountains area.  Jarratt’s father was a coal miner and later a concreter, who worked on the Snowy Mountains hydroelectric scheme.  His 5x great-grandfather, George Jarratt, born 1833, came from Croxton in Cambridgeshire, England; his son, John, married a Mary Kelly from Ireland...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o6aqaluNv2MrMz8ZGXDOVM31Uu3.jpg", url:"https://themoviedb.org/person/45210"}}, {tmdbId:"60003", properties:{bornIn:"Melbourne, Victoria, Australia", imdbId:"0536476", born:date('1981-01-08'), name:"Cassandra Magrath", bio:"Cassandra Magrath is an Australian actress.  She played Miranda Gibson in the Australian ABC 1998–2000 television series SeaChange and Liz Hunter in the 2005 Australian horror film Wolf Creek. \n\nMagrath began her acting career aged 11, with a role in the children's television programme Ocean Girl.  She also played Charlene in the Australian ABC children's television series The Wayne Manifesto that aired in 1996. \n\nMagrath also acted as Alison Pi Renfrey in The Crash Zone in 1998...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vTa1P7RNJtP1yIn0llhPYq7J4E9.jpg", url:"https://themoviedb.org/person/60003"}}, {tmdbId:"60004", properties:{bornIn:"Adelaide, South Australia, Australia", imdbId:"1040961", born:date('1978-08-08'), name:"Kestie Morassi", url:"https://themoviedb.org/person/60004"}}, {tmdbId:"60005", properties:{bornIn:"Sunbury - Victoria - Australia", imdbId:"0680667", born:date('1980-01-01'), name:"Nathan Phillips", bio:"From Wikipedia, the free encyclopedia. \n\nNathan Scott Phillips (born 1980) is an Australian actor who is currently based in Los Angeles.  He is perhaps best known for his role as backpacker Ben Mitchell in Wolf Creek and for his American film debut, Snakes on a Plane, opposite Samuel L.  Jackson, in 2006...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9t54w1XE7u7fOWQv83IP0xYAWkh.jpg", url:"https://themoviedb.org/person/60005"}}, {tmdbId:"1250", properties:{bornIn:"Rothbury, Northumberland, England, UK", imdbId:"0035602", born:date('1970-08-14'), name:"Alexander Armstrong", bio:"Alexander Armstrong is a British comedian, actor and television presenter...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e0kvGIfrjah4UmbUdKKobTgcxEd.jpg", url:"https://themoviedb.org/person/1250"}}, {tmdbId:"71281", properties:{bornIn:"Clapham, London, England, UK", imdbId:"0443373", born:date('1965-01-01'), name:"Paul Kaye", bio:"Paul Kaye is a British film and television actor and writer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/odgdOzNTcqaov7bGYte0rJMxUZN.jpg", url:"https://themoviedb.org/person/71281"}}, {tmdbId:"35172", properties:{bornIn:" Los Angeles, California, USA", imdbId:"0167139", born:date('1955-10-24'), name:"Robert Clotworthy", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ya6d3Nkp28AYIQ9TFDfwh8lshxg.jpg", url:"https://themoviedb.org/person/35172"}}, {tmdbId:"83786", properties:{bornIn:"St. Joseph, Missouri, U.S", imdbId:"0004847", born:date('1916-11-04'), name:"Walter Cronkite", bio:"Walter Leland Cronkite, Jr.  (November 4, 1916 – July 17, 2009) was an American broadcast journalist, best known as anchorman for the CBS Evening News for 19 years (1962–81).  During the heyday of CBS News in the 1960s and 1970s, he was often cited as \"the most trusted man in America\" after being so named in an opinion poll.  Although he reported many events from 1937 to 1981, including bombing in World War II, the Nuremberg trials, combat in the Vietnam War, the death of President John F...", died:date('2009-07-17'), url:"https://themoviedb.org/person/83786"}}, {tmdbId:"52478", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"0004761", born:date('1976-03-19'), name:"Rachel Blanchard", bio:"Rachel Elise Blanchard (born March 19, 1976) is a Canadian actress. \n\nDescription above from the Wikipedia article Rachel Blanchard, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5qgw9hM15TnZlLcLY0auovHJWLC.jpg", url:"https://themoviedb.org/person/52478"}}, {tmdbId:"82754", properties:{imdbId:"1331627", born:date('1991-01-01'), name:"Conor Donovan", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qvrPwtXBZnaqm5IokFQAtlEVgTv.jpg", url:"https://themoviedb.org/person/82754"}}, {tmdbId:"82755", properties:{imdbId:"1028466", born:date('1991-05-29'), name:"Jesse Camacho", bio:"Jesse Camacho is a Canadian actor.  He is the son of actors Pauline Little and Mark Camacho, and brother of Sarah Camacho...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yhlO36DEeq7okyDySRZNuc7tmss.jpg", url:"https://themoviedb.org/person/82755"}}, {tmdbId:"19858", properties:{bornIn:"Seattle, Washington, U.S.", imdbId:"1494624", born:date('1991-09-21'), name:"Zoe Weizenbaum", bio:"From Wikipedia, the free encyclopedia. \n\nZoë Weizenbaum (born September 21, 1991) is an American child actress. \n\nWeizenbaum was born in Seattle, Washington to a Jewish American mother and a Chinese father and was raised in the Jewish religion.  She grew up from the age of two in Amherst, Massachusetts.  For years, African Dance was her primary love.  She also enjoyed being part of Amherst's local musical theatre productions...", url:"https://themoviedb.org/person/19858"}}, {tmdbId:"17604", properties:{bornIn:"Modesto, California, USA", imdbId:"0719637", born:date('1971-01-07'), name:"Jeremy Renner", bio:"Jeremy Lee Renner (born January 7, 1971, height 5' 10\" (1,78 m)) is an American actor and musician.  Renner appeared in films throughout the 2000s, mostly in supporting roles.  He came to prominence in films such as Dahmer (2002), S. W. A. T.  (2003), Neo Ned (2005), 28 Weeks Later (2007), The Town (2010), and was nominated for an Academy Award for Best Actor for his starring role in the 2009 Best Picture-winning war thriller The Hurt Locker...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ycFVAVMliCCf0zXsKWNLBG3YxzK.jpg", url:"https://themoviedb.org/person/17604"}}, {tmdbId:"106282", properties:{imdbId:"0284190", name:"Macka Foley", url:"https://themoviedb.org/person/106282"}}, {tmdbId:"83968", properties:{bornIn:"Allen, Texas, United States", imdbId:"1747924", born:date('1981-02-08'), name:"Jim Parrack", bio:"From Wikipedia, the free encyclopedia. \n\nJim Parrack (born February 8, 1981) is an American actor.  He has a recurring role as Hoyt Fortenberry in HBO series True Blood, and appeared in the film Battle: Los Angeles, which was released March 2011. \n\nParrack was born on February 8, 1981 and grew up in the town of Allen, Texas.  In 2001, Parrack moved to Los Angeles, California where he studied acting at The Stella Adler Academy  and then at the Playhouse West...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zj3qGmlPQtzAeDRrOPN7iZIXzmF.jpg", url:"https://themoviedb.org/person/83968"}}, {tmdbId:"60348", properties:{bornIn:"Marylebone, London, England, UK", imdbId:"0499270", born:date('1963-10-12'), name:"Dave Legeno", bio:"​From Wikipedia, the free encyclopedia\n\nDavid \"Dave\" Legeno (born 12 October 1963) is an English actor, boxer, and mixed martial artist. \n\nDescription above from the Wikipedia article Dave Legeno, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2014-07-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rqTATsZ15cUVT9TrkeZ6qANwSey.jpg", url:"https://themoviedb.org/person/60348"}}, {tmdbId:"89387", properties:{bornIn:" London, England, UK", imdbId:"2917590", born:date('1989-08-21'), name:"Elarica Johnson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iiMfkwUSyUki9Q6YbfoVBOGSheq.jpg", url:"https://themoviedb.org/person/89387"}}, {tmdbId:"55364", properties:{imdbId:"1017414", born:date('1980-01-01'), name:"Steven Robertson", url:"https://themoviedb.org/person/55364"}}, {tmdbId:"1229169", properties:{imdbId:"0014614", name:"Roger Ailes", url:"https://themoviedb.org/person/1229169"}}, {tmdbId:"73641", properties:{bornIn:"Ealing, Middlesex, England", imdbId:"0023927", born:date('1958-01-12'), name:"Christiane Amanpour", bio:"Christiane Maria Heideh Amanpour CBE is a British-Iranian journalist and television host.  Amanpour is the Chief International Anchor for CNN and host of CNN International's nightly interview program Amanpour.  She is also the host of Amanpour & Company on PBS...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jIOaI2fAjqL7WFC0TQ836JtZgdE.jpg", url:"https://themoviedb.org/person/73641"}}] AS row
