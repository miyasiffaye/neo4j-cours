UNWIND [{tmdbId:"46924", properties:{bornIn:" Chicago, Illinois, U.S.", imdbId:"0202131", born:date('1962-06-06'), name:"Alex Datcher", bio:"Alex Datcher (born June 6, 1962) sometimes credited as Cynthia Alex Datcher, is an American actress.  She has made many guest appearances on sitcoms and TV dramas; she also has numerous supporting roles in many movies.  She has been acting since 1990.  Datcher made her first television appearance in an episode of Beauty and the Beast alongside Ron Perlman and Linda Hamilton.  She made her film debut two years later in action drama Rage and Honor, co-starring Brian Thompson and Tim DeZarn...", url:"https://themoviedb.org/person/46924"}}, {tmdbId:"20765", properties:{imdbId:"0052202", name:"Lenore Banks", url:"https://themoviedb.org/person/20765"}}, {tmdbId:"48", properties:{bornIn:"Sheffield, South Yorkshire, England, UK", imdbId:"0000293", born:date('1959-04-17'), name:"Sean Bean", bio:"Shaun Mark \"Sean\" Bean (born 17 April 1959) is an English film and stage actor.  Bean is best known for starring roles in the films Lord of the Rings: The Fellowship of the Ring, GoldenEye, Patriot Games, Troy, National Treasure and Silent Hill, as well as the television series Sharpe.  Bean has also acted in a number of television productions, most recent being HBO's Game of Thrones, as well as performing voice work for computer games and television adverts...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kTjiABk3TJ3yI0Cto5RsvyT6V3o.jpg", url:"https://themoviedb.org/person/48"}}, {tmdbId:"57422", properties:{imdbId:"0750758", born:date('1974-03-03'), name:"Jared Rushton", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vxH7gfxznPWWKB5zE0J0lsOApgP.jpg", url:"https://themoviedb.org/person/57422"}}, {tmdbId:"70507", properties:{imdbId:"0256456", name:"Alphonsia Emmanuel", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sCYMbgUCeJ7SAn37lysG5I2uFk1.jpg", url:"https://themoviedb.org/person/70507"}}, {tmdbId:"3282", properties:{bornIn:"Santa Monica, California, USA", imdbId:"0004960", born:date('1975-01-29'), name:"Sara Gilbert", bio:"​From Wikipedia, the free encyclopedia. \n\nSara Gilbert  (born January 29, 1975) is an American actress best known for her role as Darlene Conner-Healy from 1988–1997 in the U. S.  sitcom Roseanne.  She created and currently co-hosts the daytime series, The Talk, alongside four other women; discussing controversial topics, contemporary issues, and motherhood.  The Talk premiered on October 18, 2010...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h9yOWIGcvlWPWvHdMfGzue9C5aK.jpg", url:"https://themoviedb.org/person/3282"}}, {tmdbId:"75772", properties:{imdbId:"0473447", name:"Nomadlozi Kubheka", url:"https://themoviedb.org/person/75772"}}, {tmdbId:"75773", properties:{imdbId:"0403402", name:"Agatha Hurle", url:"https://themoviedb.org/person/75773"}}, {tmdbId:"75774", properties:{imdbId:"0412487", name:"Nigel Ivy", url:"https://themoviedb.org/person/75774"}}, {tmdbId:"75775", properties:{bornIn:"New York City, New York, USA", imdbId:"0842884", born:date('1953-02-20'), name:"Tracy Brooks Swope", bio:"Tracy Brooks Swope was born on February 20, 1953 in New York City, New York, as Margaret Tracy Brooks Swope.  She is an actress and producer, known for General Hospital (1963), Another World (1964) and The Power of One (1992).  She was previously married to John G.  Avildsen...", url:"https://themoviedb.org/person/75775"}}, {tmdbId:"5888", properties:{bornIn:"Toronto - Ontario - Canada", imdbId:"0207498", born:date('1970-12-20'), name:"Nicole de Boer", bio:"Nicole de Boer is a Canadian actress.  She is known for starring in the cult film Cube as Joan Leaven, playing Ezri Dax on the final season of Star Trek: Deep Space Nine (1998–1999), and as Sarah Bannerman on the series The Dead Zone (2002–2007)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pgKT9QaIQebn1G0o1yAxrJS8dyr.jpg", url:"https://themoviedb.org/person/5888"}}, {tmdbId:"49825", properties:{bornIn:"Oakland - California - USA", imdbId:"0437249", born:date('1967-01-05'), name:"J.H. Wyman", bio:"Joel Howard \"J.  H. \" Wyman (born January 5, 1967) is an American-born Canadian actor, producer, screenwriter and director. \n\nHe is known for his role in various Canadian and U. S.  shows and films, including Billy K. (William Kramer) in Catwalk, Cory Robbins in Pacific Palisades and Lyle Springer in Sirens. \n\nWyman created the short-lived Fox TV show Keen Eddie.  He then worked on the FOX science-fiction series Fringe, as an executive producer, writer, director and showrunner...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tbV0yLk327Aap3AgaMEDzJXy7bG.jpg", url:"https://themoviedb.org/person/49825"}}, {tmdbId:"168615", properties:{bornIn:"Rochester, New York, USA", imdbId:"0849653", born:date('1966-03-07'), name:"Joy Tanner", url:"https://themoviedb.org/person/168615"}}, {tmdbId:"179962", properties:{imdbId:"0315465", name:"Alle Ghadban", url:"https://themoviedb.org/person/179962"}}, {tmdbId:"143028", properties:{imdbId:"0946028", name:"Liuchun Yang", url:"https://themoviedb.org/person/143028"}}, {tmdbId:"143029", properties:{bornIn:"Mouping, Shandong, China", imdbId:"0499980", born:date('1936-02-21'), name:"Kesheng Lei", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tTnEAQsPKzCxQRLBLscnMENjvc4.jpg", url:"https://themoviedb.org/person/143029"}}, {tmdbId:"4154", properties:{bornIn:"Ramsgate, Kent, England, UK", imdbId:"0000950", born:date('1946-02-20'), name:"Brenda Blethyn", bio:"From Wikipedia, the free encyclopedia. \n\nBrenda Anne Blethyn, OBE (born 20 February 1946) is an English actress who has worked in theatre, television, and film.  Blethyn has received two Academy Award nominations, two SAG Award nominations, two Emmy Award nominations and three Golden Globe Award nominations, winning one...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c4Ik6TcyqwVwetmGYXmFUGPki2O.jpg", url:"https://themoviedb.org/person/4154"}}, {tmdbId:"42746", properties:{bornIn:"Decatur, Illinois, USA", imdbId:"0230335", born:date('1954-02-25'), name:"John Doe", bio:"John Doe (born John Nommensen Duchac on February 25, 1954 in Decatur, Illinois) is an American singer, songwriter, actor, poet and bass player.  Doe founded the much-praised L. A.  punk band X, of which he is still an active member.  His musical compositions and performances span the rock, country and folk music genres.  As an actor, he has dozens of television appearances and several movies to his credit, including the role of Jeff Parker in the television series Roswell...", url:"https://themoviedb.org/person/42746"}}, {tmdbId:"61237", properties:{bornIn:"Lincoln, Illinois, USA", imdbId:"0550830", name:"David Anthony Marshall", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jSiSbLjNiqmM5ngJ6gSNo4AYYjD.jpg", url:"https://themoviedb.org/person/61237"}}, {tmdbId:"65023", properties:{bornIn:"Melbourne - Australia", imdbId:"0689646", born:date('1968-12-31'), name:"Daniel Pollock", bio:"Pollock attended Swinburne Senior Community School in the Melbourne suburb of Hawthorn in the mid-1980s.  He acted in the films Lover Boy (1989), Nirvana Street Murder (1990), Death in Brunswick (1991) and Proof (1991). \n\nPollock's last performance was in the 1992 film Romper Stomper alongside Russell Crowe.  Pollock was posthumously nominated for Best Supporting Actor at the 1992 AFI Awards for the role...", died:date('1992-04-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9yv0QYDbc1jXA5vYvhXmHtFc1wU.jpg", url:"https://themoviedb.org/person/65023"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"28744", properties:{bornIn:"Sydney, New South Wales, Australia", imdbId:"0571537", born:date('1967-10-24'), name:"Jacqueline McKenzie", bio:"​From Wikipedia, the free encyclopedia. \n\nJacqueline Susan McKenzie  (born 24 October 1967) is an Australian actress.  McKenzie made her film debut in the 1987 film Wordplay and on stage in Child Dancing for Griffin Theatre Company.  She made a strong impression in Romper Stomper (1992), and over the next couple of years came to be regarded as one of Australia's most promising young actresses...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hH93PT4yKLtrXyBVw7AF7DbCh3p.jpg", url:"https://themoviedb.org/person/28744"}}, {tmdbId:"65024", properties:{bornIn:" Australia", imdbId:"0778808", born:date('1929-01-01'), name:"Alex Scott", bio:"Alex Scott is an Australian-British television actor best known for his appearances in British television productions of the 1960s, including The Avengers, Danger Man, The Saint and the final episode of Randall and Hopkirk.  He made over 60 appearances on British TV between 1955 and the 1990s but moved back to Australia in 1981.  Since his return to Australia he has had roles in the films Next of Kin, Sky Pirates, Now and Forever, Romper Stomper and Remembering Nigel...", died:date('2015-06-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4axnMjLvK5bmiLJBWqNIkLSdbCG.jpg", url:"https://themoviedb.org/person/65024"}}, {tmdbId:"8986", properties:{bornIn:"Philadelphia - Pennsylvania - USA", imdbId:"0714310", born:date('1948-09-01'), name:"James Rebhorn", bio:"James Robert Rebhorn (September 1, 1948 – March 21, 2014) was an American actor...", died:date('2014-03-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jRdR3q28gTPQU6eWRgiIqzGuMKU.jpg", url:"https://themoviedb.org/person/8986"}}, {tmdbId:"5503", properties:{bornIn:"Laleham, Middlesex, England,  UK", imdbId:"0000270", born:date('1970-02-04'), name:"Gabrielle Anwar", bio:"Gabrielle Anwar (born 4 February 1970) is a British actress.  She is known for her role as Margaret Tudor on The Tudors and for her role as Fiona Glenanne on Burn Notice...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v0zVLAM7kv7ZP0j95HWfNPr1fvp.jpg", url:"https://themoviedb.org/person/5503"}}, {tmdbId:"1892", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0000354", born:date('1970-10-08'), name:"Matt Damon", bio:"Matthew Paige Damon (born October 8, 1970) is an American actor, film producer and screenwriter.  He is ranked among Forbes magazine's most bankable stars and is one of the highest-grossing actors of all time. Damon has received various accolades, including an Academy Award from five nominations, two Golden Globe Awards from eight nominations, and has been nominated for three British Academy Film Awards and seven Emmy Awards...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/elSlNgV8xVifsbHpFsqrPGxJToZ.jpg", url:"https://themoviedb.org/person/1892"}}, {tmdbId:"36631", properties:{bornIn:"Monticello - New York - USA", imdbId:"0000871", born:date('1968-10-16'), name:"Randall Batinkoff", bio:"​From Wikipedia, the free encyclopedia.   \n\nRandall Matthew Batinkoff (born October 16, 1968) is an American actor.  Batinkoff was born in Monticello, New York and was raised on an egg farm near Ferndale, New York.  He attended Phillips Andover Academy in Andover, Massachusetts and Brown University in Rhode Island, receiving a Bachelor of Arts in international relations.  Batinkoff made his television debut in a 1974 commercial, after an agent spotted him at a toy store...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jGey4tkwb4cI5j5Ud01dXGA7nCw.jpg", url:"https://themoviedb.org/person/36631"}}, {tmdbId:"83560", properties:{bornIn:"Hong Kong, British Crown Colony [now China]", imdbId:"0150796", born:date('1952-10-01'), name:"Anthony Chan", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jwkptVVrxkIDB1lkInaFolC9Q6N.jpg", url:"https://themoviedb.org/person/83560"}}, {tmdbId:"6106", properties:{bornIn:"Briarwood, Queens, New York, USA", imdbId:"0001836", born:date('1961-03-04'), name:"Steven Weber", bio:"From Wikipedia, the free encyclopedia.   Steven Robert Weber (born March 4, 1961) is an American actor.  He is best known for his role in the television show Wings which aired throughout the 1990s on NBC. \n\nDescription above from the Wikipedia article Steven Weber, licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8FtkapenCOpe39eE1sQus5WLWAq.jpg", url:"https://themoviedb.org/person/6106"}}, {tmdbId:"26467", properties:{bornIn:"New York City, New York, USA", imdbId:"0001718", born:date('1965-08-19'), name:"Kyra Sedgwick", bio:"​From Wikipedia, the free encyclopedia\n\nKyra Minturn Sedgwick (born August 19, 1965) is an American actress.  Sedgwick is best known for her starring role as Deputy Chief Brenda Leigh Johnson on the TNT crime drama The Closer.  Sedgwick's role in the series won her a Golden Globe Award in 2007 and an Emmy Award in 2010.  The series will come to a close in 2011, following the completion of its seventh season...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aA5pdU9SpM2F5vmVRPrj0gPYUll.jpg", url:"https://themoviedb.org/person/26467"}}, {tmdbId:"68109", properties:{bornIn:"Greensburg, Pennsylvania, USA", imdbId:"0445992", born:date('1961-10-09'), name:"Sheila Kelley", bio:"​From Wikipedia, the free encyclopedia\n\nSheila Kelley (born October 9, 1961) is an American television actress.  She is best known for her roles as Gwen Taylor on L. A.  Law and as Dr.  Charlotte \"Charley\" Bennett Hayes on Sisters. \n\nDescription above from the Wikipedia article Sheila Kelley (American actress), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6tgtM6ZPTo8JbtVGsthUmMh7p7B.jpg", url:"https://themoviedb.org/person/68109"}}, {tmdbId:"11074", properties:{bornIn:"San Diego, California, USA", imdbId:"0001562", born:date('1957-02-06'), name:"Kathy Najimy", bio:"From Wikipedia, the free encyclopedia. \n\nKathy Ann Najimy (born February 6, 1957) is an American actress, most notable as Olive Massery on the television series Veronica's Closet, Sister Mary Patrick in Sister Act and the voice of Peggy Hill on the animated television series King of the Hill.  Prior to her film work, she was best known for two Off Broadway shows with Mo Gaffney working as the duo Kathy and Mo...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nqbZF7Igr0SC8Xq8y0jwmx0mLDN.jpg", url:"https://themoviedb.org/person/11074"}}, {tmdbId:"20623", properties:{bornIn:"New York City, New York, USA", imdbId:"0538655", born:date('1958-10-04'), name:"Wendy Makkena", bio:"From Wikipedia, the free encyclopedia. \n\nWendy Makkena (born October 4, 1958) is an American actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lf5N6a6yo3Ui75dwnxJuZZrUNDi.jpg", url:"https://themoviedb.org/person/20623"}}, {tmdbId:"6714", properties:{bornIn:"Sparks, Nevada, USA", imdbId:"0000749", born:date('1970-12-12'), name:"Mädchen Amick", bio:"Mädchen Amick (born December 12, 1970) is an American actress best known for Twin Peaks and Twin Peaks: Fire Walk with Me...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1JwmUzZyqSbViscjxSX88jCZ8hw.jpg", url:"https://themoviedb.org/person/6714"}}, {tmdbId:"10380", properties:{bornIn:"Falls Church, Virginie, États-Unis", imdbId:"0371579", born:date('1940-02-06'), name:"Jim Haynie", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xOOfHlwhjY9OKeLeUCJ2oiSz8gn.jpg", url:"https://themoviedb.org/person/10380"}}, {tmdbId:"127098", properties:{bornIn:"Pasadena, California, USA", imdbId:"0380912", born:date('1964-04-05'), name:"Gary Hershberger", url:"https://themoviedb.org/person/127098"}}, {tmdbId:"90654", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"0001118", born:date('1951-10-18'), name:"Pam Dawber", bio:"From Wikipedia, the free encyclopedia. \n\nPam Dawber (born October 18, 1951) is an American actress best known for her lead television sitcom roles as Mindy McConnell in Mork & Mindy (1978–1982) and Samantha Russell in My Sister Sam (1986–1988)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e4X7ARwNubiheEABd4jieTDphMW.jpg", url:"https://themoviedb.org/person/90654"}}, {tmdbId:"65059", properties:{bornIn:"Hinsdale, Illinois, USA", imdbId:"0005495", born:date('1978-03-23'), name:"David Tom", url:"https://themoviedb.org/person/65059"}}, {tmdbId:"16407", properties:{bornIn:"Aberystwyth, Wales, UK", imdbId:"0715953", born:date('1944-05-05'), name:"Roger Rees", bio:"From Wikipedia, the free encyclopedia\n\nRoger Rees (born 5 May 1944) is a Welsh actor.  He is best known to American audiences for playing the characters Robin Colcord on the American television sitcom show Cheers and Lord John Marbury on the American television drama The West Wing.  He won a Tony Award for his performance as the lead in The Life and Adventures of Nicholas Nickleby...", died:date('2015-07-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qKWG7oxTL1JGzTzHLacsNLDAbNs.jpg", url:"https://themoviedb.org/person/16407"}}, {tmdbId:"177443", properties:{bornIn:"Long Island, New York, USA", imdbId:"0001630", born:date('1960-06-22'), name:"Tracy Pollan", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yNMv81Y17tB16YXp3FbGMQj9vuN.jpg", url:"https://themoviedb.org/person/177443"}}, {tmdbId:"24589", properties:{bornIn:"Swan Hill, Victoria, Australia", imdbId:"0580527", born:date('1963-03-31'), name:"Paul Mercurio", url:"https://themoviedb.org/person/24589"}}] AS row
