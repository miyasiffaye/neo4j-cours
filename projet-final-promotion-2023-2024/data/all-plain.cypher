UNWIND [{tmdbId:"1462", properties:{bornIn:"Tulsa - Oklahoma - USA", imdbId:"0625789", born:date('1964-05-11'), name:"Tim Blake Nelson", bio:"From Wikipedia, the free encyclopedia\n\nTim Blake Nelson (born May 11, 1964) is an American director, writer, singer, and actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dcfdSmVmklb1HXHbB9kySdrl9Nq.jpg", url:"https://themoviedb.org/person/1462"}}, {tmdbId:"3288", properties:{bornIn:"New York City, New York", imdbId:"0919363", born:date('1969-11-30'), name:"Chris Weitz", bio:"Christopher John \"Chris\" Weitz is an American producer, writer, director and actor.  He is best known for his work with his brother, Paul Weitz, on the comedy films American Pie and About a Boy, as well as directing the film adaptation of the novel The Golden Compass and the film adaptation of New Moon from the series of Twilight books...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uDCDptv17L2EAt1x9Ipn5AWwaiU.jpg", url:"https://themoviedb.org/person/3288"}}, {tmdbId:"69488", properties:{bornIn:"Brunico, Bolzano, Trentino-Alto Adige, Italy", imdbId:"0604335", born:date('1953-08-19'), name:"Nanni Moretti", bio:"Giovanni \"Nanni\" Moretti (born August 19, 1953) is an Italian film director, producer, screenwriter and actor.  The Palme d'Or winner in 2001, in 2012 he was the President of the Jury at the Cannes Film Festival...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8n8vJyP2DqN9f8wXyjsLWYiqtzY.jpg", url:"https://themoviedb.org/person/69488"}}, {tmdbId:"6198", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"0193554", born:date('1956-09-30'), name:"Vondie Curtis-Hall", bio:"From Wikipedia, the free encyclopedia\n\nVondie Curtis-Hall (born September 30, 1956) is an American actor and film director. \n\nAs an actor, he is best known for his role as Dr.  Dennis Hancock on the CBS medical drama Chicago Hope created by David E.  Kelley. \n\nDescription above from the Wikipedia article Vondie Curtis-Hall, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eJbwjnUB3VGGioAtQTmiYI4k7lH.jpg", url:"https://themoviedb.org/person/6198"}}, {tmdbId:"28279", properties:{bornIn:"Antony, Seine, Francia", imdbId:"0418450", born:date('1964-10-19'), name:"Agnès Jaoui", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5iapBWdu5lnnZ0hLOFVYPY2yslB.jpg", url:"https://themoviedb.org/person/28279"}}, {tmdbId:"57328", properties:{imdbId:"0087904", name:"Barry W. Blaustein", url:"https://themoviedb.org/person/57328"}}, {tmdbId:"5367", properties:{bornIn:"South Orange, New Jersey, USA", imdbId:"0103785", born:date('1975-04-06'), name:"Zach Braff", bio:"Zachary Israel \"Zach\" Braff (born April 6, 1975 in South orange, New Jersey) is an American actor, screenwriter, producer, and director.  Braff first became known in 2001 for his role as Dr.  John Dorian on the TV series Scrubs, which earned him his first Emmy nomination.  Braff remained working on Scrubs for eight years, until he announced his departure as an actor, his last episode airing in December 2009.  Braff has, however, taken an executive producer's role on the series...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2AAnPoazqQRzC9Xyq3QkbnOlrtV.jpg", url:"https://themoviedb.org/person/5367"}}, {tmdbId:"52886", properties:{bornIn:"Amesbury, Massachusetts, USA", imdbId:"0232998", born:date('1968-05-11'), name:"Jeffrey Donovan", bio:"A television, movie, and stage actor.  He is the lead Michael Westen on the hit show Burn Notice, now entering its fifth season.  Donovan is also known for co-starring in following films: Changeling, Hitch, Believe in Me, Come Early Morning and Touching Evil.  This spring he played the role of Robert Kennedy in Clint Eastwood's upcoming J.  Edgar. \n\nDescription above from the Wikipedia article Jeffrey Donovan, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wlDXfXpu6Uz32LUmbFzU8QPDoQH.jpg", url:"https://themoviedb.org/person/52886"}}, {tmdbId:"4489", properties:{bornIn:"Los Angeles, California, United States", imdbId:"0644203", born:date('1961-11-27'), name:"Steve Oedekerk", bio:"Steve Oedekerk is an American comedian, director, editor, producer, screenwriter and actor.  Oedekerk is best known for his collaborations with actor Jim Carrey and director Tom Shadyac (particularly the Ace Ventura franchise), his series of \"Thumbmation\" shorts and his film Kung Pow: Enter the Fist (2002)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/maHloPSvRLk5EvAbr6yQG6fqsCF.jpg", url:"https://themoviedb.org/person/4489"}}, {tmdbId:"36423", properties:{bornIn:"Pembroke, Ontario, Canada", imdbId:"0338381", born:date('1971-07-30'), name:"Tom Green", bio:"Michael Thomas \"Tom\" Green is a Canadian actor, rapper, writer, comedian, talk show host and media personality.  He is best-known for his MTV television show The Tom Green Show, his short-lived marriage to actress Drew Barrymore and for his roles in such films as Freddy Got Fingered, Road Trip, Stealing Harvard and Charlie's Angels...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yHnSb0itPtEnbdtvnbHL2kB6sCu.jpg", url:"https://themoviedb.org/person/36423"}}, {tmdbId:"22215", properties:{bornIn:"Princeton, New Jersey, USA", imdbId:"0795290", born:date('1970-06-17'), name:"Michael Showalter", bio:"Michael English Showalter (born June 17, 1970) is an American comedian, actor, writer, and director.  He is one third of the sketch comedy trio Stella.  Showalter first came to recognition as a cast member on MTV's The State, which aired from 1993 to 1995.  He co-wrote (with David Wain) and starred in Wet Hot American Summer (2001) and he wrote, directed, and starred in The Baxter (2005), with Michelle Williams, Justin Theroux and Elizabeth Banks...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AtX8Eli8Cg8g8HrcRJDBFnplyN0.jpg", url:"https://themoviedb.org/person/22215"}}, {tmdbId:"6817", properties:{bornIn:"Ixelles, Brussels, Belgium", imdbId:"0889513", born:date('1928-05-30'), name:"Agnès Varda", bio:"Agnès Varda (30 May 1928 – 29 March 2019) was a Belgian-born French film director and professor at the European Graduate School.  Her films, photographs, and art installations focus on documentary realism, feminist issues, and social commentary — with a distinct experimental style...", died:date('2019-03-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8XKM6DCVcH5RsgIRh9mwVaEM0YB.jpg", url:"https://themoviedb.org/person/6817"}}, {tmdbId:"7883", properties:{imdbId:"0250995", name:"Ralph Eggleston", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/28ZxW5tHMuWYK8T3I0xLfVAF9yw.jpg", url:"https://themoviedb.org/person/7883"}}, {tmdbId:"19303", properties:{bornIn:"Red Bank, New Jersey, USA", imdbId:"0003620", born:date('1970-08-02'), name:"Kevin Smith", bio:"Kevin Patrick Smith (born August 2, 1970) is an American screenwriter, actor, film producer, and director, as well as a popular comic book writer, author, comedian/raconteur, and internet radio personality best recognized by viewers as Silent Bob.  His films include Clerks, Dogma, Zack and Miri Make a Porno, Cop Out, and the upcoming horror film Red State...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/r3f3qyD6pPGUKHMAZbqQf8IhclX.jpg", url:"https://themoviedb.org/person/19303"}}, {tmdbId:"74376", properties:{bornIn:"İstanbul, Türkiye", imdbId:"0948000", born:date('1973-04-23'), name:"Cem Yilmaz", bio:"​Cem Yılmaz (d.  23 Nisan 1973, İstanbul) komedyen, oyuncu, müzisyen, karikatürist, senarist ve yönetmen.  Doğumundan sonra çocukluğu 11 yaşına kadar Kocamustafapaşa - Samatya'da geçti.  Kocamustafapaşa'da ki Mehmet Akif Ersoy İlkokulu'nda 4.  sınıfta okurken aile Bahçelievler'e taşındı.  Ortaokulu Bahçelievler Kazım Karabekir Ortaokulu'nda bitirdi.  Lise öğrenimi Etiler Anadolu Otelcilik ve Turizm Meslek Lisesi'nde görmüştür...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qRRdJU4PdWxPdjIM6uULqoV4qjy.jpg", url:"https://themoviedb.org/person/74376"}}, {tmdbId:"84021", properties:{bornIn:"Calgary, Alberta, Canada", imdbId:"0343472", born:date('1959-04-30'), name:"Paul Gross", bio:"Paul Michael Gross (born April 30, 1959) is a Canadian actor, producer, director, singer and writer born in Calgary, Alberta.  He is known for his lead role as Constable Benton Fraser in the television series Due South as well as his 2008 war film Passchendaele, which he wrote, produced, directed, and starred in...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fqpHv6pMb7OnAB6PKSMX23Pvrzi.jpg", url:"https://themoviedb.org/person/84021"}}, {tmdbId:"119368", properties:{bornIn:"Guilford, Connecticut", imdbId:"0922724", born:date('1970-02-02'), name:"Jennifer Westfeldt", bio:"​From Wikipedia, the free encyclopedia.   \n\nJennifer Westfeldt (born February 2, 1970) is an American actress and screenwriter known for the hit 2001 independent film Kissing Jessica Stein, which she co-wrote with Heather Juergensen and in which the two women starred. \n\nDescription above from the Wikipedia article Jennifer Westfeldt,  licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uIyLUWDL5NFzZlcccktzuoAHPXI.jpg", url:"https://themoviedb.org/person/119368"}}, {tmdbId:"55587", properties:{bornIn:"Vancouver, British Columbia, Canada", imdbId:"0824220", born:date('1971-02-28'), name:"Peter Stebbings", bio:"Peter Stebbings is a Canadian film and television actor and director, best known for his portrayal of Kevin Sharp on the Canadian television series Madison...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jzCHs7st9EKGnwHq2aZ52ItSfiP.jpg", url:"https://themoviedb.org/person/55587"}}, {tmdbId:"2245", properties:{bornIn:"Tel-Aviv, Israel", imdbId:"0040939", born:date('1965-01-04'), name:"Yvan Attal", bio:"​From Wikipedia, the free encyclopedia\n\nYvan Attal (born 4 January 1965) is an Israeli-born French actor and director. \n\nDescription above from the Wikipedia article Yvan Attal, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2VaxsiFuad8uHHWTM6Fc71wtNCx.jpg", url:"https://themoviedb.org/person/2245"}}, {tmdbId:"66193", properties:{bornIn:"Colorado, USA", imdbId:"0761498", born:date('1960-03-15'), name:"Chris Sanders", bio:"Christopher Michael \"Chris\" Sanders (born March 15, 1960) is an American film animator and voice actor best-known for co-directing and co-writing the Disney animated feature Lilo & Stitch, and providing the voice of Experiment 626 from Lilo & Stitch and Leroy from Disney's Leroy & Stitch.  After being later dismissed from Walt Disney Animation Studios, Sanders went on to work for DreamWorks Animation, directing the highly acclaimed animated feature film, How to Train Your Dragon...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mrUm1agSL9Kj6dhV6ABVJvrwlie.jpg", url:"https://themoviedb.org/person/66193"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor:Director;
UNWIND [{tmdbId:"240", properties:{bornIn:"Manhattan, New York, USA", imdbId:"0000040", born:date('1928-07-26'), name:"Stanley Kubrick", bio:"Stanley Kubrick (July 26, 1928 – March 7, 1999) was an American film director, writer, producer, and photographer who lived in England during most of the last four decades of his career.  Kubrick was noted for the scrupulous care with which he chose his subjects, his slow method of working, the variety of genres he worked in, his technical perfectionism, and his reclusiveness about his films and personal life...", died:date('1999-03-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/exfQ6vXXq7rMS5YWb3B88PK39a1.jpg", url:"https://themoviedb.org/person/240"}}, {tmdbId:"550064", properties:{imdbId:"0325148", name:"B.Z. Goldberg", url:"https://themoviedb.org/person/550064"}}, {tmdbId:"57607", properties:{bornIn:"Hong Kong, China", imdbId:"0159507", born:date('1962-06-22'), name:"Stephen Chow", bio:"Stephen Chow Sing-Chi (born 22 June 1962) is a Hong Kong actor, comedian, screenwriter, film director and producer. \n\nDescription above from the Wikipedia article Stephen Chow, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lOqegM5BG0bH71MtogZZpRnAj61.jpg", url:"https://themoviedb.org/person/57607"}}, {tmdbId:"9281", properties:{bornIn:"Pittsfield, Massachusetts, USA", imdbId:"0006969", born:date('1974-02-10'), name:"Elizabeth Banks", bio:"Elizabeth Maresal Mitchell (born February 10, 1974), known professionally as Elizabeth Banks, is an American actress.  Banks had her film debut in the low-budget independent film Surrender Dorothy.  Since then, she has been well-known for her roles in Definitely, Maybe, Zack and Miri Make a Porno, W. , Role Models, Wet Hot American Summer, The Uninvited and the Spider-Man franchise.  Banks has also portrayed roles as guest star in television shows through her career, including the role of Dr...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xy1OKADZmcfc4P2j0EytHQuyRut.jpg", url:"https://themoviedb.org/person/9281"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor:Director;
UNWIND [{movieId:"1", properties:{languages:["English"], year:1995, imdbId:"0114709", runtime:81, imdbRating:8.3, countries:["USA"], imdbVotes:591836, title:"Toy Story", url:"https://themoviedb.org/movie/862", revenue:373554033, tmdbId:"862", plot:"A cowboy doll is profoundly threatened and jealous when a new spaceman figure supplants him as top toy in a boy's room.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uXDfjJbdP4ijW5hWSBrPrlKpxab.jpg", released:"1995-11-22", budget:30000000}}, {movieId:"2", properties:{languages:["English", " French"], year:1995, imdbId:"0113497", runtime:104, imdbRating:6.9, countries:["USA"], imdbVotes:198355, title:"Jumanji", url:"https://themoviedb.org/movie/8844", revenue:262797249, tmdbId:"8844", plot:"When two kids find and play a magical board game, they release a man trapped for decades in it and a host of dangers that can only be stopped by finishing the game.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vgpXmVaVyUL7GGiDeiK1mKEKzcX.jpg", released:"1995-12-15", budget:65000000}}, {movieId:"3", properties:{languages:["English"], year:1995, imdbId:"0113228", runtime:101, imdbRating:6.6, countries:["USA"], imdbVotes:18615, title:"Grumpier Old Men", url:"https://themoviedb.org/movie/15602", tmdbId:"15602", plot:"John and Max resolve to save their beloved bait shop from turning into an Italian restaurant, just as its new female owner catches Max's attention.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1FSXpj5e8l4KH6nVFO5SPUeraOt.jpg", released:"1995-12-22"}}, {movieId:"4", properties:{languages:["English"], year:1995, imdbId:"0114885", runtime:124, imdbRating:5.6, countries:["USA"], imdbVotes:7210, title:"Waiting to Exhale", url:"https://themoviedb.org/movie/31357", revenue:81452156, tmdbId:"31357", plot:"Based on Terry McMillan's novel, this film follows four very different African-American women and their relationships with the male gender.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4wjGMwPsdlvi025ZqR4rXnFDvBz.jpg", released:"1995-12-22", budget:16000000}}, {movieId:"5", properties:{languages:["English"], year:1995, imdbId:"0113041", runtime:106, imdbRating:5.9, countries:["USA"], imdbVotes:25938, title:"Father of the Bride Part II", url:"https://themoviedb.org/movie/11862", revenue:76578911, tmdbId:"11862", plot:"In this sequel, George Banks deals not only with the pregnancy of his daughter, but also with the unexpected pregnancy of his wife.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lf9RTErt8BSLQy98aSFblElvsCQ.jpg", released:"1995-12-08"}}, {movieId:"6", properties:{languages:["English", " Spanish"], year:1995, imdbId:"0113277", runtime:170, imdbRating:8.2, countries:["USA"], imdbVotes:416316, title:"Heat", url:"https://themoviedb.org/movie/949", revenue:187436818, tmdbId:"949", plot:"A group of professional bank robbers start to feel the heat from police when they unknowingly leave a clue at their latest heist.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rrBuGu0Pjq7Y2BWSI6teGfZzviY.jpg", released:"1995-12-15", budget:60000000}}, {movieId:"7", properties:{languages:["English", " French"], year:1995, imdbId:"0114319", runtime:127, imdbRating:6.2, countries:["Germany", " USA"], imdbVotes:29091, title:"Sabrina", url:"https://themoviedb.org/movie/11860", revenue:53672080, tmdbId:"11860", plot:"An ugly duckling having undergone a remarkable change, still harbors feelings for her crush: a carefree playboy, but not before his business-focused brother has something to say about it.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z1oNjotUI7D06J4LWQFQzdIuPnf.jpg", released:"1995-12-15", budget:58000000}}, {movieId:"8", properties:{languages:["English"], year:1995, imdbId:"0112302", runtime:97, imdbRating:5.6, countries:["USA"], imdbVotes:7224, title:"Tom and Huck", url:"https://themoviedb.org/movie/45325", revenue:23920048, tmdbId:"45325", plot:"Tom and Huck witness Injun Joe's killing of Doc Robinson one night at the graveyard. When an innocent man is accused of killing the Doc, Tom steps up as a witness, not respecting the promise made to Huck to lay low.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lOnbEStMnDGKWJGvPEsMoZDML1b.jpg", released:"1995-12-22"}}, {movieId:"9", properties:{languages:["English"], year:1995, imdbId:"0114576", runtime:111, imdbRating:5.7, countries:["USA"], imdbVotes:24978, title:"Sudden Death", url:"https://themoviedb.org/movie/9091", revenue:64350171, tmdbId:"9091", plot:"A former fireman takes on a group of terrorists holding the Vice President and others hostage during the seventh game of the NHL Stanley Cup finals.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4Snihptli0we9I4W5QfufOdHSeV.jpg", released:"1995-12-22", budget:35000000}}, {movieId:"10", properties:{languages:["English", " Russian", " Spanish"], year:1995, imdbId:"0113189", runtime:130, imdbRating:7.2, countries:["UK", " USA"], imdbVotes:194676, title:"GoldenEye", url:"https://themoviedb.org/movie/710", revenue:352194034, tmdbId:"710", plot:"James Bond teams up with the lone survivor of a destroyed Russian research center to stop the hijacking of a nuclear space weapon by a fellow agent formerly believed to be dead.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z0ljRnNxIO7CRBhLEO0DvLgAFPR.jpg", released:"1995-11-17", budget:58000000}}, {movieId:"11", properties:{languages:["English", " French"], year:1995, imdbId:"0112346", runtime:114, imdbRating:6.8, countries:["USA"], imdbVotes:41983, title:"American President, The", url:"https://themoviedb.org/movie/9087", revenue:107879496, tmdbId:"9087", plot:"Comedy-drama about a widowed U.S. president and a lobbyist who fall in love. It's all above-board, but politics is perception and sparks fly anyway.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yObOAYFIHXHkFPQ3jhgkN2ezaD.jpg", released:"1995-11-17", budget:62000000}}, {movieId:"12", properties:{languages:["English", " German"], year:1995, imdbId:"0112896", runtime:88, imdbRating:5.8, countries:["USA", " France"], imdbVotes:29321, title:"Dracula: Dead and Loving It", url:"https://themoviedb.org/movie/12110", tmdbId:"12110", plot:"Mel Brooks' parody of the classic vampire story and its famous film adaptations.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4rRfZz8YnHNRr16t3CFcJrPdXHi.jpg", released:"1995-12-22"}}, {movieId:"13", properties:{languages:["English"], year:1995, imdbId:"0112453", runtime:78, imdbRating:7.1, countries:["USA"], imdbVotes:29277, title:"Balto", url:"https://themoviedb.org/movie/21032", revenue:11348324, tmdbId:"21032", plot:"An outcast half-wolf risks his life to prevent a deadly epidemic from ravaging Nome, Alaska.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tpoaKJMRjOZl9cbZRR2aiKikyRC.jpg", released:"1995-12-22"}}, {movieId:"14", properties:{languages:["English", " Mandarin", " Russian"], year:1995, imdbId:"0113987", runtime:192, imdbRating:7.1, countries:["USA"], imdbVotes:23508, title:"Nixon", url:"https://themoviedb.org/movie/10858", revenue:13681765, tmdbId:"10858", plot:"A biographical story of former U.S. president Richard Milhous Nixon, from his days as a young boy to his eventual presidency which ended in shame.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ORlTkdDwWU94O16MlwfIR4g5Hk.jpg", released:"1996-01-05", budget:44000000}}, {movieId:"15", properties:{languages:["English"], year:1995, imdbId:"0112760", runtime:124, imdbRating:5.6, countries:["USA", " France", " Italy", " Germany"], imdbVotes:20522, title:"Cutthroat Island", url:"https://themoviedb.org/movie/1408", revenue:10017322, tmdbId:"1408", plot:"A female pirate and her companion race against their rivals to find a hidden island that contains a fabulous treasure.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hYdeBZ4BFXivdouxLfQGWNE6zRx.jpg", released:"1995-12-22", budget:98000000}}, {movieId:"16", properties:{languages:["English"], year:1995, imdbId:"0112641", runtime:178, imdbRating:8.2, countries:["USA", " France"], imdbVotes:320118, title:"Casino", url:"https://themoviedb.org/movie/524", revenue:116112375, tmdbId:"524", plot:"Greed, deception, money, power, and murder occur between two mobster best friends and a trophy wife over a gambling empire.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4TS5O1IP42bY2BvgMxL156EENy.jpg", released:"1995-11-22", budget:52000000}}, {movieId:"17", properties:{languages:["English", " French"], year:1995, imdbId:"0114388", runtime:136, imdbRating:7.7, countries:["USA", " UK"], imdbVotes:76082, title:"Sense and Sensibility", url:"https://themoviedb.org/movie/4584", revenue:134582776, tmdbId:"4584", plot:"Rich Mr. Dashwood dies, leaving his second wife and her three daughters poor by the rules of inheritance. The two eldest daughters are the titular opposites.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cBK2yL3HqhFvIVd7lLtazWlRZPR.jpg", released:"1996-01-26", budget:16000000}}, {movieId:"18", properties:{languages:["English"], year:1995, imdbId:"0113101", runtime:98, imdbRating:6.7, countries:["USA"], imdbVotes:75952, title:"Four Rooms", url:"https://themoviedb.org/movie/5", revenue:4257354, tmdbId:"5", plot:"Four interlocking tales that take place in a fading hotel on New Year's Eve.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uZSmxBLIuZ8gpadjAWNdA5aQDAc.jpg", released:"1995-12-25", budget:4000000}}, {movieId:"19", properties:{languages:["English"], year:1995, imdbId:"0112281", runtime:90, imdbRating:6.3, countries:["USA"], imdbVotes:155200, title:"Ace Ventura: When Nature Calls", url:"https://themoviedb.org/movie/9273", revenue:212385533, tmdbId:"9273", plot:"Ace Ventura, Pet Detective, returns from a spiritual quest to investigate the disappearance of a rare white bat, the sacred animal of a tribe in Africa.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wcinCf1ov2D6M3P7BBZkzQFOiIb.jpg", released:"1995-11-10", budget:30000000}}, {movieId:"20", properties:{languages:[