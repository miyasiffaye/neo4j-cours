mdbId:"4625486", name:"Bob Cowsill", url:"https://themoviedb.org/person/1404687"}}, {tmdbId:"29445", properties:{bornIn:"Garden City, Long Island, New York, USA", imdbId:"0680392", born:date('1955-02-08'), name:"Ethan Phillips", bio:"From Wikipedia, the free encyclopedia. \n\nEthan Phillips (born February 8, 1955, height 5' 6\" (1,68 m)) is an American actor, playwright and author.  He is known for television roles such as Star Trek: Voyager's Neelix and Benson's Pete Downey. \n\nRaised in Garden City, New York, Phillips attended Boston University and received a bachelor's degree in English literature and a Master of Fine Arts from Cornell University...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/npr6XzOaGJauOBV1ydaqmX6T5hl.jpg", url:"https://themoviedb.org/person/29445"}}, {tmdbId:"221116", properties:{bornIn:"Los Angeles, California, USA", imdbId:"2086223", born:date('1993-10-29'), name:"India Eisley", bio:"From Wikipedia, the free encyclopedia. \n\nIndia Joy Eisley (born October 29, 1993) is an American teen actress best known for playing Ashley Juergens in the ABC Family teen drama The Secret Life of the American Teenager...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7dmchBMMzEvUG7pkEGYdyQ35Y3F.jpg", url:"https://themoviedb.org/person/221116"}}, {tmdbId:"230810", properties:{imdbId:"4630687", name:"Jaco Muller", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yON0tl5JCNGQ4Sj1QxtDiKKyMe9.jpg", url:"https://themoviedb.org/person/230810"}}, {tmdbId:"75565", properties:{imdbId:"0511686", name:"Annabel Linder", url:"https://themoviedb.org/person/75565"}}, {tmdbId:"1076131", properties:{imdbId:"3947527", name:"Christina Storm", url:"https://themoviedb.org/person/1076131"}}, {tmdbId:"1750169", properties:{bornIn:"Indianapolis, Indiana, USA", imdbId:"4584672", name:"Kim Campbell", bio:"Kimberly \"Kim\" Woollen married country music icon Glen Campbell in 1982.  The couple met on a blind date in 1981 when Woollen was a Radio City Music Hall \"Rockette\".  Together, they had three children: Cal, Shannon, and Ashley...", url:"https://themoviedb.org/person/1750169"}}, {tmdbId:"1057653", properties:{bornIn:"Rochester, Stato di New York, Stati Uniti", imdbId:"2693238", name:"Brian Petsos", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7OdMnpx8MvjF5jDaFTwZvrhZ6ps.jpg", url:"https://themoviedb.org/person/1057653"}}, {tmdbId:"103373", properties:{imdbId:"1439162", name:"Carmen Pelaez", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eIGYL2s4XSkxdY4YjiA8LPK31Zb.jpg", url:"https://themoviedb.org/person/103373"}}] AS row
