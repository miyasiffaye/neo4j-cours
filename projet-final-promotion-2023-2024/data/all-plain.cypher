45", properties:{languages:["English"], year:2014, imdbId:"2980472", runtime:95, imdbRating:6.4, countries:["USA"], imdbVotes:12742, title:"Just Before I Go", url:"https://themoviedb.org/movie/258099", tmdbId:"258099", plot:"On the verge of giving up on life, a guy travels to his hometown to make amends.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rEwXZIOh3CLVA5JJmxT5kaYY6ff.jpg", released:"2015-04-24"}}, {movieId:"133645", properties:{languages:["English"], year:2015, imdbId:"2402927", runtime:118, imdbRating:7.4, countries:["UK", " USA"], imdbVotes:36907, title:"Carol", url:"https://themoviedb.org/movie/258480", revenue:40272135, tmdbId:"258480", plot:"An aspiring photographer develops an intimate relationship with an older woman.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uHwjbztkPEW3lcfsbKGO3XlaPjL.jpg", released:"2016-01-15"}}, {movieId:"133771", properties:{languages:["English", " French"], year:2015, imdbId:"3464902", runtime:118, imdbRating:7.2, countries:["Ireland", " UK", " Greece", " France", " Netherlands", " USA"], imdbVotes:38859, title:"The Lobster", url:"https://themoviedb.org/movie/254320", revenue:15656193, tmdbId:"254320", plot:"In a dystopian near future, single people, according to the laws of The City, are taken to The Hotel, where they are obliged to find a romantic partner in forty-five days or are transformed into beasts and sent off into The Woods.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vQ6NifiuDJ1HuFH04stzVojo3T.jpg", budget:4000000}}, {movieId:"133782", properties:{languages:["English"], year:2015, imdbId:"1881002", runtime:95, imdbRating:5.6, countries:["USA", " Switzerland"], imdbVotes:26541, title:"Maggie", url:"https://themoviedb.org/movie/287424", revenue:187112, tmdbId:"287424", plot:"A teenage girl in the Midwest becomes infected by an outbreak of a disease that slowly turns the infected into cannibalistic zombies. During her transformation, her loving father stays by her side.", poster:"ht