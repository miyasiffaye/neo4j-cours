UNWIND [{tmdbId:"46949", properties:{bornIn:"Detroit, Michigan, United States", imdbId:"0705717", born:date('1946-06-28'), name:"Gilda Radner", bio:"​From Wikipedia, the free encyclopedia\n\nGilda Susan Radner (June 28, 1946 – May 20, 1989) was an American comedian and actress, best known as one of the original cast members of the NBC sketch comedy show Saturday Night Live, for which she won an Emmy Award in 1978. \n\nDescription above from the Wikipedia article Gilda Radner, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1989-05-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ab6QhtigYDeKbaxeVKVLsMpspyd.jpg", url:"https://themoviedb.org/person/46949"}}, {tmdbId:"29021", properties:{bornIn:"Trenton, New Jersey, USA", imdbId:"0366509", born:date('1952-07-27'), name:"Roxanne Hart", bio:"Roxanne Hart (born July 27, 1952) is an American television, film and stage actress.  She may be best known for her role as Brenda Wyatt in the 1986 film Highlander.  She is also known for the role of Nurse Camille Shutt on the Medical drama Chicago Hope. \n\nDescription above from the Wikipedia article Roxanne Hart, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/29021"}}, {tmdbId:"6574", properties:{bornIn:"Urbana, Ohio, USA", imdbId:"0000317", born:date('1959-01-05'), name:"Clancy Brown", bio:"Clarence J.  \"Clancy\" Brown III (born January 5, 1959 height 6' 3½\" (1,92 m)) is an American film, television and voice actor.  He is known for his live-action roles as Captain Byron Hadley in the award-winning The Shawshank Redemption; The Kurgan in the film Highlander; Brother Justin Crowe in HBO's critically acclaimed Carnivàle and Career Sergeant Zim in Starship Troopers.  Brown is most famous for providing the voices of animated characters such as Mr.  Eugene H...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x1PmZDT0cStrGS9RfpluCFR84MG.jpg", url:"https://themoviedb.org/person/6574"}}, {tmdbId:"105740", properties:{bornIn:"Monte Buey, Córdoba, Argentina", imdbId:"0704247", born:date('1945-06-14'), name:"Lorenzo Quinteros", died:date('2019-04-23'), url:"https://themoviedb.org/person/105740"}}, {tmdbId:"1102442", properties:{bornIn:"Corrientes, Argentina", imdbId:"0815537", born:date('1953-01-15'), name:"Hugo Soto", died:date('1994-08-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aqmO6SQ69f1o1GWypF9wfwXrqUs.jpg", url:"https://themoviedb.org/person/1102442"}}, {tmdbId:"573528", properties:{imdbId:"0894536", name:"Inés Vernengo", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w0DEmVCiruGxw3YrPW4G2acPGZs.jpg", url:"https://themoviedb.org/person/573528"}}, {tmdbId:"1664253", properties:{imdbId:"0769049", name:"Cristina Scaramuzza", url:"https://themoviedb.org/person/1664253"}}, {tmdbId:"4080", properties:{imdbId:"0941125", born:date('1921-04-10'), name:"Sheb Wooley", died:date('2003-09-16'), url:"https://themoviedb.org/person/4080"}}, {tmdbId:"13591", properties:{bornIn:"Pasadena, California, USA.", imdbId:"0596959", born:date('1943-01-13'), name:"Richard Moll", bio:"Richard Moll was born on January 13, 1943 in Pasadena, California, USA as Charles Richard Moll.  He is an actor, known for Scary Movie 2 (2001), But I'm a Cheerleader (1999) and The Flintstones (1994).  He was previously married to Susan Brown and Laura Class...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aPByokbMr7X2UsVxmMG8xWRpzW6.jpg", url:"https://themoviedb.org/person/13591"}}, {tmdbId:"42174", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0001464", born:date('1953-03-04'), name:"Kay Lenz", bio:"From Wikipedia, the free encyclopedia. \n\nKay Ann Lenz (born March 4, 1953 in Los Angeles, California) is an American actress. \n\nA former child performer, Lenz has worked primarily in television and has won two Emmy Awards. \n\nDescription above from the Wikipedia article Kay Lenz, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d005Rxz9q9clW9Vau9DJWRBigep.jpg", url:"https://themoviedb.org/person/42174"}}, {tmdbId:"1471", properties:{bornIn:"Plainwell, Michigan, USA", imdbId:"0301839", born:date('1963-08-23'), name:"Ed Gale", bio:"Ed Gale is an American film and television actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pTX4hpATB8F9lrH17OkFCB9DBjR.jpg", url:"https://themoviedb.org/person/1471"}}, {tmdbId:"93407", properties:{bornIn:"Moscow, RSFSR, USSR", imdbId:"0470385", born:date('1969-10-10'), name:"Aleksey Kravchenko", bio:"From Wikipedia, the free encyclopedia\n\nAleksei Yevgenyevich Kravchenko (Russian: Алексе́й Евге́ньевич Кра́вченко; born October 10, 1969) is a Russian actor known for his role in the 1985 film Come and See as a young boy in the resistance army. \n\nAleksei Kravchenko was born in Podolsk near Moscow, He was 14 when filming started, In 1985 he made his debut in the film E.  Klimov \"Come and See\".  After graduating from vocational school he served in the Navy...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o7UD6o30iJ29dTHPCbtOScv9s5E.jpg", url:"https://themoviedb.org/person/93407"}}, {tmdbId:"93408", properties:{imdbId:"0592500", name:"Olga Mironova", bio:"Olga Mironova is an actress, known for Come and See (1985)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wSeCtQNuWVVUlHMAAkxVRSCYh7s.jpg", url:"https://themoviedb.org/person/93408"}}, {tmdbId:"93409", properties:{bornIn:"Vilnius, Lithuanian SSR, USSR, (now Lithuania)", imdbId:"0490708", born:date('1950-06-15'), name:"Liubomiras Laucevicius", url:"https://themoviedb.org/person/93409"}}, {tmdbId:"139096", properties:{imdbId:"0046575", name:"Vladas Bagdonas", url:"https://themoviedb.org/person/139096"}}, {tmdbId:"48012", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0001263", born:date('1965-02-07'), name:"Jason Gedrick", bio:"An American actor best known for his work on the television series Murder One and Boomtown, as well as the motion picture Iron Eagle.  Gedrick began his career as an extra in films such as Bad Boys (1983) and Risky Business (1983)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/45Dea89CukCmdk88F7RQMgpAeYC.jpg", url:"https://themoviedb.org/person/48012"}}, {tmdbId:"20277", properties:{bornIn:"London, England, UK", imdbId:"0837064", born:date('1946-05-02'), name:"David Suchet", bio:"David Suchet, OBE, CBE, (born 2 May 1946) is an English actor, known for his work on British television.  He is recognized for his RTS- and BPG award-winning performance as Augustus Melmotte in the 2001 British TV mini-drama “The Way We Live Now”, alongside Matthew Macfadyen and Paloma Baeza, and a 1991 British Academy Television Award (BAFTA) nomination.  He is known for his role as Agatha Christie's great detective Hercule Poirot in the long-running British TV dramatic series “Poirot”...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4X4TT8Uf8mAmRIYgYh4EeR4mWva.jpg", url:"https://themoviedb.org/person/20277"}}, {tmdbId:"6012", properties:{bornIn:"Algiers, Alger, France [now Algeria]", imdbId:"0000809", born:date('1950-01-24'), name:"Daniel Auteuil", bio:"From Wikipedia, the free encyclopedia\n\nDaniel Auteuil (born 24 January 1950) is a French actor.  His starring role in Jean de Florette brought him international recognition, and he has since become one of the best-known, best-paid and most popular actors in France.  Through films such as Caché, Mon meilleur ami, Le bossu and Après vous. . . , he has since gained greater international recognition...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5asrvkdSnlYlHap3ldDNyE5opeI.jpg", url:"https://themoviedb.org/person/6012"}}, {tmdbId:"38351", properties:{imdbId:"0220015", born:date('1941-08-05'), name:"Elisabeth Depardieu", url:"https://themoviedb.org/person/38351"}}, {tmdbId:"114628", properties:{imdbId:"0425944", name:"Pat E. Johnson", url:"https://themoviedb.org/person/114628"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"536274", properties:{bornIn:"Yorkshire, England, UK", imdbId:"0254590", born:date('1956-01-01'), name:"Peter Elliott", bio:"Peter Elliott is a British film and television actor and choreographer, best known for frequently portraying an ape or an ape like creature...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4e8mmFJ3BiMtcDFpbi3XQ2crB1G.jpg", url:"https://themoviedb.org/person/536274"}}, {tmdbId:"207309", properties:{imdbId:"0947964", name:"George Antoni", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cvLWl0uSFMX79ZCUW6WFODgb5B7.jpg", url:"https://themoviedb.org/person/207309"}}, {tmdbId:"68794", properties:{bornIn:"London - England - UK", imdbId:"0296614", born:date('1984-06-27'), name:"Toby Froud", url:"https://themoviedb.org/person/68794"}}, {tmdbId:"68795", properties:{bornIn:"Calgary, Canada", imdbId:"0860712", born:date('1959-03-09'), name:"Shelley Thompson", bio:"Shelley Thompson is a Canadian actress best known for her character Barbara Lahey on the hit Canadian mockumentary program Trailer Park Boys.  Born in Calgary, Alberta, Shelley trained at RADA in London, and worked for many years in the UK...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j7iDsBO46wsR7ZDxo305fcpk6fi.jpg", url:"https://themoviedb.org/person/68795"}}, {tmdbId:"1283", properties:{bornIn:"Golders Green, London, England, UK", imdbId:"0000307", born:date('1966-05-26'), name:"Helena Bonham Carter", bio:"Helena Bonham Carter (born 26 May 1966) is an English actress of film, stage, and television.  She made her film debut in K.  M.  Peyton's A Pattern of Roses before winning her first leading role as the titular character in Lady Jane.  She is known for her roles in films such as A Room with a View, Fight Club, and the Harry Potter series, as well as for frequently collaborating with director Tim Burton, her domestic partner since 2001...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mW1NolxQmPE16Zg6zuWyZlFgOwL.jpg", url:"https://themoviedb.org/person/1283"}}, {tmdbId:"2130", properties:{bornIn:"London - England - UK", imdbId:"0000144", born:date('1962-10-26'), name:"Cary Elwes", bio:"Cary Elwes is the third son born to interior designer/shipping heiress Tessa Kennedy and the late portrait painter Dominick Elwes, and is the brother of producer/agent Cassian Elwes and artist Damian Elwes.  He was born and raised in London and attended Harrow.  After graduating from Harrow, he moved to the US and studied drama at Sarah Lawrence College.  He left school after two years to begin his film career...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dYZIhy06ItkB9tP02V07MnmekQ8.jpg", url:"https://themoviedb.org/person/2130"}}, {tmdbId:"1227338", properties:{bornIn:"Detroit, MI", imdbId:"0835925", born:date('1936-06-06'), name:"Levi Stubbs", bio:"Levi Stubbs was born on June 6, 1936 in Detroit, Michigan, USA as Levi Stubbles.  He was an actor, known for Little Shop of Horrors (1986), Captain N: The Game Master (1989) and Queer as Folk (2000).  He was married to Clineice Townsend.  He died on October 17, 2008 in Detroit...", died:date('2008-10-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a1dZspdZRA3EeRJ1O8ySmCEWfxQ.jpg", url:"https://themoviedb.org/person/1227338"}}, {tmdbId:"13420", properties:{bornIn:"Brooklyn, New York, U.S.", imdbId:"0338746", born:date('1951-02-22'), name:"Ellen Greene", bio:"​From Wikipedia, the free encyclopedia.   \n\nEllen Greene (born February 22, 1951) is an American singer and actress.  Greene has had a long and varied career as a singer, particularly in cabaret, as an actor and singer in numerous stage productions, particularly musical theatre, as well as having performed in many films (notably in Little Shop of Horrors) and television programs.  She starred as Vivian Charles on the ABC series Pushing Daisies...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nJzE8dS38hxbALr5LZ88BYt8dm0.jpg", url:"https://themoviedb.org/person/13420"}}, {tmdbId:"67689", properties:{bornIn:"Hong Kong, China", imdbId:"0848355", born:date('1950-08-23'), name:"Alan Tam", bio:"Alan Tam Wing-lun[5] MH (traditional Chinese: 譚詠麟; simplified Chinese: 谭咏麟; pinyin: Tán Yǒnglín; Cantonese Yale: Taam4 Wing6leon4; born 23 August 1950) is a Hong Kong singer and actor.  He played a major role in developing the Cantopop scene in the 1980s as he was known for singing romantic ballads with modern arrangements...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ntWCGdmNQmVs99p0T8vtt3KIT0d.jpg", url:"https://themoviedb.org/person/67689"}}, {tmdbId:"65987", properties:{bornIn:"Hong Kong, British Crown Colony [now China]", imdbId:"0263851", born:date('1962-09-24'), name:"Rosamund Kwan", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pfXHJlVErmt83vfG8iit5lissxs.jpg", url:"https://themoviedb.org/person/65987"}}, {tmdbId:"67690", properties:{bornIn:"Alicante, Spain", imdbId:"0286499", born:date('1960-06-06'), name:"Lola Forner", bio:"Lola Forner is a Spanish actress.  She was crowned Miss Spain in 1979 and competed in Miss World 1979 and Miss Europe 1980.  She is more known to the world for starring alongside action superstar Jackie Chan in the movies Wheels on Meals and Armour of God...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9AFUO0mRgEAoK4v2znjqYvvEdEn.jpg", url:"https://themoviedb.org/person/67690"}}, {tmdbId:"55277", properties:{bornIn:"San Francisco - California - USA", imdbId:"0005489", born:date('1967-11-08'), name:"Courtney Thorne-Smith", bio:"From Wikipedia, the free encyclopedia. \n\nCourtney Thorne-Smith (born November 8, 1967, height 5' 6\" (1,68 m)) is an American actress.  She is best known for her roles as Alison Parker on Melrose Place, Georgia Thomas on Ally McBeal, and Cheryl Mabel in According to Jim, as well as her recurring role in Two and a Half Men as Lyndsey McElroy. \n\nShe was born in San Francisco, California, and grew up in Menlo Park, a suburb south of San Francisco...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/32QJmSbDsyoiCu2cpyyebdcH4Nv.jpg", url:"https://themoviedb.org/person/55277"}}, {tmdbId:"11148", properties:{bornIn:"Rochelle, Illinois, USA", imdbId:"0000260", born:date('1956-08-20'), name:"Joan Allen", bio:"Joan Allen (born August 20, 1956) is an American actress.  She worked in theatre, television and film during her early career, and achieved recognition for her Broadway debut in Burn This, winning a Tony Award for Best Performance by a Leading Actress in a Play in 1989. \n\nShe has received three Academy Award nominations; she was nominated for Best Supporting Actress for Nixon (1995) and The Crucible (1996), and for Best Actress for The Contender (2000)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4VGlW2lHwTfmV7PX01gGPK5XaSz.jpg", url:"https://themoviedb.org/person/11148"}}, {tmdbId:"1248", properties:{bornIn:"Dundee, Scotland, UK", imdbId:"0004051", born:date('1946-06-01'), name:"Brian Cox", bio:"​Brian Denis Cox, CBE (born 1 June 1946) is a Scottish actor.  He is known for his work with the Royal Shakespeare Company, where he gained recognition for his portrayal of King Lear.  He has also appeared in many Hollywood productions playing parts such as Dr.  Guggenheim in Rushmore and William Stryker in X2.  He was the first actor to portray Hannibal Lecter on film in the 1986 production Manhunter...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zNWIyHnNTyfwfWmxeo8QEh33Ar5.jpg", url:"https://themoviedb.org/person/1248"}}, {tmdbId:"4885", properties:{bornIn:"Gassin, France", imdbId:"0000322", born:date('1963-08-14'), name:"Emmanuelle Béart", bio:"Emmanuelle Béart is a French film actress, who has appeared in over 50 film and television productions since 1972.  Béart won a César Award for Best Supporting Actress in the film Manon des Sources (1986).  She has been nominated a further seven times for Most Promising Actress and Best Actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yPEWzvYnPsOy2BSDgMrhrQsIh0N.jpg", url:"https://themoviedb.org/person/4885"}}, {tmdbId:"23388", properties:{bornIn:"Boulogne-Billancourt, Hauts-de-Seine, France", imdbId:"0320762", born:date('1955-10-10'), name:"Hippolyte Girardot", bio:"From Wikipedia, the free encyclopedia.   Hippolyte Girardot (real name Frédéric, born 10 October 1955 in Boulogne-Billancourt, Hauts-de-Seine) is a French actor. \n\nHe is not related to the actress Annie Girardot. \n\nDescription above from the Wikipedia article  Hippolyte Girardot, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cYIjtenMtfDlTj1OiB6xcXULYkG.jpg", url:"https://themoviedb.org/person/23388"}}, {tmdbId:"42123", properties:{bornIn:"Barcelona, Barcelona, Catalonia, Spain", imdbId:"0785264", born:date('1957-09-16'), name:"Assumpta Serna", bio:"Assumpta Serna (born 16 September 1957) is a Spanish actress.  She is known for her roles in I, The Worst of All portraying famous Mexican religious scholar Sor Juana, Nostradamus, The Craft, and Wild Orchid, although she may be most remembered for her role as Peninsular War guerrilla commander Teresa Moreno in the first four of the ITV Richard Sharpe series of films based on the novels of Bernard Cornwell.  Serna was born as Assumpta Rodés Serna in Barcelona, Catalonia (Spain)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/27ZaVfckJ6MjUqGSKU5jVYkvgte.jpg", url:"https://themoviedb.org/person/42123"}}, {tmdbId:"34795", properties:{imdbId:"0555260", name:"Nacho Martínez", url:"https://themoviedb.org/person/34795"}}, {tmdbId:"53655", properties:{bornIn:"Barcelona, Catalonia, Spain", imdbId:"0167938", born:date('1967-04-26'), name:"Eva Cobo", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5fgkLGwnhy08xyw2CvmtVwG63Bg.jpg", url:"https://themoviedb.org/person/53655"}}, {tmdbId:"17769", properties:{bornIn:"Ann Arbor, Michigan, USA", imdbId:"0364307", born:date('1958-04-29'), name:"Laura Harrington", bio:"Laura Harrington is an American actress.  She made her film debut in Jan Egleson's cult classic  \"The Dark End of the Street\" (1981)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wuH8xmx46TJjRdezeXinKsiT6tR.jpg", url:"https://themoviedb.org/person/17769"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"5586", properties:{bornIn:"Paris, France", imdbId:"0810379", born:date('1964-07-03'), name:"Yeardley Smith", bio:"Yeardley Smith (born July 3, 1964) is a French-born American actress, voice artist, writer and painter.  She is best known for her long-running role as Lisa Simpson on The Simpsons...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9AjPwbb3uz4GfgOPBYsy2ILvwkB.jpg", url:"https://themoviedb.org/person/5586"}}, {tmdbId:"40008", properties:{bornIn:"Buncrana, County Donegal, Ireland", imdbId:"0564044", born:date('1926-03-30'), name:"Ray McAnally", bio:"Ray McAnally  was an Irish actor famous for his performances in films such as The Mission, My Left Foot, and A Very British Coup...", died:date('1989-06-15'), url:"https://themoviedb.org/person/40008"}}, {tmdbId:"61840", properties:{bornIn:"Kingston-upon-Thames, London, England", imdbId:"0879154", born:date('1965-06-12'), name:"Cathy Tyson", bio:"​From Wikipedia, the free encyclopedia.   \n\nCatherine \"Cathy\" Tyson (born 12 June 1965 in Kingston-upon-Thames, London) is an English stage, film and television actress. \n\nDescription above from the Wikipedia article  Cathy Tyson, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/49Vx34lPayMudIqBPizXFEisL9y.jpg", url:"https://themoviedb.org/person/61840"}}, {tmdbId:"1923", properties:{bornIn:"Rutherglen, Lanarkshire, Scotland, UK", imdbId:"0001059", born:date('1950-03-30'), name:"Robbie Coltrane", bio:"Robbie Coltrane, is a Scottish actor, comedian and author.  He is known both for his role as Dr Eddie \"Fitz\" Fitzgerald in the British TV series Cracker and as Rubeus Hagrid in the Harry Potter films. \n\nColtrane was born Anthony Robert McMillan in Rutherglen, South Lanarkshire, the son of Jean McMillan Ross, a teacher and pianist, and Ian Baxter McMillan, a general practitioner who also served as a forensic police surgeon.  He has an older sister, Annie, and a late younger sister, Jane...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jOHs3xvlwRiiG2CLtso5zzmGCXg.jpg", url:"https://themoviedb.org/person/1923"}}, {tmdbId:"7674", properties:{bornIn:"Sakhalin, RSFSR, USSR [now Russia]", imdbId:"0324231", born:date('1949-11-28'), name:"Alexander Godunov", bio:"Alexander Godunov was a Russian-American ballet dancer and film actor, whose defection caused a diplomatic incident between the USA and the USSR...", died:date('1995-05-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ubA1t1Rj3dpDZkgli5D17Py0OPh.jpg", url:"https://themoviedb.org/person/7674"}}, {tmdbId:"33688", properties:{imdbId:"0730959", born:date('1929-03-01'), name:"Conrad Roberts", bio:"​From Wikipedia, the free encyclopedia\n\nRobert Conrad (born March 1, 1929; according to court documents) is an American actor.  He is best known for his role in the 1965 CBS television series The Wild Wild West, in which he played the sophisticated Secret Service agent James T.  West, and his portrayal of World War II ace Pappy Boyington in the television series Baa Baa Black Sheep.  He was a recording artist of pop/rock songs in the early 1960s as Bob Conrad before he started acting...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iKm5u3gADmcDAHMTQf96uWpDnZL.jpg", url:"https://themoviedb.org/person/33688"}}, {tmdbId:"11856", properties:{bornIn:"Greenwich, London, England, UK", imdbId:"0000358", born:date('1957-04-29'), name:"Daniel Day-Lewis", bio:"Daniel Michael Blake Day-Lewis (born 29 April 1957) is an English actor with both British and Irish citizenship.  His portrayals of Christy Brown in My Left Foot (1989), Daniel Plainview in There Will Be Blood (2007) and Abraham Lincoln in Lincoln (2012) won Academy and BAFTA Awards for Best Actor, and Screen Actors Guild as well as Golden Globe Awards for There Will Be Blood and Lincoln...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9HI2GTfIKuT628XPK5d1AEteR05.jpg", url:"https://themoviedb.org/person/11856"}}, {tmdbId:"26863", properties:{bornIn:"Farnborough, Kent, United Kingdom", imdbId:"0334262", born:date('1960-05-10'), name:"Richard Graham", bio:"​From Wikipedia, the free encyclopedia\n\nRichard Graham (born May 10 1960 in Farnborough, Kent, United Kingdom) is an actor.  He is mostly known for his roles opposite Leonardo DiCaprio in Titanic and Gangs Of New York (2002), as well as playing Trevor in the football hooligan film I. D.  (1994). \n\nHe has appeared in many television series, including all 12 episodes of Maisie Raine as D. S.  Mickey Farrel, and most recently has been cast in Hollyoaks as William Alexander...", url:"https://themoviedb.org/person/26863"}}, {tmdbId:"1780824", properties:{name:"Winston Graham", url:"https://themoviedb.org/person/1780824"}}, {tmdbId:"1780825", properties:{name:"Dudley Thomas", url:"https://themoviedb.org/person/1780825"}}, {tmdbId:"30501", properties:{bornIn:"Dublin, Ireland", imdbId:"0565887", born:date('1924-03-08'), name:"Sean McClory", bio:"Sean McClory was born in Dublin, Ireland, but spent his early life in Galway.  He was the son of Hugh Patrick, an architect and civil engineer, and Mary Margaret Ball, who had been a model. \n\nSean decided to become an actor and joined Dublin's renowned Abbey Theater (also known as the National Theater of Ireland, opened in 1904)...", died:date('2003-12-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/t7h4jlPjjuxoLi63ee011gARXdA.jpg", url:"https://themoviedb.org/person/30501"}}, {tmdbId:"35516", properties:{bornIn:"Lebanon, Oregon, USA", imdbId:"0381606", born:date('1940-02-27'), name:"Howard Hesseman", bio:"From Wikipedia, the free encyclopedia. \n\nHoward Hesseman (born February 27, 1940) is an American actor best known for playing disc jockey Johnny Fever on WKRP in Cincinnati and schoolteacher Charlie Moore on Head of the Class...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jHxRcBIa9qgOoIsHgfU4kvCnn97.jpg", url:"https://themoviedb.org/person/35516"}}, {tmdbId:"2224", properties:{bornIn:"New York, New York City, USA", imdbId:"0000225", born:date('1969-08-18'), name:"Christian Slater", bio:"Christian Michael Leonard Slater (born August 18, 1969) is an American actor.  He made his film debut with a small role in The Postman Always Rings Twice before playing a leading role in the 1985 film The Legend of Billie Jean.  He then played a monk's apprentice alongside Sean Connery in The Name of the Rose before gaining recognition for his breakthrough role in the cult film Heathers...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8WMt7s6mjjb59jNO62qaD2IRZwm.jpg", url:"https://themoviedb.org/person/2224"}}, {tmdbId:"2367", properties:{bornIn:"Vienna, Austria", imdbId:"0702818", born:date('1928-10-08'), name:"Helmut Qualtinger", bio:"From Wikipedia, the free encyclopedia\n\nHelmut Qualtinger was born in Vienna, Austria.  He initially studied medicine, but quit university to become a newspaper reporter and film critic for local press, while beginning to write texts for cabaret performances and theater plays.  Qualtinger debuted as an actor at a student theater and attended the Max Reinhardt Seminar as a guest student. \n\nBeginning in 1947, he appeared in cabaret performances...", died:date('1986-09-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e18Fa3En1dpwvWd7tkEHyQxjGZ3.jpg", url:"https://themoviedb.org/person/2367"}}, {tmdbId:"2368", properties:{bornIn:"Riga, Latvian Soviet Socialist Republic, U.S.S.R.", imdbId:"0059946", born:date('1950-08-11'), name:"Elya Baskin", bio:"Baskin was born in Riga, the son of Frieda and Zalman Baskin.   He attended Moscow's prestigious Theatre and Variety Arts College and won a Festival of Young Actors Award at the Moscow Comedy Theatre.  Baskin immigrated to the United States in 1976.   He has built a considerable career in TV and movies, and is often cast as a Russian, due to his ancestry and accent.  He has ultimately become one of the most popular choices whenever a Russian is needed in a TV-episode or a major movie production...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/b8rS9GC18elbuNUZNogE153d47x.jpg", url:"https://themoviedb.org/person/2368"}}, {tmdbId:"83095", properties:{imdbId:"0551185", name:"Steve Marshall", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oWe1EfLeidA4GMDzb5CEogX5zmx.jpg", url:"https://themoviedb.org/person/83095"}}, {tmdbId:"83096", properties:{imdbId:"0926114", born:date('1963-11-11'), name:"Jill Whitlow", bio:"​From Wikipedia, the free encyclopedia. \n\nJill Whitlow  (born 1964) is an American motion picture and television actress who achieved her greatest recognition during the 1980s.  She is best remembered by American audiences for her role in the 1986 cult horror film Night of the Creeps.  She also had small roles in Porky's (1982), Mask (1985), and Weird Science (1985).  She also appeared on a 1984 episode of T. J.  Hooker called \"The Two Faces Of Betsy Morgan\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9zQWlNUBsdl1quRXgXHY0a4y4C0.jpg", url:"https://themoviedb.org/person/83096"}}, {tmdbId:"60700", properties:{bornIn:"Philadelphia, Pennsylvania, USA", imdbId:"0926592", born:date('1950-11-30'), name:"Margaret Whitton", bio:"From Wikipedia, the free encyclopedia\n\nMargaret Whitton (born November 30, 1950) is an American stage, film, and television actress, originally from Philadelphia, Pennsylvania.  Whitton did her primary film work between 1986 and 1993.  Her most visible roles were that of baseball team owner Rachel Phelps in Major League (1989) and its sequel Major League II, and as Michael J.  Fox's vibrant, sexy and underappreciated aunt-by-marriage in The Secret of My Success (1987)...", died:date('2016-12-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/acckB7EG1iYhjtHas0cmEJUvzH9.jpg", url:"https://themoviedb.org/person/60700"}}, {tmdbId:"8875", properties:{bornIn:"New York City - New York - USA", imdbId:"0546868", born:date('1937-02-19'), name:"David Margulies", bio:"David Margulies  is an actor...", died:date('2016-01-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lKXiPu99KCdETOH9XHMgVGg6z8G.jpg", url:"https://themoviedb.org/person/8875"}}, {tmdbId:"10477", properties:{bornIn:"Rosenheim, Germany", imdbId:"0001169", born:date('1945-07-19'), name:"George Dzundza", bio:"George Dzundza (born July 19, 1945) is an American television and film actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z0BI9G0Q617p02dV7q027uuWPD3.jpg", url:"https://themoviedb.org/person/10477"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"517", properties:{bornIn:"Navan, County Meath, Ireland", imdbId:"0000112", born:date('1953-05-16'), name:"Pierce Brosnan", bio:"Pierce Brendan Brosnan, OBE (16 May 1953) is an Irish actor, film producer and environmentalist who holds Irish and American citizenship. \n\nAfter leaving school at 16, Brosnan began training in commercial illustration, but trained at the Drama Centre in London for three years.  Following a stage acting career he rose to popularity in the television series Remington Steele (1982–87).  After Remington Steele, Brosnan took the lead in many films such as Dante's Peak and The Thomas Crown Affair...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dzXVwwJLPwiZeXOnf7YxorqVEEM.jpg", url:"https://themoviedb.org/person/517"}}, {tmdbId:"96090", properties:{bornIn:"Tangiers, Morocco", imdbId:"0600027", born:date('1952-01-01'), name:"Anna Maria Monticelli", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8i5St0OlgtjCgMk2MCbCQgvrGUy.jpg", url:"https://themoviedb.org/person/96090"}}, {tmdbId:"45042", properties:{bornIn:"Marylebone, London, United Kingdom", imdbId:"0001914", born:date('1954-11-03'), name:"Adam Ant", bio:"From Wikipedia, the free encyclopedia. \n\nAdam Ant (born Stuart Leslie Goddard on 3 November 1954 in Marylebone, London) is an English musician who gained popularity as the lead singer of New Wave/post-punk group Adam and the Ants and later as a solo artist, scoring ten UK top ten hits between 1980 and 1983, including three No. 1s.  Ant was also a star in America where he not only scored a string of hit singles and albums, but was once voted sexiest man in America by the viewers of MTV...", url:"https://themoviedb.org/person/45042"}}, {tmdbId:"100055", properties:{bornIn:"Rome, Lazio, Italy", imdbId:"0211281", born:date('1960-08-09'), name:"Barbara De Rossi", bio:"Barbara De Rossi was born on August 9, 1960 in Rome, Lazio, Italy.  She is an actress, known for La piovra (1984), Mamma Ebe (1985) and Hearts and Armour (1983)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kKSnYH89YP3u8a1knJ8ZS4mwtAN.jpg", url:"https://themoviedb.org/person/100055"}}, {tmdbId:"87415", properties:{imdbId:"0281453", born:date('1944-09-21'), name:"Susan Fleetwood", bio:"From Wikipedia, the free encyclopedia\n\nSusan Maureen Fleetwood (21 September 1944 — 29 September 1995) was a British stage, film and television actress, best-known as a star of the classical theatre companies of England.  She received popular acclaim in the television series Chandler &amp; Co and The Buddha of Suburbia. \n\nDescription above from the Wikipedia article Susan Fleetwood, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1995-09-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ww9Xo8KoZUKYiLeniSmC7lvPeUO.jpg", url:"https://themoviedb.org/person/87415"}}, {tmdbId:"3857", properties:{bornIn:"Rödön, Jämtlands län, Sweden", imdbId:"0249735", born:date('1924-08-25'), name:"Allan Edwall", bio:"Johan Allan Edwall was a Swedish stage and screen actor, singer, writer and director.  He graduated from the Royal Dramatic Theatre's  Acting School in 1952. \n\nGrowing up in the landscape of Jämtland, Edwall spent some time working on a ship before he arrived in Stockholm in the 1940s, just barely making a living as a writer, painter and poet before he was admitted to the Royal Dramatic Theater's acting school in 1949...", died:date('1997-02-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tleoCES9SH3D6Z8Vp8PcGzu5Rzt.jpg", url:"https://themoviedb.org/person/3857"}}, {tmdbId:"142878", properties:{imdbId:"0321108", born:date('1954-12-12'), name:"Guðrún Gísladóttir", bio:"Guðrún Gísladóttir is an Islandic stage and screen actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qvPZz1WN5vo4ATvdb3Wto5eKlDA.jpg", url:"https://themoviedb.org/person/142878"}}, {tmdbId:"2492637", properties:{imdbId:"1721070", name:"Linda Warren", url:"https://themoviedb.org/person/2492637"}}, {tmdbId:"155649", properties:{bornIn:"Wilmette, Illinois, USA", imdbId:"0615063", born:date('1963-04-17'), name:"Joel Murray", bio:"Joel is a versatile writer-director-actor.  The youngest of the nine Murrays is a veteran of over 250 sit-com episodes.  He has been a series regular on the comedies Grand, Pacific Station, Love and War, Dharma and Greg and Still Standing.  He has also recurred on the series Mike and Molly, My Boys and Two and a Half Men.  Brother of Bill Murray, John Murray and Brian Doyle-Murray...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xWkvfTlnEVkUrYKQz4ajRjUWyxC.jpg", url:"https://themoviedb.org/person/155649"}}, {tmdbId:"2492672", properties:{imdbId:"0194080", name:"Grenville Cuyler", url:"https://themoviedb.org/person/2492672"}}, {tmdbId:"65827", properties:{bornIn:"Harlem, New York City, New York, USA", imdbId:"0202966", born:date('1956-06-04'), name:"Keith David", bio:"An American film, television, and voice actor, and singer.  He is perhaps most known for his live-action roles in such films as Crash, There's Something About Mary, Barbershop and Men at Work...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jJLJuR7FNHYL1fB5igjj7IXzOel.jpg", url:"https://themoviedb.org/person/65827"}}, {tmdbId:"10086", properties:{bornIn:"San Diego, California, USA", imdbId:"0001576", born:date('1975-12-27'), name:"Heather O'Rourke", bio:"​From Wikipedia, the free encyclopedia\n\nHeather O'Rourke (December 27, 1975 – February 1, 1988) was an American child actress who played Carol Anne Freeling in the Poltergeist film trilogy and made several television guest appearances. \n\nDescription above from the Wikipedia article Heather O'Rourke, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1988-02-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ksRZu1R7NMmhCol43GZytJcYPo.jpg", url:"https://themoviedb.org/person/10086"}}, {tmdbId:"10085", properties:{imdbId:"0732319", born:date('1971-01-01'), name:"Oliver Robins", bio:"​From Wikipedia, the free encyclopedia\n\nOliver Robins (born 1971) is an American former child actor who is now a writer and director.  His first film roles were in the 1982 TV movie Million Dollar Infield, and in the 1982 ABC TV movie Don't Go to Sleep as Kevin.  He is best known for his role as Robbie Freeling in the 1982 movie Poltergeist and in its 1986 sequel Poltergeist II: The Other Side.  Oliver's other feature film role was in the 1982 comedy Airplane II: The Sequel...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ngNOKRpoiHvZXONK2kQjGWPmru5.jpg", url:"https://themoviedb.org/person/10085"}}, {tmdbId:"8873", properties:{bornIn:"Franklin, Kentucky, USA", imdbId:"0001633", born:date('1952-10-28'), name:"Annie Potts", bio:"Annie Potts is an American film and television actress, best known for playing Mary Jo Shively, one of the leading roles in the television sitcom \"Designing Women\", as well as several supporting roles in features films such as \"Ghostbusters\", \"Pretty in Pink\", and \"Jumpin' Jack Flash\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hWIzkAH7jkSkxBfwdudxbSPxeno.jpg", url:"https://themoviedb.org/person/8873"}}, {tmdbId:"20495", properties:{bornIn:"Olean, New York, USA", imdbId:"0001194", born:date('1952-11-29'), name:"Jeff Fahey", bio:"​From Wikipedia, the free encyclopedia.   \n\nJeffrey David \"Jeff\" Fahey (born November 29, 1952) is an American film and television actor.  He has portrayed Captain Frank Lapidus on the ABC series Lost and the title role of Deputy Marshal Winston MacBride on The Marshal...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gT0gViak8wTxmZMPTknRRXX4YCZ.jpg", url:"https://themoviedb.org/person/20495"}}, {tmdbId:"10362", properties:{bornIn:"Ontario, Canada", imdbId:"0561809", born:date('1942-01-01'), name:"Roberta Maxwell", bio:"From Wikipedia, the free encyclopedia\n\nRoberta Maxwell (born 1942) is a Canadian actress. \n\nShe began studying for the stage at the age of 12...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3rWkDAzROb4ludCEXBum6bzmy91.jpg", url:"https://themoviedb.org/person/10362"}}, {tmdbId:"29792", properties:{bornIn:"San Francisco, California", imdbId:"0241232", born:date('1945-06-06'), name:"David Dukes", bio:"​From Wikipedia, the free encyclopedia.   \n\nDavid Coleman Dukes (June 6, 1945 – October 9, 2000) was an American character actor. \n\nDescription above from the Wikipedia article  David Dukes, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2000-10-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uT0eWdpQleUwbhX8wcJBCEjs0h0.jpg", url:"https://themoviedb.org/person/29792"}}, {tmdbId:"5312", properties:{bornIn:"Dublin, Ireland", imdbId:"0640560", born:date('1975-04-19'), name:"Hugh O'Conor", url:"https://themoviedb.org/person/5312"}}, {tmdbId:"26101", properties:{bornIn:"Montreuil - France", imdbId:"0729691", born:date('1956-12-22'), name:"Marie Rivière", bio:"Marie Rivière (born 22 December 1956) is a French actress and filmmaker.  She is known for her collaborations with director Éric Rohmer. \n\nFrom a working-class background, Marie Rivière grew up on a housing estate/project in Montreuil before working as a schoolteacher, then as a shop assistant.  At 21, having seen L'Amour l'après-midi, she sent a letter and photo to Éric Rohmer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8dYXEsV8KwUUa1Zo9hC2gfGdvMW.jpg", url:"https://themoviedb.org/person/26101"}}, {tmdbId:"213560", properties:{imdbId:"0155102", name:"Amira Chemakhi", url:"https://themoviedb.org/person/213560"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"213561", properties:{imdbId:"0724966", name:"Sylvie Richez", url:"https://themoviedb.org/person/213561"}}, {tmdbId:"97082", properties:{bornIn:"Spain", imdbId:"0305324", name:"María Luisa García", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/voGJtPIDYGcFUGtLmC1b9xtICtH.jpg", url:"https://themoviedb.org/person/97082"}}, {tmdbId:"95479", properties:{imdbId:"0138979", born:date('1970-02-09'), name:"Linda Carol", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wK1g9uzek6nazzRhryk2U4x4GJ6.jpg", url:"https://themoviedb.org/person/95479"}}, {tmdbId:"103963", properties:{bornIn:"Webster, New York, USA", imdbId:"0931926", born:date('1949-05-28'), name:"Wendy O. Williams", bio:"From Wikipedia, the free encyclopedia. \n\nWendy Orlean Williams (May 28, 1949 – April 6, 1998), better known as Wendy O.  Williams, was an American singer, songwriter and actress.  Born in Webster, New York, she first came to prominence as the lead singer of the punk rock band Plasmatics.  Her infamous stage theatrics included blowing up equipment, near nudity and chain-sawing guitars...", died:date('1998-04-06'), url:"https://themoviedb.org/person/103963"}}, {tmdbId:"103962", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0039924", born:date('1941-10-21'), name:"Pat Ast", died:date('2001-10-03'), url:"https://themoviedb.org/person/103962"}}, {tmdbId:"29541", properties:{bornIn:"Wels, Upper Austria, Austria", imdbId:"0000356", born:date('1952-05-24'), name:"Sybil Danning", bio:"From Wikipedia, the free encyclopedia. \n\nSybil Danning (born May 24, 1952) is an Austrian actress known for her many roles in B movies, science fiction films, and action films. \n\nDescription above from the Wikipedia article Sybil Danning, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3BIF03EVJMxD7dOPhqlG0Z5RyoI.jpg", url:"https://themoviedb.org/person/29541"}}, {tmdbId:"3126", properties:{bornIn:"Hampstead, London, England, UK", imdbId:"0001746", born:date('1970-09-04'), name:"Ione Skye", bio:"​From Wikipedia, the free encyclopedia\n\nIone Skye Lee ( born Ione Skye Leitch; September 4, 1970) is an English-born American actress, who became a teen idol after the 1989 movie Say Anything. . . .  In 2006 VH1 placed her at number 84 in the \"100 Greatest Teen Stars\" list...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ye8qsi6fn51HW93c7065Jogbh9p.jpg", url:"https://themoviedb.org/person/3126"}}, {tmdbId:"43774", properties:{bornIn:"Bethlehem, Pennsylvania, USA", imdbId:"0736263", born:date('1963-03-04'), name:"Daniel Roebuck", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8HXirDk0o0b3wLdpZSG5tYj6kaT.jpg", url:"https://themoviedb.org/person/43774"}}, {tmdbId:"53510", properties:{bornIn:"Lavia, Finland", imdbId:"0784661", born:date('1954-09-20'), name:"Silu Seppälä", url:"https://themoviedb.org/person/53510"}}, {tmdbId:"4828", properties:{bornIn:"Helsinki, Finland", imdbId:"0475411", born:date('1956-09-06'), name:"Sakari Kuosmanen", bio:"Sakari Jyrki Kuosmanen (born 6 September 1956 in Helsinki) is a Finnish singer and actor.  He has recorded several solo albums and has also done work with Sleepy Sleepers and Leningrad Cowboys.  He appeared as himself on the Finnish television series Aaken ja Sakun kesäkeittiö in 1999. \n\nDescription above from the Wikipedia article Sakari Kuosmanen, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/syM87lzV2IqFno87Za1PbeAUdMW.jpg", url:"https://themoviedb.org/person/4828"}}, {tmdbId:"1303970", properties:{bornIn:"Helsinki, Finland", imdbId:"0374630", born:date('1958-02-03'), name:"Heinäsirkka", died:date('2019-12-07'), url:"https://themoviedb.org/person/1303970"}}, {tmdbId:"106172", properties:{bornIn:"Loimaa, Finland", imdbId:"0885417", born:date('1955-02-21'), name:"Mato Valtonen", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3JFNkSzPjptZ8RUrrjKhtCPEsEt.jpg", url:"https://themoviedb.org/person/106172"}}, {tmdbId:"4761", properties:{bornIn:"Pasadena, California, USA", imdbId:"0283311", born:date('1958-11-25'), name:"Darlanne Fluegel", bio:"​From Wikipedia, the free encyclopedia. \n\nDarlanne Fluegel born in Wilkes-Barre, Pennsylvania on November 25, 1953.   She is an American actress. \n\nFluegel appeared in the TV series Crime Story and the final season of Hunter.  She was featured in Sergio Leone's 1984 film Once Upon a Time in America as Robert De Niro's girlfriend Eve (credited as \"Darlanne Fleugel\"),[1] and in 1986's Tough Guys as Kirk Douglas' girlfriend.  In 1985 she appeared in To Live And Die In L. A...", died:date('2017-12-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hZRScPLpN3KpFtWBsIq5NGPhNBQ.jpg", url:"https://themoviedb.org/person/4761"}}, {tmdbId:"10983", properties:{bornIn:"Thornaby-on-Tees, North Yorkshire, England, UK", imdbId:"0341743", born:date('1947-07-31'), name:"Richard Griffiths", bio:"Richard Griffiths is an English actor of stage, film and television.  He has received the Laurence Olivier Award for Best Actor, the Drama Desk Award for Outstanding Actor in a Play, the Outer Critics Circle Award for Best Featured Actor in a Play, and the Tony Award for Best Performance by a Leading Actor in a Play, all for his role in the play The History Boys...", died:date('2013-03-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3xJvWe2qoWJZUQ3BdWdZdMT4CvB.jpg", url:"https://themoviedb.org/person/10983"}}, {tmdbId:"99358", properties:{bornIn:"Queens, New York USA", imdbId:"0424370", born:date('1963-04-12'), name:"Tracy Camilla Johns", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fXjcnepCTGfd0bJJs6O2XieCgCP.jpg", url:"https://themoviedb.org/person/99358"}}, {tmdbId:"99359", properties:{bornIn:"Tokyo, Japan", imdbId:"0382975", born:date('1962-05-31'), name:"Tommy Redmond Hicks", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jx7MpUfQ8zyLnNLjvIACxMDLiEs.jpg", url:"https://themoviedb.org/person/99359"}}, {tmdbId:"1341524", properties:{name:"John Canada Terrell", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mHxeuXRSOsrZO2rlDPgAp4UMLDC.jpg", url:"https://themoviedb.org/person/1341524"}}, {tmdbId:"1295142", properties:{imdbId:"3344839", name:"Dede McElwee", url:"https://themoviedb.org/person/1295142"}}, {tmdbId:"1295143", properties:{imdbId:"3980965", name:"Ross McElwee Jr.", url:"https://themoviedb.org/person/1295143"}}, {tmdbId:"1295144", properties:{imdbId:"0719366", name:"Patricia Rendleman", url:"https://themoviedb.org/person/1295144"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"6168", properties:{bornIn:"Warren, Ohio, U.S.", imdbId:"0671721", born:date('1940-03-27'), name:"Austin Pendleton", bio:"An American film, television, and stage actor, a playwright, and a theater director and instructor. \n\nDescription above from the Wikipedia article Austin Pendleton, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jXa5k21yl8Z2GkG69hJ0KS0Lq9j.jpg", url:"https://themoviedb.org/person/6168"}}, {tmdbId:"43476", properties:{bornIn:"Greenwich Village, New York, USA", imdbId:"0916050", born:date('1956-06-25'), name:"Chloe Webb", bio:"Chloe Webb (born June 25, 1956) is an American actress. \n\nWebb was born in Greenwich Village, Manhattan, New York.  Her New York theater debut was in the original cast of the long-running musical satire Forbidden Broadway.  She received Best Actress award from the National Society of Film Critics for her film debut in the 1986 cult classic feature film Sid and Nancy, which was based on the relationship of the Sex Pistols bassist, Sid Vicious, and his girlfriend Nancy Spungen...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7ylnbM8jTG0WQ3oFFaG0VuEJxnb.jpg", url:"https://themoviedb.org/person/43476"}}, {tmdbId:"54014", properties:{bornIn:"Bridgeton, Glasgow, Scotland, UK", imdbId:"0371342", born:date('1948-02-09'), name:"David Hayman", bio:"​David Hayman (born 9 February 1948) is a Scottish film and television actor and director, best known for his role as DCS Mike Walker in the ITV drama Trial and Retribution...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wu0P60ogVCrJrK4U2B8RjiAo5eL.jpg", url:"https://themoviedb.org/person/54014"}}, {tmdbId:"142844", properties:{imdbId:"0084033", name:"Debby Bishop", bio:"Debby Bishop is a British film and television actress, best known for her appearance in the second series of the crime drama Widows, as well as the feature films Scrubbers (1983) and Sid and Nancy (1986)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3N4uQNLgTKAWpIRANTZXmFi3Xqc.jpg", url:"https://themoviedb.org/person/142844"}}, {tmdbId:"1144716", properties:{imdbId:"0642092", name:"Angela O'Neill", url:"https://themoviedb.org/person/1144716"}}, {tmdbId:"1062087", properties:{imdbId:"0551531", name:"Wendy Martel", url:"https://themoviedb.org/person/1062087"}}, {tmdbId:"1144717", properties:{imdbId:"0743732", name:"Pamela Ross", url:"https://themoviedb.org/person/1144717"}}, {tmdbId:"1144718", properties:{imdbId:"0727810", name:"Nicole Rio", url:"https://themoviedb.org/person/1144718"}}, {tmdbId:"72028", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0343325", born:date('1960-03-17'), name:"Arye Gross", bio:"Arye Gross, born March 17, 1960, is an American actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7pNNrW5JGpHt2tJeXPOSB3BLzeX.jpg", url:"https://themoviedb.org/person/72028"}}, {tmdbId:"11164", properties:{bornIn:"Honolulu, Hawaii, USA", imdbId:"0000593", born:date('1962-10-13'), name:"Kelly Preston", bio:"Kelly Preston (October 13, 1962 – July 12, 2020) was an American actress and former model.  She appeared in more than sixty television and film productions, most notably including Mischief, Twins and Jerry Maguire.  She was married to John Travolta, with whom she collaborated on the fantasy film Battlefield Earth.  She also starred in the films The Cat in the Hat, Old Dogs, and Broken Bridges...", died:date('2020-07-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kEBLn0igo3OcNgXQ6cpoPTEaIUv.jpg", url:"https://themoviedb.org/person/11164"}}, {tmdbId:"3033", properties:{bornIn:"Burbank, California, USA", imdbId:"0000696", born:date('1972-07-29'), name:"Wil Wheaton", bio:"Richard William \"Wil\" Wheaton III (born July 29, 1972) is an American actor and writer.  As an actor, he is best known for his portrayals of Wesley Crusher on the television series Star Trek: The Next Generation, Gordie LaChance in the film Stand by Me and Joey Trotta in Toy Soldiers.  As a writer, he is best known for his blog, Wil Wheaton Dot Net. \n\nDescription above from the Wikipedia article Wil Wheaton, licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yqEW17L7Fdg2RDRLLo4SqRHkjyw.jpg", url:"https://themoviedb.org/person/3033"}}, {tmdbId:"3035", properties:{bornIn:"New York City, New York, USA", imdbId:"0005278", born:date('1974-02-17'), name:"Jerry O'Connell", bio:"Jerry O’Connell (born February 17, 1974) is an American actor, best known for his roles on the TV series Sliders and Crossing Jordan as the films Stand by Me and Kangaroo Jack...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4WkOu9MUuPylWv3G5AFEIzvjKSx.jpg", url:"https://themoviedb.org/person/3035"}}, {tmdbId:"70627", properties:{bornIn:"Otaru, Hokkaido Prefecture, Japan", imdbId:"0594421", born:date('1945-03-27'), name:"Nobuko Miyamoto", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7Ikc4hr7n8eRGGBMkirZWvTagRs.jpg", url:"https://themoviedb.org/person/70627"}}, {tmdbId:"18056", properties:{bornIn:"Isahaya, Nagasaki Prefecture, Japan", imdbId:"0945131", born:date('1956-01-01'), name:"Kôji Yakusho", bio:"Kōji Yakusho (役所 広司 Yakusho Kōji, born January 1, 1956) is a Japanese actor. \n\nDescription above from the Wikipedia article Kôji Yakusho, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/m4ZorHOhhRiiW0h2xDkHhiYm3yj.jpg", url:"https://themoviedb.org/person/18056"}}, {tmdbId:"3899", properties:{bornIn:"Koide, Niigata, Japan", imdbId:"0913822", born:date('1959-10-21'), name:"Ken Watanabe", bio:"Ken Watanabe (born October 21, 1959) is a Japanese stage, film, and television actor.  To English-speaking audiences he is known for playing tragic hero characters, such as General Tadamichi Kuribayashi in Letters from Iwo Jima and Lord Katsumoto Moritsugu in The Last Samurai, for which he was nominated for the Academy Award for Best Supporting Actor.  Among other awards, he has won the Japan Academy Prize for Best Actor twice, in 2007 for Memories of Tomorrow and in 2010 for Shizumanu Taiyō...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/psAXOYp9SBOXvg6AXzARDedNQ9P.jpg", url:"https://themoviedb.org/person/3899"}}, {tmdbId:"10690", properties:{bornIn:"Winnipeg, Manitoba, Canada ", imdbId:"0001593", born:date('1982-07-24'), name:"Anna Paquin", bio:"Anna Hélène Paquin (born 24 July 1982) is a New Zealand-Canadian actress.  She was born in Manitoba and brought up in Wellington, New Zealand, before moving to Los Angeles during her youth.  She completed a year at Columbia University, before leaving to focus on her acting career.  As a child, she played the role of Flora McGrath in Jane Campion's romantic drama film The Piano (1993), despite having had little acting experience...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5FjBCsn3kujldP8LizoCrc3hsHp.jpg", url:"https://themoviedb.org/person/10690"}}, {tmdbId:"19210", properties:{bornIn:"Cheshire, Connecticut, USA", imdbId:"0004735", born:date('1977-03-08'), name:"James Van Der Beek", bio:"James Van Der Beek (born March 8, 1977) is an American actor, known for Dawson's Creek...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5CzRqYzRMNevIu6rB8gUFKpsKZL.jpg", url:"https://themoviedb.org/person/19210"}}, {tmdbId:"86923", properties:{bornIn:"Texas, USA", imdbId:"0930226", born:date('1957-03-27'), name:"Caroline Williams", bio:"From Wikipedia, the free encyclopedia  Leah Caroline Williams (born 27 March 1957) is an American actress.   Description above from the Wikipedia article Caroline Williams, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/m6FRiLEHlDw1pDkzreBUCd0YJiA.jpg", url:"https://themoviedb.org/person/86923"}}, {tmdbId:"104014", properties:{bornIn:"Cheyenne, Wyoming, USA", imdbId:"0796842", born:date('1920-06-12'), name:"Jim Siedow", bio:"James Nash \"Jim\" Siedow (Born, June 12, 1920 - November 20, 2003 ) was an American actor, best known for his role of Drayton \"The Cook\" Sawyer in The Texas Chain Saw Massacre and its sequel The Texas Chainsaw Massacre 2. \n\n Siedow was born in Cheyenne, Wyoming.  He began acting in his high school drama class, and later on, moved to New York City, New York, where he started appearing in theatre productions...", died:date('2003-11-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1VyuXh0j36fDAz9E1oLYJiA8JkL.jpg", url:"https://themoviedb.org/person/104014"}}, {tmdbId:"27737", properties:{bornIn:"Barrington, Illinois, USA", imdbId:"0608405", born:date('1951-11-11'), name:"Bill Moseley", bio:"From Wikipedia, the free encyclopedia\n\nWilliam \"Bill\" Moseley (born November 11, 1951) is an American film actor and musician who has starred in a number of cult classic horror films, including House of 1000 Corpses, Repo! The Genetic Opera and The Devil's Rejects.  His first big role was in The Texas Chainsaw Massacre 2 as Chop Top.  He has also released records with guitarist Buckethead, in the band Cornbugs...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l2ksJH5uUCIaeTuier6wXrURrnv.jpg", url:"https://themoviedb.org/person/27737"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"519", properties:{bornIn:"Hamilton, Ontario, Canada", imdbId:"0001737", born:date('1950-03-26'), name:"Martin Short", bio:"From Wikipedia, the free encyclopedia. \n\nMartin Hayter Short, CM (born March 26, 1950) is a Canadian comedian, actor, writer, singer and producer.  He is best known for his comedy work, particularly on the TV programs SCTV and Saturday Night Live.  He has also starred in many popular comedic films such as Three Amigos, Innerspace, Pure Luck, Jungle 2 Jungle, Mars Attacks!, Father of the Bride, and Father of the Bride Part 2...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3bNEYDwMWrJeOpX1huLlKK48QnO.jpg", url:"https://themoviedb.org/person/519"}}, {tmdbId:"7139", properties:{bornIn:"Forth Worth, Texas, USA", imdbId:"0017491", born:date('1924-09-13'), name:"Norman Alden", died:date('2012-07-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/b9DgjOXgwSFLDbTT5DhAFPDGlxe.jpg", url:"https://themoviedb.org/person/7139"}}, {tmdbId:"19545", properties:{bornIn:"Modesto, California", imdbId:"0029460", born:date('1930-10-24'), name:"Jack Angel", bio:"Jack Angel was born on October 24, 1930 in Modesto, California, USA as Jack T.  Angel.  He is known for his work on A. I.  Artificial Intelligence (2001), Toy Story (1995), and Treasure Planet (2002).  He has been married to Arlene Thornton since 1984.  They have three children.  He was previously married to Barbara Champion...", url:"https://themoviedb.org/person/19545"}}, {tmdbId:"19546", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0068407", born:date('1938-07-30'), name:"Michael Bell", bio:"Michael Bell is an American actor and voice actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qZrtEHcKOFCbxtSedcdTU8f2uyW.jpg", url:"https://themoviedb.org/person/19546"}}, {tmdbId:"19547", properties:{bornIn:"Saint Louis, Missouri, USA", imdbId:"0074185", born:date('1950-12-10'), name:"Gregg Berger", bio:"From Wikipedia, the free encyclopedia. \n\nGreggory \"Gregg\" Berger (born December 10, 1950) is an American voice actor, who is known for his iconic role as Odie from the Garfield franchise...", url:"https://themoviedb.org/person/19547"}}, {tmdbId:"93796", properties:{bornIn:"New Jersey - USA", imdbId:"0697027", born:date('1968-02-23'), name:"Marc Price", bio:"​Marc Price (born February 23, 1968) is a television actor, primarily known for his role as Irwin \"Skippy\" Handelman on \"Family Ties. \" Price also played Eddie \"Ragman\" Weinbauer in the 1986 cult horror film \"Trick or Treat\" and appeared in the 1988 action-adventure film \"The Rescue\" with Kevin Dillon.   He hosted the children's game show \"Teen Win, Lose or Draw\" on The Disney Channel from 1989 to 1992 and later produced the short-lived TBS interactive game show \"Midnight Money Madness\" in 2006...", url:"https://themoviedb.org/person/93796"}}, {tmdbId:"93795", properties:{bornIn:"Stafford, Kansas, USA", imdbId:"0276363", born:date('1958-12-28'), name:"Tony Fields", bio:"Tony took the last name of Fields from his stepfather Max.  Tony's  parents divorced when he was four.  Although he was born in Stafford,  Kansas, he moved to Davis, California, where his career began in  gymnastics.  He switched to dance training when he won scholarships to  the Pacific Conservatory of the Performing Arts (studying drama and  voice), and also at Roland Dupree Academy of Dance. \n\nHe began  touring with Debbie Reynolds in her nightclub act only 3 months after  starting at Dupree...", died:date('1995-02-27'), url:"https://themoviedb.org/person/93795"}}, {tmdbId:"1076524", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0649793", born:date('1963-07-31'), name:"Lisa Orgolini", url:"https://themoviedb.org/person/1076524"}}, {tmdbId:"14737", properties:{bornIn:"Burbank, California, USA", imdbId:"0767443", born:date('1964-06-21'), name:"Doug Savant", bio:"Doug Savant (born June 21, 1963) is an American actor.  He is best known for his roles on Melrose Place and Desperate Housewives...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fvbOI31a6KM37M0buVE8wW2HObx.jpg", url:"https://themoviedb.org/person/14737"}}, {tmdbId:"29509", properties:{bornIn:"Los Angeles, California, U.S.A.", imdbId:"0000441", born:date('1971-11-13'), name:"Noah Hathaway", bio:"From Wikipedia, the free encyclopedia. \n\nNoah Leslie Hathaway (born November 13, 1971 in Los Angeles, California) is an American former child actor.  He is best known for his role as Atreyu in 80s film The Neverending Story and for portraying Boxey on the original TV Series Battlestar Galactica. \n\nDescription above from the Wikipedia article Noah Hathaway, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/29509"}}, {tmdbId:"3665", properties:{bornIn:"Greenwich, Connecticut, USA", imdbId:"0352379", born:date('1947-07-06'), name:"Shelley Hack", bio:"Shelley Hack (born July 6, 1947) is an  American model, actress, producer, and political and media adviser...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/r3HYbOAtto526o3GlgVMRLdOmNe.jpg", url:"https://themoviedb.org/person/3665"}}, {tmdbId:"150216", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0065172", born:date('1974-08-03'), name:"Jenny Beck", bio:"Jenny Beck is an American actress best known for playing a young Elizabeth on V: The Final Battle and V: The Series (episode 1).  Her other well-known television role was on Paradise as Claire Carroll. \n\nShe received three consecutive Young Artist Award nominations, 1989 to 1991, Best Young Actress Starring in a Television Series, for her role in Paradise.  She had roles in three feature films, Tightrope (1984), The Canterville Ghost (1985) and Troll (1986)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/t8gRoEtCUEwme5xsHDM6vu2LHqx.jpg", url:"https://themoviedb.org/person/150216"}}, {tmdbId:"1230", properties:{bornIn:"St. Louis, Missouri, USA", imdbId:"0000422", born:date('1952-06-20'), name:"John Goodman", bio:"John Goodman is an American stage, film and television actor, best known for his role as Dan Conner on the television series Roseanne, and the hugely popular feature film The Big Lebowski...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yyYqoyKHO7hE1zpgEV2XlqYWcNV.jpg", url:"https://themoviedb.org/person/1230"}}, {tmdbId:"71561", properties:{imdbId:"0020658", name:"Jo Harvey Allen", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/76jMNv4JR13K3bZxGhrB0q1Q2lG.jpg", url:"https://themoviedb.org/person/71561"}}, {tmdbId:"91332", properties:{bornIn:"Midway City, California, U.S.", imdbId:"0679410", born:date('1964-01-01'), name:"Dedee Pfeiffer", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5qEwnlKS2uapYYBca4VypL2K2JQ.jpg", url:"https://themoviedb.org/person/91332"}}, {tmdbId:"78305", properties:{imdbId:"0446120", born:date('1916-06-03'), name:"John Kellogg", died:date('2000-02-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/asGID6iV64631Z5hSvyXimOMTuV.jpg", url:"https://themoviedb.org/person/78305"}}, {tmdbId:"12967", properties:{bornIn:"Omaha, Nebraska, USA", imdbId:"0001436", born:date('1944-09-06'), name:"Swoosie Kurtz", bio:"Swoosie Kurtz (born September 6, 1944) is an American actress.  She began her career in theater during the 1970s and shortly thereafter began a career in television, garnering ten nominations and winning one Emmy Award.  Her most famous television project was her role on the 1990s NBC drama Sisters.  She has also appeared somewhat sporadically in films from the late 1970s up until today, including prominent roles in such films as Dangerous Liaisons, Citizen Ruth, and Liar Liar among others...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sISOxpV6zn3EfC5uKVsX7s9xLBf.jpg", url:"https://themoviedb.org/person/12967"}}, {tmdbId:"15905", properties:{bornIn:"Powder Springs, Georgia, USA", imdbId:"0001477", born:date('1972-02-07'), name:"Robyn Lively", bio:"Robyn Elaine Lively (born February 7, 1972) is an American actress.  Lively is best known for her role in the film Teen Witch, as well as for her roles in the TV shows Doogie Howser, M. D. , Twin Peaks, and Saving Grace. \n\nDescription above from the Wikipedia article Robyn Lively, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vyPSwQJ7WKXYDFuPJnkEQdXmttI.jpg", url:"https://themoviedb.org/person/15905"}}, {tmdbId:"1242279", properties:{imdbId:"0324937", name:"Brandy Gold", url:"https://themoviedb.org/person/1242279"}}, {tmdbId:"69637", properties:{bornIn:"Hong Kong, China", imdbId:"0002000", born:date('1956-09-12'), name:"Leslie Cheung", bio:"Leslie Cheung (12 September 1956 – 1 April 2003) was a Hong Kong singer-songwriter, actor, film director, record producer, and screenwriter.  Cheung is considered one of the \"founding fathers of Cantopop\" by \"combining a hugely successful film and music career...", died:date('2003-04-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6H8gTq1QCB0bD9CGDhrIJITiGVX.jpg", url:"https://themoviedb.org/person/69637"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"69638", properties:{bornIn:"Taibei, Taiwan, China", imdbId:"0160823", born:date('1960-10-31'), name:"Emily Chu", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AqAKh1uqh4v0MLXxoQznqfUxAXK.jpg", url:"https://themoviedb.org/person/69638"}}, {tmdbId:"47882", properties:{bornIn:"Bennington, Vermont", imdbId:"0001269", born:date('1963-12-14'), name:"Cynthia Gibb", bio:"From Wikipedia, the free encyclopedia. \n\nCynthia Gibb (born December 14, 1963 in Bennington, Vermont, U. S. ) is an American actress and former model who has starred in film and on television. \n\nGibb grew up in Westport, Connecticut and got her big break at the age of 14 when she was discovered by the Eileen Ford Agency in New York City.  She was on the cover of Vogue and Young Miss...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yfUiTTElY4IJ5OYJguVUglgSRcg.jpg", url:"https://themoviedb.org/person/47882"}}, {tmdbId:"1387", properties:{bornIn:"Kokawa, Slaskie, Poland", imdbId:"0054007", born:date('1956-08-12'), name:"Artur Barcis", bio:"Artur Barciś ([ˈartur ˈbarʲʨ̑ĩɕ]; born 12 August 1956) is a Polish actor.  His television appearances include Krzysztof Kieślowski's anthology series Dekalog (1989), the soap opera Aby do świtu. . .  (1992),[1] and Kurierzy (\"Couriers\").  Since 2006 he has played the lovable neurotic Arkadiusz Czerepach in the comedy series Ranczo (\"The Ranch\")...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2murk7fjwSHI1e2nozRwGCwm8f.jpg", url:"https://themoviedb.org/person/1387"}}, {tmdbId:"107571", properties:{imdbId:"0523821", born:date('1968-12-06'), name:"Olaf Lubaszenko", bio:"Olaf Sergiusz Linde-Lubaszenko (born 6 December 1968 in Wrocław) is a Polish actor and film director.  He is the son of Edward Linde-Lubaszenko, who is an actor of German and Swedish descent and Asja Łamtiugina, a Russian actress. \n\nOlaf Lubaszenko starred in films by Krzysztof Kieślowski, Barbara Sass, Władysław Pasikowski, Janusz Majewski, Juliusz Machulski and others...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vzGr9bVsPm41mWvWkRyy3FDfAji.jpg", url:"https://themoviedb.org/person/107571"}}, {tmdbId:"543992", properties:{imdbId:"0532536", name:"Piotr Machalica", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/50WAWLp45MVNKH4ORRT3u06WpI3.jpg", url:"https://themoviedb.org/person/543992"}}, {tmdbId:"57593", properties:{bornIn:"Bullardoo, Western Australia", imdbId:"0227669", born:date('1956-07-31'), name:"Ernie Dingo", bio:"From Wikipedia, the free encyclopedia\n\nErnie Dingo AM (born 31 July 1956 at Bullardoo Station)[1] is an indigenous Australian actor and television presenter originating from the Yamatji people of the Murchison region of Western Australia. \n\nDescription above from the Wikipedia article Ernie Dingo, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6xOMTFEQQIEi7BHuIicG5vqzyqU.jpg", url:"https://themoviedb.org/person/57593"}}, {tmdbId:"7430", properties:{bornIn:"Elizabeth, New Jersey, USA", imdbId:"0001615", born:date('1961-09-23'), name:"Elizabeth Peña", bio:"Elizabeth Peña (born September 23, 1961 - died October 14, 2014) was an American actress, and the daughter of a theater-company co-founder, who has also compiled experience as a television director in her own right.  Peña was born in Elizabeth, New Jersey, daughter of Estella Margarita (née Toirac), an arts administrator and producer, and Mario Peña, the Cuban-born actor, writer, and director who jointly founded the Latin American Theatre Ensemble...", died:date('2014-10-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tQ6MdFe9ifqWMEGErp8M5jjg1yw.jpg", url:"https://themoviedb.org/person/7430"}}, {tmdbId:"139044", properties:{bornIn:"Los Angeles, California, U.S.", imdbId:"0108315", born:date('1977-09-30'), name:"Maia Brewton", bio:"From Wikipedia, the free encyclopedia\n\nMaia Luisa Brewton (born September 30, 1977) is an American actress who enjoyed success in the late 1980s and early 1990s. \n\nBrewton was born in Los Angeles, California.  She is probably best known as the Mighty Thor-obsessed kid, Sara Anderson, in Adventures in Babysitting, and as Shelly Lewis on one of the Fox Network's earliest shows, Parker Lewis Can't Lose...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w10sqQx1ANA2KFwYc37gS4Kl8Up.jpg", url:"https://themoviedb.org/person/139044"}}, {tmdbId:"56145", properties:{bornIn:"Palm Springs, California, USA", imdbId:"0176861", born:date('1970-01-13'), name:"Keith Coogan", bio:"Keith Coogan (born January 13, 1970) is an American actor.  He is a grandson of actor Jackie Coogan...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vqOs0xsxJ5oxpl7A0cZREWIf773.jpg", url:"https://themoviedb.org/person/56145"}}, {tmdbId:"6165", properties:{bornIn:"Chicago, Illinois, United States", imdbId:"0710829", born:date('1971-10-26'), name:"Anthony Rapp", bio:"Anthony Deane Rapp (born October 26, 1971) is an American stage and film actor and singer best known for originating the role of Mark Cohen in the Broadway production of \"Rent\" in 1996 and later for reprising the role in the film version and the Broadway Tour of \"Rent\" in 2009.  He also performed the role of Charlie Brown in the 1999 Broadway revival of \"You're A Good Man, Charlie Brown\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/b4Ek56pX3R32feLWuz7vJMjt0lq.jpg", url:"https://themoviedb.org/person/6165"}}, {tmdbId:"118589", properties:{bornIn:"Los Angeles, California, U.S", imdbId:"0005015", born:date('1959-01-17'), name:"Susanna Hoffs", url:"https://themoviedb.org/person/118589"}}, {tmdbId:"3234", properties:{bornIn:"New York City, New York, USA", imdbId:"0000349", born:date('1962-10-11'), name:"Joan Cusack", bio:"Actress Joan Cusack was born in New York City, New York, and is the daughter of Nancy (née Carolan) and Dick Cusack.  Her father was an advertising executive, writer and actor, and her mother was a math teacher.  Her siblings - Susie Cusack, John Cusack, Ann Cusack and Bill Cusack also act.  Her family is of Irish descent. \n\nRaised in Evanston, Illinois, Cusack was actively encouraged to explore her creativity by her parents, and as a child she joined the Piven Theater Workshop...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ytjiXEqnaEYtS7XkYmoUXPrZCm5.jpg", url:"https://themoviedb.org/person/3234"}}, {tmdbId:"102439", properties:{bornIn:"Cincinnati, Ohio, USA", imdbId:"0855613", born:date('1961-05-30'), name:"John Terlesky", bio:"John Terlesky is an actor and director...", url:"https://themoviedb.org/person/102439"}}, {tmdbId:"44994", properties:{bornIn:"Cleveland, Ohio, USA", imdbId:"0002119", born:date('1955-02-12'), name:"Arsenio Hall", bio:"Arsenio Hall (born February 12, 1955)  is an American actor, comedian, and former talk show host.  He is best known for his talk show The Arsenio Hall Show, which ran between 1989 and 1994, and his roles in the films Coming to America and Harlem Nights.  Hall is also known for his appearance as Alan Thicke's sidekick on the talk show Thicke of the Night...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8oqVGysLVXkWlTOWIWkWIbL4i2q.jpg", url:"https://themoviedb.org/person/44994"}}, {tmdbId:"1194447", properties:{imdbId:"0611277", name:"Donald F. Muhich", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nXAvnV7M83LJpqZT4ph73mdyIUW.jpg", url:"https://themoviedb.org/person/1194447"}}, {tmdbId:"44995", properties:{bornIn:"Kansas City, Missouri, USA", imdbId:"0001249", born:date('1963-07-30'), name:"Monique Gabrielle", bio:"From Wikipedia, the free encyclopedia:\n\nMonique Gabrielle (born July 30, 1963) is an American model and actress. \n\nGabrielle was the 'Penthouse Pet of the Month' for December 1982 and appeared in 'Bachelor Party' in 1984.  Since then, she has had a career as a B-movie actress.  Many of Gabrielle's films have had overtly erotic overtones.  Although she was in the 1982 adult film 'Bad Girls IV' (credited as Luana Chass), she did not play an explicit part.  She did, however, in the 1990s-era Ravished...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ca47rgI73k71tC7nG8kgvvCkJkE.jpg", url:"https://themoviedb.org/person/44995"}}, {tmdbId:"25944", properties:{bornIn:" Dallas, Texas, USA", imdbId:"0223315", born:date('1959-12-16'), name:"Larry Poindexter", bio:"From Wikipedia, the free encyclopedia\n\nLarry Poindexter (born December 16, 1959) is an American actor and singer born and raised in Dallas, Texas...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/m6EIEWEVXoaoWVKZV63zIrzPMa3.jpg", url:"https://themoviedb.org/person/25944"}}, {tmdbId:"31261", properties:{bornIn:"Boston, Massachusetts, U.S.", imdbId:"0176684", born:date('1936-02-04'), name:"Gary Conway", bio:"Gary Conway (born Gareth Monello Carmody, February 4, 1936) is an American actor and screenwriter.  His notable credits include a co-starring role with Gene Barry in the detective series, Burke's Law, from 1963–1965.  In addition, he starred in the Irwin Allen sci-fi series Land of the Giants from 1968–1970...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9uz6P7ObKoaTODmSypiWLCSvyXI.jpg", url:"https://themoviedb.org/person/31261"}}, {tmdbId:"937112", properties:{imdbId:"1687791", name:"Vincent Hirsch", url:"https://themoviedb.org/person/937112"}}, {tmdbId:"1073756", properties:{imdbId:"1693504", name:"Joseph Diamand", url:"https://themoviedb.org/person/1073756"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"199366", properties:{imdbId:"6234660", name:"Maurice Smith", url:"https://themoviedb.org/person/199366"}}, {tmdbId:"3232", properties:{bornIn:"San Francisco, California, USA", imdbId:"0000956", born:date('1967-11-16'), name:"Lisa Bonet", bio:"Lilakoi Moon (born Lisa Michelle Bonet; November 16, 1967), known professionally as Lisa Bonet, is an American actress.  She is best known for her role as Denise Huxtable on the long-running NBC sitcom The Cosby Show, and originally starring in its spinoff A Different World...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h9XtA8vkvW2bNr7aLO6XHeSYETh.jpg", url:"https://themoviedb.org/person/3232"}}, {tmdbId:"147094", properties:{imdbId:"0485567", name:"Stephanie Lane", url:"https://themoviedb.org/person/147094"}}, {tmdbId:"110320", properties:{imdbId:"0217657", name:"Sevilla Delofski", url:"https://themoviedb.org/person/110320"}}, {tmdbId:"19071", properties:{bornIn:"Paris, France", imdbId:"0542009", born:date('1975-03-25'), name:"Gaspard Manesse", bio:"From Wikipedia, the free encyclopedia. \n\nGaspard Manesse (born March 25, 1975) is a French actor and musician. \n\nHe is best-remembered for starring as Julien in the film Au revoir, les enfants (1987).  He acted in and composed the music for the film Comme il vient.  Gaspard is a composer and musician - he tours throughout the heart of France playing the trumpet with a group called \"Surnatural Orchestra\" from the Ile-de-France...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dVTXZHBZ9R8W3tBpPzq4h66QLr9.jpg", url:"https://themoviedb.org/person/19071"}}, {tmdbId:"19072", properties:{bornIn:"Paris, France", imdbId:"0270830", born:date('1974-09-17'), name:"Raphael Fejtö", bio:"From Wikipedia, the free encyclopedia. \n\nRaphaël Fejtö (born September 17, 1974) is a French actor, director, and author.  He is most famous for co-starring in Louis Malle's semi-autobiographical 1987 motion picture Au revoir, les enfants (Goodbye, Children). \n\nFejtö is of Russian, Egyptian, and Lebanese ancestry.  His grandfather was Ferenc Fejtő, a famous Hungarian historian and journalist. \n\nHis primary acting credit is in Au revoir, les enfants...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oFDhQm7oHULbODDcnx1KzXaby3o.jpg", url:"https://themoviedb.org/person/19072"}}, {tmdbId:"19073", properties:{bornIn:"Joliette, Québec, Canada", imdbId:"0705072", born:date('1947-09-23'), name:"Francine Racette", bio:"From Wikipedia, the free encyclopedia. \n\nFrancine Racette is a French-Canadian actress.  She is the current and third wife of actor Donald Sutherland, and mother of three of his sons: actor Rossif Sutherland, actor Angus Sutherland, and Roeg Sutherland. \n\nDescription above from the Wikipedia article Francine Racette, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uE2dBoPG73Rx5wqUsIsSqR32BW4.jpg", url:"https://themoviedb.org/person/19073"}}, {tmdbId:"19074", properties:{imdbId:"0141133", born:date('1969-08-18'), name:"Stanislas Carré de Malberg", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oT8yWttJjTh1th9kVjkO1mi18OY.jpg", url:"https://themoviedb.org/person/19074"}}, {tmdbId:"70635", properties:{imdbId:"0458064", born:date('1917-09-02'), name:"Bodil Kjer", died:date('2003-02-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7LEdkM2J5jO2RCKBgD2RUyb5JtO.jpg", url:"https://themoviedb.org/person/70635"}}, {tmdbId:"1022633", properties:{imdbId:"0474649", born:date('1927-02-27'), name:"Jarl Kulle", bio:"Jarl Lage Kulle was a Swedish stage and screen actor, director and singer.  He graduated from the Royal Dramatic Theatre's acting school in 1949, was subsequently employed at the theatre and was a member of the ensemble till 1995.  In total, Kulle played in 76 plays at the Royal dramatic Theatre in Stockholm.  In 1959 he appeared as Henry Higgins in the musical \"My Fair Lady\" at Oscarsteatern, Stockholm.  Thirteen years earlier, in 1946, Jarl Kulle made his film debut in a minor role...", died:date('1997-10-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9UJ3Msw0k0fkV5vQiRqG3j4Pfq9.jpg", url:"https://themoviedb.org/person/1022633"}}, {tmdbId:"68631", properties:{imdbId:"0448163", name:"Kristina Kennedy", url:"https://themoviedb.org/person/68631"}}, {tmdbId:"92509", properties:{bornIn:"Queens, New York City, New York, USA", imdbId:"0521753", born:date('1964-07-28'), name:"Lori Loughlin", bio:"​From Wikipedia, the free encyclopedia\n\nLori Anne Loughlin (born July 28, 1964) is an American actress, best known for her role as Rebecca Donaldson-Katsopolis on the ABC sitcom Full House.  As of 2011, she portrays the role of Debbie Wilson on 90210, the spin-off of Beverly Hills, 90210.  She also known for portraying the role of Ava Gregory on the The WB Drama series Summerland, which she also co-created...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uelwtzItSLYEgaSjfzxfQ1AE1YK.jpg", url:"https://themoviedb.org/person/92509"}}, {tmdbId:"93925", properties:{bornIn:"El Centro, California, United States", imdbId:"0385809", born:date('1960-05-31'), name:"Tommy Hinkley", bio:"From Wikipedia, the free encyclopedia.   Hinkley's on-screen career now spans more than 20 years, and since the beginning it has been supplemented by a heavy dose of television guest roles, and periodic regular turns on TV series.  He has also been known for his roles in such popular box office draws as The Cable Guy (1996), Ocean's Thirteen (2007) and Leatherheads (2008). \n\nHinkley is a close friend of George Clooney both on and off-camera, and they have appeared in several projects together...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lNN8KIup3A4y06sl5gJKApYHmQZ.jpg", url:"https://themoviedb.org/person/93925"}}, {tmdbId:"61590", properties:{imdbId:"0693361", name:"Terry Potter", url:"https://themoviedb.org/person/61590"}}, {tmdbId:"61591", properties:{imdbId:"0641402", born:date('1961-01-01'), name:"Pete O'Herne", died:date('2010-12-14'), url:"https://themoviedb.org/person/61591"}}, {tmdbId:"61592", properties:{imdbId:"0807773", name:"Craig Smith", url:"https://themoviedb.org/person/61592"}}, {tmdbId:"61593", properties:{imdbId:"0591207", name:"Mike Minett", url:"https://themoviedb.org/person/61593"}}, {tmdbId:"2506", properties:{bornIn:"Upington, South Africa", imdbId:"0000481", born:date('1954-06-28'), name:"Alice Krige", bio:"Alice Maud Krige is a South African actress and producer.  Her first feature film role was as the Gilbert and Sullivan singer Sybil Gordon in the 1981 Academy Award-winning film Chariots of Fire.  Since then, she has played a variety of roles in a number of genres.  Krige first played the role of the Borg Queen in the motion picture Star Trek: First Contact and reprised the role for the final episode of the television series Star Trek: Voyager...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5Bqbdokkc8b1PSPrjHgEHXpxwzx.jpg", url:"https://themoviedb.org/person/2506"}}, {tmdbId:"1165", properties:{bornIn:"Milwaukee, Wisconsin, USA", imdbId:"0791502", born:date('1936-02-12'), name:"Paul Shenar", bio:"Attractive, dark-featured character actor with a voice like thunder, and eyes like a wolf, who was featured in less than sympathetic roles throughout his career.  Born and raised in Milwaukee, Wisconsin, Albert Paul Shenar attended the University of Wisconsin...", died:date('1989-10-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kc0I4h9fTY8WP3wyQbwVWEzbmil.jpg", url:"https://themoviedb.org/person/1165"}}, {tmdbId:"35547", properties:{bornIn:"New York City, New York, US", imdbId:"0189172", born:date('1978-03-31'), name:"Harley Cross", bio:"Harley Cross is an American film and television actor.  He appeared in the 1980s horror films The Believers and The Fly II; his most recent roles were in the 2004 film Kinsey and in 2000, \"Shriek If You Know What I Did Last Friday the Thirteenth\" .  He is also the co-founder of Hint Mint, a candy company...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vd8PIxUqUSHWnk0xPt3F5HPGMpo.jpg", url:"https://themoviedb.org/person/35547"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"240603", properties:{imdbId:"0409146", born:date('1916-05-08'), name:"Frank Inn", bio:"From Wikipedia, the free encyclopedia. \n\nFrank Inn was born as Elias Franklin Freeman , (May 8, 1916 - July 27, 2002) was an American animal trainer.  He trained several animals for movies, but was most known for his work with the dogs in the Benji series...", died:date('2002-07-27'), url:"https://themoviedb.org/person/240603"}}, {tmdbId:"240602", properties:{bornIn:"Gainesville, Texas, USA", imdbId:"0824134", born:date('1937-12-22'), name:"Red Steagall", bio:"From Wikipedia, the free encyclopedia. \n\nRussell (\"Red\") Steagall (born December 22, 1937) is a multitalented showbusiness personality whose career has covered a period of 35 years and has spanned the globe.  He has performed for heads of state, including a special party for President Reagan at the White House in 1983, and has completed three overseas tours for the United States Information Agency to the Middle East, the Far East, and South America...", url:"https://themoviedb.org/person/240602"}}, {tmdbId:"240604", properties:{imdbId:"0290265", name:"Nancy Francis", url:"https://themoviedb.org/person/240604"}}, {tmdbId:"62", properties:{bornIn:"Idar-Oberstein, Germany", imdbId:"0000246", born:date('1955-03-19'), name:"Bruce Willis", bio:"An American actor and producer.  His career began in television in the 1980s and has continued both in television and film since, including comedic, dramatic, and action roles.  He is well known for the role of John McClane in the Die Hard series.  Willis was born in Idar-Oberstein, West Germany, the son of a Kassel-born German, Marlene, who worked in a bank, and David Willis, an American soldier.  Willis is the eldest of four children...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/A1XBu3CffBpSK8HEIJM8q7Mn4lz.jpg", url:"https://themoviedb.org/person/62"}}, {tmdbId:"14101", properties:{bornIn:"New Orleans, Louisiana, USA", imdbId:"0488662", born:date('1947-11-25'), name:"John Larroquette", bio:"John Bernard Larroquette is an American film and television actor.  His roles include Dan Fielding on the series Night Court, Mike McBride in the Hallmark Channel series McBride, John Hemingway on The John Larroquette Show, and Carl Sack in Boston Legal...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rWXMelYm34YIBOzJJaQrBI50NEp.jpg", url:"https://themoviedb.org/person/14101"}}, {tmdbId:"70254", properties:{bornIn:"New York City, New York, USA", imdbId:"0316455", born:date('1954-08-04'), name:"Donald Gibb", bio:"From Wikipedia, the free encyclopedia. \n\nDonald Gibb (born August 4, 1954), sometimes credited as Don Gibb, is an American actor with an imposing 6 ft-4in frame, best known for portraying the hulking, dimwitted fraternity brother \"Ogre\" in several installments of the Revenge of the Nerds film series. \n\nRaised in California, Gibb attended the University of New Mexico on a basketball scholarship, where he joined Phi Delta Theta fraternity...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oAFeWjcWsfp0SVFQDT6K4aL8tJQ.jpg", url:"https://themoviedb.org/person/70254"}}, {tmdbId:"10195", properties:{bornIn:"New York City, New York, USA", imdbId:"0123680", born:date('1923-12-05'), name:"Norman Burton", bio:"Norman Burton was an American film and television actor...", died:date('2003-11-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fwUO7nZy1gxGfPAKJ9Mhm2RAuOe.jpg", url:"https://themoviedb.org/person/10195"}}, {tmdbId:"55259", properties:{bornIn:"Culiacán, Sinaloa, Mexico", imdbId:"0735467", born:date('1955-01-19'), name:"Paul Rodriguez", bio:"Paul Rodriguez (born January 19, 1955) is a Mexican-born American stand-up comedian and actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e6VaplhEMi8uh3xOl8PThkaAVI8.jpg", url:"https://themoviedb.org/person/55259"}}, {tmdbId:"84476", properties:{bornIn:"New York City - New York - USA", imdbId:"0520234", born:date('1964-04-15'), name:"Kamala Lopez", bio:"Kamala Lopez is an award-winning film and television actress, producer, director, writer and editor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lK8ewhKGSit11mtnIgvQArXYRPm.jpg", url:"https://themoviedb.org/person/84476"}}, {tmdbId:"16165", properties:{bornIn:"Tarzana, California, USA", imdbId:"0001484", born:date('1957-07-21'), name:"Jon Lovitz", bio:"Jonathan \"Jon\" Lovitz is an American comedian, actor, and singer.  He is best known as a cast member of the NBC sketch comedy show Saturday Night Live from 1985 to 1990...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jBXSLoDEVwYkNqSVWHV9yDo8whA.jpg", url:"https://themoviedb.org/person/16165"}}, {tmdbId:"28168", properties:{bornIn:"Doylestown, Pennsylvania, USA", imdbId:"0821048", born:date('1954-11-21'), name:"Timothy Stack", bio:"Timothy Stack is an American actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wMOpamq0meq9NSE5MMMV4x1MjFJ.jpg", url:"https://themoviedb.org/person/28168"}}, {tmdbId:"1498595", properties:{imdbId:"0206610", name:"Timothy E. Day", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/egZ9SBw2PpXmfWXDB0mlRN0xB6O.jpg", url:"https://themoviedb.org/person/1498595"}}, {tmdbId:"150739", properties:{bornIn:"Norfolk, Nebraska, USA", imdbId:"0712391", born:date('1914-02-06'), name:"Thurl Ravenscroft", bio:"From Wikipedia, the free encyclopedia\n\nThurl Arthur Ravenscroft (February 6, 1914 – May 22, 2005) was an American voice actor and bass singer known as the booming voice behind Kellogg's Frosted Flakes animated spokesman Tony the Tiger for more than five decades.  He was also the uncredited vocalist for the song \"You're a Mean One, Mr.  Grinch\" from the classic Christmas television special Dr...", died:date('2005-05-22'), url:"https://themoviedb.org/person/150739"}}, {tmdbId:"18686", properties:{bornIn:"Conyers, Georgia, USA", imdbId:"0000456", born:date('1958-03-20'), name:"Holly Hunter", bio:"Holly Hunter (born March 20, 1958) is an American actress.  For her performance as Ada McGrath in the 1993 drama film The Piano, she won the Academy Award, BAFTA Award, Golden Globe Award, and Cannes Film Festival Award for Best Actress.  She was also nominated for the Academy Award for Best Actress for Broadcast News (1987), and the Academy Award for Best Supporting Actress for The Firm (1993) and again for Thirteen (2003)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oNoFAi0AQXDP68tv7c7t5WjYioy.jpg", url:"https://themoviedb.org/person/18686"}}, {tmdbId:"18352", properties:{bornIn:"Lewiston, Maine, USA", imdbId:"0001131", born:date('1966-01-13'), name:"Patrick Dempsey", bio:"From Wikipedia, the free encyclopedia. \n\nPatrick Galen Dempsey (born January 13, 1966) is an American actor, known for his role as neurosurgeon Dr.  Derek Shepherd (\"McDreamy\") on the medical drama Grey's Anatomy.  Prior to Grey's Anatomy, he made several television appearances, earning him an Emmy Award nomination.  He has also recently appeared in several films, including Sweet Home Alabama, The Emperor's Club, Freedom Writers, Enchanted, Made of Honor, and Valentine's Day...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2PpaYtXdaDmNi3jap4qPIdyVesL.jpg", url:"https://themoviedb.org/person/18352"}}, {tmdbId:"59942", properties:{bornIn:"Greeley, Colorado, USA", imdbId:"0000584", born:date('1971-07-08'), name:"Amanda Peterson", bio:"Phyllis Amanda Peterson (July 8, 1971 – July 3, 2015) was an American actress...", died:date('2015-07-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oH1thfLes3PDVKJTi6R0U16n8KW.jpg", url:"https://themoviedb.org/person/59942"}}, {tmdbId:"18708", properties:{bornIn:"Los Angeles County, California, USA", imdbId:"0301381", born:date('1965-08-22'), name:"Courtney Gains", bio:"Courtney Gains (born August 22, 1965) is an American actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/elGU2wmQXpZghgG74QxMvd8B4hf.jpg", url:"https://themoviedb.org/person/18708"}}, {tmdbId:"22554", properties:{bornIn:"Downey, California, USA", imdbId:"0143836", born:date('1970-12-28'), name:"Tina Caspary", bio:"Tina Caspary is an American actress, dancer, choreographer and dance instructor, born on December 28, 1970 in Downey, California to Father,  Dewitt Caspary III and Mother, Brenda Caspary.  She has 2 brothers, Dennis Caspary (dance choreographer) & Dewitt \"Dee\" Caspary (actor & dance choreographer).  She grew up in the Southern California dance scene and has worked in every major facet of the entertainment industry...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/52vzYyJHpQJEZOM1qXIqkbjfron.jpg", url:"https://themoviedb.org/person/22554"}}, {tmdbId:"7219", properties:{bornIn:"Baton Rouge - Louisiana - USA", imdbId:"0028625", born:date('1952-01-01'), name:"David Andrews", bio:"An American actor, best known for his role as General Robert Brewster in Terminator 3: Rise of the Machines.  Andrews was born in Baton Rouge, Louisiana.  His attended the Louisiana State University as an undergraduate and followed with a year at the Duke University School of Law and two at Stanford Law School, from which he graduated in the late 1970s.  He set his career off in style by starring in the 1984 horror classic A Nightmare on Elm Street...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/36LEerIIN7gpG52mM3Ier7YWDbh.jpg", url:"https://themoviedb.org/person/7219"}}, {tmdbId:"58629", properties:{imdbId:"0050177", name:"Jennifer Balgobin", url:"https://themoviedb.org/person/58629"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"3041", properties:{bornIn:"Tulsa, Oklahoma, USA", imdbId:"0068382", born:date('1942-09-28'), name:"Marshall Bell", bio:"Archibald Marshall Bell (born September 28, 1942) is an American actor.  He has appeared in many character roles in movies and television.  His best-known movies are probably A Nightmare on Elm Street 2: Freddy's Revenge (1985), Stand by Me (1986), Twins (1988) and Total Recall (1990). \n\nDescription above from the Wikipedia article Marshall Bell, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8pZ12nmxnaB1EIxDxcp9znrubNM.jpg", url:"https://themoviedb.org/person/3041"}}, {tmdbId:"4316", properties:{bornIn:"Saugus, Santa Clarita, California, USA", imdbId:"0001013", born:date('1921-05-16'), name:"Harry Carey Jr.", bio:"Harry Carey Jr.  was an American actor. , who attempted a singing career to avoid acting but was unsuccessful.  He began acting in the John Ford Stock Company with his father.  Carey collaborated frequently with director John Ford, who was a close friend.  He appeared in such notable Ford films as 3 Godfathers, She Wore a Yellow Ribbon, The Searchers, and Cheyenne Autumn. Both of his parents had appearances in Ford's films as well.  He became a respected character actor like his father...", died:date('2012-12-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7O61xbnqAMDOKVCh9ZH8deW6M30.jpg", url:"https://themoviedb.org/person/4316"}}, {tmdbId:"22860", properties:{bornIn:"St. Louis, Missouri, USA", imdbId:"0001946", born:date('1926-10-18'), name:"Chuck Berry", died:date('2017-03-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9faTPqWt3cBmQZWfB16REh1jUwl.jpg", url:"https://themoviedb.org/person/22860"}}, {tmdbId:"1171675", properties:{imdbId:"1966924", name:"Ingrid Berry", url:"https://themoviedb.org/person/1171675"}}, {tmdbId:"2585", properties:{bornIn:"Ripley, Surrey, England, UK", imdbId:"0002008", born:date('1945-03-30'), name:"Eric Clapton", bio:"Eric Patrick Clapton, CBE (born 30 March 1945) is an English guitarist, vocalist, and songwriter.  Clapton is the only three-time inductee to the Rock and Roll Hall of Fame: once as a solo artist, and separately as a member of The Yardbirds and Cream.  Clapton has been referred to as one of the most important and influential guitarists of all time...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hcAeVVzaRCzkr9DOzvCEDLv0vd.jpg", url:"https://themoviedb.org/person/2585"}}, {tmdbId:"227003", properties:{imdbId:"0187042", name:"Robert Cray", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/urFJxPChtAaaz4b2MmlPSeVwNnN.jpg", url:"https://themoviedb.org/person/227003"}}, {tmdbId:"174708", properties:{imdbId:"0800219", born:date('1960-01-01'), name:"Josette Simon", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uLvLGR6a60To8AAlj0C5124d7Xu.jpg", url:"https://themoviedb.org/person/174708"}}, {tmdbId:"77681", properties:{bornIn:"Johannesburg, South Africa", imdbId:"0559344", born:date('1954-11-26'), name:"John Matshikiza", died:date('2008-09-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5Jzde5OZMRuSrMjgWVm34Lt8ceO.jpg", url:"https://themoviedb.org/person/77681"}}, {tmdbId:"1629826", properties:{name:"Juanita Waterman", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pRrLFUVD0Vl082pYHXO64vjNLxB.jpg", url:"https://themoviedb.org/person/1629826"}}, {tmdbId:"100591", properties:{bornIn:"Princeton, New Jersey, USA", imdbId:"0461021", born:date('1959-05-07'), name:"Michael E. Knight", bio:"​From Wikipedia, the free encyclopedia.   \n\nMichael E.  Knight (born May 7, 1959) is an American actor. \n\nKnight is best known for playing Tad Martin on the soap opera All My Children.  His first stint on the show ran from 1982-1986.  He returned from 1988–1990 and again from 1992–present.  Knight also appeared as Ted Orsini on AMC from 1993-1994. \n\nDescription above from the Wikipedia article  Michael E.  Knight , licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/100591"}}, {tmdbId:"87435", properties:{bornIn:"Dublin, Ireland", imdbId:"0564857", born:date('1943-05-07'), name:"Donal McCann", bio:"Donal McCann (7 May 1943 – 17 July 1999) was an Irish stage, film, and television actor best known for his roles in the works of Brian Friel and for his lead role in John Huston's last film, The Dead. \n\nDescription above from the Wikipedia article Donal McCann, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1999-07-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xGjV73QUTFPvNwWSv6R1dNqsMt.jpg", url:"https://themoviedb.org/person/87435"}}, {tmdbId:"168632", properties:{bornIn:"Bradford, West Yorkshire, England, UK ", imdbId:"0232703", born:date('1931-07-06'), name:"Donal Donnelly", died:date('2010-01-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h1xqf5rpk1I6omgjkD7pzQVUq94.jpg", url:"https://themoviedb.org/person/168632"}}, {tmdbId:"24519", properties:{bornIn:"Saratoga Springs, New York, USA", imdbId:"0884306", born:date('1958-06-03'), name:"Scott Valentine", bio:"From Wikipedia, the free encyclopedia. \n\nScott Eugene Valentine (born June 3, 1958) is an American actor. \n\nDescription above from the Wikipedia article Scott Valentine, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/24519"}}, {tmdbId:"68362", properties:{bornIn:"Rhode Island, USA", imdbId:"0681413", born:date('1960-10-19'), name:"Nicole Picard", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8VUigFawQ1jdhu0I1Dw64AfNpjE.jpg", url:"https://themoviedb.org/person/68362"}}, {tmdbId:"99037", properties:{imdbId:"0593919", name:"Matt Mitler", url:"https://themoviedb.org/person/99037"}}, {tmdbId:"163013", properties:{bornIn:" Brooklyn, New York, USA", imdbId:"0211040", born:date('1964-07-04'), name:"Cathryn de Prume", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l8PsbpEbhYGxw5ovOrttiVUjOEy.jpg", url:"https://themoviedb.org/person/163013"}}, {tmdbId:"722", properties:{bornIn:"New York, USA", imdbId:"0000426", born:date('1960-03-26'), name:"Jennifer Grey", bio:"From Wikipedia, the free encyclopedia. \n\nJennifer Elise Grey (born March 26, 1960) is an American actress.  She is best known for playing Frances \"Baby\" Houseman in the hit film Dirty Dancing (1987), Jeanie Bueller in Ferris Bueller's Day Off (1986) and for being the winner of season 11 of the American version of Dancing with the Stars. \n\nDescription above from the Wikipedia article Jennifer Grey, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dY8mECHnrLvr4UQr61Ym78cakoA.jpg", url:"https://themoviedb.org/person/722"}}, {tmdbId:"30097", properties:{bornIn:" Sydney, Australia", imdbId:"0404191", born:date('1960-01-22'), name:"Michael Hutchence", died:date('1997-11-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fu14gRAVKoe00zsJUrMQ559OHRa.jpg", url:"https://themoviedb.org/person/30097"}}, {tmdbId:"107467", properties:{imdbId:"0692869", name:"Saskia Post", url:"https://themoviedb.org/person/107467"}}, {tmdbId:"107468", properties:{imdbId:"0624141", name:"Nique Needles", url:"https://themoviedb.org/person/107468"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"107469", properties:{imdbId:"0093917", name:"Deanna Bond", url:"https://themoviedb.org/person/107469"}}, {tmdbId:"34986", properties:{imdbId:"0930787", name:"Ian Patrick Williams", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2GkjmbqE7yGgJsQYULkXFG2yHTC.jpg", url:"https://themoviedb.org/person/34986"}}, {tmdbId:"37028", properties:{bornIn:"Michigan, USA", imdbId:"0700850", born:date('1947-01-01'), name:"Carolyn Purdy-Gordon", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rkNC80zwfLwDAb23eXZuyZO0JOO.jpg", url:"https://themoviedb.org/person/37028"}}, {tmdbId:"91533", properties:{bornIn:"Torrance, California, US", imdbId:"0521106", born:date('1978-08-09'), name:"Carrie Lorraine", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lD6iM8yLMKKGy0M7TsfQNyiBPSW.jpg", url:"https://themoviedb.org/person/91533"}}, {tmdbId:"44883", properties:{bornIn:"Kilburn, London, England, UK", imdbId:"0738212", born:date('1911-12-27'), name:"Guy Rolfe", bio:"​From Wikipedia, the free encyclopedia\n\nGuy Rolfe (27 December 1911 – 19 October 2003) was an English actor born in London. \n\nHe made his screen debut in 1937 with an uncredited appearance in Knight Without Armour.  Notable roles include: King John in Ivanhoe (1952), Ned Seymour in Young Bess (1953), Caiaphas in King of Kings (1961), and Prince Grigory in Taras Bulba (1962)...", died:date('2003-10-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lA76cZ2EoE6QrN6oEGlTgrbPDdo.jpg", url:"https://themoviedb.org/person/44883"}}, {tmdbId:"6238", properties:{bornIn:"Essex, England, UK", imdbId:"0828980", born:date('1956-10-30'), name:"Juliet Stevenson", bio:"From Wikipedia\n\nJuliet Anne Virginia Stevenson, CBE (born 30 October 1956) is an English actor of stage and screen...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vfa2rMTtYGcjBPDtrOpSBEwpTcI.jpg", url:"https://themoviedb.org/person/6238"}}, {tmdbId:"20810", properties:{bornIn:"Marylebone, London, England, UK", imdbId:"0000613", born:date('1965-01-09'), name:"Joely Richardson", bio:"Joely Kim Richardson (born 9 January 1965) is an English actress, most known recently for her role as Queen Catherine Parr in the Showtime television show The Tudors and Julia McNamara in the television drama Nip/Tuck.  She also appeared in films such as 101 Dalmatians (1996), Event Horizon (1997), The Patriot (2000) and the upcoming film adaptation, The Girl with the Dragon Tattoo (2011)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Qf5EWbR8GUGITww7XAwTRoO4uP.jpg", url:"https://themoviedb.org/person/20810"}}, {tmdbId:"1369", properties:{bornIn:"Manchester, England, United Kingdom", imdbId:"0384060", born:date('1944-12-17'), name:"Bernard Hill", bio:"Born in 1944, Bernard Hill is a British actor of film, stage and television.  He is best known to British television viewers for playing Yosser Hughes in the groundbreaking 1982 TV series Boys from the Blackstuff.  On film he has played Captain Edward John Smith in Titanic, King Théoden in The Lord of the Rings film trilogy, and the Warden of San Quentin Prison in the Clint Eastwood film True Crime...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5i8bj2nsTrFU2ddSynleOjapxor.jpg", url:"https://themoviedb.org/person/1369"}}, {tmdbId:"4996", properties:{bornIn:"Long Island, New York, USA", imdbId:"0004700", born:date('1979-01-24'), name:"Tatyana Ali", bio:"On January 24, 1979, Tatyana Marisol Ali was born to Sonia, who was a nurse from Panama, and Sheriff Ali, a retired police officer from Trinidad.  At the age of four she started singing and got a taste of fame when she begged her mother to take her to an audition for Sesame Street (1969). \n\nShe went on to perform in many productions in her native city, New York, including the Broadway show \"Fences\"--with James Earl Jones and, later, Billy Dee Williams--and the off-Broadway show \"Orfeo del Campo\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wlCYid92sB1dffkxW271NEqrYOB.jpg", url:"https://themoviedb.org/person/4996"}}, {tmdbId:"171029", properties:{bornIn:"Richmond, Virginia, USA", imdbId:"0020312", born:date('1925-01-13'), name:"Billie Allen", url:"https://themoviedb.org/person/171029"}}, {tmdbId:"230430", properties:{imdbId:"0112913", name:"James Brown III", url:"https://themoviedb.org/person/230430"}}, {tmdbId:"3894", properties:{bornIn:"Haverfordwest, Pembrokeshire, Wales, UK", imdbId:"0000288", born:date('1974-01-30'), name:"Christian Bale", bio:"A Welsh-born English actor.  In addition to starring roles in big budget Hollywood films, he has long been heavily involved in films produced by independent producers and art houses.  Bale first caught the public eye when he was cast in the starring role of Steven Spielberg's Empire of the Sun at the age of 13, playing an English boy who is separated from his parents and subsequently finds himself lost in a Japanese internment camp during World War II...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/b7fTC9WFkgqGOv77mLQtmD4Bwjx.jpg", url:"https://themoviedb.org/person/3894"}}, {tmdbId:"12899", properties:{imdbId:"0001815", born:date('1949-06-15'), name:"Jim Varney", bio:"James Albert \"Jim\" Varney, Jr.  (June 15, 1949 – February 10, 2000) was an American actor, voice artist, and comedian, best known for his role as Ernest P.  Worrell, who was used in numerous television commercial campaigns and movies in the following years, giving Varney fame nationally in the United States...", died:date('2000-02-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j2De8KaACIbi4IX8WfUZGmCW1k2.jpg", url:"https://themoviedb.org/person/12899"}}, {tmdbId:"136105", properties:{imdbId:"0705165", born:date('1950-12-26'), name:"Victoria Racimo", url:"https://themoviedb.org/person/136105"}}, {tmdbId:"127032", properties:{bornIn:"Gueydan, Louisiana, USA", imdbId:"0002014", born:date('1907-04-03'), name:"Iron Eyes Cody", bio:"Iron Eyes Cody (born Espera Oscar de Corti), was an Italian-American actor.  He portrayed Native Americans in Hollywood films, famously as Chief Iron Eyes in Bob Hope's The Paleface.  He also played a Native American shedding a tear about litter in one of the country's most well-known television public service announcements, \"Keep America Beautiful\".   Cody began acting in the early 1930s.  He worked in film and television until his death...", died:date('1999-01-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/99UJ3zxKYQQZ8qh9OZp9k1bYyKY.jpg", url:"https://themoviedb.org/person/127032"}}, {tmdbId:"11749", properties:{imdbId:"0077670", name:"Sarah Berry", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3mIrEco33KaUIlMIALN7xYkROsk.jpg", url:"https://themoviedb.org/person/11749"}}, {tmdbId:"11750", properties:{bornIn:"Pontiac, Michigan, USA", imdbId:"0382830", born:date('1951-07-19'), name:"Dan Hicks", bio:"From Wikipedia, the free encyclopedia\n\nDan Hicks (sometimes credited as Danny Hicks) (July 19, 1951 – June 30, 2020) was an American actor.  He is best known for starring roles in Evil Dead II and Intruder as well as appearing in various other horror films.  He is a close friend of Sam Raimi (the director of Evil Dead II) and often has parts in his movies. \n\nDescription above from the Wikipedia article Dan Hicks (actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2020-06-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qBrRAMJ29R59jiGB2vJQ51ZJEBN.jpg", url:"https://themoviedb.org/person/11750"}}, {tmdbId:"11751", properties:{bornIn:"Morganfield, Kentucky, USA", imdbId:"0219990", born:date('1961-03-21'), name:"Kassie Wesley DePaiva", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7MhZiKHkLuGQuX4j96nVsNh0Icp.jpg", url:"https://themoviedb.org/person/11751"}}, {tmdbId:"11086", properties:{bornIn:"Toronto, Canada", imdbId:"0000461", born:date('1950-02-12'), name:"Michael Ironside", bio:"Frederick Reginald Ironside, known as Michael Ironside, is a Canadian actor.  He has worked as a voice actor, producer, film director, and screenwriter in movie and television series in various Canadian and American productions...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mzHmxtKcMJjDqWxKd67mKQJFW1B.jpg", url:"https://themoviedb.org/person/11086"}}, {tmdbId:"10427", properties:{bornIn:"Los Angeles, California, U.S.", imdbId:"0000271", born:date('1947-08-24'), name:"Anne Archer", bio:"From Wikipedia, the free encyclopedia. \n\nAnne Archer (born August 25, 1947) is an American actress who has performed in feature films, television, and stage and was named Miss Golden Globe in 1971.  Among her best known roles is that of Beth Gallagher in the 1987 movie Fatal Attraction, for which she received a nomination for an Academy Award. \n\nDescription above from the Wikipedia article Peter Hyams, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yIHIdnoZ9iEoOdedheF1KUe4gcD.jpg", url:"https://themoviedb.org/person/10427"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"2049", properties:{bornIn:" Panama City, Panama", imdbId:"0001952", born:date('1948-07-16'), name:"Rubén Blades", bio:"​From Wikipedia, the free encyclopedia.   \n\nRubén Blades Bellido de Luna (born July 16, 1948) is a Panamanian salsa singer, songwriter, lawyer, actor, Latin jazz musician, and politician, performing musically most often in the Afro-Cuban and Latin jazz genres...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kOgVo3qDJ9jXgIZJRJI3I1bm6sA.jpg", url:"https://themoviedb.org/person/2049"}}, {tmdbId:"550085", properties:{bornIn:"Hollywood, California, USA.", imdbId:"0011052", born:date('1961-04-10'), name:"Jeb Stuart Adams", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/seeA4grZOtuSPaBY5trmyxcRnXl.jpg", url:"https://themoviedb.org/person/550085"}}, {tmdbId:"7132", properties:{bornIn:"Bensonhurst, Brooklyn, New York City, New York, USA", imdbId:"0000352", born:date('1959-06-30'), name:"Vincent D'Onofrio", bio:"Vincent D'Onofrio (born June 30, 1959) is an American actor, film producer, and singer. \n\nHe first gained attention for his role in Full Metal Jacket and for his role  on Law & Order: Criminal Intent...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qkyiLolEqYMGH25xD4sFIXAjZQB.jpg", url:"https://themoviedb.org/person/7132"}}, {tmdbId:"8655", properties:{bornIn:"Emporia, Kansas, USA", imdbId:"0000388", born:date('1944-03-24'), name:"R. Lee Ermey", bio:"Ronald Lee Ermey (March 24, 1944 – April 15, 2018) was a retired United States Marine Corps drill instructor and actor. \n\nErmey often played the roles of authority figures, such as his breakout performance as Gunnery Sergeant Hartman in Full Metal Jacket, Mayor Tilman in the Alan Parker film Mississippi Burning, Bill Bowerman in Prefontaine, Sheriff Hoyt in The Texas Chainsaw Massacre remake, and plastic army men leader Sarge in the Toy Story films...", died:date('2018-04-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vOX3JHPLrKn2HJoPNguKcTN8Lk0.jpg", url:"https://themoviedb.org/person/8655"}}, {tmdbId:"12662", properties:{bornIn:"New Orleans, Louisiana", imdbId:"0284496", born:date('1958-11-08'), name:"Phil Fondacaro", bio:"From Wikipedia, the free encyclopedia. \n\nPhil Fondacaro (born November 8, 1958) is an American actor.  A dwarf actor at 3 feet 6 inches (1. 07 m), Fondacaro began acting in 1981, with the film Under the Rainbow. \n\nFondacaro appeared in 1983's Star Wars Episode VI: Return of the Jedi, the third Star Wars film, as an Ewok, the only one to have a death scene...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vJbPx90IzOdE6L1maYu1HIJayjG.jpg", url:"https://themoviedb.org/person/12662"}}, {tmdbId:"60060", properties:{bornIn:"Los Angeles - California - USA", imdbId:"0040015", born:date('1973-05-12'), name:"Mackenzie Astin", bio:"From Wikipedia, the free encyclopedia\n\nMackenzie Alexander Astin (born May 12, 1973) is an American actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/abDb5NH2OdarXJXIfjeeQjHhwES.jpg", url:"https://themoviedb.org/person/60060"}}, {tmdbId:"81410", properties:{bornIn:"Saltillo, Coahuila, Mexico", imdbId:"0053508", born:date('1972-01-22'), name:"Katie Barberi", url:"https://themoviedb.org/person/81410"}}, {tmdbId:"61962", properties:{bornIn:"Shoreham, Long Island, New York, USA", imdbId:"0000665", born:date('1961-11-14'), name:"D.B. Sweeney", bio:"From Wikipedia, the free encyclopedia. \n\nDaniel Bernard \"D.  B. \" Sweeney (born November 14, 1961) is an American actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/enY28APVRWfyHjGAkh6VCkYCWOA.jpg", url:"https://themoviedb.org/person/61962"}}, {tmdbId:"10822", properties:{bornIn:"Atlanta, Georgia, USA", imdbId:"0001151", born:date('1973-07-29'), name:"Stephen Dorff", bio:"Stephen Dorff (born July 29, 1973) is an American actor, best known for portraying Stuart Sutcliffe in Backbeat, Johnny Marco in Somewhere, and for his roles in Blade and Cecil B.  DeMented...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kuFyGa2HZB7hAQTUn3WKlgKAVjm.jpg", url:"https://themoviedb.org/person/10822"}}, {tmdbId:"51424", properties:{imdbId:"0219821", name:"Christa Denton", url:"https://themoviedb.org/person/51424"}}, {tmdbId:"51425", properties:{bornIn:"St. Catharines, Ontario, Canada", imdbId:"0873097", born:date('1974-02-03'), name:"Louis Tripp", url:"https://themoviedb.org/person/51425"}}, {tmdbId:"47757", properties:{bornIn:"Ottawa - Ontario - Canada", imdbId:"0746414", born:date('1965-10-26'), name:"Kelly Rowan", bio:"Kelly Rowan (born October 26, 1965) is a Canadian television and film actress and former fashion model.  She is best known for portraying Kirsten Cohen on The O. C. \n\nFrom Wikipedia, the free encyclopedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/y4j0JO71WUBoFDwrtHpjmwjtdWt.jpg", url:"https://themoviedb.org/person/47757"}}, {tmdbId:"101298", properties:{imdbId:"0552125", name:"Damon Martin", bio:"​From Wikipedia, the free encyclopedia.   \n\nDamon Martin is an American film producer, having served as Executive Producer on a dozen films since 2004.  He is also the former President and Founder of Departure Studios, which has performed post-production audio services for approximately fifty independent feature films since the company's inception before being acquired by Black Satellite Records owner Ian Colhoun and re-named Black Satellite Sound Post...", url:"https://themoviedb.org/person/101298"}}, {tmdbId:"101300", properties:{imdbId:"0236104", name:"J. Downing", bio:"​From Wikipedia, the free encyclopedia.   \n\nJ.  Downing is an American actor.  He has been married to actress Christina Carlisi since 1990.  They have one child together...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ghd3tPWcCRD5oAgPfiy1AtQCUmN.jpg", url:"https://themoviedb.org/person/101300"}}, {tmdbId:"22462", properties:{bornIn:"São Sebastião da Pedreira - Lisbon - Portugal", imdbId:"0021835", born:date('1957-03-15'), name:"Joaquim de Almeida", bio:"Joaquim António Portugal Baptista de Almeida ( born 15 March 1957) is a Portuguese-born American actor. \n\nHe began his acting during the 1980s, appearing on the 1982 action movie The Soldier...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5TLi0mVLo7GsRHBI1qY4eq4IDdK.jpg", url:"https://themoviedb.org/person/22462"}}, {tmdbId:"22210", properties:{bornIn:"Esch-sur-Alzette, Luxembourg", imdbId:"0636440", born:date('1965-01-14'), name:"Désirée Nosbusch", bio:"From Wikipedia, the free encyclopedia.  Désirée Nosbusch (born January 14, 1965) is a television presenter and actress.  She was born in Esch-sur-Alzette, Luxembourg, and has one Luxembourgish parent and one Italian parent.  In the 1980s she lived in Manhattan in New York City, and from the 1990s to 2008 she lived in Los Angeles, California.  Nosbusch speaks Luxembourgish, German, French, Italian and English...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7G96yTKgv1pG8zWsHvQECA6o3aZ.jpg", url:"https://themoviedb.org/person/22210"}}, {tmdbId:"11960", properties:{imdbId:"0870918", name:"Tung Thanh Tran", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xSAv4pTPmP8FKG0nP2qQXVBJPAU.jpg", url:"https://themoviedb.org/person/11960"}}, {tmdbId:"11961", properties:{bornIn:"Bangkok, Thailand", imdbId:"0837701", born:date('1965-01-22'), name:"Chintara Sukapatana", bio:"From Wikipedia, the free encyclopedia.   Chintara Sukapatana (b.  22 January 1965 in Bangkok, Thailand) is a Thai film actress.  Her best known role was as Trinh in the 1987 Hollywood film, Good Morning, Vietnam, in which she co-starred opposite Robin Williams.   At the time, she was a student at Chulalongkorn University.   Description above from the Wikipedia article Chintara Sukapatana, licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kY6nSy9R2n0VhIdTNkKbhjS1uMI.jpg", url:"https://themoviedb.org/person/11961"}}, {tmdbId:"56509", properties:{bornIn:"Vancouver, Canada", imdbId:"0486661", born:date('1971-01-01'), name:"Margaret Langrick", bio:"Margaret Langrick is a Canadian actress.  She won a 1986 Genie Award for Best Performance by an Actress in a Leading Role for My American Cousin and was also nominated in the same category in 1990 for Cold Comfort.  She was also nominated for a Gemini Award in 1987 for Best Guest Performance in a Series by an Actor or Actress for Danger Bay.  She also received a Young Artist Award nomination in the category Best Young Actress in a Motion Picture - Comedy in 1988 for Harry and the Hendersons...", url:"https://themoviedb.org/person/56509"}}, {tmdbId:"56510", properties:{bornIn:"Encino, California", imdbId:"0749017", born:date('1975-12-09'), name:"Joshua Rudoy", bio:"Joshua Rudoy was born on December 9, 1975 in Encino, California, USA.  He is an actor, known for Flatliners (1990), Harry and the Hendersons (1987) and What a Dummy (1990)...", url:"https://themoviedb.org/person/56510"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"166463", properties:{imdbId:"0528994", name:"Wendy Lyon", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rrr1YWLm7szPDca25pvuHhJ8vKK.jpg", url:"https://themoviedb.org/person/166463"}}, {tmdbId:"51036", properties:{bornIn:"Terceira Island, Azores, Portugal", imdbId:"0274371", born:date('1967-02-20'), name:"Louis Ferreira", bio:"​Louis Ferreira (born Luís Ferreira, also known as Louis Ferreira or Justin Louis, sometimes spelled as Justin Lewis) is a Portuguese Canadian actor. \n\nFerreira is best known for his roles in Stargate Universe as Colonel Everett Young, serial killer Ray Prager in the first season of Durham County, FBI Assistant Director John Pollock in Missing, and Art Blank in Saw IV, Saw V, and Saw 3D.  He starred in the CTV series Motive[4] as homicide detective Oscar Vega...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7xUTd7N6XbB3uWvob12qpmGzPzA.jpg", url:"https://themoviedb.org/person/51036"}}, {tmdbId:"229714", properties:{bornIn:"Vancouver - Canada", imdbId:"0775076", born:date('1956-12-27'), name:"Lisa Schrage", bio:"Lisa Schrage is a Canadian film and television actress.  She is best known for portraying as Mary Lou Maloney in the Canadian horror film \"Hello Mary Lou: Prom Night II (1987)\".  She had a lead role in the Canadian horror film \"Food of the Gods II (1989)\".  Schrage was raised in Toronto, Ontario, Canada...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1nKuxs4mk8mCt3NSaCTgQMyFHrR.jpg", url:"https://themoviedb.org/person/229714"}}, {tmdbId:"45588", properties:{bornIn:"Bradford, Yorkshire, England", imdbId:"0383354", born:date('1955-11-10'), name:"Clare Higgins", bio:"Clare Frances Elizabeth Higgins (born 10 November 1955) is an award-winning English actress. \n\nDescription above from the Wikipedia article Clare Higgins, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p3YIaynhTppxhWAgI5WjOCpzPxs.jpg", url:"https://themoviedb.org/person/45588"}}, {tmdbId:"56551", properties:{bornIn:"Los Angeles, California, U.S.A.", imdbId:"0491090", born:date('1966-05-28'), name:"Ashley Laurence", bio:"From Wikipedia, the free encyclopedia. \n\nAshley Laurence (born Lori Coburn on May 28, 1970 in Los Angeles, California) is an American film and television actress.  She is noted for her appearances in horror films, particularly the Hellraiser series. \n\nDescription above from the Wikipedia article Ashley Laurence, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cmvfP4abA5wQ6a7GUJNAWuaDcK0.jpg", url:"https://themoviedb.org/person/56551"}}, {tmdbId:"56552", properties:{bornIn:"Greenwich, London, England, UK", imdbId:"0152521", born:date('1961-06-02'), name:"Sean Chapman", bio:"Sean Chapman (born June 2, 1961) is an actor and voice actor from England...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vtiWMi6898HVSltnPjA8KRdDHZB.jpg", url:"https://themoviedb.org/person/56552"}}, {tmdbId:"52300", properties:{bornIn:"Glendale, California, USA", imdbId:"0160004", born:date('1965-08-10'), name:"Claudia Christian", bio:"Claudia Christian is an American actress born on August 10, 1965, in Glendale, California.  Her family moved to Connecticut some afterwards.  At age five, she was bitten by the acting bug when she played a Native American in a school play.  After her family returned to California, she graduated high school at 16, and set out to start her acting career.  She worked in a coffee house and then at a clothing store for two years before landing her first acting role on the soap \"Dallas\" (1978)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iFEB10ukEaBcrJ5nAhAfIDsG9vz.jpg", url:"https://themoviedb.org/person/52300"}}, {tmdbId:"72408", properties:{bornIn:"St. Matthews, South Carolina", imdbId:"0270948", born:date('1938-09-02'), name:"Clarence Felder", bio:"​From Wikipedia, the free encyclopedia\n\nClarence Felder (born September 2, 1938) is an American character actor who starred in films and on television and co-starred in ten Broadway productions. \n\nClarence's first feature film was in the 1974 movie Man on a Swing, his other films include After Hours (1985), Ruthless People (1986), The Hidden (1987), The Last Boy Scout (1991), and The Ride (1997)...", url:"https://themoviedb.org/person/72408"}}, {tmdbId:"24627", properties:{bornIn:"London", imdbId:"0183122", born:date('1944-06-20'), name:"Oliver Cotton", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2I2W2hpNPRWpidKyRDGJ3p0hSRc.jpg", url:"https://themoviedb.org/person/24627"}}, {tmdbId:"2312", properties:{bornIn:"Paris, France", imdbId:"0231652", born:date('1961-05-16'), name:"Solveig Dommartin", bio:"​From Wikipedia, the free encyclopedia.   \n\nSolveig Dommartin (16 May 1961 in Constantine, Algeria - 11 January 2007 in Paris) was a French-German actress. \n\nHer acting career began in the theatre with \"Compagnie Timothee Laine\" and with the \"Theater Labor Warschau\".  She had her first experiences with film as an assistant of Jacques Rozier. \n\nHer debut as a film actress was Wings of Desire (1987) under Wim Wenders...", died:date('2007-01-11'), url:"https://themoviedb.org/person/2312"}}, {tmdbId:"2311", properties:{bornIn:"Hanover, Germany", imdbId:"0761420", born:date('1941-06-30'), name:"Otto Sander", bio:"Otto Sander (born 30 June 1941 in Hanover) is a German film, theater, and voice actor. \n\nSander grew up in Kassel, where he graduated in 1961 from the Friedrichgymnasium.  After leaving school he spent his military service as a navy reserve officer and then studied theatre science, history of art and philosophy.  In 1965 he made his acting debut at the Düsseldorfer chamber plays...", died:date('2013-09-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oKO3ZPPFqdlBp9T3XNDla6kYWub.jpg", url:"https://themoviedb.org/person/2311"}}, {tmdbId:"2313", properties:{bornIn:"Berlin, Germany", imdbId:"0092290", born:date('1901-04-05'), name:"Curt Bois", bio:"From Wikipedia, the free encyclopedia.   Curt Bois (April 5, 1901 – December 25, 1991) was a German actor.  He is best remembered for his performance as the Pickpocket in Casablanca (1942). \n\nBois was born in Berlin and began acting in 1907, becoming one of the film world's first child actors, with a role in the silent movie Bauernhaus und Grafenschloß.  In 1909, he played the title role in Der Kleine Detektiv ('The Little Detective')...", died:date('1991-12-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tTYAnUtdmdn1KXS8rod1BNVGAX4.jpg", url:"https://themoviedb.org/person/2313"}}, {tmdbId:"111871", properties:{bornIn:"USA", imdbId:"0424830", born:date('1974-09-24'), name:"Craigus R. Johnson", url:"https://themoviedb.org/person/111871"}}, {tmdbId:"111872", properties:{bornIn:"St. Louis, Missouri, USA", imdbId:"0552385", born:date('1909-07-23'), name:"Helen Martin", bio:"From Wikipedia, the free encyclopedia\n\nHelen Dorothy Martin (July 23, 1909 – March 25, 2000) was an American actress of stage and television who is perhaps most well known for her role in the sitcom 227 as Marla Gibbs' neighbor Pearl. \n\nMartin was born in St.  Louis, Missouri, the daughter of Amanda Frankie (née Fox) and William Martin, a minister. \n\nMartin was a Broadway character actress for many decades, debuting in Orson Welles' production of Native Son in 1941...", died:date('2000-03-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q8Wcklz1nAHTjCDTvqX2Sih7are.jpg", url:"https://themoviedb.org/person/111872"}}, {tmdbId:"44822", properties:{bornIn:"Philadelphia, Pennsylvania, USA", imdbId:"0210915", born:date('1941-07-18'), name:"Starletta DuPois", url:"https://themoviedb.org/person/44822"}}, {tmdbId:"146102", properties:{imdbId:"0854842", name:"Rujun Ten", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wxp5G5azBz7dGcHVfWyaQtV2iPI.jpg", url:"https://themoviedb.org/person/146102"}}, {tmdbId:"142729", properties:{bornIn:"UK", imdbId:"0723579", born:date('1976-08-16'), name:"Sebastian Rice-Edwards", bio:"Sebastian Rice-Edwards was born in the UK...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pdkGE8NMiiwVzZqfA0tlqQRkY3l.jpg", url:"https://themoviedb.org/person/142729"}}, {tmdbId:"142730", properties:{imdbId:"0611356", name:"Geraldine Muir", url:"https://themoviedb.org/person/142730"}}, {tmdbId:"119941", properties:{bornIn:"Erie, Pennsylvania, USA", imdbId:"0823206", born:date('1952-02-16'), name:"Jonathan Stark", url:"https://themoviedb.org/person/119941"}}, {tmdbId:"74086", properties:{bornIn:"New York City, New York, USA", imdbId:"0005175", born:date('1956-01-20'), name:"Bill Maher", bio:"From Wikipedia, the free encyclopedia. \n\nWilliam \"Bill\" Maher, Jr.  (born January 20, 1956) is an American stand-up comedian, television host, political commentator, author and actor.  Before his current role as the host of HBO's Real Time with Bill Maher, Maher hosted a similar late-night talk show called Politically Incorrect originally on Comedy Central and later on ABC...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sVTF90nhXB3jIw05eJFklbGpnlC.jpg", url:"https://themoviedb.org/person/74086"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"3266", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0001505", born:date('1947-11-13'), name:"Joe Mantegna", bio:"​From Wikipedia, the free encyclopedia\n\nJoseph Anthony “Joe” Mantegna, Jr.  (born November 13, 1947) is an American actor, producer, writer and director.  He is best known for his roles in box-office hits such as Three Amigos (1986), The Godfather Part III (1990), Forget Paris (1995) and Up Close &amp; Personal (1996).  He currently stars in the CBS television series Criminal Minds as FBI Special Agent David Rossi...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2MxHhMasaSRXoWdBafPxeeuhik7.jpg", url:"https://themoviedb.org/person/3266"}}, {tmdbId:"9628", properties:{bornIn:" Chicago, Illinois, U.S.", imdbId:"0638276", born:date('1923-12-29'), name:"Mike Nussbaum", bio:"​From Wikipedia, the free encyclopedia.   \n\nMichael Nussbaum (born December 29, 1923) is an American actor and director. \n\nFrom the start of his acting career in the 1950s, Nussbaum has appeared in many of David Mamet's plays both on and off Broadway, as well as in Chicago.  His appearances in movies include roles in Field of Dreams (1989) and Men In Black (1997). \n\nIn 1997 he received a Jeff Award for his performance as Reverend Lionel Espy in David Hare's Racing Demon...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7mg6l8P5Tu8EZysHrfsP8kdScyV.jpg", url:"https://themoviedb.org/person/9628"}}, {tmdbId:"1620", properties:{bornIn:"Ipoh, Perak, Malaysia", imdbId:"0000706", born:date('1962-08-06'), name:"Michelle Yeoh", bio:"Michelle Yeoh Choo-Kheng is a Hong Kong-based Malaysian actress and dancer, well known for performing her own stunts in the action films that brought her to fame in the early 1990s. \n\nBorn in Ipoh, Malaysia, she is based in Hong Kong and was chosen by People magazine as one of the 50 Most Beautiful People in the World in 1997...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4QwqaHmkIXn0zlWgI4nwdQmil8J.jpg", url:"https://themoviedb.org/person/1620"}}, {tmdbId:"74375", properties:{bornIn:"Wilmington, Delaware, USA", imdbId:"0001686", born:date('1957-03-08'), name:"Cynthia Rothrock", bio:"Cynthia Rothrock was born on March 8, 1957 in Wilmington, Delaware, USA as Cynthia Ann Christine Rothrock.  She is an actress and producer, known for Undefeatable (1993), Huang jia shi jie (1985) and Above the Law (1986)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fXYqlA44ETISZURB1iNUKGgQYee.jpg", url:"https://themoviedb.org/person/74375"}}, {tmdbId:"116906", properties:{bornIn:"Enping, Jiangmen, China", imdbId:"0762632", born:date('1952-01-01'), name:"John Sham", bio:"John Shum Kin-Fun (Chinese: 岑建勳) is a Hong Kong actor and film producer.  His English name is sometimes written as John Sham.  Whilst known primarily for his comedic acting roles in Hong Kong cinema, he also spent time as a political activist.  He is easily recognisable from his spectacles and curly hair...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j4mvjRvZPjHSWNRwUtM39ZI5Sbi.jpg", url:"https://themoviedb.org/person/116906"}}, {tmdbId:"83556", properties:{bornIn:"Hong Kong, British Crown Colony [now China]", imdbId:"0389885", born:date('1958-05-01'), name:"Hoi Mang", bio:"Mang Hoi (Chinese: 孟海) was another important member of Sammo Hung's stunt team during the 80’s – and often worked with Jackie Chan and Yuen Biao in their films as well.  Like most of that stunt group, he alternated between stunt work for other actors and appearing in front of the camera as a character.  He did have a few major roles though in his career.    With his cherubic face and small stature and seemingly good nature he has been very popular with HK film fans...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ehUNdTvCa9e5b8Q09JSJT3CWYJ2.jpg", url:"https://themoviedb.org/person/83556"}}, {tmdbId:"15915", properties:{bornIn:"Grumo Appula, Puglia, Italy", imdbId:"0748207", born:date('1959-12-21'), name:"Sergio Rubini", bio:"An Italian actor and film director and writer, known for The Passion of the Christ (2004), The Station (1990) and Our Land (2006).  He was previously married to Margherita Buy...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v41w5OIjoRRjYjMrY94qcMkHalH.jpg", url:"https://themoviedb.org/person/15915"}}, {tmdbId:"103121", properties:{bornIn:"Roma, Italia", imdbId:"0690743", born:date('1964-02-29'), name:"Antonella Ponziani", bio:"Antonella Ponziani is an Italian stage and screen actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tkr3elMQzpKmyof5VSQtKrJmShg.jpg", url:"https://themoviedb.org/person/103121"}}, {tmdbId:"232877", properties:{imdbId:"0576862", name:"Maurizio Mein", url:"https://themoviedb.org/person/232877"}}, {tmdbId:"232879", properties:{imdbId:"0510094", name:"Paola Liguori", url:"https://themoviedb.org/person/232879"}}, {tmdbId:"16215", properties:{bornIn:"Pequannock, New Jersey, USA", imdbId:"0949744", born:date('1958-09-29'), name:"Karen Young", bio:"Karen Young (born 29 September 1958) is an American actress. \n\nBorn in Pequannock Township, New Jersey, Young studied at Rutgers University.  After graduation she moved to New York City and became an actress, appearing in such films as 9½ Weeks, Jaws: The Revenge, Daylight, Mercy and Hoffa.  Her ex-husband is Tom Noonan.  Young portrayed FBI Agent Robyn Sanseverino on The Sopranos and has portrayed various characters for the Law & Order franchise...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aDFDZj0zLHDiv0vV8N8CKg48A6q.jpg", url:"https://themoviedb.org/person/16215"}}, {tmdbId:"38560", properties:{bornIn:"Subic Bay Naval Base, Olongapo City, Zambales, Philippines", imdbId:"0001617", born:date('1962-02-17'), name:"Lou Diamond Phillips", bio:"Lou Diamond Phillips is an American film, television, and stage actor.  His breakthrough came when he starred in the film La Bamba.  He earned a supporting actor Golden Globe Award nomination for his role in Stand and Deliver and a Tony Award nomination for his role in The King and I.  Other notable films in which Phillips has starred include Courage Under Fire, Che, and Love Takes Wing...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vCGuntNWoqwO2OdoP5qzJ3O4imp.jpg", url:"https://themoviedb.org/person/38560"}}, {tmdbId:"65344", properties:{bornIn:"Brooklyn, New York City, New York, USA", imdbId:"0005246", born:date('1962-10-01'), name:"Esai Morales", bio:"Esai Morales (born October 1, 1962) is an American actor known for his role as Bob Valenzuela in La Bamba.  He also appeared in American Family and on Resurrection Blvd.  In television, he would perhaps be best known for his roles on NYPD Blue and Caprica...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kXQW3Uu8MnbIsPBzYNYDxFgDIDg.jpg", url:"https://themoviedb.org/person/65344"}}, {tmdbId:"2111", properties:{bornIn:" San Jose, California, USA", imdbId:"0221554", born:date('1950-09-02'), name:"Rosanna DeSoto", bio:"​From Wikipedia, the free encyclopedia.     Rosanna DeSoto (born September 2, 1950) is a Mexican-American actress who has performed in films and television.  She is best known for her role in Star Trek VI: The Undiscovered Country as Azetbur, the daughter of Klingon Chancellor Gorkon.  Her other film roles include La Bamba (1987) as Ritchie Valens' mother Connie Valenzuela; Stand and Deliver (1988); and Family Business (1989) as the wife of Vito McMullen (Dustin Hoffman)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4HBpM6uAUodMBiP5W6hQOugNwkK.jpg", url:"https://themoviedb.org/person/2111"}}, {tmdbId:"11389", properties:{bornIn:"Hong Kong", imdbId:"0518821", born:date('1952-10-13'), name:"John Lone", bio:"From Wikipedia, the free encyclopedia. \n\nJohn \"Johnny\" Lone  is a Hong Kong born American actor of Chinese and English descent.  Lone has played roles as diverse as a caveman in Iceman (1984), the last Emperor of China in The Last Emperor (1987), and an apparently female opera performer in M.  Butterfly (1993). \n\nDescription above from the Wikipedia article John Lone, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/r1AvQxu8gbqjTYjiTutLW88YEXa.jpg", url:"https://themoviedb.org/person/11389"}}, {tmdbId:"11394", properties:{bornIn:"Beijing, China", imdbId:"0948078", born:date('1929-06-21'), name:"Ruocheng Ying", died:date('2003-12-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mm7Cnlu5GKvNljPFSPRSXDTY0rl.jpg", url:"https://themoviedb.org/person/11394"}}, {tmdbId:"3063", properties:{bornIn:"London, England, UK", imdbId:"0842770", born:date('1960-11-05'), name:"Tilda Swinton", bio:"Katherine Mathilda \"Tilda\" Swinton (born 5 November 1960) is a British actress known for both arthouse and mainstream films.  She won the Academy Award for Best Supporting Actress for her performance in Michael Clayton...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gWbX3a7V2MgRMRzekfITNcb27xV.jpg", url:"https://themoviedb.org/person/3063"}}, {tmdbId:"1050726", properties:{bornIn:"Liverpool, England", imdbId:"0500293", born:date('1963-01-01'), name:"Spencer Leigh", bio:"Born in Liverpool, Spencer Leigh is an actor who first came to prominence in the 1980s as Icky Higson in the Willy Russell series One Summer.  Face Magazine called him one of the Brit Pack actors, alongside the likes of Tim Roth, Colin Firth and Gary Oldman, tipping him for international fame.  However Leigh favoured arthouse overall, and worked almost exclusively with Derek Jarman in a series of the auteur's films from the mid '80s through to his death...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/YZLWvqXDu8Th4YbTHW5sIeN40t.jpg", url:"https://themoviedb.org/person/1050726"}}, {tmdbId:"1359568", properties:{imdbId:"0041597", name:"'Spring' Mark Adley", url:"https://themoviedb.org/person/1359568"}}, {tmdbId:"26683", properties:{imdbId:"0564121", name:"Gerrard McArthur", url:"https://themoviedb.org/person/26683"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"9995", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0000415", born:date('1965-10-28'), name:"Jami Gertz", bio:"From Wikipedia, the free encyclopedia.  Jami Beth Gertz (born October 28, 1965) is an American actress.  Gertz is known for her early roles in the films The Lost Boys, Quicksilver, Less Than Zero, the 1980s TV series Square Pegs with Sarah Jessica Parker, and 1996's Twister, as well as for her role as Judy Miller in the CBS sitcom Still Standing with Mark Addy. \n\nDescription above from the Wikipedia article  Jami Gertz, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9O3hOr7tPShjmLNupTEdMCfjhK6.jpg", url:"https://themoviedb.org/person/9995"}}, {tmdbId:"3223", properties:{bornIn:"Manhattan, New York City, New York, USA", imdbId:"0000375", born:date('1965-04-04'), name:"Robert Downey Jr.", bio:"Robert John Downey Jr.  (born April 4, 1965) is an American actor and producer.  Downey made his screen debut in 1970, at the age of five, when he appeared in his father's film Pound, and has worked consistently in film and television ever since.  He received two Academy Award nominations for his roles in films Chaplin (1992) and Tropic Thunder (2008). \n\nDowney Jr.  is most known for his role in the Marvel Cinematic Universe as Tony Stark/Iron Man...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5qHNjhtjMD4YWH3UP0rm4tKwxCL.jpg", url:"https://themoviedb.org/person/3223"}}, {tmdbId:"13548", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0000652", born:date('1960-02-07'), name:"James Spader", bio:"James Todd Spader (born February 7, 1960) is an American actor best known for his eccentric roles in movies such as Pretty in Pink; Sex, Lies, and Videotape; Crash; Stargate; and Secretary.  His most famous television role is that of the colorful attorney Alan Shore from The Practice and its spin-off Boston Legal, for which he won three Emmy Awards...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vNreWTzTOOnLiIL4FjVrXqhlsOT.jpg", url:"https://themoviedb.org/person/13548"}}, {tmdbId:"34629", properties:{bornIn:"Madrid, Madrid, Spain", imdbId:"0690303", born:date('1947-09-15'), name:"Eusebio Poncela", bio:"Eusebio Poncela  (Madrid, 15 September 1947) is a Spanish actor. \n\nHis debut on stage was with\"Mariana Pineda\". \n\nIn 1969 appears on screen for first time in \"Fuenteovejuna\", but his first notable role was the protagonist of the Spanish cult movie Arrebato (1979), directed by Iván Zulueta. \n\nAnother hit was TVE miniserie Los gozos y las sombras (1985).  He was the protagonist of La ley del deseo by Pedro Almodóvar. \n\nHe came back to cinema with Martín (Hache), by Adolfo Aristarain...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pCbXRk44XYJzWDzYybAco5dlGF7.jpg", url:"https://themoviedb.org/person/34629"}}, {tmdbId:"2744", properties:{bornIn:"Madrid, Spain", imdbId:"0560962", born:date('1945-09-15'), name:"Carmen Maura", bio:"Carmen García Maura (born September 15, 1945) is a Spanish actress.  In a career that has spanned six decades, Maura is best known for her collaborations with noted Spanish film director Pedro Almodóvar...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/s2FYOvC6z48BHEJcVtztGE2roXz.jpg", url:"https://themoviedb.org/person/2744"}}, {tmdbId:"34792", properties:{bornIn:" Madrid, Spain", imdbId:"0596750", born:date('1963-11-27'), name:"Miguel Molina", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x2nmTfsnLGYRkpRDWH2O9JPyozG.jpg", url:"https://themoviedb.org/person/34792"}}, {tmdbId:"21730", properties:{imdbId:"0005053", born:date('1958-09-22'), name:"Joan Jett", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uTAMNcNDBaJQINGtOr9DTBEqB9T.jpg", url:"https://themoviedb.org/person/21730"}}, {tmdbId:"10669", properties:{bornIn:"Colwyn Bay, Wales, UK", imdbId:"0001096", born:date('1946-03-21'), name:"Timothy Dalton", bio:"Timothy Peter Dalton (born 21 March 1946) is a Welsh actor of film and television. He is known for portraying James Bond in The Living Daylights (1987) and Licence to Kill (1989), as well as Rhett Butler in the television miniseries Scarlett (1994), an original sequel to Gone with the Wind...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iF4C63jae3N33pCQmCXEJHKTN0t.jpg", url:"https://themoviedb.org/person/10669"}}, {tmdbId:"10670", properties:{bornIn:"London, England, UK", imdbId:"0001881", born:date('1960-12-27'), name:"Maryam d'Abo", bio:"​From Wikipedia, the free encyclopedia.   \n\nMaryam d'Abo (born 27 December 1960) is an English film and television actress, best known as Bond girl Kara Milovy in the 1987 James Bond film The Living Daylights. \n\nDescription above from the Wikipedia article Maryam d'Abo , licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x6THDm1gG2ft7w1D8oy8BSNn5Dv.jpg", url:"https://themoviedb.org/person/10670"}}, {tmdbId:"12261", properties:{bornIn:"Queens, New York, USA", imdbId:"0000574", born:date('1966-06-17'), name:"Jason Patric", bio:"An American film, television and stage actor.  He may be best-known for his roles in the films The Lost Boys, Sleepers, Your Friends & Neighbors, Narc, The Losers and Speed 2: Cruise Control.  His father is the actor/playwright Jason Miller.  Patric is the maternal grandson of Jackie Gleason...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ym2R4xqfRl9GBQVDZ7OoDgAuKg7.jpg", url:"https://themoviedb.org/person/12261"}}, {tmdbId:"37042", properties:{bornIn:"Charleston, West Virginia, U.S", imdbId:"0005174", born:date('1956-01-04'), name:"Ann Magnuson", bio:"From Wikipedia, the free encyclopedia. \n\nAnn Magnuson (born January 4, 1956) is an American actress, performance artist, and nightclub performer who first gained prominence in the 1985 film Desperately Seeking Susan.  The New York Times described her as \"An endearing theatrical chameleon who has as many characters at her fingertips as Lily Tomlin does\". \n\nDescription above from the Wikipedia article Ann Magnuson, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lAkgpA7qbyVL4Y9kFmAyefezNUY.jpg", url:"https://themoviedb.org/person/37042"}}, {tmdbId:"21104", properties:{bornIn:"New London, Connecticut, USA", imdbId:"0000444", born:date('1955-03-13'), name:"Glenne Headly", bio:"Glenne Aimee Headly (born March 13, 1955 -June 8, 2017) was an American actress of film, stage and television. \n\nDescription above from the Wikipedia article Glenne Headly, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2017-06-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v1uqgxYG3grfF7s7sky8B9oufzP.jpg", url:"https://themoviedb.org/person/21104"}}, {tmdbId:"173172", properties:{bornIn:"Corvallis, Oregon, USA", imdbId:"0557653", born:date('1947-05-06'), name:"Ben Masters", bio:"Ben Masters was born on May 6, 1947 in Corvallis, Oregon, USA.  He is an actor, known for Passions (1999), Spy Game (1997) and Noble House (1988)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9rqrhEPGgacVebCOb5EkhCiTa6f.jpg", url:"https://themoviedb.org/person/173172"}}, {tmdbId:"16644", properties:{bornIn:"Stockholm, Sweden", imdbId:"0000185", born:date('1957-11-03'), name:"Dolph Lundgren", bio:"Hans \"Dolph\" Lundgren (born 3 November 1957) is a Swedish actor, director, screenwriter, producer, and martial artist. \n\nLundgren received a degree in chemistry from Washington State University, a degree in chemical engineering from the Royal Institute of Technology in the early 1980s, and a master's degree in chemical engineering from the University of Sydney in 1982.  He holds the rank of 3rd dan black belt in Kyokushin karate and was European champion in 1980-81...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kfb7pPxqqY56bClSPyYCSIK4vgC.jpg", url:"https://themoviedb.org/person/16644"}}, {tmdbId:"12659", properties:{bornIn:"Millsboro, Pennsylvania, USA", imdbId:"0000863", born:date('1924-10-25'), name:"Billy Barty", bio:"From Wikipedia, the free encyclopedia\n\nBilly Barty (born William John Bertanzetti, October 25, 1924 – December 23, 2000) was an American actor and activist.  In adult life, he stood 3 feet, 9 inches (1. 14 m) tall, due to cartilage–hair hypoplasia dwarfism, and because of his short stature he was often cast in movies opposite taller performers for comic effect.  He specialized in outspoken or wisecracking characters...", died:date('2000-12-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tsOruE36mrteBfVSFsegoJBSFQS.jpg", url:"https://themoviedb.org/person/12659"}}, {tmdbId:"2955", properties:{bornIn:"Kansas City, Missouri, USA", imdbId:"0177933", born:date('1951-07-09'), name:"Chris Cooper", bio:"Christopher W.  \"Chris\" Cooper (born July 9, 1951) is an American film actor.  He became well known in the late 1990s, having appeared in supporting performances in several major Hollywood films, including The Bourne Identity, American Beauty, Capote, The Town, The Kingdom, Syriana, October Sky, Seabiscuit, and Adaptation, for which he won both the Academy Award and Golden Globe Award for Best Supporting Actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wgNjo087dl4lR2PqKnL0Q6hSOfG.jpg", url:"https://themoviedb.org/person/2955"}}, {tmdbId:"1581", properties:{bornIn:"Wilkes-Barre, Pennsylvania, USA", imdbId:"0001521", born:date('1952-04-28'), name:"Mary McDonnell", bio:"Mary Eileen McDonnell (born April 28, 1952) is an American film, stage, and television actress.  She received an Academy Award nomination for her role as Stands With A Fist in Dances with Wolves, and she is also very well known for her performance as President Laura Roslin in Battlestar Galactica, the President's wife in Independence Day, and for her starring role in Donnie Darko as the title character's mother...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xN4bALzSYwFm1MkdgqGV64MhUto.jpg", url:"https://themoviedb.org/person/1581"}}, {tmdbId:"77080", properties:{bornIn:"Louisville, Kentucky, USA", imdbId:"0646165", born:date('1970-01-21'), name:"Will Oldham", bio:"Will Oldham (born December 24, 1970), better known by the stage name Bonnie 'Prince' Billy, is an American singer-songwriter and actor.  From 1993 to 1997, he performed and recorded under variations of the Palace name, including the Palace Brothers, Palace Songs, and Palace Music.  After releasing material under his own name, he adopted the \"Bonnie 'Prince' Billy\" moniker for the majority of his output since 1998...", url:"https://themoviedb.org/person/77080"}}, {tmdbId:"11064", properties:{bornIn:"San Francisco, California, USA", imdbId:"0000657", born:date('1949-01-26'), name:"David Strathairn", bio:"An American film and television actor, best known for his portrayal of journalist Edward R.  Murrow in the feature film \"Good Night, and Good Luck\", for which he was nominated for an Academy Award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fhkvTcrCDPTAclTnE7sqQS1NZKq.jpg", url:"https://themoviedb.org/person/11064"}}, {tmdbId:"42627", properties:{bornIn:"Rangoon, Burma. [now Yangôn, Myanmar]", imdbId:"0928134", born:date('1958-02-20'), name:"James Wilby", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xD9TpfcPFfyesaegyhp2tTKe6g6.jpg", url:"https://themoviedb.org/person/42627"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"3291", properties:{bornIn:"London, England, UK", imdbId:"0000424", born:date('1960-09-09'), name:"Hugh Grant", bio:"Hugh John Mungo Grant (born 9 September 1960) is an English actor and film producer.  He has received a Golden Globe Award, a BAFTA, and an Honorary César.  His movies have also earned more than $2. 4 billion from 25 theatrical releases worldwide.  Grant achieved international stardom after appearing in Richard Curtis's sleeper hit Four Weddings and a Funeral (1994)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/A0ta3PuDF1imtWBV0Ff1rXMXQUv.jpg", url:"https://themoviedb.org/person/3291"}}, {tmdbId:"11278", properties:{bornIn:"Weston-super-Mare, Somerset, England, UK", imdbId:"0001291", born:date('1963-06-30'), name:"Rupert Graves", bio:"From Wikipedia, the free encyclopedia. \n\nRupert Graves (born 30 June 1963) is an English film, television and theatre actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6tS8XMuTS04xXTfeWFjJED6SFBF.jpg", url:"https://themoviedb.org/person/11278"}}, {tmdbId:"36172", properties:{bornIn:"\tToronto, Ontario, Canada", imdbId:"0915382", born:date('1935-03-02'), name:"Al Waxman", died:date('2001-01-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7nvvodM6mqMHPVzGQBIIG34pjsp.jpg", url:"https://themoviedb.org/person/36172"}}, {tmdbId:"189624", properties:{name:"Isabelle Mejias", url:"https://themoviedb.org/person/189624"}}, {tmdbId:"94490", properties:{imdbId:"0332967", born:date('1973-04-27'), name:"Andre Gower", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ezjLdoyrzj5J60oI1QypnfEScwx.jpg", url:"https://themoviedb.org/person/94490"}}, {tmdbId:"94491", properties:{bornIn:"Encino, California, USA", imdbId:"0452701", born:date('1973-06-11'), name:"Robby Kiger", url:"https://themoviedb.org/person/94491"}}, {tmdbId:"41274", properties:{bornIn:"Philadelphia - Pennsylvania - USA", imdbId:"0532685", born:date('1942-05-01'), name:"Stephen Macht", bio:"From Wikipedia, the free encyclopedia. \n\nStephen Robert Macht is an American television and film actor.   Spotted by a Universal Studios talent scout while starring at the Stratford Shakespeare Festival in Canada in 1975, Macht was signed to a contract and by the mid 1970s had left teaching and was making frequent appearances in TV episodes and movies. \n\nIn Raid on Entebbe, he portrayed Yoni Netanyahu, the Israeli officer killed in the rescue of hostages in Uganda...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6FTqfNoPKfnRhD2HkH3MqPpH5eA.jpg", url:"https://themoviedb.org/person/41274"}}, {tmdbId:"94492", properties:{bornIn:"Lethbridge, Alberta, Canada", imdbId:"0716516", born:date('1952-10-05'), name:"Duncan Regehr", bio:"​From Wikipedia, the free encyclopedia.   \n\nDuncan Peter Regehr (born October 5, 1952) is a Canadian writer, multi-media artist, and film and television actor.  He has also been a figure skater, an Olympic boxing contender, and a classically trained Shakespearean stage actor in his native Canada, before heading to Hollywood in 1980. \n\nDescription above from the Wikipedia article Duncan Regehr, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jkKDRObnVSdQV7PCUssqD804HDD.jpg", url:"https://themoviedb.org/person/94492"}}, {tmdbId:"5472", properties:{bornIn:"Grayshott, Hampshire, England, UK", imdbId:"0000147", born:date('1960-09-10'), name:"Colin Firth", bio:"Colin Andrew Firth (born 10 September 1960) is an English film, television, and stage actor.  Firth gained wide public attention in the 1990s for his portrayal of Mr.  Darcy in the 1995 television adaptation of Jane Austen's Pride and Prejudice.  In 2011, Firth received the Academy Award for Best Actor for his portrayal of King George VI in The King's Speech, a performance that also earned him the Golden Globe, BAFTA, and Screen Actors Guild Award for Best Actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5tfW4Zez6eEVOkJ8JoePGzSFbcd.jpg", url:"https://themoviedb.org/person/5472"}}, {tmdbId:"20070", properties:{bornIn:"Harrogate, Yorkshire, England, UK", imdbId:"0141697", born:date('1948-08-19'), name:"Jim Carter", bio:"From Wikipedia, the free encyclopedia\n\nJim Carter (born 19 August 1948) is an English actor. \n\nDescription above from the Wikipedia article Jim Carter (actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zAfCPOqoHGSLCGPYTGPZ74A29eM.jpg", url:"https://themoviedb.org/person/20070"}}, {tmdbId:"8979", properties:{bornIn:"Reading, Berkshire, England, UK", imdbId:"0538869", born:date('1945-03-24'), name:"Patrick Malahide", bio:"Patrick Gerald Duggan (born 24 March 1945), known professionally as Patrick Malahide, is a British actor, known for his roles as Detective Sergeant Albert Chisholm in the TV series Minder and Balon Greyjoy in the TV series Game of Thrones...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ae0AJ8FbJireYPQyglIxNucjqIy.jpg", url:"https://themoviedb.org/person/8979"}}, {tmdbId:"3019", properties:{bornIn:"Lowell, Massachusetts, USA", imdbId:"0001156", born:date('1931-06-20'), name:"Olympia Dukakis", bio:"Olympia Dukakis (born June 20, 1931) is an American actress.  In 1987, she won an Academy Award, BAFTA, and a Golden Globe for her performance in Moonstruck.  She received another Golden Globe nomination for Sinatra, and Emmy nominations for Lucky Day, More Tales of the City, and Joan of Arc...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pwoIzB9QSjKkWORQ7SpetnxFizf.jpg", url:"https://themoviedb.org/person/3019"}}, {tmdbId:"37597", properties:{imdbId:"0833627", name:"Charlie Stratton", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e0v3ndoBCRA47Q75DFTjDu9jqvj.jpg", url:"https://themoviedb.org/person/37597"}}, {tmdbId:"35875", properties:{bornIn:"\tToronto, Ontario, Canada", imdbId:"0886456", born:date('1962-05-14'), name:"Nadine Van der Velde", bio:"Nadine was born in Toronto, Ontario, Canada.  She is fluent in French.  She made her film debut in 1983 in the film Private School.  She later starred in the 1986 comedy horror Critters and 1987 film Munchies.  Her acting credits include several TV series including: Silver Spoons, Otherworld, The New Alfred Hitchcock Presents and JAG...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lMikuFbSdy4fAdlI0zdHApuOzfd.jpg", url:"https://themoviedb.org/person/35875"}}, {tmdbId:"37598", properties:{imdbId:"0253444", name:"Alix Elias", url:"https://themoviedb.org/person/37598"}}, {tmdbId:"17304", properties:{bornIn:"Pittsfield - Massachusetts - USA", imdbId:"0664499", born:date('1965-04-30'), name:"Adrian Pasdar", bio:"From Wikipedia, the free encyclopedia. \n\nAdrian Kayvan Pasdar (born April 30, 1965) is an American actor and film director.  He is known for playing Jim Profit on the TV series Profit, for his roles in Near Dark, Carlito's Way, Mysterious Ways and as Nathan Petrelli on Heroes.  Additionally, he directed the feature film Cement...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dN3ZG5Ofkivkl5WAAFSzagnqEH8.jpg", url:"https://themoviedb.org/person/17304"}}, {tmdbId:"64056", properties:{bornIn:"New York City, New York, USA", imdbId:"0942486", born:date('1962-03-23'), name:"Jenny Wright", bio:"Jennifer G.  Wright (born March 23, 1962) is an American actress who made her film debut portraying the role of Cushie in The World According to Garp in 1982.  That same year she made an appearance in Pink Floyd The Wall, playing an American groupie.  Wright had roles in both The Wild Life as Eileen and St.  Elmo's Fire as Felicia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uBY9QkFSjP8dhIqC7FoMif7X25u.jpg", url:"https://themoviedb.org/person/64056"}}, {tmdbId:"2390069", properties:{name:"Bernd Daktari Lorenz", url:"https://themoviedb.org/person/2390069"}}, {tmdbId:"2316", properties:{bornIn:"Berlin, Germany", imdbId:"0543659", born:date('1968-07-31'), name:"Beatrice Manowski", url:"https://themoviedb.org/person/2316"}}, {tmdbId:"70600", properties:{imdbId:"0526632", name:"Harald Lundt", url:"https://themoviedb.org/person/70600"}}] AS row
