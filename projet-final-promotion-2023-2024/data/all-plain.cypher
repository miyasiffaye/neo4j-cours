UNWIND [{tmdbId:"240171", properties:{bornIn:"Foshan, Guangdong province, China", imdbId:"0514904", born:date('1951-08-22'), name:"Gordon Liu Chia-Hui", bio:"Gordon Liu (劉家輝; Lau Ka-Fai; pinyin: Liu Jiahui, formerly spelled Liu Chia-Hui, birth name Xian Jinxi; born August 22, 1955) is a Chinese martial arts film actor and martial artist.  He became famous for playing the lead role of San Te in The 36th Chamber of Shaolin and its sequels.  He also played kung fu master Pai Mei in Kill Bill: Volume 2 (2004), and Johnny Mo in Kill Bill: Volume 1 (2003), the head general of the Crazy 88, O-Ren Ishii's (Lucy Liu) personal army...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hLLDmQbIi8EO0hsBbgLAswqaOrq.jpg", url:"https://themoviedb.org/person/240171"}}, {tmdbId:"70946", properties:{imdbId:"0150921", name:"Hui Lou Chen", url:"https://themoviedb.org/person/70946"}}, {tmdbId:"70947", properties:{imdbId:"0394707", born:date('1921-08-14'), name:"Tad Horino", bio:"From Wikipedia, the free encyclopedia. \n\nTadashi Horino (August 14, 1921 — October 3, 2002) was an American film and television actor...", died:date('2002-10-03'), url:"https://themoviedb.org/person/70947"}}, {tmdbId:"108074", properties:{bornIn:"Oakland, California, USA", imdbId:"0876611", born:date('1973-05-03'), name:"Jennifer Tung", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rC3vtSFo2NyFxDYl0vZmfcUvjii.jpg", url:"https://themoviedb.org/person/108074"}}, {tmdbId:"48791", properties:{bornIn:"Belgrade, Serbia", imdbId:"0543547", born:date('1950-04-05'), name:"Miki Manojlović", bio:"Predrag \"Miki\" Manojlović ( (Serbian Cyrillic: Предраг \"Мики\" Манојловић; born April 5, 1950, Belgrade, Federal People's Republic of Yugoslavia) is a Serbian actor, famous for his starring roles in some of the most important films of former Yugoslav cinema.  Since the early 1990s, he successfully branched out into movies made outside the Balkans, meaning that he's currently active in productions all over Europe...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tRRvs3G1IZYCPnqWBgb0Q0zdYTI.jpg", url:"https://themoviedb.org/person/48791"}}, {tmdbId:"65354", properties:{bornIn:"Taipei, Taiwan", imdbId:"0945992", born:date('1959-09-06'), name:"Yang Kuei-Mei", bio:"From Wikipedia, the free encyclopedia. \n\nYang Kuei-Mei (Chinese: 楊貴媚; pinyin: Yáng Guìmèi; born September 6, 1959 in Taipei, Taiwan) is a Taiwanese actress.  She has had starring roles in Eat Drink Man Woman, Vive L'Amour and The Hole. \n\nDescription above from the Wikipedia article Kuei-Mei Yang, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/73x9ahXS9OpvuIn8o0vEPz8H4pp.jpg", url:"https://themoviedb.org/person/65354"}}, {tmdbId:"71172", properties:{imdbId:"0150940", born:date('1968-11-01'), name:"Chen Chao-jung", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/exEFnrh8JigB5ybfUlG7CoL43RK.jpg", url:"https://themoviedb.org/person/71172"}}, {tmdbId:"99689", properties:{bornIn:"Nanchang，Jiangxi Province，China", imdbId:"2874732", born:date('1979-02-08'), name:"Deng Chao", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/k2pylMn5jG6z3KGrQOXP473ULNK.jpg", url:"https://themoviedb.org/person/99689"}}, {tmdbId:"71219", properties:{bornIn:"Moscow, USSR", imdbId:"1076060", born:date('1989-08-14'), name:"Artyom Bogucharsky", url:"https://themoviedb.org/person/71219"}}, {tmdbId:"86107", properties:{bornIn:"Wallasey, Merseyside, England, UK", imdbId:"0400616", born:date('1944-02-02'), name:"Geoffrey Hughes", bio:"Geoffrey Hughes DL was an English actor.  Hughes provided the voice of Paul McCartney in the animated film Yellow Submarine, and rose to fame for portraying much-loved binman Eddie Yeats in the long-running British soap opera Coronation Street from 1974 to 1983, making a return to the show in 1987...", died:date('2012-07-27'), url:"https://themoviedb.org/person/86107"}}, {tmdbId:"71648", properties:{bornIn:"Budapest, Austria-Hungary (now Hungary)", imdbId:"0073472", born:date('1876-01-24'), name:"Oscar Beregi Sr.", bio:"From Wikipedia, the free encyclopedia\n\nOscar Beregi, Sr.  (born Beregi Oszkár, 24 January 1876 – 18 October 1965) was a Hungarian film actor.  He appeared in 27 films between 1916 and 1953. \n\nHe was born in Budapest, Hungary and died in Hollywood, California.  He was the father of actor Oscar Beregi, Jr. \n\nDescription above from the Wikipedia article Oscar Beregi, Sr. , licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1965-10-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ktBvBRP1d2s3YsVd2osbr1f5hwX.jpg", url:"https://themoviedb.org/person/71648"}}, {tmdbId:"72170", properties:{imdbId:"2000380", name:"Samuel Berkowitz", url:"https://themoviedb.org/person/72170"}}, {tmdbId:"1622", properties:{bornIn:"Taipei, Taiwan", imdbId:"0151654", born:date('1976-10-14'), name:"Chang Chen", bio:"Chang Chen (born October 14, 1976) is a Taiwanese actor, born in Taipei, Taiwan.  His name is sometimes seen in the Western order (Chen Chang)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yUXlmRmq2ryLZdGJbKCdgwNBVPm.jpg", url:"https://themoviedb.org/person/1622"}}, {tmdbId:"1294946", properties:{imdbId:"5872161", born:date('1965-01-29'), name:"Cho Min-soo", bio:"Cho Min-soo (조민수) is a South Korean actress.  She is best known for her award-winning turn in the Kim Ki-duk film Pietà...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1dC0ZRTWlvFEcDk4O6peI97zsVM.jpg", url:"https://themoviedb.org/person/1294946"}}, {tmdbId:"1162595", properties:{bornIn:"South Korea", imdbId:"1159414", born:date('1973-01-09'), name:"Woo Ki-Hong", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rwFeJ97RkOUK3bBfdh9dKdjcVEL.jpg", url:"https://themoviedb.org/person/1162595"}}, {tmdbId:"582020", properties:{name:"Christian Aaron Boulogne", url:"https://themoviedb.org/person/582020"}}, {tmdbId:"2201905", properties:{name:"Sherry Sibley", url:"https://themoviedb.org/person/2201905"}}, {tmdbId:"167494", properties:{bornIn:"San Antonio - Texas - USA", imdbId:"0636048", born:date('1943-10-07'), name:"Oliver North", url:"https://themoviedb.org/person/167494"}}, {tmdbId:"1304441", properties:{imdbId:"0730189", name:"Chuck Robb", url:"https://themoviedb.org/person/1304441"}}, {tmdbId:"116180", properties:{bornIn:"Jangseong, South Jeolla, South Korea", imdbId:"1322404", born:date('1942-06-08'), name:"Byun Hee-bong", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bhARv1QDxjcX1Q7n2y3ZniUXkgB.jpg", url:"https://themoviedb.org/person/116180"}}] AS row
