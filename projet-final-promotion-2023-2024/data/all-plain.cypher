UNWIND [{tmdbId:"1624609", properties:{name:"Sarah Ellison", url:"https://themoviedb.org/person/1624609"}}, {tmdbId:"1624610", properties:{name:"Larry Ingrassia", url:"https://themoviedb.org/person/1624610"}}, {tmdbId:"553505", properties:{bornIn:"\tMinnesota, USA", imdbId:"2551033", name:"David Carr", bio:"From Wikipedia, the free encyclopedia. \n\nDavid Carr is a media and culture columnist for the New York Times.  His 2008 memoir, The Night of the Gun, details his past experiences with cocaine addiction.  The memoir was excerpted in the New York Times Magazine, published early, and was an instant best seller.  In it, David Carr interviews people from his past, tackling his memoir as if he were reporting on himself...", url:"https://themoviedb.org/person/553505"}}, {tmdbId:"1624612", properties:{name:"Dennis Crowley", url:"https://themoviedb.org/person/1624612"}}, {tmdbId:"57578", properties:{bornIn:"Sundsvall, Västernorrlands län, Sweden", imdbId:"1769728", born:date('1979-09-22'), name:"MyAnna Buring", bio:"MyAnna Buring is a Swedish-born British actress, known for her roles in The Descent, The Twilight Saga: Breaking Dawn – Part 1 and Part 2, Ripper Street and Downton Abbey...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/boC5LKewKpz8zhtUmPScHfkSAlV.jpg", url:"https://themoviedb.org/person/57578"}}, {tmdbId:"524107", properties:{imdbId:"4207396", name:"Harry Simpson", url:"https://themoviedb.org/person/524107"}}, {tmdbId:"78062", properties:{bornIn:"London, England, UK", imdbId:"1543989", born:date('1985-07-30'), name:"Aml Ameen", bio:"Aml Eysan Ameen (born 30 July 1985 in London, England) is an English actor best known for his roles as Trife in Kidulthood and Lewis Hardy in The Bill. \n\nDescription above from the Wikipedia article Aml Ameen, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wQ5zWlzmhvp2wG6gJiqoocEYHPJ.jpg", url:"https://themoviedb.org/person/78062"}}, {tmdbId:"1310760", properties:{bornIn:"Seoul, South Korea", imdbId:"3859624", born:date('1986-09-30'), name:"Ki Hong Lee", bio:"Ki Hong Lee is an actor and writer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/96zkB3e07LB1hw2segekZS1PlQb.jpg", url:"https://themoviedb.org/person/1310760"}}, {tmdbId:"1389339", properties:{bornIn:"Atlanta, Georgia, USA", imdbId:"4948500", born:date('2001-01-01'), name:"Blake Cooper", bio:"Blake Cooper (born in 2001) is an American actor, best known for playing the role of Chuck in The Maze Runner.  Born in Atlanta, Georgia on a small animal farm, Blake grew up as a Boy Scout and was well acquainted with animal training.  Blake was signed to J Pervis Talent Agency by Joy Pervis when he was 10, after being seen performing at a local event.  Immediately after signing, Blake auditioned and landed his first co-star on BET's The Game...", url:"https://themoviedb.org/person/1389339"}}, {tmdbId:"3497", properties:{bornIn:"Buffalo, New York, USA", imdbId:"0151419", born:date('1965-09-17'), name:"Kyle Chandler", bio:"Kyle Martin Chandler (born September 17, 1965) is an American film and television actor best known for his roles in the television shows Early Edition as Gary Hobson and as Eric Taylor in Friday Night Lights.  Description above from the Wikipedia article Kyle Chandler, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/12ycW6JwP51RJA36mbT7ietI4Ce.jpg", url:"https://themoviedb.org/person/3497"}}, {tmdbId:"1412012", properties:{bornIn:"Nevada City, California, USA", imdbId:"1827079", born:date('1982-01-18'), name:"Joanna Newsom", bio:"Joanna Caroline Newsom (born January 18, 1982) is an American multi-instrumentalist, singer-songwriter, and actress.  Born and raised in Northern California, Newsom was classically trained on the harp in her youth, and began her musical career as a keyboardist in the San Francisco–based indie band The Pleased. \n\nAfter recording and self-releasing two EPs in 2002, Newsom was signed to the independent label Drag City...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gDE5oIuCTgsz87ecl8DLtjoKqcx.jpg", url:"https://themoviedb.org/person/1412012"}}, {tmdbId:"77795", properties:{bornIn:"Westminster, London, England, UK", imdbId:"2239702", born:date('1980-03-03'), name:"Katherine Waterston", bio:"Katherine Boyer Waterston (born March 3, 1980) is an American actress.  She made her feature film debut in Michael Clayton (2007).  She then had supporting roles in films including Robot & Frank, Being Flynn (both 2012) and The Disappearance of Eleanor Rigby: Her (2013) before her leading role as Shasta Fay Hepworth in Paul Thomas Anderson's Inherent Vice (2014).  In 2015, she portrayed Chrisann Brennan in Steve Jobs...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sTRMVlpasY3EbceLNrMiYWdtqcP.jpg", url:"https://themoviedb.org/person/77795"}}, {tmdbId:"1505839", properties:{imdbId:"5713860", name:"Jordan Christian Hearn", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yNJiAAggfW7aJmwDccYWfHKA7TP.jpg", url:"https://themoviedb.org/person/1505839"}}, {tmdbId:"205797", properties:{bornIn:"New Jersey, USA", imdbId:"1978694", born:date('1974-12-29'), name:"Maria Dizzia", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vDIF9M0u9DUm6y2XWWv47YZSGwk.jpg", url:"https://themoviedb.org/person/205797"}}, {tmdbId:"125494", properties:{bornIn:"Carcarañá, Argentina", imdbId:"1682686", born:date('1973-12-08'), name:"Carlos Echevarría", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3YmZxunH3WvtCRcsG43kmVk4tYt.jpg", url:"https://themoviedb.org/person/125494"}}, {tmdbId:"1261763", properties:{imdbId:"4223773", name:"Javier De Pietro", url:"https://themoviedb.org/person/1261763"}}, {tmdbId:"125493", properties:{bornIn:"Roma, Italy", imdbId:"0182074", born:date('1980-03-19'), name:"Antonella Costa", bio:"From Wikipedia, the free encyclopedia\n\nAntonella Costa (born March 19, 1980 in Rome, Italy) is a film and television actress. \n\nShe works in different countries including the cinema of Argentina. \n\nDescription above from the Wikipedia article Antonella Costa, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l9flsMdJkbbpbi4Tm76d07qIZcl.jpg", url:"https://themoviedb.org/person/125493"}}, {tmdbId:"1271281", properties:{imdbId:"4224683", name:"Alejandro Barbero", url:"https://themoviedb.org/person/1271281"}}, {tmdbId:"87637", properties:{bornIn:"Iwata, Shizuoka Prefecture, Japan", imdbId:"0619178", born:date('1987-06-03'), name:"Masami Nagasawa", bio:"Nagasawa Masami is a Japanese actress under Toho Entertainment.  She has performed in many famous movies and television dramas including Crying out Love, In the Center of the World, Nada Sousou, Dragon Zakura and Proposal Daisakusen.  She graduated from Horikoshi High School in 2006.  She is also known as \"Ma-chan\" or as Yamashita Tomohisa calls her \"Maa-tan\".  On her radio show, she introduces herself as \"Gasawa\", a nickname chosen by fans...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p3OXEeYtEMwn1HigtMJORbab0a0.jpg", url:"https://themoviedb.org/person/87637"}}, {tmdbId:"119241", properties:{bornIn:"Hirakata, Osaka Prefecture, Japan", imdbId:"0645411", born:date('1980-11-18'), name:"Jun'ichi Okada", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3yXXQB0vn5IW63quew3le0LTPdn.jpg", url:"https://themoviedb.org/person/119241"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"548758", properties:{bornIn:"Nagoya, Aichi, Japan", imdbId:"0847580", born:date('1953-09-15'), name:"Keiko Takeshita", bio:"Keiko Takeshita (竹下景子 Takeshita Keiko; born on September 15, 1953 in Higashi-ku, Nagoya, Japan) is a Japanese actress.  She starred in the Japanese version of From Up on Poppy Hill as Hana Matsuzaki...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6CW9S4ZAozhns0UvT2GiIToFWUS.jpg", url:"https://themoviedb.org/person/548758"}}, {tmdbId:"1423519", properties:{bornIn:"New York City, New York, USA", imdbId:"4802218", born:date('2002-08-01'), name:"Oona Laurence", bio:"Oona Laurence (born August 1, 2002) is an American actress who is best known for originating the role of Matilda Wormwood in Matilda on Broadway alongside Bailey Ryon, Milly Shapiro, and Sophia Gennusa.  She is a New York City-based child actress with credits in film, theatre, and television.  After several appearances in regional theatre productions and minor roles in short films and television episodes, in 2012, Laurence auditioned for the new musical Matilda on Broadway...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/OufvM058kDQm8CVKDzRx4XuBsy.jpg", url:"https://themoviedb.org/person/1423519"}}, {tmdbId:"549831", properties:{bornIn:"New York City, New York, USA", imdbId:"1842419", born:date('1979-08-11'), name:"Lynn Adrianna Freedman", bio:"Lynn Adrianna is an American stage, film and television actress and dancer...", url:"https://themoviedb.org/person/549831"}}, {tmdbId:"154798", properties:{imdbId:"0686014", name:"Lisa Renee Pitts", url:"https://themoviedb.org/person/154798"}}, {tmdbId:"1509453", properties:{imdbId:"2415610", name:"Gabe Gomez", url:"https://themoviedb.org/person/1509453"}}, {tmdbId:"1151525", properties:{imdbId:"4562371", name:"Ashley Arbaugh", url:"https://themoviedb.org/person/1151525"}}, {tmdbId:"1151526", properties:{imdbId:"3658728", name:"Rachel Blais", url:"https://themoviedb.org/person/1151526"}}, {tmdbId:"1151528", p