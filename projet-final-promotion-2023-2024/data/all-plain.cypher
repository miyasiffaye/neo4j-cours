UNWIND [{tmdbId:"58941", properties:{imdbId:"0050594", name:"Brenda Ballard", url:"https://themoviedb.org/person/58941"}}, {tmdbId:"58942", properties:{bornIn:"Bethesda - Maryland - USA", imdbId:"1080718", born:date('1973-01-01'), name:"Will Beinbrink", bio:"From Wikipedia, the free encyclopedia. \n\nWilliam Bates Beinbrink (born September, 1973) [aka W.  Bates Beinbrink and Bill Bates] is an American actor who starred as Achilles Pumpkinseed in the romantic comedy The Watermelon, directed by Brad Mays and written by Michael Hemmingson.  He has also appeared in supporting roles in Cellular as an L. A...", url:"https://themoviedb.org/person/58942"}}, {tmdbId:"19360", properties:{bornIn:"Caen, Basse-Normandie, Calvados, France", imdbId:"0238475", born:date('1972-01-23'), name:"Léa Drucker", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lozgkjUn0YRYypjGpMVUPmbOTZC.jpg", url:"https://themoviedb.org/person/19360"}}, {tmdbId:"19361", properties:{bornIn:"France", imdbId:"0598857", born:date('1962-01-01'), name:"Thibault de Montalembert", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rlmatSXCig3KrEeTh1yKVTOZnMc.jpg", url:"https://themoviedb.org/person/19361"}}, {tmdbId:"21045", properties:{bornIn:"Honolulu - Hawaii - USA", imdbId:"0702572", born:date('1979-05-22'), name:"Maggie Q", bio:"From Wikipedia, the free encyclopedia\n\nMargaret Denise Quigley (born May 22, 1979), professionally known as Maggie Q, is an American actress, animal rights activist and former fashion model.  She achieved international fame starring as the title role on The CW's action-thriller series Nikita that aired in 2010-2013.  In 2014, she will portray the role of Tori Wu in the film adaption of Veronica Roth's bestselling novel Divergent. \n\nQuigley was born and raised in Honolulu, Hawaii...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/MC6ikXkfsyAsrK6qNDKvHCpWLj.jpg", url:"https://themoviedb.org/person/21045"}}, {tmdbId:"82581", properties:{bornIn:"Yonkers - New York - USA", imdbId:"0397394", born:date('1948-11-24'), name:"Joe Howard", bio:"Joe Howard was born on November 24, 1948 in Yonkers, New York, USA.  He is an actor and writer. \n\nwas previously married to Sharon Howard...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6D1rHVdwAhd1NNVbUIDYH6CtOsp.jpg", url:"https://themoviedb.org/person/82581"}}, {tmdbId:"82582", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"1336377", born:date('1976-04-21'), name:"Matthew Brent", url:"https://themoviedb.org/person/82582"}}, {tmdbId:"125845", properties:{bornIn:"Philadelphia, Pennsylvania, USA ", imdbId:"0633660", born:date('1950-01-12'), name:"Robert Noble", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hP0WNhULlY85TuIXvcYedFd9sHp.jpg", url:"https://themoviedb.org/person/125845"}}, {tmdbId:"213", properties:{imdbId:"0004423", name:"Gerry Robert Byrne", bio:"Gerry Robert Byrne is a production manager and actor.   He is best known as a production manager for the hit feature films Eternal Sunshine of the Spotless Mind (2004), Man on the Moon (1999), Brokeback Mountain (2005), The People vs.  Larry Flynt (1996)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yMvCVUHcq1S88h3ZWG3glpYQdzm.jpg", url:"https://themoviedb.org/person/213"}}, {tmdbId:"64210", properties:{bornIn:"Les Lilas, Seine-Saint-Denis, France", imdbId:"0494069", born:date('1976-04-17'), name:"Maïwenn", bio:"Maïwenn Le Besco is a French actress and film director, sometimes credited as Maïwenn...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hvfXWYcXipNEciDnNTI4vbuTPvM.jpg", url:"https://themoviedb.org/person/64210"}}, {tmdbId:"64211", properties:{bornIn:"Parigi, Francia", imdbId:"0451076", born:date('1968-03-09'), name:"Franck Khalfoun", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nzXKV3T7fHMBzRWzfYozVl8ZfwQ.jpg", url:"https://themoviedb.org/person/64211"}}, {tmdbId:"6979", properties:{bornIn:"Hong Kong - China", imdbId:"0304801", born:date('1982-08-06'), name:"Romola Garai", bio:"Romola Sadie Garai (born 6 August 1982) is an English actress and model.  She is known for appearing in the movies Amazing Grace, Atonement, and Glorious 39, and for appearing in the TV movie Emma...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jJzkM3TsurnDsFwVNCbWDl8GkK7.jpg", url:"https://themoviedb.org/person/6979"}}, {tmdbId:"24896", properties:{bornIn:"LaSalle, Québec, Canada", imdbId:"1234157", born:date('1966-09-17'), name:"Stéphane Rousseau", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mDJkNPVzafq4HtbaVDVM901Mx0r.jpg", url:"https://themoviedb.org/person/24896"}}, {tmdbId:"32511", properties:{bornIn:"Paris, France", imdbId:"0359652", born:date('1975-01-10'), name:"Marina Hands", bio:"From Wikipedia, the free encyclopedia. \n\nMarina Hands (born January 1977) is a French stage and film actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gpBLj4sUtBj8au0XN7LQIZSbY3E.jpg", url:"https://themoviedb.org/person/32511"}}, {tmdbId:"59176", properties:{bornIn:"Bedford, Texas, USA", imdbId:"0101799", born:date('1993-03-04'), name:"Jenna Boyd", bio:"Jenna Michelle Boyd (born March 4, 1993) is an American teen actress. \n\nDescription above from the Wikipedia article Jenna Boyd, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tDMgyuY9KwFHpmJdqyi51aGOkCe.jpg", url:"https://themoviedb.org/person/59176"}}, {tmdbId:"61283", properties:{bornIn:"Stockholm, Stockholms län, Sweden", imdbId:"1270590", born:date('1981-03-07'), name:"Andreas Wilson", bio:"​From Wikipedia, the free encyclopedia.   \n\nAndreas Axel Janota Wilson (born 7 March 1981, Stockholm, Sweden) is a Swedish actor who played the leading role in the Oscar-nominated (for best foreign movie) Evil.  He has also starred in Kill Your Darlings, Babas bilar and Den utvalde.  He was named as one of European films' \"Shooting Stars\" by the European Film Promotion in 2004.  He has been modeling for the clothing store Abercrombie &amp; Fitch...", url:"https://themoviedb.org/person/61283"}}, {tmdbId:"11050", properties:{imdbId:"0526616", born:date('1983-12-13'), name:"Henrik Lundström", url:"https://themoviedb.org/person/11050"}}, {tmdbId:"63764", properties:{bornIn:"Stockholm, Stockholm County, Sweden", imdbId:"0803890", born:date('1980-11-12'), name:"Gustaf Skarsgård", bio:"Gustaf Skarsgård (born 12 November 1980) is a Swedish film and television actor, best known for playing Floki on History Channel's television series \"Vikings\".  He's the son of actor Stellan Skarsgård and brother of actors Bill, Valter and Alexander Skarsgård...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oH2XSFil6ZHNg9HWur1ymwTLRX3.jpg", url:"https://themoviedb.org/person/63764"}}, {tmdbId:"68566", properties:{bornIn:"Helsinki, Finland", imdbId:"0350451", born:date('1977-04-25'), name:"Linda Zilliacus", url:"https://themoviedb.org/person/68566"}}, {tmdbId:"42287", properties:{bornIn:"USA", imdbId:"0366667", born:date('1969-02-05'), name:"Leslie Zemeckis", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1bUcEr76agVCsWpMDbfll78biaW.jpg", url:"https://themoviedb.org/person/42287"}}] AS row
