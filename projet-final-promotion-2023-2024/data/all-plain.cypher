UNWIND [{tmdbId:"43322", properties:{bornIn:"Barcelona, Spain", imdbId:"0590298", born:date('1968-09-13'), name:"Santi Millán", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/VlCEormyhyAXc8nam9OtJLqZMh.jpg", url:"https://themoviedb.org/person/43322"}}, {tmdbId:"74687", properties:{bornIn:"Nyack, New York, USA", imdbId:"1886524", born:date('1989-11-14'), name:"Stella Maeve", bio:"​From Wikipedia, the free encyclopedia. \n\nStella Maeve Johnston (born November 14, 1989) is a young American television and film actress.  She is best known for her roles in Gossip Girl and in the indie films Harold and Remember the Daze.  Johnston plays Sandy West in The Runaways, a 2010 biographical film, based on the 1970s all-girl rock band of the same name...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eVDO0GLQqjfeQiIJj5LDOBt6Ms.jpg", url:"https://themoviedb.org/person/74687"}}, {tmdbId:"118357", properties:{bornIn:"Valence, Drome, France", imdbId:"0152035", born:date('1978-11-14'), name:"Delphine Chanéac", bio:"Delphine Chanéac is a French model, actress and disc jockey...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wlkoqUVFHzgFzINHtwE3tKGnles.jpg", url:"https://themoviedb.org/person/118357"}}, {tmdbId:"81801", properties:{imdbId:"1682412", name:"Brandon McGibbon", url:"https://themoviedb.org/person/81801"}}, {tmdbId:"21125", properties:{bornIn:"North Trenton, New Jersey, USA", imdbId:"0454236", born:date('1956-11-22'), name:"Richard Kind", bio:"Richard John Kind is an American actor known for his roles in the sitcoms Mad About You and Spin City...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yWmuVQeQUzb5OSMVDoWkR0IylCK.jpg", url:"https://themoviedb.org/person/21125"}}, {tmdbId:"105303", properties:{bornIn:"New York City, New York, USA", imdbId:"0577329", born:date('1956-05-13'), name:"Fred Melamed", bio:"An American actor and writer.  He was born in New York City, and received his theatrical training at Hampshire College and the Yale School of Drama.  At Yale, he was a Samuel F.  B.  Morse College Graduate Fellow.  He was also a nominee for the Irene Ryan Award, a prize conferred upon the most promising young actors in the United States.  While still at Yale, he was an instructor at the well-known performing arts camp, Stagedoor Manor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cb5HSNuu6n4OVuxxQCDd5CfEocb.jpg", url:"https://themoviedb.org/person/105303"}}, {tmdbId:"105304", properties:{bornIn:"Miami, Florida, USA", imdbId:"3102689", name:"Sari Lennick", bio:"From Wikipedia, the free encyclopedia. \n\nSari Wagner Lennick is an American actress.  She is one of the stars of the Coen brothers 2009 film A Serious Man.  Her previous work has been in theatre.  She has performed at the Edinburgh Festival Fringe. \n\nLennick was born and raised in Miami, Florida. \n\nDescription above from the Wikipedia article Sari Lennick, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/105304"}}, {tmdbId:"37158", properties:{bornIn:"London, England, UK", imdbId:"0252238", born:date('1974-01-01'), name:"Carmen Ejogo", bio:"Carmen Elizabeth Ejogo (born 1 January 1974) is an British actress, currently based in the United States...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pJkBfxuifYtuigcjM8qnvNklZNX.jpg", url:"https://themoviedb.org/person/37158"}}, {tmdbId:"2033010", properties:{bornIn:"Scotland, UK", imdbId:"2740716", name:"Jim France", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4ouJIrB8ZOuSIgX6h78UQFFJ2Uw.jpg", url:"https://themoviedb.org/person/2033010"}}, {tmdbId:"17288", properties:{bornIn:"Heidelberg, Baden-Wurttemburg, Germany", imdbId:"1055413", born:date('1977-04-02'), name:"Michael Fassbender", bio:"Michael Fassbender (born 2 April 1977) is a German-born Irish actor.  He was born in Heidelberg, Germany, to a German father, Josef, and an Irish mother, Adele (originally from Larne, County Antrim, in Northern Ireland).  Michael was raised in the town of Killarney, Co.  Kerry, in south-west Ireland, where his family moved to when he was two years old.  His parents ran a restaurant (his father is a chef)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AaEfdglbUSLgdmPHWNGxDpravzg.jpg", url:"https://themoviedb.org/person/17288"}}, {tmdbId:"85064", properties:{imdbId:"0255108", name:"Tara Ellis", url:"https://themoviedb.org/person/85064"}}, {tmdbId:"85065", properties:{bornIn:"Alvaston, Derby, England, UK", imdbId:"1925239", born:date('1990-08-01'), name:"Jack O'Connell", bio:"Jack O'Connell is a British film and television actor, best known for playing Louis Zamperini in \"Unbroken\", Kyle Budwell in \"Money Monster\" and James Cook in the British television teen drama \"Skins\".  He received the BAFTA EE Rising Star Award in 2015...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tCzR4clrIkbkijuJBYsNoEuwRDa.jpg", url:"https://themoviedb.org/person/85065"}}, {tmdbId:"10673", properties:{bornIn:"Berlin, West Germany", imdbId:"0936591", born:date('1959-07-03'), name:"Andreas Wisniewski", bio:"​From Wikipedia, the free encyclopedia\n\nAndreas Wisniewski (born July 3, 1959) is a German actor and former dancer. \n\nDescription above from the Wikipedia article Andreas Wisniewski, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l4frH8E416xWiylSBNjMCFQLOSz.jpg", url:"https://themoviedb.org/person/10673"}}, {tmdbId:"231199", properties:{bornIn:"Brussels, Belgium", imdbId:"2130745", born:date('1979-04-03'), name:"Axelle Carolyn", bio:"Axelle Carolyn (born 3 April 1979 in Brussels) is a Belgian filmmaker and former journalist and actress. \n\nDescription above from the Wikipedia article Axelle Carolyn, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2v8K77cmGO7T8Q6uxC0Tqw9Crrs.jpg", url:"https://themoviedb.org/person/231199"}}, {tmdbId:"140238", properties:{bornIn:"Brentwood, Essex, England, UK", imdbId:"1468516", born:date('1952-09-23'), name:"William Shimell", bio:"William Shimell (born Brentwood, Essex, 23 September 1952) is an English baritone who has had an active international career performing in opera and on the concert platform since the 1980s, and more recently has appeared in non-singing roles in films. \n\nShimell studied at the Guildhall School of Music and Drama and at the National Opera Studio.  For his student performance at the Guildhall the Opera critic noted \"William Shimells's Figaro stood out from all the others...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w5LOSXe2Wtul1sUWVWpw8d7WHP6.jpg", url:"https://themoviedb.org/person/140238"}}, {tmdbId:"9747", properties:{bornIn:"Colombières-sur-Orb, Hérault, France", imdbId:"0140643", born:date('1931-09-17'), name:"Jean-Claude Carrière", bio:"​From Wikipedia, the free encyclopedia.   \n\nJean-Claude Carrière (born 17 September 1931, Colombières-sur-Orb, Hérault, France) is a screenwriter and actor.  Alumnus of the École normale supérieure de Saint-Cloud, he was a frequent collaborator with Luis Buñuel.  He was president of La Fémis, the French state film school.  His collaboration with Buñuel began with the film Diary of a Chambermaid (1964), for which he co-wrote the screenplay (with Buñuel) and also played the part of a village priest...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aacpycCbhFFIoVFTUmGpzRATNY1.jpg", url:"https://themoviedb.org/person/9747"}}, {tmdbId:"28186", properties:{bornIn:"Paris, France", imdbId:"0622145", born:date('1946-11-14'), name:"Agathe Natanson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nnb3FB84tb7FdmnntILgOI1sg97.jpg", url:"https://themoviedb.org/person/28186"}}, {tmdbId:"131324", properties:{imdbId:"3727397", name:"Bayar", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zj4i3xL69CyJvXDxYmSH3t109BM.jpg", url:"https://themoviedb.org/person/131324"}}, {tmdbId:"131325", properties:{imdbId:"3727396", name:"Hattie", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lY55YnDgkuqQlkvrHyhud37IUrV.jpg", url:"https://themoviedb.org/person/131325"}}, {tmdbId:"2326100", properties:{imdbId:"3727387", name:"Mari", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5toPV99tPRcXrFTGXLOxlLmuN54.jpg", url:"https://themoviedb.org/person/2326100"}}] AS row
