UNWIND [{tmdbId:"23383", properties:{bornIn:"Issy-les-Moulineaux, Hauts-de-Seine, France", imdbId:"1871951", born:date('1984-03-06'), name:"Leïla Bekhti", bio:"Leïla Bekhti (born 6 March 1984) is a French film and television actress of Algerian descent.  She is best known for her roles in Sheitan, Tout ce qui brille and Paris, je t'aime. \n\nBekhti was born in Issy-les-Moulineaux to an Algerian family from Sidi Bel-Abbes.  She is the youngest of three children. She went to a theater school in Paris (18e) before entering the program of Stéphane Gildas in Tolbiac, then the program of Bérengère Basty at the Art’aire studio...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9tIvjHmfKVY6dgb113iRD2Hg3jG.jpg", url:"https://themoviedb.org/person/23383"}}, {tmdbId:"23386", properties:{imdbId:"1241168", born:date('1983-07-15'), name:"Cyril Descours", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/r8VkfR8sey5AEO4i8AvbJEbM8YG.jpg", url:"https://themoviedb.org/person/23386"}}, {tmdbId:"60900", properties:{bornIn:"Kelowna, British Columbia, Canada", imdbId:"2018237", born:date('1981-04-08'), name:"Taylor Kitsch", bio:"Taylor Kitsch is a Canadian actor and model best known for his portrayal of football player Tim Riggins on the NBC series \"Friday Night Lights\".  He was in many movies including the supernatural film \"The Covenant\", the X-Men spin-off \"X-Men Origins: Wolverine\", the Disney film \"John Carter\", the war film \"Lone Survivor\" and HBO's lgbt drama \"The Normal Heart\".  In November 2014, he was cast in the second season of HBO's popular anthology crime series \"True Detective\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lnpp4g14fsLqI29KajEbJUsuBhf.jpg", url:"https://themoviedb.org/person/60900"}}, {tmdbId:"6278", properties:{bornIn:" New York City, New York, USA", imdbId:"1226817", born:date('1982-08-10'), name:"Devon Aoki", bio:"Devon Edwenna Aoki (born August 10, 1982) is an American actress and model. \n\nHer acting career includes films like 2 Fast 2 Furious, D. E. B. S. , Sin City, Dead or Alive, War and Mutant Chronicles.  She did not have her driver's license prior to filming 2 Fast 2 Furious and had to learn to drive during filming.  She was cast as Tatsu Yamashiro in Arrow season 3, but was replaced by Rila Fukushima due to a scheduling conflict...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4ou67wYflxUuZCLUqK3vuKC13t9.jpg", url:"https://themoviedb.org/person/6278"}}, {tmdbId:"31383", properties:{bornIn:"Montreal, Quebec, Canada", imdbId:"0223518", born:date('1978-05-15'), name:"Caroline Dhavernas", bio:"Caroline Dhavernas is a French-Canadian film and television actress, best known for her portrayals of Jaye Tyler, the main character in the television series \"Wonderfalls\", and the female lead Dr.  Alana Bloom in the series \"Hannibal\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ehBQ6EaViBg2Zc5nngoViQHbua9.jpg", url:"https://themoviedb.org/person/31383"}}, {tmdbId:"69225", properties:{bornIn:"Schweigmatt, Baden-Württemberg, Germany", imdbId:"0452963", born:date('1990-02-11'), name:"Q'orianka Kilcher", bio:"Q'orianka Waira Qoiana Kilcher is a German born American-Peruvian actress, singer, and activist.  She played Pocahontas in the 2005 film The New World, and Kaʻiulani in Princess Kaiulani...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/resMT5SGYBBvgAP6A5jqnj75kZN.jpg", url:"https://themoviedb.org/person/69225"}}, {tmdbId:"1197944", properties:{imdbId:"0634562", name:"Klaus Nomi", url:"https://themoviedb.org/person/1197944"}}, {tmdbId:"68532", properties:{imdbId:"0480718", name:"Gabriele Lafari", url:"https://themoviedb.org/person/68532"}}, {tmdbId:"1197945", properties:{imdbId:"0567504", name:"David McDermott", url:"https://themoviedb.org/person/1197945"}}, {tmdbId:"23459", properties:{bornIn:"New York City, New York, USA", imdbId:"1092227", born:date('1981-12-28'), name:"Sienna Miller", bio:"Sienna Rose Diana Miller (born 28 December 1981) is a British-American actress, model, and fashion designer. \n\nIn 2008, she was nominated for the BAFTA Rising Star Award, while for her role as Tippi Hedren in the 2012 TV film The Girl, she was nominated for a BAFTA TV Award for Best Actress and a Golden Globe Award for Best Actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wCYir8b8BLwDBtphjIgsrKBM0Ju.jpg", url:"https://themoviedb.org/person/23459"}}, {tmdbId:"55541", properties:{bornIn:" Burbank, California, USA", imdbId:"0004827", born:date('1973-06-16'), name:"Eddie Cibrian", bio:"Edward Carl \"Eddie\" Cibrian ( born June 16, 1973) is an American actor.  He is best known for his roles as Russell Varon in Invasion, Jesse Cardoza in CSI: Miami, Jimmy Doherty on Third Watch. \n\nDescription above from the Wikipedia article Eddie Cibrian, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/swcAPvqyUlcn1SfVwcEBzhlFqVP.jpg", url:"https://themoviedb.org/person/55541"}}, {tmdbId:"135658", properties:{bornIn:"Praha, Československo", imdbId:"0061781", born:date('1969-01-21'), name:"Varhan Orchestrovich Bauer", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dELgE5vWO3NMa1YDvuV0dBjdLUD.jpg", url:"https://themoviedb.org/person/135658"}}, {tmdbId:"135662", properties:{imdbId:"1630168", name:"Jaromír Kalina", url:"https://themoviedb.org/person/135662"}}, {tmdbId:"936659", properties:{imdbId:"2919969", name:"Martin Prikryl", url:"https://themoviedb.org/person/936659"}}, {tmdbId:"18515", properties:{imdbId:"0338323", name:"Scott Patrick Green", url:"https://themoviedb.org/person/18515"}}, {tmdbId:"23440", properties:{bornIn:"Leningrad, USSR [now Saint Petersburg, Russia]", imdbId:"0450975", born:date('1972-01-11'), name:"Konstantin Khabenskiy", bio:"From Wikipedia, the free encyclopedia. \n\nKonstantin Khabensky (born 11 January 1972) is a Russian actor best known in the West for starring in the films Night Watch and Day Watch as the lead character Anton Gorodetsky. \n\nKhabensky was born and trained in St Petersburg, and now resides in Moscow.  Khabensky was already a popular and well-established theatre and television/film actor prior to appearing in the -Watch films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dW6vvsHlecFDccWkP3wfO995Hlc.jpg", url:"https://themoviedb.org/person/23440"}}, {tmdbId:"23442", properties:{bornIn:"Baku, USSR [now Azerbaijan]", imdbId:"0579828", born:date('1939-09-17'), name:"Vladimir Menshov", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uFcUO36vMhZuI4e8KSfM4UckODG.jpg", url:"https://themoviedb.org/person/23442"}}, {tmdbId:"1190182", properties:{imdbId:"0957749", born:date('1941-06-21'), name:"Valeriy Zolotukhin", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dl75JqXcuMJkp6EojPm6m4cCa9Q.jpg", url:"https://themoviedb.org/person/1190182"}}, {tmdbId:"23441", properties:{bornIn:"Moscow, RSFSR, USSR [now Russia]", imdbId:"1115009", born:date('1973-11-01'), name:"Mariya Poroshina", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1AkcTrvrEkm4FL33E1OdnT3rWGh.jpg", url:"https://themoviedb.org/person/23441"}}, {tmdbId:"20354", properties:{bornIn:"Santa Monica, California, USA", imdbId:"0848554", born:date('1983-05-14'), name:"Amber Tamblyn", bio:"Amber Rose Tamblyn (born May 14, 1983) is an American actress, author, poet, and film director.  She first came to national attention in her role on the soap opera General Hospital as Emily Quartermaine, followed by a starring role on the prime-time series Joan of Arcadia, portraying the title character.  Her feature film work includes roles in The Sisterhood of the Traveling Pants, The Grudge 2, The Ring, and 127 Hours; she had an extended arc as Martha M...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wQnqGLRnvBF3ZWFDXK7JaFvf7ie.jpg", url:"https://themoviedb.org/person/20354"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"59175", properties:{bornIn:"Tarzana, California, USA", imdbId:"0515116", born:date('1987-08-25'), name:"Blake Lively", bio:"An American actress, model, and celebrity homemaker.  She starred as Serena van der Woodsen in the CW drama Gossip Girl (2007–12), and has co-starred in such films as The Sisterhood of the Traveling Pants (2005), Accepted (2006), The Private Lives of Pippa Lee (2009), The Town (2010), Green Lantern (2011), Savages (2012) and The Age of Adaline (2015). \n\nDescription above from the Wikipedia article Blake Lively, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rkGVjd6wImtgjOCi0IpeffdEWtb.jpg", url:"https://themoviedb.org/person/59175"}}, {tmdbId:"39995", properties:{bornIn:"Brampton, Ontario, Canada", imdbId:"0148418", born:date('1988-06-07'), name:"Michael Cera", bio:"Michael Austin Cera (pronounced /ˈsɛrə/; born June 7, 1988) is an award-winning Canadian actor best known for his roles in Arrested Development, Youth in Revolt, Superbad, Scott Pilgrim vs.  the World, and Juno...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uwCyCFtGvn9dDmrHslbsmUj0tpj.jpg", url:"https://themoviedb.org/person/39995"}}, {tmdbId:"117669", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0234668", born:date('1988-06-22'), name:"Portia Doubleday", bio:"Portia Doubleday (born June 22, 1988) is an American actress.  She is perhaps best known for her roles in the 2009 film Youth in Revolt as Sheeni Saunders and in the 2011 film Big Mommas: Like Father Like Son as Jasmine...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6lPDPTlxnFcTJF5dzmmPHVmH8ey.jpg", url:"https://themoviedb.org/person/117669"}}, {tmdbId:"58225", properties:{bornIn:"Wilkesboro, North Carolina, USA", imdbId:"0302108", born:date('1969-10-01'), name:"Zach Galifianakis", bio:"​Zacharias \"Zach\" Galifianakis is an American actor and stand-up comedian.   He is most widely known for his role as Alan in 2009's The Hangover, the highest grossing R rated comedy ever.   Prior to his explosion to the main stage Galifianakis was known mainly for his stand up act, which features a large amount of absurdist and self deprecating humor.  Zach had worked for several years in film and television playing small once off roles, often playing maladjusted characters...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qsDfoUlRnXHUiqZeBPWHzmgmKGX.jpg", url:"https://themoviedb.org/person/58225"}}, {tmdbId:"1070031", properties:{name:"Gregory Abbey", url:"https://themoviedb.org/person/1070031"}}, {tmdbId:"111780", properties:{imdbId:"0083671", born:date('1975-04-14'), name:"Amy Birnbaum", bio:"From Wikipedia, the free encyclopedia\n\nAmy Birnbaum (born April 14, 1975) is an American voice actress, who works on the properties of 4Kids Entertainment. \n\nShe has done many voiceovers for cartoons, mainly dubbing for English versions of anime.  Her works can be found in anime dubs such as Pokémon, Yu-Gi-Oh!, Kirby: Right Back at Ya!, Sonic X (including many of the recent video games), Magical DoReMi, and G. I.  Joe: Sigma 6...", url:"https://themoviedb.org/person/111780"}}, {tmdbId:"4846", properties:{bornIn:"Boyarka, Kiev Oblast, Ukrainian SSR, USSR [now Ukraine]", imdbId:"1778479", born:date('1972-09-06'), name:"Eugene Hutz", bio:"​From Wikipedia, the free encyclopedia. \n\nEugene Hütz (September 6, 1972) is a Ukrainian-born singer and composer, most notable as the frontman of the critically acclaimed New York Gypsy punk band Gogol Bordello.  Hütz is also a DJ and actor...", url:"https://themoviedb.org/person/4846"}}, {tmdbId:"4853", properties:{bornIn:"Washington, District of Columbia, USA", imdbId:"1583636", born:date('1977-02-21'), name:"Jonathan Safran Foer", bio:"From Wikipedia, the free encyclopedia. \n\nJonathan Safran Foer (born February 21, 1977) is an American author best known for his novels Everything Is Illuminated (2002) and Extremely Loud and Incredibly Close (2005).  In 2009, he published a work of nonfiction entitled Eating Animals. \n\nDescription above from the Wikipedia article Jonathan Safran Foer, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/4853"}}, {tmdbId:"4858", properties:{imdbId:"2066069", name:"Jana Hrabetova", url:"https://themoviedb.org/person/4858"}}, {tmdbId:"53828", properties:{bornIn:"Louisville, Kentucky, USA", imdbId:"1358539", born:date('1979-12-07'), name:"Jennifer Carpenter", bio:"An American actress, known for her portrayal of Emily Rose in The Exorcism of Emily Rose, Debra Morgan on Dexter, and the lead in the 2008 horror movie Quarantine...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q2Newaws22FnTcRGvK9TrRnvn01.jpg", url:"https://themoviedb.org/person/53828"}}, {tmdbId:"8198", properties:{bornIn:"Viernheim, Germany", imdbId:"0876300", born:date('1957-07-29'), name:"Ulrich Tukur", bio:"Ulrich Tukur (born Ulrich Scheurlen, July 29, 1957 in Viernheim) is a German actor and musician. \n\nDescription above from the Wikipedia article Ulrich Tukur, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8cRioOXiW0FSN0eWysHWdl4leEf.jpg", url:"https://themoviedb.org/person/8198"}}, {tmdbId:"449", properties:{bornIn:"Ottawa, Ontario, Canada", imdbId:"0059431", born:date('1982-04-09'), name:"Jay Baruchel", bio:"Jonathan Adam Saunders \"Jay\" Baruchel (born April 9, 1982) is a Canadian actor.  He has had a successful career in comedy films, and has appeared in such box office successes as Million Dollar Baby, Knocked Up, Tropic Thunder, and How to Train Your Dragon, as well as the films She's Out of My League, The Trotsky, and The Sorcerer's Apprentice...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hTg6RJMxpxcsYzmdre81TznDATZ.jpg", url:"https://themoviedb.org/person/449"}}, {tmdbId:"32238", properties:{imdbId:"1488987", name:"Mitch Baker", url:"https://themoviedb.org/person/32238"}}, {tmdbId:"31838", properties:{bornIn:"Augusta, Georgia, U.S.", imdbId:"1263939", born:date('1987-09-19'), name:"Danielle Panabaker", bio:"From Wikipedia, the free encyclopedia\n\nDanielle Nicole Panabaker (born September 19, 1987) is an American actress.  She was a cast member in the CBS drama Shark, and appeared in the films Mr.  Brooks, Sky High, and Friday the 13th, among other projects.  She is best known to younger audiences for her roles in the Disney Channel films Stuck in the Suburbs and Read It and Weep along with her younger sister Kay Panabaker...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/faX0EDc44GL5ZcsEcxTOBcfWpCP.jpg", url:"https://themoviedb.org/person/31838"}}, {tmdbId:"1796535", properties:{bornIn:"San Diego, California, USA", born:date('1953-08-29'), name:"Carlos Amezcua", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/udAO2POtlT51JbtrGoFGFWlqXCG.jpg", url:"https://themoviedb.org/person/1796535"}}, {tmdbId:"1776994", properties:{name:"Robert Benz", url:"https://themoviedb.org/person/1776994"}}, {tmdbId:"135795", properties:{bornIn:"New Orleans, Louisiana, USA", imdbId:"1787651", born:date('1979-04-05'), name:"Todd Berger", bio:"Todd Berger is an American film writer, director and actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sjZl9Ytmczg2fcNd2sQaSmuXO06.jpg", url:"https://themoviedb.org/person/135795"}}, {tmdbId:"71530", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0539082", born:date('1968-11-18'), name:"Romany Malco", bio:"From Wikipedia, the free encyclopedia\n\nRomany Malco, Jr.  (born November 18, 1968) is an American actor and music producer.  He has been nominated for several awards, including an NAACP Image Award, MTV Movie Award, and Screen Actors Guild Award.  Malco portrayed Conrad Shepard on the Showtime series Weeds.  He currently plays George St.  Cloud on the ABC primetime one-hour drama No Ordinary Family...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ch7VZGJYv3p2wd2tse5CzuwHfB2.jpg", url:"https://themoviedb.org/person/71530"}}, {tmdbId:"2598423", properties:{name:"Leon Leyson", url:"https://themoviedb.org/person/2598423"}}, {tmdbId:"1950801", properties:{name:"Leopold Rosner", url:"https://themoviedb.org/person/1950801"}}] AS row
