UNWIND [{tmdbId:"82104", properties:{bornIn:"Grinnell, Iowa, USA", imdbId:"1775091", born:date('1978-02-14'), name:"Danai Gurira", bio:"Danai Jekesai Gurira (born February 14, 1978) is a Zimbabwean-American actress and playwright.  She is best known for her role as Michonne on the AMC drama series The Walking Dead. \n\nGrinnell, IowaGurira was born in Grinnell, Iowa and was raised there until December 1983, when she moved with her family to Harare, Zimbabwe.  She has an older brother who is a chiropractor and two older sisters, while her mother is a university librarian and her father is a chemistry professor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xgo39kFf6rAynb1i9J1BeLfSXxg.jpg", url:"https://themoviedb.org/person/82104"}}, {tmdbId:"765", properties:{bornIn:"Nazareth, Israel", imdbId:"0007814", born:date('1960-11-30'), name:"Hiam Abbass", bio:"Hiam Abbass (born November 30, 1960), also known as Hiam Abbas or Hiyam Abbas, is a Palestinian actress.  She is known for her roles in the films Satin Rouge (2002), Haifa (1996), Paradise Now (2005), The Syrian Bride (2004), Free Zone (2005), Dawn of the World (2008), The Visitor (2008), Lemon Tree (2008), and Amreeka (2009).  She had a small role in Steven Spielberg's Munich, a film depicting the response to the Munich Massacre, where she also served as a dialect and acting consultant...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hkzC5aJKTiuCchBpybaHDVngYZW.jpg", url:"https://themoviedb.org/person/765"}}, {tmdbId:"173825", properties:{imdbId:"0083246", name:"Bill Birch", url:"https://themoviedb.org/person/173825"}}, {tmdbId:"56685", properties:{imdbId:"1318410", name:"Brooke Bloom", bio:"Brooke Bloom is a stage, film and television actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1MQEhhWgEfJ2Fqgw7uSGu0OA9Bj.jpg", url:"https://themoviedb.org/person/56685"}}, {tmdbId:"52583", properties:{bornIn:"Rodelas, Bahia, Brazil", imdbId:"0609944", born:date('1976-06-27'), name:"Wagner Moura", bio:"Wagner Maniçoba de Moura is a Brazilian actor, director and musician.  Critically considered one of the protagonists of current Brazilian cinema.  He is internationally recognized for the role of Pablo Escobar in the TV series Narcos and Nationally known for the role of Captain Nascimento in the TV movie Tropa de Elite and Tropa de Elite 2: The Enemy Now is Another...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7yJVQSXSTOia9y7ShPPuU5pTKFt.jpg", url:"https://themoviedb.org/person/52583"}}, {tmdbId:"52585", properties:{bornIn:"Rio de Janeiro, Rio de Janeiro, Brazil", imdbId:"2386123", born:date('1981-12-14'), name:"André Ramiro", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tab79clODjAgsNFgH8dBQWklCiK.jpg", url:"https://themoviedb.org/person/52585"}}, {tmdbId:"52584", properties:{bornIn:"Rio de Janeiro, Rio de Janeiro, Brasil", imdbId:"0432753", born:date('1976-11-15'), name:"Caio Junqueira", died:date('2019-01-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oO2ncA8EDcszRl4T3d82rPVRQ4w.jpg", url:"https://themoviedb.org/person/52584"}}, {tmdbId:"52586", properties:{bornIn:"São Paulo, São Paulo, Brazil", imdbId:"1141101", born:date('1972-12-06'), name:"Milhem Cortaz", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dCsGTNwBi3BArSNDqkterXIkr1E.jpg", url:"https://themoviedb.org/person/52586"}}, {tmdbId:"119099", properties:{imdbId:"0692301", name:"Stewart Porter", url:"https://themoviedb.org/person/119099"}}, {tmdbId:"119097", properties:{imdbId:"3063003", name:"Maarten Stevenson", url:"https://themoviedb.org/person/119097"}}, {tmdbId:"15232", properties:{bornIn:"Grants Pass, Oregon, USA", imdbId:"0123092", born:date('1967-08-22'), name:"Ty Burrell", bio:"Ty Burrell (born August 22, 1967) is an American actor and comedian.  He is best known for his starring role on Modern Family...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zXrrbvW2ZKHYHbhujDj8aBlO4yx.jpg", url:"https://themoviedb.org/person/15232"}}, {tmdbId:"558928", properties:{bornIn:"Nashville, Tennessee, USA", imdbId:"1934618", born:date('2003-08-18'), name:"Max Charles", bio:"From Wikipedia, the free encyclopedia. \n\nMax Charles (born August 18, 2003) is an American child actor.  In addition to his appearance in the 2012 film The Three Stooges, Charles played a young Peter Parker in The Amazing Spider-Man and has a role in the ABC comedy science fiction series The Neighbors.  In 2014, Charles will play Sherman in DreamWorks Animation's Mr.  Peabody & Sherman alongside Ty Burrell...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5urZfWb7TUkuy53IcVvm0lNleGj.jpg", url:"https://themoviedb.org/person/558928"}}, {tmdbId:"1054484", properties:{imdbId:"2315031", name:"Lauri Fraser", url:"https://themoviedb.org/person/1054484"}}, {tmdbId:"12071", properties:{imdbId:"0967646", name:"Guillaume Aretos", url:"https://themoviedb.org/person/12071"}}, {tmdbId:"122514", properties:{imdbId:"2973494", name:"Juana Collignon", url:"https://themoviedb.org/person/122514"}}, {tmdbId:"8605", properties:{bornIn:"Rio de Janeiro, Rio de Janeiro, Brazil", imdbId:"1130610", born:date('1988-09-16'), name:"Darlan Cunha", url:"https://themoviedb.org/person/8605"}}, {tmdbId:"8599", properties:{bornIn:"Rio de Janeiro, Rio de Janeiro, Brazil", imdbId:"1178560", born:date('1983-02-23'), name:"Jonathan Haagensen", url:"https://themoviedb.org/person/8599"}}, {tmdbId:"52534", properties:{bornIn:"Rio de Janeiro, Rio de Janeiro, Brazil", imdbId:"1775058", name:"Rodrigo dos Santos", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xoPFxHv6YMoTjheyqskNRuXAW2h.jpg", url:"https://themoviedb.org/person/52534"}}, {tmdbId:"130860", properties:{imdbId:"2833204", name:"Animal Collective", url:"https://themoviedb.org/person/130860"}}, {tmdbId:"2418969", properties:{name:"Belle & Sebastian", url:"https://themoviedb.org/person/2418969"}}] AS row
