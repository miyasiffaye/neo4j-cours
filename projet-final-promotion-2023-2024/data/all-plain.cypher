UNWIND [{tmdbId:"86663", properties:{bornIn:"Moscow, USSR", imdbId:"0475610", born:date('1936-10-08'), name:"Leonid Kuravlyov", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6miBIGzextAEZ3H80iWskJPcFfr.jpg", url:"https://themoviedb.org/person/86663"}}, {tmdbId:"72739", properties:{bornIn:"Ranger, Texas, United States", imdbId:"0624189", born:date('1943-09-20'), name:"Ted Neeley", bio:"​From Wikipedia, the free encyclopedia\n\nTed Neeley (born Teddie Joe Neeley on September 20, 1943 in Ranger, Texas) is a rock and roll drummer, singer, actor, composer, and record producer.  He is probably best known for performing the title role in Jesus Christ Superstar in 1973. \n\nDescription above from the Wikipedia article Ted Neeley, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/72739"}}, {tmdbId:"72740", properties:{bornIn:"Lynchburg, Virginia, USA", imdbId:"0026483", born:date('1903-06-13'), name:"Carl Anderson", bio:"​From Wikipedia, the free encyclopedia\n\nCarl Anderson (February 27, 1945 – February 23, 2004) was an American singer, film and theatre actor best known for his portrayal of Judas Iscariot in the Broadway and film versions of the rock opera by Andrew Lloyd Webber and Tim Rice, Jesus Christ Superstar. \n\nDescription above from the Wikipedia article Carl Anderson (singer), licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1989-09-22'), url:"https://themoviedb.org/person/72740"}}, {tmdbId:"72741", properties:{bornIn:"Honolulu, Hawaii, USA", imdbId:"0254118", born:date('1951-12-29'), name:"Yvonne Elliman", bio:"​Yvonne Marianne Elliman (born December 29, 1951) is an American singer who performed for four years in the first cast of Jesus Christ Superstar.  She scored a number of hits in the 1970s and achieved a #1 hit with \"If I Can't Have You. \" After declining success, she dedicated herself to her family, and after a long hiatus made a comeback album as a singer-songwriter in 2004...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hTG0O8Mb6Tbd9a9hK59OSA8WDA3.jpg", url:"https://themoviedb.org/person/72741"}}, {tmdbId:"72742", properties:{bornIn:"Chicago, Illinois, U.S.", imdbId:"0219336", born:date('1938-02-22'), name:"Barry Dennen", bio:"​From Wikipedia, the free encyclopedia\n\nBarry Dennen (born February 22, 1938) is an American actor, singer, and writer. \n\nDennen was born in Chicago, Illinois.  In New York City from 1960 to 1963, he had a relationship with Barbra Streisand, including living together for a year, during which time he helped her develop the nightclub act that began her successful career as a singer and actress...", died:date('2017-09-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zSRROjxzdgbMRSPjpq2Kfpszd4J.jpg", url:"https://themoviedb.org/person/72742"}}, {tmdbId:"77483", properties:{imdbId:"0949935", born:date('1932-07-04'), name:"Otis Young", bio:"​From Wikipedia, the free encyclopedia\n\nOtis E.  Young (July 4, 1932 in Providence, Rhode Island – October 11, 2001) was an African-American actor.  He was only the second African-American actor to co-star in a television Western, The Outcasts (1968-1969), with Don Murray, the first being Raymond St Jacques who had co-starred on the final season of Rawhide in 1965, as cattle drover Simon Blake...", died:date('2001-10-11'), url:"https://themoviedb.org/person/77483"}}, {tmdbId:"1811", properties:{bornIn:"Houston, Texas, USA", imdbId:"0001642", born:date('1950-10-01'), name:"Randy Quaid", bio:"From Wikipedia, the free encyclopedia. \n\nRandall Rudy \"Randy\" Quaid (born October 1, 1950) is an American actor perhaps best known for his role as Cousin Eddie in the National Lampoon's Vacation movies, as well as his numerous supporting roles in films such as The Last Detail, Independence Day, Kingpin and Brokeback Mountain.  He has won a Golden Globe Award, and has been nominated for an Academy Award, an Emmy Award and a BAFTA Award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pWtakF85K2fHSTiXiMR3elLuTOn.jpg", url:"https://themoviedb.org/person/1811"}}, {tmdbId:"10224", properties:{bornIn:"Spokane, Washington, USA", imdbId:"0416378", born:date('1920-05-29'), name:"Clifton James", bio:"From Wikipedia, the free encyclopedia.   Clifton James (born May 29, 1921) was an American actor.  He is probably best known for his work with two of the six James Bond 007 actors in the past, Roger Moore in Live and Let Die (1973), The Man With The Golden Gun (1974) and Sean Connery in The Untouchables (1987). \n\nDescription above from the Wikipedia article Clifton James, licensed under CC-BY-SA,full list of contributors on Wikipedia...", died:date('2017-04-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aKzXusxO5KN2ZQfpFssS48njM2X.jpg", url:"https://themoviedb.org/person/10224"}}, {tmdbId:"10222", properties:{bornIn:"Stockwell, London, England, UK", imdbId:"0000549", born:date('1927-10-14'), name:"Roger Moore", bio:"Sir Roger George Moore, KBE (born 14 October 1927) was an English actor and film producer, perhaps best known for portraying British secret agent James Bond in seven films from 1973 to 1985.  He also portrayed Simon Templar in the long-running British television series The Saint. \n\nHis family announced his death, after a short battle with cancer, on 23 May 2017. \n\nDescription above from the Wikipedia article Roger Moore, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2017-05-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7H7UXpYPAIZGUs4uSkzqpTrYyxX.jpg", url:"https://themoviedb.org/person/10222"}}, {tmdbId:"5050", properties:{bornIn:"New York City, New York, U.S.", imdbId:"0001433", born:date('1937-11-15'), name:"Yaphet Kotto", bio:"Yaphet Frederick Kotto (born November 15, 1939) is an American actor known for numerous film roles, as well as starring in the NBC television series Homicide: Life on the Street (1993–99) as Lieutenant Al Giardello.  His films include the science-fiction/horror film Alien (1979), and the Arnold Schwarzenegger science-fiction/action film The Running Man (1987).  He portrayed the main villain Dr.  Kananga/Mr.  Big in the James Bond movie Live and Let Die (1973)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sNMxs1xSF7LAjl7JVNDCf6wnWWY.jpg", url:"https://themoviedb.org/person/5050"}}, {tmdbId:"10223", properties:{bornIn:"Hayes, Hayes and Harlington, Middlesex, England, UK", imdbId:"0005412", born:date('1951-02-15'), name:"Jane Seymour", bio:"Jane Seymour, OBE (born Joyce Penelope Wilhelmina Frankenberg; 15 February 1951) is an English actress best known for her performances in the James Bond film Live and Let Die (1973), East of Eden (1982), Onassis: The Richest Man in the World (1988), and the American television series Dr.  Quinn, Medicine Woman (1993–1998). \n\nShe has earned an Emmy Award, two Golden Globe Awards, and a star on the Hollywood Walk of Fame.  She was made a member of the Order of the British Empire in 2000...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/b4ggW2oi90iAQPIvadyHdjOkOPn.jpg", url:"https://themoviedb.org/person/10223"}}, {tmdbId:"41732", properties:{bornIn:"Denmark", imdbId:"0887684", born:date('1932-07-15'), name:"Nina van Pallandt", bio:"Born Nina Magdelena Møller in Copenhagen, Denmark, she was first a celebrated folk singer in Europe, together with her husband, Baron Frederik van Pallandt.  They split up in 1969 and after a brief solo carrier as singer she ended up in Hollywood, appearing in several Robert Altman movies, as well as various TV series.  She is also famous as the mistress of hoaxer Clifford Irving, who went to jail when his biography of Howard Hughes proved to be a fake...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8eUeOcWHczbpFGYyYtYTgZC7WES.jpg", url:"https://themoviedb.org/person/41732"}}, {tmdbId:"11066", properties:{bornIn:"Cleveland, Ohio, USA", imdbId:"0001358", born:date('1925-02-17'), name:"Hal Holbrook", bio:"Harold Rowe \"Hal\" Holbrook, Jr.  (born 17 February 1925) is an American actor.  His television roles include Abraham Lincoln in the 1976 TV series Lincoln, Hays Stowe on The Bold Ones: The Senator and Capt.  Lloyd Bucher on Pueblo.  He is also known for his role in the 2007 film Into the Wild, for which he was nominated for a Screen Actors Guild Award and an Academy Award.  He has also done a one-man show as Mark Twain since 1954...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cnhje99hbqldY1wimQTKpApvj1n.jpg", url:"https://themoviedb.org/person/11066"}}, {tmdbId:"15956", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0815800", born:date('1943-08-28'), name:"David Soul", bio:"From Wikipedia, the free encyclopedia\n\nDavid Soul (born David Richard Solberg, August 28, 1943) is an American-British actor and singer.  He is known for his role as Detective Kenneth \"Hutch\" Hutchinson in the ABC television series Starsky & Hutch from 1975 to 1979.  In 2004 Soul became a British citizen, while retaining his U. S.  citizenship...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a4KPps2bSLp7bjLrHm9Uo9KkaNP.jpg", url:"https://themoviedb.org/person/15956"}}, {tmdbId:"28254", properties:{bornIn:"Nîmes, France", imdbId:"0480942", born:date('1938-10-26'), name:"Bernadette Lafont", bio:"Bernadette Lafont was a French actress who appeared in more than 150 feature films.  She has been considered \"the face of French New Wave\"...", died:date('2013-07-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7VQBd8mETgqj4lzh9jVjSCXqbzO.jpg", url:"https://themoviedb.org/person/28254"}}, {tmdbId:"236639", properties:{imdbId:"0495950", born:date('1944-01-01'), name:"Françoise Lebrun", bio:"Françoise Lebrun is a French film and television actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6KgU5sdNgbPsiF0bmdp1vXpG4M8.jpg", url:"https://themoviedb.org/person/236639"}}, {tmdbId:"140054", properties:{imdbId:"0918315", name:"Isabelle Weingarten", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1jujkctcnKK52UimTLHDVZGgEa4.jpg", url:"https://themoviedb.org/person/140054"}}, {tmdbId:"2555", properties:{bornIn:"Brooklyn, New York, U.S.", imdbId:"0698998", born:date('1942-05-20'), name:"David Proval", bio:"From Wikipedia, the free encyclopedia.  David Aaron Proval (born May 20, 1942) is an American actor, known for his roles as Richie Aprile on the HBO television series The Sopranos and as Tony DeVienazo in the 1973 Martin Scorsese film Mean Streets opposite Robert De Niro and Harvey Keitel. \n\nProval was born in Brooklyn, New York of Jewish heritage,  the son of actress Clara Katz of Romanian origin...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ku3LWQXiJ80nWgs21fKvTMaR6Ui.jpg", url:"https://themoviedb.org/person/2555"}}, {tmdbId:"2556", properties:{bornIn:"Trenton, New Jersey, USA", imdbId:"0732364", born:date('1948-04-13'), name:"Amy Robinson", bio:"From Wikipedia, the free encyclopedia.   Amy Robinson (born April 13, 1948 in Trenton, New Jersey) is an American actress and film producer.  She got her first film role as an actress as the female lead in Martin Scorsese's breakthrough hit Mean Streets and ultimately went on to produce his film After Hours among many others.  She was a member of the dramatic jury at the Sundance Film Festival in 1987...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aD7tseQ5HP0DwTsABUhQNvZuwCz.jpg", url:"https://themoviedb.org/person/2556"}}, {tmdbId:"3591", properties:{imdbId:"0186569", born:date('1945-10-01'), name:"Dani", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qbRajtd887gsUpqPEbqjHAOKlTn.jpg", url:"https://themoviedb.org/person/3591"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"18765", properties:{bornIn:"Montréal, Québec, Canada", imdbId:"0829155", born:date('1939-06-10'), name:"Alexandra Stewart", bio:"​Alexandra Stewart (born June 10, 1939 in Montreal, Quebec) is a Canadian actress.  Besides her cinema career, she regularly appeared on television in shows such as Les Jeux de 20 heures and L'Académie des neuf.  She has also appeared in the 1981 cartoon Space Stars and had cameos in Highlander: The Series, The Saint and the pilot episode of The X-Files.   She was part of the jury of the 2004 Chicago International Film Festival.   She has a daughter, Justine, with the French director Louis Malle...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yoQ7uZmw5FQkJPQua8HGR2WCr5q.jpg", url:"https://themoviedb.org/person/18765"}}, {tmdbId:"37583", properties:{bornIn:"Castro dei Volsci, Frosinone, Italy", imdbId:"0542063", born:date('1921-03-22'), name:"Nino Manfredi", bio:"From Wikipedia, the free encyclopedia\n\nNino Manfredi (born Saturnino Manfredi, 22 March 1921 - 4 June 2004) was an Italian actor, one of the most prominent in the commedia all'italiana genre. \n\nBorn at Castro dei Volsci, province of Frosinone, Lazio, he studied law before going into acting in the theatre company featuring also Vittorio Gassman and Tino Buazzelli, especially in dramatic roles...", died:date('2004-06-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aSRMOJOUxSqpz1Hq2T5HPxWvEgN.jpg", url:"https://themoviedb.org/person/37583"}}, {tmdbId:"21234", properties:{bornIn:"Milan, Lombardy, Italy", imdbId:"0233506", born:date('1937-02-20'), name:"Johnny Dorelli", bio:"Johnny Dorelli (born 20 February 1937) is an Italian actor, singer and showman. \n\nBorn as Giorgio Guidi in Meda, he debuted as singer in the late 1950s for CGD label.  In 1958 he won the Sanremo Festival in duo with Domenico Modugno, with the songs \"Nel blu dipinto di blu\" (also known as \"Volare\") and \"Piove (Ciao ciao bambina)\".  \"L'immensità\" earned Dorelli a ninth place at the 1967 edition of the Sanremo Song Festival...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iERbgqPTLhczWWqFR6d40L5jdRa.jpg", url:"https://themoviedb.org/person/21234"}}, {tmdbId:"143598", properties:{imdbId:"0876959", name:"Paolo Turco", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oT40XE7kRBy745KHUfF2a4L0f5b.jpg", url:"https://themoviedb.org/person/143598"}}, {tmdbId:"57905", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0905993", born:date('1949-06-22'), name:"Lindsay Wagner", bio:"Lindsay Wagner (born June 22, 1949) is an American actress.  She is probably most widely known for her role on The Bionic Woman, though she has maintained a lengthy career in a variety of other film and television productions since...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x1UwRfJt9Th5KJwZgKIcjDKmIo9.jpg", url:"https://themoviedb.org/person/57905"}}, {tmdbId:"11783", properties:{bornIn:"Bucharest, Romania", imdbId:"0002144", born:date('1902-09-22'), name:"John Houseman", bio:"John Houseman (September 22, 1902 – October 31, 1988) was a Romanian-born British-American actor and film producer who became known for his highly publicized collaboration with director Orson Welles from their days in the Federal Theatre Project through to the production of Citizen Kane.  He is perhaps best known for his role as Professor Charles Kingsfield in the 1973 film The Paper Chase for which he won a best supporting actor Oscar...", died:date('1988-10-31'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aNWCBj1ApNIBJvFAAWuEwXWaGDw.jpg", url:"https://themoviedb.org/person/11783"}}, {tmdbId:"6110", properties:{bornIn:"Old Lyme, Connecticut, USA", imdbId:"0065320", born:date('1949-12-22'), name:"Graham Beckel", bio:"Graham Beckel is an actor and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ubo1j0e7hVuz62JEIS9kkRzvqtv.jpg", url:"https://themoviedb.org/person/6110"}}, {tmdbId:"68890", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0001575", born:date('1963-11-05'), name:"Tatum O'Neal", bio:"Tatum Beatrice O'Neal (born November 5, 1963) is an American actress best known for her film work as a child actress in the 1970s.  She is the youngest to win a competitive Academy Award, at the age of 10. \n\nDescription above from the Wikipedia article Tatum O'Neal, licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9JIIA3D6sQBOo5nB2aLqZHdVtoJ.jpg", url:"https://themoviedb.org/person/68890"}}, {tmdbId:"12296", properties:{bornIn:"Denison, Texas, USA", imdbId:"0384916", born:date('1932-12-20'), name:"John Hillerman", bio:"John Hillerman (born December 20, 1932) is an American actor, known for Magnum, P. I...", died:date('2017-11-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sZ44pzr7OJrdxGfsGjTMavFCW2K.jpg", url:"https://themoviedb.org/person/12296"}}, {tmdbId:"10823", properties:{bornIn:"Brownsville, Texas, USA", imdbId:"0001434", born:date('1936-06-22'), name:"Kris Kristofferson", bio:"​Kristoffer \"Kris\" Kristofferson (born June 22, 1936) is an American musician, actor, and writer.  He is known for hits such as \"Me and Bobby McGee\", \"For the Good Times\", \"Sunday Mornin' Comin' Down\", and \"Help Me Make It Through the Night\".  Kristofferson is the sole writer of most of his songs, but he has collaborated with various other figures of the Nashville scene such as Shel Silverstein...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fWZCpnXT7sLOdc96Bm66QTOjnXZ.jpg", url:"https://themoviedb.org/person/10823"}}, {tmdbId:"58423", properties:{bornIn:"Long Beach, Long Island, New York, United States", imdbId:"0001395", born:date('1926-10-10'), name:"Richard Jaeckel", bio:"From Wikipedia, the free encyclopedia.   Richard Hanley Jaeckel (October 10, 1926 – June 14, 1997) was an American actor of film and television.   Description above from the Wikipedia article Richard Jaeckel, licensed under CC-BY-SA,full list of contributors on Wikipedia...", died:date('1997-06-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bqPHmgKzNOWU58GtoB2SDiH8MHV.jpg", url:"https://themoviedb.org/person/58423"}}, {tmdbId:"131376", properties:{imdbId:"1980761", name:"Jennifer Drake", url:"https://themoviedb.org/person/131376"}}, {tmdbId:"131377", properties:{imdbId:"0062010", name:"Eric Baugin", url:"https://themoviedb.org/person/131377"}}, {tmdbId:"39880", properties:{bornIn:"Paris - France", imdbId:"0867622", born:date('1922-04-13'), name:"Jean Topart", bio:"Jean Topart est un acteur français né le 13 avril 1922 à Paris et mort le 29 décembre 2012 au Port-Marly (Yvelines).  Il fut membre de la troupe du TNP deJean Vilar dans les années 1950-1960...", died:date('2012-12-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5ccUz2nfRPKkn0g00CAzBoONGzR.jpg", url:"https://themoviedb.org/person/39880"}}, {tmdbId:"38115", properties:{imdbId:"0885286", born:date('1936-10-04'), name:"Jean Valmont", url:"https://themoviedb.org/person/38115"}}, {tmdbId:"1226099", properties:{bornIn:"Fort Worth - Texas - USA", imdbId:"0589248", born:date('1936-01-02'), name:"Roger Miller", died:date('1992-10-25'), url:"https://themoviedb.org/person/1226099"}}, {tmdbId:"70843", properties:{bornIn:"Morley, West Yorkshire, England, UK", imdbId:"0066028", born:date('1935-02-16'), name:"Brian Bedford", bio:"From Wikipedia, the free encyclopedia. \n\nBrian Bedford (born 16 February 1935) is an English actor. \n\nDescription above from the Wikipedia article Brian Bedford, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lL7c7sizLGEK2WKnVxM3HHZ8AXr.jpg", url:"https://themoviedb.org/person/70843"}}, {tmdbId:"6360", properties:{imdbId:"0873148", born:date('1942-01-01'), name:"Dorothy Tristan", url:"https://themoviedb.org/person/6360"}}, {tmdbId:"83145", properties:{bornIn:"Abilene, Texas, USA", imdbId:"0917190", born:date('1934-01-21'), name:"Ann Wedgeworth", bio:"Ann Wedgeworth (born January 21, 1935) is an American actress, best known for her role as Lahoma Vane Lucas on the daytime dramas Another World (1967–1970) and Somerset (1970–1973). \n\nDescription above from the Wikipedia article Ann Wedgeworth, licensed under CC-BY-SA,full list of contributors on Wikipedia...", died:date('2017-11-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qi153PFDSHi5afMBkdEqquXwxWc.jpg", url:"https://themoviedb.org/person/83145"}}, {tmdbId:"38127", properties:{bornIn:"Stockholm, Stockholms län, Sweden", imdbId:"0430746", born:date('1923-06-15'), name:"Erland Josephson", bio:"From Wikipedia, the free encyclopedia. \n\nErland Josephson (born 15 June 1923 - died 25 February 2012 ) was a Swedish actor and author.  He is best known to international audiences for his work in films directed by Ingmar Bergman, Andrei Tarkovsky, and Theodoros Angelopoulos...", died:date('2012-02-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dopG1nAzyT23DMAPyPoUuwbZs4a.jpg", url:"https://themoviedb.org/person/38127"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"1273", properties:{bornIn:"Astoria, Queens, New York City, New York, USA", imdbId:"0444955", born:date('1934-11-21'), name:"Jack Kehoe", bio:"From Wikipedia, the free encyclopedia\n\nJack Kehoe (November 21, 1934 - January 14, 2020) was an American actor who appeared in a wide variety of films, including Serpico (1973), The Sting (1973), Car Wash (1976), On the Nickel (1980), Melvin and Howard (1980), The Pope of Greenwich Village (1984), The Untouchables (1987), Midnight Run (1988), and Young Guns II (1990).  His TV credits included roles in The Twilight Zone, Murder, She Wrote and Miami Vice...", died:date('2020-01-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ttDHV6m9OOAWuXnAorCTDel8vNO.jpg", url:"https://themoviedb.org/person/1273"}}, {tmdbId:"13947", properties:{bornIn:"New Haven, Connecticut, U.S.", imdbId:"0570161", born:date('1926-10-25'), name:"Biff McGuire", bio:"William Joseph \"Biff\" McGuire, Jr.  (born October 25, 1926) is an American actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/udU1EI146qn3e5VkHgs04idoL2W.jpg", url:"https://themoviedb.org/person/13947"}}, {tmdbId:"20011", properties:{bornIn:"Yellowknife, Northwest Territories, Canada", imdbId:"0452288", born:date('1948-10-17'), name:"Margot Kidder", bio:"Margaret Ruth \"Margot\" Kidder (October 17, 1948 – May 13, 2018) was a Canadian-American actress, director, and activist whose career spanned over five decades.  Her accolades include three Canadian Screen Awards and one Daytime Emmy Award.  Though she appeared in an array of films and television, Kidder is most widely known for her performance as Lois Lane in the Superman film series, appearing in the first four films...", died:date('2018-05-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ybDmKTb97zUaMkYY6PNFHLlhtgk.jpg", url:"https://themoviedb.org/person/20011"}}, {tmdbId:"41258", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0759022", born:date('1944-09-04'), name:"Jennifer Salt", bio:"From Wikipedia, the free encyclopedia\n\nJennifer Salt (born September 4, 1944) is an American actress, producer, and screenwriter. \n\nDescription above from the Wikipedia article Jennifer Salt, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nAzrHROM4nFV32PZNtgzD0CfYJE.jpg", url:"https://themoviedb.org/person/41258"}}, {tmdbId:"1466", properties:{bornIn:"Highland Falls, New York, USA", imdbId:"0001164", born:date('1923-02-28'), name:"Charles Durning", bio:"Charles Edward Durning (February 28, 1923 – December 24, 2012) was an American actor.  He best-known films include The Sting (1973), Dog Day Afternoon (1975), True Confessions (1981), Tootsie (1982), Dick Tracy (1990) and O Brother, Where Art Thou? (2000).  He was nominated for the Academy Award for Best Supporting Actor for both The Best Little Whorehouse in Texas (1982) and To Be or Not to Be (1983)...", died:date('2012-12-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bozKytaYVKoIbptxkMFWepK09U5.jpg", url:"https://themoviedb.org/person/1466"}}, {tmdbId:"97561", properties:{bornIn:"Manhattan, New York City, New York, USA", imdbId:"0278073", born:date('1942-09-20'), name:"William Finley", bio:"William Finley (September 20, 1940 – April 14, 2012)was an American actor who has appeared in the films Simon, Silent Rage, Phantom of the Paradise, Sisters, and The Wedding Party.  He had a long-running friendship and collaboration with director Brian De Palma, beginning with the student films Woton's Wake (1962) and Murder à la Mod (1968).  Most recently, he contributed a small but effective cameo in De Palma's 2006 release The Black Dahlia.  Under the name W...", died:date('2012-04-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o9UZgr7hyRu9YaNarSe7QV9BPrS.jpg", url:"https://themoviedb.org/person/97561"}}, {tmdbId:"41269", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0065183", born:date('1943-01-28'), name:"John Beck", bio:"From Wikipedia, the free encyclopedia.  John Beck (born January 28, 1943 in Chicago, Illinois) is an American actor.  He grew up in Joliet, Illinois.  Renowned as a gritty actor with plenty of presence on set, he is ultimately best-known worldwide for playing the role of Mark Graison in Dallas during the mid-1980s, but is also well-known for several other roles in which he specialised in playing hard-ball businessmen...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8NjkFDDJHrEOSRIuvyoWhlHs0X1.jpg", url:"https://themoviedb.org/person/41269"}}, {tmdbId:"69884", properties:{imdbId:"0339889", name:"Mary Gregory", url:"https://themoviedb.org/person/69884"}}, {tmdbId:"71240", properties:{bornIn:"Washington, D.C., U.S.", imdbId:"0853375", born:date('1944-01-25'), name:"Leigh Taylor-Young", bio:"From Wikipedia, the free encyclopedia\n\nLeigh Taylor-Young (born January 25, 1945) is an American actress who has appeared on stage, screen, and television. \n\nDescription above from the Wikipedia article Leigh Taylor-Young, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9l8TSUQQsTGx8aQMGurIf9gdTPY.jpg", url:"https://themoviedb.org/person/71240"}}, {tmdbId:"18329", properties:{bornIn:"Paris, France", imdbId:"0773932", born:date('1952-03-27'), name:"Maria Schneider", bio:"​From Wikipedia, the free encyclopedia\n\nMaria Schneider (27 March 1952–3 February 2011), born Marie Christine Gélin, was a French actress.  She was best known for playing Jeanne, opposite Marlon Brando, in the 1972 film, Last Tango in Paris. \n\nDescription above from the Wikipedia article Maria Schneider (actress), licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2011-02-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wagwZhq64wzZhfg9PjhRLE0KY0G.jpg", url:"https://themoviedb.org/person/18329"}}, {tmdbId:"4426", properties:{bornIn:"Roma", imdbId:"0585170", born:date('1921-05-14'), name:"Maria Michi", died:date('1980-04-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z4IJay0SUTnTzwkvK29fwQ8n1RV.jpg", url:"https://themoviedb.org/person/4426"}}, {tmdbId:"18337", properties:{bornIn:"Bangkok, Thailand", imdbId:"0302815", born:date('1916-06-27'), name:"Giovanna Galletti", died:date('1992-04-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8nHNChrcXzmyfrwVpjqmWgI8WcP.jpg", url:"https://themoviedb.org/person/18337"}}, {tmdbId:"116157", properties:{bornIn:"Helsinki, Finland", imdbId:"0517978", born:date('1945-01-04'), name:"Vesa-Matti Loiri", url:"https://themoviedb.org/person/116157"}}, {tmdbId:"116159", properties:{bornIn:"Pori, Finland", imdbId:"0707231", born:date('1944-02-17'), name:"Marjatta Raita", bio:"Marjatta Raita (17 February 1944, Pori – 27 September 2007) was a Finnish actress, who was best known for her role as Elisabeth Turhapuro in the Uuno Turhapuro movies directed by Spede Pasanen.  Raita also appeared in many other films, although she acted mainly in theater.  She studied in a theater school in 1962-1965...", died:date('2007-09-27'), url:"https://themoviedb.org/person/116159"}}, {tmdbId:"116158", properties:{bornIn:"Kuopio, Finland", imdbId:"0664218", born:date('1930-04-01'), name:"Spede Pasanen", died:date('2001-09-07'), url:"https://themoviedb.org/person/116158"}}, {tmdbId:"147773", properties:{bornIn:"Viipuri, Finland", imdbId:"0475021", born:date('1925-07-31'), name:"Juhani Kumpulainen", died:date('1991-11-12'), url:"https://themoviedb.org/person/147773"}}, {tmdbId:"10475", properties:{bornIn:"Houston, Texas, USA", imdbId:"0001042", born:date('1947-04-15'), name:"Lois Chiles", bio:"From Wikipedia, the free encyclopedia\n\nLois Cleveland Chiles (born April 15, 1947) is an American actress and former fashion model known for her role as Dr.  Holly Goodhead in the 1979 James Bond film Moonraker. \n\nDescription above from the Wikipedia article Lois Chiles, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mNfIiKy42Vy79lEzUFETPOk8LLP.jpg", url:"https://themoviedb.org/person/10475"}}, {tmdbId:"9274", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0000981", born:date('1940-07-18'), name:"James Brolin", bio:"From Wikipedia, the free encyclopedia\n\nJames Brolin (born July 18, 1940) is an American actor, producer and director, best known for his roles in soap operas, movies, sitcoms, and television.  He is the father of actor Josh Brolin and husband of singer/actress Barbra Streisand...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rNboIDJ2WfqE6vdTLWevG9pMNNn.jpg", url:"https://themoviedb.org/person/9274"}}, {tmdbId:"24319", properties:{bornIn:"Alameda County, California, USA", imdbId:"0058991", born:date('1928-08-06'), name:"Norman Bartold", died:date('1994-05-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a23SzlA8HCJP4pEV2FmjxWoLZXF.jpg", url:"https://themoviedb.org/person/24319"}}, {tmdbId:"40388", properties:{bornIn:"Honolulu, Hawaii, USA", imdbId:"0082515", born:date('1942-05-14'), name:"Jennifer Billingsley", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rbITM5ZZAmA2XcduLPm2CMP8UUj.jpg", url:"https://themoviedb.org/person/40388"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"12410", properties:{bornIn:"Greenville, South Carolina, USA", imdbId:"0005019", born:date('1942-02-02'), name:"Bo Hopkins", bio:"From Wikipedia, the free encyclopedia.  Bo Hopkins (born February 2, 1942 in Greenville, South Carolina) is an American actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9gZjIsw8dyHI9BJnfnkvGk2dmaH.jpg", url:"https://themoviedb.org/person/12410"}}, {tmdbId:"39188", properties:{bornIn:"Croydon, Surrey, England, UK", imdbId:"0940919", born:date('1930-06-01'), name:"Edward Woodward", bio:"Edward Albert Arthur Woodward OBE (1 June 1930 – 16 November 2009) was an English stage and screen actor and singer.  After graduating from the Royal Academy of Dramatic Art (RADA), Woodward began his career on stage, and throughout his career he appeared in productions in both the West End in London and on Broadway in New York.  He came to wider attention from 1967 in the title role of the British television spy drama Callan, earning him the 1970 British Academy Television Award for Best Actor...", died:date('2009-11-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2MWfWJsjCTeeuIRKhcIxj1vzuR6.jpg", url:"https://themoviedb.org/person/39188"}}, {tmdbId:"22370", properties:{bornIn:"London, England, UK", imdbId:"0450414", born:date('1944-05-12'), name:"Sara Kestelman", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/utC9COb5xLSgnOT1WtV6NQ6Zm8a.jpg", url:"https://themoviedb.org/person/22370"}}, {tmdbId:"40041", properties:{bornIn:"Gainsborough, Lincolnshire, England, UK", imdbId:"0017596", born:date('1940-11-27'), name:"John Alderton", bio:"From Wikipedia, the free encyclopedia\n\nJohn Alderton (born 27 November 1940) is an English actor who is best known for his roles in Upstairs, Downstairs, Thomas & Sarah and Please Sir!.  Alderton has often starred alongside his wife, Pauline Collins. \n\nDescription above from the Wikipedia article John Alderton, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mRrJwbF1LZ8rpY5WsBoMe2wYeJ9.jpg", url:"https://themoviedb.org/person/40041"}}, {tmdbId:"27442", properties:{bornIn:"Seravezza, Lucca, Tuscany, Italy", imdbId:"0759395", born:date('1934-03-20'), name:"Renato Salvatori", bio:"From Wikipedia, the free encyclopedia. \n\nRenato Salvatori (20 March 1934 – 27 March 1988) was an Italian multi-purpose character actor. \n\nDescription above from the Wikipedia article Renato Salvatori, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1988-03-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z6RqHnK5OpmLNDT4wRV3WkM83FM.jpg", url:"https://themoviedb.org/person/27442"}}, {tmdbId:"38244", properties:{bornIn:"Obersitzko, Prussia, Germany [now Obrzycko, Wielkopolskie, Poland]", imdbId:"0368394", born:date('1903-07-11'), name:"O.E. Hasse", bio:"O. E.  Hasse (Otto Eduard Hasse) was a German stage, screen, and television actor.  He is recognized by international audiences for his portrayal of the character Otto Keller in Alfred Hitchcock's 1953 film I Confess...", died:date('1978-09-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bSpUiYizOWjuOGNyBSNKI9rv1Qo.jpg", url:"https://themoviedb.org/person/38244"}}, {tmdbId:"24683", properties:{bornIn:"Paris, France", imdbId:"0916616", born:date('1949-08-23'), name:"Jacques Weber", bio:"Jacques Weber (born 23 August 1949) is a French actor, director and writer. \n\nPassionate about drama from his youth, Jacques Weber joined the Conservatoire national supérieur d'art dramatique at the age of 20, and won the prix d'Excellence when he left.  He joined Robert Hossein in Reims.  He then began a rich theatrical career and a sporadic cinema career. \n\nMarcel Cravenne hired him in 1970 for Tartuffe...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xORNQKmduTsIc1Sq40mnOz3Zo5K.jpg", url:"https://themoviedb.org/person/24683"}}, {tmdbId:"198327", properties:{imdbId:"0070592", name:"Mia Bendixsen", url:"https://themoviedb.org/person/198327"}}, {tmdbId:"25780", properties:{bornIn:"Naples, Italy", imdbId:"0535991", born:date('1910-04-24'), name:"Pupella Maggio", bio:"From Wikipedia, the free encyclopedia. \n\nPupella Maggio born Giustina Maggio (24 April 1910 - 8 December 1999) was an Italian film actress. \n\nDescription above from the Wikipedia article Pupella Maggio, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1999-12-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4UzmBdKw8e2x4iaCkDjZTZwsPsP.jpg", url:"https://themoviedb.org/person/25780"}}, {tmdbId:"53461", properties:{imdbId:"0104392", born:date('1917-09-09'), name:"Armando Brancia", died:date('1997-06-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aK5PXqwsBJdBJZn1QFkSJ1RwEkX.jpg", url:"https://themoviedb.org/person/53461"}}, {tmdbId:"5963", properties:{bornIn:"İzmir, Turkey", imdbId:"0637649", born:date('1932-06-27'), name:"Magali Noël", bio:"From Wikipedia, the free encyclopedia. \n\nMagali Noël (born Magali Noëlle Guiffray; June 27, 1932) is a Turkish-French actress and singer.  Originally from Izmir, she emigrated from Turkey to France in 1951, and her acting career began soon thereafter.  She acted in multilingual cinema chiefly from 1951 to 1980, doing several films in Italian with renowned director Federico Fellini, for whom she was a favourite subject...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mEFJnEVJ3MVOFrQLD40a8HMPr4O.jpg", url:"https://themoviedb.org/person/5963"}}, {tmdbId:"53462", properties:{bornIn:"Palermo, Sicily, Italy", imdbId:"0409049", born:date('1922-10-05'), name:"Ciccio Ingrassia", bio:"From Wikipedia, the free encyclopedia. \n\nCiccio Ingrassia (5 October 1922 - 28 April 2003) was an Italian comedian. \n\nHe was born in Palermo, Sicily and began his career in the 1950s, although his career only really took off in the 1960s.  He starred in many comedies, mainly as a duo with comedian Franco Franchi.  During the 1980s he also did television work. \n\nDescription above from the Wikipedia article Ciccio Ingrassia, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2003-04-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hQdJbjJSoJZXDFjnb4rQVDO4Bye.jpg", url:"https://themoviedb.org/person/53462"}}, {tmdbId:"2726", properties:{bornIn:"Hamburg, Germany", imdbId:"0591930", born:date('1910-04-20'), name:"Brigitte Mira", bio:"From Wikipedia, the free encyclopedia. \n\nBrigitte Mira (20 April 1910 – 8 March 2005) was a German actress.  She worked in both theater and film, often with Rainer Werner Fassbinder. \n\nBrigitte Mira's mother was German and her father was Jewish Russian.  During the Nazi dictatorship, Mira took part in the propaganda series Liese und Miese.  She played Miese (germ.  bad one)--the bad role model according to Nazi ideology that listened to enemy radio stations and stockpiled rationed food...", died:date('2005-03-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aTscEqH9GSbQDlT7hnKFilvzNkf.jpg", url:"https://themoviedb.org/person/2726"}}, {tmdbId:"2727", properties:{bornIn:"Morocco", imdbId:"0373289", born:date('1936-01-01'), name:"El Hedi ben Salem", bio:"El Hedi ben Salem is a Moroccan actor.  He is best known as the lover and collaborator of provocative German director Rainer Werner Fassbinder.  He died of a heart attack while in prison.  Fassbinder dedicated his last film, Querelle (1982), to Salem.  In 2012, a documentary on Salem's life entitled My Name Is Not Ali, premiered at the Montreal World Film Festival...", died:date('1976-01-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sPMb9tLQ5uPmzZrkbODFUyqtbAM.jpg", url:"https://themoviedb.org/person/2727"}}, {tmdbId:"2729", properties:{bornIn:"Munich, Germany", imdbId:"0379258", born:date('1942-10-04'), name:"Irm Hermann", bio:"Irmgard Hermann (born 4 October 1942) is a German actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/m8ZcK3gv86XUIiJUStK9Kn4bvCf.jpg", url:"https://themoviedb.org/person/2729"}}, {tmdbId:"2730", properties:{bornIn:"Zagreb, Yugoslavia [now Croatia]", imdbId:"0439546", born:date('1932-03-12'), name:"Elma Karlowa", died:date('1994-12-31'), url:"https://themoviedb.org/person/2730"}}, {tmdbId:"68679", properties:{imdbId:"0639941", name:"Paddy O'Byrne", url:"https://themoviedb.org/person/68679"}}, {tmdbId:"534894", properties:{imdbId:"0484307", born:date('1947-05-12'), name:"Micheline Lanctôt", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rQVRzBU3cZRRsjbNK43CfNtv608.jpg", url:"https://themoviedb.org/person/534894"}}, {tmdbId:"186336", properties:{imdbId:"0308185", born:date('1921-05-04'), name:"Patsy Garrett", url:"https://themoviedb.org/person/186336"}}, {tmdbId:"1152492", properties:{imdbId:"0280682", name:"Allen Fiuzat", url:"https://themoviedb.org/person/1152492"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"1172555", properties:{imdbId:"0807790", name:"Cynthia Smith", url:"https://themoviedb.org/person/1172555"}}, {tmdbId:"14253", properties:{bornIn:"Kingsburg, California, USA", imdbId:"0001620", born:date('1919-06-29'), name:"Slim Pickens", bio:"Was an American rodeo performer and film and television actor who epitomized the profane, tough, sardonic cowboy, but who is best remembered for his comic roles, notably in Dr.  Strangelove, 1941 and Blazing Saddles. \n\nDescription above from the Wikipedia article Slim Pickens, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1983-12-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/k4gIlBO0kGjibi8b4cPXIsPTjx0.jpg", url:"https://themoviedb.org/person/14253"}}, {tmdbId:"13640", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0466327", born:date('1927-02-15'), name:"Harvey Korman", bio:"From Wikipedia, the free encyclopedia\n\nHarvey Herschel Korman (February 15, 1927 – May 29, 2008) was an American comedic actor who performed in television and movie productions beginning in 1960.  His big break was being a featured performer on The Danny Kaye Show, but he is best remembered for his performances on the sketch comedy series The Carol Burnett Show and in several films by Mel Brooks, most notably as Hedley Lamarr in Blazing Saddles...", died:date('2008-05-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dwDbzPH4RaqvK9wXJzI2A4zK61f.jpg", url:"https://themoviedb.org/person/13640"}}, {tmdbId:"29915", properties:{bornIn:"Pensacola, Florida, USA", imdbId:"0198072", born:date('1948-12-31'), name:"Joe Dallesandro", bio:"Joseph Angelo D'Allesandro (born December 31, 1948), better known as Joe Dallesandro, is an American actor, and Warhol superstar.  Although he never became a mainstream film star, Dallesandro is generally considered to be the most famous male sex symbol of American underground films of the 20th century, as well as a sex symbol of gay subculture...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uMXKAa9uDu7CukAaTHjLTcKFZWa.jpg", url:"https://themoviedb.org/person/29915"}}, {tmdbId:"1072822", properties:{bornIn:"St John's Wood, London, England, UK", imdbId:"0571317", born:date('1922-06-25'), name:"Maxime McKendry", died:date('2009-04-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xjrPlIranvCS1jMp61mwCKFZrjg.jpg", url:"https://themoviedb.org/person/1072822"}}, {tmdbId:"70984", properties:{bornIn:"Hermosillo, Sonora, Mexico", imdbId:"0891835", born:date('1939-11-05'), name:"Isela Vega", bio:"Isela Vega Durazo (born November 5, 1939) is a Mexican actress, and occasional producer, writer, and director. \n\nDescription above from the Wikipedia article Isela Vega, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5varp4qcQUsFSUtrfYxGrToLDwe.jpg", url:"https://themoviedb.org/person/70984"}}, {tmdbId:"5255", properties:{bornIn:"Santa Ana, California, USA ", imdbId:"0916434", born:date('1924-10-14'), name:"Robert Webber", bio:"Over his 40-year career as one of Hollywood's veteran character actors, Robert Webber always marked his spot by playing all types of roles and was not stereotyped into playing just one kind of character.  Sometimes he even got to play a leading role (see Hysteria (1965)).  Webber first started out in small stage shows and a few Broadway plays and served a stint in the army before he landed the role of Juror 12 in 12 Angry Men (1957)...", died:date('1989-05-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1RlhCcfCkaSz0cWRSowsj5FiKXg.jpg", url:"https://themoviedb.org/person/5255"}}, {tmdbId:"86136", properties:{bornIn:"San Antonio, Texas, U.S.", imdbId:"0696031", born:date('1939-11-27'), name:"Ann Prentiss", bio:"From Wikipedia, the free encyclopedia\n\nAnn Prentiss (born November 27, 1939 - January 12, 2010) was an American actress, born to Sicilian emigrants in San Antonio, Texas.  Ann Prentiss was the younger sister of actress Paula Prentiss. \n\nPrentiss had many bit parts in movies and television series in the 1960s, 1970s and 1980s.  Her best known part was in the TV series Captain Nice, where she played Carter Nash's girlfriend, Sgt.  Candy Kane...", died:date('2010-01-12'), url:"https://themoviedb.org/person/86136"}}, {tmdbId:"30622", properties:{bornIn:"Chattanooga, Tennessee, USA", imdbId:"0919924", born:date('1951-03-04'), name:"Gwen Welles", bio:"From Wikipedia, the free encyclopedia\n\nGwen Welles (March 4, 1951 - October 13, 1993) was an American actress of stage and screen.  She was born in Chattanooga, Tennessee, as Gwen Goldberg, the daughter of Rebecca Weis Welles (born 1928), also an actress. \n\nGwen Welles may be best-remembered for her portrayal of talentless singer \"Sueleen Gay\", in Robert Altman's 1975 film Nashville, for which she was nominated for a BAFTA Award, for Best Supporting Actress...", died:date('1993-10-13'), url:"https://themoviedb.org/person/30622"}}, {tmdbId:"12295", properties:{bornIn:"New York City, USA", imdbId:"0520164", born:date('1929-07-22'), name:"Perry Lopez", bio:"​From Wikipedia, the free encyclopedia.   \n\nPerry Lopez (July 22, 1929 - February 14, 2008) was an American film and television actor.  His acting career lasted over 40 years before his death in 2008. \n\nLopez was born in New York City.  Lopez began his acting career on in theater, based in New York.  He was signed to a contract at Warner Bros.  Studios in 1955...", died:date('2008-02-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eOypJcorslBGIENQuGkeiTJF2oG.jpg", url:"https://themoviedb.org/person/12295"}}, {tmdbId:"3096", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0001030", born:date('1935-08-12'), name:"John Cazale", bio:"John Holland Cazale was an American actor.  He appeared in five films during six years that were nominated for the Academy Award for Best Picture: The Godfather, The Conversation, The Godfather Part II, Dog Day Afternoon, and The Deer Hunter.  He appeared in archival footage in The Godfather Part III, also nominated for Best Picture, making him the only actor to have this multi-film distinction...", died:date('1978-03-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/41wXX1FBalyIuf5eaA4S43Y8IfZ.jpg", url:"https://themoviedb.org/person/3096"}}, {tmdbId:"8351", properties:{bornIn:"Waxahachie - Texas - USA", imdbId:"0002078", born:date('1936-12-23'), name:"Frederic Forrest", bio:"Frederic Fenimore Forrest, Jr.  (born December 23, 1936) is an American actor. Notable film roles include The Conversation, Valley Girl ,Promise Him Anything (TV), One from the Heart, The Stone Boy, The Missouri Breaks, The Deliberate Stranger (TV), and horror maestro Dario Argento's first American film Trauma.  On television, he played Captain Richard Jenko on the first season of the Fox Television series 21 Jump Street, in 1987...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mEHEX8n5D2iA52GgQ9v95IZmokQ.jpg", url:"https://themoviedb.org/person/8351"}}, {tmdbId:"76019", properties:{bornIn:"The Bronx, New York, USA", imdbId:"0444198", born:date('1945-02-06'), name:"Steven Keats", bio:"From Wikipedia, the free encyclopedia\n\nSteven Keats (February 6, 1945 – May 8, 1994) was an American actor who appeared in such films as Silent Rage, Death Wish, Black Sunday, The Friends of Eddie Coyle, and the TV-movie version of the Norman Mailer book The Executioner's Song starring Tommy Lee Jones. \n\nDescription above from the Wikipedia article Steven Keats, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1994-05-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5KVt0cK00WkqGwet8QoSVffsCD7.jpg", url:"https://themoviedb.org/person/76019"}}, {tmdbId:"1090508", properties:{bornIn:"Chita, RSFSR, USSR [now Zabaykalsky Krai, Russia]", imdbId:"0813272", born:date('1935-06-18'), name:"Yuriy Solomin", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mHSMNAYOloMJTuyLU4PqsYZFiVD.jpg", url:"https://themoviedb.org/person/1090508"}}, {tmdbId:"58989", properties:{bornIn:"Kyzyl, Tyva, Russia", imdbId:"0613364", born:date('1910-05-02'), name:"Maksim Munzuk", bio:"From Wikipedia, the free encyclopedia\n\nMaxim Monguzhukovich Munzuk (Russian: Макси́м Монгужу́кович Мунзу́к; 15 September 1912 (on other accounts, 2 May 1910) – 28 July 1999 in Kyzyl, Tyva, Russia) was a Tuvan actor, one of the founders of Tuva's regional theatre.  He is best known for playing the title role in Akira Kurosawa's film Dersu Uzala. \n\nMaxim Munzuk was a versatile and creative person.  He was actor, director, singer, collector of musical folklore, composer, and teacher...", died:date('1999-07-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ygva6jk16z14NLkflL3aldS91aa.jpg", url:"https://themoviedb.org/person/58989"}}, {tmdbId:"58995", properties:{bornIn:"Pereslavl-Zalessky, Yaroslavl Region, USSR (now Russia)", imdbId:"0125730", born:date('1950-06-21'), name:"Mikhail Bychkov", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dJI0aU3l32ob2HT9jPnUOCjXeMD.jpg", url:"https://themoviedb.org/person/58995"}}, {tmdbId:"40181", properties:{bornIn:"Ottawa, Ontario, Canada", imdbId:"0001296", born:date('1915-02-12'), name:"Lorne Greene", bio:"Lorne Greene (February 12, 1915 – September 11, 1987), was the stage name of Lyon Himan Green, OC, a Canadian actor. \n\nHis television roles include Ben Cartwright on the western Bonanza, and Commander Adama in the science fiction movie and subsequent TV Series Battlestar Galactica.  He also worked on the Canadian television nature documentary series Lorne Greene's New Wilderness, and in television commercials as a dog food spokesman...", died:date('1987-09-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/33T4TPjdltWFAcJWedActHiai0W.jpg", url:"https://themoviedb.org/person/40181"}}, {tmdbId:"5964", properties:{bornIn:"Saint-Malo, France", imdbId:"0192490", born:date('1908-07-12'), name:"Alain Cuny", bio:"​From Wikipedia, the free encyclopedia\n\nAlain Cuny (12 July 1908 – 16 May 1994) was a French actor. \n\nHe was born René Xavier Marie in Saint-Malo, Brittany, and studied medicine for a while before entering the film industry as a costume and set designer.  Cuny started acting in the 1930s.  Among his most notable films are Les Visiteurs du soir (1942), by Marcel Carné; Les Amants (The Lovers 1958); La dolce vita (1960) and Satyricon (1969), the later two directed by Federico Fellini...", died:date('1994-05-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pWwOq4RTxq08FHaPCSobaKIp01A.jpg", url:"https://themoviedb.org/person/5964"}}, {tmdbId:"35319", properties:{bornIn:"Utrecht, Utrecht, Netherlands", imdbId:"0000482", born:date('1952-09-28'), name:"Sylvia Kristel", bio:"Sylvia Kristel was born in Utrecht, Netherlands on September 28, 1952 to father Jean-Nicholas and mother Piet.  She is known as being Dutch model, singer and actress...", died:date('2012-10-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9CoitH6zdr5FTBLh6FJZHnzkunc.jpg", url:"https://themoviedb.org/person/35319"}}, {tmdbId:"22212", properties:{bornIn:"Karlovac, Croatia, Yugoslavia (now Karlovac, Croatia)", imdbId:"0765325", born:date('1943-02-03'), name:"Daniel Sarky", died:date('1999-12-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bTNunjdPV35bpFC3HtkqMaueRlY.jpg", url:"https://themoviedb.org/person/22212"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"44110", properties:{bornIn:"Milano, Italy", imdbId:"0039967", born:date('1931-04-30'), name:"Adriana Asti", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kYZa3wNA2Ncyk3QZTvZo02spqUy.jpg", url:"https://themoviedb.org/person/44110"}}, {tmdbId:"3594", properties:{bornIn:"Algiers, Alger, France [now Algeria]", imdbId:"0077921", born:date('1910-06-19'), name:"Julien Bertheau", bio:"Julien Bertheau was born on June 19, 1910 in Algiers, Alger, France as Julien Désiré Bertheau.  He was a french actor...", died:date('1995-10-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2ytz1WGhPhTjPgvxllWuoqoW5li.jpg", url:"https://themoviedb.org/person/3594"}}, {tmdbId:"42851", properties:{imdbId:"0580989", born:date('1957-01-01'), name:"Franco Merli", url:"https://themoviedb.org/person/42851"}}, {tmdbId:"583351", properties:{imdbId:"0099102", name:"Tessa Bouché", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4vWoPYMQOZE0SY1p7sjBCffpPof.jpg", url:"https://themoviedb.org/person/583351"}}, {tmdbId:"29916", properties:{bornIn:"Brussels, Belgium", imdbId:"0888207", born:date('1927-03-25'), name:"Monique van Vooren", bio:"Monique van Vooren (born Monique Bronz or Bronze) was a Belgian-born American actress and dancer...", died:date('2020-01-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ekGqTb0zxZGynSZD1eCoDhHm2SH.jpg", url:"https://themoviedb.org/person/29916"}}, {tmdbId:"29917", properties:{bornIn:"Berlin, Germany", imdbId:"0432016", born:date('1947-11-13'), name:"Arno Juerging", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5hYTs7sYiDtXZStiMSKUdyk6Y6j.jpg", url:"https://themoviedb.org/person/29917"}}, {tmdbId:"4038", properties:{bornIn:"New York City, New York, USA", imdbId:"0000215", born:date('1946-10-04'), name:"Susan Sarandon", bio:"An American actress.  She has worked in films and television since 1969, and won an Academy Award for Best Actress for her performance in the 1995 film Dead Man Walking.  She had also been nominated for the award for four films before that and has received other recognition for her work.  She is also noted for her social and political activism for a variety of liberal causes...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oHYYL8bNakAREaLUBtMul5uMG0A.jpg", url:"https://themoviedb.org/person/4038"}}, {tmdbId:"27964", properties:{bornIn:"Charleston, South Carolina", imdbId:"0001381", born:date('1943-11-17'), name:"Lauren Hutton", bio:"​From Wikipedia, the free encyclopedia.   \n\nLauren Hutton (born November 17, 1943) is an American model and actress.  She is best-known for her starring roles in the movies American Gigolo and Lassiter, and also for her fashion modeling career. \n\nDescription above from the Wikipedia article Lauren Hutton, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5gUPtCh46ho5QPd5i6K9gxmmEU4.jpg", url:"https://themoviedb.org/person/27964"}}, {tmdbId:"10461", properties:{bornIn:" Windsor, Berkshire, England, UK", imdbId:"0613098", born:date('1949-01-16'), name:"Caroline Munro", bio:"Caroline Munro is an English stage and screen actress, vocalist, and model known for her many appearances in horror, science fiction and action films, and even in one where her character Naomi attempted to exterminate James Bond (Roger Moore).  Among the many Hammer Films productions she has been starring in \"Captain Kronos: Vampire Hunter\" (1974) and the role of Carla, she like the most...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jEQOpg8cJ1fiZwEd0HQI3N3HQYZ.jpg", url:"https://themoviedb.org/person/10461"}}, {tmdbId:"44865", properties:{bornIn:"Liverpool, England, UK", imdbId:"0048982", born:date('1934-01-20'), name:"Tom Baker", bio:"Thomas Stewart \"Tom\" Baker (born 20 January 1934) is a British actor and comedian.  He is best known for playing the fourth incarnation of the Doctor in the science fiction television series, Doctor Who, a role he played from 1974–1981...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ql8lv7SdpjRLQ3gahIAmEqTyu6g.jpg", url:"https://themoviedb.org/person/44865"}}, {tmdbId:"89065", properties:{bornIn:"London, England, UK", imdbId:"0932811", born:date('1920-01-08'), name:"Douglas Wilmer", died:date('2016-03-31'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aY09jrbttssYg2dPyIH6liUZfzL.jpg", url:"https://themoviedb.org/person/89065"}}, {tmdbId:"80191", properties:{imdbId:"0124335", name:"Marion Busia", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eC4Z5cuSs1YoUYWUlJnuqKkuj62.jpg", url:"https://themoviedb.org/person/80191"}}, {tmdbId:"80192", properties:{imdbId:"0202331", name:"Jerry Daugirda", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o4SRLUOrtqbNpcieHD68RuyJKGI.jpg", url:"https://themoviedb.org/person/80192"}}, {tmdbId:"80193", properties:{imdbId:"0570758", name:"James McIntyre", url:"https://themoviedb.org/person/80193"}}, {tmdbId:"32396", properties:{bornIn:"Bridgeport, Connecticut, USA", imdbId:"0001938", born:date('1944-08-04'), name:"Richard Belzer", bio:"Richard Jay Belzer is an American stand-up comedian, author,  and actor.  He is perhaps best known for his role as John Munch, which he has portrayed as a regular cast member on the NBC police drama series Homicide: Life on the Street and Law & Order: Special Victims Unit...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iVW93qnrTFrBH3Zk2A5T3ReCBBb.jpg", url:"https://themoviedb.org/person/32396"}}, {tmdbId:"54812", properties:{bornIn:"Woodstock, New York, USA", imdbId:"0000331", born:date('1943-10-08'), name:"Chevy Chase", bio:"Cornelius Crane \"Chevy\" Chase (born October 8, 1943) is an American comedian, writer, and television and film actor, born into a prominent entertainment industry family.  Chase worked a plethora of odd jobs before moving into comedy acting with National Lampoon.  He quickly became a key cast member in the inaugural season of Saturday Night Live, where his Weekend Update skit soon became a staple of the show...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v6TZAeufKcQhoNXe8JEXBOlyDO5.jpg", url:"https://themoviedb.org/person/54812"}}, {tmdbId:"1650959", properties:{name:"Buzzy Linhart", url:"https://themoviedb.org/person/1650959"}}, {tmdbId:"40176", properties:{bornIn:"Mount Vernon, New York, U.S.", imdbId:"0138770", born:date('1918-11-04'), name:"Art Carney", bio:"Arthur William Matthew “Art” Carney (November 4, 1918 – November 9, 2003) was an Academy Award-winning American actor in film, stage, television and radio.  He is best-known for playing Ed Norton, opposite Jackie Gleason's Ralph Kramden in the situation comedy The Honeymooners. \n\nDescription above from the Wikipedia article Art Carney, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2003-11-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aCD2BtOwrmz1Lpt079yJz8PV9O1.jpg", url:"https://themoviedb.org/person/40176"}}, {tmdbId:"237034", properties:{bornIn:"Granada, Nicaragua", imdbId:"0258089", born:date('1933-11-24'), name:"René Enríquez", bio:"René Enríquez was born on November 24, 1933 in Granada, Nicaragua.  He was an actor, known for Bananas (1971), Hill Street Blues (1981) and Dream West (1986).  He died on March 23, 1990 in Tarzana, Los Angeles, California, USA...", died:date('1990-03-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nZqwDRgZYvoMSZWOw3ETF1No8oV.jpg", url:"https://themoviedb.org/person/237034"}}, {tmdbId:"38253", properties:{imdbId:"0074596", born:date('1909-09-13'), name:"Herbert Berghof", died:date('1990-11-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wLorgq09NhzZb4infpIDPtFpTau.jpg", url:"https://themoviedb.org/person/38253"}}] AS row
