UNWIND [{tmdbId:"56867", properties:{bornIn:"Ottawa, Ontario, Canada", imdbId:"0571897", born:date('1959-06-26'), name:"Mark McKinney", bio:"From Wikipedia, the free encyclopedia. \n\nMark Douglas Brown McKinney (born June 26, 1959) is a Canadian comedian and actor, best known for his work in the sketch comedy troupe The Kids in the Hall.  Following the run of their television series (1989 to 1995) and feature film (Brain Candy), he went on to star in Saturday Night Live from 1995 to 1997...", url:"https://themoviedb.org/person/56867"}}, {tmdbId:"25308", properties:{bornIn:"London, England UK", imdbId:"0029502", born:date('1966-11-10'), name:"Vanessa Angel", bio:"​From Wikipedia, the free encyclopedia.   \n\nVanessa Madeline Angel (born 10 November 1966) is an English model and actress.  She played the role of Lisa on the television series Weird Science.  She is also known for her role as Claudia in the film Kingpin. \n\nDescription above from the Wikipedia article Vanessa Angel,  licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kLe0E2VkYgfVwGkaqxfpIpt7vUr.jpg", url:"https://themoviedb.org/person/25308"}}, {tmdbId:"27125", properties:{bornIn:"Maple Ridge, British Columbia, Canada", imdbId:"0662504", born:date('1972-06-14'), name:"Molly Parker", bio:"​Molly Parker is a Canadian film and television actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xo0GT4MAUkqCKKL8qq6WEmHDre5.jpg", url:"https://themoviedb.org/person/27125"}}, {tmdbId:"63791", properties:{bornIn:"Winnipeg, Manitoba, Canada", imdbId:"0106319", born:date('1953-12-22'), name:"Jay Brazeau", bio:"Jay Brazeau (born December 22, 1953) is a notable Canadian actor.  He was born in Winnipeg, Manitoba, Canada. His credits include voicing Richard Condie's Oscar-nominated animated short La Salla.  He also appeared in two of the first season episodes of Highlander: The Series in 1992.  In October 2009, he appeared as \"Man in chair\" in the National Arts Centre production of The Drowsy Chaperone in Ottawa.  In 2009, he played a part in several scenes added for the Ultimate Cut version of Watchmen...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3AJhDjSA8eQ7xDZV5Rf5cnFoKRw.jpg", url:"https://themoviedb.org/person/63791"}}, {tmdbId:"1193401", properties:{imdbId:"0605917", name:"Natasha Morley", url:"https://themoviedb.org/person/1193401"}}, {tmdbId:"11683", properties:{bornIn:"Prague, Czechoslovakia [now Czech Republic]", imdbId:"0006664", born:date('1936-03-28'), name:"Zdenek Sverák", bio:"From Wikipedia, the free encyclopedia\n\nZdeněk Svěrák (born 28 March 1936 in Prague) is a Czech actor, humorist and scriptwriter.  He is one of the most popular Czech cultural personalities.  In 1989, he was a member of the jury at the 39th Berlin International Film Festival. \n\nIn 1958, he graduated in Czech language and literature at the Faculty of Education of Charles University in Prague.  He has worked in a wide variety of capacities...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5S6DhXo9XS4nDPaA411piieJ1sQ.jpg", url:"https://themoviedb.org/person/11683"}}, {tmdbId:"2226771", properties:{name:"Andrey Khalimon", url:"https://themoviedb.org/person/2226771"}}, {tmdbId:"11684", properties:{bornIn:"Brno, Czechoslovakia [now in Czech Republic]", imdbId:"0755941", born:date('1953-06-07'), name:"Libuse Safránková", bio:"From Wikipedia, the free encyclopedia\n\nLibuše Šafránková (born 7 June 1953 in Brno, Czechoslovakia) is a Czech actress.  Her husband is actor Josef Abrhám.  She received the Czech Lion Award as best actress in a film in 1996 and then in 2008 she received the prize Hvězda mého srdce (Star of My Heart), awarded by Czech Television...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ylfmsG8AZu65PXnDlvNyOn02Tfv.jpg", url:"https://themoviedb.org/person/11684"}}, {tmdbId:"11685", properties:{bornIn:"Jihlava, Vysočina, Česko", imdbId:"0895384", born:date('1962-05-16'), name:"Ondrej Vetchý", bio:"From Wikipedia, the free encyclopedia\n\nOndřej Vetchý (born 16 May 1962) is a Czech actor.  He was born in Jihlava, Czechoslovakia. \n\nHe is currently employed at The Drama Club (DC) in Prague...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mCp0TSp6w28Rr9q4IOzYJhLmasx.jpg", url:"https://themoviedb.org/person/11685"}}, {tmdbId:"1221154", properties:{imdbId:"0020006", name:"Richie Allan", url:"https://themoviedb.org/person/1221154"}}, {tmdbId:"36898", properties:{bornIn:"New Jersey, USA ", imdbId:"0693531", born:date('1961-08-30'), name:"Ely Pouget", bio:"Ely Pouget was born on August 30, 1961 in New Jersey, USA as Elizabeth Pouget...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9MGEk0VSqlDUT1PwC46je5ieBGH.jpg", url:"https://themoviedb.org/person/36898"}}, {tmdbId:"158354", properties:{imdbId:"0485917", name:"Stephen J. Lang", url:"https://themoviedb.org/person/158354"}}, {tmdbId:"37252", properties:{bornIn:"Phillipsburg, New Jersey, USA", imdbId:"0956531", born:date('1989-01-16'), name:"Yvonne Zima", bio:"Yvonne Zima is an American film and television actress, best known for playing the television roles of Rachel Greene on the medical series \"ER\" and Daisy on the daytime soap \"The Young and the Restless\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dWA4Hsq8kkFXlmWERCoAh1OqK5M.jpg", url:"https://themoviedb.org/person/37252"}}, {tmdbId:"14886", properties:{bornIn:"Rye Brook, New York, USA", imdbId:"0081572", born:date('1964-08-18'), name:"Craig Bierko", bio:"Craig Bierko is an American stage and screen actor and singer, best known for playing the lead role Chet Wilton in the Lifetime dramedy series \"UnREAL\".  He holds an BS in Theater Arts from The School of Speech, Northwestern University, Evanston, Illinois...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/btsSJRxc0i7Xty1R0iCYOnbTuDE.jpg", url:"https://themoviedb.org/person/14886"}}, {tmdbId:"66297", properties:{bornIn:"Allentown, Pennsylvania, USA ", imdbId:"0036544", born:date('1936-02-07'), name:"Madison Arnold", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rbgHUIcP9rD0AwWNliCD3ZR80ep.jpg", url:"https://themoviedb.org/person/66297"}}, {tmdbId:"154680", properties:{imdbId:"0029646", name:"Vincent Angell", bio:"Vincent Angell is an actor, writer and producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fuxVCSCPTwCBLbrsnCJun3LHaV2.jpg", url:"https://themoviedb.org/person/154680"}}, {tmdbId:"1217850", properties:{imdbId:"0946474", born:date('1983-06-19'), name:"Michael Yarmush", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q2KNjKxABx5Yqv66jzIi7TydDwS.jpg", url:"https://themoviedb.org/person/1217850"}}, {tmdbId:"9285", properties:{bornIn:"USA", imdbId:"0741803", born:date('1944-08-19'), name:"John Roselius", died:date('2018-10-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hyN3arrpWwnoJXaFxdiXVppxN3i.jpg", url:"https://themoviedb.org/person/9285"}}, {tmdbId:"9286", properties:{imdbId:"0258388", name:"Louis Eppolito", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x5nWpfKJidsXtBYn6lhawWvoW7I.jpg", url:"https://themoviedb.org/person/9286"}}, {tmdbId:"3068", properties:{bornIn:" Melbourne, Australia", imdbId:"0206510", born:date('1971-09-28'), name:"Matt Day", bio:"​From Wikipedia, the free encyclopedia.   \n\nMatthew \"Matt\" Day (born 28 September 1971) is an Australian actor best known for his film and television roles. \n\nDescription above from the Wikipedia article Matt Day,  licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/3068"}}] AS row
