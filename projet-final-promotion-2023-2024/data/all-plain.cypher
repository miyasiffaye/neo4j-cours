UNWIND [{tmdbId:"51455", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0507381", born:date('1983-10-29'), name:"Johnny Lewis", bio:"Johnnie Lewis (October 29, 1983 - September 26, 2012) was an American film and television actor...", died:date('2012-09-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ebfmLC4cr4F31aDw6DGMJcjOJNz.jpg", url:"https://themoviedb.org/person/51455"}}, {tmdbId:"79037", properties:{bornIn:"Aomori Prefecture, Japan", imdbId:"1947564", born:date('1985-03-05'), name:"Ken'ichi Matsuyama", bio:"Kenichi Matsuyama (松山 ケンイチ, Matsuyama Ken'ichi, born March 5, 1985) is a Japanese actor.  He is known for his affinity for strange character roles, and he is best known internationally for playing L in the 2006 films Death Note, Death Note 2: The Last Name and L: Change the World in 2008, as well as voicing Gelus in the Death Note animated adaptation...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ftW3HpGZo40jfiN2V4csEaMG4MF.jpg", url:"https://themoviedb.org/person/79037"}}, {tmdbId:"77678", properties:{imdbId:"0786059", name:"Asaka Seto", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Jw4JZWisPhcF8JfQmemU9jP9ES.jpg", url:"https://themoviedb.org/person/77678"}}, {tmdbId:"84621", properties:{imdbId:"0396093", name:"Shigeki Hosokawa", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8D7bd1dRCRC3C5QqpqaDwrhUbww.jpg", url:"https://themoviedb.org/person/84621"}}, {tmdbId:"18328", properties:{bornIn:"El Centro, California, USA", imdbId:"0397432", born:date('1944-03-28'), name:"Ken Howard", bio:"Ken Howard (born March 28, 1944) is an American actor, best known for his roles in 1776 and on White Shadow...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fscTtY1JYJSxQdwk7ybtTtWTKiN.jpg", url:"https://themoviedb.org/person/18328"}}, {tmdbId:"53368", properties:{bornIn:"Omaha, Nebraska, USA", imdbId:"2187603", born:date('1979-07-14'), name:"Scott Porter", bio:"From Wikipedia, the free encyclopedia. \n\nMatthew Scott Porter (born July 14, 1979 height 6' (1,83 m)) is an American actor and occasional singer known for his role as Jason Street in the NBC television drama Friday Night Lights.  His character was injured during a football game in the pilot episode and became a parapalegic.  The character was inspired by David Edwards, a high school football player...", url:"https://themoviedb.org/person/53368"}}, {tmdbId:"1077875", properties:{imdbId:"0045813", name:"Nick Bacon", url:"https://themoviedb.org/person/1077875"}}, {tmdbId:"1077876", properties:{imdbId:"1961278", name:"Andrew Wyatt", url:"https://themoviedb.org/person/1077876"}}, {tmdbId:"229932", properties:{bornIn:"Tehran, Iran", imdbId:"0267042", born:date('1983-07-10'), name:"Golshifteh Farahani", bio:"Golshifteh Farahani (گلشیفته فراهانی) was born on 10th July 1983 and is an international Iranian actress.  She has dual Iranian and French nationality.  Golshifteh Farahani started her acting career in theatre at the age of 6.  Since then she has played in more than 40 films, many of which have been screened or awarded at international festivals...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/DuAPmZxZlX25m57pJy16WbIyKM.jpg", url:"https://themoviedb.org/person/229932"}}, {tmdbId:"1047942", properties:{bornIn:"Birmingham - England - UK", imdbId:"0112397", name:"Geraldine Brophy", bio:"Geraldine Brophy was born in Birmingham, England.  She is an actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mkzENh5wGiH2J4ZAqrJfE4Yqiw2.jpg", url:"https://themoviedb.org/person/1047942"}}, {tmdbId:"11451", properties:{imdbId:"0132426", name:"Eddie Campbell", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eArISmcZa3ICYn69QjcGt7qZbno.jpg", url:"https://themoviedb.org/person/11451"}}, {tmdbId:"93252", properties:{bornIn:"Busan, South Korea", imdbId:"3482070", born:date('1955-12-30'), name:"Hae-suk Kim", bio:"Kim Hae Sook is a South Korean actress.  She made her acting debut in 1974.   She has won numerous awards for her various roles in countless television dramas and films.  You can find her in dramas  and films such as, “I Hear Your Voice” (2013), “Pinocchio” (2015), “Father is Strange” (2017), “Mother of Mine” (2019), Thirst (2009), The Handmaiden (2016), and The Thieves (2012)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gbWb5gXuhGCnTSogCrmMPD65F8w.jpg", url:"https://themoviedb.org/person/93252"}}, {tmdbId:"19995", properties:{bornIn:"Hampstead, London, England, UK ", imdbId:"0265717", born:date('1946-12-29'), name:"Marianne Faithfull", bio:"Daughter of Eva, the Baroness Erisso, and Major Glynn Faithfull, a WWII British spy.  Recorded the first song written by Mick Jagger and Keith Richards, \"As Tears Go By\" (1964).  Involved in a major drug scandal with Jagger, Richards and others, which ultimately turned public opinion favorably towards the 'Rolling Stones' and other rock groups.  In the 70's she became addicted to heroin and was homeless in London's Soho district for a couple of years...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jDUoK3Lg4hL84kihErRvYtABwz4.jpg", url:"https://themoviedb.org/person/19995"}}, {tmdbId:"19997", properties:{bornIn:"London, England, UK", imdbId:"1305192", born:date('1983-04-15'), name:"Siobhan Hewlett", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eM0MCTL0VOc4elvhkzbSH3VBXBa.jpg", url:"https://themoviedb.org/person/19997"}}, {tmdbId:"2133770", properties:{name:"Janet Shular", url:"https://themoviedb.org/person/2133770"}}, {tmdbId:"1113554", properties:{imdbId:"2828850", name:"Juan Luis Acevedo", url:"https://themoviedb.org/person/1113554"}}, {tmdbId:"558915", properties:{imdbId:"1579662", name:"Jolene Andersen", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jeWRoKlw3UYWShVIdzVoJHSGrkf.jpg", url:"https://themoviedb.org/person/558915"}}, {tmdbId:"1014850", properties:{imdbId:"4927323", name:"Emanuel Ragsdale", url:"https://themoviedb.org/person/1014850"}}, {tmdbId:"177838", properties:{imdbId:"1035082", name:"Jill Basey", bio:"Jill Basey is an actress...", url:"https://themoviedb.org/person/177838"}}, {tmdbId:"7372", properties:{bornIn:"Mexico City, Distrito Federal, Mexico", imdbId:"0001917", born:date('1940-04-06'), name:"Pedro Armendáriz Jr.", bio:"Pedro Armendáriz Bohr (April 6, 1940 – December 26, 2011), better known by his stage name Pedro Armendáriz, Jr. , was a Mexican actor who made films and television series from United States and Mexico.  Pedro Armendáriz Bohr was born in Mexico City, to Mexican actor Pedro Armendáriz and Carmela Bohr.  Armendáriz appeared in the James Bond film, Licence to Kill as president Hector Lopez...", died:date('2011-12-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ngvcAFirJ6M7n8oO6FvgRYeIsX8.jpg", url:"https://themoviedb.org/person/7372"}}] AS row
