UNWIND [{tmdbId:"69721", properties:{imdbId:"0542752", name:"Farhad Mann", bio:"Farhad Mann is an American director of film and television best known for the theatrical releases Lawnmower Man 2: Beyond Cyberspace, Fighting for Freedom, and Return to Two Moon Junction.  Since 1987, Mann has directed dozens of television films and episodes for a variety of networks...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uFKMT5MHDEMuFLnv2dXPYIpgDIa.jpg", url:"https://themoviedb.org/person/69721"}}, {tmdbId:"142513", properties:{bornIn:"Adelaide, South Australia, Australia", imdbId:"0188521", born:date('1972-01-26'), name:"Emma-Kate Croghan", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rZ2WdWPel8Eu5ciBkaRITDD8uWC.jpg", url:"https://themoviedb.org/person/142513"}}, {tmdbId:"59635", properties:{bornIn:"Stuttgart, Germany", imdbId:"0952360", born:date('1946-09-07'), name:"Jerry Zaks", bio:"Jerry Zaks (born September 7, 1946) is a German-born American stage and television director, and actor.  He won the Tony Award for Best Direction of a Play and Drama Desk Award for directing The House of Blue Leaves, Lend Me A Tenor, and Six Degrees of Separation and the Tony Award for Best Direction of a Musical and Drama Desk Award for Guys and Dolls...", url:"https://themoviedb.org/person/59635"}}, {tmdbId:"118441", properties:{bornIn:"Philadelphia, Pennsylvania, U.S.A.", imdbId:"1861965", born:date('1927-05-08'), name:"Murray Lerner", died:date('2017-09-02'), url:"https://themoviedb.org/person/118441"}}, {tmdbId:"57226", properties:{imdbId:"0638175", name:"Claude Nuridsany", url:"https://themoviedb.org/person/57226"}}, {tmdbId:"57227", properties:{imdbId:"0701821", name:" Marie Pérennou", url:"https://themoviedb.org/person/57227"}}, {tmdbId:"2182", properties:{imdbId:"0219720", name:"Pen Densham", bio:"Pen Densham is a film and television producer, writer, and director born in England.  At nineteen, he moved to Canada and became a Canadian citizen.  He co-founded the Toronto-based production company Insight Productions with John Watson.  The duo also founded  the Trilogy Entertainment Group in Hollywood and its Canadian counterpart, Trilogy Entertainment North.  Densham married and has two children with Wendy Savage...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1rq1REEZFgz2yd07gp8m77oO4Cj.jpg", url:"https://themoviedb.org/person/2182"}}, {tmdbId:"32278", properties:{bornIn:"Rockville Center, New York, USA", imdbId:"0716257", born:date('1966-04-27'), name:"Matt Reeves", bio:"Matthew George \"Matt\" Reeves (born April 27, 1966 in Rockville Center, New York, USA) is an American screenwriter, director, and producer.  He began making movies at age eight, directing friends and using a wind-up camera.  Reeves befriended filmmaker J. J.  Abrams when both were 13 years old and they were making short films together.  When Reeves and Abrams were 15 or 16 years old, Steven Spielberg hired them to transfer some of his own Super 8 films to videotape...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fj2OSoBhVepDZSfLXisGJmMXDNo.jpg", url:"https://themoviedb.org/person/32278"}}, {tmdbId:"1284493", properties:{bornIn:"USA", born:date('1962-01-01'), name:"R.J. Cutler", url:"https://themoviedb.org/person/1284493"}}, {tmdbId:"621628", properties:{imdbId:"0888083", name:" David Van Taylor", url:"https://themoviedb.org/person/621628"}}, {tmdbId:"183036", properties:{imdbId:"0254120", born:date('1968-04-06'), name:"Doug Ellin", url:"https://themoviedb.org/person/183036"}}, {tmdbId:"76462", properties:{bornIn:"New York City, New York, U.S.", imdbId:"0770942", born:date('1958-03-06'), name:"Richard Schenkman", bio:"Richard Schenkman is an award-winning American screenwriter, film producer, film director and occasional actor.  Throughout his career, he has frequently also been credited as \"George Axmith\"...", url:"https://themoviedb.org/person/76462"}}, {tmdbId:"118020", properties:{bornIn:"Paris, France", imdbId:"0230695", born:date('1944-03-15'), name:"Jacques Doillon", bio:"Jacques Doillon (born 15 March 1944 in Paris, France) is a French film director.  He has a habit of giving lead roles to inexperienced young actresses in his films on family life and women.  Some actresses to break through are Fanny Bastien, Sandrine Bonnaire, Judith Godrèche, Marianne Denicourt and Charlotte Gainsbourg and Juliette Binoche.  His 1990 film La vengeance d'une femme was entered into the 40th Berlin International Film Festival...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pPeiNtf4JkM0RUIFTKTEoN3YaNF.jpg", url:"https://themoviedb.org/person/118020"}}, {tmdbId:"17812", properties:{bornIn:"Abilene - Texas - USA", imdbId:"0387706", born:date('1944-11-27'), name:"Gregory Hoblit", bio:"Gregory King Hoblit is an American Hollywood film director and TV producer. \n\nHoblit was born in Abilene, Texas, the son of Elizabeth Hubbard King and Harold Foster Hoblit, an FBI agent.  Much of Hoblit's work is oriented towards police, attorneys, and legal cases.  Hoblit has directed and produced episodes of several popular television shows such as NYPD Blue, L. A.  Law, and Hill Street Blues, as well as a made-for-TV-movie based on Roe v.  Wade.  He also wrote an episode of Hill Street Blues...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1YUF4UpcCX3j3J65a4L1KoLOHAl.jpg", url:"https://themoviedb.org/person/17812"}}, {tmdbId:"21183", properties:{bornIn:"Copenhagen, Denmark", imdbId:"0716347", born:date('1970-09-29'), name:"Nicolas Winding Refn", bio:"Nicolas Winding Refn (born 29 September 1970) is a Danish film director, screenwriter and producer.   He is known for directing the crime dramas Bleeder (1999) and the Pusher films (1996-2005), the fictionalised biographical film Bronson (2008), the dramatic adventure film Valhalla Rising (2009), the neo-noir crime film Drive (2011), the thriller Only God Forgives (2013), and the psychological horror film The Neon Demon (2016)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bPOkVITQdugCFJkbdLtsrdruEZC.jpg", url:"https://themoviedb.org/person/21183"}}, {tmdbId:"612525", properties:{imdbId:"0588769", name:"Kurt Miller", bio:"The son of legendary ski movie creator Warren Miller...", url:"https://themoviedb.org/person/612525"}}, {tmdbId:"1903661", properties:{name:" Peter Speek", url:"https://themoviedb.org/person/1903661"}}, {tmdbId:"104404", properties:{imdbId:"0053157", born:date('1963-09-12'), name:"Norberto Barba", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dGtWLR3P7F9ufp8ZPtAAlU4SqOJ.jpg", url:"https://themoviedb.org/person/104404"}}, {tmdbId:"1232954", properties:{imdbId:"0957453", name:"Lee David Zlotoff", url:"https://themoviedb.org/person/1232954"}}, {tmdbId:"65548", properties:{imdbId:"0295007", name:"Rick Friedberg", url:"https://themoviedb.org/person/65548"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"1202000", properties:{imdbId:"0838016", name:"Daniel J. Sullivan", url:"https://themoviedb.org/person/1202000"}}, {tmdbId:"1869", properties:{bornIn:"Marl, Germany", imdbId:"0941811", born:date('1959-08-25'), name:"Sönke Wortmann", bio:"From Wikipedia, the free encyclopedia\n\nSönke Wortmann (August 25, 1959 in Marl, North Rhine-Westphalia) is a German film director and producer. \n\nDescription above from the Wikipedia article Sönke Wortmann, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/1869"}}, {tmdbId:"11694", properties:{bornIn:"New York City, New York, USA", imdbId:"0510731", born:date('1965-07-24'), name:"Doug Liman", bio:"Doug Liman (born July 24, 1965) is an American film director and producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/byKGlOIEWD8yHx1eYHJ7PKI9eAA.jpg", url:"https://themoviedb.org/person/11694"}}, {tmdbId:"10953", properties:{imdbId:"0012155", name:"Gilbert Adler", url:"https://themoviedb.org/person/10953"}}, {tmdbId:"19840", properties:{bornIn:"Santiago de Chile, Chile", imdbId:"0024622", born:date('1972-03-31'), name:"Alejandro Amenábar", bio:"From Wikipedia, the free encyclopedia. \n\nAlejandro Fernando Amenábar Cantos (born 31 March 1972) is a Spanish film director.  Amenábar was born in Santiago, Chile to a Spanish mother and Chilean father, but the family moved to Spain just one year after his birth.  He studied cinema at Madrid's Universidad Complutense but eventually dropped out...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/f8JYFevN6b18oBL5mgh0b8ygMmc.jpg", url:"https://themoviedb.org/person/19840"}}, {tmdbId:"82829", properties:{imdbId:"0643422", name:"Michael Oblowitz", bio:"Michael Oblowitz is a South African filmmaker who has directed and produced a number of critically acclaimed movies and videos. \n\nDescription above from the Wikipedia article Michael Oblowitz , licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/82829"}}, {tmdbId:"87267", properties:{bornIn:"Naples, Campania, Italy", imdbId:"0742940", born:date('1922-11-15'), name:"Francesco Rosi", bio:"From Wikipedia, the free encyclopedia. \n\nFrancesco Rosi (15 November 1922 – 10 January 2015) was an Italian film director.  His film The Mattei Affair won the Palme d'Or at the 1972 Cannes Film Festival.  Rosi's films, especially those of the 1960s and 1970s, often appeared to have political messages...", died:date('2015-01-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lhEci3ufaNPt4RUqosne02yjvXq.jpg", url:"https://themoviedb.org/person/87267"}}, {tmdbId:"15042", properties:{bornIn:"USA", imdbId:"0762541", name:"Arlene Sanford", bio:"Arlene Sanford is an American film and television director.  \n\nSanford has directed for several present-day network television series and several motion picture and television movies which include A Very Brady Sequel, I'll Be Home for Christmas and Welcome Home.  \n\nMore recently, Sanford has directed episodes of ABC's popular soap drama, Desperate Housewives and also two episodes of Boston Legal...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dHPhsNnybFnfNsWXYVPZkrZC4OF.jpg", url:"https://themoviedb.org/person/15042"}}, {tmdbId:"56539", properties:{bornIn:"New York City - New York - USA", imdbId:"0392237", born:date('1960-03-22'), name:"Nicole Holofcener", bio:"From Wikipedia, the free encyclopedia. \n\nNicole Holofcener (born March 22, 1960) is an American film and television director and screenwriter.  She has directed six feature films, including Friends with Money and Enough Said as well as various television series...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/FawkGwho6HwcVr85WCZkyH5lhu.jpg", url:"https://themoviedb.org/person/56539"}}, {tmdbId:"29378", properties:{imdbId:"0002417", name:"Daniel Pyne", url:"https://themoviedb.org/person/29378"}}, {tmdbId:"69099", properties:{bornIn:"Vancouver, Canada", imdbId:"0006959", born:date('1958-05-11'), name:"Dan Ireland", bio:"From Wikipedia, the free encyclopedia. \n\nDan Ireland is a film director, producer and co-founder of the Seattle International Film Festival. \n\nDescription above from the Wikipedia article Dan Ireland, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/69099"}}, {tmdbId:"226552", properties:{imdbId:"0872316", name:"Blair Treu", url:"https://themoviedb.org/person/226552"}}, {tmdbId:"111247", properties:{imdbId:"0169874", name:"Alan Cohn", url:"https://themoviedb.org/person/111247"}}, {tmdbId:"1214396", properties:{imdbId:"0934525", name:"Scott Winant", url:"https://themoviedb.org/person/1214396"}}, {tmdbId:"2675219", properties:{name:"Sean McNamara", url:"https://themoviedb.org/person/2675219"}}, {tmdbId:"2691", properties:{bornIn:"Nashville, Tennessee, USA", imdbId:"0776114", born:date('1950-10-20'), name:"Tom Schulman", bio:"Thomas H.  Schulman (born October 20, 1950 in Nashville) is an American screenwriter most famous for his screenplay Dead Poets Society which won the Best Screenplay Academy Award for 1989. \n\nOther scripts include Honey, I Shrunk the Kids, Welcome to Mooseport, What About Bob?, 8 Heads In A Duffel Bag and Medicine Man. \n\nIn 2009, Schulman was elected vice president of the Writers Guild of America, West. \n\nTom Schulman lives in Los Angeles, California with his wife Miriam and sons Max and Peter...", url:"https://themoviedb.org/person/2691"}}, {tmdbId:"2419", properties:{bornIn:"Roanne, Loire, France", imdbId:"0000466", born:date('1953-09-03'), name:"Jean-Pierre Jeunet", bio:"From Wikipedia, the free encyclopedia\n\nJean-Pierre Jeunet is a French film director and screenwriter known for the films Delicatessen, The City of Lost Children, Alien: Resurrection and Amélie. \n\nJean-Pierre Jeunet was born in Roanne, Loire, France.  He bought his first camera at the age of 17 and made short films while studying animation at Cinémation Studios.  He befriended Marc Caro, a designer and comic book artist who became his longtime collaborator and co-director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/u3QmPbF9gdTTLsAHS97ic93gg6S.jpg", url:"https://themoviedb.org/person/2419"}}, {tmdbId:"62872", properties:{bornIn:" Wiesbaden, Germany", imdbId:"0902290", born:date('1966-12-15'), name:"Katja von Garnier", bio:"A German film director.  Her 1993 practice film Abgeschminkt! was shown in theaters all over Germany and attracted 1. 2 million visitors.  The project had been rejected by several producers that had not believed that a one-hour film could become a commercial success. The 1997 film Bandits starring Katja Riemann was also a commercial success and was the winner of the Grand Prize at the 10th Yubari International Fantastic Film Festival held in February 1999...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yJiF8M87U7DjcdDtMijVAy0XppD.jpg", url:"https://themoviedb.org/person/62872"}}, {tmdbId:"84896", properties:{bornIn:"Swansea, Wales, UK", imdbId:"0558773", born:date('1956-03-14'), name:"Sean Mathias", bio:"​From Wikipedia, the free encyclopedia.   \n\nSean Gerard Mathias (born 14 March 1956) is a British theatre director, film director, writer and actor.  Mathias was born in Swansea, south Wales.  He is known for directing the film, Bent, and for directing highly acclaimed theatre productions in London, New York, Cape Town, Los Angeles and Sydney.  He has also had a notable professional and personal partnership with the actor, Sir Ian McKellen, since the late 1970s...", url:"https://themoviedb.org/person/84896"}}, {tmdbId:"84714", properties:{bornIn:"Buenos Aires, Argentina", imdbId:"0002728", born:date('1959-07-19'), name:"Juan José Campanella", bio:"From Wikipedia, the free encyclopedia. \n\nJuan José Campanella (born July 19, 1959) is an Argentine television and film director. \n\nDescription above from the Wikipedia article Juan J.  Campanella, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p4wpKzQn2ZSuxbiuv2whmLVha48.jpg", url:"https://themoviedb.org/person/84714"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"61905", properties:{imdbId:"0896509", name:"Steven Vidler", url:"https://themoviedb.org/person/61905"}}, {tmdbId:"116653", properties:{imdbId:"0612812", name:"Lance Mungia", url:"https://themoviedb.org/person/116653"}}, {tmdbId:"549024", properties:{imdbId:"0949796", name:"Lance Young", url:"https://themoviedb.org/person/549024"}}, {tmdbId:"4762", properties:{bornIn:"Studio City, California, USA", imdbId:"0000759", born:date('1970-06-26'), name:"Paul Thomas Anderson", bio:"Paul Thomas Anderson is an American film director, screenwriter, and producer.  He has written and directed eight feature films: Hard Eight (1996), Boogie Nights (1997), Magnolia (1999), Punch-Drunk Love (2002), There Will Be Blood (2007), The Master (2012), Inherent Vice (2014) and Phantom Thread (2017)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/29DHpRKddqTwo2NU162Y49JoQYa.jpg", url:"https://themoviedb.org/person/4762"}}, {tmdbId:"113337", properties:{bornIn:"Sverdlovsk, USSR (Ekaterinburg, Russia)", imdbId:"0049326", born:date('1959-02-25'), name:"Aleksey Balabanov", died:date('2013-05-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3AWjEBAwWW92pMIv0Zck27PJBjx.jpg", url:"https://themoviedb.org/person/113337"}}, {tmdbId:"7213", properties:{bornIn:"Woodbridge - Connecticut - USA", imdbId:"0609236", born:date('1961-11-28'), name:"Jonathan Mostow", bio:"From Wikipedia, the free encyclopedia. \n\nJonathan Mostow (born November 28, 1961, in Woodbridge, Connecticut) is an American film director, writer and producer...", url:"https://themoviedb.org/person/7213"}}, {tmdbId:"7736", properties:{imdbId:"0805760", name:"Pål Sletaune", url:"https://themoviedb.org/person/7736"}}, {tmdbId:"42378", properties:{bornIn:" Melbourne, Victoria, Australia", imdbId:"0803203", born:date('1962-03-17'), name:"Rob Sitch", bio:"​From Wikipedia, the free encyclopedia.   \n\nRobert Ian Sitch (born 17 March 1962), is an Australian director, producer, screenwriter, actor and comedian. Sitch is currently a member of the Working Dog production company which produced the television shows Frontline, A River Somewhere, The Panel, Thank God You're Here and feature films The Castle and The Dish.  Sitch co-wrote and directed both of these movies...", url:"https://themoviedb.org/person/42378"}}, {tmdbId:"61411", properties:{bornIn:"Columbus, Ohio, USA", imdbId:"0227540", name:"Mark Dindal", bio:"Mark Dindal (born in Columbus, Ohio) is an American effects animator and director, who created The Emperor's New Groove as well as Cats Don't Dance.  He worked in many Disney classic projects as an effects animator, and also led the special effects for several classic movies such as The Little Mermaid and The Rescuers Down Under...", url:"https://themoviedb.org/person/61411"}}, {tmdbId:"933065", properties:{bornIn:"Greenville, Ohio, USA", imdbId:"0885666", born:date('1964-11-24'), name:"Jim Van Bebber", bio:"Jim Van Bebber is an actor and director, known for horror/exploitation films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5ss55XT7iZYuyeYSiDpbqkAg8bd.jpg", url:"https://themoviedb.org/person/933065"}}, {tmdbId:"42994", properties:{bornIn:"Washington, District of Columbia, USA", imdbId:"0229694", born:date('1969-06-23'), name:"David Dobkin", bio:"David Dobkin is a film director, producer and former screenwriter best known for directing Clay Pigeons, Shanghai Knights and Wedding Crashers...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c1cs3r7rDOzk0n32EDlon1xCGlE.jpg", url:"https://themoviedb.org/person/42994"}}, {tmdbId:"145134", properties:{bornIn:"Madison, Wisconsin, USA", imdbId:"0819613", name:"Jill Sprecher", bio:"Jill Sprecher is an American film director, producer and writer.  Sprecher collaborates on her film projects with her sister, Karen Sprecher, who writes.  Sprecher's films have starred Mathew McConaughey, Lisa Kudrow, and Greg Kinnear.  She is known for her films Clockwatchers and Thirteen Conversations About One Thing and her contributions to Big Love on HBO. [1] Her films feature stories about realistic human experiences and the struggles of women...", url:"https://themoviedb.org/person/145134"}}, {tmdbId:"9182", properties:{bornIn:"Philadelphia, Pennsylvania, USA", imdbId:"0380980", born:date('1952-02-23'), name:"Marshall Herskovitz", bio:"From Wikipedia, the free encyclopedia\n\nMarshall Schreiber Herskovitz (born February 23, 1952) is an American film director, writer and producer, and currently the President Emeritus of the Producers Guild of America.  Among his productions are Traffic, The Last Samurai, Blood Diamond, and I Am Sam.  Herskovitz has directed two feature films, Jack the Bear and Dangerous Beauty...", url:"https://themoviedb.org/person/9182"}}, {tmdbId:"588701", properties:{imdbId:"0005197", name:"Des McAnuff", url:"https://themoviedb.org/person/588701"}}, {tmdbId:"77919", properties:{imdbId:"0564827", name:"Tim McCanlies", bio:"From Wikipedia, the free encyclopedia\n\nTim McCanlies (born 1953) is a film director and screenwriter.  He has attracted attention for his work writing and directing Secondhand Lions, and wrote the screenplays for The Iron Giant and Dennis the Menace Strikes Again. \n\nMcCanlies attended high school in Bryan, Texas and took some college level courses at nearby Texas A&amp;M University.  In 1971, he moved to Austin and enrolled at the University of Texas majoring in Radio-Television-Film...", url:"https://themoviedb.org/person/77919"}}, {tmdbId:"84692", properties:{bornIn:"Oakland, California, USA", imdbId:"0852363", born:date('1958-07-04'), name:"Finn Taylor", url:"https://themoviedb.org/person/84692"}}, {tmdbId:"96854", properties:{imdbId:"0276397", born:date('1964-02-05'), name:"Martha Fiennes", url:"https://themoviedb.org/person/96854"}}, {tmdbId:"77211", properties:{bornIn:"Bakersfield, California, USA", imdbId:"0258066", born:date('1951-03-07'), name:"Félix Enríquez Alcalá", bio:"Félix Enríquez Alcalá is an American television and movie director, cinematographer, producer and painter.  He graduated with a fine arts degree from SMU and followed that up by attending the Art Center School of Design, Los Angeles...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8kizMUI6N48uIjCwh2pQrOSXADJ.jpg", url:"https://themoviedb.org/person/77211"}}, {tmdbId:"64099", properties:{bornIn:"New York City, New York, USA", imdbId:"0683578", name:"Sam Pillsbury", bio:"​From Wikipedia, the free encyclopedia\n\nSam Pillsbury is an American film director and producer. \n\nConnecticut-raised Sam Pillsbury emigrated to New Zealand at the age of 14.  Aged 23, he began working at the Government-owned National Film Unit, joining a group of emerging filmmakers who were investigating new subjects and styles...", url:"https://themoviedb.org/person/64099"}}, {tmdbId:"57630", properties:{bornIn:"Twickenham, London", imdbId:"0146341", born:date('1964-01-01'), name:"Peter Cattaneo", bio:"​From Wikipedia, the free encyclopedia\n\nPeter Cattaneo was born in 1964 in Twickenham, London.  He is a two-time Academy Award-nominated English filmmaker most famous for directing the hit British film The Full Monty.  He also directed 2005's Opal Dream. \n\nDescription above from the Wikipedia article Peter Cattaneo, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pbEHAEZJoViBebsf9LbN7vjbGcm.jpg", url:"https://themoviedb.org/person/57630"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"8685", properties:{bornIn:"Paraparaumu, New Zealand", imdbId:"0629272", born:date('1964-06-01'), name:"Andrew Niccol", bio:"Andrew M.  Niccol (born 10 June 1964) is a New Zealand-born screenwriter, producer, and director.  He wrote and directed Gattaca, S1m0ne, and Lord of War.  He also wrote and co-produced The Truman Show, which earned him an Academy Award nomination for best original screenplay in 1999 and won him a BAFTA award for Best Screenplay.  Many of his films, such as Gattaca, S1m0ne and The Truman Show view societal or political issues through a fantasy-science fiction lens...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jTNhskoCvZsLqZwk5CFIrMpCftx.jpg", url:"https://themoviedb.org/person/8685"}}, {tmdbId:"51918", properties:{bornIn:"Bolinas, California, United States", imdbId:"0005101", born:date('1973-01-04'), name:"Harmony Korine", bio:"​From Wikipedia, the free encyclopedia.   \n\nHarmony Korine (born January 4, 1973) is an American film director, producer, screenwriter, and author. \n\nHe is best known for writing Kids and for directing Gummo, Julien Donkey-Boy and Mister Lonely.  He has been a prominent figure in independent film, music and art throughout the past decade.  His film Trash Humpers premiered at Toronto International Film Festival and won the main prize, the DOX Award, at CPH:DOX in November 2009...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nifHx1FlQdgYw57QaUfHSjBKmPy.jpg", url:"https://themoviedb.org/person/51918"}}, {tmdbId:"72197", properties:{bornIn:"Istanbul, Turkey", imdbId:"0654858", born:date('1959-02-03'), name:"Ferzan Ozpetek", bio:"Ferzan Özpetek was born in Istanbul in 1959.  When he was a young student in 1976, he decided to move to Italy to study Cinema History at Sapienza University of Rome.  He completed his education attending art history and costume design classes at the Navona Academy.  He also attended director classes at the Silvio D'Amico National Academy of Dramatic Art. \n\nDescription above from the Wikipedia article Charlize Theron, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zc4b5zoIEfDGFwy3Pl49bvCEEow.jpg", url:"https://themoviedb.org/person/72197"}}, {tmdbId:"15002", properties:{bornIn:"Wilton, Connecticut, United States", imdbId:"0661751", born:date('1952-10-01'), name:"Dean Parisot", bio:"​From Wikipedia, the free encyclopedia\n\nDean Parisot is an American film and television director.  Parisot won the 1988 Academy Award for Best Short Film, Live Action for The Appointments of Dennis Jennings which starred and was co-written (with Mike Armstrong) by comedian Steven Wright.  Among his television credits are episodes of Monk, Northern Exposure and Curb Your Enthusiasm...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jpgHbQjkrQHZnhmOvmDLhxvSf3r.jpg", url:"https://themoviedb.org/person/15002"}}, {tmdbId:"229097", properties:{imdbId:"0552693", name:"Lionel C. Martin", url:"https://themoviedb.org/person/229097"}}, {tmdbId:"126125", properties:{bornIn:"Portland - Oregon - USA", imdbId:"0687739", born:date('1946-04-30'), name:"Bill Plympton", bio:"Bill Plympton (born April 30, 1946)[is an American animator, graphic designer, cartoonist, director, screenwriter and producer best known for his 1987 Academy Award-nominated animated short Your Face and his series of shorts Guard Dog, Guide Dog, Hot Dog and Horn Dog...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zjSojfL5QKyMu8RKmuE91sc0Pbc.jpg", url:"https://themoviedb.org/person/126125"}}, {tmdbId:"95760", properties:{bornIn:"Tromsø, Norway", imdbId:"0804408", born:date('1964-12-14'), name:"Erik Skjoldbjærg", bio:"Erik Skjoldbjærg (born December 14, 1964 in Tromsø, Norway) is a Norwegian director and writer best known for co-writing and directing the film Insomnia and directing Prozac Nation.  His film Pioneer was selected to be screened in the Special Presentation section at the 2013 Toronto International Film Festival...", url:"https://themoviedb.org/person/95760"}}, {tmdbId:"1033607", properties:{imdbId:"0302791", name:"Andrew Gallerani", url:"https://themoviedb.org/person/1033607"}}, {tmdbId:"123150", properties:{bornIn:"Druten, Gelderland, Netherlands", imdbId:"0226016", born:date('1959-01-12'), name:"Mike van Diem", bio:"Mike van Diem is a Dutch screenwriter and director born in Druten on the 12th of January 1959.  He won the Oscar for Best Foreign Film in 1998 with his feature film debut Character...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eLxV6TKwZIuxIEnd0HAoHyOeAF8.jpg", url:"https://themoviedb.org/person/123150"}}, {tmdbId:"70765", properties:{imdbId:"0630372", name:"John Nicolella", url:"https://themoviedb.org/person/70765"}}, {tmdbId:"80307", properties:{bornIn:"Newton, Massachusetts, Stati Uniti", imdbId:"0128225", born:date('1955-05-27'), name:"Andy Cadiff", bio:"Andy Cadiff is an American television director and producer. \n\nHe has directed episodes for number of notable television series including, Home Improvement, Spin City, My Wife and Kids, Growing Pains, According to Jim, The War at Home, Quintuplets and number of other series.  He also directed the feature films Leave It to Beaver (1997) and Chasing Liberty (2004) starring Mandy Moore...", url:"https://themoviedb.org/person/80307"}}, {tmdbId:"77086", properties:{bornIn:"Raeford, North Carolina, USA", imdbId:"0665321", born:date('1970-01-15'), name:"Jonas Pate", url:"https://themoviedb.org/person/77086"}}, {tmdbId:"228797", properties:{bornIn:"London, England", imdbId:"0477193", born:date('1957-03-17'), name:"Richard Kwietniowski", bio:"Richard Kwietniowski (born 17 March 1957) is an English film director and screenwriter of Polish descent.  During the 1980s he was a film lecturer at Bulmershe College of Higher Education (now Bulmershe Court in Reading, Berkshire.  He has directed eleven films since 1987.  His film Love and Death on Long Island was screened in the Un Certain Regard section at the 1997 Cannes Film Festival...", url:"https://themoviedb.org/person/228797"}}, {tmdbId:"171000", properties:{bornIn:"Rockford, Illinois, USA", imdbId:"0544079", born:date('1962-12-27'), name:"Joe Mantello", bio:"Joseph Mantello (born December 27, 1962) is an American actor and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qeWxvjBLjKO5LHKiHvbwI8kbwEp.jpg", url:"https://themoviedb.org/person/171000"}}, {tmdbId:"96972", properties:{bornIn:"Brussels, Belgium", imdbId:"0075626", born:date('1963-02-21'), name:"Alain Berliner", bio:"From Wikipedia, the free encyclopedia. \n\nAlain Berliner (born 21 February 1963) is a Belgian director best known for the 1997 film Ma vie en rose, which won the Golden Globe Award for Best Foreign Language Film at the 55th Golden Globe Awards in 1998. \n\nBorn in Brussels, he also directed Le Mur, Passion of Mind, La Maison du canal, and J'aurais voulu être un danseur. \n\nDescription above from the Wikipedia article Alain Berliner, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/g7KHUxBKBGbHldYbNldyPiY40RX.jpg", url:"https://themoviedb.org/person/96972"}}, {tmdbId:"1083461", properties:{bornIn:"Barletta, Apulia, Italy", imdbId:"0851383", born:date('1940-04-19'), name:"Anna Maria Tatò", url:"https://themoviedb.org/person/1083461"}}, {tmdbId:"22140", properties:{bornIn:"Ottawa, Ontario, Canada", imdbId:"0804556", name:"Kari Skogland", bio:"From Wikipedia, the free encyclopedia. \n\nKari Skogland (born in Ottawa, Ontario) is a Canadian film director, screenwriter, and producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5MSVfb2hKtDo3S386YSHjcdaYDC.jpg", url:"https://themoviedb.org/person/22140"}}, {tmdbId:"107414", properties:{bornIn:"London, UK", imdbId:"0767697", born:date('1930-10-28'), name:"Philip Saville", bio:"From Wikipedia, the free encyclopedia. \n\nPhilip Saville (sometimes credited as Philip Savile, born 28 October 1930, London) is a British actor who turned to television direction and screenwriting in the late 1950s. \n\nDuring the 1960s he directed several important television plays, such as Harold Pinter's A Night Out (1960) for ABC's Armchair Theatre anthology series, and the lost Madhouse on Castle Street (1963) for the BBC...", died:date('2016-12-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8F1WR2Ouo8Qnbe4ngzaNtHKmCpd.jpg", url:"https://themoviedb.org/person/107414"}}, {tmdbId:"950513", properties:{imdbId:"0302124", name:"Ivan Galin", url:"https://themoviedb.org/person/950513"}}, {tmdbId:"26714", properties:{bornIn:"California, USA", imdbId:"0502954", born:date('1956-07-04'), name:"John R. Leonetti", bio:"John R.  Leonetti A. S. C.  is a cinematographer and film director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uksq1bamaA4MfpBPaP4Vv8BvLpu.jpg", url:"https://themoviedb.org/person/26714"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"1704", properties:{bornIn:"Oak Ridge, Tennessee, USA", imdbId:"0893659", born:date('1964-03-16'), name:"Gore Verbinski", bio:"Gregor \"Gore\" Verbinski is an American film director and writer, best known for directing the first three Pirates of the Caribbean films and The Ring. \n\nVerbinski was born the third of five children to Vic and Laurette Verbinski in Oak Ridge, Tennessee.  His siblings are Janine, Claire, Diane and Steven.  His father was of Polish descent and worked as a nuclear physicist at Oak Ridge National Laboratory...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vu50X3GaGz1q1xoVfoKHS7hFkiG.jpg", url:"https://themoviedb.org/person/1704"}}, {tmdbId:"86203", properties:{bornIn:"New York City, New York, USA", imdbId:"0294505", born:date('1970-01-17'), name:"Bart Freundlich", bio:"From Wikipedia, the free encyclopedia. \n\nBartholomew Freundlich (born January 17, 1970 in New York, NY) is an American director, screenwriter and producer. \n\nDescription above from the Wikipedia article Bart Freundlich, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8xrjH3jOaOCxTjiYqnxL2Up8PEi.jpg", url:"https://themoviedb.org/person/86203"}}, {tmdbId:"72182", properties:{imdbId:"0667630", name:"Mark Pavia", url:"https://themoviedb.org/person/72182"}}, {tmdbId:"22676", properties:{bornIn:"Nørresundby, Denmark", imdbId:"0097079", born:date('1959-05-26'), name:"Ole Bornedal", bio:"Ole Bornedal (b.  26 May 1959, Nørresundby, Denmark) is a Danish film director, actor and producer. \n\nHe wrote and directed Nattevagten (Nightwatch, 1994), a thriller about a law student who works in a morgue as a night-watchman, and becomes implicated in a series of murders of prostitutes.  He also directed an English language remake (Nightwatch) in 1997, starring Ewan McGregor, Nick Nolte and Patricia Arquette.  In 2002, he directed I Am Dina...", url:"https://themoviedb.org/person/22676"}}, {tmdbId:"1058100", properties:{bornIn:"Glen Ridge, New Jersey, USA", imdbId:"0792398", born:date('1954-01-19'), name:"Cindy Sherman", url:"https://themoviedb.org/person/1058100"}}, {tmdbId:"51984", properties:{bornIn:"New York City, New York, USA", imdbId:"0001460", born:date('1952-01-26'), name:"Mimi Leder", bio:"Miriam \"Mimi\" Leder (born January 26, 1952) is an American film director and producer noted for her action films and use of special effects.  She was the first female graduate of the AFI Conservatory in 1973. \n\nDescription above from the Wikipedia article Mimi Leder, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iKGaiYs0oZwflUYMOSehNmH3Khh.jpg", url:"https://themoviedb.org/person/51984"}}, {tmdbId:"21404", properties:{bornIn:"Panorama City, California, USA", imdbId:"0903717", name:"Kurt Voss", bio:"From Wikipedia, the free encyclopedia\n\nKurt Voss (born 1963) is an American film director, screenwriter and musician/songwriter.  He often works with fellow UCLA alumnus Allison Anders.  Voss's credits include: Border Radio, Poison Ivy: The New Seduction, Where The Day Takes You, and Sugar Town...", url:"https://themoviedb.org/person/21404"}}, {tmdbId:"1035941", properties:{imdbId:"0175115", name:"Theresa Connelly", url:"https://themoviedb.org/person/1035941"}}, {tmdbId:"20907", properties:{bornIn:"Pittsburgh, Pennsylvania, USA", imdbId:"0298807", born:date('1966-01-19'), name:"Antoine Fuqua", bio:"Fuqua began his career directing music videos for popular artists such as Toni Braxton, Coolio, Stevie Wonder, and Prince.  From 1998 onwards, he began directing feature films, although he has worked on a few music videos since then...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7PDaPftuGKm1Zd9wol6JiHuaJrj.jpg", url:"https://themoviedb.org/person/20907"}}, {tmdbId:"58178", properties:{bornIn:"Philadelphia, Pennsylvania, USA", imdbId:"0592400", born:date('1955-09-18'), name:"David Mirkin", bio:"​From Wikipedia, the free encyclopedia. \n\nDavid Mirkin  (born September 18, 1955) is an American feature film and television director, writer and producer, known for his work on The Simpsons.  He is a native of Philadelphia and an alumnus of Loyola Marymount University.  He has won several Emmys along with the Peabody Award...", url:"https://themoviedb.org/person/58178"}}, {tmdbId:"31155", properties:{bornIn:"Wellston, Ohio, USA", imdbId:"0676248", born:date('1954-09-10'), name:"Fred Olen Ray", bio:"Fred Olen Ray is an American film and television director, producer, screenwriter, actor and cinematographer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/91Y7oLIYJjpoY0YmDEsswKfeqDg.jpg", url:"https://themoviedb.org/person/31155"}}, {tmdbId:"58829", properties:{imdbId:"0740311", name:"Darrell Rooney", url:"https://themoviedb.org/person/58829"}}, {tmdbId:"80698", properties:{imdbId:"0480349", name:" Rob LaDuca", url:"https://themoviedb.org/person/80698"}}, {tmdbId:"1230252", properties:{bornIn:"Manchester, Greater Manchester, England, UK", imdbId:"0398185", born:date('1957-05-05'), name:"Peter Howitt", bio:"Peter Howitt is an English actor and film director.  He grew up in Eltham, London and Bromley, Kent, Peter used to be a part of the Priory Players in the Priory behind Christ Church, Eltham.  He has two children, Luke (born 1990) and Amy (born 2008).  He currently resides in Vancouver, Canada. \n\nHe first found success playing Joey Boswell in the British TV series Bread.  In 1998 he wrote and directed his first film, Sliding Doors (1998)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rULzO7TsxYzdfgevc2kILxsoYWN.jpg", url:"https://themoviedb.org/person/1230252"}}, {tmdbId:"66121", properties:{bornIn:"Milwaukee, Wisconsin, USA", imdbId:"0863387", born:date('1969-01-26'), name:"George Tillman Jr.", bio:"George Tillman, Jr.  is an American film director and producer.  He attended John Marshall High School in Milwaukee, where he took Mass Communications magnet classes.  He graduated from Columbia College in Chicago in 1991 with a major in Film and Video. \n\nTillman is most notable for directing the films Soul Food (1997) and Men of Honor (2000)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l2O5FILKdFQoBW7uDzmm3wyr6cA.jpg", url:"https://themoviedb.org/person/66121"}}, {tmdbId:"87130", properties:{bornIn:"Alaska, USA", imdbId:"0228147", name:"Mark A.Z. Dippé", bio:"Mark A. Z.  Dippé (born 1958 in Alaska) is an American film director and visual effects supervisor.  He has directed numerous films from 1997 to now, starting with Spawn. \n\nHe is co-founder of The Animation Picture Company...", url:"https://themoviedb.org/person/87130"}}, {tmdbId:"47974", properties:{bornIn:"Glasgow, Scotland, UK", imdbId:"0818639", born:date('1945-09-27'), name:"Bob Spiers", bio:"Robert Alexander \"Bob\" Spiers (27 September 1945 – 8 December 2008) was a director.  \n\nHe is particularly noted as the director of the early series of Absolutely Fabulous (1992–2001), the musical comedy Spiceworld, and of the second series of Fawlty Towers (1979).  He also worked with Steven Moffat on Press Gang and Joking Apart.  \n\nSpiers won a BAFTA Award twice for his work as a television comedy director...", died:date('2008-12-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l22gNZcPsph1B5xeNtm4tqf53fQ.jpg", url:"https://themoviedb.org/person/47974"}}, {tmdbId:"115362", properties:{imdbId:"0928691", name:"Gavin Wilding", url:"https://themoviedb.org/person/115362"}}, {tmdbId:"61069", properties:{bornIn:"San Juan, Puerto Rico", imdbId:"0037708", born:date('1965-01-01'), name:"Miguel Arteta", bio:"Miguel Arteta (born 1965) is a Puerto Rican director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bAuqxNYzxFxU4lX8wExPzBZ8vJ6.jpg", url:"https://themoviedb.org/person/61069"}}, {tmdbId:"1069294", properties:{bornIn:"San Benito, Texas, USA", imdbId:"0732706", name:"James F. Robinson", bio:"James F.  Robinson is an American film director.  He is the founder of two film production companies, White Lion Pictograph and ZapPictures, as well as a new media company, CinemaElectric...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1XdQHgv5KEqDqSQUshfIi49wq7.jpg", url:"https://themoviedb.org/person/1069294"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"41472", properties:{bornIn:"Denver, Colorado, United States", imdbId:"0640964", name:"Peter O'Fallon", bio:"From Wikipedia, the free encyclopedia. \n\nPeter O'Fallon is an American director, producer and writer for commercial, television and film productions. \n\nO'Fallon grew up in Colorado and graduated from the University of Colorado at Boulder with a degree in Film Studies.  He began his career in the industry by making small T. V.  spots for local radio stations, funded and created completely on his own...", url:"https://themoviedb.org/person/41472"}}, {tmdbId:"63983", properties:{bornIn:"Long Lake, Minnesota, USA", imdbId:"0638630", born:date('1962-03-28'), name:"Roger Nygard", bio:"​From Wikipedia, the free encyclopedia. \n\nRoger Nygard (born on March 28, 1962) is an American film and television director, editor, writer, and producer.  His films include Trekkies, Trekkies 2 and The Nature of Existence (film)...", url:"https://themoviedb.org/person/63983"}}, {tmdbId:"50099", properties:{bornIn:"Tel Aviv, Israel", imdbId:"0506619", born:date('1947-06-03'), name:"Shuki Levy", bio:"​From Wikipedia, the free encyclopedia\n\nShuki Levy (born June 3, 1947 in Tel Aviv, Israel (at the time the British Mandate of Palestine) is a music composer and television writer, director, and executive producer.  Levy's best known work is soundtrack compositions for children's television programs of the 1980s, such as Inspector Gadget, The Mysterious Cities of Gold, M. A. S. K...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4fzlZFMAFiWzjAuUt583uZmqTTZ.jpg", url:"https://themoviedb.org/person/50099"}}, {tmdbId:"36083", properties:{bornIn:"Swansea, Wales, UK", imdbId:"0020728", born:date('1962-09-15'), name:"Kevin Allen", bio:"Kevin Allen  is a Welsh screenwriter, film director, film producer and actor.  In 1997 he directed and wrote the cult Welsh black comedy feature \"Twin Town\".  He also directed the films \"The Big Tease\" and \"Agent Cody Banks 2: Destination London\" and hit TV series \"Benidorm\".  He is the younger brother of comedian Keith Allen and uncle of pop singer Lily Allen ...", url:"https://themoviedb.org/person/36083"}}, {tmdbId:"69353", properties:{imdbId:"0450387", name:"Stephen Kessler", url:"https://themoviedb.org/person/69353"}}, {tmdbId:"19377", properties:{bornIn:"Orléans, France", imdbId:"0957794", born:date('1956-09-10'), name:"Erick Zonca", bio:"From Wikipedia, the free encyclopedia. \n\nErick Zonca (born September 10, 1956, in Orléans, France) is a French film director, best known for his critically acclaimed, award-winning 1998 feature film debut The Dreamlife of Angels.  The film won the Best Actress award at the 1998 Cannes Film Festival. \n\nHis first films were the shorts Rives (1992), Eternelles (1995), and Seule (1997).  Zonca's second feature was Le Petit Voleur (The Little Thief) (1999)...", url:"https://themoviedb.org/person/19377"}}, {tmdbId:"2698156", properties:{name:"Manny Coto", url:"https://themoviedb.org/person/2698156"}}, {tmdbId:"57370", properties:{bornIn:"New York, USA", imdbId:"0178997", born:date('1966-02-03'), name:"Frank Coraci", bio:"From Wikipedia, the free encyclopedia. \n\nFrank Coraci (born February 3, 1966) is an American film director and screenwriter best known for his work with Adam Sandler. \n\nCoraci was born in Shirley, New York.  Coraci graduated from New York University's Tisch School of the Arts in 1988.  He has directed three of Sandler's hit films (The Wedding Singer, The Waterboy and Click) as well as several of Sandler's music videos...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1mgOs3O9m2NrcYeKaEuNIRBAvyf.jpg", url:"https://themoviedb.org/person/57370"}}, {tmdbId:"11614", properties:{bornIn:"Mahé, Puducherry, India", imdbId:"0796117", born:date('1970-08-06'), name:"M. Night Shyamalan", bio:"Manoj Nelliyattu Shyamalan (born 6 August 1970), known professionally as M.  Night Shyamalan, is an Indian-born American film director, screenwriter, and producer known for making movies with contemporary supernatural plots that climax with a twist ending.  He is also known for filming his movies (and staging his plots) in and around Philadelphia, Pennsylvania, where he was raised.  Shyamalan released his first film, Praying with Anger, in 1992 while he was a New York University student...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uLgGi0p8qKIvQxi8ESwzkrJJ2Wu.jpg", url:"https://themoviedb.org/person/11614"}}, {tmdbId:"11419", properties:{bornIn:"Crestline, Ohio, USA", imdbId:"0476071", born:date('1964-11-25'), name:"Robert Kurtzman", bio:"​From Wikipedia, the free encyclopedia.   \n\nRobert Kurtzman (born November 25, 1964) is an American film director, producer, screenwriter, and special effects creator. \n\nDescription above from the Wikipedia article Robert Kurtzman, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9hN9noJUKvomz6lNAW24sHHRU0h.jpg", url:"https://themoviedb.org/person/11419"}}, {tmdbId:"18863", properties:{imdbId:"0201509", name:"Eric Darnell", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l3yiLuFKqpPlDGWH0kKA0X1jZKM.jpg", url:"https://themoviedb.org/person/18863"}}, {tmdbId:"20779", properties:{bornIn:"Manchester, England, UK", imdbId:"0802551", name:"Gary Sinyor", bio:"From Wikipedia, the free encyclopedia. \n\nGary Sinyor (born Manchester, England, 1962) is an award-winning film director, producer, and writer.  He was raised in a Sephardic Jewish upbringing, before going on to the National Film and Television School...", url:"https://themoviedb.org/person/20779"}}, {tmdbId:"104507", properties:{imdbId:"0326837", name:"Steve Gomer", bio:"​From Wikipedia, the free encyclopedia\n\nSteve Gomer is an American film and television director.  In 1987, he made his directorial debut directing the film Sweet Lorriane starring Maureen Stapleton.  He continued directing films namely Fly by Night (1993), Sunset Park (1996) starring Rhea Perlman and Barney's Great Adventure (1998).  Since 2000, he moved on to television directing episodes of Chicago Hope, Gilmore Girls, Ally McBeal, Joan of Arcadia, The Unit, Private Practice and few other series...", url:"https://themoviedb.org/person/104507"}}, {tmdbId:"10808", properties:{bornIn:"London, England, UK", imdbId:"0635759", born:date('1964-01-01'), name:"Stephen Norrington", bio:"Stephen Norrington (born 1964) is a British film director whose credits include Death Machine and the comic book adaptations Blade and The League of Extraordinary Gentlemen. \n\nDescription above from the Wikipedia article Stephen Norrington, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/10808"}}, {tmdbId:"7", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0004056", born:date('1965-12-03'), name:" Andrew Stanton", bio:"Andrew Stanton (born December 3, 1965) is an American film director, screenwriter, producer, and occasional voice actor based at Pixar Animation Studios.  His film work includes writing and directing Finding Nemo and WALL-E; both films earned him the Academy Award for Best Animated Feature. \n\nDescription above from the Wikipedia article Andrew Stanton, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tRwWuo06aN9vuXAPaswMN42x2ii.jpg", url:"https://themoviedb.org/person/7"}}, {tmdbId:"53304", properties:{bornIn:"Bristol, Regno Unito", imdbId:"0520485", born:date('1953-11-04'), name:"Peter Lord", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wj82RAsNniXWGaxkwsJoLqlVE1l.jpg", url:"https://themoviedb.org/person/53304"}}, {tmdbId:"72258", properties:{bornIn:"Los Angeles County, California, USA", imdbId:"0102434", born:date('1952-09-04'), name:"Steve Boyum", bio:"From Wikipedia, the free encyclopedia. \n\nSteve Boyum (born September 9, 1952) is a long time Hollywood stunt performer, television director and film director.  He has appeared in over 60 films as a stunt performer.  He has lived in Palm Springs, California since 1987...", url:"https://themoviedb.org/person/72258"}}, {tmdbId:"72450", properties:{bornIn:"Philadelphia, Pennsylvania, USA", imdbId:"0756114", born:date('1956-05-17'), name:"Bob Saget", bio:"From Wikipedia, the free encyclopedia. \n\nRobert Lane \"Bob\" Saget (born May 17, 1956) is an American stand-up comedian, actor, and television host.  Although he is best known for his past roles in the family-oriented shows Full House and America's Funniest Home Videos, Saget is known outside of television for his starkly blue stand-up routine.  He is also an honorary member of Seal and Serpent...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hLHwGxlfhm1qnPgjp1deDdhZN7t.jpg", url:"https://themoviedb.org/person/72450"}}, {tmdbId:"4782", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0000341", born:date('1942-10-23'), name:" Michael Crichton", bio:"John Michael Crichton (October 23, 1942 – November 4, 2008), best known as Michael Crichton, was an American author, producer, director, and screenwriter, best known for his work in the science fiction, medical fiction, and thriller genres.  His books have sold over 150 million copies worldwide, and many have been adapted into films...", died:date('2008-11-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mMWgO0Wq78V5IBH5yJjNgu9mHUZ.jpg", url:"https://themoviedb.org/person/4782"}}, {tmdbId:"234358", properties:{imdbId:"0940292", name:"Leslie Woodhead", url:"https://themoviedb.org/person/234358"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"222441", properties:{bornIn:"New York City, New York, USA", imdbId:"0339175", born:date('1926-09-18'), name:" Bud Greenspan", bio:"A film director, writer, and producer known for his sports documentaries.  His distinctive appearance in later years included wearing his large, dark-framed glasses atop his shaved head...", died:date('2010-12-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/G1fu7x1LZ5E4xipyNVGivDkGIl.jpg", url:"https://themoviedb.org/person/222441"}}, {tmdbId:"86557", properties:{imdbId:"0106451", name:"David Breashears", url:"https://themoviedb.org/person/86557"}}, {tmdbId:"4501", properties:{bornIn:"Renmark, South Australia, Australia", imdbId:"0005871", name:"Dean Semler", bio:"From Wikipedia, the free encyclopedia. \n\nDean Semler, A. C. S. , A. S. C.  (born 1943) is an Australian cinematographer.  Over his career, he has worked as a cinematographer, camera operator, director, second unit director, and assistant director.  Description above from the Wikipedia article Dean Semler, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/4501"}}, {tmdbId:"16391", properties:{bornIn:"Newton, Massachusetts, U.S", imdbId:"0853380", born:date('1952-12-15'), name:"Julie Taymor", bio:"From Wikipedia, the free encyclopedia\n\nJulie Taymor (born December 15, 1952) is an American director of theater, opera and film.  Taymor's work has received many accolades from critics, and she has earned two Tony Awards out of four nominations, the Drama Desk Award for Outstanding Costume Design, an Emmy Award, and an Academy Award nomination for Original Song...", url:"https://themoviedb.org/person/16391"}}, {tmdbId:"44023", properties:{bornIn:"Tel Aviv-Yafo, Israel", imdbId:"0688096", born:date('1949-01-01'), name:"Amos Poe", bio:"Amos Poe, born Amos Jay Porges, is a quintessential New York independent filmmaker.  He was a key figure in the emergence of the No Wave cinema movement that evolved from the punk music scene and flourished from the mid-1970s to the mid-1980s on New York's Lower East Side...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bnHUyLOVWTIjdrHkIGjyXAUVj1B.jpg", url:"https://themoviedb.org/person/44023"}}, {tmdbId:"226493", properties:{bornIn:"Londra", imdbId:"0325128", born:date('1960-01-01'), name:"Sandra Goldbacher", bio:"Sandra Goldbacher (born 1960) is a British film director and screenwriter...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9ih3RM3gEv8lMLjeylljI4eMgEY.jpg", url:"https://themoviedb.org/person/226493"}}, {tmdbId:"70777", properties:{bornIn:"San Francisco, California, USA", imdbId:"0838198", born:date('1958-08-03'), name:"Kevin Rodney Sullivan", bio:"From Wikipedia, the free encyclopedia. \n\nKevin Rodney Sullivan (born August 3, 1958) is an American film and television actor and film director.  He is married to wife Nita Sullivan, and has a daughter, Nicole L.  Sullivan...", url:"https://themoviedb.org/person/70777"}}, {tmdbId:"18204", properties:{bornIn:"Budapest, Hungary", imdbId:"0440914", born:date('1938-11-17'), name:"Peter Kassovitz", bio:"​From Wikipedia, the free encyclopedia\n\nPeter Kassovitz (born November 17, 1938) is a French film director and scriptwriter. \n\nHe was born in Budapest, Hungary.  He left the country at the time of the Hungarian Revolution of 1956.  He is the father of film director Mathieu Kassovitz.  He directed the film Jakob the Liar, starring Robin Williams in 1999. \n\nDescription above from the Wikipedia article Peter Kassovitz, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/18204"}}, {tmdbId:"956", properties:{bornIn:"Hatfield, Hertfordshire, England", imdbId:"0005363", born:date('1968-09-10'), name:"Guy Ritchie", bio:"Guy Stuart Ritchie (born 10 September 1968) is an English screenwriter and film maker who directed Lock, Stock and Two Smoking Barrels, Snatch, RocknRolla, Revolver and Sherlock Holmes...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9pLUnjMgIEWXi0mlHYzie9cKUTD.jpg", url:"https://themoviedb.org/person/956"}}, {tmdbId:"66190", properties:{bornIn:"California - USA", imdbId:"0051643", born:date('1967-01-01'), name:"Tony Bancroft", bio:"Tony Bancroft has spent the past 16 years developing his skills as an  Animator/Director with Walt Disney Feature Animation, Sony Imageworks,  and currently with Toonacious Family Entertainment, his own animation  studio. \n\nIn 2001, with his two partners, Tony started Toonacious Family  Entertainment, as Executive VP/Creative Production...", url:"https://themoviedb.org/person/66190"}}, {tmdbId:"57579", properties:{bornIn:"New York City, New York, USA", imdbId:"0740400", born:date('1955-04-14'), name:"Don Roos", bio:"Donald Paul Roos is an American film and television writer, director and producer...", url:"https://themoviedb.org/person/57579"}}, {tmdbId:"17698", properties:{bornIn:"Philadelphia, Pennsylvania, USA ", imdbId:"0583600", born:date('1949-12-08'), name:"Nancy Meyers", bio:"Nancy Jane Meyers is an American film director, producer and screenwriter.  She is the writer, producer and director of several big-screen successes, including The Parent Trap (1998), Something's Gotta Give (2003), The Holiday (2006), and It's Complicated (2009).  Her second solo venture, What Women Want (2000), was at one point the most successful film ever directed by a woman, taking in $183 million in the United States...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aK2lYDBYhWU9MJdNV0y1EvXiNo0.jpg", url:"https://themoviedb.org/person/17698"}}, {tmdbId:"4723", properties:{bornIn:"Providence, Rhode Island, USA", imdbId:"0001338", born:date('1961-01-17'), name:"Brian Helgeland", bio:"Brian Thomas Helgeland is an American screenwriter, film producer and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/f3oRiFyMZbq2HMzN71sHahYpfdW.jpg", url:"https://themoviedb.org/person/4723"}}, {tmdbId:"3180", properties:{imdbId:"0892705", name:"David Veloz", url:"https://themoviedb.org/person/3180"}}, {tmdbId:"59803", properties:{bornIn:"Illinois", imdbId:"0152312", born:date('1962-11-01'), name:"Brenda Chapman", bio:"From Wikipedia, the free encyclopedia\n\nBrenda Chapman is an American animator and film director.  In 1998, she became the first woman to direct an animated feature from a major studio, DreamWorks Animation's The Prince of Egypt. \n\nDescription above from the Wikipedia article Brenda Chapman, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/59803"}}, {tmdbId:"44113", properties:{imdbId:"0382769", name:" Steve Hickner", url:"https://themoviedb.org/person/44113"}}, {tmdbId:"50582", properties:{bornIn:"Belgium", imdbId:"0238865", born:date('1965-05-15'), name:"Frederik Du Chau", bio:"From Wikipedia, the free encyclopedia.   Frederik Du Chau (born 15 May 1965 in Belgium) is a film director, screenwriter and former animator.  He is well known for directing films like Racing Stripes and Underdog.  Before directing Racing Stripes he served as director on the animated feature Quest for Camelot. \n\nDescription above from the Wikipedia article Frederik Du Chau, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/50582"}}, {tmdbId:"17871", properties:{bornIn:"New York City, New York, USA", imdbId:"0357453", born:date('1970-05-26'), name:"John Hamburg", bio:"From Wikipedia, the free encyclopedia. \n\nJohn Hamburg (born May 26, 1970) is an American screenwriter and film director. \n\nDescription above from the Wikipedia article John Hamburg, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/17871"}}, {tmdbId:"54240", properties:{bornIn:"Philadelphia, Pennsylvania, USA", imdbId:"0420982", born:date('1962-05-02'), name:"Tamara Jenkins", bio:"Tamara Jenkins (born May 2, 1962) is an American screenwriter, film director and actress.  She is best known for her films Slums of Beverly Hills (1998), The Savages (2007), and Private Life (2018)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oPnE0FiniJFX333Am6F6cDsT6gy.jpg", url:"https://themoviedb.org/person/54240"}}, {tmdbId:"12991", properties:{bornIn:"Columbia Heights, Minnesota", imdbId:"0698493", born:date('1947-04-03'), name:"Pat Proft", bio:"​From Wikipedia, the free encyclopedia.   \n\nPat Proft (born April 3, 1947) is an American comedy writer and actor. \n\nProft was born in Columbia Heights, Minnesota, the son of Marguerite and Bob Proft.  He began his career at Dudley Riggs' Brave New Workshop in Minneapolis.  In the mid-1970s, he began writing for television and films.  Proft's screenplays usually rely heavily on slapstick action, wisecracks and non-sequitur-laced absurdist dialogue...", url:"https://themoviedb.org/person/12991"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"51851", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"0440458", born:date('1974-10-28'), name:"Jake Kasdan", bio:"From Wikipedia, the free encyclopedia. \n\nJake Kasdan (born Jacob Kasdan; 28 October 1974) is an American television and film director. \n\nKasdan was born in Detroit, the son of Meg (née Goldman), a writer, and writer-director Lawrence Kasdan.   His younger brother, Jon Kasdan, also works in the film and television industry as an actor and writer.  He is married to singer/songwriter Inara George of The Bird and the Bee...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pIpY7zcBSpq6Z3Q1eADPtKDB043.jpg", url:"https://themoviedb.org/person/51851"}}, {tmdbId:"56146", properties:{bornIn:"Paris, Ile-de-France, France", imdbId:"0110293", born:date('1951-12-24'), name:" Gaëtan Brizzi", url:"https://themoviedb.org/person/56146"}}, {tmdbId:"56147", properties:{bornIn:"Paris, Ile-de-France, France", imdbId:"0110294", born:date('1951-12-24'), name:" Paul Brizzi", url:"https://themoviedb.org/person/56147"}}, {tmdbId:"74297", properties:{bornIn:"São Paulo, São Paulo, Brazil", imdbId:"0125186", name:" Hendel Butoy", bio:"Former Disney animator/director who joined the studio in 1979...", url:"https://themoviedb.org/person/74297"}}, {tmdbId:"74298", properties:{imdbId:"0322368", name:" Francis Glebas", bio:"From Wikipedia, the free encyclopedia. \n\nFrancis Glebas is a writer, director, storyboard artist, and teacher.  His most recent film work isSpace Chimps where he worked in storyboarding and visual development.  This film has recently wrapped up production in Canada and is now in post-production. \n\nDescription above from the Wikipedia article Francis Glebas, licensed under CC-BY-SA, full list of contributors on Wikipedia ...", url:"https://themoviedb.org/person/74298"}}, {tmdbId:"1458349", properties:{imdbId:"0899982", name:" Art Vitello", url:"https://themoviedb.org/person/1458349"}}, {tmdbId:"67576", properties:{bornIn:"El Paso, Texas, USA", imdbId:"0872442", born:date('1946-03-20'), name:"Jesús Salvador Treviño", url:"https://themoviedb.org/person/67576"}}, {tmdbId:"5877", properties:{bornIn:"Detroit - Michigan - USA", imdbId:"0622112", born:date('1969-01-06'), name:"Vincenzo Natali", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/929oBNtZKxb0HWmsqXTCvFOjI4c.jpg", url:"https://themoviedb.org/person/5877"}}, {tmdbId:"21136", properties:{bornIn:"North Trenton - New Jersey - USA", imdbId:"0188165", born:date('1945-01-22'), name:"Michael Cristofer", bio:"​From Wikipedia, the free encyclopedia. \n\nMichael Ivan Cristofer (born 22 January 1945, Trenton, New Jersey) is an American playwright, filmmaker and actor.  He received the Pulitzer Prize for Drama and the Tony Award for Best Play for The Shadow Box in 1977.  Michael Cristofer was awarded a Pulitzer Prize and an Antoinette Perry “Tony” Award for the Broadway production of his play, The Shadow Box...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yWZr1U6A4UAatvgqvX1zmOgB92S.jpg", url:"https://themoviedb.org/person/21136"}}, {tmdbId:"26882", properties:{bornIn:"Kobe, Japan", imdbId:"0475905", born:date('1955-07-19'), name:"Kiyoshi Kurosawa", bio:"From Wikipedia, the free encyclopedia\n\nKiyoshi Kurosawa (born July 19, 1955) is a Japanese filmmaker.  He is best known for his many contributions to the Japanese horror genre. \n\nDescription above from the Wikipedia article Kiyoshi Kurosawa, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/10aLSSm6fAiRrEDHbvi1900k6Do.jpg", url:"https://themoviedb.org/person/26882"}}, {tmdbId:"229263", properties:{bornIn:"Paris, France", imdbId:"0415245", born:date('1947-02-05'), name:"Benoît Jacquot", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qs4pQ0iK5L61kDfc15iB5ZfIv5y.jpg", url:"https://themoviedb.org/person/229263"}}, {tmdbId:"16837", properties:{bornIn:"Hastings, Minnesota, USA", imdbId:"0425756", born:date('1964-10-30'), name:"Mark Steven Johnson", bio:"From Wikipedia, the free encyclopedia. \n\nMark Steven Johnson (born October 30, 1964) is an American film director and writer. \n\nJohnson was born in Hastings, Minnesota and attended California State University, Long Beach.  He has directed and co-written the two comic book based films Daredevil and Ghost Rider.  His early writing credits are for the film Grumpy Old Men and its sequel Grumpier Old Men...", url:"https://themoviedb.org/person/16837"}}, {tmdbId:"18185", properties:{bornIn:"California, - USA", imdbId:"0940790", born:date('1969-12-04'), name:"Skip Woods", bio:"​From Wikipedia, the free encyclopedia.   \n\nSkip Woods, is an American screenwriter, producer and film director.  He is best known for writing the screenplay for Swordfish and the film adaptation of the Hitman video game series.  Born December 4, 1969. \n\nWoods is also a partner in Wetwork Tactical, LLC - a weapons handling and tactics consulting firm - with former Army Special Forces member Jimmy Littlefield...", url:"https://themoviedb.org/person/18185"}}, {tmdbId:"5524", properties:{bornIn:"Auckland, New Zealand", imdbId:"0011470", born:date('1966-12-01'), name:"Andrew Adamson", bio:"From Wikipedia, the free encyclopedia.   Andrew Ralph Adamson, MNZM (born 1 December 1966) is a New Zealand film director, producer and screenwriter based mainly in Los Angeles, California, U. S. , where he made the blockbuster animation films, Shrek and Shrek 2 for which he received an Academy Award nomination.  He was director, executive producer, and scriptwriter for C.  S.  Lewis' The Lion, the Witch, and the Wardrobe...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qqIAVKAe5LHRbPyZUlptsqlo4Kb.jpg", url:"https://themoviedb.org/person/5524"}}, {tmdbId:"12058", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0421776", born:date('1960-03-04'), name:" Vicky Jenson", bio:"Victoria \"Vicky\" Jenson (born March 6, 1960) is a film director of both live-action and animated films, and has been said to be \"one of Hollywood's most inspiring female Directors\".  She has directed projects for DreamWorks Animation, including Shrek, the first film to win an Academy Award for Best Animated Feature, giving rise to one of Hollywood's largest film franchises...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/80HAp36Oa2br2ZRnK462emgrUqa.jpg", url:"https://themoviedb.org/person/12058"}}, {tmdbId:"73282", properties:{bornIn:"Dublin, Ireland", imdbId:"0106456", name:"Paddy Breathnach", bio:"From Wikipedia, the free encyclopedia.   Paddy Breathnach (born 1964, Dublin, Ireland) is an award-winning Irish film director and producer.  He directed Man About Dog, Blow Dry and Shrooms.  He was also involved in the production of The Mighty Celt and Ape. \n\nHe has received awards at the Thessaloniki Film Festival, the San Sebastián International Film Festival and the Bogotá Film Festival...", url:"https://themoviedb.org/person/73282"}}, {tmdbId:"6094", properties:{bornIn:"Altötting, Germany", imdbId:"0772691", born:date('1965-08-19'), name:"Hans-Christian Schmid", bio:"Hans-Christian Schmid (1965, Altötting) is a German film director and screenwriter. \n\nDescription above from the Wikipedia article Hans-Christian Schmid, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/6094"}}, {tmdbId:"13615", properties:{bornIn:"Philadelphia, Pennsylvania, U.S.", imdbId:"0253323", born:date('1968-04-05'), name:"Harry Elfont", bio:"From Wikipedia, the free encyclopedia.   Harry Elfont (born April 5, 1968) is an American screenwriter and film director. \n\nBorn in Philadelphia, Pennsylvania and raised in nearby Lower Moreland Township, he met his creative partner Deborah Kaplan while they were both enrolled at the Tisch School of the Arts of New York University (NYU).  They have since written several films together, and directed two: Can't Hardly Wait and Josie and the Pussycats...", url:"https://themoviedb.org/person/13615"}}, {tmdbId:"64815", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"0410769", born:date('1947-07-04'), name:"Robert Iscove", bio:"From Wikipedia, the free encyclopedia. \n\nRobert Iscove (born July 4, 1947, Toronto, Ontario, Canada) is a Canadian film and television director, television producer and a choreographer.  In 1984, he won the Daytime Emmy for Outstanding Individual Achievement in the Performing Arts - Directing...", url:"https://themoviedb.org/person/64815"}}, {tmdbId:"7087", properties:{bornIn:"Kalispell, Montana, USA", imdbId:"0083348", born:date('1957-09-11'), name:"Brad Bird", bio:"Phillip Bradley \"Brad\" Bird (born September 15, 1957) is an American director, voice actor, animator and screenwriter.  He is best known for writing and directing Disney/Pixar's The Incredibles (2004) and Ratatouille (2007).  He also adapted and directed the critically acclaimed 2D animated 1999 Warner Brothers film The Iron Giant...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ZX1hAfWK1zslpB6ifwgDP2uBqn.jpg", url:"https://themoviedb.org/person/7087"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"22677", properties:{bornIn:"Degerndorf, Germany", imdbId:"0299621", born:date('1960-09-22'), name:"Max Färberböck", url:"https://themoviedb.org/person/22677"}}, {tmdbId:"65856", properties:{imdbId:"0500343", born:date('1962-11-06'), name:"Eric Leighton", url:"https://themoviedb.org/person/65856"}}, {tmdbId:"1071", properties:{bornIn:"Wuppertal, Germany", imdbId:"0878756", born:date('1965-05-23'), name:"Tom Tykwer", bio:"From Wikipedia, the free encyclopedia\n\nTom Tykwer (born 23 May 1965) is a German film director, screenwriter, and composer.  He is best known internationally for directing Run Lola Run (1998), Heaven (2002), Perfume: The Story of a Murderer (2006), and The International (2009)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9jGSRfOnJTt8xvHtajWl4ZHRV0r.jpg", url:"https://themoviedb.org/person/1071"}}, {tmdbId:"1092209", properties:{bornIn:"Wooster, Ohio, USA", imdbId:"0289758", born:date('1936-03-11'), name:"Hollis Frampton", bio:"Hollis Frampton is known for the broad and restless intelligence he brought to the films he made, beginning in the early '60s, until his death in 1984.  In addition to being an important experimental filmmaker, he was also an accomplished photographer and writer, and in the 1970s made significant contributions to the emerging field of computer science...", died:date('1984-03-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/30EVblZoSmtV5p0mTatQRtvL9dG.jpg", url:"https://themoviedb.org/person/1092209"}}, {tmdbId:"7930", properties:{bornIn:"Prague, Czechoslovakia", imdbId:"0684342", born:date('1963-06-21'), name:"Jan Pinkava", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1V8yDrYABfQfWq6MnyjJ3fOM6Tc.jpg", url:"https://themoviedb.org/person/7930"}}, {tmdbId:"59646", properties:{imdbId:"0882330", name:"Kinka Usher", url:"https://themoviedb.org/person/59646"}}, {tmdbId:"58005", properties:{bornIn:"Guntur - India", imdbId:"0620576", name:"Bharat Nalluri", bio:"Bharat Nalluri is a British television director.  In 1993, he and producer Richard Johns co-founded Pilgrim Films.  Nalluri is best known for his work with the independent production company Kudos Film & Television in the 2000s and early 2010s.  For Kudos, he has directed episodes of Spooks, Life on Mars, Hustle (which he also helped to conceive), and Outcasts: all for transmission on BBC One...", url:"https://themoviedb.org/person/58005"}}, {tmdbId:"16435", properties:{bornIn:"Donostia-San Sebastián, Guipúzcoa, País Vasco, Spain", imdbId:"0575523", born:date('1958-10-21'), name:"Julio Medem", bio:"​From Wikipedia, the free encyclopedia\n\nJulio Medem (born 21 October 1958) is a Spanish writer and film director.  Medem was born in San Sebastián, Basque Country and showed an interest in movies since childhood, when he would take his father's Super 8 camera and shoot at night, while nobody was paying attention.  After college graduation (where he earned degrees in Medicine and General Surgery) he worked as a film critic and later as a screenwriter, assistant director and editor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4hmQnrbQnfBcE9YHDU2bIkwSfou.jpg", url:"https://themoviedb.org/person/16435"}}, {tmdbId:"110873", properties:{bornIn:"Kiev, USSR", imdbId:"0468335", born:date('1963-01-17'), name:"Igor Kovalyov", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bD5ZO27mcCsxNN73M0Rx8RBY2sW.jpg", url:"https://themoviedb.org/person/110873"}}, {tmdbId:"86439", properties:{imdbId:"0899329", name:" Norton Virgien", url:"https://themoviedb.org/person/86439"}}, {tmdbId:"62020", properties:{bornIn:"Philadelphia, Pennsylvania, USA", imdbId:"0794791", born:date('1945-06-08'), name:" Jack Sholder", bio:"​From Wikipedia, the free encyclopedia.   \n\nJack Sholder (born June 8, 1945 in Philadelphia, Pennsylvania) is a director, best known for his work in the horror film genre, notably Alone in the Dark, A Nightmare on Elm Street 2: Freddy's Revenge, The Hidden, and Wishmaster 2: Evil Never Dies. \n\nIn the DVD commentary of The Hidden Jack Sholder states that his favorite film director is Jean Renoir. \n\nHe currently works as a teacher at Western Carolina University in the department of stage and screen...", url:"https://themoviedb.org/person/62020"}}, {tmdbId:"3191", properties:{imdbId:"0305405", name:"Risa Bramon Garcia", url:"https://themoviedb.org/person/3191"}}, {tmdbId:"11676", properties:{bornIn:"Baltimore, Maryland, USA", imdbId:"0671210", born:date('1962-03-17'), name:"Mark Pellington", bio:"Mark Pellington (born March 17, 1962) is an American film director. \n\nDescription above from the Wikipedia article Mark Pellington, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/11676"}}, {tmdbId:"62514", properties:{bornIn:"Indianapolis, Indiana, USA", imdbId:"0641373", born:date('1968-10-24'), name:"Tommy O'Haver", bio:"Tommy O'Haver is an American film director and screenwriter.  He grew up in Carmel, Indiana, a suburb of Indianapolis.  He graduated from Indiana University with a degree in Journalism and Comparative Literature.  During the mid-nineties, he attended the MFA Film program at the University of Southern California School of Cinematic Arts. [1] While there, he directed shorts that appeared at major festivals, including Sundance and The New York Film Festival...", url:"https://themoviedb.org/person/62514"}}, {tmdbId:"29524", properties:{imdbId:"0712444", name:"Rand Ravich", bio:"Rand Ravich is a film and television director, writer, and producer.  He wrote and directed the 1999 science fiction thriller The Astronaut's Wife starring Johnny Depp and Charlize Theron, which was nominated for the Best Film category at the 1999 Catalonian International Film Festival.  He was a producer on the film Confessions of a Dangerous Mind, and also wrote the screenplays for the Candyman sequel Candyman 2: Farewell to the Flesh and the 1997 movie The Maker...", url:"https://themoviedb.org/person/29524"}}, {tmdbId:"40439", properties:{imdbId:"0604284", name:"David Moreton", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jqTXlc1egExoNyoqOkYNugqoDo3.jpg", url:"https://themoviedb.org/person/40439"}}, {tmdbId:"75675", properties:{bornIn:"\tMelbourne, Australia", imdbId:"0463727", born:date('1958-08-03'), name:"Ana Kokkinos", bio:"Ana Kokkinos is an Australian film and television director and screenwriter of Greek descent.  Kokkinos was born in Melbourne and prior to her career in film, she worked as an industrial lawyer.  Kokkinos has since directed three feature-length films and two short films.  She has won numerous awards for her films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bDweE20hjxzc6M51pjAs2jcglDE.jpg", url:"https://themoviedb.org/person/75675"}}, {tmdbId:"50719", properties:{bornIn:"New York City, New York, USA", imdbId:"0281869", born:date('1962-06-09'), name:"Rodman Flender", bio:"From Wikipedia, the free encyclopedia.   Rodman Flender (born June 6, 1962 in New York City, New York) is an American actor, writer, director and producer. \n\nDescription above from the Wikipedia article Rodman Flender, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/50719"}}, {tmdbId:"134146", properties:{imdbId:"0175020", name:"Myles Connell", url:"https://themoviedb.org/person/134146"}}, {tmdbId:"6431", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0004716", born:date('1969-02-12'), name:"Darren Aronofsky", bio:"Darren Aronofsky (born February 12, 1969) is an American film director, screenwriter and film producer.  He attended Harvard University and AFI to study both live-action and animation.  He won several film awards after completing his senior thesis film, \"Supermarket Sweep\", which went on to become a National Student Academy Award finalist.  Aronofsky's feature debut, π, was shot in November 1997...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sjcLM5iuF9ArlU4iv532tjmFmYN.jpg", url:"https://themoviedb.org/person/6431"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"65629", properties:{bornIn:"Paris, France", imdbId:"0074426", born:date('1950-01-01'), name:"Bibo Bergeron", bio:"Eric \"Bibo\" Bergeron is a French animator and film director.  His work includes The Road to El Dorado and Shark Tale. \n\nBergeron has served as animator on films like Asterix in Britain, Asterix and the Big Fight, Fievel Goes West, Ferngully: The Last Rainforest, We're Back! A Dinosaur's Story, All Dogs Go to Heaven 2, A Goofy Movie, The Iron Giant, The Adventures of Pinocchio and Bee Movie...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vMn3y1RUea6vFdYk472a9Zq3lFj.jpg", url:"https://themoviedb.org/person/65629"}}, {tmdbId:"12062", properties:{imdbId:"0005076", born:date('1950-12-21'), name:" Jeffrey Katzenberg", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vxcHjmckyO7HQwaFyrjoMWWQ9eP.jpg", url:"https://themoviedb.org/person/12062"}}, {tmdbId:"11873", properties:{bornIn:"Harrison, New York, U.S.", imdbId:"0474955", born:date('1966-05-28'), name:"Roger Kumble", bio:"​From Wikipedia, the free encyclopedia.   \n\nRoger Kumble (born May 28, 1966 Harrison, New York) is an American film director, screenwriter, and playwright. \n\nDescription above from the Wikipedia article Roger Kumble licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/11873"}}, {tmdbId:"75699", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0158966", born:date('1964-06-05'), name:"Lisa Cholodenko", bio:"From Wikipedia, the free encyclopedia\n\nLisa Cholodenko (born June 5, 1964) is an American film and television writer/director.  She is best known for her highly acclaimed 2010 comedy-drama The Kids Are All Right which has been nominated for a high accolade of awards including four Academy Awards, not excluding Best Picture. \n\nDescription above from the Wikipedia article Lisa Cholodenko, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/75699"}}, {tmdbId:"1764642", properties:{name:"Steven Feder", url:"https://themoviedb.org/person/1764642"}}, {tmdbId:"15361", properties:{imdbId:"0750857", born:date('1958-11-25'), name:"Josef Rusnak", url:"https://themoviedb.org/person/15361"}}, {tmdbId:"81273", properties:{bornIn:"Kōfu, Yamanashi, Japan", imdbId:"0557945", born:date('1924-08-25'), name:"Yasuzô Masumura", bio:"From Wikipedia, the free encyclopedia\n\nYasuzo Masumura (増村 保造 Masumura Yasuzō, August 25, 1924 - November 23, 1986) was a Japanese film director. \n\nMasumura was born in Kōfu on Honshū.  After dropping out of a law course at the University of Tokyo he worked as an assistant director at the Daiei studio, later returning to university to study philosophy; he graduated in 1949...", died:date('1986-11-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8LvczcX9cXEpi6y8A5hJQAGJ8P1.jpg", url:"https://themoviedb.org/person/81273"}}, {tmdbId:"1030415", properties:{name:"Susan Skoog", url:"https://themoviedb.org/person/1030415"}}, {tmdbId:"8574", properties:{bornIn:"Rio de Janeiro, Rio de Janeiro, Brazil", imdbId:"0758574", born:date('1956-04-12'), name:"Walter Salles", bio:"Walter Moreira Salles, Jr.  (born April 12, 1956) is a Brazilian filmmaker and film producer of international prominence...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/k3XHgm0f9nJK3ugilBqlm0tHfsw.jpg", url:"https://themoviedb.org/person/8574"}}, {tmdbId:"262055", properties:{imdbId:"0122428", born:date('1967-05-15'), name:"Robert Meyer Burnett", url:"https://themoviedb.org/person/262055"}}, {tmdbId:"1284691", properties:{bornIn:"Giappone", name:"Yoshihiro Ueda", url:"https://themoviedb.org/person/1284691"}}, {tmdbId:"81853", properties:{imdbId:"0945674", name:"Shigeyasu Yamauchi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rxocuwSYRINMs7MLCUmvsTJKjci.jpg", url:"https://themoviedb.org/person/81853"}}, {tmdbId:"1060540", properties:{imdbId:"0973260", name:"Mitsuo Hashimoto", url:"https://themoviedb.org/person/1060540"}}, {tmdbId:"231521", properties:{bornIn:"Neath, Glamorgan, Wales, UK", imdbId:"0836557", born:date('1967-01-01'), name:"Eric Styles", url:"https://themoviedb.org/person/231521"}}, {tmdbId:"8969", properties:{bornIn:"Kington, Herefordshire, England, UK", imdbId:"0579580", born:date('1940-09-15'), name:"Chris Menges", bio:"From Wikipedia, the free encyclopedia. \n\nChris Menges BSC, ASC, (born 15 September 1940) is an English cinematographer and film director.  He is a member of both the American and British Societies of Cinematographers. \n\nDescription above from the Wikipedia article Chris Menges, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/8969"}}, {tmdbId:"52371", properties:{bornIn:"Pasadena, California, USA", imdbId:"0136592", born:date('1946-10-19'), name:"J.S. Cardone", bio:"​From Wikipedia, the free encyclopedia.   \n\nJoseph S.  Cardone (born October 19, 1946, in Pasadena, California) is a film director, producer and writer.  He is probably best known for writing and directing Shadowzone and The Forsaken. \n\nDescription above from the Wikipedia article J.  S.  Cardone, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/52371"}}, {tmdbId:"66039", properties:{imdbId:"0764319", name:"Damon Santostefano", bio:"From Wikipedia, the free encyclopedia\n\nDamon Santostefano is an American movie director and writer.  He is best known for directing the 1999 Warner Brothers feature film Three To Tango starring Matthew Perry, Neve Campbell and Dylan McDermott, and for the television series Clueless. \n\nDescription above from the Wikipedia article Damon Santostefano, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/66039"}}, {tmdbId:"71901", properties:{bornIn:"Berkeley, California, USA", imdbId:"0007439", born:date('1965-08-25'), name:"Douglas Aarniokoski", bio:"Douglas Aarniokoski is an assistant director and director...", url:"https://themoviedb.org/person/71901"}}, {tmdbId:"12227", properties:{bornIn:"Easton, Maryland, USA", imdbId:"0141033", name:"Willard Carroll", bio:"From Wikipedia, the free encyclopedia\n\nWillard Carroll (born 1955 in Easton, Maryland) is an American film producer, writer, and director.  He was executive producer of The Brave Little Toaster series, writing the screenplays for The Brave Little Toaster to the Rescue and The Brave Little Toaster Goes to Mars...", url:"https://themoviedb.org/person/12227"}}, {tmdbId:"18679", properties:{imdbId:"0850516", name:"Mark Tarlov", url:"https://themoviedb.org/person/18679"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"67478", properties:{imdbId:"0337550", name:"Janet Greek", url:"https://themoviedb.org/person/67478"}}, {tmdbId:"40243", properties:{bornIn:"New York City, New York, USA", imdbId:"0432627", born:date('1954-11-07'), name:"Gil Junger", bio:"Gil Junger (born November 7, 1954 in New York City) is an American director for Touchstone Pictures, most famous for 10 Things I Hate About You, his directorial film debut...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5KNcFU2kyy9v3ytppOZq6NGBkNW.jpg", url:"https://themoviedb.org/person/40243"}}, {tmdbId:"5345", properties:{bornIn:"New York City, New York, U.S.", imdbId:"0587955", born:date('1966-12-30'), name:"Bennett Miller", bio:"Bennett Miller is an American film director. \n\nMiller is the director of the feature Capote (2005), a film for which he received an Oscar nomination for Best Director.  He also directed the documentary film The Cruise (1998).  He has also directed television commercials and music videos, most recently Bob Dylan's \"When the Deal Goes Down...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/r1XGBl8TYNuCm7APjWN8npP4DEw.jpg", url:"https://themoviedb.org/person/5345"}}, {tmdbId:"931795", properties:{imdbId:"0456693", name:"Tim Kirkman", url:"https://themoviedb.org/person/931795"}}, {tmdbId:"11037", properties:{bornIn:"Lund, Skåne County, Sweden", imdbId:"0600546", born:date('1969-01-17'), name:"Lukas Moodysson", bio:"Karl Frederik Lukas Moodysson (born 17 January 1969) is a Swedish author and film director.  First appearing in public as an ambitious poet in the 1980s, he had his big public, and international, breakthrough directing the 1998 romance film Show Me Love.  He has since directed a string of films with different styles and public appeal, as well as continued to write both poetry and novels...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sfMbwQxgzyHwbZvNDX0qOdlpDNw.jpg", url:"https://themoviedb.org/person/11037"}}, {tmdbId:"26481", properties:{imdbId:"0875793", name:"Anand Tucker", url:"https://themoviedb.org/person/26481"}}, {tmdbId:"583", properties:{bornIn:"East Los Angeles, California, USA", imdbId:"0266684", born:date('1938-07-18'), name:"Hampton Fancher", bio:"From Wikipedia, the free encyclopedia. \n\nHampton Fancher (born July 18, 1938) is a former actor who became a producer and screenwriter in the late 1970s.  Fancher was born to a Mexican mother and an American father in East Los Angeles, California, US.  At 15, he ran away to Spain to become a flamenco dancer and renamed himself Mario Montejo.  He was married briefly to Sue Lyon of Lolita fame. \n\nFancher lives in New York City...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4kyGARNdkYefnPfUG7KrcPuSd8H.jpg", url:"https://themoviedb.org/person/583"}}, {tmdbId:"23945", properties:{bornIn:"Paris, Ile-de-France, France", imdbId:"0000091", born:date('1942-08-31'), name:"Gérard Pirès", url:"https://themoviedb.org/person/23945"}}, {tmdbId:"4453", properties:{bornIn:"Frederiksberg, Denmark", imdbId:"0899121", born:date('1969-05-19'), name:"Thomas Vinterberg", bio:"Thomas Vinterberg is a Danish film director who, along with Lars von Trier, co-founded the Dogme 95 movement in filmmaking, which established rules for simplifying movie production.  He is best known for the films The Celebration (1998), Submarino (2010), The Hunt (2012) and Far from the Madding Crowd (2015). \n\nVinterberg was born in Frederiksberg, Denmark...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1lChKBPVLqbn7Kl8lHghybBVzgw.jpg", url:"https://themoviedb.org/person/4453"}}, {tmdbId:"987282", properties:{imdbId:"0324380", name:"Glen Goei", url:"https://themoviedb.org/person/987282"}}, {tmdbId:"606084", properties:{bornIn:"Krakau, Galicia, Austria-Hungary [now Kraków, Malopolskie, Poland]", imdbId:"0281502", born:date('1883-07-19'), name:"Max Fleischer", bio:"Max Fleischer (July 19, 1883 – September 11, 1972) was an Polish Jewish American animator, inventor, film director and producer. \n\nFleischer was a pioneer in the development of the animated cartoon and served as the head of Fleischer Studios.  He brought such animated characters as Betty Boop, Koko the Clown, Popeye and Superman to the movie screen and was responsible for a number of technological innovations including the Rotoscope...", died:date('1972-09-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tCYCccuHcX9rVigwqlA5MSSJkTX.jpg", url:"https://themoviedb.org/person/606084"}}, {tmdbId:"7131", properties:{bornIn:"South Bend, Indiana, USA", imdbId:"0438989", born:date('1961-11-20'), name:" Larry Karaszewski", bio:"Larry Karaszewski is a writer and producer best known for 1408 (2007), Man on the Moon (1999) and Ed Wood (1994). \n\nIn 1994, Karaszewski and his writing partner, Scott Alexander, convinced Tim Burton to direct a biopic about Edward D.  Wood, Jr.  They wrote the script in only six weeks. \n\nAdditionally, Karaszewski wrote a biography of the Marx brothers. \n\nHe instructed writing seminars at USC film school with Scott Alexander in late 1980s...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zEH40n4YZIMbRsXAFD6Xo4PUNWW.jpg", url:"https://themoviedb.org/person/7131"}}, {tmdbId:"10316", properties:{bornIn:"Athens, Greece", imdbId:"0000766", born:date('1935-04-27'), name:"Theodoros Angelopoulos", bio:"Theodoros \"Theo\" Angelopoulos (Greek: Θεόδωρος Αγγελόπουλος) (27 April 1935 – 24 January 2012) was a Greek filmmaker, screenwriter and film producer. \n\nAn acclaimed and multi-awarded film director who dominated the Greek art ﬁlm industry from 1975 on, Angelopoulos was one of the most influential and widely respected filmmakers in the world.  He started making films in 1967.  In the 1970s he made a series of political films about modern Greece...", died:date('2012-01-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yKDJNi4vmEjRGGRVdGFnnkAuO9f.jpg", url:"https://themoviedb.org/person/10316"}}, {tmdbId:"40333", properties:{bornIn:"Kushiro, Hokkaidō, Japan", imdbId:"0464804", born:date('1963-10-12'), name:"Satoshi Kon", bio:"Satoshi Kon (October 12, 1963 – August 24, 2010) was a Japanese anime director and mangaka from Kushiro, Hokkaidō and a member of the Japan Animation Creators Association (JAniCA).  He was a graduate of the Graphic Design department of the Musashino Art University.  He is sometimes credited as \"Yoshihiro Wanibuchi\" (鰐淵良宏 Wanibuchi Yoshihiro?) in the credits of Paranoia Agent.  He was the younger brother of guitarist and studio musician Tsuyoshi Kon...", died:date('2010-08-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ivdAAPkwZLTIjaJgSw7VNeHCAmt.jpg", url:"https://themoviedb.org/person/40333"}}, {tmdbId:"14597", properties:{bornIn:"Buenos Aires, Argentina", imdbId:"0637615", born:date('1963-12-27'), name:"Gaspar Noé", bio:"Gaspar Noé (born December 27, 1963 in Buenos Aires) is an Argentinian-born French filmmaker and the son of Argentine painter and intellectual Luis Felipe Noé.  He graduated from Louis Lumière National College and is the visiting professor of film at the European Graduate School in Saas-Fee, Switzerland.  Three of his films feature the character of a nameless butcher played by Philippe Nahon: Carne, I Stand Alone and (in a cameo) Irréversible...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wyUEwuZr3ATzltxxS4puwT5RS0b.jpg", url:"https://themoviedb.org/person/14597"}}, {tmdbId:"148455", properties:{bornIn:"Lebanon", imdbId:"0234780", born:date('1963-01-01'), name:"Ziad Doueiri", bio:"Ziad Doueiri is a Lebanese-born cinematographer, film director and writer.  He is best known for his award winning film West Beirut and cooperation with Quentin Tarantino as camera assistant for Pulp Fiction, Reservoir Dogs and other movies...", url:"https://themoviedb.org/person/148455"}}, {tmdbId:"59412", properties:{bornIn:"Albany - New York - USA", imdbId:"0417794", born:date('1970-05-15'), name:"Michael Patrick Jann", bio:"From Wikipedia, the free encyclopedia\n\nMichael Patrick Jann (born May 15, 1970 in Albany, New York, USA) is an American actor, writer and director, best known as a cast member of MTV's The State and director of the film Drop Dead Gorgeous. \n\nHe directed many episodes of Reno 911! on Comedy Central, as well as most of the non-studio sketches on Little Britain USA...", url:"https://themoviedb.org/person/59412"}}, {tmdbId:"21526", properties:{bornIn:"Israel", imdbId:"0527109", born:date('1962-05-15'), name:"Rod Lurie", bio:"​From Wikipedia, the free encyclopedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/csMmRRZBBEjrEqdUCkmwH0I2e6o.jpg", url:"https://themoviedb.org/person/21526"}}, {tmdbId:"25467", properties:{bornIn:"Pyongyang, North Korea", imdbId:"0297846", born:date('1932-01-16'), name:"Toshiya Fujita", bio:"Toshiya Fujita (藤田 敏八 Fujita Toshiya, January 16, 1932 – August 29, 1997), also known as Shigeya Fujita (藤田繁矢 Fujita Shigeya), was a Japanese film director, film actor, and screenwriter.  He is well-regarded in Japan for his youth films but is best known abroad for Lady Snowblood and Lady Snowblood 2: Love Song of Vengeance, films ironically not typical of his usual style...", died:date('1997-08-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nC4TkYj7rdlOXZ3zUWqmgGbenkv.jpg", url:"https://themoviedb.org/person/25467"}}, {tmdbId:"1769", properties:{bornIn:"New York City, New York, USA", imdbId:"0001068", born:date('1971-05-14'), name:"Sofia Coppola", bio:"Sofia Carmina Coppola (born May 14, 1971) is an American screenwriter, film director, actress, and producer.  In 2003 she became the third woman (and the first American woman) to be nominated for an Academy Award for Directing, for Lost in Translation.  In 2010, with Somewhere, she became the first American woman (and fourth American filmmaker) to win the Golden Lion, the top prize at the Venice Film Festival...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dzHC2LxmarkBxWLhjp2DRa5oCev.jpg", url:"https://themoviedb.org/person/1769"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"66795", properties:{bornIn:"Ignacio Cerdà Cataluña, Spain", imdbId:"0148511", name:"Nacho Cerdà", bio:"​From Wikipedia, the free encyclopedia\n\nNacho Cerdà (born 1969) is a Spanish film director best known for his controversial 1994 film, 'Aftermath'.  One year after producing that movie, he was accused of being the person behind the infamous alien autopsy footage.  However, this accusation has been withdrawn since after Ray Santilli was found to be the director. \n\nAftermath is the second in a trilogy of short films known as 'La Trilogia De La Muerte' (The Trilogy of Death)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cgxNd78iHFSZxbWSQryhVPCg813.jpg", url:"https://themoviedb.org/person/66795"}}, {tmdbId:"233108", properties:{bornIn:"Bosnia-Herzegovina", imdbId:"0229026", born:date('1961-06-08'), name:"Jasmin Dizdar", bio:"From Wikipedia, the free encyclopedia. \n\nJasmin Dizdar (8 June 1961, Zenica, BiH) is a London-based screenwriter, film director and author on cinema.  He is known for his film Beautiful People which won an award for the best film in Un Certain Regard category at the Cannes Film Festival. \n\nDescription above from the Wikipedia article Jasmin Dizdar, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/233108"}}, {tmdbId:"150641", properties:{imdbId:"0357143", name:"Gary Halvorson", bio:"​From Wikipedia, the free encyclopedia.   \n\nGary Halvorson is an American director of television shows, series and film...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9KwJweL5GN0y5rvsvBhBRlVtmb0.jpg", url:"https://themoviedb.org/person/150641"}}, {tmdbId:"617183", properties:{imdbId:"0144660", name:"P.J. Castellaneta", url:"https://themoviedb.org/person/617183"}}, {tmdbId:"36805", properties:{bornIn:"San Francisco, California, USA", imdbId:"0920108", born:date('1960-04-29'), name:"Audrey Wells", bio:"​From Wikipedia, the free encyclopedia. \n\nAudrey Wells (born April 29, 1960 - October 4, 2018) was an American screenwriter, film director, and producer. \n\nWells was born in San Francisco, California, and worked as a disc jockey at San Francisco jazz radio station KJAZ FM.  She graduated from U. C.  Berkeley and UCLA.  She wrote a number of successful screenplays and directed three for which she had created the script...", died:date('2018-10-04'), url:"https://themoviedb.org/person/36805"}}, {tmdbId:"492", properties:{bornIn:"Ziebice, Dolnoslaskie, Poland", imdbId:"0001405", born:date('1959-06-27'), name:"Janusz Kaminski", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5yURZbwMmhiXXlvDmRdz4V14Ufs.jpg", url:"https://themoviedb.org/person/492"}}, {tmdbId:"4522", properties:{bornIn:"Bad Nauheim, Germany", imdbId:"0512862", born:date('1964-06-02'), name:"Caroline Link", url:"https://themoviedb.org/person/4522"}}, {tmdbId:"83718", properties:{imdbId:"0877123", name:"Neil Turitz", url:"https://themoviedb.org/person/83718"}}, {tmdbId:"942084", properties:{imdbId:"0407842", name:"Mark Illsley", url:"https://themoviedb.org/person/942084"}}, {tmdbId:"141978", properties:{bornIn:"Helsinki, Finland", imdbId:"0754328", born:date('1965-03-11'), name:"Olli Saarela", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6v4DvxKp4jSQ8AGUsufswM9obTN.jpg", url:"https://themoviedb.org/person/141978"}}, {tmdbId:"103586", properties:{imdbId:"0794960", name:"Simon Shore", url:"https://themoviedb.org/person/103586"}}, {tmdbId:"3289", properties:{bornIn:"New York City, New York, USA", imdbId:"0919369", born:date('1965-11-19'), name:"Paul Weitz", bio:"​From Wikipedia, the free encyclopedia\n\nPaul John Weitz (born 1965) is an American film producer, screenwriter, actor, and film director. \n\nDescription above from the Wikipedia article Paul Weitz (filmmaker), licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/3289"}}, {tmdbId:"18898", properties:{bornIn:" Palo Alto, California, U.S.", imdbId:"0591450", born:date('1962-08-11'), name:"Rob Minkoff", bio:"From Wikipedia, the free encyclopedia.  Robert R.  \"Rob\" Minkoff (born August 11, 1962) is an American filmmaker.  He is known for directing the Academy Award-winning animated feature The Lion King.  Minkoff was born in Palo Alto, California.  He studied at California Institute of the Arts in the early 1980s in the Character Animation department...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fn5QA0bqJn6tk4Wt1QonjojFPjd.jpg", url:"https://themoviedb.org/person/18898"}}, {tmdbId:"17542", properties:{bornIn:"Nagoya, Aichi, Japan", imdbId:"0559564", born:date('1932-03-25'), name:"Toshio Matsumoto", bio:"Toshio Matsumoto  (松本 俊夫 Matsumoto Toshio) (March 25, 1932 – April 12, 2017)  was a Japanese film director, a pioneer of avant-garde experimental movies, multimedia, and video in his homeland and abroad.   Matsumoto was born in Nagoya, Aichi, Japan and graduated from Tokyo University in 1955.  His first short was Ginrin, which he made in 1955, however his most famous film is 1969's wildly experimental Funeral Parade of Roses (also known as Bara no soretsu)...", died:date('2017-04-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h1Rms3lIyrSyNtwBTlSlolIzqp8.jpg", url:"https://themoviedb.org/person/17542"}}, {tmdbId:"109004", properties:{imdbId:"0009270", name:"Neil Abramson", url:"https://themoviedb.org/person/109004"}}, {tmdbId:"83863", properties:{bornIn:"Villach, Austria", imdbId:"0439231", born:date('1953-01-01'), name:"Gerald Kargl", bio:"Gerald Kargl is an Austrian film director most famous for directing the film \"Angst\" (1983)...", url:"https://themoviedb.org/person/83863"}}, {tmdbId:"50583", properties:{bornIn:"Chicago, Illinois, USA ", imdbId:"0726472", born:date('1966-12-31'), name:"Adam Rifkin", bio:"Adam Rifkin sometimes credited as Rif Coogan, is an American film director, producer, actor and writer.  Rifkin is claimed to belong to a rare breed of film directors that transited from public access television to Hollywood.  Adam Rifkin is a writer/director/producer/actor whose eclectic career ranges from broad family comedies to cult classics to dark and gritty urban dramas.  Rifkin is best known in Hollywood circles for writing family-friendly comedies like Mousehunt and 2007's Underdog...", url:"https://themoviedb.org/person/50583"}}, {tmdbId:"81421", properties:{bornIn:"Montreal, Quebec, Canada", imdbId:"0009488", born:date('1959-12-31'), name:"Jeff Abugov", url:"https://themoviedb.org/person/81421"}}, {tmdbId:"65865", properties:{bornIn:" Dublin, Ireland", imdbId:"0640740", born:date('1967-01-01'), name:"Damien O'Donnell", url:"https://themoviedb.org/person/65865"}}, {tmdbId:"56739", properties:{bornIn:"Hong Kong", imdbId:"0151066", born:date('1962-11-28'), name:"Peter Ho-sun Chan", bio:"From Wikipedia, the free encyclopedia. \n\nPeter Chan Ho-sun (born November 28, 1962), is a film director and producer. \n\nDescription above from the Wikipedia article Peter Chan, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1zfRyMEtdsYfQIlg1E3nvkIQogz.jpg", url:"https://themoviedb.org/person/56739"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"12079", properties:{bornIn:"Beaumont, Texas, USA", imdbId:"0038432", born:date('1960-01-15'), name:"Kelly Asbury", bio:"Kelly Adam Asbury (January 15, 1960 – June 26, 2020) was an American animated film director, screenwriter, voice actor, published children's book author/illustrator, and non-fiction author.  He was best known for directing animated films, including Shrek 2 and Gnomeo & Juliet. \n\nDescription above from the Wikipedia article Kelly Asbury, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2020-06-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fzHQFYLc1zVVn3dUjr6pMuKdE0U.jpg", url:"https://themoviedb.org/person/12079"}}, {tmdbId:"15872", properties:{imdbId:"0121789", born:date('1952-09-14'), name:"Martyn Burke", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fvDvW4hIOMWHEM1wlHXQLDQZcr4.jpg", url:"https://themoviedb.org/person/15872"}}, {tmdbId:"20951", properties:{imdbId:"0253106", name:"Kevin Alyn Elders", bio:"An Author, Screenwriter, Producer and Director living in Southern California and Villefranche Sur Mer...", url:"https://themoviedb.org/person/20951"}}, {tmdbId:"72024", properties:{bornIn:"USA", imdbId:"0002700", born:date('1970-01-11'), name:"Malcolm D. Lee", bio:"Malcolm D.  Lee  (born January 11, 1970) is an American actor, film director, and screenwriter.  He has directed such films as Undercover Brother, The Best Man, Roll Bounce, Welcome Home Roscoe Jenkins, and Soul Men.  He also directed an episode of the sitcom Everybody Hates Chris.  He is the cousin of film director Spike Lee, and is a graduate of Packer Collegiate Institute and Georgetown University...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aae8K7qO5XYployiStHbAMMbahM.jpg", url:"https://themoviedb.org/person/72024"}}, {tmdbId:"88391", properties:{bornIn:"Toronto, Canada", imdbId:"0687964", born:date('1962-01-01'), name:"Jeremy Podeswa", bio:"From Wikipedia, the free encyclopedia. \n\nJeremy Podeswa (b.  1962 in Toronto, Ontario) is a Canadian/American film and television director.  He is best known for directing the films The Five Senses (1999) and Fugitive Pieces (2007).  He has also worked as Director on the television shows Six Feet Under, Nip/Tuck, The Tudors, Queer as Folk, and the HBO World War II miniseries The Pacific.  He has also written several films...", url:"https://themoviedb.org/person/88391"}}, {tmdbId:"39", properties:{bornIn:"Reading, Berkshire, England, UK", imdbId:"0005222", born:date('1965-08-01'), name:"Sam Mendes", bio:"Samuel Alexander \"Sam\" Mendes, CBE (born 1 August 1965) is an English stage and film director.  He has won two Laurence Olivier Awards for his London stage productions The Glass Menagerie and Company in 1996, and Twelfth Night and Uncle Vanya in 2003.  He also received a Tony Award nomination for Best Direction of a Musical for the Broadway revival of Cabaret in 1998.  His debut film American Beauty (1999) earned him an Academy Award for Best Director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5z89X9rB76JDblqMQ52fviwXxAN.jpg", url:"https://themoviedb.org/person/39"}}, {tmdbId:"77923", properties:{bornIn:"Gosen, Niigata Prefecture, Japan", imdbId:"0875453", born:date('1966-02-02'), name:" Kazuya Tsurumaki", bio:"Kazuya Tsurumaki is a Japanese anime director.  He is the protégé of Hideaki Anno, and was a longtime animator at Gainax before leaving for Studio Khara...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dgpgjAOLG53CI14x8VZVe1oyobd.jpg", url:"https://themoviedb.org/person/77923"}}, {tmdbId:"20430", properties:{bornIn:"Bucarest, Romania", imdbId:"0586123", born:date('1958-04-23'), name:"Radu Mihaileanu", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vCJlFdoHWRd8Molqv7NvpGjWATP.jpg", url:"https://themoviedb.org/person/20430"}}, {tmdbId:"95818", properties:{bornIn:"The Bronx, New York, U.S.", imdbId:"0086826", born:date('1959-09-14'), name:"Eric Blakeney", bio:"From Wikipedia, the free encyclopedia. \n\nEric Blakeney (born September 14, 1959) is an American film and television director, producer and screenwriter.  He is known for writing award-winning episodes of television for 21 Jump Street, and writing and directing a feature film, 2000's Gun Shy. \n\nDescription above from the Wikipedia article Eric Blakeney, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/95818"}}, {tmdbId:"21692", properties:{bornIn:"Japan", imdbId:"0756983", born:date('1962-11-25'), name:"Hironobu Sakaguchi", bio:"From Wikipedia, the free encyclopedia\n\nHironobu Sakaguchi(born November 25, 1962) is a Japanese game designer, game director and game producer.  He is world famous as the creator of the Final Fantasy series, and has had a long career in gaming with over 80 million units of video games sold worldwide.  He left Square Enix and founded a studio called Mistwalker in 2004. \n\nDescription above from the Wikipedia article Hironobu Sakaguchi, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/21692"}}, {tmdbId:"21693", properties:{bornIn:"Aichi, Japan", imdbId:"1012102", name:" Motonori Sakakibara", url:"https://themoviedb.org/person/21693"}}, {tmdbId:"85013", properties:{imdbId:"0321403", name:"Stéphane Giusti", url:"https://themoviedb.org/person/85013"}}, {tmdbId:"18889", properties:{imdbId:"0734747", born:date('1954-01-01'), name:"Mic Rodgers", bio:"Mic's Experience: 40 years SAG Stunt Work, 30 years DGA 2nd Unit Dir; Mel Gibson's personal stunt double (1984-nov 1997)...", url:"https://themoviedb.org/person/18889"}}, {tmdbId:"19012", properties:{bornIn:"St. Louis, Missouri, USA", imdbId:"0346550", born:date('1963-11-03'), name:"Davis Guggenheim", bio:"​From Wikipedia, the free encyclopedia\n\nPhilip Davis Guggenheim (born November 3, 1963) is an Academy Award-winning American film director and producer.  His credits as a producer and director include Training Day, The Shield, Alias, 24, NYPD Blue, ER, Deadwood, and Party of Five and the documentaries An Inconvenient Truth and Waiting for 'Superman'...", url:"https://themoviedb.org/person/19012"}}, {tmdbId:"3702", properties:{bornIn:"Hannover, Germany", imdbId:"0771923", born:date('1968-05-08'), name:"Sebastian Schipper", bio:"Sebastian Schipper was born on May 8, 1968 in Hannover, Germany.  He is a director, and sometimes actor, known mainly for his films Gigantic (1999), A Friend of Mine (2006), Victoria (2015) and Roads (2019)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kJLojH0xuTjqlqdCv4Ls8x72RC.jpg", url:"https://themoviedb.org/person/3702"}}, {tmdbId:"130750", properties:{imdbId:"0039468", name:"Peter Askin", url:"https://themoviedb.org/person/130750"}}, {tmdbId:"5125", properties:{bornIn:"Hamburg, Germany", imdbId:"0015359", born:date('1973-08-25'), name:"Fatih Akin", bio:"Fatih Akin (Turkish: Fatih Akın, born 25 August 1973) is a German film director, screenwriter and producer of Turkish descent.  He has won numerous awards for his films, including the Golden Bear at the Berlin Film Festival for his film Head-On (2004), Best Screenplay at the Cannes Film Festival for his film The Edge of Heaven (2007), and the Golden Globe Award for Best Foreign Language Film for his film In the Fade (2017). \n\nAkin was born in Hamburg to Turkish parents...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/y0ZdlppiSW4RDWtFrQ47Mvs58RM.jpg", url:"https://themoviedb.org/person/5125"}}, {tmdbId:"26875", properties:{bornIn:"Konkō, Okayama, Giappone", imdbId:"0620378", born:date('1961-07-19'), name:"Hideo Nakata", bio:"Hideo Nakata (中田 秀夫 Nakata Hideo, born July 19, 1961) is a Japanese filmmaker...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q02p7ApSNsdFbpKSpUI9vtBe9Cd.jpg", url:"https://themoviedb.org/person/26875"}}, {tmdbId:"1355931", properties:{imdbId:"0118756", name:"Noel Buckner", url:"https://themoviedb.org/person/1355931"}}, {tmdbId:"1355932", properties:{name:" Rob Whittlesey", url:"https://themoviedb.org/person/1355932"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"3395", properties:{bornIn:"Virum, Denmark", imdbId:"0647718", born:date('1965-04-23'), name:"Lasse Spang Olsen", bio:"Lasse Spang Olsen (born 23 April 1965) is a Danish filmmaker.  He is the son of illustrator and author, Ib Spang Olsen. \n\nApart from his many directorial and stunt coordinator credits, Olsen worked as a coordinator of extras on more than 300 films over the course two decades...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/twHJZMMeGWtqLIApmhwOIt2C8xT.jpg", url:"https://themoviedb.org/person/3395"}}, {tmdbId:"87429", properties:{bornIn:"Villefranche-sur-Mer, France", imdbId:"0643664", born:date('1943-10-27'), name:"Michel Ocelot", bio:"Michel Ocelot is a French writer, character designer, storyboard artist and director of animated films and television programs (formerly also animator, background artist, narrator and other roles in earlier works) and a former president of the International Animated Film Association...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yxVlRbK8O9MfOd2RBOiBNCFkHKD.jpg", url:"https://themoviedb.org/person/87429"}}, {tmdbId:"228568", properties:{imdbId:"0507236", name:"Gough Lewis", url:"https://themoviedb.org/person/228568"}}, {tmdbId:"35796", properties:{bornIn:"Brooklyn, New York City, New York, USA", imdbId:"0563301", born:date('1971-04-08'), name:"Craig Mazin", bio:"Craig Mazin is an American screenwriter and film director.  He is known for writing Identity Thief, The Hangover Part II, The Hangover Part III, and The Huntsman: Winter's War, as well as the five-part miniseries for HBO and Sky based on the Chernobyl disaster.  Mazin co-hosts the Scriptnotes podcast alongside fellow screenwriter John August...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uEhna6qcMuyU5TP7irpTUZ2ZsZc.jpg", url:"https://themoviedb.org/person/35796"}}, {tmdbId:"24294", properties:{bornIn:"Brooklyn, New York, United States", imdbId:"0950226", born:date('1972-10-07'), name:"Ben Younger", bio:"Ben Younger (born October 7, 1972) is an American screenwriter and film director.   Description above from the Wikipedia article Ben Younger, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/24294"}}, {tmdbId:"33438", properties:{bornIn:"Adelaide, Australia", imdbId:"0006729", born:date('1963-03-27'), name:"Pip Karmel", bio:"​From Wikipedia, the free encyclopedia\n\nPhilippa (\"Pip\") Karmel (born 1963) is an Australian filmmaker.  As a film editor, she has worked exclusively with director Scott Hicks in a notable collaboration from 1988 through 2007; their work together includes the widely recognized film Shine (1996).  She has directed and written several films, including Me Myself I (2000), which was released internationally...", url:"https://themoviedb.org/person/33438"}}, {tmdbId:"21647", properties:{bornIn:"Paris, Ile-de-France, France", imdbId:"0470443", born:date('1953-05-17'), name:"Gérard Krawczyk", bio:"​From Wikipedia, the free encyclopedia.     Gérard Krawczyk (17 May 1953) is a French film director.  He is of Polish descent (his grandparents were from Częstochowa).   Description above from the Wikipedia article Gérard Krawczyk  , licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3As3jvza5WtPIbIbLl8hYQToNmV.jpg", url:"https://themoviedb.org/person/21647"}}, {tmdbId:"551883", properties:{imdbId:"0473870", name:"Andrew J. Kuehn", url:"https://themoviedb.org/person/551883"}}, {tmdbId:"26849", properties:{bornIn:"Sarasota, Florida, USA", imdbId:"0617130", born:date('1962-11-30'), name:"Daniel Myrick", bio:"From Wikipedia, the free encyclopedia. \n\nDaniel Myrick (born November 30, 1962) is an American director most famous for co-directing and writing the 1999 film The Blair Witch Project with Eduardo Sánchez, for which they won the Independent Spirit John Cassavetes Award...", url:"https://themoviedb.org/person/26849"}}, {tmdbId:"157879", properties:{bornIn:"Ottawa, Ontario, Canada", imdbId:"0533744", born:date('1958-07-31'), name:"Alison Maclean", bio:"From Wikipedia, the free encyclopedia. \n\nAlison Maclean is a Canadian film director of music videos, short films, television (episodes of Sex and the City, The Tudors, Homicide: Life On the Street), commercials and feature films.  Her works include the music video Torn (Natalie Imbruglia, 1998), the short film Kitchen Sink (1989) and the feature films Jesus' Son (1999) starring Billy Crudup and Crush (1992) starring Marcia Gay Harden...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jfSCedkHdpM9HxmZvohQqYklutX.jpg", url:"https://themoviedb.org/person/157879"}}, {tmdbId:"84782", properties:{imdbId:"0568230", name:"Francine McDougall", bio:"From Wikipedia, the free encyclopedia\n\nFrancine McDougall is an Australian film director, producer, television director and photographer.  She is best known for directing the 2001 comedy film Sugar &amp; Spice, her major directorial debut.  She also directed the Disney Channel Original Movies Go Figure and Cow Belles. \n\nDescription above from the Wikipedia article Francine McDougall, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lPhr15uylGQ0PzV6kmONbSlKaTV.jpg", url:"https://themoviedb.org/person/84782"}}, {tmdbId:"65627", properties:{imdbId:"0410640", name:"Kris Isacsson", url:"https://themoviedb.org/person/65627"}}, {tmdbId:"15115", properties:{bornIn:"Vienna, Austria", imdbId:"0752328", born:date('1961-12-25'), name:"Stefan Ruzowitzky", bio:"​From Wikipedia, the free encyclopedia\n\nStefan Ruzowitzky (born December 25, 1961) is an Academy Award-winning Austrian film director and screenwriter. \n\nDescription above from the Wikipedia article Stefan Ruzowitzky, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/15115"}}, {tmdbId:"19842", properties:{bornIn:"Albacete, Spain", imdbId:"0191109", born:date('1947-02-18'), name:"José Luis Cuerda", bio:"He became radio and television technician after abandoning his law studies.  In 1969 he joined Spanish Television, doing reports and documentaries for information services (for five years conducted more than 500 features and documentaries).  Between 1985 and 1987 he taught at the Faculty of Fine Arts from the University of Salamanca.  After several short films in 1982 directed his first feature 'Pares y Nones', which would bring within the scope of the directors who cultivate the \"Madrid comedy\"...", url:"https://themoviedb.org/person/19842"}}, {tmdbId:"21339", properties:{bornIn:"London, England, UK", imdbId:"0125336", born:date('1969-01-01'), name:"Jez Butterworth", bio:"​From Wikipedia, the free encyclopedia.   \n\nJeremy “Jez” Butterworth is an English dramatist and film director.  Butterworth has had major success with his play Mojo that premiered at the Royal Court Theatre in 1995.  It won the Laurence Olivier, an Evening Standard and the George Devine awards.  Butterworth wrote and directed the film adaptation of Mojo, released in 1997.  This featured Harold Pinter...", url:"https://themoviedb.org/person/21339"}}, {tmdbId:"68281", properties:{bornIn:"Cardiff, Regno Unito", imdbId:"0449863", born:date('1977-01-01'), name:"Justin Kerrigan", url:"https://themoviedb.org/person/68281"}}, {tmdbId:"60621", properties:{bornIn:"California, USA", imdbId:"0291449", born:date('1955-01-21'), name:"Jeff Franklin", bio:"Jeffrey Alan \"Jeff\" Franklin  is an American television producer, writer, and director.  He achieved most of his success in the 1980s and '90s, with family-oriented sitcoms like Full House, Hangin' with Mr.  Cooper and Malcolm & Eddie.  He has also been involved in other situation comedies, including Bosom Buddies, and Laverne & Shirley. \n\nDescription above from the Wikipedia article Jeff Franklin, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/60621"}}, {tmdbId:"57741", properties:{bornIn:"Trenton, New Jersey, USA", imdbId:"0651706", born:date('1970-09-17'), name:"Mark Osborne", bio:"Mark Randolph Osborne (September 17, 1970) is an American film director, writer, producer, animator and Guggenheim Fellow (2004). \n\nDescription above from the Wikipedia article Mark Osborne (filmmaker), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6mIJet9Jhpwd2PuVlBzG4VqItAj.jpg", url:"https://themoviedb.org/person/57741"}}, {tmdbId:"1018069", properties:{imdbId:"0297543", name:"Christine Fugate", url:"https://themoviedb.org/person/1018069"}}, {tmdbId:"998589", properties:{bornIn:"USA", imdbId:"0841647", name:"John Swanbeck", url:"https://themoviedb.org/person/998589"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"17279", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0580729", born:date('1964-06-14'), name:"E. Elias Merhige", bio:"From Wikipedia, the free encyclopedia. \n\nEdmund Elias Merhige, known as E.  Elias Merhige, (born June 14th, 1964) is an American film director born in Brooklyn. \n\nMerhige is best known to mainstream audiences for the 2000 film Shadow of the Vampire, and to underground audiences for the cult-classic 1991 film Begotten. \n\nAs he says in his audio commentary to the Shadow of the Vampire DVD, Merhige views cinema as the only meaningful art form of the present era...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9fRLMDZquUrLaWj3FpVFga3t5DF.jpg", url:"https://themoviedb.org/person/17279"}}, {tmdbId:"61921", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"0813309", born:date('1971-09-01'), name:"Courtney Solomon", bio:"Courtney Solomon is a Canadian film producer. \n\nSolomon produced and directed the 2000 film Dungeons & Dragons.  His latest film, An American Haunting, is based on the Bell Witch legend in Tennessee. \n\nHe is the founder and present head of After Dark Films, a film production and distribution company specializing in horror films, and organizer of the annual horror film festival Horrorfest featuring 8 Films to Die For...", url:"https://themoviedb.org/person/61921"}}, {tmdbId:"87121", properties:{bornIn:"Kashmir, India", imdbId:"0765231", name:"Vic Sarin", bio:"From Wikipedia, the free encyclopedia. \n\nVic Sarin (born 1945) is an Indian-born Canadian/American film director, producer and screenwriter.  His work as a cinematographer includes Partition, Margaret's Museum, Whale Music, Nowhere to Hide, Norman's Awesome Experience, and Riel.  He also directed such projects as Partition, Left Behind, and Wind at My Back.  Sarin was born in Kashmir, India...", url:"https://themoviedb.org/person/87121"}}, {tmdbId:"65428", properties:{imdbId:"0354126", name:" Michael Haigney", url:"https://themoviedb.org/person/65428"}}, {tmdbId:"64883", properties:{bornIn:"Masan, South Gyeongsang Province, South Korea", imdbId:"0437625", born:date('1962-12-23'), name:"Je-kyu Kang", bio:"​From Wikipedia, the free encyclopedia\n\nKang Je-gyu (born December 23, 1962) is a South Korean film director.  He studied in Chungang University.  He firstly got his prize in Korea Youth Film festival and Korea Scenario Awards in 1991. \n\nDescription above from the Wikipedia article Kang Je-gyu, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z6vwJt3XAcQmkiuodC7hXD8ktv2.jpg", url:"https://themoviedb.org/person/64883"}}, {tmdbId:"86382", properties:{bornIn:"USA", imdbId:"0111303", born:date('1947-09-19'), name:"Henry Bromell", bio:"From Wikipedia, the free encyclopedia\n\nHenry Bromell (born 1947) is an American author, screenwriter, and director. \n\nBromell attended Eaglebrook School ('63) and the United World College of the Atlantic (64-66).  He graduated from Amherst College in 1970.  He won the Houghton Mifflin Literary Award for his first novel, The Slightest Distance.  His collection of short stories, I Know Your Heart, Marco Polo, was published by Knopf.  Bromell's work has appeared in two O.  Henry Award collections...", died:date('2013-03-18'), url:"https://themoviedb.org/person/86382"}}, {tmdbId:"6295", properties:{bornIn:"Bressuire, Deux-Sèvres, Poitou-Charentes, France", imdbId:"0106924", born:date('1948-07-13'), name:"Catherine Breillat", bio:"From Wikipedia, the free encyclopedia. \n\nCatherine Breillat (born 13 July 1948 in Bressuire, Deux-Sèvres) is a French filmmaker, novelist and Professor of Auteur Cinema at the European Graduate School...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wIJr8XJc7QjTCydM810YCWEK2oD.jpg", url:"https://themoviedb.org/person/6295"}}, {tmdbId:"24248", properties:{bornIn:"Launceston, UK", imdbId:"0170719", born:date('1959-01-01'), name:"Nigel Cole", bio:"From Wikipedia, the free encyclopedia\n\nNigel Cole (born 1959) is a British film and television director. \n\nCole began his career in the 1980s, directing current affairs shows and documentaries for Central Independent Television.  Into the 1990s, Cole co-wrote the play Sod with Arthur Smith, which he also directed and presented at the Pleasance during the 1993 Edinburgh Festival...", url:"https://themoviedb.org/person/24248"}}, {tmdbId:"41272", properties:{bornIn:"San Antonio, Texas, USA", imdbId:"0592687", born:date('1940-03-05'), name:"Don Mischer", url:"https://themoviedb.org/person/41272"}}, {tmdbId:"1219210", properties:{imdbId:"0686184", name:"Mark Piznarski", bio:"From Wikipedia, the free encyclopedia. \n\nMark Piznarski is an American film and television director.  He has directed episodes from a number of television series, including, amongst others, Veronica Mars, Gossip Girl, 90210, NYPD Blue, Friday Night Lights, Everwood, Mary Sunshine, My So-Called Life, Relativity and To Love and Die.  He has also directed a number of films and TV movies including Soccer Moms, Here on Earth and Death Benefit...", url:"https://themoviedb.org/person/1219210"}}, {tmdbId:"7324", properties:{imdbId:"0659023", name:"Pan Nalin", url:"https://themoviedb.org/person/7324"}}, {tmdbId:"12890", properties:{bornIn:"Bloomington, Minnesota, USA", imdbId:"0230032", born:date('1968-10-09'), name:"Pete Docter", bio:"Peter Hans \"Pete\" Docter is an American film director, animator, and screenwriter from Bloomington, Minnesota.  He is best known for directing the films Monsters, Inc.  and Up, and as a key figure and collaborator in Pixar Animation Studios.  The A.  V.  Club has called him \"almost universally successful\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rrAW10FlcOjqMllSwNBrFjfUT4k.jpg", url:"https://themoviedb.org/person/12890"}}, {tmdbId:"197", properties:{bornIn:"New York, City, New York, USA", imdbId:"0798899", born:date('1957-03-15'), name:" David Silverman", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uny7r1KHtuNd5dxAYPwLEyt0chs.jpg", url:"https://themoviedb.org/person/197"}}, {tmdbId:"71947", properties:{bornIn:"USA", imdbId:"0697656", born:date('1969-06-10'), name:"Gina Prince-Bythewood", bio:"Gina Prince-Bythewood (born Gina Maria Prince on June 10, 1969) is an American film director and writer.  Her primary credits as a director include the films Disappearing Acts and Love &amp; Basketball, produced by Spike Lee and starring Omar Epps and Sanaa Lathan, which won her the Independent Spirit Award for Best First Screenplay. \n\nBythewood attended UCLA's film school, where she also ran competitive track...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6LpH5I6bx0skQyPYMrpjDpJAV5v.jpg", url:"https://themoviedb.org/person/71947"}}, {tmdbId:"56154", properties:{imdbId:"0388817", name:"Antony Hoffman", url:"https://themoviedb.org/person/56154"}}, {tmdbId:"45138", properties:{bornIn:"Liège, Belgium", imdbId:"0201095", born:date('1954-03-10'), name:" Luc Dardenne", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/69TrH0jMMTQPrSUgQP7WLdEpRSF.jpg", url:"https://themoviedb.org/person/45138"}}, {tmdbId:"1141406", properties:{imdbId:"0559877", name:"John Mathew Matthan", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yDkAY6uQ4tMaJbb1Crc8z300i5b.jpg", url:"https://themoviedb.org/person/1141406"}}, {tmdbId:"115309", properties:{bornIn:"Bhutan", imdbId:"0634897", born:date('1961-06-18'), name:"Khyentse Norbu", bio:"From Wikipedia, the free encyclopedia. \n\nDzongsar Jamyang Khyentse Rinpoche (born 1961), also known as Khyentse Norbu, is a Bhutanese lama, filmmaker, and writer.  His two major films are The Cup (1999) and Travellers and Magicians (2003).  He is the author of the book What Makes You Not a Buddhist (Shambhala, 2007).  He is also a prominent tulku associated with Dzongsar Monastery in Derge, Eastern Tibet...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pBEPv2UJx2OW6eXyy5vlAfmNrfq.jpg", url:"https://themoviedb.org/person/115309"}}, {tmdbId:"161858", properties:{imdbId:"0713527", born:date('1961-03-17'), name:"David Raynr", url:"https://themoviedb.org/person/161858"}}, {tmdbId:"99496", properties:{imdbId:"0208343", born:date('1964-06-30'), name:"Raymond De Felitta", bio:"​From Wikipedia, the free encyclopedia\n\nRaymond De Felitta (born 30 June 1964) is an American independent filmmaker, writer and musician from New York City. \n\nDescription above from the Wikipedia article Raymond De Felitta, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/99496"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"9033", properties:{bornIn:"Princeton Junction, New Jersey,USA", imdbId:"0003160", born:date('1968-01-01'), name:"Christopher McQuarrie", bio:"Christopher McQuarrie is an American screenwriter, producer and director.  His screenplays include The Usual Suspects, for which he won the 1996 Academy Award, The Way of the Gun and Valkyrie.  He is the creator of NBC television series Persons Unknown...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xVbQBRpqzKkllUAvjJbgnAmTwaZ.jpg", url:"https://themoviedb.org/person/9033"}}, {tmdbId:"30711", properties:{bornIn:"New York City, New York USA", imdbId:"0518836", born:date('1962-10-16'), name:"Kenneth Lonergan", bio:"From Wikipedia, the free encyclopedia. \n\nKenneth Lonergan (born October 16, 1962) is a playwright, screenwriter, and director born in the Bronx, New York City, New York.  He began writing in high school at the Walden School (a defunct private school in Manhattan with a strong drama program). \n\nHis first play, The Rennings Children, was chosen for the Young Playwright's Festival in 1982 while he was still an undergraduate.  He would go on to graduate from the NYU Playwriting Program...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/TPd9TDpZRP8fpLjFEazQUuKWDk.jpg", url:"https://themoviedb.org/person/30711"}}, {tmdbId:"21981", properties:{bornIn:"Netherlands", imdbId:"0958969", born:date('1965-07-01'), name:"Harald Zwart", bio:"From Wikipedia, the free encyclopedia.   \n\nHarald Zwart (born July 1, 1965) is a Norwegian film director. \n\nAlthough born in the Netherlands, Zwart was raised in Fredrikstad in Norway.  As early as age eight, he started making short films.  He attended the Dutch Film Academy in Amsterdam where he received great acclaim for his student film Gabriel's Surprise.  The film was later televised...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1ncMe83Yo8SAj2o8z71eGQUPMBK.jpg", url:"https://themoviedb.org/person/21981"}}, {tmdbId:"66604", properties:{imdbId:"0152741", name:"Joe Charbanic", url:"https://themoviedb.org/person/66604"}}, {tmdbId:"151166", properties:{bornIn:"Uccle, Belgium", imdbId:"0285090", born:date('1968-01-09'), name:"Frédéric Fonteyne", url:"https://themoviedb.org/person/151166"}}, {tmdbId:"59026", properties:{bornIn:"Raleigh, North Carolina, USA", imdbId:"0715636", born:date('1964-07-03'), name:"Peyton Reed", bio:"Peyton Reed (born 3 July 1964) is an American television and film director. \n\nReed was born in Raleigh, North Carolina and attended the University of North Carolina at Chapel Hill.  Reed directed the motion pictures Bring It On, Down with Love, and The Break-Up; all comedy films.  He has also acted in small roles in some films including his own and has written a few original songs for his soundtracks.  He has also produced a few music videos...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aucXNycAtFREMIKr6ikmHvd2Mmp.jpg", url:"https://themoviedb.org/person/59026"}}, {tmdbId:"64151", properties:{bornIn:"Oklahoma City, Oklahoma, USA", imdbId:"0593610", born:date('1970-10-18'), name:"Mike Mitchell", bio:"​From Wikipedia, the free encyclopedia.   \n\nMike Mitchell (born c.  1970/71) is an American film director, producer, actor and former animator.  He is well known for directing the films Surviving Christmas, Sky High, Shrek Forever After for DreamWorks Animation, Popeye for Sony Pictures Animation...", url:"https://themoviedb.org/person/64151"}}, {tmdbId:"113733", properties:{bornIn:"Hilary Mary Allcroft Worthing, England", imdbId:"0020150", name:"Britt Allcroft", bio:"From Wikipedia, the free encyclopedia. \n\nBritt Allcroft is the multi- award-winning creator of a trio of children's entertainment produced in the 1980s and 1990s: \"Thomas the Tank Engine and Friends\", (now retitled \"Thomas and Friends\"), \"Shining Time Station\" (with co-creator Rick Siggelkow) and \"Britt Allcroft's Magic Adventures of Mumfie\". \n\nShe was born Hilary Mary Allcroft, in Worthing, England and, at 16, changed her name to Britt as her career in British radio and TV gained momentum...", url:"https://themoviedb.org/person/113733"}}, {tmdbId:"4387", properties:{bornIn:"Paris, France", imdbId:"0654830", born:date('1967-11-15'), name:"François Ozon", bio:"François Ozon (born 15 November 1967) is a French film director and screenwriter and whose films are usually characterized by sharp satirical wit and a freewheeling view on human sexuality. \n\nHe has achieved international acclaim for his films 8 femmes (2002) and Swimming Pool (2003)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6ySxjLJKObkNJXyfMWLhr0pt0Ie.jpg", url:"https://themoviedb.org/person/4387"}}, {tmdbId:"240363", properties:{bornIn:"New York City, New York, USA", imdbId:"2428282", name:" Laurie Gwen Shapiro", bio:"​From Wikipedia, the free encyclopedia.   \n\nLaurie Gwen Shapiro is an American writer and filmmaker.  She resides in New York City, where she was born and raised, and is a graduate of that city's renowned Stuyvesant High School...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fPtAyy8Ir2RaTvMdmiNYNvxqadc.jpg", url:"https://themoviedb.org/person/240363"}}, {tmdbId:"585280", properties:{imdbId:"0184016", name:"Kristen Coury", url:"https://themoviedb.org/person/585280"}}, {tmdbId:"76221", properties:{imdbId:"0255780", born:date('1959-05-03'), name:"Ben Elton", bio:"Already a successful comedian, Ben Elton turned to writing situation comedies during the 1980s and penned BBC classics such as \"The Young Ones\" (1982), \"Black-Adder II\" (1986), \"Black Adder the Third\" (1987), \"Blackadder 4\" (1989) and during the 1990s \"The Thin Blue Line\" (1995). \n\nHe provided lyrics for Andrew Lloyd Webber's musical, \"The Beautiful Game\", which was nominated for Best Musical at the Laurence Olivier Theatre Awards in 2001 (2000 season)...", url:"https://themoviedb.org/person/76221"}}, {tmdbId:"1455472", properties:{imdbId:"0447476", name:"Aviva Kempner", url:"https://themoviedb.org/person/1455472"}}, {tmdbId:"65879", properties:{bornIn:"Copenhagen, Denmark", imdbId:"0506290", born:date('1967-05-09'), name:"Kristian Levring", bio:"From Wikipedia, the free encyclopedia\n\nKristian Levring is a Danish director born in 1957 in Denmark.  He was the fourth signatory of Dogme95.  He lived eight years in France.  He graduated in editing at the National Film School of Denmark and has edited a large number of documentaries and feature films besides directing two feature films, among these, Et skud fra hjertet (1986).  He is the recipient of some 23 Danish and international awards for his commercials...", url:"https://themoviedb.org/person/65879"}}, {tmdbId:"6345", properties:{bornIn:"Morristown, New Jersey, USA", imdbId:"0005767", born:date('1948-03-31'), name:" Edward Lachman", bio:"Edward Lachman, A. S. C.  is an American cinematographer and director.  Lachman is mostly associated with the American independent film movement, and has served as director of photography on films by Todd Haynes, Wim Wenders, Steven Soderbergh, Sofia Coppola and Paul Schrader...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3kVVmrHn39L0yuNHTbd3slTiNaz.jpg", url:"https://themoviedb.org/person/6345"}}, {tmdbId:"20739", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0788202", born:date('1964-11-27'), name:"Adam Shankman", bio:"Adam Michael Shankman (born November 27, 1964) is an American film director, producer, dancer, actor, and choreographer.  He has been a judge on the television program So You Think You Can Dance since Season 3.  He began his professional career in musical theater, and was a dancer in music videos for Paula Abdul and Janet Jackson.  Shankman also choreographed one of the Spice Girls' tours...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zZmZgVp5OTU2eSMCDuOXGlQ4fBR.jpg", url:"https://themoviedb.org/person/20739"}}, {tmdbId:"56512", properties:{bornIn:"India", imdbId:"0802248", born:date('1961-05-06'), name:"Tarsem Singh", bio:"Tarsem Singh Dhandwar, known professionally as Tarsem, is an Indian-American director who has worked on films, music videos, and commercials. \n\nTarsem was born in Jalandhar, Punjab to a Punjabi Sikh family.  His father was an aircraft engineer.  He is a graduate of the Art Center College of Design in Pasadena, California. \n\nTarsem began his career directing music videos, including those of \"Hold On\" by En Vogue, \"Sweet Lullaby\" by Deep Forest and R. E. M...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/chigUx2ETaKoLOIv3AIVt5KH1nK.jpg", url:"https://themoviedb.org/person/56512"}}, {tmdbId:"43", properties:{bornIn:"Edmonton, Alberta, Canada", imdbId:"0269502", born:date('1968-03-05'), name:"John Fawcett", bio:"John Fawcett is a Canadian film and television director, producer and writer, best known for the movie \"Ginger Snaps\" and as co-creator, executive producer and director of the television series \"Orphan Black\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ArR5IXmo5yqjH4I6kcO9W5u9rDC.jpg", url:"https://themoviedb.org/person/43"}}, {tmdbId:"54025", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0476201", born:date('1968-03-21'), name:"Karyn Kusama", bio:"Karyn Kusama (born March 21, 1968) is an American film director and screenwriter. \n\nA graduate of New York University's film school, her début production Girlfight won both the Director's Award and the Grand Jury Prize (tied with Kenneth Lonergan's You Can Count on Me) at the 2000 Sundance Film Festival.  She has finished a live-action film version of Æon Flux, starring Charlize Theron.  Her newest film is Jennifer's Body which is written by Diablo Cody...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d8jLYxsHkoPJiGXvps9SD7zVdAc.jpg", url:"https://themoviedb.org/person/54025"}}, {tmdbId:"147024", properties:{imdbId:"0885108", name:"Eric Valli", url:"https://themoviedb.org/person/147024"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"1707515", properties:{name:" Michel Debats", url:"https://themoviedb.org/person/1707515"}}, {tmdbId:"74569", properties:{imdbId:"1703612", name:"Joby Harold", bio:"From Wikipedia, the free encyclopedia. \n\nJoby Harold is an English  film director and screenwriter currently living in Los Angeles.  He wrote and directed AWAKE for The Weinstein Company starring Hayden Christensen, Jessica Alba, Terrence Howard and Lena Olin.  The film was produced for under $8. 6M and grossed $32M worldwide in theatrical and $23. 45M on dvd...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bHlPziMdGj2GZk88HTVoVqS4N94.jpg", url:"https://themoviedb.org/person/74569"}}, {tmdbId:"56789", properties:{imdbId:"0080120", born:date('1964-03-08'), name:"Thomas Bezucha", bio:"From Wikipedia, the free encyclopedia. \n\nThomas Gordon Bezucha (born 8 March 1964) is an American screenwriter and director. \n\nHe wrote and directed Big Eden (2000) and The Family Stone (2005).  He is a graduate of Amherst Regional High School in Amherst, Massachusetts.  He will next direct Monte Carlo, which he co-wrote with April Blair. \n\nBezucha is openly gay. \n\nDescription above from the Wikipedia article Thomas Bezucha, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/56789"}}, {tmdbId:"17042", properties:{bornIn:" Michigan, USA", imdbId:"0365615", born:date('1969-05-04'), name:"Greg Harrison", bio:"​From Wikipedia, the free encyclopedia.   \n\nGreg Harrison (born May 4, 1969 in Michigan) is an American film director and editor. \n\nHe graduated from Michigan State University. \n\nHe has directed films such as Groove (2000) and November (2004), both of which were produced by Danielle Renfrew. \n\nDescription above from the Wikipedia article Greg Harrison,  licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/17042"}}, {tmdbId:"80540", properties:{imdbId:"0075010", name:"Stig Bergqvist", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/HYKwT9uHh4SmpHHV6cCqyBwom4.jpg", url:"https://themoviedb.org/person/80540"}}, {tmdbId:"1233222", properties:{imdbId:"0218450", name:" Paul Demeyer", url:"https://themoviedb.org/person/1233222"}}, {tmdbId:"31120", properties:{imdbId:"0011950", name:"Robert Adetuyi", bio:"From Wikipedia, the free encyclopedia\n\nRobert Adetuyi (born Sudbury, Ontario) is a Canadian screenwriter and film director.  A graduate of York University, where he studied communications and sociology, he moved to Hollywood in 1992. \n\nHis screenwriting credits include Stomp the Yard, Code Name: The Cleaner and Turn It Up.  He also directed Turn it Up...", url:"https://themoviedb.org/person/31120"}}, {tmdbId:"18175", properties:{bornIn:"Bühl, West Germany", imdbId:"0596962", born:date('1962-05-07'), name:"Dominik Moll", bio:"From Wikipedia, the free encyclopedia\n\nDominik Moll (born 7 May 1962) is a German born French film director and screenwriter.  He wrote and directed Harry, un ami qui vous veut du bien and Lemming.  He was born in Bühl, West Germany. \n\nFor his achievements on the film Harry, un ami qui vous veut du bien, he won the 2001 César Award for Best Director.  Both Lemming and Harry, un ami qui vous veut du bien were nominated for the Palme d'Or at the Cannes Film Festival...", url:"https://themoviedb.org/person/18175"}}, {tmdbId:"91987", properties:{imdbId:"0122672", name:"Gary Burns", url:"https://themoviedb.org/person/91987"}}, {tmdbId:"71943", properties:{imdbId:"0090066", born:date('1965-07-07'), name:"Reggie Rock Bythewood", url:"https://themoviedb.org/person/71943"}}, {tmdbId:"27226", properties:{imdbId:"0527261", name:"Patrick Lussier", bio:"From Wikipedia, the free encyclopedia. \n\nPatrick Lussier (born 1964) is a Canadian horror and thriller genre writer, editor and director. \n\nDescription above from the Wikipedia article Patrick Lussier, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iDVSGsOz8PewY4SCAEDCDaobi4.jpg", url:"https://themoviedb.org/person/27226"}}, {tmdbId:"93301", properties:{bornIn:"Hawaii, USA", imdbId:"0266255", born:date('1969-05-07'), name:"Jun Falkenstein", bio:"From Wikipedia, the free encyclopedia. \n\nJun Falkenstein (born May 7, 1969) is an animation director, writer, and story artist.  She is best known for directing the Disney theatrical feature The Tigger Movie. \n\nDescription above from the Wikipedia article Jun Falkenstein, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/93301"}}, {tmdbId:"227412", properties:{bornIn:"England, United Kingdom", imdbId:"0909735", born:date('1969-11-24'), name:"Kieron J. Walsh", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lb2S1ZiRyH8GNzaLjLaib5ynalF.jpg", url:"https://themoviedb.org/person/227412"}}, {tmdbId:"17597", properties:{bornIn:"Tenerife, Canary Islands, Spain", imdbId:"0294379", born:date('1967-12-05'), name:"Juan Carlos Fresnadillo", bio:"From Wikipedia, the free encyclopedia.   Juan Carlos Fresnadillo (born 5 December 1967) is a Spanish film director, script writer, and producer.  He directed Intacto and 28 Weeks Later, the sequel to Danny Boyle's 28 Days Later.  His film Esposados was nominated for the Academy Award for Best Live Action Short Film in 1996. \n\nDescription above from the Wikipedia article Juan Carlos Fresnadillo, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/17597"}}, {tmdbId:"137427", properties:{bornIn:"Trois-Rivières, Québec, Canada", imdbId:"0898288", born:date('1967-10-03'), name:"Denis Villeneuve", bio:"Denis Villeneuve (born October 3, 1967 in Gentilly, Quebec) is a Canadian film director and writer.  In his early career he won Radio-Canada's youth film competition \"La Course Europe-Asie\" in 1990-91.  He is a three-time winner of the Genie Award for Best Director, for Maelström in 2001, Polytechnique in 2010 and Incendies in 2011.  All three films also won the Best Picture award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zdDx9Xs93UIrJFWYApYR28J8M6b.jpg", url:"https://themoviedb.org/person/137427"}}, {tmdbId:"110962", properties:{bornIn:"Venice, California, USA", imdbId:"0645574", born:date('1952-03-12'), name:"Steven Okazaki", bio:"Steven Toll Okazaki (born March 12, 1952, in Venice, California) is an American filmmaker.  He is Sansei Japanese American (3rd generation) and is based in the San Francisco Bay Area.  He has received a Peabody Award and been nominated for four Academy Awards, winning an Oscar for the documentary short subject, Days of Waiting: The Life & Art of Estelle Ishigo (1990)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mMwfAicGthVZMS8i7qeeF4DjSMS.jpg", url:"https://themoviedb.org/person/110962"}}, {tmdbId:"37618", properties:{bornIn:"Wellington, New Zealand", imdbId:"0231596", born:date('1967-10-07'), name:"Andrew Dominik", bio:"Andrew Dominik is a New Zealand-born Australian film director and screenwriter.  He has directed the crime film Chopper, the Western drama film The Assassination of Jesse James by the Coward Robert Ford and the neo-noir crime film Killing Them Softly...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eOksZ6BSZboCfh3PAaw2TXsEjPL.jpg", url:"https://themoviedb.org/person/37618"}}, {tmdbId:"12632", properties:{bornIn:"USA", imdbId:"0755261", name:"Daniel Sackheim", bio:"From Wikipedia, the free encyclopedia. \n\nDaniel Sackheim is an American TV and film director.  He has directed several episodes of the TV show The X-Files, 3 episodes of Harsh Realm, House, and Life, the last two of which he also served on as an executive producer...", url:"https://themoviedb.org/person/12632"}}, {tmdbId:"67564", properties:{imdbId:"0307147", name:"Éva Gárdos", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5GucE4mNHplQbc7eZxGtiwjQ4tb.jpg", url:"https://themoviedb.org/person/67564"}}, {tmdbId:"88967", properties:{bornIn:"Rye, New York", imdbId:"0075528", born:date('1972-05-24'), name:"Greg Berlanti", bio:"Greg Berlanti (born May 24, 1972) is an American television writer and producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1T24SiIIDMa9gAmq7QaYwZywq4y.jpg", url:"https://themoviedb.org/person/88967"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"94053", properties:{bornIn:"Asan, Chungcheongnam-do, South Korea", imdbId:"0497934", born:date('1957-08-20'), name:"Myung-se Lee", url:"https://themoviedb.org/person/94053"}}, {tmdbId:"5066", properties:{imdbId:"0239725", born:date('1962-02-23'), name:"Olivier Ducastel", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aHL0qEasSybjiIVri6WEVctBMra.jpg", url:"https://themoviedb.org/person/5066"}}, {tmdbId:"5067", properties:{imdbId:"0553303", name:" Jacques Martineau", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5WSELi82AoBHP8hMZsskVjg68Pc.jpg", url:"https://themoviedb.org/person/5067"}}, {tmdbId:"71418", properties:{imdbId:"0509028", name:"Demian Lichtenstein", url:"https://themoviedb.org/person/71418"}}, {tmdbId:"16957", properties:{imdbId:"0047259", name:"Fenton Bailey", url:"https://themoviedb.org/person/16957"}}, {tmdbId:"16958", properties:{imdbId:"0053190", name:" Randy Barbato", url:"https://themoviedb.org/person/16958"}}, {tmdbId:"84211", properties:{bornIn:" San Francisco, California, USA", imdbId:"0106928", born:date('1964-01-01'), name:"Valerie Breiman", url:"https://themoviedb.org/person/84211"}}, {tmdbId:"135678", properties:{bornIn:"Prague, Czechia", imdbId:"0398575", born:date('1967-06-27'), name:"Jan Hrebejk", url:"https://themoviedb.org/person/135678"}}, {tmdbId:"53178", properties:{bornIn:"Philadelphia, Pennsylvania, USA", imdbId:"0866132", born:date('1955-10-06'), name:"Michael Tollin", bio:"Michael \"Mike\" Tollin (born June 10, 1955) is an American film director and film/television producer.  His career highlights included Radio, Coach Carter, and Varsity Blues.  He frequently collaborates with Brian Robbins in which they own a production company together called Tollin/Robbins Productions.  They created and produced such shows like All That, The Amanda Show, Kenan & Kel, One Tree Hill, Smallville, What I Like About You, The Bronx is Burning and a few others...", url:"https://themoviedb.org/person/53178"}}, {tmdbId:"99593", properties:{imdbId:"0329116", name:"Jenniphr Goodman", bio:"From Wikipedia, the free encyclopedia. \n\nJenniphr Goodman is a film director best known for directing and co-writing the 2000 film The Tao of Steve.  She received her B. A.  in creative writing and film making in 1984 through Pitzer College.  She is also a graduate of New York University's film school at the Tisch School of the Arts. \n\nDescription above from the Wikipedia article Jenniphr Goodman, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/99593"}}, {tmdbId:"58037", properties:{imdbId:"0708870", name:" Ben Ramsey", url:"https://themoviedb.org/person/58037"}}, {tmdbId:"58677", properties:{imdbId:"0875468", name:"Norio Tsuruta", url:"https://themoviedb.org/person/58677"}}, {tmdbId:"1179593", properties:{imdbId:"0254357", name:"Aiyana Elliott", url:"https://themoviedb.org/person/1179593"}}, {tmdbId:"1012", properties:{bornIn:"Frederiksværk, Denmark", imdbId:"0421314", born:date('1972-04-06'), name:"Anders Thomas Jensen", bio:"​From Wikipedia, the free encyclopedia Anders Thomas Jensen (born 6 April 1972 in Frederiksværk) is a Danish screenwriter and film director.  Jensen won the Oscar for his 1998 film Election Night.  He also received Oscar nominations in the live-action short category for his films Ernst &amp; The Light (1996) and Wolfgang (1997)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dcV0ZkjU4fIpAr0ehG3LY7dESFi.jpg", url:"https://themoviedb.org/person/1012"}}, {tmdbId:"1006172", properties:{imdbId:"0389161", name:"Deborah Hoffmann", url:"https://themoviedb.org/person/1006172"}}, {tmdbId:"8296", properties:{bornIn:"Antibes, France", imdbId:"0304521", born:date('1960-03-11'), name:"Christophe Gans", bio:"Christophe Gans is a French film director, producer and screenwriter, who specializes in horror and fantasy movies.   \n\nGans was born in Antibes, France.  As a teenager, he spent a large portion of his time creating kung fu-themed Super 8 movies with his friends.  He later went on to attend the French film school Idhec, where he created his first short film, Silver Slime.  He later spent time as a film critic before co-directing his first film, Necronomicon...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x4ILnMIY8hYXFpJj5d4M2VTQeFb.jpg", url:"https://themoviedb.org/person/8296"}}, {tmdbId:"7554", properties:{bornIn:"Milan, Italy", imdbId:"0812862", born:date('1958-08-01'), name:"Silvio Soldini", bio:"Silvio Soldini was born in 1958 in Milan where he lives and works.  Writer and director, well known for his very successful film BREAD AND TULIPS, winner in 2000 of the David di Donatello and of the Nastri d’Argento.  In 2002, with BURNING IN THE WIND he won the David di Donatello.  In 2007, Margherita Buy whom played in his DAYS IN CLOUDS received the David di Donatello for the best actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gCB9xiKmTcEDrLn8bwjeFINSu1Q.jpg", url:"https://themoviedb.org/person/7554"}}, {tmdbId:"67813", properties:{bornIn:"Reykjavik, Iceland", imdbId:"0466349", born:date('1966-02-27'), name:"Baltasar Kormákur", bio:"Baltasar Kormákur is an Icelandic actor, theater and film director, and film producer.  He is best known for directing the films 101 Reykjavík, Hafið, A Little Trip to Heaven (starring Julia Stiles and Forest Whitaker), and a film based on the book Mýrin (Jar City) by Arnaldur Indriðason.  His father is the Spanish painter Baltasar Samper...", url:"https://themoviedb.org/person/67813"}}, {tmdbId:"13927", properties:{imdbId:"0934483", name:"Kurt Wimmer", bio:"From Wikipedia, the free encyclopedia. \n\nKurt Wimmer (born 1964) is an American screenwriter and film director. \n\nWimmer is of German descent, he attended the University of South Florida and graduated with a BFA degree in Art History.  He then moved to Los Angeles where he worked for 12 years as a screenwriter before making his 2002 film, Equilibrium.  Although he is credited as the director of the 1995 film One Tough Bastard (a. k. a...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w6yuLCfWRWXcFfAcTAmVV3xceHC.jpg", url:"https://themoviedb.org/person/13927"}}, {tmdbId:"7409", properties:{imdbId:"0736930", name:"J.B. Rogers", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3XO63aCsKGwKpXB9aeyPquWmSWi.jpg", url:"https://themoviedb.org/person/7409"}}] AS row
