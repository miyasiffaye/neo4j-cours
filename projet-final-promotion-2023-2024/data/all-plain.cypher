UNWIND [{tmdbId:"65166", properties:{bornIn:"Richmond, Virginia, USA", imdbId:"0431438", born:date('1950-07-31'), name:"Mark Joy", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ithBppxcbmU6MXwjnmUc6vehPnc.jpg", url:"https://themoviedb.org/person/65166"}}, {tmdbId:"6091", properties:{bornIn:"West Berlin, Germany", imdbId:"0225944", born:date('1976-01-04'), name:"August Diehl", bio:"From Wikipedia, the free encyclopedia. \n\nAugust Diehl (born 4 January 1976) is a German actor, known for playing the Gestapo Sturmbannführer Dieter Hellstrom in Inglourious Basterds and Michael \"Mike\" Krause, Evelyn Salt's husband, in the movie Salt. \n\nDescription above from the Wikipedia article August Diehl, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ihi79pNPIDe2xlJgrZZfyoxuibP.jpg", url:"https://themoviedb.org/person/6091"}}, {tmdbId:"17543", properties:{imdbId:"0123974", born:date('1975-10-01'), name:"Fabian Busch", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aPwhdQSEvHIFwzMYRCcx7WIUZW2.jpg", url:"https://themoviedb.org/person/17543"}}, {tmdbId:"17544", properties:{bornIn:"Munich, Germany", imdbId:"0485183", born:date('1961-08-12'), name:"Dieter Landuris", url:"https://themoviedb.org/person/17544"}}, {tmdbId:"17545", properties:{bornIn:"Monheim am Rhein, Germany", imdbId:"0470818", born:date('1962-09-30'), name:"Jan-Gregor Kremp", url:"https://themoviedb.org/person/17545"}}, {tmdbId:"47735", properties:{bornIn:"Irvine, Ayrshire, Scotland, UK", imdbId:"0334150", born:date('1965-07-24'), name:"Julie Graham", bio:"Julia Graham is a Scottish television and film actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wSiQRJuzo25jnU9OUHvUrEYtXdi.jpg", url:"https://themoviedb.org/person/47735"}}, {tmdbId:"96279", properties:{bornIn:"Weston-super-Mare, Somerset, England, UK", imdbId:"0642126", born:date('1966-08-15'), name:"Con O'Neill", bio:"From Wikipedia, the free encyclopedia\n\nRobert \"Con\" O'Neill (born 15 August 1966) is an English actor.  He started his acting career at the Everyman Theatre and became primarily known for his performances in musicals.  He received critical acclaim and won a Laurence Olivier Award for playing Michael \"Mickey\" Johnstone in the musical Blood Brothers.  Subsequently, he was nominated for a Tony Award and a Drama Desk Award for the same role.  He has also appeared in many films and television series...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zFm7hKccaWOx4t2l4RSaszQXPo5.jpg", url:"https://themoviedb.org/person/96279"}}, {tmdbId:"9015", properties:{bornIn:"Glasgow, Scotland, UK", imdbId:"0531808", born:date('1976-02-23'), name:"Kelly Macdonald", bio:"Kelly Macdonald is a Scottish stage, film and televison actress, best known for her feature film debut in the British independent film Trainspotting and for her role as Margaret Thompson on the television series Boardwalk Empire...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kCcEFukFpES2TyHV3go1D06ozYd.jpg", url:"https://themoviedb.org/person/9015"}}, {tmdbId:"21594", properties:{bornIn:"Hinsdale, Illinois, USA", imdbId:"0005098", born:date('1979-03-14'), name:"Chris Klein", bio:"Frederick Christopher \"Chris\" Klein (born March 14, 1979) is an American movie actor.  He is perhaps best known for playing Chris \"Oz\" Ostreicher in the 1999 film American Pie and its sequel American Pie 2. \n\nDescription above from the Wikipedia article Chris Klein (actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/56kCtPVfvjm5IRPa2GyaQHTPIOy.jpg", url:"https://themoviedb.org/person/21594"}}, {tmdbId:"58032", properties:{bornIn:"Tulsa, Oklahoma, United States", imdbId:"0004795", born:date('1982-10-30'), name:"Jessica Campbell", bio:"​From Wikipedia, the free encyclopedia.   \n\nJessica Campbell (born October 30, 1982) is a film and television actress.  Her appearances include the roles of Tammy Metzler in the 1999 film Election, Julie Gold in the 2001 film The Safety of Objects and the recurring role of Amy Andrews in the TV series Freaks and Geeks. \n\nDescription above from the Wikipedia article Jessica Campbell, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/58032"}}, {tmdbId:"93129", properties:{imdbId:"0561676", born:date('1969-11-16'), name:"Chenoa Maxwell", url:"https://themoviedb.org/person/93129"}}, {tmdbId:"932191", properties:{imdbId:"0429319", born:date('1970-06-19'), name:"Tammi Katherine Jones", url:"https://themoviedb.org/person/932191"}}, {tmdbId:"55258", properties:{imdbId:"0498146", born:date('1974-07-16'), name:"Robinne Lee", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h0cKk9LzfrpvOyGwmt9ruq5Nlkw.jpg", url:"https://themoviedb.org/person/55258"}}, {tmdbId:"33676", properties:{bornIn:"Hamilton, Ontario, Canada", imdbId:"0005370", born:date('1973-07-08'), name:"Kathleen Robertson", bio:"Kathleen Robertson (born July 8, 1973) is a Canadian actress.  She is best known for her role as Clare Arnold in Beverly Hills, 90210 (1994–1997). \n\nDescription above from the Wikipedia article Kathleen Robertson, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nGaey63oyvcZWXFEwaihGP2YryY.jpg", url:"https://themoviedb.org/person/33676"}}, {tmdbId:"1209854", properties:{imdbId:"1123814", name:"Bill Haugland", url:"https://themoviedb.org/person/1209854"}}, {tmdbId:"101418", properties:{bornIn:"Montevideo, Uruguay", imdbId:"0485011", born:date('1949-07-06'), name:"Nelson Landrieu", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d1s2tLwb81UX8HhnMQUg0jXno9R.jpg", url:"https://themoviedb.org/person/101418"}}, {tmdbId:"46929", properties:{bornIn:"Fajardo, Puerto Rico", imdbId:"0171583", born:date('1947-06-18'), name:"Ivonne Coll", bio:"Ivonne Coll is a Puerto Rican stage, film and television actress and former Miss Universe Pageant, best known for playing series regular Alba Gloriana Villanueva on the comedy-drama series \"Jane the Virgin\", as well as recurring character Adrianna Vasquez on the television series \"Switched at Birth\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9o1PzlyQKOPZMSXIwvNZN719svC.jpg", url:"https://themoviedb.org/person/46929"}}, {tmdbId:"55706", properties:{imdbId:"0274255", born:date('1973-06-13'), name:"Michelle Ferre", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2BtY8DUS31fbtOCm3AfakkmALjj.jpg", url:"https://themoviedb.org/person/55706"}}, {tmdbId:"55707", properties:{bornIn:"Tokyo, Tokyo Prefecture, Japan", imdbId:"0945457", born:date('1974-04-11'), name:"Mirai Yamamoto", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pfwAxX4sBGrKfgcxHeFOHbqX91I.jpg", url:"https://themoviedb.org/person/55707"}}, {tmdbId:"54470", properties:{bornIn:"New Haven, Connecticut, U.S.", imdbId:"0024404", born:date('1978-02-20'), name:"Lauren Ambrose", bio:"Lauren Ambrose (born February 20, 1978) is an American film and television actress.  She is best known for playing Claire Fisher on the HBO funeral drama series Six Feet Under...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9SFLFPLj5eiFoULjM50yyuC9pSn.jpg", url:"https://themoviedb.org/person/54470"}}] AS row
