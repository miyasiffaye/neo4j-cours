UNWIND [{tmdbId:"20239", properties:{bornIn:"Lausanne, Vaud, Switzerland", imdbId:"0001641", born:date('1964-06-10'), name:"Vincent Perez", bio:"From Wikipedia, the free encyclopedia. \n\nBorn in Lausanne from a father of Spanish origin and a mother of German origin, Vincent Pérez (Vicente Pérez) spent a good part of his childhood in Penthaz and then in Cheseaux, Canton of Vaud.  After studying photography at the Center Doret in Vevey, he studied dramatic art in Geneva, then at the Conservatoire and the school of Amandiers de Nanterre. \n\nVincent Pérez in 1991, at the 16th César ceremony...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4YQooUljg7Nb4hyi4gHlE0gjKz1.jpg", url:"https://themoviedb.org/person/20239"}}, {tmdbId:"6804", properties:{bornIn:"Ohsweken, Ontario, Canada", imdbId:"0001295", born:date('1952-06-22'), name:"Graham Greene", bio:"Graham Greene was born on June 22, 1952 in Six Nations Reserve, Ontario, Canada.  He is known for his work on The Green Mile (1999), Wind River (2017) and Dances with Wolves (1990).  He has been married to Hilary Blackmore since December 20, 1990...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6uH0WVUzfMvMIOEmgaBdhry4iRx.jpg", url:"https://themoviedb.org/person/6804"}}, {tmdbId:"7853", properties:{bornIn:"Nebraska, USA", imdbId:"0002110", born:date('1959-03-09'), name:"Rodney A. Grant", bio:"From Wikipedia, the free encyclopedia. \n\nRodney Arnold Grant (born March 9, 1959) is an American actor. \n\nGrant, a Native American, was raised on the Omaha Reservation in Macy, Nebraska.  He is probably most well known for his role as \"Wind In His Hair\" in the 1990 film Dances with Wolves...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l4FiVA1ddPI8SohmB01UP9avexw.jpg", url:"https://themoviedb.org/person/7853"}}, {tmdbId:"27753", properties:{bornIn:"Kilwinning, Ayrshire, Scotland, UK", imdbId:"0295506", born:date('1952-09-25'), name:"Colin Friels", bio:"​From Wikipedia, the free encyclopedia.   \n\nColin Friels (born 25 September 1952) is a Scottish-born Australian actor. \n\nDescription above from the Wikipedia article Colin Friels, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ogsOD5j7sdc3fG2N3A75z3ePe2v.jpg", url:"https://themoviedb.org/person/27753"}}, {tmdbId:"16476", properties:{bornIn:"Tulsa, Oklahoma, USA", imdbId:"0236952", born:date('1950-02-21'), name:"Larry Drake", bio:"Larry Richard Drake (February 21, 1950 – March 17, 2016) was an American actor.  The son of Lorraine, a homemaker, and Raymond Drake, a drafting engineer for an oil company.  Drake is renowned for his portrayal of developmentally disabled Benny Stulwicz on the television show L. A.  Law from 1987 until the show's end in 1994, for which he won two consecutive Emmy Awards (1988, 1989).  He returned to the part of Benny in L. A.  Law: The Movie, a \"reunion\" movie aired on NBC in 2002...", died:date('2016-03-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/VkS3sb0gpLEY0AW7M92RO0m60b.jpg", url:"https://themoviedb.org/person/16476"}}, {tmdbId:"13389", properties:{imdbId:"0001432", born:date('1978-07-20'), name:"Charlie Korsmo", bio:"From Wikipedia, the free encyclopedia.   Charles Randolph \"Charlie\" Korsmo (born July 20, 1978) is an American former child actor turned lawyer and political activist. \n\nKorsmo was born in Fargo, North Dakota, the son of Deborah Ruf, an educational psychologist, and John Korsmo, a hospital administrator and chairman of the Federal Housing Finance Board.   He was raised in Minneapolis, Minnesota, where he attended and graduated from Breck School...", url:"https://themoviedb.org/person/13389"}}, {tmdbId:"45105", properties:{imdbId:"0640812", name:"Michael Donovan O'Donnell", url:"https://themoviedb.org/person/45105"}}, {tmdbId:"1025090", properties:{imdbId:"0929197", name:"Jim Wilkey", url:"https://themoviedb.org/person/1025090"}}, {tmdbId:"67693", properties:{imdbId:"0407453", name:"Shôko Ikeda", url:"https://themoviedb.org/person/67693"}}, {tmdbId:"13021", properties:{bornIn:"Massapequa, New York, U.S", imdbId:"0000287", born:date('1963-02-21'), name:"William Baldwin", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eGCByefnhrz6lU5IIb3OOEwjb7k.jpg", url:"https://themoviedb.org/person/13021"}}, {tmdbId:"167080", properties:{bornIn:"New York, New York", imdbId:"0521033", born:date('1964-05-22'), name:"James Lorinz", bio:"From Wikipedia, the free encyclopedia. \n\nJames Lorinz (born May 22, 1964) is an American writer/director/actor whose most famous roles include Street Trash, Frankenhooker and The Jerky Boys.  He has also had smaller parts in Last Exit to Brooklyn, Robocop 3 and King of New York. \n\nLorinz was born in Flushing, Queens, close to Shea Stadium and the 1968 World's Fair Grounds...", url:"https://themoviedb.org/person/167080"}}, {tmdbId:"1039536", properties:{imdbId:"0728582", name:"Joanne Ritchie", url:"https://themoviedb.org/person/1039536"}}, {tmdbId:"935902", properties:{imdbId:"0612038", name:"Patty Mullen", url:"https://themoviedb.org/person/935902"}}, {tmdbId:"1039537", properties:{imdbId:"0164024", name:"J.J. Clark", url:"https://themoviedb.org/person/1039537"}}, {tmdbId:"65397", properties:{bornIn:"Brooklyn, New York City, New York, USA", imdbId:"0751274", born:date('1964-12-29'), name:"Kimberly Russell", url:"https://themoviedb.org/person/65397"}}, {tmdbId:"65398", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"0629370", born:date('1944-07-12'), name:"Denise Nicholas", bio:"From Wikipedia, the free encyclopedia\n\nDenise Nicholas (born Donna Denise Nicholas; July 12, 1944) is an American actress and social activist who was involved in the American Civil Rights Movement.  She is known primarily for her role as high school guidance counselor Liz McIntyre on the ABC comedy-drama series Room 222, and for her role as Councilwoman Harriet DeLong on the NBC/CBS drama series In the Heat of the Night...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iLVYN8DuUFqF6s6cYWO8Zu4B8YT.jpg", url:"https://themoviedb.org/person/65398"}}, {tmdbId:"86474", properties:{imdbId:"0937824", name:"Kelly Wolf", url:"https://themoviedb.org/person/86474"}}, {tmdbId:"36218", properties:{bornIn:"San Tome, Venezuela", imdbId:"0228678", born:date('1955-07-02'), name:"Andrew Divoff", bio:"Andrew Daniel Divoff (born July 2, 1955) is a Venezuelan film and television actor, best known for playing the evil Djinn in the two first Wishmaster films and the villains Cherry Ganz in Another 48 Hrs. , Ivan Sarnoff in CSI: Miami and Mikhail Bakunin in Lost. \n\nDescription above from the Wikipedia article Andrew Divoff, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jGCanIWdfYsADeoVt4v4M4DkwE5.jpg", url:"https://themoviedb.org/person/36218"}}, {tmdbId:"10739", properties:{bornIn:"Princeton, New Jersey, USA", imdbId:"0001564", born:date('1958-12-31'), name:"Bebe Neuwirth", bio:"Beatrice \"Bebe\" Neuwirth (born December 31, 1958) is an American actress, singer and dancer.  She has worked in television and is known for her portrayal of Dr.  Lilith Sternin, Dr.  Frasier Crane's wife (later ex-wife), on both the TV sitcom Cheers (in a starring role), and its spin-off Frasier (in a recurring guest role).  On stage, she is also known for originating the role of Velma Kelly in the revival of Chicago and for the role of Morticia Addams in The Addams Family musical...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/u1UYoquzWCTfPs2NHdrHe7UEpLr.jpg", url:"https://themoviedb.org/person/10739"}}, {tmdbId:"17179", properties:{bornIn:"Chicago - Illinois - USA", imdbId:"0248981", born:date('1958-09-12'), name:"Gregg Edelman", bio:"From Wikipedia, the free encyclopedia. \n\nGregg Edelman (born September 12, 1958) is an American movie, television and theatre actor. \n\nEdelman was born in Chicago, Illinois and was trained at Northwestern University (Evanston, Illinois).  He is married to actress Carolee Carmello, with whom he has a daughter Zoe age 14, and son Ethan and resides with his family in Leonia, New Jersey...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jvdye1mZkBb5x4xjjtmtuLRmXzy.jpg", url:"https://themoviedb.org/person/17179"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"109762", properties:{imdbId:"0613197", born:date('1952-06-24'), name:"Jan Munroe", url:"https://themoviedb.org/person/109762"}}, {tmdbId:"36820", properties:{bornIn:"Kuala Lumpur, Malaya [now Malaysia]", imdbId:"0780485", born:date('1957-07-04'), name:"Jenny Seagrove", bio:"From Wikipedia, the free encyclopedia\n\nJennifer Ann Seagrove (born 4 July 1957) is an English actress.  She trained at the Bristol Old Vic Theatre School and rose to fame playing the lead in a TV dramatisation of Barbara Taylor Bradford's A Woman of Substance and the 1983 film Local Hero.  She is now well known in the character of Jo Mills in the long-running BBC drama series Judge John Deed (2001–07).  Her credits as a voiceover artist include a series of Waitrose television advertisements...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ihbxiN3aWehDcF5RZB3gGVsiTjN.jpg", url:"https://themoviedb.org/person/36820"}}, {tmdbId:"23974", properties:{bornIn:"Norton, Ohio, USA", imdbId:"0113474", born:date('1959-01-30'), name:"Dwier Brown", bio:"From Wikipedia, the free encyclopedia\n\nDwier Brown (30 January 1959 in Norton, Ohio, USA), is an American film and television actor.  He is appeared in a few horror films, of which \"House\" and \"The Guardian\" realised by The Exorcist's director William Friedkin, and appeared for several T. V. , films and series. \n\nDescription above from the Wikipedia article Dwier Brown, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/23974"}}, {tmdbId:"70743", properties:{bornIn:"Santa Barbara, USA", imdbId:"0355357", born:date('1958-03-21'), name:"Brad Hall", bio:"From Wikipedia, the free encyclopedia\n\nWilliam Brad Hall (born March 21, 1958, Santa Barbara, California) is an American writer and actor, best known as a Saturday Night Live news anchor on Saturday Night News.  He was also the creator of the TV series The Single Guy and Watching Ellie.  He has appeared in various motion pictures, most notably the 1986 cult classic Troll and as Nancy Allen's boyfriend in 1990's Limit Up...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lh1iZA0lR5UpZAhaUaAIMswrIQg.jpg", url:"https://themoviedb.org/person/70743"}}, {tmdbId:"21708", properties:{bornIn:"Havana, Cuba", imdbId:"0587401", born:date('1932-03-03'), name:"Tomas Milian", bio:"From Wikipedia, the free encyclopedia. \n\nTomás Milián (3 March 1933 – 22 March 2017) was a Cuban-American actor best known for having worked extensively in Italian films from the late 1950s to the 1980s. \n\nDescription above from the Wikipedia article Tomás Milián, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2017-03-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kVLofZfWggH8H3h9OyBpyjZtvyq.jpg", url:"https://themoviedb.org/person/21708"}}, {tmdbId:"42156", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0608853", born:date('1938-12-18'), name:"Roger E. Mosley", bio:"​From Wikipedia, the free encyclopedia.   \n\nRoger Earl Mosley (born December 18, 1938) is an American actor best known for his role as the helicopter pilot Theodore \"T. C. \" Calvin on the long running television series, Magnum, P. I. , which starred Tom Selleck as the title character. \n\nDescription above from the Wikipedia article Roger Earl Mosley,  licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dAQA1V6JeuvgFLpIVOFZhysbRSR.jpg", url:"https://themoviedb.org/person/42156"}}, {tmdbId:"2319", properties:{bornIn:"Lisbon, Portugal", imdbId:"0210218", born:date('1965-08-19'), name:"Maria de Medeiros", bio:"Maria de Medeiros Esteves Vitorino de Almeida (born August 19, 1965), better known as Maria de Medeiros, is a Portuguese actress, director, and singer who has been involved in both European and American film productions...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xDo5mRSKXUZRmcZjUn42ICiyyI8.jpg", url:"https://themoviedb.org/person/2319"}}, {tmdbId:"67161", properties:{imdbId:"0218186", name:"Mary Demas", url:"https://themoviedb.org/person/67161"}}, {tmdbId:"67162", properties:{imdbId:"0058997", name:"Anne Bartoletti", url:"https://themoviedb.org/person/67162"}}, {tmdbId:"67172", properties:{imdbId:"0434306", name:"Elizabeth Kaden", url:"https://themoviedb.org/person/67172"}}, {tmdbId:"56531", properties:{bornIn:"Peine, Germany", imdbId:"0673251", born:date('1925-04-21'), name:"Solomon Perel", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jzS2umMVOZ73IFEH6X0M7Os02Ji.jpg", url:"https://themoviedb.org/person/56531"}}, {tmdbId:"23797", properties:{bornIn:"Berlin, Germany", imdbId:"0389424", born:date('1969-10-18'), name:"Marco Hofschneider", bio:"From Wikipedia, the free encyclopedia. \n\nMarco Hofschneider (born Oct 18, 1969) is a German actor known for his biographical portrayal of Solomon Perel in the 1990 acclaimed (Golden Globe-winning and Academy Award-nominated) World War II film Europa Europa.  (Note that Europa Europa is known as Hitlerjunge Salomon to most European audiences. ) Since then, he has appeared in many German and British film and television programs. \n\nHofschneider was born in Berlin, Germany...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8lsRPmvqkM1Qy5gf6713EYvC7GO.jpg", url:"https://themoviedb.org/person/23797"}}, {tmdbId:"28656", properties:{bornIn:"Detmold", imdbId:"0389425", born:date('1960-01-01'), name:"René Hofschneider", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/r44H8COOEGrqIwbwmBVI7PM6yk5.jpg", url:"https://themoviedb.org/person/28656"}}, {tmdbId:"56529", properties:{imdbId:"0468965", name:"Piotr Kozlowski", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wq0qW5Ncsmt2lOJnlXzO4147rUL.jpg", url:"https://themoviedb.org/person/56529"}}, {tmdbId:"79320", properties:{bornIn:"Brooklyn, New York City, New York, USA", imdbId:"0717212", born:date('1964-04-05'), name:"Christopher Reid", bio:"From Wikipedia, the free encyclopedia.   \n\nChristopher Reid (born April 5, 1964), formerly known as Kid (shortened from his original MC name, Kid Coolout), is an American actor, comedian, and former rapper. \n\nDescription above from the Wikipedia article Christopher Reid (entertainer), licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/79320"}}, {tmdbId:"15535", properties:{bornIn:"Chicago", imdbId:"0365264", born:date('1953-08-30'), name:"Robin Harris", died:date('1990-03-18'), url:"https://themoviedb.org/person/15535"}}, {tmdbId:"79321", properties:{imdbId:"0552086", born:date('1962-07-10'), name:"Christopher Martin", bio:"​From Wikipedia, the free encyclopedia.   \n\nChristopher \"Play\" Martin (born July 10, 1962) is an American rapper and actor, formerly the latter half of the late 1980s/early 1990s hip-hop/comedy duo Kid 'n Play. \n\nDescription above from the Wikipedia article Christopher Martin (entertainer), licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/79321"}}, {tmdbId:"12133", properties:{bornIn:"Carbondale, Illinois, USA", imdbId:"0582418", born:date('1955-06-16'), name:"Laurie Metcalf", bio:"Laurie Metcalf is an American stage, film and television actress, best known for playing Jackie Harris, the title character's sister on the television sitcom \"Roseanne\", as well as for voicing Ms.  Davis in the \"Toy Story\" animation movie franchise.  She's a three-time Emmy award winner and was nominated for three Golden Globe awards, a Tony Award, and a Screen Actors Guild Award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/paZsjbxC1yOw9U3zrrkzcElyaV3.jpg", url:"https://themoviedb.org/person/12133"}}, {tmdbId:"13525", properties:{bornIn:"Port Colborne, Ontario, Canada", imdbId:"0002023", born:date('1956-11-10'), name:"Matt Craven", bio:"Matt Craven (born November 10, 1956) is a Canadian actor. \n\nCraven was born Matthew John Crnkovich in Port Colborne, Ontario, the son of Joanne Leslie, a hairdresser, and Nick Crnkovich.  He has an older sister, Deborah.  Craven is married to Sally Craven née Sutton and has two children, Nicholas and Josephine...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AboGkEDZnV4SJvqXdEXNL6qoZLn.jpg", url:"https://themoviedb.org/person/13525"}}, {tmdbId:"552474", properties:{imdbId:"0159058", name:"Ma Chong", url:"https://themoviedb.org/person/552474"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"552475", properties:{imdbId:"0174600", name:"Zhijun Cong", url:"https://themoviedb.org/person/552475"}}, {tmdbId:"552476", properties:{imdbId:"0264393", name:"Wu Fa", url:"https://themoviedb.org/person/552476"}}, {tmdbId:"22169", properties:{bornIn:"Liverpool, England, UK", imdbId:"0068552", born:date('1933-08-02'), name:"Tom Bell", bio:"Tom Bell was a British stage, film and television actor...", died:date('2006-10-04'), url:"https://themoviedb.org/person/22169"}}, {tmdbId:"7042", properties:{bornIn:"Islington, London, England, UK", imdbId:"0447290", born:date('1959-10-16'), name:"Gary Kemp", bio:"Gary Kemp was born in Islington, London in October 1959.  On his 10th birthday, he got his first guitar from his parents.  In the 70s, he and his younger brother, Martin Kemp, went to learn drama at Anna Scher's acting school.  Then, in 1978, Gary Kemp formed \"The Makers\".  After Richard Miller left, his brother replaced him on bass.  That's when Gary changed the name to Spandau Ballet.  Spandau's break came in March 1980 when they were filmed for a documentary on ITV...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jOxSHoR0GEbPvZ9gNGukyK2IKFG.jpg", url:"https://themoviedb.org/person/7042"}}, {tmdbId:"47652", properties:{bornIn:"Islington, London, England", imdbId:"0447337", born:date('1961-10-10'), name:"Martin Kemp", bio:"Martin John Kemp (born 10 October 1961) is an English actor, musician, and occasional television presenter, best known as the bassist in the New Romantic band Spandau Ballet, as well as Steve Owen from the BBC soap opera EastEnders.  He is the brother of Gary Kemp. \n\nDescription above from the Wikipedia article Martin Kemp (entertainer), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cex68RbEL5FW6VbcL1e52shUF1p.jpg", url:"https://themoviedb.org/person/47652"}}, {tmdbId:"151363", properties:{bornIn:"Berkeley, California, USA", imdbId:"0388082", born:date('1966-01-02'), name:"Kate Hodge", bio:"Kate Hodge  is an actress and producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/y6gFNTm0g8QurrvG7luCew1Ne2o.jpg", url:"https://themoviedb.org/person/151363"}}, {tmdbId:"99600", properties:{bornIn:"Townville, Pennsylvania, United States", imdbId:"0586133", name:"R.A. Mihailoff", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8F1iz1pP9pltoIaSD1YiU884Kgk.jpg", url:"https://themoviedb.org/person/99600"}}, {tmdbId:"81460", properties:{imdbId:"0124834", born:date('1968-01-01'), name:"William Butler", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/99BRb32NfOjdOh82JYEKq8tbKQD.jpg", url:"https://themoviedb.org/person/81460"}}, {tmdbId:"388", properties:{bornIn:"Lincoln, Lincolnshire, England, UK", imdbId:"0000980", born:date('1949-05-24'), name:"Jim Broadbent", bio:"One of England's most versatile character actors, Jim Broadbent was born on May 24, 1949, in Lincolnshire, the youngest son of furniture maker Roy Broadbent and sculptress Dee Broadbent.  Jim attended a Quaker boarding school in Reading before successfully applying for a place at an art school.  His heart was in acting, though, and he would later transfer to the London Academy of Music and Dramatic Art (LAMDA)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2aiaMmDXEbzSkevEI3iVKLuWeCt.jpg", url:"https://themoviedb.org/person/388"}}, {tmdbId:"42641", properties:{bornIn:"Hemel Hempstead, Hertfordshire, England, UK", imdbId:"0804218", born:date('1965-01-01'), name:"Claire Skinner", bio:"Claire Skinner is a British stage, film and television actress, best known for her role as the hapless mother Sue Brockman in the BBC sitcom \"Outnumbered\".  Her film work includes the Mike Leigh productions \"Life Is Sweet\" and \"Naked\", \"Bridget Jones's Diary\" and \"Sleepy Hollow\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/odJEMUo4utv11ylHLmrOgbhUQHZ.jpg", url:"https://themoviedb.org/person/42641"}}, {tmdbId:"10182", properties:{bornIn:"New York City, New York, USA", imdbId:"0000609", born:date('1959-05-12'), name:"Ving Rhames", bio:"An American actor best known for his work in Bringing Out the Dead, Pulp Fiction, Baby Boy, Don King: Only in America, and the Mission: Impossible film series.  Rhames was born in New York City, New York, he entered New York's School of Performing Arts, where he discovered his love of acting.  After high school, he studied drama at SUNY Purchase where he met fellow actor Stanley Tucci, who gave him his nickname \"Ving\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4gpLVNKPZlVucc4fT2fSZ7DksTK.jpg", url:"https://themoviedb.org/person/10182"}}, {tmdbId:"117358", properties:{bornIn:"Los Angeles - California - USA", imdbId:"0144233", born:date('1962-01-04'), name:"Patrick Cassidy", bio:"From Wikipedia, the free encyclopedia\n\nPatrick Cassidy (born January 4, 1962, in Los Angeles, California) is an American actor best known for his roles in musical theatre and television...", url:"https://themoviedb.org/person/117358"}}, {tmdbId:"123557", properties:{bornIn:"Louisville, Kentucky, USA", imdbId:"0234440", born:date('1958-04-15'), name:"John Dossett", bio:"From Wikipedia, the free encyclopedia\n\nJohn Dossett is an American actor and singer. \n\nDossett's interest in a theatrical career began at Mount Pleasant High School in Wilmington, Delaware, where he appeared in student productions and was involved with the school's radio station, WMPH. \n\nDossett made his Broadway debut in 1979 in a short-lived musical entitled the King of Schnorrers...", url:"https://themoviedb.org/person/123557"}}, {tmdbId:"18248", properties:{bornIn:"Fort Jackson, South Carolina, USA", imdbId:"0000571", born:date('1964-08-02'), name:"Mary-Louise Parker", bio:"Mary-Louise Parker (born August 2, 1964) is an American actress and writer.  She has won two Golden Globe Awards, a Primetime Emmy Award and a Tony Award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ljaNmBF31BbOvrrawms7vCsIqBP.jpg", url:"https://themoviedb.org/person/18248"}}, {tmdbId:"13550", properties:{bornIn:"Montreal, Quebec, Canada", imdbId:"0000480", born:date('1961-03-11'), name:"Elias Koteas", bio:"Elias Koteas (born March 11, 1961) is a Canadian actor of film and television, best known for his roles in The Prophecy, Fallen, and the live-action Teenage Mutant Ninja Turtles movies...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7CJ9cW0YCnFjFUo0BRpgE5KcHLV.jpg", url:"https://themoviedb.org/person/13550"}}, {tmdbId:"9296", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0001267", born:date('1975-01-22'), name:"Balthazar Getty", bio:"​From Wikipedia, the free encyclopedia. \n\nBalthazar Getty (born January 22, 1975) is an American film actor and member of the band Ringside.  His great grandfather was Jean Paul Getty, his grandfather Sir Paul Getty, and his father John Paul Getty III.  The Getty family's fortune is based on the oil business. \n\nHe is best known for the roles of Thomas Grace on the American action drama Alias and Tommy Walker on the ABC drama Brothers &amp; Sisters...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rtItbRp9ukaiOJ6KPtlHs3Qa24C.jpg", url:"https://themoviedb.org/person/9296"}}, {tmdbId:"61029", properties:{bornIn:"San Marcos, Texas, USA", imdbId:"0299077", born:date('1974-12-18'), name:"Chris Furrh", bio:"​From Wikipedia, the free encyclopedia. \n\nChris Furrh  (born 18 December 1974) is an American actor, most famous for starring as Jack in the 1990 film adaptation of Lord of the Flies.  After Lord of the Flies, he played the role of Nick Bankston in the 1990 telefilm A Family for Joe and, like in Lord of the Flies, a castaway teenager in Exile...", url:"https://themoviedb.org/person/61029"}}, {tmdbId:"61030", properties:{bornIn:"Los Angeles County, California, USA", imdbId:"0684999", born:date('1978-03-11'), name:"Danuel Pipoly", bio:"​From Wikipedia, the free encyclopedia. \n\nDanuel Pipoly  (born 11 March 1978) is an American actor, most famous for starring as Piggy in the 1990 film adaptation of Lord of the Flies.  He received 2 award nominations as a result of \"Lord of the Flies\", including one for best young supporting actor...", url:"https://themoviedb.org/person/61030"}}, {tmdbId:"18473", properties:{bornIn:" New York City, New York, USA", imdbId:"0197647", born:date('1978-05-01'), name:"James Badge Dale", bio:"James Badge Dale  (born May 1, 1978) is an American actor who starred in the AMC drama series Rubicon.  He is most famous for his role of Chase Edmunds in the third season of 24 and Robert Leckie in the HBO miniseries The Pacific...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xODHrgxKPNWYATKgZWQJLNhImlZ.jpg", url:"https://themoviedb.org/person/18473"}}, {tmdbId:"16754", properties:{imdbId:"0908534", name:"Basil Wallace", url:"https://themoviedb.org/person/16754"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"55270", properties:{bornIn:"Englewood - New Jersey - USA", imdbId:"0942875", born:date('1952-11-29'), name:"Tom Wright", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lJ4L5fdXBeNr528gBB4eMTdvfd4.jpg", url:"https://themoviedb.org/person/55270"}}, {tmdbId:"3229", properties:{bornIn:"Independence, Missouri, USA", imdbId:"0397124", born:date('1954-10-18'), name:"Arliss Howard", bio:"Arliss Howard (born Leslie Richard Howard; October 18, 1954) is an American actor, writer and film director. \n\nDescription above from the Wikipedia article Arliss Howard, licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zDBEVA7Skrje3A8bmR2VOJRwkZc.jpg", url:"https://themoviedb.org/person/3229"}}, {tmdbId:"5577", properties:{bornIn:"Winnetka, Illinois, USA", imdbId:"0000563", born:date('1970-06-26'), name:"Chris O'Donnell", bio:"Chris O' Donnell was born on June 26th, 1970.  He is the youngest child in his family with four sisters and two brothers.  He first started modeling at the age of thirteen and continued until the age of sixteen, when he appeared in commercials.  When he was seventeen, he was preparing to stop acting and modeling, but was asked to audition for what would be his first film, Men Don't Leave (1990)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/KvWBFg1aMBdu4X2PihXYL8xcFD.jpg", url:"https://themoviedb.org/person/5577"}}, {tmdbId:"1033159", properties:{bornIn:"Bayside, New York, USA", imdbId:"0267449", name:"Carolyn Farina", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pw05DL4jGc4BtXXZVGGbIc04QY9.jpg", url:"https://themoviedb.org/person/1033159"}}, {tmdbId:"78189", properties:{imdbId:"0166221", name:"Edward Clements", url:"https://themoviedb.org/person/78189"}}, {tmdbId:"78190", properties:{bornIn:"Denver, Colorado, USA", imdbId:"0001177", born:date('1965-03-01'), name:"Chris Eigeman", bio:"From Wikipedia, the free encyclopedia\n\nChris Eigeman (born March 1, 1965, in Denver, Colorado) is an American actor best known for roles in the Whit Stillman films Metropolitan, Barcelona, and The Last Days of Disco.  He usually plays quick-witted, articulate characters, who speak with a healthy dose of sarcasm. \n\nEigeman also appeared in the films Kicking and Screaming, Crazy Little Thing (aka The Perfect You), Mr...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tXzouEBdfTQE3tUYZhfG5NDlJG3.jpg", url:"https://themoviedb.org/person/78190"}}, {tmdbId:"4944", properties:{bornIn:"Louisville - Kentucky - USA", imdbId:"0629737", born:date('1959-03-03'), name:"Taylor Nichols", bio:"From Wikipedia, the free encyclopedia\n\nCecil Taylor Nichols (born March 3, 1959 in Lansing, Michigan) is an American actor best known for roles in the Whit Stillman films Metropolitan, Barcelona, and The Last Days of Disco.  His characters in these films were insecure, stuttering sidekicks to those of the more outgoing Chris Eigeman.  Nichols and Eigeman also played minor roles in the independent film The Next Step, released in 1997, of which Nichols was an associate producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2VnYWsBXx19tNvBX1diwfjdLkjU.jpg", url:"https://themoviedb.org/person/4944"}}, {tmdbId:"129330", properties:{imdbId:"0702409", name:"Cecilia Pérez-Cervera", url:"https://themoviedb.org/person/129330"}}, {tmdbId:"93665", properties:{imdbId:"0186460", name:"Georgie Cranford", url:"https://themoviedb.org/person/93665"}}, {tmdbId:"16297", properties:{imdbId:"0768324", name:"Edward Saxon", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AdlBT3K169zQiZygXv0dkJmzczO.jpg", url:"https://themoviedb.org/person/16297"}}, {tmdbId:"4726", properties:{bornIn:"La Jolla, California, USA", imdbId:"0001315", born:date('1959-08-14'), name:"Marcia Gay Harden", bio:"Marcia Gay Harden (born August 14, 1959) is an American film and theatre actress.  Harden's breakthrough role was in The First Wives Club (1996) which was followed by several roles which gained her wider fame including the hit comedy Flubber (1997) and Meet Joe Black (1998).  She received an Academy Award for Best Supporting Actress for her role as Lee Krasner in Pollock (2000)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vGUq4MMXQxhWerX6OUV0lWjfnF.jpg", url:"https://themoviedb.org/person/4726"}}, {tmdbId:"4253", properties:{bornIn:"Philadelphia - Pennsylvania - USA", imdbId:"0689237", born:date('1950-12-29'), name:"Jon Polito", bio:"From Wikipedia, the free encyclopedia. \n\nJon Polito (born December 29, 1950) is an American actor, known for working with the Coen Brothers, most notably in the major supporting role of Italian gangster Johnny Caspar in Miller's Crossing.  He also appeared in the first two seasons of Homicide: Life on the Street and on the first season of Crime Story.  Polito won the Maverick Spirit Event Award at Cinequest Film Festival in 2005...", died:date('2016-09-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p1ftSRdhpdiyRUEgUPTVx6SYfXL.jpg", url:"https://themoviedb.org/person/4253"}}, {tmdbId:"8534", properties:{bornIn:"Memphis, Tennessee, USA", imdbId:"0000870", born:date('1948-06-28'), name:"Kathy Bates", bio:"An American actress and director.  After several small roles in film and television, Bates rose to prominence with her performance in Misery (1990), for which she won both the Academy Award for Best Actress and a Golden Globe.  She followed this with major roles in Fried Green Tomatoes (1991) and Dolores Claiborne (1995), before playing a featured role as Margaret \"Molly\" Brown in Titanic (1997).  During this time she began her directing career, primarily in television...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qZRTzTjV4OC1Ii9a0n8QBS9zMOd.jpg", url:"https://themoviedb.org/person/8534"}}, {tmdbId:"10814", properties:{bornIn:"Orlando, Florida, USA", imdbId:"0000648", born:date('1962-07-31'), name:"Wesley Snipes", bio:"Wesley Trent Snipes (born July 31, 1962) is an American actor, film producer, and martial artist.  He has starred in numerous action-adventures, thrillers, and dramatic feature films and is well-known for his role as Blade in the Blade trilogy.  Snipes formed a production company titled Amen-Ra Films in 1991 and a subsidiary, Black Dot Media, to develop projects for film and television...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uBhM3TshYvRhOewXAimtxci9bQo.jpg", url:"https://themoviedb.org/person/10814"}}, {tmdbId:"116299", properties:{imdbId:"0565619", name:"Saundra McClain", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/u5wm7uMI0dbmde9pPo1jpAuLIE4.jpg", url:"https://themoviedb.org/person/116299"}}, {tmdbId:"167090", properties:{name:"Margaret Welsh", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yGHgZFMlzjdHFyaAEl9ej0iwHa8.jpg", url:"https://themoviedb.org/person/167090"}}, {tmdbId:"15417", properties:{bornIn:"Plymouth, Devon, England, UK", imdbId:"0595567", born:date('1930-12-26'), name:"Donald Moffat", bio:"Was an English actor with decades long career in film and stage in the United States.  He began his acting career on and off Broadway which included appearances in The Wild Duck and Right You Are If You Think You Are, earning a Tony Award nomination for both, as well as Painting Churches for which he received an Obie Award.  Moffat also appeared in several feature films including The Thing and The Right Stuff, along with his guest appearances in the television series Dr...", died:date('2018-12-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8kZ2Ow3cPtTmDwTxL7jFEsQi4ia.jpg", url:"https://themoviedb.org/person/15417"}}, {tmdbId:"27773", properties:{bornIn:"Danbury - Connecticut - USA", imdbId:"0000970", born:date('1976-04-13'), name:"Jonathan Brandis", bio:"Jonathan Gregory Brandis was an American actor, director, and screenwriter.  Beginning his career as a child model, Brandis moved on to acting in commercials and subsequently won television and film roles.  At the age of 17, he landed the role of Lucas Wolenczak, a teen prodigy on the NBC series seaQuest DSV.  The character was popular among teenage female viewers, and Brandis regularly appeared in teen magazines...", died:date('2003-11-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2lTues801W2Ms0dZinJzTFrOpdl.jpg", url:"https://themoviedb.org/person/27773"}}, {tmdbId:"112731", properties:{imdbId:"0607213", born:date('1974-12-31'), name:"Kenny Morrison", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xr6UwL1daWK7RT2h6qq6J3aOpjc.jpg", url:"https://themoviedb.org/person/112731"}}, {tmdbId:"149409", properties:{bornIn:"Philadelphia, Pennsylvania", imdbId:"0123418", born:date('1959-04-25'), name:"Clarissa Burt", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3tAjWKihek9QxfNcGKSA8GNFjOP.jpg", url:"https://themoviedb.org/person/149409"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"124546", properties:{bornIn:"Norfolk, Virginia, USA", imdbId:"0794128", born:date('1955-01-22'), name:"John Wesley Shipp", bio:"John Wesley Shipp (born January 22, 1955) is an American actor known for his various television roles.  He played the lead Barry Allen on CBS's superhero series The Flash from 1990 to 1991, and Mitch Leery, the title character's father, on the drama series Dawson's Creek from 1998 to 2001...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pL60jl0QdKx9oESZqRzA3kiXXbs.jpg", url:"https://themoviedb.org/person/124546"}}, {tmdbId:"19384", properties:{bornIn:"Washington, District of Columbia, USA", imdbId:"0865302", born:date('1954-12-04'), name:"Tony Todd", bio:"An American actor and producer, known for his height (6'5\", 1. 96 m) and deep voice.  He is well known for playing the Candyman in the horror movie franchise of the same name, William Bludworth in Final Destination and for guest starring roles on numerous television shows. \n\nDescription above from the Wikipedia article Tony Todd, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Tl2wuhRon93SkcAj1jyC52bQaG.jpg", url:"https://themoviedb.org/person/19384"}}, {tmdbId:"11768", properties:{bornIn:"Pontiac, Illinois USA", imdbId:"0848191", born:date('1957-09-04'), name:"Patricia Tallman", bio:"From Wikipedia, the free encyclopedia.   Patricia J.  Tallman (born September 4, 1957) is an American actress and stunt performer, sometimes credited as Pat Tallman. \n\nDescription above from the Wikipedia article  Patricia Tallman, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1GWLkSHqrADSrZv5jdqtn0ZNs9r.jpg", url:"https://themoviedb.org/person/11768"}}, {tmdbId:"27736", properties:{bornIn:"Chicago, Illinois, U.S.", imdbId:"0869981", born:date('1950-03-20'), name:"Tom Towles", bio:"From Wikipedia, the free encyclopedia.  Tom Towles (March 20, 1950 – April 2, 2015) was an American actor. \n\nTowles was born and raised in Chicago.  He became an actor after a stint in the U. S.  Marines, beginning with an uncredited performance in Dog Day Afternoon (1975).  He has appeared in film and television extensively since the 1980s...", died:date('2015-04-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6F9I5197hexHVB1bGN7kGTBUQed.jpg", url:"https://themoviedb.org/person/27736"}}, {tmdbId:"90653", properties:{imdbId:"0027174", name:"McKee Anderson", url:"https://themoviedb.org/person/90653"}}, {tmdbId:"140234", properties:{bornIn:"Paterson, New Jersey, USA", imdbId:"0090321", born:date('1967-12-12'), name:"Anne Bobby", url:"https://themoviedb.org/person/140234"}}, {tmdbId:"57298", properties:{bornIn:"Paris, France", imdbId:"0001594", born:date('1960-05-06'), name:"Anne Parillaud", bio:"A French actress, who has appeared in 30 films since 1977.  She is best known internationally for her role as Nikita in the movie of the same name...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xTIfxPTpBWyFJmbf1hGn0W3KT7l.jpg", url:"https://themoviedb.org/person/57298"}}, {tmdbId:"2170", properties:{bornIn:"Nice, Alpes-Maritimes, France", imdbId:"0244019", born:date('1957-09-28'), name:"Marc Duret", bio:"Marc Duret (born 28 September 1957 in Nice, Alpes-Maritimes, France) is a French actor. \n\nHaving previously played Cardinal Guillaume Briçonnet in the television series Borgia from 2011–14, Duret appeared as Joseph Duverney in the Starz series Outlander in 2016...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jOLK1qN6z3P1dnxYPrYxe0OV0CE.jpg", url:"https://themoviedb.org/person/2170"}}, {tmdbId:"57299", properties:{imdbId:"0284938", name:"Patrick Fontana", url:"https://themoviedb.org/person/57299"}}, {tmdbId:"57300", properties:{imdbId:"1016405", name:"Alain Lathière", url:"https://themoviedb.org/person/57300"}}, {tmdbId:"26071", properties:{bornIn:"Wandsworth, London", imdbId:"0168554", born:date('1965-10-08'), name:"Camille Coduri", bio:"​From Wikipedia, the free encyclopedia\n\nCamille Coduri (born 8 October 1965 in Wandsworth, London) is an English actress.  She is best known for her role in Doctor Who as Jackie Tyler appearing in a number of episodes between 2005 and 2010. \n\nShe featured in the film comedies Nuns on the Run (1990) and King Ralph (1991)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vzzNfnKteOiuyXC1IxABapFrZaL.jpg", url:"https://themoviedb.org/person/26071"}}, {tmdbId:"2497474", properties:{name:"André Christian", url:"https://themoviedb.org/person/2497474"}}, {tmdbId:"107840", properties:{imdbId:"0179776", name:"Dorian Corey", url:"https://themoviedb.org/person/107840"}}, {tmdbId:"2497475", properties:{name:"Paris Duprée", url:"https://themoviedb.org/person/2497475"}}, {tmdbId:"2497492", properties:{name:"David The Father Xtravaganza", url:"https://themoviedb.org/person/2497492"}}, {tmdbId:"85286", properties:{bornIn:"Tochigi, Japan", imdbId:"0299192", born:date('1946-07-16'), name:"Toshio Furukawa", bio:"Toshio Furukawa (古川 登志夫, Furukawa Toshio, born July 16, 1946 in what is now part of the city of Tochigi) is a Japanese actor, voice actor and narrator affiliated with Aoni Production.  He became famous for his roles in his career as Kagege (Keroro Gunso), Kai Shiden (Mobile Suit Gundam), Shin (Fist of the North Star), Asuma Shinohara (Mobile Police Patlabor), Piccolo (Dragon Ball), Ataru Moroboshi (Urusei Yatsura) and Portgas D.  Ace (One Piece).  His debut voice role is a soldier in Brave Raideen...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n4xda3RzeEP6lt7Q0GHQR5qs3gJ.jpg", url:"https://themoviedb.org/person/85286"}}, {tmdbId:"94247", properties:{imdbId:"1063287", born:date('1971-02-21'), name:"Doug Erholtz", bio:"From Wikipedia, the free encyclopedia. \n\nDouglas J.  Erholtz (born February 21, 1971) is an American voice actor. \n\nDescription above from the Wikipedia article Doug Erholtz, licensed under CC-BY-SA, full list of contributors on Wikipedia ...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1cNxPEp0bNkwyzBqOe4WO09giNb.jpg", url:"https://themoviedb.org/person/94247"}}, {tmdbId:"623", properties:{imdbId:"0866697", born:date('1966-04-03'), name:"Mîna Tominaga", bio:"Yoshiko Tominaga, better known by her stage name Miina Tominaga, is a Japanese actress, voice actress and singer from Nishi-ku, Hiroshima.  She is currently attached to Tokyo Actor's Consumer's Cooperative Society...", url:"https://themoviedb.org/person/623"}}, {tmdbId:"1109", properties:{bornIn:"Pittsburgh, Pennsylvania, U.S.", imdbId:"0001310", born:date('1955-05-09'), name:"Kevin Peter Hall", bio:"​From Wikipedia, the free encyclopedia.   \n\nKevin Peter Hall (May 9, 1955 – April 10, 1991) was an American actor known for his roles in Misfits of Science, Prophecy, Without Warning, and Harry and the Hendersons.  He was also best known as the title character in the first two films in the Predator franchise. \n\nDescription above from the Wikipedia article Kevin Peter Hall, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1991-04-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bg8ohLqgj1v9XzY927PfYNAu9nk.jpg", url:"https://themoviedb.org/person/1109"}}, {tmdbId:"1206", properties:{bornIn:"Newark - New Jersey - USA", imdbId:"0004517", born:date('1959-09-23'), name:"Jason Alexander", bio:"Jay Scott Greenspan, better known by his professional name of Jason Alexander, is an American actor, writer, comedian, television director and producer, and singer.  He is best known for his role as George Costanza on the television series Seinfeld, appearing in the sitcom from 1989 to 1998.  He also has had an active career on the stage, appearing in several Broadway musicals including Jerome Robbins' Broadway in 1989, for which he won the Tony Award as Best Actor in a Musical...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5a34uLhhHqmeYII984EfaVBh70p.jpg", url:"https://themoviedb.org/person/1206"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"68209", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0646943", born:date('1981-10-10'), name:"Michael Oliver", bio:"​From Wikipedia, the free encyclopedia\n\nMichael Oliver (born October 10, 1981) is a former American child actor of the 1990s.  Oliver is best known for his role as \"Junior\" in two Problem Child movies. \n\nDescription above from the Wikipedia article Michael Oliver (actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/68209"}}, {tmdbId:"15832", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0331906", born:date('1955-02-28'), name:"Gilbert Gottfried", bio:"Gilbert Gottfried (born February 28, 1955) is an American actor, voice actor and stand-up comedian, best known for his trademark comedic persona of speaking in a loud, grating tone of voice.  He has played numerous roles in film and television, perhaps most notably voicing the parrot Iago in Disney's Aladdin (1992), and co-starred in the Problem Child movies.  He is also known for voicing Digit in the children's cartoon/educational math-based show Cyberchase and formerly the Aflac duck...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cu15UEyL3wnUtTAF5KfuyxxjVzH.jpg", url:"https://themoviedb.org/person/15832"}}, {tmdbId:"32289", properties:{bornIn:"USA", imdbId:"0738850", born:date('1941-06-15'), name:"Andy Romano", bio:"​From Wikipedia, the free encyclopedia.   \n\nAndy Romano is an American actor, known for playing \"J. D. \" in the 1960s Beach Party movies (which starred Annette Funicello and Frankie Avalon). \n\nWhen the Beach Party saga ended, Romano went through much of the 1970s and 80s appearing in minor roles in television episodes and some TV movies.  In the late 1980s, he returned to film in supporting roles...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/maQYk63vsymyolmJBHEsBmv3KxR.jpg", url:"https://themoviedb.org/person/32289"}}, {tmdbId:"48810", properties:{bornIn:"Steubenville - Ohio - USA", imdbId:"0667182", born:date('1950-02-13'), name:"Scott Paulin", bio:"Scott Paulin is an actor and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cGSy2R21wL02JzTbEQl4DxyMDNZ.jpg", url:"https://themoviedb.org/person/48810"}}, {tmdbId:"554043", properties:{imdbId:"0533837", name:"Elizabeth Maclellan", url:"https://themoviedb.org/person/554043"}}, {tmdbId:"43753", properties:{bornIn:"Los Angeles, California, USA ", imdbId:"0076980", born:date('1958-03-30'), name:"Collin Bernsen", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ajmWBx0XUhXYD8guoOAsSn3wspq.jpg", url:"https://themoviedb.org/person/43753"}}, {tmdbId:"157968", properties:{imdbId:"0919954", name:"Steve Welles", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h1OyuVuSQvs3dldKXDQrwHMc9rF.jpg", url:"https://themoviedb.org/person/157968"}}, {tmdbId:"194599", properties:{imdbId:"0916121", name:"Greg Webb", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4jAi0fm734IEpgt5TA5Zk7OFPti.jpg", url:"https://themoviedb.org/person/194599"}}, {tmdbId:"1203993", properties:{imdbId:"0334746", name:"Dale Grand", url:"https://themoviedb.org/person/1203993"}}, {tmdbId:"178232", properties:{bornIn:"Boston, Massachusetts, U.S.", imdbId:"0254387", born:date('1923-03-26'), name:"Bob Elliott", bio:"Bob Elliott was born on March 26, 1923 in Boston, Massachusetts, USA as Robert Brackett Elliott.  He was an actor and writer, known for Quick Change (1990), Get a Life (1990) and Cabin Boy (1994).  He was married to Virginia Lee Peppers and Jane Frances Underwood.  He died on February 2, 2016 in Cundy's Harbor, Maine, USA...", died:date('2016-02-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ApysF6vUAU5IdsuFQMtgjkXcfbs.jpg", url:"https://themoviedb.org/person/178232"}}, {tmdbId:"110", properties:{bornIn:"Manhattan, New York City, New York, USA", imdbId:"0001557", born:date('1958-10-20'), name:"Viggo Mortensen", bio:"Viggo Peter Mortensen, Jr.  (born October 20, 1958) is an American-Danish actor, poet, musician, photographer and painter.  He made his film debut in Peter Weir's 1985 thriller Witness, and subsequently appeared in many notable films of the 1990s, including The Indian Runner (1991), Carlito's Way (1993), Crimson Tide (1995), The Portrait of a Lady (1996), G. I.  Jane (1997), A Perfect Murder (1998), and A Walk on the Moon (1999)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dVWm9ON1k40jSIEwqSl4p8V8Q5g.jpg", url:"https://themoviedb.org/person/110"}}, {tmdbId:"30083", properties:{bornIn:"Edinburgh, Scotland, UK", imdbId:"0242026", born:date('1950-11-07'), name:"Lindsay Duncan", bio:"From Wikipedia, the free encyclopedia. \n\nLindsay Vere Duncan, CBE (born 7 November 1950) is a Scottish stage and television actress, and winner of a Tony Award for Private Lives. \n\nDescription above from the Wikipedia article Lindsay Duncan, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kx2x62Rhod8wz1XuVDRQfqXpEqE.jpg", url:"https://themoviedb.org/person/30083"}}, {tmdbId:"87207", properties:{imdbId:"0178144", name:"Jeremy Cooper", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8x8Dipbo7aADevX41cEDDRTYkV6.jpg", url:"https://themoviedb.org/person/87207"}}, {tmdbId:"87208", properties:{bornIn:"Wilkie, Saskatchewan, Canada", imdbId:"0601874", born:date('1938-01-01'), name:"Sheila Moore", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/icFmHJlPlaSfl16KY0fWY58Mbk2.jpg", url:"https://themoviedb.org/person/87208"}}, {tmdbId:"94962", properties:{bornIn:" Melbourne, Victoria, Australia", imdbId:"0737248", born:date('1946-06-03'), name:"Tristan Rogers", bio:"From Wikipedia, the free encyclopedia.           \n\nTristan Rogers (born 3 June 1946 in Melbourne) is an Australian–American actor. \n\nEarly acting roles were on Australian television and he completed short stints in soap operas Bellbird, Number 96 (in 1974) and The Box (in 1975).  He was a regular in police drama series The Link Men (1970) which lasted 13 episodes, and had guest roles in programs including Barrier Reef, Division 4.  He also had a role in 1976 miniseries Power Without Glory...", url:"https://themoviedb.org/person/94962"}}, {tmdbId:"18750", properties:{bornIn:"Wethersfield, Connecticut, USA", imdbId:"0001711", born:date('1964-03-29'), name:"Annabella Sciorra", bio:"Annabella Sciorra (born March 29, 1964) is an American film, television, and stage actress.  Sciorra received an Independent Spirit Award nomination for Best Female Lead for the 1989 film True Love, and came to widespread attention in her co-lead role in Spike Lee's 1991 film Jungle Fever.  She starred in the 1992 thriller The Hand That Rocks The Cradle, and received critical acclaim for her work in Cop Land...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p2dnBSjLzKxldrHCQZYmVq0LcFw.jpg", url:"https://themoviedb.org/person/18750"}}, {tmdbId:"44049", properties:{bornIn:"Australia", imdbId:"0000873", born:date('1950-06-13'), name:"Belinda Bauer", bio:"​From Wikipedia, the free encyclopedia.   \n\nBelinda Bauer (born Belinda Sylvia Taubman; 13 June 1950) is a retired Australian actress and psychologist whose film career spanned the 1980s and 1990s.  She currently lives in Los Angeles, California. \n\nDescription above from the Wikipedia article  Belinda Jane Bauer, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sBY9vv2cTx7itRpNJa8LQLV5f8e.jpg", url:"https://themoviedb.org/person/44049"}}, {tmdbId:"44050", properties:{bornIn:" Shanghai, China", imdbId:"0532478", born:date('1935-04-22'), name:"Mario Machado", bio:"​From Wikipedia, the free encyclopedia.   \n\nMario Machado (born Mario Jose de Souza Machado in Shanghai, China, on April 22, 1935) is the Eurasian eight-time Emmy Award-winning television and radio broadcaster who made television history when, in 1970, he became the first Chinese-American on-air television news reporter and anchor in Los Angeles and perhaps in the nation\n\nDescription above from the Wikipedia article  Mario Machado, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2013-05-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mE1gnCm9ETbVvrmdc97p7TkVOk6.jpg", url:"https://themoviedb.org/person/44050"}}, {tmdbId:"44051", properties:{bornIn:"Hartsville, South Carolina, USA", imdbId:"0004957", born:date('1957-03-26'), name:"Leeza Gibbons", bio:"From Wikipedia, the free encyclopedia. \n\nLeeza Kim Gibbons (born 26 March 1957) is an American talk show host.  Gibbons is the host of her own radio show, Hollywood Confidential, part of the United Stations radio syndication company. \n\nDescription above from the Wikipedia article Leeza Gibbons, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wgpJqlQ4Ex0lAT91jrAWEYfqVI2.jpg", url:"https://themoviedb.org/person/44051"}}, {tmdbId:"16660", properties:{bornIn:"Los Angeles, California, U.S.", imdbId:"0821739", born:date('1976-05-05'), name:"Sage Stallone", bio:"Sage Moonblood Stallone (May 5, 1976 – July 13, 2012) was an American actor, director, producer and writer. \n\nDescription above from the Wikipedia article Sage Stallone, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2012-07-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kaW0QhisrrL1IKSlwMszIZbe5se.jpg", url:"https://themoviedb.org/person/16660"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
