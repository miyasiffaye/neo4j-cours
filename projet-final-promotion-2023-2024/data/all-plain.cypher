UNWIND [{tmdbId:"11855", properties:{bornIn:"Maidenhead, Berkshire, England, UK", imdbId:"0416524", born:date('1950-07-06'), name:"Geraldine James", bio:"From Wikipedia, the free encyclopedia\n\nGeraldine James, OBE (born 6 July 1950) is an English actress. \n\nDescription above from the Wikipedia article Geraldine James, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4FMJYeTIUxSE9SwCtnrwJzMsuC3.jpg", url:"https://themoviedb.org/person/11855"}}, {tmdbId:"1738906", properties:{name:"Michael Judd", url:"https://themoviedb.org/person/1738906"}}, {tmdbId:"1738907", properties:{name:"Julia Dearden", bio:"Julia Dearden is a television, film and theatre actress originally from Belfast...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mNrN1u4TrrGFpCPMSjB5CeUl025.jpg", url:"https://themoviedb.org/person/1738907"}}, {tmdbId:"188426", properties:{imdbId:"0639569", name:"Gerry O'Brien", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8WVgINpdOFZBlideEPbV6YnhOp0.jpg", url:"https://themoviedb.org/person/188426"}}, {tmdbId:"87097", properties:{bornIn:"Doncaster, South Yorkshire, England", imdbId:"0240072", born:date('1961-01-02'), name:"Neil Dudgeon", bio:"Neil Dudgeon was born in Doncaster, South Yorkshire on 2 January 1961 and attended Danum Grammar School among others.  He established himself as an actor in school plays and went on to study drama at university .  He made his first screen appearance in 1987.  The following year, he appeared as a World War II pilot in Piece of Cake, alongside Tim Woodward, Jeremy Northam and Nathaniel Parker...", url:"https://themoviedb.org/person/87097"}}, {tmdbId:"81260", properties:{bornIn:"Surrey, England, UK ", imdbId:"2389463", born:date('1995-03-04'), name:"Bill Milner", bio:"From Wikipedia, the free encyclopedia  William Henry \"Bill\" Milner (born 4 March 1995 in England) is an English child actor, best known for his roles as Will Proudfoot in Son of Rambow and as Edward in Is Anybody There?.   Description above from the Wikipedia article Bill Milner, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bLgmpSFgEiSFNshqmdl3EIZkRZm.jpg", url:"https://themoviedb.org/person/81260"}}, {tmdbId:"47730", properties:{bornIn:" London, England, UK", imdbId:"0828961", born:date('1972-10-30'), name:"Jessica Hynes", bio:"​From Wikipedia, the free encyclopedia.   \n\nJessica Hynes (née Stevenson; born 30 October 1972) is an English actress and writer.  She was known professionally as Jessica Stevenson until 2007. \n\nShe is possibly best known as one of the creators, writers and stars of the British sitcom Spaced. \n\nShe lives in London with her husband Adam Hynes, whom she met when she was 18, and married in 2002.  They have three children...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tTRKYwj5UIeQZmCWCEH1dMhfOoE.jpg", url:"https://themoviedb.org/person/47730"}}, {tmdbId:"93490", properties:{bornIn:"Hackney, London, England, UK", imdbId:"0934923", born:date('1914-10-30'), name:"Anna Wing", died:date('2013-07-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3tW36AV64UQxUb1w7qJNKuB4kf3.jpg", url:"https://themoviedb.org/person/93490"}}, {tmdbId:"1292420", properties:{bornIn:"Abadan, Iran", imdbId:"0267946", born:date('1969-04-17'), name:"Hamid Farokhnezhad", bio:"Hamid Farrokhnejad (حمید فرخ نژاد) is an Iranian actor, writer, and director.  Born in Abadan in 1969, he began his career in student theatre and working on short films.  He graduated from the Theatre Director programme in Tehran University Fine Arts Department.  Hamid Farrokhnejad gained popular acclaim with his role in Bride of Fire (2000) winning many awards in the Fajr Film Festival, and notably appearing as Morteza in Fireworks Wednesday (2006)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5G1sRNyAmGm2sDf89WZ5OQItiTf.jpg", url:"https://themoviedb.org/person/1292420"}}, {tmdbId:"1538303", properties:{bornIn:"Tehran, Iran", imdbId:"0998142", born:date('1972-06-25'), name:"Hediyeh Tehrani", bio:"Hedie Tehrani is a Persian actress who was born in 1972 in Tehran, Iran.  The turning point of her professional work was formed with the movie \"Sultan\" made by Massoud Kimiaei.  Her first play was in \"The Red\" movie by Fereydoun Jeirani, and the second one was for Asghar Farhadi's \"Fireworks Wednesday\" movie which she won the Best First Role Actress Award for the Fajr Festival...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cx7GVl73szirtLiGZBBVk503jM2.jpg", url:"https://themoviedb.org/person/1538303"}}, {tmdbId:"213371", properties:{bornIn:"Tehran, Iran", imdbId:"1267552", born:date('1984-01-12'), name:"Taraneh Alidoosti", bio:"Tarane Alidousti is an Iranian actress of theatre and cinema and also a translator who was born in 1984 in Tehran, Iran.  She has been featured for the first time in the movie \"I'm Taraneh, 15\" by Rassoul Sadr Ameli, and this movie can be considered as a turning point in her career.  She won the Crystal Simorgh Award for Best First Role Actress from Fajr Festival for this movie...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hZibBkEawv9xsdZTy4ajXmwtM2A.jpg", url:"https://themoviedb.org/person/213371"}}, {tmdbId:"1297979", properties:{bornIn:"Tehran, Iran", imdbId:"4204262", born:date('1970-03-04'), name:"Pantea Bahram", bio:"Pantea Bahram is an actress who was born in 1970 in Tehran, Iran.  She started her career in television and starred in season 3 of “Mirror” by Fereydoun Farhoodi in 1987.  She has also won an Honorary Diploma and Statue fo Best First Role Actress for “The Bright Day” by Hossein Shahabi from Fajr Film Festival.  From her notable activities, “Asheghaneh” series by Manouzhehr Hadi, “Fireworks Wednesday” by Asghar Farhadi and “Man Madar Hastam” directed by Fereydoun Jeirani can be named...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/XFQG3mgIyA6QMmSAdvdrRl13fm.jpg", url:"https://themoviedb.org/person/1297979"}}, {tmdbId:"95926", properties:{imdbId:"2357988", name:"Bob Proctor", url:"https://themoviedb.org/person/95926"}}, {tmdbId:"1716714", properties:{bornIn:"Canton, Ohio, USA", imdbId:"1909816", born:date('1949-04-02'), name:"Joe Vitale", url:"https://themoviedb.org/person/1716714"}}, {tmdbId:"95928", properties:{imdbId:"2362666", name:"John Assaraf", url:"https://themoviedb.org/person/95928"}}, {tmdbId:"95929", properties:{imdbId:"2379271", name:"Loral Langemeier", url:"https://themoviedb.org/person/95929"}}, {tmdbId:"2280692", properties:{name:"Manfred Schulz", url:"https://themoviedb.org/person/2280692"}}, {tmdbId:"1208293", properties:{imdbId:"2404969", name:"Massimo Vignelli", url:"https://themoviedb.org/person/1208293"}}, {tmdbId:"2280693", properties:{name:"Rick Poynor", url:"https://themoviedb.org/person/2280693"}}, {tmdbId:"2280694", properties:{name:"Wim Crouwel", url:"https://themoviedb.org/person/2280694"}}] AS row
