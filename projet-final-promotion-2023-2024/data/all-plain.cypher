CREATE RANGE INDEX FOR (n:Movie) ON (n.imdbId);
CREATE RANGE INDEX FOR (n:Movie) ON (n.imdbRating);
CREATE RANGE INDEX FOR (n:Movie) ON (n.released);
CREATE RANGE INDEX FOR (n:Movie) ON (n.tagline);
CREATE RANGE INDEX FOR (n:Movie) ON (n.title);
CREATE RANGE INDEX FOR (n:Movie) ON (n.year);
CREATE RANGE INDEX FOR (n:Person) ON (n.name);
CREATE RANGE INDEX FOR (n:User) ON (n.name);
CREATE CONSTRAINT constraint_3b27b0 FOR (node:User) REQUIRE (node.userId) IS UNIQUE;
CREATE CONSTRAINT constraint_3d5fcb7f FOR (node:Movie) REQUIRE (node.movieId) IS UNIQUE;
CREATE CONSTRAINT constraint_4499eae9 FOR (node:Person) REQUIRE (node.tmdbId) IS UNIQUE;
CREATE CONSTRAINT constraint_737d9c1d FOR (node:Movie) REQUIRE (node.tmdbId) IS UNIQUE;
CREATE CONSTRAINT constraint_f8689281 FOR (node:Genre) REQUIRE (node.name) IS UNIQUE;
UNWIND [{tmdbId:"1271225", properties:{bornIn:"France", imdbId:"2083046", born:date('1877-02-04'), name:"François Lallement", died:date('1954-01-01'), url:"https://themoviedb.org/person/1271225"}}, {tmdbId:"1602569", properties:{imdbId:"6170115", born:date('1862-01-01'), name:"Jules-Eugène Legris", died:date('1926-01-01'), url:"https://themoviedb.org/person/1602569"}}, {tmdbId:"8828", properties:{bornIn:"Springfield, Ohio, USA", imdbId:"0001273", born:date('1893-10-14'), name:"Lillian Gish", bio:"​From Wikipedia, the free encyclopedia\n\nLillian Diana Gish (October 14, 1893 – February 27, 1993) was an American stage, screen and television actress whose film acting career spanned 75 years, from 1912 to 1987. \n\nShe was a prominent film star of the 1910s and 1920s, particularly associated with the films of director D. W.  Griffith, including her leading role in Griffith's seminal Birth of a Nation (1915)...", died:date('1993-02-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6DCWtvv654sc8p2OPnxGbKvl2qC.jpg", url:"https://themoviedb.org/person/8828"}}, {tmdbId:"8829", properties:{bornIn:"Madrid, New Mexico Territory , USA", imdbId:"0550615", born:date('1894-11-09'), name:"Mae Marsh", bio:"Mae Marsh (born Mary Wayne Marsh, November 9, 1894 – February 13, 1968) was an American film actress with a career spanning over 50 years...", died:date('1968-02-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wEHHFF2Tq2Z1BlRRr27SOcUW3pu.jpg", url:"https://themoviedb.org/person/8829"}}, {tmdbId:"8830", properties:{bornIn:"Shelby County, Alabama, USA", imdbId:"0910400", born:date('1878-03-16'), name:"Henry B. Walthall", bio:"​From Wikipedia, the free encyclopedia\n\nHenry Brazeale Walthall (March 16, 1878 – June 17, 1936) was an American stage and film actor.  He appeared as the Little Colonel in D.  W.  Griffith's The Birth of a Nation (1915).   In New York in 1901, Walthall won a role in Under Southern Skies by Charlotte Blair Parker.  He performed in the play for three years, in New York and on tour...", died:date('1936-06-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5RZtgV7iFQFvVijQJzNFzViAEu8.jpg", url:"https://themoviedb.org/person/8830"}}, {tmdbId:"8831", properties:{imdbId:"0178270", born:date('1891-11-07'), name:"Miriam Cooper", bio:"​From Wikipedia, the free encyclopedia\n\nMiriam Cooper (November 7, 1891 – April 12, 1976) was a silent film actress who is best known for her work in early film including Birth of a Nation and Intolerance for D. W.  Griffith and The Honor System and Evangeline for her husband Raoul Walsh.  She retired from acting in 1923 but was rediscovered by the film community in the 1960s, and toured colleges lecturing about silent films...", died:date('1976-04-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kl8SwHKsjvJkaHnWUInhFLhLSVw.jpg", url:"https://themoviedb.org/person/8831"}}, {tmdbId:"105947", properties:{imdbId:"0360132", name:"Dan Hanlon", url:"https://themoviedb.org/person/105947"}}, {tmdbId:"105951", properties:{imdbId:"0671728", name:"Edna Pendleton", url:"https://themoviedb.org/person/105951"}}, {tmdbId:"105942", properties:{bornIn:"Toledo, Ohio, USA", imdbId:"0072911", born:date('1885-08-26'), name:"Curtis Benton", died:date('1938-09-14'), url:"https://themoviedb.org/person/105942"}}, {tmdbId:"105948", properties:{bornIn:"San Francisco, California, USA", imdbId:"0392709", born:date('1888-08-03'), name:"Allen Holubar", died:date('1923-11-20'), url:"https://themoviedb.org/person/105948"}}, {tmdbId:"8835", properties:{bornIn:"Edinburgh, Scotland, UK", imdbId:"0014894", born:date('1868-04-16'), name:"Spottiswoode Aitken", died:date('1933-02-26'), url:"https://themoviedb.org/person/8835"}}, {tmdbId:"8832", properties:{bornIn:"New York City, New York, USA", imdbId:"0017488", born:date('1883-06-18'), name:"Mary Alden", bio:"From Wikipedia, the free encyclopedia\n\nMary Maguire Alden (June 18, 1883 – July 2, 1946) was an American motion picture and stage actress.  She was one of the first Broadway actresses to work in Hollywood. \n\nBorn in New York City, Alden began her career on the Broadway stage.  She spent five years on Broadway before moving to Hollywood where she worked for the Biograph Company and Pathé Exchange in the first portion of her career...", died:date('1946-07-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tksV05qljP9YoLJ44ajq5Rw2QAL.jpg", url:"https://themoviedb.org/person/8832"}}, {tmdbId:"1647611", properties:{name:"Frank Bennett", url:"https://themoviedb.org/person/1647611"}}, {tmdbId:"21301", properties:{bornIn:"Paradise Valley, Nevada, USA", imdbId:"0701012", born:date('1895-10-21'), name:"Edna Purviance", bio:"​From Wikipedia, the free encyclopedia\n\nEdna Purviance (October 21, 1895 – January 11, 1958) was an American actress during the silent movie era.  She was the leading lady in many Charlie Chaplin movies.  In a span of eight years, she appeared in over thirty films with Chaplin...", died:date('1958-01-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2uEZFOiUMPtctVbAnhf86OR6jQa.jpg", url:"https://themoviedb.org/person/21301"}}, {tmdbId:"21303", properties:{imdbId:"0132444", born:date('1879-04-26'), name:"Eric Campbell", died:date('1917-12-20'), url:"https://themoviedb.org/person/21303"}}, {tmdbId:"21306", properties:{bornIn:"Birmingham, England", imdbId:"0042317", born:date('1882-12-13'), name:"Albert Austin", bio:"Albert Austin (13 December 1881 or 1885 – 17 August 1953) was an actor, film star, director and script writer, noted mainly for his work in Charlie Chaplin films.  He was the brother of actor William Austin.  He was born in Birmingham, England, and was a music hall performer before coming to the U. S.  with Chaplin, both as members of the Fred Karno troupe, in 1910...", died:date('1953-08-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ztUZFA4xxiuppjUf7O8oR6xK5bs.jpg", url:"https://themoviedb.org/person/21306"}}, {tmdbId:"85778", properties:{bornIn:" Melbourne, Victoria, Australia", imdbId:"0689444", born:date('1889-11-09'), name:"'Snub' Pollard", bio:"From Wikipedia, the free encyclopedia\n\nSnub Pollard (9 November 1889 – 19 January 1962) was an Australian-born vaudevillian, who became a silent film comedian in Hollywood, popular in the 1920s. \n\nBorn Harold Fraser, in Melbourne, Australia on 9 November 1889, he began performing with Pollard's Lilliputian Opera Company at a young age.  Like many of the actors in the popular juvenile company, he adopted Pollard as his stage name...", died:date('1962-01-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/srCQa37TG3RHKx5PuthzjsTpe6n.jpg", url:"https://themoviedb.org/person/85778"}}, {tmdbId:"30000", properties:{bornIn:"Dallas, Texas, USA", imdbId:"0199841", born:date('1901-01-14'), name:"Bebe Daniels", bio:"​From Wikipedia\n\nBebe Daniels (January 14, 1901 – March 16, 1971) was an American actress, singer, dancer, writer and producer.  She began her career in Hollywood during the silent film era as a child actress, became a star in musicals such as 42nd Street (1933), and later gained further fame on radio and television in Britain.  Throughout her career, Daniels appeared in 230 films...", died:date('1971-03-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fGvTe5FSELsgRZQsU3jX5btIm2y.jpg", url:"https://themoviedb.org/person/30000"}}, {tmdbId:"3000", properties:{bornIn:"Gestungshausen, Sonnefeld, Bavaria, Germany", imdbId:"0470328", born:date('1884-06-23'), name:"Werner Krauss", died:date('1959-10-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xlyS30qzcndmczxG5JdJWwJ1heI.jpg", url:"https://themoviedb.org/person/3000"}}, {tmdbId:"3001", properties:{bornIn:"Potsdam, Brandenburg, Germany", imdbId:"0891998", born:date('1893-01-22'), name:"Conrad Veidt", bio:"Hans Walter Conrad Veidt (22 January 1893 – 3 April 1943) was a German actor best remembered for his roles in films such as Different from the Others (1919), The Cabinet of Dr.  Caligari (1920), and The Man Who Laughs (1928).  After a successful career in German silent film, where he was one of the best-paid stars of Ufa, he was forced to leave Germany in 1933 with his new Jewish wife after the Nazis came to power...", died:date('1943-04-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5PvSGqd3ZR9hjLE0Wo5yUPnKgPx.jpg", url:"https://themoviedb.org/person/3001"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"590591", properties:{imdbId:"0270415", born:date('1889-03-16'), name:"Friedrich Feher", died:date('1950-09-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/s5f3MVz7nL9dnsytzTAQb4AkMWx.jpg", url:"https://themoviedb.org/person/590591"}}, {tmdbId:"3005", properties:{imdbId:"0196820", born:date('1887-09-30'), name:"Lil Dagover", died:date('1980-01-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lksn2PhJAxIGaWKDbLflQpyIycl.jpg", url:"https://themoviedb.org/person/3005"}}, {tmdbId:"29175", properties:{bornIn:"Bad Arolsen, Germany", imdbId:"0826210", born:date('1872-05-20'), name:"Albert Steinrück", died:date('1929-02-10'), url:"https://themoviedb.org/person/29175"}}, {tmdbId:"29176", properties:{bornIn:"Prague, Czech Republic", imdbId:"0758802", born:date('1889-07-14'), name:"Lyda Salmonova", bio:"Lyda Salmonova was a Czech stage and film actress.  She was married to the actor Paul Wegener and appeared alongside him in a number of films...", died:date('1968-11-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mFNTWMnOw0HRJAU74418hfBLbvK.jpg", url:"https://themoviedb.org/person/29176"}}, {tmdbId:"29177", properties:{bornIn:"Prague, Bohemia, Austria-Hungary [now Czech Republic]", imdbId:"0222074", born:date('1890-09-16'), name:"Ernst Deutsch", died:date('1969-03-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yJttn5y0zKiMb8gAmFVuE7AStVK.jpg", url:"https://themoviedb.org/person/29177"}}, {tmdbId:"128325", properties:{imdbId:"0209323", born:date('1902-06-22'), name:"Marguerite De La Motte", died:date('1950-03-10'), url:"https://themoviedb.org/person/128325"}}, {tmdbId:"97990", properties:{bornIn:"San Francisco - California - USA", imdbId:"0571770", born:date('1886-08-26'), name:"Robert McKim", bio:"From Wikipedia\n\nRobert McKim (August 26, 1886 – June 4, 1927) was an American actor of the silent film era.  He appeared in 99 films between 1915 and 1927.  He is best remembered for playing the arch villain opposite Douglas Fairbanks's Zorro in The Mark of Zorro in 1920. \n\nMcKim starred with Lon Chaney in the 1923 silent version of All The Brothers Were Valiant...", died:date('1927-06-04'), url:"https://themoviedb.org/person/97990"}}, {tmdbId:"128324", properties:{bornIn:"Kansas City, Missouri, USA", imdbId:"0001935", born:date('1882-01-17'), name:"Noah Beery", bio:"From Wikipedia, the free encyclopedia\n\nNoah Nicholas Beery (January 17, 1882 – April 1, 1946) was an American actor, who appeared in films from 1913 to 1945. \n\nDescription above from the Wikipedia article Noah Beery, Sr. , licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1946-04-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rFsrCS3q90odr4CdimFJHob6GkE.jpg", url:"https://themoviedb.org/person/128324"}}, {tmdbId:"100804", properties:{bornIn:"Halifax, Nova Scotia, Canada", imdbId:"0537556", born:date('1870-05-25'), name:"Charles Hill Mailes", bio:"From Wikipedia, the free encyclopedia\n\nCharles Hill Mailes (25 May 1870 – 17 February 1937) was a Canadian actor of the silent era.  He appeared in 290 films between 1909 and 1935. \n\nHe was born in Halifax, Nova Scotia and died in Los Angeles, California.  His spouse was the actress Claire McDowell (married 1906), with whom he had two sons, Robert &amp; Eugene. \n\nDescription above from the Wikipedia article Charles Hill Mailes, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1937-02-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cuZwr89Jxmx1fyAs6KuXPGbpfGS.jpg", url:"https://themoviedb.org/person/100804"}}, {tmdbId:"121146", properties:{bornIn:"Wheeling - West Virginia - United States", imdbId:"0289295", born:date('1902-04-19'), name:"Virginia Fox", bio:"Virginia Fox was born in Wheeling, West Virginia (though her grave erroneously  lists Charleston, W. Va.  as her place of birth), the daughter of Marie  (née Oglseby) and Frederick Fox.  While on vacation from boarding school, Fox traveled to visit a  friend in Los Angeles.  The two made a casual stop by the studio of Mack Sennett,  where she was hired on the spot and made a bathing beauty in the  studio's films...", died:date('1982-10-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aQg7RIenVSUmLgWQJFjgqEj4ycM.jpg", url:"https://themoviedb.org/person/121146"}}, {tmdbId:"10525", properties:{bornIn:"Albany, New York, USA", imdbId:"0731247", born:date('1871-02-02'), name:"Joe Roberts", bio:"\"Big Joe\" Roberts, as he was known in vaudeville, toured the country with his first wife, Lillian Stuart Roberts as part of a rowdy act known as Roberts, Hays, and Roberts.  Their signature routine was called \"The Cowboy, the Swell and the Lady. \" At this time, in the first decade of the twentieth century, Buster Keaton's father, Joe Keaton, had started a summer Actors' Colony for vaudevillians between Lake Michigan and Muskegon Lake in Michigan...", died:date('1923-10-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dqwp5M1pYiPreQFjkXTXTmf3I5c.jpg", url:"https://themoviedb.org/person/10525"}}, {tmdbId:"63378", properties:{bornIn:"Wichita County, Texas, USA", imdbId:"0588033", born:date('1893-08-09'), name:"Carl Miller", died:date('1979-01-22'), url:"https://themoviedb.org/person/63378"}}, {tmdbId:"19426", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0001067", born:date('1914-10-26'), name:"Jackie Coogan", bio:"​From Wikipedia, the free encyclopedia. \n\nJohn Leslie Coogan (October 26, 1914 – March 1, 1984), known professionally as Jackie Coogan, was an American actor who began his movie career as a child actor in silent films.  Many years later, he became known as Uncle Fester on 1960s sitcom The Addams Family.  In the interim, he sued his mother and stepfather over his squandered film earnings and provoked California to enact the first known legal protection for the earnings of child performers...", died:date('1984-03-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l9wiXgf7kLiuxgArVVeOqgPYHrm.jpg", url:"https://themoviedb.org/person/19426"}}, {tmdbId:"77", properties:{bornIn:"Cologne, Germany", imdbId:"0459030", born:date('1885-11-24'), name:"Rudolf Klein-Rogge", bio:"From Wikipedia, the free encyclopedia\n\nFriedrich Rudolf Klein-Rogge (24 November 1885 – 29 May 1955) was a German film actor.  Klein-Rogge is known for playing sinister figures in films in the 1920s and 1930s as well as being a mainstay in director Fritz Lang's Weimar-era films.  He is probably best known in popular culture, particularly to English-speaking audiences, for playing the archetypal mad scientist role of C.  A.  Rotwang in Lang's Metropolis and as the criminal genius Doctor Mabuse...", died:date('1955-05-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ua4GhFTM7uQqlM0RnSXEZ5v1kVB.jpg", url:"https://themoviedb.org/person/77"}}, {tmdbId:"28988", properties:{bornIn:"Bergen, Norway", imdbId:"0250790", born:date('1893-05-30'), name:"Aud Egede-Nissen", bio:"Aud Egede-Nissen was a Norwegian stage and screen actress, and producer.   She made her acting debut on the Norwegian stage in 1911, appearing next in Norwegian director Bjørn Bjørnson's 1913 film \"Scenens børn\".  She first moved to Denmark and later Bjørn Bjørnson invited her to Berlin, where there were opportunities in the rapidly expanding film industry...", died:date('1974-11-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/271xabIyKpp8R0mjRRD6eZkfqjn.jpg", url:"https://themoviedb.org/person/28988"}}, {tmdbId:"47169", properties:{bornIn:"Dresden, Saxony, Germany", imdbId:"0919684", born:date('1896-07-16'), name:"Gertrude Welcker", bio:"Gertrude Welcker was a German stage ans screen actress.  From 1916 to 1919 she performed in Max Reinhardt theaters, Deutsches Theater Berlin, Kammerspiele, and Volksbühne.  She made her film debut in \"Hans Trutz in the Land of Plenty\" in 1917.  She ended her film career after 64 features in 1925.  She stayed on a couple of years in the theatre.  In 1941 she became a Red Cross nurse ans escaped to Sweden as Gertud Carlsund...", died:date('1988-08-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hyTUoxHZrdGY3C2hv3qS4gfF4at.jpg", url:"https://themoviedb.org/person/47169"}}, {tmdbId:"73", properties:{bornIn:"Leipzig, Germany", imdbId:"0002154", born:date('1879-03-12'), name:"Alfred Abel", bio:"From Wikipedia, the free encyclopedia\n\nAlfred Peter Abel (12 March 1879 – 12 December 1937) was a German film actor, director, and producer.  He appeared in more than 140 silent and sound films between 1913 and 1938.  His best-known performance was as Joh Fredersen in Fritz Lang's 1927 film, Metropolis...", died:date('1937-12-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/elRbE3CTs41tFKjP05uGVXt4Bxt.jpg", url:"https://themoviedb.org/person/73"}}, {tmdbId:"89675", properties:{imdbId:"0669922", name:"Maren Pedersen", url:"https://themoviedb.org/person/89675"}}, {tmdbId:"89676", properties:{bornIn:"Copenhagen, Denmark", imdbId:"0690702", born:date('1883-04-23'), name:"Clara Pontoppidan", bio:"From Wikipedia, the free encyclopedia. \n\nClara Pontoppidan also known as Clara Wieth (April 23, 1883 – January 22, 1975) was a Danish actress.  She worked in Swedish and Danish silent films, including A Victim of the Mormons (Denmark, 1911). \n\nDescription above from the Wikipedia article Clara Pontoppidan, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1975-01-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/k5yBFjxpOQCtTKG3UF9pkOKBEF.jpg", url:"https://themoviedb.org/person/89676"}}, {tmdbId:"89677", properties:{bornIn:"Copenhagen, Denmark", imdbId:"0684773", born:date('1887-07-03'), name:"Elith Pio", bio:"From Wikipedia, the free encyclopedia. \n\nViggo Elith William Pio (3 July 1887 - 10 February 1983) was a Danish actor of stage, screen, radio and television.  He is most noted for starring roles in films such as Carl Theodor Dreyer's Leaves from Satan's Book, Johan Jacobsen's Jenny and the Soldier and Benjamin Christensen's Häxan. \n\nDescription above from the Wikipedia article Elith Pio, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1983-02-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uRns9P8BrjGyb3CI8Sbclp8aWWc.jpg", url:"https://themoviedb.org/person/89677"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"89678", properties:{bornIn:"Copenhagen, Denmark", imdbId:"0834325", born:date('1872-02-12'), name:"Oscar Stribolt", bio:"From Wikipedia, the free encyclopedia. \n\nPeter Oscar Stribolt (12 February 1872 – 20 May 1927) was a Danish stage and film actor of the silent era in Denmark.  He worked prolifically under director Lau Lauritzen Sr. \n\nDescription above from the Wikipedia article Oscar Stribolt, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1927-05-20'), url:"https://themoviedb.org/person/89678"}}, {tmdbId:"10094", properties:{imdbId:"1354245", name:"Allakariallak", url:"https://themoviedb.org/person/10094"}}, {tmdbId:"10095", properties:{imdbId:"0638725", name:"Nyla", url:"https://themoviedb.org/person/10095"}}, {tmdbId:"10097", properties:{imdbId:"0020170", name:"Allee", url:"https://themoviedb.org/person/10097"}}, {tmdbId:"10096", properties:{imdbId:"0192066", name:"Cunayou", url:"https://themoviedb.org/person/10096"}}, {tmdbId:"9839", properties:{bornIn:"Berlin, Germany", imdbId:"0775180", born:date('1879-09-06'), name:"Max Schreck", bio:"From Wikipedia, the free encyclopedia\n\nFriedrich Gustav Max Schreck (6 September 1879 – 20 February 1936) was a German actor.  He is most often remembered today for his lead role in the film Nosferatu (1922). \n\nDescription above from the Wikipedia article Max Schreck, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1936-02-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uKVNFFt6VA8R7pp7HIPJF4e5PfX.jpg", url:"https://themoviedb.org/person/9839"}}, {tmdbId:"9840", properties:{bornIn:"Wiesbaden, Germany", imdbId:"0903194", born:date('1895-02-18'), name:"Gustav von Wangenheim", bio:"From Wikipedia, the free encyclopedia\n\nGustav von Wangenheim (February 18, 1895 – August 5, 1975) was a German actor, screenwriter and director. \n\nDescription above from the Wikipedia article Gustav von Wangenheim, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1975-10-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5BQ07rsNY9z3IoN6sdwipoFoNWV.jpg", url:"https://themoviedb.org/person/9840"}}, {tmdbId:"9841", properties:{bornIn:"Düsseldorf, Germany", imdbId:"0775659", born:date('1891-09-07'), name:"Greta Schröder", bio:"From Wikipedia, the free encyclopedia\n\nGreta Schröder (7 September 1891 – 13 April 1967) was a German actress.  She is best known for the role of Thomas Hutter's wife and victim to Count Orlok in the 1922 silent film Nosferatu.  In the fictionalized 2000 film, Shadow of the Vampire, she is portrayed as having been a famous actress during the making of Nosferatu, but in fact she was little known...", died:date('1967-04-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vkwD2LVM2QRD2a6auvq1K6Zpwd0.jpg", url:"https://themoviedb.org/person/9841"}}, {tmdbId:"9843", properties:{bornIn:"Tschifu (now Yantai), China", imdbId:"0774114", born:date('1878-04-11'), name:"Georg H. Schnell", died:date('1951-03-31'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1uTps71tiRThDbvNqnyrCcH7IfM.jpg", url:"https://themoviedb.org/person/9843"}}, {tmdbId:"1670560", properties:{bornIn:"Baltimore, Maryland, USA", imdbId:"0124287", born:date('1903-05-01'), name:"Ralph Bushman", bio:"From Wikipedia, the free encyclopedia\n\nRalph Everly Bushman (May 1, 1903 – April 16, 1978), was an American actor.  He appeared in fifty-five films between 1920 and 1943.  In his early film career, he was often credited as Francis X.  Bushman Jr. \n\nThe son of notable silent film star Francis X.  Bushman and Josephine Fladung Duval, he was born in Baltimore, Maryland and died in Los Angeles, California at age 74...", died:date('1978-04-16'), url:"https://themoviedb.org/person/1670560"}}, {tmdbId:"10528", properties:{imdbId:"0911469", name:"Craig Ward", url:"https://themoviedb.org/person/10528"}}, {tmdbId:"1832030", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0172560", born:date('1856-01-01'), name:"Monte Collins", died:date('1929-08-04'), url:"https://themoviedb.org/person/1832030"}}, {tmdbId:"88954", properties:{imdbId:"0205192", born:date('1901-02-22'), name:"Mildred Davis", died:date('1969-08-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vkWEUDIbRVqjn5Pfvqc8IMpYvdj.jpg", url:"https://themoviedb.org/person/88954"}}, {tmdbId:"148377", properties:{imdbId:"0835128", name:"Bill Strother", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/amRNvJPM3GeGG6CseYG9LxlmQjE.jpg", url:"https://themoviedb.org/person/148377"}}, {tmdbId:"88958", properties:{bornIn:"North Park, Colorado, USA", imdbId:"0949927", born:date('1887-02-02'), name:"Noah Young", died:date('1958-04-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xReuE153sUJASBj0h6kPQb2qbbm.jpg", url:"https://themoviedb.org/person/88958"}}, {tmdbId:"144005", properties:{imdbId:"0494993", name:"Margaret Leahy", url:"https://themoviedb.org/person/144005"}}, {tmdbId:"29260", properties:{bornIn:"Kansas City, Missouri, USA", imdbId:"0000891", born:date('1885-04-01'), name:"Wallace Beery", bio:"From Wikipedia\n\nWallace Fitzgerald Beery (April 1, 1885 – April 15, 1949) was an American actor.  He is best known for his portrayal of Bill in Min and Bill opposite Marie Dressler, his titular role in a series of films featuring the character Sweedie, and his titular role in The Champ, for which he won the Academy Award for Best Actor.  Beery appeared in some 250 movies over a 36-year span...", died:date('1949-04-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/b7qE3s332Wu7YcOzjBYT118UOXN.jpg", url:"https://themoviedb.org/person/29260"}}, {tmdbId:"2895", properties:{bornIn:"Rorschach, Switzerland", imdbId:"0417837", born:date('1884-07-23'), name:"Emil Jannings", bio:"Emil Jannings (1884–1950) was a German actor.  He was the first actor to win the Academy Award for Best Actor...", died:date('1950-01-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yX7AFfYgYit6WlPshockLsP40LB.jpg", url:"https://themoviedb.org/person/2895"}}, {tmdbId:"35420", properties:{bornIn:"Hamburg, Germany", imdbId:"0217848", born:date('1898-12-03'), name:"Maly Delschaft", died:date('1995-08-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/m1xP591e4pee4gnLMRq58M5l4Va.jpg", url:"https://themoviedb.org/person/35420"}}, {tmdbId:"47029", properties:{bornIn:"Berlin, Germany", imdbId:"0384897", born:date('1889-12-08'), name:"Max Hiller", died:date('1948-12-17'), url:"https://themoviedb.org/person/47029"}}] AS row
