UNWIND [{tmdbId:"17923", properties:{imdbId:"0682886", name:"Frank Pietrangolare", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wFohY73v2kG0HuoLWsq0ORgMkph.jpg", url:"https://themoviedb.org/person/17923"}}, {tmdbId:"60795", properties:{imdbId:"0214129", name:"Richard DeDomenico", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/A8RjeVln7YrvkwAFgemN8vGNiZF.jpg", url:"https://themoviedb.org/person/60795"}}, {tmdbId:"3623", properties:{bornIn:"Palencia, Palencia, Castilla y León, Spain", imdbId:"0025745", born:date('1975-07-17'), name:"Elena Anaya", bio:"​From Wikipedia, the free encyclopedia\n\nElena Anaya (born July 17, 1975) is a Spanish actress whose career dates back to 1995.  Anaya was born in Palencia, Spain on July 17, 1975.  She is the youngest of 5 children.  She first received international attention in 2001 for her role in the sexually explicit drama Lucía y el sexo (Sex and Lucía) and also appeared in Pedro Almodóvar's Hable con ella (Talk to Her)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hSkjzOfvRQ8DUJdhWveIKgRlyXb.jpg", url:"https://themoviedb.org/person/3623"}}, {tmdbId:"272773", properties:{bornIn:"Arlington, Virginia, USA", imdbId:"0974465", born:date('1987-04-21'), name:"Kelsey Keel", url:"https://themoviedb.org/person/272773"}}, {tmdbId:"154955", properties:{bornIn:"Simi Valley, California, USA", imdbId:"1642290", born:date('1988-08-26'), name:"Danielle Savre", bio:"Danielle Savre is an American film and television actress and singer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2vZ5uWOit9nS6hLbGEum29LW36D.jpg", url:"https://themoviedb.org/person/154955"}}, {tmdbId:"53480", properties:{bornIn:"Glasgow, Scotland, UK", imdbId:"2043234", born:date('1981-10-26'), name:"Khalid Abdalla", bio:"From Wikipedia, the free encyclopedia. \n\nKhalid Abdalla (born 1980) is a British-Egyptian actor.  He came to international prominence after starring in the 2006 Academy Award-nominated and BAFTA-winning film, United 93.  Written and directed by Paul Greengrass, it chronicles events aboard United Airlines Flight 93, which was hijacked as part of the September 11 attacks.  Abdalla played Ziad Jarrah, the pilot and leader of the four hijackers on board the flight...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iYRhheaol1T19Qy8a8pTIPk9COK.jpg", url:"https://themoviedb.org/person/53480"}}, {tmdbId:"53481", properties:{bornIn:"Berlin, Germany", imdbId:"0503033", name:"Atossa Leoni", bio:"From Wikipedia, the free encyclopedia. \n\nAtossa Leoni is an actress who has been working internationally in film, television and theater since childhood. \n\nOf Iranian descent, Atossa was born in Berlin, Germany, raised in various countries throughout Europe and schooled in the United States.  She is fluent in five languages and currently resides in Los Angeles. [1]\n\nAtossa made her American screen debut starring as Soraya, the female lead in the film adaptation of The Kite Runner...", url:"https://themoviedb.org/person/53481"}}, {tmdbId:"17857", properties:{bornIn:"Tehran - Iran", imdbId:"0869467", born:date('1963-01-01'), name:"Shaun Toub", bio:"Shaun Toub is an Iranian-American film and television actor.  He is perhaps best known for his role as Farhad in the 2004 movie Crash, as Rahim Khan in the movie The Kite Runner, and as Yinsen in the film adaptation of the Iron Man comic book series. \n\nToub, who is of Persian Jewish background, was born in Tehran, Iran and raised in Manchester, England (his family left Iran before the 1979 revolution)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6fuJ9D50bYuMAhrlEgVqzgqF0LU.jpg", url:"https://themoviedb.org/person/17857"}}, {tmdbId:"53484", properties:{imdbId:"2860274", name:"Sayed Jafar Masihullah Gharibzada", url:"https://themoviedb.org/person/53484"}}, {tmdbId:"56446", properties:{bornIn:"West Newbury, Massachusetts, USA", imdbId:"1078479", born:date('1977-04-23'), name:"John Cena", bio:"An American professional wrestler, philanthropist and actor.  He is currently signed to WWE, where he is a free agent who appears for both the Raw and SmackDown brands. \n\nCena started his professional wrestling career in 1999 with Ultimate Pro Wrestling (UPW) and won the UPW Heavyweight Championship the following year...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mB4vXUOxXkGiOyDY3huQ7buFCuf.jpg", url:"https://themoviedb.org/person/56446"}}, {tmdbId:"9378", properties:{bornIn:"Saginaw, Michigan, USA", imdbId:"0662562", born:date('1958-05-13'), name:"Anthony Ray Parker", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/k03O1ClFvGRSedUnK0sAjTkrogX.jpg", url:"https://themoviedb.org/person/9378"}}, {tmdbId:"5201", properties:{bornIn:"Friesach, Carinthia, Austria", imdbId:"0821177", born:date('1982-08-03'), name:"Robert Stadlober", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gJdf9HI8ZBMSOPDlwAz9enmKGI2.jpg", url:"https://themoviedb.org/person/5201"}}, {tmdbId:"5202", properties:{bornIn:"Hamburg, Germany", imdbId:"0880518", born:date('1984-05-30'), name:"Kostja Ullmann", bio:"Ullmanns Vater ist Schauspieler und leitete seine eigene Schauspieleragentur in Hamburg.  Seine halbindische Mutter ist Tänzerin, seine Schwester Shantia Ullmann auch Schauspielerin.  So stand Ullmann schon im Alter von elf Jahren auf der Bühne des Ernst Deutsch Theaters in Hamburg.  1996 bekam er eine Rolle in der Fernsehserie Alphateam unter der Regie von Norbert Schulze.  Kurz darauf war er in dem Kurzfilm Das Rennen von Oleg Skworzow zu sehen...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rJqKoxbDBja0HkHEg7PwdhsCvkY.jpg", url:"https://themoviedb.org/person/5202"}}, {tmdbId:"5204", properties:{bornIn:"Wolfratshausen, Germany", imdbId:"0867341", born:date('1962-08-23'), name:"Jürgen Tonkel", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AdK9P9lWYNIiT4g6hIahPpTp6zX.jpg", url:"https://themoviedb.org/person/5204"}}, {tmdbId:"5206", properties:{bornIn:"Gräfelfing, Germany", imdbId:"1177394", born:date('1987-05-20'), name:"Miriam Morgenstern", url:"https://themoviedb.org/person/5206"}}, {tmdbId:"36095", properties:{imdbId:"0225298", name:"William Dick", url:"https://themoviedb.org/person/36095"}}, {tmdbId:"1921151", properties:{imdbId:"0557308", name:"Guy Massey", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z8Mg431ElNJFNjXPxG0VJ0WdTTk.jpg", url:"https://themoviedb.org/person/1921151"}}, {tmdbId:"1925604", properties:{name:"Martha Espinoza", url:"https://themoviedb.org/person/1925604"}}, {tmdbId:"56858", properties:{imdbId:"0490597", name:"Pauline Lau", url:"https://themoviedb.org/person/56858"}}, {tmdbId:"56862", properties:{bornIn:"Shanghai, Cina", imdbId:"2013451", born:date('1981-02-23'), name:"Meme Tian", url:"https://themoviedb.org/person/56862"}}] AS row
