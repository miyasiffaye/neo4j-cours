UNWIND [{tmdbId:"1195289", properties:{imdbId:"0638450", name:"Ronnie Nyakale", url:"https://themoviedb.org/person/1195289"}}, {tmdbId:"1195290", properties:{imdbId:"0581910", name:"Shelley Meskin", url:"https://themoviedb.org/person/1195290"}}, {tmdbId:"1658152", properties:{name:"Darleen Asevedo", url:"https://themoviedb.org/person/1658152"}}, {tmdbId:"49609", properties:{bornIn:" Ayutthaya Province, Thailand", imdbId:"0154083", born:date('1950-12-08'), name:"Sorapong Chatree", bio:"Sorapong Chatree is a Thai film actor.  He has frequently starred in the films of Prince Chatrichalerm Yukol, as well as in Cherd Songsri's classic romance, Plae Kao.  Sorapong became one of the top male stars by the mid 1970s, eventually displacing the older Sombat Metanee from the lead position.  As he aged, he retained his popularity and is well known today as a major supporting actor.  He was named a National Artist of Thailand in 2009...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7xOruSpyxZ0SgZSU7skZ37ayHmh.jpg", url:"https://themoviedb.org/person/49609"}}, {tmdbId:"149861", properties:{name:"Primorata Dejudom", url:"https://themoviedb.org/person/149861"}}, {tmdbId:"19278", properties:{bornIn:"Tulsa, Oklahoma, USA", imdbId:"0352778", born:date('1978-06-07'), name:"Bill Hader", bio:"William \"Bill\" Hader (born June 7, 1978) is an American actor, comedian, producer and writer.  He is best known for his work as a cast member on Saturday Night Live from 2005 to 2013 and for his supporting roles in comedy films such as Superbad, Hot Rod, Tropic Thunder and Adventureland...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8LiP5wHNq3QpwoARquhkGcPSgjM.jpg", url:"https://themoviedb.org/person/19278"}}, {tmdbId:"81681", properties:{bornIn:"Kansas City, Missouri, USA", imdbId:"0641354", born:date('1962-01-17'), name:"Denis O'Hare", bio:"Denis O'Hare (born January 17, 1962) is an American stage and screen actor, best known for his roles in the plays \"Take Me Out\" and \"Sweet Charity\", for his portrayal of vampire Russell Edgington on the television show \"True Blood\" and his different roles in \"American Horror Story\", and for his supporting roles in such films as \"Milk\", \"Changeling\", and \"Dallas Buyers Club\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i1dL9PdMgyQvgfAZNXz2gaiUmn.jpg", url:"https://themoviedb.org/person/81681"}}, {tmdbId:"48700", properties:{bornIn:"Berlin, Germany", imdbId:"0389263", born:date('1938-08-31'), name:"Sylvia Hoffman", url:"https://themoviedb.org/person/48700"}}, {tmdbId:"1200864", properties:{bornIn:"San Bernardino, California, USA", imdbId:"3147751", born:date('1991-08-12'), name:"Keith Stanfield", bio:"Lakeith Lee \"Keith\" Stanfield (born August 12, 1991) is an American actor and rapper.  He made his feature film debut in Short Term 12 (2013), for which he was nominated for an Independent Spirit Award.  In 2014, he co-starred in the horror film The Purge: Anarchy and in the Martin Luther King biopic Selma, as civil right activist Jimmie Lee Jackson.  Stanfield appeared in the film Dope (2015).  He played rapper Snoop Dogg in the biopic about the hip-hop group N. W...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5AykKpsH8DMxIm144ET7fVVTQfw.jpg", url:"https://themoviedb.org/person/1200864"}}, {tmdbId:"77138", properties:{bornIn:"Daylesford, Victoria, Australia", imdbId:"0426170", born:date('1978-01-01'), name:"Samuel Johnson", bio:"Samuel Joseph Johnson OAM (born 1978) is an award winning Australian actor, radio presenter, voiceover artist and philanthropist.  He is best known for his roles in the television series The Secret Life of Us (AFI award - Best Performance by an Actor in a Leading Role TV), Rush, After the Deluge and the miniseries Molly (AACTA Award for Best Lead Actor in a Television Drama)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6ASBf3URfwMnPk5aw0CiLnlxUu9.jpg", url:"https://themoviedb.org/person/77138"}}, {tmdbId:"22809", properties:{bornIn:"London, England, UK", imdbId:"0369954", born:date('1976-02-10'), name:"Keeley Hawes", bio:"Keeley Hawes (born 10 February 1976) is an English actress, born in London and educated at the Sylvia Young Theatre School.  She began her career in a number of literary adaptations, including Our Mutual Friend (1998), Wives and Daughters (1999), Tipping the Velvet (2002), and The Canterbury Tales (2003)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9J1nNawwaoQEC8Egsdk6Y1OJjWW.jpg", url:"https://themoviedb.org/person/22809"}}, {tmdbId:"71070", properties:{bornIn:"Allentown, Pennsylvania, USA ", imdbId:"1086543", born:date('1985-12-03'), name:"Amanda Seyfried", bio:"Amanda Michelle Seyfried (born December 3, 1985) is an American actress and singer.  She began her career as a model when she was 11, then at 15 began an acting career, starting off with uncredited roles and moving on to recurring roles on the soap operas As the World Turns and All My Children.  Amanda is also noted to be an avid fan of the New York Rangers, her favorite player being Ryan McDonagh...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kkWFJ2Ygu6ZcQgrldOnjhHg7WOk.jpg", url:"https://themoviedb.org/person/71070"}}, {tmdbId:"71072", properties:{bornIn:"Central Square, New York, USA", imdbId:"1893071", born:date('1956-01-01'), name:"Nancy Baldwin", bio:"Nancy Baldwin is an American-British film and television actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kGF3vUek0UpQjUfGonuPq1HRyBv.jpg", url:"https://themoviedb.org/person/71072"}}, {tmdbId:"36628", properties:{bornIn:"Mexico City - Mexico", imdbId:"0215487", born:date('1972-10-23'), name:"Kate del Castillo", bio:"From Wikipedia, the free encyclopedia. \n\nKate del Castillo (born October 23, 1972 in Mexico City) is a Mexican actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mC9eL2UrGfVQtcf9EvjX0img4Ms.jpg", url:"https://themoviedb.org/person/36628"}}, {tmdbId:"239574", properties:{bornIn:"Mexico City - Distrito Federal - Mexico", imdbId:"0220240", born:date('1961-09-02'), name:"Eugenio Derbez", bio:"Actor, writer, director and producer, Eugenio has a degree in Film Directing from the Mexican Institute of Cinematography and Theater, as well as a degree in Acting from Televisa's Acting School.  He has also studied and is trained in the arts of Dance, Music and Singing, and still today he continues prepping himself in L. A.  and in New York City...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/947gI1TgtqYRoxcZ2M0RsglBRH9.jpg", url:"https://themoviedb.org/person/239574"}}, {tmdbId:"36638", properties:{bornIn:"Ciudad de México, México", imdbId:"0953197", born:date('1981-11-30'), name:"Maya Zapata", bio:"Maya Zapata is an actress, known for Bordertown (2006), De la calle (2001) and Under the same moon (2007)...", url:"https://themoviedb.org/person/36638"}}, {tmdbId:"17306", properties:{bornIn:"Pittsburgh, Pennsylvania, USA", imdbId:"0704270", born:date('1977-06-02'), name:"Zachary Quinto", bio:"Zachary Quinto is a american actor best known for his roles as the evil Sylar on TV's Heroes and as Spock in the Star Trek Reboot.   In 1999 Quinto graduated from Carnegie Melon's School of Drama, afterwards beginning his career as a television actor.   In 2003, he landed a recurring role on 24, appearing as a computer specialist working for CTU.  Later, in 2006, he began working on Heroes, playing the evil serial killer Sylar...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qFqIaNMcDNd693epUSXo9zOTXev.jpg", url:"https://themoviedb.org/person/17306"}}, {tmdbId:"82647", properties:{imdbId:"0568846", name:"Bruce McFee", url:"https://themoviedb.org/person/82647"}}, {tmdbId:"939224", properties:{imdbId:"4227756", name:"Eric Geleynse", url:"https://themoviedb.org/person/939224"}}, {tmdbId:"31136", properties:{bornIn:"Tappahannock, Virginia, USA", imdbId:"2093097", born:date('1989-05-05'), name:"Chris Brown", bio:"From Wikipedia, the free encyclopedia. \n\nChristopher Maurice \"Chris\" Brown (born May 5, 1989) is an American R&amp;B singer, songwriter, dancer, and actor.  He made his recording debut in late 2005 with the self-titled album Chris Brown at the age of 16.  The album featured the hit single \"Run It!\", which topped the Billboard Hot 100, making Brown the first male artist to have his debut single top the chart since Montell Jordan in 1995...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/92NXoO1129xwDL65KEJUDvgG8iW.jpg", url:"https://themoviedb.org/person/31136"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"939231", properties:{imdbId:"4228202", name:"Susan Ginwalla", url:"https://themoviedb.org/person/939231"}}, {tmdbId:"939232", properties:{imdbId:"4228267", name:"Caroline Pressley", url:"https://themoviedb.org/person/939232"}}, {tmdbId:"59919", properties:{bornIn:"Grays, Essex, England, UK", imdbId:"1258970", born:date('1975-06-04'), name:"Russell Brand", bio:"British comedian, actor, columnist, author and TV & radio personality. \n\nBrand achieved mainstream fame in the UK for presenting a Big Brother spin-off, Big Brother's Big Mouth, and for his radio show, among other television series and award ceremonies.  He is noted for various controversies that have surrounded him in the British media, such as the 2008 prank calls that led to his resignation from the BBC...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7POhMFAcAriFEtOU3lhOUtDAWFC.jpg", url:"https://themoviedb.org/person/59919"}}, {tmdbId:"59292", properties:{imdbId:"2103974", name:"Cécile Breccia", url:"https://themoviedb.org/person/59292"}}, {tmdbId:"37008", properties:{bornIn:"Alpena, Michigan, USA", imdbId:"0809344", born:date('1957-11-02'), name:"Michael Bailey Smith", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nvQbMma1PzxDgjfnECsgYZrw3k6.jpg", url:"https://themoviedb.org/person/37008"}}, {tmdbId:"59293", properties:{bornIn:"Washington, District of Columbia, USA", imdbId:"0438055", born:date('1969-12-14'), name:"Archie Kao", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/f0CpbBJl5JMeMwxZ4IqsLmptCoT.jpg", url:"https://themoviedb.org/person/59293"}}, {tmdbId:"42547", properties:{bornIn:"New York City, New York, USA", imdbId:"0010264", born:date('1955-08-20'), name:"Jay Acovone", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jJR6JKsuwExjUUheA9JlIC7mgY5.jpg", url:"https://themoviedb.org/person/42547"}}, {tmdbId:"151077", properties:{imdbId:"0990452", name:"Terry Chimes", url:"https://themoviedb.org/person/151077"}}, {tmdbId:"31717", properties:{bornIn:"Sioux Falls, South Dakota, USA", imdbId:"0005064", born:date('1978-01-05'), name:"January Jones", bio:"January Kristen Jones (born January 5, 1978) is an American actress.  She is best known for playing Betty Draper on Mad Men and Cadence Flaherty in American Wedding. \n\nDescription above from the Wikipedia article January Jones, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9HYdabnECNzUPG9QcO9qLnZZG8h.jpg", url:"https://themoviedb.org/person/31717"}}, {tmdbId:"589007", properties:{imdbId:"2252767", name:"Gordon Bass", url:"https://themoviedb.org/person/589007"}}, {tmdbId:"1498510", properties:{imdbId:"2258230", name:"Anne Brown", url:"https://themoviedb.org/person/1498510"}}, {tmdbId:"74568", properties:{bornIn:"Melbourne, Victoria, Australia", imdbId:"1165110", born:date('1983-08-11'), name:"Chris Hemsworth", bio:"Chris Hemsworth (born 11 August 1983) is an Australian actor.  He is best known for his roles as Kim Hyde in the Australian TV series Home and Away (2004) and as Thor in the Marvel Cinematic Universe films Thor (2011), The Avengers (2012), Thor: The Dark World (2013), Avengers: Age of Ultron (2015), Thor: Ragnarok (2017), Avengers: Infinity War (2018), Avengers: Endgame (2019), and the upcoming Thor: Love and Thunder (2022)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oSGVmWhn4WT4TI4PCiQrpym6LfW.jpg", url:"https://themoviedb.org/person/74568"}}, {tmdbId:"91606", properties:{bornIn:"Westminster, London, England, UK", imdbId:"1089991", born:date('1981-02-09'), name:"Tom Hiddleston", bio:"Thomas William \"Tom\" Hiddleston is an English actor.  He is known for playing Loki in the Marvel Studios movie series Thor (2011 - 2021) and The Avengers (2012 - 2019)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mclHxMm8aPlCPKptP67257F5GPo.jpg", url:"https://themoviedb.org/person/91606"}}, {tmdbId:"53577", properties:{imdbId:"0199495", name:"Maxwell McCabe-Lokos", url:"https://themoviedb.org/person/53577"}}, {tmdbId:"107185", properties:{imdbId:"0169218", name:"Ari Cohen", url:"https://themoviedb.org/person/107185"}}, {tmdbId:"107186", properties:{imdbId:"0573501", name:"Erin McMurtry", url:"https://themoviedb.org/person/107186"}}, {tmdbId:"63663", properties:{bornIn:"Edmond, Oklahoma, USA", imdbId:"2201055", born:date('1991-03-29'), name:"Hayley McFarland", bio:"Hayley McFarland is an American actress, singer, and dancer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x2JAEC10XI6Ie2sArUzMbe4l2Mh.jpg", url:"https://themoviedb.org/person/63663"}}, {tmdbId:"156342", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0741891", born:date('1964-10-28'), name:"Romy Rosemont", bio:"Romy Rosemont is an American film and television actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dzhrqpUa7W6lVjuigj0G28WrHQz.jpg", url:"https://themoviedb.org/person/156342"}}, {tmdbId:"77700", properties:{bornIn:"Echuca, Victoria, Australia", imdbId:"1379938", born:date('1979-07-15'), name:"Travis Fimmel", bio:"Travis Fimmel (born 15 July 1979) is an Australian actor and former Calvin Klein model who is currently based in the United States...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v8gLLGqFOHMtftmhg6148zKvBPU.jpg", url:"https://themoviedb.org/person/77700"}}, {tmdbId:"93376", properties:{bornIn:"Atlanta, Georgia, USA", imdbId:"2503064", born:date('1989-06-09'), name:"Logan Browning", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3G52qSEQIJgPjsjH59U8pIN9fgb.jpg", url:"https://themoviedb.org/person/93376"}}] AS row
