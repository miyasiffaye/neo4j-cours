UNWIND [{tmdbId:"1153106", properties:{bornIn:"Riyad, Arabia Saudita", imdbId:"5179652", born:date('1999-05-09'), name:"Waad Mohammed", bio:"Waad Mohammed is an actress, known for Wadjda (2012)...", url:"https://themoviedb.org/person/1153106"}}, {tmdbId:"1153107", properties:{imdbId:"5184964", name:"Abdullrahman Al Gohani", url:"https://themoviedb.org/person/1153107"}}, {tmdbId:"1160690", properties:{bornIn:"Riyad, Arabia Saudita", imdbId:"2269188", born:date('1980-11-14'), name:"Ahd", bio:"Ahd is an actress, filmmaker from Saudi Arabia.  She is most well known for her starring role in 2012's high profile festival favorite, critical darling and BAFTA nominee, 'Wadjda', which is Saudi Arabia's first feature film.  The fluently English-speaking, American educated, multi-lingual Saudi Arabian native launched her film career in 2005 with a string of internationally successful short films; all three which have won prestigious festival awards...", url:"https://themoviedb.org/person/1160690"}}, {tmdbId:"64674", properties:{bornIn:"Montreal - Quebec - Canada", imdbId:"0233304", born:date('1968-06-10'), name:"Mike Dopud", bio:"Mike Dopud is a Canadian film actor, television actor, voice actor, stuntman, stage actor and athlete.  He is best known for playing Detective Smits in White Noise the 2005 action-horror film, Agent Turner in Alone in the Dark a 2005 action-horror film, playing Vic Hadfield in the Canadian miniseries Canada Russia '72, and for playing Michael 'The Assassin' in the Rollerball 2002 film remake...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yOYOX3TnIaBrLdkAMznSK6SLY38.jpg", url:"https://themoviedb.org/person/64674"}}, {tmdbId:"121718", properties:{bornIn:"Massachusetts, USA", imdbId:"0131966", born:date('1961-10-13'), name:"Bill Camp", bio:"William \"Bill\" Camp is an American actor.  He is best known for playing Detective Dennis Box in the HBO limited television series The Night Of, for which he was nominated for the Primetime Emmy Award for Outstanding Supporting Actor in a Limited Series or Movie...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yZFata0EVr7TbIAz8vZFyiDKDts.jpg", url:"https://themoviedb.org/person/121718"}}, {tmdbId:"211991", properties:{bornIn:"Fair Lawn, New Jersey, USA", imdbId:"3464684", name:"Philip Ettinger", bio:"Philip Ettinger is an actor and producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bkAEduLHkQg1AZmempKPLpoqibA.jpg", url:"https://themoviedb.org/person/211991"}}, {tmdbId:"554387", properties:{bornIn:"Tokyo Prefecture, Japan", imdbId:"0766493", born:date('1946-07-01'), name:"Masaharu Satô", bio:"Masaharu Satō is a Japanese voice actor affiliated with Aoni Production...", url:"https://themoviedb.org/person/554387"}}, {tmdbId:"1290939", properties:{bornIn:"Jakarta, Indonesia", imdbId:"3022653", born:date('1987-05-01'), name:"Arifin Putra", bio:"Putra Arifin Scheunemann or better known as Arifin Putra (born in Jakarta, May 1, 1987) is an indonesian Actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7hpqIQHYpSsZFoFlQDsmXoaj1VT.jpg", url:"https://themoviedb.org/person/1290939"}}, {tmdbId:"1155281", properties:{bornIn:"Jakarta, Indonesia", imdbId:"1233777", born:date('1963-09-02'), name:"Tio Pakusadewo", bio:"Kanjeng Raden Tumenggung Irwan Susetyo Pakusadewo, better known by the stage name Tio Pakusadewo (born 2 September 1963), is an Indonesian actor.  He has won two Citra Awards for Best Leading Actor at the Indonesian Film Festival, for Lagu untuk Seruni (1990) and Identitas (2008). \n\nTio was born on 2 September 1963 in Jakarta.  He showed interest in the arts at an early age, taking up dance while in elementary school...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uAbKPJPbXVg1pi1bAEEkaMxc0Br.jpg", url:"https://themoviedb.org/person/1155281"}}, {tmdbId:"1154465", properties:{bornIn:"Jakarta - Indonesia", imdbId:"2680798", born:date('1981-07-08'), name:"Oka Antara", bio:"Oka Antara (native name: Nyoman Oka Antara, born: 8 July 1981) is an Indonesian rapper and actor of Balinese descent...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hxa27iexJSLga0x1NNxmpzQLh8V.jpg", url:"https://themoviedb.org/person/1154465"}}, {tmdbId:"47281", properties:{bornIn:"New York, New York, USA", imdbId:"0336701", born:date('1983-08-03'), name:"Mamie Gummer", bio:"Mamie Gummer is an American stage and screen actress.  She graduated of Northwestern University's School of Communications...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iVSSYF6BldRkb2qedkbFo6MvRjv.jpg", url:"https://themoviedb.org/person/47281"}}, {tmdbId:"41089", properties:{bornIn:"Santa Monica, California, U.S.", imdbId:"0771414", born:date('1982-07-30'), name:"Martin Starr", bio:"Martin Starr (born Martin James Pflieger Schienle; July 30, 1982) is an American television and film actor, known for his roles as Bill Haverchuck on the short-lived NBC comedy-drama Freaks and Geeks and as Roman DeBeers on the Starz comedy series Party Down, as well as for his roles in the films Knocked Up, Cheats, and Adventureland. \n\nDescription above from the Wikipedia article Martin Starr, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gNyCdend3C5gY3ucq42Zt3swfg2.jpg", url:"https://themoviedb.org/person/41089"}}, {tmdbId:"564583", properties:{imdbId:"3868664", name:"Alex Shaffer", bio:"Alex Shaffer (born 1993) is an American actor, best known for his role as Kyle Timmons, a troubled kid and a wrestling prodigy, in the 2011 film Win Win...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pBKCr71i3DFnW3qDOop6CVnvJNT.jpg", url:"https://themoviedb.org/person/564583"}}, {tmdbId:"1041480", properties:{bornIn:"Medellín, Colombia", imdbId:"0682138", born:date('1985-07-07'), name:"Juan Piedrahita", bio:"Juan Piedrahita was born on July 7, 1985 in Medellin, Colombia as Juan Carlos Piedrahita.  He is an actor and casting director, known for Magic Mike XXL (2015), Safe Haven (2013) and Wanderlust (2012)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1YaSn3rtzkI4Anwa4owDwJaiALR.jpg", url:"https://themoviedb.org/person/1041480"}}, {tmdbId:"146025", properties:{imdbId:"0085994", name:"Sharon Blackwood", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xX6vMya7A4HNHxrmYZKMOHzCTHp.jpg", url:"https://themoviedb.org/person/146025"}}, {tmdbId:"101687", properties:{bornIn:"Pembroke Pines, Florida, USA", imdbId:"0269035", born:date('1977-01-08'), name:"Alison Faulk", bio:"Alison grew up in South Florida with musician parents.  She found her love of dance at an early age and it hasn’t let up.  She moved to Los Angeles to study on a Joe Tremaine Scholarship and learn about as many dance styles as she could.  This lead to a successful dance career in film, television, and with artists such as Janet Jackson, Britney Spears, Missy Elliot and Miley Cyrus.  She is a proud member of the all female hip-hop crew The Beat Freaks, as well as the Groovaloos...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yePoQDGZFQ0GMCgOd9qbqioJRAT.jpg", url:"https://themoviedb.org/person/101687"}}, {tmdbId:"95102", properties:{bornIn:"Tigard, Portland, Oregon, USA", imdbId:"0647698", born:date('1975-08-18'), name:"Kaitlin Olson", bio:"Kaitlin Olson (born August 18, 1975 height 5' 8\" (1,73 m)) is an American actress best known for playing Deandra \"Sweet Dee\" Reynolds on It's Always Sunny in Philadelphia. \n\nEarly life\n\nOlson was born in Tigard, Oregon.  Her father, Donald Olson, worked as the publisher of the Portland Tribune.  She studied theater at the University of Oregon, and later moved to Los Angeles, California to pursue acting professionally. \n\nCareer\n\nOlson was a part of the improvisational group the Groundlings...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/t8I6YPdmPTBgdY5ymqygCxciMYf.jpg", url:"https://themoviedb.org/person/95102"}}, {tmdbId:"121529", properties:{bornIn:"Passy, Paris, France", imdbId:"2244205", born:date('1985-07-01'), name:"Léa Seydoux", bio:"Léa Seydoux (born 1 July 1985) is a French actress and model.  Along with award-winning performances in French cinema and television, she has appeared in major films including Inglorious Basterds, Robin Hood, Midnight in Paris, and Mission: Impossible – Ghost Protocol.  In 2013 she shared the Palme d'Or prize at the Cannes Film Festival for the film Blue is the Warmest Color.  It was announced early 2014 that Lea will be nominated for the Rising Star Award of the BAFTAs...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lPFPB7l1IQ1TEVoO4rrgV0Lbwk4.jpg", url:"https://themoviedb.org/person/121529"}}, {tmdbId:"586757", properties:{bornIn:"Paris, France", imdbId:"2650819", born:date('1993-11-22'), name:"Adèle Exarchopoulos", bio:"Adèle Exarchopoulos (born 22 November 1993) is a French actress.  She is known for her leading performance as Adèle in Blue Is the Warmest Colour, a role which gave her worldwide attention and critical acclaim and she became the youngest artist ever to be awarded the Palme d'Or at the Cannes Film Festival. \n\nDescription above from the Wikipedia article Adèle Exarchopoulos, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i7PVJb66YDbA41SL3comTqOxRVd.jpg", url:"https://themoviedb.org/person/586757"}}, {tmdbId:"76038", properties:{imdbId:"0426209", born:date('1976-02-29'), name:"Shane Johnson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nEP6UpUQeDHIrbp9kA0URNG77lX.jpg", url:"https://themoviedb.org/person/76038"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"933578", properties:{bornIn:"Ypsilanti, Michigan, USA", imdbId:"3993221", born:date('2005-03-26'), name:"Ella Anderson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/snv9S8ta4DsO1A6TUpa6dFbAtCV.jpg", url:"https://themoviedb.org/person/933578"}}, {tmdbId:"265855", properties:{bornIn:"Toronto, Ontario,  Canada", imdbId:"0682999", born:date('1976-03-15'), name:"Cara Pifko", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oe6Xx56bpVYpcTJJNJFbzN0PWfA.jpg", url:"https://themoviedb.org/person/265855"}}, {tmdbId:"1635717", properties:{name:"Krystal Alvarez", url:"https://themoviedb.org/person/1635717"}}, {tmdbId:"986808", properties:{bornIn:"Los Angeles, California, USA ", imdbId:"0751518", born:date('1986-07-10'), name:"Wyatt Russell", bio:"In less than two years since retiring from hockey following an injury-plagued season with Groningen of the Dutch league, Wyatt Russell has found a new and very interesting line of work.   In one of his first major acting roles, Russell appears in the new film by director Judd Apatow, \"This is 40,\" as a hockey player who flirts with one of the film's stars, Leslie Mann, who also happens to be Apatow's wife...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/f759e6y7uhobWRCmD0O21cBmjBA.jpg", url:"https://themoviedb.org/person/986808"}}, {tmdbId:"1018944", properties:{bornIn:"Edogawa, Tokyo, Japan", imdbId:"2202409", born:date('1992-09-03'), name:"Shôta Sometani", bio:"Shota Sometani (染谷 将太 Sometani Shōta, born 3 September 1992) is a Japanese actor from Koto, Tokyo.  He is known for his protagonist roles in Himizu and Parasyte...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5hYMQ2Z5m35LhcRjAlsPDUMY4bd.jpg", url:"https://themoviedb.org/person/1018944"}}, {tmdbId:"1018945", properties:{bornIn:"Naha City, Okinawa, Japan", imdbId:"3049403", born:date('1994-09-21'), name:"Fumi Nikaidô", bio:"Fumi Nikaidō (二階堂 ふみ Nikaidō Fumi, born 21 September 1994) is a Japanese actress and fashion model...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tqxgrZdOpx2FuTJYlhago4fttI3.jpg", url:"https://themoviedb.org/person/1018945"}}, {tmdbId:"19394", properties:{bornIn:"New York, New York, United States", imdbId:"0579953", born:date('1971-05-30'), name:"Idina Menzel", bio:"Idina Menzel (/ɪˈdiːnə mɛnˈzɛl/; born Idina Kim Mentzel; May 30, 1971) is an American actress, singer, and songwriter.  She rose to prominence for her performance as Maureen Johnson in the Broadway musical Rent, a role which she reprised for the 2005 feature film adaptation.  In 2004, she won the Tony Award for originating the role of Elphaba in the Broadway blockbuster Wicked.  In 2014, she will be returning to Broadway in the musical If/Then...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eGsyJmAZNV5tUU4RYy2DIRlFVpW.jpg", url:"https://themoviedb.org/person/19394"}}, {tmdbId:"69399", properties:{bornIn:"Northfield, Minnesota, USA", imdbId:"0005016", born:date('1977-04-30'), name:"Alexandra Holden", bio:"Alexandra Holden (born April 30, 1977) is an American film and television actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iyEimHNN11NgF1n6dX08wk5BqxB.jpg", url:"https://themoviedb.org/person/69399"}}, {tmdbId:"64497", properties:{imdbId:"1050125", born:date('1978-05-25'), name:"Jung-Jin Lee", bio:"Lee Jung-jin, (born May 25, 1978) is a South Korean actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2n7ONAmdXUXTGj4pJhUkWhgpCCU.jpg", url:"https://themoviedb.org/person/64497"}}, {tmdbId:"1680744", properties:{imdbId:"4237872", name:"Eunjin Kang", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lrKO3I6rbUTX4du7L99s3kTPecM.jpg", url:"https://themoviedb.org/person/1680744"}}, {tmdbId:"965819", properties:{imdbId:"3124890", name:"Finley Jacobsen", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jb5V4NPK0rSxQ7KH6PxftVhQLW8.jpg", url:"https://themoviedb.org/person/965819"}}, {tmdbId:"1169852", properties:{bornIn:"Bradford, West Yorkshire, England, UK ", imdbId:"5519350", born:date('1998-06-08'), name:"Conner Chapman", url:"https://themoviedb.org/person/1169852"}}, {tmdbId:"1169853", properties:{imdbId:"5649091", name:"Shaun Thomas", url:"https://themoviedb.org/person/1169853"}}, {tmdbId:"202032", properties:{bornIn:"Leeds - West Yorkshire - England - UK", imdbId:"0408591", born:date('1969-12-15'), name:"Ralph Ineson", bio:"Ralph Michael Ineson (born 15 December 1969) is an English actor.  He played Chris Finch on the BBC television programmeme The Office.  He has a strong Yorkshire accent and is a supporter of Leeds United...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sn3ONJw2pJxMHiCqPwvkaiWr5mc.jpg", url:"https://themoviedb.org/person/202032"}}, {tmdbId:"11285", properties:{imdbId:"0121090", name:"Ian Burfield", bio:"Ian Burfield is a British stage, film and television actor and writer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/g8Nuj7mPcTZLhAN6HW5uhZf13Ja.jpg", url:"https://themoviedb.org/person/11285"}}, {tmdbId:"996636", properties:{imdbId:"1596318", name:"Riaad Moosa", url:"https://themoviedb.org/person/996636"}}, {tmdbId:"1223463", properties:{imdbId:"4083781", name:"Keene McRae", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vKxk1o3fFGVLFbmwcacuThWyDGj.jpg", url:"https://themoviedb.org/person/1223463"}}, {tmdbId:"1161962", properties:{bornIn:"Iowa City, Iowa, USA", imdbId:"1914631", born:date('1968-12-09'), name:"Brian Bell", bio:"Brian Lane Bell is an American guitarist,  singer, songwriter and actor.  He is best known as the rhythm guitarist,  backing vocalist and occasional lead vocalist of the alternative rock band Weezer, with whom he has recorded ten studio albums.  Bell also fronts the rock band The Relationship, and was previously the lead vocalist and guitarist of the indie rock band Space Twins...", url:"https://themoviedb.org/person/1161962"}}, {tmdbId:"1401537", properties:{bornIn:"Owasso, Oklahoma, USA", imdbId:"3790547", born:date('1991-04-20'), name:"Reese Mishler", bio:"As a youngster, growing up in Owasso, OK, Reese Mishler planned to someday play for his favorite football team, the Dallas Cowboys.  Those dreams were sidelined, however, when he suffered a broken pelvis in a game and it failed to heal correctly.  It was then that his mother suggested he try acting...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h1MNdX2n3zlhPGc1fnZ5rnTTKQ0.jpg", url:"https://themoviedb.org/person/1401537"}}, {tmdbId:"1401536", properties:{imdbId:"6018502", name:"Pfeifer Brown", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5O7h56LjoEvdOBTLb8vgdBjKWIV.jpg", url:"https://themoviedb.org/person/1401536"}}] AS row
