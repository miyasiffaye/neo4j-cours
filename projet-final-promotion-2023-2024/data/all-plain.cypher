UNWIND [{tmdbId:"30020", properties:{bornIn:"St. Charles, Illinois", imdbId:"0625621", born:date('1964-10-11'), name:"Michael J. Nelson", bio:"Michael J.  Nelson is the former host and writer of the Emmy-nominated, Peabody Award-winning Mystery Science Theater 3000.  Since that time, he has appeared on numerous radio and TV shows, penned a regular column for TV Guide, and authored best-selling books for both HarperCollins and Abrams. \n\nHis first book, Mike Nelson's Movie Megacheese, thrilled critics, including Richard Schickel of Time Magazine, who said of Mike, \"He's more fun than a barrel of Val Kilmers. . ...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8yCJVVFtkrh6VmAnSBbmM9yqzYc.jpg", url:"https://themoviedb.org/person/30020"}}, {tmdbId:"30022", properties:{bornIn:"River Forest - Illinois - USA", imdbId:"0614436", born:date('1956-11-03'), name:"Kevin Murphy", bio:"Kevin Murphy was born on November 3, 1956 in River Forest, Illinois, USA as Kevin Wagner Murphy.  He is an actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/s1REGBYFGc2Ibo7QlQ95cbjaq2m.jpg", url:"https://themoviedb.org/person/30022"}}, {tmdbId:"8395", properties:{bornIn:"Mansfield, Ohio, USA", imdbId:"0000580", born:date('1966-10-11'), name:"Luke Perry", bio:"Luke Perry (born Coy Luther Perry III; October 11, 1966 – March 4, 2019) was an American actor. \n\nPerry starred as Dylan McKay on the TV series Beverly Hills, 90210, a role he played from 1990–95, and then from 1998–2000.  Much publicity was garnered over the fact that even though he was playing a sixteen-year-old when 90210 began, Perry was actually in his mid twenties at that time...", died:date('2019-03-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1M1HIpOYeRpWGQBLwGlPcuHNKsk.jpg", url:"https://themoviedb.org/person/8395"}}, {tmdbId:"4943", properties:{bornIn:"Wilmette, Illinois, USA", imdbId:"0949340", born:date('1956-04-22'), name:"Bruce A. Young", bio:"Bruce A.  Young (born April 22, 1956) is an American television and film actor who is perhaps best known for his role as Capt.  Simon Banks in the UPN sci-fi police drama The Sentinel.  He also played mercenary M. B.  Nash in Jurassic Park III.  In addition, he played the character of Moselle, a pool player who loses to Vince (played by Tom Cruise), in The Color of Money...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fzhTbUwKysg8PH9CSSVJByzHvwW.jpg", url:"https://themoviedb.org/person/4943"}}, {tmdbId:"108717", properties:{bornIn:"Greenwich - Connecticut - USA", imdbId:"0874082", born:date('1966-07-31'), name:"Jim True-Frost", bio:"​From Wikipedia, the free encyclopedia\n\nJim True-Frost, born Jim True, (born July 31, 1966) is an American stage, television and screen actor.  He is most known for his portrayal of Roland \"Prez\" Pryzbylewski on all five seasons of the HBO program The Wire. \n\nDescription above from the Wikipedia article Jim True-Frost, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6ta8BGWoQixf8oRZblnQLJyTVOV.jpg", url:"https://themoviedb.org/person/108717"}}, {tmdbId:"52404", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0926165", born:date('1988-06-09'), name:"Mae Whitman", bio:"Mae Margaret Whitman (born June 9, 1988) is an American television, movie and voice actress.  She is known for her role as Ann Veal in the TV series Arrested Development, her role as Roxy Richter in Scott Pilgrim vs.  the World, and for her voice work as Katara in the animated television series Avatar: The Last Airbender, Rose/Huntsgirl in American Dragon: Jake Long, and Tinker Bell in the Tinker Bell movies...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hO1xLbFrfQLKH3Ln8eqjySgtxHX.jpg", url:"https://themoviedb.org/person/52404"}}, {tmdbId:"15789", properties:{bornIn:"Santa Barbara, California, U.S.", imdbId:"0513281", born:date('1989-01-03'), name:"Alex D. Linz", bio:"From Wikipedia, the free encyclopedia. \n\nAlexander David Linz (born January 3, 1989) is an American actor who starred in several late 1990s and early 2000s films and television programs as a child actor.  His notable film roles include Home Alone 3 (1997) and Max Keeble's Big Move (2001). \n\nDescription above from the Wikipedia article Alex D.  Linz, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pem026eNKMUMnCEVXZf5T5yjH64.jpg", url:"https://themoviedb.org/person/15789"}}, {tmdbId:"7404", properties:{bornIn:"Bedford, New Hampshire, USA", imdbId:"0798971", born:date('1970-12-01'), name:"Sarah Silverman", bio:"Sarah Silverman (born December 1, 1970) is an American comedian, writer, actress, singer and musician.   Silverman first gained notice as a writer and occasional performer on Saturday Night Live.  She starred in and produced The Sarah Silverman Program...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/g5G711XyVokJm2RoItpkaHa8mkQ.jpg", url:"https://themoviedb.org/person/7404"}}, {tmdbId:"14409", properties:{bornIn:"Astoria, New York, États-Unis", imdbId:"0001710", born:date('1966-11-02'), name:"David Schwimmer", bio:"David Lawrence Schwimmer (born November 2, 1966) is an American actor and director of television and film.  He was born in New York, and his family moved to Los Angeles when he was two.  He began his acting career performing in school plays at Beverly Hills High School.  In 1988, he graduated from Northwestern University with a Bachelor of Arts degree in theater and speech.  After graduation, Schwimmer co-founded the Lookingglass Theatre Company...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oBsK1ql5bo3zxepbQCclIwnapXM.jpg", url:"https://themoviedb.org/person/14409"}}, {tmdbId:"118131", properties:{imdbId:"0930617", name:"Gareth Williams", url:"https://themoviedb.org/person/118131"}}, {tmdbId:"1221828", properties:{imdbId:"0163199", name:"Dick Clay", url:"https://themoviedb.org/person/1221828"}}, {tmdbId:"18235", properties:{imdbId:"0364126", name:"Brett Harrelson", url:"https://themoviedb.org/person/18235"}}, {tmdbId:"1304440", properties:{imdbId:"0328937", name:"Mark Goodin", url:"https://themoviedb.org/person/1304440"}}, {tmdbId:"116341", properties:{bornIn:"Hope, Arkansas, USA", imdbId:"0001051", born:date('1946-08-19'), name:"Bill Clinton", bio:"William Jefferson \"Bill\" Clinton (born William Jefferson Blythe III; August 19, 1946) is an American politician who served as the 42nd President of the United States from 1993 to 2001.  Before that, he was Governor of the state of Arkansas.  Inaugurated at age 46, he was the third-youngest president.  He took office at the end of the Cold War, and was the first president of the baby boomer generation...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yNiUYIShDh9NoiCKJbcDChJ4q2a.jpg", url:"https://themoviedb.org/person/116341"}}, {tmdbId:"1922", properties:{bornIn:"Swansea, West Glamorgan, Wales, UK", imdbId:"0001876", born:date('1969-09-25'), name:"Catherine Zeta-Jones", bio:"Catherine Zeta-Jones, CBE, (born 25 September 1969) is a Welsh actress.  She began her career on stage at an early age.  After starring in a number of United Kingdom and United States television films and small roles in films, she came to prominence with roles in Hollywood movies such as the 1998 action film The Mask of Zorro and the 1999 crime thriller film Entrapment...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eDSWpj0r7RKt2V5PxOyXJTJvErV.jpg", url:"https://themoviedb.org/person/1922"}}, {tmdbId:"79539", properties:{imdbId:"0394191", born:date('1973-08-23'), name:"Jermaine 'Huggy' Hopkins", url:"https://themoviedb.org/person/79539"}}, {tmdbId:"1385303", properties:{imdbId:"0435658", name:"Claudia Kaleem", url:"https://themoviedb.org/person/1385303"}}, {tmdbId:"1385304", properties:{imdbId:"0580753", name:"Candice Merideth", url:"https://themoviedb.org/person/1385304"}}, {tmdbId:"1385305", properties:{imdbId:"0172123", name:"Alma Collins", url:"https://themoviedb.org/person/1385305"}}, {tmdbId:"14722", properties:{bornIn:"New York City, New York, USA", imdbId:"0275890", born:date('1965-02-05'), name:"Arabella Field", url:"https://themoviedb.org/person/14722"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"5315", properties:{bornIn:" France", imdbId:"0858284", born:date('1991-07-06'), name:"Victoire Thivisol", bio:"​From Wikipedia, the free encyclopedia.   \n\nVictoire Thivisol (born July 6, 1991 in France) is a film actress. \n\nShe first gained acclaim for her role as a child coping with her mother's death in the 1996 film, Ponette and became the youngest actress to win the Volpi Cup Best Actress Award at the Venice Film Festival.  She later went on to star in Children of the Century and Chocolat (2000), both as the daughter of Juliette Binoche...", url:"https://themoviedb.org/person/5315"}}, {tmdbId:"120627", properties:{imdbId:"0771754", name:"Delphine Schiltz", url:"https://themoviedb.org/person/120627"}}, {tmdbId:"1158431", properties:{imdbId:"0146262", name:"Matiaz Bureau Caton", url:"https://themoviedb.org/person/1158431"}}, {tmdbId:"37189", properties:{imdbId:"0785680", born:date('1988-07-14'), name:"Léopoldine Serre", url:"https://themoviedb.org/person/37189"}}, {tmdbId:"3398", properties:{bornIn:"Copenhagen, Denmark", imdbId:"0091035", born:date('1965-04-12'), name:"Kim Bodnia", bio:"Kim Bodnia is a Danish actor, writer, and director.  He became widely known for his role as police detective Martin Rohde in the Scandinavian crime drama series The Bridge.  He is also known for playing the lead role in Nicolas Winding Refn's directorial debut Pusher...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/koWU6vb82cuCDLeYE1erqnQ39cW.jpg", url:"https://themoviedb.org/person/3398"}}, {tmdbId:"31960", properties:{bornIn:"Osijek, Croazia", imdbId:"0121519", born:date('1953-05-13'), name:"Zlatko Buric", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3I9G3Fl4JHzvZgmaKMwMW1hjAyN.jpg", url:"https://themoviedb.org/person/31960"}}, {tmdbId:"21192", properties:{bornIn:"Nørrebro, Denmark", imdbId:"0237200", born:date('1974-12-22'), name:"Laura Drasbæk", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/siZJnSSbFlEWQvpCfzxCPDHkr0C.jpg", url:"https://themoviedb.org/person/21192"}}, {tmdbId:"3411", properties:{bornIn:"Kolasin, Montenegro", imdbId:"0479637", born:date('1962-11-17'), name:"Slavko Labovic", bio:"Slavko Labović is a Serbian-Danish actor most popular for the role as a Serbian gangster in the Pusher trilogy. \n\nSlavko was born to Serbian Orthodox parents in Kolašin; he and his mother left their village, to join his father in Denmark.  Slavko came to Ballerup, Denmark as a four-year old, together with his siblings. Slavko made his film debut in 1996, as a gangster in Pusher, which boosted his career in Danish cinema...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zUiBgsZQTaSJnNISjMIIfkkohwP.jpg", url:"https://themoviedb.org/person/3411"}}, {tmdbId:"33239", properties:{bornIn:"Los Angeles, California,", imdbId:"0634509", born:date('1986-06-20'), name:"Brawley Nolte", bio:"Brawley Nolte was born on June 20, 1986 in Los Angeles, California, USA as Brawley King Nolte.  He is an actor and producer, known for Ransom (1996), Affliction (1997) andMother Night (1996).  He has been married to Navi Rawatsince September 22, 2012...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uiBmcOVwUxXdggosz5ptv3GJK7N.jpg", url:"https://themoviedb.org/person/33239"}}, {tmdbId:"96043", properties:{bornIn:"London, England", imdbId:"0871406", born:date('1970-04-27'), name:"Kylie Travis", bio:"From Wikipedia, the free encyclopedia. \n\nKylie Travis (born 27 April 1966) is an Australian actress. \n\nTravis was born in London, England; her family moved to Australia shortly afterward.  She modelled for various agencies in Paris, London, and New York before taking up acting.  Her first major role was in the Aaron Spelling TV series Models Inc where she played the part of Julie, a bitchy yet loyal model...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gOsADP8B8oR3a3WccloyuV1YR2F.jpg", url:"https://themoviedb.org/person/96043"}}, {tmdbId:"81287", properties:{bornIn:"Green Lake, Wisconsin, US", imdbId:"0924204", born:date('1964-11-07'), name:"Shannon Whirry", bio:"Shannon Whirry (born November 7, 1964) is an American actress. \n\nDescription above from the Wikipedia article Shannon Whirry, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/81287"}}, {tmdbId:"2296", properties:{bornIn:"Keresley, Coventry, Warwickshire, England, UK", imdbId:"0654110", born:date('1964-10-03'), name:"Clive Owen", bio:"Clive Owen (born 3 October 1964) is an English actor, who has worked on television, stage and film.  He first gained recognition in the United Kingdom for portraying the lead in the ITV series Chancer from 1990 to 1991.  He then garnered critical acclaim for his work in the film Close My Eyes (1991) before getting international notice for his performance as a struggling writer in Croupier (1998)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7rHcMDING3PpiuhVpXW0DwNBmAd.jpg", url:"https://themoviedb.org/person/2296"}}, {tmdbId:"13936", properties:{bornIn:"Newport News, Virginia, USA", imdbId:"0265670", born:date('1949-06-10'), name:"Frankie Faison", bio:"Frankie Faison is an American stage and screen actor, best known for his role as Deputy Commissioner Ervin Burrell in HBO's television series \"The Wire\", and as Barney Matthews in the \"Hannibal Lecter\" franchise.  He studied Drama at Wesleyan University, Bloomington, Illinois, and graduated from New York Universities' Acting Program...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3717JOXK2Z8qelfyvScDGimfFBf.jpg", url:"https://themoviedb.org/person/13936"}}, {tmdbId:"48576", properties:{bornIn:"Saint-Mandé, Seine [now Val-de-Marne], France", imdbId:"0075650", born:date('1958-04-30'), name:"Charles Berling", bio:"Charles Berling (born 30 April 1958) is a French actor, director and screenwriter. \n\nSon of a navy doctor, he is also the nephew of the literary critic Raymond Picard.  His mother, Nadia, \"only daughter of (French) settlers in Morocco\" was born in Meknes (Morocco); she died in 2004. \n\nWhen he was two years old he left Paris for Brest, then Toulon, then, at seven, Tahiti. \n\nHe studied acting at the Belgian university INSAS, in Brussels.  He is the father of the actor Émile Berling...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/anSOtiRSQ0iG0c9sCajiN8OGtZ0.jpg", url:"https://themoviedb.org/person/48576"}}, {tmdbId:"73937", properties:{bornIn:"Paris, France", imdbId:"0002105", born:date('1972-03-23'), name:"Judith Godrèche", bio:"From Wikipedia, the free encyclopedia  Judith Godrèche (born March 23, 1972) is a French actress and author, born in Paris.  She has appeared in more than 30 films between 1985 and 2009.   Description above from the Wikipedia article Judith Godrèche,licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wtoYVeYdi0Uv00eFbtEvUZCdEge.jpg", url:"https://themoviedb.org/person/73937"}}, {tmdbId:"34691", properties:{bornIn:"New York City, New York, USA", imdbId:"0817983", born:date('1946-12-20'), name:"John Spencer", bio:"From Wikipedia, the free encyclopedia\n\nJohn Spencer (December 20, 1946 – December 16, 2005) was an American television actor.  He was most widely known for playing White House Chief of Staff Leo McGarry on the NBC political drama series The West Wing, which earned him an Emmy Award in 2002. \n\nDescription above from the Wikipedia article John Spencer (actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2005-12-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5VRPtXSLzKqpQiVbfsvtGbGU3AP.jpg", url:"https://themoviedb.org/person/34691"}}, {tmdbId:"6194", properties:{bornIn:"Manhattan, New York, USA", imdbId:"0000132", born:date('1979-04-12'), name:"Claire Danes", bio:"An American actress of television, stage and film.  She has appeared in roles as diverse as Angela Chase in My So-Called Life, as Juliet in Baz Luhrmann's Romeo + Juliet, as Yvaine in Stardust and as Temple Grandin in the HBO TV film Temple Grandin. \n\nDescription above from the Wikipedia article Claire Danes, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dZnZbqClPVl4glqAR5nTEIftQ1c.jpg", url:"https://themoviedb.org/person/6194"}}, {tmdbId:"6195", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0674782", born:date('1963-08-07'), name:"Harold Perrineau", bio:"Harold Perrineau (born August 7, 1963) is an American actor known for the roles of Michael Dawson in  the U. S.  television series Lost, Link in The Matrix films and games, Augustus Hill in the American  television series Oz, and Mercutio in Baz Luhrmann's Romeo + Juliet.  He recently starred in ABC's  comedy-drama television series The Unusuals, playing NYPD homicide detective Leo Banks...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8x1aoTRnUpx4AHc1fQSzGWGJhGs.jpg", url:"https://themoviedb.org/person/6195"}}, {tmdbId:"130129", properties:{bornIn:"New York City, New York, USA", imdbId:"0823155", born:date('1954-06-05'), name:"Don Stark", bio:"Don Stark was born on July 5, 1954 in New York City, New York, USA as Donald Stark.  He is an actor and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lkPWvElz5RxR4t4v3hM4SRy5E1j.jpg", url:"https://themoviedb.org/person/130129"}}, {tmdbId:"1819", properties:{bornIn:"New York Mills, New York", imdbId:"0193495", born:date('1956-06-15'), name:"Robin Curtis", bio:"Robin Curtis is an American real estate broker and actress.  She is most notable for replacing Kirstie Alley in the role of Vulcan Lieutenant Saavik in the films Star Trek III: The Search for Spock and Star Trek IV: The Voyage Home. \n\nAlthough her first appearance as Vulcan Lieutenant Saavik in Star Trek III: The Search for Spock was promoted as being her film debut, in fact Curtis had already made several film and made-for-television movie appearances...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/flSPFiJ4wE6WgI1mVqHp3wJtDYO.jpg", url:"https://themoviedb.org/person/1819"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"83187", properties:{bornIn:"New Orleans - Louisiana - USA", imdbId:"0606541", born:date('1937-02-01'), name:"Garrett Morris", bio:"From Wikipedia, the free encyclopedia. \n\nGarrett Gonzalez Morris (born February 1, 1937 height 5' 8\" (1,73 m)) is an Americancomedian and actor.  He was part of the original cast of the sketch comedy program Saturday Night Live, appearing from 1975 to 1980. \n\nMorris was a church-choir singer from his youth, trained at the Juilliard School of Music, and graduated from Dillard University in 1958.  Early in his career, he soloed with the Harry Belafonte singers...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sQKZT393FfkiKLwerDV3Yki0C3b.jpg", url:"https://themoviedb.org/person/83187"}}, {tmdbId:"80481", properties:{imdbId:"0021038", name:"Scott Allen", url:"https://themoviedb.org/person/80481"}}, {tmdbId:"12831", properties:{bornIn:"Rutherfordton, North Carolina", imdbId:"0105280", born:date('1955-09-20'), name:"Betsy Brantley", bio:"From Wikipedia, the free encyclopedia\n\nBetsy Brantley (born September 20, 1955) is an American actress. \n\nBrantley was born Rutherfordton, North Carolina.  She is the older sister of producer/screenwriter Duncan Brantley, and formerly married to Simon Dutton and Steven Soderbergh. \n\nBetsy studied acting at the Central School of Speech and Drama in the United Kingdom.  It was there that she was discovered to film a movie with Sean Connery titled, Five Days One Summer...", url:"https://themoviedb.org/person/12831"}}, {tmdbId:"1567208", properties:{bornIn:"Abbeville, Louisiana, United States", imdbId:"0178385", born:date('1960-01-01'), name:"Silas Cooper", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i3y4kuWJdYKgfLfpz0fJTsgwcSH.jpg", url:"https://themoviedb.org/person/1567208"}}, {tmdbId:"10827", properties:{imdbId:"0909384", name:"Kevin Patrick Walls", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yDixh6zfvP7tvZzlWvSYv7Tq2Fj.jpg", url:"https://themoviedb.org/person/10827"}}, {tmdbId:"101312", properties:{imdbId:"0095673", name:"David Booth", url:"https://themoviedb.org/person/101312"}}, {tmdbId:"9191", properties:{bornIn:"Battersea, London, England, UK", imdbId:"0001758", born:date('1957-02-27'), name:"Timothy Spall", bio:"Timothy Leonard Spall, OBE (born 27 February 1957) is an English character actor and occasional presenter...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zDXpquJ2lmXh9rYlyzIL9L7REfw.jpg", url:"https://themoviedb.org/person/9191"}}, {tmdbId:"127164", properties:{bornIn:"Paisley, Renfrewshire, Scotland, UK", imdbId:"0517642", born:date('1956-01-11'), name:"Phyllis Logan", bio:"​From Wikipedia, the free encyclopedia.   \n\nPhyllis Logan (born 11 January 1956) is a Scottish actress. \n\nDescription above from the Wikipedia article Phyllis Logan, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jRNfzD3bA5fyPxXRTiDbfNsTcOV.jpg", url:"https://themoviedb.org/person/127164"}}, {tmdbId:"68384", properties:{bornIn:"Hitchin, Hertfordshire, England", imdbId:"0750718", born:date('1971-08-25'), name:"Claire Rushbrook", bio:"Attended Rose Bruford College, where she studied acting...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/owoQiLTK1eSCp9H52icJK2WH63g.jpg", url:"https://themoviedb.org/person/68384"}}, {tmdbId:"2535", properties:{bornIn:"South Bend, Indiana, USA", imdbId:"0000407", born:date('1964-07-30'), name:"Vivica A. Fox", bio:"Vivica Anjanetta Fox (born July 30, 1964) is an American actress and television producer.  She is best known for her roles in the films Independence Day, Set It Off, Soul Food, Why Do Fools Fall In Love, and Kill Bill: Vol.  1.    Fox, who is of African American and Native American descent, was born in South Bend, Indiana, the daughter of Everlyena and William Fox...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pAHM3Mc1RrWc7fkwheuU3RAezKY.jpg", url:"https://themoviedb.org/person/2535"}}, {tmdbId:"55314", properties:{bornIn:"Minneapolis, Minnesota, United States", imdbId:"0253708", born:date('1967-04-17'), name:"Kimberly Elise", bio:"Kimberly Elise was born on April 17, 1967 in Minneapolis, Minnesota, USA.  Elise studied film and acting at the University of Minnesota and earned a BA in Mass Communications.  She is best known for her role in the films Set It Off, John Q, and Diary of a Mad Black Woman.  Her most recent film role was in Tyler Perry's For Colored Girls (2010), as the battered wife Crystal.  Elise is a four-time NAACP Image Award winner...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pAYWZdsWYrGc9lvMCivUU7STSWf.jpg", url:"https://themoviedb.org/person/55314"}}, {tmdbId:"68703", properties:{imdbId:"0476195", name:"Tamiyo Kusakari", url:"https://themoviedb.org/person/68703"}}, {tmdbId:"68704", properties:{bornIn:"Kanazawa-ku, Yokohama, Kanagawa Prefecture, Japan", imdbId:"0847562", born:date('1956-03-20'), name:"Naoto Takenaka", bio:"​From Wikipedia, the free encyclopedia\n\nNaoto Takenaka (March 20, 1956 ) is a Japanese actor, comedian, singer, and director from Kanazawa-ku, Yokohama, Kanagawa Prefecture affiliated with From First Production.  He is married to idol singer and actress Midori Kinouchi. \n\nDescription above from the Wikipedia article Naoto Takenaka, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sm17CU4kPDVcRRO6NJNE35LHMQl.jpg", url:"https://themoviedb.org/person/68704"}}, {tmdbId:"68705", properties:{bornIn:"Yamagata, Japan", imdbId:"0913794", born:date('1955-01-05'), name:"Eri Watanabe", bio:"Eri Watanabe (渡辺 えり), born Eriko Tsuchiya (土屋えり子), is a Japanese actress.   Her previous professional name was Eriko Watanabe (渡辺 えり子)...", url:"https://themoviedb.org/person/68705"}}, {tmdbId:"69298", properties:{bornIn:"White Plains, New York, USA", imdbId:"0569458", born:date('1972-08-10'), name:"Michael McGlone", bio:"From Wikipedia, the free encyclopedia. \n\nMike McGlone is an American actor, singer and songwriter. \n\nHe is perhaps best known as the film noiresque spokesman for GEICO insurance posing rhetorical questions in the vein of Robert Stack or Rod Serling, which are then acted out in humorous fashion. \n\nMcGlone's best-known film credits include two castings as writer/actor/director/producer Edward Burns's brother in 1995's \"The Brothers McMullen\" and 1996's \"She's the One\" (opposite Jennifer Aniston)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bA4VNmTIFPBMxnf7NWai525PB6v.jpg", url:"https://themoviedb.org/person/69298"}}, {tmdbId:"118", properties:{bornIn:"Toowoomba, Queensland, Australia", imdbId:"0001691", born:date('1951-07-06'), name:"Geoffrey Rush", bio:"Geoffrey Roy Rush (born 6 July 1951) is an Australian actor and film producer.  As of November 2009, he was one of 25 people to have won the \"Triple Crown of Acting\": an Academy Award, a Tony Award and an Emmy Award.  Apart from being nominated for 4 Academy Awards for acting (winning 1) and 5 BAFTA Awards (winning 3), he has also won 2 Golden Globe and 3 Screen Actors Guild Awards...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/npXFjaFQzBNroCEPllGPTZ5IisA.jpg", url:"https://themoviedb.org/person/118"}}, {tmdbId:"1192652", properties:{imdbId:"0104051", name:"Justin Braine", url:"https://themoviedb.org/person/1192652"}}, {tmdbId:"1192653", properties:{imdbId:"0865286", born:date('1959-01-01'), name:"Sonia Todd", url:"https://themoviedb.org/person/1192653"}}, {tmdbId:"8289", properties:{bornIn:"Manhasset, New York, USA", imdbId:"0001082", born:date('1968-07-08'), name:"Billy Crudup", bio:"William Gaither Crudup (born July 8, 1968) is an American actor.  He is known for supporting roles in films including Almost Famous, Big Fish, Mission: Impossible III, Watchmen, Public Enemies, Spotlight, and Alien: Covenant, as well as lead roles in films including Without Limits, Dedication, and the animated film Princess Mononoke.  He appeared in the 2017 superhero film Justice League as Doctor Henry Allen. \n\nHe has also had an extensive stage acting career, appearing mostly on Broadway...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pYblSarjmmIUggmOafanD2yk0Zj.jpg", url:"https://themoviedb.org/person/8289"}}, {tmdbId:"20309", properties:{bornIn:"Pikeville - Kentucky - USA", imdbId:"0948267", born:date('1956-10-23'), name:"Dwight Yoakam", bio:"From Wikipedia, the free encyclopedia. \n\nDwight David Yoakam (born October 23, 1956) is an American singer-songwriter, actor and film director, most famous for his pioneering country music.  Popular since the early 1980s, he has recorded more than twenty-one albums and compilations, has charted more than thirty singles on the Billboard Hot Country Songs charts, and sold more than 25 million records...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lMqcRiQs2OELf0xvFbLbX4nnXi8.jpg", url:"https://themoviedb.org/person/20309"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"936520", properties:{bornIn:"Hollywood, California, US", imdbId:"0589498", born:date('1924-10-15'), name:"Warren Miller", bio:"Warren Miller is an American ski and snowboarding filmmaker.  He is the founder of Warren Miller Entertainment and produced, directed and narrated his films until 1988.  His credits include over 750 sports films, several books and hundreds of published non-fiction stories.  His annual films on skiing and other outdoor sports are renowned for their stunning photography, witty narrative humor, and the impressive talents of athletes...", died:date('2018-01-24'), url:"https://themoviedb.org/person/936520"}}, {tmdbId:"12852", properties:{bornIn:"Lamesa, Texas. USA", imdbId:"0179224", born:date('1940-10-16'), name:"Barry Corbin", bio:"Barry Corbin is an American film and television actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/38AilHla20EFhEYAqoz6EzfsrQf.jpg", url:"https://themoviedb.org/person/12852"}}, {tmdbId:"23678", properties:{bornIn:"Brooklyn, New York, U.S.", imdbId:"0003044", born:date('1963-02-17'), name:"Michael Jordan", bio:"​From Wikipedia, the free encyclopedia.   \n\nMichael Jeffrey Jordan (born February 17, 1963) is a former American professional basketball player, active businessman, and majority owner of the Charlotte Hornets.  His biography on the National Basketball Association (NBA) website states, \"By acclamation, Michael Jordan is the greatest basketball player of all time...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tCqjwlROe98wYbcRhCcp3qYsUc5.jpg", url:"https://themoviedb.org/person/23678"}}, {tmdbId:"2657652", properties:{name:"Manner Washington", url:"https://themoviedb.org/person/2657652"}}, {tmdbId:"37045", properties:{bornIn:"Worthing, Sussex, England, UK", imdbId:"0001733", born:date('1963-11-21'), name:"Nicollette Sheridan", bio:"Nicollette Sheridan (born November 21, 1963) is a British television actress.  She is best known for her roles on Desperate Housewives and Knots Landing...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5jClu0aOq5hLzXa0ic3NoZBuZG4.jpg", url:"https://themoviedb.org/person/37045"}}, {tmdbId:"96974", properties:{bornIn:"Florence, Tuscany, Italy", imdbId:"0147605", born:date('1939-01-25'), name:"Carlo Cecchi", bio:"From Wikipedia, the free encyclopedia. \n\nCarlo Cecchi (born January 25, 1939) is an Italian actor. \n\nBorn in Florence, Cecchi studied under the Living Theatre and with the Workshop of Eduardo De Filippo.  In 1968 he made his debut for cinema in La sua giornata di gloria.  In 1971 he directed in Florence a theatre cooperative playing works by Shakespeare, Mayakovsky, Brecht, Chekhov and Molière...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oIOFKqLJVpE6FFlcYyDOur1HxGl.jpg", url:"https://themoviedb.org/person/96974"}}, {tmdbId:"11281", properties:{bornIn:"Dalkey, County Dublin, Ireland", imdbId:"0193661", born:date('1948-02-18'), name:"Sinéad Cusack", bio:"​From Wikipedia, the free encyclopedia.   \n\nSinéad Moira Cusack (born 18 February 1948) is an Irish stage, television and film actress.  She has received two Tony Award nominations: once for Best Leading Actress in Much Ado About Nothing (1985), and again for Best Featured Actress in Rock 'n' Roll (2008). \n\nDescription above from the Wikipedia article Sinéad Cusack, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3WTdtZqMu3dA7YLSLWtAbRcmCuo.jpg", url:"https://themoviedb.org/person/11281"}}, {tmdbId:"12763", properties:{bornIn:"Salisbury, Wiltshire, England, UK", imdbId:"0001212", born:date('1970-05-27'), name:"Joseph Fiennes", bio:"Joseph Alberic Iscariot Twisleton-Wykeham-Fiennes (born 27 May 1970) is an English film and stage actor. \n\nHe is perhaps best known for his portrayals of William Shakespeare in Shakespeare in Love, Sir Robert Dudley in Elizabeth, Commisar Danilov in Enemy at the Gates, Martin Luther in Luther, and his portrayal of Mark Benford in the 2009 TV series FlashForward. \n\nDescription above from the Wikipedia article Joseph Fiennes, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iNCoAyJUabGOiTyfyva8X3vjpdT.jpg", url:"https://themoviedb.org/person/12763"}}, {tmdbId:"83196", properties:{bornIn:"San Diego, California, USA", imdbId:"0526649", born:date('1966-03-20'), name:"Jessica Lundy", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nbTcto9xjHzQIIV1gM73IJwLVbT.jpg", url:"https://themoviedb.org/person/83196"}}, {tmdbId:"69395", properties:{bornIn:"Fort Worth, Texas, USA", imdbId:"0355379", born:date('1985-02-04'), name:"Bug Hall", bio:"From Wikipedia, the free encyclopedia. \n\nBrandon \"Bug\" Hall (born February 4, 1985) is an American actor, acting teacher and musician...", url:"https://themoviedb.org/person/69395"}}, {tmdbId:"80290", properties:{bornIn:"Hollywood, California, USA", imdbId:"0571327", born:date('1984-10-15'), name:"Alex McKenna", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xTniQ6Hyd6NljadIRKRITtojDGp.jpg", url:"https://themoviedb.org/person/80290"}}, {tmdbId:"1202001", properties:{imdbId:"0881086", name:"Benjamin Ungar", url:"https://themoviedb.org/person/1202001"}}, {tmdbId:"1164427", properties:{bornIn:"McHenry, Illinois, USA", imdbId:"0567582", born:date('1912-07-20'), name:"Tom McDermott", bio:"Tom McDermott was an American stage and screen actor...", died:date('1996-03-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fhKInuR6Q2LBF43IzFdec4IxY3t.jpg", url:"https://themoviedb.org/person/1164427"}}, {tmdbId:"58650", properties:{bornIn:"Los Angeles County, California, USA", imdbId:"0190441", born:date('1961-07-09'), name:"Raymond Cruz", bio:"Raymund Cruz (born July 9, 1961) is a Mexican American actor.  He is mostly known for playing military roles.  His movie roles include Clear and Present Danger as Ding Chavez, The Substitute as Tom Berenger's second-in-command Joey Six, The Rock in an un-credited U. S.  Marine role, From Dusk Till Dawn 2: Texas Blood Money as Jesus, Alien Resurrection as USM Private Vincent DiStephano, and Under Siege as Ramirez...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1a0GyTD2v2HSDUGlGf69IGKdFmJ.jpg", url:"https://themoviedb.org/person/58650"}}, {tmdbId:"40481", properties:{bornIn:"Cayey, Puerto Rico", imdbId:"0350079", born:date('1956-08-28'), name:"Luis Guzmán", bio:"​From Wikipedia, the free encyclopedia.   \n\nLuis Guzmán (born August 28, 1956) is an actor from Puerto Rico.  He is known for his character work.  For much of his career, his squat build, wolfish features, and brooding countenance have garnered him roles largely as sidekicks, thugs, or policemen, but his later career has seen him move into more mainstream roles...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kSdxUckOJj9R5VKrLUnRy14YhNV.jpg", url:"https://themoviedb.org/person/40481"}}, {tmdbId:"66055", properties:{bornIn:"Melbourne, Victoria, Australia", imdbId:"0636280", born:date('1950-01-06'), name:"Richard Norton", bio:"From Wikipedia, the free encyclopedia\n\nRichard Norton (born 6 January 1950, in Australia) is a martial artist, action film star, and stuntman.  Norton worked as a bodyguard in the entertainment business before pursuing an acting career.  He has attained an eighth-dan in Zen Do Kai, Australia. \n\nHis first screen appearance was in the 1980 Chuck Norris film The Octagon, and to date he has worked on over 70 feature films and television programs...", url:"https://themoviedb.org/person/66055"}}, {tmdbId:"66056", properties:{bornIn:"Taipei, Taiwan", imdbId:"0497901", born:date('1977-09-18'), name:"Miki Lee", url:"https://themoviedb.org/person/66056"}}, {tmdbId:"1426133", properties:{imdbId:"0572963", name:"Karen McLymont", url:"https://themoviedb.org/person/1426133"}}, {tmdbId:"45820", properties:{bornIn:"Oberhausen, Germany", imdbId:"0777806", born:date('1970-04-18'), name:"Esther Schweins", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mZNgGt77c7H3tXDfgl4rkd38edx.jpg", url:"https://themoviedb.org/person/45820"}}, {tmdbId:"31444", properties:{bornIn:"Walsrode, Germany", imdbId:"0472391", born:date('1949-07-19'), name:"Maren Kroymann", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5E6tcI9S597TzyQY8nwLLhyb55V.jpg", url:"https://themoviedb.org/person/31444"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"2341", properties:{bornIn:"Mannheim, Germany", imdbId:"0618291", born:date('1955-09-26'), name:"Richy Müller", bio:"Richy Müller (born Hans-Jürgen Müller; 26 September 1955 in Mannheim) is a German television and movie actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/69W9VO478asbTZJrhqOfHddyunF.jpg", url:"https://themoviedb.org/person/2341"}}, {tmdbId:"11317", properties:{bornIn:"Surrey, England, UK", imdbId:"0001523", born:date('1969-12-14'), name:"Natascha McElhone", bio:"Natascha McElhone (born 14 December 1969) is an English actress of stage, screen and television, best known for her roles in Ronin, The Truman Show and Solaris.  McElhone also plays a leading role in the Showtime series Californication...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i1DLlIG1c6J4CiarAorQyIGSdVO.jpg", url:"https://themoviedb.org/person/11317"}}, {tmdbId:"4937", properties:{bornIn:"Minneapolis, Minnesota, USA", imdbId:"0000681", born:date('1970-03-28'), name:"Vince Vaughn", bio:"An American film actor, screenwriter, producer and comedian.  He began acting in the late 1980s, appearing in minor television roles before experiencing wider recognition with the 1996 movie, Swingers.  He has since appeared in a number of films, mostly comedies, including The Lost World: Jurassic Park, Old School, Starsky & Hutch, Dodgeball: A True Underdog Story, Couples Retreat, Mr.  & Mrs.  Smith, and Wedding Crashers...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w93uYyaTUjddFo9uNKsU9nf7HOH.jpg", url:"https://themoviedb.org/person/4937"}}, {tmdbId:"17402", properties:{bornIn:"Cedar Rapids, Iowa, USA", imdbId:"0515296", born:date('1967-06-05'), name:"Ron Livingston", bio:"Ronald Joseph \"Ron\" Livingston (born June 5, 1967) is an American film and television actor.  His roles include a disaffected corporate employee in the film Office Space, a sardonic writer in a short-term relationship with Carrie Bradshaw in the TV show Sex and the City, and Captain Lewis Nixon in the miniseries Band of Brothers.  In 2006, he starred as FBI negotiator Matt Flannery in the Fox series Standoff, co-starring Rosemarie DeWitt, and he was an ad spokesman for Sprint Nextel...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qbMJsRGmvGYnB0iVBH5zVRKaANW.jpg", url:"https://themoviedb.org/person/17402"}}, {tmdbId:"64715", properties:{bornIn:"USA", imdbId:"0887187", born:date('1969-08-19'), name:"Patrick Van Horn", bio:"​From Wikipedia, the free encyclopedia\n\nPatrick Van Horn (born 19 August 1969) is an American actor.  He is best known for his role as Sue in the 1996 film Swingers, starring alongside real-life friends Jon Favreau, Vince Vaughn and Ron Livingston.  He had previously appeared in the Dirty Harry film The Dead Pool (1988), in the Pauly Shore comedy Encino Man (1992), and on the TV series The Fresh Prince of Bel-Air in 1990...", url:"https://themoviedb.org/person/64715"}}, {tmdbId:"58312", properties:{bornIn:"Akron, Ohio, USA", imdbId:"0004904", born:date('1969-09-07'), name:"Angie Everhart", bio:"Angie Everhart is an American actress and former model who appeared in such films as “Bordello of Blood” and “Another 9 1/2 Weeks”...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pu8NBk4iF18idsyYQYk7D9SpTgC.jpg", url:"https://themoviedb.org/person/58312"}}, {tmdbId:"1602", properties:{bornIn:"Alicante, Spain", imdbId:"0555093", born:date('1975-02-22'), name:"Fele Martínez", bio:"From Wikipedia, the free encyclopedia. \n\nFele Martínez (born Rafael Martínez February 22, 1975) is a Goya Award-winning Spanish actor. \n\nDescription above from the Wikipedia article Fele Martínez, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/1602"}}, {tmdbId:"17093", properties:{bornIn:"Santander, Cantabria, Spain", imdbId:"0635330", born:date('1973-08-01'), name:"Eduardo Noriega", bio:"Eduardo Noriega Gómez  (born August 1, 1973) is a Spanish film actor, perhaps best known for his roles in two Alejandro Amenábar films, the multiple Goya Award-winning Tesis (English: Thesis) (1996) and Open Your Eyes (Spanish: Abre los Ojos) (1997).  He also starred in The Wolf (Spanish: El Lobo) (2004).  In the United States, Noriega is probably best known for his role as Enrique in the political thriller Vantage Point (2008)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nmoRGcpf3LIwa5Z1Lko2YsjiLut.jpg", url:"https://themoviedb.org/person/17093"}}, {tmdbId:"30357", properties:{imdbId:"0255544", born:date('1944-04-01'), name:"Xabier Elorriaga", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rPxfRfhEanQh74uSnYeijlRezPf.jpg", url:"https://themoviedb.org/person/30357"}}, {tmdbId:"16857", properties:{bornIn:"East Bridgewater, Massachusetts, USA", imdbId:"0779866", born:date('1970-09-07'), name:"Tom Everett Scott", bio:"Thomas Everett \"Tom\" Scott (born September 7, 1970) is an American film, theatre and television actor.  His film work includes a starring role as drummer Guy Patterson in the film That Thing You Do! (1996). \n\nDescription above from the Wikipedia article Tom Everett Scott, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nVDihOvsSm7kmeyHLtAcEzrrSYC.jpg", url:"https://themoviedb.org/person/16857"}}, {tmdbId:"16217", properties:{bornIn:"Baton Rouge, Louisiana, U.S.", imdbId:"0005551", born:date('1953-05-06'), name:"Lynn Whitfield", bio:"From Wikipedia, the free encyclopedia. \n\nLynn Whitfield (born May 6, 1953) is an American actress. \n\nWhitfield began her acting career in television and theatre, before progressing to supporting roles in film.  She won an Emmy Award for Outstanding Lead Actress in a Miniseries or a Special and a NAACP Image Award for her performance as Josephine Baker in the HBO movie The Josephine Baker Story (1991)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6bHDOrk7DNtpEeLoXKpGx23eN91.jpg", url:"https://themoviedb.org/person/16217"}}, {tmdbId:"9788", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0005093", born:date('1971-01-15'), name:"Regina King", bio:"Regina King was born on January 15, 1971 in Los Angeles, California.  She is best known for her role as Mary Jenkins's (played by Marla Gibbs) studious daughter, Brenda Jenkins, on the popular 1980s sitcom, 227 and for her critically-acclaimed supporting role in the feature film Jerry Maguire.  King began her acting career in 1985 in the role on the television series 227, a role she played until 1990...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fEIz0ljk9CBrp3AitM5nwjfoGVu.jpg", url:"https://themoviedb.org/person/9788"}}, {tmdbId:"93279", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0113140", born:date('1969-02-05'), name:"Bobby Brown", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9BLFvsTEqocIyJy1vCfbCj716U7.jpg", url:"https://themoviedb.org/person/93279"}}, {tmdbId:"5148", properties:{bornIn:"Long Island, New York", imdbId:"0421087", born:date('1954-04-23'), name:"Lucinda Jenney", bio:"​From Wikipedia, the free encyclopedia\n\nLucinda Jenney (born 23 April 1954) is an American actress. \n\nDescription above from the Wikipedia article Lucinda Jenney, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ahR0bNUJRi9Phpd7RZWx4ILiMEb.jpg", url:"https://themoviedb.org/person/5148"}}, {tmdbId:"1118081", properties:{bornIn:"Hollywood, Florida, USA", imdbId:"0502342", born:date('1981-04-02'), name:"Bethany Joy Lenz", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tuweXkZ7uBoZuDt1K7eUlOc00Y2.jpg", url:"https://themoviedb.org/person/1118081"}}, {tmdbId:"85421", properties:{bornIn:"Lebanon, Oregon, USA", imdbId:"0936011", born:date('1956-02-03'), name:"Time Winters", url:"https://themoviedb.org/person/85421"}}, {tmdbId:"545570", properties:{imdbId:"0408152", name:"Elis Imboden", url:"https://themoviedb.org/person/545570"}}, {tmdbId:"174203", properties:{bornIn:"Greensboro, North Carolina, USA", imdbId:"0243838", born:date('1990-05-25'), name:"Christian Durango", url:"https://themoviedb.org/person/174203"}}, {tmdbId:"545571", properties:{imdbId:"0167810", name:"Sloan Cobb", url:"https://themoviedb.org/person/545571"}}, {tmdbId:"166930", properties:{bornIn:"Pasadena - California - USA", imdbId:"0287266", born:date('1974-02-25'), name:"Laurie Fortier", bio:"Laurie Fortier is an actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kLAmSfZmLz9wNN3IVXs2BoSiPO7.jpg", url:"https://themoviedb.org/person/166930"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"1125", properties:{bornIn:"Edinburgh, Scotland, UK", imdbId:"0001971", born:date('1972-01-23'), name:"Ewen Bremner", bio:"Ewen Bremner  (born 23 January 1972) is a Scottish actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sMfFGH1C2aMKgBFkyJG1jDl4Fzn.jpg", url:"https://themoviedb.org/person/1125"}}, {tmdbId:"9013", properties:{bornIn:"Elgin, Moray, Scotland, UK", imdbId:"0571727", born:date('1973-08-09'), name:"Kevin McKidd", bio:"Kevin McKidd (born 9 August 1973) is a Scottish television and film actor and director.  He is known for his prominent television roles, including his performances as Lucius Vorenus in Rome, as Poseidon in Percy Jackson & the Olympians: The Lightning Thief, and as Dr.  Owen Hunt in Grey's Anatomy...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/KtmEKOSehmQ35JfGjEjpqlypbP.jpg", url:"https://themoviedb.org/person/9013"}}, {tmdbId:"534", properties:{bornIn:"Cincinnati, Ohio, U.S.A", imdbId:"0095478", born:date('1955-03-17'), name:"Mark Boone Junior", bio:"Mark Boone Junior (born March 17, 1955) is an American actor perhaps best known for his roles as Bobby Munson in FX's Sons of Anarchy and in two films by Christopher Nolan, Memento and Batman Begins.  He frequently portrays a crooked cop or other authority figure, and has had a prolific career, appearing in over 70 movies, which also include 2 Fast 2 Furious, Get Carter, The General's Daughter, The Thin Red Line, Seven, and Die Hard 2...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vUYpabQZs5DtHesZEL2IO07tIUb.jpg", url:"https://themoviedb.org/person/534"}}, {tmdbId:"223797", properties:{imdbId:"0240103", name:"Bronson Dudley", url:"https://themoviedb.org/person/223797"}}, {tmdbId:"148251", properties:{bornIn:"Rome, Italy", imdbId:"0315767", born:date('1954-10-12'), name:"Massimo Ghini", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iSpdphEZopzvu3816YsiFhhKwRb.jpg", url:"https://themoviedb.org/person/148251"}}, {tmdbId:"55755", properties:{bornIn:"Kobe - Japan", imdbId:"0429114", born:date('1972-01-16'), name:"Richard T. Jones", bio:"​From Wikipedia, the free encyclopedia. \n\nRichard Timothy Jones ( height 6' 2\" (1,88 m) born January 16, 1972) is an American film and television actor.  Jones was born in Kobe, Japan and raised in Carson, California.  He is the son of Lorene, a computer analyst, and Clarence Jones, a professional baseball player and the hitting instructor for the Cleveland Indians.  He also has an older brother named Clarence Jones Jr.  who now works as a coach.  His parents later divorced...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hdko2C45Wr5G03Z8JwGjWMynP84.jpg", url:"https://themoviedb.org/person/55755"}}, {tmdbId:"21343", properties:{bornIn:" Windsor, Berkshire, England, UK", imdbId:"0001035", born:date('1969-07-31'), name:"Ben Chaplin", bio:"From Wikipedia, the free encyclopedia. \n\nBen Chaplin (born 31 July 1969), born Benedict John Greenwood, is an English actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oJc9gA7cRvRg1v4tgeAmpkaqFxO.jpg", url:"https://themoviedb.org/person/21343"}}, {tmdbId:"134", properties:{bornIn:"Terrell, Texas, USA", imdbId:"0004937", born:date('1967-12-13'), name:"Jamie Foxx", bio:"Eric Marlon Bishop (born December 13, 1967), professionally known as Jamie Foxx, is an American actor, singer-songwriter, stand-up comedian, and talk radio host.  As an actor, his work in the film Ray earned him the Academy Award and BAFTA Award for Best Actor as well as the Golden Globe Award for Best Actor in a musical/comedy.  He is also a Grammy Award winning musician, producing two albums which have charted highly on the Billboard 200: Unpredictable, which topped the chart, and Intuition...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hPwCMEq6jLAidsXAX5BfoYgIfg2.jpg", url:"https://themoviedb.org/person/134"}}, {tmdbId:"1632583", properties:{bornIn:"Rochdale, Lancashire, England, UK", imdbId:"0515337", born:date('1945-03-29'), name:"Sidney Livingstone", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aaIJIzH6YBCToIQWOe3YHG3S55H.jpg", url:"https://themoviedb.org/person/1632583"}}, {tmdbId:"15321", properties:{bornIn:"Bucharest, Romania", imdbId:"0135944", born:date('1942-03-09'), name:"Ion Caramitru", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rzyxpmQiHH4hpPVJWvDzU3dDzsJ.jpg", url:"https://themoviedb.org/person/15321"}}, {tmdbId:"8435", properties:{bornIn:"London, England, UK", imdbId:"0226820", born:date('1956-11-30'), name:"Stephen Dillane", bio:"Stephen Dillane (born 30 November 1956) is an English actor.  He won a Tony Award for his lead performance in Tom Stoppard's play The Real Thing...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/YdbDRcujOxVwtgjg8FSCBR52aL.jpg", url:"https://themoviedb.org/person/8435"}}, {tmdbId:"70684", properties:{imdbId:"0641525", name:"Donal O'Kelly", url:"https://themoviedb.org/person/70684"}}, {tmdbId:"70685", properties:{imdbId:"0752557", name:"Ger Ryan", bio:"​From Wikipedia, the free encyclopedia\n\nGer Ryan is an Irish film and television actress, whose credits include Queer as Folk, The War of the Buttons, The Van, Moll Flanders, Driftwood, A Love Divided and Intermission. \n\nRyan has worked extensively in theatre, television and film.  She has been twice nominated for a Royal Television Society Award for Family and Amongst Women, and three times nominated by IFTA for Amongst Women, Intermission and The Return...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4fHO7Ogf9SEkg0HfDUhEwQ30AW1.jpg", url:"https://themoviedb.org/person/70685"}}, {tmdbId:"70686", properties:{imdbId:"0745339", name:"Caroline Rothwell", url:"https://themoviedb.org/person/70686"}}, {tmdbId:"24558", properties:{imdbId:"0194759", born:date('1966-02-11'), name:"Laurence Côte", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9Ze7vTkIm2X5TU48itFgRj4HWFO.jpg", url:"https://themoviedb.org/person/24558"}}, {tmdbId:"5442", properties:{bornIn:"Paris, France", imdbId:"0536095", born:date('1974-05-11'), name:"Benoît Magimel", bio:"Benoît Magimel is a French actor.  A prolific actor who was 14 when he appeared in his first film, Magimel has starred in a variety of roles in French cinema. \n\nFor a number of years, he lived with French actress Juliette Binoche, with whom he co-starred in 1999's Children of the Century and later had a daughter, Hana, born in 1999.  The relationship ended in 2003...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6uM8dPDqOE0PEPfDLoRbiABLeZQ.jpg", url:"https://themoviedb.org/person/5442"}}, {tmdbId:"167212", properties:{bornIn:"Moose Jaw, Saskatchewan, Canada", imdbId:"0857275", born:date('1964-04-06'), name:"Deborah Theaker", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5xJLKDhSBHGuDlYnlBwjz9A2r06.jpg", url:"https://themoviedb.org/person/167212"}}, {tmdbId:"75463", properties:{bornIn:"Defiance, Ohio, USA", imdbId:"0386871", born:date('1958-07-28'), name:"Michael Hitchcock", bio:"Michael Hitchcock (born July 28, 1958) is an American actor, comedian, screenwriter and television producer. \n\nAs an actor, he has appeared in several of Christopher Guest's critically acclaimed movies, including Waiting for Guffman (1996), Best in Show (2000), A Mighty Wind (2003), and For Your Consideration (2006).  Best in Show earned a Golden Globe Awards nomination for “Best Comedy” and won “Funniest Motion Picture” by the American Comedy Awards and British Comedy Awards...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sLKiaWJtExmjORZCVYHB0cTgmMn.jpg", url:"https://themoviedb.org/person/75463"}}, {tmdbId:"61286", properties:{imdbId:"0932142", name:"Scott Williamson", url:"https://themoviedb.org/person/61286"}}, {tmdbId:"143150", properties:{imdbId:"0106010", name:"Amy Braverman", url:"https://themoviedb.org/person/143150"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"65605", properties:{bornIn:"Louisville, Kentucky, U.S.", imdbId:"0000738", born:date('1942-01-17'), name:"Muhammad Ali", bio:"​From Wikipedia, the free encyclopedia.   \n\nMuhammad Ali (born Cassius Marcellus Clay, Jr. ; January 17, 1942) is an American former boxer and three-time World Heavyweight Champion, who is widely considered one of the greatest heavyweight championship boxers of all time.  As an amateur, he won a gold medal in the light heavyweight division at the 1960 Summer Olympics in Rome.  After turning professional, he went on to become the first boxer to win the lineal heavyweight championship three times...", died:date('2016-06-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/u1ck2Lfx34GvW3YOoEE1ddNVdw6.jpg", url:"https://themoviedb.org/person/65605"}}, {tmdbId:"65606", properties:{bornIn:"Marshall, Texas,SUA", imdbId:"0286040", born:date('1949-01-10'), name:"George Foreman", bio:"​From Wikipedia, the free encyclopedia.   George Edward Foreman (nicknamed \"Big George\") (born January 10, 1949) is an American two-time former World Heavyweight Boxing Champion, Olympic gold medalist, ordained Baptist minister, author and successful entrepreneur.  He is credited as being one of the hardest hitters in boxing history...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7LZJVEP8iL9DQTBUDwHAnfKgmMI.jpg", url:"https://themoviedb.org/person/65606"}}, {tmdbId:"65607", properties:{bornIn:"Cleveland, Ohio, USA", imdbId:"0005091", born:date('1931-08-20'), name:"Don King", bio:"From Wikipedia, the free encyclopedia\n\nDonald \"Don\" King (born August 20, 1931) is an American boxing promoter particularly known for his hairstyle and flamboyant personality.  His career highlights include promoting \"The Rumble in the Jungle\" and the \"Thrilla in Manila\", as well as orchestrating the ascent of Mike Tyson...", url:"https://themoviedb.org/person/65607"}}, {tmdbId:"77331", properties:{bornIn:"Ames - Iowa - USA", imdbId:"0515260", born:date('1970-11-08'), name:"John Livingston", url:"https://themoviedb.org/person/77331"}}, {tmdbId:"4239", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0080049", born:date('1973-12-11'), name:"Yasiin Bey", bio:"Regarded as one of hip hop's most introspective and insightful artists, Yasiin Bey has shaped a career that transcends music genres and artistic medium.  A child of hip hop's Golden Era, the native Brooklynite spent his childhood imbedded in the culture surrounding him, as well as absorbing knowledge from across the artistic spectrum...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xP37YR6B53nY3MnzInxIhabIBjJ.jpg", url:"https://themoviedb.org/person/4239"}}, {tmdbId:"21134", properties:{bornIn:"Boston - Massachusetts - USA", imdbId:"0805476", born:date('1962-08-13'), name:"John Slattery", bio:"John M.  Slattery, Jr.  (born August 13, 1962) is an American actor and director, best known for his role as Roger Sterling on AMC's series Mad Men. \n\nDescription above from the Wikipedia article John Slattery, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gOeTWJ5rtY9gk7G8DquZlItufA8.jpg", url:"https://themoviedb.org/person/21134"}}, {tmdbId:"24965", properties:{bornIn:"Boston - Massachusetts - USA", imdbId:"0937930", born:date('1968-06-04'), name:"Scott Wolf", bio:"​From Wikipedia, the free encyclopedia.   \n\nScott Richard Wolf (born June 4, 1968) is an American actor, known for his roles on the television series Party of Five as Bailey Salinger and on Everwood as Dr.  Jake Hartman.  Since 2009, he has appeared in the Sci-Fi series V as the morally ambiguous journalist, Chad Decker...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/irmODdvrL16lTumtDRN3z99QO1c.jpg", url:"https://themoviedb.org/person/24965"}}, {tmdbId:"4581", properties:{bornIn:"Middleton, Manchester, England, UK", imdbId:"0176869", born:date('1965-10-14'), name:"Steve Coogan", bio:"Stephen John \"Steve\" Coogan (born 14 October 1965) is an English comedian, actor, writer and producer. \n\nHis best known character in the United Kingdom is Alan Partridge, a socially awkward and politically incorrect regional media personality, who featured in several television series, such as The Day Today, Knowing Me Knowing You with Alan Partridge and I'm Alan Partridge.  Outside the UK, Coogan is better known for his film roles...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tT7OXc2qA6hlREHXdwGLp0XihzA.jpg", url:"https://themoviedb.org/person/4581"}}, {tmdbId:"98530", properties:{bornIn:"Gulfport, Mississippi, USA", imdbId:"0420110", born:date('1975-02-16'), name:"Donnie Jeffcoat", url:"https://themoviedb.org/person/98530"}}, {tmdbId:"1176163", properties:{imdbId:"0929481", name:"Scott Wilkinson", url:"https://themoviedb.org/person/1176163"}}, {tmdbId:"19184", properties:{bornIn:"Panorama City, California, USA", imdbId:"0004971", born:date('1974-03-01'), name:"Mark-Paul Gosselaar", bio:"Mark-Paul Harry Gosselaar (born March 1, 1974) is an American actor.   He is best known for his role as Zack Morris on the television series Saved by the Bell (1989–1993) and its spin-offs...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3NBXFRhQ70voZTUWMhNbxaJC8XU.jpg", url:"https://themoviedb.org/person/19184"}}, {tmdbId:"77028", properties:{bornIn:"Sydney, New South Wales, Australia", imdbId:"0599889", born:date('1972-06-15'), name:"Poppy Montgomery", bio:"Poppy Montgomery (born June 15, 1972) is an Australian actress.  She is known for her starring roles on Without a Trace and Unforgettable...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aLixKI9LRqYuyTuyAzpM0i869yv.jpg", url:"https://themoviedb.org/person/77028"}}, {tmdbId:"58058", properties:{bornIn:"Lac La Hache, British Columbia, Canada", imdbId:"0613147", born:date('1966-02-12'), name:"Lochlyn Munro", bio:"Lochlyn Munro is a Canadian actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bOJ03k0oe2R6snRgzV8M4Qtoo4O.jpg", url:"https://themoviedb.org/person/58058"}}, {tmdbId:"1194903", properties:{imdbId:"0687668", name:"John Plumpis", url:"https://themoviedb.org/person/1194903"}}, {tmdbId:"80966", properties:{bornIn:"Woodland Hills, California, USA", imdbId:"0597223", born:date('1969-10-03'), name:"Janel Moloney", bio:"From Wikipedia, the free encyclopedia. \n\nJanel Moloney (born October 3, 1969) is an American actress, best known for her role as Donnatella \"Donna\" Moss on the television series The West Wing. \n\nDescription above from the Wikipedia article Janel Moloney, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/80966"}}, {tmdbId:"34735", properties:{bornIn:" St. Paul, Minnesota, USA", imdbId:"0000756", born:date('1945-08-05'), name:"Loni Anderson", bio:" From Wikipedia, the free encyclopedia\n\nLoni Kaye Anderson (born August 5, 1945) is an American actress who played the role of Jennifer Marlowe on the television sitcom WKRP in Cincinnati. \n\nAnderson was born in St.  Paul, Minnesota, August 5, 1945, the daughter of Maxine Hazel (née Kallin), a model, and Klaydon Carl \"Andy\" Anderson, an environmental chemist and grew up in suburban Roseville...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2IRmMn4u8vKiPm1iDSMXR8Wse45.jpg", url:"https://themoviedb.org/person/34735"}}, {tmdbId:"166701", properties:{bornIn:"Cincinnati, Ohio, USA", imdbId:"0098758", born:date('1983-09-28'), name:"Mathew Botuchis", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2TdtJvfGFE7XhGMD1gBEhUZyrTs.jpg", url:"https://themoviedb.org/person/166701"}}, {tmdbId:"1654282", properties:{imdbId:"0573565", name:"Maxine McNair", url:"https://themoviedb.org/person/1654282"}}, {tmdbId:"1654283", properties:{imdbId:"0573555", name:"Chris McNair", url:"https://themoviedb.org/person/1654283"}}, {tmdbId:"1654284", properties:{imdbId:"0670433", name:"Helen Pegues", url:"https://themoviedb.org/person/1654284"}}] AS ro