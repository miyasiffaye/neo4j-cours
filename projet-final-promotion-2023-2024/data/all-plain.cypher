UNWIND [{tmdbId:"17718", properties:{bornIn:"Cologne, Germany", imdbId:"0956183", born:date('1979-02-03'), name:"Marie Zielcke", url:"https://themoviedb.org/person/17718"}}, {tmdbId:"17719", properties:{bornIn:"Graz, Austria", imdbId:"0917843", born:date('1971-08-27'), name:"Julian Weigend", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7xOWxsDKVbpQevKdc57RSg3aQh4.jpg", url:"https://themoviedb.org/person/17719"}}, {tmdbId:"55547", properties:{bornIn:"Manchester, New Hampshire, USA", imdbId:"0194516", born:date('1977-05-20'), name:"Matt Czuchry", bio:"Matt Czuchry is an American actor.  He is best known for his portrayals of Logan Huntzberger on Gilmore Girls and Cary Agos on the CBS television series The Good Wife...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2rjZFfUgD5jJewgQn3HC72aIEBn.jpg", url:"https://themoviedb.org/person/55547"}}, {tmdbId:"28166", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0005399", born:date('1980-09-13'), name:"Ben Savage", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/khiml4TCvzUkTZUfhOiaWPTjKzy.jpg", url:"https://themoviedb.org/person/28166"}}, {tmdbId:"84932", properties:{bornIn:"New York, USA", imdbId:"0419650", born:date('1969-12-04'), name:"Jay Z", bio:"Shawn Corey \"Jay-Z\" Carter is an American rapper, songwriter, record producer, entrepreneur, and occasional actor.  He is one of the most financially successful hip-hop artists and entrepreneurs in America and has sold approximately 50 million albums worldwide, receiving fourteen Grammy Awards for his musical work and numerous additional nominations.  He is consistently ranked as one of the greatest rappers of all time...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mCzxfv2PZc1xq2YDzzRFIDkvzFs.jpg", url:"https://themoviedb.org/person/84932"}}, {tmdbId:"5384", properties:{bornIn:"Staten Island, New York, USA", imdbId:"0541218", born:date('1971-04-01'), name:"Method Man", bio:"Clifford Smith (born April 1, 1971 in Staten Island, New York), better known by his stage name Method Man or Meth is an American hip hop artist, record producer, actor and member of the hip hop collective Wu-Tang Clan.  He took his stage name from the 1979 film The Fearless Young Boxer, also known as Method Man.  He is one half of the rap duo Method Man & Redman along with fellow rapper Redman...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mYJFxOcrda410rS5JHPf0nPuimZ.jpg", url:"https://themoviedb.org/person/5384"}}, {tmdbId:"54799", properties:{bornIn:"Newark, New Jersey, USA", imdbId:"0714983", born:date('1970-04-17'), name:"Redman", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2yVHBc8W6yPukvZQIAlLDCNWktW.jpg", url:"https://themoviedb.org/person/54799"}}, {tmdbId:"62547", properties:{bornIn:"San Diego, California, USA", imdbId:"0860749", born:date('1958-01-27'), name:"Susanna Thompson", bio:"Susanna Thompson is an actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7LsOYvF08HvJ5jBJtH1jrZx1dcD.jpg", url:"https://themoviedb.org/person/62547"}}, {tmdbId:"16839", properties:{bornIn:"Winchester, Kentucky, USA", imdbId:"1668265", born:date('1980-05-18'), name:"Matt Long", bio:"From Wikipedia, the free encyclopedia\n\nMatthew Clayton \"Matt\" Long (born May 18, 1980) is an American actor.  He played the teenaged Jack McCallister on Jack &amp; Bobby, the younger Johnny Blaze in Ghost Rider, and Tyler Prince in Sydney White. \n\nLong was born in Winchester, Kentucky.  He has one younger sibling, Zac.  He attended Western Kentucky University where he met his wife, Lora Chaffins.  He was also a member of Sigma Alpha Epsilon fraternity...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7oOTVu3N0rmNKNn8T6kv5hiIfe6.jpg", url:"https://themoviedb.org/person/16839"}}, {tmdbId:"16840", properties:{bornIn:"Los Angeles - California - USA", imdbId:"0018161", born:date('1983-03-07'), name:"Raquel Alessi", bio:"​From Wikipedia, the free encyclopedia.   \n\nRaquel Alessi is an actress and model who starred on the FOX series Standoff and the film Ghost Rider with Nicolas Cage.  She portrays the title character in the 2009 film Miss March, alongside Zach Cregger and Trevor Moore from the comedy troupe Whitest Kids U Know. \n\nDescription above from the Wikipedia article Raquel Alessi  licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/16840"}}, {tmdbId:"16841", properties:{bornIn:"Houston, Texas, USA", imdbId:"0191442", born:date('1956-08-26'), name:"Brett Cullen", bio:"Peter Brett Cullen (born August 26, 1956) is an American actor who has appeared in numerous motion pictures and television programs.  Early in 2007, he was cast as the role of an estranged father to one of the American football players, Tim Riggins (played by actor Taylor Kitsch), in the NBC drama series Friday Night Lights. \n\nCullen was born in Houston, Texas, the son of Lucien Hugh Cullen, an oil industry executive, and Catherine Cullen.  He graduated from Madison High School in Houston in 1974...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sEcPXqdcoZ9h4s7PSjVYocEPypP.jpg", url:"https://themoviedb.org/person/16841"}}, {tmdbId:"29097", properties:{imdbId:"0035788", born:date('1958-01-03'), name:"Kerry Armstrong", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v3XHkGbuXAQPmgqJX3EU4GYd16g.jpg", url:"https://themoviedb.org/person/29097"}}, {tmdbId:"54645", properties:{bornIn:"Winnipeg, Manitoba, Canada", imdbId:"0889522", born:date('1962-09-24'), name:"Nia Vardalos", bio:"Antonia Eugenia \"Nia\" Vardalos (born September 24, 1962) is a Canadian-American actress, screenwriter, director, and producer.  Her most notable work is the 2002 Academy Award nominated film My Big Fat Greek Wedding...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qf8ZHjyl5476gZKeCspWhbQanKy.jpg", url:"https://themoviedb.org/person/54645"}}, {tmdbId:"14884", properties:{bornIn:"Reading, Pennsylvania, USA", imdbId:"0176073", born:date('1927-05-22'), name:"Michael Constantine", bio:"From Wikipedia, the free encyclopedia\n\nMichael Constantine (born May 22, 1927) is an American actor. \n\nHe is probably now best known for his portrayal of Gus Portokalos, the Windex bottle-toting Greek father of Toula Portokalos (Nia Vardalos), in the 2002 surprise hit film My Big Fat Greek Wedding...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i4m5kiXONOfWqfdGSsTGba7iZax.jpg", url:"https://themoviedb.org/person/14884"}}, {tmdbId:"54646", properties:{imdbId:"1164392", name:"Christina Eleusiniotis", url:"https://themoviedb.org/person/54646"}}, {tmdbId:"67017", properties:{bornIn:"Grand Rapids, Michigan, USA", imdbId:"0160085", born:date('1965-12-18'), name:"Shawn Christian", bio:"​From Wikipedia, the free encyclopedia. \n\nShawn Patrick Christian  (born December 18, 1965) is an American television and film actor. \n\nAfter graduating Ferris State University in Big Rapids, Michigan in 1989, he moved to Chicago to pursue an acting career.  He starred in numerous stage productions, and began appearing in commercials.  He worked on stage with improvisational company Improv Olympic.  In 1994, he was the first male spokesman on Star Search...", url:"https://themoviedb.org/person/67017"}}, {tmdbId:"67020", properties:{imdbId:"0160930", name:"Susan Chuang", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bj3w5esnk92cK8b9gcRHmV5VXyc.jpg", url:"https://themoviedb.org/person/67020"}}, {tmdbId:"174462", properties:{imdbId:"0330070", born:date('1967-04-20'), name:"Lara Jill Miller", url:"https://themoviedb.org/person/174462"}}, {tmdbId:"1242011", properties:{bornIn:"Kent, Ohio, United States", imdbId:"0293196", born:date('1970-12-02'), name:"Joshua Seth", bio:"Joshua Seth is an American voice actor, magician, comedian, keynote speaker, mentalist, and entertainer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7F8QX1fQ5cqZpKJ8F4JoWlg810n.jpg", url:"https://themoviedb.org/person/1242011"}}, {tmdbId:"168992", properties:{bornIn:"San Diego, California, USA", imdbId:"0653071", born:date('1955-09-18'), name:"Bob Papenbrook", bio:"Robert DeWayne Papenbrook (September 18, 1955 – March 17, 2006) was an American voice actor. \n\nFellow voice actors often nicknamed him \"Pappy\".  He was very well known in the worlds of anime and video game voice-overs for his voice acting of \"gruff\" characters.  However, he was especially well known in his various live action voice-overs which, most notably, included the Power Rangers franchise...", died:date('2006-03-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c6osjbHJq4od6Dv3tdxlUDjM05V.jpg", url:"https://themoviedb.org/person/168992"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"571220", properties:{name:"David Lodge", url:"https://themoviedb.org/person/571220"}}, {tmdbId:"8800", properties:{bornIn:"Linz, Austria", imdbId:"0591352", born:date('1977-04-03'), name:"Birgit Minichmayr", bio:"Birgit Minichmayr (born 3 April 1977) is an Austrian actress and singer born in Linz, Austria.  Birgit Minichmayr studied drama at the Max-Reinhardt-Seminar in Vienna. \n\nDescription above from the Wikipedia article Birgit Minichmayr, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tZlerAW9UFeRUrvthxKmhIOcVbc.jpg", url:"https://themoviedb.org/person/8800"}}, {tmdbId:"20815", properties:{bornIn:"Houston, Texas, USA", imdbId:"0566084", born:date('1992-09-28'), name:"Skye McCole Bartusiak", bio:"Skye McCole Bartusiak (September 28, 1992 – July 19, 2014) was an American film and television actress.  She appeared in The Patriot, Don't Say a Word, Beyond the Prairie: The True Story of Laura Ingalls Wilder, 24, Boogeyman, and Kill Your Darlings. \n\nMcCole Bartusiak died in 2014 of an accidental drug overdose...", died:date('2014-07-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/PzzuSKm7fSjBI1sH0gWGqbyCZU.jpg", url:"https://themoviedb.org/person/20815"}}, {tmdbId:"25002", properties:{bornIn:"Seongnam, Gyeonggi, South Korea", imdbId:"0496932", born:date('1970-07-12'), name:"Byung-hun Lee", bio:"Lee Byung-hun is a South Korean actor, singer and model.  He achieved wider fame after starring in the television dramas Iris (2009), All In (2003) and Beautiful Days (2001).  He is also known for his starring roles in Joint Security Area (2000), A Bittersweet Life (2005), The Good, the Bad, the Weird (2008) and I Saw the Devil (2010).  He has received multiple awards and nominations throughout his career...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/k94k79Eqkh73GbYsX0Tcp6wuzff.jpg", url:"https://themoviedb.org/person/25002"}}, {tmdbId:"222487", properties:{imdbId:"0890709", name:"Nelson Vasquez", url:"https://themoviedb.org/person/222487"}}, {tmdbId:"19302", properties:{bornIn:"Highlands, New Jersey, USA", imdbId:"0582939", born:date('1974-06-12'), name:"Jason Mewes", bio:"Jason Edward Mewes (born June 12, 1974) is an American television and film actor best known for playing Jay, the vocal half of the duo Jay and Silent Bob, in longtime friend Kevin Smith's films. \n\nDescription above from the Wikipedia article Jason Mewes, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pZAmLSlIUhRUGrztm5i2AuNQV2o.jpg", url:"https://themoviedb.org/person/19302"}}, {tmdbId:"1983", properties:{bornIn:"New York City - New York - USA", imdbId:"0488095", born:date('1974-01-21'), name:"Vincent Laresca", bio:"From Wikipedia, the free encyclopedia.   \n\nVincent Laresca (born January 21, 1974) is an American actor. \n\nLaresca first appeared in film in 1992, in the movie Juice as Radames.  Since then, he has appeared in many popular films, including The Devil's Advocate, The Aviator, Empire, Coach Carter, The Fast and the Furious: Tokyo Drift and Baz Luhrmann's William Shakespeare's Romeo + Juliet. \n\nIn 1997, he had a supporting role in the short-lived Fox ensemble drama 413 Hope St...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nO1HrEcjXzot40qDJkTcI4CFqTf.jpg", url:"https://themoviedb.org/person/1983"}}, {tmdbId:"1175784", properties:{imdbId:"0262506", name:"Candace Evanofski", url:"https://themoviedb.org/person/1175784"}}, {tmdbId:"1175785", properties:{imdbId:"0390184", name:"Donald Holden", url:"https://themoviedb.org/person/1175785"}}, {tmdbId:"79427", properties:{imdbId:"0497081", name:"Damian Jewan Lee", url:"https://themoviedb.org/person/79427"}}, {tmdbId:"1175786", properties:{imdbId:"0183060", name:"Curtis Cotton III", url:"https://themoviedb.org/person/1175786"}}, {tmdbId:"87256", properties:{imdbId:"0015988", name:"Mazhar Alanson", bio:"​Mahmut Mazhar Alanson (d.  13 Şubat 1950, Ankara) Türk müzisyen, gitarist, söz yazarı ve oyuncu.  Mazhar-Fuat-Özkan grubunun vokalisti olarak tanınır.   Babası Ferruh Alanson, annesi Melek Alanson'dur.  Ayla Alanson ailenin ilk kız çocuğudur.  Daha sonra Aynur Alanson doğmuştur.  En sonunda Ferruh Alanson'un 3.  çocuğu Mazhar Alanson dünyaya gelmiştir.  Babası Ferruh Alanson, Ankara Senfoni Orkestrası'nda baş trompetçiydi, annesi Melek Alanson ise ilkokul öğretmeniydi...", url:"https://themoviedb.org/person/87256"}}, {tmdbId:"115008", properties:{imdbId:"0245176", name:"Ceyda Düvenci", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ii6xMO1rzdwLmfOpOLH4hYhVRQ7.jpg", url:"https://themoviedb.org/person/115008"}}, {tmdbId:"592094", properties:{bornIn:"Istanbul, Turkey", imdbId:"0654741", born:date('1928-08-15'), name:"Selim Nasit", bio:"Turkish theater and movie artist.  Brother of amazing and lovely Turkish actress Adile Naşit.   He died because of pancreatic cancer in the Kadıköy Şifa Hospital where he was being treated...", died:date('2000-08-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fw0GPpyhglwhw9El4JdCDX8dLf6.jpg", url:"https://themoviedb.org/person/592094"}}, {tmdbId:"56356", properties:{bornIn:"Miami Beach, Florida", imdbId:"0005312", born:date('1970-05-10'), name:"Gina Philips", bio:"Gina Philips (born May 10, 1975) is an American actress.  Philips was born Gina Consolo in Miami Beach, Florida.  She is known for her recurring roles on David E.  Kelley's Ally McBeal as Sandy Hingle and Boston Public as Jenna Miller.  Her film credits include Jeepers Creepers, Love & Debate, The Anarchist Cookbook, Dead and Breakfast and The Sick House.  In addition, Philips has made guest appearances on Star Trek: DS9, Sliders, ER, CSI, Medium and Monk...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/m2Th51wF7IUfQe0spOaQmFp1TTP.jpg", url:"https://themoviedb.org/person/56356"}}, {tmdbId:"15033", properties:{bornIn:"Fairfield, Connecticut, USA", imdbId:"0519043", born:date('1978-06-02'), name:"Justin Long", bio:"From Wikipedia, the free encyclopedia. \n\nJustin Jacob Long is an American film and television actor.  He is best known for his roles in the Hollywood films Galaxy Quest, Jeepers Creepers, Dodgeball, Live Free or Die Hard, He's Just Not That into You, Drag Me to Hell, and Youth in Revolt, and his personification of a Mac in Apple's \"Get a Mac\" advertising campaign...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Hlz1LnrOzGBKoZ50HBk9ytuVUa.jpg", url:"https://themoviedb.org/person/15033"}}, {tmdbId:"56357", properties:{bornIn:"Houston, Texas, U.S.", imdbId:"0106534", born:date('1965-02-17'), name:"Jonathan Breck", bio:"From Wikipedia, the free encyclopedia. \n\nJonathan Breck (born February 17, 1965) is an American actor.  Beginning his career as a stage actor, Breck was most successful for playing the villainous demon The Creeper in the Jeepers Creepers series of horror films.  He has also appeared in numerous film and television roles including Beat Boys, Beat Girls, Good Advice, Spiders, I Married a Monster, JAG, Star Trek: Voyager, VIP, Push...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8lEThSfpr7ebYApwEiU3hO6uGd5.jpg", url:"https://themoviedb.org/person/56357"}}, {tmdbId:"56358", properties:{bornIn:"Helena, Montana, USA", imdbId:"0006970", born:date('1954-01-01'), name:"Patricia Belcher", bio:"From Wikipedia, the free encyclopedia. \n\nPatricia Belcher is an American film and television actress, best known for her role as the strict \"Estelle Dabney\" on the Disney Channel Original sitcom, Good Luck Charlie and as attorney Caroline Julian on Bones...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fT3aNLRdvqihRxF5gFrUWzyuPu4.jpg", url:"https://themoviedb.org/person/56358"}}, {tmdbId:"6281", properties:{bornIn:"San Juan, Puerto Rico", imdbId:"0043662", born:date('1976-09-25'), name:"Charlotte Ayanna", bio:"​From Wikipedia, the free encyclopedia.   \n\nCharlotte Ayanna (née Lopez; born September 25, 1976) is an American actress and former Miss Teen USA. \n\nDescription above from the Wikipedia article Charlotte Ayanna,  licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/u79MF2SbI7XUd0mXfdn6BDRYZt8.jpg", url:"https://themoviedb.org/person/6281"}}, {tmdbId:"210420", properties:{bornIn:"Cape Town, South Africa", imdbId:"0235098", born:date('1928-01-01'), name:"James B. Douglas", died:date('2009-12-29'), url:"https://themoviedb.org/person/210420"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"113949", properties:{bornIn:"Thailand", imdbId:"0681099", born:date('1977-06-05'), name:"Jesdaporn Pholdee", bio:"From Wikipedia, the free encyclopedia. \n\nJesadaporn Pholdee (also known as Tik Jesadaporn) (born June 5, 1977 in Bangkok, Thailand), is a Thai actor, model, and presenter. \n\nJesadaporn graduated with a Bachelor of Science degree in engineering from the University of the Thai Chamber of Commerce in Bangkok. \n\nHe has two younger brothers, Tun and Tong. \n\nHe began his career as a model for commercials on TV...", url:"https://themoviedb.org/person/113949"}}, {tmdbId:"1647815", properties:{name:"Sahaphap Tor", url:"https://themoviedb.org/person/1647815"}}, {tmdbId:"1647816", properties:{name:"Ekachai Buranapanit", url:"https://themoviedb.org/person/1647816"}}, {tmdbId:"1365833", properties:{name:"Giorgio Maiocchi", url:"https://themoviedb.org/person/1365833"}}, {tmdbId:"17358", properties:{imdbId:"0823940", name:"Kim Staunton", url:"https://themoviedb.org/person/17358"}}, {tmdbId:"557860", properties:{imdbId:"1101388", name:"Julian Ayer", url:"https://themoviedb.org/person/557860"}}, {tmdbId:"71467", properties:{bornIn:"Chicago, Illinois, U.S.", imdbId:"0641610", born:date('1987-07-06'), name:"Matt O'Leary", bio:"From Wikipedia, the free encyclopedia. \n\nMatthew Joseph \"Matt\" O'Leary (born July 6, 1987) is an American actor. \n\nDescription above from the Wikipedia article Matt O'Leary, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xTjZWML92P7dMrlFTdyHIfaDgTv.jpg", url:"https://themoviedb.org/person/71467"}}, {tmdbId:"574094", properties:{imdbId:"1133509", name:"Esther Wurmfeld", url:"https://themoviedb.org/person/574094"}}, {tmdbId:"574095", properties:{imdbId:"1133656", name:"Hillel Friedman", url:"https://themoviedb.org/person/574095"}}, {tmdbId:"10692", properties:{bornIn:"West Orange, New Jersey, USA", imdbId:"0685856", born:date('1981-04-10'), name:"Michael Pitt", bio:"An American actor, model and musician.  Pitt is known in film for his roles in Bernardo Bertolucci's The Dreamers (2003), Gus Van Sant's Last Days (2005), Michael Haneke's Funny Games (2007) and M.  Night Shyamalan's The Village (2004), and in television for his roles as Henry Parker in the teen drama Dawson's Creek, Jimmy Darmody in the HBO series Boardwalk Empire and Mason Verger in the NBC series Hannibal...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mKSjyfqcXTVjFhIFw6Esjlz1Tps.jpg", url:"https://themoviedb.org/person/10692"}}, {tmdbId:"36219", properties:{bornIn:"Manchester, England, UK", imdbId:"0859720", born:date('1976-01-19'), name:"Marsha Thomason", bio:"From Wikipedia, the free encyclopedia. \n\nMarsha Lisa Thomason (born 19 January 1976) is an English actress, who is known in the United States for playing Nessa Holt in the first two seasons of the NBC series Las Vegas, for her recurring role on ABC's Lost as Naomi Dorrit, and for playing FBI agent Diana Barrigan on USA Network's White Collar...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fqN0FKAJeTfcPHDFL529EkuX1s6.jpg", url:"https://themoviedb.org/person/36219"}}, {tmdbId:"9831", properties:{bornIn:" Swansea, Wales", imdbId:"0716490", born:date('1965-05-16'), name:"Vincent Regan", bio:"Vincent Regan (born 16 May 1965) is a British film and television actor. Regan has over 15 stage roles to his credit, most recently as Achilles in Troilus and Cressida at the Edinburgh International Festival.  In association with The Royal Shakespeare Company, the festival presented director Peter Stein's strongly cast and visually striking production...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vnylF0jSWOdQyRWAsQgV3oA9dk.jpg", url:"https://themoviedb.org/person/9831"}}, {tmdbId:"20080", properties:{bornIn:"Paris, France", imdbId:"0296594", born:date('1956-05-01'), name:"Catherine Frot", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pi1HwK9gJfhkDJkC3SCDJgDc9LS.jpg", url:"https://themoviedb.org/person/20080"}}, {tmdbId:"56241", properties:{bornIn:"Paris,France", imdbId:"1021224", born:date('1977-02-15'), name:"Rachida Brakni", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bsPgWJjtKcXI7IZH2ro0A7BlJfA.jpg", url:"https://themoviedb.org/person/56241"}}, {tmdbId:"54167", properties:{bornIn:"Nieppe, Hauts-de-France, France", imdbId:"0719232", born:date('1928-07-02'), name:"Line Renaud", bio:"Line Renaud (born 2 July 1928) is a popular French singer, actress and AIDS activist.  . . . \n\nSource: Article \"Line Renaud\" from Wikipedia in english, licensed under CC-BY-SA 3. 0...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gq5yYEPsmIqx9kDrmfyxAjCrTJC.jpg", url:"https://themoviedb.org/person/54167"}}, {tmdbId:"25837", properties:{bornIn:"Calgary, Alberta, Canada", imdbId:"0193846", born:date('1982-11-30'), name:"Elisha Cuthbert", bio:"Elisha Ann Cuthbert (born November 30, 1982) is a Canadian actress and model.  She began her career as the host of the Canadian children's television series Popular Mechanics for Kids (1997–2000).  Since then, her best known television roles have been Kim Bauer on the Fox action-thriller series 24 (2001–2010, 2014) and Alex Kerkovich on the ABC comedy series Happy Endings (2011–2013)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6lhbuDBlLoQPn2zxj402IBmtq8a.jpg", url:"https://themoviedb.org/person/25837"}}, {tmdbId:"29220", properties:{bornIn:"Thousand Oaks, California, USA", imdbId:"0004789", born:date('1986-04-03'), name:"Amanda Bynes", bio:"From Wikipedia, the free encyclopedia. \n\nAmanda Laura Bynes (born April 3, 1986) is an American actress, fashion designer and singer.  Bynes appeared in several successful television series, such as All That and The Amanda Show, on Nickelodeon in the mid to late 1990s and early 2000s, and in 2002, she starred in the TV series, What I Like About You...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jZ2Ot91ksIiPGYRAuojQIHRtAQ7.jpg", url:"https://themoviedb.org/person/29220"}}, {tmdbId:"19275", properties:{bornIn:"Chico, California, USA", imdbId:"0221902", born:date('1971-09-27'), name:"Amanda Detmer", bio:"​From Wikipedia, the free encyclopedia.   \n\nAmanda Jeannette Detmer (born September 27, 1971) is an American actress who has appeared in various films and television shows. \n\nDescription above from the Wikipedia article Amanda Detmer, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3FRiNxlVHaxhuZBMy4C63pgE8sf.jpg", url:"https://themoviedb.org/person/19275"}}, {tmdbId:"6498", properties:{bornIn:"Mumbai, India", imdbId:"0239267", born:date('1953-09-07'), name:"Lillete Dubey", bio:"Lillete Dubey (born 7 September 1953) is an Indian actress who has worked in theatre, television and Hindi films. \n\nLillete was born in Pune as Lillete Kiswani to a Sindhi Hindu family.  Her father, Govind Kiswani, was an engineer with the Indian Railways, and her mother, Leela, was a gynaecologist who worked with the Indian Army...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qeAlaycZ3ATHr2P6LV1V5LeC4hV.jpg", url:"https://themoviedb.org/person/6498"}}, {tmdbId:"120430", properties:{bornIn:" Mumbai, Maharashtra, India", imdbId:"0156858", born:date('1972-07-20'), name:"Shefali Shetty", bio:"Shefali Shah nee Shetty (born 20 July 1972), is an Indian actress who works in Bollywood films.  After making her film debut with a minor role in the 1995 drama Rangeela, she played a supporting role in the crime film Satya.  Her performance in Satya received critical praise and won her the Filmfare Critics Award for Best Actress and a Best Supporting Actress nomination at the 44th Filmfare Awards...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9F8UGARvP7w10Chq5povDPHpfUC.jpg", url:"https://themoviedb.org/person/120430"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"6500", properties:{bornIn:"Delhi, India", imdbId:"0704694", born:date('1963-06-05'), name:"Vijay Raaz", bio:"Vijay Raaz is an Indian film actor.  His breakthrough hit came when he played the role of Dubeyji in the movie Monsoon Wedding.  Since then, Raaz has been cast in small, often comedic roles, in many Hindi movies, often depicting the character of a common man. \n\nRaaz was born and raised in Delhi where he attended Kirori Mal College.  While at college he was a part of the dramatic society The Players.  He also appeared in plays at the National School of Drama...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bLSjiy51UPjVnTYRDmgRUy1VOwD.jpg", url:"https://themoviedb.org/person/6500"}}, {tmdbId:"27552", properties:{bornIn:"Manhasset, New York, United States", imdbId:"0251678", born:date('1964-05-17'), name:"David Eigenberg", bio:"David Eigenberg (born May 17, 1964) is an American actor.  He is known for his role of Steve Brady on the HBO comedy Sex and the City...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3JOY715n7Low0Y1a9YZAzhNjvZM.jpg", url:"https://themoviedb.org/person/27552"}}, {tmdbId:"27550", properties:{imdbId:"0870430", name:"Bob Tracey", url:"https://themoviedb.org/person/27550"}}, {tmdbId:"27681", properties:{imdbId:"0256045", name:"Ron Emanuel", bio:"Ron Emanuel is a film actor...", url:"https://themoviedb.org/person/27681"}}, {tmdbId:"1172661", properties:{bornIn:"LA, California, USA", imdbId:"0808057", born:date('1992-11-30'), name:"Dylan Smith", bio:"From Wikipedia, the free encyclopedia\n\nDylan Daniel Smith (born November 30, 1992) is an American actor.  He appeared in the films One Hour Photo and Pirates of the Caribbean: The Curse of the Black Pearl, and also guest starred on Gilmore Girls. \n\nSmith was born in Los Angeles, California on November 30, 1992, the son of Lisa and Danny Smith.  He has a younger brother, Lyndon.  Smith is an athlete who plays baseball and hockey...", url:"https://themoviedb.org/person/1172661"}}, {tmdbId:"5151", properties:{bornIn:"Gadsden, Alabama, USA", imdbId:"0335275", born:date('1949-09-18'), name:"Beth Grant", bio:"Beth Grant (born September 18, 1949) is an American actress.  She is known for often playing characters who are conservatives, religious zealots or sticklers for rules...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zAT9GvzJE0ytL3C36L461cgKI9p.jpg", url:"https://themoviedb.org/person/5151"}}, {tmdbId:"52119", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0005259", born:date('1958-11-12'), name:"Megan Mullally", bio:"Megan Mullally (born November 12, 1958) is an American actress and singer.  After working in the theatre in Chicago, Mullally moved to Los Angeles in 1985 and began to appear in supporting roles in film and television productions.  She made her Broadway debut in Grease in 1994 and she has since appeared in several Broadway musicals.  From 1998 until 2006, she played Karen Walker on the TV sitcom Will & Grace, most arguably her best known role to date...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Aryh1osN66sCLAgsDugY7n4w0az.jpg", url:"https://themoviedb.org/person/52119"}}, {tmdbId:"65571", properties:{bornIn:"Bologna, Italy", imdbId:"0009629", born:date('1971-03-02'), name:"Stefano Accorsi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v0juBdStV3KECZL1nEL7AkbWQ0j.jpg", url:"https://themoviedb.org/person/65571"}}, {tmdbId:"105685", properties:{bornIn:"Rome, Lazio, Italy", imdbId:"0583856", born:date('1974-11-09'), name:"Giovanna Mezzogiorno", bio:"Giovanna Mezzogiorno (born November 9, 1974) is an Italian theatre and film actress. \n\nGiovanna Mezzogiorno was born in Rome, November 9, 1974, daughter of actors Vittorio Mezzogiorno and Cecilia Sacchi.  She grew up watching her parents on set, conscious about acting.  At first she wanted to become a ballerina and she studied dancing for 13 years.  She is an atheist. \n\nDescription above from the Wikipedia article Giovanna Mezzogiorno, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uR2MenLF5uupH5E2hCmlBNKgleh.jpg", url:"https://themoviedb.org/person/105685"}}, {tmdbId:"31078", properties:{bornIn:"Saitama, Japan", imdbId:"0297885", born:date('1982-05-15'), name:"Tatsuya Fujiwara", bio:"Tatsuya Fujiwara was born on May 15, 1982 in Chichibu, Japan.  He is known for his work on Battle Royale (2000), Battle Royale II (2003) and Death Note (2006)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1nR5cYgh9SaA7fGdQAXznyqObPv.jpg", url:"https://themoviedb.org/person/31078"}}, {tmdbId:"31079", properties:{bornIn:"Tokyo - Japan", imdbId:"0535329", born:date('1985-07-11'), name:"Aki Maeda", bio:"From Wikipedia, the free encyclopedia\n\nAki Maeda (前田亜季 Maeda Aki, born 11 July 1985 in Tokyo, Japan) is a Japanese actress and singer.  She has an older sister named Ai Maeda. \n\nShe is perhaps best known in the west for her role as Noriko Nakagawa in the controversial 2000 film \"Battle Royale\", which she reprised for its sequel \"Battle Royale II: Requiem\".  She graduated from Hosei University in 2008...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sqKo4Ruils9gbteKPQ7hJMTPsWf.jpg", url:"https://themoviedb.org/person/31079"}}, {tmdbId:"31080", properties:{bornIn:"Takarazuka, Hyōgo, Japan", imdbId:"0945500", born:date('1974-11-11'), name:"Tarô Yamamoto", url:"https://themoviedb.org/person/31080"}}, {tmdbId:"1926", properties:{bornIn:"Aden, Yemen", imdbId:"0412850", born:date('1962-02-07'), name:"Eddie Izzard", bio:"Edward John \"Eddie\" Izzard (born 7 February 1962) is an English stand-up comedian and actor.  His comedy style takes the form of rambling, whimsical monologue and self-referential pantomime. \n\nIzzard's works include stand-up sets Unrepeatable, Definite Article, Glorious, Dress to Kill, Circle, Sexie and Stripped...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jPsZdu9DzGudytybdzjXAm77Q0r.jpg", url:"https://themoviedb.org/person/1926"}}, {tmdbId:"934041", properties:{imdbId:"0120206", name:"Clare Bullus", url:"https://themoviedb.org/person/934041"}}, {tmdbId:"2467958", properties:{name:"Simon Markey", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sKfY47SeQ2L3dahcF6PiaRj4VKA.jpg", url:"https://themoviedb.org/person/2467958"}}, {tmdbId:"52313", properties:{bornIn:"London  ", imdbId:"1169742", born:date('1922-10-08'), name:"Eileen Essell", bio:"​From Wikipedia, the free encyclopedia\n\nEileen Essell (born in London on October 8, 1922) is an English actress noted in part for the age at which she began her screen acting career. \n\nAlthough she acted on the stage for 13 years in the 1940s and 50s, her first screen performance was in her late 70s, in an episode of Doctors, and has since appeared in many other TV programmes, including The Bill, Doc Martin, Holby City, Hustle, Casualty, Ideal and Sensitive Skin...", died:date('2015-02-15'), url:"https://themoviedb.org/person/52313"}}, {tmdbId:"12", properties:{bornIn:"Los Angeles, California, USA", imdbId:"1071252", born:date('1994-05-04'), name:"Alexander Gould", bio:"From Wikipedia, the free encyclopedia. \n\nAlexander Jerome Gould (born May 4, 1994) is an American television actor and voice artist.  He is best known for his role as Shane Botwin on the Showtime TV series Weeds and for having provided the voice of Nemo in Pixar's Finding Nemo. \n\nDescription above from the Wikipedia article Alexander Gould, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fe4mUSp0XotA6Ku4Bs69Q9o2lqU.jpg", url:"https://themoviedb.org/person/12"}}, {tmdbId:"80124", properties:{imdbId:"0937766", born:date('1963-09-22'), name:"Guitar Wolf", url:"https://themoviedb.org/person/80124"}}, {tmdbId:"80126", properties:{imdbId:"0937729", born:date('1969-08-29'), name:"Drum Wolf", url:"https://themoviedb.org/person/80126"}}, {tmdbId:"80125", properties:{imdbId:"0937675", born:date('1967-01-08'), name:"Bass Wolf", died:date('2005-03-31'), url:"https://themoviedb.org/person/80125"}}] AS row
