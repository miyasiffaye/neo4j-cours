UNWIND [{tmdbId:"133212", properties:{bornIn:"Sydney, New South Wales, Australia", imdbId:"0477127", born:date('1976-11-28'), name:"Ryan Kwanten", bio:"From Wikipedia, the free encyclopedia.    Ryan Christian Kwanten (born 28 November 1976) is an Australian actor.  He played Vinnie Patterson from 1997 to 2002 on the Australian soap-opera Home and Away.  After his stint ended he joined the American teen-oriented drama Summerland portraying Jay Robertson.  In 2008, he was cast as Jason Stackhouse in True Blood. \n\nDescription above from the Wikipedia article Ryan Kwanten, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9vSgihsXFFlEStL5o6z5v3J71LI.jpg", url:"https://themoviedb.org/person/133212"}}, {tmdbId:"57574", properties:{bornIn:"Malaysia", imdbId:"0531933", born:date('1981-02-21'), name:"Shauna Macdonald", bio:"From Wikipedia, the free encyclopedia.  Shauna Macdonald (born 1981) is a Scottish television and film actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/37npPeVbx8ZZ0e54gs9JrrxAxoA.jpg", url:"https://themoviedb.org/person/57574"}}, {tmdbId:"57575", properties:{bornIn:"Hong Kong", imdbId:"0413238", born:date('1980-08-12'), name:"Natalie Mendoza", bio:"Natalie Jackson Mendoza (born 12 August 1980) is a Hong Kong-born Australian-British classical theatre-trained actress and musician.  She is best known for her role as one of the main characters, Jackie Clunes in the British TV drama Hotel Babylon and as tough girl Juno in the acclaimed horror thriller The Descent, as well as its sequel, The Descent Part 2.  She was playing Arachne in the Broadway musical, Spider-Man: Turn Off the Dark but left the show...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d4W8MXN1DESMfYFLUpaWKCxArLO.jpg", url:"https://themoviedb.org/person/57575"}}, {tmdbId:"57576", properties:{bornIn:"Penzance, Cornwall, UK", imdbId:"0717157", born:date('1980-12-23'), name:"Alex Reid", bio:"Alex Reid is a British actress, born and raised in Cornwall and trained at the Webber Douglas Academy of Dramatic Art...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dfZU6FsWj0cAeZL32hjKs5Ow5s1.jpg", url:"https://themoviedb.org/person/57576"}}, {tmdbId:"57577", properties:{bornIn:"Den Haag, Netherlands", imdbId:"0611731", born:date('1973-05-18'), name:"Saskia Mulder", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jdeI2fJWtlLKjZMZKg0aoBaC8et.jpg", url:"https://themoviedb.org/person/57577"}}, {tmdbId:"1017347", properties:{bornIn:"Cairns, Queensland, Australia", imdbId:"4154798", born:date('1989-08-10'), name:"Brenton Thwaites", bio:"An Australian actor, best known for portraying Luke Gallagher in the Fox8 teen drama series, SLiDE, and Stu Henderson in the soap opera Home and Away.  Thwaites starred in The Giver as one of the male leads, Jonas, opposite Jeff Bridges and Meryl Streep.  Thwaites was born in Cairns, Queensland, in 1989 to Peter and Fiona Thwaites.  He has a sister, Stacey.  He underwent secondary education at Cairns State High School in Far North Queensland, with his senior year held in 2006...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/k1Eyn5u5o9XCsaMMwHttqz2Dcw0.jpg", url:"https://themoviedb.org/person/1017347"}}, {tmdbId:"28846", properties:{bornIn:"Vällingby, Stockholm, Sweden", imdbId:"0002907", born:date('1976-08-25'), name:"Alexander Skarsgård", bio:"Alexander Johan Hjalmar Skarsgård (born August 25, 1976) is a Swedish actor.  He is best known for his roles as vampire Eric Northman on the HBO series True Blood, a male model in Zoolander and Brad Colbert in the HBO miniseries Generation Kill.  Description above from the Wikipedia article Alexander Skarsgård, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aVAPqwoElxk9O8QID96l6qG4x2E.jpg", url:"https://themoviedb.org/person/28846"}}, {tmdbId:"59237", properties:{bornIn:"Leningrad, Russian SFSR, Soviet Union", imdbId:"1760272", born:date('1980-02-09'), name:"Margarita Levieva", bio:"From Wikipedia, the free encyclopedia. \n\nMargarita Levieva (born February 9, 1980) is an American actress.  Born in the Soviet Union, she was a professional gymnast before going on to star in the films The Invisible, Adventureland and Spread. \n\nDescription above from the Wikipedia article Margarita Levieva, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7rSf7C5oKuvjgEBfe2GVv064Le.jpg", url:"https://themoviedb.org/person/59237"}}, {tmdbId:"59238", properties:{bornIn:"Stuart, Florida, USA", imdbId:"0549815", born:date('1984-10-03'), name:"Chris Marquette", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/auJI59lLgNdjN8QcqmEywrYnW9C.jpg", url:"https://themoviedb.org/person/59238"}}, {tmdbId:"54593", properties:{bornIn:"Quincy, Illinois, USA", imdbId:"1561561", born:date('1981-10-09'), name:"Tad Hilgenbrink", bio:"Tad Davie Hilgenbrinck Quintana (born October 9, 1981) is an American actor, known for his role as Matt Stifler in 'American Pie Presents: Band Camp'; 'The Hills Run Red' and 'The Curiosity of Chance'...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cECyfEB8GI4zTYXEOLEpRTxINLo.jpg", url:"https://themoviedb.org/person/54593"}}, {tmdbId:"54594", properties:{bornIn:"San Diego, California, USA", imdbId:"1489118", born:date('1977-04-26'), name:"Jason Earles", bio:"Jason Daniel Earles (born April 26, 1977) is an American actor, comedian, and martial artist, known for his role as Jackson Stewart in the Disney Channel sitcom Hannah Montana and his role as Rudy Gillespie in the Disney XD series Kickin' It...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c0QreOwnzTYpkxTk7D7fDuBr5ni.jpg", url:"https://themoviedb.org/person/54594"}}, {tmdbId:"83348", properties:{imdbId:"0016923", name:"Chris Albrecht", url:"https://themoviedb.org/person/83348"}}, {tmdbId:"10403", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0066098", born:date('1925-02-03'), name:"Shelley Berman", bio:"Shelley Berman (1925–2017) was an American comedian, actor, writer, teacher, lecturer, and poet...", died:date('2017-09-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/btARWtcBlpQo7BUXijI5Eap8SXi.jpg", url:"https://themoviedb.org/person/10403"}}, {tmdbId:"74294", properties:{bornIn:"Sacramento, California, USA", imdbId:"1895845", born:date('1961-01-22'), name:"Daniel Johnston", bio:"From Wikipedia, the free encyclopedia\n\nDaniel Dale Johnston (born January 22, 1961) is an American singer, songwriter, musician, and artist.  Johnston was the subject of the 2006 documentary The Devil and Daniel Johnston.  He currently lives in Waller, Texas. \n\nJohnston has been diagnosed with manic depression which has been a recurring problem throughout his life.  One critic from Pitchfork Media writes that Johnston's recordings range from \"spotty to brilliant...", url:"https://themoviedb.org/person/74294"}}, {tmdbId:"2484310", properties:{name:"Laurie Allen", url:"https://themoviedb.org/person/2484310"}}, {tmdbId:"2484311", properties:{name:"Brian Beattie", url:"https://themoviedb.org/person/2484311"}}, {tmdbId:"1091199", properties:{imdbId:"0085405", name:"Louis Black", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dXJsKPzZNTkwsEiXoJCEFbSg6iX.jpg", url:"https://themoviedb.org/person/1091199"}}, {tmdbId:"52933", properties:{imdbId:"0789171", born:date('1978-01-01'), name:"Timm Sharp", bio:"From Wikipedia, the free encyclopedia. \n\nTimm Sharp is an American actor known mainly for his TV roles, including a lead role in the 2001 comedy Undeclared, as well as recurring roles in Six Feet Under and 'Til Death.  He is set to co-star with Laura Dern in the upcoming HBO comedy series enlightened in 2011...", url:"https://themoviedb.org/person/52933"}}, {tmdbId:"21200", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"0004715", born:date('1970-05-04'), name:"Will Arnett", bio:"William Emerson \"Will\" Arnett (born May 4, 1970) is a Canadian actor and comedian best known for roles as George Oscar \"G. O. B. \" Bluth II on the Fox comedy Arrested Development and as Devon Banks on the NBC comedy 30 Rock.  Since his success on Arrested Development, Arnett has landed major film roles.  He recently played supporting roles in the comedy films Semi-Pro, Blades of Glory, and Hot Rod.  He starred in 2006's Let's Go to Prison and 2007's The Brothers Solomon...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nFRUYCfw34wTvLJe9xdhFrm0jIU.jpg", url:"https://themoviedb.org/person/21200"}}, {tmdbId:"17442", properties:{bornIn:"Kern County, California, U.S.", imdbId:"0307726", born:date('1984-04-11'), name:"Kelli Garner", bio:"Kelli Brianne Garner is an American actress.  Her credits include Man of the House, The Aviator, Bully and Thumbsucker.  She appeared in two Green Day music videos \"Jesus of Suburbia\" and the unreleased \"Whatsername\".  In December 2005, Garner starred in the Off-Broadway production of Dog Sees God: Confessions of a Teenage Blockhead at the Century Center for the Performing Arts...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6EDL2MXZigqpjUWmRclMfqIdIXp.jpg", url:"https://themoviedb.org/person/17442"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"82841", properties:{imdbId:"2137535", name:"Joe Bishop", bio:"No one has entered a biography for Joe Bishop...", url:"https://themoviedb.org/person/82841"}}, {tmdbId:"82842", properties:{imdbId:"1854513", name:"Keith Cavill", url:"https://themoviedb.org/person/82842"}}, {tmdbId:"82843", properties:{imdbId:"1992512", name:"Andy Cohn", url:"https://themoviedb.org/person/82843"}}, {tmdbId:"82844", properties:{imdbId:"1988277", name:"Scott Hogsett", url:"https://themoviedb.org/person/82844"}}, {tmdbId:"11279", properties:{bornIn:"London, England, UK", imdbId:"0019885", born:date('1953-10-26'), name:"Roger Allam", bio:"​From Wikipedia, the free encyclopedia\n\nRoger Allam (born 26 October 1953) is an English actor, known primarily for his stage career, although he has performed in film and television.  He played Inspector Javert in the original London production of the stage musical Les Misérables. \n\nDescription above from the Wikipedia article Roger Allam, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hrtVjATnltwatFCOjhtCZTnN2hW.jpg", url:"https://themoviedb.org/person/11279"}}, {tmdbId:"23599", properties:{imdbId:"2286839", name:"Larry Berry", url:"https://themoviedb.org/person/23599"}}, {tmdbId:"23592", properties:{imdbId:"1815469", name:"Tommy the Clown", bio:"​From Wikipedia, the free encyclopedia. \n\nThomas Johnson, also known as Tommy the Clown, is an American dancer best known as the inventor of the \"clowning\" style of dance, which evolved into krumping.  Johnson invented the style in 1992 to enhance birthday party clown acts, thereby creating the concept of \"hip-hop clowns\".  Johnson and his followers have performed at birthday parties ranging from inner city communities to celebrities like Madonna, Pamela Anderson, and Cedric the Entertainer...", url:"https://themoviedb.org/person/23592"}}, {tmdbId:"23596", properties:{imdbId:"1967578", name:"Dragon", url:"https://themoviedb.org/person/23596"}}, {tmdbId:"23598", properties:{imdbId:"1965622", name:"La Niña", url:"https://themoviedb.org/person/23598"}}, {tmdbId:"932362", properties:{imdbId:"1947120", name:"Doug Bruce", url:"https://themoviedb.org/person/932362"}}, {tmdbId:"84382", properties:{imdbId:"1527186", born:date('1946-06-07'), name:"Ken Adelman", bio:"From Wikipedia, the free encyclopedia. \n\nKenneth Lee Adelman (born June 9, 1946) is an American diplomat, political writer, policy analyst and William Shakespeare historian...", url:"https://themoviedb.org/person/84382"}}, {tmdbId:"84383", properties:{bornIn:"Chicago, Illinois", imdbId:"0038781", born:date('1942-05-09'), name:"John Ashcroft", bio:"From Wikipedia, the free encyclopedia. \n\nJohn David Ashcroft (born May 9, 1942) is a United States politician who was the 79th United States attorney general.  He served during the first term of President George W.  Bush from 2001 until 2005.  Ashcroft was previously the 50th Governor of Missouri (1985–1993) and a US senator from Missouri (1995–2001)...", url:"https://themoviedb.org/person/84383"}}, {tmdbId:"35747", properties:{bornIn:"New Delhi, India", imdbId:"0451307", born:date('1970-08-16'), name:"Saif Ali Khan", bio:"Saif Ali Khan is an Indian film actor and producer.  The son of actress Sharmila Tagore and the late cricketer Mansoor Ali Khan Pataudi. \n\nKhan made his acting debut in Yash Chopra's unsuccessful drama Parampara (1993), but achieved success with his roles in the romantic drama Yeh Dillagi and the action film Main Khiladi Tu Anari (both 1994)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/85uKiFDEcIqzLh0GwqYvecXw4uA.jpg", url:"https://themoviedb.org/person/35747"}}, {tmdbId:"35068", properties:{bornIn:"Mumbai, Maharashtra, India", imdbId:"1799038", born:date('1978-01-01'), name:"Vidya Balan", bio:"Vidya Balan  is an Indian actress, who appears in Hindi films.  After graduating with a degree in sociology, she started her career starring in music videos, television shows and commercials, before appearing in feature films. \n\nBalan made her movie debut in the Bengali film, Bhalo Theko in 2003.  She later made her Hindi film debut with Parineeta (2005), which earned her a Filmfare Award for Best Female Debut as well as her first Best Actress nomination at the same ceremony...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hOmPQwRmDlaRCAMTwLqPXkWsSnr.jpg", url:"https://themoviedb.org/person/35068"}}, {tmdbId:"85881", properties:{bornIn:"Mumbai, Maharashtra, India", imdbId:"0004569", born:date('1959-07-29'), name:"Sanjay Dutt", bio:"From Wikipedia, the free encyclopedia. \n\nSanjay Dutt (born 29 July 1959) is an Indian Hindi film actor and politician.  Dutt is the son of Hindi film stars Sunil and Nargis Dutt.  He made his debut in 1981. \n\nDescription above from the Wikipedia article Sanjay Dutt, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oq4pnvWhl1HxKpp0KVlSfAr3Tiu.jpg", url:"https://themoviedb.org/person/85881"}}, {tmdbId:"85669", properties:{bornIn:"Hyderabad, Telangana, India", imdbId:"1069850", born:date('1981-12-09'), name:"Dia Mirza", bio:"Dia Mirza is an Indian model, actress, producer and beauty queen who won Miss Asia Pacific 2000 title.  Mirza has primarily worked in Bollywood and is known in the media for her social work.  She made her acting debut with Rehna Hai Tere Dil Mein...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9YZ36yVYGfRqsMRVtGeGFxDs1GT.jpg", url:"https://themoviedb.org/person/85669"}}, {tmdbId:"83527", properties:{bornIn:"Kyoto, Kyoto Prefecture, Japan", imdbId:"0855429", born:date('1972-12-28'), name:"Shinobu Terajima", bio:"Shinobu Terajima is a Japanese actress.  Her feature films include Akame 48 Waterfalls (2003) and Vibrator (2003).  For her role in Caterpillar (2010), Terajima won the Silver Bear for Best Actress at the 60th Berlin Film Festival while her performance in Oh Lucy! (2017) earned her an Independent Spirit Award nomination for Best Actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j21T0BY3ty17GnLAa2IkAVfky5u.jpg", url:"https://themoviedb.org/person/83527"}}, {tmdbId:"83643", properties:{bornIn:"Asakusa, Tokyo, Japan", imdbId:"1066120", born:date('1956-06-05'), name:"Ken Nakamoto", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8kaIUU2xaUWcDU9AeptLtU1LZW4.jpg", url:"https://themoviedb.org/person/83643"}}, {tmdbId:"20631", properties:{bornIn:"Griffin, Georgia, USA", imdbId:"0372475", born:date('1953-06-27'), name:"Ann Hearn", url:"https://themoviedb.org/person/20631"}}, {tmdbId:"1787047", properties:{bornIn:"Lódz, Lódzkie, Poland", born:date('1956-04-04'), name:"Gregory Wagrowski", url:"https://themoviedb.org/person/1787047"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"74688", properties:{bornIn:"Harvey, Illinois, USA", imdbId:"1551130", born:date('1993-08-26'), name:"Keke Palmer", bio:"Lauren Keyana \"Keke\" Palmer was born August 26, 1993 in Harvey, Illinois and raised in Robbins, Illinois...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xnOrSVnqsfixk3bDV1sX7WRFZWR.jpg", url:"https://themoviedb.org/person/74688"}}, {tmdbId:"67656", properties:{imdbId:"1519453", name:"Nathan Baesel", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vPK9Ga9VwcUnpXnZyjihFPz5TZ7.jpg", url:"https://themoviedb.org/person/67656"}}, {tmdbId:"11515", properties:{bornIn:"New York, New York City, U.S.", imdbId:"0324462", born:date('1977-05-20'), name:"Angela Goethals", bio:"From Wikipedia, the free encyclopedia\n\nAngela Bethany Goethals (born May 20, 1977) is an American film, television and stage actress.  Goethals made her acting debut in the Broadway production of Coastal Disturbances in 1987, and later became known for her role in Home Alone (1990) playing the sister of Macaulay Culkin's character in the film...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uX0ZLfklHtIk4IHZqduEvlOiNBL.jpg", url:"https://themoviedb.org/person/11515"}}, {tmdbId:"2709276", properties:{name:"Heather Berman", url:"https://themoviedb.org/person/2709276"}}, {tmdbId:"2709277", properties:{name:"Emma Therese Biegacki", url:"https://themoviedb.org/person/2709277"}}, {tmdbId:"2709278", properties:{name:"Eva Carrozza", url:"https://themoviedb.org/person/2709278"}}, {tmdbId:"2709280", properties:{name:"Evangelina Carrozzo", url:"https://themoviedb.org/person/2709280"}}, {tmdbId:"65731", properties:{bornIn:"Godalming, Surrey, England, UK", imdbId:"0941777", born:date('1976-08-02'), name:"Sam Worthington", bio:"An Australian actor, best known for the portrayals of Jake Sully in Avatar, Marcus Wright in Terminator Salvation and Perseus in Clash of the Titans and its sequel, Wrath of the Titans, and Alex Mason in the video game Call of Duty: Black Ops and its sequel Call of Duty: Black Ops II.  In 2004, Worthington received Australia's highest film award for his lead performance in Somersault...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vM1WIfYQ1HUBtlVPwB9Hp9fLcn8.jpg", url:"https://themoviedb.org/person/65731"}}, {tmdbId:"79004", properties:{bornIn:"Tokyo Prefecture, Japan", imdbId:"0393109", born:date('1972-08-14'), name:"Takako Honda", bio:"Takako Honda is a Japanese voice actress and narrator affiliated with Office Osawa...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2pg7nATwo9dA084x0AhAKECvTuh.jpg", url:"https://themoviedb.org/person/79004"}}, {tmdbId:"112138", properties:{bornIn:"Ama, Aichi Prefecture, Japan", imdbId:"0594730", born:date('1964-11-04'), name:"Yûko Mizutani", bio:"Yuko Mizutani was a Japanese voice actress.  She worked for Production Baobab until September 2011 and was affiliated with Aoni Production from December 2012 until her death...", died:date('2016-05-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nxtzhMrZdo922yHJYVZeHl1Sbbi.jpg", url:"https://themoviedb.org/person/112138"}}, {tmdbId:"7028", properties:{bornIn:"Navan, County Meath, Ireland", imdbId:"0602836", born:date('1971-11-03'), name:"Dylan Moran", bio:"From Wikipedia, the free encyclopedia. \n\nDylan Moran (born 3 November 1971) is an Irish comedian, writer, actor and filmmaker.  He is most famous for his sardonic observational comedy, the television sitcom Black Books which he co-wrote and starred in and his work with Simon Pegg in Shaun of the Dead and Run Fatboy Run.  Moran also appeared as one of the two lead characters in the Irish black comedy titled A Film with Me in It in 2008...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lGPPgqWykBCvJO6f4I5hba4IMLR.jpg", url:"https://themoviedb.org/person/7028"}}, {tmdbId:"47712", properties:{imdbId:"0372423", born:date('1957-05-13'), name:"Mark Heap", url:"https://themoviedb.org/person/47712"}}, {tmdbId:"56749", properties:{imdbId:"0860065", name:"Don Thompson", bio:"Don Thompson is a Canadian actor based in Vancouver, British Columbia...", url:"https://themoviedb.org/person/56749"}}, {tmdbId:"56750", properties:{bornIn:"Montreal, Quebec, Canada", imdbId:"0705684", born:date('1974-12-30'), name:"Xantha Radley", bio:"Xantha Radley is an actress, known for The X Files: I Want to Believe (2008), Slither (2006) and Thir13en Ghosts (2001)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aVuUP5sk4gJLybW12Nzp6jTH313.jpg", url:"https://themoviedb.org/person/56750"}}, {tmdbId:"1011102", properties:{bornIn:"Connecticut - USA", imdbId:"0497522", born:date('1984-04-23'), name:"Jesse Lee Soffer", bio:"rom Wikipedia, the free encyclopedia. \n\nJesse Lee Soffer (born April 23, 1984) is an American actor.  His film debut at the age of eight was in Matinee.  In 1995, he played the role of Bobby Brady in The Brady Bunch Movie and returned for A Very Brady Sequel a year later. \n\nSoffer was born to Stan and Jill Soffer in Connecticut and has two half sisters, Shayne and Jenna.  His maternal grandfather, Peter Bruning, was the eldest son of German immigrants Auguste E Bruning and Johanna Weirs...", url:"https://themoviedb.org/person/1011102"}}, {tmdbId:"77347", properties:{bornIn:"Mount Kisco, New York, USA", imdbId:"1694983", born:date('1983-08-17'), name:"Christopher Shand", bio:"Christopher Shand was born on August 17, 1983 in Mount Kisco, New York, USA as Christopher Ian Shand.  He is an actor and producer, known for Kumiko, the Treasure Hunter 2014, Gracie 2007 and Submergence 2017...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fp6uYzzdKUmwUGpOKWDJN6WRDHg.jpg", url:"https://themoviedb.org/person/77347"}}, {tmdbId:"90744", properties:{imdbId:"2184745", name:"Karl Girolamo", url:"https://themoviedb.org/person/90744"}}, {tmdbId:"17373", properties:{bornIn:"Hamburg, Germany", imdbId:"0900920", born:date('1968-04-29'), name:"Jürgen Vogel", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/74beYQnxmxy0uml6roEvpcm6Pej.jpg", url:"https://themoviedb.org/person/17373"}}, {tmdbId:"15480", properties:{bornIn:"Berne, Switzerland", imdbId:"0863787", born:date('1975-03-25'), name:"Sabine Timoteo", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vpZKWnwtJckK3k0cepNpKZw4aON.jpg", url:"https://themoviedb.org/person/15480"}}, {tmdbId:"15486", properties:{bornIn:"Güstrow, Germany", imdbId:"0475982", born:date('1957-04-04'), name:"Peter Kurth", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1RQBjJtHiKb6l8S1qp2purktKcg.jpg", url:"https://themoviedb.org/person/15486"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"20132", properties:{bornIn:"Boston, Massachusetts, U.S", imdbId:"0287898", born:date('1984-08-03'), name:"Jon Foster", bio:"​From Wikipedia, the free encyclopedia.   \n\nJon Foster (born August 3, 1984) is an American actor.  He is perhaps best known for his roles in the 2004 film The Door in the Floor, the 2006 horror movie, Stay Alive, and co-starring opposite Jenna Elfman in the CBS comedy Accidentally on Purpose. \n\nDescription above from the Wikipedia article Jon Foster, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/od7RraCF5b8dU0YZ480AHt9XMDV.jpg", url:"https://themoviedb.org/person/20132"}}, {tmdbId:"22125", properties:{bornIn:"Hackettstown, New Jersey, USA", imdbId:"0801051", born:date('1975-11-21'), name:"Jimmi Simpson", bio:"Jimmi Simpson is an American stage, film and television actor, best known for his recurring roles in television series' such as _House of Cards_, _It's Always Sunny in Philadelphia_, and _Westworld_.  He holds a BA in Theater from Bloomsburg University, Pennsylvania, USA...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uVyNmaRuiih2B1NUeTxuRKBlPon.jpg", url:"https://themoviedb.org/person/22125"}}, {tmdbId:"3480", properties:{bornIn:"Madrid, Spain", imdbId:"0692391", born:date('1963-06-15'), name:"Blanca Portillo", bio:"From Wikipedia, the free encyclopedia. \n\nBlanca Portillo (born June 15, 1963) is a Spanish actress. \n\nDescription above from the Wikipedia article Blanca Portillo, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oIOHRtpiudtJbXFndfLs2lRI29o.jpg", url:"https://themoviedb.org/person/3480"}}, {tmdbId:"29236", properties:{bornIn:"Beverley, Yorkshire, England", imdbId:"1269412", born:date('1977-05-10'), name:"Anna Maxwell Martin", bio:"​From Wikipedia, the free encyclopedia.   \n\nAnna Maxwell Martin (born May 1977), sometimes credited as Anna Maxwell-Martin, is a two-time BAFTA award-winning English actress who has won acclaim for her performances as Lyra in His Dark Materials at the Royal National Theatre, as Esther Summerson in the BBC's 2005 adaptation of Bleak House, and as N in Channel 4's 2008 adaptation of Poppy Shakespeare...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vBAsZPe1tHPvVLViiDWYkb5k1Cu.jpg", url:"https://themoviedb.org/person/29236"}}, {tmdbId:"36662", properties:{bornIn:" Westminster, London, England", imdbId:"1659547", born:date('1985-05-28'), name:"Carey Mulligan", bio:"Carey Hannah Mulligan (born 28 May 1985) is an English actress.  She made her film debut as Kitty Bennet in Pride & Prejudice (2005).  Following Pride & Prejudice, she had roles in numerous British programs, including Doctor Who as Sally Sparrow.  In 2007, made her Broadway debut in The Seagull to critical acclaim.  In 2009, she gained widespread recognition for playing the lead role of Jenny in An Education, winning a BAFTA Award for Best Actress in a Leading Role...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vDgzF1WjiXaG6gNpcT8ZiZy9ylH.jpg", url:"https://themoviedb.org/person/36662"}}, {tmdbId:"1301827", properties:{imdbId:"6139406", name:"Finn Morrell", url:"https://themoviedb.org/person/1301827"}}, {tmdbId:"1504584", properties:{imdbId:"1401615", name:"John Bilezikjian", url:"https://themoviedb.org/person/1504584"}}, {tmdbId:"28657", properties:{bornIn:"Abington, Pennsylvania, USA", imdbId:"0289142", born:date('1966-07-14'), name:"Matthew Fox", bio:"Matthew Chandler Fox (born July 14, 1966) is an American actor and former model.  His first major role was playing older brother and family patriarch Charlie Salinger on Party of Five in the 1990s, co-starring with Scott Wolf, Neve Campbell, Jennifer Love Hewitt, and Lacey Chabert.  He is also known for his role as Dr.  Jack Shephard on the ABC drama series Lost. \n\nDescription above from the Wikipedia article Matthew Fox, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6VIfueb4j3GCsIhxnstsXlY5C3Y.jpg", url:"https://themoviedb.org/person/28657"}}, {tmdbId:"6734", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0205772", born:date('1953-06-19'), name:"Ken Davitian", bio:"From Wikipedia, the free encyclopedia. \n\nKenneth \"Ken\" Davitian (born June 19, 1953) is an American actor who is best known for his role as Borat's producer (Azamat Bagatov) in the 2006 comedy film Borat: Cultural Learnings of America for Make Benefit Glorious Nation of Kazakhstan, in which he speaks the Eastern dialect of Armenian throughout the film. \n\nDescription above from the Wikipedia article Ken Davitian, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/odykKQKSJDDJ5O5Drq1RVNaTbqM.jpg", url:"https://themoviedb.org/person/6734"}}, {tmdbId:"6735", properties:{bornIn:"Tollette, Arkansas, USA", imdbId:"0132685", born:date('1959-03-12'), name:"Luenell", bio:"From Wikipedia, the free encyclopedia. \n\nLuenell Campbell (born March 12, 1959), known professionally as Luenell, is an American comedienne and actress. \n\nShe was born in Tollette, Arkansas and uses only her first name.  She is the youngest of eight children.  She was raised in Northern California and attended Castro Valley High School.  Luenell has one daughter, and lives in Los Angeles, California...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5Mz0UEpcu1PHftgmKgoEhSSaiiA.jpg", url:"https://themoviedb.org/person/6735"}}, {tmdbId:"77120", properties:{bornIn:"Victoria, Texas, U.S.", imdbId:"0042524", born:date('1964-12-18'), name:"Steve Austin", bio:"​Steve Austin (born Steven James Anderson; December 18, 1964, later and formerly Steven James Williams), better known by his ring name \"Stone Cold\" Steve Austin, is an American film and television actor and retired professional wrestler currently signed to WWE...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/paBZhmiLWe5XWGKzpGnNOcmqC42.jpg", url:"https://themoviedb.org/person/77120"}}, {tmdbId:"108578", properties:{imdbId:"1374868", name:"Meneka Das", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i8ZpPePcnQHPco0TIHVSOOBwuI.jpg", url:"https://themoviedb.org/person/108578"}}, {tmdbId:"27397", properties:{bornIn:"Birmingham, England, UK", imdbId:"0504320", born:date('1952-02-14'), name:"Anton Lesser", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rKDn8ZHuIxl4Z3LLbUxvHdCOk0U.jpg", url:"https://themoviedb.org/person/27397"}}, {tmdbId:"54815", properties:{bornIn:"New York City, New York, USA", imdbId:"1711829", born:date('1986-03-23'), name:"Steven Strait", bio:"An American actor, fashion model, and rock singer.  The son of Jean (Viscione) and Richard Dyer Strait.  He is of half English and half Italian descent.  As a child, Steven grew up in Greenwich Village with his family.  He attended Xavier High School and enrolled himself at the Stella Adler Studio of Acting to pursue his dream as an actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wuOaC8tFlCyBlKLnJM28KkBpzNd.jpg", url:"https://themoviedb.org/person/54815"}}, {tmdbId:"143647", properties:{imdbId:"0896823", name:"Joel Virgel", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dldgBC4riWydbLSv4rm5gGFqlGp.jpg", url:"https://themoviedb.org/person/143647"}}, {tmdbId:"39518", properties:{bornIn:"Cranbrook, British Columbia, Canada", imdbId:"1628077", born:date('1999-04-27'), name:"Brooklynn Proulx", bio:"Brooklynn Marie Proulx (born April 27, 1999) is a former Canadian actress. \n\nShe was born on April 27, 1999 in Cranbrook, British Columbia, and resides in Calgary, Alberta...", url:"https://themoviedb.org/person/39518"}}, {tmdbId:"39519", properties:{imdbId:"2022539", name:"Dustin Bollinger", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jd2UbMWQMwTfl8sbHEeSTLaP2Rq.jpg", url:"https://themoviedb.org/person/39519"}}, {tmdbId:"55743", properties:{imdbId:"2367759", name:"Donald Williams", url:"https://themoviedb.org/person/55743"}}, {tmdbId:"55744", properties:{imdbId:"2366488", name:"Ellen Baker", url:"https://themoviedb.org/person/55744"}}, {tmdbId:"55745", properties:{imdbId:"2057101", name:"Franklin Chang-Diaz", url:"https://themoviedb.org/person/55745"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"94887", properties:{bornIn:"Montreal, Quebec, Canada", imdbId:"0499218", born:date('1963-05-26'), name:"Claude Legault", bio:"Claude Legault is a French Canadian film and television actor, writer and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lQL4hb8Hrt7XWeKhA0wTk3hReKb.jpg", url:"https://themoviedb.org/person/94887"}}, {tmdbId:"123181", properties:{bornIn:"Montreal, Quebec, Canada", imdbId:"0239575", born:date('1972-05-26'), name:"Martin Dubreuil", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tKbSHYYoa6duLm3l0MxDg26Z3fY.jpg", url:"https://themoviedb.org/person/123181"}}, {tmdbId:"81468", properties:{bornIn:"Montréal, Québec, Canada", imdbId:"0539981", born:date('1975-01-01'), name:"Fanny Mallette", bio:"Fanny Mallette (born 5 September 1975) is a Canadian actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8iRMCNBmt3RQFBGcQHBpeWEn7ju.jpg", url:"https://themoviedb.org/person/81468"}}, {tmdbId:"77498", properties:{bornIn:"Brussels, Belgium", imdbId:"0044073", born:date('1973-01-01'), name:"Lubna Azabal", bio:"From Wikipedia, the free encyclopedia. \n\nLubna Azabal is a Belgian actress, born in Brussels to a Moroccan father and a Spanish mother.  After studing at the Conservatoire royal of Brussels, she began a theatrical career in Belgium.  In 1997, she took her first film role when Belgian film-maker Vincent Lannoo chose her to act beside Olivier Gourmet in his short film J'adore le cinéma.  She performs in both French and Arabic films.  She was raised trilingual (French, Spanish and Berber)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qjsoXqKJPnmoMs1eyeTLBKKShYQ.jpg", url:"https://themoviedb.org/person/77498"}}, {tmdbId:"25087", properties:{imdbId:"1845700", name:"Kais Nashif", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eah8iEuGFGU0k2Aj6HLYvjjnQ5y.jpg", url:"https://themoviedb.org/person/25087"}}, {tmdbId:"1764695", properties:{bornIn:"Nazareth, Israel", imdbId:"0627213", born:date('1950-08-03'), name:"Lutuf Nouasser", url:"https://themoviedb.org/person/1764695"}}, {tmdbId:"38941", properties:{bornIn:"England, UK", imdbId:"0836343", born:date('1978-05-16'), name:"Jim Sturgess", bio:"James Anthony \"Jim\" Sturgess (born 16 May 1981) is a British actor and musician.  His breakout role was playing Jude in 2007's Across the Universe...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c1Q99UEGfU4Laa4o8yu7kGJFIY1.jpg", url:"https://themoviedb.org/person/38941"}}, {tmdbId:"38942", properties:{bornIn:"Jersey City, New Jersey, USA", imdbId:"2085629", born:date('1978-01-10'), name:"Dana Fuchs", bio:"Dana Fuchs (January 10, 1976) is an American singer, songwriter, actress and voice over talent most famous for her performance in the 2007 film Across the Universe, in which she played the role of Sadie...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bW4q1cA9swJA3YakadFa5l5CM7d.jpg", url:"https://themoviedb.org/person/38942"}}, {tmdbId:"60033", properties:{bornIn:"Harlem, New York, New York, USA", imdbId:"1861624", born:date('1982-11-15'), name:"Yaya DaCosta", bio:"Yaya DaCosta (born Camara DaCosta Johnson; November 15, 1982) is an American actress and fashion model.  She was the runner-up in Cycle 3 of America's Next Top Model. \n\nDescription above from the Wikipedia article Yaya DaCosta, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9diTHV1EIUNbXIYsTeDM5M3oQU9.jpg", url:"https://themoviedb.org/person/60033"}}, {tmdbId:"52901", properties:{imdbId:"1272833", name:"Yun Qu", url:"https://themoviedb.org/person/52901"}}, {tmdbId:"37979", properties:{bornIn:"Ottawa, Ontario, Canada", imdbId:"0391820", born:date('1977-03-01'), name:"Emily Holmes", bio:"​From Wikipedia, the free encyclopedia\n\nEmily Holmes (born March 1, 1977) is a Canadian television and film actress. \n\nHolmes was born in Ottawa, Ontario.  She has appeared in such television series as Night Visions, Mysterious Ways, The Dead Zone, Stargate SG-1, and more.  In 2002, Holmes appear in Steven Spielberg's Taken as Julie Crawford.  She also appeared in the webisode series Battlestar Galactica: The Resistance and Gene Roddenberry's Andromeda...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/251GyvALh5NiorRIwvn1oLgVmI6.jpg", url:"https://themoviedb.org/person/37979"}}, {tmdbId:"57449", properties:{bornIn:"Camden, London, England, UK", imdbId:"0562003", born:date('1975-05-01'), name:"Jodhi May", bio:"From Wikipedia, the free encyclopedia. \n\nJodhi May (born 8 May 1975) is an English actress. \n\nDescription above from the Wikipedia article Jodhi May, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iqVk4bZyBkIOOWxaYxiezcApwRG.jpg", url:"https://themoviedb.org/person/57449"}}, {tmdbId:"1908634", properties:{imdbId:"2474010", name:"Catherine An", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x4WCcwU4b5WF6fbclARVt4lbcXI.jpg", url:"https://themoviedb.org/person/1908634"}}, {tmdbId:"74021", properties:{imdbId:"0508353", born:date('1929-01-01'), name:"Bin Li", url:"https://themoviedb.org/person/74021"}}, {tmdbId:"77334", properties:{bornIn:"Houston, Texas, USA", imdbId:"2425105", born:date('1998-12-15'), name:"Chandler Canterbury", bio:"From Wikipedia, the free encyclopedia. \n\nChandler Canterbury (born December 15, 1998) is an American child actor. \n\nDescription above from the Wikipedia article Chandler Canterbury, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/flfh9tLEiERwZFQPlcShejI1TS8.jpg", url:"https://themoviedb.org/person/77334"}}, {tmdbId:"84964", properties:{bornIn:"Melbourne, Victoria, Australia", imdbId:"3041648", born:date('1988-01-01'), name:"Lara Robinson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cv4oQY0PSCEmPL82Ez5E4LTq6aA.jpg", url:"https://themoviedb.org/person/84964"}}, {tmdbId:"66658", properties:{bornIn:"Hamlin, Texas, USA", imdbId:"2052567", name:"Jae Head", bio:"Jae Head (born December 27, 1996) is an American teen actor.  He is best known for portraying Sean Junior (S. J. ) Tuohy, son of Sean and Leigh Anne Tuohy (played by Tim McGraw and Sandra Bullock), in the 2009 film The Blind Side directed by John Lee Hancock.  Head first gained popularity by playing Bo Miller, a young boy befriended by Tim Riggins on the television series Friday Night Lights...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nNh2DiYXZneyeiYDitKT6s1AwEy.jpg", url:"https://themoviedb.org/person/66658"}}, {tmdbId:"25438", properties:{bornIn:"Chichester, West Sussex, England", imdbId:"1968873", born:date('1988-04-07'), name:"Ed Speleers", bio:"​From Wikipedia, the free encyclopedia.   \n\nEdward John \"Ed\" Speleers (born 7 April 1988) is an English actor.  He is best known for his début in the title role in the 2006 film Eragon. \n\nDescription above from the Wikipedia article Edward Speleers, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jiqnxlbxMZCuqjdQVZdzVzOLED1.jpg", url:"https://themoviedb.org/person/25438"}}, {tmdbId:"30066", properties:{bornIn:"Adelaide, South Australia, Australia", imdbId:"1065316", born:date('1973-08-27'), name:"Rhett Giles", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vYCaEMNpSLGqiYZftxhlSkwhtsP.jpg", url:"https://themoviedb.org/person/30066"}}, {tmdbId:"113228", properties:{bornIn:"Johannesburg, South Africa", imdbId:"1723148", born:date('1980-12-17'), name:"Tinarie van Wyk Loots", url:"https://themoviedb.org/person/113228"}}] AS row
