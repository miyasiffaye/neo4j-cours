UNWIND [{tmdbId:"141541", properties:{bornIn:"Seoul, South Korea", imdbId:"2175143", born:date('1970-03-09'), name:"Je-mun Yun", bio:"Yoon Je-moon (born March 9, 1970) is a South Korean actor.  He is best known for his role in the 2009 television series Iris. \n\nDescription above from the Wikipedia article Yoon Je-moon, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/t7MPkH0eHFqs19NIares768UohH.jpg", url:"https://themoviedb.org/person/141541"}}, {tmdbId:"1330", properties:{bornIn:"Berlin, Germany", imdbId:"0597480", born:date('1976-12-08'), name:"Dominic Monaghan", bio:"From Wikipedia, the free encyclopedia. \n\nDominic Bernard Patrick Luke Monaghan ( born 8 December 1976) is an English actor.  He has received international attention from playing Merry in Peter Jackson's adaptation of J.  R.  R.  Tolkien's The Lord of the Rings and for his role as Charlie Pace on the television show Lost...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Z2sWde6fHtnZk2fFMVgL5Jfwzv.jpg", url:"https://themoviedb.org/person/1330"}}, {tmdbId:"31268", properties:{bornIn:"New York, New York, USA", imdbId:"0275244", born:date('1963-03-23'), name:"Larry Fessenden", bio:"Laurence T.  Fessenden is an American actor, producer, writer, director, film editor, and cinematographer.  He is the founder of the New York based independent production shingle Glass Eye Pix...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qxccgH2oyAZnmz3ZxlpCPuhhvVi.jpg", url:"https://themoviedb.org/person/31268"}}, {tmdbId:"30315", properties:{bornIn:"Leicester, England, UK", imdbId:"0035514", born:date('1971-08-22'), name:"Richard Armitage", bio:"Richard Armitage was born and raised in Leicester, England.  He attended Pattison College in Binley Road, Coventry, and studied at LAMDA (the London Academy of Music and Dramatic Art).  His first appearance on the screen was in a small role in This Year's Love (1999), but it was Sparkhouse (2002) (TV) that gave him a break-through role as the charming but a bit odd character of John Standring opposite Sarah Smart...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lRWWodfrOd5SaLnFrz7UryFhasI.jpg", url:"https://themoviedb.org/person/30315"}}, {tmdbId:"15566", properties:{bornIn:"Tucson, Arizona, USA", imdbId:"0495095", born:date('1972-10-17'), name:"Sharon Leal", bio:"Sharon Leal is actress and producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3dJCnAZDG2ZN7Hxct8UAdPePpuz.jpg", url:"https://themoviedb.org/person/15566"}}, {tmdbId:"74861", properties:{bornIn:"Gifu, Japan", imdbId:"0411692", born:date('1975-08-03'), name:"Hideaki Itô", bio:"Hideaki Ito  (伊藤 英明 Itō Hideaki, born August 3, 1975) is a Japanese actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7AGpf6imRhpfdTCkiyS5UJFJJAf.jpg", url:"https://themoviedb.org/person/74861"}}, {tmdbId:"74862", properties:{bornIn:"Kanagawa, Japan", born:date('1975-05-19'), name:"Masanobu Andô", bio:"Masanobu Andō  (安藤 政信, Andō Masanobu, born May 19, 1975 in Kawasaki, Kanagawa Prefecture, Japan) is a Japanese actor and director. \n\nFor his second film, in 1996, he won the Film Academy of Japan's Best New Actor Award, starring in Takeshi Kitano's Kids Return...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/A2XP6HjXjoTeR5fYHxL7YecnN2S.jpg", url:"https://themoviedb.org/person/74862"}}, {tmdbId:"58662", properties:{bornIn:"Tokyo, Tokyo, Japan", imdbId:"0766233", born:date('1960-12-10'), name:"Kôichi Satô", bio:"Koichi Sato (佐藤 浩市 Satō Kōichi, born December 10, 1960) is a Japanese actor.  He is the son of veteran Japanese actor Rentarō Mikuni...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/meDCqB61MeNOv4cnILjTyYwkF8a.jpg", url:"https://themoviedb.org/person/58662"}}, {tmdbId:"19857", properties:{bornIn:"Tokyo, Japan", imdbId:"0597390", born:date('1952-04-08'), name:"Kaori Momoi", bio:"​From Wikipedia, the free encyclopedia. \n\nKaori Momoi  (桃井 かおり, Momoi Kaori, born April 8, 1952 in Tokyo, Japan) is a Japanese actress. \n\nMomoi was born in Tokyo, and at the young age of 12 traveled to London to study dance at the Royal Ballet Academy.  After 3 years she returned to Tokyo, later graduating from Japan's Bungakuza School of Dramatic Arts...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p4S8j3oTYG7RWshozSzSGq9DUEr.jpg", url:"https://themoviedb.org/person/19857"}}, {tmdbId:"45124", properties:{bornIn:"Dublin, Ireland", imdbId:"0360598", born:date('1970-04-21'), name:"Glen Hansard", bio:"From Wikipedia, the free encyclopedia\n\nGlen Hansard (born 21 April 1970 in Dublin, Ireland) is the Academy Award–winning principal songwriter and vocalist/guitarist for Irish group The Frames and one half of folk rock duo, The Swell Season.  He is also known for his acting, having appeared in the BAFTA winning film The Commitments, as well as starring the film Once...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mVyoivZIZPKVPdY0bXeXhtlbFHv.jpg", url:"https://themoviedb.org/person/45124"}}, {tmdbId:"45127", properties:{bornIn:"Valasské Mezirící, Czechoslovakia", imdbId:"2461627", born:date('1988-02-28'), name:"Markéta Irglová", bio:"From Wikipedia, the free encyclopedia\n\nMarkéta Irglová (born 28 February 1988, in Valašské Meziříčí, Czech Republic) is a Czech songwriter, musician, actress, and singer.  As of 2010, she resides in New York City. \n\nDescription above from the Wikipedia article Markéta Irglová, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9EHdhk4NNja86qSdlDGrgFS6O08.jpg", url:"https://themoviedb.org/person/45127"}}, {tmdbId:"231753", properties:{imdbId:"2008013", name:"Hugh Walsh", url:"https://themoviedb.org/person/231753"}}, {tmdbId:"231754", properties:{imdbId:"2478608", name:"Gerard Hendrick", url:"https://themoviedb.org/person/231754"}}, {tmdbId:"40477", properties:{bornIn:"Boyle, County Roscommon, Ireland", imdbId:"1483369", born:date('1979-10-09'), name:"Chris O'Dowd", bio:"Chris O'Dowd (born 9 October 1979) is an Irish comedian and actor. \n\nDescription above from the Wikipedia article Chris O'Dowd, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xhfgliN8DInDVBliPq7JDeKNCvz.jpg", url:"https://themoviedb.org/person/40477"}}, {tmdbId:"92574", properties:{bornIn:"Portsmouth, England, UK", imdbId:"1742630", born:date('1975-02-08'), name:"Marc Wootton", url:"https://themoviedb.org/person/92574"}}, {tmdbId:"1669", properties:{imdbId:"0446319", born:date('1975-11-30'), name:"Dean Lennox Kelly", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dN6IZsoCnGbYfCcDGwd3kyHx5sg.jpg", url:"https://themoviedb.org/person/1669"}}, {tmdbId:"80179", properties:{bornIn:"Montreal, Quebec, Canada", imdbId:"1480090", born:date('1995-02-03'), name:"Noah Bernett", url:"https://themoviedb.org/person/80179"}}, {tmdbId:"80178", properties:{bornIn:"Montreal, Quebec, Canada", imdbId:"0031162", born:date('1972-06-22'), name:"Benz Antoine", bio:"Benz Antoine is a Haitian-Canadian film and television actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3V851yyt6SyfUr4xT0TluGEnfYR.jpg", url:"https://themoviedb.org/person/80178"}}, {tmdbId:"80122", properties:{imdbId:"1478697", name:"Paul Nakauchi", url:"https://themoviedb.org/person/80122"}}, {tmdbId:"24362", properties:{bornIn:"The Bronx, New York, USA", imdbId:"0724656", born:date('1964-10-25'), name:"Kevin Michael Richardson", bio:"From Wikipedia, the free encyclopedia. \n\nKevin Michael Richardson (born October 25, 1964) is an American actor and voice artist who currently stars in The Cleveland Show.  He is also well known for being the voice of Tartarus in the video game Halo 2. \n\nDescription above from the Wikipedia article Kevin Michael Richardson, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vgCGZMxz06kfnF97ilZTujyk7Ye.jpg", url:"https://themoviedb.org/person/24362"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"80123", properties:{imdbId:"0945194", name:"Michael Yama", url:"https://themoviedb.org/person/80123"}}, {tmdbId:"670", properties:{bornIn:"New York, USA", imdbId:"0123785", born:date('1948-07-12'), name:"Ben Burtt", bio:"From Wikipedia, the free encyclopedia.   Benjamin \"Ben\" Burtt, Jr.  (born July 12, 1948) is an American sound designer for the films Star Wars (1977), Invasion of the Body Snatchers (1978), Raiders of the Lost Ark (1981), E. T.  the Extra-Terrestrial (1982), Indiana Jones and the Last Crusade (1989) and WALL-E (2008).  He is also a film editor and director, screenwriter, and voice actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/16OhOb7WngOi4WOnGpRpbDSzYnd.jpg", url:"https://themoviedb.org/person/670"}}, {tmdbId:"72754", properties:{bornIn:"Santa Cruz, California, USA", imdbId:"2264184", born:date('1975-04-15'), name:"Elissa Knight", bio:"From Wikipedia, the free encyclopedia. \n\nElissa Knight is an American employee at Pixar Animation Studios and voice actress.  As a voice actress, her first major role was in the 2008 film WALL-E as a robot named EVE. \n\nDescription above from the Wikipedia article Elissa Knight, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vrgL992F6hQYTyNeJWDKRsrolaP.jpg", url:"https://themoviedb.org/person/72754"}}, {tmdbId:"1933834", properties:{name:"Anthony Brunelli", url:"https://themoviedb.org/person/1933834"}}, {tmdbId:"1933839", properties:{name:"Elizabeth Cohen", url:"https://themoviedb.org/person/1933839"}}, {tmdbId:"1147381", properties:{imdbId:"0189008", name:"Jonathan Crosby", url:"https://themoviedb.org/person/1147381"}}, {tmdbId:"74053", properties:{imdbId:"2825311", name:"Gerald Burke", url:"https://themoviedb.org/person/74053"}}, {tmdbId:"74054", properties:{imdbId:"2513756", name:"Ali Fadhil", url:"https://themoviedb.org/person/74054"}}, {tmdbId:"1475935", properties:{imdbId:"2828909", name:"Omar Fekeiki", url:"https://themoviedb.org/person/1475935"}}, {tmdbId:"17341", properties:{bornIn:"Puerto Rico", imdbId:"1004774", born:date('1970-12-24'), name:"Amaury Nolasco", bio:"From Wikipedia, the free encyclopedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/djcol6Qn1opxkj5oebTMtOnbOnc.jpg", url:"https://themoviedb.org/person/17341"}}, {tmdbId:"72631", properties:{bornIn:"Huelva, Spain", imdbId:"0351133", born:date('1940-04-19'), name:"José Luis Gómez", bio:"From Wikipedia, the free encyclopedia. \n\nJosé Luis Gómez García (born 19 April 1940) is a Spanish film actor.  He has appeared in 33 films since 1968.  At the 1976 Cannes Film Festival, he won the award for Best Actor in the film Pascual Duarte. \n\nDescription above from the Wikipedia article José Luis Gómez, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eG52Jd823tAQ1Ktoz7eD3CGY2PR.jpg", url:"https://themoviedb.org/person/72631"}}, {tmdbId:"56262", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"1378320", born:date('1978-05-12'), name:"Aaron Abrams", bio:"From Wikipedia, the free encyclopedia.   Aaron Abrams (born 12 May 1978) is a Canadian actor, born in Toronto, Ontario, who has worked in both film and television.  He was a regular on the television series 'Slings and Arrows' (The Sundance Channel), 'The State Within' (BBC), and 'Runaway' (CW).  Abrams is best known for writing and starring in the controversial film Young People Fucking in 2007, for which he won a Canadian Comedy Award in 2009...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/JBmN6Byyo1QSKIagjbCrTFX96I.jpg", url:"https://themoviedb.org/person/56262"}}, {tmdbId:"43903", properties:{bornIn:" Vancouver, British Columbia, Canada", imdbId:"0005318", born:date('1980-08-28'), name:"Carly Pope", bio:"​From Wikipedia, the free encyclopedia.   \n\nCarly Pope (born August 28, 1980) is a Canadian actress. \n\nDescription above from the Wikipedia article  Carly Pope, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i2yFxKvqmeJElTRTaOWw6b4HRRc.jpg", url:"https://themoviedb.org/person/43903"}}, {tmdbId:"34915", properties:{bornIn:"Kitchener, Ontario, Canada", imdbId:"0095746", born:date('1974-08-28'), name:"Kristin Booth", bio:"Kristin Booth is a Canadian stage, film and television actress, best known for playing Shane McInerney on the Hallmark Original franchise \"Signed Sealed Delivered\".  She holds a BFA from the Theatre School at Ryerson University, Toronto, Ontario, Canada...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/366SBcUxgrh8374uNetOYlP9fo0.jpg", url:"https://themoviedb.org/person/34915"}}, {tmdbId:"204459", properties:{born:date('1979-12-03'), name:"Josh Dean", url:"https://themoviedb.org/person/204459"}}, {tmdbId:"77996", properties:{bornIn:"Islington, London, England, UK", imdbId:"2633535", born:date('1997-04-01'), name:"Asa Butterfield", bio:"Asa Butterfield (born 1 April 1997) is an English actor.  He is best known for his leading roles in the Holocaust film The Boy in the Striped Pyjamas, Martin Scorsese's Hugo, and the film adaptation of Ender's Game...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wy20YeD36WvaAuwAKkrDe8bzyY0.jpg", url:"https://themoviedb.org/person/77996"}}, {tmdbId:"77997", properties:{imdbId:"2726789", name:"Zac Mattoon O'Brien", url:"https://themoviedb.org/person/77997"}}, {tmdbId:"1728070", properties:{name:"Domonkos Németh", url:"https://themoviedb.org/person/1728070"}}, {tmdbId:"77999", properties:{imdbId:"2646294", name:"Henry Kingsmill", url:"https://themoviedb.org/person/77999"}}, {tmdbId:"17401", properties:{bornIn:"Sarasota, Florida, USA", imdbId:"0740535", born:date('1951-11-17'), name:"Stephen Root", bio:"Stephen Root (born November 17, 1951) is an American actor.  He is principally known for his comedic work, but has won acclaim for his occasional dramatic roles. \n\nDescription above from the Wikipedia article Stephen Root, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jibbLPNtseUTMwlupwRTtQU1By1.jpg", url:"https://themoviedb.org/person/17401"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"234352", properties:{bornIn:"Dalby, Queensland, Australia", imdbId:"3053338", born:date('1990-07-02'), name:"Margot Robbie", bio:"Margot Elise Robbie (born 2 July 1990) is an Australian actress and film producer.  She has received nominations for two Academy Awards and five BAFTA Awards.  In 2017, Time magazine named her one of the 100 most influential people in the world, and in 2019, she was ranked among the world's highest-paid actresses. \n\nRobbie studied drama at Somerset College and began her career in Australian independent films in the late 2000s, before working in the soap opera Neighbours (2008–2011)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/51LnjSdszOnccBuwTTu4aUiGwDt.jpg", url:"https://themoviedb.org/person/234352"}}, {tmdbId:"76112", properties:{bornIn:"Seattle, Washington, USA", imdbId:"2528248", born:date('1969-01-03'), name:"Steve Wiebe", bio:"From Wikipedia, the free encyclopedia\n\nSteven J.  Wiebe (born January 3, 1969) is an algebra teacher at Finn Hill Junior High, a school in Kirkland, Washington.  Wiebe is best known as a two time world champion of Donkey Kong, most recently holding the title from the 20th of September, 2010 to the 10th of January, 2011 with a high score of 1,064,500 points.  Wiebe was the first person to achieve over a million points in the arcade game Donkey Kong with a score of 1,006,600 on July 4, 2004...", url:"https://themoviedb.org/person/76112"}}, {tmdbId:"76114", properties:{imdbId:"2791257", name:"Mark Alpiger", url:"https://themoviedb.org/person/76114"}}, {tmdbId:"1930666", properties:{imdbId:"2794419", name:"Adam Wood", url:"https://themoviedb.org/person/1930666"}}, {tmdbId:"76113", properties:{bornIn:"Fairfield, Iowa, USA", imdbId:"2436615", born:date('1949-05-14'), name:"Walter Day", bio:"From Wikipedia, the free encyclopedia\n\nWalter Aldro Day, Jr.  (born May 14, 1949) is the founder of Twin Galaxies, an international organization based in Fairfield, Iowa, that tracks high score statistics for the worldwide electronic video gaming hobby.  In March 2010, Walter Day announced his retirement from Twin Galaxies to pursue his music career. \n\nDescription above from the Wikipedia article Walter Day, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/76113"}}, {tmdbId:"77933", properties:{bornIn:"Osaka - Japan", imdbId:"0945372", born:date('1965-11-25'), name:"Yuriko Yamaguchi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7e3BXCPv0X2pqwfdfW52n7VDFmI.jpg", url:"https://themoviedb.org/person/77933"}}, {tmdbId:"55463", properties:{bornIn:"Anderson, South Carolina, USA", imdbId:"1888211", born:date('1986-10-23'), name:"Jessica Stroup", bio:"Jessica Leigh Stroup (born October 23, 1986) is an American actress and fashion model.  Stroup is best known for her role as Erin Silver on The CW television series 90210, a spin-off to the original Beverly Hills, 90210.  She is also known for starring in such feature length films such as Prom Night and The Hills Have Eyes 2. \n\nDescription above from the Wikipedia article Jessica Stroup, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sr01O3bY7fjZ3OaR9grC4gJAWeM.jpg", url:"https://themoviedb.org/person/55463"}}, {tmdbId:"77860", properties:{bornIn:"Granville, France", imdbId:"0303826", born:date('1957-11-16'), name:"Jacques Gamblin", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yUf8mLiFtIwfgreb5ozp5qGDt7h.jpg", url:"https://themoviedb.org/person/77860"}}, {tmdbId:"54675", properties:{bornIn:"Paris, France", imdbId:"0951456", born:date('1959-10-30'), name:"Zabou Breitman", bio:"Zabou Breitman (born Isabelle Breitman; 30 October 1959), or simply Zabou, is a French actress and director.  She is the daughter of actors Jean-Claude Deret and Céline Léger.  At the age of four, she appeared in her first movie.  Since 1981, Zabou has acted in dozens of roles in films, TV movies, and theaters.  She made her directoral debut in 2001 with Se souvenir des belles choses, for which she won a César Award for Best Debut.  In 2012, she participated in Rendez-vous en terre inconnue...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tPHpgD3ssDrHt6VgcajH2pD61cv.jpg", url:"https://themoviedb.org/person/54675"}}, {tmdbId:"54228", properties:{bornIn:"Rocourt, Liège, Belgium", imdbId:"1918862", born:date('1987-05-24'), name:"Déborah François", bio:"Déborah François is a Belgian actress.  She is best known for her starring role in the Palme d'Or-winning film, The Child, directed by the Dardenne brothers.  In 2009, she won a César Award for Most Promising Actress for The First Day of the Rest of Your Life...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nI6BVQceWKyzzxpk7nkbxawLELn.jpg", url:"https://themoviedb.org/person/54228"}}, {tmdbId:"72776", properties:{imdbId:"3013376", name:"Simone Sacchettino", url:"https://themoviedb.org/person/72776"}}, {tmdbId:"72777", properties:{imdbId:"2954640", name:"Salvatore Ruocco", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yYwUkA3BxAuCu7M84YNay9NLa4h.jpg", url:"https://themoviedb.org/person/72777"}}, {tmdbId:"72778", properties:{imdbId:"3012922", name:"Vincenzo Fabricino", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bWl4mPIY1xU882QTi8HWRoKZNFA.jpg", url:"https://themoviedb.org/person/72778"}}, {tmdbId:"26048", properties:{bornIn:"Memphis, Tennessee, U.S.", imdbId:"0112871", born:date('1962-12-11'), name:"Ben Browder", bio:"Robert Benedic \"Ben\" Browder (born December 11, 1962) is an American actor and writer, best known for his roles as John Crichton in Farscape and Cameron Mitchell in Stargate SG-1. \n\nDescription above from the Wikipedia article Ben Browder, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/28gdcjphnh7zjpWxgWWVvv9XMA7.jpg", url:"https://themoviedb.org/person/26048"}}, {tmdbId:"26087", properties:{bornIn:"Rochford, Essex, England, UK", imdbId:"0850102", born:date('1965-08-28'), name:"Amanda Tapping", bio:"Amanda Tapping (born 28 August 1965 in Rochford, Essex) is an English-born Canadian actress, producer and director.  She is best known for portraying Samantha Carter in the Canadian-American military science fiction television series Stargate SG-1 and Stargate Atlantis...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8ZiETPxUFtgrtWL0LgMwPP8ytuK.jpg", url:"https://themoviedb.org/person/26087"}}, {tmdbId:"26088", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0431895", born:date('1964-10-13'), name:"Christopher Judge", bio:"An American actor best known for playing Teal'c in the Canadian-American military science fiction television series Stargate SG-1, and has done voice acting for animated series and video games.  He attended the University of Oregon on a football scholarship and was a Pacific Ten Conference player. \n\nDescription above from the Wikipedia article Christopher Judge, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hxU7NXyTmVe7hbGnKJiLU6r9uQw.jpg", url:"https://themoviedb.org/person/26088"}}, {tmdbId:"26086", properties:{bornIn:"Vancouver, British Columbia, Canada", imdbId:"0788218", born:date('1970-12-15'), name:"Michael Shanks", bio:"From Wikipedia, the free encyclopedia. \n\nMichael Garrett Shanks (born December 15, 1970) is a Canadian actor who achieved fame for his role as Dr.  Daniel Jackson in the long-running Canadian-American military science fiction television series Stargate SG-1. \n\nDescription above from the Wikipedia article Michael Shanks, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4YkOrSUmfKljqTMwGIo50oviKe1.jpg", url:"https://themoviedb.org/person/26086"}}, {tmdbId:"109560", properties:{bornIn:"Bedford-Stuyvesant, Brooklyn, New York City, New York, USA", imdbId:"2829737", born:date('1983-05-06'), name:"Gabourey Sidibe", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2ixjv81FUXh45jIc4sHRrNlOYdd.jpg", url:"https://themoviedb.org/person/109560"}}, {tmdbId:"60561", properties:{bornIn:"Woodlawn, Maryland, USA", imdbId:"0594898", born:date('1967-12-11'), name:"Mo'Nique", bio:"From Wikipedia, the free encyclopedia. \n\nMonica Imes (born December 11, 1967) known professionally as Mo'Nique, is an American comedienne and actress.  Mo'Nique rose to fame in the UPN series The Parkers while making a name as a stand-up comedian hosting a variety of venues, including Showtime at the Apollo.  Mo'Nique transitioned to film with roles in such films as Phat Girlz, and Welcome Home Roscoe Jenkins...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bzSVVBKTyMi4K6MZvFCzBJs91F5.jpg", url:"https://themoviedb.org/person/60561"}}, {tmdbId:"11825", properties:{bornIn:"Columbus, Ohio, USA", imdbId:"1192254", born:date('1983-09-21'), name:"Maggie Grace", bio:"Margaret Grace Denig (born September 21, 1983), best known as Maggie Grace, is an American actress.  Originally from Worthington, Ohio, she dropped out of high school to move to Los Angeles with her mother after her parents' divorce.  While struggling financially, she landed her first role as the title character in the web-based video series Rachel's Room in 2001...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fEZSGno4ooPgFjuGzE7ogsWEHsh.jpg", url:"https://themoviedb.org/person/11825"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"88816", properties:{bornIn:"Dallas", imdbId:"3226241", born:date('1996-11-18'), name:"Noah Ringer", bio:"From Wikipedia, the free encyclopedia\n\nNoah Andrew Ringer (born November 18, 1996) is an American teen actor and martial arts practitioner.  He starred as Aang in the 2010 film The Last Airbender.  He will also play Emmett in the upcoming 2011 film Cowboys &amp; Aliens. \n\nDescription above from the Wikipedia article Noah Ringer, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eXobIl7swPrxEqPzacBJczsCrOq.jpg", url:"https://themoviedb.org/person/88816"}}, {tmdbId:"76788", properties:{bornIn:"Harrow, Greater London, England, United Kingdom", imdbId:"2353862", born:date('1990-04-23'), name:"Dev Patel", bio:"Dev Patel (born 23 April 1990) is a British film and television actor.  He is known for his performances as Anwar Kharral in the UK television teen drama series Skins and, on a more global scale, as the main male lead Jamal Malik in Danny Boyle's critically acclaimed and multiple Academy Award-winning film Slumdog Millionaire (2008), for which Patel won a number of awards, including a Critics' Choice Award and a Screen Actors Guild Award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gnlTW9ntMD6Mf6egiHlBw6knlsU.jpg", url:"https://themoviedb.org/person/76788"}}, {tmdbId:"61186", properties:{bornIn:"Westchester County, New York, USA", imdbId:"2443758", born:date('1995-01-09'), name:"Nicola Peltz", bio:"Nicola Peltz is an American film and television actress, best known for playing Katara in M.  Night Shyamalan's feature film \"The Last Airbender\", as well as Bradley Martin in the television series \"Bates Motel\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/by5WUJWe4kIM7D9tNz3KyHsup4M.jpg", url:"https://themoviedb.org/person/61186"}}, {tmdbId:"84215", properties:{bornIn:"Singapore City, Singapore", imdbId:"1717152", born:date('1984-12-21'), name:"Jackson Rathbone", bio:"From Wikipedia, the free encyclopedia\n\nMonroe Jackson Rathbone V (born December 14, 1984) is an American actor and singer.  He is perhaps best known for his role as Jasper Hale in The Twilight Saga and for playing Sokka in The Last Airbender. \n\nDescription above from the Wikipedia article Jackson Rathbone, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gR5XF9H8fNzckwVPDpWmeDMaFl2.jpg", url:"https://themoviedb.org/person/84215"}}, {tmdbId:"61256", properties:{bornIn:"La Jolla - California - USA", imdbId:"0942901", born:date('1982-08-23'), name:"Trevor Wright", bio:"Trevor Christopher Wright (born August 23, 1982) is an American actor.  Wright was born in La Jolla, California.  His breakthrough acting role was in the 2007 film Shelter.  Wright's recurring role as Zack Powers on George Lopez and guest starring in television series such as NYPD Blue, Scrubs and Boston Public led to his being named in 2003 by Teen Vogue as a \"young and upcoming star that's here to stay...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mahNj3v7x2C8iBxRbjDReqKhnqB.jpg", url:"https://themoviedb.org/person/61256"}}, {tmdbId:"81952", properties:{imdbId:"1495452", name:"Jackson Wurth", url:"https://themoviedb.org/person/81952"}}, {tmdbId:"1219899", properties:{imdbId:"0434854", name:"Jeff Kahn", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o876keswb6pAaxMJYcUORFqG3Ce.jpg", url:"https://themoviedb.org/person/1219899"}}, {tmdbId:"171522", properties:{bornIn:"Honolulu - Hawaii - USA", imdbId:"0749570", born:date('1970-11-04'), name:"Anthony Ruivivar", bio:"Anthony Ruivivar is an actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pGyKViGHdi5BxQM2jo7yja4wVmf.jpg", url:"https://themoviedb.org/person/171522"}}, {tmdbId:"41526", properties:{bornIn:"Alger, Algeria", imdbId:"0863816", born:date('1959-07-15'), name:"Patrick Timsit", bio:"​From Wikipedia, the free encyclopedia.   Patrick Timsit is a French comedian, writer and film director.  He has been nominated for 4 César Awards, three times as an actor and once as a writer.  He is most well known for the French comedy Un indien dans la ville...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p429Z97XloHvHe2a4PEZPqBZNEi.jpg", url:"https://themoviedb.org/person/41526"}}, {tmdbId:"66872", properties:{bornIn:"Saigon, French Cochinchina", imdbId:"0495166", born:date('1939-06-18'), name:"Amanda Lear", bio:"​From Wikipedia, the free encyclopedia. \n\nAmanda Lear  (originally Tapp, born 18 November 1939 or 1946, in British Hong Kong) is a French singer, lyricist, composer, painter, TV presenter, actress and novelist. \n\nLear began her career as a fashion model in the mid-1960s and was also the muse of Spanish surrealist painter Salvador Dalí.  She first came to the public attention as the model on the cover of Roxy Music's album For Your Pleasure in 1973...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4uQrykCAlwIv8a3bXdpA9W8WgM5.jpg", url:"https://themoviedb.org/person/66872"}}, {tmdbId:"73548", properties:{bornIn:"Norway", imdbId:"1335915", born:date('1968-07-02'), name:"Fridtjov Såheim", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/clOaTXrlYeWP6BGtBu5R7EKby4G.jpg", url:"https://themoviedb.org/person/73548"}}, {tmdbId:"73549", properties:{imdbId:"0391722", born:date('1956-02-08'), name:"Kjersti Holmen", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kB1Mk3x3ivH2sLqySwfhCCPy7nX.jpg", url:"https://themoviedb.org/person/73549"}}, {tmdbId:"73550", properties:{bornIn:"Oslo, Norway", imdbId:"0582278", born:date('1964-06-22'), name:"Henrik Mestad", bio:"Henrik Mestad is a Norwegian actor who is known from stage, film and TV.  Mestad has been employed by the National Theater since 1991.  He is known from television series such as Occupied and Norsemen, as well as films such as Svarte pantere and Børning...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5xTFu2ioiw9uSKalROHQn6xyys1.jpg", url:"https://themoviedb.org/person/73550"}}, {tmdbId:"73551", properties:{imdbId:"1099818", name:"Marian Saastad Ottesen", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fNvniewV45qAaPcWtCgCHYVMAoB.jpg", url:"https://themoviedb.org/person/73551"}}, {tmdbId:"74570", properties:{bornIn:"Evansville - Indiana - USA", imdbId:"0322002", born:date('1945-07-10'), name:"Ron Glass", bio:"Ron Glass was born on July 10, 1945 in Evansville, Indiana, USA as Ronald Earle Glass.  He is an actor and director, known for Barney Miller (1974), Serenity (2005) and Lakeview Terrace (2008)...", died:date('2016-11-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zowvkh44ksVkS9kuaQlEzg2q9ny.jpg", url:"https://themoviedb.org/person/74570"}}, {tmdbId:"41316", properties:{bornIn:"Giv'atayim, Israel", imdbId:"0620981", born:date('1958-06-25'), name:"Igal Naor", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xGuo7pkRfdUwdzwh6DwCBdCsSts.jpg", url:"https://themoviedb.org/person/41316"}}, {tmdbId:"109670", properties:{bornIn:"Lebanon", imdbId:"0267057", name:"Said Faraj", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/svC8PC5NRXeBcKogGiKXsUCvrd8.jpg", url:"https://themoviedb.org/person/109670"}}, {tmdbId:"122279", properties:{imdbId:"1424285", name:"Faycal Attougui", url:"https://themoviedb.org/person/122279"}}, {tmdbId:"122280", properties:{imdbId:"3043480", name:"Aymen Hamdouchi", url:"https://themoviedb.org/person/122280"}}, {tmdbId:"37625", properties:{bornIn:"Los Angeles, California, USA", imdbId:"1940449", born:date('1983-08-20'), name:"Andrew Garfield", bio:"American-British theater, film, and television actor known for his roles in the films Lions for Lambs (2007), Boy A (2007), The Imaginarium of Doctor Parnassus (2009) and The Social Network (2010).  Garfield began his career in theater working primarily as a stage actor where he won a MEN Theatre Award for his performance in Kes at Manchester's Royal Exchange Theatre in 2004, and the outstanding newcomer award at the Evening Standard Theatre Awards in 2006...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mUzapkiUn2kp17yedwoeAa2rK8C.jpg", url:"https://themoviedb.org/person/37625"}}] AS row
