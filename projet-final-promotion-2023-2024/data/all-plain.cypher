UNWIND [{tmdbId:"82415", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0684124", born:date('1962-03-23'), name:"John Pinette", bio:"​From Wikipedia, the free encyclopedia\n\nJohn Pinette (born March 23, 1962) is an American actor and stand-up comedian.  He has toured the comedy club circuit since the 1980s and has appeared in cinema and television.  Besides stand-up, Pinette does impressions of The Chipmunks, Elvis Presley, Gollum from The Lord of the Rings, Hervé Villechaize (Tattoo from Fantasy Island), as well as an Ewok.  He occasionally sings, for example \"Over the Rainbow\" from The Wizard of Oz, in stand-up routines...", died:date('2014-04-05'), url:"https://themoviedb.org/person/82415"}}, {tmdbId:"158452", properties:{bornIn:"Long Beach, California, USA", imdbId:"0365244", born:date('1962-10-05'), name:"Ricky Harris", died:date('2016-12-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dqttJ39XEIdgGLxA9X7hQO3qDrZ.jpg", url:"https://themoviedb.org/person/158452"}}, {tmdbId:"53441", properties:{bornIn:"New York City, New York, USA", imdbId:"0657760", born:date('1980-09-21'), name:"Aleksa Palladino", bio:"​From Wikipedia, the free encyclopedia.   \n\nAleksa Palladino (born September 21, 1980) is an American actress and singer, perhaps best known for her lead roles in Manny &amp; Lo, The Adventures of Sebastian Cole, Find Me Guilty, Wrong Turn 2: Dead End, and Before the Devil Knows You're Dead...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6OsYqKTcIIb1Ioq06iT3ibtIiyO.jpg", url:"https://themoviedb.org/person/53441"}}, {tmdbId:"9779", properties:{bornIn:"Cerritos, California, USA", imdbId:"0004820", born:date('1969-01-01'), name:"Morris Chestnut", bio:"Morris L.  Chestnut (born January 1, 1969) is an American film and television actor.  He is known for his roles as teenage father Ricky Baker in the 1991 film Boyz n the Hood, groom-to-be Lance Sullivan in the 1999 film The Best Man, as Tracy Reynolds, NBA star in the 2002 film Like Mike, and as the Visitor Ryan in the 2009-11 TV series V.  Chestnut was born in Cerritos, California where he graduated from RichardGahrHigh School in 1986...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7xtODH491pxmdaevqYo4SNKbdOr.jpg", url:"https://themoviedb.org/person/9779"}}, {tmdbId:"47", properties:{bornIn:"Reykjavík, Iceland", imdbId:"0001951", born:date('1965-11-21'), name:"Björk", bio:"Björk, born November 21, 1965, is an Icelandic Polar Music Prize-winning singer-songwriter, occasional actress, music composer and music producer, whose solo work includes seven solo albums and two original film soundtracks.  Björk's intermittent acting career began in 1990, when she appeared in The Juniper Tree, a tale of witchcraft based on the Brothers Grimm story of the same name.  Björk played the role of Margit, a girl whose mother has been killed for practicing witchcraft...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h42F1fUJYelX2RwLrvWkEhKFjQq.jpg", url:"https://themoviedb.org/person/47"}}, {tmdbId:"15543", properties:{bornIn:"Jersey City - New Jersey - USA", imdbId:"1035682", born:date('1974-04-24'), name:"Derek Luke", bio:"​From Wikipedia, the free encyclopedia.   \n\nDerek Luke (born April 24, 1974) is an American actor.  He won the Independent Spirit Award for his big-screen debut performance in the 2002 film Antwone Fisher, directed and produced by Denzel Washington.  Foreman is ranked #9 on Ring magazine's list of \"100 greatest punchers of all time\".  He is also well-known for the eponymous George Foreman Grill...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sJR0LET3ppMwyqIMdV0B0LL9ObB.jpg", url:"https://themoviedb.org/person/15543"}}, {tmdbId:"77078", properties:{bornIn:"Bellflower - California - USA", imdbId:"1287636", born:date('1992-05-12'), name:"Malcolm David Kelley", bio:"Malcolm David Kelley, he has been working in show business since the age of five.  He is most known for his role as young \"Walt\" on the TV series \"Lost\" and his role as \"Finn\" on TeenNick's \"Gigantic\" in 2010-11...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iI2dDYZMugpsh0voos1GMT3Cwet.jpg", url:"https://themoviedb.org/person/77078"}}, {tmdbId:"77079", properties:{imdbId:"0388144", name:"Cory Hodges", url:"https://themoviedb.org/person/77079"}}, {tmdbId:"58804", properties:{bornIn:"Canada ", imdbId:"0741388", born:date('1954-01-01'), name:"Gabrielle Rose", bio:"​From Wikipedia, the free encyclopedia. \n\nGabrielle Rose  (born 1954) is an accomplished Canadian actress.  She has an extensive resume that include multiple nominations for Genie Awards and Gemini Awards...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/obWfgaR4YBk648USvpLrJC64DVU.jpg", url:"https://themoviedb.org/person/58804"}}, {tmdbId:"560316", properties:{bornIn:"Winnipeg, Manitoba, Canada", imdbId:"0514879", born:date('1976-12-26'), name:"Nadia Litz", url:"https://themoviedb.org/person/560316"}}, {tmdbId:"104151", properties:{bornIn:"Corner Brook, Newfoundland, Canada", imdbId:"0245507", born:date('1975-03-22'), name:"Karyn Dwyer", bio:"From Wikipedia, the free encyclopedia\n\nKaryn Elizabeth Dwyer, also known as Karen Dwyer or Karyn O'Dwyer (March 22, 1975 – September 25, 2018), was a Canadian actress.  Her best known role is Maggie in the 1999 film Better Than Chocolate. \n\nDescription above from the Wikipedia article Karyn Dwyer, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2018-09-25'), url:"https://themoviedb.org/person/104151"}}, {tmdbId:"28110", properties:{bornIn:"Toronto, Ontario,  Canada", imdbId:"0184965", born:date('1971-07-31'), name:"Christina Cox", bio:"​From Wikipedia, the free encyclopedia.   \n\nChristina Cox (born July 31, 1971) is a Canadian movie and television actress and stuntwoman...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rJWYGuLhicfXuLkgYXLgoQRFAJr.jpg", url:"https://themoviedb.org/person/28110"}}, {tmdbId:"104156", properties:{bornIn:"Baden-Baden, West Germany", imdbId:"0531612", born:date('1958-10-29'), name:"Ann-Marie MacDonald", bio:"From Wikipedia, the free encyclopedia\n\nAnn-Marie MacDonald (born October 29, 1958) is a Canadian playwright, novelist, actor and broadcast journalist who lives in Toronto, Ontario.  The daughter of a member of Canada's military, she was born at an air force base near Baden-Baden, West Germany.  MacDonald won the Commonwealth Writers Prize for her first novel, Fall on Your Knees, which was also named to Oprah Winfrey's Book Club...", url:"https://themoviedb.org/person/104156"}}, {tmdbId:"33191", properties:{bornIn:"Bombay, India", imdbId:"0223499", born:date('1978-03-16'), name:"Ayesha Dharker", bio:"From Wikipedia, the free encyclopedia. \n\nAyesha Dharker (born March 16, 1978 in Mumbai, India) is an Indian actress.  She is known for her performance in the Tamil Indian film, The Terrorist (1999), for which she was awarded Best Artistic Contribution by an Actress at the Cairo International Film Festival and nominated for a Chlotrudis Award and National Film Award for Best Actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6LNt1MmG22qPQxQgRVmoOPfQofQ.jpg", url:"https://themoviedb.org/person/33191"}}, {tmdbId:"1167095", properties:{imdbId:"0471441", name:"K. Krishna", url:"https://themoviedb.org/person/1167095"}}, {tmdbId:"1167097", properties:{imdbId:"0803168", name:"Sonu Sisupal", url:"https://themoviedb.org/person/1167097"}}, {tmdbId:"1167096", properties:{imdbId:"0899652", name:"Vishwas", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2QNsXK5hDjsjYLiPRISA7p07my.jpg", url:"https://themoviedb.org/person/1167096"}}, {tmdbId:"8210", properties:{bornIn:"Jonesboro, Arkansas, USA", imdbId:"0004747", born:date('1978-09-04'), name:"Wes Bentley", bio:"Wesley Cook \"Wes\" Bentley (born September 4, 1978) is an American film actor known for his roles as Ricky Fitts in American Beauty (1999) and Seneca Crane in The Hunger Games (2012).  Bentley was one of four subjects in the documentary My Big Break (2009), which covered his fame after American Beauty and struggles with substance abuse.  Rebuilding his career, he starred in the premier of Venus in Fur by David Ives in the off-Broadway production in 2010, whose run was extended...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oDjtxTiEuCdyrcAtlCOEWUjhsaT.jpg", url:"https://themoviedb.org/person/8210"}}, {tmdbId:"77927", properties:{bornIn:"Chiyoda, Tokyo, Japan", imdbId:"0644527", born:date('1965-06-06'), name:"Megumi Ogata", bio:"Megumi Ogata is a Japanese voice actress and singer from the Greater Tokyo Area.  As a singer, she goes by the name em:óu.  She attended Tokai University, but left due to lack of interest...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cT2dWOMA1ZpnFPU6z2xEKQjAbmz.jpg", url:"https://themoviedb.org/person/77927"}}, {tmdbId:"40325", properties:{bornIn:"Tokyo, Japan", imdbId:"0370677", born:date('1967-03-30'), name:"Megumi Hayashibara", bio:"Megumi Hayashibara (林原 めぐみ Hayashibara Megumi) (born March 30, 1967) is a Japanese voice actress, singer, radio personality, and lyricist from Tokyo. \n\nShe is currently affiliated with Aksent.  Her nicknames include: Megu-san, Megu-nee, Bara-san, Kakka, and Daijin...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/btCUFtJEE7RefoguctvvfQjxIcd.jpg", url:"https://themoviedb.org/person/40325"}}] AS row
