w440_and_h660_face/unXs6VMNmAkyoJrqVuhnCQZyv80.jpg", url:"https://themoviedb.org/person/24714"}}, {tmdbId:"44650", properties:{imdbId:"0078282", born:date('1949-09-09'), name:"Toni Bertorelli", died:date('2017-05-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4qhYeIKRHTJXqLAbqXTiFrRVOpL.jpg", url:"https://themoviedb.org/person/44650"}}, {tmdbId:"75039", properties:{bornIn:"Chicago, Illinois, U.S.", imdbId:"0293342", born:date('1972-02-09'), name:"Crispin Freeman", bio:"Crispin Freeman (born February 9, 1972) is an American voice actor, ADR director and writer who provides voices for English versions of Japanese anime, animation and video games.  In anime, some of his prominent roles include Zelgadis Graywords in Slayers, Kyon in The Melancholy of Haruhi Suzumiya, Alucard in Hellsing, Kirei Kotomine in Fate/Zero and Fate/stay night: Unlimited Blade Works, Itachi Uchiha in Naruto, and Shizuo Heiwajima in Durarara!!...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rOnOnBVr0EI1YOawxyQsTDwh8tI.jpg", url:"https://themoviedb.org/person/75039"}}, {tmdbId:"1982458", properties:{name:"Victoria Harwood", url:"https://themoviedb.org/person/1982458"}}, {tmdbId:"91030", properties:{imdbId:"0544067", name:"Michael Mantell", bio:"Michael Mantell is an actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/g7dLZXBf606Mz4IBnykJ3fav0kv.jpg", url:"https://themoviedb.org/person/91030"}}, {tmdbId:"19013", properties:{bornIn:"Washington, District of Columbia, USA", imdbId:"0330722", born:date('1948-03-31'), name:"Al Gore", bio:"Albert Arnold \"Al\" Gore, Jr.  served as the 45th Vice President of the United States (1993–2001), under President Bill Clinton.  He was the Democratic Party nominee for President in the 2000 U. S.  presidential election. \n\nGore is currently an author, businessman, and environmental activist.  He was previously an elected official for 24 years, representing Tennessee in the U. S.  House of Representatives (1977–85), and later in the U. S.  Senate (1985–93), and finally becoming Vice President in 1993...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oV97Y0eVDFrmY5DJErzGCLreewK.jpg", url:"https://themoviedb.org/person/19013"}}, {tmdbId:"15556", properties:{bornIn:"London, England, UK", imdbId:"0356017", born:date('1982-05-03'), name:"Rebecca Hall", bio:"An English actress.  In 2003, Hall won the Ian Charleson Award for her debut stage performance in a production of Mrs.  Warren's Profession.  She has appeared in three high-profile films: The Prestige, Vicky Cristina Barcelona (for which she was nominated for a Golden Globe in the Best Actress in a Motion Picture – Musical or Comedy category), and The Town...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cVZaQrUY7F5khCBYdKDlEppHnQi.jpg", url:"https://themoviedb.org/person/15556"}}, {tmdbId:"60021", properties:{bornIn:"Fort Belvoir - Virginia - USA", imdbId:"0919525", born:date('1965-09-28'), name:"Christopher Evan Welch", bio:"Christopher Evan Welch (September 28, 1965 – December 2, 2013) was an American actor...", died:date('2013-12-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/midyg7Ni0QCHGgqaHyld7tpAzND.jpg", url:"https://themoviedb.org/person/60021"}}, {tmdbId:"61659", properties:{bornIn:"New York City, New York, USA", imdbId:"0582149", born:date('1974-08-11'), name:"Chris Messina", bio:"Christopher Messina (born August 11, 1974) is an American actor and film director.  He has appeared in supporting roles in films such as Vicky Cristina Barcelona, Argo, Julie & Julia, Ruby Sparks, Celeste and Jesse Forever, You've Got Mail, and Birds of Prey.  He starred in the film The Giant Mechanical Man...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l9DbQTK5pI6SOGpmfbADGLhdOYS.jpg", url:"https://themoviedb.org/person/61659"}}, {tmdbId:"37014", properties:{bornIn:"Huntington Beach, California, USA", imdbId:"0314514", born:date('1978-11-29'), name:"Lauren German", bio:"Lauren Christine German is an American actress.  She had her first major role in the 2002 romantic drama film A Walk to Remember, followed by roles in the horror films The Texas Chainsaw Massacre and Hostel: Part II...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/if1TbO8dSfPiDCMfy52nH7A2D7.jpg", url:"https://themoviedb.org/person/37014"}}, {tmdbId:"33515", properties:{bornIn:"Tokyo, Japan", imdbId:"0632497", born:date('1983-06-17'), name:"Kazunari Ninomiya", bio:"From Wikipedia, the free encyclopedia. \n\nKazunari Ninomiya (born June 17, 1983), often called Nino, is a Japanese idol, singer, songwriter, actor, seiyū and radio host.  He is a member of Japanese boy band Arashi and is best known to movie audiences for his portrayal as Private Saigo in the 2006 Clint Eastwood war film Letters from Iwo Jima. \n\nNinomiya began his career in the entertainment industry when he joined the Japanese talent agency Johnny & Associates in 1996 at the age of 13...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ikOymrt27hxKo76epFpcdJN5dv7.jpg", url:"https://themoviedb.org/person/33515"}}, {tmdbId:"33516", properties:{bornIn:"Fukuoka, Japan", imdbId:"0407296", born:date('1963-11-06'), name:"Tsuyoshi Ihara", bio:"From Wikipedia, the free encyclopedia. \n\nTsuyoshi Ihara (伊原 剛志 Ihara Tsuyoshi, birth name: Ihara Tsuyoshi) is a Japanese actor of Korean descent, born on November 6, 1963 in Kitakyūshū, and who grew up in Ikuno-ku, Osaka.  He is a graduate of Imamiya Senior High School, situated in Naniwa-ku, Osaka.  Ihara is represented by the K Dash agency. \n\nDescription above from the Wikipedia article Tsuyoshi Ihara, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yStUXAG3ni3UrKSB0PuQ4bXNwU9.jpg", url:"https://themoviedb.org/person/33516"}}, {tmdbId:"33517", properties:{bornIn:"Yokohama, Kanagawa Prefecture, Japan", imdbId:"1076976", born:date('1974-11-09'), name:"Ryô Kase", bio:"Ryo Kase (born November 9, 1974) is a Japanese actor.  He grew up in Bellevue, Washington until he was seven.  He portrayed Shimizu, one of the lower-ranked Japanese soldiers, in Clint Eastwood's Letters from Iwo Jima and starred in Masayuki Suo's film I Just Didn't Do It...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7Q7aMq0A86wLqUr7jPmanEr3Kn9.jpg", url:"https://themoviedb.org/person/33517"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"20563", properties:{bornIn:"Chernovtsy - Ukrainian SSR - USSR", imdbId:"0891514", born:date('1962-04-15'), name:"Alex Veadov", bio:"Alex Veadov is a Russian-American film and television actor.  Since the late 1980s the actor Alex Veadov aka Oleg Flyshecker, whose family was from theCaucasus, appeared in TV movies, -series and feature films.  Alex Veadov also voiced characters in some computer and video games.  He often played and voiced Russian characters.  Alex Veadov is best known for starring in the film We Own the Night taking the role as a Russian mob drug lord and hit-man named Vadim Nezhinski...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sOHwrnkMgoK09RfmkZ5xkfCXSwC.jpg", url:"https://themoviedb.org/person/20563"}}, {tmdbId:"25130", properties:{bornIn:"London, England, UK", imdbId:"1602660", born:date('1981-08-20'), name:"Ben Barnes", bio:"Ben Barnes is a British stage, film and television actor and singer, best known for playing Prince Caspian in the feature film \"Prince Caspian\" and King Caspian in \"The Voyage of the Dawn Treader\", both part of the \"The Chronicles of Narnia\" franchise, as well as series regular Logan in the HBO television series \"Westworld\".  He holds a BA in Drama and English Literature from Kingston University, London, England, UK...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cM7N4w07g3JbW1EuY9BvIHAFKmS.jpg", url:"https://themoviedb.org/person/25130"}}, {tmdbId:"1613567", properties:{name:"Sima Mobarak-Shahi", url:"https://themoviedb.org/person/1613567"}}, {tmdbId:"1613568", properties:{imdbId:"2151395", name:"Shayesteh Irani", url:"https://themoviedb.org/person/1613568"}}, {tmdbId:"1613569", properties:{name:"Ayda Sadeqi", url:"https://themoviedb.org/person/1613569"}}, {tmdbId:"1613570", properties:{name:"Golnaz Farmani", url:"https://themoviedb.org/person/1613570"}}, {tmdbId:"42200", properties:{imdbId:"0517448", name:"Lennie Loftin", bio:"Lennie Loftin is an actor...", url:"https://themoviedb.org/person/42200"}}, {tmdbId:"63231", properties:{bornIn:"Palmdale - California - USA", imdbId:"0621788", born:date('1970-02-23'), name:"Niecy Nash", bio:"Niecy Nash was born on February 23, 1970 in Palmdale, California, USA as Carol Denise Ensley.  She is an actress and producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1QblRt1zawcjTHrdXyzAwtdXKYl.jpg", url:"https://themoviedb.org/person/63231"}}, {tmdbId:"24198", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0240043", born:date('1975-03-22'), name:"Anne Dudek", bio:"From Wikipedia, the free encyclopedia\n\nAnne Louise Dudek (born March 22, 1975 height 5' 10½\" (1,79 m)) is an American actress.  She is known for her roles as Tiffany Wilson in the 2004 film White Chicks, Dr.  Amber Volakis on American television show House, Clare Pettengill on British television show The Book Group, and Francine Hanson in the American television show Mad Men. \n\nEarly life\n\nDudek was born and raised in Boston, Massachusetts.  She attended Northwestern University...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ea7ib0LrrJMtqS8FGpNiStFCoDq.jpg", url:"https://themoviedb.org/person/24198"}}, {tmdbId:"103436", properties:{bornIn:"Los Angeles County, California, USA", imdbId:"0058219", born:date('1987-09-19'), name:"Michael Barryte", url:"https://themoviedb.org/person/103436"}}, {tmdbId:"103437", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0124594", born:date('1975-05-05'), name:"Grace Bustos", url:"https://themoviedb.org/person/103437"}}, {tmdbId:"56112", properties:{bornIn:"Birmingham, Alabama, USA", imdbId:"0807900", born:date('1963-09-08'), name:"David Lee Smith", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hktppGThiKu30lcGW9CicNuinhc.jpg", url:"https://themoviedb.org/person/56112"}}, {tmdbId:"76463", properties:{bornIn:"Normal, Illinois, USA", imdbId:"0186761", born:date('1951-04-29'), name:"Ellen Crawford", bio:"​From Wikipedia, the free encyclopedia.   \n\nEllen Crawford is an American actress.  Most recently, she co-starred as Edith, in The Man from Earth.  She also played Nurse Lydia Wright on ER from 1994–2003 and then again in 2009 for the series finale.  She has performed on stage as well, most recently as Nora Melody in \"A Touch of the Poet\" by Eugene O'Neil, for Friendly Fire Theatre in New York City...", url:"https://themoviedb.org/person/76463"}}, {tmdbId:"1077311", properties:{bornIn:"Fort Worth, Texas, U.S.", imdbId:"1432806", born:date('1952-09-12'), name:"Gerry Beckley", url:"https://themoviedb.org/person/1077311"}}, {tmdbId:"1205480", properties:{imdbId:"2173417", name:"Lee Blackman", url:"https://themoviedb.org/person/1205480"}}, {tmdbId:"125815", properties:{imdbId:"0098559", name:"Perry Botkin Jr.", url:"https://themoviedb.org/person/125815"}}, {tmdbId:"163664", properties:{imdbId:"0085959", name:"Susan Blackwell", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mn8G5PuzlNz6I5hTOiPAl9jkTvZ.jpg", url:"https://themoviedb.org/person/163664"}}, {tmdbId:"56389", properties:{bornIn:"Hershey, Pennsylvania, U.S.", imdbId:"1018679", born:date('1976-11-18'), name:"Steven Pasquale", bio:"From Wikipedia, the free encyclopedia\n\nSteven Pasquale (born November 18, 1976, Hershey, Pennsylvania) is an American actor.  He is best-known for his role as Sean Garrity in the critically acclaimed series Rescue Me.  He made his debut on the HBO series Six Feet Under, playing a love interest for David.  He also starred in the film Aliens vs.  Predator: Requiem. \n\nDescription above from the Wikipedia article Steven Pasquale, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h7UvtUtbuDg3EqCvGzlqiiMNBMp.jpg", url:"https://themoviedb.org/person/56389"}}, {tmdbId:"25869", properties:{bornIn:"Evanston - Illinois - USA", imdbId:"0043855", born:date('1972-12-09'), name:"Reiko Aylesworth", bio:"From Wikipedia, the free encyclopedia. \n\nReiko M.  Aylesworth (born December 9, 1972) is an American film, television and stage actress, best known for her role on the television series 24 as Michelle Dessler...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4JKpN5On2Dvq0Zwg0CqyobABras.jpg", url:"https://themoviedb.org/person/25869"}}, {tmdbId:"40543", properties:{bornIn:"Brooklyn, New York City, New York, USA", imdbId:"0651159", born:date('1968-05-23'), name:"John Ortiz", bio:"John Ortiz (born November 21, 1969) is an American actor and Artistic Director/Co-Founder of LAByrinth Theater Company. \n\nDescription above from the Wikipedia article John Ortiz, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o2SOFI53N6Gv5S3fDEBNbeimbzY.jpg", url:"https://themoviedb.org/person/40543"}}] AS row
