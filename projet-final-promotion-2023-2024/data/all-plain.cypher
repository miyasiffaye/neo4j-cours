UNWIND [{tmdbId:"33040", properties:{bornIn:"Berlin, Germany", imdbId:"0470514", born:date('1971-09-02'), name:"Nicolette Krebitz", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3ChkIhh6EGgtEhY1jEV1ETpG92E.jpg", url:"https://themoviedb.org/person/33040"}}, {tmdbId:"22852", properties:{bornIn:"Halle (Saale)", imdbId:"0389208", born:date('2018-05-01'), name:"Jutta Hoffmann", bio:"Jutta Hoffmann was born on March 3, 1941 in Halle, Saxony-Anhalt, Germany.  She is an actress, known for Bandits (1997), Der Angriff der Gegenwart auf die übrige Zeit (1985) and Karla (1965).  She is married to Nicolaus Haenel.  They have one child.  She was previously married to Herrmann Zschoche...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wO76vCq252Xk6FkwPyWbW8Yt4Ay.jpg", url:"https://themoviedb.org/person/22852"}}, {tmdbId:"83563", properties:{imdbId:"0156432", name:"Tung Cho 'Joe' Cheung", url:"https://themoviedb.org/person/83563"}}, {tmdbId:"230827", properties:{imdbId:"0916348", name:"Brian Webber", url:"https://themoviedb.org/person/230827"}}, {tmdbId:"12795", properties:{bornIn:"Rudkobing, Denmark", imdbId:"0182666", born:date('1970-07-27'), name:"Nikolaj Coster-Waldau", bio:"Nikolaj Coster-Waldau is a Danish actor.  He graduated from the Danish National School of Performing Arts in Copenhagen in 1993.  Coster-Waldau's breakthrough performance in Denmark was his role in the film Nightwatch...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zCWcyAfbbEgB3Lmiew1yrkPU4Lr.jpg", url:"https://themoviedb.org/person/12795"}}, {tmdbId:"21721", properties:{bornIn:"Mt. Clemens, Michigan, USA", imdbId:"0001002", born:date('1966-07-31'), name:"Dean Cain", bio:"His mother, actress Sharon Thomas, married his adoptive father, director Christopher Cain; when Dean was three.  Though he grew up in Malibu and attended Santa Monica High School, his career plans favored professional football over acting.  While at Princeton, he completed a history major, dated Brooke Shields for two years, and set an NCAA record for interceptions in a season.  After signing with the Buffalo Bills, a knee injury ended his pro career before it began...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iDlc890m7HutxZXIZREkV6b4Y3H.jpg", url:"https://themoviedb.org/person/21721"}}, {tmdbId:"1010", properties:{bornIn:"Brooklyn, New York, U.S.", imdbId:"0045937", born:date('1954-12-20'), name:"Michael Badalucco", bio:"From Wikipedia, the free encyclopedia. \n\nMichael Badalucco (born December 20, 1954) is an American actor most famous for his role as lawyer Jimmy Berluti on the ABC legal drama The Practice.  He won the 1999 Emmy for Best Supporting Actor for his role on the show. \n\nBadalucco, an Italian American, was born in Flatbush, Brooklyn, New York, the son of Jean, a homemaker, and Joe Badalucco, a set dresser, movie set carpenter and property person. [1] His brother is Joseph Badalucco Jr...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ntqAjxrBsyXbRzAaln4ynSBTE1r.jpg", url:"https://themoviedb.org/person/1010"}}, {tmdbId:"76067", properties:{imdbId:"0108068", name:"Laurence Breuls", url:"https://themoviedb.org/person/76067"}}, {tmdbId:"61635", properties:{imdbId:"0188933", name:"Linda Cropper", bio:"Linda Cropper is an Australian actress, primarily in television and stage theatre...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xDZ3KI24U5rSktdyw8B7lKhZmCy.jpg", url:"https://themoviedb.org/person/61635"}}, {tmdbId:"57794", properties:{imdbId:"0528539", born:date('1971-02-18'), name:"Simon Lyndon", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/f3pVAukZRgnUsgW9QNNqyRtR5ii.jpg", url:"https://themoviedb.org/person/57794"}}, {tmdbId:"103999", properties:{imdbId:"0265957", name:"Jeffrey Falcon", url:"https://themoviedb.org/person/103999"}}, {tmdbId:"104000", properties:{imdbId:"0570228", name:"Justin McGuire", url:"https://themoviedb.org/person/104000"}}, {tmdbId:"104001", properties:{imdbId:"0207101", name:"Kim De Angelo", url:"https://themoviedb.org/person/104001"}}, {tmdbId:"81192", properties:{bornIn:"Saigon, Vietnam", imdbId:"0310032", born:date('1970-01-01'), name:"Stephane Gauger", bio:"From Wikipedia, the free encyclopedia\n\nStephane Gauger is a Vietnamese-American film director, screenwriter, and cinematographer. \n\nDescription above from the Wikipedia article Stephane Gauger, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9DGXgm6t89Zux6e1Ot0D2t78NdF.jpg", url:"https://themoviedb.org/person/81192"}}, {tmdbId:"122096", properties:{imdbId:"0505979", name:"Walter Levine", url:"https://themoviedb.org/person/122096"}}, {tmdbId:"54428", properties:{bornIn:"USA", imdbId:"0119169", born:date('1947-12-27'), name:"Rico Bueno", died:date('2016-06-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iM5SIP4fnJNnsRt6wi7z04vsJPB.jpg", url:"https://themoviedb.org/person/54428"}}, {tmdbId:"956126", properties:{imdbId:"0905294", name:"Amy Monique Waddell", url:"https://themoviedb.org/person/956126"}}, {tmdbId:"187952", properties:{imdbId:"0602027", name:"Wiley Moore", url:"https://themoviedb.org/person/187952"}}, {tmdbId:"20999", properties:{bornIn:"Bromsgrove, Worcestershire, England, UK", imdbId:"0931247", born:date('1959-08-22'), name:"Mark Williams", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gdlEDhxSmPv3hWHbpTuwCI5Jrtk.jpg", url:"https://themoviedb.org/person/20999"}}, {tmdbId:"9139", properties:{bornIn:"Guildford, Surrey, England, UK", imdbId:"0408309", born:date('1952-07-15'), name:"Celia Imrie", bio:"From Wikipedia, the free encyclopedia\n\nCelia Diana Savile Imrie (born 15 July 1952) is an English actress.  In a career starting in the early 1970s, Imrie has played Marianne Bellshade in Bergerac, Philippa Moorcroft in Dinnerladies, Miss Babs in Acorn Antiques, Diana Neal in After You've Gone, and Gloria Millington in Kingdom.  She has been described as \"one of the most successful British actresses of recent decades\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eEtVfESOVnkkdPLYkyQpalEwAwj.jpg", url:"https://themoviedb.org/person/9139"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"86940", properties:{bornIn:"Orekhovo-Zuevo, USSR (Russia)", imdbId:"0837744", born:date('1951-11-10'), name:"Viktor Sukhorukov", bio:"Viktor I.  Sukhorukov (born 10 November 1951) is a Russian actor.  He has appeared in over 50 films and television shows since 1974.  He starred in Happy Days, which was screened in the Un Certain Regard section at the 1992 Cannes Film Festival...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3YOPzBunFdFoHsqCotW4w3ychsg.jpg", url:"https://themoviedb.org/person/86940"}}, {tmdbId:"119209", properties:{imdbId:"0685527", name:"Svetlana Pismichenko", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mYfGiZdvaS1HiMs9XN7IcKHrum6.jpg", url:"https://themoviedb.org/person/119209"}}, {tmdbId:"119210", properties:{imdbId:"0955867", born:date('1973-02-02'), name:"Mariya Zhukova", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lj02CHK221diX2ydMyhLfKa2ROp.jpg", url:"https://themoviedb.org/person/119210"}}, {tmdbId:"22132", properties:{bornIn:"Jackson, Mississippi, USA", imdbId:"0301370", born:date('1948-01-18'), name:"M.C. Gainey", bio:"​From Wikipedia, the free encyclopedia\n\nMike Connor Gainey (born January 18, 1948) is an American film and television actor whose distinctive mustache, 6'2½\" height, and threatening look have given him supporting roles as Southern/Southwestern types, thugs, and criminals.  M. C.  Gainley attended the University of Southern Mississippi prior to moving to California.  He worked as an undertaker's apprentice before he decided to study acting...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nM82se0lOFbOhhj3J6tRFcdEydO.jpg", url:"https://themoviedb.org/person/22132"}}, {tmdbId:"63765", properties:{imdbId:"0804418", name:"Robert Skjærstad", url:"https://themoviedb.org/person/63765"}}, {tmdbId:"63763", properties:{imdbId:"0845301", born:date('1964-09-07'), name:"Andrine Sæther", url:"https://themoviedb.org/person/63763"}}, {tmdbId:"112598", properties:{bornIn:"Nesodden, Norway", imdbId:"0039398", born:date('1954-04-10'), name:"Per Egil Aske", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/s8l1zi31ZUq0JyFQL98O9VeYy9u.jpg", url:"https://themoviedb.org/person/112598"}}, {tmdbId:"224566", properties:{imdbId:"0513064", name:"Eli Anne Linnestad", url:"https://themoviedb.org/person/224566"}}, {tmdbId:"1643527", properties:{imdbId:"0011129", name:"Kimberly Deauna Adams", url:"https://themoviedb.org/person/1643527"}}, {tmdbId:"100592", properties:{imdbId:"0034509", name:"Vinny Argiro", url:"https://themoviedb.org/person/100592"}}, {tmdbId:"3206", properties:{imdbId:"0051257", born:date('1959-09-14'), name:"Kirk Baltz", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8PkKnqLOjfWm33GFk2Azt7MvY2Q.jpg", url:"https://themoviedb.org/person/3206"}}, {tmdbId:"9236", properties:{bornIn:"Orvieto, Terni, Umbria, Italy ", imdbId:"0134493", born:date('1992-12-05'), name:"Giorgio Cantarini", bio:"Born and raised in Florence, Italy, Giorgio was the only child born to Rimazio and La Tina Cantarini.  Soon after Giorgio, whose family nickname is Gio, celebrated his 5th birthday, his parents were separated and thereafter divorced...", url:"https://themoviedb.org/person/9236"}}, {tmdbId:"9237", properties:{bornIn:" Brindisi, Italy ", imdbId:"0243842", born:date('1923-05-05'), name:"Giustino Durano", bio:"From Wikipedia, the free encyclopedia.   Giustino Durano (May 5, 1923 in Brindisi, Italy - February 18, 2002 in Bologna, Italy) was a long lasting movie actor who is best known for his work as the uncle of Guido Orefice (Roberto Benigni) in the 1997 film, Life Is Beautiful.   Description above from the Wikipedia article Giustino Durano, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2002-02-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o302wA8DHLHDLhTXOF5wEi3C99G.jpg", url:"https://themoviedb.org/person/9237"}}, {tmdbId:"17779", properties:{bornIn:"Killeshandra, Ireland", imdbId:"0654351", born:date('1983-01-18'), name:"Eamonn Owens", url:"https://themoviedb.org/person/17779"}}, {tmdbId:"2468", properties:{bornIn:"Gaoth Dobhair, Donegal, Ireland", imdbId:"0569336", born:date('1956-01-01'), name:"Sean McGinley", bio:"​From Wikipedia, the free encyclopedia.   \n\nSeán McGinley (born ca.  1956) is an Irish film and television actor. \n\nDescription above from the Wikipedia article Seán McGinley, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/2468"}}, {tmdbId:"42838", properties:{imdbId:"0332938", name:"Peter Gowen", url:"https://themoviedb.org/person/42838"}}, {tmdbId:"89390", properties:{bornIn:"Ireland", imdbId:"0102185", born:date('1984-05-25'), name:"Alan Boyle", url:"https://themoviedb.org/person/89390"}}, {tmdbId:"223457", properties:{imdbId:"0824117", name:"Lynda Steadman", url:"https://themoviedb.org/person/223457"}}, {tmdbId:"223458", properties:{imdbId:"0125824", name:"Kate Byers", url:"https://themoviedb.org/person/223458"}}, {tmdbId:"77638", properties:{bornIn:"Guisborough, North Yorkshire, England, UK", imdbId:"0072949", born:date('1965-11-16'), name:"Mark Benton", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hPMkW7sSs4fD7qgAOTnVVF7xWMd.jpg", url:"https://themoviedb.org/person/77638"}}] AS row
