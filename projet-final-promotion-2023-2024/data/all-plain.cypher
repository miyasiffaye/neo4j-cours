UNWIND [{tmdbId:"7805", properties:{bornIn:"Detmold, Germany", imdbId:"0617852", born:date('1967-05-23'), name:"Wotan Wilke Möhring", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fOkfLJzo9LD66ydivxc8llS3xS.jpg", url:"https://themoviedb.org/person/7805"}}, {tmdbId:"5725", properties:{bornIn:"Šibenik, SR Croatia, SFR Yugoslavia (now Croatia)", imdbId:"0899681", born:date('1972-09-09'), name:"Goran Visnjic", bio:"Goran Visnjic (born September 9, 1972) is a Croatian-born American actor who has appeared in American and British films and television productions.  He is best known for his role as Dr.  Luka Kovač in the hit television series ER. \n\nVisnjic grew up in Sibenik, Croatia (then Yugoslavia), a port town on the Adriatic Sea, where he decided at an early age that he wanted to be an actor.  He first performed in local theater groups and then entered the Academy of Dramatic Arts in Zagreb...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/k2n2EH1unojcnSTu46ZAA7jkO31.jpg", url:"https://themoviedb.org/person/5725"}}, {tmdbId:"14849", properties:{bornIn:"Kentville, Nova Scotia, Canada", imdbId:"0232194", born:date('1928-01-20'), name:"Peter Donat", bio:"From Wikipedia, the free encyclopedia. \n\nPeter Donat (born 20 January 1928) is a Canadian-American actor known for his roles in American television. \n\nDescription above from the Wikipedia article Peter Donat, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2018-09-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9oxRUlGgSZCx58I8GKRKDbOIKyC.jpg", url:"https://themoviedb.org/person/14849"}}, {tmdbId:"1057163", properties:{bornIn:"Staten Island, New York, USA", imdbId:"0058294", born:date('1981-06-20'), name:"Brett Barsky", url:"https://themoviedb.org/person/1057163"}}, {tmdbId:"2241142", properties:{imdbId:"0111275", name:"Cindy E. Brolsma", url:"https://themoviedb.org/person/2241142"}}, {tmdbId:"60023", properties:{bornIn:"New York, U.S.", imdbId:"0899995", born:date('1937-03-10'), name:"Joe Viterelli", bio:"From Wikipedia, the free encyclopedia\n\nJoseph \"Joe\" Viterelli (March 10, 1937 – January 28, 2004) was an Italian American actor known for his mafioso-orientated personality endorsements. \n\nJoe Viterelli was born to Italian immigrants in Bronx, New York.  Before Viterelli became an actor, he was a successful businessman in New York City...", died:date('2004-01-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tGXum13Ec5Uigw7myg4qcU9wahy.jpg", url:"https://themoviedb.org/person/60023"}}, {tmdbId:"17190", properties:{bornIn:"Worcester, Massachusetts, USA", imdbId:"0838059", born:date('1991-07-12'), name:"Erik Per Sullivan", bio:"From Wikipedia, the free encyclopedia. \n\nErik Per Sullivan (born July 12, 1991) is an American actor best known for his role as Dewey, the younger brother to middle child Malcolm, on the FOX series, Malcolm in the Middle which was on air for 7 years. \n\nDescription above from the Wikipedia article Erik Per Sullivan, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xNGQBXkat5ZjnZ9vSg0mUbcv9Bc.jpg", url:"https://themoviedb.org/person/17190"}}, {tmdbId:"649813", properties:{imdbId:"0418554", born:date('1952-01-01'), name:"Germán Jaramillo", url:"https://themoviedb.org/person/649813"}}, {tmdbId:"649814", properties:{bornIn:"Medellin - Antioquia - Colombia", imdbId:"0050774", born:date('1982-10-04'), name:"Anderson Ballesteros", bio:"When Anderson was two years old his father placed him with his paternal grandmother in Medellin, the beautiful \"City of Eternal Spring\" then controlled by the notorious drug cartel of Pablo Escobar.  Anderson ran away from home at the age of 14, joined a gang and disappeared into the dark world of crime and violence by which runaways survived on the streets of Medellin - a world so dehumanizing that within two years he severed his gang ties to pursue an honest \"career\" as a street vendor...", url:"https://themoviedb.org/person/649814"}}, {tmdbId:"649815", properties:{bornIn:"Medellín, Colombia", imdbId:"0720461", born:date('1979-09-26'), name:"Juan David Restrepo", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l69xyzaVcCnvKe45i0HTAiIZ4vH.jpg", url:"https://themoviedb.org/person/649815"}}, {tmdbId:"1351372", properties:{bornIn:"Cartagena, Colombia", imdbId:"0124389", name:"Manuel Busquets", died:date('2019-08-03'), url:"https://themoviedb.org/person/1351372"}}, {tmdbId:"31649", properties:{bornIn:"New York City, New York, USA", imdbId:"0807548", born:date('1967-05-22'), name:"Brooke Smith", bio:"From Wikipedia, the free encyclopedia.   \n\nBrooke Smith (born May 22, 1967) is an American actress.  She is best known for her role on the TV show Grey's Anatomy as Dr.  Erica Hahn and for her role as Catherine Martin in the 1991 film The Silence of the Lambs...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bBWxi3qVAC15mzYFE4YgpOjWB5Z.jpg", url:"https://themoviedb.org/person/31649"}}, {tmdbId:"88746", properties:{imdbId:"0940202", name:"Mark Woodbury", url:"https://themoviedb.org/person/88746"}}, {tmdbId:"88747", properties:{bornIn:"Brooklyn, New York City, New York, USA", imdbId:"0443244", name:"Michael Kaycheck", bio:"Michael Kaycheck is an American writer and actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7QLkAshyl73xqOPB6tBPIwlBfmn.jpg", url:"https://themoviedb.org/person/88747"}}, {tmdbId:"57823", properties:{bornIn:"Steelton, Pennsylvania, USA", imdbId:"0121793", born:date('1941-01-20'), name:"Marylouise Burke", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nNI88PGCKxSBoiUiqVbb5YzNF9m.jpg", url:"https://themoviedb.org/person/57823"}}, {tmdbId:"17696", properties:{bornIn:"Westchester, Illinois, USA", imdbId:"1063517", born:date('1974-07-23'), name:"Kathryn Hahn", bio:"Kathryn Hahn (born July 23, 1974) is an American actress known for her roles on the television series Crossing Jordan, Transparent and the film Bad Moms...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9sVllAKfEls3SJD3GoPm2JEZoa5.jpg", url:"https://themoviedb.org/person/17696"}}, {tmdbId:"24291", properties:{bornIn:"Anchorage - Alaska - USA", imdbId:"0661755", born:date('1975-07-31'), name:"Annie Parisse", bio:"Anne Marie Cancelmi (born July 31, 1975), known as Annie Parisse, is an American television, film, and theater actress, known for playing Alexandra Borgia on the television drama Law & Order, a role she played from 2005 until 2006 in 33 episodes.  Parisse is also known for her role of Julia Lindsey Snyder on the daytime soap opera As the World Turns.  She took her stage name from her great-grandmother and namesake Anna Maria Parisse...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qYi44BzmKixH1ISPD0e48W14Zns.jpg", url:"https://themoviedb.org/person/24291"}}, {tmdbId:"77561", properties:{bornIn:"Bristol, England", imdbId:"0086611", born:date('1937-05-13'), name:"Julia Blake", bio:"Julia Blake (born 13 May 1937) is an English-born Australian actress of theatre and television.  She is best known to television audiences for her three roles in the cult series Prisoner – Evelyn Randall in 1981, Alice Dodds in 1983 and Nancy McCormack in 1986...", url:"https://themoviedb.org/person/77561"}}, {tmdbId:"11132", properties:{bornIn:"Coogee, Sydney, New South Wales, Australia", imdbId:"0863968", born:date('1923-01-03'), name:"Charles 'Bud' Tingwell", bio:"​From Wikipedia, the free encyclopedia.   \n\nCharles William \"Bud\" Tingwell AM (3 January 1923 – 15 May 2009) was an Australian film, television, theatre and radio actor.  Tingwell was one of the veterans of Australian film.  He acted in his first motion picture in 1946 and appeared in over 100 films and numerous television programs in both the United Kingdom and Australia...", died:date('2009-05-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bCUk3KCGDetXBxuxArbaXGlQQWT.jpg", url:"https://themoviedb.org/person/11132"}}, {tmdbId:"88807", properties:{imdbId:"0887710", name:"Kristine Van Pellicom", url:"https://themoviedb.org/person/88807"}}] AS row
