tps://image.tmdb.org/t/p/w440_and_h660_face/hfGzYErvwi8hB38kCsSNy6OjdPv.jpg", released:"1968-03-04"}}, {movieId:"45028", properties:{languages:["English", " Norwegian"], year:2006, imdbId:"0420087", runtime:105, imdbRating:6.9, countries:["USA"], imdbVotes:19401, title:"Prairie Home Companion, A", url:"https://themoviedb.org/movie/9526", tmdbId:"9526", plot:"A look at what goes on backstage during the last broadcast of America's most celebrated radio show, where singing cowboys Dusty and Lefty, a country music siren, and a host of others hold court.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/asMi90blB9dYIpeW1qEVDfiNEa.jpg", released:"2006-06-09", budget:10000000}}, {movieId:"45062", properties:{languages:["English"], year:2006, imdbId:"0443632", runtime:108, imdbRating:6.1, countries:["USA"], imdbVotes:41658, title:"Sentinel, The", url:"https://themoviedb.org/movie/5820", revenue:78810595, tmdbId:"5820", plot:"A Secret Service agent is framed as the mole in an assassination attempt on the President. He must clear his name and foil another assassination attempt while on the run from a Secret Service Protective Intelligence Division agent.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a7Yv1Zzf3fhzDPJBXEejroPmdUV.jpg", released:"2006-04-21", budget:60000000}}] AS row
