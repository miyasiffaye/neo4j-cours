UNWIND [{tmdbId:"5293", properties:{bornIn:"Appleton, Wisconsin, USA", imdbId:"0000353", born:date('1955-07-22'), name:"Willem Dafoe", bio:"William James Dafoe (born July 22, 1955) is an American film, stage, and voice actor, and a founding member of the experimental theatre company The Wooster Group.  He has had roles in a wide range of films, including Streets of Fire, To Live and Die in L. A...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ui8e4sgZAwMPi3hzEO53jyBJF9B.jpg", url:"https://themoviedb.org/person/5293"}}, {tmdbId:"59872", properties:{bornIn:"St. Louis - Missouri - USA", imdbId:"0659601", born:date('1954-04-28'), name:"John Pankow", bio:"​From Wikipedia, the free encyclopedia\n\nJohn Pankow (born April 28, 1954) is an American film and stage actor.  He is perhaps best known for a supporting role on the sitcom Mad About You (1993-1999). \n\nDescription above from the Wikipedia article John Pankow, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cb4udknKU3v3nH0ej2NUzRJljXa.jpg", url:"https://themoviedb.org/person/59872"}}, {tmdbId:"59873", properties:{imdbId:"0275391", born:date('1959-01-12'), name:"Debra Feuer", bio:"From Wikipedia, the free encyclopedia. \n\nDebra Feuer is an American actress.  She starred in the movies including Moment by Moment, The Hollywood Knights, To Live and Die in L. A. , MacGruder and Loud, in the italian movie Il burbero, as well as Homeboy, in which she starred with her then husband Mickey Rourke. \n\nDebra Feuer also played a minor role (Beckie Mae) in the TV show, The Dukes of Hazzard, Season 2, Episode 6, The Ghost of General Lee...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/38H5zgkzJGuTXIuzQvi9AjSwIXS.jpg", url:"https://themoviedb.org/person/59873"}}, {tmdbId:"555065", properties:{imdbId:"0544820", name:"Andree Maranda", url:"https://themoviedb.org/person/555065"}}, {tmdbId:"78020", properties:{imdbId:"0169631", name:"Mitch Cohen", url:"https://themoviedb.org/person/78020"}}, {tmdbId:"555066", properties:{name:"Jennifer Babtist", url:"https://themoviedb.org/person/555066"}}, {tmdbId:"555067", properties:{imdbId:"0542430", name:"Cindy Manion", url:"https://themoviedb.org/person/555067"}}, {tmdbId:"1272", properties:{bornIn:"Tyler, Texas, USA", imdbId:"0103071", born:date('1937-11-10'), name:"Richard Bradford", bio:"Richard Bradford (November 10, 1934 – March 22, 2016) was an American actor, known for his lead role as former CIA agent turned private eye McGill in the British television adventure series Man in a Suitcase, made by ITC and the films The Missouri Breaks,  An Enemy of The People, The Legend of Billie Jean,  The Untouchables, and Internal Affairs.  His photograph was used as the sleeve image for The Smiths 1986 single, Panic...", died:date('2016-03-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oxLUtBUC5V0Uws7hvrBAwTBXQ38.jpg", url:"https://themoviedb.org/person/1272"}}, {tmdbId:"5658", properties:{bornIn:"Cabra, Dublin, Ireland", imdbId:"0002091", born:date('1940-10-19'), name:"Michael Gambon", bio:"Sir Michael Gambon is an Irish-British actor who has worked in theatre, television and film.  A highly respected theatre actor, Gambon is recognised for his role in The Singing Detective and for his role as Albus Dumbledore in the Harry Potter film series, replacing the late actor Richard Harris. \n\nGambon was born in Cabra, Dublin during World War II.  His father, Edward Gambon, was an engineer, and his mother, Mary, was a seamstress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/blSvhjedLYFh0JrLPuOmHG1sjUu.jpg", url:"https://themoviedb.org/person/5658"}}, {tmdbId:"12931", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0001854", born:date('1956-10-26'), name:"Rita Wilson", bio:"From Wikipedia, the free encyclopedia\n\nRita Wilson (born October 26, 1956) is an American actress and producer. \n\nDescription above from the Wikipedia article Rita Wilson, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3c22ZCpoXjLbxA6NZerxIbQXDpu.jpg", url:"https://themoviedb.org/person/12931"}}, {tmdbId:"29712", properties:{bornIn:"Coronado, California, USA", imdbId:"0859772", born:date('1946-04-08'), name:"Tim Thomerson", bio:"An American actor and comedian.  Most famous for his role as Jack Deth in the Trancers film series and is renowned for his work in numerous low-budget movies and his comedic television roles...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dCqpmO9nDA07NYSdyQF5JYnmxpL.jpg", url:"https://themoviedb.org/person/29712"}}, {tmdbId:"46948", properties:{bornIn:"New York City, New York, USA", imdbId:"0001456", born:date('1960-03-24'), name:"Kelly LeBrock", bio:"Kelly LeBrock (born 24 March 1960) is an American actress and model.  Her acting debut was in The Woman in Red co-starring with comedian Gene Wilder.  She also starred in the film Weird Science, directed by John Hughes. \n\nDescription above from the Wikipedia article Kelly LeBrock, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p2sSQq8KdHQXQK9XeT5eGJ3oVcy.jpg", url:"https://themoviedb.org/person/46948"}}, {tmdbId:"70572", properties:{bornIn:"New York City, New York, USA", imdbId:"0593819", born:date('1969-06-29'), name:"Ilan Mitchell-Smith", bio:"Ilan Mitchell-Smith is an American academic and former actor best known as the co-star of the film Weird Science...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nH3WPjewgih6uVgTmrxl60Rn5vV.jpg", url:"https://themoviedb.org/person/70572"}}, {tmdbId:"11084", properties:{bornIn:"Newport Beach, California, USA", imdbId:"0000534", born:date('1957-07-09'), name:"Kelly McGillis", bio:"Kelly Ann McGillis (born July 9, 1957) is an American actress whose movies include Witness, for which she received a Golden Globe nomination, Top Gun, and The Accused. \n\nDescription above from the Wikipedia article Kelly McGillis, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oqhQvlTUuKSR1pFbqlfcV4qUHVR.jpg", url:"https://themoviedb.org/person/11084"}}, {tmdbId:"14792", properties:{bornIn:"Greifswald, Germany", imdbId:"0813977", born:date('1934-06-26'), name:"Josef Sommer", bio:"​From Wikipedia, the free encyclopedia.   \n\nJosef Sommer (born June 26, 1934) is an American film actor. \n\nHe was born Maximilian Josef Sommer in Greifswald, Germany and was raised in North Carolina, the son of Elisabeth and Clemons Sommer, a professor of art history at the University of North Carolina.  He studied at the Carnegie Institute of Technology.  He has a daughter, Maria. \n\nSommer made his acting debut at the age of nine in a North Carolina production of Watch on the Rhine...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eY3tCB4j7nWhsZX1enU6BYpaZl.jpg", url:"https://themoviedb.org/person/14792"}}, {tmdbId:"526", properties:{bornIn:"West Hollywood, California, USA", imdbId:"0001305", born:date('1976-04-16'), name:"Lukas Haas", bio:"​From Wikipedia, the free encyclopedia.   \n\nLukas Daniel Haas (born April 16, 1976) is an American actor, known for roles both as a child and as an adult.  His career has spanned more than 20 years during which time he has appeared in more than 36 feature films, as well as a number of television shows and theater productions. \n\nDescription above from the Wikipedia article Lukas Haas, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bJ0ZHg5UA9JThkC5wV4Y82T9ucy.jpg", url:"https://themoviedb.org/person/526"}}, {tmdbId:"984", properties:{bornIn:"Edinburgh, Scotland, UK", imdbId:"0746583", born:date('1966-11-22'), name:"Nicholas Rowe", bio:"From Wikipedia, the free encyclopedia.   Nicholas James Sebastian Rowe (born 22 November 1966) is a Scottish actor. \n\nDescription above from the Wikipedia article Nicholas Rowe , licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mAR7cSZO9V9v0fFlDxiKDfvHlkQ.jpg", url:"https://themoviedb.org/person/984"}}, {tmdbId:"70881", properties:{bornIn:"London, England, UK", imdbId:"0184893", born:date('1970-08-06'), name:"Alan Cox", bio:"From Wikipedia, the free encyclopedia.   Alan Cox (born 6 August 1970) is a British actor. \n\nDescription above from the Wikipedia article Alan Cox, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/70881"}}, {tmdbId:"31921", properties:{bornIn:"London, England, UK", imdbId:"0001830", born:date('1964-12-30'), name:"Sophie Ward", bio:"Sophie Ward was born on December 30, 1964 in London, England.  She is an actress, known for Young Sherlock Holmes (1985), Wuthering Heights (1992) and Jane Eyre (2011). \n\nDescription above from the Wikipedia article Sophie Ward, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2ePiAlSa7djGfSF12RKiwgQE4KR.jpg", url:"https://themoviedb.org/person/31921"}}, {tmdbId:"107241", properties:{bornIn:"Oxford, Oxfordshire, England, UK", imdbId:"0212567", born:date('1949-02-13'), name:"Brian Deacon", bio:"From Wikipedia, the free encyclopedia. \n\nBrian Deacon (born 13 February 1949) is a British actor.  Born in Oxford, he trained at the Oxford Youth Theatre.  He appeared with his brother Eric Deacon in the Peter Greenaway film, A Zed &amp; Two Noughts (1985), as Heumac in The Feathered Serpent (1976, 1978) and as Frank Miles in the TV series Lillie in 1978...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/48GhLPSdrWJoaYJV6FnuTDumYA5.jpg", url:"https://themoviedb.org/person/107241"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"142081", properties:{name:"Eric Deacon", url:"https://themoviedb.org/person/142081"}}, {tmdbId:"47644", properties:{imdbId:"0053384", born:date('1958-05-13'), name:"Frances Barber", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j4vvOB1GPVDqFJYEp56v23CF0CW.jpg", url:"https://themoviedb.org/person/47644"}}, {tmdbId:"57166", properties:{bornIn:"Fairfield, Connecticut, USA", imdbId:"0468957", born:date('1958-01-07'), name:"Linda Kozlowski", bio:"Linda Kozlowski  (born January 7, 1958) is an American actress.  She has been nominated for a Golden Globe Award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z9TvrQXL9NdvTJNoglhGZOjcn0I.jpg", url:"https://themoviedb.org/person/57166"}}, {tmdbId:"113068", properties:{imdbId:"0075303", name:"Ed Berke", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nG1l0nRvLx2i1j2ElH8dAek6CeX.jpg", url:"https://themoviedb.org/person/113068"}}, {tmdbId:"113069", properties:{imdbId:"0730306", name:"Carol Robbins", url:"https://themoviedb.org/person/113069"}}, {tmdbId:"77135", properties:{bornIn:"\tLos Angeles, CA, USA", imdbId:"0330143", born:date('1923-02-27'), name:"Dexter Gordon", bio:"From Wikipedia, the free encyclopedia\n\nDexter Gordon (February 27, 1923 – April 25, 1990) was an American jazz tenor saxophonist and an Academy Award-nominated actor (Round Midnight, Warner Bros, 1986).  He is regarded as one of the first and most important musicians to adapt the bebop musical language of people like Charlie Parker, Dizzy Gillespie, and Bud Powell to the tenor saxophone...", died:date('1990-04-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uXZ3KegarfYWQ7ANQq7hFKbXpg2.jpg", url:"https://themoviedb.org/person/77135"}}, {tmdbId:"33161", properties:{bornIn:"Paris, France", imdbId:"0167388", born:date('1955-09-21'), name:"François Cluzet", bio:"From Wikipedia, the free encyclopedia\n\nFrançois Cluzet (born 21 September 1955) is a French film and theatre actor, best known in the English-speaking world for starring in the 2006 French film \"Tell No One\", based on the novel of the same name by the American author Harlan Coben.  He won the 2007 César Award for Best Actor for his role as Dr Alexander Beck in the film. \n\nDescription above from the Wikipedia article François Cluzet, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4ioxRGRJdSjItLxAQ2pp7byWkd3.jpg", url:"https://themoviedb.org/person/33161"}}, {tmdbId:"244385", properties:{imdbId:"0354593", name:"Gabrielle Haker", url:"https://themoviedb.org/person/244385"}}, {tmdbId:"56688", properties:{imdbId:"0714191", name:"Sandra Reaves-Phillips", url:"https://themoviedb.org/person/56688"}}, {tmdbId:"7037", properties:{bornIn:"Thouars, Deux-Sèvres, France", imdbId:"0000767", born:date('1955-07-29'), name:"Jean-Hugues Anglade", bio:"Jean-Hugues Anglade (born 29 July 1955) is a French actor, film director and screenwriter, best known for his roles as Zorg in Betty Blue and Marco, the boyfriend of Nikita, in Nikita...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fB4IkPSOPRmNaJjgNrYkrrLWAKv.jpg", url:"https://themoviedb.org/person/7037"}}, {tmdbId:"4813", properties:{bornIn:"Brest, Brittany, France", imdbId:"0001095", born:date('1964-12-19'), name:"Béatrice Dalle", bio:"Béatrice Dalle (born 19 December 1964) is a French actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3iz1YYnSxgKctHAegL6B7K6AWoD.jpg", url:"https://themoviedb.org/person/4813"}}, {tmdbId:"47337", properties:{bornIn:"Paris, France", imdbId:"0201462", born:date('1948-02-29'), name:"Gérard Darmon", bio:"Gérard Darmon (born 29 February 1948) is a French actor and singer. \n\nHe is the second husband of actress Mathilda May.  He has three children: Virginie (born 1968) and, by May, daughter Sarah (born 17 August 1994) and son Jules (born 4 March 1997).  Darmon also did a cover of \"Mambo Italiano\". \n\nDarmon is of Algerian-Jewish origin.  In July 2012, he was naturalized Moroccan by a decree from King Mohamed VI. \n\nSource: Article \"Gérard Darmon\" from Wikipedia in english, licensed under CC-BY-SA 3. 0...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nYup2VXH5zZunl0WoQFy1dTlu1s.jpg", url:"https://themoviedb.org/person/47337"}}, {tmdbId:"71177", properties:{imdbId:"0208850", name:"Consuelo De Haviland", url:"https://themoviedb.org/person/71177"}}, {tmdbId:"5589", properties:{bornIn:"Salisbury, Maryland, USA", imdbId:"0001278", born:date('1944-08-07'), name:"John Glover", bio:"​From Wikipedia, the free encyclopedia.   \n\nJohn Soursby Glover Jr.  (born August 7, 1944) is an American actor, perhaps best known for a range of villainous roles in films and television, including Lionel Luthor on the Superman-inspired television series Smallville...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aPmq20MXqFALrUxaaJoC2Xonumo.jpg", url:"https://themoviedb.org/person/5589"}}, {tmdbId:"5309", properties:{bornIn:"York, North Yorkshire, England, UK", imdbId:"0001132", born:date('1934-12-09'), name:"Judi Dench", bio:"Dame Judith Olivia \"Judi\" Dench, CH, DBE, FRSA (born 9 December 1934) is an English film, stage and television actress. \n\nDench made her professional debut in 1957 with the Old Vic Company.  Over the following few years she played in several of William Shakespeare's plays in such roles as Ophelia in Hamlet, Juliet in Romeo and Juliet and Lady Macbeth in Macbeth...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1KqI8VYcbawaQYf0eIfajXqXTIn.jpg", url:"https://themoviedb.org/person/5309"}}, {tmdbId:"78518", properties:{imdbId:"0207203", name:"Jean De Baer", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bmal9SGnGM2lxGD8caXZTWfe1Or.jpg", url:"https://themoviedb.org/person/78518"}}, {tmdbId:"27880", properties:{bornIn:"Antwerp, Belgium", imdbId:"0305488", born:date('1929-04-11'), name:"Henri Garcin", bio:"​Extrait de Wikipedia, l'Encyclopedie libre. \n\nActeur français d'origine néerlandaise, venu à Paris en 1950 à l'âge de 22 ans.  Très tôt son spectacle fait le tour des cabarets parisiens, où il rencontre les \"débutants\" de l'époque : Jacques Brel (ils se parlent en flamand), Barbara, Gainsbourg, Moustaki, Poiret et Serrault. . .  En 1964, il connaît un succès au Théâtre La Bruyère, avec les 250 représentations de L’Échappée belle. \n\nSuivent, de 1965 à 1995, les pièces et les rôles chez G. B...", url:"https://themoviedb.org/person/27880"}}, {tmdbId:"27881", properties:{imdbId:"0958495", born:date('1946-09-16'), name:"Olga Zuiderhoek", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/upW1t4av2aWaJRZm4yYykvhG6fg.jpg", url:"https://themoviedb.org/person/27881"}}, {tmdbId:"27882", properties:{bornIn:"Rotterdam, Zuid-Holland, Netherlands", imdbId:"0539482", born:date('1957-11-23'), name:"Annet Malherbe", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xAzQjXPop7fEfyOEFNqmW9IiSMv.jpg", url:"https://themoviedb.org/person/27882"}}, {tmdbId:"20", properties:{bornIn:"Queens, New York, USA", imdbId:"0001610", born:date('1960-11-18'), name:"Elizabeth Perkins", bio:"Elizabeth Ann Perkins (born November 18, 1960) is an American actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/97iPhMyh7ou2tsJJ9FpgAcd0Nqv.jpg", url:"https://themoviedb.org/person/20"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"10206", properties:{bornIn:"Panama City, Florida, USA", imdbId:"0001343", born:date('1976-05-07'), name:"Carrie Henn", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pQezLMMjYw6k2sQKmsNbWNcGgHx.jpg", url:"https://themoviedb.org/person/10206"}}, {tmdbId:"781", properties:{bornIn:"New York City, New York, USA", imdbId:"0001663", born:date('1957-03-30'), name:"Paul Reiser", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v3e5TClep4ugMdU4qSRiKbvLr3B.jpg", url:"https://themoviedb.org/person/781"}}, {tmdbId:"40349", properties:{bornIn:"Bronx, New York City, New York, USA", imdbId:"0948361", born:date('1930-10-01'), name:"Erica Yohn", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ArpkNzcdaYQTjg6VdYtDFxAygIX.jpg", url:"https://themoviedb.org/person/40349"}}, {tmdbId:"40348", properties:{bornIn:"Tarzana, California, USA", imdbId:"0322064", born:date('1978-10-04'), name:"Phillip Glasser", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hak1JvlAozZJmEuzxM50brnYw6c.jpg", url:"https://themoviedb.org/person/40348"}}, {tmdbId:"81624", properties:{bornIn:"Sweetwater, Tennessee, USA", imdbId:"0048554", born:date('1961-04-12'), name:"Jay Baker", url:"https://themoviedb.org/person/81624"}}, {tmdbId:"47744", properties:{imdbId:"0055270", name:"Pat Barlow", url:"https://themoviedb.org/person/47744"}}, {tmdbId:"25024", properties:{bornIn:"St. James, Manitoba, Canada", imdbId:"0077615", born:date('1926-11-11'), name:"Lloyd Berry", died:date('2016-07-12'), url:"https://themoviedb.org/person/25024"}}, {tmdbId:"31140", properties:{bornIn:"New York City, New York, USA", imdbId:"0000524", born:date('1966-06-28'), name:"Mary Stuart Masterson", bio:"Mary Stuart Masterson (born June 28, 1966) is an American film, stage and television actress and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gUy2JuS4kmgY8laq2pvJ8tPmqsh.jpg", url:"https://themoviedb.org/person/31140"}}, {tmdbId:"32747", properties:{bornIn:"New York City, New York, USA", imdbId:"0002332", born:date('1952-07-11'), name:"Stephen Lang", bio:"​From Wikipedia, the free encyclopedia\n\nStephen Lang (born July 11, 1952) is an American actor and playwright.  He started in theatre on Broadway but is well known for his film portrayals of Stonewall Jackson in Gods and Generals (2003), George Pickett in Gettysburg (1993), and his 2009 roles as Colonel Miles Quaritch in Avatar and as Texan lawman Charles Winstead in Public Enemies...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p7iolb981MAszmSCq9JAYmnOOyX.jpg", url:"https://themoviedb.org/person/32747"}}, {tmdbId:"96442", properties:{bornIn:"Brooklyn, New York,  USA", imdbId:"0138483", born:date('1959-03-06'), name:"Michael Carmine", died:date('1989-10-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hpEPGIRHZ15U3ccSURRoZiQJ7Pw.jpg", url:"https://themoviedb.org/person/96442"}}, {tmdbId:"34485", properties:{bornIn:"Bristol, Pennsylvania, USA", imdbId:"0000452", born:date('1963-10-28'), name:"Lauren Holly", bio:"Lauren Michael Holly (born October 28, 1963) is an American actress.  She is known for her roles as Deputy Sheriff Maxine Stewart in the TV series Picket Fences, as Mary Swanson in the 1994 film Dumb & Dumber, as Jenny Shepard on the TV series NCIS, and for her relationship with actor Jim Carrey...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uJoOKPd6resnq9qA0ChbiNIk7ob.jpg", url:"https://themoviedb.org/person/34485"}}, {tmdbId:"11392", properties:{bornIn:"Stockton, California, USA", imdbId:"0241748", born:date('1952-04-19'), name:"Dennis Dun", bio:"From Wikipedia, the free encyclopedia. \n\nDennis Dun (born April 19, 1952) is a Chinese American actor from Stockton, California, currently residing in Los Angeles. \n\nDescription above from the Wikipedia article Denis Dun, licensed under CC-BY-SA, full list of contributors on  Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kVem07C5bxKI4g88RkWUDsQ9BRO.jpg", url:"https://themoviedb.org/person/11392"}}, {tmdbId:"20904", properties:{bornIn:"Minneapolis, Minnesota, United States", imdbId:"0393222", born:date('1929-02-22'), name:"James Hong", bio:"​From Wikipedia, the free encyclopedia.   \n\nJames Hong (born February 22, 1929) is a Chinese American actor and former president of the Association of Asian/Pacific American Artists (AAPAA).  A prolific acting veteran, Hong's career spans over 50 years and includes more than 350 roles in film, television, and video games. \n\nDescription above from the Wikipedia article James Hong, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v3lfw5aHOy0paOCx6WHiSnwzbH0.jpg", url:"https://themoviedb.org/person/20904"}}, {tmdbId:"18906", properties:{bornIn:"United Kingdom", imdbId:"0225698", born:date('1958-05-14'), name:"Neil Dickson", bio:"Neil Dickson is a British born stage and film actor and voice over artiste who divides his career between the US and the UK.  A graduate of the Guildhall School of Music and Drama, Dickson spent several seasons in rep before making his West End debut opposite Dame Judi Dench and Daniel Massey in The Gay Lord Quex, directed by Sir John Gielgud.  From there, he co-starred with Ian McShane, James Mason, Ava Gardner and Susan Sarandon in NBC's mini-series A. D...", url:"https://themoviedb.org/person/18906"}}, {tmdbId:"747", properties:{bornIn:"London, England, UK", imdbId:"0405033", born:date('1959-01-30'), name:"Alex Hyde-White", bio:"​From Wikipedia, the free encyclopedia\n\nAlex Punch Hyde-White (born 30 January 1959) is an English born, US raised film and television actor.  He is sometimes credited as Alex Hyde White.  Known as Punch to friends, he grew up in Palm Springs, CA attending PSHS (Class of 1975) and Georgetown University in Washington DC for one year after which he left to pursue the inevitable acting career...", url:"https://themoviedb.org/person/747"}}, {tmdbId:"89664", properties:{bornIn:"Miami, Florida, USA", imdbId:"0404441", born:date('1960-05-17'), name:"Fiona Hutchison", url:"https://themoviedb.org/person/89664"}}, {tmdbId:"17578", properties:{bornIn:"Paris, France", imdbId:"0293739", born:date('1937-10-13'), name:"Sami Frey", bio:"From Wikipedia, the free encyclopedia. \n\nSami Frey (born October 13, 1937) is a French actor.  Perhaps his most famous films are En compagnie d'Antonin Artaud (in which he portrays French poet and playwright Antonin Artaud) and Bande à part.  He made his onscreen debut in 1956. \n\nDescription above from the Wikipedia article Sami Frey, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x70K5jc9RozJ04t7b1i1tv0Myyc.jpg", url:"https://themoviedb.org/person/17578"}}, {tmdbId:"6588", properties:{bornIn:"Rome, Lazio, Italy", imdbId:"0000618", born:date('1952-06-18'), name:"Isabella Rossellini", bio:"Isabella Fiorella Elettra Giovanna Rossellini (born 18 June 1952) is an Italian actress, filmmaker, author, philanthropist, and model.  Rossellini is noted for her 14-year tenure as a Lancôme model, and for her roles in films such as Blue Velvet and Death Becomes Her. \n\n​From Wikipedia, the free encyclopedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ebcTowZoBZCDxaWd5ZrL2ZR5mQ3.jpg", url:"https://themoviedb.org/person/6588"}}, {tmdbId:"6677", properties:{bornIn:"Yakima, Washington, USA", imdbId:"0001492", born:date('1959-02-22'), name:"Kyle MacLachlan", bio:"Kyle Merritt MacLachlan is an American actor.  MacLachlan widely known for his portrayal of Dale Cooper in the TV series Twin Peaks (1990–1991; 2017), and its prequel film Twin Peaks: Fire Walk with Me (1992).  He is also known for his film roles including cult films such as Dune (1984), Blue Velvet (1986), The Hidden (1987), and Showgirls (1995)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ooI51tWwL5qVHV6KrOdbi01s2ib.jpg", url:"https://themoviedb.org/person/6677"}}, {tmdbId:"4784", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0000368", born:date('1967-02-10'), name:"Laura Dern", bio:"An American actress, film director and producer.  Dern has acted in such films as Smooth Talk (1985), Blue Velvet (1986), Fat Man and Little Boy (1988), Wild at Heart (1990), Jurassic Park (1993) and October Sky (1999).  She has won awards for her performance in the 1991 film Rambling Rose, for which she received an Academy Award nomination for Best Actress in a Leading Role...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2Ryt0SsExqWrLTzBu6sZcbLwoDJ.jpg", url:"https://themoviedb.org/person/4784"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"171213", properties:{bornIn:"New York City, New York, USA", imdbId:"0212635", born:date('1971-12-18'), name:"Lucy Deakins", url:"https://themoviedb.org/person/171213"}}, {tmdbId:"27493", properties:{bornIn:"Minneapolis, Minnesota, USA", imdbId:"0001809", born:date('1968-10-01'), name:"Jay Underwood", bio:"​From Wikipedia, the free encyclopedia.   \n\nJay Underwood (born October 1, 1968) is an American actor. \n\nIn 1983, he attended Moreau Catholic High School for one year in Hayward, California.  He is married to Julie Underwood and has three children.  His most recognized work includes portraying Ernest Hemingway in The Young Indiana Jones Chronicles, \"Bug\" in Uncle Buck, and \"Eric Gibb\" in The Boy Who Could Fly...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cUWx3F5tzeMUowmCIJoL2WrLxoe.jpg", url:"https://themoviedb.org/person/27493"}}, {tmdbId:"129258", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0322778", born:date('1971-12-29'), name:"Stacey Glick", bio:"​From Wikipedia, the free encyclopedia.   \n\nStacey Glick is a former American child actress who was born December 29, 1971 in Brooklyn, New York. \n\nHer most prominent roles came in the late-1980s in the films Brighton Beach Memoirs and Three O'Clock High.  The latter was also her last film role. \n\nStacey Glick now works as a literary agent. \n\nDescription above from the Wikipedia article Stacey Glick, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/129258"}}, {tmdbId:"1224165", properties:{bornIn:"Limerick, Pennsylvania, USA", imdbId:"0910610", born:date('1961-08-31'), name:"Lisa Waltz", bio:"Lisa Waltz is an actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tWjamTvyrmCVQ21V2Ts2I9yCwWs.jpg", url:"https://themoviedb.org/person/1224165"}}, {tmdbId:"85367", properties:{bornIn:" Toronto, Ontario, Canada", imdbId:"0443058", name:"Hadley Kay", bio:"From Wikipedia, the free encyclopedia. \n\nHadley Kay (born 1973) is a Canadian-born voice actor who appeared in the first two Care Bears movies: as the voice of magician Nicholas in The Care Bears Movie and as the villain Dark Heart in Care Bears Movie II: A New Generation. \n\nKay also appeared in Superman II, the Star Wars-inspired animated series Ewoks, Inspector Gadget, and some of the earliest The Raccoons specials as the character Tommy...", url:"https://themoviedb.org/person/85367"}}, {tmdbId:"44163", properties:{bornIn:"Blackpool, Lancashire, England, UK", imdbId:"0927770", born:date('1930-01-13'), name:"Chris Wiggins", bio:"From Wikipedia, the free encyclopedia. \n\nChris Wiggins (born January 13, 1930) is an English actor. \n\nHe started out as a banker in his home country before he began his acting career in Canada, where he moved in 1952. \n\nWiggins is probably best recognized for his role as Jack Marshak, the benevolent, resourceful expert on the occult in the syndicated television horror show Friday the 13th: The Series, and which ran from 1987 to 1990...", died:date('2017-02-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/HMpppR5Jc1YX9YfTUE3jlvJOlf.jpg", url:"https://themoviedb.org/person/44163"}}, {tmdbId:"34985", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0838588", born:date('1969-07-07'), name:"Cree Summer", bio:"From Wikipedia, the free encyclopedia. \n\nCree Summer Francks (born July 7, 1969), best known as Cree Summer, is an African-Canadian Aboriginal actress, musician and voice actress.  She is perhaps best known for her role as college student Winifred \"Freddie\" Brooks on the NBC sitcom A Different World...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yuOIiBu7YYGG79GnRa6RiDErRwp.jpg", url:"https://themoviedb.org/person/34985"}}, {tmdbId:"74951", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"0183750", born:date('1973-11-09'), name:"Alyson Court", bio:"From Wikipedia, the free encyclopedia\n\nAlyson Georgina Court (born November 9, 1973) is a Canadian actress who first appeared in the 1985 children's film Sesame Street Presents Follow That Bird, and played summer camper Dawn in the animated film The Care Bears Movie II: A New Generation the following year.  She also played Loonette the Clown, the lead character of the Canadian children's television series, The Big Comfy Couch, from 1992 to 2003...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kPeTYEV6vyyAJEsUlomVpiLcd6v.jpg", url:"https://themoviedb.org/person/74951"}}, {tmdbId:"19797", properties:{bornIn:"Morton Grove, Illinois, USA", imdbId:"0559144", born:date('1965-08-24'), name:"Marlee Matlin", bio:"Marlee Bethany Matlin (born August 24, 1965) is an American actress.  She is the youngest woman and the only deaf actress to date to win the Academy Award for Best Actress in a Leading Role, which she won at age 21 for Children of a Lesser God.   Her work in film and television has resulted in a Golden Globe award, with two additional nominations, and four Emmy nominations.  Deaf since she was 2 years old, she is also a prominent member of the National Association of the Deaf...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1iV3yA07kdj7RFj2yyzwO2T6M8o.jpg", url:"https://themoviedb.org/person/19797"}}, {tmdbId:"6541", properties:{bornIn:"Jersey City, New Jersey, USA", imdbId:"0097842", born:date('1930-09-26'), name:"Philip Bosco", bio:"From Wikipedia, the free encyclopedia. \n\nPhilip Michael Bosco (September 26, 1930 - December 3, 2018) was an American actor. \n\nDescription above from the Wikipedia article Philip Bosco, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2018-12-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3EQZt9T6Xe55BtxCy6pBTmSJt3g.jpg", url:"https://themoviedb.org/person/6541"}}, {tmdbId:"14699", properties:{bornIn:"Tacoma - Washington - USA", imdbId:"0715622", born:date('1949-04-02'), name:"Pamela Reed", bio:"From Wikipedia, the free encyclopedia. \n\nPamela Reed (born April 2, 1949) is an American actress.  She is perhaps best known as playing Ruth Powers in various episodes of TV's The Simpsons, as Arnold Schwarzenegger's hypoglycemic partner in the 1990 movie Kindergarten Cop and as the matriarch Gail Green in Jericho.  She currently appears as Marlene Griggs-Knope on the NBC sitcom Parks and Recreation...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/twFPXXzwuSd5khJVMFZU7zsVV4o.jpg", url:"https://themoviedb.org/person/14699"}}, {tmdbId:"15419", properties:{bornIn:"Philadelphia, Pennsylvania, U.S.A.", imdbId:"0906640", born:date('1955-01-08'), name:"Thomas G. Waites", bio:"An American actor and acting instructor born in Philadelphia, Pennsylvania.  Waites runs an acting studio in New York City which is named for him.  He has been a member of the Actor's Studio since 1984.  Since the 1970s, Waites has appeared in over 30 television and film productions.  Some of his credits as a television actor include NYPD Blue, Buffy the Vampire Slayer, Oz, Law & Order, Law & Order: Criminal Intent and The Jury.  In film, he appeared in Unwed Father, State of Grace, . . ...", url:"https://themoviedb.org/person/15419"}}, {tmdbId:"586460", properties:{imdbId:"0103642", born:date('1962-09-23'), name:"Janelle Brady", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2y8JoUpikyp4XyqQPZ9bGXpbDbs.jpg", url:"https://themoviedb.org/person/586460"}}, {tmdbId:"225260", properties:{imdbId:"0107621", name:"Gil Brenton", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jll5tt9SmpOZdTSvhshx8CcqDio.jpg", url:"https://themoviedb.org/person/225260"}}, {tmdbId:"555068", properties:{bornIn:"Regensburg, Germany", imdbId:"0697214", born:date('1956-01-01'), name:"Robert Prichard", url:"https://themoviedb.org/person/555068"}}, {tmdbId:"555069", properties:{bornIn:"Pennsylvania, USA", imdbId:"0752763", born:date('1946-10-29'), name:"Pat Ryan", died:date('1991-03-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2GNcgJkJG6oaJ8ptUhcYtLEqi7n.jpg", url:"https://themoviedb.org/person/555069"}}, {tmdbId:"70971", properties:{imdbId:"0495323", name:"Penny Leatherbarrow", url:"https://themoviedb.org/person/70971"}}, {tmdbId:"70972", properties:{imdbId:"0516180", name:"Howard Lloyd-Lewis", url:"https://themoviedb.org/person/70972"}}, {tmdbId:"70973", properties:{imdbId:"0100692", name:"Jonathan Bowater", url:"https://themoviedb.org/person/70973"}}, {tmdbId:"14782", properties:{bornIn:"New York City, New York, USA", imdbId:"0732367", born:date('1942-02-14'), name:"Andrew Robinson", bio:"Andrew Robinson (born February 14, 1942) is an American film, stage, and television actor. \n\nRobinson is known to specialize in playing devious and psychotic roles.  Originally a stage actor, he works predominantly in supporting roles on television and in low-budget films.  He is best known for his roles in Dirty Harry and Hellraiser as well as on Star Trek: Deep Space Nine...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v9PVuHgPBpmR7ey5PO354djs40Z.jpg", url:"https://themoviedb.org/person/14782"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"28285", properties:{imdbId:"0002850", name:"Rick Giovinazzo", url:"https://themoviedb.org/person/28285"}}, {tmdbId:"1625710", properties:{name:"Veronica Stork", url:"https://themoviedb.org/person/1625710"}}, {tmdbId:"2495184", properties:{name:"Mitch Maglio", url:"https://themoviedb.org/person/2495184"}}, {tmdbId:"2495186", properties:{name:"Asaph Livni", url:"https://themoviedb.org/person/2495186"}}, {tmdbId:"35091", properties:{bornIn:"Lowell, Massachusetts, USA", imdbId:"0342241", born:date('1971-07-09'), name:"Scott Grimes", bio:"Scott Grimes (born July 9, 1971) is an American actor, voice artist and musician.  Some of his most prominent roles are his appearances on ER, Party of Five, Band of Brothers, and American Dad...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7LOWBMiRsSVm8iLj3mklQc6v7Jy.jpg", url:"https://themoviedb.org/person/35091"}}, {tmdbId:"56128", properties:{bornIn:"Mission Viejo, California, USA", imdbId:"0001785", born:date('1969-12-19'), name:"Kristy Swanson", bio:"An American actress best known for playing Buffy in the 1992 film Buffy the Vampire Slayer, she also played Catherine \"Cathy\" Dollanganger in the movie version of the V. C.  Andrews book Flowers in the Attic. \n\nDescription above from the Wikipedia article Kristy Swanson, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8gPVElKDCBllmfIP0pjZL9zISKv.jpg", url:"https://themoviedb.org/person/56128"}}, {tmdbId:"101785", properties:{bornIn:"Ventura, California, U.S.", imdbId:"0789326", born:date('1965-07-18'), name:"Michael Sharrett", bio:"​From Wikipedia, the free encyclopedia\n\nMichael Stuart Sharrett (born July 18, 1965) is an American actor who received a Young Artist Award nomination as the \"Best Young Actor in a Horror Motion Picture\" for his role as Tom in the 1986 witty sci-fi/horror movie Deadly Friend.  Best known for his role in the 1978 classic family movie The Magic of Lassie with James Stewart, Sharrett additionally co-starred in the 1985 action film Savage Dawn and in the 1986 Wes Craven horror film Deadly Friend...", url:"https://themoviedb.org/person/101785"}}, {tmdbId:"110434", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0878645", born:date('1951-06-07'), name:"Anne Twomey", bio:"​From Wikipedia, the free encyclopedia\n\nAnne Twomey (born June 7, 1951) in Boston, Massachusetts, USA is an American stage, film, and television actress. \n\nDescription above from the Wikipedia article Anne Twomey, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/s30iZVulPrAQHzPtydykjym1gaa.jpg", url:"https://themoviedb.org/person/110434"}}, {tmdbId:"49425", properties:{bornIn:"Albuquerque, NM", imdbId:"0001272", born:date('1971-03-13'), name:"Annabeth Gish", bio:"Annabeth Gish is an American actress.  She has played roles in films Shag, Hiding Out, Mystic Pizza, SLC Punk!, The Last Supper and Double Jeopardy...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wfUaE95xUJ3Kh5okDpUMZNmbcom.jpg", url:"https://themoviedb.org/person/49425"}}, {tmdbId:"22865", properties:{bornIn:"Macon, Georgia, USA", imdbId:"0005153", born:date('1932-12-05'), name:"Little Richard", bio:"Richard Wayne Penniman (December 5, 1932 - May 9, 2020), better known as Little Richard, was a flamboyant and groundbreaking American singer, songwriter and musician. \n\nLittle Richard was a pioneering influence on the birth of Rock 'n' Roll...", died:date('2020-05-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lGgYKbHngV1w9n4OqbmG9kVZs7I.jpg", url:"https://themoviedb.org/person/22865"}}, {tmdbId:"2887", properties:{bornIn:"Pomona, California, USA", imdbId:"0001823", born:date('1949-12-07'), name:"Tom Waits", bio:"Thomas Alan \"Tom\" Waits is an American singer-songwriter, composer, and actor.  Waits has a distinctive voice, described by critic Daniel Durchholz as sounding \"like it was soaked in a vat of bourbon, left hanging in the smokehouse for a few months, and then taken outside and run over with a car...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gaxN5hhRZE84ebdKWpAOjX9Sbcf.jpg", url:"https://themoviedb.org/person/2887"}}, {tmdbId:"9235", properties:{bornIn:"Cesena, Forlì-Cesena, Emilia-Romagna, Italy", imdbId:"0000971", born:date('1960-08-10'), name:"Nicoletta Braschi", bio:"​From Wikipedia, the free encyclopedia. \n\nNicoletta Braschi  (born April 14, 1960) is an Italian actress and producer, best known for her work with her husband, actor and director Roberto Benigni. \n\nBorn in Cesena, Braschi studied in Rome's Academy of Dramatic Arts where she first met Benigni in 1980.  Her first film was with Benigni in 1983, the comedy Tu Mi Turbi (\"You Upset Me\").  She later appeared in two Jim Jarmusch films, Down by Law and Mystery Train...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i1BYJhg2V6PZEkCaMyYNLRqutmM.jpg", url:"https://themoviedb.org/person/9235"}}, {tmdbId:"67906", properties:{imdbId:"0584819", born:date('1932-09-24'), name:"Dominique Michel", url:"https://themoviedb.org/person/67906"}}, {tmdbId:"67905", properties:{bornIn:"Québec City, Québec, Canada", imdbId:"0077715", born:date('1948-04-28'), name:"Dorothée Berryman", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zlc88cQfPJuNYCIJC3RYu5L0mVO.jpg", url:"https://themoviedb.org/person/67905"}}, {tmdbId:"17388", properties:{bornIn:"Chicoutimi, Québec, Canada", imdbId:"0691925", born:date('1950-05-12'), name:"Louise Portal", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/U22fn8QRKZltUmif1i9C5yxhbq.jpg", url:"https://themoviedb.org/person/17388"}}, {tmdbId:"83180", properties:{imdbId:"0193629", born:date('1946-02-11'), name:"Pierre Curzi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wVNhAkkVhSwKBaEQR2rNDbZCWcm.jpg", url:"https://themoviedb.org/person/83180"}}, {tmdbId:"785", properties:{bornIn:"New York City, New York, USA", imdbId:"0751638", born:date('1953-04-23'), name:"James Russo", bio:"From Wikipedia, the free encyclopedia\n\nJames Vincent Russo (born April 23, 1953) is an American film and television actor.  He has starred in over 90 films in three decades. \n\nDescription above from the Wikipedia article James Russo, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nubhNb5OUkzsrndD1BNqzp7MGyo.jpg", url:"https://themoviedb.org/person/785"}}, {tmdbId:"1981", properties:{bornIn:"Tulsa, Oklahoma, USA", imdbId:"0005569", born:date('1952-11-08'), name:"Alfre Woodard", bio:"Alfre Ette Woodard (born November 8, 1952) is an American film, stage, and television actress.  She has been nominated once for an Academy Award and Grammy Awards, 12 times for Emmy Awards (winning four), and has also won a Golden Globe and three Screen Actors Guild Awards.  She is known for her role in films such as Cross Creek, Miss Firecracker, Grand Canyon, Passion Fish, Primal Fear, Star Trek: First Contact, Miss Evers' Boys, K-PAX, Radio, Take the Lead and The Family That Preys...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/70AVFDROBAeVhWDEMKWfXPpBVYq.jpg", url:"https://themoviedb.org/person/1981"}}, {tmdbId:"2394", properties:{bornIn:"Cleveland - Ohio - USA", imdbId:"0001688", born:date('1956-07-01'), name:"Alan Ruck", bio:"From Wikipedia, the free encyclopedia.   Alan Ruck (born July 1, 1956) is an American film, stage and television actor, perhaps best known for his roles as Cameron Frye in Ferris Bueller's Day Off and Stuart Bondek on Spin City...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4gyMiVcxiynVDXeLkALf8h0seoD.jpg", url:"https://themoviedb.org/person/2394"}}, {tmdbId:"4004", properties:{bornIn:"Buffalo, New York, USA", imdbId:"0000470", born:date('1946-09-28'), name:"Jeffrey Jones", bio:"Jeffrey Duncan Jones (born September 28, 1946) is an American actor.  He has appeared in many films and television shows, but may be best known for his roles as Emperor Joseph II in Miloš Forman’s Amadeus, Charles Deetz in Beetlejuice, and dean of students Edward R.  Rooney in the 1986 John Hughes film Ferris Bueller's Day Off. \n\nDescription above from the Wikipedia article Jeffrey Jones, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zLodpqWUb9OzQLpK1ZY9im1Lh0p.jpg", url:"https://themoviedb.org/person/4004"}}] AS row
