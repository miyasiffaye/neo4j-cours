UNWIND [{tmdbId:"81749", properties:{bornIn:"Porto, Portugal", imdbId:"0210701", born:date('1908-12-11'), name:"Manoel de Oliveira", bio:"Manoel de Oliveira was born in Porto, Portugal on December 11, 1908, to Francisco José de Oliveira and Cândida Ferreira Pinto.  His family were wealthy industrialists.  Oliveira attended school in Galicia, Spain and his goal as a teenager was to become an actor.  He enrolled in Italian film-maker Rino Lupo's acting school at age 20, but later changed his mind when he saw Walther Ruttmann's documentary Berlin: Symphony of a City...", died:date('2015-04-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lkEY4Amtuyk8hPmNz01EqWYH3Xk.jpg", url:"https://themoviedb.org/person/81749"}}, {tmdbId:"5953", properties:{bornIn:"Rockville, Maryland, USA", imdbId:"0005069", born:date('1969-10-22'), name:"Spike Jonze", bio:"Spike Jonze (born Adam Spiegel; October 22, 1969) is an American director, producer and actor, whose work includes music videos, commercials, film and television.  He is best known for his collaborations with writer Charlie Kaufman, which include the 1999 film Being John Malkovich and the 2002 film Adaptation. , and for his work as director of the 2009 film Where the Wild Things Are.  He was also a co-creator and executive producer of MTV's Jackass.  He is currently the creative director of VBS. tv...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x2QeqEXvi3QjgTybvZ4mmqUf4qO.jpg", url:"https://themoviedb.org/person/5953"}}, {tmdbId:"57206", properties:{bornIn:" London ", imdbId:"0006845", born:date('1949-09-19'), name:"Sally Potter", bio:"Charlotte Sally Potter OBE (born 19 September 1949) is an English film director and screenwriter.  She is known for directing Orlando (1992), which won the audience prize for Best Film at the Venice Film Festival.  She also directed The Tango Lesson (1997), The Man Who Cried (2000), Yes (2004), Rage (2009), Ginger & Rosa (2012), The Party (2017) and most recently The Roads Not Taken (2020)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7hzuG6C7GD8gbBtqdoHOfwQ3P5M.jpg", url:"https://themoviedb.org/person/57206"}}, {tmdbId:"54733", properties:{bornIn:"Dix Hills, Long Island, New York, USA", imdbId:"0609549", born:date('1964-07-11'), name:"Greg Mottola", bio:"Gregory J.  'Greg' Mottola (born July 11, 1964) is an American filmmaker, screenwriter and television director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8PIQgw1pw4zxsy1aH0d9jyUoRBA.jpg", url:"https://themoviedb.org/person/54733"}}, {tmdbId:"11151", properties:{bornIn:"New York City, New York, USA", imdbId:"0001024", born:date('1959-05-21'), name:"Nick Cassavetes", bio:"Nick Cassavetes (born May 21, 1959) is an American film actor, screenwriter, and filmmaker...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kFGQOcOyBvQSW4k6m5LR8lnbu8n.jpg", url:"https://themoviedb.org/person/11151"}}, {tmdbId:"34517", properties:{bornIn:"Conifer, Colorado, USA", imdbId:"0005295", born:date('1969-10-19'), name:"Trey Parker", bio:"From Wikipedia, the free encyclopedia\n\nTrey Parker (born Randolph Severn Parker III; October 19, 1969) is an American animator, screenwriter, director, producer, voice artist, musician and actor, best known for being the co-creator of the television series South Park along with his creative partner and best friend Matt Stone. \n\nParker started his film career in 1992, making a holiday short titled Jesus vs.  Frosty.  His first success came from Cannibal! The Musical...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/A6kLY5TLykcqhzl7tk9Fwp8XRIX.jpg", url:"https://themoviedb.org/person/34517"}}, {tmdbId:"93133", properties:{imdbId:"0156017", name:"Christopher Scott Cherot", url:"https://themoviedb.org/person/93133"}}, {tmdbId:"10", properties:{bornIn:"Wooster, Ohio, USA", imdbId:"0677037", born:date('1961-01-18'), name:"Bob Peterson", bio:"Robert \"Bob\" Peterson (born January 1961) is an American animator, screenwriter, director and voice actor, who has worked for Pixar since 1994.  His first job was working as a layout artist and animator on Toy Story.  He was nominated for an Oscar for his screenplay for Finding Nemo.  Petersonis a co-director and the writer of Up, which gained him his second Oscar nomination.  He also performed the voices of Roz in Monsters, Inc. , Mr...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1D5PtC97QwIks6xTjbJ1HNE8kbT.jpg", url:"https://themoviedb.org/person/10"}}, {tmdbId:"162102", properties:{imdbId:"0075483", name:"Myles Berkowitz", url:"https://themoviedb.org/person/162102"}}, {tmdbId:"15009", properties:{bornIn:"Washington, D.C., USA", imdbId:"0857620", born:date('1971-08-10'), name:"Justin Theroux", bio:"Justin Paul Theroux is an American actor and screenwriter.  He is best known for his work with film director David Lynch in Mulholland Drive (2001) and Inland Empire (2006), his starring role as Kevin Garvey in the HBO series The Leftovers (2014–2017) and as Tom in The Girl on the Train (2016).  He is also known as a screenwriter for films such as Tropic Thunder, Iron Man 2, Rock of Ages, and Zoolander 2...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vnI9L0rXBAw1HeC0Q8hJGeJMGAW.jpg", url:"https://themoviedb.org/person/15009"}}, {tmdbId:"19975", properties:{bornIn:"Oceanside, New York, USA", imdbId:"0742146", born:date('1972-07-11'), name:"Michael Rosenbaum", bio:"Michael Rosenbaum (born July 11, 1972) is an American actor and director.  He is best known for portraying Lex Luthor on Smallville and Flash in the DC animated universe...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9a1wACjRIAg1cbTEsL5WrzPwnFi.jpg", url:"https://themoviedb.org/person/19975"}}, {tmdbId:"3064", properties:{bornIn:"Peterhead, Aberdeenshire, Scotland, UK", imdbId:"0611932", born:date('1959-11-02'), name:"Peter Mullan", bio:"Peter Mullan (born 2 November 1959) is a Scottish stage, film and television actor and director, best known for playing supporting roles in feature films such as \"Braveheart\" and \"Trainspotting\", and for starring as the titular character Joe Kavanagh in \"My Name Is Joe\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7Y6oHcv719kfYxpWcYAE7wXzE7C.jpg", url:"https://themoviedb.org/person/3064"}}, {tmdbId:"148100", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0911505", born:date('1964-08-21'), name:"Donal Lardner Ward", url:"https://themoviedb.org/person/148100"}}, {tmdbId:"34849", properties:{bornIn:"New York City, New York, USA", imdbId:"0001130", born:date('1963-10-26'), name:"Ted Demme", bio:"From Wikipedia, the free encyclopedia. \n\nEdward \"Ted\" Demme (October 26, 1963 – January 13, 2002) was an American film director and producer...", died:date('2002-01-13'), url:"https://themoviedb.org/person/34849"}}, {tmdbId:"77003", properties:{bornIn:"Long Island, New York, USA", imdbId:"0640334", born:date('1964-01-01'), name:"Gavin O'Connor", bio:"Gavin O'Connor (born 1963) is an American film director, screenwriter, producer, playwright and actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zf3MHvbf2uKC4UbsuFHQYLz48g.jpg", url:"https://themoviedb.org/person/77003"}}, {tmdbId:"41887", properties:{bornIn:"El Centro, California, USA", imdbId:"0689187", born:date('1970-10-30'), name:"Michael Polish", url:"https://themoviedb.org/person/41887"}}, {tmdbId:"554095", properties:{imdbId:"0516286", name:"Chi Muoi Lo", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mlBxR3PuzUappuaIvKv9ebgOebo.jpg", url:"https://themoviedb.org/person/554095"}}, {tmdbId:"40223", properties:{bornIn:"Sacramento, California, U.S.", imdbId:"0138620", born:date('1969-05-09'), name:"Joe Carnahan", bio:"​From Wikipedia, the free encyclopedia.   \n\nJoseph Aaron \"Joe\" Carnahan (born May 9, 1969) is an American independent film director, screenwriter, producer and actor best known for his films Blood, Guts, Bullets and Octane, Narc, Smokin' Aces and The A-Team.  He is the brother of screenwriter Matthew Michael Carnahan...", url:"https://themoviedb.org/person/40223"}}, {tmdbId:"9048", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0163988", born:date('1962-04-02'), name:"Clark Gregg", bio:"Robert Clark Gregg (born April 2, 1962) is an American actor, screenwriter and director.  He co-starred as Christine Campbell's ex-husband Richard in the CBS sitcom The New Adventures of Old Christine, which debuted in March 2006 and concluded in May 2010.  He is best known for playing Agent Phil Coulson in the Marvel Cinematic Universe...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zwyhwrxgpiufSPpjC9dxCy5kAB0.jpg", url:"https://themoviedb.org/person/9048"}}, {tmdbId:"78157", properties:{bornIn:"Bangalore, India", imdbId:"0000755", born:date('1923-04-17'), name:"Lindsay Anderson", bio:"Lindsay Gordon Anderson (17 April 1923 – 30 August 1994) was an English director and film critic, best know for his association with the Free Cinema movement and the British New Wave.  He is most widely remembered for his 1968 film if. . . . , which won the Grand Prix at Cannes Film Festival. \n\nDescription above from the Wikipedia article Lindsay Anderson, licensed under CC-BY-SA,full list of contributors on Wikipedia...", died:date('1994-08-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l4R2RoLdqtY8xLrrt6v176tbtNQ.jpg", url:"https://themoviedb.org/person/78157"}}] AS row
