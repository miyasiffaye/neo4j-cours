UNWIND [{tmdbId:"164094", properties:{bornIn:"Camarillo, California, USA", imdbId:"1677477", born:date('1979-08-30'), name:"Marin Ireland", bio:"Marin Ireland is an American film and television actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dLLyqNFSKIdkq3asfJdGRcckco.jpg", url:"https://themoviedb.org/person/164094"}}, {tmdbId:"1255078", properties:{imdbId:"2777975", name:"Laura Clery", bio:"Laura Clery is an actress and writer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e8HKOuPtiWBaRE9R5fEFMigcICJ.jpg", url:"https://themoviedb.org/person/1255078"}}, {tmdbId:"205262", properties:{bornIn:"Saint-Raphaël, Var, France", imdbId:"1156818", name:"William Abadie", bio:"William Abadie is an actor. \n\nWilliam Abadie est acteur et producteur né à Saint-Raphaël, sur la Côte d'Azur en France. \n\nIl a passé son enfance et son adolescence à Megève dans les Alpes françaises.  Après de nombreux voyages à l’étranger, il s’établit à Paris où il suit les cours de l’Ecole Claude Mathieu.  En 1998, il quitte Paris pour New York.  Il devient l’élève du The Lee Strasberg Theatre Institute où il obtient un prix d’excellence...", url:"https://themoviedb.org/person/205262"}}, {tmdbId:"12207", properties:{bornIn:" Melbourne, Victoria, Australia", imdbId:"0001541", born:date('1968-05-28'), name:"Kylie Minogue", bio:"​From Wikipedia, the free encyclopedia\n\nKylie Ann Minogue, OBE ( born 28 May 1968), is an Australian pop singer, songwriter, and actress.  After beginning her career as a child actress on Australian television, she achieved recognition through her role in the television soap opera Neighbours, before commencing her career as a recording artist in 1987...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9xzvMYN5E6Gzudg0U9nmvVWI9Mc.jpg", url:"https://themoviedb.org/person/12207"}}, {tmdbId:"139549", properties:{bornIn:"London,  England", imdbId:"1239499", born:date('1978-02-17'), name:"Rory Kinnear", bio:"Rory Kinnear (born 17 February 1978) is an English actor and playwright who has worked with the Royal Shakespeare Company and the Royal National Theatre. \n\nHe is best known for playing Bill Tanner in the James Bond films Quantum of Solace, Skyfall, and Spectre, and in various video games of the franchise.  He is the youngest actor to play the role of Bill Tanner...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8aEABMeHXOozwE5DrMxUlCM9mpG.jpg", url:"https://themoviedb.org/person/139549"}}, {tmdbId:"139150", properties:{bornIn:"Tampa, Florida, USA", imdbId:"1541272", born:date('1981-11-25'), name:"Amy Seimetz", bio:"An American film and television actress, producer and director, especially known for producing and directing short and independent films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qa7vCi7TViddGjuYEszLdi8DRqN.jpg", url:"https://themoviedb.org/person/139150"}}, {tmdbId:"141226", properties:{imdbId:"2426419", name:"Andrew Sensenig", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wkzoOV3uW4iVeIGWUe2TIPO4DVk.jpg", url:"https://themoviedb.org/person/141226"}}, {tmdbId:"1819469", properties:{name:"Thiago Martins", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lP48woks9Th4cds9uexcGIN1EvH.jpg", url:"https://themoviedb.org/person/1819469"}}, {tmdbId:"1109317", properties:{imdbId:"4723934", name:"Nermina Lukac", url:"https://themoviedb.org/person/1109317"}}, {tmdbId:"1109318", properties:{imdbId:"5175924", name:"Milan Dragisic", url:"https://themoviedb.org/person/1109318"}}, {tmdbId:"1109319", properties:{imdbId:"5175919", name:"Jonathan Lampinen", url:"https://themoviedb.org/person/1109319"}}, {tmdbId:"1109320", properties:{imdbId:"5175923", name:"Peter Fält", url:"https://themoviedb.org/person/1109320"}}, {tmdbId:"206919", properties:{bornIn:"Londra, Regno Unito", imdbId:"2257207", born:date('1989-02-24'), name:"Daniel Kaluuya", bio:"Daniel Kaluuya (born 24 February 1989) is an English actor and writer.  Kaluuya played Chris Washington in the 2017 horror film Get Out, Posh Kenneth in the E4 teen-drama Skins, Bing in the Black Mirror episode \"Fifteen Million Merits\".  For his performance in Get Out, Kaluuya earned widespread acclaim and recognition including an Academy Award nomination for Best Actor. \n\nHe also appeared as Tealeaf in the BBC dark comedy series Psychoville and Mac in the BBC Three horror drama The Fades...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4eX0XyD9ImmJg26ED3BHRXpvzzg.jpg", url:"https://themoviedb.org/person/206919"}}, {tmdbId:"1178783", properties:{imdbId:"1580941", name:"Bill Blakemore", url:"https://themoviedb.org/person/1178783"}}, {tmdbId:"1178784", properties:{imdbId:"5196944", name:"Geoffrey Cocks", url:"https://themoviedb.org/person/1178784"}}, {tmdbId:"1178785", properties:{imdbId:"5196429", name:"Juli Kearns", url:"https://themoviedb.org/person/1178785"}}, {tmdbId:"1178786", properties:{imdbId:"5196435", name:"John Fell Ryan", url:"https://themoviedb.org/person/1178786"}}, {tmdbId:"1177904", properties:{imdbId:"4303926", name:"David Kato", url:"https://themoviedb.org/person/1177904"}}, {tmdbId:"1177905", properties:{imdbId:"5689401", name:"Christopher Senyonjo", url:"https://themoviedb.org/person/1177905"}}, {tmdbId:"1963144", properties:{imdbId:"5396407", name:"Benjamin Sheeler", bio:"Benjamin Sheeler is known for his work on Marshall (2017), The Chop (2017) and Before the Border (2015)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dkXc8F6oBUqCeKZWBosfbY1fSp9.jpg", url:"https://themoviedb.org/person/1963144"}}] AS row
