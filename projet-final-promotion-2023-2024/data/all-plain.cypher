UNWIND [{tmdbId:"58724", properties:{bornIn:"Lancaster, Pennsylvania, USA", imdbId:"0452748", born:date('1970-07-23'), name:"Rya Kihlstedt", bio:"From Wikipedia, the free encyclopedia. \n\nRya Kihlstedt (born July 23, 1970) is an American actress. \n\nKihlstedt was born in Lancaster, Pennsylvania and is a 1991 graduate of Skidmore College in Theatre Arts. \n\nShe is also of Swedish descent.  She has two children (Ava Emanuelle born 1999, and Giovanni born 2001) with her actor husband Gil Bellows. \n\nShe is the sister of Oakland-based violinist, Carla Kihlstedt...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i0KDFXvd2s5nNGJ4U0ogwpNbhYi.jpg", url:"https://themoviedb.org/person/58724"}}, {tmdbId:"28410", properties:{bornIn:"Los Angeles - California - USA", imdbId:"0000998", born:date('1971-06-15'), name:"Jake Busey", bio:"From Wikipedia, the free encyclopedia. \n\nWilliam Jacob \"Jake\" Busey (born June 15, 1971) is an American actor, musician and film producer.  He is sometimes credited as \"Jacob Busey\" or \"William Busey\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/k8E2lUJEbaxeqgj9rjxKjQCXbcc.jpg", url:"https://themoviedb.org/person/28410"}}, {tmdbId:"11864", properties:{bornIn:"New Castle, Delaware, USA", imdbId:"0000202", born:date('1974-09-10'), name:"Ryan Phillippe", bio:"Matthew Ryan Phillippe (born September 10, 1974), better known as Ryan Phillippe, is an American actor.  After appearing on the soap opera One Life to Live, he came to fame in the late 1990s starring in a string of films, including I Know What You Did Last Summer, Cruel Intentions, and 54.  In the 2000s, he appeared in several films, including 2001's Academy Award Best Picture nominee Gosford Park, 2005's Academy Award-winning ensemble film Crash, and the 2006 war drama Flags of Our Fathers...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fp0GlHdZBt8NGjoms3k3od0w7Qd.jpg", url:"https://themoviedb.org/person/11864"}}, {tmdbId:"19149", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0001760", born:date('1973-05-16'), name:"Tori Spelling", bio:"Tori Spelling (born May 16, 1973) is an American actress and reality television personality.  She is the only daughter of famed television mogul Aaron Spelling.  Spelling herself came to fame as one of the stars of Beverly Hills 90210, the era-defining teen drama produced by her father, playing the virtuous good-girl Donna Martin...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xUPnjmmMcOdAHVhZL5b88MrJi7R.jpg", url:"https://themoviedb.org/person/19149"}}, {tmdbId:"33260", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0005327", born:date('1976-03-08'), name:"Freddie Prinze Jr.", bio:"Freddie Prinze, Jr.  (born March 8, 1976) is an American actor.  He rose to fame during the late 1990s and early 2000s, after starring in several Hollywood films aimed at teenage audiences like I Know What You Did Last Summer and its sequel I Still Know What You Did Last Summer as well as She's All That, Summer Catch, Scooby-Doo, Scooby-Doo 2: Monsters Unleashed, and Delgo.  Prinze has also had acting roles in television shows, including Freddie and 24...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8V9yNBjCNRBKROyjCLKLJGcCBdG.jpg", url:"https://themoviedb.org/person/33260"}}, {tmdbId:"77896", properties:{bornIn:"Newark - New Jersey - USA", imdbId:"0004740", born:date('1965-04-07'), name:"Bill Bellamy", bio:"From Wikipedia, the free encyclopedia\n\nWilliam \"Bill\" Bellamy (born April 7, 1965) is an American actor and stand-up comedian.  He currently resides in California.  Bellamy first gained national notoriety on HBO's Russell Simmons' Def Comedy Jam, where he is credited for creating or uttering before a televised audience, the phrase \"booty call\", described as a late night call to a potential paramour with the intention of meeting strictly for sex...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xdIgRidqBVkzmpoKYTak5HO0JTd.jpg", url:"https://themoviedb.org/person/77896"}}, {tmdbId:"154341", properties:{bornIn:"Nashville, Tennessee, USA", imdbId:"0903397", born:date('1974-03-25'), name:"Lark Voorhies", bio:"Lark Voorhies (born March 25, 1974) is an American actress who rose to fame playing Lisa Turtle in Saved by the Bell, for which she was nominated for the Young Artist Award four times, winning in 1990 and 1993.  She also portrayed the role as a regular on Good Morning, Miss Bliss...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/geQXkLmtrzqeY7SUtsyBBdAebDb.jpg", url:"https://themoviedb.org/person/154341"}}, {tmdbId:"42743", properties:{bornIn:"Miami, Florida, USA", imdbId:"0005248", born:date('1974-02-18'), name:"Mari Morrow", bio:"​From Wikipedia, the free encyclopedia.   \n\nMari Morrow (born February 18, 1974) is an American film and television actress and real estate agent. \n\nDescription above from the Wikipedia article Mari Morrow, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7W2DQVtN1LiAwwDSxApdrlx7TiS.jpg", url:"https://themoviedb.org/person/42743"}}, {tmdbId:"33259", properties:{bornIn:"Waco, Texas, USA", imdbId:"0001349", born:date('1979-02-21'), name:"Jennifer Love Hewitt", bio:"Jennifer Love Hewitt (born February 21, 1979) is an American actress, singer-songwriter, film and television director and producer.  Hewitt began her acting career as a child by appearing in television commercials and the Disney Channel series Kids Incorporated.  She rose to fame in teenage popular culture in her roles in the Fox series Party of Five, as Sarah Reeves, and films I Know What You Did Last Summer and its sequel, as Julie James...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l9ggjks77ychiR4Pw6FUkSTux0m.jpg", url:"https://themoviedb.org/person/33259"}}, {tmdbId:"11863", properties:{bornIn:"New York City, New York, USA", imdbId:"0001264", born:date('1977-04-14'), name:"Sarah Michelle Gellar", bio:"Sarah Michelle Prinze  (born April 14, 1977), known professionally by her birth name of Sarah Michelle Gellar, is an American film and television actress.  She became widely known for her role as Buffy Summers on the WB/UPN television series Buffy the Vampire Slayer, for which she won six Teen Choice Awards and the Saturn Award for Best Genre TV Actress and received a Golden Globe Award nomination...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2p0CEzdnHXSs0g6yTdIqJoztfBT.jpg", url:"https://themoviedb.org/person/11863"}}, {tmdbId:"44905", properties:{bornIn:"Boring, Oregon, U.S.", imdbId:"0584553", born:date('1974-12-30'), name:"Charis Michelsen", bio:"From Wikipedia, the free encyclopedia. \n\nCharis Elisa Michelsen is an American actress, a former model and a make-up artist. \n\nDescription above from the Wikipedia article Charis Michelsen, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/44905"}}, {tmdbId:"1277319", properties:{imdbId:"0489107", name:"Tom Larson", url:"https://themoviedb.org/person/1277319"}}, {tmdbId:"171396", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0819435", born:date('1948-03-23'), name:"Richard Spore", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eG1mszyZrjCBql9TUCEEBFWSqIH.jpg", url:"https://themoviedb.org/person/171396"}}, {tmdbId:"6383", properties:{bornIn:"Cupertino, California, USA", imdbId:"0001173", born:date('1968-03-12'), name:"Aaron Eckhart", bio:"Aaron Edward Eckhart is an American film and stage actor.  Born in California, he moved to England at 13 when his father relocated the family.  Several years later, he began his acting career performing in school plays.  In 1994, he graduated from Brigham Young University with a Bachelor of Fine Arts degree in film.  For much of the mid-1990s, he lived in New York City as a struggling, unemployed actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6OeI9krCmaJ6I4sgSEwy9atzaGp.jpg", url:"https://themoviedb.org/person/6383"}}, {tmdbId:"43372", properties:{bornIn:"Glasgow, Montana, USA", imdbId:"0250368", born:date('1965-03-04'), name:"Stacy Edwards", bio:"Stacy Edwards (born March 4, 1965) is an American actress.  Edwards was born in Glasgow, Montana, the daughter of Patty and Preston Edwards, who was an Air Force officer.  She grew up all over the world, from Guam to Alabama.  At 18, she received a scholarship to the Lou Conte Dance Studio in Chicago and began her performance career as a dancer and actress.  She portrayed Hayley Benson on NBC daytime drama Santa Barbara from 1986 to 1988...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vTvcn83poPsGhdUVGNCARBmqgzU.jpg", url:"https://themoviedb.org/person/43372"}}, {tmdbId:"19208", properties:{bornIn:"Hamilton, New York, USA", imdbId:"0540164", born:date('1963-01-12'), name:"Matt Malloy", bio:"From Wikipedia, the free encyclopedia\n\nMatt Malloy is an American character actor.  He has had numerous roles in both film and TV often portraying the beleaguered everyman.  Malloy's only starring role to date was alongside Aaron Eckhart in the critically acclaimed black comedy, In the Company of Men.  He also notably guest-starred on 6 episodes of \"Six Feet Under\" in 2004 and 2005, and co-starred in the film The Stepford Wives with Nicole Kidman...", url:"https://themoviedb.org/person/19208"}}, {tmdbId:"552325", properties:{imdbId:"0558801", name:"Maria Mathiesen", url:"https://themoviedb.org/person/552325"}}, {tmdbId:"1671", properties:{bornIn:"Flekkefjord, Norway", imdbId:"0030153", born:date('1944-07-18'), name:"Sverre Anker Ousdal", bio:"Sverre Anker Ousdal (born 18 July 1944) is a Norwegian actor born in Flekkefjord.  His debut was in 1965 at Den Nationale Scene in Bergen.  He was at the Oslo Nye Teater in the period 1967 to 1970, and at the National Theatre from 1970...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tDUPfRH8L47kXTBFdGU5281fvZL.jpg", url:"https://themoviedb.org/person/1671"}}, {tmdbId:"226170", properties:{bornIn:"Oslo, Norway", imdbId:"0035277", born:date('1962-11-26'), name:"Gisken Armand", url:"https://themoviedb.org/person/226170"}}, {tmdbId:"13514", properties:{bornIn:"Niel, Flanders, Belgium", imdbId:"0213912", born:date('1946-02-14'), name:"Jan Decleir", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wgCWRtfO4HROS1o2QltEGh9DLGG.jpg", url:"https://themoviedb.org/person/13514"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"45754", properties:{bornIn:"The Hague, Zuid-Holland, Netherlands", imdbId:"0404806", born:date('1973-06-21'), name:"Fedja van Huêt", bio:"From Wikipedia, the free encyclopedia. \n\nFedja van Huêt (born 21 June 1971 in The Hague) is a Dutch stage and film actor.  He studied a college of theatre en starred several plays and movies.  He was connected to the theater companies RO-theatre and Theatre Company Hollandia.  In present, he is connected to Theatre Company Amsterdam.  In his career, he has been rewarded with a Gouden Kalf, the most prestigious film prize of the Netherlands, for his role in the movie Amnesia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fIN5xMtn1B7XD0HD5Qqg6uZIDd8.jpg", url:"https://themoviedb.org/person/45754"}}, {tmdbId:"79448", properties:{bornIn:"Edam, Netherlands", imdbId:"0776926", born:date('1962-10-31'), name:"Betty Schuurman", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7lCNa93WbOxvTpuSzl9O2x29VHA.jpg", url:"https://themoviedb.org/person/79448"}}, {tmdbId:"143010", properties:{bornIn:"Amsterdam, Noord-Holland, Netherlands", imdbId:"0233288", born:date('1970-02-08'), name:"Tamar van den Dop", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/apIheCS0PeorQ0qTW9drCrq1M1y.jpg", url:"https://themoviedb.org/person/143010"}}, {tmdbId:"5473", properties:{bornIn:"Ware, Hertfordshire, England, UK", imdbId:"0905554", born:date('1958-08-07'), name:"Julian Wadham", bio:"​From Wikipedia, the free encyclopedia\n\nJulian Wadham (born 7 August 1958) is a British actor of stage, film and television.  He has appeared on television as both Charles II (in the 2004 BBC docudrama Wren: The Man Who Built Britain) and George V (in the TV adaptation of the play My Boy Jack).  He appeared onstage as Don Pedro (alongside Zoë Wanamaker and Simon Russell Beale) at the Royal National Theatre's 2007-08 production of Much Ado About Nothing...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/20xJuLew0bNbfnwN5MOCpaOXXBH.jpg", url:"https://themoviedb.org/person/5473"}}, {tmdbId:"59191", properties:{imdbId:"0779997", name:"Nick Scotti", url:"https://themoviedb.org/person/59191"}}, {tmdbId:"82769", properties:{imdbId:"0156314", born:date('1965-11-08'), name:"Craig Chester", bio:"From Wikipedia, the free encyclopedia\n\nCraig Chester (born November 8, 1965 in West Covina, California) is an American actor and screenwriter. \n\nHe is best known for his performances in independent films in the 1990s, starting with his debut in Swoon (1992), which earned him an Independent Spirit Award nomination.  After appearing in several more independent films, he took a break from acting and wrote the autobiographical Why the Long Face?: The Adventures of a Truly Independent Actor (2003)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ptcsPmaDWzKuO7KfCWCY4lqjKMc.jpg", url:"https://themoviedb.org/person/82769"}}, {tmdbId:"58293", properties:{bornIn:"Telford, Pennsylvania, USA", imdbId:"0564107", born:date('1957-03-06'), name:"Alex McArthur", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aZk9kZUDTZJwsJGBVRORPdCTrcy.jpg", url:"https://themoviedb.org/person/58293"}}, {tmdbId:"1852", properties:{bornIn:"Dresden, Germany", imdbId:"0509583", born:date('1964-08-08'), name:"Jan Josef Liefers", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hgrzvywHlnmKPHWUPFBB6tCnVSU.jpg", url:"https://themoviedb.org/person/1852"}}, {tmdbId:"1853", properties:{bornIn:"Geneva, Switzerland", imdbId:"0888276", born:date('1958-10-23'), name:"Thierry van Werveke", died:date('2009-01-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rY3WKgG2I1rZnJbQw2rP9VQ1rOm.jpg", url:"https://themoviedb.org/person/1853"}}, {tmdbId:"677", properties:{bornIn:"Munich, Bavaria, Germany", imdbId:"0001953", born:date('1971-08-13'), name:"Moritz Bleibtreu", bio:"Moritz Bleibtreu is a German actor. \n\nBleibtreu's first appearance on TV was in the late seventies on the children's television series Neues aus Uhlenbusch.  This was followed by a role in Ich hatte einen Traum and in the miniseries Mit meinen heißen Tränen.   In 1992 he began his acting career at the Schauspielhaus in Hamburg.  He had roles in the films Speed Racer, The Baader Meinhof Complex, Run Lola Run, and Das Experiment...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uWAtkeIRE4I1EnkWw44Qhhi1Tx0.jpg", url:"https://themoviedb.org/person/677"}}, {tmdbId:"51965", properties:{bornIn:"Mound, Minnesota, USA", imdbId:"0001757", born:date('1958-09-24'), name:"Kevin Sorbo", bio:"An American actor best known for the roles of Hercules in Hercules: The Legendary Journeys and Captain Dylan Hunt in Andromeda. \n\nDescription above from the Wikipedia article Kevin Sorbo, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a6rDi3tkNJwaVoP7VGbdGelwtYw.jpg", url:"https://themoviedb.org/person/51965"}}, {tmdbId:"58856", properties:{imdbId:"0862292", name:"Tenzin Thuthob Tsarong", url:"https://themoviedb.org/person/58856"}}, {tmdbId:"58859", properties:{imdbId:"0856522", name:"Gyurme Tethong", url:"https://themoviedb.org/person/58859"}}, {tmdbId:"1525272", properties:{imdbId:"0855212", name:"Tulku Jamyang Kunga Tenzin", url:"https://themoviedb.org/person/1525272"}}, {tmdbId:"2505", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0000342", born:date('1940-01-27'), name:"James Cromwell", bio:"James Oliver Cromwell is an American film and television actor, probably best known for his role as Dr.  Zefram Cochrane in Star Trek: First Contact.  He has been nominated for an Oscar, three Emmy Awards, and four Screen Actors Guild Awards during his career. \n\nCromwell was born in Los Angeles, California and was raised in Manhattan, New York.  He was adopted by actress Kay Johnson and actor, director and producer John Cromwell, who was blacklisted during the McCarthy era...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vpNQQbM5PtxsYmVm4oh79SGFyUK.jpg", url:"https://themoviedb.org/person/2505"}}, {tmdbId:"11617", properties:{bornIn:"Hammersmith, London, UK", imdbId:"0059215", born:date('1986-01-24'), name:"Mischa Barton", bio:"Mischa Anne Marsden Barton (born 24 January 1986) is an English-American fashion model, film, television, and stage actress, best known for her role as Marissa Cooper in the American television series The O. C. . \n\nDescription above from the Wikipedia article Mischa Barton, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j3eZsKKIz4uWdVwAvokv8GHU21w.jpg", url:"https://themoviedb.org/person/11617"}}, {tmdbId:"12901", properties:{bornIn:"San Diego, California, U.S.", imdbId:"0902184", born:date('1982-10-03'), name:"Erik von Detten", bio:"Erik von Detten (born October 3, 1982) is an American actor.  He is known for his roles in Escape to Witch Mountain, Toy Story, Brink!, The Princess Diaries, So Weird, and most recently...", url:"https://themoviedb.org/person/12901"}}, {tmdbId:"16307", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0005491", born:date('1965-02-03'), name:"Maura Tierney", bio:"Maura Tierney (born February 3, 1965) is an American film and television actress, who is best known for her roles on NewsRadio and ER as well as The Affair, for which she won the Golden Globe Award in 2016...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fqFy3DcB6oUlq2DutUkow1dyZMW.jpg", url:"https://themoviedb.org/person/16307"}}, {tmdbId:"18190", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0178176", born:date('1988-11-17'), name:"Justin Cooper", bio:"Justin Cooper (born November 17, 1988) is a former American child actor who had his motion picture debut in the comedy Liar Liar. \n\nJustin Cooper started acting at the age of five, appearing in Dominos Pizza television commercials and a guest appearance on the popular sitcom Full House.  Later came The Boys Are Back.  After two years on the daytime drama General Hospital and guest appearances on ER and The Magnificent Seven, Cooper moved on to play in Liar Liar...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2RCPW4c9kn7sKCMbLvvwfLF5WrF.jpg", url:"https://themoviedb.org/person/18190"}}, {tmdbId:"11149", properties:{bornIn:"Malibu, California, USA", imdbId:"0000663", born:date('1980-08-12'), name:"Dominique Swain", bio:"Dominique Ariane Swain (born August 12, 1980) is an American actress.  She is best known for her roles as the title character in the 1997 film adaptation of Vladimir Nabokov's novel Lolita, and as Jamie Archer in the film Face/Off. \n\nSwain started her career in Hollywood as a stunt double; she appeared as the double for Macaulay Culkin's younger sister Quinn in Joseph Ruben's The Good Son (1993)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mcfwzQEm6xRtDXnVO2GNw6G8hzV.jpg", url:"https://themoviedb.org/person/11149"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"55153", properties:{bornIn:"London, England, UK", imdbId:"0517370", born:date('1975-01-01'), name:"Fiona Loewi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/V6F6CQtdT5dH5lMjCtwfcYJgMY.jpg", url:"https://themoviedb.org/person/55153"}}, {tmdbId:"93839", properties:{bornIn:"Blackgang, Isle of Wight, England, UK", imdbId:"0359430", born:date('1933-02-22'), name:"Sheila Hancock", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zX7dSYUmnoRonh64Qhl9stIQ0Qq.jpg", url:"https://themoviedb.org/person/93839"}}, {tmdbId:"8784", properties:{bornIn:"Chester, Cheshire, England, UK", imdbId:"0185819", born:date('1968-03-02'), name:"Daniel Craig", bio:"Daniel Wroughton Craig is an English actor, best known for playing British secret agent James Bond since 2006.  Craig is an alumnus of the National Youth Theatre and graduated from the Guildhall School of Music and Drama in London and began his career on stage.  His early on screen appearances were in the films Elizabeth, The Power of One and A Kid in King Arthur's Court, and on Sharpe's Eagle and Zorro in television...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iFerDZUmC5Fu26i4qI8xnUVEHc7.jpg", url:"https://themoviedb.org/person/8784"}}, {tmdbId:"40310", properties:{bornIn:"London - England - UK", imdbId:"0483457", born:date('1954-07-04'), name:"Anne Lambton", url:"https://themoviedb.org/person/40310"}}, {tmdbId:"159840", properties:{imdbId:"0091551", name:"Stephen Bogardus", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v3e28DjKs4Ten4WZKyPcu6cPDtN.jpg", url:"https://themoviedb.org/person/159840"}}, {tmdbId:"157428", properties:{born:date('1970-06-06'), name:"Randy Becker", url:"https://themoviedb.org/person/157428"}}, {tmdbId:"35962", properties:{bornIn:"Nice, Alpes-Maritimes, France", imdbId:"0488477", born:date('1960-06-15'), name:"Michèle Laroque", bio:"Michèle Laroque (born June 15, 1960) is a French actress, comedian and humorist, who has appeared in almost 60 film and television productions since 1988.  She was born in Nice, Alpes-Maritimes, France.  She was nominated for the César Awards for Best Supporting Actress in La crise (1992) and Pédale douce (1996). \n\nDescription above from the Wikipedia article Michèle Laroque, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/k3iRrItamujsyjPaAL9wyGGGTZl.jpg", url:"https://themoviedb.org/person/35962"}}, {tmdbId:"1141", properties:{bornIn:"Paris, France", imdbId:"0898653", born:date('1943-09-09'), name:"Hélène Vincent", bio:"From Wikipedia, the free encyclopedia.   Hélène Vincent, born 9 September 1940, is a French actress.   She received a César Award for Best Actress in a Supporting Role in 1989 for her role as Madame Marielle Le Quesnoy in Life Is a Long Quiet River and another in 1992 for J'embrasse pas.   Description above from the Wikipedia article Hélène Vincent, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lJJ9WjZJI6cVCpFTsXoHqSDW23v.jpg", url:"https://themoviedb.org/person/1141"}}, {tmdbId:"96981", properties:{bornIn:"Strasbourg, France", imdbId:"0238878", born:date('1984-11-30'), name:"Georges Du Fresne", bio:"Georges Du Fresne is a French actor...", url:"https://themoviedb.org/person/96981"}}, {tmdbId:"19054", properties:{bornIn:"Bellinzona, Ticino, Switzerland", imdbId:"0005655", born:date('1945-03-02'), name:"Renato Berta", bio:"Renato Berta is a Swiss cinematographer and film director, best known for his collaborations with directors Alain Tanner and Jean-Marie Straub.  Trained at the Centro Sperimentale di Cinematografia in Rome, Berta has worked as cinematographer in more than 100 films since 1969.  He won a César Award for Best Cinematography for Au revoir les enfants in 1988 and a David di Donatello for Best Cinematography for Noi credevamo in 2011...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fXjRoyeehudjs0kqsMv5yBt7b0U.jpg", url:"https://themoviedb.org/person/19054"}}, {tmdbId:"130715", properties:{imdbId:"0246822", born:date('1953-04-16'), name:"Diogo Dória", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2p8tFBuKgoCXohTz0vqRLrV3bYe.jpg", url:"https://themoviedb.org/person/130715"}}, {tmdbId:"2482", properties:{bornIn:"Glasgow, Scotland, UK", imdbId:"0641244", born:date('1965-07-09'), name:"David O'Hara", bio:"David Patrick O'Hara (born 9 July 1965) is a Scottish stage and character actor.  A graduate of the Royal Central School of Speech and Drama in London, he is best known to audiences for his numerous supporting roles in high-profile films; including Irishman Stephen in Braveheart, dimwitted mobster Fitzy in The Departed, hitman Mr.  X in Wanted, and Albert Runcorn in Harry Potter and the Deathly Hallows – Part 1.  He portrayed Det...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zPWpTV19nPLawd1E9A1jUDdcT2H.jpg", url:"https://themoviedb.org/person/2482"}}, {tmdbId:"23959", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0005226", born:date('1968-08-15'), name:"Debra Messing", bio:"​Debra Lynn Messing (born August 15, 1968)  best known for her role as Grace Adler in the sitcom Will &amp; Grace. \n\nMessing was born in the Brooklyn borough of New York City, the daughter of Sandra (née Simons), who has worked as a professional singer, banker, travel and real estate agent, and Brian Messing, a sales executive for a costume jewelry packaging manufacturer.  Messing is Jewish, a descendant of immigrants from Russia and Poland...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7YmWcP0VmO1AIoviqXoREMbjQ2V.jpg", url:"https://themoviedb.org/person/23959"}}, {tmdbId:"4177", properties:{bornIn:"London, England, UK", imdbId:"0916617", born:date('1964-03-19'), name:"Jake Weber", bio:"Jake Weber  (born 19 March 1964) is an English actor, possibly best-known for his role as Michael in Dawn of the Dead and starring opposite Brad Pitt in Meet Joe Black.  In 2001 and 2002, Weber was a series regular in HBO's The Mind of the Married Man and made guest appearances on Law & Order: Criminal Intent and NYPD Blue.  He also portrayed Joe DuBois, the husband of psychic Allison DuBois in the drama series Medium...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aCmqALe3eZ4kr0TVihIrwf6yJXE.jpg", url:"https://themoviedb.org/person/4177"}}, {tmdbId:"10825", properties:{bornIn:"Ottawa, Ontario, Canada", imdbId:"0006610", born:date('1966-02-27'), name:"Donal Logue", bio:"Donal Francis Logue (born February 27, 1966) is an Irish-Canadian film and television actor, producer and writer.  His notable roles include starring in the film The Tao of Steve, Sons of Anarchy, Vikings, the sitcom Grounded for Life, the television series Copper and the detective series Terriers.  He currently stars as detective Harvey Bullock in Fox's Gotham and had a recurring role in NBC's Law &amp; Order: Special Victims Unit as Lt.  Declan Murphy...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oRj908uSHpCWQKQ9DfzzZrwKpcs.jpg", url:"https://themoviedb.org/person/10825"}}, {tmdbId:"56184", properties:{imdbId:"0139364", name:"James Carpenter", url:"https://themoviedb.org/person/56184"}}, {tmdbId:"93177", properties:{bornIn:"Luton - Bedfordshire - England - UK", imdbId:"0743605", born:date('1971-01-01'), name:"Lee Ross", bio:"Lee Ross is an English professional actor, probably best known for his roles as nice guy Kenny Phillips in the classic CITV dramady Press Gang and more recently as violent Owen Turner in the BBC soap opera EastEnders.  He is also known for his work in the drama series Dodger, Bonzo and the Rest, Secrets &amp; Lies and The Catherine Tate Show...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sQNOXntZ677YC9686kUl1NWGP18.jpg", url:"https://themoviedb.org/person/93177"}}, {tmdbId:"20220", properties:{bornIn:"Rockville - Maryland - USA", imdbId:"0711805", born:date('1977-08-30'), name:"Elden Henson", bio:"Elden Henson (born August 30, 1977) is an American actor.  He is best known for playing Fulton Reed in the Mighty Ducks trilogy with Emilio Estevez, and playing Lenny Kagan in The Butterfly Effect. \n\nHenson was born Elden Ryan Ratliff in Rockville, Maryland to a professional photographer mother.  His siblings are actors Garette Ratliff Henson (who appeared in The Mighty Ducks with Elden) and Erick Ratliff (who, like Elden, appeared in Elvis & Me)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6ES7ojO0MmU2nSl8gQ22jzB7ZH0.jpg", url:"https://themoviedb.org/person/20220"}}, {tmdbId:"40271", properties:{imdbId:"0329422", name:"Alexander Goodwin", url:"https://themoviedb.org/person/40271"}}, {tmdbId:"3548", properties:{bornIn:"London, England, UK", imdbId:"0061063", born:date('1926-04-03'), name:"Timothy Bateson", died:date('2009-09-16'), url:"https://themoviedb.org/person/3548"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"21215", properties:{bornIn:"Memphis, Tennessee, USA", imdbId:"0005264", born:date('1966-03-14'), name:"Elise Neal", bio:"Elise Neal was born in Memphis, Tennessee on March 14, 1966.  She graduated from OvertonHigh School for the Creative and Performing Arts in 1984, and attended the University of the Arts in Philadelphia.  Elise left college after two years and moved to New York City where she landed roles in musical theater and found herself traveling the world with various touring companies.  Her experience in musical theater allowed her to easily transition into commercials, eventually bringing her to Los Angeles...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3to5jbcufE5mArk0ufKER6gptzH.jpg", url:"https://themoviedb.org/person/21215"}}, {tmdbId:"31531", properties:{bornIn:"North Plainfield, New Jersey, U.S.", imdbId:"0224007", born:date('1968-09-04'), name:"John DiMaggio", bio:"John William DiMaggio is an American voice actor.  A native of North Plainfield, New Jersey, he is known for his gruff, deep voice and New Jersey accent, which he uses to voice mainly villains and anti-heroes.  He is best known for his voice roles of Bender in Futurama, Dr.  Drakken and Motor Ed in Kim Possible, Marcus Fenix in Gears of War and Gears of War 2, Rico in the Penguins of Madagascar series, and Wakka as well as Kimahri Ronso in Final Fantasy X...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/awmyFwU6ErFJbGFFzhBYZ9AQn8m.jpg", url:"https://themoviedb.org/person/31531"}}, {tmdbId:"59642", properties:{bornIn:"Zurich, Switzerland", imdbId:"0381524", born:date('1968-03-27'), name:"Sandra Hess", bio:"Sandra Hess is a film and television actress, best known for playing Sonya Blade in the feature film Mortal Kombat: Annihilation...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qqXxOm6UzrjxQ4yQ9jhApHw8ZXD.jpg", url:"https://themoviedb.org/person/59642"}}, {tmdbId:"14723", properties:{imdbId:"0507852", born:date('1960-03-17'), name:"Vicki Lewis", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x0LqiqXF53vLYX4O4Chpd1EWw8u.jpg", url:"https://themoviedb.org/person/14723"}}, {tmdbId:"58663", properties:{bornIn:"Rio de Janeiro, Brazil", imdbId:"0073137", born:date('1950-01-20'), name:"Daniel Benzali", bio:"Daniel Benzali (born January 20, 1950) is a Brazilian-American stage, television and film actor. Benzali was a theatre actor before making guest-starring roles on television series such as Star Trek: The Next Generation, The X-Files, NYPD Blue and L. A.  Law.  L. A.  Law creator Steven Bochco was so impressed with Benzali's performance that he cast him in the lead role of his 1995 series Murder One, playing attorney Ted Hoffman.  For this role he was nominated for a Golden Globe award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xa2EcF2Ur0eh3mcmNSpVLFT9dHm.jpg", url:"https://themoviedb.org/person/58663"}}, {tmdbId:"15370", properties:{bornIn:"Deep River, Connecticut, USA", imdbId:"0001543", born:date('1972-11-08'), name:"Gretchen Mol", bio:"From Wikipedia, the free encyclopedia. \n\nGretchen Mol (born November 8, 1972) is an American actress and former model.  She is known for her roles in films like Rounders, Celebrity, 3:10 to Yuma, and The Notorious Bettie Page, where she played the title character.  She was recently seen as Gillian Darmody in HBO's Boardwalk Empire. \n\nDescription above from the Wikipedia article Gretchen Mol, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eAYAvlwJJkdiMSblsWmeRlB8Zo6.jpg", url:"https://themoviedb.org/person/15370"}}, {tmdbId:"11851", properties:{bornIn:"Ambala, Haryana, India", imdbId:"0700875", born:date('1950-10-18'), name:"Om Puri", bio:"Om Puri (1950 -2017) was an Indian actor who has appeared in both mainstream Indian films and art films.  His credits also include appearances in British and American films, including East is East and Charlie Wilson's War, and he was the recipient of  an honorary OBE...", died:date('2017-01-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3xENmjr7CA8ACRViHnjOI5jPQUt.jpg", url:"https://themoviedb.org/person/11851"}}, {tmdbId:"33432", properties:{bornIn:"Bloomington, Indiana, USA", imdbId:"0054397", born:date('1966-07-21'), name:"Arija Bareikis", bio:"Arija Bareikis was born on 21 July 1966 in Bloomington, Indiana.  She attended Bloomington High School South from 1980-1984.  After graduating from Stanford University in 1988, she moved to Southern California to take care of horses for a brief period of time.  Next, Arija moved to New York City first working as a paralegal while contemplating which direction to take her life in.  Originally, she had dreamed of becoming a dancer, which has been reflected in some of her roles on the stage...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tzZ6oGZgCejpu3uiLAMuUpzFv9p.jpg", url:"https://themoviedb.org/person/33432"}}, {tmdbId:"4445", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0061777", born:date('1966-10-28'), name:"Chris Bauer", bio:"An American stage and screen actor.  He is a graduate from the Yale School of Drama, New Haven, Connecticut...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qqOYuwOsodITHQEVBRrYAJ6rEyv.jpg", url:"https://themoviedb.org/person/4445"}}, {tmdbId:"1233", properties:{bornIn:"Fairport - New York - USA", imdbId:"0000450", born:date('1967-07-23'), name:"Philip Seymour Hoffman", bio:"Philip Seymour Hoffman (July 23, 1967 – February 2, 2014) was an American actor, director, and producer.  Best known for his distinctive supporting and character roles–typically lowlifes, eccentrics, bullies, and misfits—Hoffman acted in many films, including leading roles, from the early 1990s until his death in 2014. \n\nDrawn to theater as a teenager, Hoffman studied acting at New York University's Tisch School of the Arts...", died:date('2014-02-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/50rqDkmvXwjwVhFH7q6ph2Rkw7S.jpg", url:"https://themoviedb.org/person/1233"}}, {tmdbId:"164397", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0861361", born:date('1969-11-20'), name:"Callie Thorne", bio:"Calliope \"Callie\" Thorne (born November 20, 1969) is an American actress known for her roles on Homicide: Life on the Street as Detective Laura Ballard, a role she held for 2 seasons and the movie Homicide: The Movie, and also her role on Rescue Me as Sheila Keefe, the 9/11 widow of Jimmy, who was the cousin of the show's main character, Tommy Gavin, played by Denis Leary...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/abTd2C8d3WFVxSZPz52OYyogtRC.jpg", url:"https://themoviedb.org/person/164397"}}, {tmdbId:"164004", properties:{imdbId:"0154914", born:date('1954-12-09'), name:"Ken Cheeseman", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/veFInhz0ITqaRHRAXBjLPn3ZvTl.jpg", url:"https://themoviedb.org/person/164004"}}, {tmdbId:"72179", properties:{imdbId:"0258195", name:"Julie Entwisle", url:"https://themoviedb.org/person/72179"}}, {tmdbId:"72180", properties:{imdbId:"0609040", name:"Michael H. Moss", url:"https://themoviedb.org/person/72180"}}, {tmdbId:"16858", properties:{bornIn:"Honolulu, Hawaii, USA", imdbId:"0334179", born:date('1967-03-16'), name:"Lauren Graham", bio:"Lauren Helen Graham (born March 16, 1967) is an American actress and producer.  She is best known for playing Lorelai Gilmore on the WB Network dramedy series Gilmore Girls and Sarah Braverman on Parenthood...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3leQVZnthAZwngH7HAD6T7qfsVu.jpg", url:"https://themoviedb.org/person/16858"}}, {tmdbId:"37759", properties:{bornIn:"Camden, London, England, UK", imdbId:"0121755", born:date('1964-06-13'), name:"Kathy Burke", bio:"​From Wikipedia, the free encyclopedia.   \n\nKatherine Lucy Bridget Burke (born 13 June 1964; London, England) is an English actress, comedienne, playwright and theatre director.  She best known for her portrayals of Perry in the Harry Enfield film Kevin and Perry Go Large, and of Linda La Hughes in the british sitcom Gimme Gimme Gimme (the latter of which she co-wrote and developed with Jonathan Harvey)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q3z7nP1ryyGuwixShrBmghcmm0F.jpg", url:"https://themoviedb.org/person/37759"}}, {tmdbId:"8397", properties:{bornIn:"Nottingham, Nottinghamshire, England, UK", imdbId:"0187224", born:date('1972-03-24'), name:"Charlie Creed-Miles", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lb8m259EJs7UHz447m3ChyqomvZ.jpg", url:"https://themoviedb.org/person/8397"}}, {tmdbId:"113523", properties:{imdbId:"0607639", born:date('1945-08-01'), name:"Laila Morse", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uYO4GCZWitLJEDG4YiikG3vTPbE.jpg", url:"https://themoviedb.org/person/113523"}}, {tmdbId:"19223", properties:{bornIn:" Vancouver, British Columbia, Canada", imdbId:"0079846", born:date('1977-02-26'), name:"Nathan Bexton", url:"https://themoviedb.org/person/19223"}}, {tmdbId:"20710", properties:{bornIn:"Paris, France", imdbId:"0557859", born:date('1972-05-28'), name:"Chiara Mastroianni", bio:"From Wikipedia, the free encyclopedia. \n\nChiara Charlotte Mastroianni (born 28 May 1972) is an Italian-French actress and singer. \n\nDescription above from the Wikipedia article Chiara Mastroianni, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/42HRbySKXGnUFdGCuWeGvFOZZxu.jpg", url:"https://themoviedb.org/person/20710"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"87335", properties:{bornIn:"Rio de Janeiro, Rio de Janeiro, Brazil", imdbId:"0868639", born:date('1965-09-15'), name:"Fernanda Torres", bio:"Fernanda Pinheiro Monteiro Torres (born September 15, 1965) is a Brazilian movie, stage and television actress and writer.  She was born in Rio de Janeiro, the daughter of Oscar-nominated actress Fernanda Montenegro and actor Fernando Torres. \n\nIn May 1986, she received the Best Actress Award at Cannes Festival for Arnaldo Jabor's \"Eu Sei Que Vou Te Amar\", at the age of 20...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8WNzzomI3kqNShyl3aZnJCHcKYF.jpg", url:"https://themoviedb.org/person/87335"}}, {tmdbId:"87336", properties:{bornIn:"Rio de Janeiro, Rio de Janeiro, Brazil", imdbId:"0136690", born:date('1962-12-31'), name:"Pedro Cardoso", bio:"Pedro Cardoso (born December 31, 1962) is a Brazilian actor, screenwriter, playwright, writer and television director.  He is best known for his role as Agostinho Carrara on the Rede Globo sitcom \"A Grande Família\", for which he was nominated for an International Emmy Award for best actor. \n\nPedro Cardoso was born in Rio de Janeiro, the second of six children in a prominent family.  His father was a well-succeed lawyer, while his grandfather was the president of Banco do Brasil...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cy55yAxCdnz9pnVF6zoigGxVpDU.jpg", url:"https://themoviedb.org/person/87336"}}, {tmdbId:"87337", properties:{bornIn:"Rio de Janeiro, Rio de Janeiro, Brazil", imdbId:"0347300", born:date('1949-11-20'), name:"Luiz Fernando Guimarães", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/105kljL0qnDX6Ojkb6qbb9hAe5B.jpg", url:"https://themoviedb.org/person/87337"}}, {tmdbId:"35862", properties:{bornIn:"Glasgow, Scotland, UK", imdbId:"0378112", born:date('1965-11-19'), name:"Douglas Henshall", bio:"Douglas Henshall was born in Glasgow, Scotland in November 1965.  His mother was a nurse and his father a salesman.  He is the youngest of three children and has two older sisters.  He grew up in Barrhead and attended Barrhead High School.  Whilst at school a friend asked him to join The Scottish Youth Theatre based in Glasgow.  After leaving school, he moved to London to train at Mountview Theatre School.  He returned to Glasgow after training where he joined the 7:84 theater company...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2mjlldFRcvrXZq6pRKV5dSVlzn8.jpg", url:"https://themoviedb.org/person/35862"}}, {tmdbId:"480", properties:{bornIn:"Glasgow, Strathclyde, Scotland, UK", imdbId:"0507207", born:date('1958-11-30'), name:"Gary Lewis", bio:"From Wikipedia, the free encyclopedia\n\nGary Lewis (born Gary Stevenson on 30 November 1958) is a Scottish actor.  He has had parts in Billy Elliot, Gangs of New York, Eragon and Three and Out, as well as a major role in the television docudrama, Supervolcano. \n\nDescription above from the Wikipedia article Gary Lewis (actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/diAALtKgCA2b8KAiqnKEtvRZNil.jpg", url:"https://themoviedb.org/person/480"}}, {tmdbId:"226818", properties:{imdbId:"0829048", name:"Rosemarie Stevenson", url:"https://themoviedb.org/person/226818"}}, {tmdbId:"71770", properties:{bornIn:"Scotland", imdbId:"0566089", name:"Stephen McCole", bio:"From Wikipedia, the free encyclopedia. \n\nStephen McCole is a Scottish actor.  McCole plays the leading role in the television black comedy High Times.  McCole portrays Rab, an unemployed stoner who lives with his family in a bleak high-rise flat in Glasgow.  The series, which received the 2004 BAFTA Scotland Best Drama Award, also features McCole's older brother, Paul.  McCole credits the believability of his role to growing up in similar surroundings in Glasgow's Castlemilk project...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/y3IuUJVnfXwdKILa7O4LmMdQr01.jpg", url:"https://themoviedb.org/person/71770"}}, {tmdbId:"112", properties:{bornIn:"Melbourne, Victoria, Australia", imdbId:"0000949", born:date('1969-05-14'), name:"Cate Blanchett", bio:"Catherine Élise \"Cate\" Blanchett (born 14 May 1969) is an Australian actress and theatre director.  She has won multiple acting awards, most notably two SAGs, two Golden Globe Awards, two BAFTAs, and two Academy  Awards, as well as the Volpi Cup at the 64th Venice International Film  Festival.  Blanchett has earned seven Academy Award nominations between 1998 and 2015...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9V83uemR0ra9Wd9iRXTMlfAQlTB.jpg", url:"https://themoviedb.org/person/112"}}, {tmdbId:"15320", properties:{bornIn:"Bailesti, Romania", imdbId:"0411903", born:date('1951-08-02'), name:"Marcel Iures", bio:"Marcel Iureş (born August 2, 1951) is a Romanian stage and screen actor. \n\nIureş was born 2 August 1951 in Băileşti, Romania and is one of Romania's most acclaimed stage and film actors.  Iureş entered the Institutul de Arta Teatrala si Cinematografica in Bucharest in 1974 and graduated in 1978.  He has acted in films and on stage both in Romania and internationally, as well as playing at least ten roles on Romanian and British television...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7WOHhqlsE6Ae7sSjOqJiyG8CLU0.jpg", url:"https://themoviedb.org/person/15320"}}, {tmdbId:"93225", properties:{bornIn:"Moscow, USSR (Russia)", imdbId:"0051282", born:date('1958-12-06'), name:"Aleksandr Baluev", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3UxeNsjEKSpW8wPAGWChcq9wETj.jpg", url:"https://themoviedb.org/person/93225"}}, {tmdbId:"6326", properties:{bornIn:"Lakeland, Florida, USA", imdbId:"0804361", born:date('1958-01-01'), name:"Pat Skipper", bio:"Pat Skipper was born as William Patterson Skipper.  He is an actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/83kKXFGLe1GDXc1lau63gD5W9uF.jpg", url:"https://themoviedb.org/person/6326"}}, {tmdbId:"12217", properties:{bornIn:"Verona, New Jersey, USA", imdbId:"0001542", born:date('1970-08-23'), name:"Jay Mohr", bio:"Jon Ferguson \"Jay\" Mohr (born August 23, 1970) is an American actor, comedian and radio host...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nk9q6JdcFQMLhaElN4lpUkxuqbd.jpg", url:"https://themoviedb.org/person/12217"}}, {tmdbId:"9289", properties:{bornIn:"Kansas City - Missouri - USA", imdbId:"0557219", born:date('1955-08-16'), name:"Michael Massee", bio:"From Wikipedia, the free encyclopedia\n\nMichael Massee (born 1955) is an American actor perhaps best known for his roles as villains in film and television...", died:date('2016-10-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/swlvVVcDhaJztxr3fgB04YGoX6I.jpg", url:"https://themoviedb.org/person/9289"}}, {tmdbId:"56824", properties:{bornIn:"Kinston, North Carolina, USA", imdbId:"0005326", born:date('1977-07-30'), name:"Jaime Pressly", bio:"From Wikipedia, the free encyclopedia. \n\nJaime Elizabeth Pressly (born July 30, 1977) is an American actress and model.  She is best known for playing Joy Turner on the NBC sitcom My Name Is Earl, for which she was nominated for two Emmy Awards, winning one, for a Golden Globe Award and for a Screen Actors Guild Award.  She has also appeared in films such as Joe Dirt, DOA: Dead or Alive and I Love You, Man...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zH677OefzDCCbzJ3s1Tt4iKn1YX.jpg", url:"https://themoviedb.org/person/56824"}}, {tmdbId:"73733", properties:{imdbId:"0250214", name:"Megan Edwards", url:"https://themoviedb.org/person/73733"}}, {tmdbId:"102729", properties:{bornIn:" Dallas, Texas, USA", imdbId:"0891042", born:date('1973-06-15'), name:"Greg Vaughan", bio:"Greg Vaughan is an actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8yIOWG3IgxNXu9IZu3TQdLSC521.jpg", url:"https://themoviedb.org/person/102729"}}, {tmdbId:"120583", properties:{imdbId:"0103044", name:"Jon Bradford", url:"https://themoviedb.org/person/120583"}}, {tmdbId:"120584", properties:{imdbId:"0472687", name:"Ramsey Krull", url:"https://themoviedb.org/person/120584"}}, {tmdbId:"11616", properties:{bornIn:"Camden Town, London, England, UK ", imdbId:"0931404", born:date('1968-07-26'), name:"Olivia Williams", bio:"Olivia Haigh Williams (born 26 July 1968) is an English film, stage and television actress who has appeared in British and American films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gnL7XGfLiAbhqIjV4jAGIZgySJh.jpg", url:"https://themoviedb.org/person/11616"}}, {tmdbId:"2140", properties:{bornIn:"Cleveland, Ohio, USA", imdbId:"0005321", born:date('1971-06-30'), name:"Monica Potter", bio:"Monica Potter (born; June 30, 1971) is an American film and television actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jCFOlFAjNPMkX9pJF2Au0cquZ6v.jpg", url:"https://themoviedb.org/person/2140"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"7499", properties:{bornIn:"Bossier City, Louisiana, USA", imdbId:"0001467", born:date('1971-12-26'), name:"Jared Leto", bio:"Jared Joseph Leto (born December 26, 1971) is an American actor and musician.  He began his career as a model before studying art, and then later, film and video.  Leto gained fame during his role as Jordan Catalano in My So-Called Life.  He has appeared in films such as Fight Club; Girl, Interrupted; Panic Room; American Psycho; Alexander; Requiem for a Dream; Lord of War, Prefontaine, Mr.  Nobody and Suicide Squad...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ca3x0OfIKbJppZh8S1Alx3GfUZO.jpg", url:"https://themoviedb.org/person/7499"}}, {tmdbId:"58098", properties:{bornIn:"Jackson Heights, Queens, New York City, New York, USA", imdbId:"0001769", born:date('1954-01-12'), name:"Howard Stern", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3ahyCVSafwRP284o0Gwme5VOTQm.jpg", url:"https://themoviedb.org/person/58098"}}, {tmdbId:"176012", properties:{bornIn:"Baltimore, Maryland, USA", imdbId:"0704472", born:date('1952-08-08'), name:"Robin Quivers", url:"https://themoviedb.org/person/176012"}}, {tmdbId:"1980", properties:{bornIn:"Plainfield, New Jersey, U.S.", imdbId:"0005203", born:date('1969-02-08'), name:"Mary McCormack", bio:"From Wikipedia, the free encyclopedia\n\nMary Catherine McCormack (born February 8, 1969) is an American actress. \n\nBest known for her work in television, she has had leading roles as Justine Appleton on Murder One, as Kate Harper on The West Wing and as Mary Shannon on In Plain Sight. \n\nHer film roles include Private Parts (1997), Deep Impact (1998), True Crime (1999), High Heels and Low Lifes (2001), K-PAX (2001), Right at Your Door (2006) and 1408 (2007)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e2brLtFCfgLdOp356bcEyRzQkoJ.jpg", url:"https://themoviedb.org/person/1980"}}, {tmdbId:"1049208", properties:{imdbId:"0635806", born:date('1955-07-09'), name:"Fred Norris", url:"https://themoviedb.org/person/1049208"}}, {tmdbId:"39126", properties:{bornIn:"Chengdu, China", imdbId:"0000499", born:date('1966-10-10'), name:"Bai Ling", bio:"Bai Ling (born October 10, 1966) is a Chinese actress who has since claimed US citizenship. \n\nDescription above from the Wikipedia article Bai Ling, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/PXbFNTUbC3aoLrquCzFaxdF2ev.jpg", url:"https://themoviedb.org/person/39126"}}, {tmdbId:"57748", properties:{bornIn:"Hong Kong", imdbId:"0542677", born:date('1967-08-13'), name:"Byron Mann", bio:"Byron Mann is an actor who has made films in both Hollywood and Asia.  Mann is perhaps best known as Ryu in 1994 film Street Fighter. \n\nDescription above from the Wikipedia article Byron Mann, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4vK3bfhs3PAgIL0iA1AIJcNWewq.jpg", url:"https://themoviedb.org/person/57748"}}, {tmdbId:"16846", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"0005558", born:date('1962-11-14'), name:"Harland Williams", bio:"From Wikipedia, the free encyclopedia.   Harland Williams (born November 14, 1962) is a Canadian actor, comedian, author, artist, musician and radio personality. \n\nDescription above from the Wikipedia article Harland Williams , licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sTYycQ7LXXXXTrM0BJGrnhWGYmM.jpg", url:"https://themoviedb.org/person/16846"}}, {tmdbId:"2167", properties:{bornIn:"Queens, New York, USA", imdbId:"0001689", born:date('1948-02-28'), name:"Mercedes Ruehl", bio:"From Wikipedia, the free encyclopedia\n\nMercedes J.  Ruehl (born February 28, 1948) is an American theater, television and film actor. \n\nDescription above from the Wikipedia article Mercedes Ruehl, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hdqoxwtAAVdu0d7cnuePeNdtVCC.jpg", url:"https://themoviedb.org/person/2167"}}, {tmdbId:"183176", properties:{bornIn:"London, England, UK", imdbId:"0291233", born:date('1962-06-13'), name:"Mark Frankel", died:date('1996-09-24'), url:"https://themoviedb.org/person/183176"}}, {tmdbId:"128719", properties:{bornIn:"Moscow, USSR (Russia)", imdbId:"0631792", born:date('1965-08-23'), name:"Valeriy Nikolaev", bio:"Gifted actor and dancer Valery Nikolaev has choreographed five productions at the Chekhov MKhAT theater.  He choreographed the musical My Fair Lady (Moscow, 2000), as well.  In 1997 he traveled to Hollywood in 1997 to play in Phillip Noyce's The Saint.  Nikolaev graduated from MKhAT, where he studied under the eminent Oleg Tabakov.  It was during his studies with Tabakov that he met his future wife, Irina Apeksimova.  After graduation, Nikolaev performed with the Chekhov MKhAT theater...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/m9IzifirfxKqCF45L6NUBbHUC0g.jpg", url:"https://themoviedb.org/person/128719"}}, {tmdbId:"1748202", properties:{name:"Paulette Patterson", url:"https://themoviedb.org/person/1748202"}}, {tmdbId:"1748203", properties:{name:"Rasila Schroeder", url:"https://themoviedb.org/person/1748203"}}, {tmdbId:"1242291", properties:{imdbId:"0346027", name:"Jackie Guerra", url:"https://themoviedb.org/person/1242291"}}, {tmdbId:"92326", properties:{bornIn:"East Los Angeles, California, USA", imdbId:"0005186", born:date('1965-09-09'), name:"Constance Marie", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kOl8UabxWcNBc4m9BqAF0XFspIS.jpg", url:"https://themoviedb.org/person/92326"}}, {tmdbId:"55725", properties:{bornIn:"\tMarshville, North Carolina, U.S.", imdbId:"0871430", born:date('1959-05-04'), name:"Randy Travis", bio:"From Wikipedia, the free encyclopedia.   Randy Bruce Traywick (born May 4, 1959), better known as Randy Travis, is an American country singer and actor.  Active since 1985, he has recorded more than a dozen studio albums to date, in addition to charting more than thirty singles on the Billboard Hot Country Songs charts, of which sixteen have reached Number One...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bsMAHWzgDwTg1s3VUZZcPyGM8ub.jpg", url:"https://themoviedb.org/person/55725"}}, {tmdbId:"47884", properties:{bornIn:"Miami Beach, Florida, USA", imdbId:"0928720", born:date('1953-08-06'), name:"Valerie Wildman", url:"https://themoviedb.org/person/47884"}}, {tmdbId:"21479", properties:{bornIn:"Memphis, Tennessee, USA", imdbId:"0002989", born:date('1955-06-10'), name:"Andrew Stevens", bio:"An American executive, film producer, director and former actor. \n\nDescription above from the Wikipedia article Andrew Stevens, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6j3lBX2klVHVfZg5fMJfpxEyc7z.jpg", url:"https://themoviedb.org/person/21479"}}, {tmdbId:"185426", properties:{name:"Rowena Cooper", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/A0F1anH5RR2mLVQvC8HqOC5atNF.jpg", url:"https://themoviedb.org/person/185426"}}, {tmdbId:"1380112", properties:{imdbId:"0153147", name:"Scott Charles", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j4EYfkpt4DIofyZUcoaVl4ugd6E.jpg", url:"https://themoviedb.org/person/1380112"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"1380113", properties:{imdbId:"0180960", name:"Antonia Corrigan", url:"https://themoviedb.org/person/1380113"}}, {tmdbId:"1380114", properties:{imdbId:"0027228", name:"Myles Anderson", url:"https://themoviedb.org/person/1380114"}}, {tmdbId:"7866", properties:{bornIn:"New Brunswick, New Jersey", imdbId:"0665123", born:date('1954-06-21'), name:"Robert Pastorelli", bio:"From Wikipedia, the free encyclopedia\n\nRobert Joseph Pastorelli (June 21, 1954 – March 8, 2004) was an American actor.  He had many roles on TV, in movies, and on the stage, including the seven years he played the portly painter Eldin Bernecky on the television series Murphy Brown.  His last role was as an oddball hit man in Be Cool, reuniting him with Michael star John Travolta.  Pastorelli died of a heroin overdose in 2004...", died:date('2004-03-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hIX41Rmw1HLGGYl978aoYHq8VPX.jpg", url:"https://themoviedb.org/person/7866"}}, {tmdbId:"122245", properties:{imdbId:"0352625", born:date('1948-10-11'), name:"Jonathan Hadary", url:"https://themoviedb.org/person/122245"}}, {tmdbId:"39977", properties:{bornIn:"Evansville, Indiana, USA", imdbId:"0005230", born:date('1966-08-30'), name:"Michael Michele", bio:"Michael Michele is an American actress and fashion designer.  She began her career on stage before appearing opposite Wesley Snipes in the 1991 film New Jack City.  In the 1990s, Michele had leading roles in two CBS television series: crime drama Dangerous Curves and prime time soap opera Central Park West...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4FGvh3QdJezRyEGDleUNzTVHy2W.jpg", url:"https://themoviedb.org/person/39977"}}, {tmdbId:"57248", properties:{imdbId:"0281505", name:"Ona Fletcher", url:"https://themoviedb.org/person/57248"}}, {tmdbId:"57249", properties:{imdbId:"0647583", name:"Agga Olsen", url:"https://themoviedb.org/person/57249"}}, {tmdbId:"42643", properties:{imdbId:"0276012", name:"Patrick Field", url:"https://themoviedb.org/person/42643"}}, {tmdbId:"11355", properties:{bornIn:"Liverpool, Merseyside, England, UK", imdbId:"0005042", born:date('1963-06-06'), name:"Jason Isaacs", bio:"Jason Isaacs is an English actor born in Liverpool, who is most well known for his performance as the villain Lucius Malfoy in the Harry Potter films, the brutal Colonel William Tavington in The Patriot and as lifelong criminal Michael Caffee in the internationally-broadcast American television series Brotherhood. \n\nJason Isaacs was born on 6 June 1963, in Liverpool, England, to Jewish parents who later emigrated to Israel...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ekOlEznbxaEfANq4ZXkpj9hVyDX.jpg", url:"https://themoviedb.org/person/11355"}}, {tmdbId:"935", properties:{bornIn:"Elling, Frederikshavn, Denmark", imdbId:"0001567", born:date('1965-07-03'), name:"Connie Nielsen", bio:"Connie Inge-Lise Nielsen (born 3 July 1965) is a Danish actress.  She is known for her roles in the English language films Gladiator, The Devil's Advocate, Basic, and The Ice Harvest. \n\nDescription above from the Wikipedia article Connie Nielsen, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lvQypTfeH2Gn2PTbzq6XkT2PLmn.jpg", url:"https://themoviedb.org/person/935"}}, {tmdbId:"27267", properties:{bornIn:"Cambridge, Massachusetts, USA", imdbId:"0682071", born:date('1965-10-10'), name:"Rebecca Pidgeon", bio:"Rebecca Pidgeon (born October 10, 1965) is a British-American actress and singer-songwriter.  She has maintained a recording career while also acting on stage and in feature films.  She is married to American writer and director David Mamet. \n\nDescription above from the Wikipedia article Rebecca Pidgeon, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c8nJjBpB7zYtdnEY1GNPtUSophZ.jpg", url:"https://themoviedb.org/person/27267"}}, {tmdbId:"64856", properties:{bornIn:"Brooklyn, New York City, New York, USA", imdbId:"0925227", born:date('1967-11-10'), name:"Michael Jai White", bio:"An American actor and professional martial artist who has appeared in numerous films and television series.  He is the first African American to portray a major comic book superhero in a major motion picture, having starred as Al Simmons, the protagonist in the 1997 film Spawn.  White was born in Brooklyn, New York and moved as a teen to Bridgeport, Connecticut, where he graduated from Central High School in 1988...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/YPoHYuzR37wFpPpwEXZYQlhLln.jpg", url:"https://themoviedb.org/person/64856"}}, {tmdbId:"47985", properties:{bornIn:"Finchley, London, England, UK", imdbId:"0001978", born:date('1976-01-21'), name:"Emma Bunton", bio:"Emma Bunton is an English singer, songwriter, actress, and radio and television presenter.  She is well known as a member of the Spice Girls vocal group...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/m7R7U8gb0wnYGhkQaZAbvpnfWT5.jpg", url:"https://themoviedb.org/person/47985"}}, {tmdbId:"47986", properties:{bornIn:"Whiston, Merseyside, England, UK", imdbId:"0004822", born:date('1974-01-12'), name:"Melanie Chisholm", bio:"Melanie Jayne Chisholm, professionally known as Melanie C, is an English singer, songwriter, entrepreneur, actress and television personality.  She is one of the five members of the Spice Girls, in which she was nicknamed Sporty Spice.  Chisholm began her solo career in late 1998 by singing with Canadian rock singer Bryan Adams on the worldwide hit \"When You're Gone\".   Melanie  was born in Whiston, Merseyside, as the only child in the family.  She later moved to Widnes, Cheshire, at a young age...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uXQ1AeV0NA9wKk7K5zbnN4ao7Q6.jpg", url:"https://themoviedb.org/person/47986"}}, {tmdbId:"47987", properties:{bornIn:" Watford, Hertfordshire, England, UK", imdbId:"0001312", born:date('1972-08-06'), name:"Geri Halliwell", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wWh8mqeNVDaJu9EwCUMwM9dNb06.jpg", url:"https://themoviedb.org/person/47987"}}, {tmdbId:"45245", properties:{imdbId:"0005294", born:date('1969-08-19'), name:"Paula Jai Parker", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2SQATlR65aymoq7I3tV8aCXSyOu.jpg", url:"https://themoviedb.org/person/45245"}}, {tmdbId:"26042", properties:{bornIn:"Brooklyn, New York City, New York, USA", imdbId:"0005467", born:date('1927-06-08'), name:"Jerry Stiller", bio:"Gerald Isaac \"Jerry\" Stiller (June 8, 1927 - May 11, 2020) was an American comedian, actor, and author. \n\nHe spent many years in the comedy team Stiller and Meara with his wife Anne Meara.  Stiller and Meara are the parents of actor Ben Stiller (with whom he co-starred in the movies Zoolander, Heavyweights, Hot Pursuit and The Heartbreak Kid), and actress Amy Stiller...", died:date('2020-05-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eGymLHTpIyxKyBjACsNTpEof6y4.jpg", url:"https://themoviedb.org/person/26042"}}, {tmdbId:"1217608", properties:{imdbId:"0030882", name:"Gerald Anthony", url:"https://themoviedb.org/person/1217608"}}, {tmdbId:"77350", properties:{bornIn:" Los Angeles, California, USA", imdbId:"0816669", born:date('1974-04-15'), name:"Douglas Spain", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3vDQ5qX8AGVidWYaAjyCj39d94D.jpg", url:"https://themoviedb.org/person/77350"}}, {tmdbId:"168164", properties:{imdbId:"0276691", name:"Efrain Figueroa", url:"https://themoviedb.org/person/168164"}}] AS row
