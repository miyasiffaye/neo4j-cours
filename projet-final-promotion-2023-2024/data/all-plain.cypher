UNWIND [{tmdbId:"574660", properties:{bornIn:"Belgrado, Serbia", name:"Srđan Spasojević", url:"https://themoviedb.org/person/574660"}}, {tmdbId:"52856", properties:{imdbId:"1862705", name:"Hunter Richards", url:"https://themoviedb.org/person/52856"}}, {tmdbId:"11428", properties:{bornIn:"Georgia, USA", imdbId:"0766402", born:date('1896-03-27'), name:"Paul Satterfield", died:date('1981-08-14'), url:"https://themoviedb.org/person/11428"}}, {tmdbId:"11430", properties:{imdbId:"0359610", name:"Jim Handley", url:"https://themoviedb.org/person/11430"}}, {tmdbId:"11431", properties:{bornIn:"Grand Rapids, Michigan, USA", imdbId:"0066247", born:date('1888-11-26'), name:"Ford Beebe", bio:"From Wikipedia, the free encyclopedia\n\nFord Beebe (November 26, 1888 – November 26, 1978) was a screenwriter and director.  He entered the film business as a writer around 1916 and over the next 60 years wrote and/or directed almost 200 films.  He specialized in B-movies – mostly Westerns – and action serials, working on the \"Buck Rogers\" and \"Flash Gordon\" serials for Universal Pictures...", died:date('1978-11-26'), url:"https://themoviedb.org/person/11431"}}, {tmdbId:"6868", properties:{bornIn:"Schenectady, New York, USA", imdbId:"0122745", born:date('1955-06-18'), name:"Kevin Burns", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xGGMVmWHYzEiThXPWfC0EZI42H8.jpg", url:"https://themoviedb.org/person/6868"}}, {tmdbId:"154705", properties:{bornIn:"Liverpool, Merseyside, England, UK", imdbId:"2752098", born:date('1974-01-01'), name:"Chris Butler", bio:"Chris Butler is an English storyboard artist, writer and director, best known for \"ParaNorman\", which was nominated for the Academy Award for Best Animated Feature...", url:"https://themoviedb.org/person/154705"}}, {tmdbId:"1758307", properties:{name:"Jon Shear", url:"https://themoviedb.org/person/1758307"}}, {tmdbId:"588623", properties:{imdbId:"0444857", name:"Douglas Keeve", url:"https://themoviedb.org/person/588623"}}, {tmdbId:"1533750", properties:{bornIn:"Tiberias - Israel", name:"David Stevens", url:"https://themoviedb.org/person/1533750"}}, {tmdbId:"53212", properties:{imdbId:"0414817", name:"David Jacobson", url:"https://themoviedb.org/person/53212"}}, {tmdbId:"182", properties:{imdbId:"1475971", name:"Mat Whitecross", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kuo7QsaWWrO4CfV5BOPKUsFoKgs.jpg", url:"https://themoviedb.org/person/182"}}, {tmdbId:"589159", properties:{born:date('1970-04-26'), name:"Matt Piedmont", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gTivNdd7ZBOpZ6A5vEN7JxsBfdU.jpg", url:"https://themoviedb.org/person/589159"}}, {tmdbId:"1311595", properties:{imdbId:"1140492", name:"James Mather", url:"https://themoviedb.org/person/1311595"}}, {tmdbId:"12178", properties:{bornIn:"Katano, Osaka, Japan", imdbId:"0645657", born:date('1966-10-13'), name:"Hiroyuki Okiura", bio:"From Wikipedia, the free encyclopedia  Hiroyuki Okiura (沖浦啓之,Okiura Hiroyuki?, born October 13, 1966 in Katano, Osaka Prefecture) is a Japanese animation director and animator working for Production I. G. \n\nOkiura left high school at the age of 16 and goes into the animation industry as a member of the studio Anime R, where he studies under Moriyasu Taniguchi and which Taniguchi superintends...", url:"https://themoviedb.org/person/12178"}}, {tmdbId:"110265", properties:{imdbId:"1390562", name:"T.J. Martin", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zMiV4Iqv7T7QX5msK0yZNz8HwhK.jpg", url:"https://themoviedb.org/person/110265"}}, {tmdbId:"224687", properties:{imdbId:"2418675", name:"Daniel Lindsay", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6Vs0zFWgirfMiNy5aNb4UwuXrHI.jpg", url:"https://themoviedb.org/person/224687"}}, {tmdbId:"2199", properties:{bornIn:"Fort Walton Beach, Florida, USA", imdbId:"0291082", born:date('1960-03-10'), name:"Scott Frank", bio:"From Wikipedia, the free encyclopedia. \n\nScott Frank (born March 10, 1960) is an American screenwriter & director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dtul4M4D5s10fAUji26HHAyWDKC.jpg", url:"https://themoviedb.org/person/2199"}}, {tmdbId:"54273", properties:{bornIn:"Dombasle-sur-Meurthe, Meurthe-et-Moselle, France", imdbId:"1061623", born:date('1962-02-02'), name:"Philippe Claudel", bio:"From Wikipedia, the free encyclopedia\n\nPhilippe Claudel (born 2 February 1962), is a French writer and film director. \n\nClaudel was born in Dombasle-sur-Meurthe, Meurthe-et-Moselle.  In addition to his writing, Claudel is a Professor of Literature at the University of Nancy. \n\nHe directed the 2008 film I've Loved You So Long (Il y a longtemps que je t'aime).  Much admired, it won the 2009 BAFTA for the best film not in English...", url:"https://themoviedb.org/person/54273"}}, {tmdbId:"95510", properties:{bornIn:"Calcutta, West Bengal, India", imdbId:"1223910", born:date('1966-05-21'), name:"Sujoy Ghosh", bio:"Born on 21st May 1966 in Kolkata, Sujoy Ghosh is an Indian film writer, director, actor and producer who is well known for his critically acclaimed movies like Jhankar Beats, Kahaani, Ahalya and Badla. \n\nThe film maker started the trend of multiplex movies in Bollywood with his directorial debut Jhankaar Beats in 2003 which went on to become a superhit...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/toJ3ClvzxSQoxJrYwJQ2sslGwNo.jpg", url:"https://themoviedb.org/person/95510"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"54526", properties:{bornIn:"València, Comunitat Valenciana, Spain", imdbId:"0687042", born:date('1973-08-02'), name:"Paco Plaza", bio:"Paco Plaza is a Spanish film director best known for writing and directing REC and REC 2 with Jaume Balagueró.   He then went on to direct by himself the third installment of the REC series; REC:Genesis which is parallel sequel to the first two films, taking place before, during and after the films while Jaume Balagueró directed the conclusion REC Apocalypse...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7STjUYAbJyr3gMKm9Qvfy5ESpIt.jpg", url:"https://themoviedb.org/person/54526"}}, {tmdbId:"54795", properties:{bornIn:"Hartford, Connecticut, USA", imdbId:"0240627", born:date('1971-06-08'), name:"Troy Duffy", bio:"​From Wikipedia, the free encyclopedia.   \n\nTroy Duffy (born June 8, 1971 in Hartford, Connecticut) is an American director, screenwriter and musician.  He has directed two films, The Boondock Saints, and its sequel, The Boondock Saints II: All Saints Day. \n\nDescription above from the Wikipedia article Troy Duffy , licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/54795"}}, {tmdbId:"844266", properties:{imdbId:"2296528", name:"Jon Erwin", url:"https://themoviedb.org/person/844266"}}, {tmdbId:"909318", properties:{bornIn:"Birmingham, Alabama, USA", imdbId:"3401779", born:date('1978-09-01'), name:"Andrew Erwin", url:"https://themoviedb.org/person/909318"}}, {tmdbId:"12624", properties:{imdbId:"0007158", name:"Niels Mueller", url:"https://themoviedb.org/person/12624"}}, {tmdbId:"930684", properties:{imdbId:"0289800", name:"David France", bio:"David France is an American investigative reporter, non-fiction author, and filmmaker.  He is a contributing editor for New York magazine, a former Newsweek senior editor, and has published in The New Yorker, The New York Times Magazine, GQ, and others.  France is best known for his investigative journalism on LGBT topics...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4dPKHAOu7PLCar5TF5I1MOBUSae.jpg", url:"https://themoviedb.org/person/930684"}}, {tmdbId:"141962", properties:{bornIn:"Georgia, U.S.", imdbId:"1410159", born:date('1988-01-20'), name:"David Bruckner", bio:"David Bruckner is a writer and director, known for V/H/S (2012), The Signal (2007) and SiREN (2016)...", url:"https://themoviedb.org/person/141962"}}, {tmdbId:"1039528", properties:{imdbId:"2301412", name:"Justin Martinez", url:"https://themoviedb.org/person/1039528"}}, {tmdbId:"55146", properties:{bornIn:"New York City, New York, USA", imdbId:"0091575", born:date('1919-11-21'), name:"Paul Bogart", bio:"​From Wikipedia, the free encyclopedia.   \n\nPaul Bogart (born November 21, 1919) is an American television and film director.  He directed episodes of the television series \"Coronet Blue\" in 1967 Get Smart and All In The Family from 1976 to 1979.  Among his films are Marlowe, Skin Game (both starring James Garner) and Class of '44. \n\nIn 1991, he was awarded the French Festival Internationelle Programmes Audiovisuelle at the Cannes Film Festival...", died:date('2012-04-15'), url:"https://themoviedb.org/person/55146"}}, {tmdbId:"10395", properties:{imdbId:"0689343", name:"Jon Poll", bio:"From Wikipedia, the free encyclopedia.   Jon Poll (born 1958) is an American film director, editor and producer, best known for his directorial debut with the 2007 film Charlie Bartlett. \n\nDescription above from the Wikipedia article Jon Poll, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/10395"}}, {tmdbId:"55948", properties:{imdbId:"0000647", name:"Alan Smithee", bio:"From Wikipedia, the free encyclopedia\n\nAlan Smithee (also Allen Smithee) was an official pseudonym used by film directors who wish to disown a project, coined in 1968.  Until its use was formally discontinued in 2000, it was the sole pseudonym used by members of the Directors Guild of America (DGA) when a director dissatisfied with the final product proved to the satisfaction of a guild panel that he or she had not been able to exercise creative control over a film...", url:"https://themoviedb.org/person/55948"}}, {tmdbId:"938681", properties:{imdbId:"2086105", name:"James Duffy", url:"https://themoviedb.org/person/938681"}}, {tmdbId:"1579630", properties:{name:"Will Graham", url:"https://themoviedb.org/person/1579630"}}, {tmdbId:"898", properties:{name:"Mark Goldblatt", bio:"Mark Goldblatt is an American film editor and director.  A graduate of the London Film School, he is a member, and a former president, of the American Cinema Editors, or ACE society, as well as, a member of the Board of Governors of the Academy of Motion Picture Arts and Sciences...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hlqnD5u4M3SP3aqsMKLmQ3A9CdT.jpg", url:"https://themoviedb.org/person/898"}}, {tmdbId:"64077", properties:{imdbId:"0494889", name:"Robert Leacock", url:"https://themoviedb.org/person/64077"}}, {tmdbId:"56453", properties:{imdbId:"1669022", name:"John Bonito", url:"https://themoviedb.org/person/56453"}}, {tmdbId:"56660", properties:{imdbId:"0177170", name:"Lorna Cook", url:"https://themoviedb.org/person/56660"}}, {tmdbId:"44179", properties:{imdbId:"0402365", name:"Bruce Hunt", url:"https://themoviedb.org/person/44179"}}, {tmdbId:"1059118", properties:{imdbId:"2819316", name:"Geoffrey Fletcher", url:"https://themoviedb.org/person/1059118"}}, {tmdbId:"57433", properties:{bornIn:" Goulburn, New South Wales, Australia", imdbId:"0644695", born:date('1931-03-05'), name:"George Ogilvie", bio:"​From Wikipedia, the free encyclopedia. \n\nGeorge Ogilvie (5 March 1931 - 5 April 2020) was an Australian actor and film director.  He was born in Goulburn, New South Wales in 1931. [1] He directed Mad Max Beyond Thunderdome with George Miller. \n\nHe was awarded the A. M.  (Member of the Order of Australia) in the 1983 Queen's Birthday Honours List for his services to the theatre and the performing arts.  His 1988 television feature Captain Johnno was awarded an International Emmy...", died:date('2020-04-05'), url:"https://themoviedb.org/person/57433"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"57521", properties:{imdbId:"0065284", name:"Steve Beck", bio:"From Wikipedia, the free encyclopedia.   Steve Beck is an American movie director. \n\nDescription above from the Wikipedia article Steve Beck , licensed under CC-BY-SA,full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/57521"}}, {tmdbId:"57594", properties:{bornIn:"Kalgoorlie, Western Australia, Australia", imdbId:"0180257", born:date('1941-02-02'), name:"John Cornell", bio:"From Wikipedia, the free encyclopedia\n\nJohn Cornell (born 2 February 1941) is a film producer, actor and businessman. \n\nBorn in Kalgoorlie, Western Australia Cornell once managed Paul Hogan and often appeared alongside Hogan in his popular television show The Paul Hogan Show as Strop, a dim-witted dinkum Aussie surf lifesaver.  He produced and co-wrote the screenplay for Hogan's 1986 film, Crocodile Dundee that became the highest grossing Australian film ever...", url:"https://themoviedb.org/person/57594"}}, {tmdbId:"58338", properties:{imdbId:"0116497", name:"John Bruno", bio:"John Bruno is an American visual effects artist and filmmaker known for his prolific collaborations with director James Cameron on films like Terminator 2: Judgment Day, True Lies, Titanic, Avatar, and The Abyss, for which he won the Academy Award for Best Visual Effects. \n\nHe has also contributed to other blockbuster films including Ghostbusters, Batman Returns, Cliffhanger, X-Men: The Last Stand, and Kingsman: The Secret Service...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iUMzxRhVars9uUTm354MaoxuCng.jpg", url:"https://themoviedb.org/person/58338"}}, {tmdbId:"33316", properties:{imdbId:"0638354", name:"David Nutter", url:"https://themoviedb.org/person/33316"}}, {tmdbId:"57832", properties:{imdbId:"0496752", name:"Daniel Lee", bio:"Daniel Lee Yan-Kong is a Hong Kong film director, screenwriter, assistant director and art director. \n\nDescription above from the Wikipedia article Daniel Lee, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/57832"}}, {tmdbId:"19236", properties:{bornIn:"Landau, Rhineland-Palatinate, West Germany", imdbId:"1491557", born:date('1965-01-01'), name:"Michael Schorr", url:"https://themoviedb.org/person/19236"}}, {tmdbId:"38774", properties:{bornIn:"England, UK", imdbId:"0492979", name:"Ray Lawrence", bio:"From Wikipedia, the free encyclopedia.   Ray Lawrence (born 1948) is an Australian film director.  He was born in England and moved to Australia at age 11.  All his films are made in Australia with predominantly Australian casts.  He has made only three films in two decades, yet they have been some of the most critically acclaimed works in Australian cinema during that time.  He is famous for his insistence on \"complete creative control\", one-take shoots and use of natural light...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/axPJrFwya8IRRrvK4hR1XY6Firb.jpg", url:"https://themoviedb.org/person/38774"}}, {tmdbId:"11201", properties:{bornIn:"Paris, France", imdbId:"0956022", born:date('1934-07-25'), name:"Claude Zidi", bio:"Claude Zidi (born 25 July 1934) is a French film director and screenwriter who is noted for his mainstream burlesque comedies.  Born in Paris, he started as a cameraman and then cinematographer, and made his directorial and screenwriting debut in 1971.  He won the César Award for Best Director for My New Partner, for which he was also nominated for Best Writing. \n\nSource: Article \"Claude Zidi\" from Wikipedia in english, licensed under CC-BY-SA 3. 0...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nPfbkPRWboCwSw352VKPtHUTwaR.jpg", url:"https://themoviedb.org/person/11201"}}, {tmdbId:"933381", properties:{imdbId:"0717266", name:"Frances Reid", bio:"Frances Reid is an American film producer, director and cinematographer, best known for her documentaries \"Straight from the Heart\" and \"Long Night's Journey Into Day\", that were both nominated for an Academy Award...", url:"https://themoviedb.org/person/933381"}}, {tmdbId:"25236", properties:{bornIn:"Hong Kong", imdbId:"0864775", born:date('1955-04-22'), name:"Johnnie To", bio:"From Wikipedia, the free encyclopedia.   Johnnie To Kei-Fung, born 22 April 1955, is a Hong Kong film director and producer.  Popular in his native Hong Kong,  To has also found acclaim overseas.  Intensely prolific, To has made films in a variety of genres, though in the West he is best known for his action and crime movies, which have earned him critical respect  and a cult following...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/auYJNI4JlfPzaYzHfzrrFXxGPHf.jpg", url:"https://themoviedb.org/person/25236"}}, {tmdbId:"58052", properties:{bornIn:"Hong Kong", imdbId:"0906413", born:date('1962-01-01'), name:"Wai Ka-Fai", bio:"From Wikipedia, the free encyclopedia.  Wai Ka-Fai is a Hong Kong writer, filmmaker, producer and former TV director and producer. \n\nWai is best known for his frequent collaborations with Johnnie To, another former TV turned film director and producer.  In 1996, they formed Milkyway Image, which is now one of the most successful independent film studios in Hong Kong.  The films that the two have made together as directors and producers include Needing You. . ...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iuk9eYNkeIzbHdVdZlaGL1tLxS2.jpg", url:"https://themoviedb.org/person/58052"}}, {tmdbId:"58159", properties:{bornIn:"Tokyo", imdbId:"0727336", born:date('1941-01-22'), name:"Rintaro", bio:"Rintaro, pseudonym of Shigeyuki Hayashi, is a well-known anime director.  He works frequently with the animation studio Madhouse (which he co-founded), though he is a freelance director not employed directly by any one studio.  He is a founding member of the Japanese Animation Creators Association (JAniCA) labor group...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sXomLvqGT7SDHtu7j62R0l1AL2D.jpg", url:"https://themoviedb.org/person/58159"}}, {tmdbId:"35155", properties:{imdbId:"0336726", name:"John Gray", url:"https://themoviedb.org/person/35155"}}, {tmdbId:"58269", properties:{imdbId:"0597026", name:"Jesper Møller", url:"https://themoviedb.org/person/58269"}}, {tmdbId:"58403", properties:{imdbId:"0604688", name:"Glen Morgan", url:"https://themoviedb.org/person/58403"}}, {tmdbId:"40905", properties:{bornIn:" Vienna, Austria", imdbId:"0514226", born:date('1956-06-28'), name:"Niki List", died:date('2009-04-02'), url:"https://themoviedb.org/person/40905"}}, {tmdbId:"8108", properties:{imdbId:"0912892", name:"John Warren", bio:"American screenwriter, producer and director, born in 1953...", url:"https://themoviedb.org/person/8108"}}, {tmdbId:"1017209", properties:{bornIn:"Barcellona, Spagna", imdbId:"2165066", born:date('1984-01-01'), name:"Carles Torrens", url:"https://themoviedb.org/person/1017209"}}, {tmdbId:"59997", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0519434", born:date('1953-01-07'), name:"Robert Longo", url:"https://themoviedb.org/person/59997"}}, {tmdbId:"38527", properties:{bornIn:"Québec City, Québec, Canada", imdbId:"0503215", born:date('1957-12-12'), name:"Robert Lepage", bio:"Robert Lepage, CC OQ is a Québécois playwright, actor, film director, and stage director, one of Canada's most honoured theatre artists...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cUY9nwa2SDMtHIMqaM9FM6O3l5B.jpg", url:"https://themoviedb.org/person/38527"}}] AS row
