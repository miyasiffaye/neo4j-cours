UNWIND [{tmdbId:"160042", properties:{imdbId:"0182471", born:date('1952-03-22'), name:"Bob Costas", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zSnK9Q3k81m0O8SSH9rirv6D2fm.jpg", url:"https://themoviedb.org/person/160042"}}, {tmdbId:"221944", properties:{bornIn:"Milbridge - Maine - USA", imdbId:"1051221", born:date('1978-10-01'), name:"Katie Aselton", bio:"Kathryn \"Katie\" Aselton is an American film director, producer, and actress from Milbridge, Maine.  She is married to her co-star on The League, Mark Duplass...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4kFwHnj9VpVpNoMpD0xduerFKS.jpg", url:"https://themoviedb.org/person/221944"}}, {tmdbId:"19442", properties:{imdbId:"0100357", born:date('1939-03-08'), name:"Jim Bouton", url:"https://themoviedb.org/person/19442"}}, {tmdbId:"141873", properties:{bornIn:"Gunsan, Corea del Sud", imdbId:"1117033", born:date('1979-11-26'), name:"Seo Won", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/czZx9Z6XsBNo2rafmeIdxXZfdgw.jpg", url:"https://themoviedb.org/person/141873"}}, {tmdbId:"547971", properties:{bornIn:"Corea del Sud", imdbId:"0453761", born:date('1972-01-12'), name:"Kim Yun-tae", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wXj0D0xqGCUxMT83FbadGYwePYn.jpg", url:"https://themoviedb.org/person/547971"}}, {tmdbId:"121148", properties:{bornIn:"Seoul, South Korea", imdbId:"0661867", born:date('1966-03-22'), name:"Park Joong-hoon", bio:"​Park Joong-hoon is a South Korean film and television actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5KRiD9owMWAi74n5YZiAFF6H1ds.jpg", url:"https://themoviedb.org/person/121148"}}, {tmdbId:"133665", properties:{bornIn:"Los Angeles, California, USA ", imdbId:"0148689", born:date('1981-12-11'), name:"Dano Cerny", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zVHHJafd8HM0XH0DCk5AUiWQAC4.jpg", url:"https://themoviedb.org/person/133665"}}, {tmdbId:"1133527", properties:{bornIn:"Lourenço Marques, Portuguese Mozambique", imdbId:"1550573", born:date('1973-12-16'), name:"Mariza", bio:"Mariza (Portuguese pronunciation: [mɐˈɾizɐ]),[1][2] born Marisa dos Reis Nunes (16 December 1973, Lourenço Marques, Portuguese Mozambique) is a popular fado singer.  Mariza was born to a Portuguese father and a mother of partial African heritage. [3] At age three, her family moved to Metropolitan Portugal, and she was raised in Lisbon's historic quarters of Mouraria and Alfama.  While very young she began singing in a wide variety of musical styles, including gospel, soul and jazz...", url:"https://themoviedb.org/person/1133527"}}, {tmdbId:"1117838", properties:{bornIn:"Rosario, Argentina", imdbId:"0346466", born:date('1928-06-14'), name:"Ernesto 'Che' Guevara", died:date('1967-10-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gW72zmKXNUoFvEpK87V0SJ40TWq.jpg", url:"https://themoviedb.org/person/1117838"}}, {tmdbId:"1865991", properties:{name:"Jim Boeheim", url:"https://themoviedb.org/person/1865991"}}, {tmdbId:"1358962", properties:{name:"John Thompson", url:"https://themoviedb.org/person/1358962"}}, {tmdbId:"2012473", properties:{name:"Lou Carnesecca", url:"https://themoviedb.org/person/2012473"}}, {tmdbId:"27461", properties:{bornIn:"Caballito, Buenos Aires, Argentina", imdbId:"0893638", born:date('1975-02-23'), name:"Natalia Verbeke", bio:"Natalia Verbeke Leiva, (born February 23, 1975 in the neighborhood of Caballito, Buenos Aires, Argentina) is a Spanish actress, of Argentine origin. \n\nDescription above from the Wikipedia article Natalia Verbeke, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/r7odaYkjpjvoMQ42ougvZldYQn1.jpg", url:"https://themoviedb.org/person/27461"}}, {tmdbId:"148443", properties:{imdbId:"0034006", name:"Murielle Arden", url:"https://themoviedb.org/person/148443"}}, {tmdbId:"1003386", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0427389", born:date('1983-04-29'), name:"Sam Jones", bio:"Samuel L.  Jones III (born April 29, 1983) is an American actor.  He is best known for playing Pete Ross on the first three seasons of the Superman television series Smallville, Willie Worsley in the 2006 film Glory Road, Craig Shilo on Blue Mountain State, Chaz Pratt on ER and Billy Marsh in the 2006 film Home of the Brave...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cVZID4xSO9HqgE0Js0F86e8udzH.jpg", url:"https://themoviedb.org/person/1003386"}}, {tmdbId:"1436512", properties:{imdbId:"3898023", name:"Rich Graff", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nVac8YhokONsXdLNYk9pwGj0npm.jpg", url:"https://themoviedb.org/person/1436512"}}, {tmdbId:"40952", properties:{bornIn:"Hillbrow, Johannesburg, Union of South Africa", imdbId:"0416228", born:date('1913-05-08'), name:"Sid James", bio:"Sid James (born Solomon Joel Cohen; 8 May 1913 – 26 April 1976) was a South African-born English-based actor and comedian.  He made his name as Tony Hancock's co-star in Hancock's Half Hour and also starred in the popular Carry On films.  He was known for his trademark \"dirty laugh\" and lascivious persona.  Bruce Forsyth summed up his talent thus: \"He was a natural at being natural...", died:date('1976-04-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cjldtyJMt8J0nuWwVIuBSn0o70w.jpg", url:"https://themoviedb.org/person/40952"}}, {tmdbId:"201457", properties:{bornIn:"Barnet, Hertfordshire, England, UK", imdbId:"0656704", born:date('1948-03-05'), name:"Elaine Paige", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/heaENd1SA1cok5AkQdIEsjw9R9J.jpg", url:"https://themoviedb.org/person/201457"}}, {tmdbId:"137273", properties:{name:"Rosemarie Ford", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fq6zY237QCUMcRaY8zR7TA2db0M.jpg", url:"https://themoviedb.org/person/137273"}}, {tmdbId:"137278", properties:{bornIn:"London, England, UK", imdbId:"0057672", born:date('1964-12-24'), name:"James Barron", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xFI8KUu1aQ6sUI98bgkmgDD1P8U.jpg", url:"https://themoviedb.org/person/137278"}}] AS row
