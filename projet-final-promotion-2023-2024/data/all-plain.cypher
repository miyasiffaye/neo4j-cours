UNWIND [{tmdbId:"11890", properties:{bornIn:"USA", imdbId:"0669868", name:"Chris Pedersen", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qf1P6TXDEqEA2eHsoGrcHa8Spkr.jpg", url:"https://themoviedb.org/person/11890"}}, {tmdbId:"99485", properties:{imdbId:"0185417", name:"Bill Coyne", url:"https://themoviedb.org/person/99485"}}, {tmdbId:"99486", properties:{imdbId:"0165531", name:"Jennifer Clay", url:"https://themoviedb.org/person/99486"}}, {tmdbId:"99487", properties:{imdbId:"0639850", name:"Timothy O'Brien", url:"https://themoviedb.org/person/99487"}}, {tmdbId:"12516", properties:{bornIn:"Morristown, New Jersey, USA", imdbId:"0001373", born:date('1945-04-02'), name:"Linda Hunt", bio:"​Linda Hunt (born April 2, 1945) is an American film, stage and television actress.  She is perhaps best known for her Academy Award-winning role in 1982's The Year of Living Dangerously.  She is currently portraying the role of Henrietta \"Hetty\" Lange, Office of Special Projects Operations Manager on the CBS Television series NCIS: Los Angeles...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/36BvWt0eyCDJbzEL4LOiyCHIPGH.jpg", url:"https://themoviedb.org/person/12516"}}, {tmdbId:"25503", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0001597", born:date('1952-11-30'), name:"Mandy Patinkin", bio:"Mandy Patinkin is an American stage, film and television actor and tenor vocalist.  Patinkin is a noted interpreter of the music of Stephen Sondheim and is known for his work in musical theatre, originating iconic roles such as Georges Seurat in Sunday in the Park with George, Archibald Craven in The Secret Garden and Burrs in The Wild Party.  He has also appeared in television series' such as Chicago Hope, Dead Like Me, the first two seasons of Criminal Minds, and Homeland...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1PeZ6roZvkcoyZZbvoSIWTgGe3a.jpg", url:"https://themoviedb.org/person/25503"}}, {tmdbId:"28027", properties:{imdbId:"0394632", born:date('1929-05-26'), name:"Patrick Horgan", url:"https://themoviedb.org/person/28027"}}, {tmdbId:"67857", properties:{imdbId:"0118796", name:"John Buckwalter", url:"https://themoviedb.org/person/67857"}}, {tmdbId:"6913", properties:{bornIn:"New York City, New York, USA", imdbId:"0000289", born:date('1954-04-16'), name:"Ellen Barkin", bio:"Ellen Rona Barkin (born April 16, 1954) is an American actress. \n\nDescription above from the Wikipedia article Ellen Barkin, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/k8L89k5xEk7hN3TUKkEFUcPzSxh.jpg", url:"https://themoviedb.org/person/6913"}}, {tmdbId:"73234", properties:{bornIn:"Gary, Indiana", imdbId:"0440090", born:date('1935-07-15'), name:"Alex Karras", bio:"​From Wikipedia, the free encyclopedia.   \n\nAlexander George \"Alex\" Karras (born July 15, 1935), nicknamed \"The Mad Duck\", is a former football player, professional wrestler, and actor who is best known for playing with the Detroit Lions from 1958–1962 and 1964-1970.  In addition, he starred on the ABC sitcom Webster, alongside real-life wife Susan Clark, as the titular character's adoptive father...", died:date('2012-10-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hLnBrpfcRIi4wXazuVsmiMPNdfS.jpg", url:"https://themoviedb.org/person/73234"}}, {tmdbId:"21618", properties:{bornIn:" London, England, UK", imdbId:"0005481", born:date('1950-09-30'), name:"Victoria Tennant", bio:"Victoria Tennant (born 30 September 1950) is an English film and television actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hCFRv6zSIW4YooWv6B9FfnhcN8h.jpg", url:"https://themoviedb.org/person/21618"}}, {tmdbId:"1164", properties:{bornIn:"Pittsburgh, Pennsylvania, USA", imdbId:"0000719", born:date('1939-10-24'), name:"F. Murray Abraham", bio:"From Wikipedia, the free encyclopedia. \n\nFahrid Murray Abraham (born October 24, 1939) is an American actor.  He became known during the 1980s after winning the Academy Award for Best Actor for his role as Antonio Salieri in Amadeus.  He has appeared in many roles, both leading and supporting, in films such as All the President's Men and Scarface.  He is also known for his television and theatre work...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p2RYVGdrcP0m70BkkiKcwyrDeim.jpg", url:"https://themoviedb.org/person/1164"}}, {tmdbId:"4002", properties:{bornIn:"Guernsey, Channel Islands, UK", imdbId:"0234541", born:date('1923-05-26'), name:"Roy Dotrice", bio:"From Wikipedia, the free encyclopedia. \n\nRoy Dotrice, OBE (26 May 1923 – 16 October 2017) was a British actor known for his Tony Award-winning Broadway performance in the revival of A Moon for the Misbegotten. \n\nDescription above from the Wikipedia article Roy Dotrice, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2017-10-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tScwrFSNHYAklj2DQbRQ64qDvLs.jpg", url:"https://themoviedb.org/person/4002"}}, {tmdbId:"72055", properties:{bornIn:"San Diego, California, USA", imdbId:"0000478", born:date('1961-08-05'), name:"Tawny Kitaen", bio:"From Wikipedia, the free encyclopedia. \n\nJulie \"Tawny\" Kitaen (born August 5, 1961) is an American actress and media personality.  She became famous in the 1980s for appearing in several hard rock videos for the band Whitesnake, including the hit \"Here I Go Again\".  Kitaen was married to Whitesnake lead singer David Coverdale from 1989–1991.  She had recurring parts on multiple television series such as Hercules: The Legendary Journeys and co-hosted America's Funniest People from 1992–1994...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nEv9ccClwFOPdEHNI8ZTUUUHF4z.jpg", url:"https://themoviedb.org/person/72055"}}, {tmdbId:"36039", properties:{bornIn:"Chicago - Illinois - USA", imdbId:"0957460", born:date('1954-03-04'), name:"Adrian Zmed", bio:"Adrian Zmed was born in Chicago on March 14, 1954, the son of George Zmed, a Romanian Orthodox priest, and his wife, Persida.  He is an actor, known for T. J.  Hooker (1982), Bachelor Party (1984) and  Grease 2 (1982).  He has been married to Lyssa Lynne since October 5,  2012.  He was previously married to Barbara Fitzner and Susan Wood. \n\nZmed graduated from Lane Tech High School in Chicago...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9XBwF5bwZaMG6SbFQyrds0Y1ayK.jpg", url:"https://themoviedb.org/person/36039"}}, {tmdbId:"72056", properties:{bornIn:"Roanoke Rapids, North Carolina, U.S.", imdbId:"0342732", born:date('1928-04-01'), name:"George Grizzard", bio:"From Wikipedia, the free encyclopedia. \n\nGeorge Cooper Grizzard, Jr.  (April 1, 1928 – October 2, 2007) was an American actor of film and stage.  He appeared in more than 40 films, dozens of television programs and a number of Broadway plays. \n\nDescription above from the Wikipedia article George Grizzard, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2007-10-02'), url:"https://themoviedb.org/person/72056"}}, {tmdbId:"778", properties:{bornIn:"Springfield, Massachusetts, USA", imdbId:"0039226", born:date('1948-02-22'), name:"John Ashton", bio:"John Ashton (born February 22, 1948) is an American actor born in Springfield, Massachusetts, and graduate of the University of Southern California School of Theatre. \n\nJohn Ashton attended Enfield High School in Enfield, Connecticut. \n\nAshton has starred in several productions including MAS*H and Midnight Run...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8TzYptb6pPxZJXfrJIu0UoZTNkX.jpg", url:"https://themoviedb.org/person/778"}}, {tmdbId:"779", properties:{bornIn:"Dhahran, Saudi Arabia", imdbId:"0002060", born:date('1956-05-05'), name:"Lisa Eilbacher", bio:"Lisa Eilbacher (5' 7\" | 1. 7 m) was born on May 5, 1956 (Taurus) in Dharan, Saudi Arabia as Lisa Marie Eilbacher and is an American television and motion picture actress.  Lisa is the daughter of an oil company executive.  One of five children, in which she is the older sister of Cindy Eilbacher and Bobby Eilbacher.  Lisa spent her most formative years in Paris then moved to Beverly Hills, California with her family,  when she was seven...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tYbOrII1dXzNauGSbMlAZRyRUWT.jpg", url:"https://themoviedb.org/person/779"}}, {tmdbId:"68897", properties:{bornIn:"St. Louis, Missouri, U.S.", imdbId:"0363157", born:date('1932-09-07'), name:"John Harkins", died:date('1999-03-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4dn1qyY6a8Vrw1a0u7yTb8E4h1b.jpg", url:"https://themoviedb.org/person/68897"}}, {tmdbId:"83170", properties:{bornIn:"Suffern, New York, USA", imdbId:"0001320", born:date('1939-08-22'), name:"Valerie Harper", bio:"From Wikipedia, the free encyclopedia. \n\nValerie Harper (August 22, 1939-August 30, 2019) was an American actress, known for her role as Rhoda Morgenstern on the 1970s television show The Mary Tyler Moore Show, and for her starring roles on the sitcoms Rhoda (a spin-off of The Mary Tyler Moore Show) and Valerie. \n\nDescription above from the Wikipedia article Valerie Harper, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2019-08-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d5zCO8dOI92kVqTlFeKPukRQMNE.jpg", url:"https://themoviedb.org/person/83170"}}] AS row
