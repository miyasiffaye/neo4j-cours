UNWIND [{tmdbId:"135899", properties:{imdbId:"0008416", name:"Hossein Abedini", url:"https://themoviedb.org/person/135899"}}, {tmdbId:"135900", properties:{imdbId:"0046969", name:"Zahra Bahrami", url:"https://themoviedb.org/person/135900"}}, {tmdbId:"548125", properties:{imdbId:"0031655", name:"Christine Anu", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mZ0C11IokZbJYLJhoAx97TToBXi.jpg", url:"https://themoviedb.org/person/548125"}}, {tmdbId:"928579", properties:{bornIn:"Everett, Washington, USA", imdbId:"1060253", born:date('1959-12-31'), name:"Andy Arness", bio:"Andy Arness was born on December 31, 1959 in Everett, Washington, USA as Andrew Aaron Arness.  He is known for his work on The Matrix Reloaded (2003), Chance (2016) and Valley of the Heart's Delight (2006).  He has been married to Doreen Brown since 2000.  They have one child.  He was previously married to Teddy Baxter and Debbie Merrill...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4QoytkR9sdqQ9H4r0PiFdvXkTm9.jpg", url:"https://themoviedb.org/person/928579"}}, {tmdbId:"30737", properties:{bornIn:"Vizovice, Czech Republic", imdbId:"0689990", born:date('1949-07-31'), name:"Bolek Polívka", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/191WzkKTrEHHTPEbhqFvurkk1py.jpg", url:"https://themoviedb.org/person/30737"}}, {tmdbId:"1182313", properties:{bornIn:"Žilina, Československo", imdbId:"0803034", born:date('1960-06-30'), name:"Anna Sisková", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/E6v0pFGFjj0vMVZ0UWpbSDmQ6H.jpg", url:"https://themoviedb.org/person/1182313"}}, {tmdbId:"279944", properties:{imdbId:"0440815", name:"Csongor Kassai", url:"https://themoviedb.org/person/279944"}}, {tmdbId:"135680", properties:{imdbId:"0244612", born:date('1961-04-30'), name:"Jaroslav Dusek", bio:"Jaroslav Dušek je v první řadě improvizátor, divadelní herec a režisér, dále pak filmový herec, moderátor, libretista a scénárista.  Po gymnáziu učil autorské herectví a jevištní improvizaci na Lidové konzervatoři, dva roky byl asistentem Ivana Vyskočila, který svým pojetím autorského divadla Duška výrazně ovlivnil.  Po roce 1989 působil na Konzervatoři J.  Ježka.  Učí na Famu, příležitostně na Jamu a Damu (mezi jeho žáky patřili například Ester Kočičková nebo Jiří Macháček)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/m7Nt4znnXy9nelRHQMIJ0CIIoD0.jpg", url:"https://themoviedb.org/person/135680"}}, {tmdbId:"10486", properties:{bornIn:"Oklahoma City, Oklahoma, USA", imdbId:"0743304", born:date('1942-10-26'), name:"Chelcie Ross", bio:"Chelcie Claude Ross (born June 20, 1942) is an American character actor.  He served in Vietnam as an officer in the United States Air Force, and earned an MFA from the Dallas Theater Center...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yerwaFvmmtkZSfT68Bhbn1U6I5P.jpg", url:"https://themoviedb.org/person/10486"}}, {tmdbId:"71266", properties:{bornIn:"Joliet, Illinois, USA", imdbId:"0858106", born:date('1948-12-22'), name:"Lynne Thigpen", bio:"Lynne Thigpen (December 22, 1948 – March 12, 2003) was an American stage and television actress...", died:date('2003-03-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4ZKG11kZWlrbJccTnXeezL3vdJB.jpg", url:"https://themoviedb.org/person/71266"}}, {tmdbId:"1514686", properties:{imdbId:"0443713", name:"Ayelet Kaznelson", url:"https://themoviedb.org/person/1514686"}}, {tmdbId:"33659", properties:{imdbId:"0385682", name:"John Hines", url:"https://themoviedb.org/person/33659"}}, {tmdbId:"1215378", properties:{bornIn:"Winston-Salem, North Carolina, USA", imdbId:"0087373", born:date('1968-02-01'), name:"John Harrington Bland", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eAYcvoeRSPD7nZZY4Y4izWhnwW2.jpg", url:"https://themoviedb.org/person/1215378"}}, {tmdbId:"4994", properties:{bornIn:"Kurume, Fukuoka, Kyushu, Japan", imdbId:"0410903", born:date('1956-07-20'), name:"Ryo Ishibashi", bio:"​From Wikipedia, the free encyclopedia.   \n\nRyo Ishibashi (born July 20, 1956) is a Japanese actor and international celebrity.  He is known around the world for his roles in the classic Japanese Horror films Suicide Club and Audition.  He is also recognized in America for his role as Nakagawa in The Grudge and The Grudge 2. \n\nIshibashi was born in Kurume, Fukuoka, Kyūshū, Japan.  He started his career by starting his own band called the ARB (Alexander Ragtime Band) in 1977...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ntzIO0QqNS8xKYwYnYhE3m3Dc5d.jpg", url:"https://themoviedb.org/person/4994"}}, {tmdbId:"57455", properties:{bornIn:"Fukuoka, Japan", imdbId:"0793402", born:date('1976-02-03'), name:"Eihi Shiina", bio:"​From Wikipedia, the free encyclopedia.   \n\nEihi Shiina (born February 3, 1976) is a fashion model and actress from Fukuoka, Japan.  She got her first big break in 1995, working for Benetton, after which she represented Japan at the global Elite Model Look '95.  More magazine work followed. \n\nShiina made her film debut in 1999 with Dog-Food.  She also published a book of photographs and poems, entitled No Filter, Only Eyes, that same year...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lvYA0osYgmCwluaURsnk0TE8vfs.jpg", url:"https://themoviedb.org/person/57455"}}, {tmdbId:"68111", properties:{bornIn:"Osaka, Japan", imdbId:"0768017", born:date('1982-08-24'), name:"Tetsu Sawaki", bio:"Tetsu Sawaki (born August 24, 1982) is a Japanese actor.  Sawaki was born in Osaka, Japan. \n\nDescription above from the Wikipedia article Tetsu Sawaki, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/68111"}}, {tmdbId:"2541", properties:{bornIn:"Kumamoto, Japan", imdbId:"0475165", born:date('1955-11-16'), name:"Jun Kunimura", bio:"Jun Kunimura (國村 隼 Kunimura Jun, born November 16, 1955 in Kumamoto, Japan) is a Japanese actor known for his role as boss Tanaka in Kill Bill Vol...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9CUcPGUbHXOScAOUI6r22OfHfN6.jpg", url:"https://themoviedb.org/person/2541"}}, {tmdbId:"225968", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0454955", born:date('1974-08-05'), name:"Kent King", url:"https://themoviedb.org/person/225968"}}, {tmdbId:"177205", properties:{bornIn:"New York City, New York USA", imdbId:"0345336", born:date('1939-01-01'), name:"Charles Guardino", url:"https://themoviedb.org/person/177205"}}, {tmdbId:"165275", properties:{imdbId:"0190189", name:"Shireen Crutchfield", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/y28hfRjzSI2UJ8WjLNT3y1oFsae.jpg", url:"https://themoviedb.org/person/165275"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"58674", properties:{bornIn:"Urasoe, Okinawa Prefecture, Japan", imdbId:"0620090", born:date('1979-10-30'), name:"Yukie Nakama", bio:"​From Wikipedia, the free encyclopedia.   \n\nYukie Nakama (born October 30, 1979) is a Japanese actress, singer and former idol.  She was born in Okinawa, Japan, in a fisherman's family, the youngest of five siblings.  At the start of her career she was a gravure idol and singer (her debut single \"Moonlight to Daybreak\" was released in 1996), and appeared in bit roles until her career breakthrough playing Sadako in \"Ring 0: Birthday (2000)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cOT8d538ap3ad5aeX2LpDZOIoXG.jpg", url:"https://themoviedb.org/person/58674"}}, {tmdbId:"58675", properties:{imdbId:"0848948", name:"Seiichi Tanabe", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fbIhQj2hkDHt94kqiWlp8pDu6Yl.jpg", url:"https://themoviedb.org/person/58675"}}, {tmdbId:"27788", properties:{bornIn:"Sammu, Chiba, Japan", imdbId:"0039591", born:date('1978-06-17'), name:"Kumiko Asô", bio:"Kumiko Asou, born Kumiko Hiramaru, is a Japanese actress and model.  She has also appeared in several commercials in Japan...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nDgHiKqI7VdcbHMoabnQgbcI84b.jpg", url:"https://themoviedb.org/person/27788"}}, {tmdbId:"137517", properties:{imdbId:"0906711", name:"Takeshi Wakamatsu", url:"https://themoviedb.org/person/137517"}}, {tmdbId:"6163", properties:{bornIn:"Santa Monica, California, USA", imdbId:"0004965", born:date('1970-10-25'), name:"Adam Goldberg", bio:"Adam Charles Goldberg (born October 25, 1970) is an American actor, director, and producer. \n\nDescription above from the Wikipedia article Adam Charles, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hiqnMk1ojxuboipcsLzNbf0cloK.jpg", url:"https://themoviedb.org/person/6163"}}, {tmdbId:"186018", properties:{imdbId:"0254478", name:"Jack Elliott", url:"https://themoviedb.org/person/186018"}}, {tmdbId:"1019", properties:{bornIn:"Copenhagen, Denmark", imdbId:"0586568", born:date('1965-11-22'), name:"Mads Mikkelsen", bio:"Mikkelsen was born in the Østerbro area of Copenhagen, Denmark.  He is the youngest son of Bente Christiansen and Henning Mikkelsen, a cab driver.  He is the brother of actor Lars Mikkelsen.  After attending Århus Theatre School, he made his film debut in the movie Pusher.  He has starred in popular Danish movies such as Flickering Lights (Danish: Blinkende Lygter), The Green Butchers (Danish: De Grønne Slagtere), Valhalla Rising, his film debut Pusher, and Pusher II...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oQBzMxGTMOIVrFGUqHnWK5lB61G.jpg", url:"https://themoviedb.org/person/1019"}}, {tmdbId:"79630", properties:{bornIn:"London, England, UK", imdbId:"0527997", born:date('1956-01-31'), name:"John Lydon", bio:"John Joseph Lydon (born 31 January 1956), also known by his stage name Johnny Rotten, is an English singer, songwriter and musician.  He is best known as the lead singer of the late-1970s British punk band the Sex Pistols, which lasted from 1975 until 1978, and again for various revivals during the 1990s and 2000s.  He is also the lead singer of post-punk band Public Image Ltd (PiL), which he founded and fronted from 1978 until 1993, and again since 2009...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gjtG5yogTGqgOaDna4egF9pA6uL.jpg", url:"https://themoviedb.org/person/79630"}}, {tmdbId:"79652", properties:{imdbId:"0559149", name:"Glen Matlock", url:"https://themoviedb.org/person/79652"}}, {tmdbId:"82587", properties:{bornIn:"Welch - West Virginia - USA", imdbId:"0367724", born:date('1957-01-17'), name:"Steve Harvey", bio:"Broderick Steven \"Steve\" Harvey (born January 17, 1957) is an American actor, comedian, entertainer, television &amp; radio personality and best-selling author.  He is best known as the star of the WB sitcom The Steve Harvey Show, and as one of the four comedians featured in the Spike Lee film The Original Kings of Comedy.  Currently, he is the host of the nationally syndicated radio program The Steve Harvey Morning Show, and the current host of the television game show Family Feud...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/m9eYD66VtHPxgrXGhHw7gtugftE.jpg", url:"https://themoviedb.org/person/82587"}}, {tmdbId:"85931", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0401018", born:date('1963-03-06'), name:"D.L. Hughley", bio:"Darryl Lynn \"D.  L. \" Hughley is an American actor and stand-up comedian.  He is perhaps best known as the star of the ABC/UPN sitcom The Hughleys, and as one of the four comedians featured in the Spike Lee film The Original Kings of Comedy.  Additionally, he has been the host of CNN's D.  L.  Hughley Breaks the News, a correspondent for The Jay Leno Show on NBC, and a local radio personality in New York City...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xhOo0FVdzYt5mnIrZlITKCEtbW9.jpg", url:"https://themoviedb.org/person/85931"}}, {tmdbId:"1897", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0005170", born:date('1957-10-05'), name:"Bernie Mac", bio:"Bernard Jeffrey McCullough (October 5, 1957 – August 9, 2008), better known by his stage name, Bernie Mac, was an American actor and comedian.  Born and raised on the South Side of Chicago, Mac gained popularity as a stand-up comedian.  He joined comedians Steve Harvey, Cedric the Entertainer, and D.  L.  Hughley as The Original Kings of Comedy.  After briefly hosting the HBO show Midnight Mac, Mac appeared in several films in smaller roles...", died:date('2008-08-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e8fcldZCl8e63KN8YJGoFAZhx1l.jpg", url:"https://themoviedb.org/person/1897"}}, {tmdbId:"18999", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"0799777", born:date('1955-01-09'), name:"J.K. Simmons", bio:"Jonathan Kimble \"J.  K. \" Simmons (born January 9, 1955) is an American actor.  He is perhaps best known for his roles on television as Dr.  Emil Skoda in NBC's Law & Order (and other shows in the Law & Order franchise), Assistant Police Chief Will Pope in TNT's The Closer, neo-Nazi Vernon Schillinger in the HBO prison drama Oz, on film as J.  Jonah Jameson in the Spider-Man franchise, as Mac MacGuff in Juno, and as the voice of Cave Johnson in Portal 2...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jPoNW5fugs5h8AbcE7H5OBm04Tm.jpg", url:"https://themoviedb.org/person/18999"}}, {tmdbId:"49025", properties:{bornIn:"Avranches, Manche, France", imdbId:"0494078", born:date('1965-11-02'), name:"Samuel Le Bihan", bio:"Samuel Le Bihan (born 2 November 1965) is a French actor, known for his role in Brotherhood of the Wolf. \n\nSource: Article \"Samuel Le Bihan\" from Wikipedia in english, licensed under CC-BY-SA 3. 0...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jN4hwWfhFaE8v5TGiS6cg9HKOxe.jpg", url:"https://themoviedb.org/person/49025"}}, {tmdbId:"7540", properties:{bornIn:"Naples, Campania, Italy", imdbId:"0536134", born:date('1954-11-16'), name:"Licia Maglietta", bio:"Licia Maglietta (November 16, 1954) is an Italian actress.  She is known for her role in the film Pane e Tulipani (Bread and Tulips) and for playing title role in Agata e la Tempesta...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6xVrkk4SMYf0cW57zA3fQC9kPks.jpg", url:"https://themoviedb.org/person/7540"}}, {tmdbId:"7541", properties:{bornIn:"Udine, Italy", imdbId:"0061484", born:date('1968-07-22'), name:"Giuseppe Battiston", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kqQNVQCCgd4wImIVAy7iOCzbtTU.jpg", url:"https://themoviedb.org/person/7541"}}, {tmdbId:"7542", properties:{bornIn:"Acireale, Italy", imdbId:"0145951", born:date('1952-02-22'), name:"Antonio Catania", bio:"Antonio Catania (Acireale, 22 febbraio 1952) è un attore italiano...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/to9lD5ZJ6VoTsQFyw2gu9ybwm3H.jpg", url:"https://themoviedb.org/person/7542"}}, {tmdbId:"1585738", properties:{name:"Beau Daniels", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pDbJ2Q90AyZ5HwwZ0mYeQG7JTNm.jpg", url:"https://themoviedb.org/person/1585738"}}, {tmdbId:"46814", properties:{bornIn:"Knoxville, Tennessee, USA", imdbId:"0225460", born:date('1961-09-29'), name:"Dale Dickey", bio:"Dale Dickey is an American actress best known for her recurring role as Patty on My Name is Earl and for her supporting roles in films such as Domino and Winter's Bone.  Diana Dale Dickey was born in Knoxville, Tennessee and graduated from Bearden High School in Knoxville.  She played several roles in High School productions, notably as Emily in Our Town.  She later attended the University of Tennessee...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/588WXHw17JYi2rAqIVQXzgYENu3.jpg", url:"https://themoviedb.org/person/46814"}}, {tmdbId:"52913", properties:{bornIn:"Reykjavík, Iceland", imdbId:"0350273", born:date('1969-01-24'), name:"Hilmir Snær Guðnason", bio:"​From Wikipedia, the free encyclopedia\n\nHilmir Snær Guðnason (born 24 January 1969 in Reykjavík) is an Icelandic actor.  He is famous in his native country and has appeared in both film and on stage.  In 2000 he was named as one of European films 'Shooting Stars' by European Film Promotion.  He is best known for his roles in the films 101 Reykjavík,[1] Hafið (The Sea in English), Blueprint and Guy X...", url:"https://themoviedb.org/person/52913"}}] AS row
