UNWIND [{tmdbId:"6067", properties:{bornIn:"Austin, Texas, USA", imdbId:"0761587", born:date('1953-04-16'), name:"Jay O. Sanders", bio:"From Wikipedia, the free encyclopedia. \n\nJay Olcutt Sanders (born April 16, 1953) is an American character actor. \n\nSanders was born in Austin, Texas, to Phyllis Rae (née Aden) and James Olcutt Sanders.  He is noted for playing Mob lawyer character Steven Kordo in the 1986-88 NBC detective series Crime Story.  He is also known as the narrator for the PBS series Wide Angle from 2002–2009 and has served as narrator for a number of Nova episodes starting in 2007...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/omKTFUvCq1Dt8WoCg5hJEVAWBmw.jpg", url:"https://themoviedb.org/person/6067"}}, {tmdbId:"9452", properties:{bornIn:"Worblaufen BE, Switzerland", imdbId:"0076780", born:date('1965-08-31'), name:"Daniel Bernhardt", bio:"From Wikipedia, the free encyclopedia\n\nDaniel Bernhardt (born August 31, 1965) is a Swiss actor and martial arts expert who has appeared in a number of films and shows featuring martial arts action sequences, including little-known films like Future War (1997), series films like Bloodsport 2, 3, and 4 (in which he replaced actor and martial artist Jean-Claude Van Damme, star of the original film)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3BLz32inDr1jznU6pKQmh20zfhK.jpg", url:"https://themoviedb.org/person/9452"}}, {tmdbId:"46392", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0715563", born:date('1942-03-02'), name:"Lou Reed", bio:"Lewis Allan Reed was an American musician, singer and songwriter.  He was the guitarist, vocalist, and principal songwriter of the rock band the Velvet Underground, with a solo career that spanned five decades...", died:date('2013-10-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lWFiXdQtYHqr2EXnk5nhDFm36XF.jpg", url:"https://themoviedb.org/person/46392"}}, {tmdbId:"46394", properties:{bornIn:"Coral Gables, Florida, USA", imdbId:"0330917", name:"Mel Gorham", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/m1ju0BoV10CWPs0BuGw9rViX1Zj.jpg", url:"https://themoviedb.org/person/46394"}}, {tmdbId:"1332274", properties:{imdbId:"0028685", name:"James Andrews", url:"https://themoviedb.org/person/1332274"}}, {tmdbId:"1332275", properties:{imdbId:"0043854", name:"Mary Beth Aylesworth", url:"https://themoviedb.org/person/1332275"}}, {tmdbId:"1332276", properties:{imdbId:"0053839", name:"Mike Barbour", url:"https://themoviedb.org/person/1332276"}}, {tmdbId:"670394", properties:{imdbId:"0082227", name:"Steve Bilich", url:"https://themoviedb.org/person/670394"}}, {tmdbId:"21163", properties:{bornIn:"Park Ridge, Illinois, USA", imdbId:"0170550", born:date('1956-09-20'), name:"Gary Cole", bio:"Gary Cole is an American stage and screen actor, best known for his supporting roles in numerous television and film productions such as Jack \"Nighthawk\" Killian in \"Midnight Caller\" or as Bill Lumbergh in \"Office Space\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uWsqIlfHbyxkmBJLmq2mR93musF.jpg", url:"https://themoviedb.org/person/21163"}}, {tmdbId:"15286", properties:{bornIn:"Allentown, Pennsylvania, USA", imdbId:"0852132", born:date('1971-07-30'), name:"Christine Taylor", bio:"Christine Joan Taylor (born July 30, 1971) is an American actress.  She is known for playing Marcia Brady in The Brady Bunch Movie and A Very Brady Sequel, as well as roles in The Wedding Singer, Zoolander, and DodgeBall: A True Underdog Story. \n\nDescription above from the Wikipedia article Christine Taylor, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pObWuDJmyDJAGijDVdRO9phX3Md.jpg", url:"https://themoviedb.org/person/15286"}}, {tmdbId:"2465", properties:{bornIn:" Glasgow, Scotland, UK", imdbId:"0732703", born:date('1983-09-06'), name:"James Robinson", bio:"James Robinson is a Scottish actor/producer born in Glasgow.  Debuted as the young William Wallace in Mel Gibson’s Braveheart, he has gone on to appear in Danny Boyle’s highly acclaimed \"Babylon\" and Neil Jordan’s historical epic \"The Borgias\" with Jeremy Irons and Gina McKee.  He has guest-starred on BBC’s \"Doctors\" and \"Casualty\", and as Greg Edgars in Sony/Starz’s \"Outlander\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zXx9JpnmsVE5qSVakaBBFljtBWA.jpg", url:"https://themoviedb.org/person/2465"}}, {tmdbId:"2472", properties:{bornIn:"Dublin, Ireland", imdbId:"0492566", born:date('1954-01-25'), name:"Sean Lawlor", bio:"From Wikipedia, the free encyclopedia. \n\nSean Lawlor (January 25, 1954 – October 10, 2009), was an Irish character actor and playwright.  He was best known for his portrayal of Malcolm Wallace in Mel Gibson's Oscar-winning epic, Braveheart.  In addition, he also appeared in James Cameron's Titanic and Jim Sheridan's In the Name of the Father.  Other recent roles include Martin O Toole in \"On Broadway\" and Earl Leofric in \"1066\"...", died:date('2009-10-10'), url:"https://themoviedb.org/person/2472"}}, {tmdbId:"2473", properties:{imdbId:"0625729", born:date('1970-12-02'), name:"Sandy Nelson", url:"https://themoviedb.org/person/2473"}}, {tmdbId:"2467", properties:{bornIn:"Clydebank - West Dunbartonshire - Scotland - UK", imdbId:"0181920", born:date('1948-05-24'), name:"James Cosmo", bio:"From Wikipedia, the free encyclopedia\n\nJames Cosmos is known for his film roles as Angus MacLeod in Highlander, Campbell in Braveheart and as Father Christmas in the adaptation of The Chronicles of Narnia: The Lion, the Witch and the Wardrobe.  Over the years he has also had roles in films such as Trainspotting, The Last Legion, Troy, and 2081 .  He also appeared in Take the High Road as Alex Geddes from 1982-83...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uFyivAeeG3h8Gt5a99ACRC44vZL.jpg", url:"https://themoviedb.org/person/2467"}}, {tmdbId:"6907", properties:{imdbId:"0179960", name:"Annie Corley", bio:"From Wikipedia, the free encyclopedia.  Annie Corley is an American actress who has appeared in a wide variety of films and television shows since 1990.  Her most notable role to date was playing Meryl Streep's daughter in the film The Bridges of Madison County. \n\nA graduate of DePauw University in Indiana, she first appeared in Malcolm X.  Since then, she has been featured in several other Oscar-nominated films, such as The Cider House Rules, Seabiscuit, 21 Grams, and Monster...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ogcCSdasNNQra08tMyEDYzE5ad4.jpg", url:"https://themoviedb.org/person/6907"}}, {tmdbId:"10379", properties:{bornIn:"Youngstown - Ohio - USA", imdbId:"0805789", born:date('1957-07-30'), name:"Victor Slezak", bio:"From Wikipedia, the free encyclopedia. \n\nVictor Slezak (born July 30, 1957) is an American stage, television and screen actor who has appeared in numerous films, including The Bridges of Madison County (1995), Beyond Rangoon (1995), The Devil's Own (1997), The Siege (1998),The Cat's Meow (2001), Timequest as John F.  Kennedy (2002) and The Notorious Bettie Page (2005). \n\nOn Broadway, he starred as John F.  Kennedy, opposite Margaret Colin, in Jackie: An American Life...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ePiUGZJP5sVpk0I7oEEy9OuLgMD.jpg", url:"https://themoviedb.org/person/10379"}}, {tmdbId:"86308", properties:{imdbId:"0016589", born:date('1971-07-09'), name:"Shari Albert", url:"https://themoviedb.org/person/86308"}}, {tmdbId:"21398", properties:{bornIn:"Stowe, Vermont, USA", imdbId:"0000827", born:date('1971-02-28'), name:"Maxine Bahns", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i7L0pBY4dP0VDNoUy7FtHAIbfzc.jpg", url:"https://themoviedb.org/person/21398"}}, {tmdbId:"86309", properties:{imdbId:"0093488", name:"Catharine Bolz", url:"https://themoviedb.org/person/86309"}}, {tmdbId:"86310", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0110168", born:date('1967-03-06'), name:"Connie Britton", bio:"Connie Britton (born March 6, 1967) is an American actress.  She is best known for the roles of Nikki Faber on Spin City and on Friday Night Lights as Tami Taylor.  Her most notable films are Friday Night Lights and A Nightmare on Elm Street.  Despite the fact that the Friday Night Lights television series is based on the film, she portrays different characters in both of them.  Her character in the show is named Tami Taylor while in the film her character is named Sharon Gaines...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tvmHBugmn6zKgWWcDFFOafBkS3K.jpg", url:"https://themoviedb.org/person/86310"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"1412887", properties:{imdbId:"0417126", name:"Kathy Jamieson", url:"https://themoviedb.org/person/1412887"}}, {tmdbId:"13363", properties:{bornIn:"Paddington, London, England, UK", imdbId:"0716293", born:date('1961-08-16'), name:"Saskia Reeves", bio:"Saskia Reeves (born 16 August 1961) is a British actress perhaps best known for her roles in the films Close My Eyes (1991) and I. D.  (1995), and the 2000 miniseries Frank Herbert's Dune. \n\nBorn and brought up in London to a Dutch mother and English father, Reeves studied at London's Guildhall School of Music and Drama and has since worked with directors such as Mike Leigh, Stephen Poliakoff, Michael Winterbottom and Nicholas Hytner...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dTzb4BHZ9T9O2kNgNgTuMtGQ8rB.jpg", url:"https://themoviedb.org/person/13363"}}, {tmdbId:"102980", properties:{bornIn:"Belfast, Northern Ireland", imdbId:"0563922", born:date('1952-05-25'), name:"Des McAleer", bio:"Des McAleer is a Belfast born actor of film, TV and stage...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mebPjsnyAqBnrDStUjyGIkqAHmk.jpg", url:"https://themoviedb.org/person/102980"}}, {tmdbId:"955272", properties:{bornIn:"Mexico City - Mexico", imdbId:"0737938", born:date('1943-08-15'), name:"María Rojo", bio:"María de Lourdes Rojo e Incháustegui, commonly known as María Rojo (Mexico City, August 15, 1943), is a Mexican actress and politician.  She is currently Senator of the Republic in the upper house of Mexican Congress.   She has participated in successful Mexican films such as: Rojo amanecer, El callejón de los milagros and El Infierno; andtelenovelas such as: Alborada, Mañana es para siempre, Corazón Salvaje, and Hasta el fin del mundo...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cij2RYi90gZtGmTediDphdEAUZC.jpg", url:"https://themoviedb.org/person/955272"}}, {tmdbId:"3136", properties:{bornIn:"Coatzacoalcos, Veracruz, Mexico", imdbId:"0000161", born:date('1966-09-02'), name:"Salma Hayek", bio:"One of the most notable figures of Mexican descent in Hollywood today.  She is most famous for her work in the 2002 film Frida, for which she was nominated for a Best Actress Academy Award.  In 2001 she received Glamour magazine's Woman of the Year Award, and then in 2005, Time Magazine's \"25 Most Influental Hispanics\" award.  Salma comes from a prominent Veracruz family of Spanish and Lebanese descent...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a1VhN6kvw4tuRrIvGnvAjHAWnD5.jpg", url:"https://themoviedb.org/person/3136"}}, {tmdbId:"52745", properties:{bornIn:"Mexico City, Mexico", imdbId:"0080966", born:date('1967-10-06'), name:"Bruno Bichir", bio:"From Wikipedia, the free encyclopedia. \n\nBruno Bichir (born Bruno Bichir Nájera October 6, 1967, Mexico City) is one of the most prolific actors of the contemporary cinema of Mexico as well as telenovelas and theater. \n\nBruno is a member of the Bichir family of Lebanese origin whose members are prominent actors.  Both of his parents, Alejandro Bichir and Maricruz Nájera, and two older brothers Odiseo and Demián Bichir are actors...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/af6MbUchuOv9bPh080cF7Awqxi7.jpg", url:"https://themoviedb.org/person/52745"}}, {tmdbId:"4041", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0641640", born:date('1957-10-19'), name:"William O'Leary", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qaTKXEh5rl8PP7XThJAjC5DUChs.jpg", url:"https://themoviedb.org/person/4041"}}, {tmdbId:"5502", properties:{bornIn:"Pittsburgh, Pennsylvania, U.S.", imdbId:"0638056", born:date('1953-10-20'), name:"Bill Nunn", bio:"​From Wikipedia, the free encyclopedia.   \n\nWilliam G.  \"Bill\" Nunn III (born October 20, 1953) is an American actor. Nunn made his acting debut in the 1988 Spike Lee film School Daze, and is perhaps best known for his roles as Radio Raheem in Lee's Do the Right Thing and as Nino Brown's verbally challenged bodyguard Duh Duh Duh Man in New Jack City...", died:date('2016-09-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5dphDw0EDkKvxrolhvOFv6v91yj.jpg", url:"https://themoviedb.org/person/5502"}}, {tmdbId:"101850", properties:{imdbId:"0212921", born:date('1952-01-01'), name:"Rick Dean", died:date('2006-02-03'), url:"https://themoviedb.org/person/101850"}}, {tmdbId:"54447", properties:{bornIn:"Hammersmith, London, England, UK", imdbId:"0922335", born:date('1966-06-19'), name:"Samuel West", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yIDXDpgXxPbl5qWu8KHV7fGzVNr.jpg", url:"https://themoviedb.org/person/54447"}}, {tmdbId:"147496", properties:{imdbId:"0904153", name:"Spencer Vrooman", url:"https://themoviedb.org/person/147496"}}, {tmdbId:"56057", properties:{bornIn:"San Luis Obispo County, California, USA", imdbId:"0669326", born:date('1980-06-12'), name:"Malachi Pearson", url:"https://themoviedb.org/person/56057"}}, {tmdbId:"80291", properties:{imdbId:"0298268", name:"Jonathan Fuller", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fQ8yAEXLCHzY7dbkLeYMorf3sV7.jpg", url:"https://themoviedb.org/person/80291"}}, {tmdbId:"105645", properties:{imdbId:"0231142", name:"Jessica Dollarhide", url:"https://themoviedb.org/person/105645"}}, {tmdbId:"937034", properties:{bornIn:"Walnut Creek, California, USA", born:date('1969-01-02'), name:"Christy Turlington", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sWuOYoDDuPJWecjCYo0tuP8AXaK.jpg", url:"https://themoviedb.org/person/937034"}}, {tmdbId:"937035", properties:{imdbId:"0015823", name:"Azzedine Alaïa", url:"https://themoviedb.org/person/937035"}}, {tmdbId:"103057", properties:{bornIn:"Piacenza, Emilia-Romagna, Italy", imdbId:"0004714", born:date('1934-07-11'), name:"Giorgio Armani", bio:"Giorgio Armani is an Italian fashion designer, particularly noted for his menswear.  He is known today for his clean, tailored lines.  He formed his company, Armani, in 1975, and by 2001 was acclaimed as the most successful designer to come out of Italy, with an annual turnover of $1. 6 billion and a personal fortune of $7 billion as of 2012...", url:"https://themoviedb.org/person/103057"}}, {tmdbId:"50841", properties:{bornIn:"Berlin - Germany", imdbId:"1193699", born:date('1971-03-19'), name:"Nadja Auermann", url:"https://themoviedb.org/person/50841"}}, {tmdbId:"1429026", properties:{imdbId:"0109192", name:"Susie Bright", url:"https://themoviedb.org/person/1429026"}}, {tmdbId:"17665", properties:{imdbId:"0491306", born:date('1917-07-14'), name:"Arthur Laurents", died:date('2011-05-05'), url:"https://themoviedb.org/person/17665"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"6613", properties:{bornIn:"Finsbury Park, London, England, UK", imdbId:"0000378", born:date('1970-01-31'), name:"Minnie Driver", bio:"Minnie Driver (born Amelia Fiona J.  Driver; 31 January 1970) is an English actress and singer-songwriter.  She was nominated for an Academy Award for Best Supporting Actress for her performance in the 1997 film Good Will Hunting, as well as for an Emmy Award and a Golden Globe for her work in the television series The Riches. \n\nDescription above from the Wikipedia article Minnie Driver, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pROqdpF9tTCA2giYB50dMwhCJvC.jpg", url:"https://themoviedb.org/person/6613"}}, {tmdbId:"89021", properties:{bornIn:" Belfast, Northern Ireland", imdbId:"0642374", born:date('1971-03-04'), name:"Geraldine O'Rawe", bio:"Geraldine O'Rawe is a Northern Irish actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/77QWUiFhXFhgwJ3gC5pXrXxg7Xk.jpg", url:"https://themoviedb.org/person/89021"}}, {tmdbId:"9825", properties:{bornIn:"London - England - UK", imdbId:"0004787", born:date('1972-10-22'), name:"Saffron Burrows", bio:"​From Wikipedia, the free encyclopedia\n\nSaffron Dominique Burrows (born 22 October 1972) is an English actress and former fashion model, who starred as Det.  Serena Stevens on Law &amp; Order: Criminal Intent...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ve5xVMhgwl8pNYi5cINEiqNzlXQ.jpg", url:"https://themoviedb.org/person/9825"}}, {tmdbId:"13843", properties:{bornIn:"Providencia, Chile", imdbId:"0256399", born:date('1924-04-07'), name:"Daniel Emilfork", bio:"​From Wikipedia, the free encyclopedia.   \n\nDaniel Emilfork Berenstein (April 7, 1924 – October 17, 2006) was a Chilean stage and film actor. \n\nEmilfork was born in Providencia, Chile after his Jewish socialist parents from Kiev fled a pogrom in Odessa.  At age 25, he left Chile and settled in France, because, according to his friend Alejandro Jodorowsky, he didn't feel comfortable being a homosexual man in Chile...", died:date('2006-10-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1EDUHOHQfDUlRwYDsIjyIPQOimx.jpg", url:"https://themoviedb.org/person/13843"}}, {tmdbId:"13842", properties:{bornIn:"Paris, France", imdbId:"0900136", born:date('1984-12-01'), name:"Judith Vittet", bio:"​From Wikipedia, the free encyclopedia.   \n\nJudith Vittet (born December 1984) is a French actress best known for her role as the streetwise orphan \"Miette\" in La Cité des enfants perdus (English: The City of Lost Children) (1995).  She was nominated for a 1996 Saturn Award in the category of Best Performance By a Younger Actor. \n\nJudith Vittet was picked out of hundreds of young actresses auditioning for the part of Miette (\"Crumb\")...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eFCIj6Kb3Tcf5JQwD2ExSxTtWK6.jpg", url:"https://themoviedb.org/person/13842"}}, {tmdbId:"327", properties:{bornIn:"Harlem, New York City, New York, USA", imdbId:"0001616", born:date('1974-12-29'), name:"Mekhi Phifer", bio:"Mekhi Thira Phifer (born December 29, 1974) is an American actor.  He is perhaps best known for his multi-year role as Dr.  Greg Pratt on NBC's long-running medical drama ER and his co-starring role opposite Eminem in the feature film 8 Mile.  He was a regular on the Fox crime show Lie to Me portraying the role of Ben Reynolds, before season 3.  He was born in in Harlem, New York City, the son of Rhoda Phifer, a high school teacher; he grew up in a single-parent household with his mother...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wQTqi6GmWWjZtUnlTgCaxGSt6mq.jpg", url:"https://themoviedb.org/person/327"}}, {tmdbId:"77287", properties:{bornIn:"Newcastle upon Tyne, England, UK", imdbId:"0717176", born:date('1935-05-28'), name:"Anne Reid", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fcZTcJt5e5xczByJKJoqY1GHEhq.jpg", url:"https://themoviedb.org/person/77287"}}, {tmdbId:"58150", properties:{bornIn:"Bronx, New York, USA", imdbId:"0001107", born:date('1966-01-20'), name:"Stacey Dash", bio:"Stacey Lauretta Dash (born January 20, 1966) is an American film and television actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cSzVCx2LJkXZoUGA4z4i8cm9wMD.jpg", url:"https://themoviedb.org/person/58150"}}, {tmdbId:"328", properties:{bornIn:"Atlanta, Georgia, USA", imdbId:"0005261", born:date('1977-11-10'), name:"Brittany Murphy", bio:"Was an American actress and singer.  Born in New Jersey, Murphy moved to Los Angeles at the age of 14 with her mother Sharon, in the hopes of landing acting roles.  She quickly landed spots in commercials and guest starring roles on television, and appeared as a series regular on two short-lived family sitcoms, Drexell's Class and Almost Home...", died:date('2009-12-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9vjgU9EcHXYyh6Vc4nmpoPVNqsQ.jpg", url:"https://themoviedb.org/person/328"}}, {tmdbId:"22226", properties:{bornIn:"Passaic, New Jersey, USA", imdbId:"0748620", born:date('1969-04-06'), name:"Paul Rudd", bio:"Paul Stephen Rudd (born April 6, 1969) is an American actor, comedian, writer, and producer.  He studied theatre at the University of Kansas and the British American Drama Academy, before making his acting debut in 1992 with NBC's drama series Sisters...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8eTtJ7XVXY0BnEeUaSiTAraTIXd.jpg", url:"https://themoviedb.org/person/22226"}}, {tmdbId:"20300", properties:{bornIn:"Clapton, London, England, UK", imdbId:"0040586", born:date('1934-06-16'), name:"Eileen Atkins", bio:"From Wikipedia, the free encyclopedia. \n\nDame Eileen June Atkins, DBE (born 16 June 1934) is an English actress and occasional screenwriter. \n\nDescription above from the Wikipedia article Eileen Atkins, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yIf9zuP8TVTluEZTrVtHXZkzl6L.jpg", url:"https://themoviedb.org/person/20300"}}, {tmdbId:"127913", properties:{bornIn:"Blackheath, London, England, UK", imdbId:"0123090", born:date('1922-05-09'), name:"Sheila Burrell", died:date('2011-07-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1iPbgQR7LOst5xZx1xdfL3IG4SS.jpg", url:"https://themoviedb.org/person/127913"}}, {tmdbId:"1019878", properties:{imdbId:"0333079", name:"Patrick Goyette", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gZz5G07JmJ1s8APr7oeIoZMnY4j.jpg", url:"https://themoviedb.org/person/1019878"}}, {tmdbId:"1019879", properties:{imdbId:"0589603", name:"Jean-Louis Millette", url:"https://themoviedb.org/person/1019879"}}, {tmdbId:"21043", properties:{bornIn:" Los Angeles, California, USA", imdbId:"0909620", born:date('1963-11-17'), name:"Dylan Walsh", bio:"Dylan Walsh (born November 17, 1963) is an American actor.  He is best known as Dr.  Sean McNamara in the FX television series Nip/Tuck and for his role in the movie Congo...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6rOQgNjIJUqXDiM06K2hrL68Eky.jpg", url:"https://themoviedb.org/person/21043"}}, {tmdbId:"65887", properties:{imdbId:"0475100", name:"Vusi Kunene", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xPJME6yJwkKL1fL9lKEXmyzvwr8.jpg", url:"https://themoviedb.org/person/65887"}}, {tmdbId:"51215", properties:{imdbId:"0250643", name:"Aeryk Egan", url:"https://themoviedb.org/person/51215"}}, {tmdbId:"128485", properties:{imdbId:"0887433", name:"Le Van Loc", url:"https://themoviedb.org/person/128485"}}, {tmdbId:"113388", properties:{bornIn:" Vietnam", imdbId:"0951295", name:"Tran Nu Yên-Khê", bio:"​From Wikipedia, the free encyclopedia.   \n\nTrần Nữ Yên Khê (born 1968) is a Vietnamese actress married to director Tran Anh Hung.  She has been in all his films thus far, with the exception of Norwegian Wood.  She has alleged that, \"French people only offer me stereotypical roles of Asian women men fantasize about. \" \n\nDescription above from the Wikipedia article Trần Nữ Yên Khê licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/k79bnPsbd7YFUkW6DTsPNDmqa5h.jpg", url:"https://themoviedb.org/person/113388"}}, {tmdbId:"1508846", properties:{imdbId:"7496869", name:"Nhu Quynh Nguyen", url:"https://themoviedb.org/person/1508846"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"11902", properties:{bornIn:"New York City, New York, U.S.", imdbId:"0000862", born:date('1951-04-22'), name:"Robin Bartlett", bio:"From Wikipedia, the free encyclopedia.  Robin Bartlett (born April 22, 1951) is an American actress.  She was born in England, but was raised in Switzerland. \n\nShe was formerly married to the actor Alan Rosenberg. \n\nShe appeared in the short-lived series The Powers That Be and had a recurring role as Debbie Buchman (the sister of Paul Reiser's character) in the series Mad About You. \n\nShe has played a teacher at least twice – as Mrs.  Elliott in 1989's Lean on Me, then again as French teacher Mrs...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/FUF2kg7Rn2C34TMo3YQjgGqhFo.jpg", url:"https://themoviedb.org/person/11902"}}, {tmdbId:"15439", properties:{bornIn:"Ohsweken, Ontario, Canada", imdbId:"0001200", born:date('1953-06-12'), name:"Gary Farmer", bio:"From Wikipedia, the free encyclopedia. \n\nGary Dale Farmer (born June 12, 1953) is a Canadian actor. \n\nDescription above from the Wikipedia article Gary Farmer, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/35N1Z7INlgCRxd7j9RJWlueETUP.jpg", url:"https://themoviedb.org/person/15439"}}, {tmdbId:"66", properties:{bornIn:"Atlanta, Georgia, USA", imdbId:"0000676", born:date('1971-08-31'), name:"Chris Tucker", bio:"Christopher \"Chris\" Tucker (born August 31, 1971) is an American actor and comedian, best known for his roles as Detective James Carter in the Rush Hour trilogy and Smokey in the 1995 film Friday.   Tucker was born in Atlanta, Georgia, the youngest son of Mary Louise and Norris Tucker.  Tucker was raised in Decatur, Georgia.  After graduating from Columbia High School, he moved to Los Angeles to pursue a career in comedy and movies.  In 1992, Tucker was a frequent performer on Def Comedy Jam...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xtAK4hFyDjSYhZ9oRhppuVcLi80.jpg", url:"https://themoviedb.org/person/66"}}, {tmdbId:"6862", properties:{bornIn:"Chicago - Illinois - USA", imdbId:"0135585", born:date('1975-01-17'), name:"Freddy Rodríguez", bio:"Freddy Rodriguez (born January 17, 1975 from two Puerto Rican parents) is an American actor known for playing the characters Hector Federico \"Rico\" Diaz on HBO's Six Feet Under and El Wray in Robert Rodriguez's Planet Terror.  Recently, he was a recurring cast member on the series Ugly Betty as Giovanni \"Gio\" Rossi...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lxBSNLtNmIuRAMhmLF2TBYEgLl9.jpg", url:"https://themoviedb.org/person/6862"}}, {tmdbId:"68122", properties:{bornIn:"New York City, New York, USA", imdbId:"0004857", born:date('1956-03-01'), name:"Tim Daly", bio:"​From Wikipedia, the free encyclopedia. \n\nJames Timothy Daly (born March 1, 1956) is an American actor and producer.  He is known for his role as Joe Hackett on the NBC sitcom Wings and his voice role as Clark Kent/Superman in Superman: The Animated Series, as well as his recurring role as the drug-addicted screenwriter J. T.  Dolan on The Sopranos (for which he was nominated for an Emmy Award).  He starred as Pete Wilder on Private Practice from 2007 to 2012...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/asMoEhrCsmIAOiEASYHiPN8JfoO.jpg", url:"https://themoviedb.org/person/68122"}}, {tmdbId:"535284", properties:{imdbId:"0270332", name:"Caroleen Feeney", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dYzhTQAoKQiO08oVzJ1rlL9IxHW.jpg", url:"https://themoviedb.org/person/535284"}}, {tmdbId:"154386", properties:{imdbId:"0348371", name:"Dan Gunther", url:"https://themoviedb.org/person/154386"}}, {tmdbId:"19888", properties:{bornIn:"Marseille, Bouches-du-Rhône, France", imdbId:"0656768", born:date('1971-01-08'), name:"Géraldine Pailhas", bio:"Géraldine Pailhas (born 8 January 1971 is a French actress.  She had her first international success in 1995 as Doña Anna, the unfulfilled love of Johnny Depp in the comedy Don Juan DeMarco.  Born in Marseille she is married to actor Christopher Thompson.  She has two children. \n\nDescription above from the Wikipedia article Géraldine Pailhas, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yPHgSmVJuS7Xub2WLtaYyd6Osjz.jpg", url:"https://themoviedb.org/person/19888"}}, {tmdbId:"16850", properties:{bornIn:"Florence, Tuscany, Italy", imdbId:"0000535", born:date('1973-09-05'), name:"Rose McGowan", bio:"Rose Arianna McGowan (born September 5, 1973) is an American actor, filmmaker, activist and musician.  Born in Italy, they were raised among the Children of God cult, before their American-born parents fled back to the USA when Rose was 10 amid concerns about the direction of the community. \n\nSettling in Oregon, McGowan was bullied at school and rebelled from their family...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3olbMkDYvb9mpJxGvrZqHx0aLwr.jpg", url:"https://themoviedb.org/person/16850"}}, {tmdbId:"51670", properties:{bornIn:"Edgewood, Maryland, USA", imdbId:"0000628", born:date('1969-09-10'), name:"Johnathon Schaech", bio:"​From Wikipedia, the free encyclopedia.   \n\nJohnathon Schaech (pronounced Shek, born September 10, 1969) is an American actor, writer, and director. \n\nDescription above from the Wikipedia article Johnathon Schaech, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/13hf3VhszBoykxF7lNER2ur4Z9B.jpg", url:"https://themoviedb.org/person/51670"}}, {tmdbId:"157847", properties:{bornIn:"Heidelberg, Germany", imdbId:"0930317", born:date('1970-07-26'), name:"Cress Williams", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pIOyAg9U0eAUvs8N2Xca7uRKlOe.jpg", url:"https://themoviedb.org/person/157847"}}, {tmdbId:"66761", properties:{bornIn:"Beijing, China", imdbId:"0481709", born:date('1966-12-11'), name:"Leon Lai", bio:"Leon Lai is a Hong Kong-based actor and Cantopop singer.  The media refer to Aaron Kwok, Jacky Cheung, Andy Lau and Leon Lai as the Cantopop Four Heavenly Kings (四大天王).  He uses the stage name \"Li Ming\" or \"Lai Ming\" which literally means \"dawn...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fGlxNX2WozXLWiJC3d5jQ1NdRP1.jpg", url:"https://themoviedb.org/person/66761"}}, {tmdbId:"66762", properties:{bornIn:"Hong Kong", imdbId:"0947777", born:date('1974-05-23'), name:"Charlie Yeung", bio:"Charlie Yeung Choi-Nei, sometimes spelled Charlie Young, is a Chinese film actress and singer.  She was first noticed after appearing in a jewellery commercial with Aaron Kwok.  Since then she has participated in the music videos of artists such as Hacken Lee, Takeshi Kaneshiro and Jacky Cheung and made a number of films, most famously with Tsui Hark (The Lovers, Love in the Time of Twilight, Seven Swords) and Wong Kar-wai (Ashes of Time, Fallen Angels)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cWXC4u3dq4Ck8iIVdTT7mRsUFM8.jpg", url:"https://themoviedb.org/person/66762"}}, {tmdbId:"3813", properties:{bornIn:"Erandio, Vizcaya, Spain", imdbId:"0029962", born:date('1953-04-12'), name:"Álex Angulo", bio:"Alejandro “Álex” Angulo León was a Spanish Basque actor who performed in over sixty films during his career spanning more than 30 years.  Angulo died at the age of 61 when the vehicle in which he was travelling veered from the road...", died:date('2014-07-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xzVsmWbKhTcIGo0YhcMj4BLwhGX.jpg", url:"https://themoviedb.org/person/3813"}}, {tmdbId:"66815", properties:{bornIn:"Roma, Italia", imdbId:"0211089", born:date('1955-05-24'), name:"Armando De Razza", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cc6jUaH7fTfcqASSmARdDUb0RaL.jpg", url:"https://themoviedb.org/person/66815"}}, {tmdbId:"10847", properties:{bornIn:"Madrid - Spain", imdbId:"0782213", born:date('1965-07-17'), name:"Santiago Segura", bio:"Born in Madrid, Santiago Segura started his career by making his first short movie at the age of fourteen.  After studying Arts in Madrid, he finally decided to become a filmmaker.  His first short film Relatos de la medianoche (1989) was made with a budget of only 7. 000 pts.  (about 60 dollars).  After that, he appeared as a contestant in several Spanish TV quiz shows, such as \n\nLocos por la tele (1990) and No te rías, que es peor (1990)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w5gSHzLWoivAN2g4z2yaxCSFyTY.jpg", url:"https://themoviedb.org/person/10847"}}, {tmdbId:"66816", properties:{imdbId:"0701715", born:date('1939-07-29'), name:"Terele Pávez", died:date('2017-08-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i5adV75a3arbpRCSELevAGUC8TC.jpg", url:"https://themoviedb.org/person/66816"}}, {tmdbId:"5578", properties:{bornIn:"Queens, New York City, New York, USA", imdbId:"0000529", born:date('1964-08-13'), name:"Debi Mazar", bio:"Debi Mazar (born August 13, 1964) is an American actress, perhaps best known for her trademark Jersey Girl-type appearances, and as edgy, sharp-tongued women in independent films and her recurring role on Entourage...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mSGSJwr0RsmN0WBDcxabYqhLpUM.jpg", url:"https://themoviedb.org/person/5578"}}, {tmdbId:"81821", properties:{bornIn:"Boulogne-Billancourt, Hauts-de-Seine, France", imdbId:"0452161", born:date('1968-02-25'), name:"Sandrine Kiberlain", bio:"From Wikipedia, the free encyclopedia\n\nSandrine Kiberlain (born on 25 February 1968 in Boulogne-Billancourt) is a French actress and singer.  She has often worked with the director Laetitia Masson, and has also worked with Benoît Jacquot. \n\nKiberlain received the Prix Romy Schneider in 1995.  In addition to her acting career, she also has recorded an album (Manquait plus qu'ça, released in 2005), which has been well received in France...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iqDFdfhjZleeKjnjWvaMrXTyrB4.jpg", url:"https://themoviedb.org/person/81821"}}, {tmdbId:"20442", properties:{bornIn:"Gennevilliers, France", imdbId:"0954704", born:date('1965-09-27'), name:"Roschdy Zem", bio:"From Wikipedia, the free encyclopedia\n\nRoschdy Zem (born 1965-09-27, Gennevilliers, Hauts-de-Seine) is a French actor of Moroccan descent.  He shared the award for Best Actor for his role in the film Days of Glory at the 2006 Cannes Film Festival. \n\nDescription above from the Wikipedia article Roschdy Zem, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/snCmqnpG1BCypvuCKSAy5Z5BgV8.jpg", url:"https://themoviedb.org/person/20442"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"239336", properties:{imdbId:"0299695", name:"Jean-Michel Fête", url:"https://themoviedb.org/person/239336"}}, {tmdbId:"33665", properties:{bornIn:"DeKalb, Illinois, USA", imdbId:"0000340", born:date('1966-02-20'), name:"Cindy Crawford", bio:"Cynthia Ann \"Cindy\" Crawford (born February 20, 1966) is an American model.  Known for her trademark mole just above her lip, Crawford has adorned hundreds of magazine covers throughout her career.  She was named #3 on VH1's 40 Hottest Hotties of the 90s.  Her success at modeling made her a celebrity that has led to roles in television and film, and to work as a spokesperson...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ncJLWNKFtNDg5HFZspDMrexw2Pf.jpg", url:"https://themoviedb.org/person/33665"}}, {tmdbId:"19453", properties:{bornIn:"Denver - Colorado - USA", imdbId:"0101005", born:date('1938-01-05'), name:"Tom Bower", bio:"From Wikipedia, the free encyclopedia\n\nTom Bower (born January 1938) is an American actor who has appeared in a wide variety of television and film roles from 1973 to present.  He played physician-husband Curt on The Waltons.  He has held a number of prominent supporting roles including Dan Miller in the 2000 film Pollock and the gas station attendant in the 2006 film The Hills Have Eyes.  He also plays the barkeep in the Battlestar Galactica episode, \"Taking a Break from All Your Worries\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q26z6T3QZfpirZV3Ex885zUgUR4.jpg", url:"https://themoviedb.org/person/19453"}}, {tmdbId:"9138", properties:{bornIn:"Marylebone, London, England, UK", imdbId:"0428121", born:date('1942-12-04'), name:"Gemma Jones", bio:"Jennifer Gemma Jones (born 4 December 1942) is an English character actress on both stage and screen.  Her film appearances include Sense and Sensibility (1995), Bridget Jones's Diary (2001), the Harry Potter series (2002–11), and Woody Allen's You Will Meet a Tall Dark Stranger (2010).  For her role in the BBC television film Marvellous (2014), she won the 2015 BAFTA TV Award for Best Supporting Actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3NrvY1xvAIV3Oj7fTxVtLHX285V.jpg", url:"https://themoviedb.org/person/9138"}}, {tmdbId:"17648", properties:{bornIn:"Taunton, England, UK", imdbId:"0700856", born:date('1964-06-03'), name:"James Purefoy", bio:"James Purefoy (born 3 June 1964) is an English actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w49L5ZthjOyeNLZvPaet6qz1YRs.jpg", url:"https://themoviedb.org/person/17648"}}, {tmdbId:"170935", properties:{imdbId:"0042488", name:"Paul Austin", url:"https://themoviedb.org/person/170935"}}, {tmdbId:"94430", properties:{bornIn:"New York, City, New York, USA", imdbId:"0319826", born:date('1964-06-25'), name:"Erica Gimpel", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9rEGsUqlbVJexRZ2TTxc0UIGY5P.jpg", url:"https://themoviedb.org/person/94430"}}, {tmdbId:"954", properties:{bornIn:"Madrid, Spain", imdbId:"0004650", born:date('1946-04-03'), name:"Marisa Paredes", bio:"María Luisa Paredes Bartolomé, born on 3 April 1946 in Madrid, better known in show business as Marisa Paredes, is a Spanish actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aDfNPZ2plaCmdrYkCkburjBqYnP.jpg", url:"https://themoviedb.org/person/954"}}, {tmdbId:"36277", properties:{imdbId:"0248364", born:date('1961-04-01'), name:"Juan Echanove", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/viRJjqoYTf3LqIhiyXZtXykVszW.jpg", url:"https://themoviedb.org/person/36277"}}, {tmdbId:"36278", properties:{bornIn:"Barcelona, Spain", imdbId:"0255979", born:date('1951-01-14'), name:"Carme Elias", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zdEM6b1NGwOWKd6rgmPnRCpPedw.jpg", url:"https://themoviedb.org/person/36278"}}, {tmdbId:"25258", properties:{bornIn:"Palma de Mallorca, Spain", imdbId:"0658041", born:date('1964-09-16'), name:"Rossy de Palma", bio:"Described by many as a Picasso come-to-life, de Palma broke the rules of beauty in 1988 when she starred in Pedro Almodóvar’s Women on the Verge of a Nervous Breakdown and became a model and muse for designers like Jean-Paul Gaultier, Thierry Mugler, and Sybilla.  Her status as an iconic fashion character was further cemented with her role in Robert Altman’s 1994 satirical fashion film Prêt-à-Porter...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3IH9ZBUcFNwBr8IcS1RZhMKTpeg.jpg", url:"https://themoviedb.org/person/25258"}}, {tmdbId:"65528", properties:{bornIn:"Piedmont, California, USA", imdbId:"0828906", born:date('1962-08-02'), name:"Cynthia Stevenson", bio:"Cynthia Stevenson (born August 2, 1962 in Oakland, California) is an American film and television actress.  She was a regular cast member on the series Dead Like Me, playing the mother of the lead character. \n\nIn April 2006, she completed filming a new sitcom pilot for CBS called You've Reached the Elliotts, starring opposite Chris Elliott as his wife, which was not picked up by the network...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zdrsUVw9F0U4onvh1rS1AQor4wp.jpg", url:"https://themoviedb.org/person/65528"}}, {tmdbId:"3122", properties:{bornIn:"Kidderminster, Worcestershire, England, UK", imdbId:"0205423", born:date('1964-06-21'), name:"Sammi Davis", bio:"From Wikipedia, the free encyclopedia. \n\nSammi Davis (born Samantha Davis; 21 June 1964) is a British actress. \n\nShe gained considerable praise for her performance in Ken Russell's The Rainbow (1989).  She also had significant roles in Mike Hodges' A Prayer For The Dying and John Boorman's Hope and Glory (both 1987) as well as a leading role in the Emmy Award-winning American television series, Homefront (1991–1993). \n\nDavis was married to the director Kurt Voss, whom she later divorced...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6A6nYjHzjNkcsXskdxzHw2P7ROf.jpg", url:"https://themoviedb.org/person/3122"}}, {tmdbId:"3123", properties:{imdbId:"0004866", born:date('1972-05-19'), name:"Amanda De Cadenet", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pLlI568voL7dkFbUDIq4hFI0o0v.jpg", url:"https://themoviedb.org/person/3123"}}, {tmdbId:"567972", properties:{imdbId:"0907646", name:"Corban Walker", url:"https://themoviedb.org/person/567972"}}, {tmdbId:"140230", properties:{bornIn:"Cork, County Cork, Ireland", imdbId:"0865636", born:date('1929-11-21'), name:"Niall Toibin", bio:"Niall Toibin was born in Cork, Ireland in 1929.  Married Judy Kenny (1931-2001) in 1957.  Five children and six grand-children.  He has had an illustrious acting career spanning over four decades...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/15LWBrizDmvjeemc3gqPBYNpic8.jpg", url:"https://themoviedb.org/person/140230"}}, {tmdbId:"17024", properties:{imdbId:"0003728", born:date('1959-05-30'), name:"Owen Roe", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7ojmv5J9yohpvA8Jli84h412Ptj.jpg", url:"https://themoviedb.org/person/17024"}}, {tmdbId:"8184", properties:{imdbId:"0770788", born:date('1978-11-01'), name:"Mary Kate Schellhardt", url:"https://themoviedb.org/person/8184"}}, {tmdbId:"9778", properties:{bornIn:"Los Angeles, California, USA ", imdbId:"0001084", born:date('1969-06-15'), name:"Ice Cube", bio:"O'Shea Jackson Sr. , better known by his stage name Ice Cube, is an American rapper, record producer, actor, screenwriter, film producer, and director.  He began his career as a member of the hip-hop group C. I. A.  and later joined N. W. A...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9EghwabQ1wIQT4oN69qtPlzqGn4.jpg", url:"https://themoviedb.org/person/9778"}}, {tmdbId:"7400", properties:{bornIn:"Avonmouth, Bristol, England, UK", imdbId:"0262968", born:date('1964-02-25'), name:"Lee Evans", bio:"From Wikipedia, the free encyclopedia\n\nLee Evans (born 25 February 1964) is an English stand-up comedian, writer, actor and musician. \n\nDescription above from the Wikipedia article Lee Evans (comedian), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2BZeVCqFjYQ826ROkJaG4gehbmy.jpg", url:"https://themoviedb.org/person/7400"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"4275", properties:{bornIn:"Oran, Oranie, Algérie", imdbId:"0149260", born:date('1958-11-24'), name:"Alain Chabat", bio:"From Wikipedia, the free encyclopedia. \n\nAlain Chabat (born 24 November 1958) is a French actor and director who appeared in La Cité de la peur, French Twist, The Taste of Others and The Science of Sleep...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xRjymE6LIJd0useKWN2R1WgKDRy.jpg", url:"https://themoviedb.org/person/4275"}}, {tmdbId:"13689", properties:{bornIn:"Toulouse, Haute-Garonne, Midi-Pyrénées, France", imdbId:"0390458", born:date('1944-06-24'), name:"Ticky Holgado", bio:"Ticky Holgado (24 June 1944, in Toulouse – 22 January 2004, in Paris), pseudonym of Joseph Holgado, was a French actor and a frequent collaborator with Jean-Pierre Jeunet. \n\nWith Delicatessen (1991) by Jean-Pierre Jeunet and Marc Caro, Ticky Holgado saw his acting talent acknowledged.  Gérard Jugnot wrote for him the character of the beggar who meets the frame in the unemployment becoming NFA (played by Jugnot) in Une époque formidable (1990)...", died:date('2004-01-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cGT3k5bBs4OPwLfildORcK32zw0.jpg", url:"https://themoviedb.org/person/13689"}}, {tmdbId:"15854", properties:{bornIn:"Parma, Ohio, USA", imdbId:"0505971", born:date('1957-05-29'), name:"Ted Levine", bio:"Frank Theodore \"Ted\" Levine (born May 29, 1957) is an American actor.  He is known for his roles as Buffalo Bill in The Silence of the Lambs and Captain Leland Stottlemeyer in the television series Monk...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gFm6W1AM3LWKzAI3IypbgLLRyD4.jpg", url:"https://themoviedb.org/person/15854"}}, {tmdbId:"6886", properties:{bornIn:"Santa Monica, California, USA", imdbId:"0000207", born:date('1980-02-12'), name:"Christina Ricci", bio:"Precocious, outspoken child-teen starlet of the 1990s, Christina Ricci is an American actress and producer.  She is known for playing unconventional characters with a dark edge.  Ricci is the recipient of several accolades, including a National Board of Review Award for Best Supporting Actress and a Satellite Award for Best Actress, as well as Golden Globe, Primetime Emmy, Screen Actors Guild, and Independent Spirit Award nominations...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dzB58d6fNrTEi7nBAU1tySJc2at.jpg", url:"https://themoviedb.org/person/6886"}}, {tmdbId:"114470", properties:{bornIn:"Gary, Indiana, USA", imdbId:"0237164", born:date('1955-06-15'), name:"Polly Draper", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i6HVej6JGCimoS5CPXgYOkn94NX.jpg", url:"https://themoviedb.org/person/114470"}}, {tmdbId:"10695", properties:{bornIn:"Białystok, Poland", imdbId:"0001713", born:date('1970-06-04'), name:"Izabella Scorupco", bio:"Izabella Scorupco was born to Lech and Magdalena Skorupko in Białystok, Poland, in 1970.  When she was one year old, her parents separated, and she remained with her mother.  In 1978, they moved to Bredäng in Stockholm, Sweden, where Scorupco learned to speak Swedish, English and French. \n\nIn the late 1980s, Scorupco travelled throughout Europe working as a model, and appeared on the cover of Vogue...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Av7fykzXL701au42sTbhufHpwwv.jpg", url:"https://themoviedb.org/person/10695"}}, {tmdbId:"10696", properties:{bornIn:"Amstelveen, Noord-Holland, Netherlands", imdbId:"0000463", born:date('1964-11-05'), name:"Famke Janssen", bio:"A Dutch actress, director, screenwriter, and former fashion model.  She is known for playing the villainous Bond girl Xenia Onatopp in GoldenEye (1995), Jean Grey/Phoenix in the X-Men film series (2000–2013), and Lenore Mills in Taken (2008), and its sequel, Taken 2 (2012).  In 2008, she was appointed a Goodwill Ambassador for Integrity by United Nations.  She made her directorial debut with Bringing Up Bobby in 2011...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bdbGX6ac0FHuboQKpV1xdwkqOpB.jpg", url:"https://themoviedb.org/person/10696"}}, {tmdbId:"84213", properties:{bornIn:"Pratt, Kansas, USA", imdbId:"0267724", born:date('1952-11-14'), name:"Bill Farmer", bio:"From Wikipedia, the free encyclopedia. \n\nWilliam Farmer (born November 14, 1952 in Pratt, Kansas) is an American voice actor and comedian, best known for being the current voice of the Disney characters Goofy, Pluto and Horace Horsecollar. \n\nDescription above from the Wikipedia article William Farmer, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fIlqDsf9Ze31rVhShnR9dHgkYlD.jpg", url:"https://themoviedb.org/person/84213"}}, {tmdbId:"61983", properties:{bornIn:"Providence, Rhode Island, USA", imdbId:"0005189", born:date('1975-01-03'), name:"Jason Marsden", bio:"Jason Marsden (born January 3, 1975) is an American screen and voice actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3SR5TiCuTLebP00LTTQwDUSP14s.jpg", url:"https://themoviedb.org/person/61983"}}, {tmdbId:"93663", properties:{bornIn:"Riverside, California, USA", imdbId:"0005192", born:date('1975-10-16'), name:"Kellie Martin", bio:"Actress / Performer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l2SMcBisNoQjpSTq41VI8PoUSj2.jpg", url:"https://themoviedb.org/person/93663"}}, {tmdbId:"1932601", properties:{bornIn:"Newnan, Georgia, USA", born:date('1956-06-19'), name:"Doug Stone", bio:"Douglas Jackson Brooks, known professionally as Doug Stone, is an American country music singer.  He debuted in 1990 with the single \"I'd Be Better Off\", the first release from his 1990 self-titled debut album for Epic Records...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sgsAgQYktCmYlnCvdipksBLE4pE.jpg", url:"https://themoviedb.org/person/1932601"}}, {tmdbId:"1932602", properties:{name:"Kristy Young", url:"https://themoviedb.org/person/1932602"}}, {tmdbId:"1932603", properties:{name:"James Donadio", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1yo4lxwL9WVa4hAJZjTG3C1jv6e.jpg", url:"https://themoviedb.org/person/1932603"}}, {tmdbId:"174125", properties:{bornIn:"Georgia, USA", imdbId:"0387548", born:date('1950-01-01'), name:"Deborah Hobart", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rMhWqO6caRrrYVsstrib0Un4557.jpg", url:"https://themoviedb.org/person/174125"}}, {tmdbId:"44676", properties:{bornIn:"La Grande, Oregon, USA", imdbId:"0268428", born:date('1919-07-19'), name:"Dal McKennon", died:date('2009-07-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aqqathI67ECgRrvkfebU08OUHzm.jpg", url:"https://themoviedb.org/person/44676"}}, {tmdbId:"1248729", properties:{imdbId:"0167030", name:"Gloria Clokey", url:"https://themoviedb.org/person/1248729"}}, {tmdbId:"2083671", properties:{name:"Manny La Carruba", url:"https://themoviedb.org/person/2083671"}}, {tmdbId:"9012", properties:{bornIn:"Kingston upon Thames, Surrey, England, UK", imdbId:"0001538", born:date('1972-11-15'), name:"Jonny Lee Miller", bio:"Jonathan Lee Miller (AKA Jonny) is an English actor who gained notoriety with roles in Hackers and Trainspotting.   The son and grandson of Stage and Film actors, Jonny's first (uncredited) role was at age 10 in an episode of Doctor Who.   In 1996 he married Hacker's costar Angelina Jolie, divorcing just 18 months later.   He later married and had one child with actress-model Michele Hicks...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2f2mfib6TdGOjMd9jQl2NUruVMu.jpg", url:"https://themoviedb.org/person/9012"}}, {tmdbId:"5419", properties:{bornIn:"Sevran, France", imdbId:"0846548", born:date('1973-07-19'), name:"Saïd Taghmaoui", bio:"Saïd Taghmaoui (born July 19, 1973) is a French actor and screenwriter of Moroccan background.  One of his defining screen roles was that of Saïd in the award winning 1995 French film La Haine directed by Mathieu Kassovitz. However, Saïd has also appeared in a number of more recent English Language films, with roles such as the U. S...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kuxI08YpwQFGweIXK7TELknwexr.jpg", url:"https://themoviedb.org/person/5419"}}, {tmdbId:"5420", properties:{imdbId:"0315760", name:"Abdel Ahmed Ghili", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zCBgVA0B1ywgIQsMCPIhfnE7C60.jpg", url:"https://themoviedb.org/person/5420"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"67838", properties:{bornIn:"Mount Pleasant, New York, USA", imdbId:"0353238", born:date('1966-12-08'), name:"Marianne Hagan", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/14zTRzvemLUYpAmNWxqSmOQlcc0.jpg", url:"https://themoviedb.org/person/67838"}}, {tmdbId:"106171", properties:{bornIn:"Petsamo, Finland", imdbId:"0885533", born:date('1922-12-11'), name:"Maila Nurmi", bio:"Maila Elizabeth Syrjäniemi known professionally as Maila Nurmi, was a Finnish-American actress and television personality who created the campy 1950s character Vampira...", died:date('2008-01-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9J4KcIhdIONS1wj75YuHX9l1npg.jpg", url:"https://themoviedb.org/person/106171"}}, {tmdbId:"103080", properties:{imdbId:"0545803", born:date('1925-06-10'), name:"Paul Marco", died:date('2006-05-14'), url:"https://themoviedb.org/person/103080"}}, {tmdbId:"97824", properties:{bornIn:"Baltimore, Maryland, U.S.", imdbId:"0111926", born:date('1931-01-03'), name:"Conrad Brooks", bio:"Conrad Brooks was born as Conrad Biedrzycki on January 3, 1931 in Baltimore, Maryland.  He was the son of Polish immigrants, with a baker father, and had seven brothers and sisters.  At seventeen, along with his brothers Henry and Ted, he went to Hollywood, California.  Brooks first encountered legendary Grade-Z filmmaker Ed Wood in a donut shop.  Conrad first collaborated with Wood on the fifteen minute short movie \"Range Revenge. \" Brooks had three roles in Wood's \"Glen or Glenda...", died:date('2017-12-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ccuggOAsOHthPN1kdhDbhH69Xwn.jpg", url:"https://themoviedb.org/person/97824"}}, {tmdbId:"3201", properties:{bornIn:"Baton Rouge, Louisiana, USA", imdbId:"0898546", born:date('1960-07-05'), name:"Pruitt Taylor Vince", bio:"Pruitt Taylor Vince is an American actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jqC1v8tF92QcmkQycnaLSuJiQfl.jpg", url:"https://themoviedb.org/person/3201"}}, {tmdbId:"882", properties:{bornIn:"New York City, New York, USA", imdbId:"0000239", born:date('1977-07-01'), name:"Liv Tyler", bio:"Liv Rundgren Tyler is an American actress and model.  She is the daughter of Aerosmith's lead singer, Steven Tyler, and Bebe Buell, model and singer.  Tyler began a career in modeling at the age of 14, but after less than a year she decided to focus on acting.  She made her film debut in the 1994 film Silent Fall.  She then appeared in supporting roles in Empire Records (1995), Heavy (1996), and That Thing You Do! (1996)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d3JKakopz6r0VjW0PlC7DaQvbIb.jpg", url:"https://themoviedb.org/person/882"}}, {tmdbId:"1144665", properties:{bornIn:"Manila, Metro Manila, Philippines", imdbId:"0018208", born:date('1913-09-29'), name:"Madam Alex", bio:"Elizabeth Adams, also known as Madam Alex, was an American entrepreneur  who operated a Beverly Hills prostitution ring for two decades until she was arrested in 1988...", died:date('1995-07-08'), url:"https://themoviedb.org/person/1144665"}}, {tmdbId:"23958", properties:{bornIn:"Grass Valley, California, USA", imdbId:"0005438", born:date('1974-10-06'), name:"Jeremy Sisto", bio:"Jeremy Merton Sisto (born October 6, 1974) is an American actor, who had recurring roles as Billy Chenowith on the HBO series Six Feet Under and Detective Cyrus Lupo on Law &amp; Order on television and also starred in the films Jesus, Clueless, and Thirteen. \n\nDescription above from the Wikipedia article Jeremy Sisto, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1XfuASLjBhGOhJ4os7juRJot2we.jpg", url:"https://themoviedb.org/person/23958"}}, {tmdbId:"4688", properties:{bornIn:"New York City, New York, USA", imdbId:"0001650", born:date('1970-03-20'), name:"Michael Rapaport", bio:"American actor and a comedian Michael David Rapaport has acted in more than forty films since the early 1990s.  For his television credits he's best known for his roles on the television series Boston Public, Prison Break, Friends, and The War at Home.  \n\nRapaport has appeared in both dramatic and comedic roles on film and television.  His movie performances include “Metro”, “Deep Blue Sea”, and “Higher Learning”...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/49Q5oY4GQsEF21FvRTOsDSPS6Rm.jpg", url:"https://themoviedb.org/person/4688"}}, {tmdbId:"1147314", properties:{imdbId:"0099478", name:"Sam Bould", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i80soJLtWgKj7zSc6klVeDv1nzP.jpg", url:"https://themoviedb.org/person/1147314"}}, {tmdbId:"10875", properties:{bornIn:"North Vancouver, British Columbia, Canada", imdbId:"0948123", born:date('1972-09-04'), name:"Françoise Yip", bio:"Françoise Fong-Wa Yip ( born September 4, 1972) is a Canadian actress.  Her best-known roles are the redeemable bad girls in Jackie Chan's Rumble in the Bronx and Jet Li's Black Mask.  The critical and financial success of Rumble in the Bronx (and its subsequent number-one box-office bow in the United States) made Yip an instant success and garnered her two Hong Kong Film Award nominations.  She continued to do movies and star in TV, but her roles were less known or temporary...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2fBymfOzhw8wB6wHFHbxulNysB4.jpg", url:"https://themoviedb.org/person/10875"}}, {tmdbId:"44922", properties:{bornIn:"Hong Kong, British Crown Colony [now China]", imdbId:"0876603", born:date('1933-03-30'), name:"Bill Tung", bio:"Bill Tung Biu (March 30, 1933 in Hong Kong — February 22, 2006) was a Hong Kong actor and horse racing commentator.  Tung started off as a horse jockey with his family racing horse stable.  He was then recruited to become a horse racing commentator.  Due to his fame, he was invited to act in many movies from 1949 to 1996, many of them with Jackie Chan during the 1980s and 1990s.  Some of his famous roles includes playing Inspector Bill Wong in Police Story, and playing a wizard in Ghostly Vixen...", died:date('2006-02-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z8tQQpjKjjgP6Fv9SXlhbP9EZkZ.jpg", url:"https://themoviedb.org/person/44922"}}, {tmdbId:"81108", properties:{bornIn:"Tokyo, Japan", imdbId:"0361757", born:date('1940-02-29'), name:"Yoshio Harada", bio:"​From Wikipedia, the free encyclopedia.   \n\nYoshio Harada (born February 29, 1940) is a Japanese actor.  A veteran of over 80 films, he has twice been nominated for the Best Actor Japanese Academy Award.  He won the award for best supporting actor at the 11th Yokohama Film Festival for Dotsuitarunen and Kiss yori kantan. \n\nDescription above from the Wikipedia article Yoshio Harada, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2011-07-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uTOKwsTcqVzKZsQatEWGBrOq2U0.jpg", url:"https://themoviedb.org/person/81108"}}, {tmdbId:"15533", properties:{bornIn:"Paris, France", imdbId:"0553648", born:date('1966-01-12'), name:"Olivier Martinez", bio:"From Wikipedia, the free encyclopedia. \n\nOlivier Martinez (born January 12, 1966) is a French film actor.  He became known after roles in several French films, and has also appeared in Hollywood-produced features, including Unfaithful. \n\nDescription above from the Wikipedia article Olivier Martinez, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vhk9DkoudRDyLUbcmhR1KhW9bjn.jpg", url:"https://themoviedb.org/person/15533"}}, {tmdbId:"24816", properties:{bornIn:"Paris, France", imdbId:"0034079", born:date('1944-12-01'), name:"Pierre Arditi", bio:"​From Wikipedia, the free encyclopedia\n\nPierre Arditi (born 1 December 1944) is an award-winning French film and stage actor.  He is the brother of French actress Catherine Arditi. \n\nHe has often played romantic, womanizing roles, similar to those played by Marcello Mastroianni. \n\nIn 1987 he won a César Award for Best Actor in a Supporting Role for his role in Mélo, and in 1994, a César Award for Best Actor for his role in Smoking/No Smoking...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kLvyrJkfcGUKzn3rHI0SYX5uPwj.jpg", url:"https://themoviedb.org/person/24816"}}, {tmdbId:"237613", properties:{imdbId:"0153381", name:"Hetta Charnley", url:"https://themoviedb.org/person/237613"}}, {tmdbId:"13637", properties:{bornIn:"London, England, UK", imdbId:"0001058", born:date('1933-05-23'), name:"Joan Collins", bio:"Joan Henrietta Collins, DBE (born 23 May 1933) is an English actress, author, and columnist.  Flamboyant in her personal life, she is perhaps best known in the United States for the role of the equally flamboyant Alexis Colby in the long running television series Dynasty, as well as being a favorite of Star Trek fans for her appearance as Edith Keeler in the Star Trek episode \"The City on the Edge of Forever\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jmXqOnp2xBDl2EMuU5Rj39uHzUQ.jpg", url:"https://themoviedb.org/person/13637"}}, {tmdbId:"18657", properties:{bornIn:"Chapel Hill, North Carolina, USA", imdbId:"0391274", born:date('1971-05-23'), name:"Laurel Holloman", bio:"Laurel Holloman (born May 23, 1971) is an American actress and painter, best known for her roles in The Incredibly True Adventure of Two Girls in Love as well as on Angel and The L Word...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/og4qIp8zOdo6TMGtIe30AsK9Y2B.jpg", url:"https://themoviedb.org/person/18657"}}, {tmdbId:"82105", properties:{bornIn:"San Francisco, U.S.A.", imdbId:"0601548", born:date('1851-04-10'), name:"Maggie Moore", bio:"​From Wikipedia, the free encyclopedia\n\nMaggie Moore was the stage name of the American-Australian actor Margaret Virginia Sullivan (10 April 1851 - March 15, 1926). \n\nSullivan was born at San Francisco, U. S. A. , in 1851, and began her theatrical career at an early age.  She established a local reputation, and having married J.  C.  Williamson came with him to Australia in 1874.  They opened in Melbourne on 1 August in Struck Oil and were immediately successful...", died:date('1926-03-15'), url:"https://themoviedb.org/person/82105"}}, {tmdbId:"103680", properties:{imdbId:"0821311", name:"Kate Stafford", url:"https://themoviedb.org/person/103680"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"69301", properties:{bornIn:"Savannah, Georgia, USA", imdbId:"0769136", born:date('1984-12-25'), name:"Hal Scardino", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q8TX9vJfLSzYDztSIDmz1ao002t.jpg", url:"https://themoviedb.org/person/69301"}}, {tmdbId:"69302", properties:{bornIn:"Upland, California, USA", imdbId:"0514342", born:date('1969-03-01'), name:"Litefoot", bio:"Gary Paul Davis (born March 1, 1969), better known by his stage name Litefoot, is a Native American rapper and the founder of the Red Vinyl record label.  He also portrayed Little Bear in the movie The Indian in the Cupboard.                               Description above from the Wikipedia article Litefoot, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lZirENb3WkQarkkgKDs0qyjOltH.jpg", url:"https://themoviedb.org/person/69302"}}, {tmdbId:"67849", properties:{bornIn:"Sherman Oaks, California, USA", imdbId:"0001581", born:date('1986-06-13'), name:"Mary-Kate Olsen", bio:"Mary-Kate Olsen is an American actress, producer, author and fashion designer.  She made her career debut in 1987 alongside her twin sister Ashley Olsen in the television series Full House.  Following the huge success of Full House in America, Mary-Kate and Ashley established a successful career starring in television and film roles...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ohsjU66AUS5qkymN9E5VDLlBQ0W.jpg", url:"https://themoviedb.org/person/67849"}}, {tmdbId:"67848", properties:{bornIn:"Sherman Oaks, California, USA", imdbId:"0001580", born:date('1986-06-13'), name:"Ashley Olsen", bio:"Ashley Olsen is an American actress, producer, author and fashion designer.  She made her career debut in 1987 alongside her twin sister Mary-Kate Olsen in the television series Full House.  Following the huge success of Full House in America, they both established a successful career starring in television and film roles...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/suf5kWfRYErCp6D5YnOZlpGA8dH.jpg", url:"https://themoviedb.org/person/67848"}}, {tmdbId:"11152", properties:{bornIn:"San Francisco, California, USA", imdbId:"0158632", born:date('1968-12-05'), name:"Margaret Cho", bio:"Margaret Cho (born December 5, 1968) is an American comedian, fashion designer, actress, author, and recording artist.  Cho is best known for her stand-up routines, through which she critiques social and political problems, especially those pertaining to race and sexuality.  She has also directed and appeared in music videos and has her own clothing line...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aigOMnmiKt06CXx1g0celTbcuG7.jpg", url:"https://themoviedb.org/person/11152"}}, {tmdbId:"54455", properties:{bornIn:"Durango - Colorado - USA", imdbId:"0347957", born:date('1978-10-15'), name:"Devon Gummersall", bio:"From Wikipedia, the free encyclopedia. \n\nDevon Ryan Gummersall (born October 15, 1978) is an American actor, writer, and television and film director, perhaps best known for acting on the cult classic television show My So-Called Life...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yCMfsk2sQCnAmcEda0DmMQAsXbC.jpg", url:"https://themoviedb.org/person/54455"}}, {tmdbId:"12052", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0000569", born:date('1972-09-27'), name:"Gwyneth Paltrow", bio:"Paltrow made her acting debut on stage in 1990 and started appearing in films in 1991.  She gained early notice for her work in films such as Se7en (1995), Emma (1996), in which she played the title role, and Sliding Doors (1998).  She garnered worldwide recognition through her performance in Shakespeare in Love (1998), for which she won the Academy Award for Best Actress, a Golden Globe Award and two Screen Actors Guild Awards, for Outstanding Lead Actress and as a member of the Outstanding Cast...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/slPWN0VvYJtNOEuxlFSsXSNQMaF.jpg", url:"https://themoviedb.org/person/12052"}}, {tmdbId:"76526", properties:{bornIn:"Cheraw, South Carolina, USA", imdbId:"0861513", born:date('1953-06-12'), name:"David Thornton", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pNOWmEQWEI2gdW6hoVPO2C8PN98.jpg", url:"https://themoviedb.org/person/76526"}}, {tmdbId:"2133", properties:{bornIn:"Queens, New York City, New York, USA", imdbId:"0000539", born:date('1968-12-22'), name:"Dina Meyer", bio:"Dina Meyer is an American film and television actress, best known for her roles as Dizzy Flores in Starship Troopers and Detective Allison Kerry in the Saw films.  She portrays Mrs.  Hong as a recurring guest star on ABC's Scoundrels.  Conflicting information on the Internet gives her birthdate as both December 22, 1968 and June 15, 1969.  However Ms.  Meyer has confirmed on Twitter that her birthdate is December 22...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bKte4cIXI1aQat8JLVNONZE4Y2.jpg", url:"https://themoviedb.org/person/2133"}}, {tmdbId:"60949", properties:{bornIn:"San Francisco, California, USA", imdbId:"0001705", born:date('1963-10-31'), name:"Rob Schneider", bio:"Robert Michael Schneider (born October 31, 1963) is an American actor, comedian, screenwriter, and director.  A stand-up comic and veteran of the NBC sketch comedy series Saturday Night Live, he went on to a career in feature films, including starring roles in the comedy films Deuce Bigalow: Male Gigolo, The Animal, The Hot Chick, The Benchwarmers, and Grown Ups...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kVHNFDOGDrC3LjDyYf5RaCd6auK.jpg", url:"https://themoviedb.org/person/60949"}}, {tmdbId:"8537", properties:{bornIn:"Brisbane, Australia", imdbId:"0404993", born:date('1948-05-21'), name:"Jonathan Hyde", bio:"Jonathan Hyde (born 21 May 1948) is an Australian-born English actor, well known for his roles as J.  Bruce Ismay, the managing director of the White Star Line in Titanic, Egyptologist Allen Chamberlain in The Mummy and Sam Parrish/Van Pelt, the hunter in Jumanji.  He is married to the Scottish soprano Isobel Buchanan.  They have two daughters, one of which is the actress Georgia King. \n\nHyde was born in Brisbane, Queensland.  He is a member of the Royal Shakespeare Company...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1jYyW3B5omvMTVfEswqQQBrHN2.jpg", url:"https://themoviedb.org/person/8537"}}, {tmdbId:"205", properties:{bornIn:"Point Pleasant, New Jersey, USA", imdbId:"0000379", born:date('1982-04-30'), name:"Kirsten Dunst", bio:"Kirsten Caroline Dunst (born April 30, 1982) is an American actress, singer and model.  She made her film debut in Oedipus Wrecks, a short film directed by Woody Allen for the anthology New York Stories (1989).  At the age of 12, Dunst gained widespread recognition playing the role of vampire Claudia in Interview with the Vampire (1994), a performance for which she was nominated for a Golden Globe Award for Best Supporting Actress.  The same year she appeared in Little Women, to further acclaim...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5dI5s8Oq2Ook5PFzTWMW6DCXVjm.jpg", url:"https://themoviedb.org/person/205"}}, {tmdbId:"145151", properties:{imdbId:"0682300", born:date('1982-10-23'), name:"Bradley Pierce", bio:"Bradley Pierce began acting at age 6 and has since appeared in various projects ranging from commercial and voiceover to television and film.  He is best known for his role as Peter in the 1995 film, Jumanji, as well as voicing Chip in Disney’s original Beauty and the Beast.  Other notable roles include voicing Tails in the Saturday morning cartoon series, Sonic the Hedgehog, and a starring role in The Borrowers with John Goodman...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j6iW0vVA23GQniAPSYI6mi4hiEW.jpg", url:"https://themoviedb.org/person/145151"}}, {tmdbId:"56871", properties:{bornIn:"Tacoma, Washington, USA", imdbId:"0005516", born:date('1964-08-25'), name:"Blair Underwood", bio:"Blair Underwood (born August 25, 1964) is an American television and film actor.  He is perhaps best known as headstrong attorney Jonathan Rollins from the NBC legal drama L. A.  Law, a role he portrayed for seven years.  He has gained critical acclaim throughout his career, receiving numerous Golden Globe Award nominations, three NAACP Image Awards and 1 Grammy Award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2aDLa2bU2PevNmnCK3IOBYlh3BY.jpg", url:"https://themoviedb.org/person/56871"}}, {tmdbId:"21967", properties:{imdbId:"0332489", name:"Samuel Gould", url:"https://themoviedb.org/person/21967"}}, {tmdbId:"10130", properties:{imdbId:"0446070", born:date('1970-10-02'), name:"Catherine Kellner", bio:"An American character actress, perhaps best known for appearing in Daft Punk's music-video for their song Da Funk...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uBCxiv5z4Y3o7600GffU8BdPROu.jpg", url:"https://themoviedb.org/person/10130"}}, {tmdbId:"1052883", properties:{imdbId:"0062263", name:"Jonathan Baumbach", url:"https://themoviedb.org/person/1052883"}}, {tmdbId:"10672", properties:{bornIn:"Bahawalpur, Pakistan", imdbId:"0539562", born:date('1952-11-13'), name:"Art Malik", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hZmb9wWsteP21QA29PHEk6NlOh3.jpg", url:"https://themoviedb.org/person/10672"}}, {tmdbId:"24618", properties:{bornIn:"London, England, UK", imdbId:"0046469", born:date('1975-05-01'), name:"Paloma Baeza", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iXT3kKAAXwbaeTumswzje8chq8n.jpg", url:"https://themoviedb.org/person/24618"}}, {tmdbId:"57387", properties:{bornIn:"West Orange, New Jersey, USA", imdbId:"0280559", born:date('1977-07-25'), name:"Leo Fitzpatrick", bio:"​From Wikipedia, the free encyclopedia\n\nLeonardo Aurellio Randy \"Leo\" Fitzpatrick (born August 10, 1978) is an American actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iZG9G5DstChbwlL9mAQ727heZX.jpg", url:"https://themoviedb.org/person/57387"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"57388", properties:{bornIn:"Regno Unito", imdbId:"1344991", name:"Sarah Henderson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nj7tHeFSGrdOEP72ofsxNFy7eVh.jpg", url:"https://themoviedb.org/person/57388"}}, {tmdbId:"57389", properties:{bornIn:"London, England ", imdbId:"0682399", born:date('1975-03-21'), name:"Justin Pierce", bio:"​From Wikipedia, the free encyclopedia.   \n\nJustin Charles Pierce (March 21, 1975 – July 10, 2000) was an English-born American actor and professional skateboarder. \n\nDescription above from the Wikipedia article Justin Pierce, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2000-07-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tBOf7ySDq5ETGxLcsXfoYM853Gg.jpg", url:"https://themoviedb.org/person/57389"}}, {tmdbId:"131299", properties:{imdbId:"0150954", name:"Joseph Chan", url:"https://themoviedb.org/person/131299"}}, {tmdbId:"34923", properties:{bornIn:"Maebashi, Gunma Prefecture, Japan", imdbId:"0848968", born:date('1962-11-14'), name:"Atsuko Tanaka", bio:"Atsuko Tanaka is a Japanese voice actress.  Her deep and sultry voice is often used to portray villainesses and mature female characters...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tWl7MGGU3qGGwNDklWIN40eF5CU.jpg", url:"https://themoviedb.org/person/34923"}}, {tmdbId:"40451", properties:{bornIn:"Tokyo Prefecture, Japan", imdbId:"0960033", born:date('1959-11-24'), name:"Akio Ôtsuka", bio:"Akio Otsuka is a Japanese voice actor affiliated with Mausu Promotion.  He is the son of fellow voice actor Chikao Otsuka.  In February 2005, he married voice actress Yoko Soumi, but later divorced her in 2009...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fBgebh93VAJC9lIVdB8JmFtdixL.jpg", url:"https://themoviedb.org/person/40451"}}, {tmdbId:"83933", properties:{imdbId:"1563697", name:"Yutaka Nakano", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3dkyUVJuU6uSlWA5kkAcw8KPehv.jpg", url:"https://themoviedb.org/person/83933"}}, {tmdbId:"88919", properties:{bornIn:"Aitolahti, Finland", imdbId:"0374829", born:date('1964-07-19'), name:"Heikki Hela", url:"https://themoviedb.org/person/88919"}}, {tmdbId:"88913", properties:{bornIn:"Finland", imdbId:"0434716", born:date('1963-01-01'), name:"Timo Kahilainen", bio:"Timo Eero Kahilainen is a Finnish actor, musician, writer and producer best know for his work on the comedic TV and movies series Kummeli...", url:"https://themoviedb.org/person/88913"}}, {tmdbId:"88918", properties:{bornIn:"Sääminki, Finland", imdbId:"0798628", born:date('1954-04-27'), name:"Heikki Silvennoinen", url:"https://themoviedb.org/person/88918"}}, {tmdbId:"143123", properties:{imdbId:"0878168", name:"Mari Turunen", url:"https://themoviedb.org/person/143123"}}, {tmdbId:"79020", properties:{imdbId:"0563902", name:"Scott McAfee", url:"https://themoviedb.org/person/79020"}}, {tmdbId:"71447", properties:{imdbId:"0404532", born:date('1981-06-23'), name:"Candace Hutson", bio:"Candace Hutson (born June 23, 1980) is an American actress best known as the voice of Cera the Triceratops in The Land Before Time film series from the original movie to The Land Before Time IV: Journey Through the Mists. \n\nShe was also a regular in the television situation comedy Evening Shade.  She voiced Mattie the Mouse in Reader Rabbit.  She also appeared in the film Dolly Dearest...", url:"https://themoviedb.org/person/71447"}}, {tmdbId:"79021", properties:{bornIn:"Long Beach, California, USA", imdbId:"0389533", born:date('1985-10-10'), name:"Heather Hogan", bio:"Born and raised in Long Beach, California, Heather first became interested in acting by tagging along with older brother Jeremy to auditions.  Booking her first job at the age of five, she then began appearing in numerous theatre productions throughout Los Angeles and Orange County.  Her love for theatre inspired her desire to attend the Orange County High School of Arts where she studied acting, music and dance daily...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fKgZ9EGgr7mUFJ76LS6dIeTR1PB.jpg", url:"https://themoviedb.org/person/79021"}}, {tmdbId:"990400", properties:{imdbId:"0289439", name:"Victoria Foyt", url:"https://themoviedb.org/person/990400"}}, {tmdbId:"69697", properties:{imdbId:"0047976", born:date('1961-11-04'), name:"Jon Robin Baitz", url:"https://themoviedb.org/person/69697"}}, {tmdbId:"175081", properties:{imdbId:"0099029", name:"Savannah Smith Boucher", url:"https://themoviedb.org/person/175081"}}, {tmdbId:"6941", properties:{bornIn:"San Diego, California, USA", imdbId:"0000139", born:date('1972-08-30'), name:"Cameron Diaz", bio:"Cameron Michelle Diaz (born August 30, 1972) is an American former actress, author, producer and model.  She frequently appeared in comedies throughout her career, while also earning critical recognition in dramatic films.  Her accolades include four Golden Globe Award nominations, three Screen Actors Guild Award nominations, and a New York Film Critics Award.  In 2013, she was named the highest-paid actress over 40 in Hollywood.  As of 2018, the U. S...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tQNnnyIUfUcP1uXRButS3xcwBmP.jpg", url:"https://themoviedb.org/person/6941"}}, {tmdbId:"12260", properties:{bornIn:"Long Island, New York, USA", imdbId:"0253035", born:date('1965-02-20'), name:"Ron Eldard", bio:"From Wikipedia, the free encyclopedia. \n\nRonald Jason \"Ron\" Eldard (born February 20, 1965) is an American actor.  Eldard made his film debut in the 1989 comedy True Love, written and directed by Nancy Savoca, and co-starring Annabella Sciorra.  This film won the Grandy Jury Prize at the Sundance Film Festival.  Eldard has performed on Broadway in critically acclaimed productions of On the Waterfront, Biloxi Blues, Bash: Latterday Plays, and Death of a Salesman...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5Ww9aaJZjg1N2S6zpJkrZmQVMEI.jpg", url:"https://themoviedb.org/person/12260"}}, {tmdbId:"84093", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0560093", born:date('1984-03-14'), name:"Liesel Matthews", bio:"From Wikipedia, the free encyclopedia.   Liesel Anne Pritzker (born March 14, 1984), stage name Liesel Matthews, is an American former child actress and heiress to the Hyatt Hotels fortune.  She starred as Sara Crewe in A Little Princess, a 1995 film adaptation of the Frances Hodgson Burnett classic, and was a member of the first family in Air Force One. \n\nDescription above from the Wikipedia article Liesel Pritzker, licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l0T12SyeOOFeP0lgmDSMdt85hS9.jpg", url:"https://themoviedb.org/person/84093"}}, {tmdbId:"15498", properties:{bornIn:"East Wall, Dublin, Republic of Ireland", imdbId:"0192377", born:date('1961-06-02'), name:"Liam Cunningham", bio:"Liam Cunningham (born 2 June 1961) is an Irish actor.  He has appeared in numerous film and television productions including A Little Princess, First Knight, Jude and the BBC One science-fiction drama series Outcasts.  Description above from the Wikipedia article Liam Cunningham (actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ljmFT9zYqh4k2bmEcNU6rxoE7fW.jpg", url:"https://themoviedb.org/person/15498"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"34407", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0005404", born:date('1962-08-25'), name:"Rusty Schwimmer", bio:"An American film and television actress and singer.  Her most prominent role so far is that of Barbara Ludzinski on The Guardian. \n\nAmong her movie appearances are those as Joey B in Jason Goes to Hell: The Final Friday, Mrs.  Thornton in Twister, Mrs Pendleton in Amistad, Alice in EDtv, Irene \"Big Red\" Johnson in The Perfect Storm, Big Betty in North Country and Amelia Minchin in A Little Princess...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/15vtrhJCg9tXnedsO5CYfqZ055b.jpg", url:"https://themoviedb.org/person/34407"}}, {tmdbId:"2229", properties:{bornIn:"Miami, Florida, USA", imdbId:"0001416", born:date('1959-03-23'), name:"Catherine Keener", bio:"An American actress.  She has been nominated for the Academy Award for Best Supporting Actress twice, for Being John Malkovich (1999) and Capote (2005). \n\nDescription above from the Wikipedia article Catherine Keener, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vcFhHN9rnSym73Nr0bnRJOVnc9u.jpg", url:"https://themoviedb.org/person/2229"}}, {tmdbId:"18916", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0640413", born:date('1963-11-15'), name:"Kevin J. O'Connor", bio:"An American actor.  He is known for playing character roles in major studio films such as There Will Be Blood, The Mummy, Clive Barker’s Lord of Illusions, F/X2 and Van Helsing.  He is a favorite of writer/director Stephen Sommers, who usually casts him in his films. \n\nDescription above from the Wikipedia article Kevin J.  O'Connor (actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nlsRZBGlfZTmy0iEjCr5JFTorgb.jpg", url:"https://themoviedb.org/person/18916"}}, {tmdbId:"56440", properties:{imdbId:"0490225", name:"Joseph Latimore", bio:"Joseph Latimore is an actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xhHgv4btqWwjDgqNIrHjiYJBhmq.jpg", url:"https://themoviedb.org/person/56440"}}, {tmdbId:"56441", properties:{bornIn:"Keshena, Wisconsin, U.S.", imdbId:"0869721", born:date('1960-06-04'), name:"Sheila Tousey", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/axPhHFAX1qEmtLF0PDfk5lDEsoX.jpg", url:"https://themoviedb.org/person/56441"}}, {tmdbId:"83746", properties:{bornIn:"Izumo, Shimane, Japan", imdbId:"0261968", born:date('1966-12-18'), name:"Makiko Esumi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/svfSzV4ktZDAqh2jntnCP6fa1sv.jpg", url:"https://themoviedb.org/person/83746"}}, {tmdbId:"19590", properties:{imdbId:"0619822", born:date('1955-05-27'), name:"Takashi Naitô", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zfs63NZKNG3Uy6WqqXSQWYMQXKZ.jpg", url:"https://themoviedb.org/person/19590"}}, {tmdbId:"13275", properties:{bornIn:"Yokohama, Kanagawa Prefecture, Japan", imdbId:"0038355", born:date('1973-11-27'), name:"Tadanobu Asano", bio:"Tadanobu Asano, born Tadanobu Sato (born November 27, 1973) is a Japanese actor.  He is known for his roles as Dragon Eye Morrison in Electric Dragon 80. 000 V, Kakihara in Ichi the Killer, Mamoru Arita in Bright Future, Hattori Genosuke in Zatoichi, Kenji in Last Life in the Universe, Aman in Survive Style 5+, Ayano in The Taste of Tea, and Temudjin in Mongol.  Most recently, Asano appeared as Hogun in the film Thor, based on the Marvel Comics character...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sL0H5my3PAc208n3yu64TO3ug12.jpg", url:"https://themoviedb.org/person/13275"}}, {tmdbId:"553119", properties:{imdbId:"0440581", name:"Gohki Kashiyama", url:"https://themoviedb.org/person/553119"}}, {tmdbId:"175540", properties:{name:"Richard Chaim", url:"https://themoviedb.org/person/175540"}}, {tmdbId:"1318776", properties:{bornIn:"Shanghai, China", imdbId:"2662404", born:date('1968-11-08'), name:"Ying Huang", url:"https://themoviedb.org/person/1318776"}}, {tmdbId:"1629619", properties:{name:"Richard Troxell", url:"https://themoviedb.org/person/1629619"}}, {tmdbId:"1655439", properties:{name:"Ning Liang", url:"https://themoviedb.org/person/1655439"}}, {tmdbId:"11662", properties:{bornIn:"Orange, California, USA", imdbId:"0005134", born:date('1970-04-25'), name:"Jason Lee", bio:"Jason Michael Lee (born April 25, 1970) is an American actor and skateboarder known for his role as the title character on the NBC television series My Name is Earl, his portrayal of Syndrome in the film The Incredibles, his role as Dave Seville in the Alvin and the Chipmunks films, and his work with director Kevin Smith. \n\nDescription above from the Wikipedia article Jason Lee (actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/64tEXo3xR9IFXsIJKSlJ2LUrrEA.jpg", url:"https://themoviedb.org/person/11662"}}, {tmdbId:"4174", properties:{bornIn:"Twickenham, Middlesex, England, UK", imdbId:"0001231", born:date('1971-12-17'), name:"Claire Forlani", bio:"Claire Antonia Forlani (born 17 December 1971) is an English actress.  She became known in the mid-1990s for her leading role in the film Mallrats, and in the Jean-Michel Basquiat 1996 biopic Basquiat, later in 1998, she achieved wide recognition for starring in the fantasy romance film Meet Joe Black.  Other notable films include Boys and Girls (2000), The Medallion (2003) and In the Name of the King (2007)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5OFW8T5UN45eyou9Tfw2zt80l8G.jpg", url:"https://themoviedb.org/person/4174"}}, {tmdbId:"45389", properties:{imdbId:"0668150", name:"Vivian Paxton", url:"https://themoviedb.org/person/45389"}}, {tmdbId:"45387", properties:{bornIn:"Portland, Oregon, USA", imdbId:"0840066", born:date('1939-07-13'), name:"Claudette Sutherland", url:"https://themoviedb.org/person/45387"}}, {tmdbId:"45390", properties:{bornIn:"Passaic - New Jersey - USA", imdbId:"0650355", born:date('1963-01-01'), name:"Michael Ornstein", bio:"Ornstein studied acting as a child at the American Academy of Dramatic Arts in New York City, and later studied under Stella Adler.  After high school, he enrolled in the Mason Gross School of the Arts.  He quit after his first year and moved to New York City to begin working professionally. \n\nOrnstein's first film credit was in Crossing Delancey, where he played the minor character \"Mickey\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hZoD2myizEpkM7FoB7FQKbqBucd.jpg", url:"https://themoviedb.org/person/45390"}}, {tmdbId:"45388", properties:{imdbId:"0058786", name:"Cal Bartlett", url:"https://themoviedb.org/person/45388"}}, {tmdbId:"1066795", properties:{imdbId:"0559169", name:"Daniel Matmor", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/TQzOG2gd6fBr1NquKmQJ8tNfj7.jpg", url:"https://themoviedb.org/person/1066795"}}] AS row
