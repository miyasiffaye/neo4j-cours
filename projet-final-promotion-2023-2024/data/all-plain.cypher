UNWIND [{tmdbId:"18514", properties:{bornIn:"Rome, Lazio, Italy", imdbId:"0000782", born:date('1975-09-20'), name:"Asia Argento", bio:"Asia Argento (born Aria Maria Vittoria Rossa Argento; 20 September 1975) is an Italian actress, singer, model, and director. \n\nHer mother is actress Daria di Nicolodi and her father is Dario de Argento, an Italian film director, producer and screenwriter, well known for his work in the Italian giallo genre and for his influence on modern horror and slasher movies.  Her maternal great-grandfather was composer Alfredo Casella...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/krvxUFSgLeYpdDXmFAANNv5fzKI.jpg", url:"https://themoviedb.org/person/18514"}}, {tmdbId:"49424", properties:{bornIn:"Oakland, California, USA", imdbId:"0329640", born:date('1971-02-04'), name:"Michael A. Goorjian", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3ReUquoMVEf01eu3xLWVSxhHHvr.jpg", url:"https://themoviedb.org/person/49424"}}, {tmdbId:"35219", properties:{bornIn:"Los Angeles - California - USA", imdbId:"0123553", born:date('1955-08-03'), name:"Corey Burton", bio:"Corey Burton is an American voice actor known as the current voice of Ludwig Von Drake, Captain Hook and many other characters for numerous Disney projects, as well as several central characters for numerous Star Wars projects.  He has worked on numerous cartoon series for major networks such as Cartoon Network and has worked extensively with The Walt Disney Company and Disney theme parks...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wcpFwdL7m01cZoBJiUSMQVakK2G.jpg", url:"https://themoviedb.org/person/35219"}}, {tmdbId:"9349", properties:{imdbId:"0204424", name:"Dane A. Davis", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/16RaENd5PxeXs6XE4yrnCPjg4Gz.jpg", url:"https://themoviedb.org/person/9349"}}, {tmdbId:"16442", properties:{bornIn:"Pamplona, Navarra, Spain", imdbId:"0632385", born:date('1972-02-14'), name:"Najwa Nimri", bio:"​Najwa Nimri is a Spanish film and television actress, singer and music composer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vs4OFxsN3s1dPacyp19JKRkJlb9.jpg", url:"https://themoviedb.org/person/16442"}}, {tmdbId:"16948", properties:{bornIn:"A Coruña, Galicia, Spain", imdbId:"0637181", born:date('1958-09-17'), name:"Nancho Novo", bio:"Venancio Manuel Jesús Novo Cid-Fuentes (A Coruña, September 17, 1958), is a spanish actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3RWTU975GK1cnUyd9vP7o5Recn6.jpg", url:"https://themoviedb.org/person/16948"}}, {tmdbId:"16949", properties:{imdbId:"0883754", name:"Maru Valdivielso", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gWmBEuZoDcdLQDFbLNa6XAT6hHG.jpg", url:"https://themoviedb.org/person/16949"}}, {tmdbId:"22123", properties:{bornIn:"Panama City, Panama", imdbId:"0108287", born:date('1980-04-26'), name:"Jordana Brewster", bio:"Jordana Brewster (born April 26, 1980) is an American actress.  She began her acting career with an appearance in the soap opera All My Children (1995).  After that, she joined the cast of As the World Turns (1995–2001), as a recurring role, Nikki Munson.  She was later cast as one of the main characters in her first film feature film The Faculty (1998).  Her role brought her to the attention of a much wider audience...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8VzFsSfT7NnMGyH5JQBQdTxDHcO.jpg", url:"https://themoviedb.org/person/22123"}}, {tmdbId:"20387", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0245112", born:date('1977-09-25'), name:"Clea DuVall", bio:"Clea Helen D'Etienne DuVall is an American actress, writer, producer and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1NQRn0xhWmvfR2U4aOTHAoEwFSQ.jpg", url:"https://themoviedb.org/person/20387"}}, {tmdbId:"25872", properties:{bornIn:"Vancouver, British Columbia, Canada", imdbId:"0364977", born:date('1976-11-20'), name:"Laura Harris", bio:"From Wikipedia, the free encyclopedia.  Laura Elizabeth Harris (born November 20, 1976) is a Canadian actress. \n\nDescription above from the Wikipedia article Laura Harris, licensed under BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bDC00JbT0wWJyMbMeZps647vAuL.jpg", url:"https://themoviedb.org/person/25872"}}, {tmdbId:"2299", properties:{bornIn:"Saint Paul, Minnesota, USA", imdbId:"0001326", born:date('1978-07-21'), name:"Josh Hartnett", bio:"Joshua Daniel \"Josh\" Hartnett (born July 21, 1978) is an American actor and producer.  He first came to audiences' attention in 1997 as \"Michael Fitzgerald\" in the television series Cracker.  He made his feature film debut in 1998, co-starring with Jamie Lee Curtis in Halloween H20: 20 Years Later.  That same year, he received an MTV Movie Award nomination for Best Breakthrough Male Performance...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kTcv48SdlNJ9ZsSMUKRkvDRrljC.jpg", url:"https://themoviedb.org/person/2299"}}, {tmdbId:"60739", properties:{bornIn:"Cleveland, Ohio, USA", imdbId:"0815718", born:date('1967-02-20'), name:"Kath Soucie", bio:"From Wikipedia, the free encyclopedia. \n\nKatherine Elaine Soucie ( born February 20, 1967), is an American voice actress.  She is sometimes credited as Kath Soucie or Kath Eleanor Soucie. \n\nDescription above from the Wikipedia article Kath Soucie, licensed under CC-BY-SA, full list of contributors on Wikipedia ...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/62hvT4USvGa9OAsMP9guIBtJqkf.jpg", url:"https://themoviedb.org/person/60739"}}, {tmdbId:"155754", properties:{bornIn:"New Haven, Connecticut, USA", imdbId:"0153589", born:date('1948-12-15'), name:"Melanie Chartoff", url:"https://themoviedb.org/person/155754"}}, {tmdbId:"68225", properties:{bornIn:"Pleasant Hill, California, USA", imdbId:"0869728", born:date('1962-09-25'), name:"Beth Toussaint", url:"https://themoviedb.org/person/68225"}}, {tmdbId:"53924", properties:{bornIn:"Elizabethtown, Kentucky, U.S.", imdbId:"0005393", born:date('1968-11-06'), name:"Kelly Rutherford", bio:"​From Wikipedia, the free encyclopedia\n\nKelly Danne Melissa Rutherford (born November 6, 1968) is an American actress known for her roles of Stephanie \"Sam\" Whitmore on Generations, Megan Lewis on Melrose Place from 1996 to 1999 and currently as Lily van der Woodsen on Gossip Girl.  She was also Dixie Cousins on The Adventures of Brisco County, Jr. \n\nDescription above from the Wikipedia article Kelly Rutherford, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iAVGM2hYiSszeZZFniSU4x0sHVF.jpg", url:"https://themoviedb.org/person/53924"}}, {tmdbId:"2282535", properties:{name:"Scott Sener", url:"https://themoviedb.org/person/2282535"}}, {tmdbId:"11006", properties:{bornIn:"Stillwater, Oklahoma, USA", imdbId:"0005188", born:date('1973-09-18'), name:"James Marsden", bio:"James Paul Marsden (born September 18, 1973) is an American actor, singer, and former model.  Marsden began his acting career guest starring in the television shows Saved by the Bell: The New Class (1993), Touched by an Angel (1995), and Party of Five (1995).  He gained prominence in the early 2000s with his portrayal of Scott Summers / Cyclops in the X-Men film series (2000–2014), and starred in Superman Returns (2006)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mk142GG0saiSXALY6V4wWcmPROW.jpg", url:"https://themoviedb.org/person/11006"}}, {tmdbId:"52508", properties:{bornIn:"Yellowknife, Northwest Territories, Canada", imdbId:"0576425", born:date('1976-04-01'), name:"Tobias Mehler", bio:"​From Wikipedia, the free encyclopedia. \n\nTobias Mehler (born April 1, 1976) is a Canadian actor who has appeared in film and television productions.  Some notable roles include d'Artagnan on Young Blades, Zak Adama on Battlestar Galactica and Lieutenant Graham Simmons in Stargate SG-1...", url:"https://themoviedb.org/person/52508"}}, {tmdbId:"168702", properties:{bornIn:"New York City, New York, USA", imdbId:"0507271", born:date('1950-07-05'), name:"Huey Lewis", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/swFrfCWf95IbOAuAnwj6oJilUvQ.jpg", url:"https://themoviedb.org/person/168702"}}, {tmdbId:"8329", properties:{bornIn:"Melbourne, Victoria, Australia", imdbId:"0593664", born:date('1973-11-12'), name:"Radha Mitchell", bio:"Radha Rani Amber Indigo Ananda Mitchell is an Australian actress.  She started her career acting in various Australian television series and films, and later appeared in Hollywood films such as High Art, Pitch Black, Phone Booth, Man on Fire, Finding Neverland, Melinda and Melinda, Silent Hill and The Crazies...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Va86MqIRvA5ZyhSpHBY7qccjrv.jpg", url:"https://themoviedb.org/person/8329"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"64173", properties:{bornIn:"London, England, UK", imdbId:"0729763", born:date('1989-07-20'), name:"Bella Riza", url:"https://themoviedb.org/person/64173"}}, {tmdbId:"64174", properties:{bornIn:"England, UK", imdbId:"0611925", born:date('1989-11-01'), name:"Carrie Mullan", bio:"​From Wikipedia, the free encyclopedia\n\nCarina Mullan (born 1 November 1989) is an English actress who made her film debut as 6 year-old Lucy in Hideous Kinky (1998). \n\nDescription above from the Wikipedia article Carrie Mullan, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/64174"}}, {tmdbId:"1512294", properties:{name:"Jennifer Albano", url:"https://themoviedb.org/person/1512294"}}, {tmdbId:"1365681", properties:{imdbId:"0089093", name:"Jenni Blong", bio:"Jenni Blong is an American stage and screen actress...", url:"https://themoviedb.org/person/1365681"}}, {tmdbId:"52601", properties:{bornIn:"Glen Ellyn, Illinois, USA", imdbId:"0005003", born:date('1970-06-26'), name:"Sean Hayes", bio:"Sean Hayes (born June 26, 1970) is an American actor and comedian.  He is widely known for his role on Will & Grace, for which he won an Emmy Award, four SAG Awards, one American Comedy  Award, and six Golden Globes nominations.  He also portrayed comedian Jerry Lewis in Martin  and Lewis...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dOE7o3N33G86LJg21PU6ab5bqcZ.jpg", url:"https://themoviedb.org/person/52601"}}, {tmdbId:"65475", properties:{bornIn:"Milwaukee - Wisconsin - USA", imdbId:"0005388", born:date('1970-05-15'), name:"Brad Rowe", bio:"From Wikipedia, the free encyclopedia.  Brad Rowe (born May 15, 1970) is an American film and television actor who began his career in movies such as Invisible Temptation and Billy's Hollywood Screen Kiss (which launched the career of Sean Hayes). \n\nA University of Wisconsin–Madison graduate, Rowe originally worked as a finance manager for political campaigns in Washington, D. C.  before moving to Los Angeles, California, to pursue writing and acting...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nkUdAS5UfkNZSmmuzUXJ4FnAife.jpg", url:"https://themoviedb.org/person/65475"}}, {tmdbId:"109184", properties:{imdbId:"0304514", name:"Richard Ganoung", url:"https://themoviedb.org/person/109184"}}, {tmdbId:"151384", properties:{bornIn:"Brooklyn - New York City - New York - USA", imdbId:"0528761", born:date('1970-03-08'), name:"Meredith Scott Lynn", url:"https://themoviedb.org/person/151384"}}, {tmdbId:"28611", properties:{bornIn:"Birkadem, Alger, Algeria", imdbId:"0738789", born:date('1952-04-16'), name:"Béatrice Romand", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/44XNrVHZWwgoCWDdWGM7Km5Tjkh.jpg", url:"https://themoviedb.org/person/28611"}}, {tmdbId:"39349", properties:{bornIn:"Saint-Jean-de-Maurienne, France", imdbId:"0508888", born:date('1943-08-20'), name:"Alain Libolt", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e1tWOgNk2W5JhucO30vthXIQKeR.jpg", url:"https://themoviedb.org/person/39349"}}, {tmdbId:"64215", properties:{imdbId:"0762240", name:"Didier Sandre", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dtP5GRgZzipufXoDB1QrIDuqYi9.jpg", url:"https://themoviedb.org/person/64215"}}, {tmdbId:"7470", properties:{bornIn:"Dallas, Texas, USA", imdbId:"0001533", born:date('1947-09-27'), name:"Meat Loaf", bio:"Michael Lee Aday (born Marvin Lee Aday; September 27, 1947), better known by his stage name, Meat Loaf, is an American rock musician and actor.  He is noted for the Bat Out of Hell album trilogy consisting of Bat Out of Hell, Bat Out of Hell II: Back Into Hell and Bat Out of Hell III: The Monster Is Loose.  Bat Out of Hell has sold more than 43 million copies...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7gKLR1u46OB8WJ6m06LemNBCMx6.jpg", url:"https://themoviedb.org/person/7470"}}, {tmdbId:"15740", properties:{bornIn:"Londra, Regno Unito", imdbId:"0573406", born:date('1963-01-01'), name:"Tim McMullan", bio:"From Wikipedia, the free encyclopedia\n\nTim McMullan is a British actor, notable for his stage and television work.  He trained at the Royal Academy of Dramatic Arts. \n\nHis stage work has included a 2008 adaptation of The Misanthrope alongside Damian Lewis and Keira Knightley\n\nalong with the 2003 adaptation of His Dark Materials, the 2009 Shakespeare's Globe production of As You Like It and work for Complicite...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7RaL5N5riQlgdjEvgK4hWJie4mc.jpg", url:"https://themoviedb.org/person/15740"}}, {tmdbId:"17352", properties:{bornIn:"London, England, UK", imdbId:"0001399", born:date('1967-04-26'), name:"Marianne Jean-Baptiste", bio:"Marianne Jean-Baptiste (born April 26, 1967) is a British actress and singer of Antiguan and St.  Lucian heritage...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ggAAGN9ei8hggTwDVO4sjZpIS6t.jpg", url:"https://themoviedb.org/person/17352"}}, {tmdbId:"40059", properties:{imdbId:"0821256", name:"Chris Stafford", url:"https://themoviedb.org/person/40059"}}, {tmdbId:"40060", properties:{bornIn:"New York City, New York USA", imdbId:"0392073", born:date('1973-01-01'), name:"Tina Holmes", url:"https://themoviedb.org/person/40060"}}, {tmdbId:"40061", properties:{bornIn:"Tokyo, Japan", imdbId:"0300399", born:date('1973-09-13'), name:"Andersen Gabrych", url:"https://themoviedb.org/person/40061"}}, {tmdbId:"40062", properties:{imdbId:"0574668", name:"Stephanie McVay", url:"https://themoviedb.org/person/40062"}}, {tmdbId:"34543", properties:{bornIn:"Winter Park, Florida, USA", imdbId:"0001619", born:date('1978-12-10'), name:"Summer Phoenix", bio:"Summer Joy Phoenix is an American actress, model and designer.  She is the youngest sibling of actors/actresses River Phoenix, Rain Phoenix, Joaquin Phoenix, and Liberty Phoenix...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sTCsD0egOcDQSZEhGeDYD1cssKK.jpg", url:"https://themoviedb.org/person/34543"}}, {tmdbId:"1234", properties:{bornIn:"Wyckoff, New Jersey, USA", imdbId:"0005346", born:date('1975-11-08'), name:"Tara Reid", bio:"An American actress.  She began her television career with several guest appearances on television shows such as Saved By The Bell: The New Class, Days of our Lives, and California Dreams.  She is known for her recurring role as Danni Sullivan on NBC comedy drama series Scrubs.  Her screen debut came in A Return to Salem's Lot (1987), followed by the hit films The Big Lebowski (1998), Urban Legend (1998), and American Pie (1999)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wXbO9RrimjIx0mJWzKbjWmvi8Iv.jpg", url:"https://themoviedb.org/person/1234"}}] AS row
