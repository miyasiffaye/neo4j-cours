/2FF3Yjxd7DYR4EIJL6s2GpKDMkJ.jpg", url:"https://themoviedb.org/person/15576"}}, {tmdbId:"76215", properties:{bornIn:"Birmingham, England, UK", imdbId:"0504412", born:date('1968-08-14'), name:"Adrian Lester", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/agpu7yrnUjbXJRRd6lH2q47kwOl.jpg", url:"https://themoviedb.org/person/76215"}}, {tmdbId:"1169241", properties:{imdbId:"1057989", name:"Natasha Braisewell", url:"https://themoviedb.org/person/1169241"}}, {tmdbId:"106738", properties:{imdbId:"0112923", name:"Henry Brown", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mA1KCd5UfLhZrhiVMoINo6YCRpe.jpg", url:"https://themoviedb.org/person/106738"}}, {tmdbId:"147977", properties:{imdbId:"0598166", born:date('1969-01-19'), name:"Wendy Moniz", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o6h5BiaTiezKKEOaQKiGuTGeePe.jpg", url:"https://themoviedb.org/person/147977"}}, {tmdbId:"1910", properties:{bornIn:"Richmond, Virginia, USA", imdbId:"0000715", born:date('1952-08-07'), name:"Caroline Aaron", bio:"From Wikipedia, the free encyclopedia.   Caroline Aaron (born August 7, 1952) is an American actress and producer.  She is best known for her role as acid-tongued talk show host Mary Pat Lee on Wings...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6QCCIo9gK6bml0snBfP7xbQK1Hi.jpg", url:"https://themoviedb.org/person/1910"}}, {tmdbId:"58147", properties:{bornIn:"California, USA", imdbId:"0913465", born:date('1989-06-21'), name:"Jascha Washington", bio:"From Wikipedia, the free encyclopedia\n\nJascha Akili Washington (born June 21, 1989) is an American television and film actor and occasional singer. \n\nDescription above from the Wikipedia article Jascha Washington, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mzU3uK5ga1t2YqBB9jzLTBmjuwd.jpg", url:"https://themoviedb.org/person/58147"}}, {tmdbId:"980", properties:{bornIn:"Watford - Hertfordshire - England - UK", imdbId:"0005068", born:date('1965-01-05'), name:"Vinnie Jones", bio:"Vincent Peter \"Vinnie\" Jones (born 5 January 1965) is a retired British footballer and film actor. \n\nJones represented and captained the Welsh national football team, having qualified via a Welsh grandparent.  He also previously played for Chelsea and Leeds United.  As a member of the \"Crazy Gang\", Jones won the 1988 FA Cup Final with Wimbledon.  Jones appeared in the 7th and final series of UK gameshow Celebrity Big Brother finishing in 3rd place behind Dane Bowers and Alex Reid...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tkYWG9gY2QpoBfOh4OWNz8yQfsw.jpg", url:"https://themoviedb.org/person/980"}}, {tmdbId:"167604", properties:{bornIn:"Los Angeles - California - USA", imdbId:"0197453", born:date('1965-12-26'), name:"Nadia Dajani", url:"https://themoviedb.org/person/167604"}}, {tmdbId:"585015", properties:{bornIn:"New York, New York, U.S.A.", imdbId:"0220641", born:date('1938-09-01'), name:"Alan M. Dershowitz", bio:"Alan Morton Dershowitz is an American lawyer and academic.  He is a scholar of United States constitutional law and criminal law and a noted civil libertarian.  He began his teaching career at Harvard Law School where, in 1967, at the age of 28, he became the youngest full professor of law in its history...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/db6q6R2gsmrtPRXs1097gTxOE2a.jpg", url:"https://themoviedb.org/person/585015"}}, {tmdbId:"65885", properties:{bornIn:"Rhodesia [now Zimbabwe]", imdbId:"0027215", born:date('1947-10-23'), name:"Miles Anderson", bio:"Miles Anderson is a Zimbabwean born British stage, film and television actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9jVWEdohM3y3Jrb7xiz9dXZkyeJ.jpg", url:"https://themoviedb.org/person/65885"}}, {tmdbId:"10779", properties:{bornIn:"Portsmouth, Hampshire, England, UK", imdbId:"0129464", born:date('1946-08-01'), name:"David Calder", bio:"David Calder is an English television, stage, and screen actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n5piJegvFT7ppHb7zVbRvzP8l9R.jpg", url:"https://themoviedb.org/person/10779"}}, {tmdbId:"25702", properties:{bornIn:"Paddington, London, England, UK", imdbId:"0593961", born:date('1976-08-09'), name:"Rhona Mitra", bio:"Rhona Natasha Mitra (sometimes credited as Rona Mitra; born 9 August 1976) is an English actress, model and singer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fcNw2EGkmlO0zlFh72KvubMbsjH.jpg", url:"https://themoviedb.org/person/25702"}}, {tmdbId:"69489", properties:{bornIn:"Rome, Italy", imdbId:"0872910", born:date('1981-04-24'), name:"Jasmine Trinca", bio:"Jasmine Trinca is an Italian actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bnaL4BhkiCaVK6AIEYAB0YVpBIw.jpg", url:"https://themoviedb.org/person/69489"}}, {tmdbId:"69490", properties:{bornIn:"Roma, Italy", imdbId:"0762524", born:date('1983-06-26'), name:"Giuseppe Sanfelice", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wpNlNFZGg7djMexELaOMnyr2yaG.jpg", url:"https://themoviedb.org/person/69490"}}] AS row
