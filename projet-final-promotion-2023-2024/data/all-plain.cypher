UNWIND [{tmdbId:"1142889", properties:{imdbId:"1037381", name:"Mark Strano", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xYFuEUJGgGv5q4ukExzjrp6cb1j.jpg", url:"https://themoviedb.org/person/1142889"}}, {tmdbId:"555854", properties:{imdbId:"1767125", born:date('1977-09-21'), name:"Frankie Valenti", bio:"Frankie Valenti is an American actor.  He is a former pornographic actor known as Johnny Hazzard...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tQ0SnBachdd0nLvEOnjpJpOwtsD.jpg", url:"https://themoviedb.org/person/555854"}}, {tmdbId:"94440", properties:{imdbId:"2096172", name:"Gregory Marcel", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pk1HcgZ9Vtzij7qTYVbOYHodmAz.jpg", url:"https://themoviedb.org/person/94440"}}, {tmdbId:"1485556", properties:{imdbId:"4487928", name:"Ty Parker", url:"https://themoviedb.org/person/1485556"}}, {tmdbId:"207549", properties:{bornIn:"Cardiff, Wales", imdbId:"0917347", born:date('1985-12-25'), name:"Perdita Weeks", bio:"Perdita Weeks (born 25 December 1985) is a Welsh actress. \n\nPerdita was born in South Glamorgan, educated at Roedean School and studied art history at the Courtauld Institute.  She is the younger sister of Honeysuckle Weeks and the older sister of Rollo Weeks.   She portrayed Mary Boleyn (King Henry VIII's sister-in-law) in the Showtime drama The Tudors (2007).  In 2008 she appeared as Lydia Bennet in the ITV series Lost In Austen...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/GyJnIrdgpXfPcU5Q0ty3afc0YX.jpg", url:"https://themoviedb.org/person/207549"}}, {tmdbId:"78431", properties:{bornIn:"Washington, D.C., USA", imdbId:"1133651", born:date('1980-05-27'), name:"Ben Feldman", bio:"From Wikipedia, the free encyclopedia. \n\nBen Feldman (born May 27, 1980) is an American actor.  He has done stage acting, including the Broadway play The Graduate along with Alicia Silverstone and Kathleen Turner.  He also played a leading character inThe Perfect Man and portrayed Fran Drescher's son on the television series Living with Fran.  From 2009 to 2011, he was a regular on the television series Drop Dead Diva in the role of guardian angel Fred...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tgp0W4SUFKew2sLugHBfTWIw1Dl.jpg", url:"https://themoviedb.org/person/78431"}}, {tmdbId:"56679", properties:{bornIn:"Onslow County - North Carolina - USA", imdbId:"0388064", born:date('1985-01-26'), name:"Edwin Hodge", bio:"Edwin Martel Basil Hodge (born January 26, 1985) is an American actor.  Hodge is the older brother of actor Aldis Hodge. \n\n Hodge was born on January 26, 1985, in Jacksonville, Florida, to Aldis Hodge and Yolette Evangeline Richardson, but he was raised in New York. [3] Hodge's mother is from the state of Florida and his father is Dominican.  He recently guest starred on an episode of the TNT series Leverage which stars his younger brother.  He guest starred on an episode ofOne Tree Hill...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wbwevwzat2iy42QilcRRXshAkLv.jpg", url:"https://themoviedb.org/person/56679"}}, {tmdbId:"78124", properties:{bornIn:"Paris, France", imdbId:"2476624", born:date('1990-01-29'), name:"François Civil", bio:"François Civil, né le 29 janvier 1990 à Paris, est un acteur français. \n\n Alors qu'il démarre des études de théâtre au studio Le Magasin, François Civil décroche un rôle dans le film Le Cactus réalisé par Michel Munz et Gérard Bitton.  Puis Laurence Ferreira-Barbosa lui confie le premier rôle de son film Soit je meurs, soit je vais mieux pour lequel il est prénommé pour le César de la Révélation Masculine en 2009...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pG2bel9tOQzo0U8KuhnvNfDLQZp.jpg", url:"https://themoviedb.org/person/78124"}}, {tmdbId:"558820", properties:{bornIn:"London,  England", imdbId:"1561881", born:date('1983-09-14'), name:"Amy Winehouse", bio:"From Wikipedia, the free encyclopedia. \n\nAmy Jade Winehouse (14 September 1983 – 23 July 2011) was a British singer-songwriter known for her powerful contralto vocals and her eclectic mix of musical genres including R&amp;B, soul and jazz.  Winehouse's 2003 debut album, Frank, was critically successful in the UK and was nominated for the Mercury Prize...", died:date('2011-07-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5uaJkQ7B46GSgofUtuf3GINnGxw.jpg", url:"https://themoviedb.org/person/558820"}}, {tmdbId:"1480431", properties:{name:"Juliette Ashby", url:"https://themoviedb.org/person/1480431"}}, {tmdbId:"1278555", properties:{bornIn:"Hammersmith, London, England, UK", imdbId:"4390920", name:"Antonia Clarke", bio:"Antonia Clarke is an actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yxJw7V4uz8pPgblbFOUfweWPBfh.jpg", url:"https://themoviedb.org/person/1278555"}}, {tmdbId:"236622", properties:{imdbId:"1860270", name:"Natasha Andrews", bio:"Natasha Andrews is an actress...", url:"https://themoviedb.org/person/236622"}}, {tmdbId:"1418841", properties:{imdbId:"2992087", name:"Valérie Beaulieu", url:"https://themoviedb.org/person/1418841"}}, {tmdbId:"94098", properties:{bornIn:"Pittsburgh, Pennsylvania, USA", imdbId:"1843026", born:date('1982-10-20'), name:"Gillian Jacobs", bio:"Gillian Jacobs (born October 20, 1982) is an American film, theatre and television actress, best known for her role as Britta Perry on the NBC comedy series Community. \n\nJacobs was born in Pittsburgh, Pennsylvania.  Her mother, Martina Magenau Jacobs, was a Carnegie Mellon University director of alumni relations at the Heinz College.  Her father, William F.  Jacobs Jr. , was an investment banker. She was raised in the Pittsburgh suburb of Mt.  Lebanon...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sbZVI3F2t5CjmRANwHk3X6iOQpt.jpg", url:"https://themoviedb.org/person/94098"}}, {tmdbId:"1235568", properties:{imdbId:"1074478", name:"Beth Dover", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2QsHtyfRsu1cD4JphfBk73ciayF.jpg", url:"https://themoviedb.org/person/1235568"}}, {tmdbId:"20582", properties:{bornIn:"Birmingham - Alabama - USA", imdbId:"0660244", born:date('1964-11-07'), name:"Michael Papajohn", bio:"A native of Birmingham, Alabama, Michael graduated from Vestavia Hills High School in 1983. \n\nThe Texas Rangers drafted him in 1985, but he chose instead to attend Louisiana State University on a baseball scholarship.  He was the starting center-fielder on the first LSU team to go to the College World Series in 1986, and again in 1987. \n\nIn 1987, Everybody's All-American (1988) came to shoot in Baton Rouge, and Michael was chosen as Dennis Quaid stunt double for the football scenes...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9nVHCoYxCpGh9pO00xp7SybWd7b.jpg", url:"https://themoviedb.org/person/20582"}}, {tmdbId:"73132", properties:{bornIn:"Los Angeles, California, USA ", imdbId:"0735424", born:date('1953-07-10'), name:"Marco Rodríguez", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xKF5K71UmecsLhJno8gVp6nTIUD.jpg", url:"https://themoviedb.org/person/73132"}}, {tmdbId:"1259762", properties:{bornIn:"Clearwater, Florida, USA", imdbId:"3492402", born:date('2003-06-01'), name:"Emjay Anthony", bio:"Emjay Anthony (born June 1, 2003) is an American actor and model.  His major films include It's Complicated, Chef and Bad Moms...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q8lsX9MmYrf9UOpRUZy4ZkziIyO.jpg", url:"https://themoviedb.org/person/1259762"}}, {tmdbId:"215055", properties:{bornIn:"Seoul, South Korea", imdbId:"3081796", born:date('1983-12-21'), name:"Steven Yeun", bio:"Steven Yeun (/jʌn/; Korean: 연상엽; born Yeun Sang-yeop, December 21, 1983) is a Korean-American actor, voice actor and singer.  He is known for his role as Glenn Rhee on AMC's horror drama television series The Walking Dead.  He has also starred in the award-winning films Okja, Sorry to Bother You, and the Korean film Burning, all of which received critical acclaim.  Yeun has also appeared in many short and feature films, and has done video game and cartoon voiceovers...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5XU0L0drBa7JlGrLg2w3LhAgjG0.jpg", url:"https://themoviedb.org/person/215055"}}, {tmdbId:"469759", properties:{bornIn:"Barcelona, Barcelona, Catalonia, Spain", imdbId:"2793591", born:date('1986-05-26'), name:"Astrid Bergès-Frisbey", bio:"Àstrid Bergès-Frisbey (born 26 May 1986) is a French-Spanish actress and model.  She is best known for playing Suzanne in The Sea Wall, the mermaid Syrena in Pirates of the Caribbean: On Stranger Tides and Sofi in I Origins.  She is the recipient of the Prix Suzanne Bianchetti in 2009 and the Trophée Chopard Award for Female Revelation of the Year at the 2011 Cannes Film Festival...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/igsu7i9ivK87tMFLirIYZruim33.jpg", url:"https://themoviedb.org/person/469759"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"1015667", properties:{bornIn:"Baton Rouge, Louisiana, USA", imdbId:"0990415", name:"Randy Austin", url:"https://themoviedb.org/person/1015667"}}, {tmdbId:"164105", properties:{imdbId:"0658152", name:"Carl Palmer", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lemNIhvuXhdKMJoRYQslTRNuNxY.jpg", url:"https://themoviedb.org/person/164105"}}, {tmdbId:"1457752", properties:{bornIn:"Rize ,Türkiye", imdbId:"1778124", born:date('1976-04-20'), name:"Ali Atay", bio:"Dursun Ali Atay (born 20 April 1976) is a Turkish actor, musician and director.  He graduated theatre department of Mimar Sinan Fine Arts University.  He is best known for as Mecnun in hit surreal comedy series Leyla ile Mecnun.  He has appeared in more than fifteen films and theatre plays since 1999.   In June 2014, the shooting of his new movie, Limonata, began...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gGCyQuAObWryjWEMaQgwgiJQnqd.jpg", url:"https://themoviedb.org/person/1457752"}}, {tmdbId:"999758", properties:{bornIn:"Ankara, Turkey", imdbId:"1758682", born:date('1978-07-04'), name:"Tansu Biçer", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yjjPUD8eMu5wmf8La9RPO5Mopnp.jpg", url:"https://themoviedb.org/person/999758"}}, {tmdbId:"59752", properties:{bornIn:"Nevşehir, Turkey", imdbId:"1892960", born:date('1965-12-24'), name:"Cengiz Bozkurt", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c0eQLtf99ZAfVJGe3UfDOSgrUFL.jpg", url:"https://themoviedb.org/person/59752"}}, {tmdbId:"129833", properties:{imdbId:"3582302", name:"Asil Buyukozcelik", url:"https://themoviedb.org/person/129833"}}, {tmdbId:"1304331", properties:{imdbId:"2802539", name:"Paul Briganti", url:"https://themoviedb.org/person/1304331"}}, {tmdbId:"25214", properties:{imdbId:"0802048", name:"Stephen Singer", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v8kDAW4RyIafAZngZ5XXNOuPRKN.jpg", url:"https://themoviedb.org/person/25214"}}, {tmdbId:"214839", properties:{bornIn:"St Louis, Missouri, U.S.", imdbId:"1868102", born:date('1973-04-16'), name:"Akon", bio:"Aliaume Damala Badara Akon Thiam (born April 16, 1973),better known as Akon, is an American singer, rapper, songwriter, businessman, record producer and actor.  He rose to prominence in 2004 following the release of \"Locked Up\", the first single from his debut album Trouble...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4fKttRKpWsSF81kh3C1jMrL8zKu.jpg", url:"https://themoviedb.org/person/214839"}}, {tmdbId:"1389848", properties:{imdbId:"4091175", name:"Alex Ashbaugh", url:"https://themoviedb.org/person/1389848"}}, {tmdbId:"1434794", properties:{imdbId:"3107498", name:"Dale Pavinski", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wgwVe9ymocZAFDbUZcMjxc7Trh9.jpg", url:"https://themoviedb.org/person/1434794"}}, {tmdbId:"51999", properties:{bornIn:"New York City - New York - USA", imdbId:"2055623", born:date('1984-04-09'), name:"Lili Mirojnick", bio:"Lili Mirojnick was born on April 9, 1984 is an actress...", url:"https://themoviedb.org/person/51999"}}, {tmdbId:"210826", properties:{bornIn:"The Bronx, New York City, New York, USA", imdbId:"0623085", born:date('1977-10-10'), name:"Andrea Navedo", bio:"Andrea Navedo is an American stage, film and television actress, best known for playing series regular Xiomara Gloriana Villanueva on the comedy-drama series \"Jane the Virgin\".  She holds a BA in Communicative and Creative Arts with a concentration of Theater from the State University of New York at Old Westbury, New York, USA...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lU0t0LpC1cM4cGjTf15oWlb8snb.jpg", url:"https://themoviedb.org/person/210826"}}, {tmdbId:"185464", properties:{bornIn:" London, England, UK", imdbId:"0903637", born:date('1960-12-17'), name:"Tilly Vosburgh", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hWMYSUVwj8VtjlCvsMLFMzCey6v.jpg", url:"https://themoviedb.org/person/185464"}}, {tmdbId:"78050", properties:{bornIn:"Westminster, London, England, UK", imdbId:"1175468", born:date('1983-05-08'), name:"Elyes Gabel", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z9IqYTYxhVR9ADxaksbPQwiYQns.jpg", url:"https://themoviedb.org/person/78050"}}, {tmdbId:"1601831", properties:{name:"Lorna Pruce", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8ipHtEgoyg76t4HxPCbGwdIDwXp.jpg", url:"https://themoviedb.org/person/1601831"}}, {tmdbId:"14902", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"0132757", born:date('1952-03-24'), name:"Nicholas Campbell", bio:"Nicholas Campbell (born 24 March 1952), sometimes credited as Nick Campbell, is a Canadian actor and filmmaker, who has won three Gemini Awards for acting.  The movies Naked Lunch, Prozac Nation and the TV series Da Vinci's Inquest are some examples of his acting work. \n\nDescription above from the Wikipedia article Nicholas Campbell,  licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tMhMePwhvflufrfSx66cQMZHikx.jpg", url:"https://themoviedb.org/person/14902"}}, {tmdbId:"64612", properties:{bornIn:"Montréal, Québec, Canada", imdbId:"0740371", born:date('1973-08-21'), name:"Jeff Roop", url:"https://themoviedb.org/person/64612"}}, {tmdbId:"20187", properties:{bornIn:"West Caldwell, New Jersey, USA", imdbId:"0005179", born:date('1961-03-08'), name:"Camryn Manheim", bio:"Camryn Manheim (born March 8, 1961) is an American actress known for her work on \"The Practice\" and \"Ghost Whisperer\".   She is the daughter of a mathematics professor and a teacher.   Manheim was born Debra Frances Manheim in Caldwell, New Jersey, but grew up in Peoria, Illinois.   Manheim is known for her support of the deaf community, although she herself is not deaf...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eI42MrAyzJ3vbiGSIQB0FCwecba.jpg", url:"https://themoviedb.org/person/20187"}}, {tmdbId:"1366025", properties:{bornIn:"Warszawa, Poland", imdbId:"5851109", born:date('1995-04-05'), name:"Zofia Wichlacz", bio:"Zofia Wichłacz is a Polish actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lQiwvVcQ8fiv3CBZHL0x6tcmoLr.jpg", url:"https://themoviedb.org/person/1366025"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"1775367", properties:{name:"Wenanty Nosul", url:"https://themoviedb.org/person/1775367"}}, {tmdbId:"1104799", properties:{imdbId:"1249306", name:"Artur Urbanski", url:"https://themoviedb.org/person/1104799"}}, {tmdbId:"1395049", properties:{imdbId:"5236664", name:"Kayla Servi", url:"https://themoviedb.org/person/1395049"}}, {tmdbId:"109109", properties:{bornIn:"County Tipperary, Ireland", imdbId:"1024311", born:date('1978-01-01'), name:"Rosie Fellner", bio:"A British/Irish actress and Producer.  Born in Galway Ireland to British parents, she spent most her childhood traveling round the globe living in beautiful European countries like France, Portugal and Spain.  Now Rosie is based between New York and London where, as well as acting, she runs her production company Rosebud Pictures...", url:"https://themoviedb.org/person/109109"}}, {tmdbId:"86477", properties:{imdbId:"1721217", name:"Claire Keelan", bio:"​Claire Keelan is a British film and television actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aKNSxAV4vqXi8tg28vrKjsyKACE.jpg", url:"https://themoviedb.org/person/86477"}}, {tmdbId:"1289968", properties:{bornIn:"Hammersmith, London, England, UK", imdbId:"5353321", born:date('1992-08-12'), name:"Cara Delevingne", bio:"Cara Jocelyn Delevingne (/ˈkɑːrə ˌdɛləˈviːn/ kah-rə del-ə-veen; born 12 August 1992) is an English fashion model and actress.  She signed with Storm Model Management after leaving school in 2009.  Delevingne won the \"Model of the Year\" award at the British Fashion Awards in 2012 and 2014 and has appeared in shows for houses including Burberry, Mulberry, Dolce & Gabbana, and Jason Wu.  She started her acting career with a minor role in the 2012 film adaptation of Anna Karenina...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8TQYWBtzVH5wdRXIc8uHQOTmXL6.jpg", url:"https://themoviedb.org/person/1289968"}}, {tmdbId:"72994", properties:{bornIn:"Iowa City - Iowa - USA", imdbId:"1134612", born:date('1978-09-16'), name:"Michael Mosley", bio:"Michael Mosley is an actor and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/puRHN4OMPBXKiJdW0yyMIN9ju4r.jpg", url:"https://themoviedb.org/person/72994"}}, {tmdbId:"61914", properties:{bornIn:"Perth - Western Australia - Australia", imdbId:"2191570", born:date('1981-01-01'), name:"Zoe Ventoura", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uzK3Of1mY5Gs4ocHXYrJuuM7nrY.jpg", url:"https://themoviedb.org/person/61914"}}, {tmdbId:"1361963", properties:{imdbId:"4350114", name:"Tom Prior", url:"https://themoviedb.org/person/1361963"}}, {tmdbId:"1387383", properties:{imdbId:"6240141", name:"Sophie Perry", url:"https://themoviedb.org/person/1387383"}}, {tmdbId:"221018", properties:{bornIn:"Croydon, London, England, UK", imdbId:"1405398", born:date('1982-10-10'), name:"Dan Stevens", bio:"Daniel Jonathan \"Dan\" Stevens (born 10 October 1982) is an English actor.  He is best known for his roles as Matthew Crawley in the ITV period drama series Downton Abbey, as \"David\" in the thriller film The Guest, Sir Lancelot in Night at the Museum: Secret of the Tomb, and as The Beast/Prince in Walt Disney's live-action adaptation of Beauty and the Beast.  He currently stars as David Haller in FX series Legion...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6ioq5zfiwSZbPRWY8fVUO8bWRBC.jpg", url:"https://themoviedb.org/person/221018"}}, {tmdbId:"1094091", properties:{bornIn:" Santa Barbara, California, USA", imdbId:"2140860", born:date('1993-05-29'), name:"Maika Monroe", bio:"An American actress and professional kiteboarder.  She made her acting debut in the 2012 film At Any Price.  In 2013, she appeared alongside Kate Winslet in the drama film Labor Day.  She became recognized as a \"scream queen\" after her performances in the critically acclaimed 2014 films The Guest and It Follows.  She also played Patricia Whitmore in Independence Day: Resurgence (2016)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1N4u720cJAq8UmawBjvgd9Rb3qX.jpg", url:"https://themoviedb.org/person/1094091"}}, {tmdbId:"558927", properties:{bornIn:"Kitchener-Waterloo - Ontario - Canada", imdbId:"2063811", born:date('1994-10-02'), name:"Brendan Meyer", bio:"Brendan Meyer is an accomplished actor in both theatre and film/TV.  He has filmed throughout North America: in LA, New Mexico, Toronto and Vancouver, as well as his home town of Edmonton...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eqqcatIaUEmuax0ztI8fLUI7VGJ.jpg", url:"https://themoviedb.org/person/558927"}}, {tmdbId:"1541022", properties:{imdbId:"5777470", name:"Anais Bordier", url:"https://themoviedb.org/person/1541022"}}, {tmdbId:"1541024", properties:{imdbId:"4306292", name:"Kanoa Goo", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4NuV6pKXWIA0HKp25ZjAFhv2xGV.jpg", url:"https://themoviedb.org/person/1541024"}}, {tmdbId:"964971", properties:{bornIn:"Orangeburg, South Carolina, USA", imdbId:"2110485", born:date('1983-06-17'), name:"Manish Dayal", bio:"Manish Dayal was born on June 17, 1983 in Orangeburg, South Carolina, USA as Manish Sudhir Patel.  He is an actor and producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7XwaeMi2PJapWWnK7nFw9Kj64hf.jpg", url:"https://themoviedb.org/person/964971"}}, {tmdbId:"1021684", properties:{bornIn:"Montréal, Québec, Canada", imdbId:"3114649", born:date('1986-09-04'), name:"Charlotte Le Bon", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1i7YlempXFCbXLjt3joshgGW1XY.jpg", url:"https://themoviedb.org/person/1021684"}}, {tmdbId:"1231717", properties:{imdbId:"0549505", born:date('1963-09-27'), name:"Marc Maron", bio:"Marc Maron (born September 27, 1963) is an American stand-up comedian and podcast host. \n\nHe has been host of The Marc Maron Show, and co-host of both Morning Sedition, and Breakroom Live, all politically-oriented shows, produced under the auspices of Air America Media.  He was also the host of Comedy Central's Short Attention Span Theater for a year, replacing Jon Stewart...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zgUiWlWf2JvVYRO7aX9WUAuwYQR.jpg", url:"https://themoviedb.org/person/1231717"}}, {tmdbId:"1290854", properties:{imdbId:"5754119", name:"Sam Lipsyte", url:"https://themoviedb.org/person/1290854"}}, {tmdbId:"1541645", properties:{imdbId:"6970435", name:"Amanda McCauley", url:"https://themoviedb.org/person/1541645"}}] AS row
