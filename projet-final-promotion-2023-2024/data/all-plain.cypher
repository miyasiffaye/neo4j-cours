UNWIND [{tmdbId:"59614", properties:{imdbId:"0126743", name:"Catherine Bégin", url:"https://themoviedb.org/person/59614"}}, {tmdbId:"59615", properties:{imdbId:"0869590", name:"Robert Toupin", url:"https://themoviedb.org/person/59615"}}, {tmdbId:"14892", properties:{bornIn:"Flushing, Queens, New York, United States", imdbId:"1679669", born:date('1971-10-26'), name:"Rosemarie DeWitt", bio:"Rosemarie Braddock DeWitt (born October 26, 1971) is an American actress.  DeWitt played Emily Lehman in the Fox television series Standoff (2006–07), co-starring with her future husband Ron Livingston, as well as Charmaine Craine on United States of Tara.  She also was the title character in 2008's Rachel Getting Married, garnering several awards and nominations for best supporting actress.  She starred in the horror/thriller Poltergeist (2015), a remake of the 1982 film of the same name...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/y7UXsG7YMXM3wA1kteWv2g4LQLI.jpg", url:"https://themoviedb.org/person/14892"}}, {tmdbId:"1079805", properties:{bornIn:"Lewisville, Texas, USA", imdbId:"3061574", born:date('1999-06-11'), name:"Saxon Sharbino", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9TDfSiqCJyEutjxQLQqi2Sj97M.jpg", url:"https://themoviedb.org/person/1079805"}}, {tmdbId:"1043693", properties:{bornIn:"New Jersey", imdbId:"3714535", born:date('2003-06-17'), name:"Kyle Catlett", bio:"Kyle Catlett is an actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uixlHUzxOEc1wFaim4ePw3FFzA.jpg", url:"https://themoviedb.org/person/1043693"}}, {tmdbId:"82945", properties:{bornIn:"Washington, District of Columbia, USA", imdbId:"1889973", born:date('1971-02-27'), name:"Charles Baker", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yuRBqdgCh4OgTsfl2Xs4mC6PpnZ.jpg", url:"https://themoviedb.org/person/82945"}}, {tmdbId:"82943", properties:{bornIn:"Winston-Salem, North Carolina, USA", imdbId:"1489978", born:date('1979-01-13'), name:"Jill Wagner", bio:"Jill Wagner (born January 13, 1979) is an American television actress, model, and game show personality...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xt2XePMGLdHnKE75g31ZmReXqqV.jpg", url:"https://themoviedb.org/person/82943"}}, {tmdbId:"85236", properties:{bornIn:"Le Mars, Iowa, Stati Uniti", imdbId:"1770256", born:date('1981-04-21'), name:"Paul Rust", bio:"Paul Robert Rust is an American actor, comedian and writer.   Rust appears as a frequent guest on the Comedy Bang Bang podcast, where he is best known for his \"New No Nos\" segment.  \n\nHe is currently working with Paul Ruebens on writing an upcoming Pee-Wee Herman film, that will be produced by Judd Apatow...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fTcHwLTs4bYHXdsVGf7fdNS89HS.jpg", url:"https://themoviedb.org/person/85236"}}, {tmdbId:"98772", properties:{bornIn:"Los Angeles, California, USA", imdbId:"1988575", born:date('1984-12-05'), name:"Lauren London", bio:"Lauren Nicole London was born on December 5, 1984, in Los Angeles, California.  She is of African-American and Jewish descent.  London is an up-and-coming film and television actress, model, and occasional music video actress.  Beginning her career in music videos and later transitioning into film and television, London earned recognition for her performances in the film ATL (2006) as well as the television shows 90210 and Entourage...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vfUJtwfux3nwEGWIbrC20LyH8fn.jpg", url:"https://themoviedb.org/person/98772"}}, {tmdbId:"1231362", properties:{imdbId:"0485487", name:"Mills Lane", url:"https://themoviedb.org/person/1231362"}}, {tmdbId:"80757", properties:{bornIn:"Brownsville, Brooklyn, New York City, New York, U.S.", imdbId:"0005512", born:date('1966-06-30'), name:"Mike Tyson", bio:"Michael Gerard Tyson (born June 30, 1966) is an American former professional boxer, competing from 1985 to 2005.  He reigned as the undisputed world heavyweight champion, and holds the record as the youngest boxer to win a heavyweight title, at 20 years, four months, and 22 days old...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pFbI6qiqb7GJLj6nedE7h8b3X6y.jpg", url:"https://themoviedb.org/person/80757"}}, {tmdbId:"2563751", properties:{name:"Trevor Berbick", url:"https://themoviedb.org/person/2563751"}}, {tmdbId:"2563713", properties:{bornIn:"Brooklyn, New York, USA", born:date('1908-01-17'), name:"Cus D'Amato", bio:"Constantine \"Cus\" D'Amato was an American professional boxing manager and trainer.  An International Boxing Hall of Fame inductee, he discovered, trained and managed world heavyweight champions Floyd Patterson, Jose Torres and Mike Tyson...", died:date('1985-11-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sLLssZ19DmUdVJNu85tlXL16UwO.jpg", url:"https://themoviedb.org/person/2563713"}}, {tmdbId:"20699", properties:{bornIn:"Iasi, Romania", imdbId:"1671512", born:date('1978-04-01'), name:"Anamaria Marinca", bio:"Anamaria Marinca (born April 1, 1978 in Iaşi, Romania) is an award-winning Romanian actress, having starred in the Palme d'Or winner 4 Months, 3 Weeks and 2 Days. \n\nDescription above from the Wikipedia article Anamaria Marinca, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dxSmVbdrEWNEy95Atw8Riq5uYT5.jpg", url:"https://themoviedb.org/person/20699"}}, {tmdbId:"20698", properties:{bornIn:"Piatra Neamt, Romania", imdbId:"1693019", born:date('1976-01-25'), name:"Laura Vasiliu", url:"https://themoviedb.org/person/20698"}}, {tmdbId:"39959", properties:{bornIn:"Botosani, Romania", imdbId:"0412096", born:date('1969-06-25'), name:"Vlad Ivanov", bio:"Vlad Ivanov (born, 25 June 1969 in Botoșani) is an Romanian actor of Lipovan origin...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mWEMgTQieGgvSzjtjx6UOm444hN.jpg", url:"https://themoviedb.org/person/39959"}}, {tmdbId:"39960", properties:{bornIn:"Timisoara, Romania", imdbId:"2308578", born:date('1984-04-21'), name:"Alexandru Potocean", url:"https://themoviedb.org/person/39960"}}, {tmdbId:"16604", properties:{bornIn:"Baghdad, Iraq", imdbId:"0299924", born:date('1947-11-24'), name:"Sasson Gabai", bio:"​From Wikipedia, the free encyclopedia.   \n\nSasson Gabai (also Sasson Gabay) - is an Israeli actor, Jewish and originally from Iraq.  He works in Israeli cinema.  He has won Award of the Israeli Film Academy, Asia Pacific Screen Award, European Film Awards and Jerusalem Film Festival in 2007 as Best Actor in a highly acclaimed Israeli film \"The Band's Visit\". \n\nHe is leading and prolific actors in Israel...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pKhDM56Dzf5XbDDgw3BZau9DujA.jpg", url:"https://themoviedb.org/person/16604"}}, {tmdbId:"19942", properties:{bornIn:"Beersheba, Israel", imdbId:"0253813", born:date('1964-11-27'), name:"Ronit Elkabetz", bio:"Ronit Elkabetz ( born November 27, 1964) is an Israeli actress and filmmaker.  She works in both Israeli and French cinema.  She has won three Ophir Awards and has received a total of seven nominations.  as Best Supporting Actor in a highly acclaimed Israeli film \"The Band's Visit\" where he starred as Haled a young handsome trumpet player of the Alexandria Ceremonial Police Orchestra...", died:date('2016-04-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mSJTLszDzzacbE9m0XcFzWpMgUk.jpg", url:"https://themoviedb.org/person/19942"}}, {tmdbId:"42442", properties:{bornIn:"Galilee, Palestine", imdbId:"2759746", born:date('1977-03-01'), name:"Saleh Bakri", bio:"Saleh Bakri is a Palestinian actor.  He works in Israeli and Palestinian cinema.  He won Award of the Israeli Film Academy in 2007 as Best Supporting Actor in a highly acclaimed Israeli film \"The Band's Visit\" where he starred as Haled a young handsome trumpet player of the Alexandria Ceremonial Police Orchestra...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nx5owXvKk9QPOXbluDZhtAaUlRB.jpg", url:"https://themoviedb.org/person/42442"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"42441", properties:{imdbId:"0622384", name:"Khalifa Natour", url:"https://themoviedb.org/person/42441"}}, {tmdbId:"94185", properties:{bornIn:"Simi Valley, California, USA", imdbId:"0940362", born:date('1991-11-15'), name:"Shailene Woodley", bio:"Shailene Diann Woodley (born November 15, 1991) is an American actress.  Her first major role was as the main character, Amy Juergens, in the ABC Family series The Secret Life of the American Teenager (2008–13)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6BHOerIigACwjdJL3Kg1jq5uBz8.jpg", url:"https://themoviedb.org/person/94185"}}, {tmdbId:"933002", properties:{bornIn:"California, U.S.A.", imdbId:"3837786", born:date('2000-05-04'), name:"Amara Miller", bio:"Amara Miller is an American child actress who earned a Phoenix Film Critics Society Award nomination for \"Best Performance by a Youth in a Supporting Role\" for her debut role as Scottie King in the Academy Award-winning film The Descendants.  Miller lives in Pacific Grove, California...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lV4SazFlJOtIUOGlwIHBjujYD68.jpg", url:"https://themoviedb.org/person/933002"}}, {tmdbId:"931945", properties:{bornIn:"Austin - Texas - USA", imdbId:"1975228", born:date('1992-04-14'), name:"Nick Krause", bio:"Born in Austin and raised in Georgetown, Texas, Krause was a smart and athletic kid.  He went to college at age 10 and, after that, decided to attend the charter school, NYOS, in order to grow around people his own age.  He graduated early from Georgetown High School to begin shooting The Descendants (2011) out in Hawaii. \n\nKrause first realized that acting was for him after attending an improv comedy workshop at the age of 10...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7E0WAo6DUzMVEnD8ExNcqnsLYm6.jpg", url:"https://themoviedb.org/person/931945"}}, {tmdbId:"53820", properties:{bornIn:"Raleigh, North Carolina, USA", imdbId:"0355910", born:date('1971-02-01'), name:"Michael C. Hall", bio:"Michael C.  Hall (born February 1, 1971) is an American actor whose television roles include David Fisher on the HBO drama series Six Feet Under and Dexter Morgan on the Showtime series Dexter.  In 2009, Hall won a Golden Globe award and a Screen Actors Guild Award for his role in Dexter...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7zUMGoujuev5PUwwv4Gl6ikB50k.jpg", url:"https://themoviedb.org/person/53820"}}, {tmdbId:"28109", properties:{bornIn:"Paris, France", imdbId:"1111968", born:date('1982-05-28'), name:"Alexa Davalos", bio:"Alexa Davalos (born May 28, 1982) is an American actress.  She has appeared in several Hollywood films, including Feast of Love, The Chronicles of Riddick, The Mist, Defiance, and Clash of the Titans...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/syG2VtR6nNYCR71liWDyGFzGdwd.jpg", url:"https://themoviedb.org/person/28109"}}, {tmdbId:"23229", properties:{bornIn:"Leiderdorp, Zuid-Holland, Netherlands", imdbId:"0396924", born:date('1976-09-05'), name:"Carice van Houten", bio:"Carice Anouk van Houten, born on September 5, 1976, is a Dutch stage and film actress.  She won three Golden Calves for her roles in Suzy Q (1999), Undercover Kitty (2001) and Black Book (2006).  Her role in Black Book launched her international career.  She acted in the American films Valkyrie (2008), and Repo Men (2010). \n\nDescription above from the Wikipedia article Carice van Houten, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eVJqjb7D4FPRcZZ4nqtBk1gnkkj.jpg", url:"https://themoviedb.org/person/23229"}}, {tmdbId:"78727", properties:{bornIn:"Northern Ireland", imdbId:"2893183", born:date('1986-01-01'), name:"Jenn Murray", bio:"Jenn Murray is an actress of stage and screen from Northern Ireland...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ihzliJtl9mvRJA0qc7W1wcE1cqL.jpg", url:"https://themoviedb.org/person/78727"}}, {tmdbId:"6674", properties:{bornIn:"Marseille, Bouches-du-Rhône, France", imdbId:"1087430", born:date('1981-01-09'), name:"Julia Dietze", bio:"The daughter of the German artist, illustrator and painter Mathias Dietze.  Her mother is from Marseille.  Julia Dietze grew up with her two younger sisters in Munich.  She gained her first film experience in the movies Soloalbum by Gregor Schnitzler, Fickende Fische from Almut Getto, and Was nützt die Liebe in Gedanken by Achim von Borries, and in some TV films, such as Ghetto Kids, Echte Männer? and Die Stimmen.  Her first TV starring role was in Mädchen Nr.  1, directed by Stefan Holtz...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iNjrEGIFmi1Ja6elRYJai6glLOc.jpg", url:"https://themoviedb.org/person/6674"}}, {tmdbId:"75175", properties:{bornIn:"USA", imdbId:"0456130", name:"Christopher Kirby", bio:"An American actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8EctNOglWXvubkUulK29bCOItxM.jpg", url:"https://themoviedb.org/person/75175"}}, {tmdbId:"10744", properties:{bornIn:"Dietzenbach, Germany", imdbId:"0653248", born:date('1967-10-15'), name:"Götz Otto", bio:"A German actor known for his very tall stature.  He is 196 cm (6 ft 6 inches) tall and is often characterised by bleached blonde hair in his films. \n\nDescription above from the Wikipedia article Götz Otto, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gUIvsX30Uey3KXYA5VYx5XvcRqf.jpg", url:"https://themoviedb.org/person/10744"}}, {tmdbId:"143576", properties:{imdbId:"0351495", name:"István Göz", url:"https://themoviedb.org/person/143576"}}, {tmdbId:"1301674", properties:{imdbId:"2781186", name:"Bence Gerö", url:"https://themoviedb.org/person/1301674"}}, {tmdbId:"56614", properties:{bornIn:"Lisburn, Northern Ireland, UK", imdbId:"0829032", born:date('1964-05-24'), name:"Ray Stevenson", bio:"Ray Stevenson was born in Lisburn, Northern Ireland on 25 May 1964.  He is a film, TV and stage actor.  He moved with his family to Lemington, Newcastle-Upon-Tyne, England in 1972 at the age of eight, and later to Cramlington, Northumberland, where he was raised.  The second of three sons of a Royal Air Force pilot father and an Irish mother, As a child he dreamed to become an actor, but he also thought that dream was impossible.  So he pursued his other love, art, and went to art school instead...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/msafbswGI6uisRuNvQ8a1wMF5Ca.jpg", url:"https://themoviedb.org/person/56614"}}, {tmdbId:"88995", properties:{bornIn:"Toledo, Ohio, USA", imdbId:"1597316", born:date('1983-05-06'), name:"Adrianne Palicki", bio:"Adrianne Palicki (born May 6, 1983) is an American actress best known for her role as Tyra Collette on the NBC television series Friday Night Lights...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qjONLp73Z5tvbuMe9g18Mb9hI0J.jpg", url:"https://themoviedb.org/person/88995"}}, {tmdbId:"114144", properties:{imdbId:"1631320", name:"Gio Perez", url:"https://themoviedb.org/person/114144"}}, {tmdbId:"88550", properties:{bornIn:"Rome - New York - USA", imdbId:"0307534", born:date('1975-04-06'), name:"Joel Marsh Garland", bio:"Joel Garland is an actor and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p7t1IZ8YDHxRjC2SdYmX9ccl2y1.jpg", url:"https://themoviedb.org/person/88550"}}, {tmdbId:"34793", properties:{bornIn:"Madrid, Spain", imdbId:"0892299", born:date('1975-10-23'), name:"Manuela Velasco", bio:"Manuela Velasco is a Spanish actress and host born in Madrid.  She made her debut on a movie at only 8 years of age.  She is best known for her outstanding and popular work in REC saga directed by Jaume Balagueró.  She has participated in an important range of tv shows with small roles like 'Cuéntame como pasó' or 'Ángel o demonio'.  Currently she is member of the cast of 'Velvet', one of the most popular tv shows in Spain...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9pZMMxwoNTbCuRKsIy6TMYopqYA.jpg", url:"https://themoviedb.org/person/34793"}}, {tmdbId:"54532", properties:{imdbId:"0970337", name:"Ferran Terraza", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vw2LvonkYZ61iE3fl8SjBrHqRsh.jpg", url:"https://themoviedb.org/person/54532"}}, {tmdbId:"147878", properties:{name:"Jorge-Yamam Serrano", url:"https://themoviedb.org/person/147878"}}] AS row
