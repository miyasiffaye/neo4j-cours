UNWIND [{tmdbId:"1515629", properties:{imdbId:"0350550", name:"István Gyuricza", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/woh8xOtHGMLrN0mJePL8g5wKaBt.jpg", url:"https://themoviedb.org/person/1515629"}}, {tmdbId:"8338", properties:{bornIn:"Nanaimo, British Columbia, Canada", imdbId:"0272706", born:date('1994-10-09'), name:"Jodelle Ferland", bio:"Jodelle Micah Ferland has built up an impressive resume filled with roles in film, television and, at the beginning of her career, commercials.  Born on October 9, 1994, she got her start in an episode of CTV's Cold Squad (1998), before landing the lead role in her first film, Mermaid (2000) at an early age.  Her portrayal of the heartbroken \"Desi\" earned her a Daytime Emmy Award nomination, making her the youngest nominee in history, as well as a Young Artist Award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j0P5UnLzWC1D7sCZuLZ9neNEZns.jpg", url:"https://themoviedb.org/person/8338"}}, {tmdbId:"32205", properties:{bornIn:"Comox Valley, British Columbia, Canada", imdbId:"0281956", born:date('1981-12-15'), name:"Brendan Fletcher", bio:"Brendan Fletcher (born December 15, 1981) is a Canadian actor. \n\nDescription above from the Wikipedia article Brendan Fletcher, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9lLXazetKooqGYaSsZWZYYCDe8C.jpg", url:"https://themoviedb.org/person/32205"}}, {tmdbId:"17005", properties:{bornIn:"Indianapolis, Indiana, USA", imdbId:"0427964", born:date('1960-05-24'), name:"Doug Jones", bio:"The youngest of four brothers, Doug Jones was born on May 24, 1960 in Indianapolis, Indiana, and grew up in the city's Northeastside.  After attending Bishop Chatard High School, he headed off to Ball State University, where he graduated in 1982 with a Bachelor's degree in Telecommunications, with a minor in Theatre. \n\nHe learned mime at school, joining a troupe and doing the whole white-face thing, and has also worked as a contortionist...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tKjCnbbXb3o7upPxh4XLSdTcYDB.jpg", url:"https://themoviedb.org/person/17005"}}, {tmdbId:"443770", properties:{imdbId:"0018515", name:"John Alexander", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9YmbNIO0doeR9FoojgGia7VtpJF.jpg", url:"https://themoviedb.org/person/443770"}}, {tmdbId:"100586", properties:{bornIn:"London, England", imdbId:"1463426", born:date('1982-10-30'), name:"Jon Foo", bio:"Jonathan Patrick Foo (was born in 30 October 1982) is an English actor, martial artist and stuntman of mixed Chinese and Irish descent\n\nHe was born in London to a Chinese father from Singapore, and an Irish mother from England, which is also where he grew up.  His siblings include a little sister and two half-sisters from his father's side.  His family constantly relocated as he grew up.  His father practices karate and his mother practices judo...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wvN7yFHZwzqTF2bRhzW0YFClegh.jpg", url:"https://themoviedb.org/person/100586"}}, {tmdbId:"61829", properties:{bornIn:"Wilbraham, Massachusetts", imdbId:"0653952", born:date('1978-08-28'), name:"Kelly Overton", bio:"Kelly Overton (born August 28, 1978)  is an American actress, screenwriter, director, and producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/u1KnPtnHfdLCrImtONXCYwJDqZk.jpg", url:"https://themoviedb.org/person/61829"}}, {tmdbId:"123813", properties:{bornIn:"St. Paul, Minnesota, USA", imdbId:"1406333", born:date('1978-07-03'), name:"Ian Anthony Dale", bio:"Ian Anthony Dale (born July 3, 1978) is an American actor.  Born in Saint Paul, Minnesota, he attended school in Madison, Wisconsin.  He is of Japanese, French and English descent.  Dale currently stars as Simon Lee on The Event, and was previously known for playing Davis Lee on Surface and his recurring role on Charmed as Avatar Gamma...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x5ePN7j7C4ZmytO5VoUOpiPEyRm.jpg", url:"https://themoviedb.org/person/123813"}}, {tmdbId:"4439", properties:{imdbId:"0799967", name:"Heather Simms", url:"https://themoviedb.org/person/4439"}}, {tmdbId:"4440", properties:{imdbId:"1995957", name:"Brea Frazier", url:"https://themoviedb.org/person/4440"}}, {tmdbId:"60368", properties:{imdbId:"0713747", name:"Iain Rea", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tEA6qxH2GkzVLnpbr2I1OUDRMjh.jpg", url:"https://themoviedb.org/person/60368"}}, {tmdbId:"60370", properties:{imdbId:"1705720", name:"Tessa Mitchell", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2IyedF2mMpCHlRdeUJO2a6A4nRU.jpg", url:"https://themoviedb.org/person/60370"}}, {tmdbId:"60369", properties:{bornIn:"New Zealand.", imdbId:"1002329", born:date('1992-01-01'), name:"Aaron Murphy", bio:"From Wikipedia, the free encyclopedia\n\nAaron James Murphy is a film and TV actor.  He was born 1 January 1992 in New Zealand. \n\nDescription above from the Wikipedia article Aaron James Murphy, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ejyOFsBoVt9ClPHgF2t3s0Q4Okg.jpg", url:"https://themoviedb.org/person/60369"}}, {tmdbId:"16808", properties:{bornIn:"Anklam, Germany", imdbId:"0777788", born:date('1981-03-11'), name:"Matthias Schweighöfer", bio:"Matthias Schweighöfer (born March 11, 1981) is a German actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wyos2SmpBUDjTz1A3EegL96hM2y.jpg", url:"https://themoviedb.org/person/16808"}}, {tmdbId:"17068", properties:{bornIn:"Erbach, Germany", imdbId:"0777594", born:date('1977-05-05'), name:"Jessica Schwarz", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1hTUPs4KB93bl5WEDxuH1U2KXb9.jpg", url:"https://themoviedb.org/person/17068"}}, {tmdbId:"88496", properties:{bornIn:"New York City, New York, U.S.", imdbId:"1659579", born:date('1992-03-08'), name:"Charlie Ray", bio:"From Wikipedia, the free encyclopedia. \n\nCharlotte \"Charlie\" Ray Rosenberg (born March 8, 1992) is an American actress. \n\nDescription above from the Wikipedia article Charlie Ray, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/88496"}}, {tmdbId:"38024", properties:{bornIn:"New York City, New York, USA", imdbId:"0633223", born:date('1966-04-09'), name:"Cynthia Nixon", bio:"Cynthia Ellen Nixon (born April 9, 1966) is an American actress, known for her portrayal of Miranda Hobbes in the HBO series Sex and the City (1998–2004).  She is an Emmy-, Tony- and Grammy Award-winning actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eJ4jH5AbLNCxhHrpBA9ff978jn5.jpg", url:"https://themoviedb.org/person/38024"}}, {tmdbId:"27104", properties:{bornIn:"Montgomery - Alabama - USA", imdbId:"2215447", born:date('1986-11-28'), name:"Johnny Simmons", bio:"Johnny James Simmons (born November 28, 1986) is an American actor.  He is known for his roles as Dylan Baxter in Evan Almighty (2007), Chip Dove in Jennifer's Body (2009), \"Young Neil\" Nordegraf in Scott Pilgrim vs.  the World (2010), and Brad Hayes in The Perks of Being a Wallflower (2012)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ofJqJuKanaIL1wUhLYxy0lG8qvs.jpg", url:"https://themoviedb.org/person/27104"}}, {tmdbId:"231786", properties:{imdbId:"1816735", name:"Jonathan Velasquez", url:"https://themoviedb.org/person/231786"}}, {tmdbId:"231787", properties:{imdbId:"1816347", name:"Francisco Pedrasa", url:"https://themoviedb.org/person/231787"}}] AS row
