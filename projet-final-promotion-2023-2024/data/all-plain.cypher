UNWIND [{tmdbId:"821", properties:{bornIn:"Columbus, Ohio, United States", imdbId:"0000350", born:date('1951-11-15'), name:"Beverly D'Angelo", bio:"Beverly D'Angelo (born November 15, 1951) is an American actress and singer. \n\nDescription above from the Wikipedia article Beverly D'Angelo, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8fYQIA8dAaA4GOTxOFSKIvTqzi.jpg", url:"https://themoviedb.org/person/821"}}, {tmdbId:"1370", properties:{bornIn:"Huntington, West Virginia, USA", imdbId:"0000374", born:date('1950-03-18'), name:"Brad Dourif", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o9f0fHMF1Jo0PDCjz2r1dneolwS.jpg", url:"https://themoviedb.org/person/1370"}}, {tmdbId:"70075", properties:{imdbId:"0139801", name:"Michael Carr", url:"https://themoviedb.org/person/70075"}}, {tmdbId:"72171", properties:{imdbId:"2062221", name:"Mary Ellen Brighton", url:"https://themoviedb.org/person/72171"}}, {tmdbId:"1304260", properties:{imdbId:"0634027", name:"Thomas Noguchi", url:"https://themoviedb.org/person/1304260"}}, {tmdbId:"43203", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0268533", born:date('1951-07-22'), name:"Tisa Farrow", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jaW75xVFqP6586tYxaaZ3b3m6Zp.jpg", url:"https://themoviedb.org/person/43203"}}, {tmdbId:"3172", properties:{imdbId:"0311155", born:date('1923-04-05'), name:"Michael V. Gazzo", died:date('1995-02-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cTY2Hlf6sIR9xLI95bBir7eI0N.jpg", url:"https://themoviedb.org/person/3172"}}, {tmdbId:"44831", properties:{bornIn:"Park Ridge, Illinois, United States", imdbId:"0811202", born:date('1945-10-27'), name:"Carrie Snodgress", bio:"From Wikipedia, the free encyclopedia. \n\nCaroline \"Carrie\" Snodgress (October 27, 1945 – April 1, 2004) was an American actress. \n\nDescription above from the Wikipedia article Carrie Snodgress, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2004-04-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qpVTmJogzFVOuSPbKHPG0JhxBIo.jpg", url:"https://themoviedb.org/person/44831"}}, {tmdbId:"13023", properties:{bornIn:"San Francisco - California - USA", imdbId:"0131974", born:date('1953-06-07'), name:"Colleen Camp", bio:"Colleen Celeste Camp  (born June 7, 1953) is an American actress and film producer, known for her performances in two installments of the Police Academy series and as Yvette the Maid in the 1985 black comedy Clue.  She was also the first actress to play Kristin Shepard in U. S.  prime time soap opera Dallas in 1979.  Camp was born in San Francisco, California.  She had small early roles in films like 1975's Funny Lady with Barbra Streisand...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ykT8mEYZM57T6JH5RMIMaJQpReb.jpg", url:"https://themoviedb.org/person/13023"}}, {tmdbId:"938847", properties:{imdbId:"0082520", name:"Lucille Billingsley", url:"https://themoviedb.org/person/938847"}}, {tmdbId:"938848", properties:{imdbId:"0334360", name:"Zella Graham", url:"https://themoviedb.org/person/938848"}}, {tmdbId:"938849", properties:{imdbId:"0361913", name:"Cal Harberts", url:"https://themoviedb.org/person/938849"}}, {tmdbId:"938850", properties:{imdbId:"0361914", name:"Dan Harberts", url:"https://themoviedb.org/person/938850"}}, {tmdbId:"8892", properties:{bornIn:"Cambridge, Cambridgeshire, England, UK", imdbId:"0000556", born:date('1948-09-26'), name:"Olivia Newton-John", bio:"Olivia Newton-John AO, OBE (born 26 September 1948) is an English-born, Australian-raised singer and actress.  She is a four-time Grammy award winner who has amassed five No.  1 and ten other Top Ten Billboard Hot 100 singles and two No.  1 Billboard 200 solo albums.  Eleven of her singles (including two platinum) and 14 of her albums (including two platinum and four double platinum) have been certified gold by the RIAA...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aBaCMaR0dC6moLW2zkZ6B2uBJVn.jpg", url:"https://themoviedb.org/person/8892"}}, {tmdbId:"8894", properties:{bornIn:"New York City - New York - USA", imdbId:"0001063", born:date('1950-10-05'), name:"Jeff Conaway", bio:"Jeffrey Charles William Michael Conaway  is an American actor, best known for his roles in the movie Grease, and the US TV series Taxi and Babylon 5.  He also directed the 1992 film Bikini Summer 2...", died:date('2011-05-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5LSFAaWqppiYSJmikXciybmuFat.jpg", url:"https://themoviedb.org/person/8894"}}, {tmdbId:"8944", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0000130", born:date('1958-11-22'), name:"Jamie Lee Curtis", bio:"Jamie Lee Curtis (born November 22, 1958) is an American actress and author.  Although she was initially known as a \"scream queen\" because of her starring roles in several horror films early in her career, such as Halloween, The Fog, Prom Night and Terror Train, Curtis has since compiled a body of work that spans many genres.  Her 1998 book, Today I Feel Silly, and Other Moods That Make My Day, made the best-seller list in The New York Times...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2qZze4iDP7IIPvUUf3TY1EAFy7S.jpg", url:"https://themoviedb.org/person/8944"}}, {tmdbId:"11787", properties:{imdbId:"0477341", born:date('1949-12-19'), name:"Nancy Kyes", bio:"is an American film and television actress.  In most of her film appearances, she is credited under her stage name Nancy Loomis...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sjD5WHnW6VAw3hc8YzFyQCdTVdJ.jpg", url:"https://themoviedb.org/person/11787"}}, {tmdbId:"15500", properties:{bornIn:"Frankfurt, Germany", imdbId:"0001753", born:date('1950-07-17'), name:"P.J. Soles", bio:"Pamela Jayne Soles is a German-born American actress.  She made her film debut in 1976 as Norma Watson in Brian De Palma's Carrie before portraying Lynda van der Klok in John Carpenter's Halloween and Riff Randell in Allan Arkush's Rock 'n' Roll High School...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7gxTnPBddrC8HBBuLqdgSdRIuGL.jpg", url:"https://themoviedb.org/person/15500"}}, {tmdbId:"101765", properties:{bornIn:"Lexington, South Carolina, USA", imdbId:"0824113", born:date('1909-07-20'), name:"John Steadman", died:date('1993-01-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vYdiXIeBAZ0UD79QJzyAWWwVXmc.jpg", url:"https://themoviedb.org/person/101765"}}, {tmdbId:"99062", properties:{imdbId:"0090041", name:"Janus Blythe", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7ybqDKJhfV0gIfGKgpZ0o19LBvL.jpg", url:"https://themoviedb.org/person/99062"}}] AS row
