UNWIND [{tmdbId:"25181", properties:{bornIn:"Fort-de-l'Eau (aujourd'hui Bordj el Kiffan), département d'Alger", imdbId:"0897811", born:date('1932-03-20'), name:"Marthe Villalonga", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fD9oyI0SKEtn67JsgyoukLm5Z0u.jpg", url:"https://themoviedb.org/person/25181"}}, {tmdbId:"227933", properties:{bornIn:"France", imdbId:"0100440", name:"Jean-Pierre Bouvier", url:"https://themoviedb.org/person/227933"}}, {tmdbId:"10141", properties:{imdbId:"0294286", name:"Walter Frentz", url:"https://themoviedb.org/person/10141"}}, {tmdbId:"1090808", properties:{bornIn:"Rheydt, Germany", imdbId:"0324305", born:date('1897-10-29'), name:"Joseph Goebbels", died:date('1945-05-01'), url:"https://themoviedb.org/person/1090808"}}, {tmdbId:"2888", properties:{bornIn:"Philadelphia - Pennsylvania - USA", imdbId:"0000226", born:date('1968-09-25'), name:"Will Smith", bio:"Willard Christopher \"Will\" Smith, Jr.  (born September 25, 1968) is an American actor, film producer and pop rapper.  He has enjoyed success in music, television and film.  In April 2007, Newsweek called him the most powerful actor on the planet.  Smith has been nominated for four Golden Globe Awards, two Academy Awards, and has won multiple Grammy Awards. \n\nIn the late 1980s, Smith achieved modest fame as a rapper under the name The Fresh Prince...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eze9FO9VuryXLP0aF2cRqPCcibN.jpg", url:"https://themoviedb.org/person/2888"}}, {tmdbId:"9781", properties:{bornIn:"Brooklyn, New York City, New York, USA", imdbId:"0000505", born:date('1970-10-30'), name:"Nia Long", bio:"Nia Long (born October 30, 1970) is an American actress and occasional music video director.  She is best known for her roles in the television series The Fresh Prince of Bel-Air and Third Watch, and the films Soul Food, Love Jones, The Best Man, Big Momma's House, and Are We There Yet?     Long was born in Brooklyn, New York, U. S.  Her family is of Afro-Trinidadian descent.  Her name, Nia, is one of the seven days of Kwanzaa, which means purpose in Swahili...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2HnplqKDWkLyReeeAPsbEctkpPQ.jpg", url:"https://themoviedb.org/person/9781"}}, {tmdbId:"5920", properties:{bornIn:"London, Ontario", imdbId:"0727120", born:date('1962-02-04'), name:"Michael Riley", bio:"From Wikipedia, the free encyclopedia. \n\nMichael Riley (born February 4, 1962 in London, Ontario) is a Canadian actor and graduate of the National Theatre School in Montreal, Canada in 1984.  Riley's first appearance was in the film No Man's Land (1987).  He has acted in over 40 films and television series, including This Is Wonderland, for which he received a Gemini Award, and the Emmy-nominated BBC / Discovery Channel co-production Supervolcano...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/96Dzek5bAvEovJ4JDYbcqwvSJsi.jpg", url:"https://themoviedb.org/person/5920"}}, {tmdbId:"156515", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0710909", name:"Stephen Rappaport", url:"https://themoviedb.org/person/156515"}}, {tmdbId:"102313", properties:{bornIn:"Orange County, California, U.S.", imdbId:"0005220", born:date('1976-02-22'), name:"Tamara Mello", bio:"From Wikipedia, the free encyclopedia. \n\nTamara Beccam Mello (born February 22, 1976) is an American actress.  Her career began in 1993 with appearances on various television programs and films.  She has appeared in the TV series 7th Heaven, Boy Meets World, and Diagnosis: Murder and in the films The Brady Bunch Movie and She's All That. \n\nIn 1999, she appeared in the TV series Popular as Lily, the politically-correct vegetarian...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yOLFH0ucKqUGf2R84XHDMKRnpN.jpg", url:"https://themoviedb.org/person/102313"}}, {tmdbId:"99619", properties:{bornIn:"Wheeling, West Virginia, USA", imdbId:"0722269", born:date('1961-08-17'), name:"Ashlie Rhey", url:"https://themoviedb.org/person/99619"}}, {tmdbId:"6408", properties:{bornIn:"Harlingen, Texas, USA", imdbId:"0001763", born:date('1979-12-05'), name:"Nick Stahl", bio:"An American actor.  Starting out as a child actor, he gained recognition for his performance in the 1993 film The Man Without a Face and then embarked on a successful career as a child actor.  He later transitioned into his adult career with roles in Bully, Sin City, In the Bedroom, the HBO series Carnivàle, and the film Terminator 3: Rise of the Machines, in which he took over the role of John Connor, originally played by Edward Furlong.  He also recently starred in the film Mirrors 2...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hV1Fs7LcYWBQ90hWYA3DrCh0rPV.jpg", url:"https://themoviedb.org/person/6408"}}, {tmdbId:"65409", properties:{bornIn:"England - UK", imdbId:"0557739", born:date('1974-01-01'), name:"Fay Masterson", bio:"From Wikipedia, the free encyclopedia. \n\nFay Masterson (born 1974)  is an English film, television and video-game actress.  She is also a voice actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gKG30bketELJ7d22KIbX62djSKc.jpg", url:"https://themoviedb.org/person/65409"}}, {tmdbId:"24292", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0012178", born:date('1929-02-04'), name:"Jerry Adler", bio:"From Wikipedia, the free encyclopedia. \n\nJerry Adler (born February 4, 1929) is an American theatre director, production supervisor and a television and film actor. \n\nAdler was born in Brooklyn, New York, the son of Pauline and Philip Adler, who was a general manager of the Group Theatre.  He was raised in a Jewish observant household...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8HZi9sk98qH5IroTc1vyyo2AZ3C.jpg", url:"https://themoviedb.org/person/24292"}}, {tmdbId:"8792", properties:{bornIn:"Kansas City, Missouri, USA ", imdbId:"0169565", born:date('1933-08-10'), name:"Lynn Cohen", bio:"An actress, known for Munich (2005), The Hunger Games: Catching Fire (2013) and The Cobbler (2014).  She has been married to Ronald T.  Cohen since June 3, 1964.  She was previously married to Gilbert L.  Frazen...", died:date('2020-02-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gF2YATtRwDbnLB5eG0DGeHFW2QM.jpg", url:"https://themoviedb.org/person/8792"}}, {tmdbId:"57773", properties:{imdbId:"0877928", born:date('1971-07-13'), name:"Tyrin Turner", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z3FIkcfqgwTKwvr7Ecr0DszfJi5.jpg", url:"https://themoviedb.org/person/57773"}}, {tmdbId:"18291", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0005478", born:date('1975-09-08'), name:"Larenz Tate", bio:"Larenz Tate (born September 8, 1975) is an American film and television actor.  Tate was born on the west side of Chicago, Illinois.  He is the youngest of three siblings whose family moved to California when he was nine years old.  Convinced by their parents to enter a drama program at the Inner City Cultural Center, the trio did not take the lessons seriously until classmate Malcolm-Jamal Warner's ascent to fame after being cast on the sitcom The Cosby Show...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gkmf4YRm6TI5Guu9LjQIOxIoQvC.jpg", url:"https://themoviedb.org/person/18291"}}, {tmdbId:"156015", properties:{name:"June Kyoto Lu", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rWppbtw6vCe2fDEX0c6JFUjtofk.jpg", url:"https://themoviedb.org/person/156015"}}, {tmdbId:"156963", properties:{imdbId:"0865084", name:"Toshi Toda", url:"https://themoviedb.org/person/156963"}}, {tmdbId:"68751", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0004958", born:date('1931-06-14'), name:"Marla Gibbs", bio:"​From Wikipedia, the free encyclopedia.   \n\nMarla Gibbs (born June 14, 1931) is an American television and film actress and singer.  She is best remembered for playing Isabel Sanford's and Sherman Hemsley's sarcastic maid, Florence Johnston, on The Jeffersons and spinoff Checking In.  She also starred as Mary Jenkins on the television series 227. \n\nDescription above from the Wikipedia article Marla Gibbs, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/68751"}}, {tmdbId:"62842", properties:{bornIn:"Kansas City, Missouri, USA ", imdbId:"0341176", born:date('1968-07-15'), name:"Eddie Griffin", bio:"Edward \"Eddie\" Griffin  (born July 15, 1968) is an American actor and comedian.  He's best known for his sitcom, Malcolm &amp; Eddie, along with co-star, Malcolm-Jamal Warner, and his role in the 2002 comedy film, Undercover Brother as the film’s title character.  He also made headlines in 2007 for crashing a Ferrari Enzo...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ios0QYYyZ9YdJGnsS8aClpB9kcs.jpg", url:"https://themoviedb.org/person/62842"}}] AS row
