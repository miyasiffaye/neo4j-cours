UNWIND [{tmdbId:"39596", properties:{bornIn:"Hollister, California", imdbId:"0895308", born:date('1972-10-08'), name:"Tricia Vessey", bio:"From Wikipedia, the free encyclopedia\n\nTricia Vessey (born October 8, 1972 in Hollister, California) is an American actress. \n\nVessey grew up in Monterey, California.  Some of her film work includes: Ghost Dog: The Way of the Samurai, Trouble Every Day, Town & Country, Coming Soon, On the Edge, Nobody Needs to Know, The Brave and Bean. \n\nShe has one child, a son, with Anton Newcombe...", url:"https://themoviedb.org/person/39596"}}, {tmdbId:"13609", properties:{bornIn:"Francia", imdbId:"0220976", born:date('1958-01-01'), name:"Alex Descas", bio:"Alex Descas (born 1958) is a French actor known for his roles in Jim Jarmusch films and for his role as Schneider in the French TV series Un Flic. \n\nHe is a frequent collaborator of Claire Denis, appearing in her films No Fear, No Die, Nénette et Boni, Trouble Every Day, Ten Minutes Older: The Cello, 35 Shots of Rum and Bastards.  He is of Antillean (Guadeloupean) descent. \n\nDescription above from the Wikipedia article Alex Descas, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1FUMJTbVflnDR8vZL3J1Hv8f7tV.jpg", url:"https://themoviedb.org/person/13609"}}, {tmdbId:"16972", properties:{bornIn:"Barcelona, Cataluña, Spain", imdbId:"0530365", born:date('1965-12-22'), name:"Sergi López", bio:"Sergi López i Ayats (born 22 December 1965) is a Spanish actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4g8d39gl435tdmVXWMNeHC9SK4r.jpg", url:"https://themoviedb.org/person/16972"}}, {tmdbId:"1527640", properties:{bornIn:"France", imdbId:"0895607", born:date('1945-01-01'), name:"Jacques Viala", died:date('2012-07-12'), url:"https://themoviedb.org/person/1527640"}}, {tmdbId:"3517", properties:{bornIn:"Paris, France", imdbId:"0667573", born:date('1920-07-17'), name:"Paul Pavel", bio:"Paul Pavel est un acteur français, né Paul Kriatchko à Paris le 17 juillet 1920 et mort en novembre 2012 dans le Gard.  Il tourna également de nombreuses séries télévisées...", died:date('2012-01-01'), url:"https://themoviedb.org/person/3517"}}, {tmdbId:"13446", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0244630", born:date('1980-12-30'), name:"Eliza Dushku", bio:"Eliza Patricia Dushku  (born December 30, 1980) is an American actress known for her television roles, including recurring appearances as Faith on Buffy the Vampire Slayer and its spinoff series Angel.  She starred in two Fox series, Tru Calling and Dollhouse.  She is also known for her role in films including True Lies, The New Guy, Bring It On, Wrong Turn and Jay and Silent Bob Strike Back...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bNy4TSYriOsSbn13LNZaYSzKS1K.jpg", url:"https://themoviedb.org/person/13446"}}, {tmdbId:"154038", properties:{imdbId:"0573097", born:date('1985-10-04'), name:"Cody McMains", url:"https://themoviedb.org/person/154038"}}, {tmdbId:"51325", properties:{bornIn:"Brussels, Belgium", imdbId:"0753737", born:date('1981-01-06'), name:"Jérémie Renier", bio:"Jérémie Renier (born 6 January 1981) is a Belgian actor.  He lives in Paris, France.  His film debut was in the critically praised La Promesse (1996), directed by Luc and Jean-Pierre Dardenne.  He became better known to worldwide audiences in Brotherhood of the Wolf (2001) and L'Enfant (2005).  The latter was also directed by the Dardenne brothers...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7tZQEuutNMxdvdCCHkqCiJENGBq.jpg", url:"https://themoviedb.org/person/51325"}}, {tmdbId:"38865", properties:{bornIn:"Lyon, France", imdbId:"0444248", born:date('1979-04-02'), name:"Salim Kechiouche", bio:"From Wikipedia, the free encyclopedia\n\nSalim Kéchiouche (born April 2, 1979 in Lyons) is a French actor. \n\nDescription above from the Wikipedia article Salim Kéchiouche, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8SG1RTlxHUgiracjs9sMSyLCZ6V.jpg", url:"https://themoviedb.org/person/38865"}}, {tmdbId:"1762314", properties:{name:"Billy Mitchell", url:"https://themoviedb.org/person/1762314"}}, {tmdbId:"42387", properties:{imdbId:"0834067", name:"Christopher-Robin Street", url:"https://themoviedb.org/person/42387"}}, {tmdbId:"1061895", properties:{imdbId:"0773664", name:"Tobias Schneebaum", url:"https://themoviedb.org/person/1061895"}}, {tmdbId:"143280", properties:{bornIn:"Long Branch, New Jersey, USA", imdbId:"0537551", born:date('1923-01-31'), name:"Norman Mailer", died:date('2007-11-10'), url:"https://themoviedb.org/person/143280"}}, {tmdbId:"1061896", properties:{imdbId:"3627685", name:"Michael Nelson Rockefeller", url:"https://themoviedb.org/person/1061896"}}, {tmdbId:"11868", properties:{bornIn:"Washington, District of Columbia, USA", imdbId:"0859503", born:date('1970-12-17'), name:"Sean Patrick Thomas", bio:"​From Wikipedia, the free encyclopedia.   \n\nSean Patrick Thomas (born December 17, 1970) is an American actor.  He is perhaps best known for his co-starring role in the 2001 film Save the Last Dance, as well as his television role as Detective Temple Page in The District. \n\nDescription above from the Wikipedia article Sean Patrick Thomas, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/52OOnJ8pbqEWWd16rpI1pJge9Ml.jpg", url:"https://themoviedb.org/person/11868"}}, {tmdbId:"11703", properties:{bornIn:"Bronx, New York, USA", imdbId:"0913488", born:date('1977-01-31'), name:"Kerry Washington", bio:"Kerry Washington is an American actress.  She is known for her roles as Ray Charles's wife, Della Bea Robinson, in the film Ray (2004), as Idi Amin's wife Kay in The Last King of Scotland, and as Alicia Masters, love interest of Ben Grimm/The Thing in the live-action Fantastic Four films of 2005 and 2007...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/u6zfZGHabfSGIHDwbO7aI5Qg37L.jpg", url:"https://themoviedb.org/person/11703"}}, {tmdbId:"59568", properties:{bornIn:"Queens, New York, USA", imdbId:"0823507", born:date('1971-04-18'), name:"Fredro Starr", bio:"​From Wikipedia, the free encyclopedia.   \n\nFredro Scruggs (born January 1, 1970), better known by his stage name Fredro Starr, is an American rapper and actor from South Jamaica, Queens best known as a member of hardcore rap group Onyx. \n\nDescription above from the Wikipedia article redro Starr, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2N2JWF1S353JFcbpkEHkg06b1o.jpg", url:"https://themoviedb.org/person/59568"}}, {tmdbId:"67538", properties:{bornIn:"Walnut Creek, California, U.S.", imdbId:"0101333", born:date('1980-11-26'), name:"Jessica Bowman", bio:"Jessica Robyn Bowman (born November 26, 1980) is an American actress perhaps best known for her role as Colleen Cooper on Dr.  Quinn, Medicine Woman. \n\nDescription above from the Wikipedia article Jessica Bowman, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/67538"}}, {tmdbId:"55824", properties:{bornIn:"Niterói, Rio de Janeiro, Brazil", imdbId:"0073162", born:date('1972-07-13'), name:"Murilo Benício", bio:"From Wikipedia, the free encyclopedia\n\nMurilo Benício Ribeiro (born July 13, 1972, in Niterói, Rio de Janeiro, Brazil) is a Brazilian actor, best known for his roles in Brazilian soap operas, or 'novelas'.  He is best known in the United States for his film roles in Woman On Top with Penélope Cruz.  Novelas that he was featured in were Amores Possíveis which won the Jury Award for Latin American Cinema at the Sundance Film Festival, and his television roles in O Clone and América...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/s0XAc0kGZ35kM9TswY86mrsuW30.jpg", url:"https://themoviedb.org/person/55824"}}, {tmdbId:"11365", properties:{bornIn:"New York City, New York, USA", imdbId:"0275417", born:date('1971-06-08'), name:"Mark Feuerstein", bio:"From Wikipedia, the free encyclopedia\n\nMark Feuerstein (born June 8, 1971) is an American actor. \n\nDescription above from the Wikipedia article Mark Feuerstein, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1XsbDSx7hqhaY9Sjjx86iTp43S0.jpg", url:"https://themoviedb.org/person/11365"}}] AS row
