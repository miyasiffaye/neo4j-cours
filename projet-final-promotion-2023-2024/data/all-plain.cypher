UNWIND [{tmdbId:"4602", properties:{bornIn:"Princeton - New Jersey - USA", imdbId:"0855103", born:date('1961-12-16'), name:"Jon Tenney", bio:"From Wikipedia, the free encyclopedia. \n\nJonathan F.  W...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ktb1RA23pHJKMdcFenQ2cosnCkp.jpg", url:"https://themoviedb.org/person/4602"}}, {tmdbId:"4605", properties:{imdbId:"0171903", name:"Eugene Collier", url:"https://themoviedb.org/person/4605"}}, {tmdbId:"76130", properties:{imdbId:"0095176", born:date('1981-12-03'), name:"Brian Bonsall", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q4GOHtSIekeVY7hxVKniBPTyPNe.jpg", url:"https://themoviedb.org/person/76130"}}, {tmdbId:"76131", properties:{bornIn:"New York City, New York, USA", imdbId:"0240565", born:date('1961-05-23'), name:"Karen Duffy", url:"https://themoviedb.org/person/76131"}}, {tmdbId:"7223", properties:{bornIn:"Santa Monica, California, USA", imdbId:"0492441", born:date('1955-03-29'), name:"Christopher Lawford", bio:"From Wikipedia, the free encyclopedia Christopher Kennedy Lawford (born March 29, 1955) is an American author, actor and activist and member of the prominent Kennedy family.  Description above from the Wikipedia article Christopher Lawford, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2018-09-04'), url:"https://themoviedb.org/person/7223"}}, {tmdbId:"22134", properties:{imdbId:"0109620", born:date('1944-03-18'), name:"Ritch Brinkley", url:"https://themoviedb.org/person/22134"}}, {tmdbId:"16433", properties:{bornIn:"Newman, Illinois, USA", imdbId:"0304000", born:date('1940-04-20'), name:"James Gammon", bio:"From Wikipedia, the free encyclopedia. \n\nJames Richard Gammon (April 20, 1940 – July 16, 2010) was an American actor, known for playing grizzled \"good ol' boy\" types in numerous movies and television shows\n\nDescription above from the Wikipedia article James Gammon, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('20