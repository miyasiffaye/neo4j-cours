UNWIND [{tmdbId:"236539", properties:{bornIn:"Detroit, Michigan, United States", imdbId:"3611349", born:date('1984-09-22'), name:"Jordan Vogt-Roberts", bio:"Jordan Charles Vogt-Roberts is an American film and television director.  His feature directorial debut, The Kings of Summer, screened at the 2013 Sundance Film Festival, where it was nominated for the Grand Jury Prize, and also at the 2013 Cleveland International Film Festival.  The film won the Narrative Feature Audience Award at the 2013 Dallas International Film Festival. [1] He also wrote and directed a short film which screened at the Sundance Film Festival and SXSW, Successful Alcoholics...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fcCoGMKl9bdeMoRlIxXJj3FGaAx.jpg", url:"https://themoviedb.org/person/236539"}}, {tmdbId:"5665", properties:{imdbId:"0066534", name:"Dan Beers", url:"https://themoviedb.org/person/5665"}}, {tmdbId:"1016214", properties:{bornIn:"Recife, Pernambuco, Brazil", imdbId:"2207625", born:date('1968-01-01'), name:"Kleber Mendonça Filho", bio:"Kleber Mendonça Filho (born 1968) is a Brazilian film director, screenwriter, producer, and critic. \n\nWith a degree in Journalism from the Federal University of Pernambuco, Kleber Mendonça Filho began his career as a film critic and journalist.   As a director, he experimented with fiction, documentary, and video clips in the 1990s.  He migrated from video to digital and 35 mm film in the 2000s.  Over the course of that decade, he made several short films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7jOzp98FiL6C22tphTHEPWAhK11.jpg", url:"https://themoviedb.org/person/1016214"}}, {tmdbId:"1204338", properties:{imdbId:"0578446", name:"Rob Meltzer", url:"https://themoviedb.org/person/1204338"}}, {tmdbId:"70900", properties:{imdbId:"0161137", name:" Janet Chun", bio:"Janet Chun Siu-chun went to work for John Woo after graduation, taking up continuity on The Killers (1989) and Bullet in the Head (1990), doubling as scriptwriter for the latter.  She then served as assistant director and writer on Once a Thief (1991) and as writer and costume designer on The Hard Boiled (1992).  She had worked on dozens of films, including Lee Rock (1991), C’est La Vie, Mon Ch�ri (1993), A Chinese Odyssey (1994), Armageddon (1997) and 2000 A.  D...", url:"https://themoviedb.org/person/70900"}}, {tmdbId:"1184624", properties:{imdbId:"1852117", name:"Jason Wise", url:"https://themoviedb.org/person/1184624"}}, {tmdbId:"1293582", properties:{imdbId:"4716310", name:"Steve Wolsh", url:"https://themoviedb.org/person/1293582"}}, {tmdbId:"559", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0002892", born:date('1961-07-08'), name:"Wally Pfister", bio:"Wally Pfister was born on July 8, 1961 in Chicago, Illinois, USA as Walter Pfister.  He is known for his work on The Dark Knight (2008), Inception (2010) and The Dark Knight Rises (2012).  He has been married to Anna Julien since 1992...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uyWeYsERTTLjpjkE79QeSETLIoA.jpg", url:"https://themoviedb.org/person/559"}}, {tmdbId:"1052930", properties:{bornIn:"New York, New York", imdbId:"0466428", born:date('1972-12-31'), name:"Jacob Kornbluth", bio:"Jacob Kornbluth is the award-winning director of documentary Inequality for All, and feature films Haiku Tunnel and The Best Thief in the World.  All three films premiered in competition at the Sundance Film Festival...", url:"https://themoviedb.org/person/1052930"}}, {tmdbId:"1098658", properties:{imdbId:"2151439", name:"John Poliquin", url:"https://themoviedb.org/person/1098658"}}, {tmdbId:"68574", properties:{imdbId:"0178589", name:"Brad Copeland", url:"https://themoviedb.org/person/68574"}}, {tmdbId:"1059571", properties:{bornIn:"Houston, Texas, USA", imdbId:"2798574", born:date('1983-05-07'), name:"Justin Simien", url:"https://themoviedb.org/person/1059571"}}, {tmdbId:"59824", properties:{imdbId:"1925528", name:"Gary Entin", url:"https://themoviedb.org/person/59824"}}, {tmdbId:"1085287", properties:{imdbId:"2531147", name:"Neil Barsky", url:"https://themoviedb.org/person/1085287"}}, {tmdbId:"69987", properties:{bornIn:"Paris, France", imdbId:"1362432", born:date('1967-05-11'), name:"Jérôme Salle", bio:"Jérôme Salle (born 1971) is a French film director and screenwriter.  Salle has directed the films Anthony Zimmer, the Belgian comic book adaptation Largo Winch and its sequel The Burma Conspiracy.  His 2013 film Zulu was selected as the closing film at the 2013 Cannes Film Festival.  The movie The Tourist, written and directed by Florian Henckel von Donnersmarck, was based on Salle's screenplay for Anthony Zimmer and grossed US$ 278 million worldwide...", url:"https://themoviedb.org/person/69987"}}, {tmdbId:"1091979", properties:{bornIn:"New Delhi, India", imdbId:"1263934", name:"Nisha Pahuja", url:"https://themoviedb.org/person/1091979"}}, {tmdbId:"1088579", properties:{bornIn:"Al Ahsa, Saudi Arabia", imdbId:"2223783", born:date('1974-08-10'), name:"Haifaa Al-Mansour", bio:"Haifaa al-Mansour is the first female filmmaker in Saudi Arabia and is regarded as one of the most significant cinematic figures in the Kingdom.  She finished her bachelor's degree in Literature at the American University in Cairo and completed a Master's degree in Directing and Film Studies from the University of Sydney...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/67UWpEJi36AXxY3aQf4DBSvGv9e.jpg", url:"https://themoviedb.org/person/1088579"}}, {tmdbId:"1265056", properties:{imdbId:"1509613", name:"Jorge R. Gutiérrez", url:"https://themoviedb.org/person/1265056"}}, {tmdbId:"1083453", properties:{imdbId:"0396075", name:"Masahiro Hosoda", url:"https://themoviedb.org/person/1083453"}}, {tmdbId:"288710", properties:{bornIn:"USA", imdbId:"1225921", born:date('1977-01-01'), name:"Liz W. Garcia", bio:"American television producer, writer and director.  As a writer, her credits include Dawson's Creek, Wonderfalls and Cold Case.  Garcia's film credits include the 1988 film Return of the Killer Tomatoes and the 2002 film The New Guy as production assistant.  She wrote and directed The Lifeguard, starring Kristen Bell...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/flUCA51HIIKBbSco2CaSphKDPn5.jpg", url:"https://themoviedb.org/person/288710"}}] AS row
