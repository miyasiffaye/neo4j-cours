UNWIND [{tmdbId:"1211812", properties:{bornIn:"Leeds - Alabama - USA", imdbId:"0004725", born:date('1963-02-20'), name:"Charles Barkley", bio:"Charles Barkley an American retired professional basketball player...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ceRTD8xYs13kcyPcV6feH9vkDwb.jpg", url:"https://themoviedb.org/person/1211812"}}, {tmdbId:"2192577", properties:{name:"Bernard Goldberg", url:"https://themoviedb.org/person/2192577"}}, {tmdbId:"2573406", properties:{name:"Robert Putnam", url:"https://themoviedb.org/person/2573406"}}, {tmdbId:"62644", properties:{bornIn:"New York City, New York, USA", imdbId:"1265067", born:date('1975-07-06'), name:"50 Cent", bio:"Curtis James Jackson III (born July 6, 1975), better known by his stage name 50 Cent, is an American rapper and actor.  He rose to fame with the release of his albums Get Rich or Die Tryin' (2003) and The Massacre (2005)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uyEfYdXj8lJusUyH7I7ChvhDXPH.jpg", url:"https://themoviedb.org/person/62644"}}, {tmdbId:"334", properties:{imdbId:"0589077", born:date('1978-10-07'), name:"Omar Benson Miller", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AcqG401p1RKMkyGw7JBJWATFqQ9.jpg", url:"https://themoviedb.org/person/334"}}, {tmdbId:"2038", properties:{bornIn:"London, England, UK", imdbId:"0365140", born:date('1976-09-06'), name:"Naomie Harris", bio:"Naomie Melanie Harris (born 6 September 1976) is an English screen actress known for her breakout starring role as Selena in 28 Days Later, her supporting turns as Tia Dalma in the second and third Pirates of the Caribbean films and her portrayal of Eve Moneypenny in the James Bond franchise...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/41TVAcYqKKF7PGf3x7QfaLvkLSW.jpg", url:"https://themoviedb.org/person/2038"}}, {tmdbId:"84384", properties:{bornIn:"Riyadh, Saudi Arabia", imdbId:"1136915", born:date('1957-03-10'), name:"Osama bin Laden", bio:"Osama bin Mohammed bin Awad bin Laden was the founder of al-Qaeda, the terrorist organization responsible for the September 11 attacks on the United States and numerous other mass-casualty attacks against civilian and military targets.  He was a member of the wealthy Saudi bin Laden family, and an ethnic Yemeni Kindite.  Bin Laden was on the American Federal Bureau of Investigation's (FBI) lists of Ten Most Wanted Fugitives and Most Wanted Terrorists for his involvement in the 1998 U. S...", died:date('2011-05-02'), url:"https://themoviedb.org/person/84384"}}, {tmdbId:"1183687", properties:{imdbId:"1763115", name:"Gilles Kepel", url:"https://themoviedb.org/person/1183687"}}, {tmdbId:"34434", properties:{bornIn:"Montreal, Quebec, Canada", imdbId:"1335291", born:date('1982-06-16'), name:"Missy Peregrym", bio:"Melissa \"Missy\" Peregrym (born June 16, 1982, height 5' 6½\" (1,69 m)) is a Canadian actress and former fashion model.  She made her feature film debut in the 2006 gymnastics comedy drama Stick It.  She played a recurring role as Candice Wilmer on the NBC television series Heroes, and starred in the CW television series Reaper.  She currently stars as Andy McNally on the ABC and Global TV television series Rookie Blue...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/364PJwTQLpWjGfNisQm47Dler08.jpg", url:"https://themoviedb.org/person/34434"}}, {tmdbId:"52938", properties:{bornIn:"Montréal, Québec, Canada", imdbId:"0501837", born:date('1985-07-21'), name:"Vanessa Lengies", bio:"​From Wikipedia, the free encyclopedia.   \n\nVanessa Lynne-Marie Lengies is a Canadian actress best known for starring in the drama American Dreams as Roxanne Bojarski...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/81Nh2wTKWiB6c4miiMZfBvTPoye.jpg", url:"https://themoviedb.org/person/52938"}}, {tmdbId:"63676", properties:{bornIn:"Los Angeles - California - USA", imdbId:"1840748", born:date('1988-08-20'), name:"Nikki SooHoo", bio:"​From Wikipedia, the free encyclopedia.   \n\nNicole \"Nikki\" SooHoo (born August 20, 1988, height 5' 2½\" (1,59 m)) is a Chinese-American actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ieuRxb9FbTNdyQFWC2YWG5V0YtX.jpg", url:"https://themoviedb.org/person/63676"}}, {tmdbId:"1075012", properties:{imdbId:"1408394", name:"Ritchie Allen", url:"https://themoviedb.org/person/1075012"}}, {tmdbId:"60255", properties:{bornIn:"New York City, New York, USA", imdbId:"1545471", born:date('1994-12-03'), name:"Jake T. Austin", bio:"From Wikipedia, the free encyclopedia\n\nJake T.  Austin (born Jake Austin Szymanski; December 3, 1994) is an American actor.  He is best known for his role as Max Russo, the youngest of three wizards, on the Disney Channel original series, Wizards of Waverly Place, and as the voice of Diego, on the Nickelodeon animated series Go, Diego, Go!. \n\nDescription above from the Wikipedia article Jake T.  Austin, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fcLGoKd7ZvvkYAyFOP2txI28YHN.jpg", url:"https://themoviedb.org/person/60255"}}, {tmdbId:"208310", properties:{imdbId:"1735042", name:"Cherise Boothe", url:"https://themoviedb.org/person/208310"}}, {tmdbId:"1075013", properties:{imdbId:"2375398", name:"Jesse Bronstein", url:"https://themoviedb.org/person/1075013"}}, {tmdbId:"30429", properties:{imdbId:"1544103", name:"Stan Collymore", url:"https://themoviedb.org/person/30429"}}, {tmdbId:"30433", properties:{bornIn:"London, England, UK", imdbId:"0556453", born:date('1976-01-01'), name:"Neil Maskell", bio:"Neil Maskell is a British stage, film and television actor, best known for his roles in the British television shows \"Utopia\" and \"Humans\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/12dDCWSE8GXrhnzHuaEWxNJFfrN.jpg", url:"https://themoviedb.org/person/30433"}}, {tmdbId:"54691", properties:{bornIn:"Los Angeles, California, USA ", imdbId:"2395586", born:date('1989-06-20'), name:"Christopher Mintz-Plasse", bio:"Christopher Charles Mintz-Plasse (born June 20, 1989 height 5' 7½\" (1,71 m)) is an American actor known for starring in films such as Superbad, Role Models, Year One, and Kick-Ass. \n\nDescription above from the Wikipedia article Christopher Mintz-Plasse, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qBXWQ1sjfcgy2jKTWY9CsDCHfAg.jpg", url:"https://themoviedb.org/person/54691"}}, {tmdbId:"75633", properties:{bornIn:"Kansas City - Missouri - USA", imdbId:"1442928", born:date('1996-02-28'), name:"Bobb'e J. Thompson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/otRWlY9G3cUlQN3fAN4uuRfBAS6.jpg", url:"https://themoviedb.org/person/75633"}}, {tmdbId:"47296", properties:{bornIn:"Seattle, WA, USA", imdbId:"0604742", born:date('1966-04-22'), name:"Jeffrey Dean Morgan", bio:"Jeffrey Dean Morgan (born April 22, 1966) is an American actor, best known to television and movie audiences as Denny Duquette on Grey's Anatomy, patriarch John Winchester on Supernatural, and as The Comedian in the 2009 superhero film Watchmen.  He is known for often playing characters whose death is significant to the plot...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/V3zDGR4rvED9fG7ODv1ph1Q4z4.jpg", url:"https://themoviedb.org/person/47296"}}] AS row
