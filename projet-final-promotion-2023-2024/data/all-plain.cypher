b.org/movie/34023", tmdbId:"34023", plot:"Sardu, master of the Theatre of the Macabre, and his assistant Ralphus run a show in which, under the guise of 'magic', they torture and murder people in front of their audience. But what the punters see as a trick is actually real.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sRFWfces1Aa2yPRzDt4NVuYrysQ.jpg", released:"1976-11-03"}}, {movieId:"105769", properties:{languages:["English"], year:2013, imdbId:"1821641", runtime:122, imdbRating:6.5, countries:["Israel", " Germany", " Poland", " Luxembourg", " Belgium", " France"], imdbVotes:11819, title:"Congress, The", url:"https://themoviedb.org/movie/152795", revenue:455815, tmdbId:"152795", plot:"An aging, out-of-work actress accepts one last job, though the consequences of her decision affect her in ways she didn't consider.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oeT9rwfCBayxgVoUn1yZGmkZlUq.jpg", released:"2014-07-24"}}, {movieId:"105844", properties:{languages:["English"], year:2013, imdbId:"2024544", runtime:134, imdbRating:8.1, countries:["USA", " UK"], imdbVotes:409955, title:"12 Years a Slave", url:"https://themoviedb.org/movie/76203", revenue:187000000, tmdbId:"76203", plot:"In the antebellum United States, Solomon Northup, a free black man from upstate New York, is abducted and sold into slavery.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xdANQijuNrJaw1HA61rDccME4Tm.jpg", released:"2013-11-08", budget:20000000}}, {movieId:"105954", properties:{languages:["English"], year:2013, imdbId:"2017038", runtime:106, imdbRating:6.9, countries:["USA"], imdbVotes:57391, title:"All Is Lost", url:"https://themoviedb.org/movie/152747", revenue:6108720, tmdbId:"152747", plot:"After a collision with a shipping container at sea, a resourceful sailor finds himself, despite all efforts to the contrary, staring his mortality in the face.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9cVA4oX2xHgiglv6hemxwAaofsq.jpg", released:"2013-11-07",