UNWIND [{tmdbId:"42196", properties:{bornIn:"San Jose, California, USA", imdbId:"0382063", born:date('1958-02-19'), name:"Martin Hewitt", bio:"From Wikipedia, the free encyclopedia. \n\nMartin Hewitt (born February 19, 1958 in San Jose, California) is an American actor.  He is best known for his film debut as David Axelrod in Franco Zeffirelli's Endless Love (1981), as Dan in Yellowbeard and his role as Chad Douglas Fairchild in Zalman King's Two Moon Junction (1988)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tZ7BlKJSp6Etlh71JXRCIC1ALS6.jpg", url:"https://themoviedb.org/person/42196"}}, {tmdbId:"31431", properties:{bornIn:"Bristol, England, UK", imdbId:"0856050", born:date('1945-08-15'), name:"Nigel Terry", bio:"Nigel Terry (1945 -2015) was an English stage and film actor probably best known for his portrayal of King Arthur in John Boorman's 1981 film Excalibur, the future King John in 1968's A Lion In Winter, and for his work with legendary British auteur Derek Jarman, including the title role in his 1986 production of Caravaggio...", died:date('2015-04-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oSGakLqaffiEqZSQ6QqiJ5dumy7.jpg", url:"https://themoviedb.org/person/31431"}}, {tmdbId:"31196", properties:{bornIn:"London, England, United Kingdom", imdbId:"0165551", born:date('1946-09-18'), name:"Nicholas Clay", bio:"From Wikipedia, the free encyclopedia. \n\nNicholas Anthony Phillip Clay (18 September 1946 – 25 May 2000) was an English actor...", died:date('2000-05-25'), url:"https://themoviedb.org/person/31196"}}, {tmdbId:"20768", properties:{bornIn:"Nottingham, Nottinghamshire, England, UK", imdbId:"0526724", born:date('1952-04-04'), name:"Cherie Lunghi", bio:"Cherie Lunghi (born 4 April 1952) is an English film, television and theatre actress.  She is probably best known for her role as Guinevere in the 1981 film Excalibur, as football manageress Gabriella Benson in the 1990s television series The Manageress and for starring in a series of adverts for Kenco coffee.  She also competed in the 2008 series of Strictly Come Dancing.  She is the mother of the actress Nathalie Lunghi...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/LoIGKqUw3d58MrVsLpw22goYCK.jpg", url:"https://themoviedb.org/person/20768"}}, {tmdbId:"67566", properties:{imdbId:"0533249", name:"Stephen MacKenna", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2XcJIrA2NxjEJDT9XLFvRQWIMq5.jpg", url:"https://themoviedb.org/person/67566"}}, {tmdbId:"26857", properties:{bornIn:"Manchester, Greater Manchester, England, UK", imdbId:"0114441", born:date('1956-07-09'), name:"Philip Martin Brown", bio:"Philip Martin Brown is a British actor best known for his role as cantankerous teacher Grantly Budgen across all ten series of the BBC television series Waterloo Road...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dhgv8B6eyfUiDbrfGpWRdl8XnUP.jpg", url:"https://themoviedb.org/person/26857"}}, {tmdbId:"4783", properties:{bornIn:"Omagh, County Tyrone, Northern Ireland, UK", imdbId:"0000554", born:date('1947-09-14'), name:"Sam Neill", bio:"Nigel John Dermot \"Sam\" Neill (born 14 September 1947) is a New Zealand actor.  He is perhaps best known for his starring role as paleontologist Dr Alan Grant in Jurassic Park and Jurassic Park III...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bNZ03phkLewj8eUR6mGbKZ7jtmv.jpg", url:"https://themoviedb.org/person/4783"}}, {tmdbId:"66612", properties:{bornIn:"Auckland, New Zealand", imdbId:"0366027", born:date('1943-08-25'), name:"Lisa Harrow", bio:"Lisa Harrow (born 25 August 1943 in Auckland, New Zealand) is an actress, noted for her roles in British theatre, films and television. \n\nDescription above from the Wikipedia article Lisa Harrow, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xkSAsTcQIQXJCSPalIaVTHDEMTS.jpg", url:"https://themoviedb.org/person/66612"}}, {tmdbId:"41247", properties:{bornIn:"Winnipeg, Manitoba, Canada", imdbId:"0137230", born:date('1939-09-30'), name:"Len Cariou", bio:"From Wikipedia, the free encyclopedia. \n\nLeonard Joseph “Len” Cariou (born September 30, 1939) is a Canadian actor, best known for his portrayal of Sweeney Todd in the original cast of Sweeney Todd, the Demon Barber of Fleet Street.  He currently plays the patriarch in the multi-generational television series Blue Bloods on CBS...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9VJeCcxHkPkN4xH4izmwYHXRMy2.jpg", url:"https://themoviedb.org/person/41247"}}, {tmdbId:"16940", properties:{bornIn:"Cowes, Isle of Wight, England, UK", imdbId:"0000460", born:date('1948-09-19'), name:"Jeremy Irons", bio:"Jeremy John Irons (born 19 September 1948) is an English actor. \n\nAfter receiving classical training at the Bristol Old Vic Theatre School, Irons began his acting career on stage in 1969, and has since appeared in many London theatre productions including The Winter's Tale, Macbeth, Much Ado About Nothing, The Taming of the Shrew, and Richard II.  In 1984, he made his Broadway debut in Tom Stoppard's The Real Thing and received a Tony Award for Best Actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jWhutvBrpV09KQK7LqZxSdGSXFk.jpg", url:"https://themoviedb.org/person/16940"}}, {tmdbId:"72705", properties:{imdbId:"0574436", born:date('1949-12-28'), name:"Hilton McRae", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3MxRMfjiox5xcYtirhbylfIVKKZ.jpg", url:"https://themoviedb.org/person/72705"}}, {tmdbId:"72706", properties:{imdbId:"0604640", name:"Emily Morgan", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uT2XoHJqehdLd18TBj3bOMp7hlB.jpg", url:"https://themoviedb.org/person/72706"}}, {tmdbId:"58710", properties:{bornIn:"Pennsylvania, United States", imdbId:"0824386", born:date('1960-05-03'), name:"Amy Steel", bio:"From Wikipedia, the free encyclopedia. \n\nAmy Steel (born May 3, 1960) is an American film and television actress, also credited as Amy Steel Pulitzer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fFgpg2sNEbXQOWCxiv2qMRM0ysy.jpg", url:"https://themoviedb.org/person/58710"}}, {tmdbId:"55571", properties:{imdbId:"0298859", born:date('1951-04-13'), name:"John Furey", bio:"From Wikipedia, the free encyclopedia. \n\nJohn Furey is an American actor who has starred in film and on television.  He is best known for his role in the 1981 horror film Friday the 13th Part 2 as Paul Holt.  His most recent film is the 2005 movie The Galindez File. \n\nFurey appeared on the soap opera All My Children as Lee Hawkins in 1998.  Furey has made guest appearances on such TV shows as Eight Is Enough, CHiPs, Queer as Folk, and CSI: Crime Scene Investigation...", url:"https://themoviedb.org/person/55571"}}, {tmdbId:"58711", properties:{bornIn:"Songnefjord, Norway", imdbId:"0048661", born:date('1962-04-07'), name:"Kirsten Baker", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/veXO02TurDuzDEuMWbeajGIXbN0.jpg", url:"https://themoviedb.org/person/58711"}}, {tmdbId:"4000", properties:{bornIn:"Westchester, New York, USA", imdbId:"0000931", born:date('1962-05-02'), name:"Elizabeth Berridge", bio:"Elizabeth Berridge (born May 2, 1962) is an American film and theatre actress.  She is best-known for playing Constanze Mozart in the Academy Award winning 1984 film Amadeus. \n\nBerridge was born in New Rochelle, New York, the daughter of George Berridge, a lawyer, and Mary L.  Berridge (née Robinson), a social worker.  The Berridge family settled in Larchmont, New York, where she attended Chatsworth Elementary School, there she began to perform and sing...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hmSuiebPLyv24hHIiA1BL8aC1KL.jpg", url:"https://themoviedb.org/person/4000"}}, {tmdbId:"74642", properties:{imdbId:"0141323", name:"Shawn Carson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AtUtHGeM9fa59CAhyKWDUIYnM3H.jpg", url:"https://themoviedb.org/person/74642"}}, {tmdbId:"1012479", properties:{imdbId:"0042415", name:"Jeanne Austin", url:"https://themoviedb.org/person/1012479"}}, {tmdbId:"74641", properties:{bornIn:"Green River, Wyoming, USA", imdbId:"0567524", born:date('1893-09-09'), name:"Jack McDermott", died:date('1946-07-22'), url:"https://themoviedb.org/person/74641"}}, {tmdbId:"75349", properties:{bornIn:"Burbank - California - USA", imdbId:"0602844", born:date('1960-10-18'), name:"Erin Moran", bio:"Moran's first acting role was at the age of five, in a television commercial for First Federal Bank. [3] At the age of six, she was cast as Jenny Jones in the television series Daktari,[5] which ran from 1966 to 1969.  She made her feature-film debut in How Sweet It Is! (1968) with Debbie Reynolds,[6] and made regular appearances on The Don Rickles Show in 1972, and guest appearances in The Courtship of Eddie's Father, My Three Sons, Bearcats!, and Family Affair...", died:date('2017-04-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xipbY0i9JXmxXAqpoivXLijlqxH.jpg", url:"https://themoviedb.org/person/75349"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"55155", properties:{bornIn:"London , England , UK", imdbId:"0067049", born:date('1926-09-28'), name:"Bernard Behrens", died:date('2012-09-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6ibwaHJ45ZExo1eyUIJrATKdio7.jpg", url:"https://themoviedb.org/person/55155"}}, {tmdbId:"70752", properties:{bornIn:"Sydney, New South Wales, Australia", imdbId:"0497826", born:date('1958-01-01'), name:"Mark Lee", bio:"​From Wikipedia, the free encyclopedia.   \n\nMark Lee (born 1958) is an Australian actor and director, whose most prominent role was the lead in the film Gallipoli (1981), alongside Mel Gibson.  He has worked extensively in Australian film, television and theatre for over thirty years. \n\nHis debut was in 1969 in the film Strange holiday (based on the novel by Jules Verne)...", url:"https://themoviedb.org/person/70752"}}, {tmdbId:"70753", properties:{bornIn:"Cape Town, South Africa", imdbId:"0449652", born:date('1922-06-10'), name:"Bill Kerr", bio:"​From Wikipedia, the free encyclopedia.   \n\nWilliam 'Bill' Kerr (born 1922) is an Australian film and television actor.  He was born into a performing arts family in Cape Town, South Africa, but grew up in Wagga Wagga, New South Wales, Australia. \n\nHe began working as a child actor in depression era Australia, taking his first major role in The Silence of Dean Maitland, one of Australia's first talking films...", died:date('2014-08-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aJ7t8clJBKwG50en67Owk36XdAC.jpg", url:"https://themoviedb.org/person/70753"}}, {tmdbId:"70755", properties:{bornIn:"Toowoomba, Queensland, Australia", imdbId:"0394176", born:date('1944-03-06'), name:"Harold Hopkins", died:date('2011-12-11'), url:"https://themoviedb.org/person/70755"}}, {tmdbId:"1482678", properties:{imdbId:"0950971", name:"Charles Lathalu Yunipingu", url:"https://themoviedb.org/person/1482678"}}, {tmdbId:"64181", properties:{bornIn:"Burbank, California", imdbId:"0324397", born:date('1946-07-16'), name:"Dave Goelz", bio:"From Wikipedia, the free encyclopedia. \n\nDave Goelz (born July 16, 1946) is a puppeteer best-known for his association with The Muppets, and in particular with the Muppet character Gonzo.  His other Muppet characters include Dr.  Bunsen Honeydew, Zoot (the saxophonist of Dr.  Teeth and The Electric Mayhem), Beauregard the janitor and Tiny (the humungous chicken in The Adventures of Elmo in Grouchland) .  He also performed the characters of Boober Fraggle and Uncle Travelling Matt on Fraggle Rock...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tBJDwH008IVSeTCB5e2P856NbIv.jpg", url:"https://themoviedb.org/person/64181"}}, {tmdbId:"97884", properties:{bornIn:"Glasgow, Scotland, UK", imdbId:"0329947", born:date('1962-02-04'), name:"John Gordon Sinclair", bio:"From Wikipedia, the free encyclopedia.   John Gordon Sinclair (born 1962, Glasgow) is a Scottish actor most famous for playing Gregory in Gregory's Girl.  He was born as Gordon John but took the stage name 'John Gordon Sinclair' because Equity already had a Gordon John registered. \n\nHe joined Glasgow's Youth Theatre after he visited one night and met fellow fan of Canadian progressive rock group Rush, Robert Buchanan...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2iDe3PnGvXOC13VkhAKQ1c4jqMk.jpg", url:"https://themoviedb.org/person/97884"}}, {tmdbId:"97885", properties:{bornIn:"Airdrie, Scotland", imdbId:"0378342", born:date('1961-11-07'), name:"Dee Hepburn", bio:"From Wikipedia, the free encyclopedia.   Dee Hepburn (born November 7, 1961 in Airdrie, Scotland) is a former actor. \n\nShe trained in acting, and took a part as a school girl in the BBC's production of The Prime of Miss Jean Brodie.  She starred in Bill Forsyth's 1981 film Gregory's Girl, playing John Gordon Sinclair's love interest Dorothy...", url:"https://themoviedb.org/person/97885"}}, {tmdbId:"97887", properties:{imdbId:"0195438", name:"Jake D'Arcy", bio:"From Wikipedia, the free encyclopedia.   Jake D'Arcy is a Scottish actor best known for playing \"Pete the Jakey\" on Scottish comedy show Still Game. \n\nD'Arcy first appeared in Rab C.  Nesbitt and then he later appeared as Pete the Jakey on Still Game.  His most recent appearance was on the Christmas special of British comedy show Outnumbered as Mack, a friend of Grampa. \n\nDescription above from the Wikipedia article Jake D'Arcy , licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9l3Df8pcarIFZrUMTTIqdWR1M63.jpg", url:"https://themoviedb.org/person/97887"}}, {tmdbId:"97889", properties:{bornIn:"Glasgow, Scotland", imdbId:"0342931", born:date('1962-03-17'), name:"Clare Grogan", bio:"From Wikipedia, the free encyclopedia.   Clare Grogan (born Claire Patricia Grogan, 17 March 1962, Glasgow) is a Scottish actress and singer.  She is sometimes credited as C.  P.  Grogan. \n\nDescription above from the Wikipedia article Clare Grogan, licensed under CC-BY-SA,full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/97889"}}, {tmdbId:"5616", properties:{bornIn:"Miami Beach, Florida, USA", imdbId:"0569239", born:date('1945-10-21'), name:"Everett McGill", bio:"Everett McGill (born October 21, 1945) is an American actor, best known for mostly playing villains in films like Licence to Kill, Silver Bullet, Yanks and Under Siege 2: Dark Territory. \n\nDescription above from the Wikipedia article Everett McGill, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4LMEfVrkkifznxMtrQjDINJazts.jpg", url:"https://themoviedb.org/person/5616"}}, {tmdbId:"2372", properties:{bornIn:"New York City, New York, USA", imdbId:"0000579", born:date('1950-04-13'), name:"Ron Perlman", bio:"Ron Perlman is an American film and television actor, best known for his titular role in the \"Hellboy\" movies and his long run as Clay Morrow on the television series \"Sons of Anarchy\", as well as scores of other iconic performances, including \"The Name of the Rose\", \"City of Lost Children\", and \"Pacific Rim\".  He won a Golden Globe for his role as Vincent in the television series \"Beauty and the Beast\" and is a star and executive producer of the Amazon series \"Hand of God\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nfky6J9ueey1gMdWMNU9k9YdfGP.jpg", url:"https://themoviedb.org/person/2372"}}, {tmdbId:"152970", properties:{bornIn:"Istanbul, Turkey", imdbId:"0252832", born:date('1952-09-22'), name:"Nicholas Kadi", bio:"​From Wikipedia, the free encyclopedia\n\nNicholas Kadi (born Nameer El-Kadi; September 22, 1952) is a Turkish-born Iraqi American actor. \n\nKadi was born in Istanbul, Turkey of Iraqi descent.  His father, Nizar el Kadi, was an Iraqi ambassador. \n\nKadi has appeared in numerous television sitcoms and series, such as JAG, Sleeper Cell, Alias, 24, ER, The Young and the Restless and The Wayans Bros.  He is fluent in Arabic and French...", url:"https://themoviedb.org/person/152970"}}, {tmdbId:"13312", properties:{bornIn:"Edmonton, Alberta, Canada", imdbId:"0001044", born:date('1961-02-28'), name:"Rae Dawn Chong", bio:"From Wikipedia, the free encyclopedia\n\nRae Dawn Chong (born February 28, 1961) is a Canadian-American actress. \n\nDescription above from the Wikipedia article Rae Dawn Chong, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aj9fFFKH3QZX2FSJsj81I4y12M7.jpg", url:"https://themoviedb.org/person/13312"}}, {tmdbId:"11786", properties:{bornIn:"Niagara Falls, New York", imdbId:"0194234", born:date('1939-07-28'), name:"Charles Cyphers", bio:"​From Wikipedia, the free encyclopedia.   \n\nCharles Cyphers (born July 28, 1939) is an American actor who has starred in many films and on television.  He is known in the horror movie community for his work in the films of John Carpenter, especially his role as Sheriff Leigh Brackett in Carpenter's 1978 hit horror movie Halloween.  He reprised this role in the 1981 sequel Halloween II.  He is not related to actor Jon Cypher, alongside whom he played in Hill Street Blues...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hEaBgUG7wXI9vsTPIFaqOiTDDfK.jpg", url:"https://themoviedb.org/person/11786"}}, {tmdbId:"8609", properties:{bornIn:"New York City, New York, United States", imdbId:"0469552", born:date('1945-07-15'), name:"Jeffrey Kramer", bio:"Jeffrey Kramer (born July 15, 1945) is an Emmy Award-winning American film and television actor and film producer. \n\nKramer was born in New York City and grew up in Teaneck, New Jersey, graduating from Teaneck High School with the Class of 1963. [citation needed] He made his first appearance on the TV series Barney Miller starring in the episode Snow Job as the \"Stick Up Man\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tLlMHQtZWhR3qHXBu1RR6NanERX.jpg", url:"https://themoviedb.org/person/8609"}}, {tmdbId:"18859", properties:{bornIn:"New York City, New York, USA", imdbId:"0546004", born:date('1948-11-18'), name:"Andrea Marcovicci", bio:"From Wikipedia, the free encyclopedia\n\nAndrea Louisa Marcovicci (born November 18, 1948) is an American actress and singer. \n\nDescription above from the Wikipedia article Andrea Marcovicci, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fkfWYm0xw5glAwifv9aBDL7fyLL.jpg", url:"https://themoviedb.org/person/18859"}}, {tmdbId:"34535", properties:{imdbId:"0568499", name:"Annie McEnroe", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5jMUfQ1x075zj9LjImm2QmDF04u.jpg", url:"https://themoviedb.org/person/34535"}}, {tmdbId:"87461", properties:{bornIn:" Vancouver, British Columbia, Canada", imdbId:"0290475", born:date('1932-02-28'), name:"Don Francks", bio:"An Avid Voice Artist, Actor & Arts Persona, Don Francks Personified The 20th Century With His Candid Attitude & Great Looks, He Starred Alongside Don Adams & Frank Welker, He Starred Alongside Actress Patricia Hamilton.  His Daughter Is Non Other Than Famed Voice Actress Cree Summer, And His Son Is The Famed Canadian Television Actor Rainbow Francks.  In His Late Career He Continued Acting On Hemlock Grove.  He Died In Early 2016.  His Career Lives On Forever In Film...", died:date('2016-04-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q1bvy838NZCLDxWLpwhJYC5FsDA.jpg", url:"https://themoviedb.org/person/87461"}}, {tmdbId:"1282665", properties:{imdbId:"0760098", name:"Caroline Semple", url:"https://themoviedb.org/person/1282665"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"87462", properties:{bornIn:"Edmonton, Alberta, Canada", imdbId:"0738751", born:date('1957-04-17'), name:"Susan Roman", bio:"Susan Roman is a Canadian voice actress, best known for voice acting the role of Lita/Sailor Jupiter in the North American DiC dub of the anime, Sailor Moon.  She is one of the few voice actors to remain throughout the entire run of the series...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vyWyOdnKcoNf40ytZSy6qlIIr9p.jpg", url:"https://themoviedb.org/person/87462"}}, {tmdbId:"100618", properties:{bornIn:"Salt Lake City, Utah, USA", imdbId:"0112403", born:date('1953-09-11'), name:"Kevin Brophy", url:"https://themoviedb.org/person/100618"}}, {tmdbId:"62001", properties:{bornIn:"Kansas City, Kansas, USA", imdbId:"0908914", born:date('1948-12-14'), name:"Dee Wallace", bio:"An American actress and comedienne.  She is perhaps best known for her roles in several popular films.  These include the starring role as Elliot's mother in the Steven Spielberg film E. T.  the Extra-Terrestrial (1982), her most widely seen role.  She also played key roles in popular cult films The Hills Have Eyes (1977) and The Howling (1981) and appeared in The Stepford Wives in 1975 and 10 (1979).  In total, Wallace has appeared in more than 85 films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pP0zEU2NKPhWvDOTwrDCgEr8NnE.jpg", url:"https://themoviedb.org/person/62001"}}, {tmdbId:"10662", properties:{bornIn:"Paddington, London, England, UK", imdbId:"0001495", born:date('1922-02-06'), name:"Patrick Macnee", bio:"Patrick Macnee (born 6 February 1922) was an English actor, best known for his role as the secret agent John Steed in the series The Avengers...", died:date('2015-06-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/awLUXzzZxOXdeuJUPzOWT1Z7bDs.jpg", url:"https://themoviedb.org/person/10662"}}, {tmdbId:"65404", properties:{bornIn:"Manchester, New Hampshire, United States", imdbId:"0831791", born:date('1942-10-04'), name:"Christopher Stone", bio:"Was an American actor.  Stone appeared on film and television from the early 1970s and married actress Dee Wallace in 1980.  Together, they appeared in a number of films together including the classic horror films The Howling (1981) and Cujo (1983).  They also shared top billing in the family series The New Lassie (1989), in which he sometimes served as director...", died:date('1995-10-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wO1l1v8JnJHi2Ya1AbeoovmMrKh.jpg", url:"https://themoviedb.org/person/65404"}}, {tmdbId:"152998", properties:{imdbId:"0481635", name:"Gary Lahti", url:"https://themoviedb.org/person/152998"}}, {tmdbId:"552623", properties:{imdbId:"0408776", name:"Amy Ingersoll", url:"https://themoviedb.org/person/552623"}}, {tmdbId:"15098", properties:{bornIn:"Springfield, Massachusetts, USA", imdbId:"0004931", born:date('1917-09-18'), name:"June Foray", died:date('2017-07-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eG0wbPZ8153MLlTS0U48rZhiJgf.jpg", url:"https://themoviedb.org/person/15098"}}, {tmdbId:"110654", properties:{imdbId:"0292677", born:date('1926-08-07'), name:"Stan Freberg", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/msFe4Y7ud9k3DgcCmlXL0EZH6nR.jpg", url:"https://themoviedb.org/person/110654"}}, {tmdbId:"1229538", properties:{imdbId:"0416850", name:"Ralph James", bio:"Ralph James Torrez (November 29, 1924 – March 14, 1992) was an American voice and character actor who lived in Los Angeles County, California.  Although he did voices for the Looney Tunes, James might be remembered best for performing the voice of Mr.  Turtle in the classic commercials for Tootsie Pops which ran throughout the 1970s...", url:"https://themoviedb.org/person/1229538"}}, {tmdbId:"27752", properties:{bornIn:" Auckland, North Island, New Zealand", imdbId:"0817748", born:date('1945-09-17'), name:"Bruce Spence", bio:"​From Wikipedia, the free encyclopedia. \n\nBruce Spence  (born 17 September 1945 in Auckland, New Zealand) is an actor, having spent most of his career performing in Australia.  Bruce attended Henderson High School in West Auckland.  Spence is most known for his roles as the Gyro Captain in Mad Max 2 and as Jedediah the pilot in Mad Max Beyond Thunderdome, and as \"Zedd\" (Zeddicus Zu'l Zorander) in Legend of the Seeker...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kuaIudFTIBahGAdCamThG13jPp7.jpg", url:"https://themoviedb.org/person/27752"}}, {tmdbId:"47461", properties:{bornIn:"Hackney, London, England", imdbId:"0696463", born:date('1938-05-14'), name:"Michael Preston", bio:"From Wikipedia, the free encyclopedia. \n\nMichael Preston (born Jack Davies 14 May 1938, Hackney, London, England) is an international film and television actor, sometimes credited as Mike Preston. \n\nDescription above from the Wikipedia article Michael Preston, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kcfNCp4uXqKhlqcfWrwfTalA5Gz.jpg", url:"https://themoviedb.org/person/47461"}}, {tmdbId:"121417", properties:{imdbId:"0681041", born:date('1939-11-18'), name:"Max Phipps", died:date('2000-08-06'), url:"https://themoviedb.org/person/121417"}}, {tmdbId:"10647", properties:{bornIn:"Bad Aussee, Austria", imdbId:"0001970", born:date('1943-06-22'), name:"Klaus Maria Brandauer", bio:"From Wikipedia, the free encyclopedia. \n\nKlaus Maria Brandauer (born 22 June 1943) is an Austrian actor, film director, and professor at the Max Reinhardt Seminar in Vienna. \n\nDescription above from the Wikipedia article Klaus Maria Brandauer, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sD15196S8BAvnhajXloH92Tots3.jpg", url:"https://themoviedb.org/person/10647"}}, {tmdbId:"2807", properties:{bornIn:"Starachowice, Poland", imdbId:"0417370", born:date('1952-12-18'), name:"Krystyna Janda", bio:"From Wikipedia, the free encyclopedia.   Krystyna Janda (born 18 December 1952, Starachowice, Poland) is a Polish film and theater actress best known, in the West, for playing leading roles in several films by Polish director Andrzej Wajda, including Man of Marble (Człowiek z marmuru, 1976) and Man of Iron (Człowiek z żelaza, 1981)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AmOfMDKwhm8dN41C9kAPAGR09nO.jpg", url:"https://themoviedb.org/person/2807"}}, {tmdbId:"70913", properties:{imdbId:"0126569", born:date('1947-10-19'), name:"Ildikó Bánsági", url:"https://themoviedb.org/person/70913"}}, {tmdbId:"6270", properties:{bornIn:"Ellrich, Germany", imdbId:"0388744", born:date('1930-12-06'), name:"Rolf Hoppe", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eUtMIOmAArtFiJ9kS8GpkqL6Tv1.jpg", url:"https://themoviedb.org/person/6270"}}, {tmdbId:"100633", properties:{bornIn:"San Marcos, Texas, USA", imdbId:"0313519", born:date('1944-12-11'), name:"Lynda Day George", bio:"Lynda Louise Day George (December 11, 1944) is an American television and film actress whose career spanned three decades from the 1960s to the 1980s.  She was a cast member on Mission: Impossible.  She was also the wife of actor Christopher George...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lO7hQr91sFlG5Lr3YDqLr1GoGoU.jpg", url:"https://themoviedb.org/person/100633"}}, {tmdbId:"72888", properties:{bornIn:"Pola de Allande, Asturias, Spain", imdbId:"0106394", born:date('1934-02-24'), name:"Frank Braña", bio:"Francisco Braña Pérez (Pola de Allande, Asturias, February 24, 1934 - Majadahonda, February 13, 2012) was a spanish actor...", died:date('2012-02-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pm3atvF3WIxv1RsVSLeie5YSKjy.jpg", url:"https://themoviedb.org/person/72888"}}, {tmdbId:"26155", properties:{bornIn:"Welwyn Garden City, Hertfordshire, England, UK", imdbId:"0700803", born:date('1924-12-20'), name:"Edmund Purdom", bio:"Edmund Anthony Cutlar Purdom (19 December 1924 – 1 January 2009) was an English actor, voice artist, and director.  He worked first on stage in Britain, performing various works by Shakespeare, then later in America on Broadway, until making his way to Hollywood, and eventually spent the remainder of his life appearing in Italian cinema.  He is perhaps best known for his starring role in 1954's historical epic The Egyptian...", died:date('2009-01-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yHSztNpSyXitAHO7odegJWmQmu6.jpg", url:"https://themoviedb.org/person/26155"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"38160", properties:{bornIn:"New York City, New York, USA", imdbId:"0001091", born:date('1951-05-25'), name:"Patti D'Arbanville", bio:"From Wikipedia, the free encyclopedia\n\nPatricia \"Patti\" D'Arbanville (born May 25, 1951) is an American actress and former model. \n\nDescription above from the Wikipedia article Patti D'Arbanville, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jj2Xk1PjqmiOzGkBa5D8l2UMmfa.jpg", url:"https://themoviedb.org/person/38160"}}, {tmdbId:"5960", properties:{bornIn:"Tulsa, Oklahoma, USA", imdbId:"0005316", born:date('1947-09-23'), name:"Mary Kay Place", bio:"From Wikipedia, the free encyclopedia. \n\nMary Kay Place (born September 23, 1947) is an American actress, singer, director and screen writer.  She is best known as portraying Loretta Haggers on the television series Mary Hartman, Mary Hartman, a role which won her a Primetime Emmy Award for Outstanding Supporting Actress - Comedy Series in 1977.  Place also recorded one studio album for Columbia Records in the Haggers persona, which included the Top Ten country music hit \"Baby Boy...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iFZTr6qpFSzJURPOg0YN89pg0RP.jpg", url:"https://themoviedb.org/person/5960"}}, {tmdbId:"2958", properties:{bornIn:"Savannah, Georgia, USA", imdbId:"0769311", born:date('1955-08-27'), name:"Diana Scarwid", bio:"Diana Scarwid (born August 27, 1955) is an American actress.  Scarwid has done work in film, television and theater. \n\nDescription above from the Wikipedia article Diana Scarwid, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/f9dYXofY0sLgGZssXQX4peG9NiF.jpg", url:"https://themoviedb.org/person/2958"}}, {tmdbId:"44998", properties:{bornIn:"Huntsville, Texas, USA", imdbId:"0002079", born:date('1924-09-29'), name:"Steve Forrest", bio:"A ruggedly handsome action man of the 1960's and 70's, Steve Forrest  began his screen career as a small part contract player with MGM.  A  brother of star Dana Andrews,  he was born William Forrest Andrews, the youngest of thirteen children.   His father was a Baptist minister in Huntsville, Texas.  In 1942, Steve  enlisted in the U. S.  Army, rose to the rank of sergeant and saw action  at the Battle of the Bulge...", died:date('2013-05-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9UeIk3gaEbFvkdZqqnSiwp8eTWf.jpg", url:"https://themoviedb.org/person/44998"}}, {tmdbId:"12900", properties:{bornIn:"New York City, New York, USA", imdbId:"0001728", born:date('1943-11-12'), name:"Wallace Shawn", bio:"Wallace Shawn (born November 12, 1943) is an American actor, voice actor, playwright, essayist and comedian. \n\nHis film roles have included those of Wally Shawn in My Dinner with Andre, Vizzini in The Princess Bride, Mr.  Hall in Clueless and Rex in the Toy Story franchise.  He has also appeared in a variety of television series, including recurring roles as Cyrus Rose in Gossip Girl and as Grand Nagus Zek in Star Trek: Deep Space Nine...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tiiz0t7fFiaeoujUyejzIiLRYpu.jpg", url:"https://themoviedb.org/person/12900"}}, {tmdbId:"109470", properties:{bornIn:"Paris, France", imdbId:"0339737", born:date('1934-05-11'), name:"Andre Gregory", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jc9sMA0kkoDViSUSc8QEi9uvi4Y.jpg", url:"https://themoviedb.org/person/109470"}}, {tmdbId:"143806", properties:{imdbId:"0501721", born:date('1904-08-09'), name:"Jean Lenauer", died:date('1983-10-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qDXZNkH6smKfNe5whrULFf9jA1Y.jpg", url:"https://themoviedb.org/person/143806"}}, {tmdbId:"1757529", properties:{name:"Roy Butler", url:"https://themoviedb.org/person/1757529"}}, {tmdbId:"84762", properties:{bornIn:"Philadelphia, Pennsylvania", imdbId:"0907923", born:date('1943-01-09'), name:"Kathryn Walker", bio:"​From Wikipedia, the free encyclopedia.   \n\nKathryn Walker (born January 9, 1943 in Philadelphia, Pennsylvania) is an American theater, television and film actress.  She was with Douglas Kenney for many years until his death in 1980 at the age of 32, and was married to singer James Taylor from 1985 to 1995.  In 2008 Kathryn Walker published a novel, A Stopover in Venice (Knopf, ISBN 0-307-26706-7)...", url:"https://themoviedb.org/person/84762"}}, {tmdbId:"1757", properties:{bornIn:"Bombay, Maharashtra, India", imdbId:"0001422", born:date('1948-10-02'), name:"Persis Khambatta", bio:"​From Wikipedia, the free encyclopedia\n\nPersis Khambatta (2 October 1948 – 18 August 1998) was an Indian model, actress and author.  She was best known for her role as Lieutenant Ilia in the 1979 feature film Star Trek: The Motion Picture.  The name Persis is Greek meaning Persian woman and can be found in the Bible. \n\nDescription above from the Wikipedia article Persis Khambatta, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1998-08-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5gMJGOEDl0Z3xJNgqFhF9g0c8Rm.jpg", url:"https://themoviedb.org/person/1757"}}, {tmdbId:"70569", properties:{bornIn:"Pompton Plains, New Jersey, USA", imdbId:"0571630", born:date('1966-06-10'), name:"Doug McKeon", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qq1wJuRaHjd3vefnWoKml48byHb.jpg", url:"https://themoviedb.org/person/70569"}}, {tmdbId:"36926", properties:{bornIn:"Washington, District of Columbia, USA", imdbId:"0827973", born:date('1930-01-13'), name:"Frances Sternhagen", bio:"Frances Hussey Sternhagen is an American actress.  Sternhagen has appeared on and off Broadway, in movies, and on TV since the 1950s...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4eJzKYiAiQBPAHxJVgkdcNbXEnG.jpg", url:"https://themoviedb.org/person/36926"}}, {tmdbId:"65568", properties:{bornIn:"Los Angeles, California, United States", imdbId:"0797725", born:date('1934-03-05'), name:"James Sikking", bio:"An American actor known for his role as Lt.  Howard Hunter on the 1980s NBC TV series Hill Street Blues.  He also starred on the ABC TV series Doogie Howser, M. D.  as Dr.  David Howser and on the short-lived 1997 CBS drama series Brooklyn South as Captain Stan Jonas.  Sikking did the voice of General Gordon on the short-lived 1998 cartoon series Invasion America...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6FDWsE7uDf7jvTEJakrgN7GdvqI.jpg", url:"https://themoviedb.org/person/65568"}}, {tmdbId:"237404", properties:{bornIn:"New Orleans, Louisiana, USA", imdbId:"0046770", born:date('1949-07-31'), name:"Vernel Bagneris", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ivAsCfYEFsKeJMH1kSPAnfFXWYi.jpg", url:"https://themoviedb.org/person/237404"}}, {tmdbId:"42198", properties:{bornIn:" Shreveport, Louisiana, USA", imdbId:"0642078", born:date('1945-03-11'), name:"Tricia O'Neil", url:"https://themoviedb.org/person/42198"}}, {tmdbId:"140384", properties:{imdbId:"0544750", name:"Steve Marachuk", url:"https://themoviedb.org/person/140384"}}, {tmdbId:"2714", properties:{bornIn:"New York City, New York, USA", imdbId:"0000448", born:date('1940-05-05'), name:"Lance Henriksen", bio:"An American actor and artist best known to film and television audiences for his roles in science fiction, action, and horror films such as The Terminator, the Alien film franchise, and on television shows such as Millennium.  Henriksen is also a voice actor; he is noted for his deep, commanding voice...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1PkFmD5HdjmRa2DumtwINnnAjTH.jpg", url:"https://themoviedb.org/person/2714"}}, {tmdbId:"1212003", properties:{imdbId:"0004967", born:date('1965-01-05'), name:"Ricky Paull Goldin", url:"https://themoviedb.org/person/1212003"}}, {tmdbId:"933623", properties:{bornIn:"São Paulo, São Paulo, Brazil", imdbId:"0196236", born:date('1967-11-29'), name:"Fernando Ramos da Silva", bio:"Fernando was the star of only one film in his short life.  He played Pixote - a street child - in Pixote, a Lei do Mais Fraco (1981).  During his short period of fame, Fernando was seen as a symbol of hope for the Brazilian street kids.  He grew up in a poor neighborhood of Diadema - a industrial city close to São Paulo - Brazil.  Illiterate and poor, Fernando played Pixote at the age of 11 years old.  His only previous experience in acting was an amateur play...", died:date('1987-08-25'), url:"https://themoviedb.org/person/933623"}}, {tmdbId:"933624", properties:{imdbId:"0432247", name:"Jorge Julião", url:"https://themoviedb.org/person/933624"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"933625", properties:{bornIn:"Francisco Sá, Minas Gerais, Brazil", imdbId:"0609923", born:date('1963-11-01'), name:"Gilberto Moura", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fYSyMMSrHBAsyu70pBvax0o9jKb.jpg", url:"https://themoviedb.org/person/933625"}}, {tmdbId:"76520", properties:{imdbId:"0760290", name:"David Samson", url:"https://themoviedb.org/person/76520"}}, {tmdbId:"10263", properties:{bornIn:"Stolberg, Germany", imdbId:"0071502", born:date('1921-07-18'), name:"Heinz Bennent", bio:"Heinz Bennent (born July 18, 1921 in Stolberg near Aachen) was a German actor. \n\nHis career began after the end of World War II in Göttingen.  He moved to Switzerland in the 1970s, where he lives until his death.  His children, Anne Bennent and David Bennent also work as actors...", died:date('2011-10-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4T3avFG7FItSWzAcvyUzjjGCHgl.jpg", url:"https://themoviedb.org/person/10263"}}, {tmdbId:"15765", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"0171475", born:date('1928-12-10'), name:"John Colicos", bio:"​From Wikipedia, the free encyclopedia\n\nJohn Colicos (December 10, 1928 – March 6, 2000) was a Canadian actor.  He was a distinguished stage actor in the United Kingdom, the United States and Canada. \n\nDescription above from the Wikipedia article John Colicos, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2000-03-06'), url:"https://themoviedb.org/person/15765"}}, {tmdbId:"4250", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0503627", born:date('1941-06-22'), name:"Michael Lerner", bio:"Michael Lerner (born June 22, 1941) is an American actor. \n\nDescription above from the Wikipedia article Michael Lerner (actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lyJHZRLpBGiOYEXXvnlxq2NAboY.jpg", url:"https://themoviedb.org/person/4250"}}, {tmdbId:"725", properties:{bornIn:"New York City, New York, USA", imdbId:"0001583", born:date('1935-10-20'), name:"Jerry Orbach", died:date('2004-12-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xsj8wntuztnaKattjpZUVFXp8nZ.jpg", url:"https://themoviedb.org/person/725"}}, {tmdbId:"47771", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0286561", born:date('1937-08-03'), name:"Richard Foronjy", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/s50kiAStdTY2F128HxOfCMCqgcc.jpg", url:"https://themoviedb.org/person/47771"}}, {tmdbId:"124009", properties:{imdbId:"0082400", born:date('1935-12-26'), name:"Don Billett", url:"https://themoviedb.org/person/124009"}}, {tmdbId:"18559", properties:{bornIn:" Paris, France", imdbId:"0220852", born:date('1920-08-24'), name:"Jean Desailly", bio:"Jean Desailly (August 24, 1920, Paris – June 11, 2008) was a French actor.  He was a member of the Comédie-Française from 1942 – 1946, and later participated in about ninety movies. \n\nDesailly was married to the French actress Simone Valère...", died:date('2008-06-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fMR14DvAHQE0Ruv34alWv49VNKV.jpg", url:"https://themoviedb.org/person/18559"}}, {tmdbId:"18561", properties:{imdbId:"0163250", born:date('1955-12-01'), name:"Cyrielle Clair", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n38kpROjrCZbSjZLZKPaJ1v7jwO.jpg", url:"https://themoviedb.org/person/18561"}}, {tmdbId:"234715", properties:{imdbId:"0221102", name:"Marie-Christine Descouard", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5kKWoI7pTQRo5xglp9waWBwJkDy.jpg", url:"https://themoviedb.org/person/234715"}}, {tmdbId:"27384", properties:{imdbId:"0539081", born:date('1947-04-10'), name:"Paolo Malco", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6DVx8adpHYokOanqYVZOkMDcxuC.jpg", url:"https://themoviedb.org/person/27384"}}, {tmdbId:"102012", properties:{bornIn:"Rome, Italy", imdbId:"0682582", born:date('1957-02-28'), name:"Ania Pieroni", bio:"​From Wikipedia, the free encyclopedia\n\nAnia Pieroni (born 1957 in Rome) is an Italian actress from the late 1970s and early 1980s. \n\nDescription above from the Wikipedia article Ania Pieroni, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mmYRXxLMfdWYvWc9o3GhVhGFnWV.jpg", url:"https://themoviedb.org/person/102012"}}, {tmdbId:"102013", properties:{imdbId:"0294703", born:date('1972-09-08'), name:"Giovanni Frezza", url:"https://themoviedb.org/person/102013"}}, {tmdbId:"21315", properties:{bornIn:"Biloxi, Mississippi, USA", imdbId:"0000616", born:date('1956-04-18'), name:"Eric Roberts", bio:"An American actor.  His career began with a well-received performance in King of the Gypsies (1978), for which he earned his first Golden Globe Award nomination.  His second Golden Globe nomination came for his portrayal of Paul Snider in Star 80 (1983), followed by Globe and Academy Award nominations for his supporting role in Runaway Train (1985)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o0EyI0Otwyg0jwxLpbmV20I57oi.jpg", url:"https://themoviedb.org/person/21315"}}, {tmdbId:"590", properties:{bornIn:"Memphis, Tennessee, USA", imdbId:"0761836", born:date('1944-01-10'), name:"William Sanderson", bio:"William Sanderson (born January 10, 1948) is an American character actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i3JfaavAFq9ayeJ4doUaOGjHMMW.jpg", url:"https://themoviedb.org/person/590"}}, {tmdbId:"4513", properties:{bornIn:"Evanston, Illinois, USA", imdbId:"0001527", born:date('1961-07-18'), name:"Elizabeth McGovern", bio:"Elizabeth McGovern (born July 18, 1961) is an American film, television, and theater actor. \n\nIn 1980, while studying at Juilliard, McGovern was offered a part in her first film, Ordinary People, in which she played the girlfriend of troubled teenager Timothy Hutton. \n\nThe following year she completed her education as an actress at the American Conservatory Theatre and at The Juilliard School, and began to appear in plays, first Off-Broadway and later in famous theaters...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ihYdCKyr3JPz74tPuvkn1WSNh9b.jpg", url:"https://themoviedb.org/person/4513"}}, {tmdbId:"652", properties:{bornIn:"Hertfordshire, England, UK", imdbId:"0293550", born:date('1943-01-18'), name:"Paul Freeman", bio:"Paul Freeman is a British film and television actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mLDHLughdhSe6AqsklX0Zhjk9Rx.jpg", url:"https://themoviedb.org/person/652"}}, {tmdbId:"653", properties:{bornIn:"Harrow, Greater London, England, United Kingdom", imdbId:"0479951", born:date('1935-09-28'), name:"Ronald Lacey", bio:"Ronald Lacey (28 September 1935 – 15 May 1991) was an English actor.  He made numerous television and film appearances over a 30 year period and is perhaps best remembered for his villainous roles in Hollywood films, most famously Major Arnold Toht in Raiders of the Lost Ark. \n\nDescription above from the Wikipedia article Ronald Lacey, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1991-05-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mHWfZjEevMaIqjcyrrnFKFRUHV6.jpg", url:"https://themoviedb.org/person/653"}}, {tmdbId:"52995", properties:{bornIn:"Washington, D.C., U.S.", imdbId:"0001346", born:date('1943-07-21'), name:"Edward Herrmann", bio:"Edward Kirk Herrmann, born July 21, 1943, in Washington, D. C. , was an American television and film actor.  He is best known for his Emmy-nominated portrayals of Franklin D.  Roosevelt on television, to younger generations for his role as Richard Gilmore in Gilmore Girls, as a ubiquitous narrator for historical programs on the History Channel, and as the spokesperson for Dodge automobiles in the 1990s. \n\nHermann died from brain cancer, Wednesday, December 31, 2014, in a hospital in New York City...", died:date('2014-12-31'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sO9IoAlw3CLJZT6UF35cZBcTYRV.jpg", url:"https://themoviedb.org/person/52995"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"64822", properties:{bornIn:"Lódz, Poland, Russian Empire [now Lódz, Lódzkie, Poland]", imdbId:"0467085", born:date('1933-06-14'), name:"Jerzy Kosinski", bio:"Jerzy Nikodem Kosiński , born Józef Lewinkopf, was a Polish-American novelist and two-time President of the American Chapter of P. E. N. , who wrote primarily in English.  For several decades, Kosinski was famous as a wit, a great raconteur, and a media celebrity.  His first three novels were big hits.  However, in June 22, 1982, \"Jerzy Kosinski's Tainted Words,\" an article by Geoffrey Stokes and Eliot Fremont-Smith in The Village Voice, accused Jerzy Kosinski of plagiarism and dishonesty...", died:date('1991-05-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xInICevdL141kUrAxmYSbzx3xPm.jpg", url:"https://themoviedb.org/person/64822"}}, {tmdbId:"129267", properties:{imdbId:"0249760", name:"Marion Edward", url:"https://themoviedb.org/person/129267"}}, {tmdbId:"129268", properties:{imdbId:"0656186", name:"Grant Page", url:"https://themoviedb.org/person/129268"}}, {tmdbId:"12259", properties:{bornIn:"Genoa, Liguria, Italy", imdbId:"0002094", born:date('1922-09-01'), name:"Vittorio Gassman", bio:"From Wikipedia, the free encyclopedia. \n\nVittorio Gassman Knight Grand Cross OMRI (September 1, 1922 – June 29, 2000), popularly known as Il Mattatore, was an Italian theatre and film actor and director.  He is considered one of the greatest Italian actors and is commonly recalled as an extremely professional, versatile, magnetic interpreter, whose long career includes both important productions as well as dozens of divertissements (which made him greatly popular)...", died:date('2000-06-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sLMqeXVCdoIAoTpCZmObfi44uI2.jpg", url:"https://themoviedb.org/person/12259"}}, {tmdbId:"6280", properties:{bornIn:"Snyder, Texas, U.S.", imdbId:"0000959", born:date('1948-06-01'), name:"Powers Boothe", bio:"From Wikipedia, the free encyclopedia. \n\nPowers Allen Boothe (born June 1, 1948) is an American television and film actor.  Some of his most notable roles include his Emmy-winning 1980 portrayal of Jim Jones and his turn as Cy Tolliver on Deadwood, as well as Vice-President Noah Daniels on 24. \n\nDescription above from the Wikipedia article Powers Boothe, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2017-05-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qk1KVY5N83MsO4Qvg4W1JA8SNFH.jpg", url:"https://themoviedb.org/person/6280"}}, {tmdbId:"10430", properties:{bornIn:"San Diego, California, USA", imdbId:"0911542", born:date('1942-12-30'), name:"Fred Ward", bio:"An American actor.  He began his career in 1979 alongside Clint Eastwood in Escape from Alcatraz.  He is best known for his starring roles in the motion pictures Remo Williams, Tremors, Henry & June, Short Cuts, The Right Stuff and Exit Speed.  Ward also acted in European movies...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/t3tZduAwP1LMR8Vc13HZ39wKJ1q.jpg", url:"https://themoviedb.org/person/10430"}}, {tmdbId:"45039", properties:{bornIn:"Ripley, Tennessee, USA", imdbId:"0641509", born:date('1954-06-20'), name:"Miles O'Keeffe", bio:"From Wikipedia, the free encyclopedia.   Miles O'Keeffe (born June 20, 1954) is a television and movie actor.  O'Keeffe got his first big break playing the title role in the 1981 version of Tarzan, the Ape Man. \n\nDescription above from the Wikipedia article Miles O'Keeffe, licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/39WNGWJ4mXYqvIGkrgfW369IrVN.jpg", url:"https://themoviedb.org/person/45039"}}, {tmdbId:"1035934", properties:{bornIn:"Staten Island, New York, USA", imdbId:"0361039", born:date('1956-03-17'), name:"Patti Hansen", url:"https://themoviedb.org/person/1035934"}}, {tmdbId:"27772", properties:{bornIn:"Burbank - California - USA", imdbId:"0000615", born:date('1948-09-17'), name:"John Ritter", bio:"Johnathan Southworth \"John\" Ritter (September 17, 1948 – September 11, 2003) was an American actor, voice over artist and comedian perhaps best known for playing Jack Tripper and Paul Hennessy in the ABC sitcoms Three's Company and 8 Simple Rules, respectively.  Don Knotts called him the \"Greatest physical comedian on the planet\".  Ritter's final films Bad Santa, Clifford's Really Big Movie and Stanley's Dinosaur Round-Up were all dedicated in his memory...", died:date('2003-09-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7NhDVzAhWKWxxfXzPbpDY1KpoO7.jpg", url:"https://themoviedb.org/person/27772"}}, {tmdbId:"1046030", properties:{bornIn:"Montréal, Québec, Canada", imdbId:"0779026", born:date('1962-12-01'), name:"David Scott", died:date('1993-01-05'), url:"https://themoviedb.org/person/1046030"}}, {tmdbId:"1352277", properties:{imdbId:"1002603", name:"Paul Boensch III", url:"https://themoviedb.org/person/1352277"}}, {tmdbId:"1352278", properties:{imdbId:"1002718", name:"Johnny Harra", url:"https://themoviedb.org/person/1352278"}}, {tmdbId:"20626", properties:{bornIn:"Westport, County Mayo, Ireland", imdbId:"0536850", born:date('1933-12-29'), name:"Joseph Maher", bio:"From Wikipedia, the free encyclopedia.   Joseph Maher (December 29, 1933 – July 17, 1998) was an Irish character actor who appeared in 43 films and was nominated for three Tony Awards and a Drama Desk Award for his supporting roles on the stage. \n\nDescription above from the Wikipedia article Joseph Maher, licensed under CC-BY-SA,full list of contributors on Wikipedia...", died:date('1998-07-17'), url:"https://themoviedb.org/person/20626"}}, {tmdbId:"14246", properties:{bornIn:"Paris, France", imdbId:"0396136", born:date('1927-12-30'), name:"Robert Hossein", bio:"From Wikipedia, the free encyclopedia. \n\nRobert Hossein (born as Hosseinhof December 30, 1927 in Paris) is a French film actor of Parsi origin, director and writer.  He directed the 1982 adaption of Les Misérables, and appeared in Vice and Virtue, Le Casse, Les Uns et les Autres and Venus Beauty Institute...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bbwKyCKB3QRHwL3ErMFS6kUEsFb.jpg", url:"https://themoviedb.org/person/14246"}}, {tmdbId:"7107", properties:{bornIn:"Lowicz, Lódzkie, Poland", imdbId:"0646037", born:date('1945-02-27'), name:"Daniel Olbrychski", bio:"From Wikipedia, the free encyclopedia\n\nDaniel Olbrychski (Polish pronunciation: [ɔlˈbrɨxskʲi]; born 27 February 1945) is a Polish actor best known for leading roles in several Andrzej Wajda movies and also known for playing a defector and spymaster Vassily Orlov, alongside Hollywood actress Angelina Jolie in the movie Salt...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3QhtZuftywq7kLerVSpI0STvVHS.jpg", url:"https://themoviedb.org/person/7107"}}, {tmdbId:"114142", properties:{bornIn:"Bromma, Stockholm, Stockholms län, Sweden", imdbId:"0116339", born:date('1947-04-07'), name:"Ulf Brunnberg", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cmzgn46kTEffe4nwMSIBsIyeanL.jpg", url:"https://themoviedb.org/person/114142"}}, {tmdbId:"114143", properties:{bornIn:"Porvoo, Uudenmaan maakunta, Finland", imdbId:"0104979", born:date('1932-01-13'), name:"Nils Brandt", died:date('1990-06-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1IO5PCSfLc3j1SSYTbSncLvZbA0.jpg", url:"https://themoviedb.org/person/114143"}}, {tmdbId:"116616", properties:{bornIn:"Landskrona, Malmöhus län, Sweden [now Skåne län, Sweden]", imdbId:"0540266", born:date('1936-12-31'), name:"Siw Malmkvist", bio:"Swedish singer who has been popular in Scandinavia and West Germany.  She had a number one hit in West Germany in 1964 with \"Liebeskummer lohnt sich nicht\" (English: \"Lovesickness Is Not Worthwhile\"), and on 18 July 1964 she became the first Swede to have a hit on the US Billboard Hot 100 chart, when \"Sole Sole Sole\", a duet with Italian singer Umberto Marcato, entered the chart, peaking at #58...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/krW49zTy7Mkw7FVykjr0Kh35txF.jpg", url:"https://themoviedb.org/person/116616"}}, {tmdbId:"1049246", properties:{imdbId:"0084534", name:"Albert Bitterling", url:"https://themoviedb.org/person/1049246"}}, {tmdbId:"1049247", properties:{imdbId:"2006739", name:"Roscoe Collins", url:"https://themoviedb.org/person/1049247"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"2314486", properties:{name:"George Harris", url:"https://themoviedb.org/person/2314486"}}, {tmdbId:"140152", properties:{bornIn:"Três Corações, Minas Gerais, Brazil", imdbId:"0671446", born:date('1940-10-23'), name:"Pelé", bio:"Edison \"Edson\" Arantes do Nascimento   KBE (born 21 or 23 October 1940 ), best known by his nickname Pelé is a retired Brazilian footballer.  He is widely regarded among football historians, former players and fans to be one of the greatest football players of all time.   In 1999, he was voted as the Football Player of the Century by the IFFHS International Federation of Football History and Statistics...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vCrzn7QgDdf3am0UDo0Wr2Ai0BY.jpg", url:"https://themoviedb.org/person/140152"}}, {tmdbId:"140153", properties:{bornIn:"Municipal Borough of Barking", born:date('1941-04-12'), name:"Bobby Moore", died:date('1993-02-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rlGl3WFHSjTJwqCUEekwwWCK2bN.jpg", url:"https://themoviedb.org/person/140153"}}, {tmdbId:"14850", properties:{imdbId:"0883639", name:"Daniel Valdez", url:"https://themoviedb.org/person/14850"}}, {tmdbId:"61150", properties:{bornIn:"Frankfort, Indiana, USA", imdbId:"0014493", born:date('1925-01-21'), name:"Charles Aidman", bio:"Charles Aidman originally planned a career as an attorney, but was sidetracked during World War II and naval officer training at DePaul university.  During a speech class the instructor, who also headed the drama department, saw Aidman as ideal for a role in an upcoming play.  \"I did the play and enjoyed it.  It was the first play I was in, in my life. . . I've been acting ever since...", died:date('1993-11-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/k8OKW1z6RTyqBdGIURZ3MflThb8.jpg", url:"https://themoviedb.org/person/61150"}}, {tmdbId:"1734", properties:{bornIn:"Houston, Texas, USA", imdbId:"0001578", born:date('1952-04-01'), name:"Annette O'Toole", bio:"Annette O'Toole (born April 1, 1952) is an American actress, dancer, and songwriter.  She is most recently known for portraying Martha Kent, the mother of Clark Kent on the television series Smallville...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z5BS5EeuhpM2KGFfUjOhVXtjmMy.jpg", url:"https://themoviedb.org/person/1734"}}, {tmdbId:"2641", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0001445", born:date('1928-06-20'), name:"Martin Landau", bio:"Martin James Landau (June 20, 1928 – July 15, 2017) was an American actor, acting coach, producer, and editorial cartoonist.  His career began in the 1950s, with early film appearances including a supporting role in Alfred Hitchcock's North by Northwest (1959).  He played regular roles in the television series Mission: Impossible (for which he received several Emmy Award nominations and a Golden Globe Award) and Space: 1999...", died:date('2017-07-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/m3E6gwlk0UHTNBQktfVXgEn5MQC.jpg", url:"https://themoviedb.org/person/2641"}}, {tmdbId:"28248", properties:{bornIn:"Baltimore, Maryland, USA", imdbId:"0776239", born:date('1947-11-24'), name:"Dwight Schultz", bio:"From Wikipedia, the free encyclopedia. \n\nWilliam Dwight Schultz (born November 24, 1947) is an American stage, television, and film actor.  He is best known for his roles as Captain \"Howling Mad\" Murdock on the 1980s action show The A-Team, and as Reginald Barclay in Star Trek: The Next Generation, Star Trek: Voyager, and the film Star Trek: First Contact.  He is also well known in Animation as the Mad Scientist Dr.  Animo in the Ben 10 series, and Chef Mung Daal in the children's cartoon Chowder...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kVXkC94gNdSWRvDAs0DqBCduJ4S.jpg", url:"https://themoviedb.org/person/28248"}}, {tmdbId:"80136", properties:{imdbId:"0536214", name:"Jack Magner", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9l0tB8Hem2UhGAKKeBdLRUTDIDk.jpg", url:"https://themoviedb.org/person/80136"}}, {tmdbId:"2086676", properties:{name:"Paul Tibbets", url:"https://themoviedb.org/person/2086676"}}, {tmdbId:"1247141", properties:{bornIn:"Lamar, Missouri, USA", imdbId:"0874288", born:date('1884-05-08'), name:"Harry S. Truman", died:date('1972-12-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n4SZGM76DQ2ENMCgtakK3KOrC2v.jpg", url:"https://themoviedb.org/person/1247141"}}, {tmdbId:"1317624", properties:{imdbId:"0087426", name:"W.H.P. Blandy", url:"https://themoviedb.org/person/1317624"}}, {tmdbId:"19889", properties:{bornIn:"Brooklyn - New York - USA", imdbId:"0228336", born:date('1934-01-12'), name:"Bob Dishy", bio:"Bob Dishy was  is an actor...", url:"https://themoviedb.org/person/19889"}}, {tmdbId:"99025", properties:{imdbId:"0889090", born:date('1953-05-28'), name:"Kevin Van Hentenryck", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fUlnOWRDKrRyPfhoSuNEzEqmRiT.jpg", url:"https://themoviedb.org/person/99025"}}, {tmdbId:"229718", properties:{imdbId:"0810128", name:"Terri Susan Smith", url:"https://themoviedb.org/person/229718"}}, {tmdbId:"99040", properties:{bornIn:"Chesaning, Michigan", imdbId:"0094884", name:"Beverly Bonner", bio:"​From Wikipedia, the free encyclopedia.   \n\nBeverly Bonner is an American actress and comedian, best known for her roles in low budget horror films, including Basket Case.  She has also acted for the stage, appearing in Tom Eyen's play Women Behind Bars with the late Divine. \n\nDescription above from the Wikipedia article Beverly Bonner, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hFjzAtxDx960BZnE4rIndHvfUkS.jpg", url:"https://themoviedb.org/person/99040"}}, {tmdbId:"172482", properties:{imdbId:"0900953", name:"Robert Vogel", url:"https://themoviedb.org/person/172482"}}, {tmdbId:"10660", properties:{bornIn:"The Bronx, New York City, New York, USA", imdbId:"0000617", born:date('1955-10-15'), name:"Tanya Roberts", bio:"Tanya Roberts (born Victoria Leigh Blum; October 15, 1955) is an American actress best known for her roles in Charlie's Angels, The Beastmaster, A View to a Kill, Sheena and That '70s Show.  Roberts was regarded as one of Hollywood's most popular sex symbols during the early 1980s. \n\nDescription above from the Wikipedia article Tanya Roberts, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uQrtp0U3Nox7nuKLPzLGDDwpxN6.jpg", url:"https://themoviedb.org/person/10660"}}, {tmdbId:"586", properties:{bornIn:"Louisville, Kentucky, USA", imdbId:"0000707", born:date('1959-11-20'), name:"Sean Young", bio:"Sean Young  (born November 20, 1959) is an American actress, best known for her performance in films such as Blade Runner, Dune, and No Way Out...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qzXxAAn5D3A2OEKejkMMV5vmVFr.jpg", url:"https://themoviedb.org/person/586"}}, {tmdbId:"4162", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0511964", born:date('1918-09-24'), name:"Audra Lindley", bio:"From Wikipedia, the free encyclopedia. \n\nAudra Marie Lindley (September 24, 1918 – October 16, 1997) was an American actress, most famous for her role as landlady Helen Roper on the sitcom Three's Company and its spin-off, The Ropers. \n\nBorn in Los Angeles, California, Lindley was the daughter of show business parents.  She got her early start in Hollywood by being a stand-in, which eventually progressed to stunt work.  Nothing panned out, and she went to New York in her mid-20s to work in theater...", died:date('1997-10-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o3wCWo4UhH3f7HE82MV65enD3dQ.jpg", url:"https://themoviedb.org/person/4162"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"123175", properties:{imdbId:"0610337", born:date('1918-06-10'), name:"Wood Moy", died:date('2017-11-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i2EzNRVr4BJnTRSK6j3uwSt92gZ.jpg", url:"https://themoviedb.org/person/123175"}}, {tmdbId:"56122", properties:{imdbId:"0370634", name:"Marc Hayashi", bio:"Marc Hayashi is an American actor from San Francisco.  He was an early member of the Asian American Theater Company,  known for The Karate Kid Part II (1986), Remington Steele (1982) and Falcon Crest (1981)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dekI4fByIvsGTGf64EmDDnfE83d.jpg", url:"https://themoviedb.org/person/56122"}}, {tmdbId:"123176", properties:{imdbId:"0156803", name:"Laureen Chew", url:"https://themoviedb.org/person/123176"}}, {tmdbId:"123177", properties:{imdbId:"0911007", name:"Peter Wang", url:"https://themoviedb.org/person/123177"}}, {tmdbId:"38225", properties:{bornIn:"El Centro, California, USA", imdbId:"0000333", born:date('1946-05-20'), name:"Cher", bio:"Cher (/ˈʃɛər/; born Cherilyn Sarkisian; May 20, 1946) is an American singer and actress.  Commonly referred to as the Goddess of Pop, she is described as embodying female autonomy in a male-dominated industry.  She is known for her distinctive contralto singing voice and for having worked in numerous areas of entertainment, as well as adopting a variety of styles and appearances during her five-decade-long career...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dHMczm2J6jl4rsPxbIK7ov8OAIN.jpg", url:"https://themoviedb.org/person/38225"}}, {tmdbId:"174639", properties:{imdbId:"0094048", born:date('1928-07-13'), name:"Sudie Bond", died:date('1984-11-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yTPywMNctmFSTemPsFUyi4Yezbj.jpg", url:"https://themoviedb.org/person/174639"}}, {tmdbId:"6839", properties:{bornIn:"Pittsburgh, Pennsylvania, USA", imdbId:"0915851", born:date('1926-01-19'), name:"Fritz Weaver", died:date('2016-11-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fNIGbgy9cfzNK1pDgRB56b2N3uq.jpg", url:"https://themoviedb.org/person/6839"}}, {tmdbId:"70772", properties:{bornIn:"New York City, New York, U.S.A", imdbId:"0612020", born:date('1940-02-10'), name:"Kathryn Mullen", bio:"From Wikipedia, the free encyclopedia. \n\nKathryn \"Kathy\" Mullen is an actress, voice actress, and puppeteer most closely associated with Jim Henson projects.  She began performing on The Muppet Show in its third season, primarily as Gaffer the Backstage Cat.  She also voice directed Dog City for Nelvana, worked as a designer for The Muppet Movie, a performing assistant for Yoda on The Empire Strikes Back, and was one of the creators of Between the Lions...", url:"https://themoviedb.org/person/70772"}}, {tmdbId:"36042", properties:{bornIn:"Cornwell Manor, Cornwell, Chipping Norton, Oxfordshire, England, UK", imdbId:"0001829", born:date('1957-09-12'), name:"Rachel Ward", bio:"Rachel Claire Ward, AM (born 12 September 1957) is a British actress, columnist, film director, and screenwriter who has primarily pursued her career in Australia. \n\nDescription above from the Wikipedia article Rachel Ward, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8jksGCUaR1MgWSo2nqxY7SCSyYj.jpg", url:"https://themoviedb.org/person/36042"}}, {tmdbId:"97337", properties:{bornIn:"Fairbury, Nebraska", imdbId:"0941683", born:date('1916-06-23'), name:"Irene Worth", bio:"From Wikipedia, the free encyclopedia\n\nIrene Worth, Honorary CBE (June 23, 1916 - March 9, 2002) was an American stage and screen actress who became one of the leading stars of the English and American theatre.  She pronounced her given name with three syllables -- \"I-REE-nee\" -- and other actors are heard to use this pronunciation when referring to her at the Tony Awards ceremony and other public occasions...", died:date('2002-03-10'), url:"https://themoviedb.org/person/97337"}}, {tmdbId:"26472", properties:{bornIn:"Brooklyn, New York City, New York, USA", imdbId:"0000430", born:date('1958-08-24'), name:"Steve Guttenberg", bio:"Steve Guttenberg is an American film and television writer, director, producer, actor and comedian, best known for many starring roles in Hollywood feature films during the 1980s, such as Cocoon, Three Men and a Baby, Police Academy, and Short Circuit...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ghTMepliFNcRQHNELs8pgNDsZyW.jpg", url:"https://themoviedb.org/person/26472"}}, {tmdbId:"2295", properties:{bornIn:"Schenectady, New York, USA", imdbId:"0000620", born:date('1952-09-16'), name:"Mickey Rourke", bio:"Philip Andre \"Mickey\" Rourke Jr. , is an American actor, screenwriter, and former boxer, who has appeared primarily as a leading man in drama, action, and thriller films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i6vXukUwRsJa7S9yhZgoKt9xLDv.jpg", url:"https://themoviedb.org/person/2295"}}, {tmdbId:"660", properties:{bornIn:"Northampton, England", imdbId:"0001891", born:date('1947-05-09'), name:"Anthony Higgins", bio:"Anthony Higgins (born 9 May 1947) is an English stage, film and television actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zxpbuobkQ8yuAWTAVvGGCTSg4Ki.jpg", url:"https://themoviedb.org/person/660"}}, {tmdbId:"67026", properties:{bornIn:"Johannesburg, South Africa", imdbId:"0840531", born:date('1939-02-09'), name:"Janet Suzman", bio:"Dame Janet Suzman, DBE (born 9 February 1939) is a South African and British actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5H1cxIbRuIlpqOxU1rsGAetrsyi.jpg", url:"https://themoviedb.org/person/67026"}}, {tmdbId:"67027", properties:{bornIn:"Brisbane, Queensland, Australia", imdbId:"0483069", born:date('1955-08-21'), name:"Anne-Louise Lambert", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/soP0Pj3TJnjEUfpeILwuxP0IILS.jpg", url:"https://themoviedb.org/person/67027"}}, {tmdbId:"67028", properties:{bornIn:"Westminster, London, England, UK", imdbId:"0292140", born:date('1945-10-23'), name:"Hugh Fraser", bio:"From Wikipedia, the free encyclopedia\n\nHugh Matthew Fraser (born 23 October 1945) is an English actor, theatre director, and author.  He has regularly appeared on film and in television and is best known for his portrayal of Captain Hastings in the television series Agatha Christie's Poirot, and his role as the Duke of Wellington (replacing David Troughton) in the Sharpe television series.  Fraser has frequently been cast as upper class or aristocratic characters...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/acBJGtwZGCFJdMHrAVsZDyv2qRX.jpg", url:"https://themoviedb.org/person/67028"}}, {tmdbId:"9976", properties:{bornIn:"San Antonio, Texas, USA", imdbId:"0001794", born:date('1971-09-09'), name:"Henry Thomas", bio:"Henry Jackson Thomas, Jr.  (born September 9, 1971) is an American actor and musician.  He has appeared in more than 40 films and is best known for his role as Elliott in the 1982 Steven Spielberg film E. T.  the Extra-Terrestrial. \n\nDescription above from the Wikipedia article Henry Thomas, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l5OZ4qrrRGnEPeNhZ8PcL5vhwOI.jpg", url:"https://themoviedb.org/person/9976"}}, {tmdbId:"9979", properties:{bornIn:"Manhattan, New York City, New York, USA", imdbId:"0001075", born:date('1941-10-10'), name:"Peter Coyote", bio:"Peter Coyote (born Rachmil Pinchus Ben Mosha Cohon; October 10, 1941) is an American actor, author, director, screenwriter and narrator of films, theatre, television and audio books.  His voice work includes narrating the opening ceremony of the 2002 Winter Olympics and Apple's iPad campaign.  He has also served as on-camera co-host of the 2000 Oscar telecasts. \n\nCoyote was one of the founders of the Diggers, an anarchist improv group active in Haight-Ashbury during the mid-1960s...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ld3xLYTcZWjAc0bE33DONT7n9o8.jpg", url:"https://themoviedb.org/person/9979"}}, {tmdbId:"9978", properties:{bornIn:"New York City, New York, USA", imdbId:"0534085", born:date('1966-12-19'), name:"Robert MacNaughton", bio:"From Wikipedia, the free encyclopedia. \n\nRobert MacNaughton (born December 19, 1966) is an American actor, best known for his role as Elliott's brother Michael in E. T.  the Extra-Terrestrial, for which he won a 1983 Young Artist Award as Best Young Supporting Actor in a Motion Picture.  Robert also played the lead role of Adam Farmer in the film I Am the Cheese, based on the young adult novel by Robert Cormier...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mSEI6Xki55h8MMj9OpVpTqHjXbK.jpg", url:"https://themoviedb.org/person/9978"}}, {tmdbId:"50880", properties:{bornIn:"Bakersfield, California, USA", imdbId:"0000296", born:date('1953-11-19'), name:"Robert Beltran", bio:"From Wikipedia, the free encyclopedia. \n\nRobert Adame Beltran (born November 19, 1953) is an American actor, known for his role as Commander Chakotay on Star Trek: Voyager. \n\nDescription above from the Wikipedia article Robert Beltran, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/weqZyarkZ1A6Plf04Db9gLFKlFZ.jpg", url:"https://themoviedb.org/person/50880"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"102422", properties:{imdbId:"0756492", name:"Susan Saiger", url:"https://themoviedb.org/person/102422"}}, {tmdbId:"11462", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"0762445", born:date('1958-12-30'), name:"Ellen Sandweiss", bio:"​From Wikipedia, the free encyclopedia.   \n\nEllen Sandweiss (born December 30, 1958) (MA University of Michigan) is an American B-movie actress.  She has also performed in musical theatre as a dancer and pop singer, and in a one-woman show of Jewish music. [1]\n\nShe gained notoriety in the 1981 horror cult-classic The Evil Dead, playing Ash's sister Cheryl. \n\nDescription above from the Wikipedia article  Ellen Sandweiss, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e1ay7Jt4hwVVqsNE9RdThfyYy2V.jpg", url:"https://themoviedb.org/person/11462"}}, {tmdbId:"11463", properties:{imdbId:"0217822", name:"Richard DeManincor", bio:"From Wikipedia, the free encyclopedia.    Hal Delrich, sometimes credited as Richard DeManincor, is an American film actor. \n\nHe is perhaps best known for his appearance as Scotty in the horror film The Evil Dead (1981).  Delrich (credited as Richard DeManincor) also appeared as Officer Garvey in the comedy film Crimewave (1985). \n\nDescription above from the Wikipedia article  Richard DeManincor, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/11463"}}, {tmdbId:"11464", properties:{bornIn:"Cedar Rapids, Iowa, USA", imdbId:"0048260", born:date('1955-05-08'), name:"Betsy Baker", bio:"​From Wikipedia, the free encyclopedia.   \n\nBetsy Baker (born May 8, 1955) is an American actress.  She is best known as playing Linda in the cult classic film The Evil Dead.  She has resumed acting after a long break from the spotlight. \n\nDescription above from the Wikipedia article  Betsy Baker, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gzNmo9G6Q1TMwlqwshFBR1B6Qbt.jpg", url:"https://themoviedb.org/person/11464"}}, {tmdbId:"1229062", properties:{imdbId:"0249489", name:"Elizabeth Edmonds", url:"https://themoviedb.org/person/1229062"}}, {tmdbId:"1484404", properties:{bornIn:"England, UK", imdbId:"0908873", name:"Sue Wallace", url:"https://themoviedb.org/person/1484404"}}, {tmdbId:"1484405", properties:{imdbId:"0341678", name:"Geraldine Griffiths", url:"https://themoviedb.org/person/1484405"}}, {tmdbId:"82414", properties:{imdbId:"0575109", name:"Karen Meagher", url:"https://themoviedb.org/person/82414"}}, {tmdbId:"231927", properties:{bornIn:" Stockholm, Stockholms län, Sweden", imdbId:"0012358", born:date('1937-09-02'), name:"Kristina Adolphson", url:"https://themoviedb.org/person/231927"}}, {tmdbId:"46865", properties:{bornIn:"Vällingby, Sweden", imdbId:"0021655", born:date('1970-09-04'), name:"Pernilla Allwin", url:"https://themoviedb.org/person/46865"}}, {tmdbId:"564463", properties:{imdbId:"0021910", name:"Kristian Almgren", url:"https://themoviedb.org/person/564463"}}, {tmdbId:"777", properties:{bornIn:"Wilmington, Delaware, USA", imdbId:"0001662", born:date('1957-05-21'), name:"Judge Reinhold", bio:"Edward Ernest \"Judge\" Reinhold, Jr.  (born May 21, 1957) is an American actor, perhaps best known for co-starring in movies such as Beverly Hills Cop, Ruthless People, Fast Times at Ridgemont High, and The Santa Clause trilogy. \n\nDescription above from the Wikipedia article Judge Reinhold, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oPdJz2hSIkrj1wvOpupGoIej6IO.jpg", url:"https://themoviedb.org/person/777"}}, {tmdbId:"61217", properties:{bornIn:"USA", imdbId:"0001680", born:date('1956-07-17'), name:"Robert Romanus", bio:"From Wikipedia, the free encyclopedia. \n\nRobert Romanus (born July 17, 1956), also billed as Bob Romanus, is an American actor and musician who has starred in film and television.  He is best remembered for his role in the 1982 comedy Fast Times at Ridgemont High as the ticket scalper Mike Damone, and as Natalie Green's boyfriend Snake on The Facts of Life.  He also starred in the 1985 film Bad Medicine...", url:"https://themoviedb.org/person/61217"}}, {tmdbId:"12517", properties:{bornIn:"Stoke-on-Trent, Staffordshire, England, UK", imdbId:"0428086", born:date('1927-09-12'), name:"Freddie Jones", bio:"​From Wikipedia, the free encyclopedia\n\nFreddie Jones was an English character actor. \n\nJones was born in the town of Longton in the city of Stoke-on-Trent.  He became an actor after ten years of working as a laboratory assistant with a firm making ceramic products, when his hobby of acting took over.  He was trained at the prestigious Rose Bruford College and became famous for his role as Claudius in the 1968 British television series The Caesars.  He often played eccentric characters...", died:date('2019-07-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mWozC9kZFNhxoRSCBvmykROmMGB.jpg", url:"https://themoviedb.org/person/12517"}}, {tmdbId:"6197", properties:{bornIn:"Bridgeport, Connecticut, USA", imdbId:"0001133", born:date('1938-07-09'), name:"Brian Dennehy", bio:"Brian Mannion Dennehy was an American actor of film, stage and screen...", died:date('2020-04-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ylmQgranjV1ZdMXiaBBpszUF07m.jpg", url:"https://themoviedb.org/person/6197"}}, {tmdbId:"31440", properties:{bornIn:"Tularosa, New Mexico, United States", imdbId:"0822535", born:date('1925-02-11'), name:"Kim Stanley", bio:"From Wikipedia, the free encyclopedia.   Kim Stanley (February 11, 1925 – August 20, 2001) was an American actress, primarily in televsion and theatre, but with occasional film performances. \n\nShe began her acting career in theatre, and subsequently attended the Actors Studio in New York City, New York.  She received the 1952 Theatre World Award for her role in The Chase (1952), and starred in the Broadway productions of Picnic (1953) and Bus Stop (1955)...", died:date('2001-08-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oHDfbhT2t0gCChxPZAQtYyW4KR.jpg", url:"https://themoviedb.org/person/31440"}}, {tmdbId:"32328", properties:{imdbId:"0122576", born:date('1918-03-13'), name:"Bart Burns", url:"https://themoviedb.org/person/32328"}}, {tmdbId:"2133812", properties:{name:"Terry Ballard", url:"https://themoviedb.org/person/2133812"}}, {tmdbId:"58807", properties:{bornIn:"London - England - UK", imdbId:"0111777", born:date('1954-11-20'), name:"Richard Brooker", bio:"Richard Brooker, 58, was an actor most well known for playing Jason Voorhees in Friday the 13th Part III.  Aside from playing Jason, but Brooker had an illustrious career as an actor and director as well.  HIs most well known directorial effort was for Bill Nye the Science Guy...", died:date('2013-04-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ryRmFu6e4Nb6tMsZZzi70xEaBUt.jpg", url:"https://themoviedb.org/person/58807"}}, {tmdbId:"83334", properties:{bornIn:"USA", imdbId:"0153038", born:date('1955-03-03'), name:"Gloria Charles", bio:"Former Actress...", died:date('2016-12-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q4joFIx1SsYSUfgSsHWyvcqqpNg.jpg", url:"https://themoviedb.org/person/83334"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"58808", properties:{imdbId:"0310824", born:date('1953-01-22'), name:"Anne Gaybis", bio:"Actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xWRHgxfYcyhbcF4PMHBnc8cXXhv.jpg", url:"https://themoviedb.org/person/58808"}}, {tmdbId:"2282", properties:{bornIn:"Yorkshire, England, UK", imdbId:"0001426", born:date('1943-12-31'), name:"Ben Kingsley", bio:"Sir Ben Kingsley, CBE (born 31 December 1943), born Krishna Pandit Bhanji , is a British actor.  He has won an Oscar, BAFTA, Golden Globe and Screen Actors Guild awards in his career.  He is known for starring as Mohandas Gandhi in the film Gandhi in 1982, for which he won the Academy Award for Best Actor.  He is also known for his performances in the films Schindler's List (1993), Prince of Persia: The Sands of Time (2010), and House of Sand and Fog...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/57QnYyAVfXBUlu7wwngPwhc76vh.jpg", url:"https://themoviedb.org/person/2282"}}, {tmdbId:"101908", properties:{bornIn:"London, England, UK", imdbId:"0001028", born:date('1959-11-23'), name:"Maxwell Caulfield", bio:"Maxwell Caulfield  (born 23 November 1959) is an English-born leading actor of film, stage, and television best known for his role as Michael Carrington in the musical film Grease 2 (1982) and as Miles Colby in The Colbys (1985–87) and its parent show Dynasty (1985–86).  He has more than 70 credits to his name encompassing film, television and stage.  He starred in the Ronald F.  Maxwell American Civil War drama Gettysburg (film) (1993) and Tom DiCillo's The Real Blonde (1987)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/90277SzouzHOAT4ZU3euYh6Sl0x.jpg", url:"https://themoviedb.org/person/101908"}}, {tmdbId:"1160", properties:{bornIn:"Santa Ana, California, USA", imdbId:"0000201", born:date('1958-04-29'), name:"Michelle Pfeiffer", bio:"Michelle Marie Pfeiffer (born April 29, 1958) is an American actress and producer.  She has received many accolades, including a Golden Globe Award, and three nominations for Academy Award. \n\nPfeiffer began to pursue an acting career in 1978 and had her first leading role in the musical film Grease 2 (1982)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oGUmQBU87QXAsnaGleYaAjAXSlj.jpg", url:"https://themoviedb.org/person/1160"}}, {tmdbId:"56752", properties:{bornIn:"Santa Monica, California, U.S.", imdbId:"0005167", born:date('1952-11-21'), name:"Lorna Luft", bio:"From Wikipedia, the free encyclopedia. \n\nLorna Luft (born November 21, 1952) is an American television, stage, and film actress and singer.  She is the daughter of singer and actress Judy Garland and Sid Luft, and the half-sister of singer and actress Liza Minnelli. \n\nDescription above from the Wikipedia article Lorna Luft, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1Q9cjYloO2qmYzZEUHBZPduNjJF.jpg", url:"https://themoviedb.org/person/56752"}}, {tmdbId:"56753", properties:{bornIn:"Minneapolis, Minnesota, U.S.", imdbId:"0853808", born:date('1953-10-26'), name:"Maureen Teefy", bio:"From Wikipedia, the free encyclopedia. \n\nMaureen Jane Teefy (born October 26, 1953) is an American actress.  Her films include Fame (1980), Grease 2 (1982) and Supergirl (1984). \n\nDescription above from the Wikipedia article Maureen Teefy, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iki1NC4BnH1v2rwEPVo6l7hEBeH.jpg", url:"https://themoviedb.org/person/56753"}}, {tmdbId:"33525", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0247762", born:date('1968-05-19'), name:"Kyle Eastwood", bio:"From Wikipedia, the free encyclopedia\n\nKyle Eastwood (born May 19, 1968) is an American jazz musician.  He studied film at the University of Southern California for two years before embarking on a music career.  After becoming a session player in the early '90s and leading his own quartet, he released his first solo album, From There to Here, in 1998.  His most recent album, Metropolitain, was released 2 June 2009 by Rendezvous.  Eastwood plays acoustic and electric as well as double bass...", url:"https://themoviedb.org/person/33525"}}, {tmdbId:"558311", properties:{imdbId:"0447782", born:date('1962-02-16'), name:"Alexa Kenin", died:date('1985-09-10'), url:"https://themoviedb.org/person/558311"}}, {tmdbId:"7180", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"0001006", born:date('1950-10-30'), name:"John Candy", bio:"John Franklin Candy (October 31, 1950 – March 4, 1994) was a Canadian actor and comedian.  He rose to fame as a member of the Toronto, Ontario branch of The Second City, its related Second City Television series, and in his role in comedy films such as Stripes, Splash, Cool Runnings, The Great Outdoors, and Uncle Buck...", died:date('1994-03-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xOoA2gFdnl0qe9esbG0FJvCY0Fh.jpg", url:"https://themoviedb.org/person/7180"}}, {tmdbId:"953", properties:{bornIn:"Buenos Aires, Argentina", imdbId:"0005386", born:date('1958-08-08'), name:"Cecilia Roth", bio:"From Wikipedia, the free encyclopedia.  Cecilia Roth (born Cecilia Rotenberg on August 8, 1958 in Buenos Aires, Argentina) is an Argentine actress. \n\nHer father, Abrasha Rotenberg (b.  1926), a Jewish immigrant from the Soviet Ukraine, is an editor and a journalist.  He met Cecilia's mother, an Argentinian singer of Sephardic descent Dina Rot, in Argentina.  Cecilia Roth has made appearances in numerous television series...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cQS2OQeGLa5GrN4lffZxtzlPJ0V.jpg", url:"https://themoviedb.org/person/953"}}, {tmdbId:"36281", properties:{bornIn:"Riaño, León, Castilla y León, España", imdbId:"0002181", born:date('1956-04-26'), name:"Imanol Arias", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/526nx2CCaWEzynS3dXt7QcJzWm8.jpg", url:"https://themoviedb.org/person/36281"}}, {tmdbId:"31700", properties:{bornIn:"Berlin, Germany", imdbId:"0513298", born:date('1932-07-14'), name:"Helga Liné", bio:"Helga Liné, was born July 14, 1932 as Helga Lina Stern in Berlin, Germany.  When Hitler invaded the major part of Europe and extended his pursuit of Jews in their territories, Liné became one of many child refugees who made the dangerous exodus to Portugal for safety...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/83O6t9xqw0pr0da2CFEh6B0DQt.jpg", url:"https://themoviedb.org/person/31700"}}, {tmdbId:"37520", properties:{bornIn:"  Madrid, Spain", imdbId:"0273312", born:date('1950-02-12'), name:"Marta Fernández Muro", url:"https://themoviedb.org/person/37520"}}, {tmdbId:"106752", properties:{bornIn:"New York, New York, U.S.A.", imdbId:"0598413", born:date('1964-08-11'), name:"Lawrence Monoson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hli6dgeyskxXmfJwghyN1AtZCrn.jpg", url:"https://themoviedb.org/person/106752"}}, {tmdbId:"80137", properties:{bornIn:"Plainview, New York", imdbId:"0291404", born:date('1962-02-11'), name:"Diane Franklin", bio:"​From Wikipedia, the free encyclopedia\n\nDiane Franklin (born February 11, 1962) is an American actress. \n\nBefore she got into acting, Franklin appeared in TV commercials for Coca-Cola, Trident, Jell-O, and Maxwell House coffee.  She has worn a distinctive curly hairstyle throughout her career.  Her first film role was in the 1982 film The Last American Virgin as Karen.  Diane Franklin's other well known roles in movies are in the 1982 horror film Amityville II: The Possession as Patricia Montelli...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xvMGJAUPS0xrxMH3mkHGq6G1zjF.jpg", url:"https://themoviedb.org/person/80137"}}, {tmdbId:"119837", properties:{imdbId:"0747806", name:"Joe Rubbo", url:"https://themoviedb.org/person/119837"}}, {tmdbId:"63998", properties:{bornIn:"Lynn, Massachusetts, USA", imdbId:"0342245", born:date('1934-01-30'), name:"Tammy Grimes", bio:"Tammy Grimes is an American actress and singer...", died:date('2016-10-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3aXrIPhaFDrmQawzGaSOOuh35CW.jpg", url:"https://themoviedb.org/person/63998"}}, {tmdbId:"119454", properties:{bornIn:"Hong Kong, British Crown Colony [now China]", imdbId:"0550301", born:date('1954-02-28'), name:"Mars", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jA8EKsaP7bED9qj3FXFWLLo3zd0.jpg", url:"https://themoviedb.org/person/119454"}}, {tmdbId:"2649341", properties:{name:"Wai-Man Chan", url:"https://themoviedb.org/person/2649341"}}, {tmdbId:"105747", properties:{bornIn:"Birmingham - Alabama - USA", imdbId:"0000462", born:date('1948-10-29'), name:"Kate Jackson", bio:"From Wikipedia, the free encyclopedia. \n\nKate Jackson (born October 29, 1948, height 5' 7½\" (1,71 m)) is an American actress, director, and producer.  She is a three-time Emmy Award nominee in the Best Actress category, has been nominated for several Golden Globe Awards, and has won the titles of Favorite Television Actress in England, and Favorite Television Star in Germany—several times—for her work in the television series Scarecrow and Mrs.  King...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jZj5IJss6c94E7RQIfkDt3wilUm.jpg", url:"https://themoviedb.org/person/105747"}}] AS row
