UNWIND [{tmdbId:"112476", properties:{bornIn:"Evansville - Indiana - USA", imdbId:"1910255", born:date('1996-12-29'), name:"Dylan Minnette", bio:"Dylan Christopher Minnette was born in Evansville, Indiana in 1996.   Scouted by an agent in Chicago, Dylan began work on commercial modeling  and acting at the age of 7.  He later relocated to Los Angeles, CA to  continue his acting career. \n\nDylan scored his first major television role at the age of 8, playing  young Charlie Sheen in “Two and a Half Men”.  In 2005, he also appeared  in an episode of the popular Nickelodeon show, “Drake and Josh”...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fmRHI0ovny7lk27TzejA47or802.jpg", url:"https://themoviedb.org/person/112476"}}, {tmdbId:"1121786", properties:{bornIn:"Haifa, Israel", imdbId:"3843467", born:date('1997-05-12'), name:"Odeya Rush", bio:"Odeya Rush was born and raised in Haifa, Israel, along with her six brothers.  She began acting at the age of 14 when she starred in \"The Odd Life of Timothy Green. \" She then went on to do \"The Giver\" alongside Jeff Bridges and Meryl Streep, and \"Goosebumps\" opposite Jack Black.  At age 18, she wrote, directed and starred in her own short film called \"Thanks\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1eDPlshKwSIs3tvvkPItLr0LUrZ.jpg", url:"https://themoviedb.org/person/1121786"}}, {tmdbId:"456066", properties:{bornIn:"Texas, USA", imdbId:"2619114", born:date('1996-10-04'), name:"Ryan Lee", bio:"Ryan Lee was born on October 4, 1996 in Texas, USA.  He is an actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lHeE90kGjdFryeVYYVYn44VVJP0.jpg", url:"https://themoviedb.org/person/456066"}}, {tmdbId:"58902", properties:{imdbId:"0354427", born:date('1975-12-30'), name:"Zahf Paroo", url:"https://themoviedb.org/person/58902"}}, {tmdbId:"98818", properties:{bornIn:"Danville, USA", imdbId:"0780069", name:"Stacey Scowley", bio:"​From Wikipedia, the free encyclopedia.   \n\nStacey Scowley is an American actress.  She gained memorable attention from her appearance in a 2002 commercial for Kia Motors called \"Boyfriend\" which was heavily aired.  She has also appeared in numerous television commercials for several companies which include Progressive Auto Insurance, Supercuts, Sony, and Bud Light...", url:"https://themoviedb.org/person/98818"}}, {tmdbId:"20377", properties:{bornIn:"Los Angeles, California, USA", imdbId:"1342743", born:date('1994-02-16'), name:"Matthew Knight", bio:"Matthew Knight is an American actor, known for his role on the My Babysitter's a Vampire series...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2sINOLMONrjzsaww6uueHvPFNVQ.jpg", url:"https://themoviedb.org/person/20377"}}, {tmdbId:"90757", properties:{bornIn:"Oviedo, Florida, USA", imdbId:"2467178", born:date('1977-03-24'), name:"Mike Straub", bio:"Mike \"Michael Gene\" Straub Is An Actor.  He Has Starred In Numerous Films, Including In The Horror & Sci-fi Genre.  In 2006 He Moved To Sofia, Bulgaria Where He Has Made An Impressive Mark As An Actor...", url:"https://themoviedb.org/person/90757"}}, {tmdbId:"117526", properties:{imdbId:"2998248", name:"Aiko Horiuchi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eEKs8Jb0aimSy1yown8qmZBhGX3.jpg", url:"https://themoviedb.org/person/117526"}}, {tmdbId:"1221694", properties:{bornIn:"Boppard, Rhineland-Palatinate, West Germany", imdbId:"1169495", born:date('1975-05-29'), name:"Daniel Tosh", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uohZmMlRpGQlRSVemgGWtzBtZ3W.jpg", url:"https://themoviedb.org/person/1221694"}}, {tmdbId:"103352", properties:{bornIn:"Sunderland, Tyne and Wear, England, UK", imdbId:"1478846", born:date('1984-05-31'), name:"Richard Riddell", url:"https://themoviedb.org/person/103352"}}, {tmdbId:"77266", properties:{bornIn:"England", imdbId:"0529098", born:date('1981-08-18'), name:"Katie Lyons", bio:"​From Wikipedia, the free encyclopedia\n\nKatie Lyons (born August 18, 1981) is a British actress, most noted for her performance as Naughty Rachel in the Channel 4 sitcom Green Wing.  She has also appeared in The Bill, EastEnders, The Catherine Tate Show, The Complete Guide to Parenting, The Boat That Rocked (2009) and Boy A (2007), with a small role in The Crimson Petal and the White in 2011...", url:"https://themoviedb.org/person/77266"}}, {tmdbId:"970332", properties:{bornIn:"Frederick, Maryland, USA", imdbId:"3693309", born:date('2008-05-31'), name:"Alexis Clagett", bio:"From IMDb By Erin Clagett;\n\nLexi is the daughter of Tom &amp; Erin Clagett of Frederick, MD.  Defying the odds, she has grown from a tiny preemie into a curious, energetic toddler whose special relationship with her sisters other is a joy to watch.  Because she was cared for by so many in her first year, including nurses, extended family, big sister Hannah, friends and volunteers, Lexi loves people and adventure...", url:"https://themoviedb.org/person/970332"}}, {tmdbId:"85138", properties:{bornIn:"Albuquerque, New Mexico, USA", imdbId:"1416215", born:date('1992-08-20'), name:"Demi Lovato", bio:"Demetria Devonne \"Demi\" Lovato (born August 20, 1992) is an American singer-songwriter, musician, and actress.  Her earliest roles included a part on Barney &amp; Friends, before she became better known for her starring roles in the Camp Rock movies, as Sonny Munroe in Sonny with a Chance, and as the star of the 2009 movie Princess Protection Program.  She is also involved in philanthropic activities through charity work and various social and environmental causes...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cbGgp41GPqryeEqB7vH18ojvGdB.jpg", url:"https://themoviedb.org/person/85138"}}, {tmdbId:"85757", properties:{bornIn:" Casa Grande, Arizona, USA", imdbId:"2679438", born:date('1989-08-15'), name:"Joe Jonas", bio:"Joe Jonas  (born August 15, 1989) is an American singer, musician, actor and dancer.  He shares the lead singer role with his younger brother Nick of the Jonas Brothers, a pop-rock band made up of him and his two brothers, Nick and Kevin.  He starred as Joseph Lucas in the Disney Channel original series Jonas...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wlzMYfBH3uBwOyU0LfDMK3XaFpr.jpg", url:"https://themoviedb.org/person/85757"}}, {tmdbId:"130567", properties:{bornIn:"Las Vegas, Nevada, USA", imdbId:"2449480", born:date('1992-02-17'), name:"Meaghan Martin", bio:"​From Wikipedia, the free encyclopedia. \n\nMeaghan Jette Martin  (born February 17, 1992) is an American actress and singer, who is known for her role as Tess Tyler in the Disney Channel original movies Camp Rock and Camp Rock 2: The Final Jam.  She starred in the now canceled ABC Family television series 10 Things I Hate About You as Bianca Stratford, and was the main character Jo in the movie Mean Girls 2...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bLHLe75GkincDZz9JjZ2hfGPDIH.jpg", url:"https://themoviedb.org/person/130567"}}, {tmdbId:"85759", properties:{bornIn:"Miami, Florida, USA", imdbId:"0133566", born:date('1966-09-28'), name:"Maria Canals-Barrera", bio:"María Canals Barrera  (born September 28, 1966) is an American actress, voice actress and singer.  She is best known for her roles on Wizards of Waverly Place, Justice League and Justice League Unlimited as well as in Camp Rock and Camp Rock 2: The Final Jam...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bqlwEfG1oczOW0f8tsJ31lbIfPo.jpg", url:"https://themoviedb.org/person/85759"}}, {tmdbId:"1151218", properties:{imdbId:"1522629", born:date('1967-12-22'), name:"Camané", bio:"Camané was born in 1967 in Oeiras, Portugal as Carlos Manuel Moutinho Paiva dos Santos Duarte.  He is an actor, known for Humanos - A Vida em Variações (2006), Fado Camané (2014) and Camané As Gravações de Sempre de Mim (2008)...", url:"https://themoviedb.org/person/1151218"}}, {tmdbId:"1178462", properties:{imdbId:"0229453", name:"Carlos do Carmo", url:"https://themoviedb.org/person/1178462"}}, {tmdbId:"991946", properties:{bornIn:"Oaxaca, Mexico", imdbId:"1105038", born:date('1968-09-09'), name:"Lila Downs", bio:"Ana Lila Downs Sánchez, best known as Lila Downs (born September 9, 1968) is an American–Mexican singer-songwriter and actress.  She performs her own compositions as well as tapping into Mexican traditional and popular music.  She also incorporates indigenous Mexican influences and has recorded songs in many indigenous languages such as Mixtec, Zapotec, Mayan, Nahuatl and Purépecha...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tjFpQ0M11nJSCcgI4tpFIkManxn.jpg", url:"https://themoviedb.org/person/991946"}}, {tmdbId:"2606", properties:{bornIn:"Sudafrica", imdbId:"0450961", name:"Tony Kgoroge", url:"https://themoviedb.org/person/2606"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"63136", properties:{imdbId:"0595680", name:"Patrick Mofokeng", url:"https://themoviedb.org/person/63136"}}, {tmdbId:"1562503", properties:{bornIn:"Morgantown, West Virginia, USA", imdbId:"2864505", born:date('1993-10-02'), name:"Elizabeth McLaughlin", url:"https://themoviedb.org/person/1562503"}}, {tmdbId:"112471", properties:{bornIn:"Dallas, Texas, USA", imdbId:"2106423", born:date('1994-02-22'), name:"Ellen Marlow", bio:"From Wikipedia, the free encyclopedia\n\nEllen Taylor Marlow (born February 22, 1994) is a teen American actress.  She played Jemima Potts in Chitty Chitty Bang Bang on Broadway and Claire Lyons in The Clique movie based on the books by Lisi Harrison. \n\nDescription above from the Wikipedia article Ellen Marlow, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/112471"}}, {tmdbId:"112472", properties:{imdbId:"2667868", born:date('1993-08-28'), name:"Sophie Anna Everhard", url:"https://themoviedb.org/person/112472"}}, {tmdbId:"112473", properties:{bornIn:"Ventura County, California, U.S.", imdbId:"2679233", born:date('1994-12-26'), name:"Samantha Boscarino", bio:"From Wikipedia, the free encyclopedia\n\nSamantha Joann Boscarino (born December 26, 1994 in Ventura County, California) is an American actress. \n\nHer first notable role was in the Tyra Banks-produced film The Clique.  She also appeared on The Tyra Banks Show with her other co-stars Elizabeth McLaughlin, Ellen Marlow, Sophie Anna Everhard and Bridgit Mendler.  Boscarino also has a recurring role in Good Luck Charlie as Skyler reuniting with Mendler...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/it9bf96WWT3HxiwSdtOyzt4bMci.jpg", url:"https://themoviedb.org/person/112473"}}, {tmdbId:"51988", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0135221", born:date('1982-06-30'), name:"Lizzy Caplan", bio:"Elizabeth Caplan better known as Lizzy Caplan was born on June 30, 1982 in Los Angeles, CA.  She is an American actress, best known for her roles in the CBS show The Class, in the 2004 film Mean Girls, and the 2008 film Cloverfield. \n\nCaplan began her television acting career in 1999, when she played the minor role of Sara on the short-lived series Freaks and Geeks.  She had a series of guest appearances on other shows, and has been a guest on Sharon Osbourne's talk show...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7MzkcgNKM3o3EPCMEDi4uLcfQHP.jpg", url:"https://themoviedb.org/person/51988"}}, {tmdbId:"51989", properties:{bornIn:"Vancouver - British Columbia - Canada", imdbId:"1140300", born:date('1985-09-24'), name:"Jessica Lucas", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nYS2J93VapM1GW5UdqMFqCxVMUv.jpg", url:"https://themoviedb.org/person/51989"}}, {tmdbId:"51991", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"1221863", born:date('1982-10-28'), name:"Michael Stahl-David", bio:"From Wikipedia, the free encyclopedia. \n\nMichael Stahl-David (born October 28, 1982) is an American actor, perhaps best known for his television role as Sean Donnelly on The Black Donnellys and his lead role in the J.  J.  Abrams-produced film Cloverfield. \n\nDescription above from the Wikipedia article Michael Stahl-David, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fDA9tFEbV50uvdRj2HGOapSHXJK.jpg", url:"https://themoviedb.org/person/51991"}}, {tmdbId:"49767", properties:{bornIn:"Berlin, Germany", imdbId:"1035643", born:date('1989-08-17'), name:"Frederick Lau", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kc5BJiutoYk7xfxnn4HX2LLe7gU.jpg", url:"https://themoviedb.org/person/49767"}}, {tmdbId:"692", properties:{bornIn:"Lichtenberg, Berlin, Germany", imdbId:"1457472", born:date('1984-10-18'), name:"Jennifer Ulrich", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3I8JS27pZ2l06VRXcANm93xcQRa.jpg", url:"https://themoviedb.org/person/692"}}, {tmdbId:"931944", properties:{bornIn:" Austin, Texas, USA", imdbId:"1294664", born:date('1994-08-27'), name:"Ellar Coltrane", bio:"Ellar Coltrane was born on August 27, 1994 in Austin, Texas, USA as Ellar Coltrane Kinney Salmon.  He is an actor, known for Boyhood (2014), Fast Food Nation (2006) and Lone Star State of Mind (2002)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/21Gpla159JfFy3hDkB1RNrfjol4.jpg", url:"https://themoviedb.org/person/931944"}}, {tmdbId:"1467501", properties:{imdbId:"6567391", name:"Elijah Smith", url:"https://themoviedb.org/person/1467501"}}, {tmdbId:"78311", properties:{bornIn:"Bishopbriggs, Scotland, UK", imdbId:"0884313", born:date('1966-10-26'), name:"Steve Valentine", bio:"Steven Valentine (born October 26, 1966) is a Scottish actor and magician best known for his role on Crossing Jordan...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l3vWjZSkTFboKPWHEyoOwibxTv7.jpg", url:"https://themoviedb.org/person/78311"}}, {tmdbId:"558926", properties:{imdbId:"2744955", name:"Sage Ryan", bio:"Sage Ryan is an actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5ThMHiGhO9jSwXXtMfOxLqpXwxs.jpg", url:"https://themoviedb.org/person/558926"}}, {tmdbId:"11288", properties:{bornIn:"Barnes, London, England, UK", imdbId:"1500155", born:date('1986-05-13'), name:"Robert Pattinson", bio:"Robert Douglas Thomas Pattinson (born May 13, 1986) is an English actor from Barnes, London, UK.  After his father convinced him to join the local theatre club at the age of 15 because he was quite shy, he began his film career by playing Cedric Diggory in Harry Potter and the Goblet of Fire (2005) when he was 18.  At 22, the role of Edward Cullen in The Twilight Saga films (2008-12) brought him to worldwide stardom...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7kdpjFRXKnbsogBqzeAgfzlRojx.jpg", url:"https://themoviedb.org/person/11288"}}, {tmdbId:"79269", properties:{bornIn:"Stockholm, Sweden", imdbId:"1468283", born:date('1991-05-29'), name:"Tom Ljungman", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kVBuRqxY5hxuXV7Ub2J1Br64lZy.jpg", url:"https://themoviedb.org/person/79269"}}, {tmdbId:"79271", properties:{imdbId:"1564081", born:date('1992-04-12'), name:"Amanda Davin", url:"https://themoviedb.org/person/79271"}}, {tmdbId:"83276", properties:{bornIn:"Boston, Massachusetts, U.S.", imdbId:"1552693", born:date('1984-07-27'), name:"Kenny Wormald", bio:"From Wikipedia, the free encyclopedia.   Kenny Wormald (born July 27, 1984) is an American professional dancer.  He is best known for his appearances on the MTV network show Dancelife, and his starring role in \"Center Stage: Turn It Up\". \n\nDescription above from the Wikipedia article Kenny Wormald, licensed under CC-BY-SA,full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/83276"}}, {tmdbId:"143240", properties:{bornIn:"Sandy, Utah, USA", imdbId:"2584600", born:date('1988-07-20'), name:"Julianne Hough", bio:"Julianne Hough (born July 20, 1988) is an American professional ballroom dancer, country music singer and actress.  She is most widely known for being a two-time winner of ABC's Dancing with the Stars.  She earned a Creative Arts Primetime Emmy nomination in 2007 for choreography.  ABC's 20/20 called her one of the \"very best dancers on the planet. \" Hough's brother, Derek, is also on Dancing with the Stars and is a three-time winner himself...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/s4B1sheXe3zem1H8VXd5oQ2Wu1m.jpg", url:"https://themoviedb.org/person/143240"}}, {tmdbId:"64155", properties:{imdbId:"2163571", name:"François Bégaudeau", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kfM2Z8Rgg8x6wI8PHfjwbKszN4F.jpg", url:"https://themoviedb.org/person/64155"}}] AS row
