UNWIND [{tmdbId:"184986", properties:{imdbId:"0616607", name:"Gary Myers", url:"https://themoviedb.org/person/184986"}}, {tmdbId:"142995", properties:{bornIn:"Montreal, Quebec, Canada", imdbId:"0399088", born:date('1969-01-02'), name:"Patrick Huard", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7pv4icvjJMzljoUOTL4XM4eoY4l.jpg", url:"https://themoviedb.org/person/142995"}}, {tmdbId:"142996", properties:{bornIn:"Arvida - Quebec - Canada", imdbId:"0495920", born:date('1975-01-01'), name:"Julie LeBreton", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pMSYAWIYfdEWlLU8dHejp93mRIy.jpg", url:"https://themoviedb.org/person/142996"}}, {tmdbId:"90681", properties:{bornIn:"Granby, Québec, Canada", imdbId:"1531116", born:date('1977-12-12'), name:"Antoine Bertrand", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uVVAjRMb7eVOehWRkE6shiMspuK.jpg", url:"https://themoviedb.org/person/90681"}}, {tmdbId:"123933", properties:{imdbId:"0679930", name:"Dominic Philie", url:"https://themoviedb.org/person/123933"}}, {tmdbId:"1033064", properties:{imdbId:"0308289", name:"Francesc Garrido", url:"https://themoviedb.org/person/1033064"}}, {tmdbId:"43135", properties:{bornIn:"Waterford, Ireland", imdbId:"0321800", born:date('1982-11-22'), name:"Fiona Glascott", bio:"Fiona Glascott is an Irish actress.  She was nominated for an Irish Film and Television Award for Best Supporting Actress in Film/TV for 2003's Goldfish Memory. \n\nOn stage in London she has appeared: as Margery Pinchwife in The Country Wife (Haymarket, West End); Mahler's Conversion (Aldwych theatre, West End); Hitchcock Blonde (Royal Court and Lyric Theatre, West End) and in the original production of Whipping It Up at the Bush...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wK9BACG9cCROuupEjUfgIW945e7.jpg", url:"https://themoviedb.org/person/43135"}}, {tmdbId:"21633", properties:{imdbId:"0502097", name:"Kai Lennox", url:"https://themoviedb.org/person/21633"}}, {tmdbId:"61178", properties:{bornIn:"Riverside, California, USA", imdbId:"0790057", born:date('1989-04-18'), name:"Alia Shawkat", bio:"Alia Martine Shawkat (/ˈæliə ˈʃoʊkɑːt/ al-ee-ə shoh-kaht; born April 18, 1989) is an American actress.  She starred as Maeby Fünke in the Fox/Netflix television series Arrested Development (2003–2006; 2013–present), and as Gertie Michaels in the 2015 horror-comedy film The Final Girls. \n\nShawkat currently stars on the TBS comedy Search Party, which premiered on November 21, 2016...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aUc0hlILKfDKhlKnWQliGjkQL9a.jpg", url:"https://themoviedb.org/person/61178"}}, {tmdbId:"41090", properties:{bornIn:"Los Angeles, CA", imdbId:"2654829", born:date('1997-12-15'), name:"Maude Apatow", bio:"From Wikipedia, the free encyclopedia\n\nMaude Apatow (born December 15, 1997) is an American actress.  She is the eldest daughter of director Judd Apatow and actress Leslie Mann and is known for her roles as the daughter to her real-life mother's characters in Knocked Up (2007), Funny People (2009), and This Is 40 (2012)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xWj49QAsGlC92YcguaEEYvoMEsg.jpg", url:"https://themoviedb.org/person/41090"}}, {tmdbId:"963429", properties:{bornIn:"Los Banos, California, USA", imdbId:"2957717", born:date('2002-10-12'), name:"Iris Apatow", bio:"From Wikipedia, the free encyclopedia\n\nIris Apatow (born October 12, 2002) is an American actress known for her role as Arya in the Netflix series Love.  Apatow is the youngest daughter of director Judd Apatow and actress Leslie Mann.  She made her debut, as a child actor, with Knocked Up as Charlotte, alongside her sister Maude Apatow, directed by Judd Apatow.  Then she again reprised the character in the sequel This Is 40...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dVxJmLQf7XJl5GN9bY06gAYCtnL.jpg", url:"https://themoviedb.org/person/963429"}}, {tmdbId:"205474", properties:{bornIn:"Brisbane, Australia", imdbId:"2564938", born:date('1989-11-30'), name:"Adelaide Clemens", bio:"Born and raised in Brisbane, Australia.  Daughter of a British father.  Clemens began working as an actress on Australian television while in high school.  She guest-starred in a 2006 episode of Blue Water High as Juliet, and in 2007, she starred in the children's series Pirate Islands: The Lost Treasure of Fiji as Alison...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2xAu6ZQK0Wfil8FihLemCMvn35y.jpg", url:"https://themoviedb.org/person/205474"}}, {tmdbId:"52018", properties:{bornIn:"Charlotte, North Carolina, U.S.", imdbId:"1429380", born:date('1990-04-18'), name:"Britt Robertson", bio:"Brittany Leanna Robertson is an American actress.  She is known for playing the lead role in Tomorrowland, as well as for film roles in The Space Between Us and A Dog's Purpose.  Robertson also starred in the 2018 television series For the People...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2dvBB0F4NiS2Clxmv5mo9TvQLty.jpg", url:"https://themoviedb.org/person/52018"}}, {tmdbId:"527393", properties:{bornIn:"New York City, New York, USA", imdbId:"3729721", born:date('1991-08-26'), name:"Dylan O'Brien", bio:"Dylan O'Brien is an American actor and musician.  He co-stars as Stiles in the MTV series Teen Wolf.  He also co-starred in the film High Road, and starred in the film The First Time, with Britt Robertson...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gmU3f4aR6Bd8zkk6AiLm0dvWPaE.jpg", url:"https://themoviedb.org/person/527393"}}, {tmdbId:"131642", properties:{bornIn:"New York City - New York - USA", imdbId:"0539651", born:date('1966-01-17'), name:"Joshua Malina", bio:"From Wikipedia, the free encyclopedia. \n\nJoshua Charles Malina (born January 17, 1966) is an American film and stage actor.  He is perhaps most famous for portraying Will Bailey on the NBC drama The West Wing and Jeremy Goodwin on Sports Night...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/twmzs1fBcqdxfZquE6DnJ6mpMOy.jpg", url:"https://themoviedb.org/person/131642"}}, {tmdbId:"68954", properties:{bornIn:"Toronto, Ontario,  Canada", imdbId:"0141599", born:date('1949-07-14'), name:"Graydon Carter", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9V81UKhvgPHa9c6IAh8Z10CzUri.jpg", url:"https://themoviedb.org/person/68954"}}, {tmdbId:"10581", properties:{bornIn:"Toledo, Ohio, USA", imdbId:"1360860", born:date('1978-02-02'), name:"Rich Sommer", bio:"Rich Sommer (born February 2, 1978) is an American actor best known for his portrayal of Harry Crane on Mad Men...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rNAZkY28BVDAcBfUWPsOn3xGPFa.jpg", url:"https://themoviedb.org/person/10581"}}, {tmdbId:"117108", properties:{imdbId:"0055503", name:"Barry Barnes", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rJHczqipGu93Ku6CPyhPbUfXKDH.jpg", url:"https://themoviedb.org/person/117108"}}, {tmdbId:"1171827", properties:{imdbId:"4901062", name:"Maria Laird", url:"https://themoviedb.org/person/1171827"}}, {tmdbId:"2008878", properties:{bornIn:"Guildford, Surrey, England, UK", imdbId:"0810772", born:date('1985-02-18'), name:"Ben Smyth", url:"https://themoviedb.org/person/2008878"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"42601", properties:{bornIn:"Belfast, Northern Ireland, UK", imdbId:"0107261", born:date('1955-01-01'), name:"Brid Brennan", bio:"Bríd Brennan is a Belfast born actress known for her work on the stage and screen...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/RgdIPIWoPeG9HIDibE5P1aif4M.jpg", url:"https://themoviedb.org/person/42601"}}, {tmdbId:"91402", properties:{bornIn:"Surrey, British Columbia, Canada", imdbId:"1650932", born:date('1981-08-20'), name:"Ali Liebert", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gBqC2pUU7TtW9pdYqernpRivSel.jpg", url:"https://themoviedb.org/person/91402"}}, {tmdbId:"76973", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"0419005", born:date('1974-12-03'), name:"Joris Jarsky", bio:"From Wikipedia, the free encyclopedia\n\nJoris Jarsky (born December 3, 1974), also known as Joris Jorsky, is a Canadian stage, film and television actor who has received recognition for being a versatile actor, and is known for his role as Marty Strickland in the series Vampire High. \n\nDescription above from the Wikipedia article Joris Jarsky, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/snXBT36DDvxDhRyym44Zs55eKUf.jpg", url:"https://themoviedb.org/person/76973"}}, {tmdbId:"58737", properties:{bornIn:"Macon, Georgia, USA", imdbId:"1442113", born:date('1973-05-27'), name:"Jack McBrayer", bio:"Jack McBrayer (born May 27, 1973 height 5' 10½\" (1,79 m)) is an American actor and comedian.  He gained national exposure for his characters on \"Late Night with Conan O'Brien\".  He is best known for portraying Kenneth Parcell on the television series 30 Rock, a role for which he received an Emmy nomination in 2009. \n\nDescription above from the Wikipedia article Jack McBrayer, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cbr26xDPEiOuYQxggtCPbu5xhDU.jpg", url:"https://themoviedb.org/person/58737"}}, {tmdbId:"1654665", properties:{name:"Masuhiro Yamamoto", url:"https://themoviedb.org/person/1654665"}}, {tmdbId:"1709841", properties:{name:"Daisuke Nakazama", url:"https://themoviedb.org/person/1709841"}}, {tmdbId:"1709842", properties:{name:"Hachiro Mizutani", url:"https://themoviedb.org/person/1709842"}}, {tmdbId:"1709843", properties:{name:"Harutaki Takahashi", url:"https://themoviedb.org/person/1709843"}}, {tmdbId:"2594353", properties:{name:"Maxey Whitehead", url:"https://themoviedb.org/person/2594353"}}, {tmdbId:"2225189", properties:{name:"Alexis Tipton", url:"https://themoviedb.org/person/2225189"}}, {tmdbId:"556275", properties:{imdbId:"2233310", born:date('1982-06-29'), name:"Matthew Mercer", bio:"Matthew Mercer was born on June 29, 1982 as Matthew Christopher Miller.  He is an actor and producer, known for Resident Evil: Damnation (2012), Monsters University (2013) and Resident Evil 6 (2012)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fe1S317253vfMuNuIDjhp9vtNSs.jpg", url:"https://themoviedb.org/person/556275"}}, {tmdbId:"176748", properties:{bornIn:"New York City - New York - USA", imdbId:"1584283", born:date('1980-07-22'), name:"Lauren Bittner", bio:"Lauren Bittner  is an actress...", url:"https://themoviedb.org/person/176748"}}, {tmdbId:"579064", properties:{bornIn:"Rockville Centre, New York, U.S", imdbId:"2166469", name:"Christopher Nicholas Smith", bio:"Chris Smith is an American television and film actor.  He attended NYU Tisch School of the Arts and trained at the Atlantic Theater Company Acting School in New York City, He also married actress Rebecca Delgado Smith in 2006...", url:"https://themoviedb.org/person/579064"}}, {tmdbId:"995457", properties:{bornIn:"Texas, United States", imdbId:"3785503", born:date('2000-07-07'), name:"Chloe Csengery", url:"https://themoviedb.org/person/995457"}}, {tmdbId:"995458", properties:{bornIn:"West Columbia, South Carolina, United States", imdbId:"1053580", born:date('2004-11-02'), name:"Jessica Tyler Brown", url:"https://themoviedb.org/person/995458"}}, {tmdbId:"29412", properties:{imdbId:"0533847", name:"Eric MacLennan", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wfZEHyZ3X5HZBD5nb9N2aPSPKuR.jpg", url:"https://themoviedb.org/person/29412"}}, {tmdbId:"1795827", properties:{name:"Theo Morrissey", url:"https://themoviedb.org/person/1795827"}}, {tmdbId:"576222", properties:{bornIn:"Coral Springs, Florida, USA", imdbId:"3311695", born:date('1988-07-07'), name:"Chase Williamson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a4kOvLUcwXxaEL8t9Y05xEwyJA.jpg", url:"https://themoviedb.org/person/576222"}}, {tmdbId:"110909", properties:{bornIn:"USA", imdbId:"2373827", born:date('1984-11-17'), name:"Rob Mayes", bio:"Rob Mayes is an American film and television actor, musician and model...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AmuOGIDRUcfOoOQf9Vw4ikqWG53.jpg", url:"https://themoviedb.org/person/110909"}}, {tmdbId:"164131", properties:{bornIn:"Chester, Pennsylvania, USA", imdbId:"0109329", born:date('1946-09-30'), name:"Fran Brill", bio:"Fran Brill (born September 30, 1946) is an actress and puppeteer who worked on Sesame Street beginning in 1970.  She was the first female puppeteer hired by Jim Henson, outside of wife Jane Henson.  She is best known for performing Prairie Dawn and Zoe.  Brill retired from performing in September 2014...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6mMBTcGCfsr4AyZpdZ5gFAUXKnM.jpg", url:"https://themoviedb.org/person/164131"}}] AS row
