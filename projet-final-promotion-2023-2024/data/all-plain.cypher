UNWIND [{tmdbId:"137812", properties:{bornIn:"Roma", imdbId:"0710520", born:date('1968-03-28'), name:"Galatea Ranzi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hSz1qvpBxmghshRYFwqiGpBlSD7.jpg", url:"https://themoviedb.org/person/137812"}}, {tmdbId:"15424", properties:{bornIn:"Boulogne-Billancourt, Hauts-de-Seine, Île-de-France, France", imdbId:"0890232", born:date('1968-11-27'), name:"Michael Vartan", bio:"Michael S.  Vartan (born November 27, 1968) is a French-American film and television actor.  He is probably best known for the role of Michael Vaughn on the American television action drama Alias.  He is currently appearing in the TNT medical drama Hawthorne...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5HCb1CxwIgiZAjKMe9BG8VtHE80.jpg", url:"https://themoviedb.org/person/15424"}}, {tmdbId:"157994", properties:{imdbId:"0474057", name:"Ron Kuhlman", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uhnFDrxTJwhoTVQBtha7xyZww2i.jpg", url:"https://themoviedb.org/person/157994"}}, {tmdbId:"19870", properties:{imdbId:"0842684", name:"Jerry Swindall", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yGHz60t1NnV2wxN8KxZX3TqER3A.jpg", url:"https://themoviedb.org/person/19870"}}, {tmdbId:"948411", properties:{imdbId:"0092071", name:"Ryan Bohls", url:"https://themoviedb.org/person/948411"}}, {tmdbId:"82177", properties:{bornIn:"Shanghai, China", imdbId:"0796196", born:date('1947-03-13'), name:"Josephine Siao", bio:"Josephine Siao Fong-Fong MBE is a Hong Kong film star who became popular as a child actress and continued her success as a mature actress, winning numerous awards including Best Actress at the 45th Berlin International Film Festival (for Summer Snow). [1] Since retiring from show business (partly due to her increasing deafness), she has become a writer and a psychologist, known for her work against child abuse...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hS7UJKxyvuqsUbTRZt6Wmouwnif.jpg", url:"https://themoviedb.org/person/82177"}}, {tmdbId:"62420", properties:{bornIn:"Taipei, Taiwan", imdbId:"0398904", born:date('1958-05-04'), name:"Sibelle Hu", bio:"Sibelle Hu or Hu Huizhong (Chinese: 胡慧中; Wade–Giles: Hu Hui-chung; born 4 May 1958) is a Taiwanese actress, singer and TV personality who starred in both Taiwanese and Hong Kong movies.  She acted in many movies in the 1980s and 1990s and retired in the late 1990s...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pd1C8e7ZXMoa55BpnNJgllB0D89.jpg", url:"https://themoviedb.org/person/62420"}}, {tmdbId:"56695", properties:{bornIn:"Baltimore, Maryland, USA", imdbId:"0875951", born:date('1945-02-06'), name:"Michael Tucker", bio:"​From Wikipedia, the free encyclopedia. \n\nMichael Tucker  (born February 6, 1945) is an American actor and author, most widely known for his role in L. A.  Law, a portrayal for which he received Emmy nominations three years in a row. \n\nTucker was born in Baltimore, Maryland and is a graduate of the Baltimore City College high school and Carnegie-Mellon University in Pittsburgh, Pennsylvania, where he was close to the American T. V.  writer and producer, Steven Bochco, later to create L. A.  Law...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/njXhN02TVr2jnHnnlindfJWXkME.jpg", url:"https://themoviedb.org/person/56695"}}, {tmdbId:"5365", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0004286", born:date('1970-06-16'), name:"Clifton Collins Jr.", bio:"Clifton Collins Jr.  is an American film and television actor, best known for playing student Cesar Sanchez opposite substitute teacher Samuel L.  Jackson in the feature film \"One Eight Seven\", and as the killer Perry Smith in the independent movie \"Capote\".  He also played recurring characters in many television shows and is a series regular in HBO's \"Westworld\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ceryVVubF74pgu13Y0KUqIzxOae.jpg", url:"https://themoviedb.org/person/5365"}}, {tmdbId:"18259", properties:{bornIn:"Medford - Oregon - USA", imdbId:"0725284", born:date('1980-01-29'), name:"Jason James Richter", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fY4fYZOQZKlAtRxys2zxZ884EZq.jpg", url:"https://themoviedb.org/person/18259"}}, {tmdbId:"18261", properties:{bornIn:"Bournemouth, Dorset, England, UK", imdbId:"0040739", born:date('1959-02-18'), name:"Jayne Atkinson", bio:"Jayne Atkinson (born February 18, 1959) is an English-born American film, theatre and television actress.  She is perhaps best known for the role of Karen Hayes on 24 as well as her Tony Award-nominated roles in The Rainmaker and Enchanted April.  She is also known for appearing in the CBS drama, Criminal Minds as BAU Section Chief Erin Strauss...", url:"https://themoviedb.org/person/18261"}}, {tmdbId:"64846", properties:{bornIn:"Boyeros, Cuba", imdbId:"0675751", born:date('1965-08-13'), name:"Jorge Perugorría", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8cFd7RgjTcbMm0cTKBgs5iQ805k.jpg", url:"https://themoviedb.org/person/64846"}}, {tmdbId:"72642", properties:{imdbId:"0190489", name:"Vladimir Cruz", url:"https://themoviedb.org/person/72642"}}, {tmdbId:"72644", properties:{imdbId:"0406433", name:"Mirta Ibarra", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/83arb64FeBPkRGBSbuHMcNLuTgk.jpg", url:"https://themoviedb.org/person/72644"}}, {tmdbId:"72645", properties:{bornIn:"Santa Clara, Villa Clara, Cuba", imdbId:"0309839", born:date('1964-10-12'), name:"Francisco Gattorno", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c4tmNQFBgr9h1UNmXmqkZhtUCIY.jpg", url:"https://themoviedb.org/person/72645"}}, {tmdbId:"6068", properties:{bornIn:"Meridian, Mississippi, USA", imdbId:"0000688", born:date('1956-07-11'), name:"Sela Ward", bio:"Sela Ward (born July 11, 1956) is an American movie and television actress, best known for her roles on Sisters, Once and Again and CSI: NY...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3tXSYEmrsL1Yx2nCkv5p6KmdmmP.jpg", url:"https://themoviedb.org/person/6068"}}, {tmdbId:"2189", properties:{bornIn:" Paris, France", imdbId:"0719200", born:date('1952-05-11'), name:"Renaud", bio:"​From Wikipedia, the free encyclopedia\n\nRenaud Pierre Manuel Séchan, known as Renaud, born in Paris on 11 May 1952, is a popular French singer, songwriter and actor.  His characteristically 'broken' voice makes for a very distinctive vocal style.  Several of his songs are popular classics in France, including the sea tale \"Dès que le vent soufflera\", the irreverent \"Laisse béton\", the ballad \"Morgane de toi\" and the nostalgic \"Mistral gagnant\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1bHv3nni37E5k4DH87y9DLY1qd0.jpg", url:"https://themoviedb.org/person/2189"}}, {tmdbId:"24540", properties:{bornIn:"Bourgueil, France", imdbId:"0138405", born:date('1920-04-25'), name:"Jean Carmet", bio:"Jean Carmet (25 April 1920 – 20 April 1994) was a French actor. \n\nJean Carmet began working on stage and then in film in the early 1940s becoming a very popular comedic actor in his native country.  He is best known internationally for his role as a French colonist in the 1976 film, La Victoire en Chantant (Black and White in Color). \n\nBecause of his good-natured manner, he was as popular with members of the film crew as he was with the audiences...", died:date('1994-04-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dKtbIjEH9FI8Oa55uI5n8BA5qGK.jpg", url:"https://themoviedb.org/person/24540"}}, {tmdbId:"136757", properties:{bornIn:" Paris, France", imdbId:"0377882", born:date('1968-05-16'), name:"Judith Henry", bio:"Extrait de Wikipedia, l'Encyclopedie libre. \n\nJudith Henry est une comédienne française découverte par le grand public dans le film La Discrète.  Elle a été étudiante à l’École des enfants du spectacle et de l’École nationale du cirque. \n\nInformations et photo extraites de l'article Judith Henry de Wikipedia, licence CC-BY-SA, liste complète des contributeurs sur Wikipedia...", url:"https://themoviedb.org/person/136757"}}, {tmdbId:"15853", properties:{bornIn:"Nofire Hollow - Oklahoma - USA", imdbId:"0836071", born:date('1947-12-17'), name:"Wes Studi", bio:"Wesley \"Wes\" Studi (born December 17, 1947) is an American Cherokee actor, who has earned notability for his portrayals of Native Americans in film.  He has appeared in well-received Academy Award-winning films, such as Kevin Costner's Dances with Wolves, Michael Mann's The Last of the Mohicans, the award-winning Geronimo: An American Legend and the Academy Award-nominated film The New World (2005)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hIi9rjpOR4az0oJfvlx0FnKSJLv.jpg", url:"https://themoviedb.org/person/15853"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"50653", properties:{bornIn:"Tokyo, Japan", imdbId:"0847392", born:date('1965-10-29'), name:"Masahiro Takashima", bio:"Masahiro Takashima (髙嶋 政宏 Takashima Masahiro, born October 29, 1965, Tokyo) is a Japanese actor. \n\nDescription above from the Wikipedia article Masahiro Takashima, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1fnFiXlwUCQpWce0txPmzuQkIlR.jpg", url:"https://themoviedb.org/person/50653"}}, {tmdbId:"50654", properties:{imdbId:"0762963", born:date('1968-08-22'), name:"Ryoko Sano", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8qUSinpFksh0Dp2CXMLp1JbHcZf.jpg", url:"https://themoviedb.org/person/50654"}}, {tmdbId:"50655", properties:{bornIn:"Kanagawa, Japan", imdbId:"0643894", born:date('1972-05-09'), name:"Megumi Odaka", bio:"​From Wikipedia, the free encyclopedia\n\nMegumi Odaka started her career in 1984 as a voice-actress (seiyū) for the animation-TV-Series Fushigi na koala Blinky aka Noozles (USA) aka The Wondrous Koala Blinky (USA), where she played the character Sandy Brown.  In 1987 she started her film career at Toho with the movie \"Taketori Monogatari\" aka \"Princess from the Moon\", where she played the role of the blind girl Akeno along with Yasuko Sawaguchi, who played Kaguya, the princess...", url:"https://themoviedb.org/person/50655"}}, {tmdbId:"50656", properties:{bornIn:" Tokyo, Japan", imdbId:"0442955", born:date('1935-05-12'), name:"Yûsuke Kawazu", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9dC7zoBPK5levn5BXf37jxV3jJ8.jpg", url:"https://themoviedb.org/person/50656"}}, {tmdbId:"19957", properties:{bornIn:"Hamilton, Ontario, Canada", imdbId:"0187724", born:date('1956-05-09'), name:"Wendy Crewson", bio:"Wendy Jane Crewson (born May 9, 1956) is a Canadian actress.  Description above from the Wikipedia article Wendy Crewson, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xHqddOkIfcPhW2ieXhQwHceV7l2.jpg", url:"https://themoviedb.org/person/19957"}}, {tmdbId:"52", properties:{bornIn:"Hamilton, Massachusetts, USA", imdbId:"0001556", born:date('1953-10-11'), name:"David Morse", bio:"David Bowditch Morse (born October 11, 1953) is an American stage, television, and film actor.  He first came to national attention as Dr.  Jack Morrison in the medical drama St.  Elsewhere from 1982 to 1988.  Morse continued his movie career with roles in Dancer in the Dark, The Negotiator, The Green Mile, Disturbia, The Long Kiss Goodnight, The Crossing Guard, The Rock, Extreme Measures, Twelve Monkeys, 16 Blocks, and Hounddog...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3YeyORYXfhIOEDtfUbrkMF9qEjf.jpg", url:"https://themoviedb.org/person/52"}}, {tmdbId:"537", properties:{bornIn:" Dallas, Texas, USA", imdbId:"0864997", born:date('1951-05-30'), name:"Stephen Tobolowsky", bio:"Stephen Harold Tobolowsky (born May 30, 1951) is an American actor.  He is well known for his role as Ned Ryerson in Groundhog Day, as well as portraying Commissioner Hugo Jarry in Deadwood for nine episodes and Bob Bishop in Heroes for eleven episodes over the second and third seasons.  Tobolowsky has a semi-recurring role as Sandy Ryerson in the Fox show Glee. \n\nDescription above from the Wikipedia article Stephen Tobolowsky, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4GNQJVEcU4V8AGVMXKM5FVOuW8h.jpg", url:"https://themoviedb.org/person/537"}}, {tmdbId:"20757", properties:{imdbId:"0679326", name:"Chuck Pfarrer", url:"https://themoviedb.org/person/20757"}}, {tmdbId:"20762", properties:{imdbId:"0032050", name:"Robert Apisa", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nk8NuL0rR4QD1vDvrNAyxNmxCfe.jpg", url:"https://themoviedb.org/person/20762"}}, {tmdbId:"16743", properties:{bornIn:"Pretoria, Gauteng, South Africa", imdbId:"0903677", born:date('1962-06-16'), name:"Arnold Vosloo", bio:"From Wikipedia, the free encyclopedia. \n\nArnold Vosloo (born June 16, 1962) is a South African actor, best-known for playing the role of the villain Imhotep in the 1999 film The Mummy, and its 2001 sequel, The Mummy Returns, also known for playing the role of the superhero Darkman in the sequel Darkman II: The Return of Durant (1994) and its 1996 sequel, Darkman III: Die Darkman Die...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cs9HCEPbqdTzdfKqd0UTD3TlWGB.jpg", url:"https://themoviedb.org/person/16743"}}, {tmdbId:"1305317", properties:{bornIn:"Lancaster, New Hampshire, USA", imdbId:"0021359", born:date('1956-08-29'), name:"GG Allin", bio:"Kevin Michael \"GG\" Allin (born Jesus Christ Allin; August 29, 1956 – June 28, 1993) was an American punk rock singer-songwriter who performed and recorded with many groups during his career.  Allin was best known for his controversial live performances, which often featured transgressive acts, including self-mutilation, onstage defecation and coprophagia, indecent exposure and assaulting audience members, for which he was arrested and imprisoned on multiple occasions...", died:date('1993-06-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/u8S0JYoaZaQVcMe3HnVfNCbBmnc.jpg", url:"https://themoviedb.org/person/1305317"}}, {tmdbId:"1888807", properties:{name:"Merle Allin", url:"https://themoviedb.org/person/1888807"}}, {tmdbId:"2551129", properties:{name:"Shireen Kadivar", url:"https://themoviedb.org/person/2551129"}}, {tmdbId:"80490", properties:{bornIn:"Fort Lee, Virginia, USA", imdbId:"0708493", born:date('1951-09-18'), name:"Dee Dee Ramone", bio:"From Wikipedia, the free encyclopedia.    \n\nDee Dee Ramone (born Douglas Glenn Colvin) (September 18, 1951  – June 5, 2002) was an American songwriter and musician, best known as founding member, bassist and main songwriter of the punk rock band the Ramones...", died:date('2002-06-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wk3MJXiTnBmS8Omi6xMV0WOgtul.jpg", url:"https://themoviedb.org/person/80490"}}, {tmdbId:"65309", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0441814", born:date('1976-05-30'), name:"Omri Katz", bio:"​From Wikipedia, the free encyclopedia.   \n\nOmri Haim Katz (born May 30, 1976) is an American actor.  His TV and film credits include Eerie, Indiana; Matinee; Adventures in Dinosaur City; Hocus Pocus; and the CBS prime time soap opera Dallas, in which he played the role of John Ross Ewing III, the son of J. R.  Ewing (played by series star Larry Hagman) and Sue Ellen Ewing (Linda Gray) from 1983 to 1991...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4ohtjOAFLDghurBunwGlCKbRcjL.jpg", url:"https://themoviedb.org/person/65309"}}, {tmdbId:"120990", properties:{imdbId:"0017519", name:"Don Alder", bio:"Don Alder is an actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mODuavZbHgUzjcNe5DJanzJXFfD.jpg", url:"https://themoviedb.org/person/120990"}}, {tmdbId:"1242308", properties:{bornIn:"Philadelphia", imdbId:"0076204", born:date('1939-07-04'), name:"Ed Bernard", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2zkFaDgbS2WtNxjlEbkrYKPKpO.jpg", url:"https://themoviedb.org/person/1242308"}}, {tmdbId:"51337", properties:{imdbId:"0156610", name:"Kevin Chevalia", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/T0mBGEkDLsyg5KHQfBcb7jtsg7.jpg", url:"https://themoviedb.org/person/51337"}}, {tmdbId:"51338", properties:{imdbId:"0160239", name:"Anne Christianson", url:"https://themoviedb.org/person/51338"}}, {tmdbId:"133732", properties:{bornIn:" Carthage, Tunisia", imdbId:"0030251", born:date('1962-03-05'), name:"Amina Annabi", bio:"Amina was born in a music family.  Her father is Tunisian and her mother is French.  Her grandmother was a musician and one of her uncles was involved in the in setting up the Tabarka Festival in Tunisia, so Amina got the chance to see a number of music stars, going along to concerts byJoan Baez, James Brown and the famous Algerian diva Warda.  It was at the Tabarka music festival that Amina would get to meet the young Senegalese star Wasis Diop...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9jc703d5CeB0mBUqpXd1SHh1RIP.jpg", url:"https://themoviedb.org/person/133732"}}] AS row
