UNWIND [{tmdbId:"11291", properties:{bornIn:"Châtenay-Malabry, Hauts-de-Seine, France", imdbId:"0993242", born:date('1982-11-30'), name:"Clémence Poésy", bio:"Clémence Poésy is a French actress and model.  Since starting on the stage as a child, Poésy had dramatic education, and has been active on both film and television since 1999, including some English-language productions.  Outside of her home country, she is perhaps best known for playing Fleur Delacour in Harry Potter and the Goblet of Fire and Chloë in In Bruges...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jB16viYaToZvJvbX8mlUtTo3Gsw.jpg", url:"https://themoviedb.org/person/11291"}}, {tmdbId:"25657", properties:{imdbId:"0758411", name:"Justin Salinger", bio:"Justin Salinger is a film and television actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/69NPzag4gxlqBs9f1jPYbJzucPr.jpg", url:"https://themoviedb.org/person/25657"}}, {tmdbId:"81097", properties:{bornIn:"Stratford, Ontario, Canada", imdbId:"0731575", born:date('1984-04-02'), name:"Shawn Roberts", bio:"Shawn Roberts (born April 2, 1984) is a Canadian actor. \n\nDescription above from the Wikipedia article Shawn Roberts, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vrA6GKTV7TuRHYlNFGLuqmCweBu.jpg", url:"https://themoviedb.org/person/81097"}}, {tmdbId:"83820", properties:{bornIn:"Hong Kong, British Crown Colony [now China]", imdbId:"0482628", born:date('1967-09-21'), name:"Ka Tung Lam", bio:"Gordon Lam Ka-tung (Chinese: 林家棟, born 21 September 1967) is a Hong Kong actor known for his supporting roles in films from the likes of Andrew Lau to Johnnie To. \n\nDescription above from the Wikipedia article Gordon Lam, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/61gQoVwgpd4qzovOaZjzJpdm47K.jpg", url:"https://themoviedb.org/person/83820"}}, {tmdbId:"219264", properties:{imdbId:"0740581", name:"David Roper", url:"https://themoviedb.org/person/219264"}}, {tmdbId:"1127817", properties:{imdbId:"0714740", name:"Jimmy Reddington", url:"https://themoviedb.org/person/1127817"}}, {tmdbId:"81682", properties:{bornIn:"Belgrade, Yugoslavia [now Serbia]", imdbId:"0636942", born:date('1981-07-12'), name:"Bojana Novakovic", bio:"Bojana Novakovic is a Serbian-Australian actress who is currently starring in the American TV series Instinct with Alan Cumming.  Novakovic is known for her roles in films such as Devil and The Little Death...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/brputZXskZzzncPA4TP9ndqBe7.jpg", url:"https://themoviedb.org/person/81682"}}, {tmdbId:"90682", properties:{imdbId:"0396515", name:"Lisa Houle", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Aj5G6NGztvlKce10O2Xe2dIWUuM.jpg", url:"https://themoviedb.org/person/90682"}}, {tmdbId:"90683", properties:{bornIn:"Guildford, Surrey, England, UK", imdbId:"2468050", born:date('1986-02-12'), name:"Georgina Reilly", bio:"Georgina Reilly is a British-Canadian actress born in Surrey, England...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bNLXDfDNV4AOmAuktORHiRqgpYt.jpg", url:"https://themoviedb.org/person/90683"}}, {tmdbId:"44155", properties:{bornIn:"Khartoum, Sudan", imdbId:"0019528", born:date('1950-01-01'), name:"Hrant Alianak", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8heYIeUkBDqGSOuUCia4XS2DdvV.jpg", url:"https://themoviedb.org/person/44155"}}, {tmdbId:"140196", properties:{imdbId:"0008892", name:"Romi Aboulafia", url:"https://themoviedb.org/person/140196"}}, {tmdbId:"145133", properties:{bornIn:"London, UK", imdbId:"2227000", born:date('1981-04-10'), name:"Harry Hadden-Paton", bio:"Harry Frederick Gerard Hadden-Paton (born 10 April 1981) is a British actor.  He is perhaps best known for his television role as Herbert Pelham, 7th Marquess of Hexham, in the television series Downton Abbey. \n\nHadden-Paton played the lead role of Henry Higgins in the Lincoln Center Theater revival of My Fair Lady on Broadway, a performance for which he was nominated for the 2018 Tony Award for Best Actor in a Musical.  . . ...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qyP94KSd95vGScVwIpENI3aWTYb.jpg", url:"https://themoviedb.org/person/145133"}}, {tmdbId:"2068585", properties:{name:"Samantha Harrington", url:"https://themoviedb.org/person/2068585"}}, {tmdbId:"76527", properties:{bornIn:"Huntsville, Alabama, USA", imdbId:"1260407", born:date('1979-06-28'), name:"Felicia Day", bio:"Kathryn Felicia Day is an American actress, known for her work as \"Vi\" on the TV series Buffy the Vampire Slayer and for parts in movies such as Bring It On Again and June, as well as the Internet musical, Dr.  Horrible's Sing-Along Blog.  Day is also the star, script writer and producer of the original web series The Guild, a show loosely based on her life as a gamer, which is directed by Sean Michael Becker...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9jXzLt34ibmmmTakiZXn7Eotdeh.jpg", url:"https://themoviedb.org/person/76527"}}, {tmdbId:"14548", properties:{bornIn:"The Bronx, New York City, New York, USA", imdbId:"0476040", name:"Marcia Jean Kurtz", bio:"Marcia Jean Kurtz is an American film, stage, and television actress and director.  She has appeared in such films as The Panic in Needle Park, In Her Shoes, Dog Day Afternoon and Big Fan.  Kurtz won an Obie Award for her performance as Doris in Donald Margulies' The Loman Family Picnic.  She was also nominated for both an Obie and a Drama Desk Award for her role in Martin Sherman's When She Danced.  Kurtz also directed Matty Selman's Uncle Phillip's Coat and Evan Handler's Time of Fire...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qRZMvp6EllY83RRpKzcBdKklgoU.jpg", url:"https://themoviedb.org/person/14548"}}, {tmdbId:"20047", properties:{bornIn:"The Bronx, New York, USA", imdbId:"0120648", born:date('1974-03-01'), name:"Cara Buono", bio:"Cara Buono (born March 1, 1974) is an American actress, screenwriter and director best known for her roles as Dr.  Faye Miller in the fourth season of the AMC drama series Mad Men, Kelli Moltisanti in the sixth season of The Sopranos, Linda Salvo in the 2006 comedy Artie Lange's Beer League, and Karen Wheeler in the 2016 horror sci-fi Netflix original series Stranger Things.  She has appeared in such films as Hulk (2003) and Let Me In (2010)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8nK8PSGTfDr3GtqdgUcWwbSlyJX.jpg", url:"https://themoviedb.org/person/20047"}}, {tmdbId:"87463", properties:{bornIn:"Heston, Middlesex, England", imdbId:"0656211", born:date('1944-01-09'), name:"Jimmy Page", bio:"An English musician, songwriter, multi-instrumentalist, and record producer who achieved international success as the guitarist and leader of the rock band Led Zeppelin.  Page began his career as a studio session musician in London and, by the mid-1960s, he had become the most sought-after session guitarist in England.  He was a member of the Yardbirds from 1966 to 1968.  In late 1968, he founded Led Zeppelin...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1xxzTj4HrCBBoyCP8eJimFpo6BK.jpg", url:"https://themoviedb.org/person/87463"}}, {tmdbId:"13611", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"1226421", born:date('1975-07-09'), name:"Jack White", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o3oliP92MkIPBueVES8EAVIvAiF.jpg", url:"https://themoviedb.org/person/13611"}}, {tmdbId:"224907", properties:{imdbId:"0942052", name:"Link Wray", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1jx1BqeiclLHjHDE3xWLiROhWrE.jpg", url:"https://themoviedb.org/person/224907"}}, {tmdbId:"302165", properties:{bornIn:"Didsbury, Manchester, England, UK", imdbId:"0334441", born:date('1988-03-27'), name:"Holliday Grainger", bio:"Holliday Grainger is a British stage, film and television actress, best known for playing Lucrezia Borgia in the Showtime series The Borgias and Estella in Mike Newell's feature film Great Expectations...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3hJtIZo3QzXz1Soy2f0D8BoPcxf.jpg", url:"https://themoviedb.org/person/302165"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"85825", properties:{bornIn:"Fort Worth, Texas, USA", imdbId:"1015262", born:date('1986-04-09'), name:"Leighton Meester", bio:"Leighton Marissa Meester (born April 9, 1986) is an American actress and singer.  She is mostly known for her starring role as Blair Waldorf in the teen drama series Gossip Girl (2007–12).  She has also appeared in the 2010 country drama film Country Strong, the 2011 thriller The Roommate, the 2011 romantic-comedy Monte Carlo, and the comedies The Oranges (2011) and That's My Boy (2012).  Meester made her Broadway debut in 2014 in Of Mice and Men...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2JO16YfCnaRnck8lTV5uVeu9Pye.jpg", url:"https://themoviedb.org/person/85825"}}, {tmdbId:"91643", properties:{bornIn:"Dartford, Kent", imdbId:"3086235", born:date('1991-06-22'), name:"Katie Jarvis", bio:"From Wikipedia, the free encyclopedia. \n\nKatie Jarvis (born 22 June 1991) is an English actress, most notable for her role as Mia in the film Fish Tank.  She was spotted by a casting agent, following an argument with her boyfriend at Tilbury Town railway station. \n\nDescription above from the Wikipedia article Katie Jarvis, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o1ifXmbSRfifNPoGXdW97xox6uM.jpg", url:"https://themoviedb.org/person/91643"}}, {tmdbId:"972306", properties:{imdbId:"3650501", name:"Rebecca Griffiths", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sMV2xYF2iiHUiWCu2bs5FcL7Z77.jpg", url:"https://themoviedb.org/person/972306"}}, {tmdbId:"115918", properties:{imdbId:"3010965", name:"Villmar Björkman", url:"https://themoviedb.org/person/115918"}}, {tmdbId:"76894", properties:{imdbId:"3010930", name:"Linnea Cart-Lamy", url:"https://themoviedb.org/person/76894"}}, {tmdbId:"115920", properties:{imdbId:"3010533", name:"Sara Eriksson", url:"https://themoviedb.org/person/115920"}}, {tmdbId:"60073", properties:{bornIn:"Sacramento, California, USA", imdbId:"0488953", born:date('1989-10-01'), name:"Brie Larson", bio:"An American actress, director, and singer.  Larson was home-schooled before she studied acting at the American Conservatory Theater.  She began her acting career in television, appearing as a regular on the 2001 sitcom Raising Dad, for which she was nominated for a Young Artist Award. \n\nAs a teenager, Larson had brief roles in the 2004 films 13 Going on 30 and Sleepover...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ajL2BnTVftx9VtjNQceKC1qIqSb.jpg", url:"https://themoviedb.org/person/60073"}}, {tmdbId:"54697", properties:{bornIn:"Palo Alto, California, USA", imdbId:"2002649", born:date('1985-06-12'), name:"Dave Franco", bio:"Dave Franco is an American TV and film performing artist who is known for his parts in the movies 21 Jump Street, Now You See Me, Warm Bodies, and Neighbors, Charlie St.  Cloud, Fright Night,  and on the ninth season of the series Scrubs.  He is the more youthful sibling of performer James Franco. \n\nIn 2006, Franco made his acting presentation on The CW dramatization TV arrangement 7th Heaven. \n\nFranco has been dating on-screen character Alison Brie since 2012...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yvVRUa6jCGjm40jUpaOGhY8KUWA.jpg", url:"https://themoviedb.org/person/54697"}}, {tmdbId:"6576", properties:{bornIn:"Baltimore, Maryland, USA", imdbId:"0001679", born:date('1956-12-07'), name:"Mark Rolston", bio:"From Wikipedia, the free encyclopedia. \n\nMark Rolston (born December 7, 1956) is an American actor. \n\nDescription above from the Wikipedia article Mark Rolston, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hcrNRIptYMRXgkJ9k76BlQu6DQp.jpg", url:"https://themoviedb.org/person/6576"}}, {tmdbId:"87441", properties:{imdbId:"3135141", name:"Melissa Jones", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/QRc133y5LkAdlkugc7wqZ6aO07.jpg", url:"https://themoviedb.org/person/87441"}}, {tmdbId:"87442", properties:{imdbId:"1080095", name:"Kevin Yon", url:"https://themoviedb.org/person/87442"}}, {tmdbId:"123064", properties:{imdbId:"3362755", name:"Koby Rouviere", url:"https://themoviedb.org/person/123064"}}, {tmdbId:"123065", properties:{imdbId:"3437020", name:"Sydney Rouviere", url:"https://themoviedb.org/person/123065"}}, {tmdbId:"92404", properties:{bornIn:"Stockholm, Sweden", imdbId:"1172478", born:date('1979-11-25'), name:"Joel Kinnaman", bio:"Joel Kinnaman (born Charles Joel Nordström; 25 November 1979) is a Swedish-American actor.  A theater school graduate, Kinnaman had his breakout roles in Sweden with the Johan Falk film series and the 2010 film Easy Money.  He is known for his roles in television series The Killing and Altered Carbon, as well as in films RoboCop and Suicide Squad...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/45CWHmi09y7s7fBnkjtkEgeBr99.jpg", url:"https://themoviedb.org/person/92404"}}, {tmdbId:"1386824", properties:{imdbId:"3227473", name:"John Hollingworth", url:"https://themoviedb.org/person/1386824"}}, {tmdbId:"2238628", properties:{name:"Cato Sandford", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7MBWlVdaQKIqBeCKvooXTXUzqsT.jpg", url:"https://themoviedb.org/person/2238628"}}, {tmdbId:"36666", properties:{bornIn:"Bromley, Kent, England, UK", imdbId:"0868476", born:date('1960-06-02'), name:"Pip Torrens", bio:"From Wikipedia, the free encyclopedia.  \n\nPip Torrens (born June 2, 1960) is an English actor.  He studied English Literature at Trinity College, Cambridge.  His television appearances include Consenting Adults, two episodes of Doctor Who (\"Human Nature\"/\"The Family of Blood\"), Green Wing,Silk, The Government Inspector (as John Scarlett), The Last Detective and DI Torrens for a few episodes in The Bill in 2001...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2CMGIZ0hXTB4FcCXGlfVGaHGBBm.jpg", url:"https://themoviedb.org/person/36666"}}, {tmdbId:"81051", properties:{bornIn:"Belfort, France", imdbId:"2588665", born:date('1981-07-04'), name:"Tahar Rahim", bio:"Tahar Rahim (born 5 July 1981) is a French actor of Algerian origin.  Born in Belfort, France, his family is originally from the region of Oran, Algeria.  He is most notably known for his starring role as Malik El Djebena in the 2009 award-winning French movie A Prophet by Jacques Audiard...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/boNW2ObVaKxvZoTmFLYkVhTHdKS.jpg", url:"https://themoviedb.org/person/81051"}}, {tmdbId:"17498", properties:{bornIn:"Montreuil, Seine [now Seine-Saint-Denis], France", imdbId:"0034390", born:date('1949-02-08'), name:"Niels Arestrup", bio:"Niels Arestrup is a French actor, film director and screenwriter.  His father was Danish and his mother was French.  He has won two César Awards for Best Supporting Actor for De battre mon cœur s'est arrêté and Un prophète, both films where he was directed by Jacques Audiard...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zjPnleZ6PthQWPIvloiiQbr2rCt.jpg", url:"https://themoviedb.org/person/17498"}}, {tmdbId:"89624", properties:{bornIn:"Saint-Maurice, France", imdbId:"1513288", born:date('1975-05-30'), name:"Adel Bencherif", bio:"Adel Bencherif is a French actor of Tunisian origin.  He is most famous for his role in the 2009 film A Prophet. \n\nDescription above from the Wikipedia article Adel Bencherif, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/edoqFJ3Vhg7Ue0qj6XK4G2q75qU.jpg", url:"https://themoviedb.org/person/89624"}}] AS row
