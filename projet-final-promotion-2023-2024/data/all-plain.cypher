UNWIND [{tmdbId:"6820", properties:{imdbId:"2159846", name:"Kathleen Parker", url:"https://themoviedb.org/person/6820"}}, {tmdbId:"89929", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0781623", born:date('1900-01-01'), name:"Sybil Seely", bio:"Sybil Seely was a silent film actress who worked with the well known silent film comedy actor Buster Keaton...", died:date('1984-06-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xT29YArKVc1CPwrfO2Uuw6lS0mW.jpg", url:"https://themoviedb.org/person/89929"}}, {tmdbId:"112295", properties:{imdbId:"0816045", name:"Jim South", url:"https://themoviedb.org/person/112295"}}, {tmdbId:"180402", properties:{imdbId:"0614367", name:"Joe Murphy", url:"https://themoviedb.org/person/180402"}}, {tmdbId:"552067", properties:{imdbId:"3702737", born:date('1975-05-26'), name:"Kim Tae-hoon", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/t6I4ooL11lklB2sf2D50WIO7Eah.jpg", url:"https://themoviedb.org/person/552067"}}, {tmdbId:"550683", properties:{bornIn:"Corea del Sud", imdbId:"3641180", born:date('1971-01-10'), name:"Kim Hee-won", bio:"Kim Hee-won (김희원) is a South Korean actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sDCxskfmmNidOjV2LwsWh9dAVbN.jpg", url:"https://themoviedb.org/person/550683"}}, {tmdbId:"188721", properties:{imdbId:"0177394", born:date('1950-09-23'), name:"Christopher Cooke", bio:"Christopher Cooke was an American stage, film and television actor.  He was a Director of the Suffolk County Film Commission on Long Island, New York and founded the Long Island Film Festival in 1983...", died:date('2013-04-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4Cc6CFhoVKOJSr8WXEqVd9Gq4Cx.jpg", url:"https://themoviedb.org/person/188721"}}, {tmdbId:"1215088", properties:{bornIn:"London, England, U.K.", imdbId:"0370199", born:date('1924-04-03'), name:"Peter Hawkins", died:date('2006-07-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8EsBwsaJ29P3fuQXjBQ0BkRn6V3.jpg", url:"https://themoviedb.org/person/1215088"}}, {tmdbId:"69052", properties:{imdbId:"0632223", born:date('1941-06-15'), name:"Harry Nilsson", bio:"American singer, songwriter and musician Harry Nilsson achieved the peak of his commercial success in the late 1960's and early 1970's.  On all but his earliest recordings he is credited simply as Nilsson.  He is known for the hit singles \"Everybody's Talkin'\" (1969), \"Without You\" (1971), and \"Coconut\" (1972), the first two of which won him Grammy Awards for vocal performance.  His songwriting credits during that period included the song “One”, made famous by the rock band Three Dog Night...", died:date('1994-01-15'), url:"https://themoviedb.org/person/69052"}}, {tmdbId:"83910", properties:{bornIn:"Morecambe, Lancashire, England, UK", imdbId:"0386331", born:date('1911-05-28'), name:"Thora Hird", bio:"From Wikipedia, the free encyclopedia\n\nDame Thora Hird, DBE (28 May 1911 – 15 March 2003) was an English actress and comedian of stage and screen, presenter and writer.  In a career spanning over 70 years, she appeared in more than 100 film and television roles, becoming a household name and a British institution...", died:date('2003-03-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cBNBsMzmQMZukyqd1DGWbE8aMHN.jpg", url:"https://themoviedb.org/person/83910"}}, {tmdbId:"17069", properties:{bornIn:"Stratford-on-Avon, Warwickshire, England, UK", imdbId:"0859525", born:date('1953-09-20'), name:"Sian Thomas", url:"https://themoviedb.org/person/17069"}}, {tmdbId:"556519", properties:{name:"María Ester Escobar", url:"https://themoviedb.org/person/556519"}}, {tmdbId:"556520", properties:{name:"Francisco Maturana", url:"https://themoviedb.org/person/556520"}}, {tmdbId:"556521", properties:{name:"Alexis García V.", url:"https://themoviedb.org/person/556521"}}, {tmdbId:"929642", properties:{name:"Jaime Gaviria Gómez", url:"https://themoviedb.org/person/929642"}}, {tmdbId:"224354", properties:{bornIn:"Reading, Berkshire, England, UK", imdbId:"1017994", born:date('1970-06-15'), name:"Justin Fletcher", bio:"Justin Fletcher was born on June 15, 1970 in Reading, Berkshire, England.  He is known for his work on Shaun the Sheep Movie (2015), Something Special (2003) and Justin's House (2011)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i0cXa3B7P9cWc4j82jowzGIQDaM.jpg", url:"https://themoviedb.org/person/224354"}}, {tmdbId:"148386", properties:{bornIn:"New York - USA", imdbId:"0112239", born:date('1891-07-10'), name:"Sammy Brooks", died:date('1951-05-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zu0BKxxmlHXG83uVg50dnLNQs31.jpg", url:"https://themoviedb.org/person/148386"}}, {tmdbId:"149984", properties:{imdbId:"3540035", name:"Catherine Tanvier", url:"https://themoviedb.org/person/149984"}}, {tmdbId:"21664", properties:{bornIn:"Paris,France", imdbId:"0802488", born:date('1947-10-28'), name:"Christian Sinniger", bio:"Christian Sinniger est un acteur français né à Paris le 28 octobre 1947.   Il débute au théâtre sous la direction de Simone Turk (cofondatrice du Grenier de Toulouse) au cours des années 1970...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wKE2EopoX6RGu6VJmkH6pw6RRXz.jpg", url:"https://themoviedb.org/person/21664"}}, {tmdbId:"663", properties:{bornIn:"Dallas, Texas, USA", imdbId:"0393853", born:date('1948-07-05'), name:"William Hootkins", bio:"William Michael Hootkins was born on July 5, 1948, in Dallas, Texas.  He moved to London, England in the early '70s and lived there up until 2002.  Hootkins was an actor at Theatre Intime while attending Princeton University where he learned how to speak fluent Mandarin Chinese.  He also trained as an actor at the London Academy of Music and Dramatic Arts, and attended St.  Marks, where he was in the same theater group as Tommy Lee Jones...", died:date('2005-10-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dav2i86GN0UvYIyoTwQmGE8Nweg.jpg", url:"https://themoviedb.org/person/663"}}] AS row
