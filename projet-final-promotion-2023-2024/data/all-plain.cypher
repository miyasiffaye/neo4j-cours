UNWIND [{tmdbId:"3810", properties:{bornIn:"Las Palmas de Gran Canaria, Gran Canaria, Canary Islands, Spain", imdbId:"0000849", born:date('1969-03-01'), name:"Javier Bardem", bio:"Javier Ángel Encinas Bardem is a Spanish actor from the Canary Islands.  He is best known for his role in the 2007 film No Country for Old Men, for which he won the Academy Award for Best Supporting Actor portraying the psychopathic assassin Anton Chigurh.  He has also received critical acclaim for roles in films such as Jamón, jamón, Carne trémula, Boca a boca, Los Lunes al sol, Mar adentro, and Skyfall, for which he received both a BAFTA and a SAG nomination for Best Supporting Actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eCBiiPvBfIY7exDQwH0vEM6Bf3c.jpg", url:"https://themoviedb.org/person/3810"}}, {tmdbId:"3809", properties:{bornIn:"Trento, Italy", imdbId:"0626202", born:date('1964-02-10'), name:"Francesca Neri", bio:"Francesca Neri is an Italian actress.  Neri was born in Trento, and has twice received the Silver Ribbon Award for Best Actress from the Italian National Syndicate of Film Journalists, for Pensavo fosse amore, invece era un calesse, directed by Massimo Troisi and Carne trémula...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1aDT4mtTdnp6xh60NnjUXI62Poy.jpg", url:"https://themoviedb.org/person/3809"}}, {tmdbId:"3808", properties:{bornIn:"Roma, Italia", imdbId:"0704721", born:date('1975-05-30'), name:"Liberto Rabal", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cxhE3tf2SNQatvX2Od7QzqKAsMo.jpg", url:"https://themoviedb.org/person/3808"}}, {tmdbId:"75889", properties:{bornIn:"Monto, Queensland, Australia", imdbId:"0146264", born:date('1943-07-21'), name:"Michael Caton", bio:"From Wikipedia, the free encyclopedia\n\nMichael Caton (born in Monto, Queensland, 1943) is an Australian television, film and stage actor, and television host, best known for playing Uncle Harry in the Australian television series, The Sullivans,, playing Darryl Kerrigan from 1997's low budget hit film The Castle and playing in the popular Packed to the Rafters.  He is married to Helen Esakoff...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8V9uSF00fv8AHt51I0hwFDKAYDT.jpg", url:"https://themoviedb.org/person/75889"}}, {tmdbId:"75890", properties:{imdbId:"0855093", name:"Anne Tenney", url:"https://themoviedb.org/person/75890"}}, {tmdbId:"49360", properties:{imdbId:"0193135", name:"Stephen Curry", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zGAK0CEHAHvXgA0qY4CpwG80c77.jpg", url:"https://themoviedb.org/person/49360"}}, {tmdbId:"26056", properties:{imdbId:"0799402", born:date('1969-06-07'), name:"Anthony Simcoe", bio:"Anthony Simcoe (born 7 June 1969) is an Australian actor, best known for his portrayal of Ka D'Argo in the science fiction television series Farscape. \n\nThe 6' 6\" Simcoe is a graduate of the National Institute of Dramatic Arts in Sydney.  He holds an MFA in Drama, specializing in actor training.  Simcoe gained international fame when he was cast as Ka D'Argo in Farscape.  He was nominated for a Saturn Award for Best Supporting Actor in a Television Series in 2002 for his work on the show...", url:"https://themoviedb.org/person/26056"}}, {tmdbId:"77353", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0004982", born:date('1962-03-10'), name:"Jasmine Guy", bio:"​From Wikipedia, the free encyclopedia\n\nJasmine Guy (born March 10, 1962) is an American actress, singer and dancer.  She is best known for her starring role as Whitley Gilbert in the television sitcom A Different World and Roxy in Dead Like Me. \n\nDescription above from the Wikipedia article Jasmine Guy, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dSuTS6DE7d8VEpHEoEFcNjNXtsW.jpg", url:"https://themoviedb.org/person/77353"}}, {tmdbId:"95791", properties:{bornIn:"Los Angeles, California, USA ", imdbId:"0004831", born:date('1950-02-06'), name:"Natalie Cole", bio:"Natalie Maria Cole (February 6, 1950 – December 31, 2015) was an American singer, songwriter, and performer.  The daughter of Nat King Cole, Natalie rose to musical success in the mid–1970s as an R&amp;B artist with the hits \"This Will Be\", \"Inseparable\", and \"Our Love\".  After a period of failing sales and performances due to a heavy drug addiction, Cole re-emerged as a pop artist with the 1987 album Everlasting and her cover of Bruce Springsteen's \"Pink Cadillac\"...", died:date('2015-12-31'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tjUy6Z9VdMge28eovM8DlQWHRa0.jpg", url:"https://themoviedb.org/person/95791"}}, {tmdbId:"82630", properties:{bornIn:"New York City, New York, U.S.", imdbId:"0670779", born:date('1984-04-02'), name:"Ashley Peldon", bio:"From Wikipedia, the free encyclopedia. \n\nAshley Peldon (born April 2, 1984) is an American television and film actress. \n\nDescription above from the Wikipedia article Ashley Peldon, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/82630"}}, {tmdbId:"1169638", properties:{imdbId:"0303925", name:"Marcelo Games", url:"https://themoviedb.org/person/1169638"}}, {tmdbId:"933067", properties:{imdbId:"0685745", name:"Marc Pitman", url:"https://themoviedb.org/person/933067"}}, {tmdbId:"1185101", properties:{imdbId:"0650574", name:"Leslie Orr", url:"https://themoviedb.org/person/1185101"}}, {tmdbId:"1090741", properties:{imdbId:"0021500", name:"Maureen Allisse", url:"https://themoviedb.org/person/1090741"}}, {tmdbId:"824", properties:{bornIn:"Manhattan, New York, USA", imdbId:"0839486", born:date('1976-05-25'), name:"Ethan Suplee", bio:"Ethan Suplee (born May 25, 1976) is an American film and television actor best known for his roles as Seth Ryan in American History X, Louie Lastik in Remember the Titans, Frankie in Boy Meets World, Randy Hickey in My Name Is Earl, Thumper in The Butterfly Effect, Dewey in Unstoppable, and his roles in Kevin Smith films. \n\nDescription above from the Wikipedia article Ethan Suplee, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xhWmMUp7ZyXITAN2snKmLmfSOQG.jpg", url:"https://themoviedb.org/person/824"}}, {tmdbId:"20503", properties:{bornIn:"Vancouver - Washington - USA", imdbId:"0608714", born:date('1971-03-05'), name:"Scott Mosier", bio:"Scott A.  Mosier is a Canadian-American film producer, editor, podcaster, writer and actor best known for his work with director Kevin Smith, with whom he co-hosts the weekly podcast, SModcast...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kTp9aQtbonYPy4LnfnuXP7Slbs0.jpg", url:"https://themoviedb.org/person/20503"}}, {tmdbId:"15265", properties:{bornIn:"Belgrade, Serbia", imdbId:"0865411", born:date('1965-03-28'), name:"Srdjan Todorovic", bio:"Srđan \"Žika\" Todorović is a Serbian actor.  He was also a drummer in the bands Ekatarina Velika and Disciplina Kičme as well as a member of Radnička Kontrola and Bezobrazno Zeleno. \n\nHe is the son of the actor Bora Todorović...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/drsYd3lcoq60vWSeteU3bKtpSOP.jpg", url:"https://themoviedb.org/person/15265"}}, {tmdbId:"15268", properties:{bornIn:"Belgrade, Yugoslavia (now Serbia)", imdbId:"0441287", born:date('1970-01-20'), name:"Branka Katic", bio:"​From Wikipedia, the free encyclopedia\n\nBranka Katić (born 20 January 1970) is a Serbian actress known for appearing in the movies Black Cat, White Cat and Public Enemies, and in the TV series Big Love. \n\nDescription above from the Wikipedia article Branka Katić, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wRautmsBw9RBuSRRizI1gPCeNJ8.jpg", url:"https://themoviedb.org/person/15268"}}, {tmdbId:"15267", properties:{imdbId:"0014981", name:"Florijan Ajdini", url:"https://themoviedb.org/person/15267"}}, {tmdbId:"87388", properties:{bornIn:"Tabriz, Iran", imdbId:"0619870", born:date('1942-12-26'), name:"Mohammad Amir Naji", bio:"From Wikipedia, the free encyclopedia. \n\nReza Naji is an Iranian actor and an iconic figure of Iranian cinema. \n\nNaji started his career in theater when he was a teenager.  While serving in the Iranian army, he continued to perform in different roles.  His first role in a film goes back to 1997 in Children of Heaven, which proved to be a breakthrough...", url:"https://themoviedb.org/person/87388"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"87389", properties:{imdbId:"0268488", name:"Amir Farrokh Hashemian", url:"https://themoviedb.org/person/87389"}}, {tmdbId:"110696", properties:{imdbId:"0781245", name:"Bahare Seddiqi", url:"https://themoviedb.org/person/110696"}}, {tmdbId:"2125647", properties:{name:"Nafise Jafar-Mohammadi", url:"https://themoviedb.org/person/2125647"}}, {tmdbId:"10000", properties:{bornIn:"St. Louis, Missouri, USA", imdbId:"0819440", born:date('1964-04-24'), name:"Gregory Sporleder", bio:"​From Wikipedia, the free encyclopedia.   \n\nGregory Sporleder (April 24, 1964) is an American actor notable for playing military men in films such as The Rock, Black Hawk Down and Renaissance Man, as well as Calvin Norris in the HBO series True Blood\n\nDescription above from the Wikipedia article  Gregory Sporleder , licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qcCA7hMP8rEEGQDfNCKKl3XZrHn.jpg", url:"https://themoviedb.org/person/10000"}}, {tmdbId:"14406", properties:{bornIn:"Encino, California, USA", imdbId:"0001435", born:date('1963-07-30'), name:"Lisa Kudrow", bio:"Lisa Valerie Kudrow-Stern is an American actress, best known for her role as Phoebe Buffay in the television sitcom Friends, for which she received many accolades including an Emmy Award and two Screen Actors Guild Awards. \n\nWhile starring in Friends, Kudrow also appeared in 1999's comedy film Analyze This, directed by Harold Ramis, as well as its 2002 sequel Analyze That...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9YNzHuT7L0wdEl3zua6iUYz5tYT.jpg", url:"https://themoviedb.org/person/14406"}}, {tmdbId:"10402", properties:{bornIn:"Downey, California, USA", imdbId:"0005513", born:date('1975-10-03'), name:"Alanna Ubach", bio:"Alanna Ubach (born October 3, 1975) is an American actress and voice actress.  She is known for her roles in Legally Blonde as Serena and Meet the Fockers as Isabel Villalobos.  She has provided voices for several characters in a number of animated shows, such as Liz Allan in The Spectacular Spider-Man, the title character in El Tigre: The Adventures of Manny Rivera and Lola Boa in Brandy & Mr.  Whiskers.  She has also written and performed a one-woman show...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/scyn2JnkULyrUYeJyAyUiOabzkv.jpg", url:"https://themoviedb.org/person/10402"}}, {tmdbId:"34", properties:{bornIn:"Saint Louis, Missouri, USA", imdbId:"0932112", born:date('1957-03-04'), name:"Mykelti Williamson", bio:"Michael T.  \"Mykelti\" Williamson (born March 4, 1957) is an American actor best known for his role as Benjamin Buford (Bubba) Blue in the 1994 film Forrest Gump, as Detective Bobby \"Fearless\" Smith in the critically acclaimed but commercially unsuccessful crime drama Boomtown, and recently for appearing as the head of CTU for season 8 of the hit TV series 24...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/b68ZTxJL8EuvGMCcgSH3Mbn2GxP.jpg", url:"https://themoviedb.org/person/34"}}, {tmdbId:"18461", properties:{bornIn:"New York City, New York, USA ", imdbId:"0157915", born:date('1961-11-18'), name:"Nick Chinlund", bio:"From Wikipedia, the free encyclopedia. \n\nZareh Nicholas \"Nick\" Chinlund (born November 18, 1961) is an American actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lRmgWDIXqBTneGbKlJNSFyiis1e.jpg", url:"https://themoviedb.org/person/18461"}}, {tmdbId:"28863", properties:{bornIn:"Lajas, Puerto Rico", imdbId:"0763632", born:date('1974-03-15'), name:"Renoly Santiago", bio:"Actor, singer and writer known for his appearances in films such as Dangerous Minds, Hackers and Con Air, and in television series such as Touched by an Angel and Law & Order: Criminal Intent...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mdWgsQM0u6w9nBVzTHIY7FY1nOG.jpg", url:"https://themoviedb.org/person/28863"}}, {tmdbId:"56040", properties:{bornIn:"Knoxville, Tennessee, USA", imdbId:"0185475", born:date('1957-02-01'), name:"Cylk Cozart", bio:"From Wikipedia, the free encyclopedia\n\nCylk Cozart (born February 1, 1957) is an American actor who has appeared in over 30 films and 20 television shows. \n\nDescription above from the Wikipedia article Cylk Cozart, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rE6WR3lczuNJQx1UlhV5ymnlXSq.jpg", url:"https://themoviedb.org/person/56040"}}, {tmdbId:"20089", properties:{bornIn:"Sparks, Nevada, USA", imdbId:"0540441", born:date('1984-11-21'), name:"Jena Malone", bio:"Jena Malone (born November 21, 1984) is an American actress, musician, and photographer.  She made her film debut in Bastard Out of Carolina (1996) and has appeared in films including Ellen Foster (1997), Contact (1997), Stepmom (1998), Donnie Darko (2001), Life as a House (2001), Saved! (2004), Pride & Prejudice (2005), Into the Wild (2007), The Ruins (2008), Sucker Punch (2011), The Hunger Games film series (2013–15) and The Neon Demon (2016)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1qmkanVCFr3ZaXcxSXVDO8andb0.jpg", url:"https://themoviedb.org/person/20089"}}, {tmdbId:"148122", properties:{bornIn:"Baltimore - Maryland - USA", imdbId:"0086553", born:date('1962-08-20'), name:"Geoffrey Blake", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uKdiO6QagiT0mZ7tf9Xrl8OZUKy.jpg", url:"https://themoviedb.org/person/148122"}}, {tmdbId:"17328", properties:{bornIn:"Twickenham, Middlesex, England, UK", imdbId:"0001722", born:date('1967-10-29'), name:"Rufus Sewell", bio:"​From Wikipedia, the free encyclopedia. \n\nRufus Frederik Sewell (born 29 October 1967) is an English actor.  In film, he has appeared in The Woodlanders, Dangerous Beauty, Dark City, A Knight's Tale, The Illusionist, Tristan and Isolde, and Martha, Meet Frank, Daniel and Laurence.  On television, he starred in the 2010 mini-series The Pillars of the Earth.  Earlier he played the hero, Will Ladislaw, in the BBC adaptation of George Eliot's Middlemarch...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fVQ04mfnOZj9rB73VT3B7spRdeD.jpg", url:"https://themoviedb.org/person/17328"}}, {tmdbId:"56857", properties:{bornIn:"Queens, New York, USA", imdbId:"0004906", born:date('1973-11-26'), name:"Peter Facinelli", bio:"Peter Facinelli (born November 26, 1973) is an Italian-American actor, known as the star of Fastlane.  He also stars as Carlisle Cullen in the Twilight movies and as Mike Dexter in the film Can't Hardly Wait...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dedS4MpictN0kjQsPjjZSQwZoee.jpg", url:"https://themoviedb.org/person/56857"}}, {tmdbId:"87018", properties:{bornIn:"Kannapolis, North Carolina, USA", imdbId:"0589976", born:date('1972-12-30'), name:"Eddie Mills", bio:"Eddie Mills (born December 30, 1972) is an American actor, probably most known for Wasteland...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hYt5jsbpvOw7AmuIQd4tZx3CrvI.jpg", url:"https://themoviedb.org/person/87018"}}, {tmdbId:"36632", properties:{bornIn:"Buenos Aires, Argentina", imdbId:"0098709", born:date('1975-08-29'), name:"Juan Diego Botto", bio:"From Wikipedia, the free encyclopedia\n\nJuan Diego Botto-Rota (born August 29, 1975, in Buenos Aires, Argentina) is an Argentine-Spanish actor. \n\nBotto's father disappeared during the Argentine Dirty War when Juan Diego was only two years old.  With his mother and older sister María, also an actress, he moved to Madrid, Spain, where he currently resides. \n\nBotto started acting at the age of 5 in the film Juego de poder (Power Game)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7Fd5EyWQZAeHkMMJntEkr0lTGVz.jpg", url:"https://themoviedb.org/person/36632"}}, {tmdbId:"56654", properties:{bornIn:"Santa Fiora, Grosseto, Tuscany, Italy", imdbId:"0603090", born:date('1956-08-21'), name:"Laura Morante", bio:"​From Wikipedia, the free encyclopedia. \n\nLaura Morante  (born 21 August 1956) is an Italian film actress. \n\nShe was born in Santa Fiora, province of Grosseto (Tuscany), and is the niece of renowned Italian novelist Elsa Morante...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nZS1JCzVsxVa4tqnHG0q05UDxYQ.jpg", url:"https://themoviedb.org/person/56654"}}, {tmdbId:"24918", properties:{bornIn:"Valladolid, Castilla y León, Spain", imdbId:"0617799", born:date('1965-07-23'), name:"Elvira Mínguez", bio:"She is an actress and a writer known for Retribution (2015) and The Invisible Guardian (2017)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cgzCJ5ewByXizdXDCjQ0MGS2laQ.jpg", url:"https://themoviedb.org/person/24918"}}, {tmdbId:"147822", properties:{imdbId:"0633375", name:"Thokozani Nkosi", url:"https://themoviedb.org/person/147822"}}, {tmdbId:"55708", properties:{bornIn:"UK", imdbId:"0806822", born:date('1649-03-07'), name:"Ron Smerczak", died:date('2019-05-12'), url:"https://themoviedb.org/person/55708"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"147823", properties:{imdbId:"0243062", name:"Wilson Dunster", url:"https://themoviedb.org/person/147823"}}, {tmdbId:"108939", properties:{bornIn:"Albuquerque, New Mexico, USA", imdbId:"0284158", born:date('1983-02-20'), name:"Jeremy Foley", url:"https://themoviedb.org/person/108939"}}, {tmdbId:"40463", properties:{imdbId:"0292498", born:date('1921-11-20'), name:"Dan Frazer", died:date('2011-12-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tBe7tZ4Hyzs7cnGFSpBiEGcwQII.jpg", url:"https://themoviedb.org/person/40463"}}, {tmdbId:"16293", properties:{bornIn:"New Rochelle, New York, USA", imdbId:"0372217", born:date('1944-08-25'), name:"Anthony Heald", bio:"An American actor known for portraying Hannibal Lecter's jail nemesis, Dr.  Frederick Chilton in The Silence of the Lambs and Red Dragon, and for playing assistant principal Scott Guber in David E.  Kelley's Boston Public.  He also had a recurring role as Judge Cooper on Kelley's The Practice and Boston Legal. \n\nDescription above from the Wikipedia article Anthony Heald, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e0E6Z1Y0debr4mAHgj0HO7MYyXG.jpg", url:"https://themoviedb.org/person/16293"}}, {tmdbId:"79866", properties:{bornIn:"London, England, UK", imdbId:"0209095", born:date('1927-01-01'), name:"David de Keyser", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AaAZsz9uuSldZ9QMUlMbmooc7bh.jpg", url:"https://themoviedb.org/person/79866"}}, {tmdbId:"6885", properties:{bornIn:"Benoni, Gauteng, South Africa", imdbId:"0000234", born:date('1975-08-07'), name:"Charlize Theron", bio:"Charlize Theron (born 7 August 1975) is a South African actress, film producer and former fashion model. \n\nShe rose to fame in the late 1990s following roles in the films The Devil's Advocate (1997), Mighty Joe Young (1998), and The Cider House Rules (1999)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gd7ShD0yt4bsR2STeQ19KQ6hvXL.jpg", url:"https://themoviedb.org/person/6885"}}, {tmdbId:"21397", properties:{bornIn:"Trenton, New Jersey, USA", imdbId:"0005379", born:date('1961-05-13'), name:"Dennis Rodman", bio:"Dennis Keith Rodman (born May 13, 1961) is an American retired professional basketball player who played for the Detroit Pistons, San Antonio Spurs, Chicago Bulls, Los Angeles Lakers, and Dallas Mavericks in the National Basketball Association (NBA)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tIYGMFJvBZ30HY3KlVQ0evoaEKV.jpg", url:"https://themoviedb.org/person/21397"}}, {tmdbId:"65732", properties:{bornIn:"Moberly - Missouri - USA", imdbId:"0402358", name:"Brad Hunt", bio:"From Wikipedia, the free encyclopedia\n\nBrad Hunt is an American actor born in Moberly, Missouri...", url:"https://themoviedb.org/person/65732"}}, {tmdbId:"21177", properties:{bornIn:"Boulogne-Billancourt, Hauts-de-Seine, France", imdbId:"0508293", born:date('1952-11-24'), name:"Thierry Lhermitte", bio:"​Thierry Lhermitte (born 24 November 1952) is a French actor, director, writer and producer, best known for his comedic roles.  He was a founder of the comedy troupe Le Splendid in the 1970s, along with, among others, Christian Clavier, Gérard Jugnot, and Michel Blanc.  The group adapted a number of its stage hits for the cinema, and scored major successes with films such as Les Bronzés (1978), Les Bronzés font du ski (1979), Le Père Noël est une ordure (1982) and Un indien dans la ville (1994)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/364D8tAqEoKGLmufpPosHct27kS.jpg", url:"https://themoviedb.org/person/21177"}}, {tmdbId:"35323", properties:{bornIn:"Tours, France", imdbId:"0898317", born:date('1951-02-06'), name:"Jacques Villeret", bio:"Jacques Villeret (6 February 1951 – 28 January 2005) was a French actor, best known internationally for his role as François Pignon in the comedy Le Dîner de Cons.  During his career, he earned many awards including the prestigious medal and title of Chevalier de la Légion d'Honneur. \n\nVilleret was born Mohamed Boufroura in Loches, Indre-et-Loire, France, to an Algerian father and a French mother...", died:date('2005-01-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w4sONhPYO3c361BPxDToT4pJFpY.jpg", url:"https://themoviedb.org/person/35323"}}, {tmdbId:"26887", properties:{bornIn:"Neuilly-sur-Seine, France", imdbId:"0404091", born:date('1947-12-08'), name:"Francis Huster", bio:"Francis Huster (born 8 December 1947) is a French stage, film and television actor, film director and scriptwriter.  Francis Huster was born in Neuilly-sur-Seine.  He studied acting at the Conservatoire of the 17th arrondissement of Paris, at the Cours Florent and at the Conservatoire national (1968), where he had René Simon and later Antoine Vitez as teachers.  He joined the Comédie-Française in 1971, became sociétaire in 1977, and left this institution in 1982...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v2q1DoC8HPOKzo8uRpllC7nnRhQ.jpg", url:"https://themoviedb.org/person/26887"}}, {tmdbId:"24832", properties:{bornIn:"Garches, Seine-et-Oise [now Hauts-de-Seine], France", imdbId:"0699545", born:date('1939-10-20'), name:"Daniel Prévost", bio:"Daniel Prévost (born 20 October 1939) is a French actor, comedian and writer. \n\nDaniel Prévost, alias Denis Forestier, was born to Louise Drancourt and Mohand Ait Salem.  His father was of Berber descent from Algeria (Kabylie region), a fact which he did not discover until later life. \n\nHe is the father of actors Sören Prévost, Erling Prévost and Christophe Prévost. \n\nAfter attending drama school in Paris, Prévost made his theatre début alongside the likes of Michel Serrault in Un certain M.  Blot...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oXgHTf056G7gjS290Nadn05CbPT.jpg", url:"https://themoviedb.org/person/24832"}}, {tmdbId:"14408", properties:{bornIn:"Williamstown, Massachusetts, USA", imdbId:"0001612", born:date('1969-08-19'), name:"Matthew Perry", bio:"Matthew Langford Perry (born August 19, 1969) is an American-Canadian actor, best known for his role as Chandler Bing on the popular, long-running NBC television sitcom Friends, for which he earned an Emmy Award nomination in 2002.  His portrayal of Ron Clark in The Ron Clark Story earned him an Emmy nomination and a Golden Globe nomination.  He also guest-starred in three episodes of the drama series The West Wing, which garnered him two consecutive Emmy nominations in 2003 and 2004...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ggpN8b9GJNGqzJnWWRtYuexg3Fw.jpg", url:"https://themoviedb.org/person/14408"}}, {tmdbId:"8214", properties:{bornIn:"Fontana - California - USA", imdbId:"0215916", born:date('1962-11-10'), name:"Barry Del Sherman", bio:"Barry Del Sherman is an actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zXLTW52g9BW9CCQ5fzxoGNLDe8P.jpg", url:"https://themoviedb.org/person/8214"}}, {tmdbId:"74073", properties:{bornIn:"Anaheim - California - USA", imdbId:"0001034", born:date('1957-09-23'), name:"Rosalind Chao", bio:"​From Wikipedia, the free encyclopedia.   \n\nRosalind Chao (born September 23, 1959) is a Chinese American actress.  Chao's most prolific roles have been as a star of CBS' AfterMASH portraying South Korean refugee Soon-Lee Klinger for both seasons, and the recurring character Keiko O'Brien with 27 appearances on the syndicated science fiction series Star Trek: The Next Generation and Star Trek: Deep Space Nine.  Chao is married to voice actor Simon Templeman...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ejUMD59T6txpKmNqIBroXBjyDHx.jpg", url:"https://themoviedb.org/person/74073"}}, {tmdbId:"10881", properties:{bornIn:"Fitzrovia, London, England, UK", imdbId:"0827170", born:date('1969-04-21'), name:"Toby Stephens", bio:"Toby Stephens (born 21 April 1969) is an English stage, television and film actor who has appeared in films in both Hollywood and Bollywood.  He is best known for playing megavillain Gustav Graves in the James Bond film Die Another Day (2002) and Edward Fairfax Rochester in the BBC television adaptation of Jane Eyre (2006)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7hZVlhxd4FkhEQxaF4lTgwj3SYc.jpg", url:"https://themoviedb.org/person/10881"}}, {tmdbId:"22122", properties:{bornIn:"Panaroma City, California, USA", imdbId:"0328709", born:date('1981-08-08'), name:"Meagan Good", bio:"Meagan Good (born August 8, 1981) is an American film and television actress and occasional film producer. \n\nBeginning her career at the age of four, Good has appeared in numerous commercials, television shows, feature films, and music videos...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/anleQytF5PwsERpbQNf83wpcWlD.jpg", url:"https://themoviedb.org/person/22122"}}, {tmdbId:"4941", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0005273", born:date('1972-06-28'), name:"Alessandro Nivola", bio:"Alessandro Antine Nivola (born June 28, 1972) is an American actor, perhaps best known for his roles in the films Best Laid Plans, Jurassic Park III, Face/Off, and the first two films of the Goal! trilogy...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jeTachWiSokMd0eDvzgfVzb2He0.jpg", url:"https://themoviedb.org/person/4941"}}, {tmdbId:"53246", properties:{bornIn:"London - England - UK", imdbId:"0758485", born:date('1962-04-24'), name:"Jason Salkey", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qetZBxDlZA6102rvQhHqAGTMUZx.jpg", url:"https://themoviedb.org/person/53246"}}, {tmdbId:"105229", properties:{imdbId:"0604822", name:"Lara Morgan", url:"https://themoviedb.org/person/105229"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"93154", properties:{imdbId:"0393878", name:"Dave Hoover", url:"https://themoviedb.org/person/93154"}}, {tmdbId:"93155", properties:{imdbId:"0579193", name:"George Mendonça", url:"https://themoviedb.org/person/93155"}}, {tmdbId:"93156", properties:{imdbId:"0579088", name:"Raymond A. Mendez", url:"https://themoviedb.org/person/93156"}}, {tmdbId:"93157", properties:{bornIn:"Adelaide, South Australia, Australia", imdbId:"0112227", born:date('1954-12-30'), name:"Rodney Brooks", bio:"From Wikipedia, the free encyclopedia\n\nRodney Allen Brooks (born December 30, 1954, in Adelaide, Australia) is a professor of robotics at Massachusetts Institute of Technology.  Since 1986 he has authored a series of highly influential papers which have inaugurated a fundamental shift in artificial intelligence research.  Outside the scientific community Brooks is also known for his appearance in a film featuring him and his work, Fast, Cheap, and Out of Control...", url:"https://themoviedb.org/person/93157"}}, {tmdbId:"18145", properties:{imdbId:"0014606", born:date('1983-10-05'), name:"Luke Aikman", url:"https://themoviedb.org/person/18145"}}, {tmdbId:"1567499", properties:{imdbId:"0345291", name:"Bea Guard", url:"https://themoviedb.org/person/1567499"}}, {tmdbId:"174982", properties:{bornIn:" London, England, UK", imdbId:"0669345", born:date('1959-04-27'), name:"Neil Pearson", bio:"Neil Pearson is an English stage, screen and television actor...", url:"https://themoviedb.org/person/174982"}}, {tmdbId:"18031", properties:{bornIn:"Bristol, England, UK", imdbId:"0312587", born:date('1967-01-02'), name:"Ruth Gemmell", url:"https://themoviedb.org/person/18031"}}, {tmdbId:"19838", properties:{bornIn:"Fremont, Nebraska, USA", imdbId:"0001339", born:date('1958-11-16'), name:"Marg Helgenberger", bio:"Mary Marg Helgenberger (born November 16, 1958, height 5' 6\" (1,68 m)) is an American film and television actress, perhaps best known for her roles as Catherine Willows in the CBS drama CSI: Crime Scene Investigation, and as K. C.  Koloski in the ABC drama China Beach, which earned her the 1990 Emmy Award for Outstanding Supporting Actress in a Drama Series. \n\nDescription above from the Wikipedia article Marg Helgenberger, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gqQEW204as3r5MkSbiZp8hKniaH.jpg", url:"https://themoviedb.org/person/19838"}}, {tmdbId:"1957", properties:{bornIn:"Paris - France", imdbId:"0000521", born:date('1966-11-17'), name:"Sophie Marceau", bio:"Sophie Marceau (French: [sɔfi maʁso]) born Sophie Danièle Sylvie Maupu, is a French actress, director, screenwriter, and author.  As a teenager, Marceau achieved popularity with her debut films La Boum (1980) and La Boum 2 (1982), receiving a César Award for Most Promising Actress. \n\nIn February 1980, Marceau and her mother came across a model agency looking for teenagers.  Marceau had photos taken at the agency, but did not think anything would come of it...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ggYd5jtI9mNB0VRY05EeY8fN2nX.jpg", url:"https://themoviedb.org/person/1957"}}, {tmdbId:"137602", properties:{imdbId:"0067665", name:"Dominique Belcourt", url:"https://themoviedb.org/person/137602"}}, {tmdbId:"115874", properties:{bornIn:"New York City - New York - USA", imdbId:"0326988", born:date('1962-01-01'), name:"Carlos Gómez", bio:"Carlos Gomez's career spans over twenty years in film, television and theatre.  The award winning actor was one of the leads of the A&amp;E series \"The Glades\".  Garnering critical praise prior to its launch, The Glades became the most watched original drama series telecast in A&amp;E network history.  Carlos also received a 2011 Imagen Award for best supporting actor in a television series for the show...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4uCM3Y4QS2uaRJBYf7Yi67VvPHl.jpg", url:"https://themoviedb.org/person/115874"}}, {tmdbId:"83209", properties:{imdbId:"0077692", name:"Vincent Berry", url:"https://themoviedb.org/person/83209"}}, {tmdbId:"13633", properties:{bornIn:"Tang Hall, York, North Yorksire, England, UK", imdbId:"0004692", born:date('1964-01-14'), name:"Mark Addy", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4ao6jitEAxmQDlJheEOKT8lhJI8.jpg", url:"https://themoviedb.org/person/13633"}}, {tmdbId:"57628", properties:{bornIn:"Sheffield, South Yorkshire, England, UK", imdbId:"0810890", born:date('1985-04-17'), name:"William Snape", bio:"William Snape is an English actor.  He played Nathan Schofield in the British comedy The Full Monty...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/b0hc5WIcNXulGvNPMxx4bDyBjy5.jpg", url:"https://themoviedb.org/person/57628"}}, {tmdbId:"57629", properties:{bornIn:"Leeds, West Yorkshire, UK", imdbId:"0401269", born:date('1963-12-10'), name:"Steve Huison", bio:"Born in Leeds, Steve Huison is a British actor of TV, theatre and film.  He is best known for playing Lomper in the 1997 hit movie The Full Monty and for playing Eddie Windass in Coronation Street.  He appeared in the Ken Loach film the Navigators and the Mike Leigh film Peterloo, and starred in Victoria Wood's sitcom Dinnerladies.  He is the co-founder of the Shoestring Theatre Company and an artist who exhibits regularly...", url:"https://themoviedb.org/person/57629"}}, {tmdbId:"19123", properties:{bornIn:"Hamburg, Germany", imdbId:"0521443", born:date('1960-11-15'), name:"Susanne Lothar", bio:"From Wikipedia, the free encyclopedia\n\nSusanne Lothar (15 November 1960 – 21 July 2012) was a German film, television and stage actress...", died:date('2012-07-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/51CyaN2rUTqvIiidOdOGvAyEGk6.jpg", url:"https://themoviedb.org/person/19123"}}, {tmdbId:"18490", properties:{bornIn:"Magdeburg", imdbId:"0317385", born:date('1971-11-23'), name:"Frank Giering", died:date('2010-06-23'), url:"https://themoviedb.org/person/18490"}}, {tmdbId:"11626", properties:{bornIn:"West Point, New York, USA", imdbId:"0000683", born:date('1925-10-03'), name:"Gore Vidal", bio:"Gore Vidal (born October 3, 1925) is an American author, playwright, essayist, screenwriter, and liberal political activist.  Early in his career he wrote The City and the Pillar (1948), which outraged mainstream critics as one of the first major American novels to feature unambiguous homosexuality.  He also ran for political office twice and served as a longtime political critic...", died:date('2012-07-31'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vHIIjpltpM9StRYmjjM7liAObuZ.jpg", url:"https://themoviedb.org/person/11626"}}, {tmdbId:"19159", properties:{bornIn:"Yolo, California, US", imdbId:"0002006", born:date('1960-06-17'), name:"Thomas Haden Church", bio:"Thomas Haden Church (born Thomas Richard McMillen; June 17, 1960) is an American actor.  After co-starring in the 1990s sitcom Wings, Church became well known for his film roles, including his Academy Award-nominated performance in Sideways and his role as the Sandman in Spider-Man 3...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/74NK9HCYvNafMggSp1PAK5Nwkpe.jpg", url:"https://themoviedb.org/person/19159"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"67805", properties:{imdbId:"0824317", name:"Claudia Stedelin", url:"https://themoviedb.org/person/67805"}}, {tmdbId:"1348957", properties:{bornIn:"North Carolina - USA", imdbId:"4122775", born:date('1995-04-10'), name:"Ian Nelson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sO5c4rLCKZiSHHWjsfikNwCck8g.jpg", url:"https://themoviedb.org/person/1348957"}}, {tmdbId:"7134", properties:{bornIn:"East Boston, Massachusetts, USA", imdbId:"0385805", born:date('1962-04-12'), name:"Brent Hinkley", bio:"​From Wikipedia, the free encyclopedia. \n\nBrent Hinkley  (born April 12, 1962) is an American actor.  He is best known for his role as \"Lou\" the sidler in the Seinfeld episode The Merv Griffin Show, and Officer Murray in The Silence of the Lambs...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o7vmerVxCynNszBFgxJjwOS99NY.jpg", url:"https://themoviedb.org/person/7134"}}, {tmdbId:"59645", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0005239", born:date('1978-08-25'), name:"Kel Mitchell", bio:"Kel Johari Rice Mitchell (born August 25, 1978) is an American actor, comedian, dancer,  musician, writer, and producer.  He is best known for his work as a  regular cast member of the Nickelodeon sketch comedy series All That...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gK2fSb3JCWAQ54hLCFWwzDiyHqj.jpg", url:"https://themoviedb.org/person/59645"}}, {tmdbId:"77330", properties:{bornIn:"Atlanta, Georgia, USA", imdbId:"0860380", born:date('1978-05-10'), name:"Kenan Thompson", bio:"From Wikipedia, the free encyclopedia. \n\nKenan Thompson (born May 10, 1978) is an American actor and comedian.  He is best known for his work as a cast member of NBC's long-running sketch comedy series Saturday Night Live.  He is also known for his starring roles in the films Good Burger and Fat Albert, his portrayal of Kenan Rockmore on the Nickelodeon sitcom Kenan & Kel, and as a cast member of the Nickelodeon sketch comedy series All That.  He ranks at #88 on VH1's 100 Greatest Teen Stars...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/As3n7ZdAoUnaB39Jl19eJBZOPbl.jpg", url:"https://themoviedb.org/person/77330"}}, {tmdbId:"5587", properties:{bornIn:"Queens, New York, USA", imdbId:"0000279", born:date('1964-04-25'), name:"Hank Azaria", bio:"Hank Azaria  (born April 25, 1964) is an American film, television and stage actor, director and comedian.  He is noted for being one of the principal voice actors on The Simpsons...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uON3TWSySIy8wbDhkSzmFTDM6XO.jpg", url:"https://themoviedb.org/person/5587"}}, {tmdbId:"83050", properties:{imdbId:"0786580", name:"Jacob Sewell", url:"https://themoviedb.org/person/83050"}}, {tmdbId:"1420962", properties:{imdbId:"4037995", name:"Nick Sutton", url:"https://themoviedb.org/person/1420962"}}, {tmdbId:"1038661", properties:{imdbId:"0721758", name:"Jacob Reynolds", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zyhqlnG7KfPR9MRw1ptkjXzNd0R.jpg", url:"https://themoviedb.org/person/1038661"}}, {tmdbId:"57345", properties:{bornIn:"Rome, Italy", imdbId:"0309348", born:date('1965-02-24'), name:"Alessandro Gassman", bio:"From Wikipedia, the free encyclopedia. \n\nAlessandro Gassman (born February 24, 1965) is an Italian actor. \n\nBorn in Rome, he is the son of actors Vittorio Gassman and Juliette Mayniel...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3zss1TgmQZU0GSUGDGMbmfWS2e6.jpg", url:"https://themoviedb.org/person/57345"}}, {tmdbId:"78711", properties:{bornIn:"Rome, Italy", imdbId:"0195017", born:date('1963-04-21'), name:"Francesca d'Aloja", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vU3CX29gHeQNbxtCxX5xIMCbQ33.jpg", url:"https://themoviedb.org/person/78711"}}, {tmdbId:"96975", properties:{imdbId:"0258905", born:date('1946-09-08'), name:"Halil Ergün", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Mul4ypT2wnARLV1pw8E8OPHPhI.jpg", url:"https://themoviedb.org/person/96975"}}, {tmdbId:"13255", properties:{imdbId:"0457229", born:date('1960-12-29'), name:"Kayoko Kishimoto", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2GjZuRXETjPNdrRo1DOzgtnQ76E.jpg", url:"https://themoviedb.org/person/13255"}}, {tmdbId:"137029", properties:{bornIn:"Komatsushima, Tokushima, Japan", imdbId:"0652592", born:date('1951-09-27'), name:"Ren Ôsugi", bio:"Actor...", died:date('2018-02-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AtITnpwCJXRxaO0K2kKcDYeef7o.jpg", url:"https://themoviedb.org/person/137029"}}, {tmdbId:"4990", properties:{bornIn:"Tokyo, Japan", imdbId:"0855398", born:date('1963-11-12'), name:"Susumu Terajima", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ls7hOjfFjOOTow7x0IP4GhcCeJf.jpg", url:"https://themoviedb.org/person/4990"}}, {tmdbId:"4492", properties:{bornIn:"Toledo, Ohio, USA", imdbId:"0001311", born:date('1931-09-10'), name:"Philip Baker Hall", bio:"Philip Baker Hall (born September 10, 1931) is an American actor.  In film, Hall has portrayed the lead roles of President Richard Nixon in Robert Altman's Secret Honor (1984), Arthur Pratt in Duck (2005), and Sydney in Paul Thomas Anderson's Hard Eight (1996), later collaborating with Anderson on Boogie Nights (1997) and Magnolia (1999).  He is also known for his portrayal of Lieutenant Bookman, Library Cop on Seinfeld...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7ENTBA0FocF26BW20h2Edo9H2GB.jpg", url:"https://themoviedb.org/person/4492"}}, {tmdbId:"10746", properties:{bornIn:"London, England, UK", imdbId:"0658244", born:date('1927-06-04'), name:"Geoffrey Palmer", bio:"From Wikipedia, the free encyclopedia.  Geoffrey Dyson Palmer, OBE (born 4 June 1927) is an English actor, best known for his roles in sitcoms such as Butterflies and As Time Goes By. \n\nDescription above from the Wikipedia article Geoffrey Palmer , licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4J07KAFl30lNmxT2lMbeY1aiJIP.jpg", url:"https://themoviedb.org/person/10746"}}, {tmdbId:"20903", properties:{bornIn:"South Pasadena, California, USA", imdbId:"0005079", born:date('1979-02-08'), name:"Josh Keaton", url:"https://themoviedb.org/person/20903"}}, {tmdbId:"45566", properties:{bornIn:"Norwalk, Connecticut, USA", imdbId:"0058372", born:date('1962-09-29'), name:"Roger Bart", bio:"Roger Bart was born on September 29, 1962 in.  He is an actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cliL3nZpi0di8wkNK9VBznd99lg.jpg", url:"https://themoviedb.org/person/45566"}}, {tmdbId:"53573", properties:{bornIn:"Rybnik - Slaskie - Poland", imdbId:"0472762", born:date('1955-08-31'), name:"Olek Krupa", bio:"Aleksander Krupa, often credited as Olek Krupa, born August 31, 1955, is a Polish actor best known for playing villains and/or criminals, such as in Blue Streak and Home Alone 3.  He also notably portrayed a Serb general engaged in genocide against Bosnian Muslims in 2001's Behind Enemy Lines. \n\nOn television he appears in many Law &amp; Order episodes...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jTVCCZCm16aZeUCXnoSd4EldfyN.jpg", url:"https://themoviedb.org/person/53573"}}] AS row
