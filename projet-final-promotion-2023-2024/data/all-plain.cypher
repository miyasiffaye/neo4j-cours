UNWIND [{tmdbId:"1380221", properties:{imdbId:"1088971", name:"Kaila Amariah", url:"https://themoviedb.org/person/1380221"}}, {tmdbId:"35456", properties:{bornIn:"San Diego, California, USA", imdbId:"0846903", born:date('1979-05-27'), name:"Marissa Tait", bio:"From Wikipedia, the free encyclopedia. \n\nMarissa Tait (b.  May 27, 1979 in San Diego, CA) is an American actress. \n\nDescription above from the Wikipedia article Marissa Tait, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/35456"}}, {tmdbId:"1031377", properties:{bornIn:"New Port Richey, Pasco County, Florida, USA", imdbId:"1092434", born:date('1985-06-11'), name:"Chris Trousdale", bio:"Chris Trousdale (June 11, 1985 - June 2, 2020) was an American actor and singer.  He was a member of the boy band Dream Street along with Jesse McCartney, Frankie Galasso, Greg Raposo and Matt Ballinger...", died:date('2020-06-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sbKNKV85MbdnuM6lM2LXhDRtouD.jpg", url:"https://themoviedb.org/person/1031377"}}, {tmdbId:"154000", properties:{bornIn:"New York City, New York, USA", imdbId:"0040591", born:date('1972-02-07'), name:"Essence Atkins", bio:"Essence Uhura Atkins (born February 7, 1972) is an American actress.  She is best known for the roles of Dee Dee Thorne on the UPN sitcom Half & Half and as Yvette Henderson on the The WB sitcom Smart Guy.  She is currently starring in the TV series Are We There Yet? as Suzanne Kingston-Persons...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5cBdIVRJmy7IntOk3E3yyqGk2fJ.jpg", url:"https://themoviedb.org/person/154000"}}, {tmdbId:"5294", properties:{bornIn:"Forest Gate, London, UK", imdbId:"0252230", born:date('1977-07-10'), name:"Chiwetel Ejiofor", bio:"Chiwetelu Umeadi \"Chiwetel\" Ejiofor was born on 10 July 1977 in Forest Gate, London.  He attended London Academy of Music and Dramatic Art, but had to leave after a year after receiving the roll of Ens, in Steven Spielberg's historical drama, \"Amistad\".  For his first leading film role in Dirty Pretty Things, he won a British Independent Film Award for best actor.  He has portrayed Othello in numerous stage productions including Bloomsbury Theatre, Theatre Royal in Glasgow and Donmar Warehouse...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kq5DDnqqofoRI0t6ddtRlsJnNPT.jpg", url:"https://themoviedb.org/person/5294"}}, {tmdbId:"2598", properties:{bornIn:"London, England, UK", imdbId:"0645683", born:date('1969-01-01'), name:"Sophie Okonedo", bio:"Sophie Okonedo, OBE (born 1968) is a British actress and singer, who has starred in both successful British and American productions.  In 1991, she made her acting debut in the British critically acclaimed coming-of-age drama, Young Soul Rebels.  In 2004, she gained critical acclaim for her role as Tatiana Rusesabagina, the wife of Rwandan hotel manager Paul Rusesabagina in the genocide drama film Hotel Rwanda (2004)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ws5K51bOHWwJWtOHZqxT2W5wm07.jpg", url:"https://themoviedb.org/person/2598"}}, {tmdbId:"4792", properties:{bornIn:"Schwerin, Germany", imdbId:"0765911", born:date('1956-10-23'), name:"Katrin Saß", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qvFBCUkcG9FKk9b7U9l6yFffDXp.jpg", url:"https://themoviedb.org/person/4792"}}, {tmdbId:"4793", properties:{bornIn:"Kazan, Tatar ASSR, Soviet Union", imdbId:"0451122", born:date('1975-10-01'), name:"Chulpan Khamatova", bio:"From Wikipedia, the free encyclopedia. \n\nChulpan Nailevna Khamatova (born October 1, 1975) is a Russian film, theater and TV actress of Tatar origin.  Her name, Chulpan, means \"Venus\" in Tatar. \n\nDescription above from the Wikipedia article Chulpan Khamatova, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v39VCgWnZyvtPEqgwjfmt8wgl51.jpg", url:"https://themoviedb.org/person/4793"}}, {tmdbId:"4794", properties:{bornIn:"Leipzig, Germany", imdbId:"0800314", born:date('1976-02-06'), name:"Maria Simon", url:"https://themoviedb.org/person/4794"}}, {tmdbId:"35084", properties:{bornIn:"Paris, France", imdbId:"0002776", born:date('1943-06-15'), name:"Johnny Hallyday", bio:"Jean-Philippe Léo Smet (15 June 1943 – 5 December 2017), better known by his stage name Johnny Hallyday, was a French rock and roll and pop singer and actor, credited for having brought rock and roll to France...", died:date('2017-12-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rgpaPugET3cVaIJiEj6KcqVm4Cg.jpg", url:"https://themoviedb.org/person/35084"}}, {tmdbId:"6304", properties:{bornIn:"Lons-le-Saunier, Jura, France", imdbId:"0836681", born:date('1944-04-23'), name:"Jean-François Stévenin", bio:"Jean-François Stévenin (born 23 April 1944) is a French actor and filmmaker.  He has appeared in 150 films and television shows since 1968.  He starred in the film Cold Moon, which was entered into the 1991 Cannes Film Festival. \n\nSource: Article \"Jean-François Stévenin\" from Wikipedia in english, licensed under CC-BY-SA 3. 0...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4NjAxLYSPlIqOkxJruq5njTUmpX.jpg", url:"https://themoviedb.org/person/6304"}}, {tmdbId:"1543580", properties:{imdbId:"0625226", name:"Charlie Nelson", url:"https://themoviedb.org/person/1543580"}}, {tmdbId:"69119", properties:{imdbId:"0616068", born:date('1978-06-21'), name:"Garikayi Mutambirwa", url:"https://themoviedb.org/person/69119"}}, {tmdbId:"69120", properties:{bornIn:"St. Louis, Missouri, USA", imdbId:"0626069", born:date('1978-11-19'), name:"Eric Nenninger", bio:"From Wikipedia, the free encyclopedia\n\nEric John Nenninger (born November 19, 1978) is an American actor, best known for playing Scott Braddock in the 2003 horror film, Jeepers Creepers II and for his recurring role as Cadet Eric Hanson on Malcolm in the Middle. \n\nDescription above from the Wikipedia article Eric Nenninger, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dmHei3ZqHxkWlssKouHShx5dhAb.jpg", url:"https://themoviedb.org/person/69120"}}, {tmdbId:"69681", properties:{bornIn:"Montauban, Tarn-et-Garonne, France", imdbId:"0479721", born:date('1936-08-27'), name:"Philippe Labro", bio:"Philippe Labro (born 27 August 1936) is a French author, journalist and film director.  He has worked for RTL, Paris Match, TF1 and Antenne 2.  He is a laureate of the Prix Interallié, a French literary distinction founded in 1930, which was awarded for «L'Étudiant étranger» in 1986. \n\nAt the age of eighteen, he left France to study at Washington and Lee University in Virginia.  He then travelled across the United States.  On his return to Europe, he became a reporter...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/snuf9J6LrVHMLD4iIIwMFHufyD4.jpg", url:"https://themoviedb.org/person/69681"}}, {tmdbId:"557854", properties:{bornIn:"Tehran, Iran", imdbId:"1178113", born:date('1974-09-22'), name:"Mania Akbari", bio:"From Wikipedia, the free encyclopedia. \n\nMania Akbari is an Iranian film director.  Akbari began her artistic career as a painter in 1991.  She entered the world of cinema as a director of photography and later as an assistant director of documentaries.  In 2002, she starred in Abbas Kiarostami’s Ten and in 2003 co-directed the documentary Crystal.  In 2005 she wrote, directed and starred in her first feature film, 20 Fingers, winner of a prize at the Venice Film Festival digital film competition...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/y2JIRdJOxefTmpIU2Ax7zJkX9hv.jpg", url:"https://themoviedb.org/person/557854"}}, {tmdbId:"557856", properties:{imdbId:"1179606", name:"Amin Maher", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ra5MjbK2fXbOTwaS0YjwJyo7jfN.jpg", url:"https://themoviedb.org/person/557856"}}, {tmdbId:"557857", properties:{imdbId:"1332962", name:"Kamran Adl", url:"https://themoviedb.org/person/557857"}}, {tmdbId:"1413759", properties:{imdbId:"2948264", name:"Roya Akbari", url:"https://themoviedb.org/person/1413759"}}, {tmdbId:"3908", properties:{bornIn:"Minneapolis, Minnesota, USA", imdbId:"0219301", born:date('1979-10-22'), name:"Tony Denman", url:"https://themoviedb.org/person/3908"}}] AS row
