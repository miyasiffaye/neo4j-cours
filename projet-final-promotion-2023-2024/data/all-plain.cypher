UNWIND [{tmdbId:"1353780", properties:{imdbId:"5364484", name:"András Sütö", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6sOZVl5kELti2nsomYNVGxBrQcV.jpg", url:"https://themoviedb.org/person/1353780"}}, {tmdbId:"1353781", properties:{imdbId:"3944077", name:"Ádám Varga", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jA2Mjegwn3UbONEEziDePNwW45Q.jpg", url:"https://themoviedb.org/person/1353781"}}, {tmdbId:"6082", properties:{bornIn:"Berlin, Germany", imdbId:"0773308", born:date('1985-05-25'), name:"Sebastian Urzendowsky", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/giM7sUkKMjSLtAE6PXlFAHIJrLw.jpg", url:"https://themoviedb.org/person/6082"}}, {tmdbId:"89640", properties:{imdbId:"0127102", name:"Enikö Börcsök", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zbqVGiZT4P2Ez4PxJDFsxZgRuc6.jpg", url:"https://themoviedb.org/person/89640"}}, {tmdbId:"1215525", properties:{bornIn:"Omaha, Nebraska, USA", imdbId:"1138983", born:date('1973-04-28'), name:"Jorge Garcia", bio:"From Wikipedia, the free encyclopedia\n\nJorge García (born April 28, 1973, height 5' 11½\" (1,82 m)) is an American actor and comedian.  He first came to public attention with his performance as Hector Lopez on the television show Becker and later for his portrayal of Hugo \"Hurley\" Reyes in the television series Lost.  Garcia also performs as a stand-up comedian.  He most recently starred in the FOX television series Alcatraz, as well as playing a minor character on ABC's Once Upon a Time...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fcAzP3fCI2sOV8APKe0KFmG66uB.jpg", url:"https://themoviedb.org/person/1215525"}}, {tmdbId:"7175", properties:{bornIn:"Memphis, Tennessee, USA", imdbId:"0291349", born:date('1942-03-25'), name:"Aretha Franklin", died:date('2018-08-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6s14FO3kFARyC5arHqgnhwwSYvA.jpg", url:"https://themoviedb.org/person/7175"}}, {tmdbId:"59270", properties:{bornIn:"Andria, Italy", imdbId:"1249052", born:date('1979-11-13'), name:"Riccardo Scamarcio", bio:"Riccardo Scamarcio is an Italian film actor and film producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zWGhuQtWgEL5WPfBCbCxqV2rTCG.jpg", url:"https://themoviedb.org/person/59270"}}, {tmdbId:"1774436", properties:{name:"Vanessa Wasche", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/upN58hbIEu1hnkY2YTa8Y8dXIQo.jpg", url:"https://themoviedb.org/person/1774436"}}, {tmdbId:"155574", properties:{bornIn:"Taylor County, Texas, USA", imdbId:"0334027", born:date('1970-02-08'), name:"Enid Graham", url:"https://themoviedb.org/person/155574"}}, {tmdbId:"973998", properties:{imdbId:"3425494", name:"Ursula Parker", bio:"She is a prodigious violinist; played Carnegie Hall at age 8.  Speaks fluent Slovenian.  Her mother is from Slovenia...", url:"https://themoviedb.org/person/973998"}}, {tmdbId:"1193593", properties:{imdbId:"4706451", name:"Sarah Sokolovic", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gUkc4Y1SYsMPfRsNaHJtEDozW87.jpg", url:"https://themoviedb.org/person/1193593"}}, {tmdbId:"3284", properties:{bornIn:"Freehold, New Jersey, USA", imdbId:"0819803", born:date('1949-09-23'), name:"Bruce Springsteen", bio:"Bruce Springsteen released his first album in 1973, but it was his second album, The Wild, The Innocent & The E Street Shuffle in 1974 that led a rock critic to call him \"the future of rock'n'roll. \" A year later Springsteen released Born to Run to critical and popular success, and he was a bona fide rock star, nicknamed \"The Boss. \" In the '80s he released The River to huge success, and his 1984 album, Born in the U. S. A. \n\n was on top of the charts for seven weeks...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qGBUdCAIu6WBfihbIK6r6KuGmqB.jpg", url:"https://themoviedb.org/person/3284"}}, {tmdbId:"1045526", properties:{bornIn:"Rotterdam, Zuid-Holland, Netherlands", imdbId:"4142492", born:date('1987-02-08'), name:"Hannah Hoekstra", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e9z9VmHFguKylKj4Hlq9rjqNeEp.jpg", url:"https://themoviedb.org/person/1045526"}}, {tmdbId:"1310504", properties:{imdbId:"5534085", name:"Kelly Byrne", bio:"Kelly Byrne is an Irish actress making waves internationally for her role in \"The Canal\" by award winning director Ivan Kavanagh.  She has also appeared in Donal Foreman's \"Out of Here\" and most recently in Darren Thornton's \"A Date for Mad Mary\".  In 2010 Kelly Studied at The Gaeity School of Acting.  In 2011 she was invited by director Kirsten Sheridan into the Actors Studio at Bow Street (Formerly The Factory)...", url:"https://themoviedb.org/person/1310504"}}, {tmdbId:"1446320", properties:{bornIn:"San Mateo, California, USA", imdbId:"1051295", born:date('1993-10-19'), name:"Hunter King", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lFACjapH3WvCrUSUlhEJZZxkbxA.jpg", url:"https://themoviedb.org/person/1446320"}}, {tmdbId:"1013973", properties:{bornIn:"Locarno, Switzerland", imdbId:"3231562", born:date('1985-01-02'), name:"Carla Juri", bio:"Carla Juri was born January 2nd, 1985 in Locarno, Switzerland.  She is an actress known most for Blade Runner 2049 (2017), Wetlands (2013), Brimstone (2016) and When Hitler Stole Pink Rabbit (2019)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7Tu9PCmTyLD1wWP8PGCzZpuImre.jpg", url:"https://themoviedb.org/person/1013973"}}, {tmdbId:"231628", properties:{bornIn:"Halle, Germany", imdbId:"2556155", born:date('1982-06-16'), name:"Christoph Letkowski", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d3fKuPTNTxT1tpUHQGPVWK0SBU7.jpg", url:"https://themoviedb.org/person/231628"}}, {tmdbId:"1298767", properties:{imdbId:"4170693", born:date('1990-01-01'), name:"Marlen Kruse", url:"https://themoviedb.org/person/1298767"}}, {tmdbId:"223012", properties:{imdbId:"2172460", name:"Jayson Blair", url:"https://themoviedb.org/person/223012"}}, {tmdbId:"2684800", properties:{name:"Macarena Hernández", url:"https://themoviedb.org/person/2684800"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"240003", properties:{imdbId:"0729008", name:"Robert Rivard", url:"https://themoviedb.org/person/240003"}}, {tmdbId:"133067", properties:{imdbId:"2282835", name:"Slaine", url:"https://themoviedb.org/person/133067"}}, {tmdbId:"13939", properties:{bornIn:"Londres, Angleterre, Royaume-Uni", imdbId:"0182662", born:date('1967-07-01'), name:"Ritchie Coster", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kYXTkSP5fbgM1kBrYlqOwI8vrlJ.jpg", url:"https://themoviedb.org/person/13939"}}, {tmdbId:"1320011", properties:{imdbId:"5778843", name:"John Hargrove", url:"https://themoviedb.org/person/1320011"}}, {tmdbId:"1194603", properties:{imdbId:"5747281", name:"Samantha Berg", url:"https://themoviedb.org/person/1194603"}}, {tmdbId:"1320012", properties:{imdbId:"6054613", name:"Mark Simmons", url:"https://themoviedb.org/person/1320012"}}, {tmdbId:"1938691", properties:{name:"Danny Mahoney", url:"https://themoviedb.org/person/1938691"}}, {tmdbId:"71586", properties:{bornIn:"Hammersmith, London, England, UK", imdbId:"0654295", born:date('1986-09-12'), name:"Alfie Allen", bio:"Alfie Allen was born in Hammersmith, London.  His older sister is singer Lily Allen.  Allen's first professional appearance was in a one-off Channel 4 comedy, You Are Here in 1998.  The same year, Allen and his sister Lily appeared in the 1998 film, Elizabeth, which was produced by their mother.  His early work included small roles in Agent Cody Banks 2: Destination London, Atonement and BBC1's historical hospital drama, Casualty 1907...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1N6NPuSHUYdiwRbSTVbaEOrFIk.jpg", url:"https://themoviedb.org/person/71586"}}, {tmdbId:"1192218", properties:{bornIn:"Oxford, Oxfordshire, England, UK", imdbId:"4148205", born:date('1993-04-19'), name:"Sebastian De Souza", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aueQZSQghquLSZ4qjRQPO4GGAMS.jpg", url:"https://themoviedb.org/person/1192218"}}, {tmdbId:"1312526", properties:{imdbId:"4942550", name:"Andrew Leung", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hXK4gUIooj3SpQ2qwEN9JLV0B7d.jpg", url:"https://themoviedb.org/person/1312526"}}, {tmdbId:"147884", properties:{bornIn:"Helensburgh, Dumbartonshire, Scotland, UK", imdbId:"1410360", born:date('1981-09-01'), name:"Morven Christie", bio:"Morven Christie (born 1 September 1981) is a Scottish actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fTlG9uWyaiQt9UATyPYswjo9EGh.jpg", url:"https://themoviedb.org/person/147884"}}, {tmdbId:"1099876", properties:{imdbId:"2196179", name:"Kenny Chin", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i2Msjdl4nkZ6GGBagHg3opxb33f.jpg", url:"https://themoviedb.org/person/1099876"}}, {tmdbId:"1502376", properties:{imdbId:"3691128", name:"Jamahl Garrison-Lowe", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iXGOZvgPxr6FXnKZgwD2ZehGKLR.jpg", url:"https://themoviedb.org/person/1502376"}}, {tmdbId:"1475236", properties:{imdbId:"0318353", name:"Gilly Gilchrist", url:"https://themoviedb.org/person/1475236"}}, {tmdbId:"1312122", properties:{imdbId:"5520750", name:"Frederick Schmidt", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uJbO9kaUJEdE3wlX8XUAf9bIVEe.jpg", url:"https://themoviedb.org/person/1312122"}}, {tmdbId:"1869489", properties:{name:"Edna Caskey", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/g0RFzeUxzhnCgjNKCi10KXSKXuw.jpg", url:"https://themoviedb.org/person/1869489"}}, {tmdbId:"1394670", properties:{bornIn:"Jacksonville, Florida, USA", imdbId:"5518972", born:date('1995-03-20'), name:"RJ Cyler", bio:"Ronald \"RJ\" Cyler II (born March 21, 1995) is an American actor.  He is best known for his roles in Me and Earl and the Dying Girl, Power Rangers, I'm Dying Up Here and Scream...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9baPsx4DJn2vy7AOfcfEe6IH5JN.jpg", url:"https://themoviedb.org/person/1394670"}}, {tmdbId:"59450", properties:{bornIn:"Pensacola, Florida, USA", imdbId:"1737500", born:date('1981-03-30'), name:"Katy Mixon", bio:"Katy Elizabeth Mixon (born March 30, 1981) is an American actress.  She is best known for her role as April Buchanon on HBO's Eastbound & Down...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9XNOI61of8l9mGehe8wrHTTArXF.jpg", url:"https://themoviedb.org/person/59450"}}, {tmdbId:"129104", properties:{bornIn:"Houston, Texas, USA", imdbId:"2552034", born:date('1988-10-04'), name:"Melissa Benoist", bio:"Melissa Benoist is an American actress and singer, known for her portrayal of \"Marley Rose\" on Glee and the title role in Supergirl.  Furthermore, she has appeared in a number of television series, including Homeland, The Good Wife and Law & Order. \n\nMelissa's first film was in singer Mariah Carey's Tennessee (2008)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ypC15woTlwz87q6Ri4FaEzzGqMV.jpg", url:"https://themoviedb.org/person/129104"}}, {tmdbId:"1159982", properties:{bornIn:"Manhattan, New York, USA", imdbId:"5052065", born:date('1994-03-14'), name:"Ansel Elgort", bio:"Ansel Elgort (born March 14, 1994) is an American actor, singer and a DJ (under the name Ansølo).  As a film actor, he is known for playing Tommy Ross in Carrie (2013), Caleb Prior in The Divergent Series (2014), Augustus Waters in The Fault in Our Stars (2014), and Baby in Baby Driver (2017)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ynceZwoR41V4FBiElUpgG5aFi9i.jpg", url:"https://themoviedb.org/person/1159982"}}] AS row
