UNWIND [{tmdbId:"138561", properties:{imdbId:"0397520", name:"Nicola Howard", url:"https://themoviedb.org/person/138561"}}, {tmdbId:"138562", properties:{imdbId:"0333802", name:"Sasha Graff", url:"https://themoviedb.org/person/138562"}}, {tmdbId:"120418", properties:{imdbId:"0514944", name:"Jackson Liu", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fJ0YFg2H475vw1ODkqokZ42MKV7.jpg", url:"https://themoviedb.org/person/120418"}}, {tmdbId:"120419", properties:{bornIn:"Taiwan", imdbId:"0938925", born:date('1978-08-21'), name:"Annie Wu", url:"https://themoviedb.org/person/120419"}}, {tmdbId:"23679", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"0921942", born:date('1952-04-16'), name:"Billy West", bio:"William Richard \"Billy\" West (born April 16, 1950) is an American voice actor.  He launched his career in the early 1980s performing daily comedic routines on Boston's WBCN (TOP Rock station of the time) shortly after moving on to do the revival of Beany and Cecil and was also a castmember on the Howard Stern's radio show during the early to mid 1990s. \n\nWest is best known for his voice-work on Ren & Stimpy, Doug and Futurama.  His favorite characters are Philip J...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iNQtBsgV4wr3z5CEEFhR5U4Yedk.jpg", url:"https://themoviedb.org/person/23679"}}, {tmdbId:"15234", properties:{bornIn:"Winchester, Virginia, USA", imdbId:"0000274", born:date('1971-09-08'), name:"David Arquette", bio:"From Wikipedia, the free encyclopedia. \n\nDavid Arquette (born September 8, 1971) is an American actor, film director, producer, screenwriter, fashion designer, and occasional professional wrestler.  A member of the Arquette acting family, he first became known during the late 1990s after starring in several Hollywood films, including the Scream series.  He has since had several television roles, including playing \"Jason Ventress\" on ABC's In Case of Emergency...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/74wJjoywG7zCrNMWbRxwoyOj7Ub.jpg", url:"https://themoviedb.org/person/15234"}}, {tmdbId:"161285", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0258353", born:date('1938-10-01'), name:"Tony Epper", died:date('2012-07-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bIFX8XhlrDdO5vhr9selbFD5cz5.jpg", url:"https://themoviedb.org/person/161285"}}, {tmdbId:"46456", properties:{imdbId:"0255958", name:"Ingeborg Elzevier", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e4wltD0ADgA7uQWd5eaSesFW0vy.jpg", url:"https://themoviedb.org/person/46456"}}, {tmdbId:"46457", properties:{imdbId:"0255398", name:"Khaldoun Elmecky", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c2esRhzEqW4ImUWQSI5vTAPbnWN.jpg", url:"https://themoviedb.org/person/46457"}}, {tmdbId:"46458", properties:{bornIn:"Leeuwarden, Friesland, Netherlands", imdbId:"0198723", born:date('1963-09-01'), name:"Margo Dames", bio:"Margo Dames is a Dutch actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/r8842XVRCH2nFM5ijUeK5b2BA2M.jpg", url:"https://themoviedb.org/person/46458"}}, {tmdbId:"30430", properties:{bornIn:"Bath, Somerset, England, UK", imdbId:"0890055", born:date('1973-09-27'), name:"Indira Varma", bio:"Indira Anne Varma is an English stage and screen actress.  She was a member of Musical Youth Theatre Company and graduated from the Royal Academy of Dramatic Art (RADA) in London, in 1995.  Her film debut and first major role was in Kama Sutra: A Tale of Love.  She has gone on to appear in the television series The Canterbury Tales, Rome, Luther, Human Target, and Game of Thrones (as Ellaria Sand)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ei228xVTeujz3H4k4lZiYMx2LRw.jpg", url:"https://themoviedb.org/person/30430"}}, {tmdbId:"178622", properties:{imdbId:"0863130", born:date('1967-05-16'), name:"Ramon Tikaram", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wtBLiI8tzeqPLMB9uswkyFhChva.jpg", url:"https://themoviedb.org/person/178622"}}, {tmdbId:"5471", properties:{bornIn:"London, England, UK", imdbId:"0004710", born:date('1969-01-17'), name:"Naveen Andrews", bio:"Naveen Andrews (born January 17, 1969) is a British actor.  He is best known for The English Patient and Lost...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tVAQ4dP9rRosjHZBLNVlfAGVE66.jpg", url:"https://themoviedb.org/person/5471"}}, {tmdbId:"71871", properties:{bornIn:"Moscow, RSFSR, USSR", imdbId:"0091074", born:date('1971-12-27'), name:"Sergey Bodrov Jr.", bio:"Actor, director, screenwriter, TV presenter, art historian.  Born in the family of writer, screenwriter and director Sergei Bodrov Sr.  In 1993 he graduated from the History Department of Moscow State University (Department of Art History).  In 1998 he defended his thesis on \"Architecture in the Venetian Renaissance painting. \" In 1996-1999 he was the presenter of the program “Vzglyad” (ORT).  In 2001, as a presenter, he took part in the \"Last Hero\" program on Channel One...", died:date('2002-09-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8nPsE3lhfFeKqqGGmcf42jLlSOl.jpg", url:"https://themoviedb.org/person/71871"}}, {tmdbId:"223410", properties:{imdbId:"0797703", name:"Jemal Sikharulidze", url:"https://themoviedb.org/person/223410"}}, {tmdbId:"223411", properties:{imdbId:"0577277", name:"Susanna Mekhraliyeva", url:"https://themoviedb.org/person/223411"}}, {tmdbId:"35806", properties:{bornIn:"Newark, New Jersey", imdbId:"0641944", born:date('1972-03-06'), name:"Shaquille O'Neal", bio:"Shaquille Rashaun O'Neal ( born March 6, 1972), nicknamed \"Shaq\" , is an American professional basketball player for the NBA's Boston Celtics.  Standing 7 ft 1 in (2. 16 m) tall and weighing 325 pounds (147 kg), he is one of the heaviest players ever to play in the NBA.  Throughout his 18-year career, O'Neal has used his size and strength to overpower opponents for points and rebounds.  After the retirement of Lindsey Hunter on March 5, 2010, O'Neal became the oldest active player in the NBA...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lSl3ZH4BHKrDoEZNIksPw87zaSb.jpg", url:"https://themoviedb.org/person/35806"}}, {tmdbId:"69671", properties:{imdbId:"0009806", name:"James Acheson", url:"https://themoviedb.org/person/69671"}}, {tmdbId:"59662", properties:{bornIn:"Washington D.C., USA", imdbId:"0324790", born:date('1963-07-22'), name:"Joanna Going", bio:"From Wikipedia, the free encyclopedia. \n\nJoanna C.  Going (born 22 July 1963) is an American actress.  Born in Washington, D. C. , she was the oldest of six children of Lorraine M.  (née Calise), a police dispatcher, and John Burke Going, a state assemblyman and lawyer.  Raised in Newport, Rhode Island she graduated from Rogers High School in 1981, then attended Emerson College for two years before studying at the American Academy of Dramatic Arts...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cqYMJFlkkAc2n1FTGaOmom4IFFL.jpg", url:"https://themoviedb.org/person/59662"}}, {tmdbId:"58955", properties:{bornIn:"Montreal, Quebec, Canada", imdbId:"0567852", born:date('1961-05-16'), name:"Kevin McDonald", bio:"Kevin McDonald is a Canadian film and television actor and comedian...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d3hNodXpZtkWZuix2Vox7ebUlR3.jpg", url:"https://themoviedb.org/person/58955"}}] AS row
