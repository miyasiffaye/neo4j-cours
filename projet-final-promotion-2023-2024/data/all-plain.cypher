n:"Tortosa, Tarragona Province, Catalonia, Spain", imdbId:"1564103", born:date('1977-11-03'), name:"Belén Fabra", bio:"Belén Fabra Homedes is a Spanish actress.  She made her breakthrough with the 2007 play Plataforma, for which she was nominated for the Premios Max and the Valle-Inclán de Teatro Award.  She is fluent in Catalan, Spanish and English and she can speak Italian.  Belén was nominated for the Gaudí Award for Best Performance by an Actress in a Leading Role for her role in the notorious 2008 erotic film \"Diario de una ninfómana\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jMpbVLPzbniRx6GBHz3CMdEGEIl.jpg", url:"https://themoviedb.org/person/81160"}}, {tmdbId:"15592", properties:{imdbId:"1414974", born:date('1968-11-30'), name:"Llum Barrera", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lyIlsIC7kAXPab70OjsvuxaFqEX.jpg", url:"https://themoviedb.org/person/15592"}}, {tmdbId:"74278", properties:{bornIn:"Toronto, Ontario,  Canada", imdbId:"0172220", name:"K.C. Collins", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gzCsWz2xf3cMvGxR0VByW8hAr3c.jpg", url:"https://themoviedb.org/person/74278"}}, {tmdbId:"78066", properties:{imdbId:"2849572", name:"Jerry Bo Yu Chen", url:"https://themoviedb.org/person/78066"}}, {tmdbId:"78065", properties:{imdbId:"2848497", name:"Campbell Ping He", url:"https://themoviedb.org/person/78065"}}, {tmdbId:"78067", properties:{imdbId:"2849718", name:"Cindy Shui Yu", url:"https://themoviedb.org/person/78067"}}] AS row
