UNWIND [{tmdbId:"236435", properties:{bornIn:"Montevideo, Uruguay", imdbId:"0854803", name:"Jorge Temponi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zOHrjzvSE88nUQXKrdnqGzAd2dK.jpg", url:"https://themoviedb.org/person/236435"}}, {tmdbId:"236436", properties:{imdbId:"0869004", name:"Alfonso Tort", url:"https://themoviedb.org/person/236436"}}, {tmdbId:"1867437", properties:{name:"Valentín Rivero", url:"https://themoviedb.org/person/1867437"}}, {tmdbId:"34716", properties:{imdbId:"0318383", name:"Allan Gildea", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/y1OugLExUbcP3oyKZNPUywzXELq.jpg", url:"https://themoviedb.org/person/34716"}}, {tmdbId:"34717", properties:{imdbId:"0189302", name:"Gerard Crossan", url:"https://themoviedb.org/person/34717"}}, {tmdbId:"34718", properties:{imdbId:"1073366", name:"Mary Moulds", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4KDoIoWQXElyZgam3e8Cqpy42wK.jpg", url:"https://themoviedb.org/person/34718"}}, {tmdbId:"70815", properties:{imdbId:"0165881", name:"Emma Cleasby", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8lNwiJSUUR1rP5DCSlNbi9jUlH.jpg", url:"https://themoviedb.org/person/70815"}}, {tmdbId:"38809", properties:{imdbId:"0751950", born:date('1976-09-20'), name:"Camilla Rutherford", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rVoFC3VLv5JWsBN0mlyTLrF1Zg5.jpg", url:"https://themoviedb.org/person/38809"}}, {tmdbId:"16756", properties:{bornIn:"Scarborough, Yorkshire, England, UK", imdbId:"0592993", born:date('1973-01-01'), name:"Jimi Mistry", bio:"From Wikipedia, the free encyclopedia. \n\nJimi Mistry (born 1 January 1973) is a British actor. \n\nDescription above from the Wikipedia article Jimi Mistry, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/16756"}}, {tmdbId:"19923", properties:{bornIn:"London, England", imdbId:"0095017", born:date('1963-11-10'), name:"Hugh Bonneville", bio:"Hugh Richard Bonneville Williams  is an English stage, film, television and radio actor.  He was born in Paddington in west London in 1963. \n\nHe was educated at Dulwich College Preparatory School in south-east London and at Sherborne School in Dorset.  After reading  theology at Corpus Christi College, Cambridge, he studied acting at the Webber Douglas Academy of Dramatic Art in London...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7JhrWtkyrmrUQnAAwXKZbnY9nYl.jpg", url:"https://themoviedb.org/person/19923"}}, {tmdbId:"16855", properties:{bornIn:"Nashua, New Hampshire, USA", imdbId:"0601553", born:date('1984-04-10'), name:"Mandy Moore", bio:"Amanda Leigh \"Mandy\" Moore (born April 10, 1984) is an American singer-songwriter, actress and fashion designer.  Moore became famous as a teenager in the late 1990s, after the release of her teen pop albums So Real, I Wanna Be with You, and Mandy Moore.  In 2007, she took an adult pop-folk direction with the release of Wild Hope.  Her most recent album, Amanda Leigh, was released on May 26, 2009.  Moore has sold more than 10 million records worldwide...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1Z5yJ6FUsEtlVZzpyzOpfzvcpcm.jpg", url:"https://themoviedb.org/person/16855"}}, {tmdbId:"21658", properties:{bornIn:"Kochi, Japan", imdbId:"0386414", born:date('1980-07-18'), name:"Ryôko Hirosue", bio:"​From Wikipedia, the free encyclopedia.   \n\nRyōko Hirosue (born July 18, 1980) is a Japanese actress and pop star, best known in the West for her roles in the Luc Besson-produced Wasabi and the Academy Award-winning Japanese film Departures.  She also starred in a comedy series Yasuko to Kenji in 2008. \n\nDescription above from the Wikipedia article Ryōko Hirosue , licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/r8cFZwZzmoM0vYgFrmDJpKDKyDx.jpg", url:"https://themoviedb.org/person/21658"}}, {tmdbId:"1753", properties:{bornIn:"Robbins, Illinois, USA", imdbId:"0629667", born:date('1932-12-28'), name:"Nichelle Nichols", bio:"​From Wikipedia, the free encyclopedia.     Nichelle Nichols (born Grace Nichols; December 28, 1932) is an American actress, singer and voice artist.  She sang with Duke Ellington and Lionel Hampton before turning to acting.  Her most famous role is that of communications officer Lieutenant Uhura aboard the USS Enterprise in the popular Star Trek television series, as well as the succeeding motion pictures, where her character was eventually promoted in Starfleet to the rank of commander...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2HwNfe1fXMXOSzKgGOEXmhmhC0n.jpg", url:"https://themoviedb.org/person/1753"}}, {tmdbId:"58681", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0431520", born:date('1954-06-12'), name:"Ella Joyce", bio:"​From Wikipedia, the free encyclopedia.     Ella Joyce (born June 12, 1954) is an American actress. Joyce's television credits include the pilot for NewsRadio, and series regular \"Eleanor Emerson\" on Roc as well as the recurring role of \"Jasmine\" on My Wife &amp; Kids. \n\nShe has received numerous awards, nominations, and accolades for her performances in the theater, including the New York AUDELCO and the NAACP Image Nomination (for theater and television)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3Girvka7ngB282f93IyUZ5H261J.jpg", url:"https://themoviedb.org/person/58681"}}, {tmdbId:"143582", properties:{imdbId:"1201807", name:"Jack Angstreich", url:"https://themoviedb.org/person/143582"}}, {tmdbId:"143583", properties:{imdbId:"1202234", name:"Eric Chadbourne", url:"https://themoviedb.org/person/143583"}}, {tmdbId:"143584", properties:{imdbId:"1202887", name:"Bill Heidbreder", url:"https://themoviedb.org/person/143584"}}, {tmdbId:"143585", properties:{imdbId:"1205330", name:"Roberta Hill", url:"https://themoviedb.org/person/143585"}}, {tmdbId:"47334", properties:{bornIn:"Tbilisi, Georgia", imdbId:"0474333", born:date('1983-08-08'), name:"Nutsa Kukhianidze", bio:"Nutsa Kukhianidze was born on August 8, 1983 in Tbilisi, USSR.  She is an actress and writer, known for The Good Thief (2002), Gaseirneba Karabaghshi (2005) and Tbilisuri Love Story (2009).  She has been married to Guka Rcheulishvili since July 17, 2005.  They have one child...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pWFLb4qnoDcWebpXt5hwaj6lqw8.jpg", url:"https://themoviedb.org/person/47334"}}, {tmdbId:"47335", properties:{imdbId:"0256075", born:date('1981-01-01'), name:"Ouassini Embarek", url:"https://themoviedb.org/person/47335"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"47336", properties:{bornIn:"Longjumeau - France", imdbId:"0492200", born:date('1962-08-06'), name:"Marc Lavoine", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8kL2Xqoe31Ys4ls1E9QI5sjdhV6.jpg", url:"https://themoviedb.org/person/47336"}}, {tmdbId:"71535", properties:{bornIn:"Overland Park, Kansas, USA", imdbId:"0437454", born:date('1962-04-15'), name:"Tom Kane", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sq49aVP56G50Nr5kCL7Ove6Z9jE.jpg", url:"https://themoviedb.org/person/71535"}}, {tmdbId:"66744", properties:{bornIn:"Manassas, Virginia, USA", imdbId:"1015096", born:date('1972-08-20'), name:"Chaney Kley", bio:"From Wikipedia, the free encyclopedia. \n\nChaney Kley (August 20, 1972 – July 24, 2007) was an American film and television actor. \n\nDescription above from the Wikipedia article Chaney Kley, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2007-07-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5XSCZAgi1BUZrLp7eDyIxT46w01.jpg", url:"https://themoviedb.org/person/66744"}}, {tmdbId:"66745", properties:{bornIn:"San Diego, California, U.S.", imdbId:"0146536", born:date('1973-04-08'), name:"Emma Caulfield", bio:"From Wikipedia, the free encyclopedia. \n\nEmma Caulfield (born April 8, 1973) is an American actress best known for her role as ex-demon Anya Jenkins on the television series Buffy the Vampire Slayer, as well as Susan Keats, a love interest of Brandon Walsh's on the television series Beverly Hills, 90210.  She currently plays Sasha on Gigantic. \n\nDescription above from the Wikipedia article Emma Caulfield, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tYQURD5pl4iGHjyA2yVwmmhaoPt.jpg", url:"https://themoviedb.org/person/66745"}}, {tmdbId:"38660", properties:{bornIn:"Melbourne, Australia", imdbId:"1064987", name:"Lee Cormie", bio:"From Wikipedia, the free encyclopedia. \n\nLee Cormie (born 8 February 1992) is an Australian actor in Melbourne, Australia mostly known for his starring roles in number 1 US Box Office hit Darkness Falls and Australian film December Boys alongside Daniel Radcliffe.   Description above from the Wikipedia article Christian Lee Cormie, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/64oIDigP4MF6UxikjpPMUxGiKMi.jpg", url:"https://themoviedb.org/person/38660"}}, {tmdbId:"66746", properties:{imdbId:"0685221", name:"Grant Piro", bio:"From Wikipedia, the free encyclopedia. \n\nGrant Piro is an Australian actor.  He is best known as the host of the children's television show Couch Potato on the Australian Broadcasting Corporation. \n\nDescription above from the Wikipedia article Grant Piro, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1iE3YeZnUHRXlbKr1oI4cq6bcVJ.jpg", url:"https://themoviedb.org/person/66746"}}, {tmdbId:"71198", properties:{bornIn:"Dallas, Texas", imdbId:"0437283", born:date('1974-06-27'), name:"Christian Kane", bio:"Christian Kane is an American actor and singer/songwriter of Native American descent.  He currently stars as Eliot Spencer on the TNT series Leverage.  He is best known for his roles in the television shows Angel and Into the West, and the movies Just Married and Secondhand Lions. \n\nHe is the lead singer of the country-southern rock band Kane; their album, The House Rules, was released on December 7, 2010...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bHQDqGBW2yCEsHlNMkmJpQA9lDr.jpg", url:"https://themoviedb.org/person/71198"}}, {tmdbId:"41043", properties:{bornIn:"Cheadle Hulme, Cheshire, England, UK", imdbId:"0570570", born:date('1956-09-18'), name:"Tim McInnerny", bio:"From Wikipedia, the free encyclopedia.   Tim McInnerny ( born 18 September 1956) is an English actor.  He is known for his role as Percy in Blackadder and Blackadder II, and as Captain Darling in Blackadder Goes Forth; he did not reprise his role as Percy in Blackadder the Third due to a fear of being typecast...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nOLjLixEDo1xFhBmAfRLMKwB9Fv.jpg", url:"https://themoviedb.org/person/41043"}}, {tmdbId:"2049783", properties:{imdbId:"1290364", name:"Tom Watson", url:"https://themoviedb.org/person/2049783"}}, {tmdbId:"42545", properties:{bornIn:"Long Island, New York, USA", imdbId:"0000465", born:date('1953-03-12'), name:"Ron Jeremy", bio:"An American pornographic actor.  Nicknamed \"The Hedgehog\", he was ranked by AVN at number one in their \"The 50 Top Porn Stars of All Time\" list.  Jeremy has also appeared in non-pornographic films, such as The Boondock Saints, The Chase, Orgazmo, and 54.  He is noted for his 9. 75-inch (~24. 75 cm) penis (self-reported) —and he has gained some notoriety for being capable of autofellatio (which he first demonstrated on-screen in Inside Seka)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p13HTvxofm4GJNx13eeTQk2EXfm.jpg", url:"https://themoviedb.org/person/42545"}}, {tmdbId:"104953", properties:{bornIn:"Washington, D.C., USA", imdbId:"0546735", born:date('1943-10-02'), name:"William Margold", bio:"William \"Bill\" Margold was an American pornographic film actor and porn film director.  Margold was a former director of the Free Speech Coalition and was a co-founder of X-Rated Critics Organization (XRCO) and Fans of X-Rated Entertainment (FOXE).  He was the founder of PAW Foundation, the charity for the welfare of pornography industry performers. [2] He was also a member of the AVN Hall of Fame.  He was at one time married to the 1980s porn film actress Drea...", died:date('2017-01-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pIgjXULx5l968K6MYANtLMPJQtO.jpg", url:"https://themoviedb.org/person/104953"}}, {tmdbId:"98331", properties:{imdbId:"0326155", name:"Al Goldstein", url:"https://themoviedb.org/person/98331"}}, {tmdbId:"99825", properties:{bornIn:"New York City, New York, USA", imdbId:"0506891", born:date('1923-04-30'), name:"Al Lewis", bio:"An American character actor best known for his role as Count Dracula lookalike \"Grandpa\", opposite Fred Gwynne's and Yvonne De Carlo's characters on the CBS television series The Munsters from 1964 to 1966 and its subsequent film versions.  Later in life, he was also a restaurant owner, political candidate, and radio broadcaster.   His acting career begins the well-documented portion of his life...", died:date('2006-02-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gZhCDtWYOZz8EF0wOIZM2HZTONe.jpg", url:"https://themoviedb.org/person/99825"}}, {tmdbId:"556531", properties:{imdbId:"2003038", name:"Moishe Bar Am", url:"https://themoviedb.org/person/556531"}}, {tmdbId:"556532", properties:{imdbId:"2029440", name:"Sanabel Hassan", url:"https://themoviedb.org/person/556532"}}, {tmdbId:"21711", properties:{bornIn:"Seattle, Washington, USA", imdbId:"0159776", born:date('1982-08-19'), name:"Erika Christensen", bio:"Erika Jane Christensen (born August 19, 1982) is an American actress whose film appearances include Traffic (2000), Swimfan (2002), How to Rob a Bank (2007), and The Perfect Score (2004), among others.  She also co-starred in the short-lived drama Six Degrees on ABC.  She is currently co-starring in the 2010 television series Parenthood as Julia Braverman-Graham...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2QQJgrGVe3Fr8x7y50dBpN2g9lS.jpg", url:"https://themoviedb.org/person/21711"}}, {tmdbId:"50346", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0032375", born:date('1978-12-07'), name:"Shiri Appleby", bio:"Shiri Freda Appleby (born December 7, 1978) is an American film and television actress.  She is best known for her leading role as Liz Parker in the television series Roswell.  Her film credits include A Time for Dancing, where she was one of the two female main characters; Swimfan; Havoc with Anne Hathaway; and Charlie Wilson's War with Tom Hanks and Julia Roberts...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nvH09LMnA8vBmmxHBmf79MtKHsc.jpg", url:"https://themoviedb.org/person/50346"}}, {tmdbId:"61111", properties:{imdbId:"0836964", born:date('1972-12-10'), name:"Tara Subkoff", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tGV6s8CtewhWmSkFKeQtIluWWov.jpg", url:"https://themoviedb.org/person/61111"}}, {tmdbId:"73700", properties:{imdbId:"0385076", born:date('1974-12-13'), name:"Richard Hillman", died:date('2009-06-27'), url:"https://themoviedb.org/person/73700"}}, {tmdbId:"4247", properties:{imdbId:"0510814", born:date('1980-01-31'), name:"Tiffany Limos", url:"https://themoviedb.org/person/4247"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"6279", properties:{bornIn:"Houston, Texas, USA", imdbId:"0088127", born:date('1981-09-16'), name:"Alexis Bledel", bio:"Alexis Bledel (born September 16, 1981) is an American actress and fashion model.  She is known for her roles as Rory Gilmore in the television series Gilmore Girls and Lena Kaligaris in The Sisterhood of the Traveling Pants and The Sisterhood of the Traveling Pants 2. \n\nDescription above from the Wikipedia article Alexis Bledel, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xsg2WLtKhLDF4DX5uyEAMNaM7bG.jpg", url:"https://themoviedb.org/person/6279"}}, {tmdbId:"53493", properties:{bornIn:" Montclair, New Jersey, USA", imdbId:"0671980", born:date('1977-04-23'), name:"Kal Penn", bio:"Kal Penn (born April 23, 1977) is an American actor, known for the TV show House and the Harold and Kumar comedy films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yICM1JcxKbEpaqTUreY0yFMIc8W.jpg", url:"https://themoviedb.org/person/53493"}}, {tmdbId:"33457", properties:{bornIn:"Teaneck, New Jersey, U.S.", imdbId:"0032628", born:date('1957-03-20'), name:"Amy Aquino", bio:"Amy Aquino (born March 20, 1957) is an American television, film, and stage actress.  The graduate of Harvard and Yale universities has appeared in television series such as Brooklyn Bridge, ER, and Being Human, and was nominated for a Screen Actors Guild Award for her role in Picket Fences.  She was co-Secretary/Treasurer of the SAG-AFTRA until August 2015 and currently stars in Amazon Studios' television series Bosch as Lt.  Grace Billets...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3mvn3aSTWYPcQeZ7KxGknpzFV4S.jpg", url:"https://themoviedb.org/person/33457"}}, {tmdbId:"21722", properties:{bornIn:"Media - Pennsylvania - USA", imdbId:"0082517", born:date('1960-05-20'), name:"John Billingsley", bio:"From Wikipedia, the free encyclopedia. \n\nJohn Billingsley (born May 20, 1960, height 5' 9½\" (1,77 m)) is an American actor, known for his role as Doctor Phlox on the television series Star Trek: Enterprise. \n\nJohn Billingsley was born in Media, Pennsylvania, and subsequently lived in Huntsville, Alabama and Slidell, Louisiana before his family settled in Weston, Connecticut. \n\nBillingsley is married to fellow actor Bonita Friedericy...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uQzAvv4LUt57GBrYzDj5Ao1vhUT.jpg", url:"https://themoviedb.org/person/21722"}}, {tmdbId:"84521", properties:{imdbId:"0090481", name:"Elisa Bocanegra", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nNf88dj04dZPIHMlL40rXm3ZbwK.jpg", url:"https://themoviedb.org/person/84521"}}, {tmdbId:"99945", properties:{imdbId:"1241513", name:"Ike Ogut", url:"https://themoviedb.org/person/99945"}}, {tmdbId:"99946", properties:{bornIn:"India", imdbId:"0969891", born:date('1973-01-01'), name:"Nelofer Pazira", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ep50AdRnNiaIP4s1BE6ayFHmOpZ.jpg", url:"https://themoviedb.org/person/99946"}}, {tmdbId:"99956", properties:{imdbId:"0970321", name:"Hassan Tantai", url:"https://themoviedb.org/person/99956"}}, {tmdbId:"99958", properties:{imdbId:"0970343", name:"Sadou Teymouri", url:"https://themoviedb.org/person/99958"}}, {tmdbId:"54621", properties:{bornIn:"Zagreb, Croatia", imdbId:"0084484", born:date('1972-03-02'), name:"Rene Bitorajac", bio:"Rene Bitorajac is a Croatian actor...", url:"https://themoviedb.org/person/54621"}}, {tmdbId:"54622", properties:{bornIn:"Zagreb, Croatia, Yugoslavia (now Zagreb, Croatia)", imdbId:"0816297", born:date('1966-09-13'), name:"Filip Sovagovic", bio:"Filip Šovagović (born September 13, 1966 in Zagreb, SR Croatia, SFR Yugoslavia) is a Croatian actor, playwright and journalist.  At first known simply as the son of renowned Croatian actor Fabijan Šovagović borned in Ladimirevci, Filip Šovagović has appeared in many films and TV shows in the last decade and a half, gradually building a reputation of his own.  His films include No Man's Land, Oscar winner, and in 2005 he made his directorial début with the film Pušća Bistra...", url:"https://themoviedb.org/person/54622"}}, {tmdbId:"54623", properties:{bornIn:"Brussels, Belgium", imdbId:"0796207", born:date('1963-03-07'), name:"Georges Siatidis", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4rY0awV2NSZ2CcOdSU2fnsCBolp.jpg", url:"https://themoviedb.org/person/54623"}}, {tmdbId:"73836", properties:{bornIn:"Halifax - Nova Scotia - Canada", imdbId:"0716438", born:date('1977-01-01'), name:"Laura Regan", bio:"From Wikipedia, the free encyclopedia. \n\nLaura Regan (born 1977) is a Canadian actress known for her role as Jessica Lynch in the TV movie Saving Jessica Lynch...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qSAiOH8nilxzjCqOHMc6HU32kxK.jpg", url:"https://themoviedb.org/person/73836"}}, {tmdbId:"46772", properties:{bornIn:"Butler, Pennsylvania, USA", imdbId:"0089456", born:date('1972-01-11'), name:"Marc Blucas", bio:"Marcus Paul Blucas is an American actor, known for playing Riley Finn in Buffy the Vampire Slayer, Matthew Donnelly in Necessary Roughness and abolitionist John Hawkes in Underground.  Prior to his acting career, he was known for playing college basketball with the Wake Forest Demon Deacons. \n\nBlucas' first television role was in the television movie Inflammable, made in 1995.  From there, he found roles in both television and film...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/24gXjSJzM15GN197gruKah6HM3f.jpg", url:"https://themoviedb.org/person/46772"}}, {tmdbId:"52776", properties:{bornIn:"Kielce, Swietokrzyskie, Poland", imdbId:"0231436", born:date('1976-07-17'), name:"Dagmara Dominczyk", bio:"From Wikipedia, the free encyclopedia. \n\nDagmara Domińczyk (born July 17, 1976) is a Polish American actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lxQclVBcr5JqRwHKCWP4L092JG.jpg", url:"https://themoviedb.org/person/52776"}}, {tmdbId:"17497", properties:{bornIn:"Paris, France", imdbId:"0244151", born:date('1974-05-28'), name:"Romain Duris", bio:"Romain Duris (born 28 May 1974) is a French actor.  Romain Duris is most famous for his role as the French exchange student Xavier Rousseau in The Spanish Apartment and The Russian Dolls.  He has a reputation for versatility, having played a thug in The Beat That My Heart Skipped...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2pFMVxyKbVkULNWqXbqFb3TV7zK.jpg", url:"https://themoviedb.org/person/17497"}}, {tmdbId:"17522", properties:{bornIn:"Namur, Belgium", imdbId:"0208426", born:date('1975-07-17'), name:"Cécile De France", bio:"​Belgian actress Cécile de France began her acting career in French cinema hits such as “L'Art (délicat) de la séduction” (2001) and “Irène” (2002) after being discovered by the agent Dominique Besnehard.  Her international breakthrough came with the horror thriller “Haute Tension” (2003), which was a worldwide success.  She caught the eye of Hollywood producers and soon landed her first major role in a US feature film, “Around the World in 80 Days” (2004)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8nzL3XON3VfUevvP2KvYbnbF5sT.jpg", url:"https://themoviedb.org/person/17522"}}, {tmdbId:"19363", properties:{bornIn:"Genève, Suisse", imdbId:"0721469", born:date('1957-02-12'), name:"Dominique Reymond", bio:"Elève au Conservatoire de Genève, Dominique Reymond a ensuite pour professeur à Chaillot Antoine Vitez.  Cette grande actrice de théâtre -qui travaille avec Sobel, Grüber ou encore Lassalle- fait sa première apparition à l'écran en 1984 dans Pinot simple flic, puis on l'aperçoit chez Dupeyron, Chabrol et Garrel (La Naissance de l'amour en 1993)...", url:"https://themoviedb.org/person/19363"}}, {tmdbId:"46074", properties:{bornIn:"Worthington, Ohio, USA", imdbId:"0006713", born:date('1968-01-12'), name:"Rachael Harris", bio:"Rachael Elaine Harris (born January 12, 1968) is an American actress and comedian.  She is known for her numerous television roles, such as starring as Dr.  Linda Martin on Lucifer and as a guest star on TV shows such as Sister, Sister, Reno 911!, New Girl, Suits and The Good Wife. \n\nDescription above from the Wikipedia article Rachael Harris, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/39RYYTxxHaJKDXFTabjAPH8z5r6.jpg", url:"https://themoviedb.org/person/46074"}}, {tmdbId:"46075", properties:{imdbId:"0267424", name:"Zaid Farid", url:"https://themoviedb.org/person/46075"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"76961", properties:{bornIn:"Mexico City, Distrito Federal, Mexico", imdbId:"0065007", born:date('1963-08-01'), name:"Demián Bichir", bio:"Demián Bichir Nájera (August 1, 1963, height 5' 10\" (1,78 m)) is a Mexican actor.  Both of his parents, Alejandro Bichir and Maricruz Nájera, and brothers Odiseo and Bruno Bichir are actors.  He was married to singer Lisset Gutiérrez. \n\nHe started his acting career at the age of 14 in the telenovela Rina with Ofelia Medina.  His second acting role was as an adult in Vivir enamorada both telenovelas were during his years with Televisa...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sw8TqPQLbMMgLbkNNUIW649THWJ.jpg", url:"https://themoviedb.org/person/76961"}}, {tmdbId:"2601738", properties:{name:"Ashley L. Anderson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qTvIiAONIs6kDdsnxc6lM1ytsxC.jpg", url:"https://themoviedb.org/person/2601738"}}, {tmdbId:"6736", properties:{bornIn:"Ladysmith, British Columbia, Canada", imdbId:"0000097", born:date('1967-07-01'), name:"Pamela Anderson", bio:"Pamela Denise Anderson (born July 1, 1967) is a Canadian-American actress, model, producer, author, activist, and former showgirl, known for her roles on the television series Home Improvement, Baywatch, and V. I. P.  She was chosen as a Playmate of the Month for Playboy magazine in February 1990. [1] For a time, she was known as Pamela Anderson Lee (or Pamela Lee) after marrying Mötley Crüe drummer Tommy Lee.  She maintains dual American and Canadian citizenship...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/acBYqqwr2P66Zn2VhWMeq5w03GL.jpg", url:"https://themoviedb.org/person/6736"}}, {tmdbId:"1231217", properties:{bornIn:" Dallas, Texas, U.S.", imdbId:"1026272", born:date('1977-03-12'), name:"Camille Anderson", url:"https://themoviedb.org/person/1231217"}}, {tmdbId:"6730", properties:{bornIn:"Hammersmith, London, England, UK", imdbId:"0056187", born:date('1971-10-13'), name:"Sacha Baron Cohen", bio:"Sacha Noam Baron Cohen (born 13 October 1971) is a British comedian, actor, and writer.  He is most widely known for his portrayal of three unorthodox fictional characters, Ali G, Borat, and Brüno.  In his routines, Baron Cohen's characters interact with unsuspecting people who do not realize they are being set up for comic situations and self-revealing ridicule...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jcCDoJfk1KgrVcID94gjgfrmZH2.jpg", url:"https://themoviedb.org/person/6730"}}, {tmdbId:"53257", properties:{bornIn:"San Antonio, Texas, USA", imdbId:"0729256", born:date('1961-02-24'), name:"Emilio Rivera", bio:"Emilio Rivera  (born February 24, 1961) is an American film and television actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/brtL6uF2cWCN3LhQYWymHPdTY88.jpg", url:"https://themoviedb.org/person/53257"}}, {tmdbId:"57197", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0478834", born:date('1978-01-01'), name:"Gina La Piana", bio:"Gina La Piana is a Latina actress and singer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oMNVcGZDV7RM1PkCKnNxJDO79PG.jpg", url:"https://themoviedb.org/person/57197"}}, {tmdbId:"57198", properties:{imdbId:"1169988", name:"Dana de Celis", url:"https://themoviedb.org/person/57198"}}, {tmdbId:"44208", properties:{bornIn:"Wolverhampton, Staffordshire, England, UK", imdbId:"0000911", born:date('1949-11-19'), name:"Nigel Bennett", bio:"From Wikipedia, the free encyclopedia\n\nNigel Bennett (born 19 November 1949) is an English actor/director/writer who has been based in Canada since 1986.  He is best known for playing the vampire patriarch Lucien LaCroix in the TV series Forever Knight, for which he won the Canadian Gemini Award for best supporting actor in a dramatic series. \n\nDescription above from the Wikipedia article Nigel Bennett, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gaB8nZnEbGe8lIgZtoo1ObYSUEg.jpg", url:"https://themoviedb.org/person/44208"}}, {tmdbId:"53720", properties:{bornIn:"St. John's, Newfoundland, Canada", imdbId:"0916448", name:"Timothy Webber", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mM49QpT5fwGCMPenjOIrUo1nqV8.jpg", url:"https://themoviedb.org/person/53720"}}, {tmdbId:"97299", properties:{imdbId:"0881081", name:"Natar Ungalaaq", url:"https://themoviedb.org/person/97299"}}, {tmdbId:"97300", properties:{imdbId:"0993083", name:"Sylvia Ivalu", url:"https://themoviedb.org/person/97300"}}, {tmdbId:"97301", properties:{imdbId:"0991466", name:"Peter-Henry Arnatsiaq", url:"https://themoviedb.org/person/97301"}}, {tmdbId:"97302", properties:{imdbId:"0993358", name:"Lucy Tulugarjuk", url:"https://themoviedb.org/person/97302"}}, {tmdbId:"41901", properties:{bornIn:"San Juan, Puerto Rico", imdbId:"0761052", born:date('1973-04-02'), name:"Roselyn Sanchez", bio:"Roselyn Sánchez (born April 2, 1973) is a Puerto Rican singer-songwriter, model, actress, producer and writer. \n\nShe is best known for her roles on Without a Trace and Devious Maids.  In film, Sánchez has appeared in Rush Hour 2, Boat Trip, The Game Plan, and Act of Valor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/t1xPA67A2VoQwjEC43hmOzEKNP3.jpg", url:"https://themoviedb.org/person/41901"}}, {tmdbId:"5937", properties:{bornIn:"Spalding - Saskatchewan - Canada", imdbId:"0558182", born:date('1970-03-25'), name:"Kari Matchett", bio:"From Wikipedia, the free encyclopedia. \n\nKari Matchett (born March 25, 1970 height 5' 6\" (1,68 m)) is a Canadian television and film actress.  She played Mariel Underlay in Invasion, Lisa Miller in 24, and Kate Filmore in the cult favorite science fiction movie Cube 2: Hypercube.  She currently appears in the USA television series Covert Affairs...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n3XMEVkAH2QsUHEoDvs0kAlFz08.jpg", url:"https://themoviedb.org/person/5937"}}, {tmdbId:"5938", properties:{bornIn:"Swansea, Wales, UK", imdbId:"0943870", born:date('1957-04-20'), name:"Geraint Wyn Davies", bio:"From Wikipedia, the free encyclopedia. \n\nGeraint Wyn Davies (b.  April 20, 1957, Swansea, Wales) is a Welsh-Canadian-American actor. \n\nThe son of a Welsh Congregationalist preacher, he moved with his family to Canada from Haverfordwest at the age of seven, where he attended Upper Canada College.  His most famous role is that of vampire turned police detective Nick Knight on Forever Knight.  Previous to this role, he had also played a vampire in Dracula: The Series...", url:"https://themoviedb.org/person/5938"}}, {tmdbId:"5939", properties:{bornIn:"Ottawa, Ontario, Canada", imdbId:"0475129", born:date('1987-01-01'), name:"Grace Lynn Kung", bio:"Grace Lynn Kung is a Canadian stage and screen actress.  She graduated from the Ottawa School of Speech and Drama, Ontario, Canada...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/57LglZCKA8d2Q5kzHOiD8rykx0p.jpg", url:"https://themoviedb.org/person/5939"}}, {tmdbId:"5940", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"0272536", born:date('1973-04-03'), name:"Matthew Ferguson", bio:"From Wikipedia, the free encyclopedia. \n\nMatthew Ferguson is an actor born on 3 April 1973 in Toronto, Ontario, Canada.  He graduated from the Claude Watson School for the Performing Arts...", url:"https://themoviedb.org/person/5940"}}, {tmdbId:"179206", properties:{imdbId:"0108782", name:"Rand Bridges", url:"https://themoviedb.org/person/179206"}}] AS row
