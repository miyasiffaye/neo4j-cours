UNWIND [{tmdbId:"1817204", properties:{imdbId:"0427801", name:"Constance Jones", url:"https://themoviedb.org/person/1817204"}}, {tmdbId:"35642", properties:{bornIn:"Tokyo, Japan", imdbId:"0256861", born:date('1961-06-28'), name:"Ken'ichi Endô", bio:"Kenichi Endou (遠藤 憲一 Endō Ken'ichi, born 28 June 1961 in Tokyo) is a Japanese actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ywFJyl39dPBVkO74NsluedXpdCT.jpg", url:"https://themoviedb.org/person/35642"}}, {tmdbId:"35643", properties:{bornIn:"Nagasaki, Japan", imdbId:"0879749", born:date('1959-08-07'), name:"Shungiku Uchida", bio:"From Wikipedia, the free encyclopedia. \n\nShungicu Uchida, real name Shigeko Uchida, is a Japanese manga artist, novelist, essayist, actress, and singer...", url:"https://themoviedb.org/person/35643"}}, {tmdbId:"35644", properties:{bornIn:"Aichi Prefecture, Japan", imdbId:"0913820", born:date('1976-09-16'), name:"Kazushi Watanabe", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ay4qsYy8fF25mueYdsyQqnkB9Zx.jpg", url:"https://themoviedb.org/person/35644"}}, {tmdbId:"35645", properties:{imdbId:"1115962", name:"Jun Mutô", url:"https://themoviedb.org/person/35645"}}, {tmdbId:"2292443", properties:{name:"Anthony Albano", url:"https://themoviedb.org/person/2292443"}}, {tmdbId:"2041", properties:{bornIn:"Compton, California, USA", imdbId:"0236564", born:date('1965-02-18'), name:"Dr. Dre", bio:"Andre Romelle Young, known by his stage name Dr.  Dre, is an American rapper, record producer, record executive, entrepreneur, and actor.  He is the founder and current CEO of Aftermath Entertainment and Beats Electronics...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3wkVNoWmat6QgYZfOOpsRYZtq6s.jpg", url:"https://themoviedb.org/person/2041"}}, {tmdbId:"153952", properties:{imdbId:"0072840", born:date('1973-10-25'), name:"Lamont Bentley", died:date('2005-01-18'), url:"https://themoviedb.org/person/153952"}}, {tmdbId:"46433", properties:{bornIn:"Mount Vernon, New York, USA", imdbId:"0163863", born:date('1929-11-30'), name:"Dick Clark", bio:"From Wikipedia, the free encyclopedia.   \n\n Richard Wagstaff \"Dick\" Clark was an American game-show host, radio andtelevision personality, and businessman.  He served as chairman and chief executive officer of Dick Clark Productions, which he sold part of in recent years.  Clark is best known for hosting long-running television shows such as American Bandstand, five versions of the game show Pyramid, and Dick Clark's New Year's Rockin' Eve...", died:date('2012-04-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5b0BckJqRZIwi1LcbuA8o2KPZTZ.jpg", url:"https://themoviedb.org/person/46433"}}, {tmdbId:"1673063", properties:{bornIn:"Cleveland, Ohio, USA", imdbId:"0842171", born:date('1968-02-29'), name:"Michelle Sweeney", bio:"Michelle Sweeney is a Canadian film and television actress and soul singer...", url:"https://themoviedb.org/person/1673063"}}, {tmdbId:"96558", properties:{bornIn:"Ehime Prefecture, Japan", imdbId:"0441161", born:date('1971-12-20'), name:"Reiko Kataoka", url:"https://themoviedb.org/person/96558"}}, {tmdbId:"96559", properties:{bornIn:"Tokyo, Japan", imdbId:"0847146", born:date('1969-05-20'), name:"Kazuya Takahashi", url:"https://themoviedb.org/person/96559"}}, {tmdbId:"96560", properties:{bornIn:"Osaka, Japan", imdbId:"0015386", born:date('1957-01-18'), name:"Yôko Akino", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wHcLJ0RyGSBTrjg6c0mkkYmUEz3.jpg", url:"https://themoviedb.org/person/96560"}}, {tmdbId:"14606", properties:{bornIn:"Saint-Germain-en-Laye, Yvelines, France", imdbId:"0243355", born:date('1964-01-11'), name:"Albert Dupontel", bio:"From Wikipedia, the free encyclopedia.   Albert Dupontel (born 11 January 1964 in Saint-Germain-en-Laye, Yvelines) is a French actor and film director.  He started his career as a stand-up comedian.  In February 1998, his 1996 film Bernie took the Grand Prize at the 9th Yubari International Fantastic Film Festival which was attended by Dupontel.   Description above from the Wikipedia article Albert Dupontel, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fzW4n89UVWrF1Ep5g1hxeXL6MPd.jpg", url:"https://themoviedb.org/person/14606"}}, {tmdbId:"14610", properties:{bornIn:"Porto Empedocle (AG), Sicilia, Italia", imdbId:"0696353", born:date('1960-06-05'), name:"Jo Prestia", bio:"Jo Prestia (born 5 June 1960 in Porto Empedocle) is an Italian born French kick boxer and actor.  He appeared in more than seventy films since 1996 and is best known for his performance as Le Tenia in the controversial 2002 film, Irréversible. \n\nSource: Article \"Jo Prestia\" from Wikipedia in english, licensed under CC-BY-SA 3. 0...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/owAotRB9XMCf1LkceEl0ygWueQA.jpg", url:"https://themoviedb.org/person/14610"}}, {tmdbId:"565525", properties:{imdbId:"1028146", name:"M.L. Piyapas Bhirombhakdi", url:"https://themoviedb.org/person/565525"}}, {tmdbId:"81039", properties:{imdbId:"1033693", born:date('1960-10-17'), name:"Sarunyu Wongkrachang", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wYUe7WBUU5hdtH8ce632PEHC1wr.jpg", url:"https://themoviedb.org/person/81039"}}, {tmdbId:"227708", properties:{imdbId:"0969934", born:date('1960-01-17'), name:"Chatchai Plengpanich", url:"https://themoviedb.org/person/227708"}}, {tmdbId:"565526", properties:{imdbId:"1035342", born:date('1970-10-28'), name:"Johnny Anfone", url:"https://themoviedb.org/person/565526"}}, {tmdbId:"560229", properties:{bornIn:"Namur, Belgium", imdbId:"0547732", born:date('1986-01-01'), name:"Morgan Marinne", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bZdLa98Lut6UMrbpFJ0tFWZQlnh.jpg", url:"https://themoviedb.org/person/560229"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"45159", properties:{imdbId:"1176635", name:"Isabella Soupart", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zj3m68IQUvz9LpThg7ywGaMFWsf.jpg", url:"https://themoviedb.org/person/45159"}}, {tmdbId:"1348216", properties:{imdbId:"1237886", name:"Nassim Hassaïni", url:"https://themoviedb.org/person/1348216"}}, {tmdbId:"235332", properties:{bornIn:"Tokyo Prefecture, Japan", born:date('1936-07-12'), name:"Miyoko Shôji", url:"https://themoviedb.org/person/235332"}}, {tmdbId:"23988", properties:{bornIn:" Taito, Tokyo, Japan", imdbId:"1046347", born:date('1974-12-27'), name:"Fumiko Orikasa", bio:"Fumiko Orikasa ( born December 27, 1974 in Taito, Tokyo) is a Japanese voice actress and singer who works for Atomic Monkey.  Her record label is Geneon Entertainment.  Shopping is one of her hobbies.  She is a skilled dancer, and is referred to as \"Oririn\" by fellow voice actors and fans.  She also performed a fair number of anime insert and character image songs. \n\nDescription above from the Wikipedia article Fumiko Orikasa, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p6uWtQJRRy9sCpSWY9BYX8D7uf3.jpg", url:"https://themoviedb.org/person/23988"}}, {tmdbId:"223309", properties:{bornIn:"Fukushima Prefecture, Japan", imdbId:"0959936", born:date('1933-05-23'), name:"Shôzô Îzuka", bio:"is a Japanese voice actor from Fukushima Prefecture who is affiliated with Sigma Seven.  He graduated from the fine arts department of Nihon University. \n\nHe is most known for the roles of Hakaider (Android Kikaider), Doctor Neo Cortex (Crash Bandicoot series), 38 out of 50 Vader Monsters (Denshi Sentai Denjiman), Ryu Jose (Mobile Suit Gundam), Heart (Fist of the North Star), Happosai Ueda (Nintama Rantarou), Nappa (Dragon Ball Z) and Sergeant Bosco Albert \"B. A...", url:"https://themoviedb.org/person/223309"}}, {tmdbId:"73476", properties:{imdbId:"0064170", name:"Michael Beattie", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gDuLXdt6xXMjGOmdqoLymyra55n.jpg", url:"https://themoviedb.org/person/73476"}}, {tmdbId:"4166", properties:{bornIn:"Paris, France", imdbId:"0141140", born:date('1971-05-28'), name:"Isabelle Carré", bio:"​From Wikipedia, the free encyclopedia.   \n\nIsabelle Carré (born 28 May 1971 in Paris) is a French actress, who has appeared in more than 40 films since 1989.  She won a César Award for Best Actress for her role in Se souvenir des belles choses (2001), and has been nominated a further six times, for Beau fixe (1992), Le Hussard sur le toit (1995), La Femme défendue (1997), Les Sentiments (2003), Entre ses mains (2005) and Anna M.  (2007)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3TvLVw9PvcBlpGm8MX4epLuhtIM.jpg", url:"https://themoviedb.org/person/4166"}}, {tmdbId:"55101", properties:{bornIn:"Umbuzeiro, Paraíba, Brazil", imdbId:"0890388", born:date('1954-06-25'), name:"Luiz Carlos Vasconcelos", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/heA62KbZb1LNAsvCuNu2qmG1KrM.jpg", url:"https://themoviedb.org/person/55101"}}, {tmdbId:"42125", properties:{bornIn:"Monte Santo de Minas, Brazil", imdbId:"0328604", born:date('1933-12-09'), name:"Milton Gonçalves", bio:"Milton Gonçalves (December 9, 1933) is a Brazilian actor.  He's one of the most famous black actors in Brazil, having collaborated twice with acclaimed director Hector Babenco. \n\nGonçalves started his career in São Paulo, in an amateur group.  As he moved to a professional group, he met Augusto Boal, who was looking for an actor to play an old black man...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nmA7yNcPfYYj8TvvKFsZqRDdUaK.jpg", url:"https://themoviedb.org/person/42125"}}, {tmdbId:"55102", properties:{imdbId:"0206950", born:date('1938-07-10'), name:"Ivan de Almeida", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/frgRwQ7wzEFJCqp9G4C3xWTG4lG.jpg", url:"https://themoviedb.org/person/55102"}}, {tmdbId:"55103", properties:{bornIn:"São Paulo, São Paulo, Brazil", imdbId:"1355166", born:date('1964-09-09'), name:"Ailton Graça", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/s3ISrqMMHnb7OAho204UrLaEePI.jpg", url:"https://themoviedb.org/person/55103"}}, {tmdbId:"995641", properties:{imdbId:"1728270", name:"Velda Bontrager", url:"https://themoviedb.org/person/995641"}}, {tmdbId:"995642", properties:{imdbId:"3772765", name:"Mark Bontrager", url:"https://themoviedb.org/person/995642"}}, {tmdbId:"995643", properties:{imdbId:"3772874", name:"Dewayne Chupp", url:"https://themoviedb.org/person/995643"}}, {tmdbId:"995644", properties:{imdbId:"3772814", name:"Dylan Cole", url:"https://themoviedb.org/person/995644"}}, {tmdbId:"58155", properties:{imdbId:"1131157", name:"Yuka Imoto", url:"https://themoviedb.org/person/58155"}}, {tmdbId:"58156", properties:{imdbId:"1130970", name:"Kei Kobayashi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hlMnHB5j4mjh1bWYdV8CSMocBQC.jpg", url:"https://themoviedb.org/person/58156"}}, {tmdbId:"1968908", properties:{name:"Kôki Okada", url:"https://themoviedb.org/person/1968908"}}, {tmdbId:"58158", properties:{bornIn:"Kyoto, Kyoto Prefecture, Japan", imdbId:"0410937", born:date('1944-03-16'), name:"Tarô Ishida", bio:"Taro Ishida (March 16, 1944 - September 21, 2013) was a Japanese actor and voice actor...", died:date('2013-09-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/guDNGqfnUaCBa7tEetIWKcNAa0Y.jpg", url:"https://themoviedb.org/person/58158"}}, {tmdbId:"4730", properties:{bornIn:"New York City, New York, USA", imdbId:"0002536", born:date('1986-09-12'), name:"Emmy Rossum", bio:"An American actress and singer-songwriter.  She first starred in a string of movies including Songcatcher (2000), An American Rhapsody (2001) and Passionada (2002).  Her role in Mystic River (2003) garnered her wider fame.  She then starred in the blockbuster film The Day After Tomorrow (2004) and The Phantom of the Opera (2004) for which she was nominated for a Golden Globe.  She has since starred in Poseidon (2006), Dragonball: Evolution (2009) and Dare (2009)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aJ8bzA1WJOBFx0Ppdo1fLMiNxLh.jpg", url:"https://themoviedb.org/person/4730"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"17178", properties:{bornIn:"Norfolk, Virginia, USA", imdbId:"0933940", born:date('1973-07-03'), name:"Patrick Wilson", bio:"Patrick Joseph Wilson (born July 3, 1973) is an American actor and singer. \n\nWilson has spent years singing lead roles in major Broadway musicals, beginning in 1996.  In 2003, he appeared in the HBO mini-series Angels in America...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tc1ezEfIY8BhCy85svOUDtpBFPt.jpg", url:"https://themoviedb.org/person/17178"}}, {tmdbId:"9195", properties:{bornIn:"Shinagawa, Tokyo Prefecture, Japan", imdbId:"0760796", born:date('1960-10-12'), name:"Hiroyuki Sanada", bio:"Hiroyuki Sanada (真田 広之 Sanada Hiroyuki, born Hiroyuki Shimosawa (下澤 廣之 Shimosawa Hiroyuki); 12 October 1960) is a Japanese actor from Tokyo.  Before breaking in to the movie business, he trained at Sonny Chiba’s Japan Action Club hoping to one day become a martial arts action film star.  Sanada appeared in many action films in the 70s and early 80s, but as it became clear he was actually a talented and well-rounded actor, he was able to branch out into all different types of roles in every genre...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iQ5fRWJbwwNE6G7TMB1gLNogmq8.jpg", url:"https://themoviedb.org/person/9195"}}, {tmdbId:"31841", properties:{bornIn:"St. Louis, Missouri, USA", imdbId:"0776580", born:date('1972-07-03'), name:"Matt Schulze", bio:"Matt Schulze (born July 3, 1972) is an American actor and musician...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sLzdh6nDWn0STeoSHFFpPbtTGDQ.jpg", url:"https://themoviedb.org/person/31841"}}, {tmdbId:"65132", properties:{bornIn:"Forth Worth, Texas, USA", imdbId:"0193066", born:date('1961-09-07'), name:"Don 'D.C.' Curry", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jVWzJTT2ggOqz2RI4HqsU2F2oDX.jpg", url:"https://themoviedb.org/person/65132"}}, {tmdbId:"17736", properties:{bornIn:"The Bronx, New York, USA", imdbId:"0664238", born:date('1970-10-25'), name:"Adam Pascal", bio:"From Wikipedia, the free encyclopedia\n\nAdam Pascal (born October 25, 1970) is an American actor and singer known for his performance as Roger Davis in the original cast of Jonathan Larson's musical Rent on Broadway 1996, the 2005 movie version of the musical, and the Broadway Tour of Rent in 2009.  He is also known for originating the role of Radames in Elton John and Tim Rice's Aida and for playing the Emcee from the 1998 revival of Cabaret...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fSX3Ywl96eeuKpxiORTPgW1wuwD.jpg", url:"https://themoviedb.org/person/17736"}}, {tmdbId:"19392", properties:{bornIn:"Rocky Mount, Virginia, USA", imdbId:"0552509", born:date('1969-01-18'), name:"Jesse L. Martin", bio:"From Wikipedia, the free encyclopedia\n\nJesse Lamont Martin (born Jesse Lamont Watkins; January 18, 1969) is an American theatre, film, and television actor.  He is best known for originating the role of Tom Collins in the Broadway theatrical production of Rent, and for his portrayal of NYPD Detective Ed Green on the NBC drama television series Law &amp; Order. \n\nDescription above from the Wikipedia article Jesse L.  Martin, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/enyC1P8DQThh1huqFQlVfdRuji1.jpg", url:"https://themoviedb.org/person/19392"}}, {tmdbId:"14386", properties:{bornIn:"Houston, Texas, United States", imdbId:"0461498", born:date('1981-09-04'), name:"Beyoncé Knowles", bio:"Beyoncé Giselle Knowles-Carter (born September 4, 1981), often known simply as Beyoncé, is an American R&B and pop recording artist and actress. \n\nBorn and raised in Houston, Texas, she enrolled in various performing arts schools and was first exposed to singing and dancing competitions as a child.  Knowles rose to fame in the late 1990s as the lead singer of the R&B girl group Destiny's Child, one of the world's best-selling girl groups of all time...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9MgDCYBBVBl4lM1DuxNIIbCHlKy.jpg", url:"https://themoviedb.org/person/14386"}}, {tmdbId:"10980", properties:{bornIn:"Hammersmith, London, England, UK", imdbId:"0705356", born:date('1989-07-23'), name:"Daniel Radcliffe", bio:"Daniel Jacob Radcliffe (born 23 July 1989) is an English actor who rose to prominence playing the titular character in the Harry Potter film series.  His work on the series has earned him several awards and more than £60 million. \n\nRadcliffe made his acting debut at age ten in BBC One's television movie David Copperfield (1999), followed by his film debut in 2001's The Tailor of Panama...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/k5ROulKM24IJtv0jcRj1berhd8I.jpg", url:"https://themoviedb.org/person/10980"}}, {tmdbId:"10989", properties:{bornIn:"Harlow, Essex, England, UK", imdbId:"0342488", born:date('1988-08-24'), name:"Rupert Grint", bio:"From Wikipedia, the free encyclopedia\n\nRupert Alexander Grint (born 24 August 1988) is an English actor, who rose to prominence playing Ron Weasley, one of the three main characters in the Harry Potter film series.  Grint was cast as Ron at the age of 11, having previously acted only in school plays and at his local theatre group.  From 2001 to 2010, he starred in eight Harry Potter movies alongside Daniel Radcliffe and Emma Watson...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iFlkpTaOF6fGLqxz8b0PhI0i0zN.jpg", url:"https://themoviedb.org/person/10989"}}, {tmdbId:"10990", properties:{bornIn:"Paris, France", imdbId:"0914612", born:date('1990-04-15'), name:"Emma Watson", bio:"Emma Watson (born 15 April 1990) is an English actress who rose to prominence playing Hermione Granger, one of three starring roles in the Harry Potter film series.  Watson was cast as Hermione at the age of nine, having previously acted only in school plays.  From 2001 to 2011, she starred in eight Harry Potter films alongside Daniel Radcliffe and Rupert Grint.  Watson's work on the Harry Potter series has earned her several awards and more than £10 million...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mf0OANvWYSzU1d8yggrhyw8IbIz.jpg", url:"https://themoviedb.org/person/10990"}}, {tmdbId:"14833", properties:{bornIn:"Schenectady, New York, USA", imdbId:"0332390", born:date('1923-12-10'), name:"Harold Gould", bio:"From Wikipedia, the free encyclopedia. \n\nHarold V.  Goldstein (December 10, 1923 – September 11, 2010), best known by his stage name Harold Gould, was an American actor best known for playing Martin Morgenstern in the 1970s sitcoms Rhoda and The Mary Tyler Moore Show and as Miles Webber &amp; also as Arnie Peterson on The Golden Girls...", died:date('2010-09-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ch7LudSeUX76eiXjRbFB17dZa0k.jpg", url:"https://themoviedb.org/person/14833"}}, {tmdbId:"1225534", properties:{bornIn:"St. John's", imdbId:"0427480", born:date('1948-01-15'), name:"Andy Jones", bio:"Andrew Jordan Jones (born January 15, 1948) is a Canadian comedian, and a former member of CODCO.  Andy Jones was born in St.  John’s, Newfoundland and Labrador.  He is the brother of comedienne Cathy Jones and filmmaker Michael Jones.  Jones wrote for one season of The Kids in the Hall, and played a small role in their film Brain Candy.  Jones also starred in, co-wrote, and co-directed the 1986 feature film The Adventure of Faustus Bidgood...", url:"https://themoviedb.org/person/1225534"}}, {tmdbId:"2123019", properties:{name:"Vicky Hynes", url:"https://themoviedb.org/person/2123019"}}, {tmdbId:"20982", properties:{bornIn:"Invercargill, New Zealand", imdbId:"0190744", born:date('1966-06-30'), name:"Marton Csokas", bio:"Marton Csokas (born 30 June 1966) is a New Zealand film and television actor. \n\nDescription above from the Wikipedia article Marton Csokas, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bUO8mwJQ00ZD9wNZsNCevCZQR5L.jpg", url:"https://themoviedb.org/person/20982"}}, {tmdbId:"12470", properties:{bornIn:"Singapore", imdbId:"0837282", born:date('1974-09-11'), name:"Paulyn Sun", bio:"Paulyn Sun is a Hong Kong-based Singaporean actress.  She quit her job in business development to launch an acting career in Hong Kong.  In 1994, she represented Singapore at the Miss Universe...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4jQXsptwbZAhunpuV4MLWosFxHG.jpg", url:"https://themoviedb.org/person/12470"}}, {tmdbId:"59174", properties:{bornIn:"Los Angeles, California, USA", imdbId:"1065229", born:date('1984-04-18'), name:"America Ferrera", bio:"America Georgina Ferrera (born April 18, 1984) is a Honduran-American actress, best known for playing the lead role in the television comedy series \"Ugly Betty\".  Her portrayal garnered critical acclaim, and she won the Golden Globe Award for \"Best Actress in a Comedy Series\", the Screen Actors Guild Award for \"Best Female Actor in a Comedy Series\", and the Emmy Award for \"Outstanding Lead Actress in a Comedy Series\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eTsuQqrSvnN5VBuOroQTPPIKe9q.jpg", url:"https://themoviedb.org/person/59174"}}, {tmdbId:"192506", properties:{imdbId:"0646488", name:"Ingrid Oliu", url:"https://themoviedb.org/person/192506"}}, {tmdbId:"41798", properties:{bornIn:"Mission Hills, California, USA", imdbId:"0520064", born:date('1961-04-23'), name:"George Lopez", bio:"From Wikipedia, the free encyclopedia\n\nGeorge Lopez (born April 23, 1961) is an American comedian, actor, and talk show host.  He is mostly known for starring in his self-produced ABC sitcom George Lopez.  His stand-up comedy examines race and ethnic relations, including the Mexican American culture.  He is currently the host of the late-night talk show Lopez Tonight on TBS. \n\nDescription above from the Wikipedia article George Lopez, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vLO7JRNp3i4h9PNz97FvEqpaBsL.jpg", url:"https://themoviedb.org/person/41798"}}, {tmdbId:"105734", properties:{imdbId:"1177180", name:"Rodrigo Noya", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qYeK5vACF9ZSfqjCVEs2gRZar5w.jpg", url:"https://themoviedb.org/person/105734"}}, {tmdbId:"105736", properties:{bornIn:"Buenos Aires, Argentina", imdbId:"0136509", born:date('1977-10-21'), name:"Julieta Cardinali", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2OzcNWHErAzuiMwte1uskeTV0kW.jpg", url:"https://themoviedb.org/person/105736"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{name:"Adventure", properties:{}}, {name:"Animation", properties:{}}, {name:"Children", properties:{}}, {name:"Comedy", properties:{}}, {name:"Fantasy", properties:{}}, {name:"Romance", properties:{}}, {name:"Drama", properties:{}}, {name:"Action", properties:{}}, {name:"Crime", properties:{}}, {name:"Thriller", properties:{}}, {name:"Horror", properties:{}}, {name:"Mystery", properties:{}}, {name:"Sci-Fi", properties:{}}, {name:"Documentary", properties:{}}, {name:"IMAX", properties:{}}, {name:"War", properties:{}}, {name:"Musical", properties:{}}, {name:"Western", properties:{}}, {name:"Film-Noir", properties:{}}, {name:"(no genres listed)", properties:{}}] AS row
CREATE (n:Genre{name: row.name}) SET n += row.properties;
UNWIND [{tmdbId:"88953", properties:{bornIn:"Burchard, Nebraska, USA", imdbId:"0516001", born:date('1893-04-20'), name:"Harold Lloyd", bio:"Harold Lloyd has been called the cinema’s “first man in space. ” He was a product of the film industry.  His comedy wasn’t imported from Vaudeville or the British Music Hall like his contemporaries, Charlie Chaplin and Buster Keaton.  Harold learned to use the camera the way other comics used a bowler hat or a funny walk...", died:date('1971-03-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/er4ZNznuum2v8vqeZr2fT3Friqo.jpg", url:"https://themoviedb.org/person/88953"}}, {tmdbId:"29123", properties:{bornIn:"Arnoldsdorf, West Prussia, Germany [now Jarantowice, Kujawsko-Pomorskie, Poland]", imdbId:"0917467", born:date('1874-12-11'), name:"Paul Wegener", bio:"Paul Wegener was a German actor known for his pioneering roles in Expressionist films.  He can also be considered a father of horror for his breakout role in The Student of Prague (1913).  Wegener maintained a career throughout and after the Nazi era, starring in his last film in 1948...", died:date('1948-09-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6D04qOrnJNNeCiZef0hxRqUt1B4.jpg", url:"https://themoviedb.org/person/29123"}}, {tmdbId:"8635", properties:{bornIn:"Piqua, Kansas, USA", imdbId:"0000036", born:date('1895-10-04'), name:"Buster Keaton", bio:"Buster Keaton was an American comic actor, filmmaker, producer and writer.  He was best known for his silent films, in which his trademark was physical comedy with a consistently stoic, deadpan expression, earning him the nickname \"The Great Stone Face\". \n\nKeaton was recognized as the seventh-greatest director of all time by Entertainment Weekly.  In 1999, the American Film Institute ranked Keaton the 21st-greatest male star of all time...", died:date('1966-02-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kEybBFkO5AX83o3WKyNDfuvfVrn.jpg", url:"https://themoviedb.org/person/8635"}}, {tmdbId:"143998", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0820461", born:date('1897-05-17'), name:"Malcolm St. Clair", died:date('1952-06-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eeTYVC0RKAZzhylzNbX1MuXF4TB.jpg", url:"https://themoviedb.org/person/143998"}}, {tmdbId:"13953", properties:{bornIn:"Kenosha, Wisconsin, USA", imdbId:"0166836", born:date('1891-11-04'), name:"Edward F. Cline", bio:"Edward F.  Cline was an American screenwriter, actor, writer, and director...", died:date('1961-05-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6lNCZC7XJCXcaw3dhVYX6MxIvLf.jpg", url:"https://themoviedb.org/person/13953"}}, {tmdbId:"14481", properties:{bornIn:"Colorado Springs, Colorado, USA", imdbId:"0151606", born:date('1883-04-01'), name:"Lon Chaney", bio:"Lon Chaney (born Leonidas Frank Chaney) - nicknamed \"Man of a Thousand Faces\" - was an American Silent screen star.  He died after completing his only sound film...", died:date('1930-08-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3wZ0n7Yt0JSMju2UAyWYOtLgUzG.jpg", url:"https://themoviedb.org/person/14481"}}, {tmdbId:"8841", properties:{bornIn:"Bow, London, England, UK", imdbId:"0187981", born:date('1882-07-27'), name:"Donald Crisp", bio:"Donald Crisp was born George William Crisp at the family home in Bow,  London.  Donald's parents were James Crisp and Elizabeth Crisp, his birth  was registered by his mother on 4th September 1882.  Donald's sisters  were Elizabeth, Ann, Alice (known as Louisa) and Eliza and his brothers  were James, John and Mark.  Family memories state that Donald's  brother-in-law James Needham (Louisa's husband) lent/gave Donald the  fare to USA...", died:date('1974-05-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rZHp5vzagKpvCQaf7HLtI9PeHXi.jpg", url:"https://themoviedb.org/person/8841"}}, {tmdbId:"2106", properties:{bornIn:"Hermosa, Chicago, Illinois, USA", imdbId:"0000370", born:date('1901-12-05'), name:"Walt Disney", bio:"​From Wikipedia, the free encyclopedia.   \n\nWalter Elias \"Walt\" Disney (December 5, 1901 – December 15, 1966) was an American film producer, director, screenwriter, voice actor, animator, entrepreneur, entertainer, international icon, and philanthropist, well-known for his influence in the field of entertainment during the 20th century.  Along with his brother Roy O...", died:date('1966-12-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rucTIeVtozKer6TmCYBxFr8Wy2q.jpg", url:"https://themoviedb.org/person/2106"}}, {tmdbId:"13355", properties:{bornIn:"West Newton, Massachusetts, United States", imdbId:"0674019", born:date('1892-05-16'), name:"Osgood Perkins", bio:"​From Wikipedia, the free encyclopedia.   \n\nOsgood Perkins (May 16, 1892 – September 21, 1937) was an American actor. Perkins was born James Ripley Osgood Perkins in West Newton, Massachusetts, the son of Helen Virginia (née Anthony) and Henry Phelps Perkins.  He is a descendant of a Mayflower passenger John Howland.  Perkins made his Broadway debut in 1924 in the George S.  Kaufman – Marc Connelly play Beggar on Horseback...", died:date('1937-09-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tU3scIG5k7dG3cRagxn3wWHrMSS.jpg", url:"https://themoviedb.org/person/13355"}}, {tmdbId:"10921", properties:{bornIn:"Scarborough, North Riding of Yorkshire, England, UK", imdbId:"0001452", born:date('1899-07-01'), name:"Charles Laughton", bio:"From Wikipedia, the free encyclopedia. \n\nCharles Laughton (1 July 1899 – 15 December 1962) was an English-American stage and film actor, director, producer and screenwriter.  Laughton was trained in London at the Royal Academy of Dramatic Art and first appeared professionally on the stage in 1926.  In 1927, he was cast in a play with his future wife Elsa Lanchester, with whom he lived and worked until his death...", died:date('1962-12-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eRTDXGpo3JHA5tQ299lJTxeuFao.jpg", url:"https://themoviedb.org/person/10921"}}, {tmdbId:"4165", properties:{bornIn:"Winterset, Iowa, USA ", imdbId:"0000078", born:date('1907-05-26'), name:"John Wayne", bio:"Marion Mitchell Morrison (born Marion Robert Morrison; May 26, 1907 – June 11, 1979), known professionally as John Wayne and nicknamed Duke, was an American actor and filmmaker.  An Academy Award-winner for True Grit (1969), Wayne was among the top box office draws for three decades. \n\nBorn in Winterset, Iowa, Wayne grew up in Southern California.  He was president of Glendale High class of 1925...", died:date('1979-06-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iqEHYrf2d9m5JlLBHsvsd34SIZr.jpg", url:"https://themoviedb.org/person/4165"}}, {tmdbId:"46617", properties:{bornIn:"Camberwell, London, UK", imdbId:"0526946", born:date('1918-02-04'), name:"Ida Lupino", bio:"Ida Lupino (4 February 1918 – 3 August 1995) was an English-American film actress and director, and a pioneer among women filmmakers.  In her 48-year career, she appeared in 59 films and directed seven others.  She also appeared in serial television programmes 58 times and directed 50 other episodes.  In addition, she contributed as a writer to five films and four TV episodes. \n\nDescription above from the Wikipedia article Ida Lupino, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1995-08-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mJx87Iq7J2ymTg8CZ0EWK7yHSmt.jpg", url:"https://themoviedb.org/person/46617"}}, {tmdbId:"11493", properties:{bornIn:"Forest Hill, London, England, UK", imdbId:"0001366", born:date('1893-04-03'), name:"Leslie Howard", bio:"From Wikipedia, the free encyclopedia\n\nLeslie Howard (3 April 1893 – 1 June 1943) was an English stage and film actor, director, and producer.  Among his best-known roles was Ashley Wilkes in Gone with the Wind (1939) and roles in Of Human Bondage (1934), The Scarlet Pimpernel (1934), The Petrified Forest (1936), Pygmalion (1938), and Intermezzo (1939). \n\nHoward's Second World War activities included acting and filmmaking...", died:date('1943-06-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8ZGrKIKCPL9CRKpGFZB68QQbHuo.jpg", url:"https://themoviedb.org/person/11493"}}, {tmdbId:"8630", properties:{bornIn:"Vienna, Austria-Hungary [now Austria]", imdbId:"0002233", born:date('1885-09-22'), name:"Erich von Stroheim", bio:"From Wikipedia\n\nErich von Stroheim (September 22, 1885 – May 12, 1957) was an Austrian-born film star of the silent era, subsequently noted as an auteur for his directorial work...", died:date('1957-05-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v0DY16kMSMAqIdI3yYSRGYiz37c.jpg", url:"https://themoviedb.org/person/8630"}}, {tmdbId:"3359", properties:{bornIn:"Dorking, Surrey, England, UK", imdbId:"0000059", born:date('1907-05-22'), name:"Laurence Olivier", bio:"Laurence Kerr Olivier, Baron Olivier, OM (22 May 1907 – 11 July 1989) was an English actor and director who, along with his contemporaries Ralph Richardson, Peggy Ashcroft and John Gielgud, dominated the British stage of the mid-20th century.  He also worked in films throughout his career, playing more than fifty cinema roles.  Late in his career, he had considerable success in television roles...", died:date('1989-07-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q8XmXrFIu6aPqkyAI5JhCYQm4Kk.jpg", url:"https://themoviedb.org/person/3359"}}, {tmdbId:"82216", properties:{bornIn:"Filley, Nebraska, USA", imdbId:"0001791", born:date('1911-08-05'), name:"Robert Taylor", bio:"From Wikipedia, the free encyclopedia. \n\nRobert Taylor (born Spangler Arlington Brugh; August 5, 1911 – June 8, 1969) was an American film and television actor who was one of the most popular leading men of his time. \n\nTaylor began his career in films in 1934 when he signed with Metro-Goldwyn-Mayer.  He won his first leading role the following year in Magnificent Obsession...", died:date('1969-06-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mdqt2422xSs2uN7Cju9W2jWVDlF.jpg", url:"https://themoviedb.org/person/82216"}}, {tmdbId:"19406", properties:{bornIn:"Fishkill Landing [now Beacon], New York, USA", imdbId:"0599910", born:date('1904-05-21'), name:"Robert Montgomery", bio:"From Wikipedia, the free encyclopedia\n\nRobert Montgomery (born Henry Montgomery Jr. ; May 21, 1904 – September 27, 1981) was an American film and television actor, director, and producer.  He was also the father of actress Elizabeth Montgomery. \n\nMontgomery settled in New York City to try his hand at writing and acting.  He established a stage career, and became popular enough to turn down an offer to appear opposite Vilma Bánky in the film This Is Heaven (1929)...", died:date('1981-09-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o2H1yxVxbxlTWP1PZDFXv6oxiFj.jpg", url:"https://themoviedb.org/person/19406"}}, {tmdbId:"4112", properties:{bornIn:"Trieste, Austria-Hungary", imdbId:"0002134", born:date('1908-01-10'), name:"Paul Henreid", bio:"From Wikipedia, the free encyclopedia.   \n\nPaul Henreid (10 January 1908 – 29 March 1992), whose birthname was Paul Georg Julius Hernreid Ritter von Wassel-Waldingau, was an Austrian actor and film director.  Henreid's best remembered role is as Victor Laszlo in Casablanca (1942). \n\nDescription above from the Wikipedia article Paul Henreid, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1992-03-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aKMN2qy2vFoiGAndEzVkFZuhG01.jpg", url:"https://themoviedb.org/person/4112"}}, {tmdbId:"23626", properties:{bornIn:"San Francisco, California, USA", imdbId:"0000630", born:date('1967-10-04'), name:"Liev Schreiber", bio:"Liev Schreiber is an American actor, producer, director and screenwriter.  He became known during the late 1990s and early 2000s, having initially appeared in several independent films, and later mainstream Hollywood films, including the Scream trilogy of horror films, The Sum of All Fears, X-Men Origins: Wolverine, and Salt.  Schreiber is also a respected stage actor, having performed in several Broadway productions...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/miHBraMiP8d76eT81LErC6kAx3D.jpg", url:"https://themoviedb.org/person/23626"}}, {tmdbId:"40", properties:{bornIn:"Kenosha, Wisconsin, USA", imdbId:"0000080", born:date('1915-05-06'), name:"Orson Welles", bio:"George Orson Welles (May 6, 1915 – October 10, 1985), best known as Orson Welles, was an American film director, actor, theatre director, screenwriter, and producer, who worked extensively in film, theatre, television and radio...", died:date('1985-10-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c5wKlmD001cQAqJjvDbVOTVeAyV.jpg", url:"https://themoviedb.org/person/40"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor:Director;
UNWIND [{tmdbId:"19328", properties:{bornIn:"Mountain View, Arkansas, USA", imdbId:"0694090", born:date('1904-11-14'), name:"Dick Powell", bio:"Richard Ewing \"Dick\" Powell (November 14, 1904 – January 2, 1963) was an American singer, actor, producer, director and studio boss. \n\nBorn in Mountain View, the seat of Stone County in northern Arkansas, Powell attended the former Little Rock College in the state capital, before he started his entertainment career as a singer with the Charlie Davis Orchestra, based in the midwest.  He recorded a number of records with Davis and on his own, for the Vocalion label in the late 1920s...", died:date('1963-01-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xyUlt3yZZe4RUZq1yEXyhpuxU9W.jpg", url:"https://themoviedb.org/person/19328"}}, {tmdbId:"13294", properties:{bornIn:"Pittsburgh, Pennsylvania, USA", imdbId:"0000037", born:date('1912-08-23'), name:"Gene Kelly", bio:"Metro-Goldwyn-Mayer was the largest and most powerful studio in Hollywood when Gene Kelly arrived in town in 1941.  He came direct from the hit 1940 original Broadway production of \"Pal Joey\" and planned to return to the Broadway stage after making the one film required by his contract.  His first picture for Metro-Goldwyn-Mayer was For Me and My Gal (1942) with Judy Garland.  What kept Kelly in Hollywood were \"the kindred creative spirits\" he found behind the scenes at Metro-Goldwyn-Mayer...", died:date('1996-02-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/g98yyY7oGrkocUxxJgOt82I7z6A.jpg", url:"https://themoviedb.org/person/13294"}}, {tmdbId:"14502", properties:{bornIn:"Vancouver, British Columbia, Canada", imdbId:"0409869", born:date('1914-01-31'), name:"John Ireland", bio:"John Benjamin Ireland (January 30, 1914 – March 21, 1992) was a Canadian-American actor and film director.  He was nominated for an Academy Award for his performance in All the King's Men (1949), making him the first Vancouver-born actor to receive an Academy Award nomination. \n\nIreland was a supporting actor in several famous Western films such as My Darling Clementine (1946), Red River (1948), Vengeance Valley (1951), and Gunfight at the O. K.  Corral (1957)...", died:date('1992-03-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uVqlrLTVzc9pqIMkAPMIuqHxhRb.jpg", url:"https://themoviedb.org/person/14502"}}, {tmdbId:"13784", properties:{bornIn:"New York City, New York, USA", imdbId:"0000044", born:date('1913-11-02'), name:"Burt Lancaster", bio:"From Wikipedia, the free encyclopedia\n\nBurton Stephen \"Burt\" Lancaster (November 2, 1913 – October 20, 1994) was an American film actor noted for his athletic physique and distinctive smile (which he called \"The Grin\").  Later he took roles that went against his initial \"tough guy\" image.  In the late 1950s Lancaster abandoned his \"all-American\" image and came to be regarded as one of the best actors of his generation...", died:date('1994-10-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qmxwPU1KuxvmptKr5vU7TfaO5Bo.jpg", url:"https://themoviedb.org/person/13784"}}, {tmdbId:"10158", properties:{bornIn:"Bridgeport, Connecticut, USA", imdbId:"0000053", born:date('1917-08-06'), name:"Robert Mitchum", bio:"Robert Charles Durman Mitchum  (August 6, 1917 – July 1, 1997) was an American film actor, author, composer and singer and is #23 on the American Film Institute's list of the greatest male American screen legends of all time.  Mitchum is largely remembered for his starring roles in several major works of the film noir style, and is considered a forerunner of the anti-heroes prevalent in film during the 1950s and 1960s...", died:date('1997-07-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4SpuhiEDFXqONdtUbqW7HMyo5Nb.jpg", url:"https://themoviedb.org/person/10158"}}, {tmdbId:"39608", properties:{bornIn:"Hollywood, California, USA", imdbId:"0001135", born:date('1926-08-12'), name:"John Derek", bio:"From Wikipedia, the free encyclopedia.  \n\nJohn Derek (August 12, 1926 – May 22, 1998) was an American actor, director and photographer most famous for the women to whom he was married. \n\nDescription above from the Wikipedia article John Derek, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1998-05-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1Sgu4o8FxyvyafcjLWMu9Qn4W6H.jpg", url:"https://themoviedb.org/person/39608"}}, {tmdbId:"3663", properties:{bornIn:"Newark, New Jersey, USA ", imdbId:"0001471", born:date('1926-03-16'), name:"Jerry Lewis", bio:"Jerry Lewis (March 16, 1926 - August 20, 2017) was an American comedian, actor, film producer, writer, film director and singer.  He is best-known for his slapstick humor in stage, radio, screen, recording and television.  Lewis is also known for his charity fund-raising telethons and position as national chairman for the Muscular Dystrophy Association (MDA)...", died:date('2017-08-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hUZTlaRZua273L6rgA75BWpads3.jpg", url:"https://themoviedb.org/person/3663"}}, {tmdbId:"9108", properties:{bornIn:"Freeport, Pennsylvania, USA", imdbId:"0852279", born:date('1920-12-13'), name:"Don Taylor", bio:"Don Taylor was an American movie actor and director best known for his performances in 1950s classics like Stalag 17 and Father of the Bride and the 1948 film noir The Naked City.  He later turned to directing films such as Escape from the Planet of the Apes (1971) and Tom Sawyer (1973)...", died:date('1998-12-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tFQYFlFtOwK5ueiXiuQyWVXG9SJ.jpg", url:"https://themoviedb.org/person/9108"}}, {tmdbId:"3084", properties:{bornIn:"Omaha, Nebraska, USA", imdbId:"0000008", born:date('1924-04-03'), name:"Marlon Brando", bio:"Marlon Brando, Jr.  (April 3, 1924 – July 1, 2004) was an American actor who performed for over half a century...", died:date('2004-07-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fuTEPMsBtV1zE98ujPONbKiYDc2.jpg", url:"https://themoviedb.org/person/3084"}}, {tmdbId:"16897", properties:{bornIn:"Miami, Florida, USA", imdbId:"0001627", born:date('1927-02-20'), name:"Sidney Poitier", bio:"Sir Sidney Poitier, KBE (born February 20, 1927) is a Bahamian American actor, film director, author, and diplomat.  In 1963, Poitier became the first black person to win an Academy Award for Best Actor for his role in Lilies of the Field.  The significance of this achievement was later bolstered in 1967 when he starred in three well-received films—To Sir, with Love; In the Heat of the Night; and Guess Who's Coming to Dinner—making him the top box office star of that year...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fhMiCe3ScxBGKEX6Y6flEJm7iHd.jpg", url:"https://themoviedb.org/person/16897"}}, {tmdbId:"1159927", properties:{imdbId:"0808544", name:"Jack Smith", url:"https://themoviedb.org/person/1159927"}}, {tmdbId:"12329", properties:{bornIn:"Sora, Frosinone, Lazio, Italy", imdbId:"0001120", born:date('1901-07-07'), name:"Vittorio De Sica", bio:"Vittorio De Sica (7 July 1901 – 13 November 1974) was an Italian director and actor, a leading figure in the neorealist movement. \n\nFour of the films he directed won Academy Awards: Sciuscià and Bicycle Thieves (honorary), while Yesterday, Today and Tomorrow and Il giardino dei Finzi Contini won the Academy Award for Best Foreign Language Film...", died:date('1974-11-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/SObzAVAFAzCSM5nmpvpNdX7oxq.jpg", url:"https://themoviedb.org/person/12329"}}, {tmdbId:"834", properties:{bornIn:"Wiznitz, Bukovina, Austria-Hungary", imdbId:"0695937", born:date('1906-12-05'), name:"Otto Preminger", bio:"Otto Ludwig Preminger (5 December 1905 – 23 April 1986) was an Austro–Hungarian-American theatre and film director. \n\nAfter moving from the theatre to Hollywood, he directed over 35 feature films in a five-decade career.  He rose to prominence for stylish film noir mysteries such as Laura (1944) and Fallen Angel (1945).  In the 1950s and 1960s, he directed a number of high-profile adaptations of popular novels and stage works...", died:date('1986-04-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zmJuWBIbWURkB138eD9IPVzpAUt.jpg", url:"https://themoviedb.org/person/834"}}, {tmdbId:"5763", properties:{bornIn:"Le Pecq, Yvelines, France", imdbId:"0004244", born:date('1907-10-09'), name:"Jacques Tati", bio:"Jacques Tati (born Jacques Tatischeff; 9 October 1907 – 5 November 1982) was a French filmmaker, working both as a comedic actor and director.  In a poll conducted by Entertainment Weekly of the Greatest Movie Directors Tati was voted the 46th greatest of all time.  With only six feature-length films to his credit as director, he directed fewer films than any other director on this list of 50...", died:date('1982-11-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6mZch9eKmON3SGQ8gdZitEv449F.jpg", url:"https://themoviedb.org/person/5763"}}, {tmdbId:"12446", properties:{bornIn:"Southsea, Hampshire, England, UK", imdbId:"0000634", born:date('1925-09-08'), name:"Peter Sellers", bio:"From Wikipedia, the free encyclopedia. \n\nRichard Henry Sellers, CBE (8 September 1925 – 24 July 1980), known as Peter Sellers, was a British comedian and actor best known as Chief Inspector Clouseau in The Pink Panther film series, for playing three different characters in Dr.  Strangelove, as Clare Quilty in Lolita, and as the man-child and TV-addicted Chance the gardener in his penultimate film, Being There.  Leading actress Bette Davis once remarked of him, \"He isn't an actor—he's a chameleon...", died:date('1980-07-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rZqV15C4Y5Avq3IkHfrPHQZRdl5.jpg", url:"https://themoviedb.org/person/12446"}}, {tmdbId:"16002", properties:{bornIn:"Seattle, Washington", imdbId:"0625383", born:date('1920-03-24'), name:"Gene Nelson", bio:"From Wikipedia, the free encyclopedia. \n\nGene Nelson was an American dancer, actor, screenwriter, and director.  Born Leander Eugene Berg in Astoria, Oregon, he moved to Seattle when he was a year old.  He was inspired to become a dancer by watching Fred Astaire when he was a child.  After serving in the Army during World War II during which he also performed in the musical This Is the Army, Nelson landed his first Broadway role in Lend an Ear, for which he received the Theatre World Award...", died:date('1996-09-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1pAFmgqAvSY1MsT7TvZPiqTnuLd.jpg", url:"https://themoviedb.org/person/16002"}}, {tmdbId:"7301", properties:{bornIn:"New York City, New York, USA", imdbId:"0000578", born:date('1932-04-04'), name:"Anthony Perkins", bio:"Anthony Perkins (April 4, 1932 – September 12, 1992) was an American actor and singer.  He is best known for his role as Norman Bates in Alfred Hitchcock's Psycho and his Oscar-nominated role in Friendly Persuasion (1956)...", died:date('1992-09-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lRwJZy8lTKEXpTOlHkyqIQpeyMJ.jpg", url:"https://themoviedb.org/person/7301"}}, {tmdbId:"31439", properties:{bornIn:"Stratford, London, England, UK", imdbId:"0285302", born:date('1926-07-22'), name:"Bryan Forbes", bio:"Bryan Forbes (22 July 1926 – 8 May 2013) was an English film director, screenwriter, film producer, actor and novelist...", died:date('2013-05-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kmRjRq6nxAN7UlISqyxvd67QCKd.jpg", url:"https://themoviedb.org/person/31439"}}, {tmdbId:"8741", properties:{bornIn:"Silbodal, Värmlands län, Sweden", imdbId:"0803705", born:date('1879-09-20'), name:"Victor Sjöström", bio:"Victor Sjöström (known in the United States also as Victor Seastrom) was a Swedish actor, screenwriter, and film director...", died:date('1960-01-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nkRxnYQtnSNdMH7Y8DaW1p1f4YL.jpg", url:"https://themoviedb.org/person/8741"}}, {tmdbId:"13565", properties:{bornIn:"Beech Grove, IN", imdbId:"0000537", born:date('1930-03-24'), name:"Steve McQueen", bio:"He was the ultra-cool male film star of the 1960s, and rose from a troubled youth spent in reform schools to being the world's most popular actor.  Over 25 years after his untimely death from mesothelioma in 1980, Steve McQueen is still considered hip and cool, and he endures as an icon of popular culture...", died:date('1980-11-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xUxg7SAM17eEc0rF90gz59Ap0w1.jpg", url:"https://themoviedb.org/person/13565"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor:Director;
UNWIND [{tmdbId:"3636", properties:{bornIn:"Shaker Heights, Ohio, USA", imdbId:"0000056", born:date('1925-01-26'), name:"Paul Newman", bio:"Paul Leonard Newman (January 26, 1925 – September 26, 2008) was an American actor, film director, entrepreneur, humanitarian, professional racing driver, auto racing team owner, and auto racing enthusiast...", died:date('2008-09-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nIFChFSulCQO6jZvmi7YlBh1Eas.jpg", url:"https://themoviedb.org/person/3636"}}, {tmdbId:"232669", properties:{bornIn:"Chappes, France", imdbId:"0133424", born:date('1912-04-21'), name:"Marcel Camus", died:date('1982-01-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lErZmR4arJzF9QBVGWrdIPg64zl.jpg", url:"https://themoviedb.org/person/232669"}}, {tmdbId:"30647", properties:{bornIn:"New York City, New York, USA", imdbId:"0003203", born:date('1924-02-17'), name:"Mel Welles", bio:"From Wikipedia, the free encyclopedia\n\nMel Welles (February 17, 1924 - August 18, 2005) was an American film actor.  His best-remembered role may be that of hapless flower shop owner Gravis Mushnik in the 1960 low-budget Roger Corman dark comedy, The Little Shop of Horrors (which featured Jack Nicholson as a masochistic dental patient). \n\nNot much is known of Welles' early life, except that he was born Ira Meltcher in New York City.  He graduated from Mt.  Carmel High School, in 1940...", died:date('2005-08-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4hKznYBbTIy78NtOJK0LNaq4UxO.jpg", url:"https://themoviedb.org/person/30647"}}, {tmdbId:"4786", properties:{bornIn:"Cambridge, Cambridgeshire, England, UK", imdbId:"0000277", born:date('1923-08-29'), name:"Richard Attenborough", bio:"From Wikipedia, the free encyclopedia. \n\nRichard Samuel Attenborough, Baron Attenborough, Kt, CBE (29 August 1923 – 24 August 2014) was an English actor, filmmaker, entrepreneur, and politician.  He was the President of the Royal Academy of Dramatic Art (RADA) and the British Academy of Film and Television Arts (BAFTA).  Attenborough joined the Royal Air Force during World War II and served in the film unit...", died:date('2014-08-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bU0o3g5rbpzRkJ5bGowekGvfiHw.jpg", url:"https://themoviedb.org/person/4786"}}, {tmdbId:"68", properties:{bornIn:" Vienna, Austria", imdbId:"0000485", born:date('1890-12-05'), name:"Fritz Lang", bio:"Friedrich Christian Anton \"Fritz\" Lang (December 5, 1890 – August 2, 1976) was an Austrian-American filmmaker, screenwriter, and occasional film producer and actor.  One of the best known émigrés from Germany's school of Expressionism, he was dubbed the \"Master of Darkness\" by the British Film Institute...", died:date('1976-08-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aGfdQV0cOLdES9imtk2vaHZaY3T.jpg", url:"https://themoviedb.org/person/68"}}, {tmdbId:"514", properties:{bornIn:"Manhattan, New York, USA", imdbId:"0000197", born:date('1937-04-22'), name:"Jack Nicholson", bio:"John Joseph \"Jack\" Nicholson (born April 22, 1937) is an American actor, film director, producer and writer.  He is renowned for his often dark-themed portrayals of neurotic characters.  Nicholson has been nominated for Academy Awards 12 times.  He has won the Academy Award for Best Actor twice, for One Flew Over the Cuckoo's Nest and for As Good as It Gets.  He won the Academy Award for Best Supporting Actor for the 1983 film Terms of Endearment...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uZyV6vZ9Ubipw89woZzY7dBaEPz.jpg", url:"https://themoviedb.org/person/514"}}, {tmdbId:"11857", properties:{bornIn:"South Kensington, London, England, UK", imdbId:"0000024", born:date('1904-04-14'), name:"John Gielgud", bio:"Sir Arthur John Gielgud, OM, CH ( 14 April 1904 – 21 May 2000) was an English actor, director, and producer.  A descendant of the renowned Terry acting family, he achieved early international acclaim for his youthful, emotionally expressive Hamlet which broke box office records on Broadway in 1937.  He was known for his beautiful speaking of verse and particularly for his warm and expressive voice, which his colleague Sir Alec Guinness likened to \"a silver trumpet muffled in silk\"...", died:date('2000-05-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rSyG2ypOnMVOuGtDJMYt5VV1bMr.jpg", url:"https://themoviedb.org/person/11857"}}, {tmdbId:"10592", properties:{bornIn:"Liverpool, England, UK", imdbId:"0006168", born:date('1940-10-09'), name:"John Lennon", bio:"John Winston Ono Lennon, MBE (9 October 1940 – 8 December 1980) was an English musician and singer-songwriter who rose to worldwide fame as one of the founding members of The Beatles, one of the most commercially successful and critically acclaimed acts in the history of popular music.  Along with fellow Beatle Paul McCartney, he formed one of the most successful songwriting partnerships of the 20th century...", died:date('1980-12-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eoaFA3ekdmEhAtSZ3wb9gEm2TYh.jpg", url:"https://themoviedb.org/person/10592"}}, {tmdbId:"10215", properties:{bornIn:"Liverpool, England, UK", imdbId:"0005200", born:date('1942-06-18'), name:"Paul McCartney", bio:"Sir James Paul McCartney, MBE (born 18 June 1942) is an English musician, singer-songwriter and composer.  Formerly of The Beatles (1960–1970) and Wings (1971–1981), McCartney is the most commercially successful songwriter in the history of popular music, according to Guinness World Records. \n\nMcCartney gained worldwide fame as a member of The Beatles, alongside John Lennon, George Harrison, and Ringo Starr...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sCPsv9ueP5UR6BkMSmRDlwbra6S.jpg", url:"https://themoviedb.org/person/10215"}}, {tmdbId:"10593", properties:{bornIn:"Liverpool, England, UK", imdbId:"0365600", born:date('1943-02-25'), name:"George Harrison", bio:"George Harrison,  MBE (25 February 1943 – 29 November 2001) was an English rock guitarist, singer-songwriter, actor and film producer who achieved international fame as lead guitarist of The Beatles.   Often referred to as \"the quiet Beatle\",  Harrison became over time an admirer of Indian mysticism, and introduced it to the other Beatles, as well as those of their Western audience...", died:date('2001-11-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zwUO2gnKBnSrKOB9hnhI9GdOX6e.jpg", url:"https://themoviedb.org/person/10593"}}, {tmdbId:"11147", properties:{bornIn:"New York City, New York, U.S.", imdbId:"0001023", born:date('1929-12-09'), name:"John Cassavetes", bio:"John Nicholas Cassavetes was a Greek-American actor, film director, and screenwriter.  Cassavetes was a pioneer of American independent film, writing and directing over a dozen movies, which he partially self-financed, and pioneered the use of improvisation and a realistic cinéma vérité style.  He also acted in many Hollywood films, notably Rosemary's Baby (1968) and The Dirty Dozen (1967).  He studied acting with Don Richardson, using an acting technique based on muscle memory...", died:date('1989-02-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4a3ON8y1EbjXLY1pWfAkFRgLqga.jpg", url:"https://themoviedb.org/person/11147"}}, {tmdbId:"6449", properties:{bornIn:"Richmond, Virginia, U.S.", imdbId:"0000886", born:date('1937-03-30'), name:"Warren Beatty", bio:"Warren Beatty is an American actor and filmmaker.  He has been nominated for fourteen Academy Awards – four for Best Actor, four for Best Picture, two for Best Director, three for Original Screenplay, and one for Adapted Screenplay – winning Best Director for Reds (1981)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4IDilrr21iRKv75QOwNKJPC3WgW.jpg", url:"https://themoviedb.org/person/6449"}}, {tmdbId:"190", properties:{bornIn:"San Francisco, California, USA", imdbId:"0000142", born:date('1930-05-31'), name:"Clint Eastwood", bio:"An American film actor, director, producer, composer and politician...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/muqCdaIVgLFtHb1FpwkH15bBXme.jpg", url:"https://themoviedb.org/person/190"}}, {tmdbId:"94011", properties:{bornIn:"Hermosillo, Sonora, Mexico", imdbId:"0006837", born:date('1916-11-15'), name:"Bill Melendez", bio:"José \"Bill\" Cuauhtémoc Meléndez (November 15, 1916 – September 2, 2008) was a Mexican–American character animator, voice actor, film director and producer known for his cartoons for Walt Disney Productions (working on four Disney films Pinocchio, Fantasia, Dumbo and Bambi), Warner Bros.  Cartoons, UPA and the Peanuts series.  Melendez provided the voices of Snoopy and Woodstock in the latter as well...", died:date('2008-09-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kvIqx3FX1rPFAX9WkKkcTylC6d2.jpg", url:"https://themoviedb.org/person/94011"}}, {tmdbId:"20030", properties:{bornIn:"Paris, France", imdbId:"0674742", born:date('1941-07-13'), name:"Jacques Perrin", bio:"From Wikipedia, the free encyclopedia. \n\nJacques Perrin (born Jacques André Simonet; 13 July 1941) is a French actor and filmmaker.  He is occasionally credited as Jacques Simonet.  Simonet was his father's name and Perrin his mother's. \n\nDescription above from the Wikipedia article Jacques Perrin, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5HRh3Ae5pbLB4sUgBz4Rzr9sSPJ.jpg", url:"https://themoviedb.org/person/20030"}}, {tmdbId:"21520", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0910737", born:date('1919-06-14'), name:"Sam Wanamaker", bio:"Was an American film director and actor and is credited as the person most responsible for the modern recreation of Shakespeare's Globe Theatre in London.  He is father to actress Zoë Wanamaker...", died:date('1993-12-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/di9f8OPCKbZFDX0Ux4Uu0mIPgK8.jpg", url:"https://themoviedb.org/person/21520"}}, {tmdbId:"69300", properties:{bornIn:"New York City, New York, USA", imdbId:"0757256", born:date('1921-11-08'), name:"Gene Saks", bio:"From Wikipedia, the free encyclopedia. \n\nGene Saks (born November 8, 1921) is an American stage and film director...", died:date('2015-03-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eycEUe3kyD4SLBlTE3suUHmQhcd.jpg", url:"https://themoviedb.org/person/69300"}}, {tmdbId:"86", properties:{bornIn:"San Francisco, California, U.S.", imdbId:"0113164", born:date('1937-12-01'), name:"Bruce Brown", bio:"​From Wikipedia, the free encyclopedia.   \n\nBruce Brown (born December 1, 1937 in San Francisco, California) is an American documentary film director, known as an early pioneer of the surf film.  He is the father of filmmaker Dana Brown. \n\nHis surfing films were Slippery When Wet (1958), Surf Crazy (1959), Barefoot Adventure (1960), Surfing Hollow Days (1961), Waterlogged (1962), and his most well known film, The Endless Summer (1964) which received a nationwide theatrical release in 1966...", died:date('2017-12-10'), url:"https://themoviedb.org/person/86"}}, {tmdbId:"88571", properties:{imdbId:"0912849", name:"Harold P. Warren", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4ztmebGPEkTsM2S68JmyCFiuMeS.jpg", url:"https://themoviedb.org/person/88571"}}, {tmdbId:"1895", properties:{bornIn:"The Bronx, New York City, New York, USA", imdbId:"0005348", born:date('1922-03-20'), name:"Carl Reiner", bio:"Carl Reiner (March 20, 1922 - June 29, 2020) was an American actor, film director, producer, writer and comedian.  During his career he won nine Emmy Awards and one Grammy Award.  He has the distinction of being the only person to have appeared on the The Tonight Show with each of its five hosts...", died:date('2020-06-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mOTXz6LK7PUdqGcTVfQl7MtqCrV.jpg", url:"https://themoviedb.org/person/1895"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor:Director;
UNWIND [{tmdbId:"4135", properties:{bornIn:"Santa Monica, California, USA", imdbId:"0000602", born:date('1936-08-18'), name:"Robert Redford", bio:"Charles Robert Redford Jr.  (born August 18, 1936), better known as Robert Redford, is an American actor, film director, producer, businessman, model, environmentalist, philanthropist, and founder of the Sundance Film Festival.  He has received two Oscars: one in 1981 for directing Ordinary People, and one for Lifetime Achievement in 2002...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fUj0y9f69EYqWcGgjDhEcHlyzTW.jpg", url:"https://themoviedb.org/person/4135"}}, {tmdbId:"4774", properties:{bornIn:"St. Simons Island, Georgia, USA", imdbId:"0000987", born:date('1936-02-17'), name:"Jim Brown", bio:"An American former professional football player who has also made his mark as an actor.  He is best known for his exceptional and record-setting nine-year career as a running back for the NFL Cleveland Browns from 1957 to 1965.  In 2002, he was named by Sporting News as the greatest professional football player ever.  He is considered to be one of the greatest professional athletes the U. S.  has ever produced...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wfp06VC5yr9mdzdZ5JcbzqD5YEG.jpg", url:"https://themoviedb.org/person/4774"}}, {tmdbId:"4483", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0000163", born:date('1937-08-08'), name:"Dustin Hoffman", bio:"Dustin Hoffman (born August 8, 1937) is an American stage, film and television actor.  After versatile portrayals of antiheroes and vulnerable types of characters in stage plays, he had his breakthrough film role as Benjamin Braddock in the feature film \"The Graduate\".  Since then he starred in many films, like \"Papillon\", \"Kramer vs.  Kramer\", \"Tootsie\", and \"Rain Man\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zN03MlLSFeTFT5TtX282mHD1rqF.jpg", url:"https://themoviedb.org/person/4483"}}, {tmdbId:"133471", properties:{bornIn:"Stockholm, Stockholms län, Sweden", imdbId:"0803672", born:date('1924-12-02'), name:"Vilgot Sjöman", bio:"David Harald Vilgot Sjöman was a Swedish writer and film director.  His films deal with controversial issues of social class, morality, and sexual taboos, combining the emotionally-tortured characters of Ingmar Bergman with the avant garde style of the French New Wave...", died:date('2006-04-09'), url:"https://themoviedb.org/person/133471"}}, {tmdbId:"2778", properties:{bornIn:"Dodge City - Kansas - USA", imdbId:"0000454", born:date('1936-05-17'), name:"Dennis Hopper", bio:"Dennis Lee Hopper (May 17, 1936 – May 29, 2010) was an American actor, filmmaker and artist.  As a young man, Hopper became interested in acting and eventually became a student of the Actors' Studio.  He made his first television appearance in 1954, and appeared in two films featuring James Dean, Rebel Without a Cause (1955) and Giant (1956).  During the next 10 years, Hopper appeared frequently on television in guest roles, and by the end of the 1960s had played supporting roles in several films...", died:date('2010-05-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3Hg8mkb1RxqNhDOofzHdr0PoufH.jpg", url:"https://themoviedb.org/person/2778"}}, {tmdbId:"30706", properties:{bornIn:"Forest Hill, London, England, UK", imdbId:"0420383", born:date('1926-06-10'), name:"Lionel Jeffries", bio:"From Wikipedia, the free encyclopedia\n\nLionel Charles Jeffries (10 June 1926 – 19 February 2010) was an English actor, screenwriter and film director. \n\nDescription above from the Wikipedia article Lionel Jeffries, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2010-02-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6FYwiCj3W3pzQrtRBoaF9gc8Uvq.jpg", url:"https://themoviedb.org/person/30706"}}, {tmdbId:"10400", properties:{bornIn:"Williamsburg, Brooklyn, New York, USA", imdbId:"0000659", born:date('1942-04-24'), name:"Barbra Streisand", bio:"Barbara Joan \"Barbra\" Streisand (born April 24, 1942) is an American singer, songwriter, actress, and filmmaker.  She has won two Academy Awards, eight Grammy Awards, four Emmy Awards, a Special Tony Award, an American Film Institute award, a Peabody Award, and is one of the few entertainers who have won an Academy, Emmy, Grammy, and Tony Award. \n\nShe is one of the most commercially and critically successful entertainers in modern entertainment history, with more than 71...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6YD223jsdZX7VnWSjGjP1S7Xj6X.jpg", url:"https://themoviedb.org/person/10400"}}, {tmdbId:"3460", properties:{bornIn:"Milwaukee, Wisconsin, USA", imdbId:"0000698", born:date('1933-06-11'), name:"Gene Wilder", bio:"Gene Wilder (born Jerome Silberman; June 11, 1933 - August 29, 2016) was an American stage and screen actor, director, screenwriter, and author. \n\nWilder began his career on stage, making his screen debut in the film Bonnie and Clyde in 1967.  His first major role was as Leopold Bloom in the 1968 film The Producers...", died:date('2016-08-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j4naYGrsnKVFynZJZ1RS1XKR47X.jpg", url:"https://themoviedb.org/person/3460"}}, {tmdbId:"16475", properties:{bornIn:"Lansing, Michigan, USA", imdbId:"0000608", born:date('1936-02-11'), name:"Burt Reynolds", bio:"Burton Leon \"Burt\" Reynolds Jr.  (February 11, 1936 - September 6, 2018) was an American actor.  Some of his memorable roles include Bo 'Bandit' Darville in Smokey and the Bandit, Lewis Medlock in Deliverance, Bobby \"Gator\" McCluskey in White Lightning and sequel Gator, Paul Crewe and Coach Nate Scarborough in The Longest Yard and its 2005 remake respectively, J. J.  McClure in The Cannonball Run, the voice of Charlie B.  Barkin in All Dogs Go to Heaven, and Jack Horner in Boogie Nights...", died:date('2018-09-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5FNuc4f1OR9EF9QcrcnFIr3zZQr.jpg", url:"https://themoviedb.org/person/16475"}}, {tmdbId:"1650", properties:{bornIn:"Paris, France", imdbId:"0000076", born:date('1932-02-06'), name:"François Truffaut", bio:"François Roland Truffaut (6 February 1932 – 21 October 1984) was an influential film critic and filmmaker and one of the founders of the French New Wave.  In a film career lasting over a quarter of a century, he remains an icon of the French film industry.  He was also a screenwriter, producer, and actor working on over twenty-five films...", died:date('1984-10-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3bXLtipaybsje01LlQvHvuUAZNq.jpg", url:"https://themoviedb.org/person/1650"}}, {tmdbId:"24318", properties:{bornIn:"New York City, New York", imdbId:"0000907", born:date('1938-05-22'), name:"Richard Benjamin", bio:"From Wikipedia, the free encyclopedia. \n\nRichard Benjamin (born May 22, 1938) is an American actor and film director.  He has starred in a number of productions, including Goodbye, Columbus (1969), based on the novella (1959) by Philip Roth, and Westworld (1973)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i58m0OdJLHBez2z6ZbXiqXOZZpV.jpg", url:"https://themoviedb.org/person/24318"}}, {tmdbId:"14987", properties:{bornIn:"Portsmouth - New Hampshire - USA", imdbId:"0094288", born:date('1938-08-06'), name:"Peter Bonerz", bio:"From Wikipedia, the free encyclopedia\n\nPeter Bonerz (born August 6, 1938 in Portsmouth, New Hampshire) is an American actor and director who is best known as the character Dr.  Jerry Robinson on The Bob Newhart Show. \n\nBonerz grew up in Milwaukee, Wisconsin, where he attended Marquette University High School, gaining his first theatrical experience with the Prep Players under rigid conditions.  At Marquette University he participated in the Marquette University Players under the Rev.  John J...", url:"https://themoviedb.org/person/14987"}}, {tmdbId:"1243", properties:{bornIn:"The Bronx, New York City, New York, USA", imdbId:"0000095", born:date('1935-12-01'), name:"Woody Allen", bio:"Woody Allen (born Allen Stewart Konigsberg; December 1, 1935) is an American screenwriter, film director, actor, comedian, writer, musician, and playwright.  Allen's distinctive films, which run the gamut from dramas to screwball sex comedies, have made him a notable American director.  He is also distinguished by his rapid rate of production and his very large body of work.  Allen writes and directs his movies and has also acted in the majority of them...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wcPQgZLDibuej1RwNTy1R2U2ZJw.jpg", url:"https://themoviedb.org/person/1243"}}, {tmdbId:"3087", properties:{bornIn:"San Diego, California, USA", imdbId:"0000380", born:date('1931-01-05'), name:"Robert Duvall", bio:"Robert Selden Duvall (born January 5, 1931) is an American actor and director.  He has won an Academy Award, two Emmy Awards, and four Golden Globe Awards over the course of his career.  Duvall has been in some of the most acclaimed and popular films of all time, among them To Kill a Mockingbird, The Godfather, The Godfather Part II, MASH, Network, True Grit, Bullitt, The Conversation, Apocalypse Now, Tender Mercies, The Natural and Lonesome Dove...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2TBraRu1vWjUItXtXAII8z6Pvs9.jpg", url:"https://themoviedb.org/person/3087"}}, {tmdbId:"8930", properties:{bornIn:"Weston-Super-Mare, Somerset, England, UK", imdbId:"0000092", born:date('1939-10-27'), name:"John Cleese", bio:"John Marwood Cleese (born 27 October 1939) is an English actor, comedian, writer and film producer.  He achieved success at the Edinburgh Festival Fringe, and as a scriptwriter and performer on The Frost Report.  In the late 1960s he became a member of Monty Python, the comedy troupe responsible for the sketch show Monty Python's Flying Circus and the four Monty Python films: And Now for Something Completely Different, Holy Grail, Life of Brian and The Meaning of Life...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kg63gNYQtGPi2fSNIvCnVAclCbi.jpg", url:"https://themoviedb.org/person/8930"}}, {tmdbId:"280", properties:{bornIn:"Minneapolis, Minnesota, USA", imdbId:"0000416", born:date('1940-11-22'), name:"Terry Gilliam", bio:"Terrence Vance \"Terry\" Gilliam is an American-British screenwriter, film director, animator, actor and member of the Monty Python comedy troupe.  Gilliam is also known for directing several films, including Time Bandits (1981), Brazil (1985), The Adventures of Baron Munchausen (1988), The Fisher King (1991), 12 Monkeys (1995), Fear and Loathing in Las Vegas (1998) and The Imaginarium of Doctor Parnassus (2009).  He is the only \"Python\" not born in Britain; he took British citizenship in 1968...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dnI56oXeTBmNgj6ibnUqoHvmau6.jpg", url:"https://themoviedb.org/person/280"}}, {tmdbId:"129482", properties:{bornIn:"Minneapolis, Minnesota, U.S.", imdbId:"0490871", born:date('1931-08-10'), name:"Tom Laughlin", bio:"From Wikipedia, the free encyclopedia. \n\nTom Laughlin (born August 10, 1931) is an American actor, director, screenwriter, author, educator and political activist.  Laughlin is best known for his series of Billy Jack films.  He has been married to Delores Taylor since 1954.  Taylor has also co-produced and acted in all four of the Billy Jack films.  His unique promotion of The Trial of Billy Jack was a major influence on the way films are marketed...", died:date('2013-12-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fPD8HQ355BLgiecFlg1Z5skIOjz.jpg", url:"https://themoviedb.org/person/129482"}}, {tmdbId:"4415", properties:{bornIn:"Rimini, Emilia-Romagna, Italy", imdbId:"0000019", born:date('1920-01-20'), name:"Federico Fellini", bio:"Federico Fellini, Knight Grand Cross (January 20, 1920 – October 31, 1993), was an Italian film director and screenwriter.  Known for a distinct style that blends fantasy and baroque images, he is considered one of the most influential and widely revered filmmakers of the 20th century. \n\nPersonal and highly idiosyncratic visions of society, Fellini's films are a unique combination of memory, dreams, fantasy and desire...", died:date('1993-10-31'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/g2bf6j08VBocJMVvOK7sEYqBX91.jpg", url:"https://themoviedb.org/person/4415"}}, {tmdbId:"130137", properties:{imdbId:"1373935", name:"David Evans", url:"https://themoviedb.org/person/130137"}}, {tmdbId:"19429", properties:{bornIn:"San Francisco, California, USA", imdbId:"0000045", born:date('1940-11-27'), name:"Bruce Lee", bio:"Bruce Jun Fan Lee (Lee Siu Loong) was born in 1940 in San Francisco, CA while his parents were on tour with the Chinese Opera.  Ultimately raised in Hong Kong, Bruce Lee was a child actor appearing in more than 20 films.  At the age of 13, Bruce took up the study of wing chun gung fu under renowned wing chun master, Yip Man. \n\nBruce left Hong Kong at the age of 18, came to the United States and made his way to Seattle, Washington where he worked in the restaurant of a family friend...", died:date('1973-07-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uUC3N3sIuFLD0ZpNyc58NxW1Pzf.jpg", url:"https://themoviedb.org/person/19429"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor:Director;
UNWIND [{tmdbId:"55119", properties:{bornIn:"Tocopilla, Chile", imdbId:"0423524", born:date('1929-02-07'), name:"Alejandro Jodorowsky", bio:"From Wikipedia, the free encyclopedia. \n\nAlejandro Jodorowsky Prullansky, known as Alejandro Jodorowsky (born 17 February 1929) is a Chilean filmmaker, playwright, composer and writer with a large cult following.  Best known for his avant-garde films, he has been \"venerated by cult cinema enthusiasts\" for his work which \"is filled with violently surreal images and a hybrid blend of mysticism and religious provocation...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q3VIqsCXbhcurRzxx2ws2j7y6hd.jpg", url:"https://themoviedb.org/person/55119"}}, {tmdbId:"22767", properties:{bornIn:"Mexico City, Distrito Federal, Mexico", imdbId:"0000778", born:date('1932-01-11'), name:"Alfonso Arau", bio:"Alfonso Arau is a Mexican actor and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5ishPim5akWXSnMbwOWSc3KxDx8.jpg", url:"https://themoviedb.org/person/22767"}}, {tmdbId:"14277", properties:{bornIn:"Zoppot, Free City of Danzig [now Sopot, Pomorskie, Poland]", imdbId:"0001428", born:date('1926-10-18'), name:"Klaus Kinski", bio:"​From Wikipedia, the free encyclopedia\n\nNikolaus Karl Günther Nakszyński, best known as Klaus Kinski (18 October 1926 – 23 November 1991), was a German actor.  He appeared in over 130 films, and is perhaps best-remembered as a leading role actor in Werner Herzog films: Aguirre, the Wrath of God (1972), Nosferatu (1979), Woyzeck (1979), Fitzcarraldo (1982) and Cobra Verde (1987)...", died:date('1991-11-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/twuyGlZJzJXFcbhVS2jlQOsTVFK.jpg", url:"https://themoviedb.org/person/14277"}}, {tmdbId:"12988", properties:{bornIn:"Cambridge, Massachusetts, United States", imdbId:"0001274", born:date('1943-03-25'), name:"Paul Michael Glaser", bio:"From Wikipedia, the free encyclopedia. \n\nPaul Michael Glaser (born March 25, 1943) is an American actor and director, perhaps best known for his role as Detective David Starsky on the 1970s television series Starsky and Hutch; he also appeared as Captain Jack Steeper on the 1999 to 2005 NBC series Third Watch...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aNos5u2GpMXu3p9KoVIk9AcU0cr.jpg", url:"https://themoviedb.org/person/12988"}}, {tmdbId:"1158", properties:{bornIn:"New York City, New York, USA", imdbId:"0000199", born:date('1940-04-25'), name:"Al Pacino", bio:"Alfredo James \"Al\" Pacino (born April 25, 1940) is an American film and stage actor and director.  He is famous for playing mobsters, including Michael Corleone in The Godfather trilogy, Tony Montana in Scarface, Alphonse \"Big Boy\" Caprice in Dick Tracy and Carlito Brigante in Carlito's Way, though he has also appeared several times on the other side of the law — as a police officer, detective and a lawyer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sLsw9Dtj4mkL8aPmCrh38Ap9Xhq.jpg", url:"https://themoviedb.org/person/1158"}}, {tmdbId:"9309", properties:{bornIn:"Peoria, Illinois, USA", imdbId:"0001640", born:date('1940-12-01'), name:"Richard Pryor", bio:"Richard Franklin Lennox Thomas Pryor was an American stand-up comedian, actor, film director, social critic, satirist, writer, and MC.   Pryor was known for uncompromising examinations of racism and topical contemporary issues, which employed colorful vulgarities, and profanity, as well as racial epithets.  He reached a broad audience with his trenchant observations and storytelling style...", died:date('2005-12-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gAKIhP0HPv1dyezF2Ut3SReuWyh.jpg", url:"https://themoviedb.org/person/9309"}}, {tmdbId:"3092", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0000473", born:date('1946-01-05'), name:"Diane Keaton", bio:"American film actress Diane Keaton (Born Diane Hall), began her career on stage and got her first major role in the Broadway rock musical \"Hair\" as understudy to the lead.  Keaton made her film debut in the 1972 screen adaptation of Woody Allen’s Broadway play \"Play It Again, Sam\".  That same year Keaton was cast in her first major film role as Kay Adams-Corleone in the Oscar-winning movie “The Godfather”...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7gEdH5vGwpUpogscTb2JivnoRBb.jpg", url:"https://themoviedb.org/person/3092"}}, {tmdbId:"40230", properties:{bornIn:" Philadelphia, Pennsylvania, USA", imdbId:"0393661", born:date('1958-09-19'), name:"Kevin Hooks", bio:"​From Wikipedia, the free encyclopedia.   \n\nKevin Hooks (born September 19, 1958) is an American actor, and a television and film director; he is notable from his roles in Aaron Loves Angela &amp; Sounder, but may be best-known as Morris Thorpe from TV's The White Shadow.  In 1986, he starred in the short-lived ABC sitcom He's the Mayor.  He directed Wesley Snipes in Passenger 57 and also Laurence Fishburne and Stephen Baldwin in Fled...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zQIkzw1QsQvnjgLb5TMO4jyoqFY.jpg", url:"https://themoviedb.org/person/40230"}}, {tmdbId:"6159", properties:{bornIn:"Duncan, Oklahoma, USA", imdbId:"0000165", born:date('1954-03-01'), name:"Ron Howard", bio:"Ronald William Howard (born March 1, 1954) is an American filmmaker and actor.  Howard first came to prominence as a child actor, guest-starring in several television series, including an episode of The Twilight Zone.  He gained national attention for playing young Opie Taylor, the son of Sheriff Andy Taylor (played by Andy Griffith) in the sitcom The Andy Griffith Show from 1960 through 1968...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vU0OIMRJPp7pB3fq5mfSH7rx9Nf.jpg", url:"https://themoviedb.org/person/6159"}}, {tmdbId:"1270", properties:{bornIn:"Van Nuys, California, USA", imdbId:"0001747", born:date('1953-10-30'), name:"Charles Martin Smith", bio:"Charles Martin Smith (born October 30, 1953) is an American film actor, writer, and director. \n\nDescription above from the Wikipedia article  Charles Martin Smith, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uzm5v0Q7nCH223EvPiJyh9Y0qiN.jpg", url:"https://themoviedb.org/person/1270"}}, {tmdbId:"380", properties:{bornIn:"Greenwich Village, New York City, New York, USA", imdbId:"0000134", born:date('1943-08-17'), name:"Robert De Niro", bio:"Robert De Niro, Jr.  (born August 17, 1943) is an American actor, director, and producer. \n\nHis first major film role was in 1973's Bang the Drum Slowly.  In 1974, he played the young Vito Corleone in The Godfather Part II, a role that won him the Academy Award for Best Supporting Actor.  His longtime collaboration with Martin Scorsese began with 1973's Mean Streets, and earned De Niro an Academy Award for Best Actor for his portrayal of Jake LaMotta in the 1980 film, Raging Bull...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cT8htcckIuyI1Lqwt1CvD02ynTh.jpg", url:"https://themoviedb.org/person/380"}}, {tmdbId:"21958", properties:{bornIn:"New York City, New York, USA", imdbId:"0753073", born:date('1934-03-23'), name:"Mark Rydell", bio:"From Wikipedia, the free encyclopedia. \n\nMark Rydell (born March 23, 1935 , in New York City) is an American actor, film director and producer.  He has directed many Academy Award-nominated films including The Fox (1967), The Reivers (1969), Cinderella Liberty (1973), The Rose (1979), The River (1984) and For the Boys (1991).  He was nominated for an Academy Award for Best Director for On Golden Pond (1981). \n\nRydell's initial training was in music.  As a youth, he wanted to be a conductor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5UP43cVTYcdMY2DkyBrYQILYHk7.jpg", url:"https://themoviedb.org/person/21958"}}, {tmdbId:"6593", properties:{bornIn:"Nevada, Missouri, USA", imdbId:"0001379", born:date('1906-08-05'), name:"John Huston", bio:"John Marcellus Huston (August 5, 1906 – August 28, 1987) was an American film director, screenwriter, actor, and visual artist.  He wrote the screenplays for most of the 37 feature films he directed, many of which are today considered classics: The Maltese Falcon (1941), The Treasure of the Sierra Madre (1948), The Asphalt Jungle (1950), The African Queen (1951), The Misfits (1961), Fat City (1972), The Man Who Would Be King (1975) and Prizzi's Honor (1985)...", died:date('1987-08-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eNAADfV8UXLTRvcIwqkxqnzHEUN.jpg", url:"https://themoviedb.org/person/6593"}}, {tmdbId:"58499", properties:{bornIn:"Dunkirk, New York, USA", imdbId:"0355181", born:date('1940-10-18'), name:"H.B. Halicki", bio:"Henry Blight Halicki (October 18, 1940 – August 20, 1989), most commonly known as H.  B.  \"Toby\" Halicki, was an American director, writer, stunt driver, actor, and filmmaker.  Halicki directed the 1974 film Gone in 60 Seconds as well as producing and starring in several other action films.  He was killed in an accident while filming Gone in 60 Seconds 2 in 1989.  Wishing to preserve his legacy, his widow, Denice Shakarian Halicki, produced a remake in 2000 along with Jerry Bruckheimer...", died:date('1989-08-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tEnOoHgp3ND23dF3NDJmE0gBvhc.jpg", url:"https://themoviedb.org/person/58499"}}, {tmdbId:"99339", properties:{imdbId:"0788553", name:"Ken Shapiro", url:"https://themoviedb.org/person/99339"}}, {tmdbId:"16483", properties:{bornIn:"New York City, New York, USA", imdbId:"0000230", born:date('1946-07-06'), name:"Sylvester Stallone", bio:"An American actor and filmmaker.  He is well known for his Hollywood action roles, including boxer Rocky Balboa in the Rocky series' eight films from 1976 to 2018; soldier John Rambo from the five Rambo films, released between 1982 and 2019; and Barney Ross in the three The Expendables films from 2010 to 2014.  He wrote or co-wrote most of the 16 films in all three franchises, and directed many of the films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qDRGPAcQoW8Wuig9bvoLpHwf1gU.jpg", url:"https://themoviedb.org/person/16483"}}, {tmdbId:"35040", properties:{bornIn:"Bennington, Omaha, Nebraska, USA", imdbId:"0931437", born:date('1940-09-19'), name:"Paul Williams", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hfBFenLU5reDGVi4wiP5P1VcP3G.jpg", url:"https://themoviedb.org/person/35040"}}, {tmdbId:"16927", properties:{bornIn:"Châteauroux, Indre, France", imdbId:"0000367", born:date('1948-12-27'), name:"Gérard Depardieu", bio:"Gérard Xavier Marcel Depardieu (born 27 December 1948) is a French actor, film-maker, businessman and vineyard owner.  He is one of the most prolific character actors in film history, having completed approximately 170 movies since 1967.  He has twice won the César Award for Best Actor as well as the Golden Globe award for Best Actor in Green Card...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cibkIAJN6ctlqHohhdDEcfbiCAL.jpg", url:"https://themoviedb.org/person/16927"}}, {tmdbId:"1748", properties:{bornIn:"Montreal, Quebec, Canada", imdbId:"0000638", born:date('1931-03-22'), name:"William Shatner", bio:"From Wikipedia, the free encyclopedia\n\nWilliam Shatner (born March 22, 1931) is a Canadian actor, musician, singer, author, film director, spokesman and comedian...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7lsjbNFMGj3kYYWoMk1LNnl4p5P.jpg", url:"https://themoviedb.org/person/1748"}}, {tmdbId:"2725", properties:{bornIn:"Bad Wörishofen, Germany", imdbId:"0001202", born:date('1945-05-31'), name:"Rainer Werner Fassbinder", bio:"Rainer Werner Fassbinder was a German film director, screenwriter, and actor.  He is one of the most important figures in the New German Cinema.   Fassbinder was prolific; in a professional career that lasted less than fifteen years, he completed forty feature length films, two television film series, three short films, four video productions, twenty-four stage plays, and four radio plays...", died:date('1982-06-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xll1qAg0TOzcuNlfZWEEKB1JxqR.jpg", url:"https://themoviedb.org/person/2725"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor:Director;
UNWIND [{tmdbId:"32552", properties:{bornIn:"Wöllersdorf, Austria", imdbId:"0396998", born:date('1922-05-18'), name:"Adrian Hoven", died:date('1981-04-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/myyHWz27BQVZ3aoTeerMl0IueTG.jpg", url:"https://themoviedb.org/person/32552"}}, {tmdbId:"8966", properties:{bornIn:"Broadstairs, Kent, England, UK", imdbId:"0732430", born:date('1946-05-02'), name:"Bruce Robinson", bio:"From Wikipedia, the free encyclopedia\n\nBruce Robinson (born 2 May 1946) is an English director, screenwriter, novelist and actor.  He is arguably most famous for writing and directing the cult classic Withnail and I, a film with comic and tragic elements, set in London during the 1960s which drew on his experiences as ' a chronic alcoholic and resting actor, living in squalor' in Camden Town...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/psdhzgK6X3pkHdK4MpURu4U4Hpg.jpg", url:"https://themoviedb.org/person/8966"}}, {tmdbId:"71732", properties:{bornIn:"Houston, Texas, USA ", imdbId:"0557751", born:date('1934-06-01'), name:"Peter Masterson", bio:"Carlos Bee Masterson Jr.  was an American actor, director, producer, and writer.   Masterson often worked with his cousin, writer Horton Foote.  Acting from the mid-1960s to the mid-1980s, including 1975's The Stepford Wives as Walter Eberhart, since then he concentrated mostly on directing and producing.  Actress Mary Stuart Masterson is his daughter; she appeared with her father in The Stepford Wives, playing one of his daughters...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/A5vHAGwbGJqHp5B9GBQsT6uNqKC.jpg", url:"https://themoviedb.org/person/71732"}}, {tmdbId:"1038", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0000149", born:date('1962-11-19'), name:"Jodie Foster", bio:"Alicia Christian \"Jodie\" Foster (born November 19, 1962) is an American actress and director.  She has received two Academy Awards, three British Academy Film Awards, two Golden Globe Awards, and the Cecil B.  DeMille Award.  For her work as a director, she has been nominated for a Primetime Emmy Award. \n\nFoster began her professional career as a child model when she was three years old, and she made her acting debut in 1968 in the television sitcom Mayberry R. F. D...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qAdHh0E86ZbEKqsWLgOfIYxxXHH.jpg", url:"https://themoviedb.org/person/1038"}}, {tmdbId:"57110", properties:{imdbId:"0453987", name:"Bruce Kimmel", url:"https://themoviedb.org/person/57110"}}, {tmdbId:"3556", properties:{bornIn:"Paris, France", imdbId:"0000591", born:date('1933-08-18'), name:"Roman Polanski", bio:"Roman Polanski (born 18 August 1933) is a Polish-French film director, producer, writer and actor.  Born in Paris to Polish parents, Polanski relocated with his family to Poland in 1937.  After surviving the Holocaust, he continued his education in Poland and became a critically acclaimed director of both art house and commercial films.  Polanski's first feature-length film, Knife in the Water (1962), made in Poland, was nominated for an Academy Award for Best Foreign Language Film...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5Kks5RMO2az5YOcFJjYXiDt4qH1.jpg", url:"https://themoviedb.org/person/3556"}}, {tmdbId:"7795", properties:{bornIn:"New York City, New York, USA", imdbId:"0377750", born:date('1930-12-09'), name:"Buck Henry", bio:"Buck Henry (born Henry Zuckerman; December 9, 1930 – January 8, 2020) was an American actor, screenwriter, and director.  Henry's contributions to film included, his work as a co-director on Heaven Can Wait (1978) alongside Warren Beatty, and his work as a co-writer for Mike Nichols's The Graduate (1967) and Peter Bogdanovich's What's Up, Doc? (1972).  His long career began on television with work on shows with Steve Allen in The New Steve Allen Show (1961)...", died:date('2020-01-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gWowaG4B9Z0UlvZn4hjlvq7kWZU.jpg", url:"https://themoviedb.org/person/7795"}}, {tmdbId:"14639", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0000316", born:date('1926-06-28'), name:"Mel Brooks", bio:"From Wikipedia, the free encyclopedia. \n\nMelvin Brooks (né Kaminsky, born June 28, 1926) is an American filmmaker, comedian, actor and composer.  He is known as a creator of broad film farces and comic parodies.  Brooks began his career as a comic and a writer for the early TV variety show Your Show of Shows.  He became well known as part of the comedy duo with Carl Reiner in the comedy skit The 2000 Year Old Man...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c21qNcMJlHnRolfhQhZOVacjtwI.jpg", url:"https://themoviedb.org/person/14639"}}, {tmdbId:"12987", properties:{bornIn:"Milwaukee, Wisconsin, USA", imdbId:"0001878", born:date('1947-10-16'), name:"David Zucker", bio:"From Wikipedia, the free encyclopedia\n\nDavid Zucker (born October 16, 1947) is an American film director, producer and screenwriter. \n\nDescription above from the Wikipedia article David Zucker, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cNUQHuGB4wy7TSPoP6irW78dpX8.jpg", url:"https://themoviedb.org/person/12987"}}, {tmdbId:"2176", properties:{bornIn:"San Saba, Texas, USA", imdbId:"0000169", born:date('1946-09-15'), name:"Tommy Lee Jones", bio:"Tommy Lee Jones (born September 15, 1946) is an American actor and film director. \n\nHe has received three Academy Award nominations, winning one as Best Supporting Actor for the 1993 thriller film The Fugitive.  His notable film roles include federal marshal Samuel Gerard in The Fugitive and its sequel U. S.  Marshals, the villain \"Two-Face\" in Batman Forever, terrorist William Strannix in Under Siege, Agent K in the Men in Black films, former Texas Ranger Woodrow F...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zixpaPmOonRh1I3TWgxDkeGxkrv.jpg", url:"https://themoviedb.org/person/2176"}}, {tmdbId:"21278", properties:{bornIn:"New York City, New York, USA", imdbId:"0000257", born:date('1936-01-28'), name:"Alan Alda", bio:"Alan Alda  (born January 28, 1936) is an American actor, director, screenwriter, and author.  A six-time Emmy Award and Golden Globe Award winner, he is best known for his role as Hawkeye Pierce in the TV series MAS*H.  He is currently a visiting professor at the Stony Brook University School of Journalism...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a5tOOHdsrKSabKwdzDOYqeTp446.jpg", url:"https://themoviedb.org/person/21278"}}, {tmdbId:"18897", properties:{bornIn:"Victoria Peak, Hong Kong", imdbId:"0000329", born:date('1954-04-07'), name:"Jackie Chan", bio:"Jackie Chan (Chinese: 成龍; born 7 April 1954), born Chan Kong-sang, is a Hong Kong actor, action choreographer, filmmaker, comedian, producer, martial artist, screenwriter, entrepreneur, singer and stunt performer.  In his movies, he is known for his acrobatic fighting style, comic timing, use of improvised weapons, and innovative stunts.  Jackie Chan has been acting since the 1970s and has appeared in over 100 films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sVuTm1w5G6ofrx4lRjy64D7MRiS.jpg", url:"https://themoviedb.org/person/18897"}}, {tmdbId:"20006", properties:{bornIn:"New York City - New York - USA", imdbId:"0001659", born:date('1952-09-25'), name:"Christopher Reeve", bio:"From Wikipedia, the free encyclopedia\n\nChristopher D'Olier Reeve (September 25, 1952 – October 10, 2004) was an American actor, film director, producer, screenwriter and author.  He achieved stardom for his acting achievements, including his notable motion picture portrayal of the fictional superhero Superman. \n\nOn May 27, 1995, Reeve became a quadriplegic after being thrown from a horse in an equestrian competition in Virginia...", died:date('2004-10-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vAGrPf3ajy6OVE3FhgABynZfybP.jpg", url:"https://themoviedb.org/person/20006"}}, {tmdbId:"11159", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0001507", born:date('1946-07-13'), name:"Cheech Marin", bio:"From Wikipedia, the free encyclopedia. \n\nRichard Anthony \"Cheech\" Marin (born July 13, 1946) is an American comedian and actor who gained recognition as part of the comedy act Cheech & Chong during the 1970s and early 1980s, and as Don Johnson's partner, Insp.  Joe Dominguez on Nash Bridges.  He has also voiced characters in several Disney movies, including Oliver and Company, The Lion King, Cars and its 2011 sequel...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eecHDNRn9K80ZcuSocsMhQb2G1i.jpg", url:"https://themoviedb.org/person/11159"}}, {tmdbId:"63208", properties:{bornIn:"Edmonton, Alberta, Canada", imdbId:"0001045", born:date('1938-05-24'), name:"Tommy Chong", bio:"From Wikipedia, the free encyclopedia. \n\nTommy Chong (born May 24, 1938) is a Canadian-American comedian, actor and musician who is well-known for his stereotypical portrayals of hippie-era stoners.  He is most widely known for his involvement in the marijuana-themed Cheech & Chong comedy movies with Cheech Marin, as well as playing the character Leo on Fox's That '70s Show. \n\nDescription above from the Wikipedia article Tommy Chong, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xjAZc5IB4iPAlqpUbtM1LkcUAhI.jpg", url:"https://themoviedb.org/person/63208"}}, {tmdbId:"707", properties:{bornIn:"Ottawa, Ontario, Canada", imdbId:"0000101", born:date('1952-07-01'), name:"Dan Aykroyd", bio:"Daniel Edward \"Dan\" Aykroyd, CM (born July 1, 1952) is a Canadian comedian, actor, screenwriter, musician, winemaker and ufologist.  He was an original cast member of Saturday Night Live, an originator of The Blues Brothers (with John Belushi) and Ghostbusters and has had a long career as a film actor and screenwriter...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gJcfD01UrOpzE8IednQlyKD4BMM.jpg", url:"https://themoviedb.org/person/707"}}, {tmdbId:"11511", properties:{bornIn:"Bethesda, Maryland, USA", imdbId:"0827663", born:date('1957-08-28'), name:"Daniel Stern", bio:"​From Wikipedia, the free encyclopedia.   \n\nDaniel Jacob Stern (born August 28, 1957) is an American film and television actor.  He is known for his roles in the Hollywood films C. H. U. D. , City Slickers and the first two Home Alone films, and as the narrator for the television series The Wonder Years. \n\nDescription above from the Wikipedia article Daniel Stern , licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cEn9kJMKZN9ojSPUpkLB7qNAk3K.jpg", url:"https://themoviedb.org/person/11511"}}, {tmdbId:"39104", properties:{bornIn:"the Bronx, New York, U.S.", imdbId:"0001206", born:date('1951-07-19'), name:"Abel Ferrara", bio:"Abel Ferrara is an American movie screenwriter and director.  He is best known as an independent filmmaker of such films as The Driller Killer (1979), Ms.  45 (1981), King of New York (1990), Bad Lieutenant (1992) and The Funeral (1996)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wWyt14GTVm98OXdGihO8xeE4ZYL.jpg", url:"https://themoviedb.org/person/39104"}}, {tmdbId:"2461", properties:{bornIn:"Peekskill, New York, USA", imdbId:"0000154", born:date('1956-01-03'), name:"Mel Gibson", bio:"An actor, film director, producer and screenwriter.  Born in Peekskill, New York, Gibson moved with his parents to Sydney, Australia when he was 12 years old and later studied acting at the Australian National Institute of Dramatic Art.  After appearing in the Mad Max and Lethal Weapon series, Gibson went on to direct and star in the Academy Award-winning Braveheart...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6l9aF05kmPBcdcFpLzYbPlmPtJv.jpg", url:"https://themoviedb.org/person/2461"}}, {tmdbId:"1532", properties:{bornIn:"Wilmette, Illinois, USA", imdbId:"0000195", born:date('1950-09-21'), name:"Bill Murray", bio:"William James \"Bill\" Murray (born September 21, 1950) is an American actor and comedian.  He first gained national exposure on Saturday Night Live and later went on to star in a number of critically and commercially successful comedic films, including Caddyshack (1980), Ghostbusters (1984), and Groundhog Day (1993)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nnCsJc9x3ZiG3AFyiyc3FPehppy.jpg", url:"https://themoviedb.org/person/1532"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor:Director;
UNWIND [{tmdbId:"55983", properties:{bornIn:"Greenville, Mississippi, USA", imdbId:"0001345", born:date('1936-09-24'), name:"Jim Henson", bio:"Jim Henson was an American film director, television producer and puppeteer, best known as the creator of The Muppets...", died:date('1990-05-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mb5iH36utDBZr0ZtdspIwXQP1De.jpg", url:"https://themoviedb.org/person/55983"}}, {tmdbId:"7908", properties:{bornIn:"Hereford, Herefordshire, England, United Kingdom ", imdbId:"0000568", born:date('1944-05-25'), name:"Frank Oz", bio:"Frank Oz born Richard Frank Oznowicz;  is a British-born American film director, actor, voice actor and puppeteer who is known for creating and performing the characters Miss Piggy and Fozzie Bear in The Muppet Show and for directing films, including the 1986 Little Shop Of Horrors remake and Dirty Rotten Scoundrels.  He is also the operator and voice of Yoda in the Star Wars series...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hAArPKPyYpYI79fuYdKdeQWY5zS.jpg", url:"https://themoviedb.org/person/7908"}}, {tmdbId:"13", properties:{bornIn:"Beverly Hills, California, USA", imdbId:"0000983", born:date('1947-07-22'), name:"Albert Brooks", bio:"Albert Lawrence Brooks (born Albert Lawrence Einstein; July 22, 1947) is an American actor, voice actor, writer, comedian and director.  He received an Academy Award nomination in 1987 for his role in Broadcast News.  His voice acting credits include Marlin the clownfish in Finding Nemo and recurring guest voices for the animated television series The Simpsons and Russ Cargill in its film adaptation The Simpsons Movie...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8iDSGu5l93N7benjf6b3AysBore.jpg", url:"https://themoviedb.org/person/13"}}, {tmdbId:"1749", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0000559", born:date('1931-03-26'), name:"Leonard Nimoy", bio:"Leonard Nimoy was an American actor, film director, poet, musician and photographer.  Nimoy's most famous role is that of Spock in the original Star Trek series 1966–1969, multiple films, television and video game sequels. \n\nNimoy began his career in his early twenties, teaching acting classes in Hollywood and making minor film and television appearances through the 1950s, as well as playing the title role in Kid Monk Baroni.  In 1953, he served in the United States Army...", died:date('2015-02-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vyo1sOdwEIP8adhts3UpelyiBwn.jpg", url:"https://themoviedb.org/person/1749"}}, {tmdbId:"10367", properties:{bornIn:"Baltimore, Maryland, USA", imdbId:"0000691", born:date('1946-04-22'), name:"John Waters", bio:"Growing up in Baltimore in the 1950s, John Waters was not like other children; he was obsessed by violence and gore, both real and on the screen.  With his weird counter-culture friends as his cast, he began making silent 8mm and 16mm films in the mid-'60s; he screened these in rented Baltimore church halls to underground audiences drawn by word of mouth and street leafleting campaigns...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4foU1kJ24CJwz2RVZgyc7oxMs4i.jpg", url:"https://themoviedb.org/person/10367"}}, {tmdbId:"12438", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0000837", born:date('1945-08-16'), name:"Bob Balaban", bio:"Robert Elmer Balaban is an American actor, author, producer, and director.  He was one of the producers nominated for the Academy Award for Best Picture for Gosford Park, in which he also appeared...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lYwYgrOiPDD9Q4rCPXm1h2Bjmbt.jpg", url:"https://themoviedb.org/person/12438"}}, {tmdbId:"69791", properties:{bornIn:"San Francisco, California, U.S.", imdbId:"0354024", born:date('1943-06-02'), name:"Charles Haid", bio:"From Wikipedia, the free encyclopedia. \n\nCharles Maurice Haid III (born June 2, 1943) is an American actor and director, with notable work in both movies and television.  He is known for his portrayal of Officer Andy Renko in Hill Street Blues. \n\nHaid was born in San Francisco, California, the son of Grace Marian (née Folger) and Charles Maurice Haid, Jr.  He attended Carnegie Institute of Technology (now Carnegie Mellon University), where he met Steven Bochco...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/39kBH9dpc1pwer9Ra1gOKSvbX4W.jpg", url:"https://themoviedb.org/person/69791"}}, {tmdbId:"22354", properties:{bornIn:"Watford, England, UK", imdbId:"0588184", born:date('1942-08-19'), name:"David Miller", url:"https://themoviedb.org/person/22354"}}, {tmdbId:"33054", properties:{bornIn:"New York City, New York, USA", imdbId:"0330360", born:date('1961-02-03'), name:"Keith Gordon", bio:"Keith Gordon is an American actor and film director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qh2MpLx2B5CYZVKJz2VLXEuRMBC.jpg", url:"https://themoviedb.org/person/33054"}}, {tmdbId:"24173", properties:{bornIn:"Detroit, Michigan, U.S.", imdbId:"0082802", born:date('1958-06-02'), name:"Mike Binder", bio:"​From Wikipedia, the free encyclopedia.   \n\nMike Binder (born June 2, 1958) is an American film director, screenwriter, producer and actor. \n\nDescription above from the Wikipedia article Mike Binder, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/24173"}}, {tmdbId:"408", properties:{bornIn:"Savannah, Georgia, USA", imdbId:"0005077", born:date('1947-12-07'), name:"James Keach", bio:"From Wikipedia, the free encyclopedia\n\nJames Keach (born December 7, 1947) is an American actor, producer, and director.  He is the younger brother of actor Stacy Keach, Jr. , and son of actor Stacy Keach, Sr. \n\nDescription above from the Wikipedia article James Keach, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fvy4gGSHcKnbRlgL07XfiI7udXk.jpg", url:"https://themoviedb.org/person/408"}}, {tmdbId:"6818", properties:{bornIn:" Munich, Bavaria, Germany", imdbId:"0001348", born:date('1942-09-05'), name:"Werner Herzog", bio:"Werner Herzog (German: [ˈvɛɐ̯nɐ ˈhɛɐ̯tsoːk]; born 5 September 1942) is a German film director, screenwriter, author, actor, and opera director.  Herzog is a figure of the New German Cinema.  His films often feature ambitious protagonists with impossible dreams, people with unique talents in obscure fields, or individuals who are in conflict with nature. \n\nWerner Herzog made his first film in 1961 at the age of 19...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qKlz1oM482Xf0jTPfLiR6qXlLYK.jpg", url:"https://themoviedb.org/person/6818"}}, {tmdbId:"2171", properties:{bornIn:"New York City, New York, USA", imdbId:"0001162", born:date('1955-06-08'), name:"Griffin Dunne", bio:"Griffin Dunne (born June 8, 1955) is an American actor and film director, known for his roles in An American Werewolf in London (1981) and After Hours (1985)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zfeYJZzApMFlTrR67O01iLAnAC4.jpg", url:"https://themoviedb.org/person/2171"}}, {tmdbId:"10594", properties:{bornIn:"Liverpool, England, UK", imdbId:"0823592", born:date('1940-07-07'), name:"Ringo Starr", bio:"Richard Starkey, MBE (born 7 July 1940), better known by his stage name Ringo Starr, is an English musician, singer-songwriter, and actor who gained worldwide fame as the drummer for The Beatles.  When the band formed in 1960, Starr was a member of another Liverpool band, Rory Storm and the Hurricanes.  He became The Beatles' drummer in August 1962, taking the place of Pete Best...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7fSrrdl90BYdR3dtOnNkosOw0kw.jpg", url:"https://themoviedb.org/person/10594"}}, {tmdbId:"51962", properties:{bornIn:"Philadelphia, PA, USA", imdbId:"0001070", born:date('1937-07-12'), name:"Bill Cosby", bio:"William Henry \"Bill\" Cosby, Jr.  (born July 12, 1937) is an American comedian, actor, author, television producer, educator, musician and activist.  A veteran stand-up performer, he got his start at various clubs; then landed a starring role in the 1960s action show, I Spy.  He later starred in his own series, the situation comedy The Bill Cosby Show, in 1969...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uvnJvaIguD6vPCZ1a8wuXlaElgZ.jpg", url:"https://themoviedb.org/person/51962"}}, {tmdbId:"59442", properties:{bornIn:"Valley Stream, Long Island, New York, USA", imdbId:"0059229", born:date('1956-07-19'), name:"Peter Barton", bio:"​From Wikipedia, the free encyclopedia.   \n\nPeter Thomas Barton (born July 19, 1956) is an American actor.  He was a graduate of Valley Stream North High School, where he played soccer and wrestled.  He also attended Nassau Community College.  In the 1980s and 1990s, he starred in several TV series, including Shirley, with Shirley Jones; The Powers of Matthew Star, with Louis Gossett, Jr. ; Burke's Law with Gene Barry; and the soap operas Sunset Beach and The Young and the Restless...", url:"https://themoviedb.org/person/59442"}}, {tmdbId:"17494", properties:{bornIn:"Wheaton, Illinois, USA", imdbId:"0240797", born:date('1946-09-05'), name:"Dennis Dugan", bio:"American director, comedian, and actor Dennis Dugan started his acting career in 1972, appearing in the 1973 made for TV movie” The Girl Most Likely to. . . ”  He is well known for his frequent collaborations with comedic actor Adam Sandler. \n\nDennis has also made a career as a television and film director, and appears in cameo parts in many of his films.  Dugan has directed episodes of such television series as Moonlighting (was also a guest star in some episodes), Ally McBeal, and NYPD Blue...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3QH2wJ1eVBLT3Vi2GNVO5TayXEB.jpg", url:"https://themoviedb.org/person/17494"}}, {tmdbId:"228", properties:{bornIn:"Englewood, New Jersey, USA", imdbId:"0000438", born:date('1950-11-28'), name:"Ed Harris", bio:"Ed Harris is an American stage, film and television actor, writer, producer and director, best known for playing supporting characters in feature films such as \"Apollo 13\", \"A Beautiful Mind\", and \"The Truman Show\", as well as many recurring and starring roles in television shows, among them the portrayal of The Man in Black in HBO's \"Westworld\".  He holds a BFA in Drama from the California Institute of the Arts, Valencia, USA...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kUbUA70WPiosPT4kBJMWtGk0ASd.jpg", url:"https://themoviedb.org/person/228"}}, {tmdbId:"11161", properties:{bornIn:"Pittsburgh, Pennsylvania, United States", imdbId:"0767741", born:date('1946-11-03'), name:"Tom Savini", bio:"From Wikipedia, the free encyclopedia.   Thomas Vincent \"Tom\" Savini (born November 3, 1946) is an American actor, stuntman, director, award-winning special effects and makeup artist.   He is known for his work on the Living Dead films directed by George A.  Romero, as well as Creepshow, The Burning, Friday the 13th, The Prowler, and Maniac.  He directed the 1990 remake of Night of the Living Dead...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2eUw64Wi0beunf9GpaITUe4fp4q.jpg", url:"https://themoviedb.org/person/11161"}}, {tmdbId:"1524", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0000601", born:date('1944-11-21'), name:"Harold Ramis", bio:"Harold Allen Ramis was an American actor, director, and writer, specializing in comedy.  His best-known film acting roles are as Egon Spengler in Ghostbusters (1984) and Russell Ziskey in Stripes (1981), both of which he co-wrote.  As a writer/director, his films include the comedies Caddyshack (1980), Groundhog Day (1993), and Analyze This (1999)...", died:date('2014-02-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fxB7M2gUlYMqhCmYkzGNcaW8Oh5.jpg", url:"https://themoviedb.org/person/1524"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor:Director;
UNWIND [{tmdbId:"2228", properties:{bornIn:"Santa Monica, California, USA", imdbId:"0000576", born:date('1960-08-17'), name:"Sean Penn", bio:"An American actor, screenwriter and film director, also known for his political and social activism.  He is a two-time Academy Award winner for his roles in Mystic River (2003) and Milk (2008), as well as the recipient of a Golden Globe Award for the former and a Screen Actors Guild Award for the latter.   Penn began his acting career in television with a brief appearance in a 1974 episode of Little House on the Prairie, directed by his father Leo Penn...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lpZRNf56TmPsNNWZ7lhcgFM6rBc.jpg", url:"https://themoviedb.org/person/2228"}}, {tmdbId:"587", properties:{bornIn:"Los Angeles, California, U.S.", imdbId:"0001579", born:date('1947-02-24'), name:"Edward James Olmos", bio:"A Mexican American actor and director.  Among his most memorable roles are William Adama in the re-imagined Battlestar Galactica, Lt.  Martin Castillo in Miami Vice, teacher Jaime Escalante in Stand and Deliver, patriarch Abraham Quintanilla in the film Selena, Detective Gaff in Blade Runner, and narrator El Pachuco in both the stage and film versions of Zoot Suit. \n\nDescription above from the Wikipedia article Edward James Olmos, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mXnilUrQBIMLHSQkPjQk99mX70x.jpg", url:"https://themoviedb.org/person/587"}}, {tmdbId:"776", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0000552", born:date('1961-04-03'), name:"Eddie Murphy", bio:"Edward \"Eddie\" Regan Murphy (born April 3, 1961) is an American actor, voice actor, film director, producer, comedian and singer. \n\nHe is the second-highest grossing actor in motion picture history.  He was a regular cast member on Saturday Night Live from 1980 to 1984, and has worked as a stand-up comedian.  He was ranked #10 on Comedy Central's list of the 100 Greatest Stand-ups of All Time...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qgjMfefsKwSYsyCaIX46uyOXIpy.jpg", url:"https://themoviedb.org/person/776"}}, {tmdbId:"35350", properties:{bornIn:"Vancouver, British Columbia, Canada", imdbId:"0001743", born:date('1948-01-29'), name:"Marc Singer", bio:"Marc Singer (born January 29, 1948) is a Canadian-born American actor best known for his roles in the Beastmaster film series and as Mike Donovan in the original 1980s TV series V. \n\nDescription above from the Wikipedia article Marc Singer, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/npgKM5FfPKnAukzV11pXOlLeBnZ.jpg", url:"https://themoviedb.org/person/35350"}}, {tmdbId:"4724", properties:{bornIn:"Philadelphia, Pennsylvania, USA", imdbId:"0000102", born:date('1958-07-08'), name:"Kevin Bacon", bio:"Kevin Norwood Bacon (born July 8, 1958) is an American film and theater actor whose notable roles include Animal House, Diner, Footloose, Flatliners, A Few Good Men, Apollo 13, Mystic River, The Woodsman, Friday the 13th, Hollow Man, Tremors and Frost/Nixon. \n\nBacon has won Golden Globe and Screen Actors Guild Awards, was nominated for an Emmy Award, and was named by The Guardian as one of the best actors never to have received an Academy Award nomination...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rjX2Oz3tCZMfSwOoIAyEhdtXnTE.jpg", url:"https://themoviedb.org/person/4724"}}, {tmdbId:"101377", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0000860", born:date('1938-08-06'), name:"Paul Bartel", bio:"Paul Bartel was an American actor, writer and director.  Bartel was perhaps most known for his 1982 hit black comedy Eating Raoul, which he wrote, starred in and directed...", died:date('2000-05-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eXeUaLNs5OOKEQmIzCimIaQYZUv.jpg", url:"https://themoviedb.org/person/101377"}}, {tmdbId:"11357", properties:{bornIn:"Birmingham, Michigan, USA", imdbId:"0132257", born:date('1958-06-22'), name:"Bruce Campbell", bio:"Bruce Lorne Campbell (born June 22, 1958) is an American actor, producer, writer and director.  One of his best-known roles is portraying Ash Williams in Sam Raimi's Evil Dead franchise, beginning with the 1978 short film Within the Woods.  He has starred in many low-budget cult films such as Crimewave, Maniac Cop, Sundown: The Vampire in Retreat, and Bubba Ho-Tep...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vR46yp0Bx9Y198DtiDHnamyr610.jpg", url:"https://themoviedb.org/person/11357"}}, {tmdbId:"10431", properties:{bornIn:"Hollywood, Los Angeles, California, USA", imdbId:"0000492", born:date('1962-02-05'), name:"Jennifer Jason Leigh", bio:"Jennifer Jason Leigh began acting on television during the 1970s, guest-starring on several television shows, and her film breakthrough came in 1982 for her performance as Stacy Hamilton in Fast Times at Ridgemont High.  In 2015, she received widespread critical acclaim for performance as  Daisy Domergue in Quentin Tarantino's The Hateful Eight, for which she was nominated for the Golden Globe, Critics' Choice, BAFTA and the Academy Award for Best Supporting Actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7CpqvYVCI6Sq07zgQYxHRydevpk.jpg", url:"https://themoviedb.org/person/10431"}}, {tmdbId:"42745", properties:{bornIn:"Queens, New York City, New York, USA", imdbId:"0031078", born:date('1958-04-19'), name:"Steve Antin", bio:"​From Wikipedia, the free encyclopedia.   \n\nSteven Howard \"Steve\" Antin (born April 19, 1958) is an American actor, stunt man, screenwriter, producer, and director. \n\nDescription above from the Wikipedia article  Steven Antin, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/id9xROmosHeF1W4HqDu8oi2zeF3.jpg", url:"https://themoviedb.org/person/42745"}}, {tmdbId:"83313", properties:{bornIn:"Philadelphia, Pennsylvania, USA", imdbId:"0563039", born:date('1952-10-20'), name:"Melanie Mayron", bio:"Melanie Mayron is an American film and television actress and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p2dBLbvDR0tg1JyB7S27YPJ7lNo.jpg", url:"https://themoviedb.org/person/83313"}}, {tmdbId:"29383", properties:{bornIn:"New York City, New York, USA", imdbId:"0001942", born:date('1957-02-22'), name:"Luca Bercovici", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6iEWQqsNTarMHLYbM1HPXSYoBk3.jpg", url:"https://themoviedb.org/person/29383"}}, {tmdbId:"62410", properties:{bornIn:"Hong Kong, British Crown Colony [now China]", imdbId:"0005033", born:date('1952-01-07'), name:"Sammo Kam-Bo Hung", bio:"Sammo Hung (Chinese: 洪金寶, born Hung Kam Po, 7 January 1952) is a Hong Kong actor, martial artist, producer and director, known for his work in many kung fu films and Hong Kong action cinema.  He has been a fight choreographer for, amongst others, Jackie Chan, King Hu, and John Woo.  Hung is one of the pivotal figures who spearheaded the Hong Kong New Wave movement of the 1980s, helped reinvent the martial arts genre and started the vampire-like Jiang Shi genre...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hR3ofkY2tz8XpI9tx9ngDHKCpW0.jpg", url:"https://themoviedb.org/person/62410"}}, {tmdbId:"57082", properties:{bornIn:"Galveston, Texas, USA", imdbId:"0007082", born:date('1961-03-25'), name:"John Stockwell", bio:"From Wikipedia, the free encyclopedia\n\nJohn Stockwell (born March 25, 1961) is an American actor, director, producer, writer and former model. \n\nStockwell was born John Stockwell Samuels IV in Galveston, Texas, the son of an attorney.  His first feature film as an actor came in 1981's So Fine...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5XmsOQP1fdsELSPmCFuFWUVElfr.jpg", url:"https://themoviedb.org/person/57082"}}, {tmdbId:"12708", properties:{bornIn:"New York City, New York, US", imdbId:"0082526", born:date('1971-04-16'), name:"Peter Billingsley", bio:"From Wikipedia, the free encyclopedia.   \n\nPeter Billingsley (born 16 April 1971), also known as Peter Michaelsen and Peter Billingsley-Michaelsen, is an American actor, director, and producer best known for his role as Ralphie in the 1983 movie A Christmas Story.  He began his career as an infant, in television commercials. \n\nDescription above from the Wikipedia article Peter Billingsley licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2Aq3fcRbEifBWfOgBIbZdPDcDUW.jpg", url:"https://themoviedb.org/person/12708"}}, {tmdbId:"61961", properties:{bornIn:"St. Catharines, Ontario, Canada", imdbId:"0858686", born:date('1949-05-20'), name:"Dave Thomas", bio:"David \"Dave\" Thomas (born May 20, 1949) is a Canadian comedian and actor.  He was born in St.  Catharines, Ontario, but moved to Durham, North Carolina where his father, John E.  Thomas, attended Duke University and earned a PhD in Philosophy.  Thomas attended George Watts and Moorehead elementary schools...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aUU8H9o4jgOyV7D6nULrEiwi6mV.jpg", url:"https://themoviedb.org/person/61961"}}, {tmdbId:"8872", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"0001548", born:date('1953-04-18'), name:"Rick Moranis", bio:"Frederick Allan \"Rick\" Moranis (born April 18, 1953) is a retired Canadian comedian, actor and musician.  He came to prominence in the 1980s on Second City Television, before moving on to appearances in several Hollywood films, including Strange Brew; Ghostbusters; Spaceballs; Little Shop of Horrors; Honey, I Shrunk the Kids; Little Giants; Parenthood; The Flintstones, and My Blue Heaven...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rVZbTJjM4g0Um6trlLHRiBzBO7t.jpg", url:"https://themoviedb.org/person/8872"}}, {tmdbId:"57055", properties:{bornIn:"Cleveland, Ohio, USA", imdbId:"0509033", born:date('1956-03-10'), name:"Mitchell Lichtenstein", bio:"From Wikipedia, the free encyclopedia\n\nMitchell Wilson Lichtenstein (born 10 March 1956 in Cleveland, OH) is an openly gay American actor, writer, producer and director. \n\nLichtenstein studied acting at Bennington College in Vermont. \n\nIn Ang Lee's film The Wedding Banquet (1993), Lichtenstein played the partner of a gay Taiwanese man living in the United States who is forced to marry by his parents.  Other credits include Streamers (1983)...", url:"https://themoviedb.org/person/57055"}}, {tmdbId:"518", properties:{bornIn:"Asbury Park, New Jersey, USA", imdbId:"0000362", born:date('1944-11-17'), name:"Danny DeVito", bio:"Danny DeVito (born November 17, 1944) is an American actor, comedian, director, and producer.  He first gained prominence for his portrayal of Louie De Palma on Taxi, for which he won a Golden Globe and an Emmy. \n\nDeVito founded the production company Jersey Films with his wife Rhea Perlman...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gNHF2SNXFFCRqwIQ2Xv6r6aV6UD.jpg", url:"https://themoviedb.org/person/518"}}, {tmdbId:"31", properties:{bornIn:"Concord, California, USA", imdbId:"0000158", born:date('1956-07-09'), name:"Tom Hanks", bio:"Thomas Jeffrey Hanks (born July 9, 1956) is an American actor and filmmaker.  Known for both his comedic and dramatic roles, Hanks is one of the most popular and recognizable film stars worldwide, and is widely regarded as an American cultural icon. \n\nHanks made his breakthrough with leading roles in the comedies Splash (1984) and Big (1988)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mKr8PN8sn80LzVaZMg8L52kmakm.jpg", url:"https://themoviedb.org/person/31"}}, {tmdbId:"44990", properties:{bornIn:"Bellevue, Washington", imdbId:"0005022", born:date('1953-08-20'), name:"Peter Horton", bio:"​From Wikipedia, the free encyclopedia\n\nPeter Horton (born August 20, 1953) is an American actor and director.  He played the role of Prof.  Gary Shepherd on the popular television series Thirtysomething until 1991. \n\nDescription above from the Wikipedia article Peter Horton, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/44990"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor:Director;
UNWIND [{tmdbId:"69597", properties:{bornIn:"Culver City, California, USA", imdbId:"0000106", born:date('1975-02-22'), name:"Drew Barrymore", bio:"Drew Blyth Barrymore (born February 22, 1975) is an American film actress, producer, and director.  She is a member of the Barrymore family of American actors and granddaughter of John Barrymore.  She first appeared in an advertisement when she was 11 months old.  Barrymore made her film debut in Altered States in 1980.  Afterwards, she starred in her breakout role in E. T.  the Extra-Terrestrial...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9lCZyAKiS7dfmByA1tsuk3wCCGa.jpg", url:"https://themoviedb.org/person/69597"}}, {tmdbId:"5657", properties:{bornIn:"Santa Monica, California, USA", imdbId:"0001378", born:date('1951-07-08'), name:"Anjelica Huston", bio:"Anjelica Huston (born July 8, 1951) is an American actress.  Huston became the third generation of her family to win an Academy Award, for her performance in 1985's Prizzi's Honor, joining her father, director John Huston, and grandfather, actor Walter Huston.  She later was nominated in 1989 and 1990 for her acting in Enemies, a Love Story and The Grifters respectively...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6hnYeHa7Rc1w1MmQ3JsLSIb7yCX.jpg", url:"https://themoviedb.org/person/5657"}}, {tmdbId:"6949", properties:{bornIn:"Christopher, Illinois, USA", imdbId:"0000518", born:date('1953-12-09'), name:"John Malkovich", bio:"An American actor, producer, director, and fashion designer.  Over the last 30 years of his career, Malkovich has appeared in more than 70 motion pictures.  For his roles in Places in the Heart and In the Line of Fire, he received Academy Award nominations...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5coH0AExljEnbseCXKL4CDOVQj8.jpg", url:"https://themoviedb.org/person/6949"}}, {tmdbId:"9894", properties:{bornIn:"St. Pölten, Austria", imdbId:"0926919", born:date('1919-10-28'), name:"Bernhard Wicki", bio:"​From Wikipedia, the free encyclopedia. \n\nBernhard Wicki  (28 October 1919 in St.  Pölten, Austria - 5 January 2000 in Munich) was an Austrian actor and film director. \n\nWicki studied in the city of Breslau such topics as Art History, History und German Literature.  In 1938, he transferred to the Schauspielschule des Staatlichen Schauspielhauses (drama school) in Berlin...", died:date('2000-01-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/f7xRocSVPUkLlxUBEGUW2lNfX7v.jpg", url:"https://themoviedb.org/person/9894"}}, {tmdbId:"2880", properties:{bornIn:"New York City, New York, USA", imdbId:"0000389", born:date('1962-05-12'), name:"Emilio Estevez", bio:"Emilio Estévez is an American actor, film director, and writer.  He started his career as an actor and is well-known for being a member of the acting Brat Pack of the 1980s, starring in The Breakfast Club and St.  Elmo's Fire.  He is also known for Repo Man, The Mighty Ducks and its sequels, Maximum Overdrive, Bobby (which he also wrote and directed), and his performances in Western films such as Young Guns and its sequel.  One of his first appearances was as \"Two-Bit\" in The Outsiders...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lTyufiVNbc0WS6y8NVRN04hqow0.jpg", url:"https://themoviedb.org/person/2880"}}, {tmdbId:"26510", properties:{bornIn:"Hamilton, Ontario, Canada", imdbId:"0506405", born:date('1946-12-17'), name:"Eugene Levy", bio:"Eugene Levy (born December 17, 1946) is a Canadian actor, television director, producer, musician, and writer.  He is known for his work in Canadian television series, American movies, and television movies.  He is the only actor to have starred in all seven of the American Pie films, as Noah Levenstein. \n\nDescription above from the Wikipedia article Eugene Levy, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i2cyjoGr63nWdSkcW4MNumpIYCk.jpg", url:"https://themoviedb.org/person/26510"}}, {tmdbId:"7678", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"0000952", born:date('1956-10-03'), name:"Hart Bochner", bio:"​From Wikipedia, the free encyclopedia. \n\nHart Matthew Bochner  (born October 3, 1956) is a Canadian film actor, screenwriter, director, and producer. \n\nBochner was born in Toronto, Ontario, the son of Ruth (née Roher), a concert pianist, and actor Lloyd Bochner. \n\nBochner appeared in such films as Islands in the Stream (1977), Breaking Away (1979), Terror Train (1980), Rich and Famous (1981), Supergirl (1984) and Die Hard (1988)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p6SEDorodWckJG9Kz70N95UR27X.jpg", url:"https://themoviedb.org/person/7678"}}, {tmdbId:"77133", properties:{bornIn:"Birmingham, Michigan, U.S.", imdbId:"0001441", born:date('1950-04-04'), name:"Christine Lahti", bio:"From Wikipedia, the free encyclopedia.  Christine Lahti (born April 4, 1950) is an Academy Award winning American actress and film director. \n\nDescription above from the Wikipedia article Christine Lahti, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8tN2asTuDxdGuzWU6PrPYDNFDlc.jpg", url:"https://themoviedb.org/person/77133"}}, {tmdbId:"3026", properties:{bornIn:"The Bronx, New York, USA", imdbId:"0001661", born:date('1947-03-06'), name:"Rob Reiner", bio:"Robert Norman \"Rob\" Reiner (born March 6, 1947) is an American actor, director, producer, writer, and political activist. \n\nAs an actor, Reiner first came to national prominence as Archie and Edith Bunker's (played by Carroll O'Connor and Jean Stapleton, respectively) son-in-law, Michael \"Meathead\" Stivic, on All in the Family.  That role earned him two Emmy Awards during the 1970s...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/axu2DtYr0W0QUcQUqylzYgIU7hB.jpg", url:"https://themoviedb.org/person/3026"}}, {tmdbId:"2165", properties:{bornIn:"New York City, New York, USA", imdbId:"0000275", born:date('1959-08-10'), name:"Rosanna Arquette", bio:"Rosanna Lisa Arquette is an American actress, director and producer, nominated for an Emmy Award for her performance in the TV film The Executioner's Song, and won the BAFTA Award for Best Actress in a Supporting Role for the film Desperately Seeking Susan.  Her other film roles include After Hours, The Big Blue, Pulp Fiction, and Crash...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n6OBhzo8qs9ZZfbLyqvPJYYTHgq.jpg", url:"https://themoviedb.org/person/2165"}}, {tmdbId:"1269", properties:{bornIn:" Lynwood, California, USA", imdbId:"0000126", born:date('1955-01-18'), name:"Kevin Costner", bio:"Kevin Michael Costner is an American actor, singer, musician, producer, director, and businessman.  He has been nominated for three BAFTA (British Academy of Film and Television Arts) Awards, won two Academy Awards, and two Golden Globe Awards.  Costner's roles include Lt.  John J...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bykmxJHLfbFM3NT05RZXhx8YTzF.jpg", url:"https://themoviedb.org/person/1269"}}, {tmdbId:"122449", properties:{bornIn:"Hampton, Virginia, USA", imdbId:"0416945", born:date('1952-02-19'), name:"Steve James", bio:"From Wikipedia, the free encyclopedia. \n\nSteve James is an American film producer and director of several documentaries, including the award-winning Hoop Dreams and Stevie.  He is also the director of the 1997 feature film Prefontaine.  His newest film, The Interrupters, a portrayal of a year inside the lives of former gang members in Chicago who now intervene in violent conflicts, will be released in 2011 after premiering at the Sundance Film Festival...", died:date('1993-12-18'), url:"https://themoviedb.org/person/122449"}}, {tmdbId:"10747", properties:{bornIn:"Cairo, Egypt", imdbId:"0271501", born:date('1949-08-17'), name:"Julian Fellowes", bio:"Julian Alexander Kitchener-Fellowes, Baron Fellowes of West Stafford, DL (born 17 August 1949), known as Julian Fellowes, is an English actor, novelist, film director and screenwriter, as well as a Conservative peer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hRWGCVNRkeu61lh3NRmfRym9yOp.jpg", url:"https://themoviedb.org/person/10747"}}, {tmdbId:"2395", properties:{bornIn:"New York City, New York, USA", imdbId:"0000155", born:date('1955-11-13'), name:"Whoopi Goldberg", bio:"An American comedian, actress, singer-songwriter, political activist, and talk show host.  Goldberg made her film debut in The Color Purple (1985) playing Celie, a mistreated black woman in the Deep South.  She received a nomination for the Academy Award for Best Actress and won her first Golden Globe Award for her role in the film.  In 1990, she starred as Oda Mae Brown, a psychic helping a slain man (Patrick Swayze) find his killer in the blockbuster film Ghost...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yuxwjw8msCh1IH27vzpttvkZVIo.jpg", url:"https://themoviedb.org/person/2395"}}, {tmdbId:"569", properties:{bornIn:"Austin, Texas, USA", imdbId:"0000160", born:date('1970-11-06'), name:"Ethan Hawke", bio:"Ethan Green Hawke (born November 6, 1970) is an American actor, writer and director.  He made his feature film debut in 1985 with the science fiction movie Explorers, before making a supporting appearance in the 1989 drama Dead Poets Society which is considered his breakthrough role.  He then appeared in such films as White Fang (1991), A Midnight Clear (1992), and Alive (1993) before taking a role in the 1994 Generation X drama Reality Bites, for which he gained critical acclaim...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a7rgJl8TYUWAfJuM4fxbLHgD7BL.jpg", url:"https://themoviedb.org/person/569"}}, {tmdbId:"26473", properties:{bornIn:"Chicago, Illinois, USA ", imdbId:"0001770", born:date('1963-11-27'), name:"Fisher Stevens", bio:"Fisher Stevens is an American stage and screen actor, director, writer and producer.  In 2010, he was honoured with an Academy Award in the category \"Best Documentary Feature\" for his movie \"The Cove\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/TutpOyw0A6FF5hEoFDYseI2EVN.jpg", url:"https://themoviedb.org/person/26473"}}, {tmdbId:"2053", properties:{bornIn:"Fort Worth, Texas, USA", imdbId:"0000200", born:date('1955-05-17'), name:"Bill Paxton", bio:"Bill Paxton (May 17, 1955 - February 25, 2017) was an American actor.  He appeared in films including Aliens and Titanic and starred as practising polygamist Bill Henrickson in the HBO series Big Love.  On February 25, 2017 he died from complications following heart surgery...", died:date('2017-02-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aLdNe6mt1cSi2zWlUYRregzfis5.jpg", url:"https://themoviedb.org/person/2053"}}, {tmdbId:"43553", properties:{bornIn:"Łódź, Poland", imdbId:"0804592", born:date('1938-05-05'), name:"Jerzy Skolimowski", bio:"Jerzy Skolimowski (born May 5, 1938) is a Polish film director, screenwriter, dramatist and actor.  A graduate of the prestigious National Film School in Łódź, Skolimowski has directed more than twenty films since his 1960 début Oko wykol (The Menacing Eye).  He lived in Los Angeles for over 20 years where he painted in a figurative, expressionist mode and acted occasionally in films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5yQ5GDNHTXrYrvT9ZcPk6VfrrgJ.jpg", url:"https://themoviedb.org/person/43553"}}, {tmdbId:"57147", properties:{bornIn:"Lightning Ridge, New South Wales, Australia", imdbId:"0001357", born:date('1939-10-08'), name:"Paul Hogan", bio:"Paul Hogan, AM (born 8 October 1939) is an Australian actor of best known for his role as Michael \"Crocodile\" Dundee from the Crocodile Dundee film series, for which he won a Golden Globe award. \n\nDescription above from the Wikipedia article Paul Hogan, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1QQURn65Q2yeDCaGIaLktd6kUPx.jpg", url:"https://themoviedb.org/person/57147"}}, {tmdbId:"27875", properties:{bornIn:"Haarlem, Noord-Holland, Netherlands", imdbId:"0912334", born:date('1952-08-14'), name:"Alex van Warmerdam", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a2luT69Tcxu9FcaBXBwd98IRuCn.jpg", url:"https://themoviedb.org/person/27875"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor:Director;
UNWIND [{tmdbId:"17114", properties:{bornIn:"El Paso, Texas, United States", imdbId:"0593463", born:date('1963-04-21'), name:"John Cameron Mitchell", bio:"John Cameron Mitchell is an American writer, actor and director, best known for the movies \"Hedwig and the Angry Inch\", \"Shortbus\" and \"Rabbit Hole\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iDyhkjtgy7U8xl9tKk9xcJA3yEY.jpg", url:"https://themoviedb.org/person/17114"}}, {tmdbId:"2223", properties:{bornIn:"Chicago, Illinois, USA ", imdbId:"0000625", born:date('1976-07-09'), name:"Fred Savage", bio:"Fred Savage (born July 9, 1976) is an American actor, director and producer of television and film. \n\nHe is best known for his role as Kevin Arnold in the American television series The Wonder Years and as the grandson in The Princess Bride. \n\nIn later years, he has directed and produced numerous episodes of television series, such as Ned's Declassified School Survival Guide, Hannah Montana, and Phil of the Future, as well as the primetime series Ugly Betty and It's Always Sunny In Philadelphia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ux4TBPjG2kZDUlDiKb6eBK7BBFl.jpg", url:"https://themoviedb.org/person/2223"}}, {tmdbId:"55265", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0001738", born:date('1966-08-05'), name:"Jonathan Silverman", bio:"From Wikipedia, the free encyclopedia.   Jonathan E.  Silverman (born August 5, 1966) is an American actor. \n\nDescription above from the Wikipedia article Jonathan E.  Silverman, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tHTJUxFyI2PNwxp8EiRlmKNUdh2.jpg", url:"https://themoviedb.org/person/55265"}}, {tmdbId:"4818", properties:{bornIn:"Manciano La Misericordia, Castiglion Fiorentino, Arezzo, Italia", imdbId:"0000905", born:date('1952-10-27'), name:"Roberto Benigni", bio:"From Wikipedia, the free encyclopedia\n\nRoberto Remigio Benigni, Knight Grand Cross OMRI (born 27 October 1952) is an Italian actor, comedian, screenwriter and director of film, theatre and television. \n\nDescription above from the Wikipedia article Roberto Benigni, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/noelOhwX1oaNSvU9NLKhPrHTFI3.jpg", url:"https://themoviedb.org/person/4818"}}, {tmdbId:"504", properties:{bornIn:"West Covina, California, USA", imdbId:"0000209", born:date('1958-10-16'), name:"Tim Robbins", bio:"Timothy Francis Robbins (born October 16, 1958) is an American actor, screenwriter, director, producer, and musician.  He is best known for his portrayal of Andy Dufresne in the prison drama film The Shawshank Redemption (1994)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hsCu1JUzQQ4pl7uFxAVFLOs9yHh.jpg", url:"https://themoviedb.org/person/504"}}, {tmdbId:"58040", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0540330", born:date('1934-02-04'), name:"Bruce Malmuth", bio:"​From Wikipedia, the free encyclopedia.   \n\nBruce Malmuth (February 4, 1934 - June 29, 2005 of esophageal cancer) was an American actor and film director. \n\nDescription above from the Wikipedia article Bruce Malmuth, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2005-06-29'), url:"https://themoviedb.org/person/58040"}}, {tmdbId:"3131", properties:{bornIn:"Málaga, Andalucía, Spain", imdbId:"0000104", born:date('1960-08-10'), name:"Antonio Banderas", bio:"José Antonio Domínguez Bandera (born August 10, 1960), known professionally as Antonio Banderas, is a Spanish actor, producer, director, and singer.  He began his acting career at age 19 with a series of films by director Pedro Almodóvar and then appeared in high-profile Hollywood films, especially in the 1990s, including Assassins, Evita, Interview with the Vampire, Philadelphia, Desperado, The Mask of Zorro, Spy Kids, the Shrek sequels and Puss in Boots...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/50GhCzQuaI5Ul01NEyJZloeVP7g.jpg", url:"https://themoviedb.org/person/3131"}}, {tmdbId:"2178", properties:{bornIn:"Longview, Texas, USA", imdbId:"0001845", born:date('1961-07-15'), name:"Forest Whitaker", bio:"Forest Steven Whitaker III (born July 15, 1961) is an American actor, producer, and director. \n\nHe has earned a reputation for intensive character study work for films such as Lee Daniels' The Butler, Bird and Ghost Dog: The Way of the Samurai,for his work in direct-to-video films and for his recurring role as LAPD Internal Affairs Lieutenant Jon Kavanaugh on the award-winning television series The Shield...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fugyEeN6sisuYi07HSoxdVHm0CZ.jpg", url:"https://themoviedb.org/person/2178"}}, {tmdbId:"6384", properties:{bornIn:"Beirut, Lebanon", imdbId:"0000206", born:date('1964-09-02'), name:"Keanu Reeves", bio:"Keanu Charles Reeves is a Canadian actor.  Reeves is known for his roles in Bill &amp; Ted's Excellent Adventure, Speed, Point Break, and The Matrix trilogy as Neo.  He has collaborated with major directors such as Stephen Frears (in the 1988 period drama Dangerous Liaisons); Gus Van Sant (in the 1991 independent film My Own Private Idaho); and Bernardo Bertolucci (in the 1993 film Little Buddha)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d9HyjGMCt4wgJIOxAGlaYWhKsiN.jpg", url:"https://themoviedb.org/person/6384"}}, {tmdbId:"7904", properties:{bornIn:"Long Beach, Long Island, New York, USA", imdbId:"0000345", born:date('1948-03-14'), name:"Billy Crystal", bio:"William Edward \"Billy\" Crystal (born March 14, 1948) is an American actor, writer, producer, comedian and film director.  He gained prominence in the 1970s for playing Jodie Dallas on the ABC sitcom Soap and became a Hollywood film star during the late 1980s and 1990s, appearing in the critical and box office successes When Harry Met Sally. . .  and City Slickers.  He has hosted the Academy Awards eight times...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nLVT3OFx58ePsESSBJ9XWCMq28d.jpg", url:"https://themoviedb.org/person/7904"}}, {tmdbId:"5281", properties:{bornIn:"Atlanta, Georgia, USA", imdbId:"0000490", born:date('1957-03-20'), name:"Spike Lee", bio:"Spike Lee was born Shelton Lee in 1957, in Atlanta, Georgia.  At a very young age, he moved from pre-civil rights Georgia, to Brooklyn, New York.  Lee came from a proud and intelligent background.  His father was a jazz musician, and his mother, a school teacher.  His mother dubbed him Spike, due to his tough nature.  He attended school in Morehouse College in Atlanta and developed his film making skills at Clark Atlanta University...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2KOHXgk2uoRXl6u7V9xpAIo3uay.jpg", url:"https://themoviedb.org/person/5281"}}, {tmdbId:"126620", properties:{bornIn:"Charlotte, North Carolina, USA", imdbId:"0568478", born:date('1947-07-21'), name:"Ross McElwee", bio:"From Wikipedia, the free encyclopedia. \n\nRoss McElwee is an American documentary filmmaker and cinematographer, and Harvard professor, known for his autobiographical films about his family and personal life, usually interwoven with an episodic journey of some sort.  McElwee is a 1971 graduate of Brown University, and received his MS from MIT in 1977.  He received the Career Award at the 2007 Full Frame Documentary Film Festival...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h0hGY95OYCC5g0JF0aLCyY6dish.jpg", url:"https://themoviedb.org/person/126620"}}, {tmdbId:"64", properties:{bornIn:"New Cross, London, England, UK", imdbId:"0000198", born:date('1958-03-21'), name:"Gary Oldman", bio:"Gary Leonard Oldman (born 21 March 1958) is an English actor, filmmaker and musician, well-known to audiences for his portrayals of dark and morally ambiguous characters.  He has starred in films such as Sid and Nancy, Prick Up Your Ears, JFK, Dracula, True Romance, Léon, The Fifth Element, The Contender, the Harry Potter film series and the Batman film series, as well as in television shows such as Friends and Fallen Angels...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2v9FVVBUrrkW2m3QOcYkuhq9A6o.jpg", url:"https://themoviedb.org/person/64"}}, {tmdbId:"3078", properties:{bornIn:"Dumbarton, Dunbartonshire, Scotland, UK", imdbId:"0126154", born:date('1952-05-14'), name:"David Byrne", bio:"David Byrne (born May 14, 1952) is a Scottish-born musician most associated with his role as a founding member and principal songwriter of the American band Talking Heads, which was active between 1975 and 1991.  Since then, Byrne has released his own solo recordings and worked with various media including film, photography, opera, and non-fiction.  He has received Grammy, Oscar, and Golden Globe awards and been inducted to the Rock and Roll Hall of Fame...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iyD9S1hvyWjtiAedZAACDcWKuaf.jpg", url:"https://themoviedb.org/person/3078"}}, {tmdbId:"937111", properties:{imdbId:"0453723", name:"Y.K. Kim", url:"https://themoviedb.org/person/937111"}}, {tmdbId:"15111", properties:{bornIn:"Sint-Agatha Berchem, Belgium", imdbId:"0000241", born:date('1960-10-18'), name:"Jean-Claude Van Damme", bio:"Van Damme was born Jean-Claude Camille François van Varenberg in Berchem-Sainte-Agathe, Brussels, Belgium, to Eliana and Eugène van Varenberg, an accountant.  “The Muscles from Brussels” started martial arts at the age of eleven.  His father introduced him to martial arts when he saw his son was physically weak.  At the age of 12, van Damme began his martial arts training at Centre National De Karate (National Center of Karate) under the guidance of Master Claude Goetz in Ixelles, Belgium...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vugNQUOjsNGRO4nDAi3oHCDucI7.jpg", url:"https://themoviedb.org/person/15111"}}, {tmdbId:"95024", properties:{bornIn:"Syracuse, New York, USA", imdbId:"0001281", born:date('1962-05-26'), name:"Bobcat Goldthwait", bio:"Robert Francis \"Bobcat\" Goldthwait is an American screen and voice actor, comedian, screenwriter, and film and television director.   He became recognized as a solo stand-up comedian and had a record \"Meat Bob\" and two televised concert specials in the 1980s.  During the fall of 1993, he performed stand-up material as an opening act for Nirvana on what would be their final North American tour...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dvx9ykvmZnpLJhXqdMx3rF00Mx7.jpg", url:"https://themoviedb.org/person/95024"}}, {tmdbId:"18342", properties:{bornIn:"New York City, New York, USA", imdbId:"0333804", born:date('1959-10-22'), name:"Todd Graff", bio:"From Wikipedia, the free encyclopedia. \n\nTodd Graff (born October 22, 1959) is an American actor, writer and director, best known for his 2003 independent film Camp...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nA8idC01PtLDWBdxWgan7RFiIMz.jpg", url:"https://themoviedb.org/person/18342"}}, {tmdbId:"1241", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0001806", born:date('1957-02-28'), name:"John Turturro", bio:"John Michael Turturro (born February 28, 1957) is an Italian American actor, writer, and director known for his roles in the films The Big Lebowski (1998), O Brother, Where Art Thou? (2000), and The Batman (2021).  He has appeared in over sixty films, and has worked frequently with the Coen brothers, Adam Sandler, and Spike Lee...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rNgTqu5ILeUlBLJsDh8mJtpLfOV.jpg", url:"https://themoviedb.org/person/1241"}}, {tmdbId:"68750", properties:{bornIn:"Chicago, Illinois, USA ", imdbId:"0870186", born:date('1957-02-06'), name:"Robert Townsend", bio:"Robert Townsend was born on February 6, 1957 in Chicago, Illinois.  He is an actor, comedian, film director, and writer.  In 1974, Townsend auditioned for parts at Chicago's Experimental Black Actors' Guild and performed in local plays studying at the famed Second City comedy workshop for improvisation.  He enrolled at Illinois State University and a year and later moved to New York to study at the Negro Ensemble Company.  Townsend had a brief un-credited role in the movie Cooley High (1975)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/saXSXNW1G1Wt9kN4r4Chjxm3YcU.jpg", url:"https://themoviedb.org/person/68750"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor:Director;
UNWIND [{tmdbId:"16214", properties:{bornIn:"Mexico City, Distrito Federal, Mexico", imdbId:"0005522", born:date('1957-01-15'), name:"Mario Van Peebles", bio:"​From Wikipedia, the free encyclopedia\n\nMario \"Chip\" Cain Van Peebles (born January 15, 1957) is an American director and actor who has appeared in numerous Hollywood films.  He is son of filmmaker Melvin Van Peebles. \n\nDescription above from the Wikipedia article Mario Van Peebles, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fiExKjVttfePRwmfVvMHPjC7F9n.jpg", url:"https://themoviedb.org/person/16214"}}, {tmdbId:"6720", properties:{bornIn:"Shanghai, China", imdbId:"0001040", born:date('1961-04-26'), name:"Joan Chen", bio:"Joan Chong Chen (born April 26, 1961) is a Chinese American actress, film director, screenwriter and film producer.  She became famous in China for her performance in the 1979 film Little Flower and came to international attention for her performance in the 1987 Academy Award-winning film The Last Emperor.  She is also known for her roles in Twin Peaks, Red Rose White Rose, Saving Face and The Home Song Stories, and for directing the feature film Xiu Xiu: The Sent Down Girl...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7uMTJpY8B2hufXqmlxJpaUPpcJi.jpg", url:"https://themoviedb.org/person/6720"}}, {tmdbId:"1103", properties:{bornIn:"Poughkeepsie, New York, USA", imdbId:"0004886", born:date('1943-02-26'), name:"Bill Duke", bio:"William Henry \"Bill\" Duke, Jr.  (born February 26, 1943) is an American actor and film director with over 30 years of experience.  Known for his physically imposing frame, Duke's work frequently dwells within the action/crime and drama genres but also includes comedy. \n\nDescription above from the Wikipedia article Bill Duke , licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3g2ggBB7hGq1gnQwiJtHgfX2AbF.jpg", url:"https://themoviedb.org/person/1103"}}, {tmdbId:"13524", properties:{bornIn:"New York City, New York, U.S.", imdbId:"0001302", born:date('1948-02-05'), name:"Christopher Guest", bio:"​From Wikipedia, the free encyclopedia.   \n\nThe Rt.  Hon.  Christopher Haden-Guest, 5th Baron Haden-Guest (born February 5, 1948), better known as Christopher Guest, is an American screenwriter, composer, musician, director, actor and comedian.  He is most widely known in Hollywood for having written, directed and starred in several improvisational \"mockumentary\" films that feature a repertory-like ensemble cast, such as This is Spinal Tap...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6CsixXuPyNTPaUtEBqNiXMMcYBF.jpg", url:"https://themoviedb.org/person/13524"}}, {tmdbId:"11275", properties:{bornIn:"Hampstead, London, England, UK", imdbId:"0000410", born:date('1957-08-24'), name:"Stephen Fry", bio:"From Wikipedia, the free encyclopedia. \n\nStephen John Fry (born 24 August 1957) is an English actor, screenwriter, author, playwright, journalist, poet, comedian, television presenter and film director, and a director of Norwich City Football Club.  He first came to attention in the 1981 Cambridge Footlights Revue presentation \"The Cellar Tapes\", which also included Hugh Laurie, Emma Thompson and Tony Slattery...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xeheTDmmQDFYaKxEHmyxbjrte4G.jpg", url:"https://themoviedb.org/person/11275"}}, {tmdbId:"2628", properties:{bornIn:"Paddington, London, England, UK", imdbId:"0000662", born:date('1966-12-21'), name:"Kiefer Sutherland", bio:"Kiefer Sutherland is a British-Canadian actor, producer and director, best known for his portrayal of Jack Bauer on the Fox thriller drama series 24.  He has won an Emmy Award and Golden Globe award.  He is the son of Canadian actors Donald Sutherland and Shirley Douglas...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zZDrEJDVkcZXjrzXMGQBPIlxhIz.jpg", url:"https://themoviedb.org/person/2628"}}, {tmdbId:"14405", properties:{bornIn:"Birmingham, Alabama, USA", imdbId:"0001073", born:date('1964-06-15'), name:"Courteney Cox", bio:"Courteney Bass Cox (born June 15, 1964) is an American actress, who achieved fame for her role as Monica Geller on the NBC sitcom Friends.  Cox has also starred in Dirt and the Scream series of movies.  She currently stars in the ABC sitcom Cougar Town, for which she earned her first Golden Globe nomination. \n\nDescription above from the Wikipedia article Courteney Cox, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a2NJbLwimILFYOVArpUuwS1pBAY.jpg", url:"https://themoviedb.org/person/14405"}}, {tmdbId:"35689", properties:{bornIn:"New York City, New York, USA", imdbId:"0005540", born:date('1958-06-08'), name:"Keenen Ivory Wayans", bio:"Keenen Ivory Wayans was born on June 8, 1958...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e9XRdXolDV8RjGPHPXH6IISDTSP.jpg", url:"https://themoviedb.org/person/35689"}}, {tmdbId:"1461", properties:{bornIn:"Lexington, Kentucky, USA", imdbId:"0000123", born:date('1961-05-06'), name:"George Clooney", bio:"An American actor, film director, producer, and screenwriter.  He has received three Golden Globe Awards for his work as an actor and two Academy Awards—one for acting and the other for producing.  Clooney is also noted for his political activism and has served as one of the United Nations Messengers of Peace since January 31, 2008...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kHiVY6r1k6juXrNetAYk2jILqn9.jpg", url:"https://themoviedb.org/person/1461"}}, {tmdbId:"126452", properties:{bornIn:"Giappone", imdbId:"0297872", born:date('1957-03-12'), name:"Kei Fujiwara", bio:"From Wikipedia, the free encyclopedia. \n\nKei Fujiwara (born March 12, 1957) is a Japanese actress, cinematographer, editor, writer and film director.  Her first role was in the American film, The Neptune Factor, but she is perhaps best known for starring in the Japanese cult film, Tetsuo: The Iron Man.  Recently she has devoted her time to writing and directing, and is known for her surreal and violent experimental films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mAGHrMoDdYnumFWSICoMREfaJ6L.jpg", url:"https://themoviedb.org/person/126452"}}, {tmdbId:"58608", properties:{bornIn:"Tokyo Prefecture, Japan", imdbId:"0875354", born:date('1960-01-01'), name:"Shin'ya Tsukamoto", bio:"Shinya Tsukamoto (born January 1, 1960) is a Japanese film director and actor with a considerable cult following both domestically and abroad...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lHt4zpGcyI7QVdFrmzJ2WqEJ5kt.jpg", url:"https://themoviedb.org/person/58608"}}, {tmdbId:"61797", properties:{bornIn:"Hunter Valley, New South Wales, Australia", imdbId:"0000635", born:date('1953-07-27'), name:"Yahoo Serious", bio:"​From Wikipedia, the free encyclopedia.   \n\nYahoo Serious (born 27 July 1953), born Greg Pead (name-change by deed poll in 1980), is an Australian film actor, director and score composer.  He is best known for his 1988 comedy Young Einstein.  He also created Reckless Kelly in 1993 and Mr.  Accident in 2000.  Serious writes, directs, produces, stars in, and has composed the scores for his movies...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9FVyS8etOL81knz84N0Wlo3LTVr.jpg", url:"https://themoviedb.org/person/61797"}}, {tmdbId:"98", properties:{bornIn:"\tToronto, Ontario, Canada", imdbId:"0001631", born:date('1979-01-08'), name:"Sarah Polley", bio:"Sarah Polley (born January 8, 1979) is a Canadian actress, singer, film director, and screenwriter.  Polley first attained notice in her role as Sara Stanley in the Canadian television series, Road to Avonlea.  She has also starred in such films as The Sweet Hereafter, Guinevere, Go, The Weight of Water, My Life Without Me, The Adventures of Baron Munchausen, Dawn of the Dead, Splice, and Mr.  Nobody...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qcdT6y6QEjaERHPUBC07YGKgR6k.jpg", url:"https://themoviedb.org/person/98"}}, {tmdbId:"1558", properties:{bornIn:"Copenhagen, Denmark", imdbId:"0469273", born:date('1947-03-02'), name:"Søren Kragh-Jacobsen", bio:"Søren Kragh-Jacobsen (born 2 March 1947 in Copenhagen) is a Danish film director, musician, and song writer.  He was one of the founders and practitioners of the Dogme95 project, for creating films without artificial technology or techniques. \n\nKragh-Jacobsen started out as a popular musician in Denmark, before attending film school in Prague.  After returning to Denmark, he directed and co-wrote television productions...", url:"https://themoviedb.org/person/1558"}}, {tmdbId:"10707", properties:{bornIn:"Colwyn Bay, Wales, UK", imdbId:"0001402", born:date('1942-02-01'), name:"Terry Jones", bio:"Terence Graham Parry Jones was a Welsh comedian, screenwriter, actor, film director, children's author, popular historian, political commentator, and TV documentary host.  He is best known as a member of the Monty Python comedy team. \n\nAt the age of 4, the Jones family moved to Surrey in England.  Jones attended primary school at Esher COE school and later attended the Royal Grammar School in Guildford, where he was school captain in the 1960-61 academic year...", died:date('2020-01-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/keJpqxK8gykrrK2W6yeSeDUbYDK.jpg", url:"https://themoviedb.org/person/10707"}}, {tmdbId:"5292", properties:{bornIn:"Mount Vernon, New York, United States", imdbId:"0000243", born:date('1954-12-28'), name:"Denzel Washington", bio:"Denzel Hayes Washington, Jr.  (born December 28, 1954) is an American actor, screenwriter, director and film producer.  He first rose to prominence when he joined the cast of the medical drama St.  Elsewhere, playing Dr.  Philip Chandler for six years.  He has received much critical acclaim for his work in film since the 1990s, including for his portrayals of real-life figures, such as Steve Biko, Malcolm X, Rubin \"Hurricane\" Carter, Melvin B.  Tolson, Frank Lucas, and Herman Boone...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8bSw5zpBYFo6zjazSIt4aZmiEjx.jpg", url:"https://themoviedb.org/person/5292"}}, {tmdbId:"5010", properties:{bornIn:"Pomona, California, USA", imdbId:"0276062", born:date('1964-02-24'), name:"Todd Field", bio:"From Wikipedia, the free encyclopedia. \n\nWilliam Todd Field, known professionally as Todd Field (born February 24, 1964) is an American actor and writer/director.  He has received three Academy Award nominations. \n\nDescription above from the Wikipedia article Todd Field, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dJZYO81fHPK0unjrlbqOtUuhcly.jpg", url:"https://themoviedb.org/person/5010"}}, {tmdbId:"11181", properties:{bornIn:"Belfast, Northern Ireland, UK", imdbId:"0000110", born:date('1960-12-10'), name:"Kenneth Branagh", bio:"Kenneth Charles Branagh (born December 10, 1960) is a Northern Irish-born English actor and film director.  He is best known for directing and starring in several film adaptations of William Shakespeare's plays, but has also appeared in a number of films and television series...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3BJ5izFVhPioT8BtYmAhugQThCS.jpg", url:"https://themoviedb.org/person/11181"}}, {tmdbId:"21175", properties:{bornIn:"Courbevoie, Seine [now Hauts-de-Seine], France", imdbId:"0003508", born:date('1952-04-16'), name:"Michel Blanc", bio:"Michel Blanc (born 16 April 1952 in Courbevoie, France) is a French actor and director who is noted for his roles of losers and hypochondriacs.  He is frequently associated with the Splendid group, which he co-founded, along with Thierry Lhermitte, Josiane Balasko, Christian Clavier and Gérard Jugnot.  Michel Blanc has also shown his versatility by appearing in more serious roles, such as the title role in the Patrice Leconte film Monsieur Hire...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mNa9bmpI7pv01diJXz8lT5jGRGA.jpg", url:"https://themoviedb.org/person/21175"}}, {tmdbId:"41285", properties:{bornIn:"Dublin, Ireland", imdbId:"0792202", born:date('1976-07-14'), name:"Kirsten Sheridan", bio:"Kirsten Sheridan (born July 14, 1976) is an Irish film director and screenwriter.  The director of August Rush (2007) and Disco Pigs (2001), Sheridan was nominated for an Academy Award for co-writing the semi-autobiographical film In America with her father, director Jim Sheridan, and her sister, Naomi Sheridan. \n\nDescription above from the Wikipedia article Kirsten Sheridan, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tgxwvotewbTyj18Eb2DAH2BkKcE.jpg", url:"https://themoviedb.org/person/41285"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor:Director;
UNWIND [{tmdbId:"37221", properties:{bornIn:"Greenfield, Massachusetts, United States", imdbId:"0422710", born:date('1955-03-05'), name:"Penn Jillette", bio:"Penn Jillette is an American magician, juggler, comedian, musician, inventor, actor, and best-selling author known for his work with fellow magician Teller as half of the team Penn &amp; Teller...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zmAaXUdx12NRsssgHbk1T31j2x9.jpg", url:"https://themoviedb.org/person/37221"}}, {tmdbId:"55189", properties:{bornIn:"Kingston, Ontario, Canada", imdbId:"0567680", born:date('1959-05-28'), name:"Bruce McDonald", bio:"Bruce McDonald (born May 28, 1959) is a Canadian film and television director, writer and producer.  He is known for his award-winning cult films Roadkill (1989) and Hard Core Logo (1996). \n\nHe was part of a loosely-affiliated group of filmmakers to emerge from Toronto known as the Toronto New Wave...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eMYYaExetcCHcDV4zNOIgkyLFIu.jpg", url:"https://themoviedb.org/person/55189"}}, {tmdbId:"17087", properties:{bornIn:"Flint, Michigan, USA", imdbId:"0601619", born:date('1954-04-23'), name:"Michael Moore", bio:"Michael Francis Moore is an American filmmaker, author and liberal political commentator.  He is the director and producer of Bowling for Columbine, Fahrenheit 9/11, Sicko, and Capitalism: A Love Story, four of the top ten highest-grossing documentaries of all time.  In September 2008, he released his first free movie on the Internet, Slacker Uprising, documenting his personal crusade to encourage more Americans to vote in presidential elections...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/koL5wDUjQIGN8muO4DXfrzvk1a4.jpg", url:"https://themoviedb.org/person/17087"}}, {tmdbId:"1979", properties:{bornIn:"South Orange, New Jersey, USA", imdbId:"0000228", born:date('1959-07-26'), name:"Kevin Spacey", bio:"Kevin Spacey Fowler (born July 26, 1959), better known by his stage name Kevin Spacey, is an  American actor of screen and stage, film director, producer, screenwriter and singer who has resided in the United Kingdom since 2003.  He began his career as a stage actor during the 1980s before obtaining supporting roles in film and television...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dlVRkUYKyZdJ39AN55cY1LoyXAP.jpg", url:"https://themoviedb.org/person/1979"}}, {tmdbId:"31024", properties:{bornIn:"St. Louis, Missouri, USA", imdbId:"0858525", born:date('1947-07-27'), name:"Betty Thomas", bio:"Betty Thomas was born July 27, 1947 in St.  Louis, Missouri, graduating from Ohio University with a BA in fine arts.  Initially sidetracked, Betty first taught school in Chicago but found herself restricted and needing more of an open forum for self-expression than a classroom.  She found herself drawn inextricably to comedy...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/y9K6S2TsiLpcQoIwDM1qigx1VJ4.jpg", url:"https://themoviedb.org/person/31024"}}, {tmdbId:"3417", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0001282", born:date('1960-05-20'), name:"Tony Goldwyn", bio:"Anthony Howard \"Tony\" Goldwyn (born May 20, 1960) is an American actor and director.  He portrayed the villain Carl Bruner in Ghost, Colonel Bagley in The Last Samurai, and the voice of the title character of the Disney animated Tarzan. \n\nDescription above from the Wikipedia article Tony Goldwyn, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/m4CJX4QwjZsdYJKe8OJamLRnlQh.jpg", url:"https://themoviedb.org/person/3417"}}, {tmdbId:"78029", properties:{bornIn:"Frankfurt am Main, Germany", imdbId:"0001454", born:date('1965-04-16'), name:"Martin Lawrence", bio:"From Wikipedia, the free encyclopedia\n\nMartin Fitzgerald Lawrence (born April 16, 1965) is an American actor who was born in Frankfurt am Main, Germany, he's film director, film producer, screenwriter, and comedian.  He came to fame during the 1990s, establishing a Hollywood career as a leading actor, most notably the films Bad Boys, Blue Streak, Big Momma's House and Bad Boys II...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tCP58OEUJOAsk2iiBeIDgmbt6y3.jpg", url:"https://themoviedb.org/person/78029"}}, {tmdbId:"55152", properties:{bornIn:"New York City, New York, USA", imdbId:"0001714", born:date('1961-07-19'), name:"Campbell Scott", bio:"From Wikipedia, the free encyclopedia. \n\nCampbell Scott (born July 19, 1961) is an American actor, director, producer, and voice artist. \n\nDescription above from the Wikipedia article Campbell Scott, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/98UtuTEQzYmJsoZV8FNnpebG2cJ.jpg", url:"https://themoviedb.org/person/55152"}}, {tmdbId:"224", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"0000343", born:date('1943-03-15'), name:"David Cronenberg", bio:"David Paul Cronenberg, (born March 15, 1943 in Toronto) is a Canadian filmmaker and screenwriter.  He is one of the principal originators of what is commonly known as the body horror or venereal horror genre.  This style of filmmaking explores people's fears of bodily transformation and infection.  In his films, the psychological is typically intertwined with the physical...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kLHnBnUomcH96PdLRBnuZUzRoY1.jpg", url:"https://themoviedb.org/person/224"}}, {tmdbId:"3129", properties:{bornIn:"London, England, UK", imdbId:"0000619", born:date('1961-05-14'), name:"Tim Roth", bio:"An English film actor.  Notable credits include Reservoir Dogs, Pulp Fiction, Four Rooms, Planet of the Apes, The Incredible Hulk and Rob Roy. \n\nTimothy Simon Roth is an English actor and director.  He made his debut in the television film Made in Britain.  He gained critical acclaim for his role as Myron in The Hit, for which he was nominated for the BAFTA Award for Most Promising Newcomer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qSizF2i9gz6c6DbAC5RoIq8sVqX.jpg", url:"https://themoviedb.org/person/3129"}}, {tmdbId:"66496", properties:{bornIn:"Queens, New York, USA", imdbId:"0791248", born:date('1966-06-24'), name:"Adrienne Shelly", bio:"​From Wikipedia, the free encyclopedia\n\nAdrienne Shelly (June 24, 1966 – November 1, 2006), sometimes credited as Adrienne Shelley, was an American actress, director and screenwriter.  Making her name in independent films such as 1989's The Unbelievable Truth and 1990's Trust, Shelly transitioned to a writing and directing career in subsequent years...", died:date('2006-11-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/khep82znnE1O9B0eORuLuqQzKO5.jpg", url:"https://themoviedb.org/person/66496"}}, {tmdbId:"1776", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"0000338", born:date('1939-04-07'), name:"Francis Ford Coppola", bio:"Francis Ford Coppola  (born April 7, 1939) is an American film director, producer and screenwriter.  He is widely acclaimed as one of Hollywood's most celebrated and influential film directors.  He epitomized the group of filmmakers known as the New Hollywood, which included George Lucas, Martin Scorsese, Robert Altman, Woody Allen and William Friedkin, who emerged in the early 1970s with unconventional ideas that challenged contemporary filmmaking...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mGKkVp3l9cipPt10AqoQnwaPrfI.jpg", url:"https://themoviedb.org/person/1776"}}, {tmdbId:"37872", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0178880", born:date('1936-05-04'), name:"Eleanor Coppola", bio:"Eleanor Coppola is an American documentary filmmaker, artist, and writer.  She is married to director Francis Ford Coppola.  She is most known for her 1991 documentary film Hearts of Darkness: A Filmmaker's Apocalypse as well as other documentaries chronicling the films of her husband and children...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cSaflK0aquTDiQfeViUPhApVU4j.jpg", url:"https://themoviedb.org/person/37872"}}, {tmdbId:"8328", properties:{bornIn:"St. Louis, Missouri, USA", imdbId:"0587518", born:date('1944-04-11'), name:"John Milius", bio:"John Frederick Milius is an American screenwriter, director, and producer of motion pictures.  He was one of the writers for the first two Dirty Harry films, received an Academy Award nomination as screenwriter of Apocalypse Now, and wrote and directed The Wind and the Lion, Conan the Barbarian and Red Dawn...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Aj1eweha4qvMJ1aIuSa24shcvWc.jpg", url:"https://themoviedb.org/person/8328"}}, {tmdbId:"36602", properties:{bornIn:"New York City, New York, USA", imdbId:"0000916", born:date('1964-03-11'), name:"Peter Berg", bio:"Peter Berg (born March 11, 1964) is an American actor, film director, producer and writer.  He is known for directing films such as Friday Night Lights, The Kingdom, The Rundown, Hancock and Battleship.  He is highly regarded for developing the television series Friday Night Lights, based on the film of the same name which he also directed...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1pR16H0zqRG49ns8cYykYpodgGF.jpg", url:"https://themoviedb.org/person/36602"}}, {tmdbId:"6385", properties:{bornIn:"Florida, USA", imdbId:"0724927", born:date('1942-01-01'), name:"William Richert", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c7OLmySPTx7UO17ua1upOMnhbeN.jpg", url:"https://themoviedb.org/person/6385"}}, {tmdbId:"2632", properties:{bornIn:"Andrews, South Carolina, USA", imdbId:"0001674", born:date('1965-02-07'), name:"Chris Rock", bio:"Christopher Julius \"Chris\" Rock III (born February 7, 1965) is an American comedian, actor, screenwriter, television producer, film producer and director.  He was voted in the US as the 5th greatest stand-up comedian of all time by Comedy Central.  He was also voted in the UK as the 9th greatest stand-up comic on Channel 4's 100 Greatest Stand-Ups in 2007, and again in the updated 2010 list as the 8th greatest stand-up comic...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cqI8yQ00GNDV3PAAz5UeLj7vOX0.jpg", url:"https://themoviedb.org/person/2632"}}, {tmdbId:"879", properties:{bornIn:"Hot Springs, Arkansas, USA", imdbId:"0000671", born:date('1955-08-04'), name:"Billy Bob Thornton", bio:"Billy Bob Thornton (born August 4, 1955) is an American actor, screenwriter, director and musician.  Thornton gained early recognition as a cast member on the CBS sitcom Hearts Afire and in several early 1990s films including On Deadly Ground and Tombstone.  In the mid-1990s, after writing, directing, and starring in the independent film Sling Blade, he won an Academy Award for Best Adapted Screenplay...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i5EKWHuXokznIDMy2prTXzRmklI.jpg", url:"https://themoviedb.org/person/879"}}, {tmdbId:"934", properties:{bornIn:"Wellington, New Zealand", imdbId:"0000128", born:date('1964-04-07'), name:"Russell Crowe", bio:"Russell Ira Crowe (born 7 April 1964) is a New Zealand-born Australian actor and musician.  His acting career began in the late 1980s with roles in Australian television series including Police Rescue and Neighbours.  In the early 1990s, Crowe's local prominence peaked when he won the Australian Film Industry Award for Best Actor for his portrayal of an inner-city skinhead in the Geoffrey Wright film, Romper Stomper...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mGTtPuwE8OR00tkJGmVLJmt8KpW.jpg", url:"https://themoviedb.org/person/934"}}, {tmdbId:"4566", properties:{bornIn:"Hammersmith, London, UK", imdbId:"0000614", born:date('1946-02-21'), name:"Alan Rickman", bio:"Alan Sidney Patrick Rickman (21 February 1946-14 January 2016) was an English actor and theatre director.  He was a renowned stage actor in modern and classical productions and a former member of the Royal Shakespeare Company.  Rickman was known for his film performances as Hans Gruber in Die Hard, Severus Snape in the Harry Potter film series, Eamon de Valera in Michael Collins, and Metatron in Dogma...", died:date('2016-01-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7tADZs4ILE93oJ5pAh6mKQFEq2m.jpg", url:"https://themoviedb.org/person/4566"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor:Director;
UNWIND [{tmdbId:"51864", properties:{bornIn:"St. Louis, Missouri, USA", imdbId:"0501435", born:date('1961-02-24'), name:"Kasi Lemmons", bio:"Kasi Lemmons (born Karen Lemmons on February 24, 1961) is an American film director and actress, most notable for her work on the films Eve's Bayou, The Caveman's Valentine and Talk to Me.  Lemmons was born in St.  Louis, Missouri, the daughter of a poet/psychotherapist mother and a biology teacher father.   When Lemmons was eight years old, her parents divorced, and she and her mother and two sisters moved to Newton, Massachusetts.  Her mother remarried when she was nine...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hof1zuo2FRj83xNuJWl1sWUPMtS.jpg", url:"https://themoviedb.org/person/51864"}}, {tmdbId:"564", properties:{bornIn:"Houston, Texas, USA", imdbId:"0000500", born:date('1960-07-30'), name:"Richard Linklater", bio:"Self-taught writer-director Richard Linklater was among the first and most successful talents to emerge during the American independent film renaissance of the 1990s...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wNijRefhQCp0BkNqM5qhhdazDgx.jpg", url:"https://themoviedb.org/person/564"}}, {tmdbId:"17764", properties:{bornIn:"Baltimore, Maryland, USA", imdbId:"0001165", born:date('1951-01-30'), name:"Charles S. Dutton", bio:"Charles Stanley Dutton (born January 30, 1951) is an American stage, film, and television actor and director.  He is perhaps best known for starring in the television series Roc (1991–1994) and House MD (as the father of Eric Foreman).  Description above from the Wikipedia article Charles S.  Dutton, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zX8lrPMMC6Uh1ZrNkcrvempl02X.jpg", url:"https://themoviedb.org/person/17764"}}, {tmdbId:"5149", properties:{bornIn:"Chicago Lawn, Chicago, Illinois, USA", imdbId:"0001372", born:date('1961-09-22'), name:"Bonnie Hunt", bio:"Bonnie Lynne Hunt (born September 22, 1961) is an American actress, comedian, writer, director, television producer and daytime television host...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uKAfrFRZYnHFAxw53Jldbs8yIZO.jpg", url:"https://themoviedb.org/person/5149"}}, {tmdbId:"47820", properties:{bornIn:"Namur, Belgium", imdbId:"0688143", born:date('1964-09-22'), name:"Benoît Poelvoorde", bio:"Benoît Poelvoorde (born 22 September 1964, in Namur, Belgium) is a Belgian actor and comedian...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1rt37BkFjSYF7imtvJ5t30bqsNM.jpg", url:"https://themoviedb.org/person/47820"}}, {tmdbId:"64998", properties:{bornIn:"Hollywood, California, USA", imdbId:"0001736", born:date('1968-02-01'), name:"Pauly Shore", bio:"Paul Montgomery \"Pauly\" Shore (born February 1, 1968) is an American comedian and actor who starred in several comedy films in the 1990s and hosted a video show on MTV in the late 1980s and early 1990s.  Shore is currently performing stand-up comedy. \n\nDescription above from the Wikipedia article Pauly Shore, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uI7ctTqSIlLL7nn6UqDdqqhGNVC.jpg", url:"https://themoviedb.org/person/64998"}}, {tmdbId:"2226", properties:{bornIn:"Lafayette, Indiana, USA", imdbId:"0001628", born:date('1934-07-01'), name:"Sydney Pollack", bio:"Sydney Irwin Pollack was an American film director, producer and actor.  Pollack studied with Sanford Meisner at the Neighborhood Playhouse in New York City, where he later taught acting.  He began directing television shows in the 1960s before moving to films. \n\nPollack directed more than 21 films and 10 television shows, acted in over 30 films or shows, and produced over 44 films...", died:date('2008-05-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dbbMGZ2CWqlTuHD09KpoZdxKyI2.jpg", url:"https://themoviedb.org/person/2226"}}, {tmdbId:"69359", properties:{bornIn:"Canada", imdbId:"0009788", name:"Mark Achbar", bio:"From Wikipedia, the free encyclopedia.   Mark Achbar is a Canadian filmmaker, best known for directing The Corporation and Manufacturing Consent: Noam Chomsky and the Media. \n\nDescription above from the Wikipedia article Mark Achbar, licensed under CC-BY-SA,full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/69359"}}, {tmdbId:"127283", properties:{bornIn:"Paris, France", imdbId:"0171664", born:date('1957-12-19'), name:"Cyril Collard", bio:"From Wikipedia, the free encyclopedia\n\nCyril Collard (French: [kɔlaʁ]; 19 December 1957, Paris − 5 March 1993, Paris) was a French author, filmmaker, composer, musician and actor.  He is known for his unapologetic portrayals of bisexuality and HIV in art, particularly his autobiographical novel and film Les Nuits Fauves (Savage Nights).  Openly bisexual, Collard was also one of the first French artists to speak openly about his HIV-positive status...", died:date('1993-03-05'), url:"https://themoviedb.org/person/127283"}}, {tmdbId:"33", properties:{bornIn:"Blue Island, Illinois, USA", imdbId:"0000641", born:date('1955-03-17'), name:"Gary Sinise", bio:"Gary Sinise (born March 17, 1955) is an American actor, film director and musician...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ngYV91xYfCu0JNcSxJ4yQ7tzOna.jpg", url:"https://themoviedb.org/person/33"}}, {tmdbId:"41419", properties:{bornIn:"Oxford, Oxfordshire, England, UK", imdbId:"0491402", born:date('1959-06-11'), name:"Hugh Laurie", bio:"James Hugh Calum Laurie CBE is an English actor, director, singer, musician, comedian and author.  Laurie is known for portraying the title character on the Fox medical drama series House (2004–2012), for which he received two Golden Globe Awards and nominations for numerous other awards.  He was listed in the 2011 Guinness World Records as the most watched leading man on television and was one of the highest-paid actors in a television drama, earning £250,000 ($409,000) per episode of House...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/akArncggHnusP5jxzMBKmJDRrMo.jpg", url:"https://themoviedb.org/person/41419"}}, {tmdbId:"15521", properties:{bornIn:"Newark, New Jersey, USA", imdbId:"0225416", born:date('1951-06-25'), name:"Ernest R. Dickerson", bio:"From Wikipedia, the free encyclopedia. \n\nErnest Roscoe Dickerson A. S. C.  (usually credited as Ernest R.  Dickerson or Ernest Dickerson, born June 25, 1951) is an American film and television director and cinematographer.  He directed generally urban films sometimes with supernatural story like Juice, Tales from the Crypt Presents Demon Knight, Bones and Never Die Alone.  He is known for his frequent collaborations with Spike Lee...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/95LqJiPlj202gZchzpHg7XR5axe.jpg", url:"https://themoviedb.org/person/15521"}}, {tmdbId:"141825", properties:{bornIn:"Pittsburgh, Pennsylvania, USA", imdbId:"0192090", born:date('1960-12-13'), name:"Rusty Cundieff", bio:"George Arthur \"Rusty\" Cundieff (born December 13, 1960) is an American film/television director, actor, and writer.  His notable credits are as director/writer of and lead actor in the This Is Spinal Tap-like rap satire Fear of a Black Hat, as writer of the second installment to House Party, and as director of the horror anthology Tales from the Hood.  He also directed the 1997 film, Sprung.  He was also a director for Chappelle's Show and a correspondent on TV Nation...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/14re77GRWUNrI3gEGIiCSRGqtVL.jpg", url:"https://themoviedb.org/person/141825"}}, {tmdbId:"10139", properties:{bornIn:"Berlin, Germany", imdbId:"0726166", born:date('1902-08-22'), name:"Leni Riefenstahl", bio:"Helene Bertha Amalie \"Leni\" Riefenstahl (22 August 1902 – 8 September 2003) was a German film director, actress and dancer widely noted for her aesthetics and innovations as a filmmaker.  Her most famous film was Triumph des Willens (Triumph of the Will), made at the 1934 Nuremberg congress of the Nazi Party...", died:date('2003-09-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6qBz8IVXankocpDP6pLQJFAIYYp.jpg", url:"https://themoviedb.org/person/10139"}}, {tmdbId:"2406", properties:{bornIn:"Paris, France", imdbId:"0440913", born:date('1967-08-03'), name:"Mathieu Kassovitz", bio:"Mathieu Kassovitz (born 3 August 1967) is a French director, screenwriter, producer and actor, best known for his Cannes-winning drama La Haine.  Kassovitz is also the founder of MNP Entreprise, a film production company...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3FRBEdKKlxhvPWPt0jzgmSjeHwn.jpg", url:"https://themoviedb.org/person/2406"}}, {tmdbId:"15277", properties:{bornIn:"Queens, New York, USA", imdbId:"0269463", born:date('1966-10-19'), name:"Jon Favreau", bio:"Jonathan Favreau (/ˈfævroʊ/; born October 19, 1966) is an American actor, director, producer, and screenwriter. \n\nAs an actor, he is known for roles in films such as \"Rudy\" (1993), \"Swingers\" (1996) (which he also wrote), \"Very Bad Things\" (1998), \"Daredevil\" (2003), \"The Break-Up\" (2006), \"Couples Retreat\" (2009), and \"Chef\" (2014) (which he also wrote and directed)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8MtRRnEHaBSw8Ztdl8saXiw1egP.jpg", url:"https://themoviedb.org/person/15277"}}, {tmdbId:"3317", properties:{bornIn:"Tokyo, Japan", imdbId:"0001429", born:date('1947-01-18'), name:"Takeshi Kitano", bio:"Takeshi Kitano (born January 18, 1947) is a Japanese filmmaker, comedian, singer, actor, tap dancer, film editor, presenter, screenwriter, author, poet, painter, and one-time video game designer who has received critical acclaim, both in his native Japan and abroad, for his highly idiosyncratic cinematic work.  The famed Japanese film critic Nagaharu Yodogawa once dubbed him \"the true successor\" to influential filmmaker Akira Kurosawa...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lBNxZWRnbhTnqoloe6XB2SR93qF.jpg", url:"https://themoviedb.org/person/3317"}}, {tmdbId:"110879", properties:{imdbId:"0067861", name:"Roko Belic", url:"https://themoviedb.org/person/110879"}}, {tmdbId:"2283", properties:{bornIn:"Peekskill, New York, USA", imdbId:"0001804", born:date('1960-11-11'), name:"Stanley Tucci", bio:"Stanley Tucci is an American actor, writer, film producer and film director.  He has been nominated for several notable film awards, including an Academy Award for Best Supporting Actor, for his performance in The Lovely Bones (2009)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/y5D26OXjx83B3R48nckJMp7yQ29.jpg", url:"https://themoviedb.org/person/2283"}}, {tmdbId:"884", properties:{bornIn:"New York City, New York, USA", imdbId:"0000114", born:date('1957-12-13'), name:"Steve Buscemi", bio:"An American actor, writer and director.  He was born in Brooklyn, New York, the son of Dorothy, who worked as a hostess at Howard Johnson's, and John Buscemi, a sanitation worker and Korean War veteran.  Buscemi's father was Sicilian American and his mother Irish American.  He has three brothers: Jon, Ken, and Michael.  Buscemi was raised Roman Catholic...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n0pZumkrcZrAPMoPq684RhYnjPV.jpg", url:"https://themoviedb.org/person/884"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor:Director;
UNWIND [{tmdbId:"10697", properties:{bornIn:"Aberfeldy, Perthshire, Scotland, UK", imdbId:"0001086", born:date('1965-01-27'), name:"Alan Cumming", bio:"Alan Cumming, OBE (born 27 January 1965) is a Scottish-American stage and screen actor, singer, comedian, director, producer and author.  He is best known for playing Emcee in \"Cabaret\" on stage, for his portrayal of Boris Grishenko in the James Bond movie \"GoldenEye\" and as Nightcrawler in \"X2\", for his recurring role of Eli Gold in the CBS television series \"The Good Wife\", and for his autobiography \"Not My Father's Son: A Memoir\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cXbcMoCtS8947or9K5cOQev1Mmj.jpg", url:"https://themoviedb.org/person/10697"}}, {tmdbId:"20173", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"0001528", born:date('1963-08-17'), name:"Don McKellar", bio:"​From Wikipedia, the free encyclopedia.   \n\nDon McKellar (born August 17, 1963) is a Canadian actor, writer, and filmmaker. \n\nDescription above from the Wikipedia article Don McKellar, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/swGAgpDZ3qSsjqe2WXvbtIkLhpv.jpg", url:"https://themoviedb.org/person/20173"}}, {tmdbId:"35137", properties:{bornIn:"Paris, France", imdbId:"0001929", born:date('1950-04-15'), name:"Josiane Balasko", bio:"Josiane Balasko (born 15 April 1950) is a French actress, writer and director. \n\nShe was born Josiane Balašković in Paris.  One of Balasko's most recognized roles among English speakers is as a lesbian in 1995's Gazon maudit (French Twist).  She won the 1996 César Award (shared with Telsche Boorman) for best writing for this film, for which she was also nominated as best director.  The movie itself was nominated for best film...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eDAW4L3nNpx0sfhh5nMix4KdjfM.jpg", url:"https://themoviedb.org/person/35137"}}, {tmdbId:"11806", properties:{bornIn:"Spokane, Washington, U.S.", imdbId:"0842140", born:date('1959-10-10'), name:"Julia Sweeney", bio:"From Wikipedia, the free encyclopedia. \n\nJulia Anne Sweeney (born October 10, 1959) is an American actress, comedian and author best known as a cast member on Saturday Night Live and for her autobiographical solo shows. \n\nDescription above from the Wikipedia article Julia Sweeney, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6u70GXtLICF75FJ1l0gpZETK7eM.jpg", url:"https://themoviedb.org/person/11806"}}, {tmdbId:"1146", properties:{bornIn:"Paris, France", imdbId:"0000365", born:date('1969-12-21'), name:"Julie Delpy", bio:"Julie Delpy (born December 21, 1969) is a French-American actress, director, screenwriter, and singer-songwriter.  She studied filmmaking at New York University's Tisch School of the Arts and has directed, written, and acted in more than 30 films including Europa Europa, Before Sunrise, Before Sunset, and 2 Days in Paris.  After moving to the U. S. , she became an American citizen...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rd40f4QpAUUne3hMaUhHrZtcK2c.jpg", url:"https://themoviedb.org/person/1146"}}, {tmdbId:"524", properties:{bornIn:"Jerusalem, Israel", imdbId:"0000204", born:date('1981-06-09'), name:"Natalie Portman", bio:"Natalie Portman (born Neta-Lee Hershlag, June 9, 1981) is an actress with dual American and Israeli citizenship.  Her first role was in the 1994 action thriller Léon: The Professional, opposite Jean Reno.  She was later cast as Padmé Amidala in the Star Wars prequel trilogy (released in 1999, 2002 and 2005). \n\nBorn in Jerusalem to an Israeli father and American mother, Portman grew up in the eastern United States from the age of three...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/edPU5HxncLWa1YkgRPNkSd68ONG.jpg", url:"https://themoviedb.org/person/524"}}, {tmdbId:"2388", properties:{bornIn:"Bellefonte, Pennsylvania, USA", imdbId:"0000408", born:date('1952-08-19'), name:"Jonathan Frakes", bio:"From Wikipedia, the free encyclopedia. \n\nJonathan Scott Frakes (born August 19, 1952) is an American actor, author and director.  Frakes is best known for his portrayal of Commander William T.  Riker in the television series Star Trek: The Next Generation and subsequent films.  Frakes also hosted the television series Beyond Belief: Fact or Fiction, challenging viewers to discern his stories of fact-based phenomena and fabricated tales...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/koY6DtPAnuiJpdOW3bPHzmoC6cZ.jpg", url:"https://themoviedb.org/person/2388"}}, {tmdbId:"15337", properties:{bornIn:"Sydney, New South Wales, Australia", imdbId:"0689852", born:date('1965-09-06'), name:"John Polson", bio:"John Polson is an Australian actor, director and founder of \"Tropfest\", the world's largest short film festival...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rsjpQFAvQSo05HflPSCODCCbYFl.jpg", url:"https://themoviedb.org/person/15337"}}, {tmdbId:"82796", properties:{bornIn:"Moscow, RSFSR, USSR", imdbId:"0586482", born:date('1945-10-21'), name:"Nikita Mikhalkov", bio:"Film director, screenwriter, actor, producer.  Honored Artist of the RSFSR (12. 31. 1976).  People's Artist of the RSFSR (03/28/1984).  Father - poet Sergei Vladimirovich Mikhalkov (1913-2009), author of the text of the national anthem of the USSR and Russia, mother - writer Natalia Petrovna Konchalovskaya (1903-1988)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/25GLiAUDhHIIMqNtkBaz6uW7R5A.jpg", url:"https://themoviedb.org/person/82796"}}, {tmdbId:"119232", properties:{bornIn:"Greenwich - Connecticut - USA", imdbId:"0006888", born:date('1951-04-12'), name:"Tom Noonan", bio:"An American actor and film writer-director.  Noonan was born in Greenwich, Connecticut, the son of Rosaleen and Tom Noonan, who worked as a dentist and jazz musician respectively.  He has an older brother, John F.  Noonan, a playwright, and two sisters, Barbara and Nancy.  In 1986, Noonan played Francis Dolarhyde, a serial killer who kills entire families, in Michael Mann's Manhunter, the first movie to feature Hannibal Lecter...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vNGdfEAo6OVOHkGuwx7ioeomv55.jpg", url:"https://themoviedb.org/person/119232"}}, {tmdbId:"1032", properties:{bornIn:"Queens, New York, USA", imdbId:"0000217", born:date('1942-11-17'), name:"Martin Scorsese", bio:"​American film director, screenwriter, producer, actor, and film historian Martin Marcantonio Luciano Scorsese made the short films while he attended New York University's film school; these include “What's a Nice Girl Like You Doing in a Place Like This?” (1963), “It's Not Just You, Murray!” (1964), and his most famous short of the period “The Big Shave” (1967).  This came shortly after seriously considering entering into priesthood...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9U9Y5GQuWX3EZy39B8nkk4NY01S.jpg", url:"https://themoviedb.org/person/1032"}}, {tmdbId:"14392", properties:{bornIn:"San Carlos, California, USA", imdbId:"0000941", born:date('1951-11-27'), name:"Kathryn Bigelow", bio:"Kathryn Ann Bigelow is an American film director.  Her best-known films are the cult horror film Near Dark (1987), the surfer/bank robbery action picture Point Break (1991), the historical/mystery film The Weight of Water (2000) and the war drama The Hurt Locker (2008).  The Hurt Locker won the 2010 Academy Award for Best Picture, won the BAFTA Award for Best Film, and was nominated for the 2010 Golden Globe Award for Best Drama...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7wiMnFR6WP9SK870AvNQ3LccLi7.jpg", url:"https://themoviedb.org/person/14392"}}, {tmdbId:"138", properties:{bornIn:"Knoxville, Tennessee, USA", imdbId:"0000233", born:date('1963-03-27'), name:"Quentin Tarantino", bio:"Quentin Jerome Tarantino (born March 27, 1963) is an American film director, screenwriter, producer, cinematographer and actor.  In the early 1990s he was an independent filmmaker whose films used nonlinear storylines and aestheticization of violence.  His films have earned him a variety of Academy Award, Golden Globe, BAFTA and Palme d'Or Awards and he has been nominated for Emmy and Grammy Awards.  In 2007, Total Film named him the 12th-greatest director of all time...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1gjcpAa99FAOWGnrUvHEXXsRs7o.jpg", url:"https://themoviedb.org/person/138"}}, {tmdbId:"1896", properties:{bornIn:"Kansas City, Missouri, USA ", imdbId:"0000332", born:date('1964-11-29'), name:"Don Cheadle", bio:"An American film actor as well as producer.  Cheadle first received widespread notice for his portrayal of Mouse Alexander in the film Devil in a Blue Dress, for which he won Best Supporting Actor awards from the Los Angeles Film Critics Association and the National Society of Film Critics and was nominated for similar awards from the Screen Actors Guild and the NAACP Image Awards...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/b1EVJWdFn7a75qVYJgwO87W2TJU.jpg", url:"https://themoviedb.org/person/1896"}}, {tmdbId:"129534", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"0167029", born:date('1921-10-12'), name:"Art Clokey", bio:"​From Wikipedia, the free encyclopedia\n\nArthur \"Art\" Clokey (October 12, 1921 - January 8, 2010) was a pioneer in the popularization of stop motion clay animation, beginning in 1955 with a film experiment called Gumbasia, influenced by his professor, Slavko Vorkapich, at the University of Southern California. \n\nFrom the Gumbasia project, Art Clokey and his wife Ruth invented Gumby...", died:date('2010-01-08'), url:"https://themoviedb.org/person/129534"}}, {tmdbId:"11701", properties:{bornIn:"Los Angeles, California, USA ", imdbId:"0001401", born:date('1975-06-04'), name:"Angelina Jolie", bio:"Angelina Jolie is an American actress.  She has received an Academy Award, two Screen Actors Guild Awards, and three Golden Globe Awards.  Jolie has promoted humanitarian causes throughout the world, and is noted for her work with refugees as a Goodwill Ambassador for the United Nations High Commissioner for Refugees (UNHCR).  She has been cited as one of the world's most beautiful women and her off-screen life is widely reported...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gD8jlGkQC8GBajulNlIzBK1YEO1.jpg", url:"https://themoviedb.org/person/11701"}}, {tmdbId:"92561", properties:{bornIn:"London, England, UK", imdbId:"0112374", born:date('1948-01-30'), name:"Nick Broomfield", bio:"From Wikipedia, the free encyclopedia\n\nNicholas \"Nick\" Broomfield (born 1948) is an English documentary film-maker.  He is the son of Maurice Broomfield, a photographer. \n\nBroomfield works with a minimal crew, just himself and one or two camera operators, which gives his documentaries a particular style.  Broomfield is often in shot holding the sound boom...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fEuA7S6ud5uCUBGVDrjt1zKC8V1.jpg", url:"https://themoviedb.org/person/92561"}}, {tmdbId:"88750", properties:{imdbId:"0319680", name:"Tom Gilroy", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bKzidtz01QqN49YdJE7fcyr8Ezm.jpg", url:"https://themoviedb.org/person/88750"}}, {tmdbId:"1893", properties:{bornIn:"Falmouth, Massachusetts, USA", imdbId:"0000729", born:date('1975-08-12'), name:"Casey Affleck", bio:"Caleb Casey McGuire Affleck-Boldt (born August 12, 1975), best known as Casey Affleck is an American actor and film director.  Throughout the 1990s and early 2000s, he played supporting roles in mainstream hits like Good Will Hunting (1997) and Ocean's Eleven (2001) as well as in critically acclaimed independent films such as Chasing Amy (1997).  During this time, he became known as the younger brother of actor and director Ben Affleck, with whom he has frequently collaborated professionally...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hcggAadv5SwdhoAb4yYMoAFYdWK.jpg", url:"https://themoviedb.org/person/1893"}}, {tmdbId:"67569", properties:{imdbId:"0553095", name:"Steven M. Martin", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jXyiVQnF4KofwiT0KuLmSoFtaAW.jpg", url:"https://themoviedb.org/person/67569"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor:Director;
UNWIND [{tmdbId:"17403", properties:{bornIn:"Guayaquil, Ecuador", imdbId:"0431918", born:date('1962-10-17'), name:"Mike Judge", bio:"Michael Craig Judge is an American animator, film director, writer and voice actor, best known as the creator and star of the popular animated television series Beavis and Butt-head (1993–1997, 2011–), King of the Hill (1997–2009), and The Goode Family (2009). \n\nHe also wrote, directed and occasionally produced the films Beavis and Butt-head Do America (1996), Office Space (1999), Idiocracy (2006) and Extract (2009).  Judge is also known for his role in the Spy Kids movie franchise...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2W43DxSRk2F78H2l0Ow3X50Y0ST.jpg", url:"https://themoviedb.org/person/17403"}}, {tmdbId:"106753", properties:{bornIn:"Cleveland, Ohio, USA", imdbId:"1444462", born:date('1962-12-09'), name:"Richard Brooks", bio:"Richard Brooks is an American actor and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eL51q3GpEtkdXWE6nE56PQ9kOkK.jpg", url:"https://themoviedb.org/person/106753"}}, {tmdbId:"819", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0001570", born:date('1969-08-18'), name:"Edward Norton", bio:"Edward Harrison Norton (born August 18, 1969) is an American actor, screenwriter, film director and producer.  In 1996, his supporting role in the courtroom drama Primal Fear garnered him a nomination for the Academy Award for Best Supporting Actor.  Two years later, his lead role as a reformed white power skinhead in American History X earned a nomination for Academy Award for Best Actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5XBzD5WuTyVQZeS4VI25z2moMeY.jpg", url:"https://themoviedb.org/person/819"}}, {tmdbId:"47773", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0005196", born:date('1930-04-25'), name:"Paul Mazursky", bio:"From Wikipedia, the free encyclopedia. \n\nIrwin Lawrence \"Paul\" Mazursky (April 25, 1930 – June 30, 2014) was an American film director, screenwriter, and actor.  Known for his dramatic comedies that often dealt with modern social issues, he was nominated for five Academy Awards: three times for Best Original Screenplay, once for Best Adapted Screenplay, and once for Best Picture for An Unmarried Woman (1978)...", died:date('2014-06-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jXUJeFzkvl0j4rq5vbxUKjrwNg4.jpg", url:"https://themoviedb.org/person/47773"}}, {tmdbId:"7399", properties:{bornIn:"New York City, New York, USA", imdbId:"0001774", born:date('1965-11-30'), name:"Ben Stiller", bio:"An American comedian, actor, writer, film director, and producer.  He is the son of veteran comedians and actors Jerry Stiller and Anne Meara.  After beginning his acting career with a play, Stiller wrote several mockumentaries, and was offered two of his own shows, both entitled The Ben Stiller Show.  He began acting in films, and had his directorial debut with Reality Bites...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gHLp8bqc4ZBHqp5uheYH8sPHEBB.jpg", url:"https://themoviedb.org/person/7399"}}, {tmdbId:"109253", properties:{bornIn:"New Zealand", imdbId:"0090904", born:date('1960-12-27'), name:"Costa Botes", bio:"Costa Botes has been an independent film-maker in New Zealand since the early 1980s.  His short film Stalin’s Sickle won the jury prize at the Clermont-Ferrand Short Film Festival in 1988.  Forgotten Silver, a mock-documentary co-written & co-directed with Peter Jackson in 1995 created a national sensation in 1995.  It won a special critics prize at the Venice Film Festival, and has become a cult favourite worldwide...", url:"https://themoviedb.org/person/109253"}}, {tmdbId:"108", properties:{bornIn:"Pukerua Bay, North Island, New Zealand", imdbId:"0001392", born:date('1961-10-31'), name:"Peter Jackson", bio:"Sir Peter Robert Jackson, (born 31 October 1961) is a New Zealand film director, producer, actor, and screenwriter, known for his Lord of the Rings film trilogy, adapted from the novel by J.  R.  R.  Tolkien.  He is also known for his 2005 remake of King Kong and as the producer of District 9...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4hh7hips4xc6kgpNDQKQH3goRvJ.jpg", url:"https://themoviedb.org/person/108"}}, {tmdbId:"2361070", properties:{name:"Bruce La Bruce", url:"https://themoviedb.org/person/2361070"}}, {tmdbId:"68185", properties:{bornIn:"New York City, New York, U.S.", imdbId:"0769703", born:date('1962-01-22'), name:"Eric Schaeffer", bio:"From Wikipedia, the free encyclopedia. \n\nEric Schaeffer (born January 22, 1962) is an American actor, writer and director. \n\nDescription above from the Wikipedia article Eric Schaeffer, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/68185"}}, {tmdbId:"68215", properties:{bornIn:"Centreville - Illinois - USA", imdbId:"0399737", born:date('1961-12-15'), name:"Reginald Hudlin", bio:"Reginald Alan Hudlin is an American writer and film director...", url:"https://themoviedb.org/person/68215"}}, {tmdbId:"24045", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0330687", born:date('1981-02-17'), name:"Joseph Gordon-Levitt", bio:"Joseph Leonard Gordon-Levitt (born February 17, 1981) is an American actor whose career as both a child and adult has included television series and theatrical films.  He is known for his roles in the 2009 indie (500) Days of Summer and Christopher Nolan's sci-fi Inception.  The former earned him a Golden Globe nomination.  Beginning in commercials as a young child he made his film debut in 1992's Beethoven...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dhv9f3AaozOjpvjAwVzOWlmmT2V.jpg", url:"https://themoviedb.org/person/24045"}}, {tmdbId:"73499", properties:{bornIn:"Edmonton, Alberta, Canada", imdbId:"0567126", born:date('1961-05-12'), name:"Bruce McCulloch", bio:"Bruce Ian McCulloch (born May 12, 1961) is a Canadian actor, writer, comedian, and film director.  McCulloch is best known for his work as a member of The Kids in the Hall, a popular Canadian comedy troupe, and as a writer for Saturday Night Live.  McCulloch has also appeared on series such as Twitch City and Gilmore Girls.  He directed the films Dog Park, Stealing Harvard and Superstar...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mknOQPuT4PTA5Qjxz4xx95krkwR.jpg", url:"https://themoviedb.org/person/73499"}}, {tmdbId:"30021", properties:{imdbId:"0540075", name:"Jim Mallon", bio:"From Wikipedia, the free encyclopedia\n\nJim Mallon is an American television and film producer and writer, most notable for being executive producer of the Peabody Award-winning series Mystery Science Theater 3000 (MST3K).  He is also president of the series' production company, Best Brains, Inc. , directed more than 75 episodes of MST3K, and played the role of Gypsy from the first season until the middle of the eighth season...", url:"https://themoviedb.org/person/30021"}}, {tmdbId:"22461", properties:{bornIn:"Buffalo - New York - USA", imdbId:"0001252", born:date('1961-04-11'), name:"Vincent Gallo", bio:"From Wikipedia, the free encyclopedia. \n\nVincent Gallo  (born April 11, 1961) is an American film actor, director, producer, screenwriter, singer-songwriter, and painter...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tkWaZr3WmLm2SxeXymlbYSfRaZW.jpg", url:"https://themoviedb.org/person/22461"}}, {tmdbId:"12833", properties:{bornIn:"Woodside, Queens County, New York, USA", imdbId:"0122653", born:date('1968-01-29'), name:"Edward Burns", bio:"Edward Fitzgerald Burns (born January 29, 1968) is an American actor, film producer, writer and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pTLdPUSxDUcdmvy91LGCF3pk0AM.jpg", url:"https://themoviedb.org/person/12833"}}, {tmdbId:"1844", properties:{bornIn:"Freiburg im Breisgau, Germany", imdbId:"0001709", born:date('1963-12-19'), name:"Til Schweiger", bio:"Tilman Valentin \"Til\" Schweiger ( born December 19, 1963) is a German actor, director, and producer.  He is one of Germany’s most successful filmmakers.  Since 1968, when the FFA started counting, no other German actor drew more people to the cinemas.  He runs his own production company Barefoot Films in Berlin...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oBoY5DNa2DmAxixjmJFXgjA2z7A.jpg", url:"https://themoviedb.org/person/1844"}}, {tmdbId:"880", properties:{bornIn:"Berkeley, California, USA", imdbId:"0000255", born:date('1972-08-15'), name:"Ben Affleck", bio:"Ben Affleck (born Benjamin Géza Affleck-Boldt; August 15, 1972) is an American actor, film director, writer, and producer.  He became known in the mid-1990s with his performance in the Kevin Smith films Mallrats (1995) and Chasing Amy (1997).  Affleck is an Academy Award as well as a Golden Globe Award winner, along with Matt Damon, for their collaborative screenplay for the 1997 film Good Will Hunting...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8WE5VNhTkiyus0xqUWdL9wNyl0P.jpg", url:"https://themoviedb.org/person/880"}}, {tmdbId:"5342", properties:{bornIn:"Berlin, Germany", imdbId:"0001566", born:date('1931-11-06'), name:"Mike Nichols", bio:"Mike Nichols (born Mikhail Igor Peschkowsky; November 6, 1931 – November 19, 2014) was an American film and theatre director, producer, actor and comedian.  He was noted for his ability to work across a range of genres and an aptitude for getting the best out of actors regardless of their acting experience.   Nichols began his career in the 1950s with the comedy improvisational troupe, The Compass Players, predecessor of The Second City, in Chicago...", died:date('2014-11-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eJgJEVil7iOJ9sTAXLCVRKfeKKM.jpg", url:"https://themoviedb.org/person/5342"}}, {tmdbId:"1390109", properties:{imdbId:"0552782", name:"Michael Martin", url:"https://themoviedb.org/person/1390109"}}, {tmdbId:"19143", properties:{bornIn:"Vancouver, British Columbia, Canada", imdbId:"0000594", born:date('1969-08-28'), name:"Jason Priestley", bio:"​From Wikipedia, the free encyclopedia.   \n\nJason Bradford Priestley (born August 28, 1969)  is a Canadian-American actor and director.  He is best known as the virtuous Brandon Walsh on the television series Beverly Hills, 90210, a role which catapulted him to recognition in the early 1990s...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lQvkOOhf59FTD86G96fTRp17VJt.jpg", url:"https://themoviedb.org/person/19143"}}] AS row
