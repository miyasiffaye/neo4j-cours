UNWIND [{tmdbId:"164945", properties:{bornIn:"Euless, Texas, USA", imdbId:"1083404", born:date('1980-01-10'), name:"Sarah Shahi", bio:"Sarah Shahi (born January 10, 1980) is an American actress and a former NFL Cheerleader...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dFnYqsEZQMAuatj367fohnB1rFI.jpg", url:"https://themoviedb.org/person/164945"}}, {tmdbId:"66579", properties:{bornIn:"Brooklyn - New York - USA", imdbId:"0813887", born:date('1974-02-24'), name:"Bonnie Somerville", bio:"Bonnie was raised by her mother, and her mother's large Irish Catholic family in Flatbush, Brooklyn.  Her mother is one of 9 children! Bonnie started acting and singing at a young age, appearing in all the high school plays at Poly Prep Country Day School in Bay Ridge, Brooklyn.  She attended Boston College as a Musical Theater major, and left to move back home to New York to try acting professionally...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kG8YzQmYJA7cy4i09AlKMksiet4.jpg", url:"https://themoviedb.org/person/66579"}}, {tmdbId:"49271", properties:{bornIn:"Toms River - New Jersey - USA", imdbId:"1310016", born:date('1974-05-13'), name:"Brian Geraghty", bio:"From Wikipedia, the free encyclopedia\n\nBrian Timothy Geraghty (born May 13, 1974) is an American film and television actor, best known for his role in the Academy Award winning film The Hurt Locker. \n\nDescription above from the Wikipedia article Brian Geraghty, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4sqeUc4xYyzQ3Qpl5oxlQBTAAQk.jpg", url:"https://themoviedb.org/person/49271"}}, {tmdbId:"59280", properties:{imdbId:"1043006", name:"Victor Pagan", bio:"Victor Pagan is an actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1VTVqeXmP7IUCciOyoqpBUKj8zk.jpg", url:"https://themoviedb.org/person/59280"}}, {tmdbId:"11040", properties:{bornIn:" Stockholm, Stockholms län, Sweden", imdbId:"0358390", born:date('1967-09-0