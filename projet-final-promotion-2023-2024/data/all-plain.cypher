UNWIND [{tmdbId:"971329", properties:{bornIn:"Manhattan, New York, USA", imdbId:"3616206", born:date('1984-09-18'), name:"Nina Arianda", bio:"Nina Arianda (born Nina Arianda Matijcio; September 18, 1984) is an American film, stage and television actress.  She won a Tony Award for Best Lead Actress in a Play in 2012 for Venus in Fur.  She was also nominated for another Tony for her performance in Born Yesterday...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rZCZ0cF6DyWn5sOwhy2gv4mgi7.jpg", url:"https://themoviedb.org/person/971329"}}, {tmdbId:"1090687", properties:{imdbId:"3621345", name:"Helen Rogers", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gr7mzXGMwjk8Jpjw9KxRMvdY7Ef.jpg", url:"https://themoviedb.org/person/1090687"}}, {tmdbId:"1307320", properties:{bornIn:"Arlington, Virginia, USA", imdbId:"4078666", name:"Alexandra Turshen", bio:"Alexandra Turshen is an American film and television actress.  She is a former classical ballet dancer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6z3Q46ULQTMMCzfLdw0rwUjRAXS.jpg", url:"https://themoviedb.org/person/1307320"}}, {tmdbId:"1405969", properties:{imdbId:"4259098", name:"Lauren Molina", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5wO4MRjv9id9tHReoNpMCvDmRYY.jpg", url:"https://themoviedb.org/person/1405969"}}, {tmdbId:"77234", properties:{bornIn:"Jamshedpur, Jharkand, India", imdbId:"1231899", born:date('1982-07-18'), name:"Priyanka Chopra", bio:"​Priyanka Chopra is an Indian actress and former Miss World.  Before starting her acting career, she worked as a model and gained fame after winning the Miss World title in 2000.  She is often referred to by the nickname \"Piggy Chops\", which was given to her by co-stars on the set of the film Bluffmaster! Chopra made her acting debut with the 2002 Tamil film Thamizhan...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6yVdkbetHhWnJNomKATSTy5bGlN.jpg", url:"https://themoviedb.org/person/77234"}}, {tmdbId:"224223", properties:{bornIn:" Mumbai, Maharashtra, India", imdbId:"3828984", born:date('1985-07-06'), name:"Ranveer Singh", bio:"Ranveer Singh Bhavnani is an Indian film actor who appears in Hindi films.  After completing a bachelor's degree from Indiana University, Bloomington, Singh returned to India to pursue a career in film.  He made his acting debut in 2010 with a leading role in Yash Raj Films' romantic comedy Band Baaja Baaraat.  The film emerged as a critical and commercial success, earning Singh a Filmfare Award in the Best Male Debut category...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eWFBf4CLdnWSGJRNl0ugBEVs78q.jpg", url:"https://themoviedb.org/person/224223"}}, {tmdbId:"202845", properties:{bornIn:"Lake Forest, California, USA", imdbId:"2147876", born:date('1983-09-03'), name:"Christine Woods", bio:"From Wikipedia, the free encyclopedia. \n\nChristine Woods (b.  September 3, 1983) is an American actress who has appeared in numerous television shows.  More recently, she could be seen as part of the main cast in ABC's FlashForward, in which she portrayed FBI Special Agent Janis Hawk...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wBDuMqxjpqVcyT11CeokDWyqbCP.jpg", url:"https://themoviedb.org/person/202845"}}, {tmdbId:"41565", properties:{bornIn:"Canton, Ohio, U.S.", imdbId:"1535594", born:date('1977-12-01'), name:"Nate Torrence", bio:"From Wikipedia, the free encyclopedia. \n\nNathan Andrew \"Nate\" Torrence (born December 1, 1977) is an American comedic actor known for his  numerous roles in television advertisements. \n\nDescription above from the Wikipedia article Nate Torrence, licensed under CC-BY-SA, full list of  contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yT9o149xPygdY0NsF9sNgiQwuru.jpg", url:"https://themoviedb.org/person/41565"}}, {tmdbId:"149670", properties:{bornIn:"Los Angeles - California - USA", imdbId:"0918858", born:date('1970-12-29'), name:"Kevin Weisman", bio:"From Wikipedia, the free encyclopedia\n\nKevin Weisman (born December 29, 1970) is an American film, television and stage actor.  His best-known acting role was that of Marshall Flinkman on the television series Alias (2001–2006)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c0YWHu02cHGynufhOM7eNtIQ5ze.jpg", url:"https://themoviedb.org/person/149670"}}, {tmdbId:"1213603", properties:{bornIn:"Dobbs Ferry, New York, USA", imdbId:"0339011", born:date('1980-09-04'), name:"Max Greenfield", bio:"Max Greenfield is an American actor and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8f7K5f81I0A9vz0plREVuVR5yWr.jpg", url:"https://themoviedb.org/person/1213603"}}, {tmdbId:"482044", properties:{bornIn:"Lancester, Pensylvania, USA", imdbId:"3396631", born:date('1985-12-26'), name:"Beth Behrs", bio:"Beth Behrs (born December 26, 1985 height 5' 5\" (1,65 m)) is an American actress.  She plays Caroline Channing in the CBS sitcom 2 Broke Girls\n\nBehrs was born in Lancaster, Pennsylvania, the elder daughter of David Behrs, a college president, and Maureen Behrs, a first grade teacher. She has a sister who is six years younger. Behrs moved to Lynchburg, Virginia, in 1989, where she was raised. She began performing in theater at the age of four, and played soccer while growing up...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/weC4dku688I1aExh6UgQQUePcMr.jpg", url:"https://themoviedb.org/person/482044"}}, {tmdbId:"63234", properties:{bornIn:"Bellflower, California, USA", imdbId:"1018488", born:date('1969-10-10'), name:"Wendi McLendon-Covey", bio:"Wendi Anne McLendon-Covey is an American actress and comedian. \n\nAfter her a breakout performance in the 2011 comedy film Bridesmaids, She has appeared in numerous films.  In 2013 she began starring as Beverly Goldberg in the ABC comedy series The Goldbergs, for which she was nominated for a Critics' Choice Television Award for Best Actress in a Comedy Series in 2014...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d8VKC8Ms3u9XiW4e4jsy2grP02d.jpg", url:"https://themoviedb.org/person/63234"}}, {tmdbId:"1397783", properties:{imdbId:"6627667", name:"James Freedson-Jackson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5A3IAxyB2T2zBzM20PH0iVVDMXE.jpg", url:"https://themoviedb.org/person/1397783"}}, {tmdbId:"1397784", properties:{imdbId:"4881741", name:"Hays Wellford", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gTuoxG9OJxPld8UWsM8OCq6L7LS.jpg", url:"https://themoviedb.org/person/1397784"}}, {tmdbId:"1393915", properties:{imdbId:"6702770", name:"Kitana Kiki Rodriguez", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iR8bJguB5TGPXJCHIT42ICIWTBs.jpg", url:"https://themoviedb.org/person/1393915"}}, {tmdbId:"1393916", properties:{bornIn:"Houston, Texas, U.S.A.", imdbId:"4924757", born:date('1991-03-28'), name:"Mya Taylor", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kmjXjFdCBoNYXuXNd8UWeQccMSS.jpg", url:"https://themoviedb.org/person/1393916"}}, {tmdbId:"966306", properties:{imdbId:"1199489", name:"Karren Karagulian", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lO7UnbhlI0827HeahIb2GWh6F7F.jpg", url:"https://themoviedb.org/person/966306"}}, {tmdbId:"167132", properties:{imdbId:"1620433", name:"Karen Abercrombie", url:"https://themoviedb.org/person/167132"}}, {tmdbId:"1498038", properties:{imdbId:"2068185", name:"Priscilla C. Shirer", url:"https://themoviedb.org/person/1498038"}}, {tmdbId:"525138", properties:{imdbId:"3956954", name:"T.C. Stallings", url:"https://themoviedb.org/person/525138"}}] AS row
