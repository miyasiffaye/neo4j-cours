UNWIND [{tmdbId:"1373447", properties:{name:"Geeta Masi", url:"https://themoviedb.org/person/1373447"}}, {tmdbId:"34257", properties:{bornIn:"Camden Town, London, England, UK ", imdbId:"372117", born:date('1954-02-20'), name:"Anthony Stewart Head", bio:"Anthony Stewart Head (born 20 February 1954), usually credited as Anthony Head, is an English actor and musician.  He rose to fame in the UK following his role in television advertisements for Nescafé Gold Blend (Taster's Choice in the U. S. ), and is known for his roles as Rupert Giles in Buffy the Vampire Slayer and as Uther Pendragon in Merlin. \n\nDescription above from the Wikipedia article Anthony Head, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3IKmIaEQFgHtTlUI548eirwIJPP.jpg", url:"https://themoviedb.org/person/34257"}}, {tmdbId:"81243", properties:{bornIn:"Edogawa, Tokyo Prefecture, Japan", imdbId:"0657139", born:date('1972-01-22'), name:"Romi Park", bio:"Romi Park is a Japanese actress and voice actress of Korean descent.  At the first Seiyuu Awards, she won an award for her portrayal of Nana Oosaki in Nana.  She is known for voicing tough, calm, and mature preteen or teenage boys...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fEvexnzIMSiwajd7Tt1QVjSIDDS.jpg", url:"https://themoviedb.org/person/81243"}}, {tmdbId:"83928", properties:{bornIn:"Kumamoto, Japan", imdbId:"1069584", born:date('1979-05-30'), name:"Rie Kugimiya", bio:"Rie Kugimiya is a Japanese singer and voice actress affiliated with I'm Enterprise.   Some of Kugimiya's most prominent roles include Alphonse Elric in the Fullmetal Alchemist series, Kagura in Gin Tama, and Happy in Fairy Tail...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5uxG4tsx8vCfxI8yr1RoeDkrsDg.jpg", url:"https://themoviedb.org/person/83928"}}, {tmdbId:"9719", properties:{bornIn:"Kagoshima Prefecture, Japan", imdbId:"1289414", born:date('1960-02-28'), name:"Toru Okawa", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nomHObaqAsFa5hJBfbTS1baIZtm.jpg", url:"https://themoviedb.org/person/9719"}}, {tmdbId:"1112515", properties:{imdbId:"3727412", name:"Jeff Turley", url:"https://themoviedb.org/person/1112515"}}, {tmdbId:"1381547", properties:{imdbId:"5254152", name:"Jack Goldenberg", url:"https://themoviedb.org/person/1381547"}}, {tmdbId:"1624702", properties:{bornIn:"Milwaukee, Wisconsin, USA", born:date('1942-01-12'), name:"Bernardine Dohrn", bio:"Bernardine Rae Dohrn, born Ohrnstein, is a former leader of the Weather Underground, a militant radical group responsible for bombings of the United States Capitol, the Pentagon, and several police stations in New York, as well as the accidental Greenwich Village townhouse explosion that killed three members of the Underground...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/addEn6xFPzDjhh1yuR9SyOq8cMU.jpg", url:"https://themoviedb.org/person/1624702"}}, {tmdbId:"1663236", properties:{name:"Mark Rudd", url:"https://themoviedb.org/person/1663236"}}, {tmdbId:"57855", properties:{bornIn:"Brattleboro, Vermont, USA", imdbId:"1685658", born:date('1990-12-20'), name:"JoJo", bio:"​From Wikipedia, the free encyclopedia.   \n\nJoanna Noëlle Blagden Levesque (born December 20, 1990, height 5' 3½\" (1,61 m)), professionally known as JoJo, is an American recording artist and actress.  After competing on the television show, America's Most Talented Kids, she was noticed by record producer Vincent Herbert who asked her to audition for Blackground Records.  JoJo's self-titled debut album was released in June 2004 and has sold over 3 million copies worldwide...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tBqc9oC2tw9LMXPQDdl24nsRBKW.jpg", url:"https://themoviedb.org/person/57855"}}, {tmdbId:"77763", properties:{bornIn:"Long Island, New York, USA", imdbId:"0284201", born:date('1969-06-07'), name:"Mick Foley", bio:"From Wikipedia, the free encyclopedia\n\nMichael Francis \"Mick\" Foley, Sr.  (born June 7, 1965) is an American professional wrestler, author, comedian, actor, voice actor and former color commentator.  He has worked for many wrestling promotions, including World Wrestling Entertainment (WWE, formerly WWF), World Championship Wrestling (WCW), National Wrestling Alliance (NWA), Extreme Championship Wrestling (ECW) and currently Total Nonstop Action Wrestling (TNA)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/DHUA9BWpNlue1Wk4eIk2r9zjUF.jpg", url:"https://themoviedb.org/person/77763"}}, {tmdbId:"33016", properties:{bornIn:"Hammond, Indiana, USA", imdbId:"0298750", born:date('1944-06-30'), name:"Terry Funk", bio:"From Wikipedia, the free encyclopedia\n\nTerrence \"Terry\" Funk (born June 30, 1944) is an American professional wrestler and actor known chiefly for the hardcore wrestling style he adopted in the latter part of his career that inspired many younger wrestlers, including Mick Foley.  Funk has appeared in the NWA, AWA, WWF/E, WCW, ECW, USWA, ROH, and TNA...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hcTda82quZ40tEzWCOMZEtId7QR.jpg", url:"https://themoviedb.org/person/33016"}}, {tmdbId:"1224931", properties:{bornIn:"Passaic, New Jersey, U.S.", imdbId:"0899866", born:date('1939-06-09'), name:"Dick Vitale", bio:"Richard John \"Dick\" Vitale (born June 9, 1939), also known as \"Dickie V\", is an American basketball sportscaster.  A former head coach in the college and professional ranks, he is well known as a college basketball broadcaster for ESPN.  He is known for catchphrases such as \"baby\" and \"diaper dandy\" (outstanding freshman player), as well as enthusiastic and colorful remarks he makes during games, and has authored nine books and appeared in several movies...", url:"https://themoviedb.org/person/1224931"}}, {tmdbId:"81851", properties:{imdbId:"0793987", born:date('1963-08-08'), name:"Emi Shinohara", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3a8bruVKiRVyRy4SrReNpLZvQpp.jpg", url:"https://themoviedb.org/person/81851"}}, {tmdbId:"1222101", properties:{bornIn:" Fukuoka, Fukuoka Prefecture, Japan", imdbId:"0959972", born:date('1946-03-13'), name:"Ryūsuke Ōbayashi", bio:"Ryūsuke Ōbayashi (大林 隆介 Ōbayashi Ryūsuke, born March 13, 1946 in Fukuoka, Fukuoka Prefecture, Japan) is a Japanese voice actor.  Some of his best known roles include Soun Tendo in Ranma ½ and Captain Kiichi Goto in Patlabor.  He was formerly credited as Ryūnosuke Ōbayashi (大林　隆之介 Ōbayashi Ryūnosuke), and his real name is Shōchi Ōbayashi (大林　昌一 Ōbayashi Shōichi).  He is employed by the talent management firm 81 Produce...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1sZ5ZQDtlwcMBOT7HWsPnzou9XL.jpg", url:"https://themoviedb.org/person/1222101"}}, {tmdbId:"15761", properties:{bornIn:"Fort Ord, California, USA", imdbId:"0217221", born:date('1973-08-24'), name:"Grey DeLisle", bio:"Erin Grey Van Oosbree (born August 24, 1973), credited as Grey DeLisle and Grey Griffin, is an American voice actress and singer-songwriter. \n\nShe has done voice acting for numerous animated films, television shows, and video games.  She has been the voice of Daphne Blake in the Scooby-Doo cartoons and direct-to-videos and other appearances since 2000...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eSUflDcMYGjHodSA2Xnsm2eDRD9.jpg", url:"https://themoviedb.org/person/15761"}}, {tmdbId:"77275", properties:{imdbId:"1385421", name:"Arif Herati", url:"https://themoviedb.org/person/77275"}}, {tmdbId:"123294", properties:{bornIn:"Iceland", imdbId:"1743730", born:date('1976-04-06'), name:"Georg Holm", bio:"Georg \"Goggi\" Hólm is the bassist of the Icelandic post-rock band Sigur Rós.  Hólm is the most prominent member of Sigur Rós in the English press, as he does significantly more press than the other members due to his being the most fluent English-speaker in the band; part of Georg's fluency in English comes from briefly living in Brighton, England...", url:"https://themoviedb.org/person/123294"}}, {tmdbId:"77303", properties:{bornIn:"Beijing, China", imdbId:"1281653", born:date('1946-03-19'), name:"Wang Xueqi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6ZWonDufaYcVeMmv1ZD8MZZZDeM.jpg", url:"https://themoviedb.org/person/77303"}}, {tmdbId:"10501", properties:{bornIn:" Tel Aviv, Israel", imdbId:"0867694", born:date('1935-09-09'), name:"Chaim Topol", bio:"Chaim Topol ( born September 9, 1935), often billed simply as Topol, is an Israeli theatrical and film performer. \n\nDescription above from the Wikipedia article Chaim Topol, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Ah6ZOrg9AmeqPU04qUGF5eon2Fv.jpg", url:"https://themoviedb.org/person/10501"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"5462", properties:{bornIn:"Jacksonville, Oregon, USA", imdbId:"0173416", born:date('1892-09-11'), name:"Pinto Colvig", bio:"He is probably best known as the voice of Disney's Goofy and the original Bozo the Clown, a part he played for a full decade beginning in 1946.  He also provided the voice for Practical Pig, the pig who built the \"house of bricks\" in the Disney short Three Little Pigs, as well as both Sleepy and Grumpy in Snow White and the Seven Dwarfs, and the barks for Pluto the dog.  Colvig worked for not only the Disney studio, but also the Warner Bros...", died:date('1967-10-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o1YhkxvvCtpU9SkFEwl8n2iNFL4.jpg", url:"https://themoviedb.org/person/5462"}}, {tmdbId:"20654", properties:{bornIn:"Jilin, China", imdbId:"1091782", born:date('1978-03-23'), name:"Liu Ye", bio:"Liu Ye (Chinese: 刘烨; pinyin: Líu Yè, born March 23, 1978 in Jilin, China) is a Chinese film and television actor. \n\nBeginning his acting career when he was a 20 year old student majoring in performing arts at the Central Academy of Drama in Beijing, Liu Ye's talent in acting was apparent very early on.  Liu was nominated for Best Supporting Actor for his role as a young postman in his first movie, Postmen in the Mountains, at China's Golden Rooster Awards in 1999...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5tDiEoDtp1wvIgJU5pdP9hLK1oF.jpg", url:"https://themoviedb.org/person/20654"}}, {tmdbId:"17120", properties:{bornIn:"Seoul, South Korea", imdbId:"0432601", born:date('1973-03-20'), name:"Jung Woo-sung", bio:"Jung Woo-sung (March 20, 1973) is a South Korean actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/srGmUJpKDYh6jtKkKmzUSTCDgsX.jpg", url:"https://themoviedb.org/person/17120"}}, {tmdbId:"1244152", properties:{imdbId:"0049154", name:"Jim Bakker", url:"https://themoviedb.org/person/1244152"}}, {tmdbId:"3186", properties:{bornIn:"New Castle, Pennsylvania", imdbId:"0722153", born:date('1965-05-17'), name:"Trent Reznor", bio:"From Wikipedia, the free encyclopedia\n\nMichael Trent Reznor (born May 17, 1965) is an American singer-songwriter, multi-instrumentalist, composer, producer, actor, leader of industrial rock band Nine Inch Nails, and member of How to Destroy Angels alongside his wife, Mariqueen Maandig, and Atticus Ross.  He was previously associated with bands Option 30, Exotic Birds, and Tapeworm, among others.  Reznor left Interscope Records in 2007, and is now an independent musician...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gzvgK9ydCfW5Sh9tsEeYcYCnxrh.jpg", url:"https://themoviedb.org/person/3186"}}, {tmdbId:"60642", properties:{bornIn:"Gainesville, Florida, USA", imdbId:"0678816", born:date('1950-10-20'), name:"Tom Petty", bio:"Thomas Earl \"Tom\" Petty (born October 20, 1950) is an American singer-songwriter and multi-instrumentalist.  He is the frontman of Tom Petty and the Heartbreakers and a founding member of the late 1980s supergroup Traveling Wilburys and Mudcrutch.  He has also performed under the pseudonyms of Charlie T.  Wilbury, Jr.  and Muddy Wilbury...", died:date('2018-05-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iYZ34EdhyaVbGyBagXyQ2v1YLrG.jpg", url:"https://themoviedb.org/person/60642"}}, {tmdbId:"16450", properties:{bornIn:"New York City, New York, USA", imdbId:"0004835", born:date('1969-11-04'), name:"Sean Combs", bio:"American rapper, singer, record producer, actor and men's fashion designer Sean John Combs was born in Harlem and grew up in Mount Vernon, New York.  He dropped out of Howard University to become a top executive at Uptown Records and founded Bad Boy Records in 1993. \n\nHe has taken the roles of recording executive, performer, producer of MTV's Making the Band, writer, arranger, clothing designer, and Broadway actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hEyRWDouxLiDWguMzJyoagZAReu.jpg", url:"https://themoviedb.org/person/16450"}}, {tmdbId:"1755", properties:{bornIn:"Columbus, Ohio, USA", imdbId:"0000854", born:date('1932-02-23'), name:"Majel Barrett", bio:"Majel Barrett-Roddenberry  (born Majel Leigh Hudec; February 23, 1932 – December 18, 2008) was an American actress and producer.  She is perhaps best known for her role as Nurse Christine Chapel in the original Star Trek series, and for being the voice of most onboard computer interfaces throughout the series.  She was also the wife of Star Trek creator Gene Roddenberry...", died:date('2008-12-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uTnxd737sEFgc6hVrFgUC5TwzfW.jpg", url:"https://themoviedb.org/person/1755"}}, {tmdbId:"2317487", properties:{name:"Hiroaki Suzuki", url:"https://themoviedb.org/person/2317487"}}, {tmdbId:"2639767", properties:{name:"Hiroshi Ootaki", url:"https://themoviedb.org/person/2639767"}}, {tmdbId:"1320013", properties:{imdbId:"5747282", name:"Dean Gomersall", url:"https://themoviedb.org/person/1320013"}}, {tmdbId:"14313", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0522306", born:date('1938-07-26'), name:"Darlene Love", bio:"Born Darlene Wright in Los Angeles in 1938, she began her career as lead singer with the vocal trio, The Blossoms.  After a spell as regulars on ABC TV's variety show Shindig! (1964) in the early 60s, the trio went on to sing backup on a variety of Elvis Presley recordings, and even backed him on his 1968 NBC-TV special Elvis: The Comeback Special (1968).  For a while, they backed Tom Jones during some of his Las Vegas shows...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5V7j58GBnRmpiEIZQlT7AXHErKy.jpg", url:"https://themoviedb.org/person/14313"}}, {tmdbId:"1207582", properties:{imdbId:"0141536", name:"Clarence Carter", url:"https://themoviedb.org/person/1207582"}}, {tmdbId:"998494", properties:{bornIn:"Guiyang, Guizhou, China", imdbId:"0632440", born:date('1972-04-27'), name:"Ning Jing", bio:"Ning Jing was born on April 27, 1972 in Guiyang, Guizhou, China.  She is an actress, known for Red Firecracker, Green Firecracker (1994), Red River Valley (1997) and Heart of China (1999)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cxAFx855PYi8c3sOVE4v7y0j2d.jpg", url:"https://themoviedb.org/person/998494"}}, {tmdbId:"1019795", properties:{bornIn:"Beijing, China", imdbId:"3173607", born:date('1960-11-04'), name:"Wu Gang", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hw9Nqp9rUp1xRil07HoYyJAnqvG.jpg", url:"https://themoviedb.org/person/1019795"}}, {tmdbId:"111466", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0551065", born:date('1947-08-31'), name:"Mona Marshall", bio:"From Wikipedia, the free encyclopedia.  Mona Marshall (born Mona Mortica Ianotti on August 31, 1947) is an American voice actress.  She is often cast in the role of young boys.  Her roles have included parts in not only Japanese anime, but also in American cartoons as well.  Mona Marshall has recently lent her voice to the talking bear Koby the Study Buddy...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/A2RCAt0Xmm3jLBKZogQAJX6eD9n.jpg", url:"https://themoviedb.org/person/111466"}}, {tmdbId:"31137", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0924552", born:date('1975-04-21'), name:"Brian J. White", bio:"Bian Joseph White (born April 21, 1975) is an American actor, producer, model, dancer, and stockbroker.  White was born near Boston, Massachusetts, the son of Estelle Bowser, a financial advisor, and Jo Jo White, a basketball player for the Boston Celtics, sports executive, and restaurateur.  He is the oldest of six children.  White attended Newton South High School and was a graduate of Dartmouth College, where he was a member of the Beta Theta Pi fraternity...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rNX2wRiV1XXiqPMnsnxWpp8FkpD.jpg", url:"https://themoviedb.org/person/31137"}}, {tmdbId:"544916", properties:{bornIn:"Hebei, China", imdbId:"0151787", born:date('1931-01-01'), name:"Paul Chang Chung", bio:"Born Chang Chung Tien in 1931...", died:date('2010-01-01'), url:"https://themoviedb.org/person/544916"}}, {tmdbId:"106837", properties:{bornIn:"Racine, Wisconsin, USA", imdbId:"0263691", born:date('1958-01-04'), name:"Cory Everson", bio:"Corinna Kneuer (born January 4, 1958), best known by her stage name Cory (or Corey) Everson, is an American female bodybuilding champion and actress.  She won the Ms.  Olympia contest six years in a row from 1984 to 1989. \n\nDescription above from the Wikipedia article Cory Everson, licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/s7uzAnkncQUujZkBkWvCQLGLHG.jpg", url:"https://themoviedb.org/person/106837"}}, {tmdbId:"1150758", properties:{imdbId:"5524328", name:"Loungnam Kaosainam", url:"https://themoviedb.org/person/1150758"}}] AS row
