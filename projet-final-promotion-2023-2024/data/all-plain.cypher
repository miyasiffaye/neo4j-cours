UNWIND [{tmdbId:"229695", properties:{bornIn:"Dublin, Ireland", imdbId:"0444096", born:date('1960-01-01'), name:"David Keating", bio:"Known for directing the 2009 sleeper hit \"Woke Wood\" starring Petyr Baelish.  Keating is one of the leading auteurs in Irish cinema.  His works have garnered much discussion in Film Schools around the world.  His experimental use of the Meisner technique, which he has re-purposed as 'the Keating method' has revolutionized the director-actor relationship...", url:"https://themoviedb.org/person/229695"}}, {tmdbId:"91641", properties:{bornIn:"London, England, UK", imdbId:"1671943", born:date('1972-02-03'), name:"Franny Armstrong", bio:"From Wikipedia, the free encyclopedia. \n\nFranny Armstrong (born 3 February 1972) is a British documentary film director working for her own company, Spanner Films, and a former drummer with indie pop group The Band of Holy Joy.  She is primarily known for three films: climate change blockbuster The Age of Stupid, McLibel, about the infamous McDonald's court case and Drowned Out, following the fight against the Narmada Dam Project...", url:"https://themoviedb.org/person/91641"}}, {tmdbId:"142312", properties:{bornIn:"South Korea", imdbId:"0950775", born:date('1972-05-07'), name:"Jennifer Yuh", bio:"From Wikipedia, the free encyclopedia.   Jennifer Yuh Nelson (born May 7, 1972) is a Korean-American director and storyboard artist.  She is the director of Kung Fu Panda 2, Kung Fu Panda 3, and The Darkest Minds.  Yuh is the first woman to solely direct an animated feature from a major Hollywood studio...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/opLn7bTvqUOkio2OrZU5Ejam6cV.jpg", url:"https://themoviedb.org/person/142312"}}, {tmdbId:"140229", properties:{imdbId:"0069900", name:"Mehdi Ben Attia", url:"https://themoviedb.org/person/140229"}}, {tmdbId:"41621", properties:{imdbId:"0469813", name:"Tony Krantz", url:"https://themoviedb.org/person/41621"}}, {tmdbId:"114334", properties:{bornIn:" Sydney, Australia", imdbId:"2391575", born:date('1972-11-30'), name:"David Michôd", bio:"David Michôd ([Mish-oh]; born 30 November 1972 in Sydney) is an Australian film director, screenwriter and producer. \n\nHe is best known for directing his first feature film, the critically acclaimed crime drama Animal Kingdom (2010), which got an Academy Award nomination for best supporting actress Jacki Weaver.  His follow-up was the dystopian drama The Rover (2014) with Guy Pearce and Robert Pattinson, War Machine (2017) with Brad Pitt and The King (2019) with Timothée Chalamet...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i36sil9wx4Esgc7t2dDtZwUfeMc.jpg", url:"https://themoviedb.org/person/114334"}}, {tmdbId:"77357", properties:{bornIn:"Exeter, UK", imdbId:"1012501", born:date('1972-10-26'), name:"Rupert Wyatt", bio:"Rupert Wyatt (born 26 October 1972 in Exeter) is a British writer and film director...", url:"https://themoviedb.org/person/77357"}}, {tmdbId:"112582", properties:{imdbId:"1155102", name:"Judith Ehrlich", url:"https://themoviedb.org/person/112582"}}, {tmdbId:"112585", properties:{imdbId:"0326124", name:" Rick Goldsmith", url:"https://themoviedb.org/person/112585"}}, {tmdbId:"124747", properties:{imdbId:"1853544", born:date('1967-03-16'), name:"Pierre Coffin", bio:"From Wikipedia, the free encyclopedia.   \n\nPierre Coffin, born in 1967, is a French animator and director.  He was trained at the Gobelins in Paris and started to work at Amblimation, the 2D London based facility, where he worked on the Steven Spielberg-executive-produced We're Back! A Dinosaur's Story.  He then started as a freelance animator in the French CGI studio Ex Machina where he worked as animator, animation supervisor, and eventually director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5HojYPP34c4agydy7D90apCMNHn.jpg", url:"https://themoviedb.org/person/124747"}}, {tmdbId:"90583", properties:{imdbId:"0034531", born:date('1972-09-14'), name:"Don Argott", bio:"From Wikipedia, the free encyclopedia.  \n\n \n\nDon Argott (born September 14, 1972) is an American documentary filmmaker and musician originally from Pequannock, New Jersey, and currently residing in Philadelphia, Pennsylvania. \n\nArgott has directed the documentary films Rock School (2005), Two Days in April (2007), and The Art of the Steal (2009), and has also worked as a producer and cinematographer.   He co-owns the production company 9. 14 Pictures with producer Sheena M.  Joyce...", url:"https://themoviedb.org/person/90583"}}, {tmdbId:"801", properties:{bornIn:"Graz, Austria", imdbId:"0322198", born:date('1959-12-03'), name:"Michael Glawogger", died:date('2014-04-23'), url:"https://themoviedb.org/person/801"}}, {tmdbId:"234400", properties:{imdbId:"1645978", name:"Nicolo Donato", url:"https://themoviedb.org/person/234400"}}, {tmdbId:"94264", properties:{bornIn:"Sweden", imdbId:"0028220", born:date('1972-09-28'), name:"Casper Andreas", bio:"Casper Andreas is an American actor, film director, screenwriter, and film producer based in New York City. \n\nAs an actor, he has guest starred on \"Hawaii Five-0\" and the Hulu series \"Deadbeat\" and most recently co-starred on the new TV series \"Lethal Weapon\".  Film roles include \"I Dream Too Much\", \"Hitch\", Little Children\", and \"Celebrity\".  He has also appeared in many of his own films -- a few times in starring roles and more often in supporting roles...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jNglHpyJ9cp3VnRm2RhYZvWAElq.jpg", url:"https://themoviedb.org/person/94264"}}, {tmdbId:"115143", properties:{imdbId:"2640570", name:" Fred M. Caruso", url:"https://themoviedb.org/person/115143"}}, {tmdbId:"938682", properties:{bornIn:"Österåker, Stockholms län, Sweden", imdbId:"1158962", born:date('1963-06-27'), name:" Patrik Forsberg", url:"https://themoviedb.org/person/938682"}}, {tmdbId:"1272994", properties:{imdbId:"1743387", name:" Jonathan van Tulleken", url:"https://themoviedb.org/person/1272994"}}, {tmdbId:"89930", properties:{bornIn:"Copenhagen, Denmark", imdbId:"0960312", name:"Anders Østergaard", bio:"Danish director, not to be confused with the norwegian director  Anders Øvergaard...", url:"https://themoviedb.org/person/89930"}}, {tmdbId:"141675", properties:{imdbId:"0934864", name:"Jason Winer", bio:"From Wikipedia, the free encyclopedia\n\nJason Winer is an American director, producer, writer, actor and comedian.  He is best known for being one of the directors on the award-winning series Modern Family on ABC. \n\nWiner was born and raised in Baltimore, Maryland.  He attended Northwestern University and was an alumnus of the Improv Olympic Theatre. \n\nAfter college, Winer acted in television commercials for companies such as Budweiser, Nike and Dr.  Pepper...", url:"https://themoviedb.org/person/141675"}}, {tmdbId:"550681", properties:{imdbId:"1204442", name:"Nick Tomnay", url:"https://themoviedb.org/person/550681"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"239571", properties:{imdbId:"0727754", name:"Carl Rinsch", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ngiDXCAJ8FgsbpdZ8ULPte70AEf.jpg", url:"https://themoviedb.org/person/239571"}}, {tmdbId:"588219", properties:{imdbId:"0697934", name:"D. Kerry Prior", url:"https://themoviedb.org/person/588219"}}, {tmdbId:"567559", properties:{imdbId:"0257373", name:" Kurt Engfehr", url:"https://themoviedb.org/person/567559"}}, {tmdbId:"74924", properties:{imdbId:"1333798", name:"Mabrouk El Mechri", url:"https://themoviedb.org/person/74924"}}, {tmdbId:"2540183", properties:{name:"John Sobrack", url:"https://themoviedb.org/person/2540183"}}, {tmdbId:"122423", properties:{bornIn:"Athens, Greece", imdbId:"0487166", born:date('1973-05-27'), name:"Yorgos Lanthimos", bio:"Yorgos Lanthimos (born 1973) is a Greek filmmaker and theatre director. \n\nYorgos Lanthimos was born in Athens.  He studied directing for Film and Television at the Stavrakos Film School in Athens.  Through the 90’s he directed a series of videos for Greek dance-theater companies.  Since 1995 he has directed a large number of TV commercials, in addition to music videos, short films and experimental theater plays...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eK2RB0nSEmB6RVSbHB2b6v0Nuip.jpg", url:"https://themoviedb.org/person/122423"}}, {tmdbId:"1921", properties:{bornIn:"Boston - Massachusetts - USA", imdbId:"1079776", born:date('1968-06-10'), name:"George Nolfi", bio:"From Wikipedia, the free encyclopedia. \n\nGeorge Nolfi is an American screenwriter.  He directed the 2011 film The Adjustment Bureau, which he also wrote (adapted from a short story by Philip K.  Dick). \n\nDescription above from the Wikipedia article Sarah George Nolfi, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/1921"}}, {tmdbId:"234397", properties:{imdbId:"0540220", name:"Jeff Malmberg", url:"https://themoviedb.org/person/234397"}}, {tmdbId:"132876", properties:{bornIn:"Gander, Canada", imdbId:"0679031", born:date('1978-05-27'), name:"Brad Peyton", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7F7dM4A6QbA67xOxTJyv3aqinrA.jpg", url:"https://themoviedb.org/person/132876"}}, {tmdbId:"121873", properties:{bornIn:"Cambridge, Massachusetts, USA", imdbId:"0335138", born:date('1963-02-06'), name:"Debra Granik", bio:"From Wikipedia, the free encyclopedia. \n\nDebra Granik (born the 6th of February, 1963) is an American independent filmmaker...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fgV1v014IAKTKJWLigH5IhxKisU.jpg", url:"https://themoviedb.org/person/121873"}}, {tmdbId:"145228", properties:{bornIn:"Helsinki, Finland", imdbId:"1118351", born:date('1976-07-21'), name:"Jalmari Helander", url:"https://themoviedb.org/person/145228"}}, {tmdbId:"131521", properties:{imdbId:"1127632", born:date('1977-01-01'), name:"Spencer Susser", bio:"From Wikipedia, the free encyclopedia.   Spencer Susser is an American film director and screenwriter.   Susser is the only American member of the Australian filmmaking collective Blue-Tongue Films.   His short film I Love Sarah Jane, featuring Mia Wasikowska, won Best Narrative Short at the 2008 Nashville Film Festival,  the Reel Frontier Merit Award at the Arizona International Film Festival, and the Canal+ Award at the Clermont-Ferrand International Short Film Festival...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uf5t2vuykcGNIW7JGN6cCUL2QUB.jpg", url:"https://themoviedb.org/person/131521"}}, {tmdbId:"53276", properties:{imdbId:"0630633", name:"Galt Niederhoffer", bio:"From Wikipedia, the free encyclopedia. \n\nGalt Niederhoffer (born 1975) is an American movie producer and novelist. \n\nHer movie credits as a producer include Prozac Nation (2001), Lonesome Jim (2005), The Baxter (2005) and Grace Is Gone (2006).  She is one of the principals at Plum Pictures. \n\nHer autobiographical novel A Taxonomy of Barnacles (2005) about rivalry among six sisters has been described as \"zany and witty\" by some critics, \"silly and contrived\" by others...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7Y0Q6Zm3Ro8VGyjNLaYYyrRrGLm.jpg", url:"https://themoviedb.org/person/53276"}}, {tmdbId:"109745", properties:{bornIn:"Los Angeles, California, Stati Uniti", imdbId:"1767218", born:date('1983-01-24'), name:"Lee Toland Krieger", url:"https://themoviedb.org/person/109745"}}, {tmdbId:"2688238", properties:{name:"Ho-Cheung Pang", url:"https://themoviedb.org/person/2688238"}}, {tmdbId:"1707", properties:{imdbId:"0064181", born:date('1972-01-01'), name:"Stuart Beattie", bio:"From Wikipedia, the free encyclopedia. \n\nStuart Beattie (born 1972) is an Australian screenwriter and film director.  He attended Knox Grammar School, in Sydney, Australia, where his mother, Sandra, was a languages teacher, and later Charles Sturt University in Bathurst. \n\nDescription above from the Wikipedia article Stuart Beattie, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mgR1jZAECtmvQ67iuZixlI3xFn6.jpg", url:"https://themoviedb.org/person/1707"}}, {tmdbId:"137475", properties:{bornIn:"Toronto - Ontario - Canada", imdbId:"0003557", name:"Richard J. Lewis", bio:"From Wikipedia, the free encyclopedia. \n\nRichard J.  Lewis is a television and film director born in Toronto, Ontario, Canada. \n\nFrom 2002 to 2009, Lewis worked on the CBS television crime`drama series, CSI: Crime Scene Investigation as writer, director and co-executive producer. \n\nHe is best known for directing the films Whale Music (1994) and Barney's Version (2010), the latter featuring a Golden Globe winning performance by actor Paul Giamatti...", url:"https://themoviedb.org/person/137475"}}, {tmdbId:"55251", properties:{bornIn:"Hackney, London, England, UK", imdbId:"0438090", born:date('1972-01-01'), name:"Asif Kapadia", bio:"​From Wikipedia, the free encyclopedia.   \n\nAsif Kapadia (born 1972) is a British filmmaker of Indian descent.  He directed several award-winning films, including The Sheep Thief (1997), winner of the 2nd Prize Cinéfondation for Short Film at the Cannes Film Festival, The Warrior (2001), which won the BAFTA Award for Best British Film and Senna (2010), winner of the World Cinema Audience Award Documentary at the Sundance Film Festival 2011...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5FuAWpePS3R5UcIysUrmeNZEGFe.jpg", url:"https://themoviedb.org/person/55251"}}, {tmdbId:"21198", properties:{bornIn:"Bronx, New York, USA", imdbId:"0812307", born:date('1975-06-21'), name:"Peter Sohn", bio:"From Wikipedia, the free encyclopedia\n\nPeter Sohn is a Pixar storyboard artist and animator.  Sohn started his career with Pixar in the art and story departments for Finding Nemo.  He also worked on The Incredibles, Ratatouille and WALL-E.  Sohn performed the voice of Emile in Ratatouille.  He made his directorial debut with the short film Partly Cloudy in 2009 which he also wrote.  In a CGSociety article, Sohn says his idea for Partly Cloudy came from watching Dumbo as a child...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oxHZZfhXiKWH7n4ZQlo9UjBbvWV.jpg", url:"https://themoviedb.org/person/21198"}}, {tmdbId:"112280", properties:{bornIn:"Asakusa, Tokyo, Japan", imdbId:"1883583", born:date('1969-04-01'), name:"Yoshihiro Nishimura", bio:"From Wikipedia, the free encyclopedia\n\nYoshihiro Nishimura  is a Japanese film director, special effects and makeup effects artist, and a screenwriter who has worked predominantly in the horror genre.  Nishimura has been described as \"a legendary director and effects artist\" and \"the Tom Savini of Japan\" with \"talent to burn\".  He has been credited with establishing a new type of visual film presentation, the \"gore effect\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uXJ6hq8F4XM6NR18Lcf1SpXehDE.jpg", url:"https://themoviedb.org/person/112280"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"80762", properties:{bornIn:"Osaka, Japan", imdbId:"1381841", born:date('1967-02-23'), name:" Naoyuki Tomomatsu", bio:"Naoyuki Tomomatsu is a Japanese film director and screenwriter who has worked in the pink film and horror genres. \n\nDescription above from the Wikipedia article Naoyuki Tomomatsu, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/80762"}}, {tmdbId:"208113", properties:{name:"Sarah Smith", url:"https://themoviedb.org/person/208113"}}, {tmdbId:"928490", properties:{imdbId:"0216214", name:"Camille Delamarre", url:"https://themoviedb.org/person/928490"}}, {tmdbId:"565297", properties:{imdbId:"0627920", name:" Jeff Newitt", url:"https://themoviedb.org/person/565297"}}, {tmdbId:"527607", properties:{bornIn:"Canada ", imdbId:"1699934", born:date('1981-12-09'), name:"Sean Durkin", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gdi5W76r0VhfycibNttA6YEXFsQ.jpg", url:"https://themoviedb.org/person/527607"}}, {tmdbId:"151007", properties:{bornIn:"Baldwin Hills, California, Stati Uniti", imdbId:"0709056", name:"Peter Ramsey", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9708uu7CeTLSzm69ykdYxgPcd2S.jpg", url:"https://themoviedb.org/person/151007"}}, {tmdbId:"141688", properties:{imdbId:"1834213", name:"Gary McKendry", bio:"​From Wikipedia, the free encyclopedia.   \n\nGary McKendry is a Northern Irish film and television commercial director.  His short film Everything in This Country Must was nominated for an Academy Award in 2005. \n\nMcKendry was born and raised in Ballyclare, County Antrim, Northern Ireland.  He attended the Belfast College of Art for a year before enrolling at Central Saint Martins College of Art and Design in London...", url:"https://themoviedb.org/person/141688"}}, {tmdbId:"76965", properties:{bornIn:"Aberdeen, Regno Unito", imdbId:"1580671", born:date('1972-01-01'), name:"Jon S. Baird", url:"https://themoviedb.org/person/76965"}}, {tmdbId:"225976", properties:{bornIn:"Clawson, Michigan, USA", imdbId:"0768959", born:date('1976-06-21'), name:"Dan Scanlon", bio:"From Wikipedia, the free encyclopedia. \n\nDan Scanlon was an animator for The Indescribable Nth and Joseph: King of Dreams.  He served as a storyboard artist for The Little Mermaid II: Return to the Sea and 101 Dalmatians II: Patch's London Adventure.  He is the director of the upcoming Pixar film Monsters University, due to release in 2013. \n\nScanlon currently works at Pixar, and was a story artist for Cars and Toy Story 3.  He co-directed the short film Mater and the Ghostlight...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sNHqtJKMd59fvEiwBRPD3zKKYQ4.jpg", url:"https://themoviedb.org/person/225976"}}, {tmdbId:"55789", properties:{bornIn:"Jackson, Mississippi, USA", imdbId:"0853238", born:date('1969-06-03'), name:"Tate Taylor", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7xXp4TsBl6OB4v2kNqvKAG5uOnh.jpg", url:"https://themoviedb.org/person/55789"}}, {tmdbId:"52479", properties:{bornIn:"Los Angeles County, California, USA", imdbId:"0185848", born:date('1972-05-25'), name:"Eli Craig", bio:"Elijah M.  \"Eli\" Craig (born May 25, 1972 in Los Angeles) is a Writer/Director, who started his Hollywood career with a few small acting jobs. \n\nHis first full-length film as writer/director was the horror comedy movie Tucker &amp; Dale vs Evil, which took three years to complete. \n\nDescription above from the Wikipedia article Eli Craig, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/52479"}}, {tmdbId:"83189", properties:{bornIn:"Livorno, Italy", imdbId:"0899501", born:date('1964-03-04'), name:"Paolo Virzì", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1KqQ7j1rx91LUq0i5SA7CAtqfJ9.jpg", url:"https://themoviedb.org/person/83189"}}, {tmdbId:"118639", properties:{bornIn:"Alkmaar, Noord-Holland, Netherlands", imdbId:"1519353", born:date('1973-08-29'), name:"Tom Six", bio:"Tom Six was born in Alkmaar, Noord-Holland, in the Netherlands on August 29, 1973.  He has stated that his love of film began at an early age, when he would run around with his grandfather's camera, recording the world around him.   Six was heavily influenced by a number of horror films released during his upbringing, such as the 1975 Italian \"drama\" film Saló, or the 120 Says of Sodom and the 1979 Canadian horror film The Brood.  Six has stated that Salò is the sickest film he has ever seen...", url:"https://themoviedb.org/person/118639"}}, {tmdbId:"107699", properties:{imdbId:"2342225", name:"Boris Acosta", url:"https://themoviedb.org/person/107699"}}, {tmdbId:"155531", properties:{bornIn:"London, England", imdbId:"0180428", born:date('1968-12-20'), name:"Joe Cornish", bio:"From Wikipedia, the free encyclopedia. \n\nJoseph Murray \"Joe\" Cornish (born 20 December 1968) is an English Comedian, Television &amp; Radio presenter, Director, Writer and Actor, who along with his long-time comedy partner, Adam Buxton, form the comedy duo Adam and Joe. \n\nDescription above from the Wikipedia article Joe Cornish (comedian), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yJNJ0haP69aPf3fhiCJXvlESDss.jpg", url:"https://themoviedb.org/person/155531"}}, {tmdbId:"124748", properties:{bornIn:"Baltimore, Maryland, U.S.", imdbId:"0719208", born:date('1966-12-05'), name:"Chris Renaud", bio:"From Wikipedia, the free encyclopedia.   \n\nChris Renaud is an American illustrator and film-maker.  He was nominated for an Academy Award for the 2006 animated short No Time for Nuts, which featured the character Scrat from the computer animated Ice Age films.  Most recently, he directed Despicable Me, starring the voice of Steve Carell, which debuted #1 at the U. S.  box office on July 9th, 2010...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sumBJgBqRkK4XEJ2JYXpad3MTJs.jpg", url:"https://themoviedb.org/person/124748"}}, {tmdbId:"560352", properties:{imdbId:"2909800", name:"Munehisa Sakai", url:"https://themoviedb.org/person/560352"}}, {tmdbId:"82222", properties:{imdbId:"0540148", name:"Emmett Malloy", url:"https://themoviedb.org/person/82222"}}, {tmdbId:"45421", properties:{imdbId:"0737442", name:"Todd Rohal", bio:"Todd Rohal is an American independent filmmaker.  His three feature films are 2012's Nature Calls, 2011's The Catechism Cataclysm, and 2006'sThe Guatemalan Handshake.  He is also responsible for the short films Single Spaced (1997), Slug 660 (1998), Knuckleface Jones (1999) and Hillbilly Robot (2001).  Single Spaced and Knuckleface Jones both feature actress Piper Perabo, a college friend of Rohal...", url:"https://themoviedb.org/person/45421"}}, {tmdbId:"90367", properties:{imdbId:"0515005", name:"Sam Liu", bio:"From Wikipedia, the free encyclopedia. \n\nSam Liu is an American animation director and storyboard artist.  He is best know for his directing on animated superhero films at both Marvel Entertainment and Warner Bros.  Animation.  Titles include All-Star Superman, Superman/Batman:Public Enemies, Hulk Vs, Planet Hulk, Thor: Son of Asgard and co-directing with Lauren Montgomery on Justice League: Crisis on Two Earths and Batman:Year One...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3u01dPeS4Us9sUFzwS8DzjA3udr.jpg", url:"https://themoviedb.org/person/90367"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"80923", properties:{bornIn:"Vallentuna, Stockholms län, Sweden", imdbId:"0617523", born:date('1969-07-29'), name:"Måns Mårlind", bio:"Måns Magnus Mårlind (born on 29 July 1969 in Vallentuna) is a Swedish director and screenwriter. \n\nDescription above from the Wikipedia article Måns Mårlind, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/80923"}}, {tmdbId:"130051", properties:{imdbId:"0608936", name:"Craig Moss", url:"https://themoviedb.org/person/130051"}}, {tmdbId:"934803", properties:{bornIn:" Los Angeles, California, USA", imdbId:"2503633", born:date('1984-02-19'), name:"Josh Trank", bio:"Joshua Benjamin Trank (born February 19, 1984) is an American film director, screenwriter, and editor.  He is known for directing the 2012 science fiction film Chronicle and the 2015 superhero film Fantastic Four...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cRuViuaRcRnI3CpCIiYZOhWVwk1.jpg", url:"https://themoviedb.org/person/934803"}}, {tmdbId:"84013", properties:{imdbId:"0675257", name:"Pinchas Perry", url:"https://themoviedb.org/person/84013"}}, {tmdbId:"225952", properties:{imdbId:"0419683", born:date('1955-05-05'), name:"Vikram Jayanti", url:"https://themoviedb.org/person/225952"}}, {tmdbId:"231720", properties:{bornIn:"Utrecht, Utrecht, Netherlands", imdbId:"1984934", name:"Jaap van Heusden", bio:"Jaap van Heusden was born 1979 in Utrecht, the Netherlands.  As the son of a preacher he was surrounded by stories right from childhood.  By the age of eight he had trashed his first Nikon camera.  And by age twelve he burnt his first novel because it was so bad.  At fifteen he was convinced he would become a major player in European politics.  He gave up acting at seventeen because he found out there where people who were actually any good at it...", url:"https://themoviedb.org/person/231720"}}, {tmdbId:"52935", properties:{bornIn:"Wheeling, Illinois, USA", imdbId:"0197855", born:date('1985-07-20'), name:"John Francis Daley", bio:"From Wikipedia, the free encyclopedia\n\nJohn Francis Daley (born July 20, 1985) is an American television and film actor, singer, and director, sometimes credited as John Daley or John Francis Daly.  He is best known for playing Sam Weir on the NBC comedy-drama Freaks and Geeks and his current role as Lance Sweets on the series Bones.  He plays keyboards and vocals for the band Dayplayer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rKZL3e8gI2tQD6Kv0QojXK5sG4u.jpg", url:"https://themoviedb.org/person/52935"}}, {tmdbId:"1236679", properties:{bornIn:"New York City, New York, USA", imdbId:"0326246", born:date('1969-01-01'), name:" Jonathan M. Goldstein", bio:"Jonathan M.  Goldstein was born in 1969 in.  He is a producer and writer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/s1fwSaxlYvw3KdmRvT1ZSYhsEkJ.jpg", url:"https://themoviedb.org/person/1236679"}}, {tmdbId:"144536", properties:{bornIn:"Hiroshima, Japan", imdbId:"0766263", born:date('1970-09-16'), name:"Shinsuke Sato", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/f3QUEYCGe5d7u7FXsArRlU1APoo.jpg", url:"https://themoviedb.org/person/144536"}}, {tmdbId:"94075", properties:{bornIn:"Toronto, Canada", imdbId:"1659741", born:date('1973-04-19'), name:"David Soren", url:"https://themoviedb.org/person/94075"}}, {tmdbId:"65594", properties:{bornIn:"Elephant and Castle, London, England", imdbId:"0567620", born:date('1967-01-01'), name:"John Michael McDonagh", bio:"John Michael McDonagh is an English-born film director and screenwriter of Irish descent.  He wrote and directed The Guard.  His brother is the playwright and filmmaker Martin McDonagh. \n\nDescription above from the Wikipedia article John Michael McDonagh, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2naifQzuI4XEJblHNQIotIx6hTM.jpg", url:"https://themoviedb.org/person/65594"}}, {tmdbId:"225893", properties:{imdbId:"1732975", name:"Niall MacCormick", url:"https://themoviedb.org/person/225893"}}, {tmdbId:"56210", properties:{bornIn:"San Justo, Argentina", imdbId:"0871086", born:date('1971-10-04'), name:"Pablo Trapero", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jIaBRcCHXu0AKsnj0pS2SeOJYuK.jpg", url:"https://themoviedb.org/person/56210"}}, {tmdbId:"2149", properties:{imdbId:"0002252", name:"David A. Armstrong", url:"https://themoviedb.org/person/2149"}}, {tmdbId:"131948", properties:{bornIn:"Birkenhead, Merseyside, England, UK", imdbId:"1770672", born:date('1970-12-05'), name:"Tim Hetherington", bio:"​From Wikipedia, the free encyclopedia\n\nTimothy Alistair Telemachus Hetherington (5 December 1970 – 20 April 2011) was a British-American photojournalist with work that \"ranged from multi-screen installations, to fly-poster exhibitions, to handheld device downloads. \" He was best known for the documentary film Restrepo (2010), which he co-directed with Sebastian Junger; the film was nominated for an Academy Award for Best Documentary Feature in 2011...", died:date('2011-04-20'), url:"https://themoviedb.org/person/131948"}}, {tmdbId:"21863", properties:{bornIn:"Belmont, Massachusetts, USA", imdbId:"0432631", born:date('1962-01-17'), name:" Sebastian Junger", bio:"​From Wikipedia, the free encyclopedia\n\nSebastian Junger (born January 17, 1962) is an American author, journalist, and documentarian, most famous for the best-selling book The Perfect Storm: A True Story of Men Against the Sea, his award-winning chronicle of the war in Afghanistan in his 2010 movie Restrepo, and his 2010 book War. \n\nDescription above from the Wikipedia article Sebastian Junger, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/21863"}}, {tmdbId:"20659", properties:{bornIn:"Rasht, Iran", imdbId:"2277869", born:date('1969-11-22'), name:"Marjane Satrapi", bio:"Marjane Satrapi is an Iranian-born French contemporary graphic novellist, illustrator, animated film director, and children's book author.  She is known for Persepolis, The Voices (2014) and Chicken with Plums (2011)...", url:"https://themoviedb.org/person/20659"}}, {tmdbId:"74105", properties:{imdbId:"0827830", name:"Ricki Stern", url:"https://themoviedb.org/person/74105"}}, {tmdbId:"74106", properties:{imdbId:"0839064", name:" Anne Sundberg", bio:"Anne Sundberg works as a writer, producer and director for film and television productions, especially documentaries...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3xNjRbSFtycwosTmtzYYxkRRn3.jpg", url:"https://themoviedb.org/person/74106"}}, {tmdbId:"72344", properties:{imdbId:"1300606", name:"Asger Leth", url:"https://themoviedb.org/person/72344"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"144476", properties:{bornIn:"Ishikawa Prefecture, Japan", imdbId:"0948488", born:date('1973-07-10'), name:"Hiromasa Yonebayashi", bio:"From Wikipedia, the free encyclopedia. \n\nHiromasa Yonebayashi (born 1973 in Ishikawa Prefecture, Japan), nicknamed Maro, is a Japanese animator and director for Studio Ghibli.  Making his directing debut with them in the film The Borrower Arrietty, he became the youngest director of a Studio Ghibli film. \n\nDescription above from the Wikipedia article Hiromasa Yonebayashi, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bV0Xg5JHzTdcCDaLX7fKHn3gYH2.jpg", url:"https://themoviedb.org/person/144476"}}, {tmdbId:"124279", properties:{bornIn:"Fresno, California, USA", imdbId:"1541845", name:"Brandon Vietti", bio:"Brandon Vietti is an American producer, director, and story artist.   Vietti’s directing credits include Batman: Under the Red Hood, Batman: The Brave and the Bold, Legion of Superheroes, Superman Doomsday, The Batman, Spider-man: The Animated Series, and Jackie Chan Adventures...", url:"https://themoviedb.org/person/124279"}}, {tmdbId:"1247708", properties:{bornIn:"Maizuru, Kyoto Prefecture, Japan", imdbId:"2128776", born:date('1966-07-31'), name:"Tatsuya Ishihara", bio:"Tatsuya Ishihara (Japanese: 石原 立也, born July 31, 1966) is a Japanese television and film director from Maizuru, Kyoto working for the Japanese animation studio Kyoto Animation...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yAumMV8Nf4I71QtofFkOfLcTAWl.jpg", url:"https://themoviedb.org/person/1247708"}}, {tmdbId:"219647", properties:{bornIn:"Hyōgo Prefecture, Japan", imdbId:"1856817", born:date('1972-04-05'), name:" Yasuhiro Takemoto", bio:"Yasuhiro Takemoto (Japanese: 武本 康弘, April 5, 1972 – July 18, 2019) was a Japanese animator and television and film director.  He worked at Kyoto Animation for almost his entire animation career after joining the company in 1996. \n\nHis first major job as a director came in 2003 with Full Metal Panic? Fumoffu.  Two years later he directed his sequel: The Second Raid.  In 2007, Takemoto replaced Lucky Star director Yutaka Yamamoto after his dismissal...", died:date('2019-07-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zQEmmJrtMq1Sdnl3TUeoGYreqZH.jpg", url:"https://themoviedb.org/person/219647"}}, {tmdbId:"235503", properties:{imdbId:"1744333", name:"Joonas Berghäll", url:"https://themoviedb.org/person/235503"}}, {tmdbId:"235504", properties:{imdbId:"2029418", name:" Mika Hotakainen", url:"https://themoviedb.org/person/235504"}}, {tmdbId:"108321", properties:{imdbId:"0161461", name:"Randall Churchill", url:"https://themoviedb.org/person/108321"}}, {tmdbId:"936154", properties:{imdbId:"1908892", name:" Stephen St. Leger", url:"https://themoviedb.org/person/936154"}}, {tmdbId:"1066409", properties:{imdbId:"1561205", name:"Hadi Hajaig", url:"https://themoviedb.org/person/1066409"}}, {tmdbId:"236859", properties:{bornIn:"Belgium", imdbId:"1742427", born:date('1972-10-09'), name:"Michaël R. Roskam", bio:"As a (very) young man Michael R.  Roskam was passionate about grafic novels, comic-strips and cinema.  Inspired by the great Belgian tradition of comic-strip artists like Hergé, he decided to become a comic-strip artist himself and went to St-Lucas Academy of Fine Arts in Brussels.  There he discovered painting and contemporary art.  He graduated but also got involved into writing fiction - meanwhile keeping his passion for the image alive by drawing and experimenting with video...", url:"https://themoviedb.org/person/236859"}}, {tmdbId:"83281", properties:{bornIn:"Dublin, Ireland", imdbId:"1049433", born:date('1966-11-30'), name:"Lenny Abrahamson", bio:"Leonard Ian “Lenny” Abrahamson (born 30 November 1966 is an Irish film director and screenwriter.  He is known for directing such acclaimed independent films as Adam & Paul (2004), Garage (2007), What Richard Did (2012) and Frank (2014) all of which contributed to Abrahamson's six Irish Film and Television Awards.  In 2015, he received widespread recognition for directing Room, based on the novel of the same name by Emma Donoghue...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vokwnrTqrdYKTt6YaeegjSZszz7.jpg", url:"https://themoviedb.org/person/83281"}}, {tmdbId:"1288624", properties:{imdbId:"3819792", name:"Geoff Moore", url:"https://themoviedb.org/person/1288624"}}, {tmdbId:"1288625", properties:{imdbId:"1506819", name:" David Posamentier", url:"https://themoviedb.org/person/1288625"}}, {tmdbId:"77965", properties:{bornIn:"Bergen, Norvegia", imdbId:"0878763", born:date('1967-05-19'), name:"Morten Tyldum", bio:"Morten Tyldum (born 19 May 1967) is a Norwegian film director.  He is best known for directing internationally successful films such as Headhunters (2011), a thriller based on a novel by Jo Nesbø and The Imitation Game (2014), a historical drama for which he was nominated for the Academy Award for Best Director. \n\nDescription above from the Wikipedia article Morten Tyldum, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rE1zmcXoqtJl5fIa3fKoqnzteyw.jpg", url:"https://themoviedb.org/person/77965"}}, {tmdbId:"556172", properties:{imdbId:"1170855", born:date('1973-11-24'), name:"J.C. Chandor", bio:"Jeffrey McDonald Chandor, better known as J.  C.  Chandor, is an American film director, producer and screenwriter, best known for writing and directing the films Margin Call (2011), All Is Lost (2013), and A Most Violent Year (2014).  Chandor grew up in the Basking Ridge section of Bernards Township, New Jersey.  He is the son of Mary (McDonald) and Jeff Chandor, an investment banker...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6oaCrcLpqAvuWci6kStnuuAc34I.jpg", url:"https://themoviedb.org/person/556172"}}, {tmdbId:"59357", properties:{bornIn:"Encino, California, USA", imdbId:"0628599", name:"Teddy Newton", bio:"Teddy Newton is an artist at Pixar Animation Studios.  He has worked as a storyboard artist for 2 Stupid Dogs, The Iron Giant, and Dexter's Laboratory. \n\nHe studied at the California Institute of the Arts in its world-renowned Character Animation program...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/coG2SkqTGyoICeJnUu2C5YSQhJA.jpg", url:"https://themoviedb.org/person/59357"}}, {tmdbId:"213611", properties:{bornIn:" New York", imdbId:"0696236", name:"Richard Press", url:"https://themoviedb.org/person/213611"}}, {tmdbId:"93214", properties:{imdbId:"0702797", name:"Steven Quale", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iENjtsm0u8SQtf1n6gazhDDvO3g.jpg", url:"https://themoviedb.org/person/93214"}}, {tmdbId:"225160", properties:{bornIn:"Rome, Italy", imdbId:"0002645", born:date('1966-08-20'), name:"Paolo Genovese", url:"https://themoviedb.org/person/225160"}}, {tmdbId:"7709", properties:{bornIn:"Parigi, Francia", imdbId:"0332647", born:date('1951-08-25'), name:"Romain Goupil", url:"https://themoviedb.org/person/7709"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"1299380", properties:{imdbId:"1294036", born:date('1977-11-12'), name:"Nima Nourizadeh", bio:"Nima Nourizadeh is an Iranian-British commercial and film director and editor.  His debut film is Project X, released in March 2012.  Prior to making Project X, he directed music videos for Dizzee Rascal, Pink Grease, Franz Ferdinand, Bat for Lashes, Santigold, Hot Chip, Yelle and Lily Allen.  He also directed advertisements for Adidas.  Nourizadeh is the son of political activist Alireza Nourizadeh and his siblings are electronic music producers Omid 16B and Navid...", url:"https://themoviedb.org/person/1299380"}}, {tmdbId:"28671", properties:{bornIn:"Kabul, Afghanistan", imdbId:"1680298", name:"Atiq Rahimi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qF0KrBwZkPLjAqLHk3Hu40zdBFm.jpg", url:"https://themoviedb.org/person/28671"}}, {tmdbId:"154865", properties:{bornIn:"Cambridge, Massachusetts, USA", imdbId:"1571761", born:date('1977-06-23'), name:"Sian Heder", url:"https://themoviedb.org/person/154865"}}, {tmdbId:"141673", properties:{imdbId:"2639032", name:"Jason Eisener", url:"https://themoviedb.org/person/141673"}}, {tmdbId:"937024", properties:{imdbId:"1350938", name:"Aimee Lagos", url:"https://themoviedb.org/person/937024"}}, {tmdbId:"119417", properties:{imdbId:"1026883", name:"Gavin Wiesen", url:"https://themoviedb.org/person/119417"}}, {tmdbId:"118463", properties:{bornIn:"New York City, New York, USA", imdbId:"0217938", born:date('1966-11-06'), name:"Peter DeLuise", bio:"From Wikipedia, the free encyclopedia. \n\nPeter John DeLuise (born November 6, 1966) is an American actor, director, producer, and screenwriter, perhaps best known for directing episodes of science fiction television shows, particularly in the Stargate franchise. \n\nDescription above from the Wikipedia article Peter DeLuise, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cxQ9hgXGWiL0taDnamGaoJ8JQgd.jpg", url:"https://themoviedb.org/person/118463"}}, {tmdbId:"67717", properties:{bornIn:"Paris, France", imdbId:"0371890", born:date('1967-03-29'), name:"Michel Hazanavicius", bio:"From Wikipedia, the free encyclopedia. \n\nMichel Haznavicius (born 29 March 1967) is a French film director, producer and screenwriter best known for his spy movie parodies OSS 117: Cairo, Nest of Spies and OSS 117: Lost in Rio, both of which star Jean Dujardin.  His 2011 film The Artist competed for the Palme d'Or at the 2011 Cannes Film Festival but lost to The Tree of Life.  Dujardin though won the best actor prize at Cannes for his role in The Artist...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5Adwey0AqG16rM7jrDMjUaew9W3.jpg", url:"https://themoviedb.org/person/67717"}}, {tmdbId:"19311", properties:{bornIn:"Pittsburgh, Pennsylvania, United States", imdbId:"0154716", born:date('1970-01-25'), name:"Stephen Chbosky", bio:"Stephen Chbosky (born January 25, 1970) is an American novelist, screenwriter, and film director best-known for writing The New York Times bestselling coming-of-age novel The Perks of Being a Wallflower (1999), as well as for writing and directing the film version of the same book, starring Logan Lerman, Emma Watson, and Ezra Miller...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/baY9f8wtuDhDeQ8WTopBrIkROlF.jpg", url:"https://themoviedb.org/person/19311"}}, {tmdbId:"115091", properties:{imdbId:"1950018", name:"R. Ellis Frazier", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kVH64R9QLeOpOl9L7af0iWOnVpi.jpg", url:"https://themoviedb.org/person/115091"}}, {tmdbId:"991868", properties:{bornIn:"Calabasas, California, USA", imdbId:"1847738", born:date('1974-09-05'), name:"Ari Sandel", url:"https://themoviedb.org/person/991868"}}, {tmdbId:"236360", properties:{imdbId:"0155201", name:"Daming Chen", url:"https://themoviedb.org/person/236360"}}, {tmdbId:"71729", properties:{imdbId:"0553942", name:"Steve Martino", url:"https://themoviedb.org/person/71729"}}, {tmdbId:"91186", properties:{imdbId:"0864263", name:"Douglas Tirola", url:"https://themoviedb.org/person/91186"}}, {tmdbId:"84426", properties:{bornIn:"Suresnes, France", imdbId:"0619923", born:date('1973-04-15'), name:"Olivier Nakache", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dUIumSDxWOnryokzrUQZxYE0Tq.jpg", url:"https://themoviedb.org/person/84426"}}, {tmdbId:"84425", properties:{bornIn:"Paris, France", imdbId:"0865918", born:date('1971-07-03'), name:" Eric Toledano", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eDtsKsLL8sbRWaLvlwTGPu3pbZG.jpg", url:"https://themoviedb.org/person/84425"}}, {tmdbId:"109439", properties:{imdbId:"0201061", born:date('1965-06-12'), name:"Kieran Darcy-Smith", bio:"Kieran Darcy-Smith is an Australian actor, director, writer and producer.  In 1996, he co-founded Blue-Tongue Films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5oTuxw1uHPYvOa0vsSnNch7HHux.jpg", url:"https://themoviedb.org/person/109439"}}, {tmdbId:"2394289", properties:{name:" Jack Attridge", url:"https://themoviedb.org/person/2394289"}}, {tmdbId:"1073896", properties:{imdbId:"1754704", name:" Zillah Bowes", url:"https://themoviedb.org/person/1073896"}}, {tmdbId:"1292356", properties:{imdbId:"1780501", name:" Alejo Crisóstomo", url:"https://themoviedb.org/person/1292356"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"1476281", properties:{imdbId:"3416434", name:" Soma Helmi", url:"https://themoviedb.org/person/1476281"}}, {tmdbId:"1033184", properties:{imdbId:"2465524", name:" Joaquin Montalvan", url:"https://themoviedb.org/person/1033184"}}, {tmdbId:"2584513", properties:{name:" Lilit Movsisyan", url:"https://themoviedb.org/person/2584513"}}, {tmdbId:"2453604", properties:{name:" Emmanuelle Pickett", url:"https://themoviedb.org/person/2453604"}}, {tmdbId:"2056602", properties:{name:" Marcus Tedenryd", url:"https://themoviedb.org/person/2056602"}}, {tmdbId:"1937039", properties:{name:" Zuqy", url:"https://themoviedb.org/person/1937039"}}, {tmdbId:"111736", properties:{imdbId:"0355806", name:"Klay Hall", bio:"From Wikipedia, the free encyclopedia. \n\nKlay Hall is an American animation director who is credited on multiple television series and feature films.  He directorial career is noteworthy because of his having directed both traditional 2d long-form animation, and 3d (cgi) long-form animation. \n\nKlay launched his animation career on \"Amazing Stories,\" \"Cool World,\" and \"Mighty Mouse: The New Adventures,\" before working as director on \"The Simpsons,\" and \"Family Dog...", url:"https://themoviedb.org/person/111736"}}, {tmdbId:"143671", properties:{bornIn:"Sol-Iletsk, USSR (Russia)", imdbId:"1922735", born:date('1966-09-29'), name:"Aleksey Fedorchenko", bio:"Director of fiction and documentary cinema, scriptwriter, producer.  Born in Sol-Iletsk, Orenburg\n\nregion, in 1966.  Graduated from the Engineering and Economics Faculty of the Ural Polytechnic (1988); from script faculty of the Film Institute VGIK (2000, class of V.  Chernykh, L.  Kozhinova and Yu.  Rogozin).  Since 1990 has worked at the Sverdlovsk film studio, since 2005 he is producer and director of the film company “29 February”.  Debuted in feature films in 2005 with “First on the Moon”...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rSZZpC6gybHQQNL7HZdKrINTgxN.jpg", url:"https://themoviedb.org/person/143671"}}, {tmdbId:"144766", properties:{imdbId:"0632763", name:"Satoshi Nishimura", url:"https://themoviedb.org/person/144766"}}, {tmdbId:"81157", properties:{bornIn:"Buenos Aires, Argentina", imdbId:"0096375", born:date('1963-04-22'), name:"Sebastián Borensztein", url:"https://themoviedb.org/person/81157"}}, {tmdbId:"87014", properties:{imdbId:"0686304", name:"Marcelo Piñeyro", url:"https://themoviedb.org/person/87014"}}, {tmdbId:"131870", properties:{bornIn:"Santa Monica, California, USA", imdbId:"0918078", born:date('1983-12-23'), name:"Daryl Wein", url:"https://themoviedb.org/person/131870"}}, {tmdbId:"930710", properties:{bornIn:"Athens, Georgia, Stati Uniti", imdbId:"1242054", born:date('1978-01-01'), name:"James Ponsoldt", bio:"James Ponsoldt was born in 1978 as James Adam Ponsoldt.  He is a director and writer, known for The Spectacular Now (2013), Smashed (2012) and Off the Black (2006).  He has been married to Megan Holloway since September 25, 2010...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iG1JveKARZuK05Oh5czmXXxAbdn.jpg", url:"https://themoviedb.org/person/930710"}}, {tmdbId:"75753", properties:{imdbId:"0642041", name:" Morgan O'Neill", url:"https://themoviedb.org/person/75753"}}, {tmdbId:"68432", properties:{imdbId:"1956691", name:"Jamie Linden", url:"https://themoviedb.org/person/68432"}}, {tmdbId:"15345", properties:{bornIn:"Los Angeles - California - USA", imdbId:"0476064", born:date('1973-09-07'), name:"Alex Kurtzman", bio:"Alex Kurtzman (born September 7, 1973) is an American film and television screenwriter and producer.  Kurtzman was born and raised in Los Angeles, California, where he met his high school friend and long time collaborator Roberto Orci.  He attended Wesleyan University. \n\nIn 2011, Forbes magazine described Orci and Kurtzman as \"Hollywood's Secret Weapons\" who together \"are the quiet force behind $3 billion in box office. \" He and Orci frequently work with J.  J.  Abrams and Michael Bay on projects...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uDZxuaV19OYMhN7vuuVg1bSlqUM.jpg", url:"https://themoviedb.org/person/15345"}}, {tmdbId:"161932", properties:{bornIn:"Charlotte, North Carolina, USA", imdbId:"0711110", born:date('1970-07-15'), name:" Jim Rash", bio:"Jim Rash was born in Charlotte, North Carolina and is an American actor, comedian and screenwriter. \n\nHis most noticeable appearance was when he portrayed Mr Grayson/Stitches, a sidekick to the supervillain 'Royal Pain' in the 2005 film Sky High and as the recurring characters Fenton on That '70s Show and \"Andrew the Whore House Guy\" on Reno 911!.  He also guest starred in the last episode of Friends, and played the role of Head T. A.  Philip in Slackers...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cXat9HZ5ajQZsrAZ8xE4zIEVEcb.jpg", url:"https://themoviedb.org/person/161932"}}, {tmdbId:"135479", properties:{imdbId:"2765527", name:"Carlo Ledesma", url:"https://themoviedb.org/person/135479"}}, {tmdbId:"228134", properties:{bornIn:"Westminster, United Kingdom", imdbId:"2782185", born:date('1971-03-16'), name:"Rupert Sanders", bio:"Rupert Sanders was born on March 16, 1971 in Westminster, London, England.  He is a director and writer, known for Snow White and the Huntsman (2012), Ghost in the Shell (2017) and Black Hole (2010).  He was previously married to Liberty Ross...", url:"https://themoviedb.org/person/228134"}}, {tmdbId:"135113", properties:{bornIn:"Norway", imdbId:"0004217", born:date('1973-05-06'), name:"André Øvredal", bio:"Andre Øvredal made a name for himself as one of Norway's most successful director of commercials for customers in Norway and abroad to his credit.  He has a Bachelor of Arts degree from Brooks Institute of Photography in California where he directed the first feature in the school's 50 year old history.  This thriller Future Murder as released as one of 80 first-time films in a special DVD series...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mVx5y0gVhqGDGsOTsxSSR8bUvGL.jpg", url:"https://themoviedb.org/person/135113"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"933739", properties:{bornIn:"Francia", imdbId:"2610231", born:date('1980-01-01'), name:"Zal Batmanglij", bio:"Zal Batmanglij is an American film director and screenwriter.  He directed and co-wrote the 2011 film Sound of My Voice and the 2013 film The East, both of which premiered at the Sundance Film Festival. \n\nBatmanglij was born in France to Iranian parents.  His mother is the cookbook author Najmieh Batmanglij, and his younger brother Rostam Batmanglij is a member of the band Vampire Weekend.  Both brothers are gay.  Batmanglij grew up in Washington, DC, in the United States...", url:"https://themoviedb.org/person/933739"}}, {tmdbId:"550684", properties:{imdbId:"4137350", name:"Cindy Meehl", bio:"Cindy Meehl is an American film producer and director.  In 2008, she founded Cedar Creek Productions...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ulQ3FlmT4yPtK3f6R8fu5YsBexh.jpg", url:"https://themoviedb.org/person/550684"}}, {tmdbId:"465763", properties:{imdbId:"0962849", name:"Maggie Carey", bio:"Maggie Carey is an American director and screenwriter...", url:"https://themoviedb.org/person/465763"}}, {tmdbId:"45996", properties:{bornIn:"Osaka, Japan", imdbId:"0457565", born:date('1969-05-30'), name:"Ryûhei Kitamura", bio:"​From Wikipedia, the free encyclopedia\n\nRyuhei Kitamura (born May 30, 1969) is a Japanese filmmaker. \n\nDescription above from the Wikipedia article Ryuhei Kitamura, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iitzR6lbdD1sCK2LOoG8Li1Cg30.jpg", url:"https://themoviedb.org/person/45996"}}, {tmdbId:"15892", properties:{bornIn:"River Vale, New Jersey, USA", imdbId:"1557594", born:date('1976-03-19'), name:"Dan Fogelman", bio:"Dan Fogelman (born February 19, 1976) is an American television producer and screenwriter whose screenplays include Tangled; Crazy, Stupid, Love; and the Pixar film Cars.  He also created the 2012 television sitcom The Neighbors, the 2015 fairy tale-themed musical comedy series Galavant, the 2016 dramedy series This Is Us, and the 2016 baseball drama series Pitch...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/grLBoLU2blYEoT8vjGFOiM8mw1D.jpg", url:"https://themoviedb.org/person/15892"}}, {tmdbId:"165787", properties:{bornIn:"Oxnard, California, USA", imdbId:"0601781", born:date('1963-05-10'), name:"Rich Moore", bio:"From Wikipedia, the free encyclopedia. \n\nRich Moore is an American animation director and a business partner in Rough Draft Studios, best known for his work on The Simpsons and Wreck-It Ralph. \n\nHis animation directing credits include the television series The Simpsons, Futurama, The Critic, Drawn Together and Baby Blues, and the segment \"Spy vs.  Spy\" for MADtv...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oIAmkZf9LuJuMqR8zSchoD3FJT8.jpg", url:"https://themoviedb.org/person/165787"}}, {tmdbId:"928915", properties:{imdbId:"0312173", born:date('1983-10-16'), name:"David Gelb", url:"https://themoviedb.org/person/928915"}}, {tmdbId:"1252638", properties:{bornIn:"Osaka Prefecture, Japan", imdbId:"1020249", name:"Kazuya Murata", url:"https://themoviedb.org/person/1252638"}}, {tmdbId:"254741", properties:{imdbId:"0548789", name:"Constance Marks", bio:"Constance Marks is an award-winning independent documentary filmmaker.  She is the founder and president of Constance Marks Productions, Inc. , a documentary production company based in New York City.  Marks began her filmmaking career over 35 years ago as an assistant editor for the renowned Cinema Verite pioneers, David and Albert Maysles.  Marks’ critically acclaimed films have been shown theatrically, broadcast widely, and garnered numerous awards...", url:"https://themoviedb.org/person/254741"}}, {tmdbId:"550669", properties:{imdbId:"1427149", name:"Andrew Rossi", bio:"From Wikipedia, the free encyclopedia\n\nAndrew Rossi is a director, producer, and cinematographer of documentary films.  His first feature film, Eat This New York, aired on the Sundance Channel in 2004.  He then directed Le Cirque: A Table In Heaven, a documentary about restaurateur Sirio Maccioni and his family, which premiered at the 2007 Full Frame Documentary Film Festival and was later shown on HBO...", url:"https://themoviedb.org/person/550669"}}, {tmdbId:"1414", properties:{bornIn:" Tokyo, Japan", imdbId:"2066439", born:date('1967-01-21'), name:"Gorô Miyazaki", bio:"Gorō Miyazaki (宮崎 吾朗, Miyazaki Gorō, born January 21, 1967) is a Japanese film director and landscaper.  He is the son of animator Hayao Miyazaki, who is one of the co-founders of Studio Ghibli.  Described as \"reluctant\" to follow his father's career, Gorō initially worked as a landscaper for many years before entering the film business. \n\nMiyazaki was born to animators Hayao Miyazaki and Akemi Ōta in Tokyo...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/44FdzDvvVhhiPT3xJXRLnfVgFbs.jpg", url:"https://themoviedb.org/person/1414"}}, {tmdbId:"1211000", properties:{imdbId:"3230448", name:"Tom Gormican", url:"https://themoviedb.org/person/1211000"}}, {tmdbId:"929568", properties:{imdbId:"1789487", name:"David Redmon", url:"https://themoviedb.org/person/929568"}}, {tmdbId:"989375", properties:{imdbId:"2920884", name:" Ashley Sabin", url:"https://themoviedb.org/person/989375"}}, {tmdbId:"1168125", properties:{imdbId:"1170261", name:"Seth Kramer", url:"https://themoviedb.org/person/1168125"}}, {tmdbId:"965932", properties:{imdbId:"1015339", born:date('1973-11-06'), name:" Jeremy Newberger", url:"https://themoviedb.org/person/965932"}}, {tmdbId:"1141827", properties:{imdbId:"0076473", name:"Sabine Bernardi", url:"https://themoviedb.org/person/1141827"}}, {tmdbId:"5575", properties:{bornIn:"New York City, New York, USA", imdbId:"0326040", born:date('1962-07-07'), name:"Akiva Goldsman", bio:"Akiva J.  Goldsman (born July 7, 1962) is an American screenwriter and producer in the motion picture industry.  He received an Academy Award for Best Adapted Screenplay for the 2001 film, A Beautiful Mind, which also won the Oscar for Best Picture. \n\nGoldsman has been involved specifically with Hollywood films.  His filmography includes the films A Beautiful Mind, I am Legend and Cinderella Man, as well as more serious dramas, and numerous rewrites both credited and uncredited...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zjnY7yoXZifRJR9x8hdGIm9ducG.jpg", url:"https://themoviedb.org/person/5575"}}, {tmdbId:"108072", properties:{bornIn:"Montreal, Quebec, Canada", imdbId:"0618779", born:date('1972-12-06'), name:"Ruba Nadda", bio:"From Wikipedia, the free encyclopedia. \n\nRuba Nadda is an Arab Canadian film director.  She was born in Montreal, Quebec, Canada on 6 December 1972 to a Syrian father and a Palestinian mother.  She made several award-winning short films, including Lost Woman Story, Interstate Love Story, So Far Gone and Damascus Nights before writing and directing features I Always Come to You, Unsettled and Sabah...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mzKuaGBumeHDIxFb0iU6Y3IHPWu.jpg", url:"https://themoviedb.org/person/108072"}}, {tmdbId:"531211", properties:{imdbId:"3052903", name:"Alison Klayman", url:"https://themoviedb.org/person/531211"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"82418", properties:{bornIn:"Deurne, Belgium", imdbId:"0887452", born:date('1962-04-26'), name:"Erik Van Looy", bio:"Erik Van Looy was born on April 26, 1962 in Deurne, Flanders, Belgium as Erik Ludovicus Maria Van Looy.  He is a director and a writer, known for the classic Belgian films, De Zaak Alzheimer/The Memory of a Killer (2003) and Loft (2008).  He's also directed the US-remake of The Loft (2014).  Between writing and directing movies, he is the host of De Slimste Mens Ter Wereld/The Smartest Person in the World, a hugely successful game show on Belgian TV...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j77gE9eOYxax7Ae83Z906n4BWQ1.jpg", url:"https://themoviedb.org/person/82418"}}, {tmdbId:"1031692", properties:{imdbId:"2365361", name:"Phil Dorling", url:"https://themoviedb.org/person/1031692"}}, {tmdbId:"59330", properties:{imdbId:"0638913", name:" Ron Nyswaner", url:"https://themoviedb.org/person/59330"}}, {tmdbId:"95528", properties:{bornIn:"Bilbao, Vizcaya, País Vasco, España", imdbId:"0074311", born:date('1963-01-01'), name:"Pablo Berger", bio:"Spanish film director born in Bilbao, Spain.  In 2012 he premiered his third film Blancanieves (Snow White), which was the Spanish representative at the Academy Awards (2013) as Best Foreign Language Film.  Blancanieves won ten Goya Awards, including Best Picture and Best Original Screenplay...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sPU0ShhIL8xdPoDLmqSa3kt6wWH.jpg", url:"https://themoviedb.org/person/95528"}}, {tmdbId:"225556", properties:{bornIn:"Oakland, California, USA", imdbId:"0015328", born:date('1964-06-22'), name:"Salim Akil", url:"https://themoviedb.org/person/225556"}}, {tmdbId:"1354171", properties:{imdbId:"3918746", name:"Henry Hobson", url:"https://themoviedb.org/person/1354171"}}, {tmdbId:"523789", properties:{imdbId:"4571695", born:date('1980-10-28'), name:"Aaron Harvey", url:"https://themoviedb.org/person/523789"}}, {tmdbId:"9897", properties:{imdbId:"1145655", name:"Shirish Kunder", url:"https://themoviedb.org/person/9897"}}, {tmdbId:"217587", properties:{imdbId:"2853516", name:"Leslye Headland", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xyQOpREerpSYTlYeo7ci7A4egwu.jpg", url:"https://themoviedb.org/person/217587"}}, {tmdbId:"1124970", properties:{imdbId:"4458549", name:"Jay Bulger", url:"https://themoviedb.org/person/1124970"}}, {tmdbId:"208119", properties:{imdbId:"1840943", name:"Peter Templeman", url:"https://themoviedb.org/person/208119"}}, {tmdbId:"1172231", properties:{imdbId:"0667650", name:"Frank Pavich", url:"https://themoviedb.org/person/1172231"}}, {tmdbId:"1085904", properties:{bornIn:" New Orleans, Louisiana, USA", imdbId:"1310794", born:date('1978-10-29'), name:"Ramaa Mosley", url:"https://themoviedb.org/person/1085904"}}, {tmdbId:"1044256", properties:{imdbId:"1515795", name:"Lisanne Pajot", url:"https://themoviedb.org/person/1044256"}}, {tmdbId:"1044257", properties:{imdbId:"2499666", name:" James Swirsky", url:"https://themoviedb.org/person/1044257"}}, {tmdbId:"20267", properties:{bornIn:"Hagen, Germany", imdbId:"1673756", born:date('1978-01-01'), name:"Jan Ole Gerster", url:"https://themoviedb.org/person/20267"}}, {tmdbId:"1429200", properties:{imdbId:"2950998", name:"Justin Trefgarne", url:"https://themoviedb.org/person/1429200"}}, {tmdbId:"544130", properties:{imdbId:"3609341", born:date('1983-04-29'), name:"Jen Soska", url:"https://themoviedb.org/person/544130"}}, {tmdbId:"544134", properties:{imdbId:"3609300", born:date('1983-04-29'), name:" Sylvia Soska", url:"https://themoviedb.org/person/544134"}}, {tmdbId:"859754", properties:{bornIn:"Hammersmith, Londra, Regno Unito", imdbId:"1717925", born:date('1975-01-01'), name:"Bart Layton", bio:"Bartholomew Nicholas \"Bart\" Layton (born 1975) is an English documentary filmmaker.  He is the writer and director of the films The Imposter and American Animals...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/b2BWSqBVp0QpXsRv4atJFzlwnL2.jpg", url:"https://themoviedb.org/person/859754"}}] AS row
