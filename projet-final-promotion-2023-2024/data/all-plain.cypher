UNWIND [{tmdbId:"570509", properties:{imdbId:"3527143", name:"Storm Acheche Sahlstrøm", url:"https://themoviedb.org/person/570509"}}, {tmdbId:"3965", properties:{imdbId:"0032597", name:"Deborah Aquila", url:"https://themoviedb.org/person/3965"}}, {tmdbId:"1042471", properties:{imdbId:"2193611", name:"Ronnie Connell", url:"https://themoviedb.org/person/1042471"}}, {tmdbId:"78349", properties:{bornIn:"Tochigi, Japan", imdbId:"0945359", born:date('1964-10-20'), name:"Tomoko Yamaguchi", bio:"​Tomoko Yamaguchi (born October 20, 1964) is a Japanese actress and singer from Tochigi.  She is the lead actress for the classic j-drama Long Vacation, which features her starring alongside with Takuya Kimura.  She has been married to Toshiaki Karasawa since 1995. \n\nDescription above from the Wikipedia article Tomoko Yamaguchi, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/f0jTVAz8IaVaR5zJCWZPogWY6Py.jpg", url:"https://themoviedb.org/person/78349"}}, {tmdbId:"78351", properties:{bornIn:"Ōta, Tokyo, Japan", imdbId:"1031551", born:date('1966-01-26'), name:"Kazushige Nagashima", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mpZydioB1SwYVXO3lvndOWBC2jL.jpg", url:"https://themoviedb.org/person/78351"}}, {tmdbId:"78350", properties:{bornIn:" Taito, Tokyo, Japan", imdbId:"0023858", born:date('1967-08-08'), name:"Yûki Amami", bio:"Yuki Amami joined the Takarazuka in 1987 and retired in 1995.  After resigning from the company, she continues to work as a TV and movie actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h5OODF0k6lOomoA6T4BzyqFTcdL.jpg", url:"https://themoviedb.org/person/78350"}}, {tmdbId:"78348", properties:{bornIn:"Tokorozawa, Saitama Prefecture, Japan", imdbId:"0865776", born:date('1955-01-26'), name:"Jôji Tokoro", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bndtzl3ghsdYqjgGqsmp4oUtxtw.jpg", url:"https://themoviedb.org/person/78348"}}, {tmdbId:"1316523", properties:{imdbId:"0789018", name:"Chris Sharp", url:"https://themoviedb.org/person/1316523"}}, {tmdbId:"112560", properties:{bornIn:"Bronx, New York, USA", imdbId:"2466842", born:date('1984-08-15'), name:"Quinton Aaron", bio:"Quinton Aaron (born August 15, 1984) is an American actor.  His first lead role was as Michael Oher in the 2009 film, The Blind Side. \n\nDescription above from the Wikipedia article Quinton Aaron, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AvmNkbRAX1oOecrldWuwvRmDZGw.jpg", url:"https://themoviedb.org/person/112560"}}, {tmdbId:"173879", properties:{imdbId:"0444752", name:"Elizabeth Keener", url:"https://themoviedb.org/person/173879"}}, {tmdbId:"1396822", properties:{bornIn:"Austin, Texas, USA", imdbId:"1389923", born:date('1981-04-19'), name:"Elise Ivy", url:"https://themoviedb.org/person/1396822"}}, {tmdbId:"1461222", properties:{imdbId:"4001891", name:"I. Gusti Ayu Puspawati", url:"https://themoviedb.org/person/1461222"}}, {tmdbId:"1461223", properties:{imdbId:"3741301", name:"Hadi Subiyanto", url:"https://themoviedb.org/person/1461223"}}, {tmdbId:"20727", properties:{bornIn:"Bad Säckingen, Baden-Württemberg, Germany", imdbId:"0205811", born:date('1971-01-01'), name:"Baki Davrak", bio:"From Wikipedia, the free encyclopedia. \n\nBaki Davrak (born 1971 in Bad Säckingen, Baden-Württemberg) is a Turkish-German actor who is known for his leading role in the film The Edge of Heaven (Auf der anderen Seite) which won the Prix du scénario at the 2007 Cannes Film Festival. \n\nDescription above from the Wikipedia article Baki Davrak, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/20727"}}, {tmdbId:"1863761", properties:{name:"Cengiz Daner", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lepKLzkeRjkhZa0i3RioKGHzpst.jpg", url:"https://themoviedb.org/person/1863761"}}, {tmdbId:"20728", properties:{bornIn:"Bilecik, Turkey", imdbId:"0476004", born:date('1936-02-01'), name:"Tuncel Kurtiz", died:date('2013-09-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vSRA3lJoOYsstWixWLIt6TDNKfw.jpg", url:"https://themoviedb.org/person/20728"}}, {tmdbId:"54415", properties:{bornIn:"Hollywood, Florida, USA", imdbId:"1265802", born:date('1981-02-23'), name:"Josh Gad", bio:"Joshua Gad (born February 23, 1981) is an American film, television and stage actor who was in the short-lived television series Back to You in the role of Ryan Church.  The show premiered in September 2007 co-starring Patricia Heaton and Kelsey Grammer.  Gad has also appeared in episodes of ER and Numb3rs.  His film appearances include The Rocker, Crossing Over, 21, and Razortooth...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/17iKlfWZBDTAucqjkhRKHr9xjIz.jpg", url:"https://themoviedb.org/person/54415"}}, {tmdbId:"98394", properties:{imdbId:"1649714", born:date('1974-08-11'), name:"Affion Crockett", url:"https://themoviedb.org/person/98394"}}, {tmdbId:"53862", properties:{bornIn:"Camarillo, California, USA", imdbId:"0192505", born:date('1985-11-30'), name:"Kaley Cuoco", bio:"Kaley Cuoco is an American film and television actress and singer.  She is best known for her roles as Bridget Hennessy on the sitcom 8 Simple Rules, Billie Jenkins on the supernatural drama Charmed, and Penny on the sitcom The Big Bang Theory...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ob8NcbPMckrH5fa9CdSZoW06f0u.jpg", url:"https://themoviedb.org/person/53862"}}, {tmdbId:"51533", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0469823", born:date('1983-07-13'), name:"Fran Kranz", bio:"Francis Elliott \"Fran\" Kranz (born July 13, 1981, height 5' 10\" (1,78 m)) is an American actor.  He is best-known for his role as Topher Brink in Joss Whedon's sci-fi drama Dollhouse.  He previously starred in the television comedy, Welcome to the Captain. \n\nDescription above from the Wikipedia article Fran Kranz, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tAtebGFOl5l5DWGzuBtbmBaIVrq.jpg", url:"https://themoviedb.org/person/51533"}}] AS row
