UNWIND [{tmdbId:"1661472", properties:{imdbId:"7083264", name:"Spanky Taylor", url:"https://themoviedb.org/person/1661472"}}, {tmdbId:"1450888", properties:{imdbId:"1719336", name:"David Miscavige", url:"https://themoviedb.org/person/1450888"}}, {tmdbId:"224664", properties:{bornIn:" Tokyo, Japan", imdbId:"1595000", born:date('1986-12-24'), name:"Satomi Ishihara", bio:"Ishihara Satomi is a Japanese actress.  Popular among Japanese fans, she gained recognition for her acting talent.  She started taking parts acting in television dramas in 2003. \n\nSatomi Ishihara appeared in various commercial events also known as public relations.  Printed materials such as photobooks, DVD photo collections and calendars are available...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uqsOoOy1wTjVSURG31KuMgeTIP9.jpg", url:"https://themoviedb.org/person/224664"}}, {tmdbId:"1098600", properties:{bornIn:"Tokyo", imdbId:"4056296", born:date('1977-03-07'), name:"Hiroki Hasegawa", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fjr47fabDNz8rt7kbIB82lnOTQF.jpg", url:"https://themoviedb.org/person/1098600"}}, {tmdbId:"588403", properties:{bornIn:"Tokyo Prefecture, Japan", imdbId:"0847570", born:date('1971-01-02'), name:"Yutaka Takenouchi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AcrPjkKV5Yp37oA1D7W8wbdWVHF.jpg", url:"https://themoviedb.org/person/588403"}}, {tmdbId:"1397778", properties:{bornIn:"Miami, Florida, USA", imdbId:"5896355", born:date('1996-04-16'), name:"Anya Taylor-Joy", bio:"Anya-Josephine Taylor-Joy (born 16 April 1996) is an Argentine and English actress.  She is known for her roles as Thomasin in the 2015 period horror film The Witch, as Casey Cooke in the horror-thriller films Split (2016) and Glass (2019), and as Lily in the 2017 black comedy thriller film Thoroughbreds...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hwpqQBzL3vVSppnMIINc2RCHXgn.jpg", url:"https://themoviedb.org/person/1397778"}}, {tmdbId:"71083", properties:{bornIn:"East Kilbride, Scotland, UK", imdbId:"0225483", born:date('1971-01-01'), name:"Kate Dickie", bio:"Kate Dickie (born in 1971 in East Kilbride, Scotland) is a five times award-winning Scottish actress who has appeared in TV-series, stage plays and movies.  She is best-known for her portrayal as the security camera operative Jackie in her starring debut Red Road, directed by Andrea Arnold, and for which she was given several awards as best actress, among other things at the BAFTA Scotland Awards and the British Independent Film Awards in 2006...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mlFYUmZycpRa7TGgDTfP0xanE1Q.jpg", url:"https://themoviedb.org/person/71083"}}, {tmdbId:"1397779", properties:{bornIn:"Baja California, Mexico", imdbId:"4308860", born:date('2001-01-01'), name:"Harvey Scrimshaw", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/s3mANTkS07T2v9YLvHactP15ay.jpg", url:"https://themoviedb.org/person/1397779"}}, {tmdbId:"936970", properties:{bornIn:"New York City - New York - USA", imdbId:"3400186", born:date('1994-02-01'), name:"Julia Garner", bio:"Julia Garner is an American actress.  She has appeared in the films Martha Marcy May Marlene, The Perks of Being a Wallflower, Sin City: A Dame to Kill For, and We Are What We Are...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3ssgMsIWiTafSrjHNYdxYYZcvuf.jpg", url:"https://themoviedb.org/person/936970"}}, {tmdbId:"39007", properties:{bornIn:"San Francisco, California, USA", imdbId:"3163793", name:"Carlos Miranda", bio:"Carlos Miranda is a film and television actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oHX1GRREtLDqXVpiXeWPf6trAFo.jpg", url:"https://themoviedb.org/person/39007"}}, {tmdbId:"2472821", properties:{name:"Jessica Cavanagh", url:"https://themoviedb.org/person/2472821"}}, {tmdbId:"573774", properties:{bornIn:"Port of Spain, Trinidad, Trinidad and Tobago", imdbId:"0138460", born:date('1941-06-29'), name:"Stokely Carmichael", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9n1nQ9PQvwfUdcapsHkiprV4rym.jpg", url:"https://themoviedb.org/person/573774"}}, {tmdbId:"555310", properties:{imdbId:"0189459", name:"Stanley Crouch", url:"https://themoviedb.org/person/555310"}}, {tmdbId:"1416745", properties:{imdbId:"6754631", name:"Robert Durst", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/b3U6gjPe1YAGBF3ZXEXgVotLv5c.jpg", url:"https://themoviedb.org/person/1416745"}}, {tmdbId:"1757255", properties:{name:"Debra Kay Anderson", url:"https://themoviedb.org/person/1757255"}}, {tmdbId:"1226534", properties:{imdbId:"1371293", name:"Jay London", url:"https://themoviedb.org/person/1226534"}}, {tmdbId:"69921", properties:{imdbId:"0787322", born:date('1949-11-28'), name:"Paul Shaffer", url:"https://themoviedb.org/person/69921"}}, {tmdbId:"84698", properties:{bornIn:"Vancouver, British Columbia, Canada", imdbId:"2057726", born:date('1988-11-08'), name:"Jessica Lowndes", bio:"Jessica Lowndes (born November 8, 1988) is a Canadian actress and singer.  She is best known for her role as Adrianna Tate-Duncan on TV series 90210. \n\nDescription above from the Wikipedia article Jessica Lowndes, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zXxQcsal4mkBxfXoCoe67Ne7dya.jpg", url:"https://themoviedb.org/person/84698"}}, {tmdbId:"1274510", properties:{bornIn:"California, U.S.", imdbId:"4865040", born:date('2007-07-27'), name:"Alyvia Alyn Lind", bio:"Alyvia Alyn Lind is an actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gg7ZRQQic55Kh7vGQRFz7dwbBSr.jpg", url:"https://themoviedb.org/person/1274510"}}, {tmdbId:"1442069", properties:{bornIn:"Vancouver, British Columbia, Canada", imdbId:"6016511", born:date('2002-12-23'), name:"Finn Wolfhard", bio:"Finn Wolfhard (born December 23, 2002) is a Canadian actor, musician, screenwriter and director.  His acting roles include Mike Wheeler in the Netflix series Stranger Things (2016–present), for which he has won Screen Actors Guild Award for Outstanding Performance by an Ensemble in a Drama Series out of three nominations...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pefciSxD2TZurQIDtyGtStz9TaK.jpg", url:"https://themoviedb.org/person/1442069"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"1356210", properties:{bornIn:"Marbella, Málaga, Andalusia, Spain", imdbId:"5611121", born:date('2004-02-19'), name:"Millie Bobby Brown", bio:"Millie Brown was born in Spain, to British parents.  They moved to Orlando, Florida in 2011, where Millie went to acting workshops to pass the time on a Saturday, and it was there that a top Hollywood talent scout called and told Millie's parents that \"she has instincts you cannot teach. \" She advised Millie's parents that Millie could \"mix it with the best kids in Hollywood...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yzfxLMcBMusKzZp9f1Z9Ags8WML.jpg", url:"https://themoviedb.org/person/1356210"}}, {tmdbId:"1331981", properties:{bornIn:"Los Angeles County, California ", imdbId:"1418096", born:date('1979-01-04'), name:"Samantha Sloyan", bio:"Samantha Sloyan (born January 4, 1979) is an American actress.  Sloyan is best known for her roles in In the Key of Eli and Scandal, Hush and Grey's Anatomy...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/prhRQ3npp7OwssXhxNUw0RTFjFw.jpg", url:"https://themoviedb.org/person/1331981"}}, {tmdbId:"932076", properties:{bornIn:"Silver Spring, Maryland, USA", imdbId:"2318089", born:date('1982-08-09'), name:"Kate Siegel", bio:"Kate Siegel (born August 9, 1982) is an American actress and screenwriter.  She made her film debut in The Curse of the Black Dahlia (2006).  She made her television debut in Ghost Whisperer (2009).  She is best known for her work in the horror-thriller film Hush (2016) which she also co-wrote with her husband Mike Flanagan. \n\nDescription above from the Wikipedia article Kate Siegel, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eLwkHwjYlZyZHHvBEFVT4LLAaSe.jpg", url:"https://themoviedb.org/person/932076"}}, {tmdbId:"2207929", properties:{name:"Brian Carmody", url:"https://themoviedb.org/person/2207929"}}, {tmdbId:"35070", properties:{bornIn:"Amritsar, Punjab, India", imdbId:"0474774", born:date('1967-09-09'), name:"Akshay Kumar", bio:"​Akshay Kumar is an Indian film actor, producer and martial artist who has appeared in over a hundred Hindi films.  When he began his acting career in the 1990s, he primarily starred in action films and was particularly known for his appearances in feature films commonly called the \"Khiladi series\", which included Khiladi (1992), Sabse Bada Khiladi (1995), Khiladiyon Ka Khiladi (1996), and Khiladi 420 (2000), as well as other action films such as Mohra (1994)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/stVu4BdMwDFi490UXUDG4xD7Zcb.jpg", url:"https://themoviedb.org/person/35070"}}, {tmdbId:"1040950", properties:{bornIn:"New Delhi, India", imdbId:"3373271", born:date('1985-11-28'), name:"Esha Gupta", bio:"Esha Gupta  is an Indian film actress, model, and the winner of the Miss India International title of 2007.  She has established a career in Bollywood films. \n\nGupta entered the Femina Miss India contest in 2007, where she placed third and won the Miss India International title, and later represented India at Miss International pageant...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xHzt46aqV3rtH3BcwtkDwzlAETv.jpg", url:"https://themoviedb.org/person/1040950"}}, {tmdbId:"1554281", properties:{name:"Steven Avery", url:"https://themoviedb.org/person/1554281"}}, {tmdbId:"1051058", properties:{imdbId:"3080119", born:date('1990-03-25'), name:"Lorenzo Richelmy", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mwyi149Lwnt7KxubmPFohLqYXZf.jpg", url:"https://themoviedb.org/person/1051058"}}, {tmdbId:"86764", properties:{bornIn:"Edmonton - Alberta - Canada", imdbId:"2138746", name:"Olivia Cheng", bio:"Olivia Sonya Cheng is a Canadian actress, broadcast journalist, and former correspondent for Entertainment Tonight Canada...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c1rOhwVuZi3v47fuTAnVVB4XuSc.jpg", url:"https://themoviedb.org/person/86764"}}, {tmdbId:"1401531", properties:{bornIn:"Seoul, South Korea", imdbId:"2263791", born:date('1985-01-25'), name:"Claudia Kim", bio:"Claudia Kim, born Kim Soo-hyun (김수현), is a South Korean actress and model...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iuiRf8no7xkPSWu9XPF7AmYQlHt.jpg", url:"https://themoviedb.org/person/1401531"}}, {tmdbId:"1157303", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"1380711", born:date('1965-11-02'), name:"Laura Albert", bio:"Laura Victoria Albert is the American author of writings that include works credited to the literary persona JT LeRoy...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wJYbwEzqKV9BTcQs2DWOw7iDk08.jpg", url:"https://themoviedb.org/person/1157303"}}, {tmdbId:"1092233", properties:{imdbId:"0070532", name:"Bruce Benderson", bio:"Bruce Benderson is an American author, born to Jewish parents of Russian descent, who lives in New York.  He attended William Nottingham High School in Syracuse, New York and then Binghamton University...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/txytVRVTXxKOp81Xai8JhhsTT3N.jpg", url:"https://themoviedb.org/person/1092233"}}, {tmdbId:"1240056", properties:{imdbId:"0177981", name:"Dennis Cooper", url:"https://themoviedb.org/person/1240056"}}, {tmdbId:"1666933", properties:{name:"Panio Gianopoulos", url:"https://themoviedb.org/person/1666933"}}, {tmdbId:"176125", properties:{imdbId:"0183824", name:"Paul Courtenay Hyu", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xMyvtY7fHSxzx5KloxAXjiB1DYn.jpg", url:"https://themoviedb.org/person/176125"}}, {tmdbId:"1232425", properties:{imdbId:"0261557", name:"Lili Estefan", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rPpgudDlSqpuJAJyrCBln95ttN7.jpg", url:"https://themoviedb.org/person/1232425"}}, {tmdbId:"86498", properties:{bornIn:"San Diego, California, USA", imdbId:"0407101", born:date('1976-07-15'), name:"Gabriel Iglesias", bio:"Gabriel Jesus Iglesias (born July 15, 1976), known comically as Fluffy, is an American comedian, actor, writer, producer and voice actor.  He is known for his shows I'm Not Fat… I'm Fluffy and Hot & Fluffy. \n\nDescription above from the Wikipedia article Gabriel Iglesias, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8Bjy3RZ5TfNs3oUOUpxTv84G01f.jpg", url:"https://themoviedb.org/person/86498"}}, {tmdbId:"26485", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0000902", born:date('1954-06-15'), name:"Jim Belushi", bio:"James Adam Belushi is an American actor, comedian and musician.  He is best known for his title role of James \"Jim\" Orenthal on the American sitcom According to Jim.  He is the younger brother of the late comic actor John Belushi. \n\nBelushi was born in Chicago to Adam Anastos Belushi, an Albanian from Qytezë, Korçë, and Agnes Demetri (Samaras) Belushi, who was born in Ohio from Greek-Albanian immigrants from Korçë...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qF3CalNHfLdeZQ02KhUFPxEqCm2.jpg", url:"https://themoviedb.org/person/26485"}}, {tmdbId:"16145", properties:{bornIn:"Hachioji, Tokyo, Japan", imdbId:"0473802", born:date('1971-01-17'), name:"Youki Kudoh", bio:"Youki Kudoh is a Japanese actress and singer.  She won the award for best newcomer at the 6th Yokohama Film Festival for “The Crazy Family. ” She also won the award for best actress at the 16th Hochi Film Award for “War and Youth...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dQHHbR7spJQXp2bi2YQQkMPk3H3.jpg", url:"https://themoviedb.org/person/16145"}}, {tmdbId:"73044", properties:{bornIn:"Tokyo Prefecture, Japan", imdbId:"0649026", born:date('1965-08-18'), name:"Ikue Otani", bio:"Ikue Otani is a Japanese voice actress and singer, most famous for providing the voice of Pikachu in Pokémon.  She took pregnancy leave from her work from January to May 2006, but her voice credit for Pikachu did not change, as her voice has been recorded many times...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pa4NT65bTYkAGIZCtQgfXkifqrw.jpg", url:"https://themoviedb.org/person/73044"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"64753", properties:{imdbId:"1579372", born:date('1993-05-22'), name:"Kesun Loder", url:"https://themoviedb.org/person/64753"}}, {tmdbId:"80457", properties:{bornIn:"Seoul, South Korea", imdbId:"0359197", born:date('1964-11-03'), name:"Han Seok-kyu", bio:"Han Suk-kyu   (born November 3, 1964 in Seoul) is a South Korean actor.  One of the leading actors of Korean cinema, Han's notable works include Green Fish (1997), No.  3 (1997), Christmas in August (1998), Shiri (1999), The Scarlet Letter (2004), and The President's Last Bang (2005). \n\nDescription above from the Wikipedia article Han Suk-kyu, licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5N1vW3rLzeDNqprrZqwPpTPm3Ub.jpg", url:"https://themoviedb.org/person/80457"}}, {tmdbId:"20738", properties:{bornIn:"Gimhae, South Gyeongsang, South Korea", imdbId:"0814280", born:date('1967-01-17'), name:"Song Kang-ho", bio:"Song Kang-ho first worked in plays, entering a troupe.  He started working in films as a supporting actor in minor roles.   He made the breakthrough in 'Green Fish' in a supporting role which had a major impact.  In 'No.  3' he actually created a syndrome from his role, when people started imitating his acting...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Ac62dYrkZ45AzubyjTUEelpAwje.jpg", url:"https://themoviedb.org/person/20738"}}, {tmdbId:"26854", properties:{bornIn:"Grays, Essex, England, UK", imdbId:"0205289", born:date('1953-07-30'), name:"Phil Davis", bio:"Philip \"Phil\" Davis is an English actor, writer, and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sNJ9nFWxpGVmQYvq7rU9xqryu0F.jpg", url:"https://themoviedb.org/person/26854"}}, {tmdbId:"643", properties:{bornIn:"Shenyang, Liaoning Province, China", imdbId:"0000084", born:date('1965-12-31'), name:"Gong Li", bio:"From Wikipedia, the free encyclopedia\n\nGong Li (born 31 December 1965) is a Chinese-born Singaporean film actress.  Gong first came into international prominence through close collaboration with Chinese director Zhang Yimou and is credited with helping bring Chinese cinema to Europe and the United States...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uP3Fs3QUsGBxhNqGFWMnN1Z2l8z.jpg", url:"https://themoviedb.org/person/643"}}, {tmdbId:"65277", properties:{bornIn:"Changsha, Hunan, China", imdbId:"0955342", born:date('1956-09-01'), name:"Zhang Fengyi", bio:"​From Wikipedia, the free encyclopedia\n\nZhang Fengyi (born September 1, 1956) is a Chinese actor most famous for his role in Farewell My Concubine, as a Chinese stage actor dealing with China's changing political climate and the affections of his singing partner.  Other notable roles have been his interpretations of the would-be assassin Jing Ke in the film The Emperor and the Assassin and the warlord Cao Cao in the two-part film Red Cliff.  Zhang was born in Changsha, Hunan province...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l3PtQzEU84l7B9XA6SitAGIIJqH.jpg", url:"https://themoviedb.org/person/65277"}}, {tmdbId:"65278", properties:{bornIn:"Shandong, China", imdbId:"0839008", name:"Sun Zhou", url:"https://themoviedb.org/person/65278"}}, {tmdbId:"65263", properties:{imdbId:"1210703", name:"Chutcha Rujinanon", url:"https://themoviedb.org/person/65263"}}, {tmdbId:"1139069", properties:{bornIn:"Urumqi, Xinjiang, China", born:date('1937-12-18'), name:"Ma Jingwu", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2OnA3NnroNCCj8Qd0so3DfFiRjM.jpg", url:"https://themoviedb.org/person/1139069"}}, {tmdbId:"15168", properties:{imdbId:"0955831", born:date('1930-04-15'), name:"Zhu Xu", bio:"Zhu Xu (Chinese: 朱旭) is a Chinese actor.  He is well known for his roles in Zhang Yang's Shower and Wu Tianming's The King of Masks, the latter film helping him garner a Best Actor prize at the Tokyo International Film Festival...", url:"https://themoviedb.org/person/15168"}}, {tmdbId:"15169", properties:{imdbId:"0699699", name:"Quanxin Pu", url:"https://themoviedb.org/person/15169"}}, {tmdbId:"15170", properties:{bornIn:"Tangshan, Hebei, China", imdbId:"0422640", born:date('1969-11-04'), name:"Jiang Wu", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2eUlOQ4JlGUMMAPNHgxZ4uO4ONA.jpg", url:"https://themoviedb.org/person/15170"}}, {tmdbId:"15171", properties:{imdbId:"0954840", name:"He Zeng", url:"https://themoviedb.org/person/15171"}}, {tmdbId:"15264", properties:{imdbId:"0786281", name:"Bajram Severdzhan", url:"https://themoviedb.org/person/15264"}}, {tmdbId:"1337", properties:{bornIn:"Hong Kong", imdbId:"0504897", born:date('1962-06-27'), name:"Tony Leung Chiu-Wai", bio:"Tony Leung Chiu-Wai is a Hong Kong film actor and former TVB actor.  A major film star since the 1990s, Leung has won the Hong Kong Film Awards five times and the Golden Horse Best Actor awards thrice...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nQbSQAws5BdakPEB5MtiqWVeaMV.jpg", url:"https://themoviedb.org/person/1337"}}, {tmdbId:"1619", properties:{bornIn:"Lamma Island, Hong Kong, British Crown Colony [now China]", imdbId:"0000334", born:date('1955-05-18'), name:"Chow Yun-Fat", bio:"Chow Yun-Fat is an Asian-born film actor who first came to the attention of western audiences via his roles in the high-octane/blazing guns action films of maverick HK director John Woo...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cTBiIlh0ePSAjyW0SmIESCBwTWt.jpg", url:"https://themoviedb.org/person/1619"}}, {tmdbId:"26784", properties:{bornIn:"Shanghai, China", imdbId:"0497097", born:date('1952-08-06'), name:"Danny Lee Sau-Yin", bio:"Danny Lee Sau-Yin is a Hong Kong actor, film producer, screenwriter, director, action director and presenter.  He is best known for frequently portraying Hong Kong police officers in films such as \"Law With Two Phases\" (1984), \"The Killer\" (1989) and \"The Untold Story\" (1993).  He won the award for Best Leading Actor at the 1984 Golden Horse Awards...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/en3IGABHGV4orIYPMdsyUJ3sa3Z.jpg", url:"https://themoviedb.org/person/26784"}}, {tmdbId:"67047", properties:{imdbId:"0160846", name:"Paul Chu Kong", url:"https://themoviedb.org/person/67047"}}, {tmdbId:"67346", properties:{imdbId:"0010629", name:"John Adames", url:"https://themoviedb.org/person/67346"}}, {tmdbId:"227778", properties:{bornIn:"Hong Kong, British Crown Colony [now China]", born:date('1957-09-09'), name:"Carol Cheng", bio:"Cheng began her career in the 1970s working on a number of Television Broadcasts Limited series.  She has also hosted the Hong Kong version of the game show The Weakest Link.  In 1983, she made her debut along with Chow Yun-fat, with whom she would later become romantically involved.  After her film debut her output became so prolific that at one point she was working on nine films simultaneously, leading her to have the nickname \"Nine films Cheng...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fnbJTW1jf93T8pexvjWNjOxW3gq.jpg", url:"https://themoviedb.org/person/227778"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"65427", properties:{bornIn:"Kitakyushu, Fukuoka Prefecture, Japan", imdbId:"0879936", born:date('1967-06-15'), name:"Yuji Ueda", bio:"Yuji Ueda is a Japanese voice actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/b7gFUNNUPGyrfuvBf8AW4DaziYX.jpg", url:"https://themoviedb.org/person/65427"}}, {tmdbId:"56861", properties:{bornIn:"Hong Kong, British Crown Colony [now China]", imdbId:"0504899", born:date('1958-02-01'), name:"Tony Leung Ka-Fai", bio:"From Wikipedia, the free encyclopedia\n\nTony Leung Ka-fai (born February 1, 1958) is a three-time Hong Kong Film Award-winning Chinese film actor. \n\nBecause he is often confused with actor Tony Leung Chiu-Wai, Tony Leung Ka-fai is known as \"Big Tony\", while Tony Leung Chiu-Wai is known as \"Little Tony\", nicknames which correspond to the actors' respective physical statures...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ksrZeHeEKqPm5GS1IrmJ9WC9sRS.jpg", url:"https://themoviedb.org/person/56861"}}, {tmdbId:"45865", properties:{bornIn:"США", imdbId:"0490477", born:date('1980-07-26'), name:"Ellen Hamilton Latzen", bio:"Ellen Hamilton Latzen  (born July 26, 1980) is an American actress who appeared as a child actor in television and film roles from 1987 to 1997, including Family Ties, The Equalizer, Mr.  North, and National Lampoon's Christmas Vacation.  However, her most notable role was her first role, as the daughter to Michael Douglas' character in the 1987 film Fatal Attraction...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vy6vtjiFleUTaNoigSBpg8gg0We.jpg", url:"https://themoviedb.org/person/45865"}}, {tmdbId:"149010", properties:{bornIn:"Los Angeles County, California, USA", imdbId:"0114371", born:date('1987-12-04'), name:"Orlando Brown", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bedZmTFMkTLmXwbSn2z0IQqQE02.jpg", url:"https://themoviedb.org/person/149010"}}, {tmdbId:"20751", properties:{bornIn:"Gold Beach, Oregon, USA", imdbId:"0933098", born:date('1973-09-25'), name:"Bridgette Wilson", bio:"Bridgette Wilson (born September 25, 1973) is an American actress, singer and model.  A Miss Teen USA in 1990, Wilson holds several acting roles in television and movies, including the role of Veronica Vaughn in the movie Billy Madison, and the role of Sonya in the movie Mortal Kombat.  She married tennis player Pete Sampras in 2000. \n\nDescription above from the Wikipedia article Bridgette Wilson, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zq6uzzL87CtfgxD4G3bLTcgUUTe.jpg", url:"https://themoviedb.org/person/20751"}}, {tmdbId:"45999", properties:{bornIn:"Musashino, Tokyo, Japan", imdbId:"0651534", born:date('1968-03-11'), name:"Takao Osawa", bio:"Takao Osawa (born on March 11, 1968) is a Japanese actor and a former model.  He began his career as a fashion model when he was a university student in 1987.  He rose to prominence in a lead role on the television drama Heaven's Coins in 1995.  He turned his focus to film roles from 2000. \n\nDescription above from the Wikipedia article Takao Osawa, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fgnR4ICiuF5csPfp3dN9MK1XdbE.jpg", url:"https://themoviedb.org/person/45999"}}, {tmdbId:"67926", properties:{imdbId:"0208878", name:"Guy-Manuel de Homem-Christo", url:"https://themoviedb.org/person/67926"}}, {tmdbId:"2649452", properties:{name:"Todd Edwards", url:"https://themoviedb.org/person/2649452"}}, {tmdbId:"67938", properties:{bornIn:"San Rafael, California, USA", imdbId:"0337751", born:date('1975-02-07'), name:"Dan Green", bio:"From Wikipedia, the free encyclopedia\n\nDaniel Alexander Green (born February 7, 1975), is an American voice actor, voice director and script adapter who has worked for 4Kids Entertainment, DuArt Film and Video, NYAV Post and Central Park Media...", url:"https://themoviedb.org/person/67938"}}, {tmdbId:"67833", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0835688", born:date('1967-10-18'), name:"Eric Stuart", bio:"From Wikipedia, the free encyclopedia\n\nEric Stuart (born October 18, 1967 in Brooklyn, New York) is a voice actor, voice director, singer, songwriter, and guitarist.  As the lead singer of his own band, the Eric Stuart Band (abbreviated ESB), he is an award-winning independent artist with a growing US and international fan base...", url:"https://themoviedb.org/person/67833"}}, {tmdbId:"68812", properties:{bornIn:"Kansas City, Missouri, USA", imdbId:"0000799", born:date('1929-11-15'), name:"Ed Asner", bio:"Edward Asner (born November 15, 1929), commonly known as Ed Asner, is an American film, television, stage, and voice actor and former president of the Screen Actors Guild, primarily known for his Emmy Award-winning role as Lou Grant on both The Mary Tyler Moore Show and its spin-off series, Lou Grant.  In 2009, he starred as the voice of Carl Fredricksen in Pixar's award-winning animated film, Up...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i9Akq9tqNwgcAc63QaSaiTYZtUB.jpg", url:"https://themoviedb.org/person/68812"}}, {tmdbId:"544797", properties:{bornIn:"Hong Kong", imdbId:"0157785", born:date('1963-01-26'), name:"Chin Siu-Ho", bio:"Chin Siu Ho (Chinese: 錢小豪, born January 26, 1963) is a Hong Kong actor and martial artist, notable for acting with Jet Li in The Tai-Chi Master and Fist of Legend.  He is the older brother of actor Chin Kar-Lok...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/s4UGGQ04mZp9ZEOD2hptHCUV5ha.jpg", url:"https://themoviedb.org/person/544797"}}, {tmdbId:"63442", properties:{bornIn:"Seoul, South Korea", imdbId:"1028580", born:date('1976-03-25'), name:"Cha Tae-hyun", bio:"Cha Tae-Hyun (차태현) is a South Korean actor and co-founder of the entertainment agency Blossom Entertainment...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wilKs6xi6ggjpkMwnlxZOAoMK0g.jpg", url:"https://themoviedb.org/person/63442"}}, {tmdbId:"63436", properties:{bornIn:"Seoul, South Korea", imdbId:"0432428", born:date('1981-10-30'), name:"Jun Ji-hyun", bio:"Jun Ji-hyun ( born October 30, 1981) also known as Gianna Jun, is a South Korean actress and model.  She had her breakthrough role in 2001 as The Girl in the film My Sassy Girl which became the highest grossing Korean comedy of all time.  Other notable films include Il Mare (2000) and Windstruck (2004)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/27pUbPsQGzH1pSbZZtZZ6cz4mUr.jpg", url:"https://themoviedb.org/person/63436"}}, {tmdbId:"125427", properties:{imdbId:"1077025", born:date('1939-04-13'), name:"Kim In-mun", bio:"Kim In-mun (김인문) was a South Korean actor...", died:date('2011-04-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2abcJjJdER5m6Ku4MvJ3WcINFIo.jpg", url:"https://themoviedb.org/person/125427"}}, {tmdbId:"553705", properties:{imdbId:"5092875", born:date('1960-08-14'), name:"Song Ok-Suk", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cAroBRYVKL0OozWq5EFe11mWNkA.jpg", url:"https://themoviedb.org/person/553705"}}, {tmdbId:"68672", properties:{bornIn:"Washington, District of Columbia, USA", imdbId:"0090981", born:date('1966-11-19'), name:"Wolfgang Bodison", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fA2K4CE8KV53UOTCvhvtfR2aQ1J.jpg", url:"https://themoviedb.org/person/68672"}}, {tmdbId:"68676", properties:{bornIn:"Hong Kong, China", imdbId:"0803298", born:date('1912-11-27'), name:"Yuen Siu-Tien", bio:"Yuen Siu-tien (27 November 1912 – 8 January 1979) (also known as Yuan Xiaotian, Simon Yuen, Sam Seed or \"Ol' Dirty\") was a Chinese martial arts film actor in the late 1970s.  Yuen is perhaps best known as Beggar So in three films: Drunken Master, Story of Drunken Master and his final film Dance of the Drunk Mantis.  He starred in films with film actors like Jackie Chan and under the direction of his real life son Yuen Woo-ping.  Yuen died having a heart attack in 1979...", died:date('1979-01-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lGd4ZuaXzHUbLENA2e1NQboworG.jpg", url:"https://themoviedb.org/person/68676"}}, {tmdbId:"68677", properties:{bornIn:"Osaka, Japan", imdbId:"0399007", born:date('1944-12-21'), name:"Hwang Jang-Lee", bio:"​From Wikipedia, the free encyclopedia\n\nHwang Jang Lee (born 21 December 1944) is a Korean martial artist and actor.  Hwang is perhaps best known as Sheng Kuan in 1978 film Snake in the Eagle's Shadow and Wong Chin in 1981 film Hitman in the Hand of Buddha.  Variations of his name are often written as Wong Cheng Lee or Wong Cheng Li, in their Cantonese-Chinese equivalents...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/65dBu82HVUNfBOzbPzsYUF1QDgf.jpg", url:"https://themoviedb.org/person/68677"}}, {tmdbId:"20664", properties:{bornIn:"Shiogama, Miyagi Prefecture, Japan", imdbId:"0945290", born:date('1961-06-17'), name:"Kouichi Yamadera", bio:"Kouichi Yamadera is a Japanese voice actor and radio personality, known for voicing Jim Carrey and Eddie Murphy in the Japanese language releases of their respective films.  In 2006, he divorced voice actress Kanai Mika...", url:"https://themoviedb.org/person/20664"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"4259", properties:{bornIn:"Seoul, South Korea", imdbId:"1018275", born:date('1971-11-05'), name:"Kim Young-min", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xXbY65ATWU0VGd59Ry16o3mnxps.jpg", url:"https://themoviedb.org/person/4259"}}, {tmdbId:"4261", properties:{imdbId:"1415741", name:"Ha Yeo-jin", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xciG4E8WPFBqKDSlhu3NO5iWuNK.jpg", url:"https://themoviedb.org/person/4261"}}, {tmdbId:"1048070", properties:{imdbId:"1301454", born:date('1944-10-19'), name:"Oh Yeong-su", url:"https://themoviedb.org/person/1048070"}}, {tmdbId:"1303267", properties:{imdbId:"0097140", born:date('1948-03-15'), name:"Kate Bornstein", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wU0T7iVLUpGVLO0Vrce2kHCm50S.jpg", url:"https://themoviedb.org/person/1303267"}}, {tmdbId:"69289", properties:{bornIn:"Busan, South Korea", imdbId:"0793781", born:date('1973-02-15'), name:"Shin Eun-kyung", bio:"Shin Eun-kyung (born 15 February 1973) is a South Korean actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h0XEpxsWzAyNScsBCJBbZWCTGV1.jpg", url:"https://themoviedb.org/person/69289"}}, {tmdbId:"69378", properties:{bornIn:"Seoul, South Korea", imdbId:"1235292", born:date('1972-06-01'), name:"Kim Sang-kyung", bio:"Kim Sang-kyung (born December 29, 1971) is a South Korean actor.  He is known for his leading roles in Memories of Murder (2003) and May 18 (2007)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jY8yOGFF0gNoB9DeDcQnbS5Z79M.jpg", url:"https://themoviedb.org/person/69378"}}, {tmdbId:"69379", properties:{bornIn:"Gyeonggi Province, South Korea", imdbId:"1323287", born:date('1965-11-16'), name:"Kim Roe-ha", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bGHnBUrBKk2ItXDZJrBDnBeQJvj.jpg", url:"https://themoviedb.org/person/69379"}}, {tmdbId:"109404", properties:{imdbId:"0751752", name:"Vito Russo", url:"https://themoviedb.org/person/109404"}}, {tmdbId:"69636", properties:{bornIn:"Xinhui, Guangdong, China", imdbId:"0862479", born:date('1946-08-19'), name:"Ti Lung", bio:"From Wikipedia, the free encyclopedia. \n\nTommy Tam Fu-Wing, also known as Ti Lung (Chinese: 狄龍) , or Dik Lung, is a Hong Kong actor, known for his numerous starring roles in a string of Shaw Brothers Studio's films, particularly The Blood Brothers,The Avenging Eagle, Clans of Intrigue, The Duel, The Sentimental Swordsman and its sequel, as well as the classic John Woo film A Better Tomorrow...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5Y6Krs06i9X0ZddRDiyw3RX6MwX.jpg", url:"https://themoviedb.org/person/69636"}}, {tmdbId:"4889", properties:{bornIn:"Pittsburgh, Pennsylvania, USA", imdbId:"0228171", born:date('1974-11-13'), name:"Kim Director", bio:"​From Wikipedia, the free encyclopedia. \n\nKim Director (born November 13, 1974) is an American actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/va3lHRPsyhA2jwb7sUIu0Kxngmy.jpg", url:"https://themoviedb.org/person/4889"}}, {tmdbId:"548617", properties:{name:"Wai Pak", url:"https://themoviedb.org/person/548617"}}, {tmdbId:"65971", properties:{bornIn:"Canton, China", imdbId:"0793384", born:date('1913-01-01'), name:"Sek Kin", bio:"Shih Kien (Chinese: 石堅, 1 January 1913 – 3 June 2009) was a Hong Kong–based Chinese actor.  Shih is best known for playing antagonists and villains in several early Hong Kong wuxia and martial arts films that dated back to the black-and-white period, and is most familiar to Western audiences for his portrayal of the primary villain, Han, in the 1973 martial arts film Enter the Dragon, which starred Bruce Lee...", died:date('2009-06-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vxsUlLtb6lred2cNEVcveRCsBZd.jpg", url:"https://themoviedb.org/person/65971"}}, {tmdbId:"70048", properties:{imdbId:"1185314", name:"Sanshi Katsura", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nndJZXsxHqRPor6K8KZicUjMZgE.jpg", url:"https://themoviedb.org/person/70048"}}, {tmdbId:"64434", properties:{bornIn:"Vancouver, British Columbia, Canada", imdbId:"1218953", born:date('1982-11-22'), name:"Charlene Choi", bio:"Born in Canada, Charlene Choi is a Chinese film and television actress and singer.  She is a member of the Cantopop group Twins, along with Gillian Chung...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9f4cT2AgaDsvEwMQRirs0w01mF1.jpg", url:"https://themoviedb.org/person/64434"}}, {tmdbId:"70336", properties:{bornIn:"Jeongseon County, Gangwon Province, South Korea", imdbId:"1047193", born:date('1977-11-10'), name:"Won Bin", bio:"Won Bin (born Kim Do-jin on November 10, 1977) is a South Korean actor.  He first gained wide popularity in 2000 after starring in the KBS's television series Autumn in My Heart.  One of the most selective actors in the Korean entertainment industry, he has starred in only five films to date, Guns & Talks, Taegukgi, My Brother, Mother and The Man from Nowhere...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7Ginzkr5lRT7x3bGc3GFSONNT7N.jpg", url:"https://themoviedb.org/person/70336"}}, {tmdbId:"70337", properties:{bornIn:"Gunsan, Jeollabuk-do, South Korea", imdbId:"0497249", born:date('1980-11-16'), name:"Lee Eun-ju", bio:"Lee Eun-ju was a South Korean actress.  She committed suicide at the age of 24. \n\nDescription above from the Wikipedia article Lee Eun-ju, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2005-02-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yP2DP3SEVfBZj23jqFVBDJ9ZZo0.jpg", url:"https://themoviedb.org/person/70337"}}, {tmdbId:"70338", properties:{bornIn:"Seoul, South Korea", imdbId:"1045837", born:date('1969-04-10'), name:"Gong Hyung-jin", bio:"Gong Hyung-jin is a South Korean actor and television host...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Qr28OEOVsWTkoZOdJo11VSQmQn.jpg", url:"https://themoviedb.org/person/70338"}}, {tmdbId:"70439", properties:{bornIn:"Guangdong Province，China", imdbId:"0874868", born:date('1936-08-09'), name:"Patrick Tse", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5neIbXmuvtdQIygHu6D2wighYwW.jpg", url:"https://themoviedb.org/person/70439"}}, {tmdbId:"77304", properties:{bornIn:"Wuhu，Anhui province，China", imdbId:"0955505", born:date('1976-03-12'), name:"Zhao Wei", bio:"Zhao Wei (Chinese: 赵薇, born March 12, 1976) is a mainland Chinese film actress and pop singer.  Audiences sometimes refer to her by her English name, Vicki Zhao (sometimes spelt Vicky Zhao).   She has been awarded the Hundred Flowers Award, Shanghai Film Critics Award, Huabiao Award, Golden Eagle TV Award as well as Shanghai Film Festival Golden Globet, two times Changchun Film Festival Golden Deer and four nominations of Hong Kong Film Award, two nominations of Golden Horse Award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pJG0sJP7Zc8xG0NOSk5r2JQ2SLb.jpg", url:"https://themoviedb.org/person/77304"}}, {tmdbId:"66717", properties:{bornIn:"Hong Kong, China", imdbId:"0938893", born:date('1961-09-02'), name:"Anthony Wong", bio:"With nearly 200 screen credits to his name, Anthony Wong Chau-sang (born Anthony Perry on September 2, 1961) is one of the most versatile and prolific actors in world Cinema...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hHxVKR5MJoqBNg210Kw2vYahw80.jpg", url:"https://themoviedb.org/person/66717"}}] AS row
