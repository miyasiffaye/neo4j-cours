UNWIND [{tmdbId:"84695", properties:{bornIn:"Boston, Massachusetts", imdbId:"1101451", born:date('1965-04-06'), name:"Frank Black", bio:"From Wikipedia, the free encyclopedia. \n\nBlack Francis (born Charles Michael Kittridge Thompson IV on April 6, 1965) is an American singer, songwriter and guitarist.  He is best known as the frontman of the influential alternative rock band Pixies, with whom he performs under the stage name Black Francis.  Following the band's breakup in 1993, he embarked on a solo career under the name Frank Black...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1zVvITZJiZ54QVmFNZJtPmhW00g.jpg", url:"https://themoviedb.org/person/84695"}}, {tmdbId:"88828", properties:{bornIn:"Dayton, Ohio", imdbId:"1645859", born:date('1961-06-10'), name:"Kim Deal", bio:"From Wikipedia, the free encyclopedia. \n\nKimberley Ann Deal (born June 10, 1961) is an American singer, songwriter and musician, best known as the bassist (and backup/lead vocalist) of the alternative rock band the Pixies and the lead vocalist and rhythm guitarist for The Breeders.  Deal first joined the Pixies in January 1986 as the band's bassist, adopting the stage name Mrs.  John Murphy for the band's releases Come On Pilgrim and Surfer Rosa...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2BItlz25nDaXcBQ6ce0BtX84ee4.jpg", url:"https://themoviedb.org/person/88828"}}, {tmdbId:"88830", properties:{bornIn:"Burlington, Massachusetts", imdbId:"1861644", born:date('1961-12-06'), name:"David Lovering", bio:"From Wikipedia, the free encyclopedia. \n\nDavid Lovering (born December 6, 1961) is an American musician and magician.  He is best known as the drummer for the alternative rock band Pixies, which he joined in 1986.  After the band's breakup in 1993, Lovering drummed with several other acts, including The Martinis, Cracker, Nitzer Ebb and Tanya Donelly.  He also pursued a magic career as The Scientific Phenomenalist; performing scientific and physics-based experiments on stage...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4ARdl5fSzLTMQac2Fd9p4a4iYiD.jpg", url:"https://themoviedb.org/person/88830"}}, {tmdbId:"88831", properties:{bornIn:"Manila, Philippines", imdbId:"1128842", born:date('1965-06-10'), name:"Joey Santiago", bio:"From Wikipedia, the free encyclopedia. \n\nJoey Santiago (born Joseph Alberto Santiago on June 10, 1965) is a Filipino-American guitarist and composer.  Active since 1986, Santiago is best known as the lead guitarist for the American alternative rock band Pixies.  After the band's breakup in 1993, Santiago produced musical scores for film and television documentaries, and he formed The Martinis with his wife, Linda Mallari...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d1Iy3gjEKPnkl7TPiEHfi7pApFB.jpg", url:"https://themoviedb.org/person/88831"}}, {tmdbId:"17118", properties:{imdbId:"2415554", name:"Mohamed Akhzam", url:"https://themoviedb.org/person/17118"}}, {tmdbId:"17476", properties:{bornIn:"Worthing, Sussex, England, UK", imdbId:"0927835", born:date('1950-01-01'), name:"Peter Wight", bio:"Peter Wight is a British character actor of stage, film and TV who is perhaps best known for his work with Mike Leigh on films such as Meantime, Naked, Vera Drake, Another Year and Mr Turner...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6KTJTAIrZFrYxqiK8vSSm2zDYpg.jpg", url:"https://themoviedb.org/person/17476"}}, {tmdbId:"4529", properties:{bornIn:"Lyon, Rhône, France", imdbId:"0856500", born:date('1971-01-17'), name:"Sylvie Testud", bio:"Née d'une mère comptable d'origine italienne et d'un père qui les abandonne lorsqu'elle a deux ans, Sylvie Testud grandit dans le quartier populaire de la Croix-Rousse à Lyon.  Très tôt fascinée par le cinéma, la jeune fille s'identifie notamment au personnage d'ado complexée incarné par Charlotte Gainsbourg dans L' Effrontée...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aAriA5QCS8kRk0jJRtp1mnH70Es.jpg", url:"https://themoviedb.org/person/4529"}}, {tmdbId:"16923", properties:{bornIn:"Paris, France", imdbId:"0339621", born:date('1954-09-08'), name:"Pascal Greggory", bio:"Pascal Greggory (born September 8, 1954) is a French actor. \n\nDescription above from the Wikipedia article Pascal Greggory, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1J3QISHIZg6C1xkhvshtX2lEiDG.jpg", url:"https://themoviedb.org/person/16923"}}, {tmdbId:"22820", properties:{bornIn:"Los Angeles - California - USA", imdbId:"0827735", born:date('1967-09-23'), name:"Jenna Stern", bio:"Jenna Louise Stern (born September 23, 1967 in Los Angeles, California) is an American actress.  Member of an artist family, Stern is the daughter of actor/producer Tom Stern and Academy award-nominated and Golden Globe-winning actress Samantha Eggar.  Her brother, Nicolas Stern, is a producer for film and television.  She married actor Brennan Brown in 1998, and they live in Brooklyn, New York.  Stern graduated from the U. C.  Berkeley with a B. A.  and received her M. F. A.  from NYU Graduate School...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eQQQNOpZBwsPmEAFETFNFE9xenV.jpg", url:"https://themoviedb.org/person/22820"}}, {tmdbId:"16742", properties:{imdbId:"2218894", name:"Kagiso Kuypers", url:"https://themoviedb.org/person/16742"}}, {tmdbId:"33934", properties:{bornIn:"Queensbury, New York, USA", imdbId:"1277177", born:date('1976-01-18'), name:"Derek Richardson", bio:"From Wikipedia, the free encyclopedia\n\nDerek Richardson (born January 18, 1976) is an American actor. \n\nDerek Richardson was born in Queensbury, New York.  He attended Colorado College from 1994 to 1998.  He began his career with guest roles on Law &amp; Order and Strangers with Candy.  Upon moving to Los Angeles in 2002, he was cast in a recurring role on J. J.  Abrams' Felicity as Keri Russell's love interest...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9lLW2UgkD4QgLnRjLbiLRaHdLdh.jpg", url:"https://themoviedb.org/person/33934"}}, {tmdbId:"33935", properties:{bornIn:"Iceland", imdbId:"1898448", born:date('1968-02-05'), name:"Eythor Gudjonsson", bio:"From Wikipedia, the free encyclopedia\n\nEyþór Guðjónsson (born February 5, 1968), often anglicized as Eythor Gudjonsson, is an Icelandic actor.  He stands 6'3\" (1. 91 m) tall. \n\nHe got his first big role in the 2005 horror movie Hostel, where he plays an Icelandic backpacker named Óli, famous for his catchphrase \"King of the Swing\", traveling through Europe with American backpackers Paxton (Jay Hernandez) and Josh (Derek Richardson) where they get lured to a Slovakian hostel with a gruesome secret...", url:"https://themoviedb.org/person/33935"}}, {tmdbId:"33936", properties:{bornIn:"Banská Bystrica, Slovakia", imdbId:"1319676", born:date('1979-05-16'), name:"Barbara Nedeljakova", bio:"From Wikipedia, the free encyclopedia\n\nBarbara Nedeljáková (born May 19, 1979) is a Slovak actress, best known for her role as Natalya in the 2005 horror film Hostel. \n\nDescription above from the Wikipedia article Barbara Nedeljáková, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3zIlT0MzScQ0LabagUoTDJAWCZP.jpg", url:"https://themoviedb.org/person/33936"}}, {tmdbId:"4432", properties:{bornIn:"Monroe, Georgia, USA", imdbId:"0175814", born:date('1953-11-13'), name:"Frances Conroy", bio:"Frances Conroy (born November 13, 1953) is an American actress.  She is most widely known for playing the matriarch Ruth O'Connor Fisher Sibley on the HBO funeral drama series Six Feet Under, which earned her a Golden Globe in 2004. \n\nDescription above from the Wikipedia article Frances Conroy, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aJRQAkO24L6bH8qkkE5Iv1nA3gf.jpg", url:"https://themoviedb.org/person/4432"}}, {tmdbId:"29617", properties:{imdbId:"0083307", name:"Paul Birchard", bio:"American actor living in Scotland and working worldwide.  In 1986 he wrote and recorded the song \"Diamonds Rap (We Are The Diamonds)\", promoting the Glasgow Diamonds American football team.  Known for Hanna (2011), 1408 (2007) and The Dark Knight (2005)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3A8JwCXwIE3qYwaFLFyaixUp070.jpg", url:"https://themoviedb.org/person/29617"}}, {tmdbId:"192933", properties:{imdbId:"0500065", born:date('1949-01-01'), name:"Margot Leicester", bio:"Margot was born in September 1949.  Growing up in Middleton in Lancashire  she attended Bury Grammar school, whose theatre trips to Stratford on  Avon, the Manchester Exchange and Octagon Theatre, Bolton, led to her  interest in acting.  On leaving school she read English, aptly enough at  the University of Leicester, and on graduation worked in repertory  theatres around the country...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/M2PEeYUdkrd4VjI1D0lsHbiG8t.jpg", url:"https://themoviedb.org/person/192933"}}, {tmdbId:"1781739", properties:{name:"Walter Lewis", url:"https://themoviedb.org/person/1781739"}}, {tmdbId:"109441", properties:{bornIn:"Minneapolis, Minnesota, USA", imdbId:"1491631", born:date('1992-03-29'), name:"Chris Massoglia", bio:"From Wikipedia, the free encyclopedia. \n\nChristopher Paul \"Chris\" Massoglia (born March 29, 1992) is an American television and motion picture actor. \n\nDescription above from the Wikipedia article Chris Massoglia, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2AwADDLC3RJgjFS5vOChInj5Rwr.jpg", url:"https://themoviedb.org/person/109441"}}, {tmdbId:"109867", properties:{imdbId:"2827359", name:"Jessica Carlson", url:"https://themoviedb.org/person/109867"}}, {tmdbId:"1255409", properties:{bornIn:"South Korea", imdbId:"1937349", born:date('1988-01-02'), name:"Shi-hoo Kim", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tzSDbXVsE6ypYo85Mqnaf6t5KUZ.jpg", url:"https://themoviedb.org/person/1255409"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"1117876", properties:{name:"Yea-young Kwon", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1WSbsfCYU9evbLn2Nyy3I6zGMge.jpg", url:"https://themoviedb.org/person/1117876"}}, {tmdbId:"90155", properties:{imdbId:"1105416", name:"Kôji Imada", url:"https://themoviedb.org/person/90155"}}, {tmdbId:"90157", properties:{imdbId:"1856217", name:"Sayaka Maeda", url:"https://themoviedb.org/person/90157"}}, {tmdbId:"90159", properties:{bornIn:"Osaka Prefecture, Japan", imdbId:"1029524", born:date('1973-03-10'), name:"Takashi Fujii", url:"https://themoviedb.org/person/90159"}}, {tmdbId:"90160", properties:{imdbId:"1855460", name:"Seiko Takuma", url:"https://themoviedb.org/person/90160"}}, {tmdbId:"14889", properties:{imdbId:"1161069", born:date('1994-11-11'), name:"Connor Price", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ziae4hnNIQTSOrSIapMRSybXiRQ.jpg", url:"https://themoviedb.org/person/14889"}}, {tmdbId:"55673", properties:{bornIn:"Boca Raton, Florida, USA", imdbId:"1795630", born:date('1993-10-27'), name:"Troy Gentile", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l4iv0LPM0gfx1MxEZ8EHfzC1cOX.jpg", url:"https://themoviedb.org/person/55673"}}, {tmdbId:"62167", properties:{imdbId:"2342090", name:"Mackenzie Mowat", url:"https://themoviedb.org/person/62167"}}, {tmdbId:"62168", properties:{bornIn:"Johannesburg, South Africa", imdbId:"1199888", born:date('1996-02-17'), name:"Sasha Pieterse", bio:"Sasha Pieterse (born 17 February 1996) is a South African-born American actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aTQCx8IEaEz2BN3zXWS3j4xbifP.jpg", url:"https://themoviedb.org/person/62168"}}, {tmdbId:"95635", properties:{bornIn:"Brantford - Ontario - Canada", imdbId:"0634409", born:date('1973-03-17'), name:"Michelle Nolden", bio:"From Wikipedia, the free encyclopedia. \n\nMichelle Nolden (height 5' 8\" (1,73 m) is a Canadian actress.  She has appeared in numerous films and television shows including ZOS: Zone of Separation, Numb3rs, Street Time, Earth: Final Conflict, The Time Traveler's Wife, Men with Brooms, Republic of Doyle as well as directing and writing a film called Loonie.  She has been nominated for an ACTRA Award and a Gemini Award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4ddqYDjKvEoYFl0pcrSpZoqHqYv.jpg", url:"https://themoviedb.org/person/95635"}}, {tmdbId:"59243", properties:{bornIn:"Vancouver, British Columbia, Canada", imdbId:"1821102", born:date('1997-04-23'), name:"Alex Ferris", bio:"Alexander Ferris (born April 23, 1997) is a Canadian actor.  He is perhaps best known for his roles in the thriller film The Invisible (2007), the drama film The Time Traveler's Wife (2009), and the comedy film Diary of a Wimpy Kid (2010)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uGzXaX2CbmrliRy4sdXuvfKZHWj.jpg", url:"https://themoviedb.org/person/59243"}}, {tmdbId:"34018", properties:{bornIn:"Barcelona, Catalonia, Spain", imdbId:"1273697", born:date('1981-03-27'), name:"Quim Gutiérrez", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/17Mo65PvdiG8dN2nIyH5rK0qMHz.jpg", url:"https://themoviedb.org/person/34018"}}, {tmdbId:"34019", properties:{bornIn:"Donostia-San Sebastián, Guipúzcoa, País Vasco, Spain", imdbId:"1011070", born:date('1978-10-28'), name:"Marta Etura", bio:"Marta Etura Palenzuela is a Spanish film and television actress.  Etura was born in San Sebastián...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nzi1LHG2KelUsVJNRkFRewGfZ6y.jpg", url:"https://themoviedb.org/person/34019"}}, {tmdbId:"3483", properties:{bornIn:"Málaga, Andalucía, Spain", imdbId:"0209409", born:date('1968-01-18'), name:"Antonio de la Torre", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d43JMOaio4mTZlov23gM2q8a6Uo.jpg", url:"https://themoviedb.org/person/3483"}}, {tmdbId:"34020", properties:{bornIn:"Córdoba, Argentina", imdbId:"0173105", born:date('1944-10-25'), name:"Héctor Colomé", died:date('2015-02-28'), url:"https://themoviedb.org/person/34020"}}, {tmdbId:"28485", properties:{bornIn:"Blackburn, Lancashire, England, UK", imdbId:"0671487", born:date('1967-09-01'), name:"Steve Pemberton", bio:"Steven James Pemberton is an English actor, comedian and writer, best known as a member of The League of Gentlemen with Reece Shearsmith, Mark Gatiss, and Jeremy Dyson.  Pemberton and Shearsmith also co-wrote and appeared in the sitcom Psychoville and the comedy-drama Inside No.  9...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j4AFPsF6DM9nfccol3VFQgPJ6Ia.jpg", url:"https://themoviedb.org/person/28485"}}, {tmdbId:"2619178", properties:{name:"Lily Atkinson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eqNbtVKlyNIuj0c78ki1ZHtEMMw.jpg", url:"https://themoviedb.org/person/2619178"}}, {tmdbId:"1251835", properties:{bornIn:"London, England", imdbId:"2085738", born:date('1999-09-19'), name:"Preston Nyman", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eidKvLDCRw68tG3CN6fGhvHUnW.jpg", url:"https://themoviedb.org/person/1251835"}}, {tmdbId:"52851", properties:{bornIn:"Los Angeles, California, USA", imdbId:"1745736", born:date('1975-12-05'), name:"Paula Patton", bio:"Paula Maxine Patton (born December 5, 1975) is an American actress.  She is mostly known for her appearances in the films Idlewild (2006), Déjà Vu (2006), Mirrors (2008), Precious (2009), Just Wright (2010), and Jumping the Broom (2011). \n\nDescription above from the Wikipedia article Paula Patton, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9sLIo0nCh4UEi3dHQCAwrFh0r4j.jpg", url:"https://themoviedb.org/person/52851"}}, {tmdbId:"172069", properties:{bornIn:"Anderson, South Carolina, USA", imdbId:"1569276", born:date('1976-11-29'), name:"Chadwick Boseman", bio:"Chadwick Boseman is an American actor, playwright, and screenwriter hailing from Anderson, South Carolina.  He graduated from Howard University and went on to study at the British American Dramatic Academy in Oxford.   Boseman's play \"Deep Azure\" was nominated for a 2006 Joseph Jefferson Award for New Work.   His breakout role was playing the lead Jackie Robinson in 2013's 42. \n\nBoseman is most well known for portraying T’Challa/Black Panther in the Marvel Cinematic Universe...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1lz1wLOuPFSRIratMz0SxD3tkJ.jpg", url:"https://themoviedb.org/person/172069"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"87243", properties:{bornIn:"West Palm Beach, Florida, USA", imdbId:"2718512", born:date('1985-01-03'), name:"Nicole Beharie", bio:"An American actress and singer.  She is known for her roles in American Violet (2008), Shame (2011), and 42 (2013).  Since September 2013, she has starred in the Fox fantasy series Sleepy Hollow.  Her height is 5' 1\" (1,55 m). \n\nBeharie was born in West Palm Beach, Florida. She attended Orangeburg Wilkinson High School in Orangeburg, South Carolina, and is a 2003 graduate of the South Carolina Governor's School for the Arts and Humanities, a public residential high school in Greenville...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rxLFX3rahbXvCZzyjMLkBnKdJwu.jpg", url:"https://themoviedb.org/person/87243"}}, {tmdbId:"22227", properties:{bornIn:"Washington - D.C. - USA", imdbId:"0005221", born:date('1961-04-02'), name:"Christopher Meloni", bio:"Christopher Peter Meloni (born April 2, 1961) is an American actor.  He is best known for his television roles as NYPD Detective Elliot Stabler on the NBC police drama Law &amp; Order: Special Victims Unit, and as inmate Chris Keller on the HBO prison drama Oz...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oiUzAJu9TV3KxhTeLABVRDq0xoj.jpg", url:"https://themoviedb.org/person/22227"}}, {tmdbId:"55775", properties:{bornIn:"Los Angeles, California, USA", imdbId:"1556320", born:date('1986-11-25'), name:"Katie Cassidy", bio:"Katherine Evelyn Anita \"Katie\" Cassidy (born November 25, 1986) is an American actress who has performed in The CW TV series Melrose Place, Supernatural, and Gossip Girl, and is considered to be a modern-day Scream queen for her roles in When a Stranger Calls, Black Christmas, A Nightmare on Elm Street and the horror TV series, Harper's Island.  Cassidy also starred in Taken, and has roles in the upcoming films Fencewalker and Monte Carlo...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mcRo6KyzYOE7prr01mTd5b2TstI.jpg", url:"https://themoviedb.org/person/55775"}}, {tmdbId:"71580", properties:{bornIn:"Hammersmith, London, England, UK", imdbId:"1212722", born:date('1976-07-19'), name:"Benedict Cumberbatch", bio:"Benedict Timothy Carlton Cumberbatch (born 19 July 1976) is an English film, television, and theatre actor.  His most acclaimed roles include: Stephen Hawking in the BBC drama \"Hawking\" (2004); William Pitt in the historical film \"Amazing Grace\" (2006); the protagonist Stephen Ezard in the miniseries thriller \"The Last Enemy\" (2008); Paul Marshall in \"Atonement\" (2007); Bernard in \"Small Island\" (2009); and Sherlock Holmes in the modern BBC adaptation series \"Sherlock\" (2010)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wz3MRiMmoz6b5X3oSzMRC9nLxY1.jpg", url:"https://themoviedb.org/person/71580"}}, {tmdbId:"58427", properties:{bornIn:"Havering, Essex, England, UK", imdbId:"2281941", born:date('1987-11-24'), name:"Scott Hazell", bio:"From Wikipedia, the free encyclopedia.   Scott Darren Hazell (born 24 November 1987) is a London-based actor working in Theatre, Television and Film. \n\nDescription above from the Wikipedia article Scott Hazell, licensed under CC-BY-SA,full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/58427"}}, {tmdbId:"33403", properties:{bornIn:"Long Island, New York", imdbId:"0567881", born:date('1948-06-18'), name:"Mac McDonald", bio:"Mac McDonald (born Terence McDonald, 18 June 1949, in Long Island, New York, USA) is an American actor.  He is best known for playing Captain Hollister on the BBC TV series Red Dwarf and frequently plays American characters in other British TV shows.  He has also had many movie roles in films such as Aliens, Batman and The Fifth Element, all of which were filmed in England. \n\nDescription above from the Wikipedia article Mac McDonald, licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gejehuptBzsJlPiWKU8B9TTrc7r.jpg", url:"https://themoviedb.org/person/33403"}}, {tmdbId:"58428", properties:{bornIn:"USA", imdbId:"0934618", born:date('1981-03-24'), name:"Philip Winchester", bio:"From Wikipedia, the free encyclopedia.  Philip C.  Winchester (born March 24, 1981) is an American actor. \n\nDescription above from the Wikipedia article Philip Winchester, licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hjjGI5uOlo4v6T360UR1bmUys4w.jpg", url:"https://themoviedb.org/person/58428"}}, {tmdbId:"11022", properties:{bornIn:"Westford, Massachusetts, USA", imdbId:"0822155", born:date('1976-12-27'), name:"Aaron Stanford", bio:"Aaron Stanford (born December 27, 1976) is an American actor best known for his roles in X2 and X-Men: The Last Stand as well as The Hills Have Eyes...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tOR7U3DURbSF746EARXlmaxhlL0.jpg", url:"https://themoviedb.org/person/11022"}}, {tmdbId:"5025", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0005416", born:date('1976-07-19'), name:"Vinessa Shaw", bio:"Vinessa Elizabeth Shaw (born July 19, 1976) is an American actress and model.  Shaw has starred in numerous motion pictures since the early 1990s, and is probably most well-known for her performances in Disney's 1993 Halloween film Hocus Pocus, Ladybugs, the 2006 remake of Wes Craven's horror picture The Hills Have Eyes, as well as the 2008 romance film Two Lovers, in which she starred alongside Joaquin Phoenix and Gwyneth Paltrow...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wzfFYvX2tnnfGxr8JR0fC2CvDEB.jpg", url:"https://themoviedb.org/person/5025"}}, {tmdbId:"28660", properties:{bornIn:"Mount Eliza, Victoria, Australia", imdbId:"0211087", born:date('1981-12-27'), name:"Emilie de Ravin", bio:"From Wikipedia, the free encyclopedia\n\nEmilie de Ravin (born 27 December 1981) is an Australian actress.  She is commonly associated with her roles as Tess Harding on Roswell and Claire Littleton on the ABC drama Lost. \n\nDe Ravin's film credits include Santa's Slay (2005), The Hills Have Eyes (2006) and Ball Don't Lie (2008).  She starred as Brendan Frye's heroin-addicted ex-girlfriend Emily in the neo-noir film Brick (2005)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/T4pyhFEPC8zSgUz9p3uQT2J5zX.jpg", url:"https://themoviedb.org/person/28660"}}, {tmdbId:"933160", properties:{bornIn:"New Delhi, India", imdbId:"4139037", born:date('1993-03-21'), name:"Suraj Sharma", bio:"Suraj Sharma is an Indian actor from New Delhi, who made his debut with the title role in the 2012 film Life of Pi.   Suraj Sharma was born in New Delhi, India.  His parents are Malayalis, they hail from Kerala.  Suraj is a student of philosophy at St Stephen's college in New Delhi.  He has completed schooling from Sardar Patel Vidyalaya, where he was described as a popular student...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zM1GN7rnzdhoIK3FBXaBCOx7igy.jpg", url:"https://themoviedb.org/person/933160"}}, {tmdbId:"935504", properties:{imdbId:"4853568", name:"Ayush Tandon", url:"https://themoviedb.org/person/935504"}}, {tmdbId:"1133846", properties:{imdbId:"5306953", name:"Gautam Belur", url:"https://themoviedb.org/person/1133846"}}, {tmdbId:"40462", properties:{bornIn:"Huntington Woods, Michigan, USA", imdbId:"0068338", born:date('1980-07-18'), name:"Kristen Bell", bio:"Kristen Bell (born July 18, 1980) is an American actress and voice actress. \n\nIn 2001, she made her Broadway debut.  After moving to Los Angeles, she landed various television guest appearances and small film parts, but she gained fame as the title character on Veronica Mars. \n\nBesides her tv and movie roles, she provided the voice and face of Lucy Stillman in the Assassin's Creed video game series...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zPDp7jfqwiesn7R3ygKufwjMLDU.jpg", url:"https://themoviedb.org/person/40462"}}, {tmdbId:"19211", properties:{bornIn:"Covington, Louisiana, USA", imdbId:"0813812", born:date('1978-12-08'), name:"Ian Somerhalder", bio:"Ian Somerhalder (born December 8, 1978) is an American model, actor and producer and founder of the Ian Somerhalder Foundation.  He is best known for playing Damon Salvatore in The Vampire Diaries and Boone Carlyle in Lost...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/egcPsSlojwiB3kXjj3rpZSxu5gq.jpg", url:"https://themoviedb.org/person/19211"}}, {tmdbId:"37936", properties:{bornIn:"Jersey City, New Jersey, USA", imdbId:"0587396", born:date('1981-09-26'), name:"Christina Milian", bio:"​From Wikipedia, the free encyclopedia.   \n\nChristine Marié Flores (born September 26, 1981), better known by her stage name Christina Milian (pronounced /mɪliˈɑːn/) is an American recording artist, actress, dancer and model.  Born in Jersey City, New Jersey, Milian moved to Los Angeles when she was 13 years old, desiring to be an actress.  By the age of 17, Milian had begun writing songs to help obtain a recording contract...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8gjuOvjQytPC5BygAToJgBIctpN.jpg", url:"https://themoviedb.org/person/37936"}}, {tmdbId:"120724", properties:{bornIn:"Los Angeles, California, USA ", imdbId:"1535523", born:date('1998-07-08'), name:"Jaden Smith", bio:"Jaden Christopher Syre Smith (born July 8, 1998) is an American child actor, rapper, songwriter, dancer, and the son of Will Smith and Jada Pinkett Smith.  He is the elder brother of singer Willow Smith.  His breakthrough role was in the 2006 film The Pursuit of Happyness, and he has also starred in the remakes of The Day the Earth Stood Still and The Karate Kid...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/meraACSN0LYwLeZlaXN9YW6JCZT.jpg", url:"https://themoviedb.org/person/120724"}}, {tmdbId:"38673", properties:{bornIn:"Cullman, Alabama, USA", imdbId:"1475594", born:date('1980-04-26'), name:"Channing Tatum", bio:"Channing Matthew Tatum (born April 26, 1980) is an American actor and film producer.  He began his career as a fashion model before turning to film roles, having starred in She's the Man (2006), Step Up (2006), Fighting (2009), Public Enemies (2009), G. I.  Joe: The Rise of Cobra (2009), and Dear John (2010)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e5p1xrGtPfpJBQR9Pt3B6W4buZP.jpg", url:"https://themoviedb.org/person/38673"}}, {tmdbId:"51975", properties:{bornIn:"Brandon, Wisconsin, USA", imdbId:"1377561", born:date('1982-11-14'), name:"Laura Ramsey", bio:"From Wikipedia, the free encyclopedia.   Laura Ramsey (born November 14, 1982) is an American film and television actress and model.  Ramsey was born in Brandon, Wisconsin, where she attended Laconia High School and subsequently moved to Los Angeles to pursue an acting career.  She was discovered while waiting tables in a Los Angeles restaurant on Sunset Boulevard. \n\nDescription above from the Wikipedia article Laura Ramsey, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9iJECsBwVspFwrev7UuHagdX6u7.jpg", url:"https://themoviedb.org/person/51975"}}, {tmdbId:"59315", properties:{bornIn:"New York City, New York, USA", imdbId:"1312575", born:date('1984-03-10'), name:"Olivia Wilde", bio:"Olivia Wilde is an American film and television actress, model, activist and director, best known for playing recurring television characters Alex Kelly on The O. C. , and Dr.  Remy \"Thirteen\" Hadley on the medical-drama House.  She also starred as and gave her voice to Quorra in the feature film science fiction franchise Tron...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gaCRH7B1TUuuYGxjBqrUG49jy9s.jpg", url:"https://themoviedb.org/person/59315"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"1902699", properties:{name:"James Vasquez", url:"https://themoviedb.org/person/1902699"}}, {tmdbId:"1902700", properties:{name:"Nicole Marcks", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zhd0M1VLDelo3cJHuAnmVW1yWfA.jpg", url:"https://themoviedb.org/person/1902700"}}, {tmdbId:"1829515", properties:{name:"David McBean", url:"https://themoviedb.org/person/1829515"}}, {tmdbId:"27107", properties:{imdbId:"0236451", name:"Mike Doyle", bio:"From Wikipedia, the free encyclopedia. \n\nMike Doyle is an American actor, screenwriter, director and producer.  He is best known for his recurring roles in the television series Law &amp; Order: Special Victims Unit, playing Forensics Tech Ryan O'Halloran, and Oz, playing Adam Guenzel. \n\nIt was on the set of Oz that Doyle met George Morfogen, whom he would cast in Shiner, a short film written, produced and directed by Doyle that debuted at the 2006 Tribeca Film Festival...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vWvYo2T80nz0F4hcXRBDpawUBo0.jpg", url:"https://themoviedb.org/person/27107"}}, {tmdbId:"74337", properties:{bornIn:"Allentown, Pennsylvania, U.S.", imdbId:"1075468", born:date('1973-11-14'), name:"Dana Snyder", bio:"​From Wikipedia, the free encyclopedia\n\nDana Snyder (born November 14, 1973) is an American stand-up comedian, actor, voice artist, and comedian, best known for playing Master Shake on the Aqua Teen Hunger Force show, and the film Aqua Teen Hunger Force Colon Movie Film for Theaters, both part of Cartoon Network's Adult Swim franchise...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xCNiRmQqVh6VJ0zfYfNpxW0KsFk.jpg", url:"https://themoviedb.org/person/74337"}}, {tmdbId:"74338", properties:{imdbId:"1052894", name:"Carey Means", bio:"​From Wikipedia, the free encyclopedia\n\nCarey Means is an American voice actor best known for playing Frylock in the Adult Swim show Aqua Teen Hunger Force.  Means is a graduate of Lincoln University in Jefferson City, Missouri with a degree for B. S.  Fine Arts/Vocal Music. \n\nDescription above from the Wikipedia article Carey Means, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/74338"}}, {tmdbId:"74340", properties:{bornIn:"ewark, Ohio,  United States", imdbId:"0581258", born:date('1966-11-27'), name:"Andy Merrill", bio:"​From Wikipedia, the free encyclopedia\n\nAndy Merrill (born November 27, 1966 in Newark, Ohio) is a television writer, producer, and voice actor best known for his comedy voice portrayal of the character Brak on Space Ghost: Coast To Coast and Cartoon Planet and other related productions from Cartoon Network utilizing characters from the Space Ghost series.  He is a graduate of Asbury University where he majored in media communications...", url:"https://themoviedb.org/person/74340"}}, {tmdbId:"74154", properties:{imdbId:"3003326", name:"Kelan Pannell", url:"https://themoviedb.org/person/74154"}}, {tmdbId:"7998", properties:{imdbId:"0662088", name:"Bret 'Brook' Parker", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/A1Bz3MJwMOkoCQSjHCGN0Z7mlYC.jpg", url:"https://themoviedb.org/person/7998"}}, {tmdbId:"59358", properties:{imdbId:"1747568", name:"Eli Fucile", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pcNfD0mIB9KrQMaXP0rN82VbiHY.jpg", url:"https://themoviedb.org/person/59358"}}, {tmdbId:"84707", properties:{bornIn:"New York City, New York, USA", imdbId:"0265637", born:date('1934-02-25'), name:"Michael Fairman", url:"https://themoviedb.org/person/84707"}}, {tmdbId:"208282", properties:{imdbId:"0011354", name:"Shea Adams", url:"https://themoviedb.org/person/208282"}}, {tmdbId:"217046", properties:{imdbId:"1812267", name:"Eddie Baroo", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pdxur3LhMEg8DNajEhHKE1J7FIx.jpg", url:"https://themoviedb.org/person/217046"}}, {tmdbId:"34657", properties:{bornIn:"Gold Coast, Queensland, Australia ", imdbId:"0057254", born:date('1927-05-02'), name:"Ray Barrett", bio:"From IMDb: Ray Barrett studied music and elocution and began acting at the age of eleven.  He was the first actor put under contract by the Australian Broadcasting Corporation Drama section.  He worked for several years on radio in Sydney, before working successfully in Britain between 1958 and the mid-1970s, when he returned to Australia.  He has received two AFI (Australian Film Industry) awards as an actor...", died:date('2009-09-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xN2aEguqoB6EQ2cKOpdpjhwCCC1.jpg", url:"https://themoviedb.org/person/34657"}}, {tmdbId:"76188", properties:{bornIn:"Ipswich, Queensland, Australia", imdbId:"0058181", name:"Tony Barry", bio:"From Wikipedia, the free encyclopedia\n\nTony Barry is an Australian actor who has performed in 55 feature films and 45 television series, across a four-decade career. \n\nDescription above from the Wikipedia article Tony Barry, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uRPT91lZPoGba7A67B3ZXK9PWjl.jpg", url:"https://themoviedb.org/person/76188"}}, {tmdbId:"62561", properties:{bornIn:"Los Angeles, California, USA", imdbId:"1935086", born:date('1983-10-03'), name:"Tessa Thompson", bio:"Tessa Thompson is an American film and television actress, best known for her roles as Valkyrie in the feature films Thor: Ragnarok and Avengers: Endgame, Jackie Cook on the TV series Veronica Mars, and Charlotte Hale on the HBO series Westworld...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ewRWXNfS3ehaalCQtvHCa7BhibC.jpg", url:"https://themoviedb.org/person/62561"}}, {tmdbId:"56734", properties:{bornIn:"Atlanta, Georgia, USA", imdbId:"1631269", born:date('1997-02-10'), name:"Chloë Grace Moretz", bio:"Chloë Grace Moretz is an American actress and model.  She had her breakthrough role in 2010, when she starred as Mindy Macready a. k. a.  Hit-Girl in Kick-Ass.  Some of her other film credits include (500) Days of Summer (2009), Diary of a Wimpy Kid (2010), Let Me In (2010), Hugo (2011), Dark Shadows (2012), Carrie (2013), If I Stay (2014) and The Equalizer (2014)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j9d4i2xsLGUhwpuy5y0fkx1qAcz.jpg", url:"https://themoviedb.org/person/56734"}}, {tmdbId:"35029", properties:{bornIn:"New York City, New York, USA", imdbId:"1092086", born:date('1974-04-10'), name:"David Harbour", bio:"David Harbour (born April 10, 1975) is an American actor.   Active since 1999, Harbour is perhaps best known for his role as Chief of Police Jim Hopper on the Netflix series Stranger Things (2016-present)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/chPekukMF5SNnW6b22NbYPqAStr.jpg", url:"https://themoviedb.org/person/35029"}}, {tmdbId:"54830", properties:{bornIn:"Pasadena, California, USA", imdbId:"0124208", born:date('1982-07-08'), name:"Sophia Bush", bio:"Sophia Anna Bush (born July 8, 1982) is an American actress, director and spokesperson.  She is perhaps best known for playing Detective Erin Lindsay on NBC's Chicago P. D.   Her film credits include the 2007 remake The Hitcher, John Tucker Must Die and The Narrows...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jfcyfreMPXngbgnEtVXKPvTXhp1.jpg", url:"https://themoviedb.org/person/54830"}}, {tmdbId:"54834", properties:{bornIn:"Virginia, USA", imdbId:"0461149", born:date('1978-10-25'), name:"Zachary Knighton", bio:"Zachary Andrew Knighton (born October 25, 1978) is an American actor who currently stars as Dave Rose on the ABC comedy series Happy Endings.  Prior to that, he co-starred as Dr.  Bryce Varley on ABC's science fiction series FlashForward from 2009–2010. \n\nDescription above from the Wikipedia article Zachary Knighton, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dtpt1IvPKHaEQmakARofIGhrJOL.jpg", url:"https://themoviedb.org/person/54834"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"57171", properties:{bornIn:"Waterford, Connecticut, USA", imdbId:"0582462", born:date('1978-12-09'), name:"Jesse Metcalfe", bio:"Jesse Eden Metcalfe (born December 9, 1978) is an American actor, most known for his role on Desperate Housewives as John Rowland.  He is also notable for his portrayal of Miguel Lopez-Fitzgerald on the soap opera Passions and his starring role as the title character in the movie John Tucker Must Die. \n\nDescription above from the Wikipedia article Jesse Metcalfe, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/atp5FK0tBemYNYQfSPnI2egR7rX.jpg", url:"https://themoviedb.org/person/57171"}}, {tmdbId:"57172", properties:{bornIn:"Glen Cove, Long Island, New York, USA", imdbId:"1215338", born:date('1980-10-13'), name:"Ashanti", bio:"​From Wikipedia, the free encyclopedia. \n\nAshanti Shequoiya Douglas born October 13, 1980 is an American recording artist, record producer and actress who rose to fame in the early 2000s.  Ashanti is most famous for her eponymous debut album, which featured the hit song \"Foolish\", and sold over 503,000 copies in its first week of release throughout the U. S.  in April 2002...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cYGZBOFNCIk83c0ut6hiQcR3k4o.jpg", url:"https://themoviedb.org/person/57172"}}, {tmdbId:"20819", properties:{bornIn:"West Hartford, Connecticut, USA", imdbId:"0200601", born:date('1968-12-16'), name:"Peter Dante", bio:"From Wikipedia, the free encyclopedia\n\nPeter Francis Dante (born December 16, 1968) is an French-American actor.  He has been in most Happy Madison films with his friend, Adam Sandler.  His roles are usually alongside Jonathan Loughran and/or Allen Covert.  His role in Little Nicky was named \"Peter\".  Similarly, his role in Grandma's Boy was named after his last name \"Dante\".  He also played a gay man named Tommy in Adam Sandler's movie Big Daddy...", url:"https://themoviedb.org/person/20819"}}, {tmdbId:"58016", properties:{bornIn:"Rochdale, Lancashire, England, UK", imdbId:"0295484", born:date('1976-07-12'), name:"Anna Friel", bio:"Anna Louise Friel (born 12 July 1976) is an English actress.  She rose to fame in the UK as Beth Jordache on the Channel 4 soap Brookside. \n\nDescription above from the Wikipedia article Anna Friel, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5JEtDmxo1Ck2ztv8wKJoYGkcL4w.jpg", url:"https://themoviedb.org/person/58016"}}, {tmdbId:"40386", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"0525076", born:date('1966-03-16'), name:"Ted Ludzik", url:"https://themoviedb.org/person/40386"}}, {tmdbId:"23533", properties:{imdbId:"1517875", born:date('1995-12-26'), name:"Zach Mills", bio:"Zachary \"Zach\" Mills (born December 26, 1995) is an American teen actor. \n\nMills has appeared in many film and television productions.  These include a brief appearance in the television series Scrubs and guest starring roles in such shows as Malcolm in the Middle, Eleventh Hour, Numb3rs, Ghost Whisperer and October Road.  His first significant supporting role in a film was as Adrien Brody's son in the 2006 film, Hollywoodland...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yGEROwelNIwZIQ85deNJ7zf2crX.jpg", url:"https://themoviedb.org/person/23533"}}, {tmdbId:"16970", properties:{bornIn:"Barcelona, Spain", imdbId:"1419440", born:date('1994-06-11'), name:"Ivana Baquero", bio:"​From Wikipedia, the free encyclopedia.   \n\nIvana Baquero Macías (born June 11, 1994; Barcelona, Spain) is a Spanish actress.  At the age of 11, Baquero was chosen by director Guillermo del Toro to play the lead role of Ofelia in Pan's Labyrinth, for which she won critical acclaim and the Goya Award for Best New Actress. \n\nDescription above from the Wikipedia article Ivana Baquero , licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/82lpu56szh5cVm85PWRqogBYVgv.jpg", url:"https://themoviedb.org/person/16970"}}, {tmdbId:"16971", properties:{bornIn:"Madrid, Spain", imdbId:"0893941", born:date('1970-10-02'), name:"Maribel Verdú", bio:"Maribel Verdú (born Madrid 2 October 1970) is a Spanish actress.  She is known to English-speaking audiences for playing Luisa in the 2001 film Y tu mamá también and Mercedes in Guillermo del Toro's 2006 film Pan's Labyrinth.  In Spain she is known for films such as Belle Époque, Tetro, and Huevos de oro. \n\nVerdú was born María Isabel Verdú Rollán.  She began acting at 13.  She has appeared in almost 50 movies since 1984.  Most have been in Spanish.  She has also been in TV shows...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7hxTsW5CKi2lkz5yGMWShki7DOo.jpg", url:"https://themoviedb.org/person/16971"}}, {tmdbId:"4255", properties:{bornIn:"Brooklyn - New York - USA", imdbId:"0692466", born:date('1947-01-26'), name:"Richard Portnow", bio:"​From Wikipedia, the free encyclopedia\n\nRichard Portnow (born January 26, 1947) is a prolific American character actor who played Howard Stern's father, Ben in the movie Private Parts.  He has appeared on The Sopranos and many other films, video games, and television shows such as Hannah Montana and Boston Legal...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uQZ3vSa2HHXywkDjGY8dN0oH5oY.jpg", url:"https://themoviedb.org/person/4255"}}, {tmdbId:"102649", properties:{bornIn:"Washington, D.C., USA", imdbId:"2490944", born:date('1969-04-27'), name:"Cory Booker", bio:"Cory Anthony Booker is the Mayor of Newark, New Jersey.  He is a member of the Democratic Party.  Booker is a former Newark City Councilman.  Booker was elected Mayor in 2006, becoming the 36th mayor of Newark and the third African-American mayor of that city...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qbs1ZFOQK8iTZmYuB94gVkaNbvM.jpg", url:"https://themoviedb.org/person/102649"}}, {tmdbId:"2360428", properties:{bornIn:"Newark, New Jersey, USA ", imdbId:"2665166", born:date('1962-09-06'), name:"Chris Christie", bio:"Christopher James Christie is an American politician, former federal prosecutor, and political commentator who served as the 55th Governor of New Jersey from 2010 to 2018.  Christie was born in Newark, New Jersey and raised in Livingston, New Jersey...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ma2qKHTl6sUnFPzvlkJFLB9r2Aj.jpg", url:"https://themoviedb.org/person/2360428"}}, {tmdbId:"57409", properties:{bornIn:"Veracruz, Veracruz, Mexico", imdbId:"0478886", born:date('1977-04-08'), name:"Ana de la Reguera", bio:"Ana de la Reguera grew up in the tropical state of Veracruz, on the Gulf Coast of Mexico.  She began her performance arts studies in the Cultural Institute of Veracruz, then left for Televisa's Center for Artistic Education (CEA) and TV Aztecas' artistic institute (CEFAC) in Mexico City, later taking study with Lisa Robertson and Aaron Spicer in Los Angeles and acting coach Juan 'Carlos Corzza in Spain...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5ABHVktvlIMyfLCZo2sJsOIMQCo.jpg", url:"https://themoviedb.org/person/57409"}}, {tmdbId:"57410", properties:{imdbId:"0422948", born:date('1973-12-13'), name:"Héctor Jiménez", bio:"​From Wikipedia, the free encyclopedia. \n\nHéctor Jiménez  (born December 13, 1973) is a Mexican actor best known for playing Esqueleto, Nacho's tag team partner in the movie Nacho Libre.  He is also Mr.  Tumnus in Epic Movie and the cashier in Wild Hogs.  He worked in a theater company in Tijuana for eight years before moving to Mexico City where he worked for a Swiss company, a clown theater.  In 2007 he was nominated in the MTV Movie Awards for Best Fight Scene with Jack Black and the Los Duendes...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8eNizTOeHjpjMiTJziLgdlf09wO.jpg", url:"https://themoviedb.org/person/57410"}}, {tmdbId:"57411", properties:{imdbId:"1377265", name:"Darius Rose", url:"https://themoviedb.org/person/57411"}}, {tmdbId:"6978", properties:{imdbId:"0242319", name:"Jim Dunk", url:"https://themoviedb.org/person/6978"}}, {tmdbId:"42663", properties:{bornIn:"Accra, Gold Coast, Ghana", imdbId:"0061106", born:date('1957-02-22'), name:"Robert Bathurst", bio:"From Wikipedia, the free encyclopedia. \n\nRobert Guy Bathurst (born 22 February 1957) is an English actor.  Bathurst was born in the Gold Coast in 1957, where his father was working as a management consultant.  His family moved to Dublin, Ireland, in 1959 and Bathurst was enrolled at an Anglican boarding school.  In 1966, the family moved to England, and Bathurst transferred to another boarding school, where he took up amateur dramatics...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mOKxDA9v6yYsGnoMkULmKRxRqgh.jpg", url:"https://themoviedb.org/person/42663"}}, {tmdbId:"6969", properties:{bornIn:"London, England, UK", imdbId:"1052141", born:date('1963-01-01'), name:"Geoff Bell", bio:"From Wikipedia, the free encyclopedia\n\nGeoff Bell (born 1963) is an English actor. \n\nDescription above from the Wikipedia article Geoff Bell (actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q9vQN6JJxAQLtR8E6s8ehkPAzto.jpg", url:"https://themoviedb.org/person/6969"}}, {tmdbId:"6970", properties:{bornIn:"London, England, UK", imdbId:"0298089", name:"Christopher Fulford", bio:"From Wikipedia, the free encyclopedia\n\nChristopher Fulford (born 1955 in London) is a British actor who is best known for his supporting roles in many British TV shows. \n\nIn his early career he often appeared in British crime dramas.  He was guest star of both the ITV crime series Inspector Morse, as a suspect in Driven to Destruction (1990)  and as a killer in the early A Touch of Frost episode Widows and Orphans (1994)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2n73aEyiU4fJprC2vHIf0M7YJ62.jpg", url:"https://themoviedb.org/person/6970"}}, {tmdbId:"1441482", properties:{imdbId:"2196217", name:"Neeral Mulchandani", url:"https://themoviedb.org/person/1441482"}}, {tmdbId:"1255585", properties:{name:"Tanya Sharma", url:"https://themoviedb.org/person/1255585"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"16775", properties:{imdbId:"0405396", born:date('1968-08-23'), name:"Janne Hyytiäinen", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AnM4cw1RntFvCVLzDr0MHE8Xdmt.jpg", url:"https://themoviedb.org/person/16775"}}, {tmdbId:"16777", properties:{imdbId:"0433519", born:date('1975-06-14'), name:"Maria Järvenhelmi", url:"https://themoviedb.org/person/16777"}}, {tmdbId:"16776", properties:{bornIn:"Kuopio, Finland", imdbId:"0374685", born:date('1970-08-21'), name:"Maria Heiskanen", bio:"From Wikipedia, the free encyclopedia. \n\nMaria Heiskanen (born 1970) is a Finnish actress.  She works in cinema, television and theatre. \n\nHeiskanen received her breakthrough role in the 1991 Swedish film Il Capitano: A Swedish Requiem directed by Jan Troell.  For her role Heiskanen won the Gold Plaque Award in Chicago International Film Festival for the Best Actress in 1992.  Heiskanen lived in Sweden during 1993 - 2003 and worked in movies and theatre...", url:"https://themoviedb.org/person/16776"}}, {tmdbId:"16778", properties:{bornIn:"Ranua, Finland", imdbId:"0463568", born:date('1966-03-16'), name:"Ilkka Koivula", url:"https://themoviedb.org/person/16778"}}, {tmdbId:"39459", properties:{bornIn:"London, England", imdbId:"2017943", born:date('1982-04-05'), name:"Hayley Atwell", bio:"Hayley Elizabeth Atwell is a British-American actress.  She is known for her work in stage productions, such as A View from the Bridge, and onscreen, for period pieces, such as the 2008 drama The Duchess...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l2qU8PUX0z949O7L669UUxekQbQ.jpg", url:"https://themoviedb.org/person/39459"}}, {tmdbId:"60898", properties:{bornIn:"Constanta, Romania", imdbId:"1659221", born:date('1982-08-13'), name:"Sebastian Stan", bio:"Sebastian Stan (born August 13, 1982) is a Romanian American actor, known for his role as James Buchanan \"Bucky\" Barnes/Winter Soldier in the Marvel Cinematic Universe.  He also appeared in the 2010 film Black Swan.  On television, Stan portrayed Carter Baizen on Gossip Girl, Prince Jack Benjamin on Kings, Jefferson on Once Upon a Time, and T. J.  Hammond on the miniseries Political Animals...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/g0iWJKxhseovpNKTh7cAIqkNCGW.jpg", url:"https://themoviedb.org/person/60898"}}, {tmdbId:"82092", properties:{bornIn:"Los Angeles, California, USA", imdbId:"1443238", born:date('1975-03-15'), name:"Will.i.am", bio:"William James Adams Jr. , (born March 15, 1975), better known by his stage name will. i. am (will-i-am) and occasionally by his other stage name Zuper Blahq, is an American rapper, musician, songwriter, singer, actor and producer.  will. i. am came to prominence in the 1990s as a member of the hip hop group The Black Eyed Peas along with rappers apl. de. ap and Taboo and, later, singer Fergie...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uQgowLkEJyB5oBm34sqSKTPcZwv.jpg", url:"https://themoviedb.org/person/82092"}}, {tmdbId:"73525", properties:{bornIn:"Enfield, Middlesex, England, UK", imdbId:"0752740", born:date('1984-04-22'), name:"Michelle Ryan", bio:"Michelle Claire Ryan (born 22 April 1984) is an English actress. She is known for portraying the role of Zoe Slater on the BBC soap opera EastEnders.  In 2007, she starred in the short lived revival of the American television series Bionic Woman.  She has appeared as the wicked sorceress Nimueh in the 2008 BBC TV series Merlin, and as Lady Christina de Souza in the 2009 episode of Doctor Who...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/12PceCPn9pIHhdRGyx3PWj4xJbu.jpg", url:"https://themoviedb.org/person/73525"}}, {tmdbId:"73530", properties:{imdbId:"2931729", name:"Erica Ellis", url:"https://themoviedb.org/person/73530"}}, {tmdbId:"1531173", properties:{name:"Jay Bowen", url:"https://themoviedb.org/person/1531173"}}, {tmdbId:"49001", properties:{bornIn:"Ottawa, Ontario, Canada", imdbId:"0149950", born:date('1976-08-27'), name:"Sarah Chalke", bio:"Sarah Chalke (born August 27, 1976) is a Canadian actress known for portraying Dr.  Elliot Reid on the NBC/ABC comedy Scrubs, \"Second Becky\" Conner Healy on Roseanne, and Stella Zinman in the CBS sitcom How I Met Your Mother.  She is currently starring in the CBS sitcom Mad Love. \n\nDescription above from the Wikipedia article Sarah Chalke, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ycwiu89cpjqCtSNC5FjbJggjj5R.jpg", url:"https://themoviedb.org/person/49001"}}, {tmdbId:"116996", properties:{imdbId:"0046152", name:"Jean Badin", url:"https://themoviedb.org/person/116996"}}, {tmdbId:"57461", properties:{bornIn:"Penang, Malaysia", imdbId:"0750971", born:date('1961-01-12'), name:"Simon Russell Beale", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lQKqNjsjgQoVjtARuuPRgilQBm0.jpg", url:"https://themoviedb.org/person/57461"}}, {tmdbId:"1516913", properties:{imdbId:"2343227", name:"Clare Crowhurst", url:"https://themoviedb.org/person/1516913"}}, {tmdbId:"1516912", properties:{imdbId:"2346765", name:"Donald Crowhurst", url:"https://themoviedb.org/person/1516912"}}, {tmdbId:"77289", properties:{bornIn:"Bucharest, Romania", imdbId:"1942458", born:date('1997-03-21'), name:"Catinca Untaru", url:"https://themoviedb.org/person/77289"}}, {tmdbId:"77290", properties:{imdbId:"2440242", name:"Kim Uylenbroek", url:"https://themoviedb.org/person/77290"}}, {tmdbId:"10743", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0419633", born:date('1946-06-26'), name:"Ricky Jay", bio:"Ricky Jay (born Richard Jay Potash) was an actor, magician, cardsharp, and film consultant.  Ricky's love and deep study of card tricks and deception gained him worldwide fame and respect, and he was often called in to consult for movies and TV shows where deception was a key element of the story...", died:date('2018-11-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xtJvNUSwIOKZ4Z4SDOYjPhvdtIN.jpg", url:"https://themoviedb.org/person/10743"}}, {tmdbId:"90760", properties:{bornIn:"Warsaw, Poland", imdbId:"0344734", born:date('1980-07-13'), name:"Karolina Gruszka", url:"https://themoviedb.org/person/90760"}}, {tmdbId:"15497", properties:{bornIn:" Adamstown, County Wexford, Ireland", imdbId:"2073546", born:date('1977-11-06'), name:"Padraic Delaney", bio:"​From Wikipedia, the free encyclopedia\n\nPádraic Delaney (born 6 November 1977) is an Irish actor best known for playing Teddy O'Donovan in the Ken Loach film The Wind That Shakes the Barley, for which he earned an IFTA nomination as well as being named Irish Shooting Star for the 2007 Berlin Film Festival...", url:"https://themoviedb.org/person/15497"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"15509", properties:{imdbId:"1695893", name:"Orla Fitzgerald", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1GlqOJOaiQqwTwvTSjALFuNoiKY.jpg", url:"https://themoviedb.org/person/15509"}}, {tmdbId:"21430", properties:{bornIn:"Oslo, Norway", imdbId:"0853573", born:date('1974-01-19'), name:"Natassia Malthe", bio:"Natassia is the younger of two daughters.  She was born in Norway but is half Filipino.  She is usually credited by her birth name however is sometime credited as 'Lina Teal'.  In Canada, Scotland, and Norway, Malthe went to dance schools at the Royal Winnipeg Ballet, the Goh Ballet Academy, and the Norwegian Opera House respectively, where she sang and danced while finishing high school.  Later she moved to London, England to study musical theater...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qnc226IJfaE2cplj2pMSS6g9e3B.jpg", url:"https://themoviedb.org/person/21430"}}, {tmdbId:"12111", properties:{bornIn:"Memphis, Tennessee, USA", imdbId:"0005493", born:date('1981-01-31'), name:"Justin Timberlake", bio:"Justin Randall Timberlake (born January 31, 1981) is an American pop singer and actor.  He has won ten Grammy Awards as well as four Emmy Awards.  He achieved early fame when he appeared as a contestant on Star Search, and went on to star in the Disney Channel television series The New Mickey Mouse Club, where he met future bandmate JC Chasez.  Timberlake became famous in the late 1990s as the lead singer of the boy band NSYNC, whose launch was financed by Lou Pearlman...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6Yk5t9RwkdkAT8Qv45934Eez2CA.jpg", url:"https://themoviedb.org/person/12111"}}, {tmdbId:"16662", properties:{bornIn:" San Francisco, California, USA", imdbId:"0304579", born:date('1944-03-10'), name:"Richard Gant", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/25vUWxrUY7hjLdAeNaJYkvaMKcW.jpg", url:"https://themoviedb.org/person/16662"}}, {tmdbId:"20494", properties:{bornIn:"Waiheke Island, New Zealand", imdbId:"1057928", born:date('1978-11-17'), name:"Zoë Bell", bio:"From Wikipedia, the free encyclopedia. \n\nZoë E.  Bell (born 17 November 1978) is a stuntwoman and actress from New Zealand.  Some of her most notable stunt work includes doubling for Lucy Lawless on Xena: Warrior Princess and for Uma Thurman in Kill Bill.  As an actress, she has appeared both on television and in feature films and also starred in the web series Angel of Death.  She is probably most recognized for playing herself in the Quentin Tarantino film, Death Proof...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fDckmfcIrrdcOgyGifVF2FvQtiE.jpg", url:"https://themoviedb.org/person/20494"}}, {tmdbId:"20491", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"1089685", born:date('1980-12-28'), name:"Vanessa Ferlito", bio:"Vanessa Ferlito (born December 28, 1980) is an American actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i128WKjZ3JkoJBOLw48hF4Uwu5V.jpg", url:"https://themoviedb.org/person/20491"}}, {tmdbId:"54738", properties:{bornIn:"London, England, UK", imdbId:"1658935", born:date('1982-12-07'), name:"Jack Huston", bio:"From Wikipedia, the free encyclopedia\n\nJack Alexander Huston (born 7 December 1982) is an English actor.  Huston had a starring role in \"Neighborhood Watch\" and recently filmed Outlander (2008) with James Caviezel and Sophia Myles.  He appeared in the third film in the Twilight series, Eclipse, where he played Royce King II. \n\nHuston currently appears in HBO's Boardwalk Empire as Richard Harrow, a heavily scarred World War I marksman turned gangster...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i0Fxf1WQNzFHZO1Yk42UJxgy1rI.jpg", url:"https://themoviedb.org/person/54738"}}, {tmdbId:"81577", properties:{imdbId:"1966818", name:"Jason Yachanin", bio:"​From Wikipedia, the free encyclopedia.   \n\nJason Yachanin is an American actor most famous for playing Arbie in the comedy horror film Poultrygeist: Night of the Chicken Dead.  He also appeared in the film Friends (With Benefits), in which he plays Jason. \n\nDescription above from the Wikipedia article Jason Yachanin  licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/81577"}}, {tmdbId:"81578", properties:{imdbId:"1985800", name:"Kate Graham", url:"https://themoviedb.org/person/81578"}}, {tmdbId:"81579", properties:{bornIn:"Baltimore, Maryland, USA", imdbId:"1968388", born:date('1977-08-05'), name:"Allyson Sereboff", bio:"Allyson Sereboff is an American film and television actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4hrCgj3MKV1Eih8JXXzc4mRRyHj.jpg", url:"https://themoviedb.org/person/81579"}}, {tmdbId:"84274", properties:{imdbId:"2066036", name:"Robin L. Watkins", url:"https://themoviedb.org/person/84274"}}, {tmdbId:"95047", properties:{bornIn:"Glasgow, Scotland", imdbId:"0574615", born:date('1961-01-04'), name:"Graham McTavish", bio:"From Wikipedia, the free encyclopedia. \n\nGraham McTavish (born 1961) is a Scottish television actor. \n\nHe has played the character Warden Ackerman in Red Dwarf in five episodes of series 8.  McTavish has also had many supporting roles in British dramas and films such as Casualty, Jekyll, The Bill, Taggart and Sisterhood...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9IjPwv7Vb4QygA1cPSX179oqjsT.jpg", url:"https://themoviedb.org/person/95047"}}, {tmdbId:"18271", properties:{bornIn:"Marshalltown, Iowa, U.S.", imdbId:"0403947", born:date('1966-12-09'), name:"Toby Huss", bio:"Toby Edward Huss (born December 9, 1966) is an American actor.  He is best known for portraying Artie, the Strongest Man in the World on the cult hit Nickelodeon TV series The Adventures of Pete &amp; Pete, for his voice-over work on the long running animated series King of the Hill, and for his role as Felix 'Stumpy' Dreifuss on HBO's Carnivàle. \n\nHuss was born in Marshalltown, Iowa...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5G5qW92hB4Uu15R2PlTN45WD4Bj.jpg", url:"https://themoviedb.org/person/18271"}}, {tmdbId:"200", properties:{bornIn:" Dayton, Ohio, USA", imdbId:"0004813", born:date('1957-10-25'), name:"Nancy Cartwright", bio:"Nancy Campbell Cartwright (born October 25, 1957) is an American film and television actress, comedian and voice artist.  She is best known for her long-running role as Bart Simpson on The Simpsons.  Cartwright voices additional characters for the show...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/40qNhyYJhSE2Yiy4pnXSZhdufO6.jpg", url:"https://themoviedb.org/person/200"}}, {tmdbId:"96429", properties:{bornIn:"Balvanera, Buenos Aires, Argentina", imdbId:"0673391", born:date('1963-02-25'), name:"Diego Peretti", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4Uq50GociCxPEDXorBIYfzSqpLq.jpg", url:"https://themoviedb.org/person/96429"}}, {tmdbId:"103431", properties:{bornIn:"Buenos Aires, Argentina", imdbId:"0527045", born:date('1956-06-12'), name:"Luis Luque", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aj2TUHR1jdIQLvwt7iorMLbGj6k.jpg", url:"https://themoviedb.org/person/103431"}}, {tmdbId:"591423", properties:{imdbId:"0274467", name:"Óscar Ferreiro", url:"https://themoviedb.org/person/591423"}}, {tmdbId:"591424", properties:{imdbId:"1496225", name:"Gabriela Iscovich", url:"https://themoviedb.org/person/591424"}}, {tmdbId:"20381", properties:{bornIn:"Hartford - Connecticut - USA", imdbId:"1564087", born:date('1980-12-03'), name:"Jenna Dewan Tatum", bio:"From Wikipedia, the free encyclopedia\n\nJenna Lee Dewan-Tatum (née Dewan; born December 3, 1980) is an American actress and dancer.  She began her career as a background dancer for artists including Missy Elliott, Janet Jackson, and Christina Aguilera.  She is best known for her role as Nora in the film Step Up.  She has also appeared in the short-lived NBC series The Playboy Club and had a recurring role on the FX series American Horror Story: Asylum...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ltrHvbX44IQZyZ2qnuxOWsCXXDK.jpg", url:"https://themoviedb.org/person/20381"}}, {tmdbId:"58959", properties:{bornIn:"The Bronx, New York City, New York, United States", imdbId:"1690482", born:date('1979-06-07'), name:"Damaine Radcliff", bio:"From Wikipedia, the free encyclopedia. \n\nDamaine Anthony Radcliff, more commonly known as Damaine Radcliff, is an American film actor who was born in The Bronx, New York City.  He is possibly most known for his roles in the movies Glory Road, Step Up and his parodies on his YouTube Channel...", url:"https://themoviedb.org/person/58959"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"58960", properties:{imdbId:"2026113", name:"De'Shawn Washington", url:"https://themoviedb.org/person/58960"}}, {tmdbId:"60390", properties:{imdbId:"0546197", name:"Trula M. Marcus", url:"https://themoviedb.org/person/60390"}}, {tmdbId:"52477", properties:{bornIn:"Aurora, Colorado, USA", imdbId:"0117022", born:date('1981-10-09'), name:"Zachery Ty Bryan", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3NSkphwYVSBX1C8bwEBF7cFWmq3.jpg", url:"https://themoviedb.org/person/52477"}}, {tmdbId:"55465", properties:{bornIn:"England, UK", imdbId:"1556238", name:"Samuel Anderson", bio:"From Wikipedia, the free encyclopedia\n\nSamuel Anderson (born 1982) is an English actor.  He played the role of police officer Ross Kirk in Emmerdale up until early 2009. \n\nHe originated the role of Crowther in the 2004 National Theatre production of Alan Bennett's play The History Boys and subsequently performed the same role in the Broadway, Sydney, Wellington and Hong Kong productions and radio and film versions...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/155QL3ZdGm6NseuA2bMnAXyB6hZ.jpg", url:"https://themoviedb.org/person/55465"}}, {tmdbId:"55466", properties:{bornIn:"Hillingdon, London, England, United Kingdom", imdbId:"0179479", born:date('1978-08-22'), name:"James Corden", bio:"English comedian, writer, actor, producer and TV personality.  He is co-creator and star of BBC comedy shows Gavin & Stacey and Horne & Corden, and hosts The Late Late Show with James Corden...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xGB0gfZ48M27gQjjL7inJIh1Pqj.jpg", url:"https://themoviedb.org/person/55466"}}, {tmdbId:"51902", properties:{bornIn:"Valladolid, Castilla y León, Spain", imdbId:"0147308", born:date('1968-04-22'), name:"Fernando Cayo", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sglfXHNFlzOBBLuRrbDkxghSW4H.jpg", url:"https://themoviedb.org/person/51902"}}, {tmdbId:"51903", properties:{imdbId:"2265834", name:"Roger Príncep", url:"https://themoviedb.org/person/51903"}}, {tmdbId:"36663", properties:{bornIn:"Great Britain", imdbId:"0086865", born:date('1974-01-01'), name:"Claudie Blakley", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bUy1X1ili9Goj3AQNrBD1kd7A8q.jpg", url:"https://themoviedb.org/person/36663"}}, {tmdbId:"22810", properties:{bornIn:"Leicester, Leicestershire, England, UK", imdbId:"0638762", born:date('1966-04-13'), name:"Andy Nyman", bio:"Andy Nyman is an English actor and magician. \n\nNyman first came to note with his performance as a hard nosed director in Musical! and then as Keith Whitehead in the cult film of the Martin Amis novel, Dead Babies.  He has played lead roles in Jon Avnet's Emmy award winning film Uprising (NBC) as a Polish freedom fighter and in Coney Island Baby as a gay French gun dealer.  In 2006, he played Gordon in the cult hit Severance...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9bN9RVoPWmsmV3VBI7hp4VKD9Kg.jpg", url:"https://themoviedb.org/person/22810"}}, {tmdbId:"41044", properties:{bornIn:"London, England, UK", imdbId:"1959501", born:date('1979-01-01'), name:"Babou Ceesay", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nhHcSiJc9U9JBzGJZ3QVS9jEc2b.jpg", url:"https://themoviedb.org/person/41044"}}, {tmdbId:"48406", properties:{bornIn:"Paris, France", imdbId:"0093740", born:date('1972-09-21'), name:"Olivia Bonamy", bio:"​From Wikipedia, the free encyclopedia\n\nOlivia Bonamy (born 21 September 1972) is a French actress best known for her appearances in the films Jefferson in Paris, Jacques Audiard'sRead my lips, the thriller Ils and Le ciel, les oiseaux et ta mère. \n\nDescription above from the Wikipedia article Olivia Bonamy, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cV2dPwnEFBv4sReDUxN0TpAKiYy.jpg", url:"https://themoviedb.org/person/48406"}}, {tmdbId:"125412", properties:{bornIn:"Maisons-Laffitte, France", imdbId:"0169621", born:date('1970-12-13'), name:"Michaël Cohen", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o1u4MM8Zn1erP77By8kgv10jLeO.jpg", url:"https://themoviedb.org/person/125412"}}, {tmdbId:"67030", properties:{imdbId:"0595055", name:"Adriana Mocca", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sihhbc9gYU7V6y3QFlMWGj2PLfb.jpg", url:"https://themoviedb.org/person/67030"}}, {tmdbId:"67031", properties:{imdbId:"1929223", name:"Maria Roman", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o8zergHHmbn00Rl08WvoiQJ3aKy.jpg", url:"https://themoviedb.org/person/67031"}}, {tmdbId:"31549", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0482851", born:date('1967-01-24'), name:"Phil LaMarr", bio:"Phillip \"Phil\" LaMarr (born January 24, 1967) is an American actor, comedian and voice actor.  One of the original cast members on the sketch comedy series MADtv, he is also known for his voice acting on the animated series Futurama, Static Shock, Samurai Jack, Justice League, Justice League Unlimited, Star Wars: Knights of the Old Republic II The Sith Lords, Star Wars: The Clone Wars, Metal Gear Solid 2: Sons of Liberty, Metal Gear Solid 4: Guns of the Patriots, and inFAMOUS...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l5w0qABfsFBxjfWNnpFiaXnh4Nm.jpg", url:"https://themoviedb.org/person/31549"}}, {tmdbId:"127387", properties:{bornIn:"Alliance, Ohio, U.S.", imdbId:"0523180", born:date('1971-03-05'), name:"Yuri Lowenthal", bio:"From Wikipedia, the free encyclopedia.   Yuri Lowenthal (born March 5, 1971; Alliance, Ohio) is a voice actor that has voiced several anime and video game characters.  He also voiced Kamal for the alternate reality game I Love Bees. \n\nHe is best friends with Doug Erholtz.  He is married to fellow voice actress Tara Platt.  He graduated from The College of William &amp; Mary in Williamsburg, Virginia. \n\nLowenthal co-founded Monkey Kingdom Productions with partner Tara Platt in 2004...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/68tBtkEmCUws4BAr2TQ5OIs2hIR.jpg", url:"https://themoviedb.org/person/127387"}}, {tmdbId:"154106", properties:{bornIn:"Milwaukee, Wisconsin", imdbId:"0126023", born:date('1970-10-28'), name:"Greg Eagles", bio:"Gregory D.  Eagles (born October 28, 1970) is an American actor, voice actor, writer and producer.  He is best known for voicing the Grim Reaper in Grim & Evil and its spin-off The Grim Adventures of Billy & Mandy.  He is also known for voicing Brother 6 and Rokutaro in Afro Samurai, Aku Aku in the Crash Bandicoot video game franchise, and Gray Fox in Metal Gear Solid...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hbmNTtYTxBQnMoOU6n4TeycPNGi.jpg", url:"https://themoviedb.org/person/154106"}}, {tmdbId:"38661", properties:{bornIn:"Sydney, New South Wales, Australia", imdbId:"1693309", born:date('1993-07-31'), name:"Christian Byers", bio:"Christian Byers is an Australian actor born on 31 July 1993 in Sydney, Australia.  In 2006, he made his film debut in Opal Dream, before featuring in December Boys alongside Daniel Radcliffe.  In 2007, Christian portrayed Jacob in Hey, Hey, It's Esther Blueburger.  Christian is also the lead vocalist, second guitarist and organist of the band The Slippers.  He is also participating in a Sydney-based television show,The Flip, as Maxx.  He currently attends Fort Street High School in Sydney...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yfAKKbzeEsH5Q981mQjaydO8tE6.jpg", url:"https://themoviedb.org/person/38661"}}, {tmdbId:"1394227", properties:{bornIn:" Australia", imdbId:"2094577", born:date('1993-03-01'), name:"James Fraser", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n5eMCArpoyAmj3eUcSuxCTtoX9h.jpg", url:"https://themoviedb.org/person/1394227"}}, {tmdbId:"18182", properties:{bornIn:"Berdyansk, Ukraine", imdbId:"1385871", born:date('1979-11-14'), name:"Olga Kurylenko", bio:"Olga Kurylenko, a Ukrainian-born actress and model who grew up in poverty sharing a Soviet flat with her aunt, uncle, grandparents and cousin, is now starring as Bond girl opposite Daniel Craig.   She was born Olga Konstantinovna Kurylenko on November 14, 1979, in Berdyansk, Ukraine, Soviet Union.  Her mother, Marina Alyabysheva, divorced her father, Konstantin Kurylenko, soon after her birth.  After the divorce, her mother struggled to survive as an art teacher...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zkOOwEzs0VhbK7t4PhqEZALEWeE.jpg", url:"https://themoviedb.org/person/18182"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"17343", properties:{bornIn:"Fremont, Ohio, USA", imdbId:"0460694", born:date('1959-07-08'), name:"Robert Knepper", bio:"Robert Lyle Knepper (born July 8, 1959) is an American actor.  He is best known for starring as Theodore \"T-Bag\" Bagwell in the Fox network's drama series, Prison Break, for which he was nominated for a Satellite Award.  He has also appeared in the films Hitman (2007) and Transporter 3 (2008), and joined the cast of Heroes for its fourth season.  Most recently, he joined the cast of Stargate Universe for its second season, which has started airing in the US in the 2010 fall season...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w40AttR4OPQvjYyTVanq5Rm5iOb.jpg", url:"https://themoviedb.org/person/17343"}}, {tmdbId:"76490", properties:{bornIn:"Gorleston, Norfolk, England", imdbId:"0458325", born:date('1978-04-06'), name:"Myleene Klass", bio:"From Wikipedia, the free encyclopedia. \n\nMyleene Angela Klass (born 6 April 1978) is an English singer, model, occasional actress, pianist, fashion designer, presenter, classical music DJ and media personality.  She was formerly a member of the defunct British pop band Hear'Say...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bELhmJFkUlAsvKbX4MLmnIw0j6t.jpg", url:"https://themoviedb.org/person/76490"}}, {tmdbId:"76491", properties:{imdbId:"0397577", name:"Robin Walsh", url:"https://themoviedb.org/person/76491"}}, {tmdbId:"76492", properties:{imdbId:"1766778", name:"Matt McKenna", url:"https://themoviedb.org/person/76492"}}, {tmdbId:"209730", properties:{imdbId:"2796342", name:"Danielle Skraastad", url:"https://themoviedb.org/person/209730"}}, {tmdbId:"8947", properties:{bornIn:"Liverpool, England", imdbId:"0313702", born:date('1937-08-08'), name:"Tom Georgeson", bio:"Liverpudlian actor Tom Georgeson is best known for his roles in several groundbreaking TV dramas including Between the Lines and  Boys from the Blackstuff, Scully and G. B. H.  - the last three all penned by Alan Bleasdale.  For film fans he is perhaps best remembered for his role as crook George Thomason (a play on his own name) in John Cleese and Charles Crichton's 1988 comedy smash A Fish Called Wanda...", url:"https://themoviedb.org/person/8947"}}, {tmdbId:"17483", properties:{imdbId:"0540585", born:date('1957-06-19'), name:"Michael Maloney", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sE5K1f3TW1foDTT6yrGaeW4grun.jpg", url:"https://themoviedb.org/person/17483"}}, {tmdbId:"74539", properties:{bornIn:"Nashville, Tennessee, USA", imdbId:"1225406", born:date('1996-09-12'), name:"Colin Ford", bio:"Colin Ford (born September 12, 1996) is an American child actor and voice actor.  He is best known for his role as Jackson Patch in Dog Days of Summer and as young Sam Winchester in the 2005 TV Series, Supernatural.  He has also been in American Family...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AquXBhH1jXdObhU1Fw3ecITEBVW.jpg", url:"https://themoviedb.org/person/74539"}}, {tmdbId:"25376", properties:{bornIn:"St. Cloud - Minnesota - USA", imdbId:"0340408", born:date('1963-12-20'), name:"Joel Gretsch", bio:"​From Wikipedia, the free encyclopedia. \n\nJoel James Gretsch (height 5' 10\" (1,78 m) born December 20, 1963) is an American actor.  His roles include Tom Baldwin on the USA Network series The 4400, Capt. /Maj. /Col.  Owen Crawford in the Steven Spielberg produced 2002 sci-fi miniseries Taken and Father Jack Landry on V...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8sTiI294vfMpli7hBEi8bDAVZ1t.jpg", url:"https://themoviedb.org/person/25376"}}, {tmdbId:"230", properties:{bornIn:" Antigonish, Nova Scotia, Canada", imdbId:"0570385", born:date('1947-02-03'), name:"Stephen McHattie", bio:"Stephen McHattie is a Canadian stage, film and television actor.  He's a graduate of the American Academy of Dramatic Arts, Manhattan, New York, USA...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zqOwiEDXYM9AKQgHGJGeIp7QkPh.jpg", url:"https://themoviedb.org/person/230"}}, {tmdbId:"11678", properties:{bornIn:"Seattle, Washington, USA", imdbId:"0933988", born:date('1966-01-20'), name:"Rainn Wilson", bio:"Rainn Dietrich Wilson (born January 20, 1966) is an American actor and comedian.  He is primarily known for his role as the egomaniacal Dwight Schrute on the American version of the television comedy The Office.  He has also directed two episodes of The Office: the sixth season's \"The Cover-Up\" and the seventh season's \"Classy Christmas\". \n\nDescription above from the Wikipedia article Rainn Wilson, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lmy5NQsrTlbsyTrQw30gsKCZbWm.jpg", url:"https://themoviedb.org/person/11678"}}, {tmdbId:"58952", properties:{bornIn:"Bath, England, U.K.", imdbId:"1623511", born:date('1980-11-07'), name:"Adam Campbell", bio:"From Wikipedia, the free encyclopedia. \n\nAdam Campbell (born 7 November 1980) is an English actor.  Among his credits are roles in the American film parodies Date Movie, Epic Movie, and portrayed Cal Vandeusen in the horror miniseries Harper's Island...", url:"https://themoviedb.org/person/58952"}}, {tmdbId:"52854", properties:{bornIn:"England, UK", imdbId:"0598241", born:date('1979-12-14'), name:"Sophie Monk", bio:"Sophie Charlene Akland Monk (born 14 December 1979) is an Australian pop singer, actress and model.  Monk, who was born in England, was once a member of female pop group Bardot and has since released a solo album, Calendar Girl.  She appeared in films such as Date Movie and Click. \n\nDescription above from the Wikipedia article Sophie Monk licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/agJoSOjmtw8wfSTNQarQwWwKuon.jpg", url:"https://themoviedb.org/person/52854"}}, {tmdbId:"109459", properties:{imdbId:"1959110", name:"J. Andrew Keitch", url:"https://themoviedb.org/person/109459"}}, {tmdbId:"109460", properties:{imdbId:"2027060", name:"Joan Lauckner", url:"https://themoviedb.org/person/109460"}}, {tmdbId:"109461", properties:{imdbId:"0358508", name:"Tim Hammer", url:"https://themoviedb.org/person/109461"}}, {tmdbId:"109462", properties:{imdbId:"1533716", name:"Nils Haaland", url:"https://themoviedb.org/person/109462"}}, {tmdbId:"36592", properties:{bornIn:"The Bronx, New York, USA", imdbId:"1519680", born:date('1994-04-12'), name:"Saoirse Ronan", bio:"Saoirse Una Ronan (born 12 April 1994) is an Irish and American actress.  She is a four-time Academy Award nominee; receiving a Best Supporting Actress nomination for Atonement (2007), and Best Actress nominations for Brooklyn (2015), Lady Bird (2017), and Little Women (2019)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wTTvT0GeVjzyUQG9ydX7XaAZKNr.jpg", url:"https://themoviedb.org/person/36592"}}, {tmdbId:"124377", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0075588", born:date('1949-11-01'), name:"Jeannie Berlin", bio:"Jeannie Berlin (born Jeannie Brette May; November 1, 1949) is an American actress and screenwriter. \n\nShe is best known for her role in the 1972 film The Heartbreak Kid, directed by her mother Elaine May, for which she received Academy Award and Golden Globe nominations...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sT1o2nVecNUgysnHV7g6KYTciXb.jpg", url:"https://themoviedb.org/person/124377"}}, {tmdbId:"12044", properties:{bornIn:"Belgrade, Serbia, Yugoslavia", imdbId:"0084759", born:date('1962-06-30'), name:"Predrag Bjelac", bio:"Predrag Bjelac is a Serbian actor.  He is a graduate of the Belgrade University's Faculty of Dramatic Arts (FDU), class of 1986, and studied at The Lee Strasberg Theatre Institute (1988) in New York City.  He currently resides in the Czech Republic with his wife and daughters Una and Tara...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lkEIazzU1b8dDGMqdtYMXf2hHFV.jpg", url:"https://themoviedb.org/person/12044"}}] AS 