UNWIND [{tmdbId:"1044098", properties:{imdbId:"0421541", name:"Kandeyce Jorden", url:"https://themoviedb.org/person/1044098"}}, {tmdbId:"194698", properties:{bornIn:"New York City, New York, USA", imdbId:"0892474", born:date('2018-05-01'), name:"Martha Velez", url:"https://themoviedb.org/person/194698"}}, {tmdbId:"27763", properties:{bornIn:"Milton, Florida, USA", imdbId:"0000680", born:date('1968-12-18'), name:"Casper Van Dien", bio:"An American actor, best known for his role as Johnny Rico in “Starship Troopers...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4BYmpBDA0XFMF4PMokLdZ87Qntk.jpg", url:"https://themoviedb.org/person/27763"}}, {tmdbId:"9205", properties:{bornIn:"Downers Grove, Illinois, USA", imdbId:"0000612", born:date('1971-02-17'), name:"Denise Richards", bio:"Denise Lee Richards is an American actress, former fashion model, and television personality.  Her most recognized roles are Carmen Ibanez in Starship Troopers (1997), Kelly Van Ryan in Wild Things (1998) and Bond girl Christmas Jones in The World Is Not Enough (1999). \n\nDenise Lee Richards was born to Joni, a coffee shop owner and Irv Richards, a telephone engineer, in Downers Grove, Illinois.  Her mother died of kidney cancer in November 2007...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dIeiBG2LZFPAU44WkatoTVG4nn5.jpg", url:"https://themoviedb.org/person/9205"}}, {tmdbId:"112099", properties:{bornIn:"Chicago, Illinois, U.S.", imdbId:"0712675", born:date('1933-12-01'), name:"Lou Rawls", bio:"Louis Allen Rawls was an American singer, songwriter, actor, voice actor, and record producer.  Rawls released more than 60 albums, sold more than 40 million records,[2] and had numerous charting singles, most notably his song \"You'll Never Find Another Love like Mine\".  He worked as a film, television, and voice actor.  He was also a three-time Grammy-winner, all for Best Male R&B Vocal Performance...", died:date('2006-01-06'), url:"https://themoviedb.org/person/112099"}}, {tmdbId:"99856", properties:{imdbId:"0483315", name:"Steven Lambert", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pqCxvgAUpOhgbz9FRgBcyNXJZ46.jpg", url:"https://themoviedb.org/person/99856"}}, {tmdbId:"73913", properties:{bornIn:"Paddington, London, England, UK", imdbId:"0386882", born:date('1953-03-03'), name:"Robyn Hitchcock", bio:"From Wikipedia, the free encyclopedia. \n\nRobyn Rowan Hitchcock (born 3 March 1953) is an English singer-songwriter and guitarist.  While primarily a vocalist and guitarist, he also plays harmonica, piano and bass guitar. \n\nComing to prominence in the late 1970s with The Soft Boys, Hitchcock afterward launched a prolific solo career.  Hitchcock's musical and lyrical styles have been influenced by the likes of Bob Dylan, John Lennon and Syd Barrett...", url:"https://themoviedb.org/person/73913"}}, {tmdbId:"21130", properties:{bornIn:"Pittsburgh, Pennsylvania, United States of America", imdbId:"0058983", born:date('1974-02-26'), name:"Jayce Bartok", bio:"​From Wikipedia, the free encyclopedia\n\nJayce Bartok (born February 26, 1974) is an American actor.  A young leading man with TV and film experience, Bartok had his best chance to date as Pony, the rock star who returns to his home town where his pals are waiting in Richard Linklater's subUrbia (1997).  He wrote, directed and produced the short film Stricken in 2005. \n\nDescription above from the Wikipedia article Jayce Bartok , licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/21130"}}, {tmdbId:"99513", properties:{imdbId:"0004803", name:"Amie Carey", url:"https://themoviedb.org/person/99513"}}, {tmdbId:"18070", properties:{bornIn:"South Dakota, USA", imdbId:"0441588", born:date('1970-05-11'), name:"Nicky Katt", bio:"Nicholas Lea \"Nicky\" Katt  (born May 11, 1970 in North Dakota) is an American actor known for his role as unorthodox teacher Harry Senate on David E.  Kelley's Fox drama Boston Public...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4IPdDqsSsDWmv2Uep5skdykJYij.jpg", url:"https://themoviedb.org/person/18070"}}, {tmdbId:"1982", properties:{bornIn:"Evanston, Illinois, USA", imdbId:"0619651", born:date('1972-02-12'), name:"Ajay Naidu", bio:"Ajay Kalahastri Naidu (born 12 February 1972) is an American actor. \n\nNaidu was born in Evanston, Illinois and raised in Chicago, the son of Indian immigrants from Chittor District, Andhra Pradesh to the U. S.  He attended Evanston Township High School.  As an actor, he trained with the American Repertory Theater's Institute for Advanced Theatre Training at Harvard University...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tOvD8yveJ4Aq10LICADK3wS3dwE.jpg", url:"https://themoviedb.org/person/1982"}}, {tmdbId:"216040", properties:{bornIn:"Bristol, England, UK", imdbId:"0914786", name:"Mark Watson", url:"https://themoviedb.org/person/216040"}}, {tmdbId:"42133", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0797151", born:date('1970-07-14'), name:"Nina Siemaszko", bio:"Nina Siemaszko (born July 14, 1970) is an American film and television actress. \n\nDescription above from the Wikipedia article Nina Siemaszko, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aXEBJst8pDU662tkrnJ1XZb4uUi.jpg", url:"https://themoviedb.org/person/42133"}}, {tmdbId:"213388", properties:{imdbId:"0052113", name:"Caerthan Banks", url:"https://themoviedb.org/person/213388"}}, {tmdbId:"64712", properties:{bornIn:"Winnipeg, Manitoba, Canada", imdbId:"0564805", born:date('1955-07-25'), name:"Tom McCamus", bio:"Tom McCamus is a Canadian stage, film and television actor, best known for his work as the villainous Mason Eckhart on the science-fiction television series \"Mutant X\", for his award winning performances in the feature films \"I Love a Man in Uniform\" and \"Waking Up Walter: The Walter Gretzky Story\", and for his supporting role in the Academy Award nominated drama \"Room\".  He holds a BFA in Theatre from the University of Windsor, Ontario, Canada...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rdKdNQedH350kWxwH2vbP8CFdsi.jpg", url:"https://themoviedb.org/person/64712"}}, {tmdbId:"111784", properties:{imdbId:"0635070", name:"Lars Nordh", url:"https://themoviedb.org/person/111784"}}, {tmdbId:"111785", properties:{imdbId:"0489281", name:"Stefan Larsson", url:"https://themoviedb.org/person/111785"}}, {tmdbId:"111786", properties:{bornIn:"Kristianstad, Skåne län, Sweden", imdbId:"0138061", born:date('1948-01-01'), name:"Bengt C.W. Carlsson", url:"https://themoviedb.org/person/111786"}}, {tmdbId:"111787", properties:{imdbId:"0265229", name:"Torbjörn Fahlström", url:"https://themoviedb.org/person/111787"}}, {tmdbId:"117528", properties:{bornIn:"Isfahan, Iran", imdbId:"0259831", born:date('1947-03-26'), name:"Homayoun Ershadi", bio:"Homayoun Ershadi (sometimes spelled Homayon Ershadi), is an Iranian actor.  Ershadi was born in Isfahan, Iran in 1947.  He studied architecture in Italy and worked in that field.  Acclaimed Iranian New Wave director Abbas Kiarostami chose him to play the leading role in Taste of Cherry...", url:"https://themoviedb.org/person/117528"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"117529", properties:{imdbId:"0046667", name:"Abdolrahman Bagheri", url:"https://themoviedb.org/person/117529"}}, {tmdbId:"117530", properties:{imdbId:"0049086", name:"Afshin Khorshid Bakhtiari", url:"https://themoviedb.org/person/117530"}}, {tmdbId:"117531", properties:{imdbId:"0602392", name:"Safar Ali Moradi", url:"https://themoviedb.org/person/117531"}}, {tmdbId:"230213", properties:{born:date('1950-05-14'), name:"Miguel Ángel Solá", bio:"​From Wikipedia, the free encyclopedia\n\nMiguel Ángel Solá (born May 14, 1950) is a prolific Argentine actor who has made over 60 film appearances in film and TV in Argentina since 1973. \n\nSolá belongs to the Vehil's dinasty of actors, eight generations of actors originally from Catalonia.  His mother was Paquita Vehil and his aunt the legendary Luisa Vehil.  His sister Mónica is also an actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sBzPcRGEwButkuqUexc9mOIjJ55.jpg", url:"https://themoviedb.org/person/230213"}}, {tmdbId:"1395095", properties:{imdbId:"0621507", name:"Cecilia Narova", url:"https://themoviedb.org/person/1395095"}}, {tmdbId:"6859", properties:{bornIn:"Buenos Aires, Argentina", imdbId:"0535502", born:date('1978-06-19'), name:"Mía Maestro", bio:"From Wikipedia, the free encyclopedia\n\nMía Maestro (born June 19, 1978) is an Argentine actress and singer.  She is best known for her role as Nadia Santos in the television drama Alias, and as Christina Kahlo in Frida. \n\nDescription above from the Wikipedia article Mía Maestro, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qRbV2yIrviokWENK7yhzNGGiWrr.jpg", url:"https://themoviedb.org/person/6859"}}, {tmdbId:"1395096", properties:{imdbId:"0178690", name:"Juan Carlos Copes", url:"https://themoviedb.org/person/1395096"}}, {tmdbId:"147015", properties:{imdbId:"0560871", name:"Morgane Maugran", url:"https://themoviedb.org/person/147015"}}, {tmdbId:"1145352", properties:{imdbId:"0537611", name:"Géraldine Maillet", url:"https://themoviedb.org/person/1145352"}}, {tmdbId:"1390470", properties:{imdbId:"0575325", name:"Katerina Mechera", url:"https://themoviedb.org/person/1390470"}}, {tmdbId:"59449", properties:{bornIn:"Rockville, Maryland, USA", imdbId:"0005191", born:date('1964-06-12'), name:"Paula Marshall", bio:"Paula Marshall  (born June 12, 1964) is an American actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rBmk7DDOYHempHWrPnijRvPDFaW.jpg", url:"https://themoviedb.org/person/59449"}}, {tmdbId:"203677", properties:{name:"Evan Adams", url:"https://themoviedb.org/person/203677"}}, {tmdbId:"15011", properties:{bornIn:"Moberly, Missouri, USA", imdbId:"0109785", born:date('1961-05-21'), name:"Brent Briscoe", bio:"​From Wikipedia, the free encyclopedia.   \n\nBrent Briscoe (May 21, 1961 – October 18, 2017) is an American actor and screenwriter.  Briscoe was born in Moberly, Missouri.  After finishing his education at the University of Missouri, Briscoe launched his career as a theater actor.  He then segued into screenwriting and acting in feature films.  He moved to Los Angeles permanently after working with Billy Bob Thornton on Sling Blade and the two frequently collaborated in the subsequent years...", died:date('2017-10-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4N7ZjV0Tb2EwwRzOBGp7h01oXVu.jpg", url:"https://themoviedb.org/person/15011"}}, {tmdbId:"36424", properties:{bornIn:"Long Island", imdbId:"0005112", born:date('1968-01-14'), name:"LL Cool J", bio:"James Todd Smith better known as LL Cool J (acronym for Ladies Love Cool James) is an American rapper and actor.  He has released thirteen studio albums and two greatest hits compilations; his newest album is 2013's Authentic, following 2008's Exit 13, which completed his record deal with Def Jam Recordings.  He has appeared in numerous films, and stars as NCIS Special Agent Sam Hanna on the CBS crime drama television series NCIS: Los Angeles...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hyzfa0E6SffzDezFPYKZEPKcKzM.jpg", url:"https://themoviedb.org/person/36424"}}, {tmdbId:"1909", properties:{bornIn:"Charleston, West Virginia, USA", imdbId:"0004916", born:date('1943-03-28'), name:"Conchata Ferrell", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1CuSudlDbvrhFSpXPckzlMfzLiJ.jpg", url:"https://themoviedb.org/person/1909"}}, {tmdbId:"25654", properties:{bornIn:"Spring Valley, New York, USA", imdbId:"0000523", born:date('1966-06-08'), name:"Julianna Margulies", bio:"Julianna Margulies (born July, 8, 1966) is an American film and television actress, best known for her role on ER, for which she won an Emmy Award, and The Good Wife, for which she won a Golden Globe, two Emmy and two Screen Actors Guild Awards...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yuYF7jf9FRzphMTsmp1l1MkGpNK.jpg", url:"https://themoviedb.org/person/25654"}}, {tmdbId:"91375", properties:{imdbId:"1124767", name:"Barbara Adams", url:"https://themoviedb.org/person/91375"}}, {tmdbId:"42707", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"0824763", born:date('1965-12-19'), name:"Jessica Steen", bio:"Jessica Steen (born December 19, 1965) is a film and television actress, noted for her roles in Captain Power and the Soldiers of the Future, Homefront, Earth 2, Armageddon, Left Behind: World at War, NCIS, and Flashpoint. \n\nDescription above from the Wikipedia article Jessica Steen, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7pKpGn6beYaDdEnSSmZWJY5DGlc.jpg", url:"https://themoviedb.org/person/42707"}}, {tmdbId:"2039", properties:{bornIn:"Dublin, Ireland", imdbId:"0322407", born:date('1955-03-29'), name:"Brendan Gleeson", bio:"Brendan Gleeson is an Irish actor.  His best-known films include the Harry Potter films, Braveheart, Gangs of New York, 28 Days Later, and the role of Michael Collins in The Treaty.  He won an Emmy award in 2009 for his portrayal of Winston Churchill in the film Into the Storm. \n\nGleeson was born in Dublin, Ireland and has described himself as having been an avid reader as a child.  After leaving school for a short while, he worked for two years in an office with a health board...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rMqHaHDwSvqH8d0NdSS2qrWldvS.jpg", url:"https://themoviedb.org/person/2039"}}, {tmdbId:"147877", properties:{bornIn:"Ruthin, Wales, UK", imdbId:"0406974", born:date('1968-01-01'), name:"Llyr Ifans", bio:"Llŷr Ifans is a Welsh actor, born in Ruthin, Denbighshire.  He is best known for appearing opposite his brother Rhys Ifans in the cult film, \"Twin Town\", in 1997.  \n\nIn September 2007 Ifans appeared at Clwyd Theatr Cymru in their production of \"A Toy Epic\", which ran at the Mold venue and then was taken on a short tour around Wales. \n\nHe also appeared in the short Welsh-language television drama \"S. O. S.  Galw Gari Tryfan\"...", url:"https://themoviedb.org/person/147877"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"7026", properties:{bornIn:"Haverfordwest, Pembrokeshire, Wales, UK", imdbId:"0406975", born:date('1967-07-22'), name:"Rhys Ifans", bio:"From Wikipedia, the free encyclopedia. \n\nRhys Ifans (born Rhys Owain Evans; 22 July 1967) is a Welsh actor and musician.  He is known for his portrayal of characters such as Spike in Notting Hill and Jed Parry in Enduring Love and as a member of the Welsh rock groups Super Furry Animals and The Peth.  Ifans also appeared as Xenophilius Lovegood in the Harry Potter and the Deathly Hallows films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/g8EUs8r1ECh9plKtrxBparsxlZ1.jpg", url:"https://themoviedb.org/person/7026"}}, {tmdbId:"585957", properties:{imdbId:"0858755", name:"Dorien Thomas", url:"https://themoviedb.org/person/585957"}}, {tmdbId:"15336", properties:{bornIn:"Glenrothes, Fife, Scotland, UK", imdbId:"0779084", born:date('1965-11-25'), name:"Dougray Scott", bio:"Born in Scotland, trained at the Welsh College of Music and Drama where he was named most promising drama student.  Scott's early work was in Scottish national theatre and television, first appearing in the series Soldier Soldier as well as on the stage in the Tim Fleming directed production of Wallace.  Early television credits to follow included The Rover, Taggart: Nest of Vipers, Lovejoy, and Soldier Soldier...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zeZmtK4EKK9R2r6bp2nTxMs3ByS.jpg", url:"https://themoviedb.org/person/15336"}}, {tmdbId:"21132", properties:{bornIn:"Bloomington, Indiana, USA", imdbId:"0072344", born:date('1969-10-04'), name:"Abraham Benrubi", bio:"Abraham Benrubi (born October 4, 1969) is an American character actor known for his appearances on ER, Parker Lewis Can't Lose and Robot Chicken...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d5pQ1PCv0XDnYXZTbX2t5r4AMph.jpg", url:"https://themoviedb.org/person/21132"}}, {tmdbId:"3181", properties:{imdbId:"0752116", name:"Richard Rutowski", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Vd0aI386QjKsRNTfWpqjxKamNT.jpg", url:"https://themoviedb.org/person/3181"}}, {tmdbId:"76836", properties:{imdbId:"0745408", name:"Paolo Rotondo", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w9jNDPig76lzu3ilCKE7YJEMAdd.jpg", url:"https://themoviedb.org/person/76836"}}, {tmdbId:"67122", properties:{imdbId:"0323163", name:"Paul Glover", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mDoAPIMX3DnTSDOb5yi8iJtU1fO.jpg", url:"https://themoviedb.org/person/67122"}}, {tmdbId:"1085971", properties:{imdbId:"0333968", name:"Christopher Graham", url:"https://themoviedb.org/person/1085971"}}, {tmdbId:"1085972", properties:{imdbId:"0847715", name:"Darien Takle", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/394T6ts076a3WOIrJXOS9AWXHoz.jpg", url:"https://themoviedb.org/person/1085972"}}, {tmdbId:"134178", properties:{bornIn:"Bethesda - Maryland - USA", imdbId:"0005359", born:date('1951-02-23'), name:"Patricia Richardson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i7nIqwsGp0XlL0pvRX6dx1CkK5z.jpg", url:"https://themoviedb.org/person/134178"}}, {tmdbId:"150061", properties:{imdbId:"0242226", name:"Christine Dunford", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ndDoilOu0UEEbjse70HknzQTnlC.jpg", url:"https://themoviedb.org/person/150061"}}, {tmdbId:"43772", properties:{bornIn:"Long Beach, California, USA", imdbId:"0940052", born:date('1963-04-19'), name:"Tom Wood", url:"https://themoviedb.org/person/43772"}}, {tmdbId:"34721", properties:{bornIn:" Philadelphia, Pennsylvania, USA", imdbId:"0084114", born:date('1948-11-30'), name:"Larry Bishop", bio:"From Wikipedia, the free encyclopedia. \n\nLarry Bishop (born November 30, 1948) is an American actor, screenwriter and movie director.  He is the son of Sylvia Ruzga and comedian Joey Bishop.  He has been featured in many Hollywood movies including Hell Ride. \n\nHis television credits include writing for (and appearances on) The Hollywood Palace (with then-partner Rob Reiner), and appearances on I Dream of Jeannie, Love, American Style, Laverne and Shirley and Kung Fu...", url:"https://themoviedb.org/person/34721"}}, {tmdbId:"59826", properties:{bornIn:"Ixelles (Belgique) ", imdbId:"0753696", born:date('1974-04-11'), name:"Natacha Régnier", bio:"Nathalie \"Natacha\" Régnier (born 11 April 1974) is a Belgian actress.  She received a Cannes Film Festival Award, a European Film Award, and a César Award for her role in the 1998 film The Dreamlife of Angels.  Régnier is the first Belgian actress to win a César Award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ydwkoFfIbGEHuOhFRW3CYFTWgHM.jpg", url:"https://themoviedb.org/person/59826"}}, {tmdbId:"59830", properties:{imdbId:"0580174", name:"Patrick Mercado", url:"https://themoviedb.org/person/59830"}}, {tmdbId:"36059", properties:{bornIn:"Tomaszów Lubelski, Lubelskie, Poland", imdbId:"0001586", born:date('1957-01-02'), name:"Joanna Pacula", bio:"Joanna Pacula (born January 2, 1957) is a Polish actress. Pacula joined Warsaw Dramatic Theatre where she acted until 1981.  She started her career playing in productions of Shakespeare's Romeo and Juliet, Othello and As You Like It.  She also found work in a handful of films, including Krzysztof Zanussi's Barwy ochronne/Camouflage (1977).  In 1981, Pacula was caught in Paris when communist authorities in Poland declared martial law.  In 1982 she eventually emigrated to the U. S...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/97JaBMYa3xgTdsKrTNQG71uEZsZ.jpg", url:"https://themoviedb.org/person/36059"}}, {tmdbId:"42169", properties:{bornIn:"Fort Worth, Texas, USA", imdbId:"0319231", born:date('1950-01-23'), name:"Richard Gilliland", bio:"From Wikipedia, the free encyclopedia.   Richard Gilliland (born January 23, 1950) is an American television and movie actor. \n\nGilliland was born in Fort Worth, Texas.  He appeared onscreen in the 1970s.  Notable appearances include Thirtysomething, Party of Five, Little Women, and a recurring role on Designing Women (where he met his wife Jean Smart, who starred as Charlene in that series).  The couple has one son, Connor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/f7E7MZKKSzGkeRLIUscfrkMUNrl.jpg", url:"https://themoviedb.org/person/42169"}}, {tmdbId:"63935", properties:{bornIn:"Columbia, South Carolina, USA", imdbId:"0199830", born:date('1956-03-04'), name:"Alex Daniels", url:"https://themoviedb.org/person/63935"}}, {tmdbId:"2464", properties:{bornIn:" Glasgow, Scotland, UK", imdbId:"0005171", born:date('1963-09-21'), name:"Angus Macfadyen", bio:"​From Wikipedia, the free encyclopedia\n\nAngus Macfadyen (born 21 September 1963) is a Scottish actor.  Angus Macfadyen was born in Glasgow and was brought up partly in Africa, France, the Philippines and Singapore.  His father was a doctor in the World Health Organisation.  He was once engaged to actress Catherine Zeta-Jones.  Macfadyen attended the University of Edinburgh, and the Central School of Speech and Drama in London...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yUuA7U3lw6yM0Eb6mD83qYeevH2.jpg", url:"https://themoviedb.org/person/2464"}}, {tmdbId:"533016", properties:{bornIn:"California, - USA", imdbId:"0947126", born:date('1984-11-05'), name:"Mario Yedidia", bio:"Mario Yedidia was born on November 5, 1984 in California, USA.  He is an actor, known for Warriors of Virtue (1997), Jack (1996) and Under Wraps (1997)...", url:"https://themoviedb.org/person/533016"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"6407", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0005420", born:date('1974-04-12'), name:"Marley Shelton", bio:"Marley Eve Shelton (born April 12, 1974) is an American film and television actress.  Shelton began her acting career in her late teens, and appeared in several 1990s' television movies and shows.  She made her film debut in the critically acclaimed drama Grand Canyon (1991), and was cast in the films The Sandlot (1993), Nixon (1995), and Warriors of Virtue (1997).  Shelton subsequently appeared in Pleasantville (1998) and Never Been Kissed (1999)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p5IBZkG0hf2iYt9FKMhCgV0QLn3.jpg", url:"https://themoviedb.org/person/6407"}}, {tmdbId:"995587", properties:{bornIn:"Shanxi, China", imdbId:"0156874", born:date('1927-04-05'), name:"Chao Li Chi", died:date('2010-10-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ppbDeOKRND51Av76pLCBWFVWZZV.jpg", url:"https://themoviedb.org/person/995587"}}, {tmdbId:"77603", properties:{imdbId:"0638249", name:"Emira Nusevic", url:"https://themoviedb.org/person/77603"}}, {tmdbId:"33528", properties:{bornIn:"New Brunswick, New Jersey, USA", imdbId:"0189200", born:date('1986-05-28'), name:"Joseph Cross", bio:"From Wikipedia, the free encyclopedia\n\nJoseph Michael Cross (born May 28, 1986) is an American actor. \n\nDescription above from the Wikipedia article Joseph Cross (actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/exxcI1BPy7BFQvXWM5DiH7xpwPO.jpg", url:"https://themoviedb.org/person/33528"}}, {tmdbId:"1328126", properties:{imdbId:"0717562", born:date('1986-02-07'), name:"Timothy Reifsnyder", url:"https://themoviedb.org/person/1328126"}}, {tmdbId:"82519", properties:{bornIn:"Steinbach, Manitoba, Canada", imdbId:"0000282", born:date('1970-04-23'), name:"Scott Bairstow", bio:"Scott Hamilton Bairstow (born April 23, 1970) is a Canadian-born American actor known for his roles as \"Newt Call\" on the Lonesome Dove series in Canada and as \"Ned Grayson\" on the American television drama series, Party of Five.  He was born in Steinbach, Manitoba, Canada to Douglas and Diane Bairstow, professional classical musicians. \n\nDescription above from the Wikipedia article Scott Bairstow, licensed under CC-BY-SA,full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/82519"}}, {tmdbId:"15739", properties:{bornIn:"Essex, England, UK", imdbId:"0421105", born:date('1957-05-10'), name:"Alex Jennings", bio:"From Wikipedia, the free encyclopedia\n\nAlexander \"Alex\" Jennings (born 10 May 1957) is an English actor, who has worked extensively with the Royal Shakespeare Company and National Theatre.  A three-time Olivier Award winner, he won for Too Clever by Half (1988), Peer Gynt (1996), and My Fair Lady (2003).  He is the only performer to have won Olivier awards in the drama, musical and comedy categories.  He played Prince Charles in the 2006 film The Queen...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8U9T8b2V4AWlENgSmuy4SIAckM9.jpg", url:"https://themoviedb.org/person/15739"}}, {tmdbId:"17787", properties:{bornIn:"Glasgow, Scotland, UK", imdbId:"0492373", born:date('1932-05-08'), name:"Phyllida Law", bio:"Phyllida Law  is a Scottish actress, the mother of Emma and Sophie Thompson...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iL3UchWZqdk6RabqDZW9HBcJDwQ.jpg", url:"https://themoviedb.org/person/17787"}}, {tmdbId:"47404", properties:{bornIn:"Glasgow, Scotland", imdbId:"0717427", born:date('1937-12-21'), name:"Sheila Reid", bio:"​From Wikipedia, the free encyclopedia.   \n\nSheila Reid (born 1937) is a Scottish actress, best known for her performance as Madge Barron in Benidorm. \n\nDescription above from the Wikipedia article Sheila Reid, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/36OEL4KtXLkEjGq5TsSUQ58KH6y.jpg", url:"https://themoviedb.org/person/47404"}}, {tmdbId:"1645", properties:{bornIn:"Shetland Islands, Scotland, UK", imdbId:"0900806", born:date('1936-10-06'), name:"Sandra Voe", bio:"​From Wikipedia, the free encyclopedia.   \n\nSandra Voe (born October 6, 1936) is an actress of film, television and theatre. \n\nDescription above from the Wikipedia article Sandra Voe, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pIHuQOcK7FjepXNGM4Ze49yuPAr.jpg", url:"https://themoviedb.org/person/1645"}}, {tmdbId:"64932", properties:{bornIn:"San Diego, California, USA", imdbId:"0491079", born:date('1968-11-16'), name:"Tammy Lauren", bio:"​From Wikipedia, the free encyclopedia.   \n\nTammy Lauren (born November 16, 1968) is an American actress who has appeared in film and television.  She starred in Wishmaster, portraying Alexandra Amberson, a young woman who accidentally awakens the Djinn, a powerful spirit more commonly known as a genie. \n\nDescription above from the Wikipedia article Tammy Lauren, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/64932"}}, {tmdbId:"64933", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0501422", born:date('1954-06-22'), name:"Chris Lemmon", bio:"Christopher Lemmon (born January 22, 1954) is an American actor and author...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rgJVXdRLj5XRxjQw5r2fN3I9cq7.jpg", url:"https://themoviedb.org/person/64933"}}, {tmdbId:"1097545", properties:{imdbId:"0341443", name:"Bill Griffith", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vdKsVmNP2tLc7tCbVHM13CCOfCQ.jpg", url:"https://themoviedb.org/person/1097545"}}, {tmdbId:"1724871", properties:{bornIn:"New York City, New York, USA", imdbId:"0597940", born:date('1949-03-21'), name:"Eddie Money", bio:"From Wikipedia, the free encyclopedia\n\nEdward Joseph Mahoney (March 21, 1949 – September 13, 2019), known professionally as Eddie Money, was an American singer, songwriter and multi-instrumentalist who had success in the 1970s and 1980s with a string of Top 40 hits and platinum albums.  Money is well known for songs like \"Baby Hold On\", \"Two Tickets to Paradise\", \"Think I'm in Love\", \"Shakin'\", \"Take Me Home Tonight\", \"I Wanna Go Back\", \"Walk on Water\", and \"The Love in Your Eyes\"...", died:date('2019-09-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1njhYSbMnilk8D4DVr3SCYv5gdo.jpg", url:"https://themoviedb.org/person/1724871"}}, {tmdbId:"138897", properties:{imdbId:"0707780", name:"Michael Ralph", url:"https://themoviedb.org/person/138897"}}, {tmdbId:"227218", properties:{imdbId:"0002520", name:"Jeff Mazzola", url:"https://themoviedb.org/person/227218"}}, {tmdbId:"1459590", properties:{imdbId:"0591268", name:"Dick Mingalone", url:"https://themoviedb.org/person/1459590"}}, {tmdbId:"162500", properties:{imdbId:"0080891", name:"Vladimir Bibic", url:"https://themoviedb.org/person/162500"}}, {tmdbId:"78102", properties:{bornIn:"Des Moines, Iowa, USA", imdbId:"0383371", born:date('1961-12-09'), name:"David Anthony Higgins", bio:"From Wikipedia, the free encyclopedia\n\nDavid Anthony Higgins (born December 9, 1961; Des Moines, Iowa) is an American comedic actor, best known for playing the roles of Craig Feldspar from Malcolm in the Middle and Mr.  Bitters from Big Time Rush. \n\nThe brother of comedian Steve Higgins, he got his major break when cast in 1995 as outspoken barista Joe in the retooled version of the sitcom Ellen.  He is perhaps most well recognized for his roles as Craig Feldspar in Malcolm in the Middle and Mr...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9xTu9K4ssOPKwIqLmv3ZjRtQNLI.jpg", url:"https://themoviedb.org/person/78102"}}, {tmdbId:"59196", properties:{bornIn:"Pittsburgh, Pennsylvania, USA", imdbId:"0280886", born:date('1941-06-21'), name:"Joe Flaherty", bio:"From Wikipedia, the free encyclopedia. \n\nJoe Flaherty (born June 21, 1941) is an American-Canadian actor and comedian.  He is best known for his work on the Canadian sketch comedy SCTV, from 1976 to 1984, and as Harold Weir on Freaks and Geeks.  He is currently a judge on The Second City's Next Comedy Legend. \n\nDescription above from the Wikipedia article Joe Flaherty, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ryQDsvXgZpZCG2Y9b7TTCOFqG7e.jpg", url:"https://themoviedb.org/person/59196"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"235288", properties:{bornIn:"Puerto Rico", imdbId:"0596776", born:date('1943-06-22'), name:"Ralph Molina", bio:"Born in Puerto Rico, Ralph Molina has been a member of Crazy Horse in a career spanning nearly six decades since they were formed in 1962 (originally as Danny & the Memories, and then briefly, The Rockets).  He has remained throughout the group's many personnel changes, and has performed on all 20 releases by the band, with and without Neil Young...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wEokrWVjxLpjcUH7uTdUXnxu7Ix.jpg", url:"https://themoviedb.org/person/235288"}}, {tmdbId:"235287", properties:{imdbId:"0847888", name:"Billy Talbot", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zkxNoAZICtbsk7ru8yMOsQfxRB7.jpg", url:"https://themoviedb.org/person/235287"}}, {tmdbId:"15425", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"0949918", born:date('1945-11-12'), name:"Neil Young", bio:"Genres:  Rock, folk rock, hard rock, country rock\n\nOccupations:  Musician, songwriter, producer, director, screenwriter\n\nInstruments: Guitar, vocals, harmonica, piano, keyboards, banjo, ukelele\n\nYears active: 1960–present Labels: Reprise, Motown, Geffen\n\nAssociated acts: The Squires, The Mynah Birds, Buffalo Springfield, Crosby, Stills, Nash & Young, Crazy Horse, The Stray Gators, The Stills-Young Band, The Ducks, Northern Lights, Pearl Jam, Booker T...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gmB3EN81vnrtmaptCVdynJD7mwu.jpg", url:"https://themoviedb.org/person/15425"}}, {tmdbId:"12538", properties:{bornIn:"Cullowhee - North Carolina - USA", imdbId:"0780678", born:date('1959-03-07'), name:"Nick Searcy", bio:"From Wikipedia, the free encyclopedia. \n\nNick Searcy (born March 7, 1959) is an American actor who currently portrays Chief Deputy United States Marshal Art Mullen on FX's Justified.  He also had a major role in the Tom Hanks produced miniseries From the Earth to the Moon as Deke Slayton...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nyeIw9bLarqoZ4mDVkkzRUPRiGK.jpg", url:"https://themoviedb.org/person/12538"}}, {tmdbId:"168373", properties:{bornIn:"San Juan, Puerto Rico", imdbId:"0154663", born:date('1968-06-28'), name:"Chayanne", bio:"Elmer Figueroa de Arce, better known as Chayanne, was born in Puerto Rico, the third of five siblings.  He is married to Venezuelan Mariana Elizabeth \"Marilisa\" Maronesa de Figueroa, with whom he has a son, Lorenzo Valentino and a daughter, Isadora Sofia.  Chayanne debuted as a singer at ten years of age, becoming a part of a Menudo-type group \"Los Chicos. \" His recording career includes 14 albums/CDs, 5 of these with Los Chicos and 9 others as a solo performer; all in Spanish...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zFQZYogGqQjvR4Xawg10dXwnift.jpg", url:"https://themoviedb.org/person/168373"}}, {tmdbId:"823", properties:{bornIn:"Palos Heights, Illinois, USA", imdbId:"0000497", born:date('1974-08-24'), name:"Jennifer Lien", bio:"Jennifer Ann Lien (born August 24, 1974) is an American actress, best known for playing the alien Kes on the television series Star Trek: Voyager. \n\nEarly life\n\nThe youngest of three children, Lien was born in Palos Heights, Illinois.  Her mother, Delores Lien, was a college teacher. \n\nCareer\n\nHer first television appearance was in a bubblegum advertisement playing twins...", url:"https://themoviedb.org/person/823"}}, {tmdbId:"58184", properties:{bornIn:"Cambridge, Massachusetts, USA", imdbId:"0004852", born:date('1947-09-06'), name:"Jane Curtin", bio:"​From Wikipedia, the free encyclopedia. \n\nJane Therese Curtin (born September 6, 1947, height 5' 5\" (1,65 m)) is an American actress and comedienne.  She is commonly referred to as Queen of the Deadpan.  First coming to prominence as an original cast member on Saturday Night Live in 1975, she went on to win back-to-back Emmy Awards for Best Lead Actress in a Comedy Series on the 1980s sitcom Kate & Allie portraying the role of Allison \"Allie\" Lowell...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8zFqSKnRtI8DuvtgfW9873U3Daz.jpg", url:"https://themoviedb.org/person/58184"}}, {tmdbId:"45586", properties:{bornIn:"Liverpool, England, UK", imdbId:"0844294", born:date('1961-04-12'), name:"Magda Szubanski", bio:"Magdalene Mary Szubanski AO is an Australian television and film actress, comedian and writer.  Szubanski's career started as a writer and performer of sketch comedy and has since progressed to production of TV, film acting, and musical theatre...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fNb650TNqOBG6dSP9bLhoxxI9wA.jpg", url:"https://themoviedb.org/person/45586"}}, {tmdbId:"45386", properties:{bornIn:"Marquette, Michigan, USA", imdbId:"0825566", name:"Mary Stein", bio:"From Wikipedia, the free encyclopedia. \n\nMary was born in Marquette, Michigan, and grew up in Milwaukee, Wisconsin.  She began an acting career performing in plays...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vrV6Fqwu8jby0DXzg3ldNL7qCjE.jpg", url:"https://themoviedb.org/person/45386"}}, {tmdbId:"20788", properties:{bornIn:"Union Township, New Jersey, USA", imdbId:"0005119", born:date('1967-10-11'), name:"Artie Lange", bio:"From Wikipedia, the free encyclopedia. \n\nArthur Steven \"Artie\" Lange, Jr.  (born October 11, 1967) is an American actor, comedian, radio personality, and author.  Lange is most notable for replacing Jackie Martling on The Howard Stern Show, and for being an original cast member of the sketch comedy series MADtv.  Lange co-wrote a book with Anthony Bozza titled Too Fat to Fish.  It was released on November 11, 2008, and debuted at number one on the New York Times best-seller list on November 21, 2008...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3bbfXRP7TANPJrsj0oLosw9vq0v.jpg", url:"https://themoviedb.org/person/20788"}}, {tmdbId:"21293", properties:{imdbId:"0269479", name:"Alan Fawcett", url:"https://themoviedb.org/person/21293"}}, {tmdbId:"110887", properties:{imdbId:"0923852", name:"Jane Wheeler", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Ab3vhCpbY364Ba1bClpUsrJbYfE.jpg", url:"https://themoviedb.org/person/110887"}}, {tmdbId:"31031", properties:{bornIn:" Los Angeles, California, USA", imdbId:"0695497", born:date('1986-09-16'), name:"Kyla Pratt", bio:"​From Wikipedia, the free encyclopedia\n\nKyla Alissa Pratt (born September 16, 1986) is an American actress and singer.  She is also credited as Kyla A.  Pratt. \n\nDescription above from the Wikipedia article Kyla Pratt, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nwkCSweQbO6UyDP0dnXQjVp0qGr.jpg", url:"https://themoviedb.org/person/31031"}}, {tmdbId:"1731651", properties:{imdbId:"3809656", name:"Diana Rice", url:"https://themoviedb.org/person/1731651"}}, {tmdbId:"6942", properties:{imdbId:"0918435", name:"Eric Weinstein", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yPYIjSrc1SLiVHAsBaB5RAOhINh.jpg", url:"https://themoviedb.org/person/6942"}}, {tmdbId:"822", properties:{bornIn:"Evansville, Indiana, USA", imdbId:"0000984", born:date('1948-10-02'), name:"Avery Brooks", bio:"Avery Franklin Brooks (born October 2, 1948) is an American actor, jazz musician, opera singer and college professor.  Brooks is perhaps best known for his television roles as Benjamin Sisko on Star Trek: Deep Space Nine, and as Hawk on Spenser: For Hire and its spinoff A Man Called Hawk. \n\nDescription above from the Wikipedia article Avery Brooks, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w1p0QQKdtVcdX6NVRUfVZzPZKHM.jpg", url:"https://themoviedb.org/person/822"}}, {tmdbId:"1507100", properties:{imdbId:"0096772", name:"Bobby Boriello", url:"https://themoviedb.org/person/1507100"}}, {tmdbId:"41640", properties:{bornIn:"New York City, New York, USA", imdbId:"0271165", born:date('1952-12-27'), name:"Tovah Feldshuh", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c0VOkTP88UneW37YOBebtBhMHYF.jpg", url:"https://themoviedb.org/person/41640"}}, {tmdbId:"56485", properties:{bornIn:"Cincinnati, Ohio  United States", imdbId:"0453492", born:date('1965-03-31'), name:"Jacqueline Kim", bio:"​From Wikipedia, the free encyclopedia\n\nJacqueline Joan Kim (born March 31, 1965) an actor, filmmaker and composer, is also known as the musical entity, This I Heard.  She has been nominated for a FIND Independent Spirit award for portraying the lead role in the acclaimed indie film, Charlotte Sometimes. \n\nDescription above from the Wikipedia article Jacqueline Kim, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nTIV1EoiDgMUcdwyKYj7jUPu7V4.jpg", url:"https://themoviedb.org/person/56485"}}, {tmdbId:"17265", properties:{bornIn:"Palisades - New York - USA", imdbId:"0659363", born:date('1989-08-21'), name:"Hayden Panettiere", bio:"Hayden Leslie Panettiere is an American actress and singer.  She came to professional prominence at the age of 10 with her portrayal of Sheryl Yoast in Disney's Remember the Titans, although for five years before that, Panettiere had held roles in two soap operas.  She portrayed Sarah Roberts on One Life to Live (1994–1997), and Lizzie Spaulding on Guiding Light (1996–2000)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gwGSfFZFstdXhLD0WkmLn7NXRDm.jpg", url:"https://themoviedb.org/person/17265"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"1074137", properties:{bornIn:" Glasgow, Scotland, UK", imdbId:"0272521", born:date('1965-04-11'), name:"Lynn Ferguson", url:"https://themoviedb.org/person/1074137"}}, {tmdbId:"20241", properties:{imdbId:"0371304", born:date('1945-02-04'), name:"Tony Haygarth", bio:"Tony Haygarth was born on February 4, 1945 in Liverpool, England.  He is an actor, known for Chicken Run (2000), Where the Heart Is (1997) and Rosie (1977).  He is married to Carol Haygarth.  They have two children...", url:"https://themoviedb.org/person/20241"}}, {tmdbId:"3568", properties:{bornIn:"Finsbury Park, London, England, UK", imdbId:"0324009", born:date('1933-02-13'), name:"Patrick Godfrey", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fGZMxe4VpV0rYDYbgXmyJlDO3f7.jpg", url:"https://themoviedb.org/person/3568"}}, {tmdbId:"1443624", properties:{imdbId:"0594951", name:"Bobby Moat", url:"https://themoviedb.org/person/1443624"}}, {tmdbId:"108438", properties:{bornIn:" Flint, Michigan", imdbId:"0888321", born:date('1969-12-08'), name:"Steve Van Wormer", bio:"​From Wikipedia, the free encyclopedia.   \n\nSteve Van Wormer (born December 8, 1969) is an American actor and comedian.  He was born in Flint, Michigan, attended Grand Blanc Community High School and Michigan State University, and moved to Los Angeles, California upon graduation.  He has acted in movies including Groove, Meet the Deedles, and Jingle All The Way.  His television appearances include Without a Trace, Johnny Tsunami and Turks, as well as The Tonight Show...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o6w0F9pMqKgsy7O11lCGoSQiG1Y.jpg", url:"https://themoviedb.org/person/108438"}}, {tmdbId:"8167", properties:{bornIn:"Glendale, California, USA", imdbId:"0908094", born:date('1973-09-12'), name:"Paul Walker", bio:"Paul William Walker IV (September 12, 1973 – November 30, 2013) was an American actor.  He became well known in 1999 after his role in the hit film Varsity Blues.  However, he was perhaps best known for starring as Brian O'Conner in The Fast and the Furious film series.  His other films include Eight Below, Into the Blue, She's All That and Takers...", died:date('2013-11-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wyNH05Bt6q8Tg2U8SZwtIYcbs7J.jpg", url:"https://themoviedb.org/person/8167"}}, {tmdbId:"157904", properties:{bornIn:"Columbus, Ohio, USA", imdbId:"0486277", born:date('1974-05-22'), name:"A.J. Langer", bio:"From Wikipedia, the free encyclopedia A. J.  Langer Courtenay, Lady Courtenay (born May 22, 1974), is an American actress best known for her role as Rayanne Graff on the television series My So-Called Life.  Description above from the Wikipedia article A. J.  Langer, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/r9jyNoXkkLpZj15GoN88Nbx7WaW.jpg", url:"https://themoviedb.org/person/157904"}}, {tmdbId:"23495", properties:{bornIn:"Orlando, Florida, USA", imdbId:"0005044", born:date('1982-05-11'), name:"Jonathan Jackson", bio:"From Wikipedia, the free encyclopedia.  Jonathan Stevens Jackson (born May 11, 1982) is an American actor, best known for playing Lucky Spencer, son of supercouple Luke and Laura on the American daytime drama General Hospital.  He also played the protagonist, Jesse Tuck, in the 2002 film Tuck Everlasting. \n\nDescription above from the Wikipedia article Jonathan Jackson , licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/crikMKPClMfPDXMGd4SvRRdn58o.jpg", url:"https://themoviedb.org/person/23495"}}, {tmdbId:"77075", properties:{bornIn:"Québec City, Québec, Canada", imdbId:"0005172", born:date('1963-10-17'), name:"Norm MacDonald", bio:"From Wikipedia, the free encyclopedia. \n\nNorman Gene \"Norm\" Macdonald (born October 17, 1963) is a Canadian stand-up comedian, writer and actor.  He is best known for his five seasons as a cast member on Saturday Night Live, which included anchoring Weekend Update for three years.  Early in his career, he wrote for the sitcom Roseanne and made appearances on shows including The Drew Carey Show and NewsRadio.  He also starred in The Norm Show from 1999 to 2001...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pGOpdt9Xy9YO2nUEWgp8G89KC5r.jpg", url:"https://themoviedb.org/person/77075"}}, {tmdbId:"54826", properties:{bornIn:"Orlando, Florida, USA", imdbId:"0005025", born:date('1966-06-14'), name:"Traylor Howard", bio:"Traylor Howard (born June 14, 1966) is an American actress.  She is best known for her roles on Two Guys and a Girl as well as Monk...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ymB8T4c0ech3oL1G0EhdlEWWg3m.jpg", url:"https://themoviedb.org/person/54826"}}, {tmdbId:"1729865", properties:{name:"Barret Hackney", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/inMMIFps57M0VwPkzDmVOD1kqid.jpg", url:"https://themoviedb.org/person/1729865"}}, {tmdbId:"1766586", properties:{bornIn:"Pittsburgh, Pennsylvania, USA", name:"Jared Pfennigwerth", url:"https://themoviedb.org/person/1766586"}}, {tmdbId:"922344", properties:{name:"Kitao Sakurai", bio:"Kitao Sakurai is a writer and director, known for The Eric Andre Show (2012), Aardvark (2010) and Coda (2003). \n\nSakurai was born in Kinugasa Japan and was raised in Cleveland Ohio.  He began his career as a child actor, appearing in films such as Kevin Smith's Dogma (1999) and Best of The Best 3 (1995).  Sakurai then turned his focus towards cinematography, lensing Ry-Russo Young's You Wont Miss Me (2009) and Edwin Decena's Transformations (2006) along with countless \"dirty south\" hip-hop videos...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9uaITTRb3OOdkV9ujcUTd9f9cp7.jpg", url:"https://themoviedb.org/person/922344"}}, {tmdbId:"19899", properties:{bornIn:"Fredrikstad, Østfold, Norway", imdbId:"0832509", born:date('1960-07-15'), name:"Dennis Storhøi", bio:"Jahn Dennis Storhøi (born July 15, 1960 in Fredrikstad, Norway) is a Norwegian actor. \n\n He is an acclaimed theatre actor in Norway, having won several awards.  However, he is best known for his role asHerger the Joyous in John McTiernan's The 13th Warrior.  To younger crowds he is better known for playing in several Norwegian TV shows and giving voices to cartoons.   On 17 March 2010, he and several other Norwegian actors were cast in The Thing prequel...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oKIPuT0L0jiXfqXIBRzpqrojsPv.jpg", url:"https://themoviedb.org/person/19899"}}, {tmdbId:"19898", properties:{bornIn:"Prague - Czechoslovakia", imdbId:"0474520", born:date('1956-07-14'), name:"Vladimir Kulich", bio:"Vladimir Kulich is a Czech-Canadian actor.  He is best known for his roles as Buliwyf in the film The 13th Warrior, Tiberius in the film Ironclad, Erik in the television series Vikings, as well as the voice of Ulfric Stormcloak in The Elder Scrolls V: Skyrim and as The Beast in the television series Angel.  In 1995 he appeared as Olafsson in the X-Files episode \"Død Kalm. \" While living in Montreal, Canada as a young adult, he was a professional hockey player...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z6pfLx4kJvqWj501SIxExu6rYFi.jpg", url:"https://themoviedb.org/person/19898"}}, {tmdbId:"1085098", properties:{imdbId:"0311405", name:"Haile Gebrsellasie", url:"https://themoviedb.org/person/1085098"}}, {tmdbId:"1018249", properties:{imdbId:"0311406", name:"Shawananness Gebrselassie", url:"https://themoviedb.org/person/1018249"}}, {tmdbId:"1018137", properties:{imdbId:"0955053", name:"Yonas Zergaw", url:"https://themoviedb.org/person/1018137"}}, {tmdbId:"1018138", properties:{imdbId:"0354143", name:"Tedesse Haile", url:"https://themoviedb.org/person/1018138"}}, {tmdbId:"239171", properties:{imdbId:"1435207", name:"Lhakpa Dorji", url:"https://themoviedb.org/person/239171"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"1913648", properties:{name:"Dorje Sherpa", url:"https://themoviedb.org/person/1913648"}}, {tmdbId:"135673", properties:{name:"Ed Viesturs", url:"https://themoviedb.org/person/135673"}}, {tmdbId:"5024", properties:{bornIn:"Ljusdal, Sweden", imdbId:"0724688", born:date('1959-06-06'), name:"Marie Richardson", bio:"Marie Elisabet Richardson is a Swedish stage and screen actress.  She graduated from the Swedish National Academy of Acting, Stockholm, in 1985, and has since been a member of the ensemble at The Royal Dramatic Theatre in Stockholm...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d1IjQzD19i8aCPTDYoCso3Jaq12.jpg", url:"https://themoviedb.org/person/5024"}}, {tmdbId:"65524", properties:{bornIn:"Llwydcoed, Aberdare, Glamorgan, Wales, UK", imdbId:"0344435", born:date('1973-10-06'), name:"Ioan Gruffudd", bio:"Ioan Gruffudd is a Welsh actor who trained at the Royal Academy of Dramatic Art in London, England.  He started off mainly in Welsh-language productions, then came to international attention as Fifth Officer Harold Lowe in the film \"Titanic\" (1997), and as Lt.  John Beales in \"Black Hawk Down\" (2001). \n\nHowever, he is probably best known for playing the role of Horatio Hornblower in \"Hornblower\", the British made-for-TV films (1998–2003) based on C. S.  Forester's novels...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bUfnbySl6afH1Upkeq0v2Kp8Ymx.jpg", url:"https://themoviedb.org/person/65524"}}, {tmdbId:"56731", properties:{bornIn:"Pomona, California, USA", imdbId:"0004695", born:date('1981-04-28'), name:"Jessica Alba", bio:"Jessica Marie Alba (born April 28, 1981) is an American television and film actress.  She began her television and movie appearances at age 13 in Camp Nowhere and The Secret World of Alex Mack (1994).  Alba rose to prominence as the lead actress in the television series Dark Angel (2000–2002).  Alba later appeared in various films including Honey (2003), Sin City (2005), Fantastic Four (2005), Into the Blue (2005), Fantastic Four: Rise of the Silver Surfer and Good Luck Chuck both in 2007...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kB0XNtvkOuaFjk9Z2RZIcp5Kig2.jpg", url:"https://themoviedb.org/person/56731"}}, {tmdbId:"16828", properties:{bornIn:"Sudbury, Massachusetts, USA", imdbId:"0262635", born:date('1981-06-13'), name:"Chris Evans", bio:"An American actor.  Evans is known for his superhero roles as the Marvel Comics characters Steve Rogers in the Marvel Cinematic Universe and the Human Torch in Fantastic Four (2005) and its 2007 sequel.  Evans began his career on the 2000 television series Opposite Sex.  Besides his superhero films, he has appeared in such films as Not Another Teen Movie (2001), Sunshine (2007), Scott Pilgrim vs.  the World (2010), Snowpiercer (2013), and Gifted (2017)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bOH7QqvC9FShVMzWH2wBTtb2iwX.jpg", url:"https://themoviedb.org/person/16828"}}, {tmdbId:"19654", properties:{bornIn:"Lowell, Massachusetts, USA", imdbId:"0004821", born:date('1963-08-30'), name:"Michael Chiklis", bio:"Michael Charles Chiklis (born August 30, 1963) is an American actor, voice actor, occasional director and television producer.  Some of the previous roles for which he is best known include Commissioner Tony Scali on the ABC police drama The Commish, LAPD Detective Vic Mackey on the FX police drama The Shield, Thing in the Fantastic Four film series, and Jim Powell on the science-fiction, comedy-drama No Ordinary Family...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pAkKjbzxP6Z6Y5zAGpwmWQo1iji.jpg", url:"https://themoviedb.org/person/19654"}}, {tmdbId:"2219", properties:{bornIn:"Santa Monica, California, USA", imdbId:"0001497", born:date('1975-06-27'), name:"Tobey Maguire", bio:"Tobias Vincent Maguire is an American actor and film producer.  He gained recognition for his role as Peter Parker / Spider-Man in Sam Raimi's Spider-Man trilogy.  His other major films include Pleasantville, The Cider House Rules, Wonder Boys, Seabiscuit, The Good German, Brothers, and The Great Gatsby...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uTjU9MVPhyLNs4cjacee3XoCmeE.jpg", url:"https://themoviedb.org/person/2219"}}, {tmdbId:"126418", properties:{bornIn:"Charlestown, Massachusetts, USA", imdbId:"0518989", born:date('1960-01-06'), name:"Howie Long", bio:"From Wikipedia, the free encyclopedia. \n\nHoward \"Howie\" Matthew Moses Long (born January 6, 1960 in Charlestown, Massachusetts) is an American former National Football League defensive end and actor.  He was inducted into the Pro Football Hall of Fame in 2000.  He is currently a studio analyst for Fox Network's NFL coverage. \n\nDescription above from the Wikipedia article Howie Long, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qEnlcLGMS3mVp3XJRm4TmmCXb0U.jpg", url:"https://themoviedb.org/person/126418"}}, {tmdbId:"1552811", properties:{name:"José Rafael Arango", url:"https://themoviedb.org/person/1552811"}}, {tmdbId:"1006135", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0035230", name:"Nicole Arlyn", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/scWt9YiofmEFRGGSgeX5HllDclH.jpg", url:"https://themoviedb.org/person/1006135"}}, {tmdbId:"1006136", properties:{imdbId:"0129812", name:"David Cale", url:"https://themoviedb.org/person/1006136"}}, {tmdbId:"133517", properties:{bornIn:"Riverside, California, USA", imdbId:"0276707", born:date('1990-12-01'), name:"Jean-Luke Figueroa", url:"https://themoviedb.org/person/133517"}}, {tmdbId:"105351", properties:{imdbId:"0387524", name:"Florence Hoath", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dBm7EM7kwNJ69snZW8JASwr7SIo.jpg", url:"https://themoviedb.org/person/105351"}}, {tmdbId:"1244", properties:{bornIn:"Dublin, Ireland", imdbId:"0001667", born:date('1977-07-27'), name:"Jonathan Rhys Meyers", bio:"Jonathan Rhys Meyers is an Irish actor and model. \n\nHe is best known for his roles in the films Velvet Goldmine, Bend It Like Beckham, Woody Allen's Match Point and his television roles as Elvis Presley in the biographical miniseries Elvis, which earned him a Golden Globe for Best Actor, and as King Henry VIII in the historical drama The Tudors. \n\nIn two of his films, Velvet Goldmine and August Rush, he also took over singing parts...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iqt4t52DEmjBMpdhfmZqcRbHiCl.jpg", url:"https://themoviedb.org/person/1244"}}, {tmdbId:"61981", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0003817", born:date('1957-12-10'), name:"Michael Clarke Duncan", bio:"Michael Clarke Duncan was an American film and television actor, best known for his breakout role as John Coffey in the feature film The Green Mile, which netted him an Academy Award nomination for Best Actor in a Supporting Role and a Golden Globe nomination for Best Performance by an Actor in a Supporting Role in a Motion Picture...", died:date('2012-09-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3RX8OBqt3gbvFwKYZqiom4O3Ta6.jpg", url:"https://themoviedb.org/person/61981"}}, {tmdbId:"4169", properties:{bornIn:" Washington, District of Columbia, USA", imdbId:"0152638", born:date('1973-08-24'), name:"Dave Chappelle", bio:"David Khari Webber \"Dave\" Chappelle was born on August 24, 1973 in Washington, D. C.  He is a comedian, screenwriter, television/film producer and actor.  Chappelle began his film career in the film Robin Hood: Men in Tights in 1993 and continued to star in minor roles in the films The Nutty Professor, Con Air, and Blue Streak.  His first lead role in a film was in Half Baked in 1998...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qrJzigQLQ7FwrzYBLeDwvuPN63t.jpg", url:"https://themoviedb.org/person/4169"}}, {tmdbId:"57690", properties:{bornIn:"Valley Stream, Long Island, New York, USA", imdbId:"0108028", born:date('1967-06-21'), name:"Jim Breuer", bio:"From Wikipedia, the free encyclopedia\n\nJim Breuer (born June 21, 1967) is an American stand-up comedian, actor and radio host.  He is most noted for his time as a cast member on Saturday Night Live and starring in the 1998 cult \"stoner comedy\" Half Baked, alongside Dave Chappelle. \n\nDescription above from the Wikipedia article Jim Breuer, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8TH8fGxu0UMAM4Qqy3W7nbqWRP4.jpg", url:"https://themoviedb.org/person/57690"}}, {tmdbId:"55257", properties:{bornIn:"Brooklyn - New York - USA", imdbId:"0035060", born:date('1956-08-19'), name:"Adam Arkin", bio:"From Wikipedia, the free encyclopedia. \n\nAdam Arkin (born August 19, 1956) is an American television, film and stage actor and director.  He played the role of Aaron Shutt on Chicago Hope.  He is also one of the three actors to portray Dale \"The Whale\" Biederbeck on Monk.  As of 2007 he starred in the NBC drama Life.  In 2009 he portrayed villain Ethan Zobelle, a white separatist gang leader, on the FX original series Sons of Anarchy.  He is the son of Oscar winning actor Alan Arkin...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/66CugPTyelfdtYe0IV0U0LQP1sA.jpg", url:"https://themoviedb.org/person/55257"}}, {tmdbId:"1812", properties:{bornIn:"Kalispell, Montana, USA", imdbId:"0931329", born:date('1980-09-09'), name:"Michelle Williams", bio:"Michelle Ingrid Williams (born September 9, 1980) is an American actress.  She began her career with television guest appearances, and made her feature film debut in Lassie (1994), which earned her a Youth in Film nomination.  She gained wider recognition for her role as Jen Lindley on the The WB series Dawson's Creek from 1998 to 2003...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sXTP6wlqIDz1tDGLU3DFbklSTpq.jpg", url:"https://themoviedb.org/person/1812"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"6614", properties:{bornIn:"Santa Barbara, California, USA", imdbId:"0369513", born:date('1975-03-22'), name:"Cole Hauser", bio:"Cole Kenneth Hauser (born March 22, 1975) is an American film and television actor best known for his roles in School Ties, Good Will Hunting and 2 Fast 2 Furious...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2BF7mFi9YGguJPlJRgrdWwHR7Ic.jpg", url:"https://themoviedb.org/person/6614"}}, {tmdbId:"17637", properties:{bornIn:"Rochester, New York, USA", imdbId:"0004875", born:date('1971-01-02'), name:"Taye Diggs", bio:"From Wikipedia, the free encyclopedia  \n\n  Scott Leo \"Taye\" Diggs (born January 2, 1971) is an American theatre, film and television actor.  He is perhaps best known for his roles in the Broadway musical Rent, the motion picture How Stella Got Her Groove Back, and the television series Private Practice.  His nickname, Taye, comes from the playful pronunciation of Scotty as \"Scottay\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nC583kPPgQg4dpbQAsCEsHVlNR3.jpg", url:"https://themoviedb.org/person/17637"}}, {tmdbId:"976644", properties:{bornIn:"New York, New York, USA", imdbId:"0060280", born:date('1952-01-01'), name:"Leo Bassi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hlsuu68ohBwrsPF6oKeDC1bEI24.jpg", url:"https://themoviedb.org/person/976644"}}, {tmdbId:"1902572", properties:{name:"Henri Behar", url:"https://themoviedb.org/person/1902572"}}, {tmdbId:"27200", properties:{imdbId:"0070305", name:"Maurizio Benazzo", url:"https://themoviedb.org/person/27200"}}, {tmdbId:"57676", properties:{bornIn:"Westwood, New Jersey, USA", imdbId:"0756218", born:date('1989-11-26'), name:"Katie Sagona", bio:"​From Wikipedia, the free encyclopedia.   \n\nKatie Sagona (born November 26, 1989) is an American actress.  She acted in a series of films and TV shows throughout the 1990s and 2000s, including You've Got Mail, In Dreams, Grumpier Old Men, Black and White, and she also played Johnny Depp's daughter in Donnie Brasco.  She was a Ford Model and appeared in Italian Vogue, and in print for Versace among many others...", url:"https://themoviedb.org/person/57676"}}, {tmdbId:"36217", properties:{bornIn:"Zagreb, Croatia", imdbId:"0001245", born:date('1955-09-07'), name:"Mira Furlan", bio:"​Mira Furlan is a leading actress of theatre, film and TV in the former Yugoslavia. \n\nShe emigrated to the U. S.  with her husband, Goran Gajić, in November 1991, due to the intolerable political circumstances in her homeland.  Ms.  Furlan starred in the Warner Brothers TV-series \"Babylon 5\" (1994) as \"Ambassador Delenn\" (Sci-Fi Universe Award for Best Supporting Actress in a Genre TV-series 1996 and 1997). \n\nMs.  Furlan's film credits include leading roles in over 25 films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/230eF35kgW0Jo2II1LmGPlRuw8a.jpg", url:"https://themoviedb.org/person/36217"}}, {tmdbId:"52302", properties:{bornIn:"Columbus, Ohio, USA", imdbId:"0081863", born:date('1960-03-18'), name:"Richard Biggs", bio:"Richard James Biggs II (March 18, 1960 – May 22, 2004) was an American television and stage actor, known for his roles on the television series Days of Our Lives and Babylon 5.  Born in Columbus, Ohio, Biggs attended the University of Southern California on scholarship, studying theatre.  He briefly taught at a Los Angeles high school before landing his first major television role, that of Dr.  Marcus Hunter on the soap opera Days of Our Lives...", died:date('2004-05-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tgdq475c79cegroGWlIq9RIib21.jpg", url:"https://themoviedb.org/person/52302"}}, {tmdbId:"92172", properties:{bornIn:"Auckland, New Zealand", imdbId:"0420279", born:date('1970-08-25'), name:"Aaron Jeffery", bio:"Aaron C.  Jeffery (born 1970) is a Logie Award winning New Zealand – Australian actor.   Born in Howick, Auckland, Jeffery moved to Australia at the age of 17 and studied acting at NIDA.   Jeffery has been in a relationship with his former McLeod's Daughters co-star Zoe Naylor since 2010. [1] The couple welcomed their first child together, a daughter called Sophia Jade Jeffery, in 2012. Jeffery also has another daughter from a previous relationship...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8mt7NCevggbt9kVL5NBuz630n4K.jpg", url:"https://themoviedb.org/person/92172"}}, {tmdbId:"80267", properties:{imdbId:"0814358", name:"Paul Sonkkila", url:"https://themoviedb.org/person/80267"}}, {tmdbId:"23621", properties:{bornIn:"London, England, UK", imdbId:"0853364", born:date('1987-03-06'), name:"Hannah Taylor Gordon", bio:"​From Wikipedia, the free encyclopedia\n\nHannah Taylor-Gordon (born 6 March 1987) is an English actress.  Best known for her role as the title character in Anne Frank: The Whole Story for which she received both an Emmy and a Golden Globe nomination.  She has appeared with small roles in Academy Award-nominated movies like Four Weddings and a Funeral (1994) and Mary Shelley's Frankenstein (1994).  She studies in LAMDA, an acting school of London...", url:"https://themoviedb.org/person/23621"}}, {tmdbId:"23622", properties:{bornIn:"Budapest, Hungary", imdbId:"0407285", born:date('1956-05-04'), name:"Éva Igó", bio:"Éva Igó is a Hungarian stage, film and television actress and singer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/llacNPREAEARviqeoE0ic2ilYi8.jpg", url:"https://themoviedb.org/person/23622"}}, {tmdbId:"23623", properties:{imdbId:"0126540", name:"István Bálint", url:"https://themoviedb.org/person/23623"}}, {tmdbId:"15441", properties:{bornIn:"Jerusalem, Israel", imdbId:"0000815", born:date('1972-03-30'), name:"Mili Avital", bio:"From Wikipedia, the free encyclopedia. \n\nMili Avital (Hebrew: מילי אביטל‎; born 30 March 1972) is an Israeli-American actress.  Avital built a successful international career.  She started in her native Israel, starring on stage, film and Television, winning the Israeli Academy Award for Best Supporting Actress in 1992, and nominated for Best Actress in 1994.  That year she moved to New York and started to work almost immediately in America.  She has maintained her career in both countries since...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eFiuHaLejLHOyUhA0EwKEoe0Nhw.jpg", url:"https://themoviedb.org/person/15441"}}, {tmdbId:"40279", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0001184", born:date('1971-09-30'), name:"Jenna Elfman", bio:"Jenna Elfman (born September 30, 1971, height 5' 10\" (1,78 m)) is an American television and film actress.  She is known for her role as Dharma on the ABC sitcom Dharma & Greg. \n\nDescription above from the Wikipedia article Jenna Elfman, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3w7iKOJnsKnxC0up8JpAmMHBlWR.jpg", url:"https://themoviedb.org/person/40279"}}, {tmdbId:"10871", properties:{bornIn:"New York City, New York, USA", imdbId:"0005169", born:date('1979-04-04'), name:"Natasha Lyonne", bio:"Natasha Bianca Lyonne Braunstein (born April 4, 1979), known professionally as Natasha Lyonne, is an American actress, writer, producer and director.  She is best known for her portrayal of Nicky Nichols in the Netflix series Orange Is the New Black (2013–2019), for which she received an Emmy Award nomination in 2014, and for her role as Jessica in the American Pie film series (1999–2012)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Ao3Tao5nCrJGvNiFyFrzZs0Iyzg.jpg", url:"https://themoviedb.org/person/10871"}}, {tmdbId:"2838", properties:{bornIn:"Springfield, Massachusetts, USA", imdbId:"0001721", born:date('1974-11-18'), name:"Chloë Sevigny", bio:"Chloë Stevens Sevigny (born November 18, 1974) is an American film actress, fashion designer and former model.  Sevigny became known for her broad fashion career in the mid-1990s, both for modeling and for her work at New York's Sassy magazine, which labeled her the new \"it girl\" at the time, garnering her attention within New York's fashion scene...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eM7KGAMCmZCzYDFV8gaSfknN675.jpg", url:"https://themoviedb.org/person/2838"}}, {tmdbId:"974", properties:{bornIn:"North London, England, UK", imdbId:"0002077", born:date('1966-01-31'), name:"Dexter Fletcher", bio:"Dexter Fletcher (born 31 January 1966) is an English actor and director.  He has appeared in Guy Ritchie's Lock, Stock and Two Smoking Barrels and the crime comedy Smoking Guns, as well as in television shows such as the comedy-drama Hotel Babylon, the HBO series Band of Brothers and, earlier in his career, the children's show Press Gang.  He was also in the film Bugsy Malone.  He had a short stint as a presenter on the third series of Channel 4's GamesMaster in 1993 and 1994...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yRI8MDB5sg8b8EZkzFz5cCBrnKL.jpg", url:"https://themoviedb.org/person/974"}}, {tmdbId:"975", properties:{bornIn:"East End, London, England, UK", imdbId:"0602941", born:date('1969-12-23'), name:"Nick Moran", bio:"Nicholas James \"Nick\" Moran is an English actor, writer, producer and director, best known for his role as Eddy the card shark in Lock, Stock, and Two Smoking Barrels.  He also appeared as Scabior in Harry Potter and the Deathly Hallows. \n\nMoran first hit the big screen in 1990 alongside Roger Daltrey and Chesney Hawkes, in Buddy's Song (1990).  Moran co-starred with John Hurt in New Blood (1999), and also starred with Joseph Fiennes, Sadie Frost and Tara FitzGerald in Rancid Aluminium (2000)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cwqrMbCE9ABFK8NhnK2DypEozr1.jpg", url:"https://themoviedb.org/person/975"}}, {tmdbId:"976", properties:{bornIn:"Shirebrook, Derbyshire, England, UK", imdbId:"0005458", born:date('1967-07-26'), name:"Jason Statham", bio:"Jason Statham (born 26.  Juli 1967) is an English actor and martial artist, known for his roles in the Guy Ritchie crime films Lock, Stock and Two Smoking Barrels; Revolver; and Snatch. \n\nStatham appeared in supporting roles in several American films, such as The Italian Job, as well as playing the lead role in The Transporter, Crank, The Bank Job, War (opposite martial arts star Jet Li), and Death Race...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lldeQ91GwIVff43JBrpdbAAeYWj.jpg", url:"https://themoviedb.org/person/976"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"585902", properties:{bornIn:"Nuova Zelanda", imdbId:"0032370", name:"Noel Appleby", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7yESBZZGlJ0A0LDQVlmCY3ABNdO.jpg", url:"https://themoviedb.org/person/585902"}}, {tmdbId:"1366", properties:{bornIn:"Wellington - New Zealand", imdbId:"1019674", born:date('1976-09-22'), name:"Sala Baker", bio:"Sala Baker is an actor and stuntman from Wellington, New Zealand.  Originally hired as one of several stunt performers for The Lord of the Rings film trilogy, he ended up landing the part of the Dark Lord Sauron.  In addition, he also played several Orcs, a Gondorian, and one of the Rohirrim.  Outside of the trilogy, Baker has performed in The Chronicles of Narnia: The Lion, the Witch and the Wardrobe and two Pirates of the Caribbean movies...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rLjJOiHjjpFkR9hySucXkSuEKQj.jpg", url:"https://themoviedb.org/person/1366"}}, {tmdbId:"22082", properties:{bornIn:"Purvis, Mississippi, USA", imdbId:"0000327", born:date('1982-09-30'), name:"Lacey Chabert", bio:"Lacey Nicole Chabert (born September 30, 1982) is an American actress, voice actress and singer.  She first gained prominence as a child actress for her role as Claudia Salinger in the television drama Party of Five (1994–2000)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ZoZlDteXk61YjED5vBsGXSL8um.jpg", url:"https://themoviedb.org/person/22082"}}, {tmdbId:"21029", properties:{bornIn:"Bellingham, Washington, USA", imdbId:"0121605", born:date('1966-11-25'), name:"Billy Burke", bio:"William Albert \"Billy\" Burke (born November 25, 1966) is an American actor.  He is known for his role as Charlie Swan in Twilight, The Twilight Saga: New Moon and the 2010 film The Twilight Saga: Eclipse.  He is also known for his role as Gary Matheson in the second season of 24...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pNkPfMV4f6Za6T2zBe6x2XIdkIb.jpg", url:"https://themoviedb.org/person/21029"}}, {tmdbId:"59789", properties:{bornIn:"Methuen, Massachusetts, USA", imdbId:"0317293", born:date('1965-06-11'), name:"Pamela Gidley", bio:"Pamela Catherine Gidley (born June 11, 1965) is an American actress and model. \n\nDescription above from the Wikipedia article Pamela Gidley , licensed under CC-BY-SA,full list of contributors on Wikipedia...", died:date('2018-04-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wvjae2TVyAejQTcItTHziRmaLRR.jpg", url:"https://themoviedb.org/person/59789"}}, {tmdbId:"147489", properties:{imdbId:"0410905", born:date('1961-10-22'), name:"Takaaki Ishibashi", url:"https://themoviedb.org/person/147489"}}, {tmdbId:"80494", properties:{imdbId:"0851767", name:"José María de Tavira", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x6qV0LQLWlioWwmldyZNMidUB51.jpg", url:"https://themoviedb.org/person/80494"}}, {tmdbId:"57374", properties:{imdbId:"0797225", name:"Diego Sieres", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yyhzuhWALlzhgXImQsveoiqAaYq.jpg", url:"https://themoviedb.org/person/57374"}}, {tmdbId:"1077815", properties:{imdbId:"0346020", name:"Emiliano Guerra", url:"https://themoviedb.org/person/1077815"}}, {tmdbId:"956973", properties:{imdbId:"0649872", name:"Yolanda Orisaga", url:"https://themoviedb.org/person/956973"}}, {tmdbId:"8687", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0564277", born:date('1961-09-23'), name:"Chi McBride", bio:"Kenneth \"Chi\" (pronounced \"shy\") McBride (born September 23, 1961) is an American actor.  He starred as Emerson Cod on the ABC series Pushing Daisies, and on Fox's drama Human Target. \n\nDescription above from the Wikipedia article Chi McBride, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8SZovWxZzQ78uQp2rNzU9fKyYJS.jpg", url:"https://themoviedb.org/person/8687"}}, {tmdbId:"33181", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0001751", born:date('1955-07-09'), name:"Jimmy Smits", bio:"From Wikipedia, the free encyclopedia. \n\nJimmy Smits (born July 9, 1955) is an American actor.  Smits is perhaps best known for his roles as attorney Victor Sifuentes on the 1980s legal drama L. A.  Law, as NYPD Detective Bobby Simone on the 1990s police drama NYPD Blue, and as U. S.  Congressman (and later President of the United States) Matt Santos on The West Wing.  He is also notable for his portrayal of Bail Organa in the Star Wars prequel trilogy, and Miguel Prado in Dexter...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yn4g0hjKPhHgZlW2TFzNmlP1zKf.jpg", url:"https://themoviedb.org/person/33181"}}, {tmdbId:"1771", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0000610", born:date('1974-12-17'), name:"Giovanni Ribisi", bio:"Giovanni Ribisi (born December 17, 1974) is an American actor.  His film credits include Gone in 60 Seconds, Boiler Room, Saving Private Ryan, The Mod Squad, The Gift, Sky Captain and the World of Tomorrow, Lost in Translation and more recently, Public Enemies and Avatar.  He is also known for his role as Phoebe Buffay's brother Frank on the sitcom Friends.  He also appeared in music videos for Crystal Ball by Keane and Talk About The Blues by The Jon Spencer Blues Explosion...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8EAiS9D3YtGOrwNM0OrwmDpWK7s.jpg", url:"https://themoviedb.org/person/1771"}}, {tmdbId:"15838", properties:{bornIn:"Manila, Philippines ", imdbId:"0758964", born:date('1971-02-22'), name:"Lea Salonga", bio:"From Wikipedia, the free encyclopedia. \n\nMaría Lea Carmen Imutan Salonga (born February 22, 1971), better known as Lea Salonga, is a Filipina singer and actress best known for her roles in musical theatre, for supplying the singing voices of two Disney Princesses, and as a recording artist and television performer, especially in the Philippines. \n\nDescription above from the Wikipedia Lea Salonga licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7tD73CUz9MYeOYIsTBGAAND16lS.jpg", url:"https://themoviedb.org/person/15838"}}, {tmdbId:"10345", properties:{bornIn:"Mokpo, South Korea", imdbId:"0644902", born:date('1943-06-29'), name:"Soon-Tek Oh", died:date('2018-04-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AmGOXn78x9v2vuRUlVWXlNuXtPX.jpg", url:"https://themoviedb.org/person/10345"}}, {tmdbId:"1445726", properties:{imdbId:"0613837", name:"Gheorghe Muresan", url:"https://themoviedb.org/person/1445726"}}, {tmdbId:"22108", properties:{bornIn:"Lynchburg, Virginia, USA", imdbId:"0000240", born:date('1970-01-20'), name:"Skeet Ulrich", bio:"Bryan Ray Trout (born January 20, 1970), best known as Skeet Ulrich, is an American actor best known for starring in the CBS drama Jericho as Jake Green and for portraying Billy Loomis in Scream.  He starred in the police and courtroom drama Law &amp; Order: LA for eleven episodes before being let go due to a creative overhaul. \n\nDescription above from the Wikipedia article Skeet Ulrich, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/r6dVYAnvCuSmUcDAgrHUJwtvx9y.jpg", url:"https://themoviedb.org/person/22108"}}, {tmdbId:"2859", properties:{bornIn:"Dallas, Texas, USA", imdbId:"0188687", born:date('1948-12-23'), name:"Gail Cronauer", bio:"Gail Cronauer is an American stage, television, and feature film actress and an acting professor.  She has performed films as diverse as Oliver Stone's JFK to the TV series, Walker, Texas Ranger.  She is a recipient of the 2007, Dallas Fort Worth Theater Critics Forum award, for her role in the Lyric Stage production, Master Class...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wTLEWlXbkd17gImST3kApddu973.jpg", url:"https://themoviedb.org/person/2859"}}, {tmdbId:"23659", properties:{bornIn:"Irvine, California, USA", imdbId:"0002071", born:date('1967-07-16'), name:"Will Ferrell", bio:"A graduate of the University of Southern California, Will Ferrell became interested in performing while a student at University High School in Irvine, California, where he made his school's daily morning announcements over the public address system in disguised voices...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sXT9uCw7ceIxTdmL9XqtuYdNmgM.jpg", url:"https://themoviedb.org/person/23659"}}, {tmdbId:"58317", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0441592", born:date('1970-10-19'), name:"Chris Kattan", bio:"Christopher Lee \"Chris\" Kattan  (born October 19, 1970) is an American actor/comedian, best known for his work on Saturday Night Live...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/feIeEWzlxYg6zVoVCSA8Egi34PR.jpg", url:"https://themoviedb.org/person/58317"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"214142", properties:{bornIn:"North Hollywood, California, USA", imdbId:"0307074", born:date('1970-03-18'), name:"Raquel Gardner", bio:"Raquel Gardner was born on March 18, 1970.  She is an actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/y4BuCcOjmLHkaxfagJJcN3QfOZz.jpg", url:"https://themoviedb.org/person/214142"}}, {tmdbId:"2224933", properties:{name:"Viveca Paulin", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kk9JcN9fjfxYonYbrUKhbCSYWLQ.jpg", url:"https://themoviedb.org/person/2224933"}}, {tmdbId:"149665", properties:{bornIn:"Memphis, Tennessee, USA", imdbId:"0733812", born:date('1971-12-05'), name:"Kali Rocha", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/f7KbFyacNW8SpGikARP99m6uT7B.jpg", url:"https://themoviedb.org/person/149665"}}, {tmdbId:"151260", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"0136760", born:date('1982-02-28'), name:"Lena Cardwell", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/duTJN2eg1geNLQMdBBR2GnJ4Vsi.jpg", url:"https://themoviedb.org/person/151260"}}, {tmdbId:"18262", properties:{bornIn:"Menomonee Falls, Wisconsin, USA", imdbId:"0726223", born:date('1948-05-12'), name:"Richard Riehle", bio:"An American actor.  Richard attended the University of Notre Dame, where he became heavily involved with the University Theatre...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dLVsIz74rTpNRgwFm8znMOVgWNI.jpg", url:"https://themoviedb.org/person/18262"}}, {tmdbId:"49265", properties:{bornIn:"New York City, New York, USA", imdbId:"0517820", born:date('1986-07-02'), name:"Lindsay Lohan", bio:"Lindsay Lohan (born July 2, 1986) is an American actress, pop singer and model.  She began her career as a child fashion model before making her motion picture debut in Disney's 1998 remake of The Parent Trap at the age of 11.  Lohan gained further fame between 2003 and 2005 with leading roles in the films Freaky Friday, Mean Girls and Herbie: Fully Loaded, subsequently appearing in independent films including Robert Altman's A Prairie Home Companion and Emilio Estevez's Bobby...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rVANXIDawwRZxvxDpJQtH4c3j2g.jpg", url:"https://themoviedb.org/person/49265"}}, {tmdbId:"55422", properties:{bornIn:"Oak Ridge, Tennessee, USA", imdbId:"0005006", born:date('1970-12-28'), name:"Elaine Hendrix", bio:"Elaine Hendrix is an American film and television actress, producer, singer and dancer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ajnxlCCO0IYQeaL2KOJwjFWkFG0.jpg", url:"https://themoviedb.org/person/55422"}}, {tmdbId:"49", properties:{bornIn:"Norristown, Pennsylvania, USA", imdbId:"0004742", born:date('1967-04-18'), name:"Maria Bello", bio:"Maria Elena Bello (born April 18, 1967)  is an American actress and singer.  She started her acting career in small off-Broadway plays, such as The Killer Inside Me, Small Town Gals with Big Problems, and Urban Planning.   Bello's big break came when producers Kerry Lenhart and John J.  Sakmar cast her as Mrs.  Smith in the spy show Mr.  & Mrs.  Smith...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tFkbad0JoWvYc6XYBITv6EfeLwR.jpg", url:"https://themoviedb.org/person/49"}}, {tmdbId:"88597", properties:{bornIn:"New York City - New York - USA", imdbId:"0667350", born:date('1978-05-29'), name:"Jay Paulson", bio:"From Wikipedia, the free encyclopedia. \n\nJoseph Andrew \"Jay\" Hughes Paulson (born in St.  Luke's-Roosevelt Hospital, Manhattan, on May 29, 1978) is an American actor.  Jay graduated UCLA in 2001 with B. A.  in History and is a lifetime member of The Actors Studio.  He also ran the 22nd Annual Los Angeles Marathon in 4:50:13, March 4, 2007.  He is a practicing Theravadin Buddhist.  He is also a vegan and is married to Courtney Paulson née Kohl, July 19, 2008...", url:"https://themoviedb.org/person/88597"}}, {tmdbId:"49275", properties:{bornIn:" Los Angeles, California, USA", imdbId:"0308208", born:date('1963-09-19'), name:"Spencer Garrett", bio:"From Wikipedia, the free encyclopedia.  Spencer Garrett (born September 19, 1963) is an American actor who has appeared in television programs, television films, films, and a few blockbuster productions like Transformers: Revenge of the Fallen, Public Enemies, and Air Force One...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jJWISea4PvC9Mv5kWONAMKhEK7j.jpg", url:"https://themoviedb.org/person/49275"}}, {tmdbId:"7523", properties:{bornIn:"Montréal, Québec, Canada", imdbId:"0319698", born:date('1971-11-30'), name:"Jessalyn Gilsig", bio:"From Wikipedia, the free encyclopedia. \n\nJessalyn Gilsig (born November 30, 1971)  is a Canadian actress known for her roles in the television series Boston Public, Nip/Tuck and as Will Schuester's ex-wife Terri Schuester in Glee.  She has also appeared in several episodes of NYPD Blue, Prison Break, and Heroes as well as several other series. \n\nDescription above from the Wikipedia article Jessalyn Gilsig, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uEApWb9gsIFMZKSxKFklpFW25Wi.jpg", url:"https://themoviedb.org/person/7523"}}, {tmdbId:"141715", properties:{bornIn:"Bologna, Italy", imdbId:"0337211", born:date('1961-07-28'), name:"Irene Grazioli", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/g9kam3z9DHeCSnvTir1clUEz8qL.jpg", url:"https://themoviedb.org/person/141715"}}, {tmdbId:"141716", properties:{imdbId:"0491315", name:"Anita Laurenzi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/owIk2gGhUNcmNHwbuL0R8dK4M5w.jpg", url:"https://themoviedb.org/person/141716"}}, {tmdbId:"141717", properties:{imdbId:"0700610", name:"Tommaso Puntelli", url:"https://themoviedb.org/person/141717"}}, {tmdbId:"146784", properties:{imdbId:"1011675", name:"Ryan McCluskey", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2pguRx0dn6DBZPqDg3oieSoo2DO.jpg", url:"https://themoviedb.org/person/146784"}}, {tmdbId:"1104994", properties:{imdbId:"0668994", name:"Oscar Pearce", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z6OOMofeqYdq6TlamNXlILm9wPR.jpg", url:"https://themoviedb.org/person/1104994"}}, {tmdbId:"232174", properties:{bornIn:"London, United Kingdom", imdbId:"0654049", born:date('1967-09-27'), name:"Indra Ové", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wDfCsmdCE4PwSPZoONC3JgssA2B.jpg", url:"https://themoviedb.org/person/232174"}}, {tmdbId:"195535", properties:{imdbId:"0093319", name:"Anna Bolt", url:"https://themoviedb.org/person/195535"}}, {tmdbId:"2131", properties:{bornIn:"New York City, New York, USA", imdbId:"0504962", born:date('1970-01-21'), name:"Ken Leung", bio:"Kenneth \"Ken\" Leung (born January 21, 1970) is an American actor best known for his role as Miles Straume in the ABC television series Lost and roles in such films as Shanghai Kiss, Rush Hour, X-Men: The Last Stand, and Saw. \n\nDescription above from the Wikipedia article Ken Leung, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/r2fMMlzSxTvcHFfDesF1AuPdZAz.jpg", url:"https://themoviedb.org/person/2131"}}, {tmdbId:"21629", properties:{bornIn:"Hong Kong, British Crown Colony [now China]", imdbId:"0002245", born:date('1962-06-10'), name:"Tzi Ma", bio:"Tzi Ma (born June 10, 1962) is a Chinese American film and television actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x4fz0LCIiBNGdil3nBYO22W7QJ0.jpg", url:"https://themoviedb.org/person/21629"}}] AS row
