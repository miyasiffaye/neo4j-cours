UNWIND [{tmdbId:"25663", properties:{bornIn:"London, England, UK", imdbId:"1032473", born:date('1990-05-16'), name:"Thomas Brodie-Sangster", bio:"Thomas Brodie-Sangster (born 16 May 1990) is an English film and television actor, best known for his roles in Love Actually, Nanny McPhee, Nowhere Boy, and The Maze Runner.  He also provides the voice of Ferb in the animated Disney show Phineas and Ferb...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sMw8Jh8m7O4u0Ige2Kqp3wM5vlZ.jpg", url:"https://themoviedb.org/person/25663"}}, {tmdbId:"12792", properties:{bornIn:"Waukegan, Illinois, USA", imdbId:"0887144", born:date('1969-07-06'), name:"Brian Van Holt", bio:"Brian Van Holt (born July 6, 1969) is an American actor and advertising model...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vLLhqw1UHMYvzhPGfQKGbbjWnlq.jpg", url:"https://themoviedb.org/person/12792"}}, {tmdbId:"38406", properties:{bornIn:"New York City, New York, USA", imdbId:"0385296", born:date('1981-02-17'), name:"Paris Hilton", bio:"Paris Whitney Hilton (born February 17, 1981) is an American socialite, heiress, media personality, model, singer, author, fashion designer and actress.  She is a great-granddaughter of Conrad Hilton (founder of Hilton Hotels).  Hilton is known for her controversial participation in a sex tape in 2003, and appearance on the television series The Simple Life alongside fellow socialite and childhood best friend Nicole Richie...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aCD1dCivkuW1DLQwfzl7OqnmCJi.jpg", url:"https://themoviedb.org/person/38406"}}, {tmdbId:"62064", properties:{bornIn:"Los Angeles, California, USA", imdbId:"1517976", born:date('1980-08-26'), name:"Chris Pine", bio:"Christopher Whitelaw \"Chris\" Pine (born August 26, 1980) is an American actor.  He has appeared in the romantic comedies The Princess Diaries 2: Royal Engagement (2004) and Just My Luck (2006), as well as the action films Smokin' Aces (2007) and Unstoppable (2010).  In 2009, he portrayed James T.  Kirk in the film Star Trek...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ipG3BMO8Ckv9xVeEY27lzq975Qm.jpg", url:"https://themoviedb.org/person/62064"}}, {tmdbId:"19664", properties:{bornIn:"Tokyo, Japan", imdbId:"1027847", born:date('1980-10-31'), name:"Samaire Armstrong", bio:"Samaire Armstrong is a Japanese-born American actress, fashion designer and model.  She has also appeared in music videos for Penny and Me by Hanson and Bad Day by Daniel Powter...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8hKUnwInxuNx2219IxDwCwOB7oA.jpg", url:"https://themoviedb.org/person/19664"}}, {tmdbId:"56455", properties:{bornIn:"Anaheim, California, USA", imdbId:"1291227", born:date('1975-09-20'), name:"Moon Bloodgood", bio:"Moon Bloodgood (born September 20, 1975) is an American actress and model.  She starred as \"Lt.  Blair Williams\" in the film Terminator Salvation alongside Christian Bale and Sam Worthington.  Bloodgood previously starred in the films Eight Below and Pathfinder. \n\nDescription above from the Wikipedia article Moon Bloodgood , licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/akOHCXJtQpgLIWaPwKaR34lkqFT.jpg", url:"https://themoviedb.org/person/56455"}}, {tmdbId:"19855", properties:{imdbId:"1797214", born:date('1993-08-05'), name:"Suzuka Ohgo", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2GjYt8E29ZvesCPjGB4JmtYcfQv.jpg", url:"https://themoviedb.org/person/19855"}}, {tmdbId:"548619", properties:{imdbId:"0302320", name:"Stirling Gallacher", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gKYbbEbB95AkClkTJ9vWqMFbKZZ.jpg", url:"https://themoviedb.org/person/548619"}}, {tmdbId:"76594", properties:{bornIn:"Franklin, Tennessee, USA", imdbId:"1415323", born:date('1992-11-23'), name:"Miley Cyrus", bio:"Miley Ray Cyrus (born Destiny Hope Cyrus; November 23, 1992) is an American actress and pop singer.  She achieved wide fame for her role as Miley Stewart/Hannah Montana on the Disney Channel sitcom Hannah Montana.  Cyrus recorded music for the soundtracks, Hannah Montana (2006) and Hannah Montana 2/Meet Miley Cyrus (2007), released by Walt Disney Records.  With the success of the Hannah Montana franchise she established herself as a teen idol...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8ljHoL9C4a5cFf1IP75J0kkxH1E.jpg", url:"https://themoviedb.org/person/76594"}}, {tmdbId:"56910", properties:{bornIn:"New York City - New York - USA", imdbId:"0261435", born:date('1955-05-31'), name:"Susie Essman", bio:"From Wikipedia, the free encyclopedia. \n\nSusan \"Susie\" Essman (born May 31, 1955) is an American stand-up comedian, actress, writer, television producer, and voice artist.  She is best known for her role as Susie Greene on the HBO television sitcom Curb Your Enthusiasm.  She is also well-known for her portrayal of \"Mittens\" in Bolt...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eOuK6IKfgNX3nU9ZcWcMWbcMXtq.jpg", url:"https://themoviedb.org/person/56910"}}, {tmdbId:"61423", properties:{bornIn:"Salt Lake City, Utah, USA", imdbId:"0910559", born:date('1968-10-24'), name:"Mark Walton", bio:"From Wikipedia, the free encyclopedia.   Mark Walton (born October 24, 1968) is a story artist and voice actor at the Walt Disney Feature Animation.  Walton is best known for voicing Rhino the hamster in Bolt. \n\nDescription above from the Wikipedia article Mark Walton, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/61423"}}, {tmdbId:"56542", properties:{bornIn:"Philadelphia, Pennsylvania, USA ", imdbId:"1789970", born:date('1991-06-29'), name:"Addison Timlin", bio:"Addison Jayne Timlin (born June 29, 1991) is an American actress, best known for her roles as Jami Lerner in The Town That Dreaded Sundown and Colleen Lunsford in Little Sister.  She is also known for playing Sasha Bingham in Showtime's Californication...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ropQg0oZZP0R3xkWxYNdMx8glHi.jpg", url:"https://themoviedb.org/person/56542"}}, {tmdbId:"69899", properties:{bornIn:"Lake Charles, Louisiana, USA", imdbId:"1157048", born:date('1980-09-29'), name:"Zachary Levi", bio:"An American television actor, director, and singer known for the roles of Kipp Steadman in Less than Perfect, Chuck Bartowski in Chuck, and Flynn Rider in Tangled. \n\nDescription above from the Wikipedia article Zachary Levi, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1W8L3kEMMPF9umT3ZGaNIiCYKfZ.jpg", url:"https://themoviedb.org/person/69899"}}, {tmdbId:"2517", properties:{bornIn:"Corona, New York, USA", imdbId:"0614220", born:date('1959-03-07'), name:"Donna Murphy", bio:"​From Wikipedia, the free encyclopedia\n\nDonna Murphy (born March 7, 1959) is an American stage, film, television actress and singer.  Murphy has won two Tony Awards for Best Actress in a Musical for her roles in Passion as Fosca and in The King and I as Anna Leonowens.  She received three more Tony Award nominations for Best Actress in a Musical for her performances in Wonderful Town as Ruth Sherwood,Lovemusik as Lotte Lenya and The People in the Picture as Raisel/Bubbie...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tmre2oZkIHGqnLhWeldpX2Ujgl0.jpg", url:"https://themoviedb.org/person/2517"}}, {tmdbId:"101416", properties:{bornIn:"Olathe, Kansas, USA", imdbId:"0573354", born:date('1978-10-21'), name:"Michael McMillian", bio:"Michael McMillian (born October 21, 1978) is an American actor and writer, known for his roles as Henry Gibson on What I Like About You and Steve Newlin on the HBO series True Blood.  McMillian is also the creator and writer of the comic book, Lucid, for Before the Door Pictures and Archaia Studios Press...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8uS5Mi7aIVuF5XWARbX9EeBRQZN.jpg", url:"https://themoviedb.org/person/101416"}}, {tmdbId:"109174", properties:{imdbId:"0168398", name:"Lea Coco", bio:"Lea Coco is an actor and writer...", url:"https://themoviedb.org/person/109174"}}, {tmdbId:"26867", properties:{bornIn:"Hartlepool, England", imdbId:"0282117", born:date('1972-07-26'), name:"Steve Fletcher", bio:"From Wikipedia, the free encyclopedia. \n\nSteven Mark Fletcher (born 26 July 1972) was an English professional footballer born in Hartlepool who is currently in his second spell for Bournemouth, the club where he has spent the majority of his career.  He now assistant manager at the club under Lee Bradbury.  He announced his retirement 22nd May 2011, after admitting he hated Bournemouth and was too scared to keep playing.  He also had a spell working at the Bournemouth Pizza Hut...", url:"https://themoviedb.org/person/26867"}}, {tmdbId:"109175", properties:{imdbId:"1555022", name:"Mo Quigley", url:"https://themoviedb.org/person/109175"}}, {tmdbId:"1127469", properties:{imdbId:"1356769", name:"Shake Tukhmanyan", url:"https://themoviedb.org/person/1127469"}}, {tmdbId:"10843", properties:{bornIn:"London, England, UK", imdbId:"0331577", born:date('1968-09-29'), name:"Luke Goss", bio:"From Wikipedia, the free encyclopedia. \n\nLuke Damon Goss (born 29 September 1968) is an English singer and actor.  Since 1994, he has been married to backing singer Shirley Lewis, (who has worked with singers Elton John, George Michael, Luther Vandross, and many others), and has one stepdaughter, Carli.  In January 2007, he and wife Shirley moved permanently to Los Angeles, but still maintain a residence in London...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bHdc67gZFzZ7RJmgYbMtfaCOT4R.jpg", url:"https://themoviedb.org/person/10843"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"359229", properties:{imdbId:"0502834", name:"Louie Leonardo", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7aKOp6pnAMSlGgowNEsrSmeQagm.jpg", url:"https://themoviedb.org/person/359229"}}, {tmdbId:"91302", properties:{bornIn:"Cerritos, California, USA", imdbId:"0020354", born:date('1974-06-05'), name:"Chad Allen", bio:"​From Wikipedia, the free encyclopedia\n\nChad Allen (born June 5, 1974) is an American actor.  Performing since he was a child, Allen is perhaps best known for his role as Matthew Cooper on the television series Dr.  Quinn: Medicine Woman from 1993 to 1998. \n\nDescription above from the Wikipedia article Chad Allen (actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/91302"}}, {tmdbId:"162892", properties:{imdbId:"0349993", born:date('1978-06-21'), name:"Jack Guzman", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/y9slFhZT5ZHEwUUrtOH6AjUEyqR.jpg", url:"https://themoviedb.org/person/162892"}}, {tmdbId:"55425", properties:{bornIn:"New York City, New York, U.S.", imdbId:"0101152", born:date('1971-05-30'), name:"John Ross Bowie", bio:"John Ross Bowie (born May 30, 1971) is an American actor and comedian best known for playing Barry Kripke in The Big Bang Theory, and modeling as the benefits spokesperson for Target Corporation \"Ben E.  Fitz\".  He has also appeared in commercials for Progressive and appeared in the film What The Bleep Do We Know? opposite Marlee Matlin.  He has also made guest appearances on shows such as Reno 911 and Glee.  In March 2011 he began a run in a series of commercials for the Ford Motor Company...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/XAv1RilHZu7qiGGIOgikrLgHeD.jpg", url:"https://themoviedb.org/person/55425"}}, {tmdbId:"55426", properties:{bornIn:"Minneapolis, Minnesota, USA", imdbId:"0047121", born:date('1990-10-20'), name:"Robert Bailey Jr.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5ABLtJ9WJ81AzW5zctxtfI6Gu92.jpg", url:"https://themoviedb.org/person/55426"}}, {tmdbId:"2684", properties:{bornIn:"Vancouver, British Columbia, Canada", imdbId:"0891275", born:date('1976-06-23'), name:"Emmanuelle Vaugier", bio:"Emmanuelle Vaugier is a Canadian film actress, singer, songwriter and television actress who has had recurring roles on CSI:NY, Two and a Half Men, and Smallville...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3wGefsb5WrQPPXVM6egqIKOwfIq.jpg", url:"https://themoviedb.org/person/2684"}}, {tmdbId:"16807", properties:{bornIn:"Wroclaw, Dolnoslaskie, Poland", imdbId:"0992883", born:date('1980-03-29'), name:"Natalia Avelon", bio:"From Wikipedia, the free encyclopedia. \n\nNatalia Avelon (born March 29, 1980) is a Polish-German actress and singer. \n\nDescription above from the Wikipedia article Natalia Avelon, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uhTh7X4v8ZCuw6EKVVMieturM0T.jpg", url:"https://themoviedb.org/person/16807"}}, {tmdbId:"56563", properties:{imdbId:"0680568", name:"Lara Phillips", bio:"​From Wikipedia, the free encyclopedia.   \n\nLara Phillips is a film and TV series actress, mostly known for her lead roles in independent films such as Kwik Stop in 2001 and The Aviary in 2005. \n\nPhillips was raised in Ann Arbor, Michigan, USA, where she graduated from the alternative Community High School in 1990.  In 1994, Phillips earned a BFA degree in acting from the DePaul University Theatre School in Chicago, Illinois...", url:"https://themoviedb.org/person/56563"}}, {tmdbId:"56564", properties:{imdbId:"1484983", name:"Bill Noble", bio:"​From Wikipedia, the free encyclopedia.   \n\nBill Noble was an Australian international representative rugby league footballer.  He played club football in the New South Wales Rugby Football League premiership's very first season with Newtown.  That year he was also selected to play for Australia, making his full international debut against New Zealand the following year...", url:"https://themoviedb.org/person/56564"}}, {tmdbId:"32885", properties:{bornIn:"Canada", imdbId:"0194788", born:date('1950-06-25'), name:"Michel Côté", url:"https://themoviedb.org/person/32885"}}, {tmdbId:"71507", properties:{bornIn:"Montréal, Québec, Canada", imdbId:"0343082", born:date('1984-03-11'), name:"Marc-André Grondin", bio:"Marc-André Grondin (born March 11, 1984 in Montreal, Quebec) is a Canadian actor, most noted for his performance as Zachary Beaulieu in Jean-Marc Vallée's film C. R. A. Z. Y.  (2005), for which he won a Jutra award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zDhXXY7f1nJlejdKcYOhMWmyoVu.jpg", url:"https://themoviedb.org/person/71507"}}, {tmdbId:"232137", properties:{imdbId:"0698921", born:date('1952-10-12'), name:"Danielle Proulx", bio:"Danielle Proulx (born October 12, 1952 in Montreal, Quebec) is a French Canadian actress.  She is multi-award winning actress and she was married to Raymond Cloutier.  Her son, Émile Proulx-Cloutier, is also an actor.  She also has a niece, Catherine Proulx-Lemay, who is an actress.  She won a Genie Award for her supporting role in the Best Picture-winner C. R. A. Z. Y. . \n\nDescription above from the Wikipedia article Danielle Proulx, licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fcSWJibnKHK5ZI1aOYEVtVmXr2B.jpg", url:"https://themoviedb.org/person/232137"}}, {tmdbId:"69369", properties:{imdbId:"1588828", name:"Émile Vallée", url:"https://themoviedb.org/person/69369"}}, {tmdbId:"68918", properties:{bornIn:"Adachi, Tokyo", imdbId:"0461981", born:date('1973-05-25'), name:"Ai Kobayashi", bio:"From Wikipedia, the free encyclopedia. \n\nAi Kobayashi (born May 25, 1973) is a Japanese voice actress from Adachi, Tokyo.  She is affiliated with HeaT...", url:"https://themoviedb.org/person/68918"}}, {tmdbId:"70098", properties:{bornIn:"Yokohama, Japan", imdbId:"0467558", born:date('1957-12-19'), name:"Jûrôta Kosugi", bio:"Jūrōta Kosugi is a Japanese voice actor.  His deep voice is often used for rough and imposing characters...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/em3Zh1IzkTDSdaoGBVLx89u6GuI.jpg", url:"https://themoviedb.org/person/70098"}}, {tmdbId:"70099", properties:{bornIn:"Hirano, Osaka Prefecture, Japan", imdbId:"1124112", born:date('1970-09-13'), name:"Yuki Matsuoka", bio:"Yuki Matsuoka is a Japanese voice actress affiliated with Production Baobab...", url:"https://themoviedb.org/person/70099"}}, {tmdbId:"20313", properties:{bornIn:"Kanagawa Prefecture, Japan", imdbId:"0594274", born:date('1982-03-12'), name:"Asumi Miwa", url:"https://themoviedb.org/person/20313"}}, {tmdbId:"8789", properties:{bornIn:"Neuilly-sur-Seine, Hauts-de-Seine, France", imdbId:"0023832", born:date('1965-10-25'), name:"Mathieu Amalric", bio:"​From Wikipedia, the free encyclopedia.   \n\nMathieu Amalric (born 25 October 1965) is a French actor and film director, perhaps best known internationally for his performance in The Diving Bell and the Butterfly, for which he drew critical acclaim.  He also has won the Étoile d'or and the Lumière Award. \n\nDescription above from the Wikipedia article Mathieu Amalric, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ltVinTTE21sdOR8uLlGN5SsyCXI.jpg", url:"https://themoviedb.org/person/8789"}}, {tmdbId:"7276", properties:{bornIn:"Alençon, Orne, France", imdbId:"0175931", born:date('1963-05-25'), name:"Anne Consigny", bio:"Anne Consigny is a French film and television actress, best known for her feature film roles of Françoise in \"Je ne suis pas là pour être aimé\" as well as Claude in \"The Diving Bell and the Butterfly\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jkWnYMih7sHDjkvsCBUOLJiT8jg.jpg", url:"https://themoviedb.org/person/7276"}}, {tmdbId:"22163", properties:{imdbId:"0612127", name:"Florence Muller", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6DAKS8xAIgVOE831jyTbzhhpigV.jpg", url:"https://themoviedb.org/person/22163"}}] AS row
