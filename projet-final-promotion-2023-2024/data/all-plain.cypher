UNWIND [{tmdbId:"32458", properties:{bornIn:"Middlebury, Vermont", imdbId:"0542759", born:date('1972-05-14'), name:"Gabriel Mann", bio:"Gabriel Mann (born May 14, 1972) is an American actor and former fashion model. \n\nDescription above from the Wikipedia article Gabriel Mann (actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mrqiMfwoQnLBGGP3zvfHrwPKHJW.jpg", url:"https://themoviedb.org/person/32458"}}, {tmdbId:"18313", properties:{bornIn:"Long Island - New York - USA", imdbId:"0728346", born:date('1960-11-27'), name:"Michael Rispoli", bio:"From Wikipedia, the free encyclopedia.   Michael Rispoli (born November 27, 1960) is an American character actor.  He was formerly part of the HBO television series The Sopranos as Jackie Aprile, Sr.  Rispoli recently reunited with The Sopranos co-star James Gandolfini in the 2009 thriller The Taking of Pelham 1 2 3. \n\nRispoli, a second-generation Italian American, was born in Long Island, New York, one of eight children...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4rtCKJTtPq9cSHFQqZSbyCLLWCO.jpg", url:"https://themoviedb.org/person/18313"}}, {tmdbId:"1985", properties:{imdbId:"0931654", born:date('1972-02-29'), name:"Saul Williams", bio:"From Wikipedia, the free encyclopedia\n\nSaul Stacey Williams (born February 29, 1972) is an American poet, writer, actor and musician known for his blend of poetry and alternative hip hop and for his leading role in the 1998 independent film Slam. \n\nDescription above from the Wikipedia article Saul Williams, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/1985"}}, {tmdbId:"203683", properties:{bornIn:"Newport News, Virginia", imdbId:"0812308", born:date('1964-01-01'), name:"Sonja Sohn", bio:"From Wikipedia, the free encyclopedia.  Sonja Sohn is an American actress and community activist.  She is best known for her role as Detective Kima Greggs on the hit HBO drama The Wire, which has led to her current work as the leader of the Baltimore community initiative ReWired for Change.   She is currently starring as Detective Samantha Baker on the ABC drama series Body of Proof...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ywx9VUp66kr7vt3xiSKHRtYBjw1.jpg", url:"https://themoviedb.org/person/203683"}}, {tmdbId:"104789", properties:{imdbId:"0540395", name:"Bonz Malone", url:"https://themoviedb.org/person/104789"}}, {tmdbId:"64908", properties:{bornIn:"Los Angeles, California, United States", imdbId:"0004986", born:date('1964-03-25'), name:"LisaGay Hamilton", bio:"From Wikipedia, the free encyclopedia. \n\nLisa Gay Hamilton (born March 25, 1964) is an American film, television, and theater actress known for her role as attorney Rebecca Washington on the ABC legal drama The Practice, and for her critically acclaimed performance as young Sethe in Jonathan Demme's film adaptation of Toni Morrison's Beloved.  Her theater credits include Measure for Measure (Isabella), Henry IV Parts I & II (Lady Hotspur), Athol Fugard’s, Valley Song and The Ohio State Murders...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bqfowff4gF0cGaQ1c7F89HAL3DH.jpg", url:"https://themoviedb.org/person/64908"}}, {tmdbId:"77174", properties:{bornIn:"Kennesaw, Georgia, USA", imdbId:"0504516", born:date('1970-08-04'), name:"Ron Lester", died:date('2016-06-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cfHRgHSVhBuhijpn8csJuCOwyV3.jpg", url:"https://themoviedb.org/person/77174"}}, {tmdbId:"154520", properties:{imdbId:"0313530", name:"Matt George", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ckt5PH6XaPYjwNjrdYKKc5TRd4S.jpg", url:"https://themoviedb.org/person/154520"}}, {tmdbId:"214613", properties:{imdbId:"0514976", name:"Matty Liu", url:"https://themoviedb.org/person/214613"}}, {tmdbId:"980328", properties:{imdbId:"0867051", name:"Shaun Tomson", url:"https://themoviedb.org/person/980328"}}, {tmdbId:"89177", properties:{bornIn:"Tokyo, Japan", imdbId:"0298576", born:date('1923-03-17'), name:"Eiji Funakoshi", bio:"From Wikipedia, the free encyclopedia.    \n\nEiji Funakoshi (  17 March 1923 - 17 March 2007) was a Japanese actor.  He received the Kinema Junpo Awards for Best Actor and the Mainichi Film Concours for Best Actor for his performance in Fires on the Plain. \n\nDescription above from the Wikipedia article Eiji Funakoshi , licensed under CC-BY-SA,full list of contributors on Wikipedia...", died:date('2007-03-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/afpFg4ubN8PRRkOoO9vmoOTPuOZ.jpg", url:"https://themoviedb.org/person/89177"}}, {tmdbId:"81276", properties:{bornIn:"Taipai, Taiwan", imdbId:"0585637", born:date('1944-03-26'), name:"Mako Midori", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bXuaYnl8TU7QTPePz2iV7nlv8Yj.jpg", url:"https://themoviedb.org/person/81276"}}, {tmdbId:"106161", properties:{bornIn:"Setagaya, Tokyo, Japan", imdbId:"0784279", born:date('1922-05-29'), name:"Noriko Sengoku", died:date('2012-12-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cXgruyEbM6sU57jjpzDb8pmGuoe.jpg", url:"https://themoviedb.org/person/106161"}}, {tmdbId:"55546", properties:{bornIn:"Passaic, New Jersey, USA", imdbId:"0917962", born:date('1977-06-05'), name:"Liza Weil", bio:"Liza Rebecca Weil (born June 5, 1977) is an film and television American actress.  She is known for her roles as Paris Geller in the television drama Gilmore Girls and Bonnie Winterbottom in the legal drama How to Get Away with Murder...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5KK2W2qbGALTfrjWktbVsKTUud0.jpg", url:"https://themoviedb.org/person/55546"}}, {tmdbId:"168971", properties:{born:date('1973-11-30'), name:"Chad Morgan", url:"https://themoviedb.org/person/168971"}}, {tmdbId:"1393715", properties:{bornIn:"Abington, Pennsylvania, USA", imdbId:"0744073", name:"Kathryn Rossetter", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ArS8RQQojp3aTU5e1lcoMkRoaR1.jpg", url:"https://themoviedb.org/person/1393715"}}, {tmdbId:"10055", properties:{bornIn:"Rio de Janeiro, Rio de Janeiro, Brazil", imdbId:"0005244", born:date('1929-10-16'), name:"Fernanda Montenegro", bio:"Fernanda Montenegro (born Arlete Pinheiro Esteves da Silva; October 16, 1929) is a Brazilian stage, television and film actress, mostly recognized for her leading role in Central Station, which she was nominated for the Academy Award for Best Actress, becoming the first Brazilian actor to be nominated. \n\nShe is commonly revered as one of Brazil's finest actresses and referred to as \"The First Lady of Brazilian Theater\" and \"The First Lady of Brazilian Television\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bja0rn1BjAnA5Z5VbEvL2apvMT5.jpg", url:"https://themoviedb.org/person/10055"}}, {tmdbId:"10057", properties:{bornIn:"Rio de Janeiro, Rio de Janeiro, Brazil", imdbId:"0702479", born:date('1943-01-22'), name:"Marília Pêra", bio:"Marília Pêra was a Brazilian actress hailed as \"one of the decade's [1980s] ten best actresses\" by Pauline Kael.  Pêra won the National Society of Film Critics Award for Best Actress in 1982 for her role in Hector Babenco's acclaimed Pixote, and received Best Actress awards at the Gramado Film Festival (Triple Award Winner) and at the Cartegena Film Festival for Carlos Diegues' Better Days Ahead.  Other films include Bar Esperança, Angels of the Night and Diegues' Tieta do Agreste...", died:date('2015-12-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9gxyrjoTlBPjEp6SnISeFU4hVMs.jpg", url:"https://themoviedb.org/person/10057"}}, {tmdbId:"10059", properties:{bornIn:"Rio de Janeiro, Rio de Janeiro, Brazil", imdbId:"0646737", born:date('1985-07-18'), name:"Vinícius de Oliveira", bio:"Vinícius de Oliveira (born July 18, 1985) is a Brazilian actor.  He was born in Rio de Janeiro.  He lived in Bonsucesso, Rio de Janeiro with his mother, who had to work hard to support him and his three siblings.  To make ends meet, he even started working as a shoe shiner, always dreaming of becoming a professional football player...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7C2Po6guvHji9na2VIlWhu5quAv.jpg", url:"https://themoviedb.org/person/10059"}}, {tmdbId:"10060", properties:{bornIn:"Cajazeiras, Paraíba, Brazil", imdbId:"0513913", born:date('1962-03-06'), name:"Soia Lira", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/omMVXaJv8DgkdpAl1JLKLZ9QhE8.jpg", url:"https://themoviedb.org/person/10060"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"29298", properties:{bornIn:"Toronto - Ontario - Canada", imdbId:"0005202", born:date('1963-04-18'), name:"Eric McCormack", bio:"Eric James McCormack (born April 18, 1963, height 5' 11\" (1,80 m)) is a Canadian American actor, musician, writer and producer.  Born in Toronto, he began his acting career performing in school plays at Stephen Leacock Collegiate Institute High School.  He left Ryerson University in 1985, in order to accept a position with the Stratford Shakespeare Festival, where he spent five years performing in numerous play productions. \n\nFor much of the late 1990s, he lived in Los Angeles and had minor roles...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nAVgJZeptg0ay0adsYhnrGf9Jsc.jpg", url:"https://themoviedb.org/person/29298"}}, {tmdbId:"56166", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"0107808", name:"Carl Bressler", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/g4ZIiRNlF2u1pamX65B28VuFunH.jpg", url:"https://themoviedb.org/person/56166"}}, {tmdbId:"179646", properties:{bornIn:"Modesto, California, USA", imdbId:"0322238", born:date('1984-05-30'), name:"Ethan Glazer", url:"https://themoviedb.org/person/179646"}}, {tmdbId:"45395", properties:{imdbId:"0291522", name:"Phyllis Franklin", url:"https://themoviedb.org/person/45395"}}, {tmdbId:"4758", properties:{bornIn:"Burbank, California, U.S.", imdbId:"0004921", born:date('1967-10-29'), name:"Joely Fisher", bio:"From Wikipedia, the free encyclopedia. \n\nJoely Fisher (born October 29, 1967) is an American actress best known for her work on television as Paige Clark on Ellen as well as Joy Stark in the Fox sitcom 'Til Death, and also on stage and in films...", url:"https://themoviedb.org/person/4758"}}, {tmdbId:"32362", properties:{bornIn:"Perth Amboy, New Jersey, USA", imdbId:"0000954", born:date('1962-03-02'), name:"Jon Bon Jovi", bio:"From Wikipedia, the free encyclopedia. \n\nJon Bon Jovi (born John Francis Bongiovi, Jr. ; March 2, 1962) is an American musician, singer, songwriter, and actor, best known as the founder and lead singer of Bon Jovi.  Throughout his career, he has released two solo albums and eleven studio albums with his band which have sold over 130 million albums worldwide...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oJdKuDWKGYp2zQbQlErrL4R4j5y.jpg", url:"https://themoviedb.org/person/32362"}}, {tmdbId:"24239", properties:{bornIn:"Oxford, England", imdbId:"0069331", born:date('1980-01-01'), name:"Lara Belmont", bio:"From Wikipedia, the free encyclopedia\n\nLara Belmont (born 1980) is a British actress, most famous for her role as Jessie in the 1999 film The War Zone.  She also appeared in ITV's lavish costume drama Henry VIII as his eldest daughter Mary Tudor.  Belmont, who is from Oxford, worked as a model before she was spotted in the street by a casting director. \n\nDescription above from the Wikipedia article Lara Belmont, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/24239"}}, {tmdbId:"128598", properties:{imdbId:"0192191", born:date('1981-01-01'), name:"Freddie Cunliffe", url:"https://themoviedb.org/person/128598"}}, {tmdbId:"1265", properties:{bornIn:"New York City, New York USA", imdbId:"0036981", born:date('1943-01-01'), name:"Letty Aronson", url:"https://themoviedb.org/person/1265"}}, {tmdbId:"535801", properties:{imdbId:"0696661", name:"Soon-Yi Previn", url:"https://themoviedb.org/person/535801"}}, {tmdbId:"401955", properties:{imdbId:"0057100", name:"Dan Barrett", url:"https://themoviedb.org/person/401955"}}, {tmdbId:"401763", properties:{imdbId:"0923188", name:"Simon Wettenhall", url:"https://themoviedb.org/person/401763"}}, {tmdbId:"13362", properties:{bornIn:"Glasgow, Scotland", imdbId:"0627995", born:date('1974-11-27'), name:"Alec Newman", bio:"From Wikipedia, the free encyclopedia.   Alec Newman is a Scottish stage, television and film actor.  He was born in Glasgow on 27 November 1974.  Prior to joining the National Youth Theatre in London at age 17, he considered becoming a professional footballer.  He trained at LAMDA. \n\nHis highest profile appearances are tied to science fiction works. \n\nDescription above from the Wikipedia article Alec Newman, licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qbSY0vUIyc8SUuLCw7hK5CsTpvQ.jpg", url:"https://themoviedb.org/person/13362"}}, {tmdbId:"989", properties:{bornIn:"Deptford, London, UK", imdbId:"0605365", born:date('1939-01-27'), name:"P.H. Moriarty", bio:"P. H.  Moriarty is a British actor best known for playing hard men and gangsters.  He began acting late in life, having worked for many years in several professions including a boxer and a longshoresman.  It was whilst working in the latter role that his film career started; a production company, shooting on the docks spotted him one day and asked him to act in their film...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/k0geInO1w0hWGqN5A2fx0l6K8NM.jpg", url:"https://themoviedb.org/person/989"}}, {tmdbId:"11397", properties:{bornIn:"Wandsworth, London, England, UK", imdbId:"0949983", name:"Ric Young", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2XxcV8eGeyAXOofsXmEsN2hSx45.jpg", url:"https://themoviedb.org/person/11397"}}, {tmdbId:"85142", properties:{bornIn:"Brooklyn - New York - USA", imdbId:"0070115", born:date('1965-07-24'), name:"Paul Ben-Victor", bio:"​From Wikipedia, the free encyclopedia. \n\nPaul Ben-Victor (born July 24, 1965) is an American actor.  Ben-Victor was born Paul Friedman, in Brooklyn, New York, the son of Leah Kornfeld, a playwright, and Victor Friedman.  Ben-Victor debuted on the small screen in 1987 in the made-for-TV movie Blood Vows: The Story of a Mafia Wife and on an episode of Cagney &amp; Lacey...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qhxGWVppbnwF4YuzQQtIym5z99E.jpg", url:"https://themoviedb.org/person/85142"}}, {tmdbId:"155", properties:{bornIn:"Speake, Alabama, USA", imdbId:"0085407", born:date('1982-11-29'), name:"Lucas Black", bio:"Lucas York Black (born November 29, 1982) is an American film and television actor.  He is known for his roles in the CBS television series American Gothic as well as roles in films such as Sling Blade, Jarhead, Friday Night Lights, The Fast and the Furious: Tokyo Drift, Legion and Get Low. \n\nDescription above from the Wikipedia article Lucas Black , licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w2oImwC4Y0RDtyvaKGTCFCKsvwh.jpg", url:"https://themoviedb.org/person/155"}}, {tmdbId:"5700", properties:{bornIn:"Pompano Beach, Florida USA", imdbId:"0738354", born:date('1920-11-08'), name:"Esther Rolle", bio:"From Wikipedia, the free encyclopedia\n\nEsther Elizabeth Rolle (November 8, 1920 – November 17, 1998) was a Bahamian American actress.  Rolle is best known for her role as Florida Evans, on the CBS television sitcom Maude, for two seasons (1972–1974), and its spin-off series Good Times, for five seasons (1974–77, 1978–79), for which Rolle was nominated for a Golden Globe Award for Best Actress - Television Series Musical or Comedy in 1976...", died:date('1998-11-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qC1k4WhH9vULIKucdBbgfiQ5bmD.jpg", url:"https://themoviedb.org/person/5700"}}, {tmdbId:"90496", properties:{bornIn:"Arakawa-ku, Tokyo, Japan", imdbId:"0637586", born:date('1936-10-25'), name:"Masako Nozawa", bio:"From Wikipedia, the free encyclopedia\n\nMasako Nozawa is a Japanese actress and voice actress from Tokyo.  Throughout her life, she has been affiliated with Production Baobab, 81 Produce and self-owned Office Nozawa; she is currently affiliated with Aoni Production.  Her late husband, Masaaki Tsukada, was also a voice actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jxbXdejmPoiKnNoQz7Dkb80qC26.jpg", url:"https://themoviedb.org/person/90496"}}, {tmdbId:"210069", properties:{imdbId:"0031290", name:"Monika Antonelli", url:"https://themoviedb.org/person/210069"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"224683", properties:{bornIn:"Aomori Prefecture, Japan", born:date('1941-10-20'), name:"Shin Aomori", bio:"a Japanese actor , voice actor and narrator .  Born in Aomori Prefecture .  His real name is Kazuo Ichinohe .  From October 2013, belonged to Aoji Production .  Previously belonged to the Tokyo Actors Cooperative Society , Sigma Seven ( -August 2013).  The stage name comes from Aomori Prefecture, where I came from...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xSBmmIpJqztpbgd2b9gVmj8tmA0.jpg", url:"https://themoviedb.org/person/224683"}}, {tmdbId:"65510", properties:{bornIn:"Tokyo, Japan", imdbId:"0849028", born:date('1955-01-15'), name:"Mayumi Tanaka", bio:"Mayumi Tanaka was born on January 15, 1955 in Tokyo, Japan.  She is an actress, known for Dragon Ball Z (1989), Dragon Ball Z Kai (2009) and Dragon Ball Z (1996)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dvwL1Uqqm8eyVLbTqCyyiSnpG83.jpg", url:"https://themoviedb.org/person/65510"}}, {tmdbId:"40327", properties:{bornIn:"Isogo-ku, Yokohama, Kanagawa Prefecture, Japan", imdbId:"0299228", born:date('1953-07-31'), name:"Tôru Furuya", bio:"From Wikipedia, the free encyclopedia\n\nTōru Furuya (古谷 徹 Furuya Tōru?) is a veteran narrator and seiyū (voice actor) born on July 31, 1953 in Yokohama, Kanagawa Prefecture, Japan.  As a child, he was a member of Gekidan Himawari, a children's acting troupe.  He is currently employed by the talent management firm Aoni Production...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eEGny7OZvUEFtB74e33Z19UitPE.jpg", url:"https://themoviedb.org/person/40327"}}, {tmdbId:"100124", properties:{bornIn:"Nagoya, Aichi Prefecture, Japan", imdbId:"0840721", born:date('1950-03-06'), name:"Hirotaka Suzuoki", bio:"Japanese actor, voice actor and narrator from Nagoya, Aichi Prefecture.  Graduated from Tokyo Keizai University. \n\nHis best known roles include Mobile Suit Gundam (Bright Noa), Captain Tsubasa (Kojirou Hyuga), Saint Seiya (Dragon Shiryū), Dragon Ball (Tenshinhan), The Transformers (Starscream), Ranma ½ (Tatewaki Kuno), Rurouni Kenshin (Saitō Hajime), Pokémon (Giovanni), and Invincible Steel Man Daitarn 3 (Banjō Haran).  He was also the official Japanese dub-voice for Tom Cruise...", died:date('2006-08-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lxl10IWmSS2iHBfhwQHJ7pGcunf.jpg", url:"https://themoviedb.org/person/100124"}}, {tmdbId:"1686", properties:{imdbId:"0476223", name:"Takeshi Kusao", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gDiYLUdl9zXXJmhE0bAuB1Jm3FJ.jpg", url:"https://themoviedb.org/person/1686"}}, {tmdbId:"122191", properties:{bornIn:"Kōtō, Tokyo, Japan", imdbId:"0351338", born:date('1952-02-08'), name:"Daisuke Gôri", bio:"Daisuke Gouri (February 8, 1952 - January 17, 2010) was a Japanese voice actor.  He was affiliated with Ezaki Productions during his early career and was last affiliated with Aoni Production.  He was also known under his real and former stagename Yoshio Nagahori...", died:date('2010-01-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/g5OeBa8Rww8VNZiJuU7RhZxodwc.jpg", url:"https://themoviedb.org/person/122191"}}, {tmdbId:"122193", properties:{bornIn:"Hokkaido, Japan", imdbId:"0875442", born:date('1960-03-29'), name:"Hiromi Tsuru", died:date('2017-11-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oFU9CCNLUhklLhEuLutM0FyTUbt.jpg", url:"https://themoviedb.org/person/122193"}}, {tmdbId:"122501", properties:{bornIn:"Osaka Prefecture, Japan", imdbId:"0394690", born:date('1958-02-01'), name:"Ryô Horikawa", bio:"Ryou Horikawa, born as Makoto Horikawa, is a Japanese voice actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2vxIYMdMGbwvpcOQNSRLjU4cvai.jpg", url:"https://themoviedb.org/person/122501"}}, {tmdbId:"115790", properties:{bornIn:"Niigata, Japan", imdbId:"0793554", born:date('1954-11-20'), name:"Bin Shimada", bio:"Bin Shimada, born November 20, 1954 in, Niigata, Japan is a Japanese voice actor.  He is affiliated with the talent management firm Aoni Production...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dr81G05LE73RuZ10vwgyT35ahRH.jpg", url:"https://themoviedb.org/person/115790"}}, {tmdbId:"625", properties:{bornIn:"Tokyo, Japan", imdbId:"0443509", born:date('1932-10-31'), name:"Iemasa Kayumi", bio:"​From Wikipedia, the free encyclopedia. \n\nIemasa Kayumi  (born October 31, 1932) is a Japanese voice actor, actor, and narrator from the Tokyo Metropolitan area.  He is currently affiliated with 81 Produce...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l9oUipH9gm6lTgIhnBC4ZgDge0K.jpg", url:"https://themoviedb.org/person/625"}}, {tmdbId:"122653", properties:{bornIn:"Chiba, Chiba Prefecture, Japan", imdbId:"0443733", born:date('1948-04-16'), name:"Kazuyuki Sogabe", died:date('2006-09-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mRKCnfm8S6NiBkf93QT9vdIpFKJ.jpg", url:"https://themoviedb.org/person/122653"}}, {tmdbId:"1243319", properties:{bornIn:"Kochi Prefecture, Japan", imdbId:"0913780", born:date('1936-03-21'), name:"Takeshi Watabe", bio:"was a Japanese voice actor.  He was born in Kōchi Prefecture.  He usually played villains and performed the voices for many anime characters and tokusatsu villains.  He is most famous for voicing Kaminari in Doraemon.  He took over the ongoing roles of Shingo Kanemoto after his death...", died:date('2010-12-13'), url:"https://themoviedb.org/person/1243319"}}, {tmdbId:"122373", properties:{imdbId:"0851311", name:"Naoki Tatsuta", url:"https://themoviedb.org/person/122373"}}, {tmdbId:"12219", properties:{bornIn:"New York City, New York, USA", imdbId:"0829537", born:date('1962-11-28'), name:"Jon Stewart", bio:"Jon Stewart  (born Jonathan Stuart Leibowitz; November 28, 1962) is an American political satirist, writer, television host, actor, media critic and stand-up comedian.  He is widely known as host of The Daily Show, a satirical news program that airs on Comedy Central. \n\nStewart started as a stand-up comedian, but branched into television as host of Short Attention Span Theater for Comedy Central...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jmnRMhkms5YAHNb5ZK5ro750vKk.jpg", url:"https://themoviedb.org/person/12219"}}, {tmdbId:"56730", properties:{bornIn:"Arezzo, Tuscany, Italy", imdbId:"0819850", born:date('1992-08-04'), name:"Cole Sprouse", bio:"Cole Sprouse is an Italian-born American actor, collectively known as the Sprouse Bros with his twin brother Dylan Sprouse.  By the end of the 2000s, MSN reported the twin brothers became the richest teenage twins in the world...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mQAXL0rUGwX316d1FBBQmloZzHu.jpg", url:"https://themoviedb.org/person/56730"}}, {tmdbId:"8540", properties:{bornIn:"Klagenfurt - Carinthia - Austria", imdbId:"0001572", born:date('1968-09-15'), name:"Danny Nucci", bio:"From Wikipedia, the free encyclopedia. \n\nDanny Nucci (born September 15, 1968) is an Austrian-American actor best known his role as Jack Dawson's Italian friend Fabrizio De Rossi in the 1997 film Titanic...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wKGDLd1ylioWhpNLkunHQ2sfYSa.jpg", url:"https://themoviedb.org/person/8540"}}, {tmdbId:"59222", properties:{bornIn:"Little Rock, Arkansas, USA", imdbId:"0627624", born:date('1964-12-10'), name:"George Newbern", bio:"From Wikipedia, the free encyclopedia. \n\nGeorge Young Newbern (born December 10, 1964) is an American television and film actor best known for his roles as Bryan MacKenzie in Father of the Bride (1991) and its sequel Father of the Bride Part II as well as Danny (The Yeti) in Friends.  He is also well known for his role as Superman from the Justice League and Justice League Unlimited animated series as well as Sephiroth from the Final Fantasy series and the Kingdom Hearts series...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gdOHMTBR01yGiDZ793exTNbWyUh.jpg", url:"https://themoviedb.org/person/59222"}}, {tmdbId:"389", properties:{bornIn:"Carmel, California, USA", imdbId:"0002055", born:date('1972-05-22'), name:"Alison Eastwood", bio:"An American film director, Hollywood actress, fashion model, and fashion designer.  She made her directorial debut with Rails & Ties (2007), starring Kevin Bacon and Marcia Gay Harden.  Daughter of Clint Eastwood...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tJbIZjs7S2EOyxEM1xFdsWCESIM.jpg", url:"https://themoviedb.org/person/389"}}, {tmdbId:"6164", properties:{bornIn:"Little Rock, Arkansas, USA", imdbId:"0524197", born:date('1971-06-20'), name:"Josh Lucas", bio:"Over his career, Josh Lucas has worked with many of the film community's greatest talents.  He has starred alongside Jon Voight in Jerry Bruckheimer's Glory Road (2006), for which Lucas added 40 pounds to transform himself into legendary basketball coach Don Haskins.  Lucas also starred with Kurt Russell and Richard Dreyfuss in Wolfgang Petersen's Poseidon (2006).  He starred with Morgan Freeman and Robert Redford in Lasse Hallström's An Unfinished Life (2005)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7E37ps3pkqgKxdBNhBhTHqHdVgA.jpg", url:"https://themoviedb.org/person/6164"}}, {tmdbId:"32029", properties:{bornIn:"New York City, New York, USA", imdbId:"0756083", born:date('1962-04-03'), name:"Bill Sage", bio:"Bill Sage is an American film and television actor.  He's a graduate of the State University of New York at Purchase, USA...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2uQv1NMnGrqqhBMKTm5RBCKh7UV.jpg", url:"https://themoviedb.org/person/32029"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"4886", properties:{bornIn:"Hollywood - Florida - USA", imdbId:"0005342", born:date('1969-01-06'), name:"Norman Reedus", bio:"Norman Mark Reedus (born January 6, 1969) is an American actor.  He is perhaps best known for his portrayal as Murphy MacManus in the 1999 film The Boondock Saints and for the character of Daryl Dixon in the AMC television series The Walking Dead.  He has also directed several videos and modeled for various fashion designers. \n\nDescription above from the Wikipedia article Norman Reedus, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ozHPdO5jAt7ozzdZUgyRAMNPSDW.jpg", url:"https://themoviedb.org/person/4886"}}, {tmdbId:"54790", properties:{bornIn:"Norwich, Connecticut, USA", imdbId:"0217386", born:date('1952-05-04'), name:"David Della Rocco", bio:"From Wikipedia, the free encyclopedia\n\nDavid Della Rocco (Born May 4, 1952) is an Italian-American comedian and actor best known for his supporting role in the 1999 cult film The Boondock Saints, in which he played a character also named David Della Rocco (though usually just called \"Rocco\" and \"Roc\")\n\nDella Rocco brought many of his real-life mannerisms and flair to the character, making an impression on fans and living up to the character's nickname, \"The Funny Man\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5ctSDninCKr81JHuokbRn95sjUU.jpg", url:"https://themoviedb.org/person/54790"}}, {tmdbId:"70958", properties:{imdbId:"0820903", born:date('1971-03-04'), name:"Nick Stabile", bio:"Stabile was born on March 4, 1970 in Wheat Ridge, Colorado.  He graduated from Pomona High School in 1988...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ihq0SPXmzMQlk1az9G60x4ukD05.jpg", url:"https://themoviedb.org/person/70958"}}, {tmdbId:"2206", properties:{bornIn:"Nottingham, Nottinghamshire, England, UK", imdbId:"0608090", born:date('1977-05-13'), name:"Samantha Morton", bio:"Samantha Jane Morton (born 13 May 1977) is an English actress and film director.  She began her performing career with guest roles in television shows such as Soldier Soldier and Boon before making her film debut in the 1997 drama film This Is the Sea, playing the character of Hazel Stokes...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7jV2vDi6TDIFDFSc5esqFso628w.jpg", url:"https://themoviedb.org/person/2206"}}, {tmdbId:"118617", properties:{bornIn:"England, UK", imdbId:"0940245", born:date('1949-11-30'), name:"Nicholas Woodeson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/g8sVxrMjLAWEde8TZaa42e2Lr42.jpg", url:"https://themoviedb.org/person/118617"}}, {tmdbId:"65007", properties:{bornIn:"Saint-Maur-des-Fossés, Val-de-Marne, France", imdbId:"0660854", born:date('1972-12-22'), name:"Vanessa Paradis", bio:"Vanessa Chantal Paradis (born 22 December 1972) is a French singer, model and actress.  She became a child star at 14 with the worldwide success of her single \"Joe le taxi\".  Since then, she has accomplished a career in music, movies and modelling...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/78CpZ2bltGSuUiQerXbo3Y298eK.jpg", url:"https://themoviedb.org/person/65007"}}, {tmdbId:"271955", properties:{imdbId:"0679546", name:"Frédéric Pfluger", url:"https://themoviedb.org/person/271955"}}, {tmdbId:"65008", properties:{imdbId:"0313320", name:"Demetre Georgalas", url:"https://themoviedb.org/person/65008"}}, {tmdbId:"38877", properties:{bornIn:"Paris, France", imdbId:"0219099", born:date('1966-05-14'), name:"Marianne Denicourt", bio:"From Wikipedia, the free encyclopedia. \n\nMarianne Denicourt (14 May 1966 in Paris) is a French actress, who has appeared in about 50 film and television productions between 1986 and 2009. \n\nShe studied under Patrice Chéreau in 1985-86 at the Ecole du théâtre des Amandiers in the western Paris suburb of Nanterre. \n\nShe lives with actor Daniel Auteuil. \n\nDescription above from the Wikipedia article Marianne Denicourt, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uUUJxTGruet9fvyXiEyYNM9oIs6.jpg", url:"https://themoviedb.org/person/38877"}}, {tmdbId:"64343", properties:{bornIn:" Los Angeles, California, USA", imdbId:"0018099", born:date('1969-01-03'), name:"John Ales", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d8jC0dF0iuzx2XnNxneFgK5eJeK.jpg", url:"https://themoviedb.org/person/64343"}}, {tmdbId:"75468", properties:{imdbId:"0357988", name:"Julie Hamilton", url:"https://themoviedb.org/person/75468"}}, {tmdbId:"51390", properties:{bornIn:"Milton Keynes - Buckinghamshire - England - UK", imdbId:"0004749", born:date('1975-04-25'), name:"Emily Bergl", bio:"Bergl was born in Milton Keynes, England to an Irish mother and an English architect father.  She lacks a British accent because she moved to Chicago with her family when she was a child and attended Glenbrook South High School and Grinnell College, where she was the lead in several school productions.  She graduated Phi Beta Kappa in 1997 with a B. A.  in English and Theater.  She has a brother...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rZSSCh9fuiRM9imp9BfZt3qq6In.jpg", url:"https://themoviedb.org/person/51390"}}, {tmdbId:"52476", properties:{bornIn:"Milford, Connecticut, USA", imdbId:"0116465", born:date('1972-09-06'), name:"Dylan Bruno", bio:"Dylan Bruno (born September 6, 1972) is an American actor, producer and former model.  He portrayed FBI agent Colby Granger in the CBS series Numbers...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xRO78p1UyVlr5iPpsg8tC43O6Qd.jpg", url:"https://themoviedb.org/person/52476"}}, {tmdbId:"52475", properties:{bornIn:" Louisville, Kentucky, USA", imdbId:"0810397", born:date('1957-09-07'), name:"J. Smith-Cameron", bio:"J.  Smith-Cameron is an American actress best known for her supporting roles as Janet Talbot on the television series Rectify and Gerri Kellman on Succession...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aq6lOve8Y3LEXtS0CYVUirILqxH.jpg", url:"https://themoviedb.org/person/52475"}}, {tmdbId:"71900", properties:{bornIn:" London, England, UK", imdbId:"0001600", born:date('1959-05-29'), name:"Adrian Paul", bio:"Adrian Hewett (born May 29, 1959) is an actor best known for his role on Highlander: The Series...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eWvjUly7IO420nJLYY1sumXswGo.jpg", url:"https://themoviedb.org/person/71900"}}, {tmdbId:"9146", properties:{bornIn:"Brooklyn - New York - USA", imdbId:"0053887", born:date('1971-06-18'), name:"Lisa Barbuscia", url:"https://themoviedb.org/person/9146"}}, {tmdbId:"1703911", properties:{name:"Dieter Dengler", url:"https://themoviedb.org/person/1703911"}}, {tmdbId:"1705980", properties:{name:"Eugene Deatrick", url:"https://themoviedb.org/person/1705980"}}, {tmdbId:"17051", properties:{bornIn:"Palo Alto, California, USA", imdbId:"0290556", born:date('1978-04-19'), name:"James Franco", bio:"James Edward Franco (born April 19, 1978) is an American actor.  He left college in order to pursue acting and started off his career by making guest appearances on television series in the 1990s.  Franco landed a lead part on the short-lived cult hit television program Freaks and Geeks and later achieved recognition for playing the titular character in the TV biopic James Dean (2001), for which he was awarded a Golden Globe Award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rShzuvrQJJQJ6lXDn3IQX4o0iCE.jpg", url:"https://themoviedb.org/person/17051"}}, {tmdbId:"65030", properties:{imdbId:"0106736", name:"Joe Breen", url:"https://themoviedb.org/person/65030"}}] AS row
