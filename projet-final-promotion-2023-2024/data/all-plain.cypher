UNWIND [{tmdbId:"1159603", properties:{imdbId:"0039911", name:"António Assunção", url:"https://themoviedb.org/person/1159603"}}, {tmdbId:"1840022", properties:{imdbId:"0050905", name:"Julie Balloo", url:"https://themoviedb.org/person/1840022"}}, {tmdbId:"57057", properties:{bornIn:"Changsha City, Hunan Province, China", imdbId:"0013833", born:date('1944-06-02'), name:"Ya-Lei Kuei", bio:"Grace Gua Ah-leh (born 2 June 1944) is a Taiwanese actress and singer.  Gua has portrayed over 200 roles in film and television since 1965.  She has won the Golden Horse Awards 4 times and the Golden Bell Awards twice. \n\nGua Ah Leh is a well known award-winning actress.  Also known as Kuei Ya-lei and Grace Gua, she was born in China in 1944.  She studied acting at the National Taiwan University of Arts...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7nkFqpzp6u2uGABRKPNLk5edzbv.jpg", url:"https://themoviedb.org/person/57057"}}, {tmdbId:"1623", properties:{bornIn:"Suqian, Jiangsu, China", imdbId:"0485950", born:date('1930-01-01'), name:"Sihung Lung", bio:"From Wikipedia, the free encyclopedia. \n\nSihung Lung (born 1930 – May 2, 2002) was an actor in the cinema of Taiwan who appeared in over 100 films and was best known for playing paternal roles in films including Eat Drink Man Woman and The Wedding Banquet.  He frequently collaborated with award-winning director Ang Lee, notably cast in films such as Crouching Tiger, Hidden Dragon and Pushing Hands. \n\nLung enlisted in Chiang Kai-shek's army as a teenager to fight the Chinese Communist Party...", died:date('2002-05-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i1aiG0pf73LKssRbo6tFv0kzUnz.jpg", url:"https://themoviedb.org/person/1623"}}, {tmdbId:"57056", properties:{imdbId:"0157771", name:"May Chin", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/znrJwHW5VNVe4wt890vMaGJCsDO.jpg", url:"https://themoviedb.org/person/57056"}}, {tmdbId:"57054", properties:{bornIn:"Taiwan", imdbId:"0152061", born:date('1960-06-09'), name:"Winston Chao", bio:"Winston Chao Wen-hsuan (born 9 June 1960) is a Taiwanese actor.  He came to international attention for his performance in the 1993 film The Wedding Banquet.  He is also known for his roles in Red Rose White Rose and Eat Drink Man Woman, and for his five portrayals of Sun Yat-sen, notably in the films The Soong Sisters (1997), Road to Dawn (2007) and 1911 (2011)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/giJfjDRPThs41p7bRhtACx2z9TV.jpg", url:"https://themoviedb.org/person/57054"}}, {tmdbId:"32597", properties:{bornIn:"Waterbury, Connecticut, USA", imdbId:"0001518", born:date('1961-10-26'), name:"Dylan McDermott", bio:"Mark Anthony McDermott (born October 26, 1961), better known by his professional name of Dylan McDermott, is an American actor, known for his role as lawyer and law firm head Bobby Donnell on the television legal drama The Practice and his role in the series Dark Blue as Lt.  Carter Shaw...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9x3nu3qQdLtxrrr6usC1fgbIQb9.jpg", url:"https://themoviedb.org/person/32597"}}, {tmdbId:"1392738", properties:{imdbId:"0188949", name:"Alison Crosbie", url:"https://themoviedb.org/person/1392738"}}, {tmdbId:"1392739", properties:{imdbId:"2535022", name:"Philip King", url:"https://themoviedb.org/person/1392739"}}, {tmdbId:"230551", properties:{bornIn:"Privolnoe, Severo-Kavkazsky kray, USSR (Russia)", imdbId:"0329784", born:date('1931-03-02'), name:"Mikhail Gorbachev", bio:"Mikhail Sergeyevich Gorbachev is a Russian and formerly Soviet politician.  The eighth and last leader of the Soviet Union, he was the general secretary of the Communist Party of the Soviet Union from 1985 until 1991...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kiKZ3XR760LyBZ8YvNdZf6EFFzl.jpg", url:"https://themoviedb.org/person/230551"}}, {tmdbId:"27433", properties:{bornIn:"Genova, Liguria, Italy", imdbId:"0897715", born:date('1932-12-31'), name:"Paolo Villaggio", died:date('2017-07-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9jwSJGIFRiJ0uwOKCmi3KO0T12v.jpg", url:"https://themoviedb.org/person/27433"}}, {tmdbId:"72786", properties:{bornIn:"Napoli (Italy)", imdbId:"0606204", born:date('1945-08-26'), name:"Gigio Morra", url:"https://themoviedb.org/person/72786"}}, {tmdbId:"1151165", properties:{imdbId:"0813169", name:"Sergio Solli", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/awwiyTMCPpHv2IvnNTZ1I7zI7Wm.jpg", url:"https://themoviedb.org/person/1151165"}}, {tmdbId:"64741", properties:{imdbId:"0501154", born:date('1962-05-29'), name:"John D. LeMay", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aBGuK1pWQ2elq60H0357kFvqhNs.jpg", url:"https://themoviedb.org/person/64741"}}, {tmdbId:"64742", properties:{imdbId:"0444443", born:date('1969-04-09'), name:"Kari Keegan", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rvyHbQUEMUYpjJCMdtKlatlJ5iH.jpg", url:"https://themoviedb.org/person/64742"}}, {tmdbId:"51579", properties:{bornIn:"Memphis, Tennessee, USA", imdbId:"0931736", born:date('1949-01-07'), name:"Steven Williams", bio:"From Wikipedia, the free encyclopedia. \n\nSteven Williams (born January 7, 1949) is an American actor of films and television. \n\nWilliams was born in Memphis, Tennessee and raised in Chicago.  He is known for his role as Captain Adam Fuller on the Fox Network's hit TV series 21 Jump Street from 1987-91. \n\nHe played Lt.  Burnett on the CBS drama series The Equalizer in 1989.  He later played Det.  August Brooks on the short lived TNT's L. A.  Heat in 1996.  Steven also had a recurring role as Mr...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/okrQsLdE6hCGJ1M4p5nXPC3mJTW.jpg", url:"https://themoviedb.org/person/51579"}}, {tmdbId:"143432", properties:{bornIn:"Hanoi, Vietnam", imdbId:"0157905", born:date('1939-01-01'), name:"Kieu Chinh", url:"https://themoviedb.org/person/143432"}}, {tmdbId:"10075", properties:{bornIn:"Tianjin, China", imdbId:"0157796", born:date('1936-11-30'), name:"Tsai Chin", bio:"From Wikipedia, the free encyclopedia. \n\nTsai Chin, also known by her Chinese name Zhou Caiqin, is an actress, director, teacher and author, best known in America for her role as Auntie Lindo in the film The Joy Luck Club.   The third daughter of the legendary Peking opera actor and singer Zhou Xinfang, Tsai Chin was the first Chinese student trained at the Royal Academy of Dramatic Art in London, and later earned a Masters Degree at Tufts University in Boston, Massachusetts...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7dMi1bbF2JphxBtqQX5YjDpwoOW.jpg", url:"https://themoviedb.org/person/10075"}}, {tmdbId:"16096", properties:{bornIn:"Marseille, France", imdbId:"0638395", born:date('1939-07-31'), name:"France Nuyen", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cHO99EWPsvylnn0HkZGZYccimRX.jpg", url:"https://themoviedb.org/person/16096"}}, {tmdbId:"86633", properties:{bornIn:"Beijing, China", imdbId:"0523734", born:date('1927-01-19'), name:"Lisa Lu", bio:"Lisa Lu Yan (simplified Chinese: 卢燕; traditional Chinese: 盧燕; pinyin: Lú Yàn; born July 8, 1927) is a Chinese-born American actress and singer.  She won the Golden Horse Awards three times in the 1970s...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cK69ncJvlUVnJwsVinSYc4n8yWw.jpg", url:"https://themoviedb.org/person/86633"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"5724", properties:{bornIn:"Worcester, Massachusetts, USA", imdbId:"0001459", born:date('1957-08-18'), name:"Denis Leary", bio:"Denis Colin Leary (born August 18, 1957) is an American actor, comedian, writer, director and film producer.  Leary is known for his biting, fast paced comedic style and chain smoking.  He is the star and co-creator of the television show Rescue Me, which ended its seventh and final season on September 7, 2011.  Leary has starred in many motion pictures, most recently as CaptainGeorge Stacy in Marc Webb's 2012 film The Amazing Spider-Man and the voice of Diego in the animated Ice Age series...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1vYNcuEbkvEnS340vldUyUu4D7H.jpg", url:"https://themoviedb.org/person/5724"}}, {tmdbId:"1569421", properties:{name:"Kathy Larson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xMsK5yag7QagLCc6RgkvTvM5Lov.jpg", url:"https://themoviedb.org/person/1569421"}}, {tmdbId:"1569422", properties:{imdbId:"0587331", name:"David Milford", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o8nSIBmkP26YwQPhqLISebNiYqT.jpg", url:"https://themoviedb.org/person/1569422"}}, {tmdbId:"12640", properties:{bornIn:"New York City, New York, USA", imdbId:"0000141", born:date('1960-08-07'), name:"David Duchovny", bio:"David William Duchovny (born August 7, 1960, height 6' 0½\" (1,84 m)) is an American actor, writer, and director.  He is best known for playing Fox Mulder on The X-Files and Hank Moody on Californication, both of which have earned him Golden Globe awards  Duchovny was born in New York City, New York in 1960.  He is the son of Margaret \"Meg\" (née Miller), a school administrator and teacher, and Amram \"Ami\" Ducovny (1927–2003), a writer and publicist who worked for the American Jewish Committee...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rZ2pEvu9IYsnHx3ElWUy4KgK3ia.jpg", url:"https://themoviedb.org/person/12640"}}, {tmdbId:"54146", properties:{bornIn:"Madrid, Spain", imdbId:"0286579", born:date('1955-12-01'), name:"Verónica Forqué", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rki2ZGDMQOMqrWS7BN2gNr27gSY.jpg", url:"https://themoviedb.org/person/54146"}}, {tmdbId:"26661", properties:{imdbId:"0142964", born:date('1964-03-12'), name:"Àlex Casanovas", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2qZwHh0dSD5MfSqBSfGuDbtWL8x.jpg", url:"https://themoviedb.org/person/26661"}}, {tmdbId:"17772", properties:{bornIn:"Norwalk, Connecticut, United States", imdbId:"0103038", born:date('1979-05-28'), name:"Jesse Bradford", bio:"From Wikipedia, the free encyclopedia.  Jesse Bradford (born May 28, 1979) is an American actor. \n\nDescription above from the Wikipedia article Jesse Bradford, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aT3eZzGDMKrwlYgHtwBH4KHKa64.jpg", url:"https://themoviedb.org/person/17772"}}, {tmdbId:"4491", properties:{bornIn:"Sherman Oaks, Los Angeles, California, USA", imdbId:"0000098", born:date('1969-02-11'), name:"Jennifer Aniston", bio:"Jennifer Joanna Aniston (born February 11, 1969) is an American actress, filmmaker, and businesswoman.  She gained worldwide recognition for portraying Rachel Green on the television sitcom Friends (1994–2004), a role which earned her an Emmy Award, a Golden Globe Award, and a Screen Actors Guild Award.  In 2012, she received a star on the Hollywood Walk of Fame.  Additionally, Men's Health magazine voted Aniston the \"Sexiest Woman of All Time\". \n\nAniston has also enjoyed a successful film career...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o5jCZTBv49mh2JhIpsw3FkGuns7.jpg", url:"https://themoviedb.org/person/4491"}}, {tmdbId:"70556", properties:{bornIn:"Richmond, California, USA", imdbId:"0645949", born:date('1958-04-22'), name:"Ken Olandt", url:"https://themoviedb.org/person/70556"}}, {tmdbId:"61904", properties:{bornIn:"Whitestone, Queens, New York, USA", imdbId:"0896292", born:date('1981-11-18'), name:"Christina Vidal", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7Th8N0AymiBn5ROxBjPekM8SKMd.jpg", url:"https://themoviedb.org/person/61904"}}, {tmdbId:"78729", properties:{bornIn:"Jersey City, New Jersey, U.S.", imdbId:"0001447", born:date('1956-02-03'), name:"Nathan Lane", bio:"Nathan Lane (born Joseph Lane; February 3, 1956) is an American actor.  He has won three Tony Awards, and has been nominated for two Golden Globe Awards and six Primetime Emmy Awards...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nEYS0KO1qVO3y0RAt8V8pFxnPb7.jpg", url:"https://themoviedb.org/person/78729"}}, {tmdbId:"87255", properties:{bornIn:"Ozone Park, Queens, New York City, New York, USA", imdbId:"0490980", born:date('1953-06-22'), name:"Cyndi Lauper", bio:"Cynthia Ann Stephanie \"Cyndi\" Lauper is an American singer, songwriter, actress, and LGBT rights activist whose career has spanned over four decades.  Her debut solo album She's So Unusual (1983), was an instant commercial success.  The album was the first debut female album to chart four top-five hits on the Billboard Hot 100—\"Girls Just Want to Have Fun\", \"Time After Time\", \"She Bop\", and \"All Through the Night,\" earning Lauper the Best New Artist award at the 27th Grammy Awards in 1985...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4fMFl40wCdIEjlajmdpqqPJkhMQ.jpg", url:"https://themoviedb.org/person/87255"}}, {tmdbId:"6591", properties:{bornIn:"Stockton, California, USA", imdbId:"0001389", born:date('1956-06-26'), name:"Chris Isaak", bio:"Christopher Joseph \"Chris\" Isaak (born June 26, 1956) is an American rock musician and occasional actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7NdLnxpXoUhQRQOkAbXfpqCIYdr.jpg", url:"https://themoviedb.org/person/6591"}}, {tmdbId:"540487", properties:{imdbId:"0927615", name:"Alex Wiesendanger", url:"https://themoviedb.org/person/540487"}}, {tmdbId:"59451", properties:{bornIn:"College Point, Queens, New York City, New York, USA", imdbId:"0302356", born:date('1985-02-09'), name:"David Gallagher", bio:"David Gallagher (born February 9, 1985) is an American actor.  He is best known for the role of Simon Camden on 7th Heaven and Mikey Ubriacco in the Look Who's Talking Now.  He is also voiced Riku in the Kingdom Hearts video game series...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9bMmhGtJeBgaXqXGwKDxABnqNpu.jpg", url:"https://themoviedb.org/person/59451"}}, {tmdbId:"71167", properties:{bornIn:"Ontario, Canada", imdbId:"0526939", born:date('1988-02-04'), name:"Tabitha Lupien", bio:"​From Wikipedia, the free encyclopedia.   \n\nTabitha Lupien (born circa 1988) is a Canadian actress and competitive dancer trained in ballet, tap, jazz, pointe, hip hop, and acrobatics.  She trains with her sisters Lindsay and Samantha and her brother Isaac at the Canadian Dance Company, owned by her parents Allain and Dawn, located in Oakville, Ontario.  She is best known for her role as Julie Ubriacco from Look Who's Talking Now.  She had a minor role in the 2007 film version of Hairspray as Becky...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kvLFOQP9BTuShsenJIwY4Qi0Wb5.jpg", url:"https://themoviedb.org/person/71167"}}, {tmdbId:"73296", properties:{bornIn:"Toronto, Ontario,  Canada", imdbId:"0551154", name:"Ruth Marshall", url:"https://themoviedb.org/person/73296"}}, {tmdbId:"78685", properties:{bornIn:"Winnipeg - Manitoba - Canada", imdbId:"0051621", born:date('1967-05-17'), name:"Cameron Bancroft", bio:"Cameron Bancroft (born May 17, 1967 in Winnipeg, Manitoba, Canada), sometimes credited as Cam Bancroft is a television actor.  He studied acting at the California Institute of the Arts, from the late eighties/early nineties.  Bancroft is an alumnus of Handsworth Secondary School.  He is best known for playing Joe Bradley on the television series Beverly Hills, 90210.  He was on the show from 1995 to 1996.  He played the male leading role in Code Name: Eternity in 1999-2000...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6NB6mTfuFRmebqyI6srbEIB0iOV.jpg", url:"https://themoviedb.org/person/78685"}}, {tmdbId:"18658", properties:{bornIn:"Toronto, Ontario,  Canada", imdbId:"0000477", born:date('1975-01-25'), name:"Mia Kirshner", bio:"Mia Kirshner (born January 25, 1975) is a Canadian actress and social activist who works in movies and television series.  She is best known for her portrayal of Jenny Schecter on The L Word (2004–2009) and for her role in the 2006 crime film The Black Dahlia as Elizabeth Short...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/HYUuhnyWFOybWTLmMOFptOLt3o.jpg", url:"https://themoviedb.org/person/18658"}}, {tmdbId:"385", properties:{bornIn:"Edinburgh, Scotland, UK", imdbId:"0007183", born:date('1934-04-07'), name:"Ian Richardson", bio:"From Wikipedia, the free encyclopedia. \n\nIan William Richardson CBE (7 April 1934 – 9 February 2007) was a Scottish actor best known for his portrayal of the Machiavellian Tory politician Francis Urquhart in the BBC's House of Cards trilogy.  He was also a leading Shakespearean stage actor. \n\nDescription above from the Wikipedia article Ian Richardson, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2007-02-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fZKfiYidcPGu1JnJYTAwtTJnAzU.jpg", url:"https://themoviedb.org/person/385"}}] AS row
