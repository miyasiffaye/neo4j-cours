UNWIND [{tmdbId:"109176", properties:{name:"Tennyson Bardwell", bio:"From Wikipedia, the free encyclopedia. \n\nTennyson Bardwell is an American film and TV commercial director and screenwriter. \n\nDescription above from the Wikipedia article Tennyson Bardwell, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/109176"}}, {tmdbId:"18139", properties:{imdbId:"0899854", name:"Tony Vitale", url:"https://themoviedb.org/person/18139"}}, {tmdbId:"109452", properties:{imdbId:"0232902", name:"Jack Donohue", url:"https://themoviedb.org/person/109452"}}, {tmdbId:"109455", properties:{imdbId:"0422425", name:"Austen Jewell", url:"https://themoviedb.org/person/109455"}}, {tmdbId:"50542", properties:{bornIn:"Ceuta, Spain", imdbId:"0554632", born:date('1925-05-15'), name:"Eugenio Martín", bio:"Eugenio Martín is a Spanish film director and writer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eBehZhrIweiTDOGdc9074jEOPu1.jpg", url:"https://themoviedb.org/person/50542"}}, {tmdbId:"41670", properties:{bornIn:"Roxbury, Connecticut, USA", imdbId:"0589182", born:date('1962-09-15'), name:"Rebecca Miller", bio:"Rebecca Augusta Miller (born September 15, 1962) is an American film director, screenwriter and actress, most known for her films Personal Velocity: Three Portraits (winner of the Independent Spirit John Cassavetes Award), The Ballad of Jack and Rose, and Angela,and The Private Lives of Pippa Lee all of which she wrote and directed...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/s0jjPvcX4i8yd7IiBuvnrJ7FbT3.jpg", url:"https://themoviedb.org/person/41670"}}, {tmdbId:"1203", properties:{bornIn:"Riverside, California, U.S.", imdbId:"0493369", born:date('1960-08-11'), name:"J. F. Lawton", bio:"Jonathan Frederick Lawton (also known as J.  F.  Lawton), born on August 11, 1960 in Riverside, California, is an American screenwriter, film producer and film director.  Screen credits include Pretty Woman, Mistress, Blankman, Under Siege, Under Siege 2: Dark Territory, The Hunted, Chain Reaction, DOA: Dead or Alive, Jackson, V. I. P.  and under the assumed name JD Athens Cannibal Women in the Avocado Jungle of Death and Pizza Man.   Description above from the Wikipedia article J.  F...", url:"https://themoviedb.org/person/1203"}}, {tmdbId:"109465", properties:{imdbId:"0600510", name:"Marc Moody", url:"https://themoviedb.org/person/109465"}}, {tmdbId:"109837", properties:{imdbId:"1976116", name:"Gerard Johnson", bio:"British director and writer of the films Tony and Hyena.  His cousin is the actor Peter Ferdinando, the star of his films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/inFho7Omy22MZNpUjQoVT8zfspv.jpg", url:"https://themoviedb.org/person/109837"}}, {tmdbId:"80482", properties:{imdbId:"0918660", name:"Gary Weis", bio:"From Wikipedia, the free encyclopedia. \n\nGary Weis is a movie and television director.  He was the second creator of short films for Saturday Night Live (following Albert Brooks and preceding Tom Schiller). \n\nDescription above from the Wikipedia article Gary Weis, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/80482"}}, {tmdbId:"110337", properties:{imdbId:"1378741", name:"Kim Bartley", url:"https://themoviedb.org/person/110337"}}, {tmdbId:"67619", properties:{bornIn:"Frome, Somerset, England, UK", imdbId:"0337885", born:date('1913-11-05'), name:"Guy Green", bio:"Green was born in Frome, Somerset, England.  He began working in film in 1929 and became a noted film cinematographer and a founding member of the British Society of Cinematographers.  Green became a full-time director of photography in the mid-1940s, working on such films as David Lean's Oliver Twist in 1948. \n\nIn about 1955, Green switched to directing, and he moved to Hollywood around 1962.  In addition to directing A Patch of Blue (1965), Green also wrote and co-produced the film...", died:date('2005-09-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tKLguzWTWiQpsYWQ89O7DZIe9JA.jpg", url:"https://themoviedb.org/person/67619"}}, {tmdbId:"88096", properties:{imdbId:"0588964", name:"Michael Miller", url:"https://themoviedb.org/person/88096"}}, {tmdbId:"129941", properties:{imdbId:"0788454", name:"Alan Shapiro", url:"https://themoviedb.org/person/129941"}}, {tmdbId:"90609", properties:{bornIn:"New York City, New York, U.S.", imdbId:"0674020", born:date('1974-02-02'), name:"Oz Perkins", bio:"Osgood Robert \"Oz\" Perkins II (born February 2, 1974) is an American film director, writer and actor.  He was born in New York City, New York, the elder son of the actor Anthony Perkins and the photographer and actress Berry Berenson. \n\nPerkins's first acting role was in 1983's Psycho II, in which he briefly appeared as the twelve-year-old version of the Norman Bates character his father had created...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fCEfHXkvkKNPnySxlHvukgVOeTw.jpg", url:"https://themoviedb.org/person/90609"}}, {tmdbId:"110726", properties:{imdbId:"0338018", born:date('1900-04-23'), name:"Joseph Green", died:date('1996-06-20'), url:"https://themoviedb.org/person/110726"}}, {tmdbId:"65115", properties:{imdbId:"0760131", name:"Keith Samples", bio:"From Wikipedia, the free encyclopedia\n\nKeith Samples is a film and television director, producer and writer.  He founded Rysher Entertainment in 1991 and was CEO before leaving in 1997 to concentrate on writing and directing.  Media Rights Capital. \n\nDescription above from the Wikipedia article Keith Samples, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/65115"}}, {tmdbId:"111338", properties:{bornIn:"Princeton, New Jersey, USA", imdbId:"0002835", born:date('1960-05-07'), name:"Adam Bernstein", url:"https://themoviedb.org/person/111338"}}, {tmdbId:"4780", properties:{bornIn:"Hemer, Germany", imdbId:"0065615", born:date('1954-06-22'), name:"Wolfgang Becker", url:"https://themoviedb.org/person/4780"}}, {tmdbId:"31652", properties:{imdbId:"0647381", name:"Dan Ollman", url:"https://themoviedb.org/person/31652"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"31653", properties:{imdbId:"0697140", name:"Sarah Price", url:"https://themoviedb.org/person/31653"}}, {tmdbId:"60045", properties:{bornIn:"Newark, New Jersey, USA", imdbId:"0112498", born:date('1964-01-21'), name:"Eric Bross", bio:"​From Wikipedia, the free encyclopedia.   \n\nEric Bross is an American film director.  He has directed numerous films from 1995 to now. \n\nDescription above from the Wikipedia article Eric Bross, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/60045"}}, {tmdbId:"22814", properties:{bornIn:"Plainfield, New Jersey, USA", imdbId:"0921013", name:"Richard Wenk", bio:"Richard Wenk nasceu em 1956 em Plainfield, Nova Jersey, EUA.  Ele é um escritor e diretor, conhecido por Os Mercenários 2 (2012), O Protetor (2014) e 16 Quadras (2006)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tUH6K1QHmZKpZC2UGn7q1z20C4P.jpg", url:"https://themoviedb.org/person/22814"}}, {tmdbId:"1473044", properties:{name:"Shan Nicholson", url:"https://themoviedb.org/person/1473044"}}, {tmdbId:"30477", properties:{bornIn:"New York City, New York, USA", imdbId:"0921464", born:date('1947-01-17'), name:"Peter Werner", bio:"From Wikipedia, the free encyclopedia\n\nPeter Werner (born January 17, 1947 in New York City, New York) is an American television and film director. \n\nIn 1977, Werner won the Academy Award for Best Live Action Short Film for directing the short film In the Region of Ice. [1]Since then he worked on primarily directing television amassing a number of television film credits namely Mama Flora's Family, Two Mothers for Zachary, Call Me Claus, Gracie's Choice, Mom at Sixteen and among other films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AuairAONEXSePGhVX8x2xYrHNqn.jpg", url:"https://themoviedb.org/person/30477"}}, {tmdbId:"16730", properties:{bornIn:"Johannesburg, South Africa", imdbId:"0740213", born:date('1962-04-28'), name:"Darrell James Roodt", bio:"Darrell Roodt (born in 1963) is a South African film director, screenwriter and producer. \n\nHis film Sarafina was screened out of competition at the 1992 Cannes Film Festival...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iJ0oqs5Il1B6hEV2A1FLmTYeMXz.jpg", url:"https://themoviedb.org/person/16730"}}, {tmdbId:"120615", properties:{bornIn:"Austin, Texas", imdbId:"1053530", born:date('1961-08-27'), name:"Tom Ford", bio:"Thomas Carlyle \"Tom\" Ford (born August 27, 1961) is an American fashion designer and film director.  He gained international fame for his turnaround of the Gucci fashion house and the creation of the Tom Ford label before directing the Oscar-nominated film A Single Man. \n\nDescription above from the Wikipedia article Tom Ford, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vi52aEXdiNwV5FJZ7kXM6IBjV0R.jpg", url:"https://themoviedb.org/person/120615"}}, {tmdbId:"95187", properties:{imdbId:"0169296", name:"Dan Cohen", url:"https://themoviedb.org/person/95187"}}, {tmdbId:"113102", properties:{imdbId:"0601963", name:"Tom Moore", url:"https://themoviedb.org/person/113102"}}, {tmdbId:"87459", properties:{bornIn:"Richmond, Indiana", imdbId:"0287988", born:date('1903-12-13'), name:"Norman Foster", bio:"From Wikipedia, the free encyclopedia.   Norman Foster (December 13, 1903 - July 7, 1976) was an American film director and actor. \n\nBorn John Hoeffer in Richmond, Indiana, Foster originally became a cub reporter on a local newspaper in Indiana before going to New York in the hopes of getting a better newspaper job but there were no vacancies.  He tried a number of theatrical agencies before getting stage work and later appeared on Broadway in the George S...", died:date('1976-07-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6PzZaFOexKOW9HR1dbxRdBW6jkg.jpg", url:"https://themoviedb.org/person/87459"}}, {tmdbId:"101666", properties:{imdbId:"1503726", born:date('1960-11-20'), name:"Paul King", bio:"From Wikipedia, the free encyclopedia.   Paul King is a writer and director.  He works in television, film and theatre, and specialises in comedy. \n\nHe graduated from St Catharine's College, Cambridge University with first-class honors in English in 1999.  There he met Richard Ayoade, Matthew Holness and Alice Lowe, and went on to direct them at the Edinburgh Festival in \"Garth Marenghi's FrightKnight\" (nominated for the Perrier Award in 2000), and \"Netherhead\" (Perrier Award winner 2001)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vteMQaGDpNHkKcuwT8yVQNeAohV.jpg", url:"https://themoviedb.org/person/101666"}}, {tmdbId:"1011", properties:{bornIn:"Copenhagen, Denmark", imdbId:"0081540", born:date('1960-04-15'), name:"Susanne Bier", bio:"Susanne Bier (born 15 April 1960) is a Danish film director best known for her feature films Brothers, After the Wedding and the Academy-Award-winning In a Better World. \n\nDescription above from the Wikipedia article Susanne Bier, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tVp2J7hMAgJnaXtQojFN3VTVYaY.jpg", url:"https://themoviedb.org/person/1011"}}, {tmdbId:"33254", properties:{bornIn:"Scotland", imdbId:"0318947", name:"Jim Gillespie", bio:"Jim Gillespie is a Scottish film director.  His directing work includes I Know What You Did Last Summer (1997), and D-Tox (2002)...", url:"https://themoviedb.org/person/33254"}}, {tmdbId:"64992", properties:{bornIn:"Mei County, Guangdong", imdbId:"0396284", born:date('1947-04-08'), name:"Hou Hsiao-hsien", bio:"From Wikipedia, the free encyclopedia. \n\nHou Hsiao-hsien (Chinese: 侯孝賢; pinyin: Hóu Xiàoxián) (born April 8, 1947) is an award-winning film director and a leading figure of Taiwan's New Wave cinema movement...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rqP4CEO6toAwGhsj8mmdu3Bta6I.jpg", url:"https://themoviedb.org/person/64992"}}, {tmdbId:"120218", properties:{imdbId:"0731253", name:"John Roberts", url:"https://themoviedb.org/person/120218"}}, {tmdbId:"44130", properties:{bornIn:"Liverpool, England, UK", imdbId:"0528420", born:date('1946-06-11'), name:"Paul Lynch", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5gTl4LfofAuzpSm6jo12O6Z5cvz.jpg", url:"https://themoviedb.org/person/44130"}}, {tmdbId:"42060", properties:{bornIn:"San Francisco, California, USA", imdbId:"0291548", born:date('1893-03-21'), name:"Sidney Franklin", bio:"From Wikipedia\n\nSidney Franklin (March 21, 1893 — May 18, 1972) was an American film director and producer.  His brother Chester Franklin also became a director during the silent film era...", died:date('1972-05-18'), url:"https://themoviedb.org/person/42060"}}, {tmdbId:"33541", properties:{imdbId:"0160602", name:"Mark Christopher", url:"https://themoviedb.org/person/33541"}}, {tmdbId:"33557", properties:{imdbId:"0073035", name:"Michael Benveniste", url:"https://themoviedb.org/person/33557"}}, {tmdbId:"33558", properties:{imdbId:"0956172", name:"Howard Ziehm", url:"https://themoviedb.org/person/33558"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"116792", properties:{imdbId:"0507185", name:"Everett Lewis", bio:"From Wikipedia, the free encyclopedia. \n\nEverett Lewis is an American director, screenwriter and producer.  He earned his Bachelor of Arts from North Carolina State University and a Master of Fine Arts from the University of Southern California.  He also serves on the faculty or as a guest lecturer of a number of colleges and universities, including the University of Southern California School of Cinematic Arts, Chapman University and Long Beach City College...", url:"https://themoviedb.org/person/116792"}}, {tmdbId:"121829", properties:{imdbId:"0446060", name:"Barnet Kellman", url:"https://themoviedb.org/person/121829"}}, {tmdbId:"1551246", properties:{name:"Ross Adam", url:"https://themoviedb.org/person/1551246"}}, {tmdbId:"67756", properties:{imdbId:"0042472", name:"Michael Austin", url:"https://themoviedb.org/person/67756"}}, {tmdbId:"66639", properties:{imdbId:"1249947", name:"Michael Hofmann", url:"https://themoviedb.org/person/66639"}}, {tmdbId:"117794", properties:{bornIn:"Bristol, England, UK", imdbId:"0606439", born:date('1962-06-15'), name:"Chris Morris", bio:"From Wikipedia, the free encyclopedia\n\nChristopher Morris (born 15 June 1962) is an English satirist, writer, director and actor.  A former radio DJ, he is best known for anchoring the spoof news and current affairs television programmes The Day Today and Brass Eye, as well as his frequent engagement with controversial subject matter. \n\nIn 2010 Morris directed his first feature-length film Four Lions about a group of inept British terrorists...", url:"https://themoviedb.org/person/117794"}}, {tmdbId:"82286", properties:{imdbId:"0505660", name:"Marc Levin", bio:"From Wikipedia, the free encyclopedia. \n\nMarc Levin (born in 1951) is a Jewish American filmmaker who is perhaps best known for his film Slam (1998) which won both the Sundance Film Festival's Dramatic Feature Grand Jury Prize and the Cannes Film Festival's Golden Camera award.  Levin was awarded the 1997 DuPont-Columbia Award for CIA: America's Secret Warriors, a three-part series that first aired on the Discovery Channel...", url:"https://themoviedb.org/person/82286"}}, {tmdbId:"586103", properties:{bornIn:"San Sebastián, España", imdbId:"1084937", born:date('1975-01-01'), name:"Luiso Berdejo", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1BTRXkR4pKumMEktHJTRm8clGqS.jpg", url:"https://themoviedb.org/person/586103"}}, {tmdbId:"47005", properties:{imdbId:"0851930", born:date('1965-01-01'), name:"Alan Taylor", bio:"Alan Taylor is an American television and film director, television producer, and screenwriter, known for his work on TV shows such as Lost, The West Wing, Six Feet Under, Sex and the City, The Sopranos, and the films Palookaville, Thor: The Dark World and Terminator Genisys...", url:"https://themoviedb.org/person/47005"}}, {tmdbId:"34402", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0076618", born:date('1905-07-12'), name:"Edward Bernds", bio:"Edward Bernds was an American screenwriter and director...", died:date('2000-05-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5HREQElhmdsUwok6k9i8vZ7xfK.jpg", url:"https://themoviedb.org/person/34402"}}, {tmdbId:"57447", properties:{bornIn:"Racine, Wisconsin, USA", imdbId:"0189610", born:date('1948-08-01'), name:"Christopher Crowe", url:"https://themoviedb.org/person/57447"}}, {tmdbId:"933", properties:{imdbId:"0629933", name:"William Nicholson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/szH7cvOglYQn2pOeuorbQOtoiAO.jpg", url:"https://themoviedb.org/person/933"}}, {tmdbId:"8573", properties:{bornIn:"  United States", imdbId:"0942869", name:"Thomas J. Wright", bio:"From Wikipedia, the free encyclopedia. \n\nThomas J.  Wright is an American television director, artist, and set designer.  Wright has directed episodes of Smallville, One Tree Hill, Firefly, and many other programs.  He also worked extensively on Chris Carter's Millennium, on which he was a producer as well as directing 26 of the show's 67 episodes.  He also directed the 1989 Hulk Hogan film No Holds Barred...", url:"https://themoviedb.org/person/8573"}}, {tmdbId:"1178751", properties:{imdbId:"0368057", name:"Koji Hashimoto", url:"https://themoviedb.org/person/1178751"}}, {tmdbId:"46442", properties:{imdbId:"0800048", name:"Adam Simon", url:"https://themoviedb.org/person/46442"}}, {tmdbId:"34891", properties:{imdbId:"0425843", name:"Mike Johnson", url:"https://themoviedb.org/person/34891"}}, {tmdbId:"65401", properties:{imdbId:"0676361", name:"Charlie Peters", url:"https://themoviedb.org/person/65401"}}, {tmdbId:"285452", properties:{imdbId:"0971919", name:"Pete Jones", url:"https://themoviedb.org/person/285452"}}, {tmdbId:"8012", properties:{imdbId:"0054659", name:"Alan Barillaro", url:"https://themoviedb.org/person/8012"}}, {tmdbId:"71031", properties:{imdbId:"0035830", born:date('1944-07-24'), name:"Michael Armstrong", url:"https://themoviedb.org/person/71031"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"1293762", properties:{imdbId:"2392222", name:"Oscar Sharp", url:"https://themoviedb.org/person/1293762"}}, {tmdbId:"258199", properties:{imdbId:"0552786", name:"Michael Martin", url:"https://themoviedb.org/person/258199"}}, {tmdbId:"9888", properties:{bornIn:"Paris, France", imdbId:"0219136", born:date('1946-04-21'), name:"Claire Denis", bio:"Claire Denis (French: [dəni]; born 21 April 1946 in Paris) is a French auteur film director and writer.  Denis is widely regarded as one of the strongest female voices in contemporary world cinema.  Her film Beau Travail (1999) is considered a modern masterpiece and one of the greatest female-directed films in the history of cinema.  Other acclaimed works include Trouble every Day (2001), 35 Shots of Rum (2008), White Material (2009) and High Life (2018)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zKR7pmegNQDjWqeWv7JNvHqJ2l5.jpg", url:"https://themoviedb.org/person/9888"}}, {tmdbId:"1062093", properties:{imdbId:"0290867", name:"Carol Frank", url:"https://themoviedb.org/person/1062093"}}, {tmdbId:"111094", properties:{bornIn:"Recife, Pernambuco, Brazil", born:date('1970-01-18'), name:"Heitor Dhalia", bio:"​From Wikipedia, the free encyclopedia\n\nHeitor Dhalia (born 18 January 1970) is a Brazilian film director and screenwriter.  He has directed five films since 1988.  His film, À Deriva, competed in the Un Certain Regard section at the 2009 Cannes Film Festival. \n\nDescription above from the Wikipedia article Diane Lane, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tcozYi3Fw46hg1QA11q6KZjQR1z.jpg", url:"https://themoviedb.org/person/111094"}}, {tmdbId:"2004", properties:{bornIn:"Forestville, New York, USA", imdbId:"0007973", born:date('1887-01-25'), name:"George Abbott", bio:"From Wikipedia, the free encyclopedia. \n\nGeorge Francis Abbott (June 25, 1887 – January 31, 1995) was an American theater producer and director, playwright, screenwriter, and film director and producer whose career spanned more than eight decades...", died:date('1995-01-31'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/43Tj83RQFgWCkTgpDAgRcbkyqaZ.jpg", url:"https://themoviedb.org/person/2004"}}, {tmdbId:"1245609", properties:{imdbId:"0113845", name:"Jim Brown", url:"https://themoviedb.org/person/1245609"}}, {tmdbId:"206549", properties:{imdbId:"0721944", name:"Scott Reynolds", url:"https://themoviedb.org/person/206549"}}, {tmdbId:"157208", properties:{imdbId:"0675479", name:"Bill Persky", url:"https://themoviedb.org/person/157208"}}, {tmdbId:"1664321", properties:{name:"Peter Barton", url:"https://themoviedb.org/person/1664321"}}, {tmdbId:"60922", properties:{imdbId:"0330347", name:"Josh Gordon", bio:"American director Josh Gordon gained notoriety in the 1990s by directing notable short films such as Angry Boy and Culture.   His career really took off in 2007 when he was not only an executive producer for the TV show Caveman, he also co-directed Blades of Glory starring Will Ferrell...", url:"https://themoviedb.org/person/60922"}}, {tmdbId:"97322", properties:{imdbId:"1326065", name:"Richard Bell", url:"https://themoviedb.org/person/97322"}}, {tmdbId:"20133", properties:{bornIn:"New York City, New York, USA", imdbId:"0931095", born:date('1968-09-27'), name:"Tod Williams", bio:"From Wikipedia, the free encyclopedia. \n\nTod Culpan \"Kip\" Williams (born September 27, 1968) is an American director, producer and screenwriter. \n\nDescription above from the Wikipedia article Kip Williams, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/20133"}}, {tmdbId:"35052", properties:{bornIn:"Ho Chi Minh City, Vietnam", imdbId:"0004784", born:date('1973-09-14'), name:"Tony Bui", url:"https://themoviedb.org/person/35052"}}, {tmdbId:"1197567", properties:{imdbId:"0394793", name:"Andrew Horn", url:"https://themoviedb.org/person/1197567"}}, {tmdbId:"234793", properties:{imdbId:"0002174", name:"Yves Angelo", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8MxSOC3x1Uch1GNDC8IHYvzKTrC.jpg", url:"https://themoviedb.org/person/234793"}}, {tmdbId:"223393", properties:{imdbId:"0593592", name:"Max Mitchell", url:"https://themoviedb.org/person/223393"}}, {tmdbId:"3431", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"0748022", born:date('1943-03-10'), name:"Bruce Joel Rubin", bio:"Bruce Joel Rubin (b.  March 10, 1943, Detroit, Michigan) is a screenwriter best known for the supernatural romance, Ghost for which he won the 1991 Oscar for Best Original Screenplay.  \n\nHe also wrote the screenplay for the 1990 psychological thriller Jacob's Ladder...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jgSFvY1hTFONlIkbfGHHnH6DW50.jpg", url:"https://themoviedb.org/person/3431"}}, {tmdbId:"139898", properties:{imdbId:"0096995", name:"Arthur Borman", url:"https://themoviedb.org/person/139898"}}, {tmdbId:"66800", properties:{bornIn:"Long Beach, California, USA", imdbId:"0293533", born:date('1969-12-05'), name:"Morgan J. Freeman", bio:"From Wikipedia, the free encyclopedia\n\nMorgan J.  Freeman (born December 5, 1969) is an American film director.  In 1997, his debut feature, Hurricane Streets, became the first narrative film to win three awards at the Sundance Film Festival (Audience Award, Best Director, and Best Cinematography).  The film was bought by MGM/UA and distributed the following year. \n\nMorgan received a BA in film studies from UC Santa Barbara in 1992...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fcpw2XhChM1kty9USRe3yIrygHg.jpg", url:"https://themoviedb.org/person/66800"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"1197831", properties:{name:"Vanessa Middleton", url:"https://themoviedb.org/person/1197831"}}, {tmdbId:"1057662", properties:{bornIn:"Evanston, Illinois, USA", imdbId:"0565342", born:date('1950-02-16'), name:"Todd McCarthy", bio:"Todd McCarthy is an American film critic.  He wrote for Variety for 31 years as its chief film critic until 2010.  In October of that year, he joined The Hollywood Reporter where he subsequently became chief film critic. \n\nWas born on February 16, 1950 in Evanston, Illinois, the son of Daniel and Barbara McCarthy.  His mother was a cellist and served as the president of the Evanston Symphony Orchestra.  His father was a rancher and real-estate developer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ik8MtRAtyYsRH4a3blYQQbDY1Tf.jpg", url:"https://themoviedb.org/person/1057662"}}, {tmdbId:"1057663", properties:{imdbId:"0760523", name:"Stuart Samuels", url:"https://themoviedb.org/person/1057663"}}, {tmdbId:"56982", properties:{imdbId:"0077686", name:"Tom Berry", url:"https://themoviedb.org/person/56982"}}, {tmdbId:"144430", properties:{name:"Paul Donovan", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yRLN3vjr1sYqikeSjQTMULlnjG7.jpg", url:"https://themoviedb.org/person/144430"}}, {tmdbId:"1109245", properties:{imdbId:"1779938", name:"Digby Cook", url:"https://themoviedb.org/person/1109245"}}, {tmdbId:"57446", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0738796", born:date('1959-09-18'), name:"Mark Romanek", bio:"From Wikipedia, the free encyclopedia. \n\nMark Romanek (born September 18, 1959) is an American music video director who has also moved into directing theatrical films...", url:"https://themoviedb.org/person/57446"}}, {tmdbId:"35479", properties:{imdbId:"0087071", name:"John Blanchard", bio:"From Wikipedia, the free encyclopedia. \n\nJohn Blanchard is a Canadian television director and producer. \n\nHe is best known for his directorial work on the sketch comedy series SCTV, The Kids in the Hall, CODCO, MADtv and the talk show The Martin Short Show for which he won a Daytime Emmy Award for Outstanding Directing in a Talk Show...", url:"https://themoviedb.org/person/35479"}}, {tmdbId:"2613476", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0205282", born:date('1937-01-02'), name:"Peter Davis", bio:"Peter Davis was born on January 2, 1937 in Los Angeles, California.  His parents were the screenwriters Frank Davis and Tess Slesinger (who was also a short story writer and novelist).  Davis is a producer and director, known for Hearts and Minds (1974), The Selling of the Pentagon (1971) and \"JACK\" (1993).  Davis has also written three nonfiction books: Hometown, Where Is Nicaragua? and If You Came This Way...", url:"https://themoviedb.org/person/2613476"}}, {tmdbId:"183", properties:{bornIn:"Wakayama Prefecture, Japan", imdbId:"0605479", born:date('1959-12-26'), name:"Koji Morimoto", bio:"is a Japanese anime director.  Some of his works include being an animator in the Akira film; shorts in Robot Carnival, Short Peace, and The Animatrix; and key animation in anime such as Kiki's Delivery Service, City Hunter, and Fist of the North Star.  He is the co-founder of Studio 4°C...", url:"https://themoviedb.org/person/183"}}, {tmdbId:"1464511", properties:{name:"John Forte", url:"https://themoviedb.org/person/1464511"}}, {tmdbId:"114562", properties:{bornIn:"Council Bluffs, Iowa, USA", imdbId:"0446129", born:date('1905-11-15'), name:"Ray Kellogg", bio:"From Wikipedia, the free encyclopedia\n\nEdgar Ray Kellogg (November 15, 1905 - July 5, 1976) was an American special effects artist and film director. \n\nDuring World War II, Kellogg was a U. S.  Navy Lieutenant with the O. S. S.  Field Photographing Branch where he became acquainted with John Ford.  Following the war, Kellogg went to Hollywood, working in special effects for 20th Century Fox, eventually heading the unit.  He made his debut as a director in 1959...", died:date('1976-07-05'), url:"https://themoviedb.org/person/114562"}}, {tmdbId:"2490", properties:{bornIn:"Pusztatúrpásztó, Austria-Hungary (now Hungary)", imdbId:"0466099", born:date('1893-09-16'), name:"Alexander Korda", bio:"​From Wikipedia, the free encyclopedia\n\nSir Alexander Korda (/ˈkɔːrdə/; born Sándor László Kellner, 16 September 1893 – 23 January 1956) was a British film producer and director and screenwriter, who founded his own film production studios and film distribution company...", died:date('1956-01-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/93uwIiQQLFilIkemBrjS2D4WgCQ.jpg", url:"https://themoviedb.org/person/2490"}}, {tmdbId:"36425", properties:{bornIn:"Kalamazoo, Michigan, USA", imdbId:"0629334", born:date('1968-08-09'), name:"McG", bio:"Joseph McGinty Nichol, better known as McG, is an American director and producer of film and television.  He began his career in the music industry, directing music videos and producing various albums.  He later rose to prominence with his first film, Charlie's Angels...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yCCOETvYXMA8KmSeFHCwzh6k6Vp.jpg", url:"https://themoviedb.org/person/36425"}}, {tmdbId:"40054", properties:{bornIn:"Oakland, California, USA", imdbId:"0831720", born:date('1902-07-16'), name:"Andrew L. Stone", bio:"From Wikipedia, the free encyclopedia. \n\nAndrew L.  Stone (b.  July 16, 1902, Oakland, California - d.  June 9, 1999, Los Angeles, California) was an American screenwriter, director, and producer.  Best known for his hard hitting, realistic films, Stone frequently collaborated with his wife, editor and producer Virginia Lively Stone (credited as Virginia L.  Stone)...", died:date('1999-06-09'), url:"https://themoviedb.org/person/40054"}}, {tmdbId:"149091", properties:{bornIn:"Milwaukee, Wisconsin, U.S.", born:date('1912-05-24'), name:"Joseph Anthony", bio:"From Wikipedia, the free encyclopedia\n\nJoseph Anthony (May 24, 1912 – January 20, 1993) was an American playwright, actor, and director.  He made his film acting debut in the 1934 film Hat, Coat, and Glove and his theatrical acting debut in a 1935 production of Mary of Scotland.  On five occasions he was nominated for a Tony Award for Best Direction. \n\nJoseph Anthony was born as Joseph Deuster in Milwaukee, Wisconsin on May 24, 1912.  His parents were Leonard Deuster and Sophie Deuster (née Hertz)...", died:date('1993-01-20'), url:"https://themoviedb.org/person/149091"}}, {tmdbId:"83905", properties:{imdbId:"0614645", born:date('1912-05-08'), name:"Richard Murphy", died:date('1993-05-19'), url:"https://themoviedb.org/person/83905"}}, {tmdbId:"29571", properties:{bornIn:"London, Ontario, Canada", imdbId:"0731910", born:date('1878-06-14'), name:"John S. Robertson", bio:"From Wikipedia, the free encyclopedia.   John Stuart Robertson (14 June 1878 in London, Ontario – 5 November 1964 in California) was a Canadian born actor and later film director perhaps best known for his 1920 screen adaptation of Dr.  Jekyll and Mr.  Hyde, starring John Barrymore.  He broke into filmmaking in 1915 with Vitagraph, then with Famous Players-Lasky, making 57 features in his career.  Robertson left film in 1935, amid the increasing prevalence of sound pictures...", died:date('1964-11-05'), url:"https://themoviedb.org/person/29571"}}, {tmdbId:"53069", properties:{bornIn:"Berkeley, California, US", imdbId:"1349818", born:date('1976-09-20'), name:"Anna Boden", bio:"Anna Boden is an American film director, cinematographer, editor, and screenwriter best known as the co-writer of the 2006 film Half Nelson.  She is known for her collaborations with fellow filmmaker Ryan Fleck. \n\nDescription above from the Wikipedia article Anna Boden, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/53069"}}, {tmdbId:"814", properties:{bornIn:"London, United Kingdom", imdbId:"0443411", born:date('1946-01-11'), name:"Tony Kaye", bio:"A director of films, music videos, advertisements and documentaries.  Kaye has made several iconic music videos, including the video for \"Runaway Train\" by Soul Asylum, which won a Grammy Award; \"Dani California\" by Red Hot Chili Peppers; \"What God Wants\" by Roger Waters; and \"Help Me\" and \"God's Gonna Cut You Down\" by Johnny Cash.  Kaye is a six time Grammy nominated music video director...", url:"https://themoviedb.org/person/814"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"935102", properties:{bornIn:"Buenos Aires, Argentina", imdbId:"3014420", born:date('1977-12-08'), name:"Marco Berger", bio:"Marco Berger is an Argentinean film director and screenwriter born December 8, 1977.  He studied at the Universidad del Cine in Buenos Aires and made his directorial debut in 2007 with the short films Una última voluntad and El reloj.  His first feature film was Plan B, which was presented on a number of film festivals (Buenos Aires, Rome, London)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p4NqcK2vMtZQ4TRfvVgg0qOzK8B.jpg", url:"https://themoviedb.org/person/935102"}}, {tmdbId:"86293", properties:{bornIn:"New York City, New York, USA", imdbId:"0950001", born:date('2018-05-01'), name:"Robert M. Young", bio:"Robert Milton Young, usually known as Robert M.  Young (born November 22, 1924 in New York City, New York), is an American multi-award winning screenwriter, director, cinematographer and producer. [1] In 1985 he was a member of the jury at the 14th Moscow International Film Festival...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iekSJ1eb9o0zvJqPwgEdx1ZfRsE.jpg", url:"https://themoviedb.org/person/86293"}}, {tmdbId:"37236", properties:{bornIn:"Trivandrum, Kerala, India", imdbId:"0007144", born:date('1964-03-08'), name:"Santosh Sivan", bio:"Santosh Sivan ASC, ISC is an Indian cinematographer, film director, producer and actor in Indian cinema.  Santosh graduated from the Film and Television Institute of India (FTII) and has to date completed 45 feature films and 41 documentaries. [3] He is a founding member of the Indian Society of Cinematographers (ISC) and is the most awarded Director of Photography (DOP) in India...", url:"https://themoviedb.org/person/37236"}}, {tmdbId:"937124", properties:{imdbId:"0601262", name:"Guy Moore", url:"https://themoviedb.org/person/937124"}}, {tmdbId:"38494", properties:{imdbId:"0897045", name:"Daniel Vigne", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fzHdk95lTTuJD6r44TQehxCEgU8.jpg", url:"https://themoviedb.org/person/38494"}}, {tmdbId:"37577", properties:{bornIn:"Barcelona, Barcelona, Catalonia, Spain", imdbId:"0000940", born:date('1946-03-19'), name:"Bigas Luna", bio:"Bigas Luna is a Spanish film director.  He began his professional career in the design world, creating the 'Estudio Gris' with Carlos Riart in 1969.  In his earlier exhibitions, at the beginning of the sixties, he showed a great interest in conceptual art and the emerging visual technologies.  Esteemed as an atypical director in the Spanish cinema, in 1986 he retired to Tarragona in order to devote his time to painting...", died:date('2013-04-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5TcxEE7z5zSPvAkg8D1CIpYdLuR.jpg", url:"https://themoviedb.org/person/37577"}}, {tmdbId:"133406", properties:{imdbId:"3656297", name:"Dan Rush", url:"https://themoviedb.org/person/133406"}}, {tmdbId:"1135524", properties:{imdbId:"2405259", name:"Paul Thomas", url:"https://themoviedb.org/person/1135524"}}, {tmdbId:"60243", properties:{bornIn:" Slippery Rock, Pennsylvania, USA", imdbId:"0003343", born:date('1965-09-25'), name:"Rob Schmidt", bio:"​From Wikipedia, the free encyclopedia. \n\nRob Schmidt (born September 25, 1965) is an American film director and writer.  His film credits include Wrong Turn and Crime and Punishment in Suburbia.  He also created a pilot called American Town for Twentieth Century Fox.  He directed a Masters of Horror episode called \"Right to Die...", url:"https://themoviedb.org/person/60243"}}, {tmdbId:"6284", properties:{imdbId:"0689392", born:date('1938-05-21'), name:"Kay Pollak", bio:"Kay\n\nPollak is a Swedish film director.  After a long break from film-making, he\n\nreturned in 2004 with As It Is in Heaven (Så som i himmelen), a major box\n\noffice success in Sweden.  The film was nominated for an Academy Award for Best\n\nForeign Language Film.  It was also nominated for no less than eight Swedish Guldbagge\n\nAwards, including Best Direction and Best Film, but received none...", url:"https://themoviedb.org/person/6284"}}, {tmdbId:"136345", properties:{bornIn:"Hobart, Tasmania, Australia", imdbId:"2015237", name:"Sean Byrne", bio:"Sean hails from Hobart, Tasmania.  The Loved Ones (2009) is his first feature and has achieved official selection at over twenty international film festivals, winning the People's Choice Award, Midnight Madness Category, Toronto International Film Festival (2009) and The Siren Award for Best International Feature, Lund International Film Festival (2010)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gBnLv1mDLPtCFQtUrdegSkR8CsS.jpg", url:"https://themoviedb.org/person/136345"}}, {tmdbId:"141169", properties:{imdbId:"2788363", name:"Lee Seung-moo", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/26TbxNeRWlNI5S9D90PpU5aXDe8.jpg", url:"https://themoviedb.org/person/141169"}}, {tmdbId:"56929", properties:{bornIn:"London, England, UK", imdbId:"0605093", born:date('1899-01-01'), name:"William Morgan", bio:"William Morgan was a London-born film editor and director.  He also edited some episodes of three 1950s television series...", died:date('1964-01-01'), url:"https://themoviedb.org/person/56929"}}, {tmdbId:"12952", properties:{imdbId:"0358960", born:date('1946-01-26'), name:"Christopher Hampton", url:"https://themoviedb.org/person/12952"}}, {tmdbId:"105055", properties:{bornIn:"Columbus, Ohio, USA", imdbId:"0808542", born:date('1932-11-14'), name:"Jack Smith", bio:"Jack Smith was an American filmmaker, actor, and pioneer of underground cinema.  He is generally acclaimed as a founding father of American performance art, and has been critically recognized as a master photographer, though his photographic works are rare and remain largely unknown...", died:date('1989-09-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/esTDlW3y21jIz32D9bAqSxeseQU.jpg", url:"https://themoviedb.org/person/105055"}}, {tmdbId:"1203291", properties:{imdbId:"0736537", name:"Ferenc Rófusz", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5TxFKJGbgfdQp4zlk9cJAgSLmIC.jpg", url:"https://themoviedb.org/person/1203291"}}, {tmdbId:"55038", properties:{imdbId:"0351993", name:"Philip Haas", bio:"​From Wikipedia, the free encyclopedia\n\nPhilip Haas is an American artist and filmmaker.  His exhibition of film installations at the Kimbell Art Museum, \"Butchers, Dragons, Gods and Skeletons,\" was listed by TIME magazine as one of the top ten museum shows of 2009 Retrospectives of his art films have been held at the Tate Gallery in London, the Centre Georges Pompidou in Paris, Lincoln Center in New York, the Museum of Fine Arts, Boston, and the National Gallery of Art in Washington, D. C...", url:"https://themoviedb.org/person/55038"}}, {tmdbId:"1566166", properties:{name:"Mark Lewis", url:"https://themoviedb.org/person/1566166"}}, {tmdbId:"138322", properties:{bornIn:"DeLand, Florida, USA", imdbId:"0638033", name:"Victor Nunez", bio:"From Wikipedia, the free encyclopedia. \n\nVictor Nuñez (born 1945) is a film director, professor at the Florida State University College of Motion Picture, Television and Recording Arts, and a founding member of the Independent Feature Project.  He is best known for directing Ulee's Gold, a critically acclaimed movie starring Jessica Biel and Peter Fonda. \n\nNuñez grew up in Peru and Tallahassee, Florida...", url:"https://themoviedb.org/person/138322"}}, {tmdbId:"96657", properties:{bornIn:"Daegu, South Korea", imdbId:"0496969", born:date('1954-04-01'), name:"Lee Chang-dong", bio:"Lee Chang-dong (born July 4, 1954) is a South Korean film director, screenwriter and novelist.  He won the 2008 Special Director's Prize at the Asian Film Awards and has been nominated for the Golden Lion and Palme d'Or.  Lee served as the minister of Culture and Tourism in the South Korean Government from 2003 to 2004. \n\nDescription above from the Wikipedia article Lee Chang-dong, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vGd5mddV2YGuuC6q1B15bwHnmCu.jpg", url:"https://themoviedb.org/person/96657"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"85311", properties:{imdbId:"0368675", name:"Masanori Hata", url:"https://themoviedb.org/person/85311"}}, {tmdbId:"146295", properties:{born:date('1952-01-01'), name:"Yim Ho", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sU7Df0Yuoc21YxVEb1WocR1cL05.jpg", url:"https://themoviedb.org/person/146295"}}, {tmdbId:"6558", properties:{bornIn:"Fort Scott, Kansas, United States", imdbId:"0662953", born:date('1912-11-30'), name:"Gordon Parks", bio:"From Wikipedia, the free encyclopedia. \n\nGordon Roger Alexander Buchanan Parks (November 30, 1912 – March 7, 2006) was a groundbreaking American photographer, musician, poet, novelist, journalist, activist and film director.  He is best remembered for his photo essays for Life magazine and as the director of the 1971 film Shaft...", died:date('2006-03-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wBcsvgQwaRkIitgUkEcVEwguPPH.jpg", url:"https://themoviedb.org/person/6558"}}, {tmdbId:"132257", properties:{bornIn:"Genoa, Liguria, Italy", imdbId:"0598855", born:date('1930-02-22'), name:"Giuliano Montaldo", bio:"Born in 1930 in Genoa.  Still a young student in 1950 when director Carlo Lizzani gave him a role in the film Achtung Banditi!.  Following this experience he traveled to Rome where, after acting in film and theatre, he became the Assistant Director of Lizzani, Gillo Pontecorvo, Sergio Leone, Francesco Rosi.  In 1960 he made his debut as a Director with Tiro Al piccione, a film about the Partisan Resistance, on competition at the 1961 Venice Film Festival...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ncuf7q1nVfUpCJPK8YHwfHZVaG0.jpg", url:"https://themoviedb.org/person/132257"}}, {tmdbId:"19707", properties:{bornIn:" Los Angeles, California, USA", imdbId:"0023929", born:date('1951-12-27'), name:"Charles Band", bio:"​From Wikipedia, the free encyclopedia.   \n\nCharles Robert Band (b.  December 27, 1951 in Los Angeles, California) is a director, writer, and producer of horror films.  He is the son of director-producer Albert Band, and brother of the composer Richard Band.  With his former wife Meda, he has two children, Alex Band, the vocalist for band The Calling, and Taryn Band.  He has two sons with his former wife Debra Dion, Harlan and Zalman.  Charles' grandfather was the artist Max Band...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fBmoBlvkx7mO2ektp7ex7ch2mSs.jpg", url:"https://themoviedb.org/person/19707"}}, {tmdbId:"81116", properties:{bornIn:"Buenos Aires, Argentina", imdbId:"0836949", born:date('1944-12-27'), name:"Eliseo Subiela", bio:"Eliseo Alberto Subiela (born December 27, 1944 in Buenos Aires) is an Argentine film director and writer, whose works are considered to be in the 'magic realism' genre. \n\nSubiela is the father of actress, Guadalupe Subiela (who acted in her father's film, Pequeños Milagros).  He has won and been nominated for awards at the Toronto, Montreal, Berlin, Istanbul and Havana film festivals, among others...", url:"https://themoviedb.org/person/81116"}}, {tmdbId:"1167470", properties:{bornIn:"Artane, Ireland", imdbId:"2411495", born:date('1981-01-01'), name:"Gary Shore", url:"https://themoviedb.org/person/1167470"}}, {tmdbId:"43141", properties:{bornIn:"Manchester, England", imdbId:"0871428", name:"Pete Travis", bio:"From Wikipedia, the free encyclopedia. \n\nPete Travis is an English television and film director.  His work includes Cold Feet (1999), The Jury (2002) and Omagh (2004) for television, and Vantage Point (2008) and Endgame (2009) for cinema.  In November 2010, Travis began filming Dredd, a new film adaptation of the Judge Dredd comics character. \n\nDescription above from the Wikipedia article Pete Travis, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/43141"}}, {tmdbId:"46230", properties:{bornIn:"Okayama, Japan", imdbId:"0651915", born:date('1932-03-31'), name:"Nagisa Ōshima", bio:"Nagisa Ōshima (大島 渚) was a Japanese film director and screenwriter.  After graduating from Kyoto University he was hired by Shochiku Ltd.  and quickly progressed to directing his own movies, making his debut feature “A Town of Love and Hope” in 1959...", died:date('2013-01-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qt7OPEIbLdOLVupOGVKyFDqxpFr.jpg", url:"https://themoviedb.org/person/46230"}}, {tmdbId:"123401", properties:{bornIn:"Baltimore, Maryland", imdbId:"0330456", born:date('1909-09-06'), name:"Michael Gordon", bio:"​From Wikipedia, the free encyclopedia\n\nMichael Gordon (September 6, 1909 – April 29, 1993) was an American stage actor and stage and film director. \n\nDescription above from the Wikipedia article Michael Gordon (film director), licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1993-04-29'), url:"https://themoviedb.org/person/123401"}}, {tmdbId:"584335", properties:{bornIn:"Buenos Aires, Argentina", imdbId:"0122184", born:date('1973-08-23'), name:"Daniel Burman", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6zriWDd1G7g69q2pWR1UedEc6Cz.jpg", url:"https://themoviedb.org/person/584335"}}, {tmdbId:"58053", properties:{bornIn:"Colonia inglese di Hong Kong", imdbId:"1001051", born:date('1973-09-22'), name:"Pang Ho-cheung", bio:"Pang Ho-cheung (Chinese: 彭浩翔, born 22 September 1973) is a Hong Kong novelist, playwright, actor and filmmaker...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bDnzR3ayIstd13h1TBFU9ARePg3.jpg", url:"https://themoviedb.org/person/58053"}}, {tmdbId:"40307", properties:{bornIn:"London, England, UK", born:date('1958-03-25'), name:"John Maybury", bio:"From Wikipedia, the free encyclopedia.   John Maybury (born 25 March 1958) is an English filmmaker.  In 2005 he was listed as one of the 100 most influential gay and lesbian people in Britain.   Description above from the Wikipedia article John Maybury, licensed under CC-BY-SA,full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/40307"}}, {tmdbId:"12824", properties:{bornIn:"Chicago, Illinois, USA ", imdbId:"0353893", born:date('1955-11-26'), name:"Don Hahn", bio:"From Wikipedia, the free encyclopedia\n\nDon Hahn (born 1955) is an American film producer who has produced some of the most successful Walt Disney animated films of the past 20 years.  He currently owns his own film production company called Stone Circle Pictures. \n\nDescription above from the Wikipedia article Don Hahn, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rOUyA2JG3yN2Sh4ICZoGYShU5ox.jpg", url:"https://themoviedb.org/person/12824"}}, {tmdbId:"40508", properties:{bornIn:"USA", imdbId:"0185063", born:date('1975-02-05'), name:"James Cox", url:"https://themoviedb.org/person/40508"}}, {tmdbId:"145175", properties:{bornIn:"New York City, United States", imdbId:"0662032", born:date('1885-05-11'), name:"Albert Parker", bio:"From Wikipedia, the free encyclopedia. \n\nAlbert Parker (11 May 1885, New York City – 10 August 1974, London) was an American film director, producer, screenwriter and actor.  He directed 36 films between 1917 and 1938.  In the early 1930s Parker left Hollywood for England where he continued to direct films and also opened an actors' agency office.  One of his later clients in the 1960s was a young actress named Helen Mirren. \n\nHe was born in New York, New York and died in London, England...", died:date('1974-08-10'), url:"https://themoviedb.org/person/145175"}}, {tmdbId:"53329", properties:{imdbId:"0819862", name:"David Sproxton", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zVeJRzQaIvENbOUbhMgP4DkgK7W.jpg", url:"https://themoviedb.org/person/53329"}}, {tmdbId:"215396", properties:{name:"Richard Goleszowski", url:"https://themoviedb.org/person/215396"}}, {tmdbId:"1119483", properties:{imdbId:"0668849", name:"Peter Peake", url:"https://themoviedb.org/person/1119483"}}, {tmdbId:"1119834", properties:{imdbId:"0725725", name:"Dave Alex Riddett", url:"https://themoviedb.org/person/1119834"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"1265554", properties:{imdbId:"0177174", name:"Luis Cook", url:"https://themoviedb.org/person/1265554"}}, {tmdbId:"1242904", properties:{imdbId:"0232401", name:"Vincent J. Donehue", url:"https://themoviedb.org/person/1242904"}}, {tmdbId:"107168", properties:{imdbId:"0452772", name:"Stephen Kijak", bio:"​From Wikipedia, the free encyclopedia.   \n\nStephen Kijak is an American filmmaker. Kijak studied with renowned film scholar and John Cassavetes expert Ray Carney as well as the late Mel Howard at Boston University’s College of Communication.  He wrote, directed and produced the feature film Never Met Picasso (1996) which starred Margot Kidder, Alexis Arquette and Don McKellar (music by Kristin Hersh)...", url:"https://themoviedb.org/person/107168"}}, {tmdbId:"82293", properties:{imdbId:"0086282", name:"Jon Blair", url:"https://themoviedb.org/person/82293"}}, {tmdbId:"144590", properties:{born:date('1971-09-21'), name:"Lee Jeong-beom", bio:"Lee Jeong-beom (born September 21, 1971) is a South Korean film director and screenwriter.  He is best known for such films as Cruel Winter Blues (2006) and The Man from Nowhere (2010).  With more than 6 million admissions and a revenue of ₩47. 1 billion, The Man from Nowhere was the best-selling film (domestic and foreign) in Korea in 2010...", url:"https://themoviedb.org/person/144590"}}, {tmdbId:"240366", properties:{imdbId:"0385971", name:"Carma Hinton", url:"https://themoviedb.org/person/240366"}}, {tmdbId:"30811", properties:{imdbId:"0330545", name:"Richard Gordon", url:"https://themoviedb.org/person/30811"}}, {tmdbId:"1673596", properties:{imdbId:"0925474", name:"Steve White", url:"https://themoviedb.org/person/1673596"}}, {tmdbId:"80924", properties:{bornIn:"Gothenburg, Västra Götalands län, Sweden", imdbId:"0825407", born:date('1970-11-17'), name:"Björn Stein", bio:"Björn Stein was born on November 17, 1970 in Annedal, Gothenburg, Västra Götalands län, Sweden as Björn Leonard Stein.  He is a writer and director...", url:"https://themoviedb.org/person/80924"}}, {tmdbId:"550045", properties:{imdbId:"1905310", name:"Jeff Zimbalist", url:"https://themoviedb.org/person/550045"}}, {tmdbId:"550046", properties:{imdbId:"3104562", name:"Michael Zimbalist", url:"https://themoviedb.org/person/550046"}}, {tmdbId:"32012", properties:{bornIn:"Liévin,France", imdbId:"0257992", born:date('1931-04-13'), name:"Robert Enrico", bio:"Robert Georgio Enrico (13 April 1931 – 23 February 2001) was a French film director and scriptwriter best known for making the Oscar-winning short An Occurrence at Owl Creek Bridge (1961). \n\nHe was born in Liévin, Pas-de-Calais, in the north of France, to Italian immigrant parents, and died in Paris. \n\nSource: Article \"Robert Enrico\" from Wikipedia in english, licensed under CC-BY-SA 3. 0...", died:date('2001-02-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fYtLJaqGzzsjWODelx6Cmwje5mn.jpg", url:"https://themoviedb.org/person/32012"}}, {tmdbId:"33223", properties:{bornIn:"Elmira, New York, USA", imdbId:"0730018", born:date('1892-01-14'), name:"Hal Roach", bio:"Harry Eugene Roach Sr.  professionally known as Hal Roach, was an American film and television producer, director, and actor who was active from the 1910s to the 1990s.  He is remembered today for producing a number of successes including the Laurel and Hardy franchise, the films of entertainer Charley Chase, and the Our Gang film comedy series...", died:date('1992-11-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/g8v06AclO77Lrrlhj8NST9UQwf3.jpg", url:"https://themoviedb.org/person/33223"}}, {tmdbId:"93953", properties:{imdbId:"0257698", born:date('1926-06-22'), name:"George Englund", died:date('2017-09-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aQCOs2EXCYoUVbD116qVhUehCLA.jpg", url:"https://themoviedb.org/person/93953"}}, {tmdbId:"7348", properties:{bornIn:"Mexico, D. F., Mexico", imdbId:"0140196", born:date('1962-08-18'), name:"Carlos Carrera", url:"https://themoviedb.org/person/7348"}}, {tmdbId:"51950", properties:{imdbId:"0081590", name:"Robert Bierman", url:"https://themoviedb.org/person/51950"}}, {tmdbId:"5058", properties:{bornIn:"London, England UK", imdbId:"0002337", born:date('1944-01-01'), name:"Roger Christian", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1032h46ID4ORAEWLCryDprZEtNp.jpg", url:"https://themoviedb.org/person/5058"}}, {tmdbId:"161784", properties:{imdbId:"0254623", born:date('1921-08-24'), name:"Scott Elliott", died:date('2004-11-04'), url:"https://themoviedb.org/person/161784"}}, {tmdbId:"137680", properties:{name:"Jamie Johnson", bio:"From Wikipedia, the free encyclopedia. \n\nJames Wittenborn \"Jamie\" Johnson (born 1979) is an American film director, heir and socialite.  He is a documentary filmmaker, and one of the great-grandsons of Robert Wood Johnson I (co-founder of Johnson &amp; Johnson). \n\nDescription above from the Wikipedia article Jamie Johnson  , licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/137680"}}, {tmdbId:"190339", properties:{name:"Ian Iqbal Rashid", url:"https://themoviedb.org/person/190339"}}] AS row
