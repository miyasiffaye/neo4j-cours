}}, {tmdbId:"13526", properties:{bornIn:"Hollywood, California, USA", imdbId:"0001864", born:date('1971-06-04'), name:"Noah Wyle", bio:"Noah Wyle (born June 4, 1971) is an American film, television and theatre actor.  He is best known for his roles on ER as well as in The Librarian franchise...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kOCkuwHwCP0p7wDRFoV98WlcDlS.jpg", url:"https://themoviedb.org/person/13526"}}, {tmdbId:"9998", properties:{imdbId:"0806217", born:date('1968-10-02'), name:"Joey Slotnick", url:"https://themoviedb.org/person/9998"}}, {tmdbId:"31527", properties:{imdbId:"0381117", born:date('1949-03-18'), name:"J.G. Hertzler", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tFXm0QBvm3KfIBEvkzVa5c8pgPD.jpg", url:"https://themoviedb.org/person/31527"}}, {tmdbId:"31837", properties:{bornIn:"Boston, Massachusetts, U.S.", imdbId:"0176981", born:date('1972-03-18'), name:"Dane Cook", bio:"From Wikipedia, the free encyclopedia.   Dane Jeffrey Cook (born March 18, 1972) is an American stand-up comedian and film actor.  He has released five comedy albums: Harmful If Swallowed; Retaliation; Vicious Circle; Rough Around The Edges: Live From Madison Square Garden; and Isolated Incident.  Retaliation became the highest charting comedy album in 28 years  and went platinum...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vdIdIv4xvi7NXmDCAHA7Fu74jUz.jpg", url:"https://themoviedb.org/person/31837"}}] AS row
