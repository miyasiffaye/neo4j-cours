UNWIND [{tmdbId:"124471", properties:{bornIn:"Bedford, New Hampshire, U.S.", imdbId:"0583570", born:date('1976-01-08'), name:"Josh Meyers", bio:"From Wikipedia, the free encyclopedia. \n\nJoshua Dylan \"Josh\" Meyers (born January 8, 1976) is an American actor, known for being a cast member of the sketch comedy MADtv and playing Randy Pearson in the eighth and final season of That '70s Show.  He is the younger brother of Saturday Night Live head writer Seth Meyers. \n\nDescription above from the Wikipedia article Josh Meyers, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/124471"}}, {tmdbId:"342", properties:{bornIn:"Philadelphia - Pennsylvania - USA", imdbId:"0126021", born:date('1975-08-28'), name:"Eugene Byrd", bio:"From Wikipedia, the free encyclopedia. \n\nEugene Byrd (born August 28, 1975) is an American actor.  He has been in movies including Dead Man, Sleepers, 8 Mile, Lift and Anacondas: The Hunt for the Blood Orchid, and has the leading role in Confess, for which he won the Break-Out Performance Award at the 2006 Method Fest Independent Film Festival. \n\nHe starred as Dr.  Sidney Trumaine in the television show Crossing Jordan...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4Vs64bmZC4MgOnwIhGEeZWUw7q1.jpg", url:"https://themoviedb.org/person/342"}}, {tmdbId:"132157", properties:{bornIn:"Wyckoff, New Jersey, USA", imdbId:"3009232", born:date('1992-09-30'), name:"Ezra Miller", bio:"Ezra Matthew Miller (born: September 30, 1992) in Wyckoff, New Jersey 30, their mother is Marta (Koch), a modern dancer, and their father is Robert S.  Miller, who has worked at Workman Publishing and as former senior VP for Hyperion Books.  They have two older sisters.  Ezra is of Ashkenazi Jewish (father) and German-Dutch (mother) ancestry; they has described themself as Jewish and \"spiritual\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6wmTpbYpmhthaxzM5ss3377F9IV.jpg", url:"https://themoviedb.org/person/132157"}}, {tmdbId:"1431169", properties:{imdbId:"3838127", born:date('2002-10-05'), name:"Jasper Newell", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fO3Uo93f4SoSCYbfhGya7GwaWqf.jpg", url:"https://themoviedb.org/person/1431169"}}, {tmdbId:"83814", properties:{bornIn:"Salford, Lancashire, England", imdbId:"0263740", born:date('1959-07-26'), name:"Steve Evets", bio:"​From Wikipedia, the free encyclopedia.   \n\nSteve Evets (born Steven Murphy; c.  1960) is an English actor and musician, who found fame in the leading role in the 2009 film Looking for Eric. \n\nDescription above from the Wikipedia article Steve Evets, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/83814"}}, {tmdbId:"37758", properties:{bornIn:"Marseille, France", imdbId:"0134642", born:date('1966-05-24'), name:"Eric Cantona", bio:"Eric Daniel Pierre Cantona (born 24 May 1966) is a French actor and former French international footballer.  He played for Auxerre, Martigues, Marseille, Bordeaux, Montpellier, Nîmes and Leeds United before ending his professional footballing career at Manchester United, where he won four Premier League titles in five years and two League and FA Cup Doubles...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lMIXZd1QiHH7Y5emujCKGnRh6np.jpg", url:"https://themoviedb.org/person/37758"}}, {tmdbId:"83815", properties:{bornIn:"Manchester, England, UK", imdbId:"2288625", born:date('1964-01-30'), name:"Stephanie Bishop", url:"https://themoviedb.org/person/83815"}}, {tmdbId:"83817", properties:{bornIn:"Mossley, Greater Manchester, England", imdbId:"1542551", born:date('1984-10-04'), name:"Gerard Kearns", bio:"From Wikipedia, the free encyclopedia\n\nGerard Kearns (born 4 October 1984) is an English actor.  He has appeared in film and television.  He played Ian Gallagher, one of the original characters in Channel 4's Shameless, for 6 years. \n\nDescription above from the Wikipedia article Gerard Kearns, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/83817"}}, {tmdbId:"144852", properties:{bornIn:"Mississauga, Ontario, Canada", imdbId:"2113653", born:date('1991-08-18'), name:"Richard Harmon", bio:"Richard Scott Harmon (born August 18, 1991) is a Canadian actor best known for his role as John Murphy in CW's The 100.  Harmon is also known for his roles as Jasper Ames in the The Killing and Julian Randol on Continuum.  Harmon received critical praise for his role in the movie If I Had Wings. \n\nWikipedia, the free encyclopedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kYc2nCBBU9pHNDMDopk6WIVXZg6.jpg", url:"https://themoviedb.org/person/144852"}}, {tmdbId:"46903", properties:{bornIn:"Edmonton - Alberta - Canada", imdbId:"1068777", born:date('1991-11-10'), name:"Genevieve Buechner", bio:"Born on November 10, at 2:30A. M. , 1991 in Edmonton during a terrible snow storm, Genevieve Buechner was born to single parent mother Tea Buechner.  She began to pester her mother about acting lessons when she was three.  Her mother was very reluctant to encourage this interest. \n\nStill Genna persevered and finally her mother allowed her to take a small course in acting from the local theatre - Vancouver Youth Theatre...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/38ORPkiBaUMwcnHIVMpfgoLdQpc.jpg", url:"https://themoviedb.org/person/46903"}}, {tmdbId:"85506", properties:{bornIn:"Regina, Saskatchewan, Canada", imdbId:"1263747", born:date('1980-08-09'), name:"Charlie David", bio:"Charlie David (born August 9, 1980) is a Canadian actor, who stars in the LGBT horror series Dante's Cove.  He has also worked as a producer, writer, and TV host.  He was honored by Out Magazine as one of the \"Out 100\" for Remarkable Contributions to Gay Culture in 2005.  He is co-owner of Border2Border Entertainment. \n\nDescription above from the Wikipedia article Charlie David, licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eUgCfqeRiRjXlLNCMy51vjIS5gk.jpg", url:"https://themoviedb.org/person/85506"}}, {tmdbId:"5498", properties:{bornIn:"Hamburg, West Germany", imdbId:"0100196", born:date('1974-01-25'), name:"Adam Bousdoukos", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hJ8ie6negEG55KiOfjAVEMyAIDB.jpg", url:"https://themoviedb.org/person/5498"}}, {tmdbId:"53846", properties:{bornIn:"Hamburg, Germany", imdbId:"2114493", born:date('1981-06-13'), name:"Pheline Roggan", bio:"Pheline Roggan, geboren am 13.  Juni 1981 in Hamburg, absolvierte von 2001 bis 2004 eine Ausbildung an der \"Schule für Schauspiel\" in Hamburg.  Erste, noch kleine Rollen hatte sie in Anno Sauls Kinofilm \"Kebab Connection\" (2004), Frieder Wittichs Fernsehspiel \"Die Nacht der Löwen\" (2005) und Birgit Möllers \"Valerie\" (2006)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1CAVwiXiRWlGJdXrNeRfhlTTnWy.jpg", url:"https://themoviedb.org/person/53846"}}, {tmdbId:"1186434", properties:{bornIn:"Hamburg, Germany", imdbId:"3341495", born:date('1981-01-01'), name:"Anna Bederke", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/55kFW09S3KnB3c2L1P8iGLaLDEY.jpg", url:"https://themoviedb.org/person/1186434"}}, {tmdbId:"23669", properties:{bornIn:"Rouen, Seine-Maritime, France", imdbId:"0868881", born:date('1965-10-13'), name:"Philippe Torreton", bio:"From Wikipedia, the free encyclopedia. \n\nPhilippe Torreton (born 13 October 1965, Rouen, Seine-Maritime, France) is a French actor. \n\nDescription above from the Wikipedia article Philippe Torreton, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8EG07uT9b6Ytukw0Rna6JA2KFv1.jpg", url:"https://themoviedb.org/person/23669"}}, {tmdbId:"6018", properties:{bornIn:"Vitry-sur-Seine, France", imdbId:"0244999", born:date('1944-11-28'), name:"Daniel Duval", bio:"Daniel Duval (28 November 1944 – 10 October 2013) was a French film actor, director and writer. \n\nBest known as an actor, Duval has credits in over 70 television and film productions.  As a filmmaker, Duval was awarded the Silver Prize at the 10th Moscow International Film Festival in 1977 for his drama film Shadow of the Castles, which he wrote and directed.  In 2008 and 2010, he appeared in a recurring role during the second and third seasons, respectively, of the hit French TV drama Engrenages...", died:date('2013-10-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fhov7IrseaF5WKJ666VVBlxBFO3.jpg", url:"https://themoviedb.org/person/6018"}}, {tmdbId:"118616", properties:{bornIn:"Portlaoise, County Laois, Ireland", imdbId:"1588066", born:date('1988-01-07'), name:"Robert Sheehan", bio:"Robert Sheehan (born 7 January 1988) is an Irish actor.  He is the son of Joe and Maria Sheehan.  His father was a member of the Garda Síochána, the police force of the Republic of Ireland.  As a child, Sheehan was interested in performing music.  He learned how to play the banjo, the bodhrán, and the spoons.  He took part in the Fleadh Cheoil, an Irish music competition for children and teenagers...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2rum1TvJyB13RMERueiH1MrBmjZ.jpg", url:"https://themoviedb.org/person/118616"}}, {tmdbId:"27492", properties:{bornIn:"USA", imdbId:"0113595", born:date('1948-11-07'), name:"Garrett M. Brown", bio:"Garrett M.  Brown is an actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4tPbboNt7gBw8XPLK8UEA90iBpC.jpg", url:"https://themoviedb.org/person/27492"}}, {tmdbId:"116881", properties:{bornIn:" Philadelphia, Pennsylvania, USA", imdbId:"0878597", born:date('1971-12-22'), name:"Deborah Twiss", url:"https://themoviedb.org/person/116881"}}, {tmdbId:"114252", properties:{bornIn:"Doncaster, Yorkshire, England, UK", imdbId:"1296102", born:date('1979-01-01'), name:"Edward Hogg", bio:"From Wikipedia, the free encyclopedia.  Edward Hogg (born 1979) is an English actor, known for portraying Jesco White in White Lightnin' and Stephen Turnbull in Bunny and the Bull.  Description above from the Wikipedia article Edward Hogg, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aOxjerJAT9ny9AHTUPu6kxWa1r.jpg", url:"https://themoviedb.org/person/114252"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"114253", properties:{bornIn:"Yorkshire, England, UK", imdbId:"1375030", born:date('1972-11-28'), name:"Simon Farnaby", bio:"Simon Alexander Farnaby (born 2 April 1973) is an English actor, writer, and comedian.  He is best known as a part of the TV series Horrible Histories (2009-2013), Yonderland (2013-2016) and Ghosts (2019-).  He also starred in films such as Mindhorn (2016), Paddington (2014), and its sequel, Paddington 2 (2017) and Christopher Robin (2018)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5DSGbenykZIkmRwVfo6MErEF73J.jpg", url:"https://themoviedb.org/person/114253"}}, {tmdbId:"114254", properties:{bornIn:"Madrid, Spain", imdbId:"1531585", born:date('1983-06-16'), name:"Verónica Echegui", bio:"Verónica Echegui is a Spanish film and television actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n7zUdB3UN5MyEAlnvxYNajss8x2.jpg", url:"https://themoviedb.org/person/114254"}}, {tmdbId:"38664", properties:{bornIn:"Melbourne - Victoria - Australia", imdbId:"0822982", born:date('1977-06-14'), name:"Sullivan Stapleton", bio:"Sullivan Stapleton (born 14 June 1977)] is an Australian actor who is best known for his roles in the SKY (BSkyB)/Cinemax/HBO television series Strike Back and the 2010 Sundance Film Festival selection Animal Kingdom. \n\nStapleton played the lead role, Greek leader Themistocles, in the film 300: Rise of an Empire (2014).  He was honored on 24 October 2013 with a Breakthrough Award at an exclusive Australians in Film Benefit Dinner held in Los Angeles...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zT25J9Jtbhkimul2KSeCZZulIPU.jpg", url:"https://themoviedb.org/person/38664"}}, {tmdbId:"37168", properties:{bornIn:"Stornoway, UK", imdbId:"0558548", born:date('1975-08-07'), name:"Hans Matheson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mtF6cwcvhZEvxBFa5ncuxPHRWs4.jpg", url:"https://themoviedb.org/person/37168"}}, {tmdbId:"76792", properties:{bornIn:"Bombay, Maharashtra, India", imdbId:"2951768", born:date('1984-10-18'), name:"Freida Pinto", bio:"Freida Selena Pinto (born 18 October 1984) is an Indian actress who has appeared mainly in American and British films.  Born and raised in Mumbai, India, Pinto gained an interest in acting at an early age and took part in amateur theatre while she was a student at St.  Xavier's College, Mumbai, where she majored in English literature and minored in psychology and economics.  Following graduation, she worked as a model and hosted the international travel show Full Circle (2006) on Zee TV...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fhUEcLvlsy13hHO5xJb0fV3AiYw.jpg", url:"https://themoviedb.org/person/76792"}}, {tmdbId:"207396", properties:{bornIn:"Washington, D.C., USA", imdbId:"1878999", born:date('1978-10-31'), name:"Brian Hallisay", bio:"Brian Hallisay (born October 31, 1978) is an American actor best known for his role on Privileged...", url:"https://themoviedb.org/person/207396"}}, {tmdbId:"1644492", properties:{imdbId:"1323233", name:"Mustafa Kamel", url:"https://themoviedb.org/person/1644492"}}, {tmdbId:"1644499", properties:{imdbId:"4841645", name:"Hussein Sami", url:"https://themoviedb.org/person/1644499"}}, {tmdbId:"84573", properties:{bornIn:"Québec, Canada", imdbId:"0246386", born:date('1981-01-01'), name:"Mélissa Désormeaux-Poulin", bio:"Mélissa Désormeaux-Poulin (born in 1981) is a French Canadian actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pMC2DPY01mkxnwGnowJV9X4hp7i.jpg", url:"https://themoviedb.org/person/84573"}}, {tmdbId:"105235", properties:{imdbId:"3065862", name:"Adar Beck", url:"https://themoviedb.org/person/105235"}}, {tmdbId:"97576", properties:{bornIn:"London, England, UK", imdbId:"2110418", born:date('1982-11-29'), name:"Gemma Chan", bio:"Gemma Chan is a British stage, film, and television and former fashion model.  She's a graduate from the Drama Centre London, England, UK...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/r5yu8cnSaVA36j0CTSC8TjiYYE5.jpg", url:"https://themoviedb.org/person/97576"}}, {tmdbId:"105237", properties:{imdbId:"1125878", name:"John Lloyd Fillingham", url:"https://themoviedb.org/person/105237"}}, {tmdbId:"210824", properties:{bornIn:"Montclair, New Jersey, Stati Uniti", imdbId:"1393354", born:date('1980-07-12'), name:"Kristen Connolly", bio:"Kristen Connolly is an American actress.  She is known for her roles as Christina Gallagher on the Netflix show House of Cards and as Dana Polk in the 2012 movie The Cabin in the Woods...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zPXAK1KoQ78lYyBS7nmzbQNVxpl.jpg", url:"https://themoviedb.org/person/210824"}}, {tmdbId:"486603", properties:{bornIn:"Auckland, New Zealand", imdbId:"0404307", born:date('1986-02-08'), name:"Anna Hutchison", bio:"Hutchison's career began on the New Zealand soap opera Shortland Street and continued in the American series Power Rangers Jungle Fury.  She also played Allison Dine, the girlfriend of crime figure Terry Clark in the Australian television series Underbelly: A Tale of Two Cities also known as Underbelly: The Mr Asia Story, and Amy Smart in the New Zealand television comedy-drama series Go Girls...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i7o5JRt43W3qsPbFm8qhsQAws6t.jpg", url:"https://themoviedb.org/person/486603"}}, {tmdbId:"158587", properties:{imdbId:"0419363", name:"Christina Jastrzembska", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hlGttnHoGd7s4J4K48eXvS3HPA1.jpg", url:"https://themoviedb.org/person/158587"}}, {tmdbId:"85071", properties:{bornIn:"Barnsley, South Yorkshire, England, UK", imdbId:"0233215", born:date('1974-01-01'), name:"Shaun Dooley", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uWiw28ARiLkvL6xUjKDLDlSsfkY.jpg", url:"https://themoviedb.org/person/85071"}}, {tmdbId:"210386", properties:{imdbId:"1646177", name:"Morgan Murphy", bio:"Morgan Murphy is a writer and producer...", url:"https://themoviedb.org/person/210386"}}, {tmdbId:"1118075", properties:{imdbId:"2287455", name:"Naomi Glick", url:"https://themoviedb.org/person/1118075"}}, {tmdbId:"939366", properties:{imdbId:"2485687", name:"Anna Felix", url:"https://themoviedb.org/person/939366"}}, {tmdbId:"59081", properties:{bornIn:"Burnage, Manchester, England", imdbId:"0861915", born:date('1953-10-12'), name:"David Threlfall", bio:"Born in Burnage, Manchester in 1953, David Threlfall is a celebrated actor of stage, film and television.  In the latter, he is perhaps best known as the feckless Frank Gallagher in Channel 4's Shameless.  In 1994 whilst working on a production of The Count of Monte Cristo at the Royal Exchange, Manchester, Threlfall met Bosnian actress Brana Bajic and the pair subsequently married a year later...", url:"https://themoviedb.org/person/59081"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"233276", properties:{bornIn:"Liverpool, England, UK", imdbId:"3017284", born:date('1994-05-02'), name:"Josh Bolt", url:"https://themoviedb.org/person/233276"}}, {tmdbId:"557872", properties:{bornIn:"São Paulo, Brazil", imdbId:"3297139", name:"Vik Muniz", bio:"From Wikipedia, the free encyclopedia. \n\nVik Muniz Vicente Jose Muniz (born 1961, São Paulo, Brazil) is a visual artist living in New York City. \n\nDescription above from the Wikipedia article Vik Muniz, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/557872"}}, {tmdbId:"935275", properties:{imdbId:"3587069", born:date('2002-09-28'), name:"Isabella Gielniak", bio:"Just a girl who loves acting, singing, and dancing.  She love God, Jesus and her boy toy zach...", url:"https://themoviedb.org/person/935275"}}, {tmdbId:"935276", properties:{imdbId:"3102749", name:"Austin Bickel", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xkdKLwuMJbZgfwGTpoo3LqHbSOf.jpg", url:"https://themoviedb.org/person/935276"}}, {tmdbId:"456008", properties:{imdbId:"2875966", name:"Laurence Belcher", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7hwMQloRIuGXX8r4u7oL3xhe5tF.jpg", url:"https://themoviedb.org/person/456008"}}, {tmdbId:"66027", properties:{bornIn:"Mostar, Bosnia & Herzegovina, Yugoslavia", imdbId:"0872729", born:date('1972-09-02'), name:"Sergej Trifunovic", bio:"Sergej Trifunović ( born 2 September 1972 in Mostar, SR Bosnia and Herzegovina, SFR Yugoslavia) is a popular Serbian movie actor. \n\nDescription above from the Wikipedia article Sergej Trifunović, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jTF9YEIP8RQlnu4on5jHMQpwBy6.jpg", url:"https://themoviedb.org/person/66027"}}, {tmdbId:"574658", properties:{bornIn:"Belgrade, Serbia", imdbId:"1011158", born:date('1983-01-18'), name:"Jelena Gavrilovic", bio:"Jelena Gavrilović is a Serbian actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jsg6n5qSCQ30KfrZd4H3WExIyiV.jpg", url:"https://themoviedb.org/person/574658"}}, {tmdbId:"1049995", properties:{bornIn:"Pančevo, Serbia", imdbId:"0079048", born:date('1964-03-27'), name:"Slobodan Bestic", url:"https://themoviedb.org/person/1049995"}}, {tmdbId:"1281596", properties:{bornIn:"Winter Park - Florida - USA", imdbId:"2624166", born:date('1999-10-06'), name:"Will Shadley", bio:"Will Shadley is an actor...", url:"https://themoviedb.org/person/1281596"}}, {tmdbId:"115737", properties:{bornIn:"Helsingborg, Malmöhus län, Sweden", imdbId:"0992562", born:date('1976-05-26'), name:"Alexander Karim", url:"https://themoviedb.org/person/115737"}}, {tmdbId:"1013156", properties:{bornIn:"Ronne, Denmark", imdbId:"3140538", born:date('1984-05-01'), name:"Mikkel Boe Følsgaard", bio:"Mikkel Boe Følsgaard is a young danish actor.  In 2012, he won the award of Best Male Actor at the Berlinale for his appearance in the movie A Royal Affair, while still attending theatre school, Statens Teaterskole in Copenhagen.  He graduated in the summer of 2012...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oKC5KLsbj0npfRJA3j9nEIMglmg.jpg", url:"https://themoviedb.org/person/1013156"}}, {tmdbId:"4460", properties:{bornIn:"Odense, Denmark", imdbId:"0245988", born:date('1972-04-15'), name:"Trine Dyrholm", bio:"From Wikipedia, the free encyclopedia\n\nTrine Dyrholm (born in Odense, Denmark on April 15, 1972) is a Danish actress, singer and songwriter.  Dyrholm received national attention when she placed third in the Danish, Dansk Melodi Grand Prix as a 14-year-old singer.  Four years later, she again achieved national recognition when she won the Bodil Award for Best Actress in her debut film: the teenage romance Springflod...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ntUn5eKFlQxbjPci5A99qJOjulY.jpg", url:"https://themoviedb.org/person/4460"}}, {tmdbId:"2548186", properties:{name:"Bill Ellis", url:"https://themoviedb.org/person/2548186"}}, {tmdbId:"2548187", properties:{name:"Dorothy D'Eletto", url:"https://themoviedb.org/person/2548187"}}, {tmdbId:"76920", properties:{imdbId:"0388473", born:date('1973-01-01'), name:"Vegar Hoel", bio:"Vegar Hoel is an actor and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9wzMs9gVGAPcJA0wdCPYhWHuHxT.jpg", url:"https://themoviedb.org/person/76920"}}, {tmdbId:"76919", properties:{bornIn:"Norway", imdbId:"2552337", born:date('1975-01-01'), name:"Stig Frode Henriksen", bio:"Stig Frode Henriksen (born 1975) is a Norwegian actor, producer and screenwriter.  His acting career began in 2007, with his first role in the film Kill Buljo.  Throughout his career, Henriksen has played in more than 22 films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fJIFhe2gXh2akRiSXPSCGmTOaP7.jpg", url:"https://themoviedb.org/person/76919"}}, {tmdbId:"76917", properties:{bornIn:"Aurskog-Høland, Norway", imdbId:"2297067", born:date('1981-04-09'), name:"Charlotte Frogner", bio:"Charlotte Frogner (born April 4, 1981) is a Norwegian actress, best known outside of Norway for her role in the Norwegian Zombie film Dead Snow.  She has been employed by Oslo's Det Norske Teatret since 2004 where she has appeared in a number of productions and acted for Norwegian television. \n\nDescription above from the Wikipedia article Charlotte Frogner, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xAaBmAepMzWoHuoI5sl1feYEKYx.jpg", url:"https://themoviedb.org/person/76917"}}, {tmdbId:"76924", properties:{imdbId:"1284656", born:date('1981-10-23'), name:"Lasse Valdal", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dj1QvfAiwE4OZRqFwyBFAdAfrar.jpg", url:"https://themoviedb.org/person/76924"}}, {tmdbId:"1017336", properties:{bornIn:"Motala, Sweden", imdbId:"0632165", born:date('1967-03-15'), name:"Bengt Braskered", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dYNbesiCfIwuzXbxBlThl7cmOaP.jpg", url:"https://themoviedb.org/person/1017336"}}, {tmdbId:"225239", properties:{bornIn:"Kävlinge, Sweden", imdbId:"1133009", born:date('1974-08-18'), name:"Sanna Persson", bio:"Sanna Persson is a Swedish comedian and actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ve8TIQyqt3octfZe5bmAsqwp7In.jpg", url:"https://themoviedb.org/person/225239"}}] AS row
