rg/t/p/w440_and_h660_face/nFkSZQhC9EpjzIO4DMNa4VaN4Tz.jpg", url:"https://themoviedb.org/person/1102384"}}, {tmdbId:"95321", properties:{bornIn:"Providence, Rhode Island", imdbId:"2133655", born:date('1977-03-21'), name:"Chris Sparling", bio:"Chris Sparling is an American screenwriter, director, and actor from Providence, Rhode Island...", url:"https://themoviedb.org/person/95321"}}, {tmdbId:"1272849", properties:{imdbId:"1539392", name:"Kristin Hanggi", url:"https://themoviedb.org/person/1272849"}}, {tmdbId:"143014", properties:{imdbId:"0436899", name:"Mischa Kamp", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/buxpCz9SZKwyYsYehwZ8k2y5zYF.jpg", url:"https://themoviedb.org/person/143014"}}, {tmdbId:"1192754", properties:{imdbId:"1481618", name:"Peter Landesman", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dbnWqlVwt6smXXddPZDyRCdCPkn.jpg", url:"https://themoviedb.org/person/1192754"}}, {tmdbId:"61763", properties:{name:"Shane Abbess", url:"https://themoviedb.org/person/61763"}}, {tmdbId:"937147", properties:{bornIn:"Woodstock, New York, USA", imdbId:"2127315", born:date('1970-10-21'), name:" Autumn de Wilde", bio:"Autumn de Wilde (born 1970) is an American photographer and director best known for her portraiture and commercial work photography of musicians, as well as her music video, commercial and film work. \n\nDescription above from the Wikipedia article Autumn de Wilde, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8KheaszjZvQlPNuTpmLHEf5ZfcP.jpg", url:"https://themoviedb.org/person/937147"}}, {tmdbId:"2058952", properties:{name:"Jeff Radice", url:"https://themoviedb.org/person/2058952"}}, {tmdbId:"1285877", properties:{bornIn:"Los Angeles, California, USA", imdbId:"6195256", born:date('1991-01-04'), name:" Maclain Way", bio:"Maclain Way is an American film producer and director, known for Wild Wild Country (2018), The Battered Bastards of Baseball (2014) and The New Yorker Presents (2015).  Through his mother (Jamie Way née Russell) he is the nephew of Kurt Russell and grandson of Bing Russell, prolific actors both...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yhB5cUGOzpHiYN4rsnRZ2v28YRV.jpg", url:"https://themoviedb.org/person/1285877"}}, {tmdbId:"1305369", properties:{imdbId:"2580808", name:"Johanna Hamilton", url:"https://themoviedb.org/person/1305369"}}, {tmdbId:"1288796", properties:{imdbId:"2067421", name:"Gerard Johnstone", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1XmsujVNMWzKQYsMSCBoM56fouW.jpg", url:"https://themoviedb.org/person/1288796"}}, {tmdbId:"240376", properties:{imdbId:"2361949", name:"Andrew Mogel", url:"https://themoviedb.org/person/240376"}}, {tmdbId:"62763", properties:{bornIn:"Miami, Florida, US", imdbId:"0666871", born:date('1976-06-20'), name:" Jarrad Paul", bio:"Jarrad Paul is an American actor, film director and screenwriter...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eh9EXNzYsQMu7OEicUB24sDh2fW.jpg", url:"https://themoviedb.org/person/62763"}}] AS row
