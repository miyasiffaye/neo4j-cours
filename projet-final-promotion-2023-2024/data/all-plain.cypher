UNWIND [{tmdbId:"47032", properties:{bornIn:"Troppau, Silesia, Austria-Hungary [now Opava, Czech Republic]", imdbId:"0476130", born:date('1874-07-17'), name:"Emilie Kurz", died:date('1934-01-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aTco2ojDUT5in2GRhagnzTDSyTc.jpg", url:"https://themoviedb.org/person/47032"}}, {tmdbId:"14920", properties:{bornIn:"Peoria, Illinois, U.S.", imdbId:"0570230", born:date('1903-12-06'), name:"Kathryn McGuire", bio:"From Wikipedia, the free encyclopedia\n\nKathryn McGuire (December 6, 1903 – October 10, 1978) was an American silent-film actress and dancer. \n\nDescription above from the Wikipedia article Kathryn McGuire, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1978-10-10'), url:"https://themoviedb.org/person/14920"}}, {tmdbId:"14421", properties:{bornIn:"Nova Scotia, Canada", imdbId:"0904143", born:date('1857-11-11'), name:"Frederick Vroom", bio:"From Wikipedia, the free encyclopedia\n\nFrederick Vroom (11 November 1857 – 24 June 1942) was a Canadian actor of the silent era.  He appeared in 70 films between 1912 and 1939. \n\nHe was born in Nova Scotia, Canada and died in Hollywood, California from a heart attack. \n\nDescription above from the Wikipedia article Frederick Vroom, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1942-06-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/atQMQI84MyYYICd6nGtcvbwhVD9.jpg", url:"https://themoviedb.org/person/14421"}}, {tmdbId:"10530", properties:{imdbId:"0444172", born:date('1867-07-06'), name:"Joe Keaton", died:date('1946-01-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jCPa5FUv7izUmOekWPPd5bQJ8kh.jpg", url:"https://themoviedb.org/person/10530"}}, {tmdbId:"14921", properties:{imdbId:"0175068", name:"Erwin Connelly", died:date('1931-02-12'), url:"https://themoviedb.org/person/14921"}}, {tmdbId:"109088", properties:{bornIn:"Denver, Colorado, United States", imdbId:"0001196", born:date('1883-05-22'), name:"Douglas Fairbanks", bio:"Douglas Fairbanks, Sr.  (May 23, 1883 – December 12, 1939) was an American actor, screenwriter, director and producer.  He was best known for his swashbuckling roles in silent films such as The Thief of Bagdad, Robin Hood, and The Mark of Zorro.  An astute businessman, Fairbanks was a founding member of United Artists.  Fairbanks was also a founding member of The Motion Picture Academy and hosted the first Oscars Ceremony in 1929...", died:date('1939-12-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eAT0WkRYA9DXtTmcbhvhhMrQcZa.jpg", url:"https://themoviedb.org/person/109088"}}, {tmdbId:"14488", properties:{bornIn:"Budapest, Austria-Hungary [now Hungary]", imdbId:"0250366", born:date('1868-01-01'), name:"Snitz Edwards", bio:"Snitz Edwards was a noted character actor, in films from 1915 to 1931...", died:date('1937-05-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jBtTVS1Ve1tnwVKKYQQyWcwjmNk.jpg", url:"https://themoviedb.org/person/14488"}}, {tmdbId:"108104", properties:{bornIn:"San Francisco, California, USA", imdbId:"0067634", born:date('1872-07-27'), name:"Charles Belcher", died:date('1943-12-10'), url:"https://themoviedb.org/person/108104"}}, {tmdbId:"29981", properties:{bornIn:"Indianapolis, Indiana, USA", imdbId:"0426710", born:date('1900-05-01'), name:"Julanne Johnston", bio:"From Wikipedia, the free encyclopedia. \n\nJulanne Johnston (May 1, 1900 - December 26, 1988) was an American silent film actress born in Indianapolis, Indiana. \n\nJohnston is known for being on William Randolph Hearst's yacht The Oneida during the weekend in November 1924 when film director and producer Thomas Ince later died of heart failure.  She was also the female lead in the Douglas Fairbanks film The Thief of Bagdad, with Anna May Wong, that same year...", died:date('1988-12-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5CJdV1WKw9E0mPs8hWeC2bYV9m9.jpg", url:"https://themoviedb.org/person/29981"}}, {tmdbId:"9609", properties:{bornIn:"Moscow, Russian Empire", imdbId:"0031446", born:date('1898-02-12'), name:"Aleksandr Antonov", bio:"From Wikipedia, the free encyclopedia\n\nAleksandr Pavlovich Antonov (1898 – 1962) was a Russian film actor who had a lengthy career, stretching from the silent era to the 1950s. \n\nHis best known role was as Grigory Vakulinchuk in Sergei Eisenstein's film The Battleship Potemkin.  He also had a part in another Eisenstein film, Strike. \n\nDescription above from the Wikipedia article Aleksandr Pavlovich Antonov, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1962-11-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/np04jLrwpAR0V7a1MNMyNtYncQ9.jpg", url:"https://themoviedb.org/person/9609"}}, {tmdbId:"9610", properties:{bornIn:"Russian Empire", imdbId:"0058290", born:date('1866-03-15'), name:"Vladimir Barsky", bio:"Vladimir Grigorievich Barsky (1866 - January 24, 1936) - Russian Soviet director, screenwriter and actor; author of articles on theater issues. \n\nHe took part in the development of Turkmen and Uzbek cinematography.  He graduated from the Moscow Real School (1885) and the Imperial Moscow Technical School. \n\nFrom 1892 - director and actor of a number of theaters, in 1899–1917 he worked as a director and actor of the drama theater in Ivanovo-Voznesensk, in 1917–1921 - at the National House in Tiflis...", died:date('1936-01-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oVJqWwAPy5LQz2luSsRkkUZtjcm.jpg", url:"https://themoviedb.org/person/9610"}}, {tmdbId:"9607", properties:{bornIn:"Yekaterinburg, Russian Empire", imdbId:"0017893", born:date('1903-01-22'), name:"Grigori Aleksandrov", bio:"Grigori Vasilyevich Aleksandrov or Alexandrov (original family name was Mormonenko; 23 January 1903 - 16 December 1983) was a prominent Soviet film director who was named a People's Artist of the USSR in 1947 and a Hero of Socialist Labor in 1973.  He was awarded the Stalin Prizes for 1941 and 1950...", died:date('1983-12-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gY3az71QDIwBrl2POLb2tvaKkrg.jpg", url:"https://themoviedb.org/person/9607"}}, {tmdbId:"9611", properties:{bornIn:"Moscow, Russian Empire [now Russia]", imdbId:"0090434", born:date('1904-02-06'), name:"Ivan Bobrov", died:date('1952-04-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yCHbMMtSGOYzn5O7FfaTncYsSBw.jpg", url:"https://themoviedb.org/person/9611"}}, {tmdbId:"102501", properties:{bornIn:"South Pittsburg, Tennessee, USA", imdbId:"0707814", born:date('1899-11-21'), name:"Jobyna Ralston", bio:"Jobyna Ralston (born Jobyna Lancaster Raulston, November 21, 1899 – January 22, 1967) was an American stage and film actress.  She had a featured role in the first Oscar-winning film, Wings in 1927, but is perhaps best remembered today for her on-screen chemistry with Harold Lloyd, with whom she appeared in seven movies...", died:date('1967-01-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tIPbxqkszkjOHc1VZVzONEWHtLu.jpg", url:"https://themoviedb.org/person/102501"}}, {tmdbId:"115995", properties:{bornIn:"New York City, New York, USA", imdbId:"0070757", born:date('1896-02-06'), name:"Brooks Benedict", died:date('1968-01-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l3Bw5oBij94yG0QSO45inFnySRZ.jpg", url:"https://themoviedb.org/person/115995"}}, {tmdbId:"1759857", properties:{name:"James Anderson", url:"https://themoviedb.org/person/1759857"}}, {tmdbId:"144016", properties:{bornIn:"Conneautville, Pennsylvania, USA", imdbId:"0874124", born:date('1861-01-03'), name:"Howard Truesdale", died:date('1941-12-08'), url:"https://themoviedb.org/person/144016"}}, {tmdbId:"144017", properties:{bornIn:"Covington, Kentucky, USA", imdbId:"0616762", name:"Kathleen Myers", url:"https://themoviedb.org/person/144017"}}, {tmdbId:"144018", properties:{imdbId:"0860617", name:"Ray Thompson", died:date('1927-06-29'), url:"https://themoviedb.org/person/144018"}}, {tmdbId:"1364095", properties:{imdbId:"0264146", name:"Brown Eyes", url:"https://themoviedb.org/person/1364095"}}] AS row
