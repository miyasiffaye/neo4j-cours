UNWIND [{movieId:"50064", properties:{languages:["English", " German", " Russian"], year:2006, imdbId:"0452624", runtime:105, imdbRating:6.1, countries:["USA"], imdbVotes:21109, title:"Good German, The", url:"https://themoviedb.org/movie/182", revenue:5914908, tmdbId:"182", plot:"While in post-war Berlin to cover the Potsdam Conference, an American military journalist is drawn into a murder investigation which involves his former mistress and his driver.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3LjHC2CWDkzoiPehf3GViujws0.jpg", released:"2007-01-19", budget:32000000}}, {movieId:"50068", properties:{languages:["Japanese", " English"], year:2006, imdbId:"0498380", runtime:141, imdbRating:7.9, countries:["USA"], imdbVotes:129738, title:"Letters from Iwo Jima", url:"https://themoviedb.org/movie/1251", revenue:68673228, tmdbId:"1251", plot:"The story of the battle of Iwo Jima between the United States and Imperial Japan during World War II, as told from the perspective of the Japanese who fought it.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kZokxQtzMPURvijWYFuvh1fAvnv.jpg", released:"2007-02-02", budget:19000000}}, {movieId:"50147", properties:{languages:["English"], year:2006, imdbId:"0454082", runtime:84, imdbRating:4.5, countries:["USA", " Canada"], imdbVotes:19553, title:"Black Christmas", url:"https://themoviedb.org/movie/9656", revenue:21510851, tmdbId:"9656", plot:"An escaped maniac returns to his childhood home on Christmas Eve, which is now a sorority house, and begins to murder the sorority sisters one by one.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gTvPGnwiOzWbdMk8R0Ts4ZSJbXZ.jpg", released:"2006-12-25", budget:9000000}}, {movieId:"50160", properties:{languages:["English"], year:2006, imdbId:"0482546", runtime:88, imdbRating:7.0, countries:["UK", " USA", " Isle Of Man"], imdbVotes:23326, title:"Miss Potter", url:"https://themoviedb.org/movie/13967", revenue:35078241, tmdbId:"13967", plot:"The story of Beatrix Potter,