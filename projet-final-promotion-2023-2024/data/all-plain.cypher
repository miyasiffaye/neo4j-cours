UNWIND [{tmdbId:"1214870", properties:{bornIn:"Westchester County, New York, USA", imdbId:"1927701", born:date('1992-10-09'), name:"Tyler James Williams", bio:"Tyler James Williams was born on October 9, 1992 in Westchester County, New York, USA.  He is an actor, known for Everybody Hates Chris (2005), Dear White People (2014) and Let It Shine (2012)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iuPSybfJYExEgUfSmIdN540gdHp.jpg", url:"https://themoviedb.org/person/1214870"}}, {tmdbId:"970219", properties:{bornIn:"Richland, Washington, USA", imdbId:"3500582", born:date('1987-09-22'), name:"Teyonah Parris", bio:"Teyonah Parris is an American actress.  She began her career playing a recurring role as Dawn Chambers in the AMC drama series, Mad Men, before landing her breakthrough role in the 2014 independent film Dear White People.  In 2015, Parris starred in the satirical drama film Chi-Raq directed by Spike Lee...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mArqi5mGbKvfrNsrEEkdy0gDvGu.jpg", url:"https://themoviedb.org/person/970219"}}, {tmdbId:"1108829", properties:{bornIn:"California, - USA", imdbId:"3846716", born:date('1991-08-09'), name:"Cameron Deane Stewart", bio:"Cameron Deane Stewart is an actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5vjZAtawy51IISEFT5rkfERRmNZ.jpg", url:"https://themoviedb.org/person/1108829"}}, {tmdbId:"231057", properties:{bornIn:" Louisville, Kentucky, USA", imdbId:"0214302", born:date('1986-02-01'), name:"Justin Deeley", bio:"Justin Deeley is an American model and actor.  He is known for his roles on the television series 90210 and Drop Dead Diva...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5GO7YJrybyBFQ527tWy6p8I69pa.jpg", url:"https://themoviedb.org/person/231057"}}, {tmdbId:"214068", properties:{imdbId:"0262374", born:date('1951-08-17'), name:"Wesley Eure", url:"https://themoviedb.org/person/214068"}}, {tmdbId:"97186", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"008