ties:{imdbId:"0296843", name:"Brittain Frye", url:"https://themoviedb.org/person/98943"}}, {tmdbId:"98950", properties:{imdbId:"0365107", name:"Michael Harris", url:"https://themoviedb.org/person/98950"}}, {tmdbId:"98947", properties:{imdbId:"0339123", born:date('1960-03-19'), name:"David Greenlee", url:"https://themoviedb.org/person/98947"}}, {tmdbId:"99237", properties:{bornIn:"Batley, Yorkshire, UK", imdbId:"0364703", born:date('1964-12-16'), name:"Gail Harris", bio:"​From Wikipedia, the free encyclopedia\n\nGail Harris was born in Batley, a small mill town in Yorkshire English as Gail Robyn on December 16, 1964. \n\nBefore her film industry work, Harris was a Page 3 Girl for the British tabloid press.  She was also featured in Mayfair magazine as the \"Girl of the Month\" on two separate occasions, and as the 10th anniversary feature model of High Society magazine.  She transitioned and set her sights on Hollywood, beginning her career as a stunt and double...", url:"https://themoviedb.org/person/99237"}}, {tmdbId:"99067", properties:{bornIn:"Versailles, Kentucky, USA", imdbId:"0601611", born:date('1963-12-27'), name:"Melissa Moore", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/92RIJylUsGuDho2N477Vats0HOD.jpg", url:"https://themoviedb.org/person/99067"}}, {tmdbId:"593372", properties:{imdbId:"0955706", name:"Stacia Zhivago", url:"https://themoviedb.org/person/593372"}}, {tmdbId:"1179245", properties:{imdbId:"0894827", born:date('1966-09-18'), name:"Barbii", url:"https://themoviedb.org/person/1179245"}}, {tmdbId:"17495", properties:{bornIn:"New York City, New York, USA", imdbId:"0000588", born:date('1970-11-16'), name:"Martha Plimpton", bio:"Martha Plimpton is an American singer, stage and screen actress, best known for playing the lead role of Virginia Chance on the television sitcom \"Raising Hope\", and for guest starring as Patti Nyholm in the CBS legal drama \"The Good Wife\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ukQ0gGBcZzPb5qPM7I2dnMSHt6l.jpg", url:"https://themoviedb.org/person/17495"}}, {tmdbId:"32", properties:{bornIn:"Dallas, Texas, USA", imdbId:"0000705", born:date('1966-04-08'), name:"Robin Wright", bio:"Robin Gayle Wright (born April 8, 1966) is an American actress.  She is best known for her roles as Jenny Curran in Forrest Gump, as Buttercup in The Princess Bride, and as Mary Surratt in The Conspirator.  She has also been credited as Robin Wright Penn...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/roJedXmjqEcSOC1HaQ4e9gEWdR3.jpg", url:"https://themoviedb.org/person/32"}}, {tmdbId:"1820121", properties:{imdbId:"8768787", name:"David Forrester", url:"https://themoviedb.org/person/1820121"}}, {tmdbId:"11716", properties:{bornIn:"Abington Township, Pennsylvania, U.S.", imdbId:"0492932", born:date('1980-02-11'), name:"Matthew Lawrence", bio:"From Wikipedia, the free encyclopedia. \n\nMatthew William Lawrence (born February 11, 1980) is an American actor known for his leading role in the movie Cheats with Trevor Fehrman and his role of Jack Hunter on the ABC sitcom Boy Meets World from 1997 to 2000, and his roles in movies such as The Hot Chick, The Comebacks, and Mrs.  Doubtfire. \n\nDescription above from the Wikipedia article Matthew Lawrence, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/r8e160wnsDbdcQ52YKkrjfwa8QI.jpg", url:"https://themoviedb.org/person/11716"}}, {tmdbId:"45041", properties:{bornIn:"Newburyport, Massachusetts, USA", imdbId:"0387432", born:date('1968-06-29'), name:"Judith Hoag", bio:"From Wikipedia, the free encyclopedia\n\nJudith Hoag (born June 29, 1968) is an American actress and acting teacher.  She is perhaps best known for portraying April O'Neil in the first Teenage Mutant Ninja Turtles film.  She has also co-starred in the Disney Channel Original Movie (DCOM) Halloweentown films and as Cindy Price on the HBO series Big Love.  Judith has recently appeared in advertisements for Windows 7, \"To the Cloud\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aLnR4ayGjLyJDkYaJGk5tEgAFsi.jpg", url:"https://themoviedb.org/person/45041"}}, {tmdbId:"6181", properties:{bornIn:"New York City - New York - USA", imdbId:"0656929", born:date('1964-06-21'), name:"Josh Pais", bio:"Josh Pais (born June 21, 1964) is an American actor of film and television. \n\nHe has appeared in many Hollywood films, including Teenage Mutant Ninja Turtles (in which he both was in the costume and was the voice) as Raphael, Music of the Heart, Scream 3, It Runs in the Family, Little Manhattan and Find Me Guilty.  He played Assistant M. E.  Borak in 15 episodes of the series Law &amp; Order, between 1990 and 2002...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qEVC3PyZNOS5OtunJ7eo0TavCBK.jpg", url:"https://themoviedb.org/person/6181"}}, {tmdbId:"81432", properties:{imdbId:"0286337", name:"David Forman", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/y7CJ5d7j1A3dDnUl0xkze7O4jp9.jpg", url:"https://themoviedb.org/person/81432"}}, {tmdbId:"21384", properties:{imdbId:"0125084", name:"Paul Butler", url:"https://themoviedb.org/person/21384"}}] AS row
