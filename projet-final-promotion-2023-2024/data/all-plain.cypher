UNWIND [{tmdbId:"105738", properties:{bornIn:"Paris, France", imdbId:"0634120", born:date('1956-05-05'), name:"Jean Pierre Noher", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bOhQmfBYSJeNtn6vlsj3tKoOLfc.jpg", url:"https://themoviedb.org/person/105738"}}, {tmdbId:"7498", properties:{bornIn:"Santa Ynez Valley, California, USA", imdbId:"0047248", born:date('1976-06-08'), name:"Eion Bailey", bio:"From Wikipedia, the free encyclopedia. \n\nEion Francis Hamilton Bailey (born June 8, 1976) is an American actor, perhaps best known for appearing in the HBO miniseries Band of Brothers as Pvt.  David Kenyon Webster and in the films Fight Club, Center Stage, Mindhunters and Sexual Life.  He currently has a recurring role on the USA Network TV show Covert Affairs. \n\nDescription above from the Wikipedia article Eion Bailey, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hKqfGq1sPhZdQOlto0bS3igFZdP.jpg", url:"https://themoviedb.org/person/7498"}}, {tmdbId:"54500", properties:{bornIn:"Hertfordshire, England, UK", imdbId:"0962261", born:date('1977-06-29'), name:"Will Kemp", bio:"From Wikipedia, the free encyclopedia\n\nWilliam \"Will\" Kemp (born 29 June 1977) is an English actor and dancer. \n\nDescription above from the Wikipedia article Will Kemp (actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x1pO6ca7UpkzuLj68Z7a1LPpuFO.jpg", url:"https://themoviedb.org/person/54500"}}, {tmdbId:"112770", properties:{imdbId:"0797191", name:"François Siener", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eKQhrMHXQSvwvMDt1mC0sP2rF0i.jpg", url:"https://themoviedb.org/person/112770"}}, {tmdbId:"26291", properties:{bornIn:"Auckland, New Zealand", imdbId:"0376540", born:date('1974-10-08'), name:"Martin Henderson", bio:"Martin Henderson (born October 8, 1974) is a New Zealand actor, well known to American audiences for his starring role in the ABC TV series Off the Map, while remaining known in his home country for his teenage role as Stuart Neilson in the soap opera Shortland Street...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dBeMYpC13EZf1q4VT4zwwMxI1NV.jpg", url:"https://themoviedb.org/person/26291"}}, {tmdbId:"26292", properties:{bornIn:"Los Angeles, California, U.S.", imdbId:"0233562", born:date('1993-02-07'), name:"David Dorfman", bio:"From Wikipedia, the free encyclopedia. \n\nDavid Dorfman (born February 7, 1993) is an American actor.  He portrayed Aidan Keller in the 2002 horror film remake The Ring, and its 2005 sequel The Ring Two.  His other film roles include Sammy in Panic, Joey in Bounce, and Jedidiah Hewitt in The Texas Chainsaw Massacre.  He has also portrayed the character \"Charles Wallace Murry\" in the film version of A Wrinkle in Time.  In 2008, Dorfman appeared in the film Drillbit Taylor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/45HdlGaVcVxMzzPoR1BYshCV2Ux.jpg", url:"https://themoviedb.org/person/26292"}}, {tmdbId:"15293", properties:{bornIn:" Donnybrook, Western Australia, Australia", imdbId:"1095720", born:date('1990-03-24'), name:"Keisha Castle-Hughes", bio:"Keisha Castle-Hughes (born 24 March 1990) is a New Zealand film actress who rose to prominence at the age of eleven when playing Paikea \"Pai\" Apirana in the 2002 film Whale Rider.  The film was nominated for many awards, including an Academy Award for Best Actress of which she was the youngest female nominated in the Best Actress category and an award at the Broadcast Film Critics Association Awards for Best Actress, which she won in 2004...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lAbNw40OkoPKT39jV5O1d8PCXp4.jpg", url:"https://themoviedb.org/person/15293"}}, {tmdbId:"15294", properties:{imdbId:"0660984", name:"Rawiri Paratene", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oGSLpDSqlNlSCt7evHz3EPlDET2.jpg", url:"https://themoviedb.org/person/15294"}}, {tmdbId:"15295", properties:{imdbId:"0369357", name:"Vicky Haughton", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9LaetM0NZBibp6zwkiMqOdXjbM5.jpg", url:"https://themoviedb.org/person/15295"}}, {tmdbId:"80678", properties:{bornIn:"Boaz, Alabama, USA", imdbId:"0388113", born:date('1963-04-02'), name:"Tim Hodge", bio:"From Wikipedia, the free encyclopedia\n\nTimothy Hodge (born April 2, 1963 in Boaz, Alabama) is an American voice actor, director, producer and writer at Big Idea (the company famous for producing VeggieTales).  He was an animator at Disney before joining Big Idea. \n\nDescription above from the Wikipedia article Tim Hodge, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/80678"}}, {tmdbId:"110801", properties:{imdbId:"1009595", name:"Lisa Vischer", url:"https://themoviedb.org/person/110801"}}, {tmdbId:"7539", properties:{imdbId:"1001663", name:"Liz Phair", url:"https://themoviedb.org/person/7539"}}, {tmdbId:"83777", properties:{bornIn:"Downsview, Ontario, Canada", imdbId:"0796125", name:"Christopher Shyer", bio:"From Wikipedia, the free encyclopedia. \n\nChristopher Shyer (sometimes credited as Chris Shyer) is a Canadian actor who has appeared in over 50 film and television roles. \n\nDescription above from the Wikipedia article Christopher Shyer, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/83777"}}, {tmdbId:"172851", properties:{bornIn:"Montréal, Québec, Canada", imdbId:"0302818", born:date('1974-07-21'), name:"Ray Galletti", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e9xq1J7z8t5NtUalpxRCV4uchms.jpg", url:"https://themoviedb.org/person/172851"}}, {tmdbId:"52457", properties:{imdbId:"0669826", name:"Eileen Pedde", bio:"Pedde made her debut in the TV series The Little Kidnappers in 1990.  She has appeared in numerous major American television series including The X Files and Smallville (2003) but is perhaps best known for her role as Sergeant Erin Mathias in Battlestar Galactica.  She starred in the 2007 film Juno...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/unjd0sAVtNhdIJAxzx49RfeVevy.jpg", url:"https://themoviedb.org/person/52457"}}, {tmdbId:"62717", properties:{bornIn:"Vancouver, British Columbia, Canada", imdbId:"0788907", name:"Rekha Sharma", bio:"Rekha Shanti Sharma is a Canadian actress best known for her portrayal of Tory Foster on Battlestar Galactica. \n\nHer ancestors are from the state of Uttar Pradesh in India, which they left during the British period.  Her family resettled in the Fiji Islands and her parents moved to Canada.  She has an older brother, Sunil, who is nine years her senior.  Their father is a Hindu priest. \n\nSharma started to pursue acting as a career in her 20s...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3qLo8UbKs26n7g1oyKHckNH1IvU.jpg", url:"https://themoviedb.org/person/62717"}}, {tmdbId:"33397", properties:{bornIn:"Dublin, Ireland", imdbId:"0092961", born:date('1991-02-28'), name:"Sarah Bolger", bio:"Sarah Lee Bolger (born 28 February 1991) is an Irish actress.  She is known for her role as Princess / Lady Mary Tudor on The Tudors and for her role as Mallory Grace in The Spiderwick Chronicles. \n\nDescription above from the Wikipedia article Sarah Bolger, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/buw6aDGctZMOTaPFAd9EaBPa76n.jpg", url:"https://themoviedb.org/person/33397"}}, {tmdbId:"65483", properties:{bornIn:"Dublin, Ireland", imdbId:"1071580", born:date('1996-01-05'), name:"Emma Bolger", bio:"​From Wikipedia, the free encyclopedia\n\nEmma Bolger (born 5 January 1996 in Dublin) is an Irish teen actress.  Her most notable role is in the 2002 film In America. \n\nDescription above from the Wikipedia article Emma Bolger, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/65483"}}, {tmdbId:"96787", properties:{bornIn:"Dublin, Ireland", imdbId:"1070538", born:date('1992-01-01'), name:"Sophie Vavasseur", bio:"Sophie Vavasseur (born 1992) is an Irish actress best known for her award-nominated role as Evelyn Doyle in the American-German-British-Irish film Evelyn. \n\nDescription above from the Wikipedia article Sophie Vavasseur, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tlAjiOhWufp4yUTfZbbUfqNFJun.jpg", url:"https://themoviedb.org/person/96787"}}, {tmdbId:"44735", properties:{bornIn:"New York City, New York, USA", imdbId:"0251986", born:date('1983-10-05'), name:"Jesse Eisenberg", bio:"Jesse Adam Eisenberg (born October 5, 1983) is an American actor, author, and playwright.  He made his television debut with the short-lived comedy-drama series Get Real (1999–2000).  Following his first leading role in the comedy-drama film Roger Dodger (2002), he appeared in the drama film The Emperor's Club (2002), the psychological thriller film The Village (2004), the comedy-drama film The Squid and the Whale (2005), and the drama film The Education of Charlie Banks (2007)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yYhwWRcxDHTn63gSEF1vnDAD7cD.jpg", url:"https://themoviedb.org/person/44735"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"12078", properties:{imdbId:"0970731", born:date('1991-08-12'), name:"Bobby Block", bio:"Bobby Block is known for his work on Shrek (2001), The Polar Express (2004) and Finding Nemo (2003)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l4ktDZmixDQIhXfDsyLvTGANXiy.jpg", url:"https://themoviedb.org/person/12078"}}, {tmdbId:"80108", properties:{bornIn:"Yanagawa, Fukuoka, Japan", imdbId:"1070494", born:date('1980-12-13'), name:"Satoshi Tsumabuki", bio:"From Wikipedia, the free encyclopedia.  \n\n \n\nSatoshi Tsumabuki (  born December 13, 1980) is a Japanese actor.  His breakthrough film was Waterboys for which he was nominated for the 'Best Actor' award at the Japanese Academy Awards, and won the 'Newcomer of the Year' prize.  He is also the bassist and lead singer of the Japanese band Basking Lite. \n\nDescription above from the Wikipedia article Satoshi Tsumabuki, licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fU3MluyNl2WQFLGBW4MgEbw6uSX.jpg", url:"https://themoviedb.org/person/80108"}}, {tmdbId:"117974", properties:{bornIn:"Nagoya, Aichi Prefecture, Japan", imdbId:"1071507", born:date('1980-01-14'), name:"Hiroshi Tamaki", bio:"Hiroshi Tamaki (玉木 宏 Tamaki Hiroshi, born 14 January 1980) is a Japanese actor, singer, and model from Nagoya, Japan.  When he was still in high school, he was discovered by a talent agent while out shopping with friends.  He made his debut in the drama Am I Weird? (私ってへん？ Watashitte Hen?) in 1998.  Tamaki became more well-known with his appearance in the 2001 film Waterboys. His singing career debuted with the single \"Seasons\" in summer 2004...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hoMVrogt3LWl6XkL0590uhQ8A3E.jpg", url:"https://themoviedb.org/person/117974"}}, {tmdbId:"107105", properties:{bornIn:"Japan", imdbId:"1069856", born:date('1981-11-16'), name:"Akifumi Miura", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7VJv6SqY3fzm7MK8StKj1Om73ms.jpg", url:"https://themoviedb.org/person/107105"}}, {tmdbId:"107106", properties:{bornIn:"Nishio, Aichi, Japan", imdbId:"1069562", born:date('1978-10-11'), name:"Kôen Kondô", bio:"Koen Kondo (Kôen Kondô; 近藤公園; born 11 October 1978) is a Japanese actor.  He made his debut in the popular 2001 film Waterboys...", url:"https://themoviedb.org/person/107106"}}, {tmdbId:"15684", properties:{bornIn:"Asheville, North Carolina, USA", imdbId:"0773973", born:date('1976-03-16'), name:"Paul Schneider", bio:"Paul Andrew Schneider (born March 16, 1976) is an American film actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/69tLX644rRr1RT9gxajsWlNrf0Y.jpg", url:"https://themoviedb.org/person/15684"}}, {tmdbId:"74242", properties:{bornIn:"Tallahassee, Florida, USA", imdbId:"0924154", born:date('1969-01-05'), name:"Shea Whigham", bio:"Franklin Shea Whigham, Jr.  (born January 5, 1969), best known as Shea Whigham, is an American actor currently starring as Elias Thompson on the HBO dramatic series Boardwalk Empire. \n\nDescription above from the Wikipedia article Shea Whigham, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d3caK3l4UfbnzOxv95wLoFLZzMO.jpg", url:"https://themoviedb.org/person/74242"}}, {tmdbId:"62862", properties:{bornIn:"Statesboro, Georgia, USA", imdbId:"1144419", born:date('1976-12-29'), name:"Danny McBride", bio:"Daniel Richard \"Danny\" McBride (born December 29, 1976) is an American actor, comedian, screenwriter, and producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6ytGpaZZnTScKiBFQ0XlNgmwtCc.jpg", url:"https://themoviedb.org/person/62862"}}, {tmdbId:"17638", properties:{imdbId:"0766762", name:"Cliff Saunders", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6wasu9LMW29B8xwg5HHk4qAIB0x.jpg", url:"https://themoviedb.org/person/17638"}}, {tmdbId:"111243", properties:{bornIn:"Sioux City, Iowa, USA", imdbId:"1409629", born:date('1977-09-21'), name:"David Backus", url:"https://themoviedb.org/person/111243"}}, {tmdbId:"37157", properties:{imdbId:"0893120", born:date('1969-05-10'), name:"Lenny Venito", bio:"From Wikipedia, the free encyclopedia. \n\nLenny Venito is an American actor who has made appearances in movies such as Gigli, Men in Black II, and War of the Worlds.  Starting in 2006, Venito has been featured in The Sopranos as the character nicknamed \"Murmur,\" who helped shake down actor Ben Kingsley (playing himself) and violently mug actress Lauren Bacall (also playing herself)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3Ok9n02a13poLdb5cZaIJKTBHrC.jpg", url:"https://themoviedb.org/person/37157"}}, {tmdbId:"1857196", properties:{name:"Matt McFarland", url:"https://themoviedb.org/person/1857196"}}, {tmdbId:"1611576", properties:{born:date('1995-04-17'), name:"Paulie Litt", url:"https://themoviedb.org/person/1611576"}}, {tmdbId:"77667", properties:{bornIn:"Leningrad, USSR (St. Petersburg, Russia)", imdbId:"0968541", born:date('1987-04-19'), name:"Oksana Akinshina", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1OyynbiwrYcKatc1ghESlCGGZef.jpg", url:"https://themoviedb.org/person/77667"}}, {tmdbId:"71220", properties:{imdbId:"1220156", name:"Lyubov Agapova", url:"https://themoviedb.org/person/71220"}}, {tmdbId:"71221", properties:{imdbId:"1221836", name:"Liliya Shinkaryova", url:"https://themoviedb.org/person/71221"}}, {tmdbId:"27428", properties:{bornIn:"High Wycombe, England, UK", imdbId:"1093951", born:date('1990-06-13'), name:"Aaron Taylor-Johnson", bio:"Aaron Perry Johnson (born 13 June 1990) is an English actor whose professional work includes performances on stage, television, and in feature films.  He began performing at age six, and appeared in films such as Angus, Thongs and Perfect Snogging and The Illusionist before graduating to starring roles in films such as Nowhere Boy, in which he played John Lennon, and the superhero movie Kick-Ass...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lM0FO9u5GRaeVqD38614tfxl9gu.jpg", url:"https://themoviedb.org/person/27428"}}, {tmdbId:"27678", properties:{bornIn:"Camden - London - England", imdbId:"1433660", born:date('1968-01-01'), name:"Tom Fisher", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oVKIxTE5zNg5KlFg2AEZ0vYs2sy.jpg", url:"https://themoviedb.org/person/27678"}}, {tmdbId:"7517", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0098378", born:date('1983-01-02'), name:"Kate Bosworth", bio:"Catherine Ann \"Kate\" Bosworth (born January 2, 1983) is an American actress.  Bosworth starred in the television series Young Americans, in which she played Bella Banks.  She became known with a leading role in 2002's Blue Crush.  The following year, Bosworth played the teenage girlfriend of porn star John Holmes in Wonderland opposite Val Kilmer.  In 2004, she portrayed Sandra Dee in Kevin Spacey's Beyond the Sea...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wpVf6UcYpUiGn80vDueW9ulgTpQ.jpg", url:"https://themoviedb.org/person/7517"}}, {tmdbId:"57088", properties:{bornIn:"Kauai - Hawaii - USA", imdbId:"1149633", born:date('1979-05-19'), name:"Sanoe Lake", bio:"​From Wikipedia, the free encyclopedia. \n\nSànoe Lake  (born on May 19, 1979 in Kauai, Hawaii) is an American actress of Hawaiian, Japanese and English descent...", url:"https://themoviedb.org/person/57088"}}] AS row
