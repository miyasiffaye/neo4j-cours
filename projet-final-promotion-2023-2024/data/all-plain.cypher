UNWIND [{tmdbId:"95857", properties:{bornIn:"Venice, California, USA", imdbId:"0750598", born:date('1955-02-09'), name:"Elizabeth Ruscio", url:"https://themoviedb.org/person/95857"}}, {tmdbId:"4987", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0004898", born:date('1973-07-20'), name:"Omar Epps", bio:"Omar Hashim Epps (born July 20, 1973) is an American actor, singer, songwriter, and record producer. \n\nHis film roles include Juice, Major League II, Higher Learning, Scream 2, The Wood, In Too Deep, and Love and Basketball.  Epps' television work includes ER and House...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yc9JiSiIykY4jbWrMqccneYBvIi.jpg", url:"https://themoviedb.org/person/4987"}}, {tmdbId:"539213", properties:{born:date('1964-05-16'), name:"Ron Marquette", died:date('1994-09-27'), url:"https://themoviedb.org/person/539213"}}, {tmdbId:"581150", properties:{imdbId:"0402531", name:"Leigh Hunt", url:"https://themoviedb.org/person/581150"}}, {tmdbId:"581151", properties:{imdbId:"0719824", name:"John Renshaw", url:"https://themoviedb.org/person/581151"}}, {tmdbId:"51539", properties:{bornIn:" Vancouver, British Columbia, Canada", imdbId:"0192963", born:date('1965-09-25'), name:"Gordon Currie", bio:"Gordon Currie was born in Vancouver, Canada to American parents.  One of his first or breakthrough roles was playing Officer Palone on 21 Jump Street (1987).  In 1991, after a couple years working in locally shot TV and film in Vancouver, Gordon moved to Los Angeles to study acting more seriously.  Gordon's first roommate was Brad Pitt...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h06Vpwv0XHCogV4xULwNBVXN6dI.jpg", url:"https://themoviedb.org/person/51539"}}, {tmdbId:"54634", properties:{bornIn:"Edmonton - Alberta - Canada", imdbId:"0921979", born:date('1970-12-31'), name:"Chandra West", bio:"From Wikipedia, the free encyclopedia. \n\nChandra K.  West (born December 31, 1970) is a Canadian actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/58SU6QLK12YFTCPkxOfY0AO3zNu.jpg", url:"https://themoviedb.org/person/54634"}}, {tmdbId:"224322", properties:{bornIn:"Los Angeles, California, USA", born:date('1963-02-07'), name:"Ash Adams", url:"https://themoviedb.org/person/224322"}}, {tmdbId:"43433", properties:{bornIn:"Burley, Idaho, USA", imdbId:"0384711", born:date('1969-05-09'), name:"Teresa Hill", bio:"​From Wikipedia, the free encyclopedia.   \n\nTeresa Hill (born May 9, 1969 in Burley, Idaho) is an American actress and interior designer. \n\nShe played Nemesis in the 1995-1999 television series Hercules: The Legendary Journeys. \n\nDescription above from the Wikipedia article Teresa Hill, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d3QmlZxmr43UMEsTQ6UMBMwJjTE.jpg", url:"https://themoviedb.org/person/43433"}}, {tmdbId:"1370644", properties:{imdbId:"0370700", name:"John Haycraft", url:"https://themoviedb.org/person/1370644"}}, {tmdbId:"34982", properties:{bornIn:"Burbank, California, U.S.", imdbId:"0071818", born:date('1962-10-02'), name:"Jeff Bennett", bio:"From Wikipedia, the free encyclopedia\n\nJeffrey Glenn \"Jeff\" Bennett (born October 2, 1962) is an American voice actor, best known as the voice of Johnny Bravo in the series of the same name.  When voicing Johnny, he made his voice sound like that of Elvis Presley.  He is also famous for voicing Petrie in The Land Before Time series from the second film onward...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pnLx7XTUjeePTXc9rXd10OPoa0.jpg", url:"https://themoviedb.org/person/34982"}}, {tmdbId:"11398", properties:{bornIn:"Tokyo, Japan", imdbId:"0846480", born:date('1950-09-27'), name:"Cary-Hiroyuki Tagawa", bio:"Cary-Hiroyuki Tagawa (born September 27, 1950) is a Japanese American actor. \n\nIn addition to his extensive film work, he has appeared on television in Star Trek: The Next Generation - \"Encounter at Farpoint\" (1987), Thunder in Paradise (1995), Nash Bridges (1996), Baywatch: Hawaiian Wedding (2003), and Heroes (2007).  He also provided the voice of Sin Tzu for the video game Batman: Rise of Sin Tzu.  He played the part of Earth Alliance security officer Morishi in Babylon 5 - \"Convictions\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zxKQN4pDpqgVyhJ0td6WqY4mGsv.jpg", url:"https://themoviedb.org/person/11398"}}, {tmdbId:"6105", properties:{bornIn:"Brooklyn - New York - USA", imdbId:"0507659", born:date('1947-06-29'), name:"Richard Lewis", bio:"From Wikipedia, the free encyclopedia. \n\nRichard Philip Lewis (born June 29, 1947) is an American comedian and actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4ICUjOwcaRPbUud8uHFgWkNODvc.jpg", url:"https://themoviedb.org/person/6105"}}, {tmdbId:"1219", properties:{bornIn:"Cincinnati, Ohio, USA", imdbId:"0001865", born:date('1962-09-12'), name:"Amy Yasbeck", bio:"Amy Marie Yasbeck (born September 12, 1962) is an American film and television actress.  She is best known for her role as Casey Chapel Davenport on Wings...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wDd71vFKUMJutO3fZjY2Pw0HWb.jpg", url:"https://themoviedb.org/person/1219"}}, {tmdbId:"44058", properties:{bornIn:"Los Angeles, California, U.S.", imdbId:"0752802", born:date('1984-01-24'), name:"Remy Ryan", bio:"​From Wikipedia, the free encyclopedia.   \n\nRemy Ryan Hernandez (born January 24, 1984) is an American film actress.  She is best known for her role as Nikko in the 1993 science fiction movie RoboCop 3.  Her other film roles include Monkey Trouble (1994) and Toto, Lost in New York (1996).  She is sometimes credited as Remy Ryan during early '90's. \n\nShe has made television appearances on shows like Mann & Machine, Northern Exposure, The Torkelsons, The Flash and Beauty and the Beast...", url:"https://themoviedb.org/person/44058"}}, {tmdbId:"44059", properties:{bornIn:"New York, New York", imdbId:"0519023", born:date('1954-01-01'), name:"Jodi Long", bio:"​From Wikipedia, the free encyclopedia.   \n\nJodi Long (born January 7, 1954) is an American actress. Long had roles in many feature films including Patty Hearst, RoboCop 3, Striking Distance and The Hot Chick.  On television she appeared as a regular on such series as Cafe Americain, All American Girl and Miss Match, all of which were short-lived...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rLsdDkJMQRGiLfYgfwqQcNW4ZGc.jpg", url:"https://themoviedb.org/person/44059"}}, {tmdbId:"21381", properties:{imdbId:"0940070", name:"Wallace Wood", url:"https://themoviedb.org/person/21381"}}, {tmdbId:"21403", properties:{bornIn:"Las Vegas - Nevada - USA", imdbId:"0005272", born:date('1980-07-10'), name:"Thomas Ian Nicholas", bio:"Thomas Ian Nicholas (born July 10, 1980) is an American film actor, singer, musician, producer, director, and writer.  Nicholas is best known for playing Henry Rowengartner in Rookie of the Year and Kevin Myers in American Pie, American Pie 2, and American Wedding. \n\nDescription above from the Wikipedia article Thomas Ian Nicholas, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yCgfHhjqvrirtvgtBRc1TMkF5ri.jpg", url:"https://themoviedb.org/person/21403"}}, {tmdbId:"26930", properties:{bornIn:"Oak Park, Illinois, USA", imdbId:"0607920", born:date('1958-01-01'), name:"Amy Morton", bio:"Amy Morton (born January 1, 1958) is an American actress and director, best known for her work in theatre.  She was nominated two times for a Tony Award for Best Actress in a Play for her performances in August: Osage County and Who's Afraid of Virginia Woolf?.  She is currently starring as Sergeant Trudy Platt in the NBC drama series Chicago P. D...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gWVEHcLI5am2XErhXofFPkw2iWY.jpg", url:"https://themoviedb.org/person/26930"}}, {tmdbId:"15852", properties:{bornIn:"Granada Hills, California, USA ", imdbId:"0000171", born:date('1968-04-19'), name:"Ashley Judd", bio:"An American television and film actress, who has played lead roles in films including Ruby in Paradise, Kiss the Girls, Double Jeopardy, Where the Heart Is and High Crimes.  She is active in a number of humanitarian and political causes, including two missions to the Democratic Republic of Congo to campaign against sexual violence against women.  Description above from the Wikipedia article Ashley Judd, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5771ZxVIs5rQbI1SV8TOlAFcF15.jpg", url:"https://themoviedb.org/person/15852"}}] AS row
