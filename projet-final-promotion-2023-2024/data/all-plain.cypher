UNWIND [{tmdbId:"73472", properties:{bornIn:"Kaohsiung, Taiwan", imdbId:"0910935", born:date('1970-08-01'), name:"Jean Wang", url:"https://themoviedb.org/person/73472"}}, {tmdbId:"12928", properties:{bornIn:" Redwood City, California", imdbId:"0539678", born:date('1984-07-07'), name:"Ross Malinger", bio:"Ross Malinger (born July 7, 1984) is an American actor, best known for his role in Sleepless In Seattle.  He starred in Toothless, Sudden Death.  On television he had starring roles on Recess and Good Advice as well as guest roles on Party of Five and Seinfeld...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/adbUg93lEPJr3yp2Hn4Ah6xRbaG.jpg", url:"https://themoviedb.org/person/12928"}}, {tmdbId:"8536", properties:{bornIn:"London, Ontario, Canada", imdbId:"0001255", born:date('1949-03-16'), name:"Victor Garber", bio:"Victor Joseph Garber (born March 16, 1949) is a Canadian film, stage and television actor and singer.  Garber is perhaps best known for playing Jesus in Godspell, Jack Bristow in the television series Alias and Thomas Andrews in James Cameron's Titanic...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q0h2M3xdCugsWVgi6c3ixZt7a8L.jpg", url:"https://themoviedb.org/person/8536"}}, {tmdbId:"6416", properties:{bornIn:"Warrington, Cheshire, England, UK", imdbId:"0908116", born:date('1966-05-19'), name:"Polly Walker", bio:"Polly Walker (born 19 May 1966) is an English actress. \n\nDescription above from the Wikipedia article Polly Walker, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lfXAWi15IUiRna1kMWWfShC3N6Z.jpg", url:"https://themoviedb.org/person/6416"}}, {tmdbId:"17782", properties:{bornIn:"Dublin - Ireland", imdbId:"0000538", born:date('1953-05-30'), name:"Colm Meaney", bio:"Colm J.  Meaney (born 30 May 1953) is an Irish actor widely known for playing Miles O'Brien in Star Trek: The Next Generation and Star Trek: Deep Space Nine.  He is second only to Michael Dorn in most appearances in Star Trek episodes.  He has guest-starred on many TV shows from Law &amp; Order to The Simpsons.  He has also had a significant career in motion pictures...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/guL6RJdlRMtOJN3LoaY3G8hG4Rd.jpg", url:"https://themoviedb.org/person/17782"}}, {tmdbId:"74018", properties:{bornIn:"Dublin, Ireland", imdbId:"0445530", name:"Tina Kellegher", bio:"From Wikipedia, the free encyclopedia\n\nTina Kellegher is an Irish actress, born in Dublin in 1967.  She is best known for her role as Niamh Quigley in BBC television series Ballykissangel.  She is also a well-known voice on BBC Radio 4, having played policewoman Tina Mahon in the first four series of Baldi.  She is married to Gordon Wycherley, location manager on, among other projects, Ballykissangel.  They have two sons, Michael, who was born in 2003 and Brian who was born in 2007...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jnGgWXon1cAITuuoK9JJLlMARdV.jpg", url:"https://themoviedb.org/person/74018"}}, {tmdbId:"17026", properties:{imdbId:"0564502", name:"Ruth McCabe", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wlNCRQ8odruOPyY2WKG80znHlKr.jpg", url:"https://themoviedb.org/person/17026"}}, {tmdbId:"63367", properties:{imdbId:"0533942", name:"Eanna MacLiam", url:"https://themoviedb.org/person/63367"}}, {tmdbId:"183814", properties:{bornIn:"Connecticut, U.S.A.", imdbId:"0563070", born:date('1965-06-08'), name:"Jefferson Mays", bio:"Jefferson Mays (born Lewis Jefferson Mays; June 8, 1965) is an American film, stage and television actor. \n\nMays was raised in Clinton, Connecticut with his parents, a naval intelligence officer and a children's librarian, and his siblings.  Mays graduated from Yale College, where he received a Bachelor of Arts degree, and the University of California, San Diego, where he earned a Master of Fine Arts...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5W9RapvctoJpGfjaQFQHsaLlGc9.jpg", url:"https://themoviedb.org/person/183814"}}, {tmdbId:"3204", properties:{bornIn:"Pontotoc, Mississippi, USA", imdbId:"0280890", born:date('1942-07-27'), name:"Lanny Flaherty", url:"https://themoviedb.org/person/3204"}}, {tmdbId:"15153", properties:{imdbId:"0920073", born:date('1944-12-20'), name:"Wendell Wellman", url:"https://themoviedb.org/person/15153"}}, {tmdbId:"17832", properties:{bornIn:"Sarasota, Florida, USA", imdbId:"0001303", born:date('1971-08-29'), name:"Carla Gugino", bio:"Carla was born in Sarasota, Florida.  Moved with her mother to Paradise, California, when Carla was just five years old.  During her childhood, they moved many times within the state.  But she remained a straight-A student throughout high school and graduated as valedictorian.  A major modeling agency discovered Carla in San Diego and sent her to New York to begin a new career when she was 15...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/76eXMkYZCh1mRxG6O7irmJZsiG7.jpg", url:"https://themoviedb.org/person/17832"}}, {tmdbId:"74276", properties:{bornIn:"Sand Springs, Oklahoma, États-Unis", imdbId:"0681882", born:date('1947-04-18'), name:"Cindy Pickett", bio:"​From Wikipedia, the free encyclopedia.   \n\nCindy Lou Pickett (born April 18, 1947) is an American actress best known for her 1970s role as Jackie Marler-Spaulding on the CBS soap Guiding Light; her role as Dr.  Carol Novino on the hugely-popular television drama St...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6CqKvPebiGfLtPkUO2wJi9kd572.jpg", url:"https://themoviedb.org/person/74276"}}, {tmdbId:"52709", properties:{bornIn:"Osaka, Japan", imdbId:"0463814", born:date('1971-04-16'), name:"Aya Kokumai", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a8ExdKeQXf3WLw8bpukHKLDvsA7.jpg", url:"https://themoviedb.org/person/52709"}}, {tmdbId:"20335", properties:{bornIn:"Tokoname, Aichi Prefecture, Japan", imdbId:"0913880", born:date('1950-03-11'), name:"Tetsu Watanabe", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/it0WL3g31uIE7ZntjVVOwFzfn0R.jpg", url:"https://themoviedb.org/person/20335"}}, {tmdbId:"52710", properties:{imdbId:"0441548", name:"Masanobu Katsumura", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xcVHpOWbWBh3C9cJj8GyDE4Pe6l.jpg", url:"https://themoviedb.org/person/52710"}}, {tmdbId:"39251", properties:{bornIn:"Paris, France", imdbId:"0395850", born:date('1957-04-23'), name:"Dominique Horwitz", bio:"Dominique Horwitz, wird am 23 April 1957 in Paris geboren.  1971 zieht  die Familie nach Berlin, wo er das Deutsch – Französische Gymnasium  besucht.  Mit 19 Jahren steht Dominique Horwitz das erste mal vor einer  Fernsehkamera, bereits ein Jahr später, 1978, ist er im Kino zu sehen  mit Peter Lilienthals „David“...", url:"https://themoviedb.org/person/39251"}}, {tmdbId:"3491", properties:{bornIn:"Dessau, Germany", imdbId:"0470981", born:date('1962-09-08'), name:"Thomas Kretschmann", bio:"Thomas Kretschmann (born 8 September 1962) is a German actor best known for playing Leutnant Hans Von Witzland in the 1993 film Stalingrad, Hauptmann Wilm Hosenfeld in The Pianist, Hermann Fegelein in Der Untergang, and Captain Englehorn in the 2005 remake of King Kong. \n\nDescription above from the Wikipedia article Thomas Kretschmann, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7M0P39a3CVA22dJyv5YQEkTThU7.jpg", url:"https://themoviedb.org/person/3491"}}, {tmdbId:"4936", properties:{bornIn:"Witten, Germany", imdbId:"0293695", born:date('1959-04-10'), name:"Jochen Nickel", url:"https://themoviedb.org/person/4936"}}, {tmdbId:"22184", properties:{bornIn:"Berlin, Deutschland", imdbId:"0748993", born:date('1967-11-30'), name:"Sebastian Rudolph", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kUITYcAdzFbqmkdG47f8GsQgTxz.jpg", url:"https://themoviedb.org/person/22184"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"137917", properties:{bornIn:"Bengbu, Anhu, China", born:date('1969-06-20'), name:"Wenli Jiang", bio:"Jiang Wenli was born in a highbrow family.  Her father was a railroad engineer, her mother was a railroad telephone operator, and her parents love literature and art.  Since Wenli was a little girl, her father taught her to read famous book and painting, and listen to famous songs.  When she was 5 years old, she dreamt about being a gymnast, so her mother sent her to study dance and gymnastics...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/34dJE4iDo6cAeJffqHtYlDFptbl.jpg", url:"https://themoviedb.org/person/137917"}}, {tmdbId:"552478", properties:{imdbId:"0633082", name:"Xingli Niu", url:"https://themoviedb.org/person/552478"}}, {tmdbId:"1396188", properties:{imdbId:"1229075", born:date('1962-01-01'), name:"Shaojun Tian", url:"https://themoviedb.org/person/1396188"}}, {tmdbId:"543178", properties:{bornIn:"Tianjin, China", imdbId:"0955346", born:date('1955-01-17'), name:"Guoli Zhang", bio:"Zhang Guoli (born 17 January 1955) is a Chinese film actor and director.  Zhang was a xiangsheng actor before he started working on films and television series.  He is mostly known for his roles playing the Emperor in various dramas involving Qing Dynasty imperial China.  He has also hosted the CCTV New Year's Gala in 2014. \n\nHe is married to actress Deng Jie and he has a son named Zhang Mo from a previous marriage, who is also an actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jYC0uUs7XUufPzYqgDB8OI6cv05.jpg", url:"https://themoviedb.org/person/543178"}}, {tmdbId:"25306", properties:{bornIn:"Bethlehem, Pennsylvania", imdbId:"0004995", born:date('1956-07-12'), name:"Mel Harris", bio:"From Wikipedia, the free encyclopedia.   Mel Harris (Mary Ellen Harris) (born July 12, 1956) is an American actress. \n\nDescription above from the Wikipedia article Mel Harris, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hKQ09Iku4IwfSD6D8jTmvm8ptMq.jpg", url:"https://themoviedb.org/person/25306"}}, {tmdbId:"579216", properties:{bornIn:"Hong Kong, British Crown Colony [now China]", born:date('1969-09-15'), name:"Fennie Yuen", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ylY0Bf8ji6cUb2ttiUSVcRo1ufq.jpg", url:"https://themoviedb.org/person/579216"}}, {tmdbId:"14344", properties:{bornIn:"Guildford, Surrey, England", imdbId:"0934179", born:date('1946-12-25'), name:"Stuart Wilson", bio:"​From Wikipedia, the free encyclopedia.   \n\nStuart Wilson (born 25 December 1946) is an English actor. Wilson got his first big break when chosen for the leading role of Johann Strauss II in the 1972 ITV costume drama The Strauss Family...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8IMv8WdbpkV2z4Sb5AJvyE6s0bn.jpg", url:"https://themoviedb.org/person/14344"}}, {tmdbId:"17485", properties:{bornIn:"Windsor - Ontario - Canada", imdbId:"0001624", born:date('1960-01-12'), name:"Oliver Platt", bio:"Oliver James Platt (born January 12, 1960) is an American actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/toAVx1NyoVbFkxh0ydRsD1fP6pV.jpg", url:"https://themoviedb.org/person/17485"}}, {tmdbId:"2480345", properties:{name:"Leon Theremin", url:"https://themoviedb.org/person/2480345"}}, {tmdbId:"1842466", properties:{name:"Clara Rockmore", url:"https://themoviedb.org/person/1842466"}}, {tmdbId:"1842442", properties:{name:"Robert Moog", url:"https://themoviedb.org/person/1842442"}}, {tmdbId:"10132", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0272173", born:date('1958-08-22'), name:"Colm Feore", bio:"An American-born Canadian stage, film and television actor. \n\nDescription above from the Wikipedia article Colm Feore, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oOxcf1qB1IvVZrBEE1PdrfMiyBK.jpg", url:"https://themoviedb.org/person/10132"}}, {tmdbId:"1239577", properties:{imdbId:"0450658", name:"Derek Keurvorst", url:"https://themoviedb.org/person/1239577"}}, {tmdbId:"1211071", properties:{imdbId:"0480430", name:"Katya Ladan", url:"https://themoviedb.org/person/1211071"}}, {tmdbId:"6193", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0000138", born:date('1974-11-11'), name:"Leonardo DiCaprio", bio:"Leonardo DiCaprio (born November 11, 1974) is an American actor, film producer, and environmental activist. \n\nHe began his film career by starring as Josh in Critters 3 before starring in the film adaptation of the memoir This Boy's Life (1993) alongside Robert De Niro...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wo2hJpn04vbtmh0B9utCFdsQhxM.jpg", url:"https://themoviedb.org/person/6193"}}, {tmdbId:"53814", properties:{bornIn:"San Mateo County, California, U.S.", imdbId:"0088098", born:date('1975-02-08'), name:"Jonah Blechman", bio:"From Wikipedia, the free encyclopedia. \n\nJonah Ethan Blechman (born February 8, 1975) is an American actor.  He has appeared in This Boy's Life with Leonardo DiCaprio and stars in Another Gay Movie alongside Johathan Chase and Michael Carbonaro and the sequel Another Gay Sequel: Gays Gone Wild!. \n\nDescription above from the Wikipedia article Jonah Blechman, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/53814"}}, {tmdbId:"1582", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"0001166", born:date('1972-09-10'), name:"James Duval", bio:"James \"Jimmy\" Edward Duval (born September 10, 1972) is an American actor, who is most famous for his roles in the Gregg Araki \"Teenage Apocalypse\" trilogy in addition to Frank in Donnie Darko, Miguel in Independence Day, and Singh in Go...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pTtpPWhLgInYBUfRJGMKLeG9fw7.jpg", url:"https://themoviedb.org/person/1582"}}, {tmdbId:"110880", properties:{imdbId:"0067118", name:"Susan Behshid", url:"https://themoviedb.org/person/110880"}}, {tmdbId:"110881", properties:{imdbId:"0318680", name:"Jenee Gill", url:"https://themoviedb.org/person/110881"}}, {tmdbId:"1138", properties:{imdbId:"0753666", born:date('1953-08-19'), name:"Benoît Régent", died:date('1994-10-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hSCNZq6w24lJUTJpRNyiVTtQ9lL.jpg", url:"https://themoviedb.org/person/1138"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"1139", properties:{bornIn:"Paris,France", imdbId:"0674340", born:date('1966-06-30'), name:"Florence Pernel", bio:"Florence Pernel débute sa carrière d’actrice à l'âge de 10 ans dans le téléfilm Plein soleil.  A 14 ans, elle apparait pour la première fois sur le grand écran dans le film Girls, de Just Jaeckin, photographe et réalisateur du film érotique Emmanuelle.    En 1981, à seulement 15 ans, elle est nommée aux Césars dans la catégorie \"Meilleur espoir féminin\" pour son rôle dans \n\nQue les gros salaires lèvent le doigt !.  Elle n'abandonne pas pour autant ces études et délaisse alors le cinéma...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fqrv9hguDX9xtjlQnZuABOVSoka.jpg", url:"https://themoviedb.org/person/1139"}}, {tmdbId:"1140", properties:{imdbId:"0904996", name:"Charlotte Véry", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cgeMreoNYlgYEqToHn3jgGZtbbG.jpg", url:"https://themoviedb.org/person/1140"}}, {tmdbId:"1211888", properties:{bornIn:"The Bronx - New York - USA", imdbId:"0717650", born:date('1931-01-13'), name:"Charles Nelson Reilly", died:date('2007-05-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yyxYSQCd7ceUxW7GLUIzaMzLulQ.jpg", url:"https://themoviedb.org/person/1211888"}}, {tmdbId:"10981", properties:{bornIn:"County Cork, Ireland", imdbId:"0789716", born:date('1958-07-10'), name:"Fiona Shaw", bio:"From Wikipedia, the free encyclopedia. \n\nFiona Shaw, Honorary CBE (born 10 July 1958) is an Irish actress and theatre director.  Although to international audiences she is probably most familiar for her minor role as Petunia Dursley in the Harry Potter films, she is an accomplished classical actress.  Shaw was awarded an honorary CBE in 2001. \n\nDescription above from the Wikipedia article Fiona Shaw, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tjM74LcxwnYM77Csg1EtlXb1F9a.jpg", url:"https://themoviedb.org/person/10981"}}, {tmdbId:"40258", properties:{bornIn:"Tacoma, Washington, USA", imdbId:"0001717", born:date('1957-05-31'), name:"Kyle Secor", bio:"From Wikipedia, the free encyclopedia. \n\nKyle Ivan Secor (born May 31, 1957) is an American television and movie actor, best known for his role as Detective Tim Bayliss on the crime drama Homicide: Life on the Street...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ggt3Emlmx48COKAA7rl4MdWJyo3.jpg", url:"https://themoviedb.org/person/40258"}}, {tmdbId:"28781", properties:{bornIn:"Paris, France", imdbId:"0002010", born:date('1952-05-06'), name:"Christian Clavier", bio:"Christian Clavier is a French actor, screenwriter, film producer and film director.  He is the brother of French film director Stéphane Clavier. \n\nAfter his high class studies at the Neuilly Lycée Pasteur—though asserted here and there, he never studied at Institut d'Études Politiques de Paris (Sciences Po) —he started his actor career with the comedic theater troupe Splendid, which had hits with films like Les Bronzés font du ski and Le Père Noël est une ordure...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9WsvKjheeizXCcZrFjZCrCoItqO.jpg", url:"https://themoviedb.org/person/28781"}}, {tmdbId:"62531", properties:{bornIn:"Dieppe, France", imdbId:"0501256", born:date('1964-03-09'), name:"Valérie Lemercier", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2WMtL9SFIWmOIL2P6PdfHncSLXP.jpg", url:"https://themoviedb.org/person/62531"}}, {tmdbId:"64913", properties:{bornIn:"Gap, Hautes-Alpes, France", imdbId:"0154707", born:date('1951-09-19'), name:"Marie-Anne Chazel", bio:"Marie-Anne Chazel (born 19 September 1951) is a French actress, screenwriter and director, who has been active in both film and television since 1974. \n\nBorn Marie-Anne France Jacqueline Chazel to the actress Louba Guertchikoff (birth name Louba Louise Pinon, 1919–1999) in Gap, Hautes-Alpes, France. \n\nFrom 1967 Chazel studied at Pasteur College, alongside Michel Blanc, Gerard Jugnot, Thierry Lhermitte and Christian Clavier...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iDfbfCk3uzlCaFypaIelkmIlhmi.jpg", url:"https://themoviedb.org/person/64913"}}, {tmdbId:"60093", properties:{bornIn:"Carville, Louisiana, USA", imdbId:"0142598", born:date('1944-10-25'), name:"James Carville", bio:"Chester James Carville Jr.  is a media personality with a subject matter expertise in United States Elections, and a prominent political consultant who specializes in developing framing and strategy for electoral campaigns...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9nqZlgTmykti5veQEFljHAr6NaL.jpg", url:"https://themoviedb.org/person/60093"}}, {tmdbId:"117817", properties:{imdbId:"0826888", born:date('1961-02-10'), name:"George Stephanopoulos", url:"https://themoviedb.org/person/117817"}}, {tmdbId:"1051946", properties:{imdbId:"0065321", name:"Heather Beckel", url:"https://themoviedb.org/person/1051946"}}, {tmdbId:"175194", properties:{bornIn:"USA", imdbId:"0066669", name:"Paul Begala", bio:"Paul Edward Begala is an American political consultant and political commentator, best known as the former adviser to President Bill Clinton.  Begala was a chief strategist for the 1992 Clinton–Gore campaign, which carried 33 states and made Clinton the first Democrat to occupy the White House in twelve years...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wVBvYJvcJcjARpArthnoCeWPCqv.jpg", url:"https://themoviedb.org/person/175194"}}, {tmdbId:"175553", properties:{bornIn:"New York City, New York", born:date('1980-09-06'), name:"Blaze Berdahl", bio:"is an American actress, singer, rapper, voice-over actor, announcer, and narrator. [1] She is perhaps best known for her roles as Lenni Frazier in the children's television series Ghostwriter and Ellie Creed in the film Pet Sematary (1989)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lb8zPVqanj6XPmkZFYvBPI43pyW.jpg", url:"https://themoviedb.org/person/175553"}}, {tmdbId:"24203", properties:{bornIn:" Coney Island, New York, U.S.", imdbId:"0674231", born:date('1948-03-31'), name:"Rhea Perlman", bio:"Rhea Jo Perlman (born 31 March 1948) is an American actress and writer.  She is best known for her role as head-waitress Carla Tortelli in the sitcom Cheers (1982–1993).  Over the course of 11 seasons, Perlman was nominated for ten Emmy Awards for Outstanding Supporting Actress – winning four times – and was nominated for a record seven Golden Globe Awards for Best Supporting Actress in a Television Series...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/utg7mKbhNvxRWfWBwSb27tQTaOE.jpg", url:"https://themoviedb.org/person/24203"}}, {tmdbId:"14991", properties:{bornIn:"New Rochelle, New York, USA", imdbId:"0005143", born:date('1950-04-28'), name:"Jay Leno", bio:"An American actor, stand-up comedian and television host.  From 1992 to 2009, Leno was the host of NBC's The Tonight Show with Jay Leno.  Beginning in September 2009, Leno started a primetime talk show, titled The Jay Leno Show, which aired weeknights at 10:00 p. m.  (Eastern Time, UTC-5), also on NBC.  After The Jay Leno Show was canceled in January 2010 amid a host controversy, Leno returned to host The Tonight Show with Jay Leno on March 1, 2010...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cplpY6q2VFtR7c1gMHM50wPzdU3.jpg", url:"https://themoviedb.org/person/14991"}}, {tmdbId:"42974", properties:{bornIn:"New York, New York", imdbId:"0004752", born:date('1964-11-07'), name:"Troy Byer", bio:"Troy Yvette Beyer (born November 7, 1964) is an American film director, screenwriter and actress. \n\nDescription above from the Wikipedia article Troy Beyer, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jf4fviwKUPBqs3cDyBKPR6m6URB.jpg", url:"https://themoviedb.org/person/42974"}}, {tmdbId:"18346", properties:{bornIn:"Fairfax, Virginia, USA", imdbId:"0446805", born:date('1985-06-28'), name:"Rae'Ven Larrymore Kelly", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bJGMNfhDyzAVh1cy9Yoi6dGvlES.jpg", url:"https://themoviedb.org/person/18346"}}, {tmdbId:"80990", properties:{bornIn:"Sumter, South Carolina, USA", imdbId:"0135102", born:date('1925-09-22'), name:"Virginia Capers", died:date('2004-05-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zajkV5BKMGmXV0cyiLEvPv2j3AR.jpg", url:"https://themoviedb.org/person/80990"}}, {tmdbId:"131732", properties:{bornIn:"Guangxi, China", imdbId:"0944578", born:date('1962-02-25'), name:"Xin Xin Xiong", bio:"“The Human Whirlwind” would be a fitting nickname for stuntman, fight performer and actor Xiong Xin Xin due to his incredibly fast and electrifying wu-shu acrobatics and fighting moves.  His physical prowess and bravery as a stuntman and stunt-double had already brought him some level of repute when he was finally given opportunities to shine playing characters in movies...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/f6dTFDOiKuUX0WH6fTsgoSIY3sm.jpg", url:"https://themoviedb.org/person/131732"}}, {tmdbId:"67221", properties:{bornIn:"Shanghai, China", imdbId:"0156522", born:date('1967-02-07'), name:"Sharla Cheung", bio:"Sharla Cheung Man, also known as Cheung Man (born February 7, 1967) is an actress working in the Hong Kong film industry. \n\nSharla Cheung was discovered by Wong Jing, with whom she worked on many of his productions in the early 1990s.  Cheung gained popularity with the numerous films she's starred in alongside Stephen Chow, in which she was frequently cast as Chow's love interest...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6PdXxsO2XqVkEDbMmo4vklu3z4s.jpg", url:"https://themoviedb.org/person/67221"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"67222", properties:{bornIn:"Hong Kong, British Crown Colony [now China]", imdbId:"0946873", born:date('1968-05-16'), name:"Chingmy Yau", bio:"​Born May 16, 1968 as Yau Suk Ching, Chingmy Yau get her start in the entertainment industry by participating in beauty pageants.  It was after her appearance at the Miss Hong Kong beauty pageant in 1989 (where she took the \"Miss Photogenic\" trophy) that she began to get film offers.  Most of her early work consisted of her playing goody-two-shoes roles in romantic comedies until notorious film-maker Wong Jing took Yau under his wing -- and into his bed, even though he was married at the time...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cA4g5xiaw5pJrlwWRShm0Y0JTuA.jpg", url:"https://themoviedb.org/person/67222"}}, {tmdbId:"65966", properties:{imdbId:"0155587", born:date('1951-05-22'), name:"Kent Cheng", bio:"Kent Cheng Jak-si (Chinese: 鄭則士, born 22 May 1951) is a Hong Kong film and television actor.  He is a two time recipient of the best actor award at the Hong Kong Film Awards...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rQRr8QvdkUsQVhchdUtiTznVVff.jpg", url:"https://themoviedb.org/person/65966"}}, {tmdbId:"87944", properties:{bornIn:"Guangzhou, Guangdong, China", imdbId:"0492344", born:date('1947-08-27'), name:"Kar-Ying Law", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ly8lSEpKrjciOucpSLQjcj3JcnI.jpg", url:"https://themoviedb.org/person/87944"}}, {tmdbId:"83691", properties:{imdbId:"0787931", name:"Puishan Auyeung", url:"https://themoviedb.org/person/83691"}}, {tmdbId:"935445", properties:{bornIn:"Copenhagen, Denmark", imdbId:"0738231", born:date('1928-09-20'), name:"Kirsten Rolffes", died:date('2000-04-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v5F6oMsr6GjgujBxy23tKNc5Fw0.jpg", url:"https://themoviedb.org/person/935445"}}, {tmdbId:"209386", properties:{bornIn:"Nyborg, Denmark", imdbId:"0360856", born:date('1924-08-14'), name:"Holger Juul Hansen", died:date('2013-03-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iFNeaB82mPYMjeQBsGpG7wQhqib.jpg", url:"https://themoviedb.org/person/209386"}}, {tmdbId:"64122", properties:{bornIn:"Copenhagen, Denmark", imdbId:"0683587", born:date('1955-10-16'), name:"Søren Pilmark", bio:"Søren Pilmark was born on October 16, 1955 in Copenhagen, Denmark as Søren Louis Pilmark.  He is an actor and writer, known for Flickering Lights (2000), King's Game (2004) and The Keeper of Lost Causes (2013)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1wIiWtSGtnj26SYprHtMXE57srS.jpg", url:"https://themoviedb.org/person/64122"}}, {tmdbId:"45746", properties:{bornIn:"Voorburg, Zuid-Holland, The Netherlands", imdbId:"0772499", born:date('1966-02-01'), name:"Ariane Schluter", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oQdGo6V7yLOMfr9xl9uXo9u7PtL.jpg", url:"https://themoviedb.org/person/45746"}}, {tmdbId:"211203", properties:{imdbId:"0447397", born:date('1944-07-12'), name:"Ad van Kempen", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iYXQLfIQPolVfmO0OpWNhPHsEPL.jpg", url:"https://themoviedb.org/person/211203"}}, {tmdbId:"148101", properties:{imdbId:"0289247", born:date('1979-04-26'), name:"Sean Fox", url:"https://themoviedb.org/person/148101"}}, {tmdbId:"150573", properties:{imdbId:"0881817", name:"Gabriel Cosmin Urdes", url:"https://themoviedb.org/person/150573"}}, {tmdbId:"150574", properties:{bornIn:"Wien, Austria", imdbId:"0586632", born:date('1971-04-04'), name:"Lukas Miko", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7TOxIu0j5tYlWvXV4jRihYbIpum.jpg", url:"https://themoviedb.org/person/150574"}}, {tmdbId:"61471", properties:{bornIn:"Hall in Tirol, Austria", imdbId:"0345100", born:date('1924-05-04'), name:"Otto Grünmandl", died:date('2000-03-03'), url:"https://themoviedb.org/person/61471"}}, {tmdbId:"37069", properties:{bornIn:"Lausanne, Switzerland", imdbId:"0071501", born:date('1963-10-13'), name:"Anne Bennent", bio:"Anne Bennent is a Swiss stage and screen actress, chansoneuse and reader.  She is actor David Bennent's big sister...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/m9c4gQS3a7MUdpcrPTBU6OhWGqb.jpg", url:"https://themoviedb.org/person/37069"}}, {tmdbId:"215830", properties:{bornIn:"Garland, Texas", imdbId:"0278026", born:date('1987-08-30'), name:"Cameron Finley", bio:"From Wikipedia, the free encyclopedia. \n\nJoseph Cameron Finley (born August 30, 1987) is an American former child actor. \n\nFinley was born in Garland, Texas, the son of Lexa Iann (née Aulgur), a spiritual healer, and Charles David \"Chuck\" Finley, a software developer.  He has two siblings, Taz and Stopher.  When he was three, he was taken by his parents to an acting seminar near his home...", url:"https://themoviedb.org/person/215830"}}, {tmdbId:"84077", properties:{bornIn:"Brooklyn, New York City, New York, USA", imdbId:"0552222", born:date('1965-08-11'), name:"Duane Martin", bio:"Duane Martin (born August 11, 1965) is an American film and television actor...", url:"https://themoviedb.org/person/84077"}}, {tmdbId:"155236", properties:{imdbId:"0047223", born:date('1933-10-27'), name:"David Bailey", died:date('2004-11-25'), url:"https://themoviedb.org/person/155236"}}, {tmdbId:"31004", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0005159", born:date('1966-03-03'), name:"Tone Loc", bio:"From Wikipedia, the free encyclopedia. \n\nAnthony Terrell Smith (born March 3, 1966, Los Angeles, California), better known by his stage name Tone Lōc, is an American rapper and actor.  He is best known for his deep, gravelly voice and his million-selling hit singles, \"Wild Thing\" and \"Funky Cold Medina\".  Tone Lōc is also a voice actor, having voiced characters in several cartoon series...", url:"https://themoviedb.org/person/31004"}}, {tmdbId:"529", properties:{bornIn:"Ely, Cambridgeshire, England, UK", imdbId:"0001602", born:date('1967-10-05'), name:"Guy Pearce", bio:"Guy Edward Pearce (born 5 October 1967) is an English-born Australian actor and musician, known for his roles as Leonard Shelby in Christopher Nolan's Memento, Lieutenant Ed Exley in the film L. A.  Confidential, a drag queen in the cult film The Adventures of Priscilla, Queen of the Desert, Mike Young in the popular Australian television series Neighbours and King Edward VIII (\"David\") in the 2010 Best Picture Oscar winner The King's Speech...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hCzlUxrTLz3ntoPApW873sX0THf.jpg", url:"https://themoviedb.org/person/529"}}, {tmdbId:"126332", properties:{imdbId:"0751405", name:"Rebel Penfold-Russell", url:"https://themoviedb.org/person/126332"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"71171", properties:{bornIn:"Taipei, Taiwan", imdbId:"0497642", born:date('1968-10-12'), name:"Kang-sheng Lee", bio:"Lee Kang-sheng  (Chinese: 李康生; pinyin: Lǐ Kāngshēng) (b.  1968 in Taipei, Taiwan) is a Taiwanese actor, film director, and screenwriter.  He has appeared in all of Tsai Ming-liang's feature films.  Lee's directorial efforts include The Missing in 2003 and Help Me Eros in 2007...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kCqGudZllthGvvCwUSKIDuSstXG.jpg", url:"https://themoviedb.org/person/71171"}}, {tmdbId:"2577253", properties:{name:"Kuei-Mei Yang", url:"https://themoviedb.org/person/2577253"}}, {tmdbId:"134763", properties:{imdbId:"0537698", name:"Charles Gitonga Maina", url:"https://themoviedb.org/person/134763"}}, {tmdbId:"134764", properties:{bornIn:"Cádiz, Spain", imdbId:"0891483", born:date('1960-11-05'), name:"Yolanda Vazquez", bio:"Yolanda Vazquez is a television, film and theatre actress.  Vazquez was born in the province of Cadiz in the south of Spain and moved to England at the age of ten...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zR6789BnCi4Q9MC98556kVkUl6Z.jpg", url:"https://themoviedb.org/person/134764"}}, {tmdbId:"75790", properties:{bornIn:"Port Elizabeth, South Africa", imdbId:"0637681", born:date('1941-10-06'), name:"Winston Ntshona", bio:"From Wikipedia, the free encyclopedia\n\nWinston Ntshona (born 6 October 1941) is a South African playwright and actor. \n\nBorn in Port Elizabeth, Ntshona worked alongside fellow South African Athol Fugard on several occasions and played a minor role in Richard Attenborough's acclaimed film Gandhi. \n\nNtshona also played deposed President Julius Limbani, the subject of a rescue attempt in The Wild Geese (1977).  Limbani is based on Moise Tshombe...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kcTvrBEaTeW2lrNamIrh39Jls35.jpg", url:"https://themoviedb.org/person/75790"}}, {tmdbId:"19292", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0001191", born:date('1966-09-09'), name:"Adam Sandler", bio:"Adam Sandler (born September 9, 1966) is an American actor, comedian, and producer. \n\nAt seventeen, he took his first step towards becoming a stand-up comedian when he took the stage at a Boston comedy club.  He regularly performed in clubs and at universities while attending New York University. \n\nIn 1987, he got a recurring role on The Cosby Show.  While working at a comedy club in Los Angeles, he recommended to Saturday Night Live producer Lorne Michaels by Dennis Miller...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rUaw3hLRxK4T9Vp9yS1YxQ2PgnT.jpg", url:"https://themoviedb.org/person/19292"}}, {tmdbId:"58198", properties:{bornIn:"Madison, Wisconsin, USA", imdbId:"0000394", born:date('1964-02-15'), name:"Chris Farley", bio:"From Wikipedia, the free encyclopedia\n\nChristopher Crosby \"Chris\" Farley (February 15, 1964 – December 18, 1997) was an American comedian and actor.  Farley was a member of Chicago's The Second City Theatre and cast member of the NBC sketch comedy show Saturday Night Live from 1990 to 1995.  He died on December 18, 1997 in Chicago of a cocaine intoxication and morphine overdose...", died:date('1997-12-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bnWvsN2pk4Z9SAZZRNN2kCZ5uPd.jpg", url:"https://themoviedb.org/person/58198"}}, {tmdbId:"17257", properties:{bornIn:"Bucharest, Romania", imdbId:"0530581", born:date('1966-07-11'), name:"Elina Löwensohn", bio:"Elina Löwensohn (born 11 July 1966) is a Romanian-born American actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eXw64F0CoDpYo6WBjk1ABeeuATX.jpg", url:"https://themoviedb.org/person/17257"}}, {tmdbId:"109144", properties:{imdbId:"0949433", born:date('1961-10-27'), name:"Damian Young", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pOeJAkFZpIApXwNHxWFy92RnJaB.jpg", url:"https://themoviedb.org/person/109144"}}, {tmdbId:"53930", properties:{bornIn:"Westlake Village, Los Angeles, California, USA", imdbId:"0001499", born:date('1985-02-07'), name:"Tina Majorino", bio:"Tina Marie Majorino (born February 7, 1985) is an American film and television actress.  She started her career as a child actor, starring in films such as Andre, When a Man Loves a Woman, Corrina, Corrina, and Waterworld.  Despite her early success, Majorino left show business in 1999. \n\nShe returned several years later in what would become one of her best known roles, the character Deb in the 2004 film Napoleon Dynamite...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tYZsyLn3GliOTYyr9An8WiBLXNY.jpg", url:"https://themoviedb.org/person/53930"}}, {tmdbId:"130935", properties:{imdbId:"0576721", born:date('1977-06-11'), name:"Shane Meier", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z3lmQgYB1BX8cTOt4NTqjupgUqp.jpg", url:"https://themoviedb.org/person/130935"}}, {tmdbId:"198700", properties:{imdbId:"0671719", name:"Aidan Pendleton", url:"https://themoviedb.org/person/198700"}}, {tmdbId:"4691", properties:{bornIn:"Westwood, New Jersey, USA", imdbId:"0001254", born:date('1961-09-18'), name:"James Gandolfini", bio:"James J.  Gandolfini, Jr.  (September 18, 1961 - June 19, 2013) was an American actor.  He is best known for his role as Tony Soprano in the HBO TV series The Sopranos, about a troubled crime boss struggling to balance his family life and career in the Mafia...", died:date('2013-06-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hWG2RY9mOWuZaWse7wROUUnHaGR.jpg", url:"https://themoviedb.org/person/4691"}}, {tmdbId:"106791", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0878152", born:date('1962-09-25'), name:"Aida Turturro", bio:"​From Wikipedia, the free encyclopedia.   \n\nAida Turturro (born September 25, 1962) is an American actress probably best known for playing Janice Soprano, sister of New Jersey mob boss Tony Soprano, on the HBO TV series The Sopranos...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xr5lWiB11Kzi2s6NNraW4De23ZI.jpg", url:"https://themoviedb.org/person/106791"}}, {tmdbId:"10138", properties:{bornIn:" Seattle, Washington, USA", imdbId:"0355083", born:date('1963-02-12'), name:"Brian Haley", bio:"​From Wikipedia, the free encyclopedia\n\nBrian Haley (born February 12, 1963) is an American actor and stand-up comedian.  His stand-up act is characterized by playing his all-American looks against manic outbursts and absurd situations...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7obuBQ4ltbh4dx09R9Gf1G77Y0o.jpg", url:"https://themoviedb.org/person/10138"}}, {tmdbId:"230632", properties:{bornIn:"Nalbari, Assam, India", imdbId:"0084443", born:date('1965-01-14'), name:"Seema Biswas", url:"https://themoviedb.org/person/230632"}}, {tmdbId:"995721", properties:{imdbId:"0659241", name:"Nirmal Pandey", died:date('2010-02-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o17S0roL4VvmxOZVdPHpvutih63.jpg", url:"https://themoviedb.org/person/995721"}}, {tmdbId:"129726", properties:{bornIn:"Uttar Pradesh, India", imdbId:"0900267", born:date('1949-01-31'), name:"Rajesh Vivek", died:date('2016-01-14'), url:"https://themoviedb.org/person/129726"}}, {tmdbId:"65058", properties:{bornIn:"London, England, UK", imdbId:"0074065", born:date('1969-10-13'), name:"Tushka Bergen", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fXrX8m7fdb1gJq5KpKNBziOxLUF.jpg", url:"https://themoviedb.org/person/65058"}}, {tmdbId:"23931", properties:{bornIn:"Tenafly, New Jersey, USA", imdbId:"0000227", born:date('1967-09-28'), name:"Mira Sorvino", bio:"From Wikipedia, the free encyclopedia. \n\nMira Katherine Sorvino (born September 28, 1967) is an American actress.  She won the Academy Award for Best Supporting Actress for her performance in Mighty Aphrodite (1995) and is also known for her role as Romy White in Romy and Michele's High School Reunion...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nThgMCWdMpNgjGmHQrKMUAYKoQa.jpg", url:"https://themoviedb.org/person/23931"}}] AS row
