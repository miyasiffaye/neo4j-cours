UNWIND [{tmdbId:"1336", properties:{bornIn:"Beijing, China", imdbId:"0001472", born:date('1963-04-26'), name:"Jet Li", bio:"Li Lian Jie (born April 26, 1963), better known by his stage name Jet Li, is a Chinese martial artist, actor, film producer, wushu champion, and international film star who was born in Beijing, China, and who has currently taken up Singapore citizenship. \n\nAfter three years of intensive training with Wu Bin, Li won his first national championship for the Beijing Wushu Team...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cctWKglKQz4xV5XHJ28TbfEkfEM.jpg", url:"https://themoviedb.org/person/1336"}}, {tmdbId:"80280", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0871590", born:date('1979-04-17'), name:"Michael Treanor", bio:"From Wikipedia, the free encyclopedia. \n\nMichael Treanor (born April 17, 1979) is an actor and martial artist who starred in 3 Ninjas and 3 Ninjas Knuckle Up.  He is the third son of Richard and Peggy Treanor. \n\nTreanor was discovered by casting agents for 3 Ninjas in his martial arts class.  After encouragement from friends and family, he auditioned for and successfully landed the role of eldest brother Rocky. \n\nTreanor is a black belt and continues to practice as an adult...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9iNHOUbmn5j2MwIMLeL6vfxBy4z.jpg", url:"https://themoviedb.org/person/80280"}}, {tmdbId:"8187", properties:{bornIn:"Pasadena, California, USA", imdbId:"0805189", born:date('1980-07-04'), name:"Max Elliott Slade", bio:"Max Elliott Slade (born July 4, 1980) is an American actor who starred in 3 Ninjas, 3 Ninjas Kick Back, and 3 Ninjas Knuckle Up.  He was featured as Jay Lovell in Apollo 13, young Mark Goddard in The Sweeper, and young Gil Buckman in Parenthood.  Slade was born in Pasadena, California.  He chose his own middle name, Elliott, at the age of 3 after watching the movie E. T.  His parents' names are John and Betty, and has an older brother named Demian.  All of them are, or at one time were, actors...", url:"https://themoviedb.org/person/8187"}}, {tmdbId:"80281", properties:{bornIn:"Ventura, California, USA", imdbId:"0694379", born:date('1984-01-30'), name:"Chad Power", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/okFKNft6QUcIh4N9hKjZnwY2Bbs.jpg", url:"https://themoviedb.org/person/80281"}}, {tmdbId:"20957", properties:{bornIn:"  United States", imdbId:"0572914", born:date('1955-06-21'), name:"Rachel McLish", bio:"Rachel McLish won her first bodybuilding competition in 1980 and was crowned the first Ms.  Olympia. Her career as a bodybuilder was short lived, but her beauty and charisma made her a natural in front of the camera.  She became an author, model, actress, and owned her own clothing line after she retired from bodybuilding.  From her early years, she wanted to help women get in shape during a time when weight training just wasn’t the norm for women...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fMY9L0C77UDxEJpHujs0XaKNgAu.jpg", url:"https://themoviedb.org/person/20957"}}, {tmdbId:"15827", properties:{bornIn:"New York City, New York, U.S.", imdbId:"0918334", born:date('1975-10-05'), name:"Scott Weinger", bio:"​From Wikipedia, the free encyclopedia.   \n\nScott Eric Weinger (born October 5, 1975) is an American actor and screenwriter, best known as the speaking voice of Aladdin in Walt Disney's eponymous feature film.  Weinger would reprise the role in two direct-to-video sequels, for the Disney Channel television series, and the Kingdom Hearts Series.  He is also well known for playing D. J.  Tanner's boyfriend \"Steve\" on Full House for several seasons...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oQavRbyJhtCyW4uTX5hLjvqXow1.jpg", url:"https://themoviedb.org/person/15827"}}, {tmdbId:"15829", properties:{bornIn:"Los Angeles, California, U.S.", imdbId:"0488306", born:date('1970-03-20'), name:"Linda Larkin", bio:"​From Wikipedia, the free encyclopedia.   \n\nLinda Larkin (born March 20, 1970) is an American cinema and television actress.  She is best known for providing the voice of Princess Jasmine in the movie Aladdin and various Aladdin sequels and spin-offs, as well as in the Kingdom Hearts video game series.   In order for her to voice Princess Jasmine she had to lower her voice due to Disney saying her voice was too high for Jasmine's voice...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cc7LSz7zDTyB7hGtPiBBSuJVDh6.jpg", url:"https://themoviedb.org/person/15829"}}, {tmdbId:"15830", properties:{bornIn:"Cleveland, Ohio, Stati Uniti", imdbId:"0293455", born:date('1950-01-05'), name:"Jonathan Freeman", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/auYxo6kO2FTnVUxcTtuzioa9IKe.jpg", url:"https://themoviedb.org/person/15830"}}, {tmdbId:"15904", properties:{bornIn:"Canton, Ohio, USA", imdbId:"0102163", born:date('1912-01-31'), name:"John Boylan", bio:"​From Wikipedia, the free encyclopedia\n\nJohn J.  Boylan (January 31, 1912 – November 16, 1994) was an American film, television, and theatrical actor.  One of three children born in Canton, Ohio to an Irish-American immigrant family, he began acting in 1932 when he helped found the Players' Guild for a local community theater...", died:date('1994-11-16'), url:"https://themoviedb.org/person/15904"}}, {tmdbId:"8666", properties:{imdbId:"0520199", born:date('1954-11-08'), name:"Sal Lopez", url:"https://themoviedb.org/person/8666"}}, {tmdbId:"2494201", properties:{imdbId:"0599598", name:"Vira Montes", url:"https://themoviedb.org/person/2494201"}}, {tmdbId:"2494510", properties:{name:"Roberto Martín Márquez", url:"https://themoviedb.org/person/2494510"}}, {tmdbId:"104382", properties:{bornIn:"Nuevo Laredo, Mexico", imdbId:"0650969", born:date('1961-05-01'), name:"Dyana Ortelli", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5ucJJBjifV9tEiVWnTLFy8OUrzF.jpg", url:"https://themoviedb.org/person/104382"}}, {tmdbId:"83459", properties:{imdbId:"0915764", born:date('1959-07-24'), name:"Shawn Weatherly", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i8DmLqmMnHnrJCFTcL1ToiGTukG.jpg", url:"https://themoviedb.org/person/83459"}}, {tmdbId:"64999", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0911725", born:date('1969-09-24'), name:"Megan Ward", bio:"From Wikipedia, the free encyclopedia\n\nMegan Marie Ward (born September 24, 1969) is an American actress best known for her numerous credits in science fiction and horror movies and television series.  In 2007, she joined the cast of the American daytime drama General Hospital as Kate Howard. \n\nDescription above from the Wikipedia article Megan Ward, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wMrxzRi6101yXfcOzJnw7fNgZpl.jpg", url:"https://themoviedb.org/person/64999"}}, {tmdbId:"3137", properties:{bornIn:"Puerto Rico", imdbId:"0129538", born:date('1959-01-01'), name:"Paul Calderon", bio:"He was born in Puerto Rico 1959.  Calderon moved to New York with his family at the age of six, where he grew up on the streets of the Lower East Side and Spanish Harlem.  Following some time in college, he enlisted in the United States Army and served overseas as an infantryman.   Returning to the States, Calderon set his sights on an acting career.  Starting out on the New York stage, he won an Obie Award for his performance in Blade to the Heat at the Public Theatre...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xIORhcIDmFMlaS3ZS3em1QiTkt5.jpg", url:"https://themoviedb.org/person/3137"}}, {tmdbId:"15537", properties:{bornIn:"Muskogee, Oklahoma, USA", imdbId:"0859150", born:date('1961-08-31'), name:"Leonard L. Thomas", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tz9fJ5O7aa3a1vBt52bIZKYdaSK.jpg", url:"https://themoviedb.org/person/15537"}}, {tmdbId:"10478", properties:{bornIn:"Tulsa, Oklahoma, USA", imdbId:"0000675", born:date('1963-06-10'), name:"Jeanne Tripplehorn", bio:"From Wikipedia, the free encyclopedia. \n\nJeanne Marie Tripplehorn is an American actress.  She began her career in theatre, acting in several plays throughout the early 1990s, including Anton Chekov's Three Sisters on Broadway.  Her film career began with the role of a police psychologist in the erotic thriller Basic Instinct (1992).  Her other film roles include The Firm (1993), Waterworld (1995) and Sliding Doors (1998)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cUlg7l2KtX1j1XTzDZicBIZETgH.jpg", url:"https://themoviedb.org/person/10478"}}, {tmdbId:"99042", properties:{imdbId:"0740587", name:"Gil Roper", url:"https://themoviedb.org/person/99042"}}, {tmdbId:"99043", properties:{imdbId:"0081787", born:date('1931-01-18'), name:"Dan Biggers", died:date('2011-12-05'), url:"https://themoviedb.org/person/99043"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"35241", properties:{bornIn:"Hinsdale, Illinois, USA", imdbId:"0005497", born:date('1978-03-23'), name:"Nicholle Tom", bio:"Nicholle Tom (born March 23, 1978) is an American actress, best known for her role on The Nanny...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cjFw8BrIpptxMJrDkEWEE25E8bi.jpg", url:"https://themoviedb.org/person/35241"}}, {tmdbId:"955", properties:{bornIn:"Madrid, Spain", imdbId:"0004851", born:date('1974-04-28'), name:"Penélope Cruz", bio:"Penélope Cruz Sánchez is a Spanish actress and model, signed at age 15, made her acting debut at 16 on television and her feature film debut the following year in Jamón, jamón (1992), to critical acclaim.   Cruz achieved recognition for her lead roles in the 2001 films Vanilla Sky and Blow. \n\nShe has since built a successful career, appearing in films from a range of genres, from thrillers to family friendly holiday features...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4etspxiOqhoIrlVuLmMrt6z17AL.jpg", url:"https://themoviedb.org/person/955"}}, {tmdbId:"145412", properties:{bornIn:"Madrid, Spain", imdbId:"0246418", born:date('1962-03-04'), name:"Miriam Díaz-Aroca", url:"https://themoviedb.org/person/145412"}}, {tmdbId:"23215", properties:{bornIn:"  Madrid, Spain", imdbId:"0225916", born:date('1966-09-18'), name:"Gabino Diego", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qqAWyPU31uk6juPPP6YLHI6jr3a.jpg", url:"https://themoviedb.org/person/23215"}}, {tmdbId:"965", properties:{bornIn:"Lima, Peru", imdbId:"0273178", born:date('1921-08-28'), name:"Fernando Fernán Gómez", bio:"Fernando Fernán Gómez was a Spanish actor, screenwriter, film director, theater director and member of the Royal Spanish Academy...", died:date('2007-11-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/s3grWW8bLqOoQFuLj011wW1KaWt.jpg", url:"https://themoviedb.org/person/965"}}, {tmdbId:"20449", properties:{bornIn:"Vienna, Austria", imdbId:"0295823", born:date('1975-11-13'), name:"Arno Frisch", bio:"From Wikipedia, the free encyclopedia. \n\nArno Frisch (born 13 November 1975) is an Austrian actor.  He has had central roles in two films by Michael Haneke, namely, Benny's Video and Funny Games. \n\nDescription above from the Wikipedia article Arno Frisch, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/20449"}}, {tmdbId:"8196", properties:{bornIn:"Grimma, Germany", imdbId:"0618057", born:date('1953-06-20'), name:"Ulrich Mühe", bio:"From Wikipedia, the free encyclopedia. \n\nFriedrich Hans Ulrich Mühe (20 June 1953 – 22 July 2007) was a German film, television and theatre actor...", died:date('2007-07-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8jjYOQgLwtWnB2stXEXp3IMNRqJ.jpg", url:"https://themoviedb.org/person/8196"}}, {tmdbId:"20450", properties:{imdbId:"0823730", name:"Ingrid Stassner", url:"https://themoviedb.org/person/20450"}}, {tmdbId:"8851", properties:{bornIn:"Newark, New Jersey, USA ", imdbId:"0001365", born:date('1963-08-09'), name:"Whitney Houston", bio:"From Wikipedia, the free encyclopedia\n\nWhitney Elizabeth Houston (born August 9, 1963 - February 11, 2012) was an American R&B/pop singer, actress, and former fashion model.  Houston is the most awarded female artist of all time, according to Guinness World Records, and her list of awards include 2 Emmy Awards, 6 Grammy Awards, 16 Billboard Music Awards, 22 American Music Awards, among a total of 415 career awards as of 2010...", died:date('2012-02-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5su69sRCQReFTS94j2OtcgIQLne.jpg", url:"https://themoviedb.org/person/8851"}}, {tmdbId:"8854", properties:{bornIn:"Cleveland, Ohio, USA", imdbId:"0167850", born:date('1934-06-16'), name:"Bill Cobbs", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cP2ETKFdk93z4e1oXZVG0utI3IM.jpg", url:"https://themoviedb.org/person/8854"}}, {tmdbId:"59153", properties:{bornIn:"New York City, New York, USA", imdbId:"0002101", born:date('1964-11-27'), name:"Robin Givens", bio:"Robin Simone Givens is an American model and film, television, and stage actress.  Givens first began acting in 1985 with an appearance on The Cosby Show, followed by roles in Diff'rent Strokes and the 1986 television film Beverly Hills Madam, opposite Faye Dunaway.   After meeting in March 1986, Givens married boxer Mike Tyson on February 7, 1988.  Tyson was then estimated to have US$50 million, and Givens and he did not make a prenuptial agreement...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iF7JVhxEcDqXEVBKNdSK9Bfwz6W.jpg", url:"https://themoviedb.org/person/59153"}}, {tmdbId:"4587", properties:{bornIn:"Cleveland, Ohio, USA", imdbId:"0000932", born:date('1966-08-14'), name:"Halle Berry", bio:"Halle Maria Berry is an American actress and former fashion model.  She won an Academy Award for Best Actress in 2002 for her performance in Monster's Ball, becoming the first and, as of 2014, the only woman of African-American descent to win an Oscar for a leading role.  She is one of the highest paid actresses in Hollywood and has been involved in the production side of several of the films in which she performed.  Berry is also a Revlon spokes-model...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yfAJMERSlDIZD1iy6Aab8bArcCK.jpg", url:"https://themoviedb.org/person/4587"}}, {tmdbId:"11332", properties:{bornIn:" New Zealand", imdbId:"0050975", born:date('1967-01-18'), name:"Timothy Balme", bio:"Timothy Guy Balme (born January 18, 1967), also known as Tim Balme, is an actor and screenwriter from New Zealand.  He's most well known for his roles on the long-running soap opera Shortland Street and Mercy Peak, as well as lead roles in the cult favourites Braindead and Jack Brown Genius.  He most recently was a writer and actor on the television series The Almighty Johnsons...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l1MWge3W4M3y1wYRJ9sLYkDLLHd.jpg", url:"https://themoviedb.org/person/11332"}}, {tmdbId:"11333", properties:{bornIn:"Spain", imdbId:"0679272", born:date('1965-01-01'), name:"Diana Peñalver", url:"https://themoviedb.org/person/11333"}}, {tmdbId:"11334", properties:{bornIn:"Worthing, Sussex, England, UK", imdbId:"0600473", born:date('1939-01-01'), name:"Elizabeth Moody", died:date('2010-01-12'), url:"https://themoviedb.org/person/11334"}}, {tmdbId:"11335", properties:{bornIn:" New Zealand", imdbId:"0914240", born:date('1940-01-15'), name:"Ian Watkin", bio:"Ian Watkin was a New Zealand actor, famous for his films “Braindead” and “Sleeping Dogs”.  Watkin grew up in Greymouth and moved to Australia in 1999, becoming a wine broker.  He appeared in an episode of Ngaio Marsh Theater in 1977...", died:date('2016-05-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6RfEvqidFQcdiO5HbrV7dNO9pVj.jpg", url:"https://themoviedb.org/person/11335"}}, {tmdbId:"402118", properties:{imdbId:"0370069", name:"Isobel Hawking", url:"https://themoviedb.org/person/402118"}}, {tmdbId:"39657", properties:{bornIn:"Oxford, England", imdbId:"0370071", born:date('1942-01-08'), name:"Stephen Hawking", bio:"Stephen William Hawking CH CBE FRS FRSA (8 January 1942 – 14 March 2018) was an English theoretical physicist, cosmologist, author, and Director of Research at the Centre for Theoretical Cosmology within the University of Cambridge.  His scientific works included a collaboration with Roger Penrose on gravitational singularity theorems in the framework of general relativity and the theoretical prediction that black holes emit radiation, often called Hawking radiation...", died:date('2018-03-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zcngJdU6f4qKiKYFocM9ANJxGXt.jpg", url:"https://themoviedb.org/person/39657"}}, {tmdbId:"1399265", properties:{imdbId:"0401925", name:"Janet Humphrey", url:"https://themoviedb.org/person/1399265"}}, {tmdbId:"1399266", properties:{imdbId:"0370070", name:"Mary Hawking", url:"https://themoviedb.org/person/1399266"}}] AS row
