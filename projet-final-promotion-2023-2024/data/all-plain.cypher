UNWIND [{tmdbId:"1262481", properties:{name:"Alessandro Carloni", url:"https://themoviedb.org/person/1262481"}}, {tmdbId:"150098", properties:{bornIn:"Highgate, London, England, UK", imdbId:"3734458", born:date('1972-02-18'), name:"Rupert Goold", bio:"Rupert Goold (born 1972) is an English theatre director.  He is the artistic director of Headlong Theatre (previously the Oxford Stage Company) and from 2010 he will be an associate director at the Royal Shakespeare Company...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l2B4YBQtkycR4bshIYvoZrL0x7t.jpg", url:"https://themoviedb.org/person/150098"}}, {tmdbId:"17458", properties:{bornIn:"Tunis, Tunisia", imdbId:"0444244", born:date('1960-12-07'), name:"Abdellatif Kechiche", bio:"From Wikipedia, the free encyclopedia. \n\nAbdellatif Kechiche, born December 7, 1960 in Tunis, Tunisia is an actor, movie director and screenwriter.  He made his directorial debut in 2000 with La Faute à Voltaire (Blame it on Voltaire), aka Poetical Refugee, which he also wrote.  He also directed L'Esquive, which won a César Award for Best Film and Best Director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3blJf1ragOzMXtiWbxQ9dc23enm.jpg", url:"https://themoviedb.org/person/17458"}}, {tmdbId:"8023", properties:{bornIn:"USA", imdbId:"0049633", name:"Kyle Balda", bio:"Kyle Balda is an American animator and film director, best known for co-directing 2012 animated film The Lorax with Chris Renaud and 2015's Minions with Pierre Coffin.  He has also worked as animator on several films including Jumanji, Toy Story 2, and Despicable Me.  He has worked for Pixar for years and now he is working for Illumination Entertainment...", url:"https://themoviedb.org/person/8023"}}, {tmdbId:"1120694", properties:{bornIn:"Providence, Rhode Island, USA", imdbId:"1601644", born:date('1971-10-22'), name:" Jennifer Lee", bio:"She earned a master's degree in fine arts at Columbia University of Arts, where she met Phil Johnston, with whom she wrote the script for Wreck-It Ralph (Ralph the Demolisher in Latin America, Break, Ralph! In Spain).  She was later chosen screenwriter for the Disney Animation Frozen movie, but at the end of 2012, she was also announced as director with Chris Buck...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pjZY7hdneR7FLrAT0mXNR6RrPfy.jpg", url:"https://themoviedb.org/person/1120694"}}, {tmdbId:"229604", properties:{imdbId:"1163237", born:date('1965-01-01'), name:"Clio Barnard", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3t7kB3miBr9bvGIs1948MLDpUQM.jpg", url:"https://themoviedb.org/person/229604"}}, {tmdbId:"533061", properties:{bornIn:"Warren, Ohio, U.S.", imdbId:"0342970", born:date('1969-01-14'), name:"Dave Grohl", bio:"David Eric \"Dave\" Grohl (born January 14, 1969) is an American rock musician, multi-instrumentalist, and singer-songwriter who is the lead vocalist, guitarist, and primary songwriter for the Foo Fighters; the former drummer for Nirvana and Scream; the drummer for Them Crooked Vultures; and wrote all the music for his short-lived side projects Late! and Probot...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hDfFm3lLPcdupe3PDucZdidKFBI.jpg", url:"https://themoviedb.org/person/533061"}}, {tmdbId:"1401541", properties:{imdbId:"4000389", name:"Travis Cluff", url:"https://themoviedb.org/person/1401541"}}, {tmdbId:"1401542", properties:{imdbId:"3951039", name:" Chris Lofing", url:"https://themoviedb.org/person/1401542"}}, {tmdbId:"1289604", properties:{bornIn:"Margate, Kent, England", imdbId:"3235877", born:date('1976-07-25'), name:"Ana Lily Amirpour", bio:"Ana Lily Amirpour was born on July 25, 1976 in Margate, Kent, England.  She is a director and writer, known for A Girl Walks Home Alone at Night (2014), The Bad Batch (2016) and A Little Suicide (2012)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bay1UyEh7oRwhW5ZIXvzpc33pXe.jpg", url:"https://themoviedb.org/person/1289604"}}, {tmdbId:"64139", properties:{imdbId:"0827750", name:"Joshua Michael Stern", url:"https://themoviedb.org/person/64139"}}, {tmdbId:"589610", properties:{imdbId:"2257147", name:"Stevan Riley", url:"https://themoviedb.org/person/589610"}}, {tmdbId:"293911", properties:{bornIn:"USA", imdbId:"0915304", born:date('1970-01-01'), name:"Scott Waugh", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zKRgOUNhzlMJSlyNHct6ZeBEAqR.jpg", url:"https://themoviedb.org/person/293911"}}, {tmdbId:"1144604", properties:{bornIn:"Hawaii, USA", imdbId:"2308774", born:date('1978-11-23'), name:"Destin Daniel Cretton", bio:"Destin Daniel Cretton is an American film director, screenwriter, producer, and editor.  He is best known for writing and directing his second feature film, Short Term 12...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6pOwxAXGsaqjlJmAdz9k3UArBdS.jpg", url:"https://themoviedb.org/person/1144604"}}, {tmdbId:"1057579", properties:{bornIn:"Japan", imdbId:"0619110", name:"Tatsuya Nagamine", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hiSUYqVI52RDFyaUPzfR85fQKZg.jpg", url:"https://themoviedb.org/person/1057579"}}, {tmdbId:"53296", properties:{bornIn:"Texas, USA", imdbId:"0649191", born:date('1974-09-23'), name:"Joshua Oppenheimer", bio:"Joshua Oppenheimer was born on September 23, 1974 in Texas, USA.  He is a producer and director, known for The Act of Killing (2012), The Look of Silence (2014) and The Entire History of the Louisiana Purchase (1998)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dHlrnmh2X0xZYmEfEwcsLTuarAD.jpg", url:"https://themoviedb.org/person/53296"}}, {tmdbId:"1349420", properties:{imdbId:"2964327", name:" Christine Cynn", bio:"Christine Cynn has been directing documentary and experimental films for the past 14 years, her most well known works being The Act of Killing (2012) and Shooting Ourselves (2016)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gRpGZM2a6BQzKnKBpyZGsEzoiXb.jpg", url:"https://themoviedb.org/person/1349420"}}, {tmdbId:"1454884", properties:{imdbId:"1031639", name:"Cedric Nicolas-Troyan", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oY4uK0KikdZzhlo1ZI8ilw1qAIE.jpg", url:"https://themoviedb.org/person/1454884"}}, {tmdbId:"544644", properties:{imdbId:"2554792", name:"Mac Carter", url:"https://themoviedb.org/person/544644"}}, {tmdbId:"551463", properties:{bornIn:"Salem, Massachusetts, United States", imdbId:"1093039", born:date('1978-05-20'), name:"Mike Flanagan", bio:"Mike Flanagan was born in Salem, Massachusetts in 1978 to Timothy and Laura Flanagan.  The family relocated frequently, as Timothy was in the U. S.  Coast Guard, and finally settled in Bowie, Maryland.  As a child, he would shoot and edit short movies on VHS.  This continued as he attended Archbishop Spalding High School in Severna Park, Maryland, where he was active in the school's drama department and the president of the school's SGA...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/85q5HSDoltjvg1ES0eToNlLjfPB.jpg", url:"https://themoviedb.org/person/551463"}}] AS row
