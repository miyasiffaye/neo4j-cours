UNWIND [{tmdbId:"96152", properties:{bornIn:"Munnsville, New York, USA", imdbId:"0911492", born:date('1930-10-05'), name:"Delbert Ward", died:date('1998-08-06'), url:"https://themoviedb.org/person/96152"}}, {tmdbId:"96153", properties:{bornIn:"Morrisville, New York, USA", imdbId:"1526324", born:date('1959-07-23'), name:"Roscoe Ward", died:date('2007-07-23'), url:"https://themoviedb.org/person/96153"}}, {tmdbId:"90198", properties:{imdbId:"0911700", born:date('1941-06-21'), name:"Lyman Ward", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zFBlLLgbLLDcEf7SvXlJCVPpg3V.jpg", url:"https://themoviedb.org/person/90198"}}, {tmdbId:"63242", properties:{imdbId:"0688145", name:"Jacqueline Poelvoorde-Pappaert", url:"https://themoviedb.org/person/63242"}}, {tmdbId:"1117722", properties:{imdbId:"0660561", name:"Nelly Pappaert", url:"https://themoviedb.org/person/1117722"}}, {tmdbId:"1117723", properties:{imdbId:"0660560", name:"Hector Pappaert", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3jencpq6EE0QXbcEJjNgygeJZbx.jpg", url:"https://themoviedb.org/person/1117723"}}, {tmdbId:"3982", properties:{bornIn:"Brooklyn, New York City, New York, USA", imdbId:"0075359", born:date('1955-12-16'), name:"Xander Berkeley", bio:"Alexander Harper Berkeley (born December 16, 1955) is an American actor.  He is known for his television roles as Sheriff Thomas McAllister on the crime drama The Mentalist, George Mason on the political thriller series 24, Percy Rose on the action thriller series Nikita, the Man on The Booth At The End and Gregory in AMC's The Walking Dead.  His notable film roles include Todd Voight in Terminator 2: Judgment Day, Agent Gibbs in Air Force One, Bowery Snax in Sid and Nancy, Dr...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oBoKGfngGGZmSVGFslphYjc23WO.jpg", url:"https://themoviedb.org/person/3982"}}, {tmdbId:"76759", properties:{imdbId:"0758436", born:date('1980-10-19'), name:"Benjamin Salisbury", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fQ5BiuBMY6gisJxrSHwUS43lXx8.jpg", url:"https://themoviedb.org/person/76759"}}, {tmdbId:"68494", properties:{bornIn:"San Francisco, California, USA", imdbId:"0923529", born:date('1974-09-06'), name:"Justin Whalin", bio:"Justin Garrett Whalin (born September 6, 1974) is an American actor best known for his role as Jimmy Olsen in the American television series Lois &amp; Clark: The New Adventures of Superman...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oEKsEJsmAj1ozJ2ehZ60NeJvfW0.jpg", url:"https://themoviedb.org/person/68494"}}, {tmdbId:"68495", properties:{bornIn:"New York City, New York, USA", imdbId:"0716275", born:date('1970-11-30'), name:"Perrey Reeves", bio:"​From Wikipedia, the free encyclopedia.   \n\nPerrey Reeves (born November 30, 1970) is an American film and television actress best known for her role on HBO's Entourage...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mQrk0rd6rU86lfkXlmOf5Sb28VW.jpg", url:"https://themoviedb.org/person/68495"}}, {tmdbId:"68496", properties:{imdbId:"0843199", name:"Jeremy Sylvers", bio:"Jeremy Sylvers is a former American child actor, known for his roles in Saved By the Bell, and My Wife and Kids...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dnHX6Dcm7SzzDj5R4W8JIQWE00c.jpg", url:"https://themoviedb.org/person/68496"}}, {tmdbId:"32802", properties:{bornIn:"Atlanta, Georgia, U.S.", imdbId:"0003910", born:date('1968-06-26'), name:"Travis Fine", bio:"​From Wikipedia, the free encyclopedia.   \n\nTravis Lane Fine (born June 26, 1968) is an American actor, writer, director and producer, perhaps best known for his roles in Girl, Interrupted and The Young Riders. \n\nDescription above from the Wikipedia article Travis Fine, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/32802"}}, {tmdbId:"27643", properties:{bornIn:"Australia", imdbId:"0502813", born:date('1971-11-14'), name:"Marco Leonardi", bio:"From Wikipedia, the free encyclopedia\n\nMarco Leonardi (born November 14, 1971) is an Italian actor. \n\nLeonardi was born in Australia to Italian parents.  He moved to Italy at the age of four and starred in the famous movie Cinema Paradiso and in the Mexican movie Like Water for Chocolate (1993).  He has made several movies in the United States, such as Once Upon a Time in Mexico.  Other appearances include the Canadian film The Five Senses...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jsGXp0sNG0CJYcqqi8NJHH2Usje.jpg", url:"https://themoviedb.org/person/27643"}}, {tmdbId:"74940", properties:{bornIn:"Monterrey, Nuevo Leon, Mexico", imdbId:"0004816", born:date('1968-12-21'), name:"Lumi Cavazos", bio:"From Wikipedia, the free encyclopedia\n\nLumi Cavazos (born December 21, 1968) is a Mexican actress who won the Best Actress awards at the Tokyo Film Festival, and Brazil’s Festival de Gramado for her portrayal of \"Tita\" in the 1993 adaptation of Laura Esquivel’s Mexican novel, Like Water for Chocolate.  The film grabbed the attention of US film critics and moviegoers, and facilitated her entry into the American film industry.  She subsequently relocated to Los Angeles...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qD7DyoqUUqoaFTMz8IJkfOYwf5M.jpg", url:"https://themoviedb.org/person/74940"}}, {tmdbId:"1068840", properties:{bornIn:"Tabasco, Mexico", imdbId:"0868207", born:date('1945-10-02'), name:"Regina Torné", url:"https://themoviedb.org/person/1068840"}}, {tmdbId:"148189", properties:{bornIn:"Ciudad de México, México", imdbId:"0555227", born:date('1962-02-03'), name:"Mario Iván Martínez", bio:"Mario Iván Martínez Morales is an actor, known for La habitación azul (2002), Como agua para chocolate (1992) and Cronos (1993). \n\nHe's the son of actress Margarita Isabel...", url:"https://themoviedb.org/person/148189"}}, {tmdbId:"287", properties:{bornIn:"Shawnee, Oklahoma, USA", imdbId:"0000093", born:date('1963-12-18'), name:"Brad Pitt", bio:"William Bradley Pitt (born December 18, 1963) is an American actor and film producer.  He has received multiple awards, including two Golden Globe Awards and an Academy Award for his acting, in addition to another Academy Award and a Primetime Emmy Award as producer under his production company, Plan B Entertainment. \n\nPitt first gained recognition as a cowboy hitchhiker in the road movie Thelma & Louise (1991)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cckcYc2v0yh1tc9QjRelptcOBko.jpg", url:"https://themoviedb.org/person/287"}}, {tmdbId:"77012", properties:{imdbId:"0009215", name:"Michele Abrams", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/akOY4jztDJnRz9ZpDQRYBuBVCmG.jpg", url:"https://themoviedb.org/person/77012"}}, {tmdbId:"17094", properties:{bornIn:"Ramallo, Buenos Aires, Argentina", imdbId:"0527002", born:date('1936-02-23'), name:"Federico Luppi", bio:"​From Wikipedia, the free encyclopedia\n\nFederico Luppi (born February 23, 1936 in Ramallo, Buenos Aires Province) is an Argentine film, TV, radio and theatre actor. \n\nDescription above from the Wikipedia Federico Luppi, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2017-10-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e6OwcF9QXDFnJ4Y0L6TTPy56KK2.jpg", url:"https://themoviedb.org/person/17094"}}, {tmdbId:"70364", properties:{bornIn:"Mexico City, Distrito Federal, Mexico", imdbId:"0410609", born:date('1943-07-25'), name:"Margarita Isabel", bio:"​From Wikipedia, the free encyclopedia\n\nMargarita Isabel is a Mexican film and television actress.  Born as Margarita Isabel Morales y González, she is a multiple Ariel Award-winning actress.  Five times nominated, she has won three Silver Ariel awards: in 1992, 1995 and 1996.  Her son, Mario Iván Martínez (b.  February 3, 1955, Mexico City), is a Mexican tenor and actor. \n\nDescription above from the Wikipedia Margarita Isabel, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2017-04-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cLMUJ7nwS4H54baj8iIaWsYhUXi.jpg", url:"https://themoviedb.org/person/70364"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"9029", properties:{bornIn:"Belfast, Northern Ireland, UK", imdbId:"0001653", born:date('1946-10-31'), name:"Stephen Rea", bio:"An Irish film and stage actor.  Rea has appeared in a number of high profile films, both Irish and international, such as V for Vendetta, Michael Collins, Interview with the Vampire and Breakfast on Pluto.  Rea was nominated for an Academy Award for his lead performance as Fergus in the 1992 film The Crying Game...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8Ej68YWZ8P2Wwf2a0UXibqq9Mu9.jpg", url:"https://themoviedb.org/person/9029"}}, {tmdbId:"42566", properties:{bornIn:"Northern Ireland", imdbId:"0001160", born:date('1958-08-01'), name:"Adrian Dunbar", bio:"From Wikipedia, the free encyclopedia. \n\nAdrian Dunbar (born 1 August 1958) is an actor from Northern Ireland, best known for his television and theatre work.  Dunbar co-wrote and starred in the 1991 film, Hear My Song, nominated for Best Original Screenplay at the BAFTA awards. \n\nDescription above from the Wikipedia article Adrian Dunbar, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AwiptVRftEIwXSM8C4izNVQtQL7.jpg", url:"https://themoviedb.org/person/42566"}}, {tmdbId:"20005", properties:{bornIn:"Queens, New York City, New York, USA", imdbId:"0446702", born:date('1968-03-06'), name:"Moira Kelly", bio:"Moira Kelly is an American actress.  She is best known for her roles as Kate Moseley in The Cutting Edge, Oona O'Neill in Chaplin, Mandy Hampton on The West Wing, Karen Roe on One Tree Hill, and providing the voice for Adult Nala in The Lion King and The Lion King II: Simba's Pride...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3yQRnGSfbPWQDInZHTzzXsrAhUR.jpg", url:"https://themoviedb.org/person/20005"}}, {tmdbId:"65019", properties:{bornIn:"Memphis, Tennessee, USA", imdbId:"0809031", born:date('1936-04-29'), name:"Lane Smith", died:date('2005-06-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d8eqhoGalfvV33s3vdxI0Tps4Dp.jpg", url:"https://themoviedb.org/person/65019"}}, {tmdbId:"33613", properties:{bornIn:"Waterbury - Connecticut - USA", imdbId:"0005336", born:date('1956-12-30'), name:"Sheryl Lee Ralph", bio:"From Wikipedia, the free encyclopedia. \n\nSheryl Lee Ralph (born December 30, 1956) is an American actress and singer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eq7FeNDJFUVtdHAtvzNkOIapzX.jpg", url:"https://themoviedb.org/person/33613"}}, {tmdbId:"5469", properties:{bornIn:"Ipswich, Suffolk, England, UK", imdbId:"0000146", born:date('1962-12-22'), name:"Ralph Fiennes", bio:"An English actor, director and producer.  A noted Shakespeare interpreter, he first achieved success onstage at the Royal National Theatre.  Fiennes' portrayal of Nazi war criminal Amon Göth in Schindler's List (1993) earned him nominations for the Academy Award for Best Supporting Actor and the Golden Globe Award for Best Supporting Actor, and he won the BAFTA Award for Best Actor in a Supporting Role...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i8CQIAEAjkieDIA88b4gh122h8s.jpg", url:"https://themoviedb.org/person/5469"}}, {tmdbId:"47627", properties:{bornIn:"Newcastle, Tyne and Wear, England", imdbId:"0005216", born:date('1961-05-08'), name:"Janet McTeer", bio:"From Wikipedia, the free encyclopedia. \n\nJanet McTeer, OBE (born 5 August 1961) is a British actress. \n\nDescription above from the Wikipedia article Janet McTeer, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kiLmLRkxTW52YrZuBRhrYR8EYZ4.jpg", url:"https://themoviedb.org/person/47627"}}, {tmdbId:"18269", properties:{bornIn:"Indianapolis, Indiana, USA", imdbId:"0000409", born:date('1968-12-03'), name:"Brendan Fraser", bio:"The son of a Canadian travel executive who frequently moved his family, Brendan can claim affinity with Ottawa, Indianapolis, Detroit, Seattle, London and Rome.  His early exposure to theatre, particularly in London, led him to Seattle's Cornish Institute.  After graduation he found a minor role as Sailor #1 in River Phoenix's Dogfight (1991), then somewhat more substantial roles in Encino Man (1992) and School Ties (1992).  He expresses a preference for playing \"fish out of water\" men...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n8VOWXp94nhIEo5nS9o6bOpUHiN.jpg", url:"https://themoviedb.org/person/18269"}}, {tmdbId:"13638", properties:{bornIn:"Charleston, South Carolina, USA", imdbId:"0004959", born:date('1962-07-03'), name:"Thomas Gibson", bio:"Thomas Ellis Gibson (born July 3, 1962) is an American actor and director.  He portrayed Daniel Nyland in the CBS series Chicago Hope, Greg Montgomery on the ABC series Dharma & Greg, and Aaron Hotchner on the CBS series Criminal Minds (2005–2016)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jdMeJ1GjVDETKUDYOC56eBz0NlO.jpg", url:"https://themoviedb.org/person/13638"}}, {tmdbId:"20767", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0000526", born:date('1970-05-12'), name:"Samantha Mathis", bio:"Samantha Mathis is an American film and television actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8lcxFGgEdvDcaNYGsmRSB6oEUQG.jpg", url:"https://themoviedb.org/person/20767"}}, {tmdbId:"109", properties:{bornIn:"Cedar Rapids, Iowa, USA", imdbId:"0000704", born:date('1981-01-28'), name:"Elijah Wood", bio:"Elijah Jordan Wood (born January 28, 1981) is an American actor.  He made his film debut with a minor part in Back to the Future Part II (1989), then landed a succession of larger roles that made him a critically acclaimed child actor by age 9.  He is best known for his high-profile role as Frodo Baggins in Peter Jackson's critically acclaimed The Lord of the Rings trilogy...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7UKRbJBNG7mxBl2QQc5XsAh6F8B.jpg", url:"https://themoviedb.org/person/109"}}, {tmdbId:"64826", properties:{imdbId:"0322050", born:date('1958-05-01'), name:"Isabel Glasser", bio:"From Wikipedia, the free encyclopedia\n\nIsabel Glasser (born May 1, 1958) is an American actress who has starred in the movies Forever Young, Pure Country and the Law &amp; Order franchise. \n\nDescription above from the Wikipedia article Juan de Isabel Glasser, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/64826"}}, {tmdbId:"6717", properties:{bornIn:"Queens, New York City, New York, USA", imdbId:"0550929", born:date('1967-01-02'), name:"James Marshall", bio:"​From Wikipedia, the free encyclopedia. \n\nJames Marshall (height 5' 10\" (1,78 m)) is an American actor, best known for playing the character James Hurley in the cult television series Twin Peaks (1990–1991) and its 1992 prequel film Twin Peaks: Fire Walk with Me, and for his role as PFC Louden Downey in A Few Good Men.  Marshall was born James David Greenblatt on January 2, 1967, in Queens, New York.  His father was a Radio City Music Hall publicist, and his mother danced with the Rockettes...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ieK50VhhwNXx0rgOidaEG3JqrDT.jpg", url:"https://themoviedb.org/person/6717"}}, {tmdbId:"1376089", properties:{imdbId:"0507963", name:"Richard Lexsee", url:"https://themoviedb.org/person/1376089"}}, {tmdbId:"521717", properties:{bornIn:"Chicago, Illinois, USA ", imdbId:"0751470", name:"T.E. Russell", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dOJb6luGZK3AQJxFXLXcWo97Evy.jpg", url:"https://themoviedb.org/person/521717"}}, {tmdbId:"9777", properties:{bornIn:"Bronx, New York, USA", imdbId:"0000421", born:date('1968-01-02'), name:"Cuba Gooding Jr.", bio:"Cuba Gooding was born in Bronx, New York to Shirley, a singer with the Sweethearts, and Cuba Gooding, Sr. , a lead vocalist of soul group The Main Ingredient.  He has two brothers, musician Tommy Gooding and fellow actor Omar Gooding, and sister, April Gooding.  His family moved to Los Angeles after Gooding Sr. 's music group had a hit single with \"Everybody Plays the Fool\" in 1972 but abandoned his family two years later.  Gooding Jr...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bxL1lZyMKcexcAKNhkU4Gy73wLb.jpg", url:"https://themoviedb.org/person/9777"}}, {tmdbId:"7317", properties:{bornIn:"Twickenham, England, UK", imdbId:"0758608", born:date('1921-02-21'), name:"Peter Sallis", bio:"From Wikipedia, the free encyclopedia\n\nPeter Sallis, OBE (born 1 February 1921, died 2 June 2017) was an English actor and entertainer, well-known for his work on British television.  Although he was born and brought up in London, his two most notable roles required him to adopt the accents and mannerisms of a Northerner. \n\nSallis was best known for his role as the main character Norman Clegg in the long-running British TV comedy Last of the Summer Wine, set in a Yorkshire town...", died:date('2017-06-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yaqyKiizBKTEDhpKeQ4QNDNaK3d.jpg", url:"https://themoviedb.org/person/7317"}}, {tmdbId:"53574", properties:{imdbId:"0856908", born:date('1965-08-10'), name:"Eric Thal", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mohh0ONnWuGQPRm4VxQ7JpN2WZD.jpg", url:"https://themoviedb.org/person/53574"}}, {tmdbId:"1231", properties:{bornIn:"Fayetteville, North Carolina, USA", imdbId:"0000194", born:date('1960-12-03'), name:"Julianne Moore", bio:"Julianne Moore (born Julie Anne Smith; December 3, 1960) is an American actress and author.  Prolific in film since the early 1990s, she is particularly known for her portrayals of emotionally troubled women in both independent and blockbuster films, and has received many accolades, including an Academy Award, a British Academy Film Award and two Golden Globes.  Time magazine named Moore one of the 100 most influential people in the world in 2015...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7G0Y2igys4ZIqz0WeR6wvAneKtn.jpg", url:"https://themoviedb.org/person/1231"}}, {tmdbId:"42206", properties:{bornIn:"Washington, District of Columbia, USA", imdbId:"0566783", born:date('1958-05-20'), name:"Matt McCoy", bio:"​From Wikipedia, the free encyclopedia. \n\nMatt McCoy (born May 20, 1958) is an American actor. \n\nMcCoy was born in Washington, D. C. .  Since starring as Sgt.  Nick Lassard in two Police Academy films, his motion picture credits have included the Curtis Hanson films The Hand That Rocks the Cradle (1992) and L. A.  Confidential (1997), as well as the action comedy National Security (2003) alongside Martin Lawrence and Steve Zahn...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4VkRnRc7h4JatbBKZMEQV7n4w0R.jpg", url:"https://themoviedb.org/person/42206"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"68758", properties:{imdbId:"0076791", born:date('1961-04-02'), name:"Kevin Bernhardt", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fmC5anKgpreSaou4M3TA0vYasf9.jpg", url:"https://themoviedb.org/person/68758"}}, {tmdbId:"63065", properties:{imdbId:"0608118", name:"Lawrence Mortorff", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uTvzRyNxRdGWDmbtW2BxJKs3Nie.jpg", url:"https://themoviedb.org/person/63065"}}, {tmdbId:"68759", properties:{bornIn:"Cedar Rapids - Iowa - USA", imdbId:"0000395", born:date('1963-11-19'), name:"Terry Farrell", bio:"From Wikipedia, the free encyclopedia\n\nTheresa Lee \"Terry\" Farrell (born November 19, 1963, height 5' 11¾\" (1,82 m)) is an American former actress and fashion model.  She is perhaps best known for her performances in the television series Star Trek: Deep Space Nine as Jadzia Dax and Becker as Regina Kostas. \n\nFarrell is the daughter of Kay Carol Christine (Bendickson) and Edwin Francis Farrell, Jr.  Later, her mother married David W.  Grussendorf, who adopted Terry and her sister, Christine...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yQtKmCN8u3FpioGcytjgTZyVz0a.jpg", url:"https://themoviedb.org/person/68759"}}, {tmdbId:"70783", properties:{imdbId:"0139393", name:"Ken Carpenter", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kCRRAyWOgAo2Me5oBJRLUD0E23w.jpg", url:"https://themoviedb.org/person/70783"}}, {tmdbId:"11514", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"0001573", born:date('1954-03-04'), name:"Catherine O'Hara", bio:"Catherine Anne O'Hara (born March 4, 1954) is a Canadian-American actress and comedienne.  She is well known for her comedy work on SCTV, and her roles in the films After Hours, Beetlejuice, Home Alone, and The Nightmare Before Christmas, and also in the mockumentary films written and directed by Christopher Guest including Waiting for Guffman, Best in Show, A Mighty Wind, and For Your Consideration...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cMBxHeztNVc8YXKcj084Mdd3f3U.jpg", url:"https://themoviedb.org/person/11514"}}, {tmdbId:"1908", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0647084", born:date('1978-04-28'), name:"Robert Oliveri", bio:"Robert Oliveri was born on April 28, 1978 in Los Angeles, California, USA as Robert Dane Oliveri.  He is an actor, known for Honey, I Shrunk the Kids (1989), Edward Scissorhands (1990) and Honey, I Blew Up the Kid (1992)...", url:"https://themoviedb.org/person/1908"}}, {tmdbId:"68379", properties:{imdbId:"0787741", name:"Daniel Shalikar", url:"https://themoviedb.org/person/68379"}}, {tmdbId:"54444", properties:{imdbId:"0071851", name:"Joseph Bennett", url:"https://themoviedb.org/person/54444"}}, {tmdbId:"7056", properties:{bornIn:"Paddington, London, England", imdbId:"0000668", born:date('1959-04-15'), name:"Emma Thompson", bio:"Emma Thompson (born 15 April 1959) is a British actress, comedian and screenwriter.  Her first major film role was in the 1989 romantic comedy The Tall Guy.  In 1992, Thompson won multiple acting awards, including an Academy Award and a BAFTA Award for Best Actress, for her performance in the British drama Howards End.  The following year Thompson garnered dual Academy Award nominations, as Best Actress for The Remains of the Day and as Best Supporting Actress for In the Name of the Father...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/odPswHsSsed56uHeVWmABKKlXlX.jpg", url:"https://themoviedb.org/person/7056"}}, {tmdbId:"1379843", properties:{imdbId:"2016787", name:"Norman Zigrossi", url:"https://themoviedb.org/person/1379843"}}, {tmdbId:"1379844", properties:{imdbId:"2008646", name:"Robert Sikma", url:"https://themoviedb.org/person/1379844"}}, {tmdbId:"1379846", properties:{imdbId:"1941655", name:"Bob Robideau", url:"https://themoviedb.org/person/1379846"}}, {tmdbId:"19115", properties:{bornIn:"Saigon, Vietnam", imdbId:"0199006", born:date('1974-01-01'), name:"Linh Dan Pham", bio:"Pham was born in 1974 in Saigon, but moved to France with her parents a year later. \n\nHer big break came in 1992 when she starred in the Oscar-winning film \"Indochine,\" playing the adopted child of a French woman in French-ruled Vietnam. \n\nPham studied commerce in university and worked as a senior marketing manager after graduation.  She has worked in New York, Singapore and Vietnam and now resides in London. \n\nShe has also taken an acting course at the Lee Strasberg Institute in New York...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a4NL2yLCx2w5KTitGJ9IA6dE2G5.jpg", url:"https://themoviedb.org/person/19115"}}, {tmdbId:"24381", properties:{bornIn:"Les Lilas, Seine, France", imdbId:"0946179", born:date('1933-07-18'), name:"Jean Yanne", bio:"Jean Yanne (born Jean Roger Gouyé; 18 July 1933 – 23 May 2003) was a French actor, screenwriter, producer, director and composer. \n\nDuring his career, he won a Cannes Film Festival Award for his leading role in We Won't Grow Old Together (1972) and received a César Award nomination for his supporting role in Indochine (1992)...", died:date('2003-05-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nZAsOM0mtE0oHHj9DlbH94SxtAI.jpg", url:"https://themoviedb.org/person/24381"}}, {tmdbId:"27391", properties:{bornIn:"Roma, Lazio, Italy", imdbId:"0302105", born:date('1954-12-22'), name:"Anna Galiena", bio:"Anna Galiena (born 22 December 1954) is an Italian actress, best known to English-speaking audiences for her appearances in Le Mari de la coiffeuse, Jamón, jamón and Being Human.  her youth, Galiena starred in numerous off and on-Broadway shows, including several revivals of Shakespeare plays.  She had made over a dozen films, mainly in her native Italy before her role in Le Mari de la coiffeuse brought her to international attention...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3Xo541WhSCdKZWui1ssxCkTxNbP.jpg", url:"https://themoviedb.org/person/27391"}}, {tmdbId:"37580", properties:{bornIn:"Sevilla, Spain", imdbId:"0225921", born:date('1942-12-14'), name:"Juan Diego", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/GYF8sjCA6jaCO9RTn2QbiBjqgP.jpg", url:"https://themoviedb.org/person/37580"}}, {tmdbId:"10885", properties:{bornIn:"Hong Kong, China", imdbId:"0874684", born:date('1934-09-02'), name:"Kenneth Tsang", bio:"Kenneth Tsang Kong (born 1938) is a Hong Kong actor.  Tsang's career has spanned 50 years and included a variety of acting roles. \n\nTsang was born in Hong Kong with family roots in Zhongshan, Guangdong.  He attended high school in Texas, U. S.  and received a degree in architecture from the University of California, Berkeley.  He returned to Hong Kong in the early 1960s but was bored by the work...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sBktfdIY1xbWGccoP6Mt82ioaYG.jpg", url:"https://themoviedb.org/person/10885"}}, {tmdbId:"70046", properties:{imdbId:"0605797", name:"Shûichirô Moriyama", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8p1YNl2vaBoWGXE1R6DWfZ1eNo0.jpg", url:"https://themoviedb.org/person/70046"}}, {tmdbId:"70047", properties:{imdbId:"0441401", name:"Tokiko Katô", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/95wR4onf6VEF5KUiYkG4zBpja6X.jpg", url:"https://themoviedb.org/person/70047"}}, {tmdbId:"20334", properties:{bornIn:"Nagano, Nagano Prefecture, Japan", imdbId:"0436639", born:date('1940-03-07'), name:"Tsunehiko Kamijô", bio:"Tsunehiko Kamijō (上條 恒彦 Kamijō Tsunehiko?, born March 7, 1940 in Nagano) is a Japanese singer, actor and voice actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v2poQi0qYEWdTaMf2pVTWmcdwZp.jpg", url:"https://themoviedb.org/person/20334"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"70590", properties:{bornIn:"Hong Kong, British Crown Colony [now China]", imdbId:"0594909", born:date('1959-11-05'), name:"Teresa Mo", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7fAzzOMmRrFkGxEboCtP2MM6dp3.jpg", url:"https://themoviedb.org/person/70590"}}, {tmdbId:"3203", properties:{bornIn:"Pine Ridge, South Dakota, USA", imdbId:"0575184", born:date('1939-11-10'), name:"Russell Means", bio:"​From Wikipedia, the free encyclopedia\n\nRussell Charles Means (born November 10, 1939) is an Oglala Sioux activist for the rights of Native American people.  He is a prominent member of the American Indian Movement (AIM) having joined the organisation in 1968.  Means has also pursued careers in politics, acting, and music. \n\nDescription the Wikipedia article Russell Means, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2012-10-22'), url:"https://themoviedb.org/person/3203"}}, {tmdbId:"57448", properties:{bornIn:"Inuvik, Northwest Territories, Canada", imdbId:"0777760", born:date('1967-06-19'), name:"Eric Schweig", bio:"​From Wikipedia, the free encyclopedia\n\nEric Schweig (born Ray Dean Thrasher on 19 June 1967  ) is a Canadian actor best known for his role as Chingachgook's son Uncas in The Last of the Mohicans (1992). \n\nDescription the Wikipedia article Eric Schweig, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/u2J5KUwenwVxRqMTLRvAYqZqwmf.jpg", url:"https://themoviedb.org/person/57448"}}, {tmdbId:"15443", properties:{bornIn:"Armour, South Dakota, USA", imdbId:"0109517", born:date('1957-10-24'), name:"Mark Bringelson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gOQjWsp3PzZeBFZtKU5JTx8tor9.jpg", url:"https://themoviedb.org/person/15443"}}, {tmdbId:"52699", properties:{imdbId:"0542706", born:date('1951-07-28'), name:"Danny Mann", bio:"From Wikipedia, the free encyclopedia.   Daniel \"Danny\" Mann is an American voice actor, writer, singer, musician, and production manager.  He is best known for his voice of Hector from Heathcliff and the Catillac Cats, Freeway, Cloudraker and Lightspeed in Transformers, Backwoods Beagle in DuckTales, Kaltag in Balto, Ferdinand from Babe, and Serge in Open Season, Open Season 2, and as Serge and Kevin the porcupine Open Season 3...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/980QYqXIZCMn5Knx0vjROkw9vKo.jpg", url:"https://themoviedb.org/person/52699"}}, {tmdbId:"42335", properties:{bornIn:"Santa Barbara, California, U.S.", imdbId:"0001849", born:date('1964-06-29'), name:"Kathleen Wilhoite", bio:"Kathleen Wilhoite is an American stage and screen actress, and a singer/songwriter.  She enrolled in the USC Drama School, and two months later she had landed her first movie role.  As her acting career began to blossom, so did her enthusiasm as a songwriter...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z3xPuuH2O0HNBofGBmtoKu4GvXC.jpg", url:"https://themoviedb.org/person/42335"}}, {tmdbId:"352", properties:{bornIn:"San Mateo, California, USA", imdbId:"0371660", born:date('1954-06-02'), name:"Dennis Haysbert", bio:"Dennis Dexter Haysbert (born June 2, 1954) is an American film and television actor.  He is known for portraying baseball player Pedro Cerrano in the Major League film trilogy, President David Palmer on the American television series 24, and Sergeant Major Jonas Blane on the drama series The Unit, as well as his work in commercials for Allstate Insurance.  He is also known for his authoritative, bass voice...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lcnjaw2CFN6q9eaes1jTYrUB0rb.jpg", url:"https://themoviedb.org/person/352"}}, {tmdbId:"1576657", properties:{name:"Stephanie McFadden", url:"https://themoviedb.org/person/1576657"}}, {tmdbId:"5470", properties:{bornIn:"Redruth, Cornwall, England, UK", imdbId:"0000218", born:date('1960-05-24'), name:"Kristin Scott Thomas", bio:"Kristin A.  Scott Thomas, OBE is an English actress who has also acquired French nationality.  She gained international recognition in the 1990s for her roles in Bitter Moon, Four Weddings and a Funeral and The English Patient. \n\nSince the 1980s, she has also worked in French cinema in films such as the thriller Tell No One and Philippe Claudel's I've Loved You So Long...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kFy1U9bTI2yIA0LyrgsqU5isFl0.jpg", url:"https://themoviedb.org/person/5470"}}, {tmdbId:"8354", properties:{bornIn:"Brighton, Alabama, U.S.", imdbId:"0355278", born:date('1937-11-10'), name:"Albert Hall", bio:"From Wikipedia, the free encyclopedia. \n\nAlbert P.  Hall (born November 10, 1937) is an American actor. \n\nBorn in Brighton, Alabama, Hall graduated from the Columbia University School of the Arts in 1971.  That same year he appeared Off-Broadway in The Basic Training of Pavlo Hummel and on Broadway in the Melvin Van Peebles musical Ain't Supposed to Die a Natural Death.  His most famous film role to date is probably that of Chief Phillips in Francis Ford Coppola's award-winning Apocalypse Now...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jvcOpEO0vSNy3KaDkhIldI1CoaU.jpg", url:"https://themoviedb.org/person/8354"}}, {tmdbId:"19739", properties:{bornIn:"San Antonio, Texas,  United States", imdbId:"0293272", born:date('1934-03-21'), name:"Al Freeman Jr.", bio:"From Wikipedia, the free encyclopedia. \n\nAl Freeman, Jr. , M. Ed.  (born Albert Cornelius Freeman, Jr.  on March 21, 1934, in San Antonio, Texas) is an African-American actor and director. \n\nFreeman has made appearances in many films, such as My Sweet Charlie, Finian's Rainbow, and Malcolm X, and television series such as The Cosby Show, Law &amp; Order, Homicide: Life on the Street and The Edge of Night...", died:date('2012-09-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qLnfxKvvbjDRtFHDgGS1U9KC9SO.jpg", url:"https://themoviedb.org/person/19739"}}, {tmdbId:"1033096", properties:{imdbId:"0130668", name:"Pablo Calogero", url:"https://themoviedb.org/person/1033096"}}, {tmdbId:"83721", properties:{bornIn:"New York City, New York, USA", imdbId:"0169753", born:date('1961-12-19'), name:"Scott Cohen", bio:"Scott Cohen (born December 19, 1961) is an American actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7gSfZoWhwsTvCCvFXOfUFZwNXMo.jpg", url:"https://themoviedb.org/person/83721"}}, {tmdbId:"1033097", properties:{imdbId:"0342044", name:"Mario Grillo", url:"https://themoviedb.org/person/1033097"}}, {tmdbId:"1033098", properties:{imdbId:"0410028", name:"Ralph Irizarry", url:"https://themoviedb.org/person/1033098"}}, {tmdbId:"214705", properties:{bornIn:"New York City - New York - USA", born:date('1925-11-24'), name:"William F. Buckley", bio:"William F.  Buckley was born on November 24, 1925 in New York City, New York, USA as William Frank Buckley Jr.  He was married to Patricia Aldyen Austin Taylor.  He died on February 27, 2008 in Stamford, Connecticut, USA...", died:date('2008-02-27'), url:"https://themoviedb.org/person/214705"}}, {tmdbId:"20498", properties:{imdbId:"0002230", name:"Carlos Gallardo", bio:"From Wikipedia, the free encyclopedia\n\nCarlos Gallardo is a Mexican actor, producer and occasional screenwriter and director, and frequent collaborator with his friend, director Robert Rodriguez. \n\nDescription above from the Wikipedia article Carlos Gallardo, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1ZaDFJtyjAQUMDah86qJtEEjW7A.jpg", url:"https://themoviedb.org/person/20498"}}, {tmdbId:"57469", properties:{imdbId:"0351042", name:"Consuelo Gómez", url:"https://themoviedb.org/person/57469"}}, {tmdbId:"57470", properties:{imdbId:"0398426", name:"Jaime de Hoyos", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kn9w7ky5XgEc5cqBg4TODYXcdUO.jpg", url:"https://themoviedb.org/person/57470"}}, {tmdbId:"57471", properties:{imdbId:"0549682", name:"Peter Marquardt", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hUFTLzot9V0S0B7MJRHmgonTeug.jpg", url:"https://themoviedb.org/person/57471"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"170231", properties:{imdbId:"0160541", name:"Bojesse Christopher", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z6OQYBH4nl6JSabTX21tkg6gyZ8.jpg", url:"https://themoviedb.org/person/170231"}}, {tmdbId:"56962", properties:{imdbId:"0206889", name:"Rodolfo De Alexandre", url:"https://themoviedb.org/person/56962"}}, {tmdbId:"65038", properties:{imdbId:"0459706", name:"Heidi Kling", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7nRVPGjXRR2SjQPGzHagXIxcuuV.jpg", url:"https://themoviedb.org/person/65038"}}, {tmdbId:"975731", properties:{bornIn:"Mill Valley, California, USA", imdbId:"0584150", born:date('1979-03-24'), name:"Jordan Christopher Michael", url:"https://themoviedb.org/person/975731"}}, {tmdbId:"140236", properties:{imdbId:"0703925", born:date('1959-05-11'), name:"Martha Quinn", bio:"Best known as one of the original MTV VJs...", url:"https://themoviedb.org/person/140236"}}, {tmdbId:"1080640", properties:{imdbId:"0618998", name:"Michael Naegel", url:"https://themoviedb.org/person/1080640"}}, {tmdbId:"19839", properties:{bornIn:"Oceanside, Long Island, New York, USA", imdbId:"0001601", born:date('1954-08-30'), name:"David Paymer", bio:"David Paymer is an American actor and director for film and television, nominated for an Academy Award for \"Best Supporting Actor\" in 1992 for \"Mr.  Saturday Night\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/owoOdDFgXpls1OFKwmQ104Nkl5.jpg", url:"https://themoviedb.org/person/19839"}}, {tmdbId:"3141", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0000673", born:date('1964-12-04'), name:"Marisa Tomei", bio:"Marisa Tomei was born on December 4, 1964, in Brooklyn, New York, to mother Patricia \"Addie\" Tomei, an English teacher and father Gary Tomei, a lawyer.  Marisa also has a brother, actor Adam Tomei.  As a child, Marisa's mother frequently corrected her speech as to eliminate her heavy Brooklyn accent.  As a teen, Marisa attended Edward R.  Murrow High School and graduated in the class of 1982...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nrRXQkCWVXQVIHhYMhEjOWehJCH.jpg", url:"https://themoviedb.org/person/3141"}}, {tmdbId:"19505", properties:{bornIn:"Brooklyn, New York", imdbId:"0925943", born:date('1964-09-08'), name:"Mitchell Whitfield", bio:"From Wikipedia, the free encyclopedia. \n\nMitchell Whitfield (born on September 8, 1964, in Brooklyn, New York) is an American actor. \n\nHe guest-starred in several episodes of Friends as Dr.  Barry Farber, Rachel's orthodontist ex-fiancé whom Rachel left at the altar on their wedding day.  He also appeared in Dharma &amp; Greg; Murder, She Wrote; Diagnosis Murder and CSI: Crime Scene Investigation.  In the 1992 film My Cousin Vinny, Whitfield starred as Stan Rothenstein, opposite Ralph Macchio...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aCyQGfiRfoCNlSXQ8D2mD5f8zFn.jpg", url:"https://themoviedb.org/person/19505"}}, {tmdbId:"62123", properties:{bornIn:"New York City - New York - USA", imdbId:"0608378", born:date('1974-11-14'), name:"David Moscow", bio:"David Raphael Moscow (born November 14, 1974) is an American actor.  His first major role was as the young Josh Baskin in the 1988 film Big, in which his character was magically transformed into an adult played by Tom Hanks. \n\nDescription above from the Wikipedia article David Moscow, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/b0tUWBy7Ia2JcaLtepeZvYUkUZm.jpg", url:"https://themoviedb.org/person/62123"}}, {tmdbId:"33052", properties:{bornIn:"Nevada City, California, USA", imdbId:"0250180", born:date('1980-03-24'), name:"Luke Edwards", bio:"​From Wikipedia, the free encyclopedia. \n\nLucas Daniel \"Luke\" Edwards (born March 24, 1980) is an American actor.  He began taking acting lessons for fun on his mother's suggestion and landed his first television role in 1988 on an ABC Afterschool Special episode.  He had roles in the films 'The Wizard, Guilty By Suspicion, Newsies, Mother's Boys, Little Big League, American Pie 2, Jeepers Creepers 2, Debating Robert Lee, Graphic, Turn Me On, Dead Man, and Disarmed...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cZcUHl6jojQJiviybrDV5iX8K9Z.jpg", url:"https://themoviedb.org/person/33052"}}, {tmdbId:"7133", properties:{bornIn:"Washington, District of Columbia, USA", imdbId:"0143295", born:date('1967-06-06'), name:"Max Casella", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5CNTDSCBhWPclTLTyTBy8oHUkzb.jpg", url:"https://themoviedb.org/person/7133"}}, {tmdbId:"28896", properties:{bornIn:"Soest, Utrecht, Netherlands", imdbId:"0941914", born:date('1957-06-17'), name:"Jack Wouterse", bio:"Jack Wouterse is a Dutch actor.  He starred in movies, on television and in theatre plays.  He is also voice actor in films such as Monsters &amp; Co and Ice Age...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qQenSg4QLPdsLviQuBdTYuO0DWu.jpg", url:"https://themoviedb.org/person/28896"}}, {tmdbId:"46450", properties:{imdbId:"0524632", born:date('1942-11-10'), name:"Rudolf Lucieer", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uHISa84292m7zU4ZIOCldexAnRd.jpg", url:"https://themoviedb.org/person/46450"}}, {tmdbId:"46451", properties:{imdbId:"0941916", name:"Loes Wouterson", url:"https://themoviedb.org/person/46451"}}, {tmdbId:"40938", properties:{bornIn:"Pont-Sainte-Maxence, Oise, France", imdbId:"0001960", born:date('1973-08-14'), name:"Romane Bohringer", bio:"From Wikipedia, the free encyclopedia\n\nRomane Bohringer (born 14 August 1973 in Pont-Sainte-Maxence, Oise, France) is a French actress, film director, screenwriter and costume designer.  She is the daughter of Richard Bohringer and sister of Lou Bohringer.  Her parents named her after Roman Polanski. \n\nShe won the César Award for Most Promising Actress for her role in Savage Nights...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/keVDM0uUbKmo0yOVNrjMuKiH1B2.jpg", url:"https://themoviedb.org/person/40938"}}, {tmdbId:"256268", properties:{imdbId:"0530034", name:"Carlos López", url:"https://themoviedb.org/person/256268"}}, {tmdbId:"1162582", properties:{imdbId:"0089493", name:"Corine Blue", url:"https://themoviedb.org/person/1162582"}}, {tmdbId:"27422", properties:{bornIn:"London, England, UK", imdbId:"0668271", born:date('1958-11-22'), name:"Bruce Payne", bio:"​From Wikipedia, the free encyclopedia.   \n\nBruce Martyn Payne (born 22 November 1958) is an English actor and producer.  Though better known for his villainous roles, Bruce Payne has played characters across the spectrum.  His notable villainous roles include Charles Rane in Passenger 57, Jacob Kell in Highlander: Endgame and Damodar in Dungeons &amp; Dragons and Dungeons &amp; Dragons: Wrath of the Dragon God.  His notable heroic roles include Frankie in Kounterfeit, Dr...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2KZ1q44Ztp87qjC9BhPzCK7Yewm.jpg", url:"https://themoviedb.org/person/27422"}}, {tmdbId:"3197", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"0001744", born:date('1961-11-29'), name:"Tom Sizemore", bio:"Tom Sizemore (born November 29, 1961) is an American film and television actor and producer.  He is known for his roles in films such as Saving Private Ryan, Pearl Harbor, Heat and Black Hawk Down and supporting roles in well known films such as The Relic, True Romance, Natural Born Killers, Wyatt Earp and Devil in a Blue Dress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/soINOuacuiThRb2LyPD4tTWve7C.jpg", url:"https://themoviedb.org/person/3197"}}] AS row
