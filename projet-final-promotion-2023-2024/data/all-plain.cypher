UNWIND [{tmdbId:"552480", properties:{name:"Zhaoji Jia", url:"https://themoviedb.org/person/552480"}}, {tmdbId:"552618", properties:{imdbId:"1267469", name:"Zhigang Zhao", url:"https://themoviedb.org/person/552618"}}, {tmdbId:"552619", properties:{imdbId:"0955773", name:"Renying Zhou", url:"https://themoviedb.org/person/552619"}}, {tmdbId:"47775", properties:{bornIn:"New York City, New York, USA", imdbId:"0004711", born:date('1968-09-16'), name:"Marc Anthony", bio:"From Wikipedia, the free encyclopedia. \n\nMarc Anthony (born Marco Antonio Muñiz; September 16, 1968) is an American singer, songwriter, actor, record producer and television producer.   Anthony is the top selling tropical salsa artist of all time.  The two-time Grammy and five-time Latin Grammy-winner has sold more than 12 million albums worldwide.  He is best known for his Latin salsa numbers and ballads...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mOkqbV5iiusOLEOVPmepQcAGF8K.jpg", url:"https://themoviedb.org/person/47775"}}, {tmdbId:"4252", properties:{bornIn:"Green Bay, Wisconsin, USA", imdbId:"0001724", born:date('1953-10-09'), name:"Tony Shalhoub", bio:"Tony Shalhoub is an American actor. \n\nHis television work includes the role of Antonio Scarpacci on Wings and Adrian Monk on Monk.  He has won three Emmy Awards and a Golden Globe for his work on Monk.  He also has a successful career as a character actor, with roles in Spy Kids, Men in Black, Men in Black II, Galaxy Quest, 1408, Barton Fink, Big Night, The Siege, The Man Who Wasn't There...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1LOfr36H1OFP5nsCD1ZQKu5QpXo.jpg", url:"https://themoviedb.org/person/4252"}}, {tmdbId:"77254", properties:{imdbId:"0088745", born:date('1942-10-30'), name:"Larry Block", url:"https://themoviedb.org/person/77254"}}, {tmdbId:"23970", properties:{bornIn:"Honolulu - Hawaii - USA", imdbId:"0236225", born:date('1958-02-21'), name:"Denise Dowse", bio:"Denise Dowse is an actress and director...", url:"https://themoviedb.org/person/23970"}}, {tmdbId:"57868", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"0866381", name:"Dara Tomanovich", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jBzR1mGrJN6uU5mk7nspawsclSo.jpg", url:"https://themoviedb.org/person/57868"}}, {tmdbId:"57869", properties:{bornIn:"Los Angeles, California, USA ", imdbId:"0922182", born:date('1965-03-04'), name:"Kevin West", url:"https://themoviedb.org/person/57869"}}, {tmdbId:"57831", properties:{bornIn:"Hong Kong, British Crown Colony [now China]", imdbId:"0596297", born:date('1970-06-02'), name:"Karen Mok", bio:"Karen Joy Morris, known more commonly in the Sinosphere as Karen Mok or Mok Man-Wai, (born 2 June 1970) is a two-time Golden Melody Award-winning Hong Kong-based actress and singer-songwriter. \n\nDescription above from the Wikipedia article Karen Mok Man-Wai, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8iLaXFGSbc54Oyn75ERt5BbPmkU.jpg", url:"https://themoviedb.org/person/57831"}}, {tmdbId:"2201903", properties:{name:"Russ Little", url:"https://themoviedb.org/person/2201903"}}, {tmdbId:"1300945", properties:{imdbId:"0579693", name:"Tinka Menkes", url:"https://themoviedb.org/person/1300945"}}, {tmdbId:"1089063", properties:{imdbId:"0641262", name:"Jack O'Hara", url:"https://themoviedb.org/person/1089063"}}, {tmdbId:"9640", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0005286", born:date('1988-04-10'), name:"Haley Joel Osment", bio:"Haley Joel Osment (born April 10, 1988) is an American actor.  After a series of roles in television and film during the 1990s, including a small part in Forrest Gump playing the title character’s son, Osment rose to fame with his performance as Cole Sear in M.  Night Shyamalan’s thriller film The Sixth Sense that earned him a nomination for Academy Award for Best Supporting Actor.  He subsequently appeared in leading roles in several high-profile Hollywood films including Steven Spielberg's A. I...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jft0dGgR5bJ6mR7QRYriMVBC6QH.jpg", url:"https://themoviedb.org/person/9640"}}, {tmdbId:"8263", properties:{bornIn:"Portland, Maine, USA", imdbId:"0551908", born:date('1947-01-15'), name:"Andrea Martin", bio:"Andrea Martin is an American stage and screen actress, writer and comedian...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/syS5bfwIeFAFzAWtn0dqPbfPadM.jpg", url:"https://themoviedb.org/person/8263"}}, {tmdbId:"36422", properties:{bornIn:"Dallas, Texas, USA", imdbId:"0005561", born:date('1971-09-21'), name:"Luke Wilson", bio:"Luke Cunningham Wilson (born September 21, 1971) is an American actor, director and writer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/GTx8OEQoj0GWVwSjxRCgWtzP6n.jpg", url:"https://themoviedb.org/person/36422"}}, {tmdbId:"887", properties:{bornIn:" Dallas, Texas, USA", imdbId:"0005562", born:date('1968-11-18'), name:"Owen Wilson", bio:"Owen Cunningham Wilson (born November 18, 1968) is an American actor and screenwriter from Dallas, Texas.  His older brother, Andrew and younger brother, Luke, are also actors.  He has had a long association with filmmaker Wes Anderson, having shared co-writing and acting credits for Bottle Rocket (1996) and The Royal Tenenbaums (2001), which was nominated for an Academy Award for Best Original Screenplay, and for his collaborations with fellow actor Ben Stiller...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ntN3DL1Us5G2PCvlfq112vLXRKa.jpg", url:"https://themoviedb.org/person/887"}}, {tmdbId:"42006", properties:{imdbId:"0235684", born:date('1950-05-26'), name:"Ned Dowd", url:"https://themoviedb.org/person/42006"}}, {tmdbId:"1117323", properties:{bornIn:"Texas, USA", imdbId:"0288800", born:date('1985-03-22'), name:"Shea Fowler", url:"https://themoviedb.org/person/1117323"}}, {tmdbId:"6807", properties:{bornIn:"Daly City, California, USA", imdbId:"0005377", born:date('1968-11-05'), name:"Sam Rockwell", bio:"Sam Rockwell was born on November 5, 1968, in San Mateo, California, the only child of two actors, Pete Rockwell and Penny Hess.  The family moved to New York when he was two years old, living first in the Bronx and later in Manhattan.  When Sam was five years old, his parents separated, at which point he and his father moved to San Francisco, where he subsequently grew up, while summers and other times were spent with his mother in New York...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4zjUldl3ykbgcLO7FxWppR6s7Ck.jpg", url:"https://themoviedb.org/person/6807"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"4935", properties:{bornIn:"Warrington, Cheshire, England, UK", imdbId:"0000592", born:date('1945-02-07'), name:"Pete Postlethwaite", bio:"An English stage, film and television actor.  After minor television appearances including in The Professionals, Postlethwaite's first success came with the film Distant Voices, Still Lives in 1988.  He played a mysterious lawyer, Mr.  Kobayashi, in The Usual Suspects, and he appeared in Alien 3, In the Name of the Father, Amistad, Brassed Off, The Shipping News, The Constant Gardener, The Age of Stupid, Inception, The Town, Romeo + Juliet, and Æon Flux...", died:date('2011-01-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2gpa75Ci4y2OKmOc8WXnaeGgyKF.jpg", url:"https://themoviedb.org/person/4935"}}, {tmdbId:"47629", properties:{imdbId:"0867017", born:date('1965-10-15'), name:"Stephen Tompkinson", url:"https://themoviedb.org/person/47629"}}, {tmdbId:"1639", properties:{bornIn:"Islington, London, England, UK", imdbId:"0001833", born:date('1967-01-14'), name:"Emily Watson", bio:"Emily Margaret Watson OBE is an English actress.  She was nominated for the Academy Award for Best Actress for her debut film role as Bess McNeil in Lars von Trier's Breaking the Waves and for her role as Jacqueline du Pré in Hilary and Jackie, winning the BIFA Award for Best Actress for the latter...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oJerQ7xq5uLTsxjqGWzsbYCjobh.jpg", url:"https://themoviedb.org/person/1639"}}, {tmdbId:"1640", properties:{bornIn:"Gothenburg, Västra Götalands län, Sweden", imdbId:"0001745", born:date('1951-06-13'), name:"Stellan Skarsgård", bio:"Stellan Skarsgård is a Swedish actor, known internationally for his film roles in Angels & Demons, Breaking the Waves, The Hunt for Red October, Ronin, Good Will Hunting, Pirates of the Caribbean: Dead Man's Chest, Pirates of the Caribbean: At World's End, Dominion: Prequel to the Exorcist, Mamma Mia! and Thor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x78BtYHElirO7Iw8bL4m8CnzRDc.jpg", url:"https://themoviedb.org/person/1640"}}, {tmdbId:"66813", properties:{imdbId:"0842422", born:date('1957-01-05'), name:"Jeep Swenson", died:date('1997-08-18'), url:"https://themoviedb.org/person/66813"}}, {tmdbId:"41087", properties:{bornIn:"San Francisco, California, USA", imdbId:"0005182", born:date('1972-03-26'), name:"Leslie Mann", bio:"Leslie Mann (born March 26, 1972), is an American actress best known for her roles in comedic films, many of which are collaborations with her husband, Judd Apatow. \n\nDescription above from the Wikipedia article Leslie Mann, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x3OS9RL3qsv50kzRtpR2OhbuTkr.jpg", url:"https://themoviedb.org/person/41087"}}, {tmdbId:"56984", properties:{bornIn:"Fort Worth, Texas, USA", imdbId:"0348186", born:date('1961-11-02'), name:"Janet Gunn", bio:"​From Wikipedia, the free encyclopedia. \n\nJanet Gunn  (nee Janet Lynn Fulkerson) is an American actress who was born on November 2, 1961, in Fort Worth, Texas...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ccuwCABWm9SPuKx9W081Ld7mPn2.jpg", url:"https://themoviedb.org/person/56984"}}, {tmdbId:"141747", properties:{bornIn:"Ohio, USA ", imdbId:"0669625", born:date('1947-03-20'), name:"Anthony Peck", bio:"Cast in four movies from director John McTiernan, including playing two different characters in the 1st and 3rd \"Die Hard\" film.   Had one son, Michael Pecchio.   According to director John McTiernan in his DVD commentary for 'Die Hard' when he met Anthony Peck the actor was working as a waiter in between roles...", died:date('1996-07-30'), url:"https://themoviedb.org/person/141747"}}, {tmdbId:"91612", properties:{bornIn:"Irlanda", imdbId:"0895083", born:date('1966-09-28'), name:"Arie Verveen", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ghYFpRtdYO7vY8FLTN9HAhrCxoO.jpg", url:"https://themoviedb.org/person/91612"}}, {tmdbId:"138240", properties:{bornIn:"New York, New York, U.S", imdbId:"0775087", born:date('1968-07-17'), name:"Bitty Schram", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tThxwNGRxcdOAMtR9tYqLd5Hdqb.jpg", url:"https://themoviedb.org/person/138240"}}, {tmdbId:"26009", properties:{bornIn:"Detroit, Michigan USA", imdbId:"0641097", born:date('1963-01-23'), name:"Gail O'Grady", bio:"Gail O'Grady (born January 23, 1963) is an American television actress.  She is best known for her roles on NYPD Blue and American Dreams...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ngPimQB84yeXC2A56pfzGt2Kjtq.jpg", url:"https://themoviedb.org/person/26009"}}, {tmdbId:"71776", properties:{imdbId:"0165401", born:date('1973-04-11'), name:"Garance Clavel", url:"https://themoviedb.org/person/71776"}}, {tmdbId:"5445", properties:{bornIn:"Thiers, Puy-de-Dôme, France", imdbId:"0815668", born:date('1957-04-17'), name:"Zinedine Soualem", bio:"Zinedine Soualem (born 17 April 1957) is a French actor.  He has appeared in at least five films directed by Cédric Klapisch.  Of Algerian origins, he was married to actress Hiam Abbass.  They have two daughters, Lina and Mouna...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/feyQoQ89GDPnnmbeiiVFHkJvQtH.jpg", url:"https://themoviedb.org/person/5445"}}, {tmdbId:"64550", properties:{bornIn:"Paris, France", imdbId:"0494161", born:date('1918-09-18'), name:"Renée Le Calm", died:date('2019-06-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wZ89G20jHqj5xFoqd2sPRXmYAQo.jpg", url:"https://themoviedb.org/person/64550"}}, {tmdbId:"71777", properties:{bornIn:"Grasse, France", imdbId:"0701396", born:date('1965-07-25'), name:"Olivier Py", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/27irRy4qzeiHvmNJ6IKECLghT8U.jpg", url:"https://themoviedb.org/person/71777"}}, {tmdbId:"3293", properties:{bornIn:"Westminster, London, England, UK", imdbId:"0001838", born:date('1970-03-07'), name:"Rachel Weisz", bio:"An English film and theatre actress and fashion model.  She started her acting career at Trinity Hall, Cambridge University, where she co-founded the theatrical group Cambridge Talking Tongues.  The group was awarded the Student Drama Award for the improvised piece Slight Possession during the Edinburgh Festival Fringe by The Guardian.  Weisz started working in television, appearing in Inspector Morse, the British miniseries The Scarlet and the Black, and the television movie Advocates II...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3QbFXeiUzXUVUrJ7fdiCn7A7ReW.jpg", url:"https://themoviedb.org/person/3293"}}, {tmdbId:"58727", properties:{bornIn:"New York City, New York, États-Unis", imdbId:"0808603", born:date('1987-04-10'), name:"Jamie Renée Smith", bio:"From Wikipedia, the free encyclopedia.  Jamie Renée Smith (born April 10, 1987) is an American actress. \n\nDescription above from the Wikipedia article Jamie Renée Smith, licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2m1ddsKk0gbmcsocLS8D9wRODIm.jpg", url:"https://themoviedb.org/person/58727"}}, {tmdbId:"102723", properties:{bornIn:" Dallas, Texas, USA", imdbId:"0758597", born:date('1982-08-17'), name:"Mark Salling", bio:"Mark Salling (17 August 1982 - 30 January 2018) was a American actor and musician.  He was known for his role as Noah \"Puck\" Puckerman on the television series Glee...", died:date('2018-01-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fLWPStpGrim60exek3sDLTzjHri.jpg", url:"https://themoviedb.org/person/102723"}}, {tmdbId:"12206", properties:{bornIn:"Albury, New South Wales, Australia", imdbId:"0746896", born:date('1962-01-01'), name:"Richard Roxburgh", bio:"Richard Roxburgh is an Australian AFI Award-winning actor who has starred in many Australian films and has appeared in supporting roles in a number of Hollywood productions, usually as villains...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/A76gaY7IYnMNv1lAxRKnn1HsyxH.jpg", url:"https://themoviedb.org/person/12206"}}, {tmdbId:"150536", properties:{bornIn:"Brisbane, Queensland, Australia", imdbId:"0653222", born:date('1941-01-01'), name:"Barry Otto", bio:"From Wikipedia, the free encyclopedia. \n\nBarry Otto (born 1941) is an Australian actor with a long list of memorable roles on stage and in film.  He received an AFI Award for Best Supporting Actor in Strictly Ballroom as well as being nominated for Bliss, Cosi and The More Things Change. . . .  He is the father of actresses Gracie and Miranda Otto. \n\nOtto is a keen amateur artist and has twice entered the Archibald Prize...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ykKB33a595plLh6fTuf3xPlWZc1.jpg", url:"https://themoviedb.org/person/150536"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"3052", properties:{bornIn:"Melbourne, Victoria, Australia", imdbId:"0341737", born:date('1968-12-18'), name:"Rachel Griffiths", bio:"Rachel Anne Griffiths is an Australian film and television actress.  She came to prominence with the 1994 film Muriel's Wedding and her Academy Award nominated performance in Hilary and Jackie (1998).  She is best known for her portrayals of Brenda Chenowith in the HBO series Six Feet Under and Sarah Walker Laurent on the ABC primetime drama Brothers & Sisters...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fMKF2RzD5YdvD0sjHt93Zmo277O.jpg", url:"https://themoviedb.org/person/3052"}}, {tmdbId:"17346", properties:{bornIn:"Chicago, Illinois, USA ", imdbId:"0000677", born:date('1972-06-19'), name:"Robin Tunney", bio:"Robin Jessica Tunney (born June 19, 1972, height 5' 4\" (1,63 m)) is an American actress.  She is known for her role as Teresa Lisbon in the television series The Mentalist (2008–present), as well as previous roles in the films Encino Man (1992), Empire Records (1995), The Craft (1996), End of Days (1999), and Vertical Limit (2000), and the 2005–06 series Prison Break. \n\nEarly life:\n\nTunney was born in Chicago, Illinois to a car salesman father, and a bartender mother...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6Q41n1HfbEo8lOK0eXGNtZMeP4n.jpg", url:"https://themoviedb.org/person/17346"}}, {tmdbId:"9206", properties:{bornIn:"Guelph, Ontario, Canada", imdbId:"0000117", born:date('1973-10-03'), name:"Neve Campbell", bio:"​Neve Adrianne Campbell (born October 3, 1973) is a Canadian actress.  After beginning her career on stage, she achieved fame on the 1990s television series Party of Five, playing the role of teenager Julia Salinger.  She subsequently appeared in leading roles in several Hollywood films, including Scream, The Craft, and Wild Things, and has since appeared in smaller parts and returned to stage roles.  Neve Campbell was born in Guelph, Ontario...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/171hRggAVnI2J1DKHGNOCiBgxhm.jpg", url:"https://themoviedb.org/person/9206"}}, {tmdbId:"19222", properties:{bornIn:"New York City, New York, USA", imdbId:"0874086", born:date('1966-11-15'), name:"Rachel True", bio:"Rachel India True (born November 15, 1966) is an American film and television actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1zg6aARdiNFaeBiT9UhfXgdGTli.jpg", url:"https://themoviedb.org/person/19222"}}, {tmdbId:"13604", properties:{bornIn:"Ann Arbor, Michigan, USA", imdbId:"0006563", born:date('1947-04-21'), name:"Iggy Pop", bio:"From Wikipedia, the free encyclopedia.   \n\nIggy Pop (born James Newell \"Jim\" Osterberg, Jr. ; April 21, 1947) is an American singer, songwriter, musician, and occasional actor.  He is considered an influential innovator of punk rock, hard rock, and other styles of rock music.  Pop began calling himself \"Iggy\" after his first band in high school (for which he was drummer), The Iguanas...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lKcA2n2sDNfE45elqw6gkE8h4ex.jpg", url:"https://themoviedb.org/person/13604"}}, {tmdbId:"24048", properties:{bornIn:"Ridgewood, New Jersey, USA", imdbId:"0635139", born:date('1962-03-11'), name:"Jeffrey Nordling", bio:"​From Wikipedia, the free encyclopedia. \n\nJeffrey Richard Nordling (born March 11, 1962) is an American actor.  He is known for his role as Jake Manning in the television series Once and Again...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ncN63j4FAErxhXCsFZtWdskcp48.jpg", url:"https://themoviedb.org/person/24048"}}, {tmdbId:"56930", properties:{bornIn:"Morgantown, West Virginia, USA", imdbId:"0782978", born:date('1941-02-05'), name:"David Selby", bio:"From Wikipedia, the free encyclopedia. \n\nDavid Lynn Selby (born February 5, 1941) is an American character and stage actor.  He has worked in movies, soap operas and television...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w7OUsn0tXFV3p056704eP7DkrcP.jpg", url:"https://themoviedb.org/person/56930"}}, {tmdbId:"15851", properties:{bornIn:"New London, Connecticut, USA", imdbId:"0000312", born:date('1964-06-22'), name:"Amy Brenneman", bio:"Amy Frederica Brenneman (born June 22, 1964) is an American actress, perhaps best known for her roles in the television series NYPD Blue, Judging Amy and Private Practice.  She has also starred in films such as Heat, Fear, Daylight, Nine Lives and 88 Minutes. \n\nDescription above from the Wikipedia article  Amy Brenneman, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kbLoCpvnQWn5oHlAr70pZ6QXoa3.jpg", url:"https://themoviedb.org/person/15851"}}, {tmdbId:"15250", properties:{bornIn:"Englewood, New Jersey, USA", imdbId:"0204706", born:date('1964-03-23'), name:"Hope Davis", bio:"Hope Davis (born March 23, 1964) is an American actress.  She has starred in more than 20 feature films, including About Schmidt, Arlington Road, Flatliners, Mumford, American Splendor, The Lodger and Next Stop Wonderland. \n\nDescription above from the Wikipedia article Hope Davis, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dJb76YQDFmfJ6ptlvBvx0ZBP44C.jpg", url:"https://themoviedb.org/person/15250"}}, {tmdbId:"1174793", properties:{imdbId:"0573715", name:"Pat McNamara", url:"https://themoviedb.org/person/1174793"}}, {tmdbId:"3208", properties:{bornIn:"Elmira, New York, USA", imdbId:"0001623", born:date('1966-01-08'), name:"Maria Pitillo", bio:"​From Wikipedia, the free encyclopedia\n\nMaria Pitillo (born January 8, 1966) is an American actress who has starred in several films; most notably as Audrey Timmonds in Godzilla--a role which garnered her a Golden Raspberry Award for Worst Supporting Actress.  She also made an appearance on the TV series Providence. \n\nPitillo was born in Elmira, New York and was raised in Mahwah, New Jersey...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bP5Ezapqj4qJezaEdiBrIpzrUuX.jpg", url:"https://themoviedb.org/person/3208"}}, {tmdbId:"978", properties:{bornIn:"Cambridge, Cambridgeshire, England, UK", imdbId:"0533599", born:date('1967-04-30'), name:"Steven Mackintosh", bio:"Steven Mackintosh (born 30 April 1967) is an English actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vDA4mmVe0XMnqd6qMyGWI8bUEeC.jpg", url:"https://themoviedb.org/person/978"}}, {tmdbId:"35690", properties:{bornIn:"New York City, New York, U.S", imdbId:"0915465", born:date('1971-01-19'), name:"Shawn Wayans", bio:"Shawn Mathis Wayans (born January 19, 1971) is an American actor, producer, writer and comedian who starred in In Living Color and The Wayans Bros.  He is the brother of Keenen Ivory, Damon, Marlon, Kim and Nadia Wayans...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Cat25uXhB680QLmvg9Tu16W563.jpg", url:"https://themoviedb.org/person/35690"}}, {tmdbId:"9562", properties:{bornIn:"New York City, New York, USA", imdbId:"0005541", born:date('1972-07-23'), name:"Marlon Wayans", bio:"Marlon L.  Wayans was born on July 23, 1972 in New York City.  He is the brother of Nadia Wayans, Shawn Wayans, Keenen Ivory Wayans, Damon Wayans, Dwayne Wayans, and Kim Wayans; all celebrities in their own right.  Wayans went to Fiorello H.  LaGuardia High School of Music &amp; Art and Performing Arts in New York City, the school made famous in Fame.  He then went on to attend Howard University...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7LYnX3vluHFBs1WCRKUjSIEDEkn.jpg", url:"https://themoviedb.org/person/9562"}}, {tmdbId:"66131", properties:{imdbId:"0429385", born:date('1970-01-23'), name:"Tracey Cherelle Jones", url:"https://themoviedb.org/person/66131"}}, {tmdbId:"27590", properties:{bornIn:" Los Angeles, California, USA", imdbId:"0817893", born:date('1968-01-02'), name:"Chris Spencer", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zpO4NOydiMgNvf9LBowUrIM8swr.jpg", url:"https://themoviedb.org/person/27590"}}, {tmdbId:"7090", properties:{bornIn:"St. Thomas, U.S. Virgin Islands", imdbId:"0001288", born:date('1955-02-21'), name:"Kelsey Grammer", bio:"Allen Kelsey Grammer is a 5-time Emmy Award-winning American actor and comedian.  He is most widely known for his two-decade portrayal of psychiatrist Dr.  Frasier Crane in the NBC sitcoms Cheers and Frasier...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qATQWUUUdUDVjuyspooYNiUmNJD.jpg", url:"https://themoviedb.org/person/7090"}}, {tmdbId:"57428", properties:{bornIn:"The Bronx, New York, U.S", imdbId:"0484678", born:date('1972-09-18'), name:"Michael Landes", bio:"From Wikipedia, the free encyclopedia\n\nMichael Christopher Landes (born September 18, 1972) is an American actor.  He is known for his roles of Jimmy Olsen in the first season of Lois and Clark: The New Adventures of Superman, Detective Nicholas O'Malley in Special Unit 2, Officer Thomas Burke in Final Destination 2, and David Conlon in The Wedding Bells. \n\nDescription above from the Wikipedia article Michael Landes, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2EdaNaUQdWi7Vi0pLNaS9Ys9fVi.jpg", url:"https://themoviedb.org/person/57428"}}, {tmdbId:"14407", properties:{bornIn:"Newton, Massachusetts, USA", imdbId:"0001455", born:date('1967-07-25'), name:"Matt LeBlanc", bio:"Matt LeBlanc was born in Newton, Massachusetts, to an Italian mother and a father of mixed Irish, English, Dutch and French ancestry.  After graduating from high school, he spent some time as a photo model in Florida before moving to New York where he took drama classes.  After a few small roles on stage and on TV, he became famous for his role as Joey in \"Friends\" (1994), and in a less successful spin-off, \"Joey\" (2004)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wvGne2ilC3dI1aTT8uGgJ8Zo4EG.jpg", url:"https://themoviedb.org/person/14407"}}, {tmdbId:"9295", properties:{imdbId:"0743418", born:date('1930-08-09'), name:"Gene Ross", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9VnYVtFLgHAOSIqVqmSz2G5P0u0.jpg", url:"https://themoviedb.org/person/9295"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"177049", properties:{imdbId:"0382070", name:"Paul Hewitt", url:"https://themoviedb.org/person/177049"}}, {tmdbId:"1232170", properties:{imdbId:"0021023", name:"Sage Allen", url:"https://themoviedb.org/person/1232170"}}, {tmdbId:"27011", properties:{bornIn:"Tarrytown, New York, USA", imdbId:"0001853", born:date('1963-03-18'), name:"Vanessa Williams", bio:"An American pop-R&B recording artist, producer, dancer, model, and actress.  In 1983, she became the first woman of African-American descent to be crowned Miss America, but a scandal involving nude photographs caused her to relinquish her title early.  Williams rebounded by launching a career as an entertainer, earning Grammy, Emmy, and Tony Award nominations...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/30O1Af0wy6UBt8EpVRuq28tTGoT.jpg", url:"https://themoviedb.org/person/27011"}}, {tmdbId:"58731", properties:{imdbId:"0336573", name:"Diva Gray", url:"https://themoviedb.org/person/58731"}}, {tmdbId:"1661583", properties:{imdbId:"0021887", name:"Ami Almendral", url:"https://themoviedb.org/person/1661583"}}, {tmdbId:"27261", properties:{bornIn:"San Clemente, California, USA", imdbId:"0122466", born:date('1977-03-24'), name:"Olivia Burnette", bio:"Olivia Nicole Burnette (born March 24, 1977) is an American actress\n\nDescription above from the Wikipedia article Olivia  Burnette  licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cn8n42CWGUSBI1NNiarVIP9Lyr6.jpg", url:"https://themoviedb.org/person/27261"}}, {tmdbId:"157108", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0477363", born:date('1988-11-11'), name:"Alexandra Kyle", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tb4TYvNEnobfKIjlbuwZlHGiaD1.jpg", url:"https://themoviedb.org/person/157108"}}, {tmdbId:"43853", properties:{bornIn:"Beaumont, Texas, USA", imdbId:"0355659", born:date('1935-06-03'), name:"Irma P. Hall", bio:"​Irma P.  Hall is an American film and television actress, best known for playing matriarchal figures in feature films like \"A Family Thing\", \"Soul Food\", and \"The Ladykillers\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kKLDJvpAE1uKLeTw5jUmBwPgqOd.jpg", url:"https://themoviedb.org/person/43853"}}, {tmdbId:"53", properties:{bornIn:"Arbrå, Gävleborgs län, Sweden", imdbId:"0001780", born:date('1953-08-27'), name:"Peter Stormare", bio:"A Swedish film, stage, voice and television actor as well as a theatrical director, playwright and musician.  He is perhaps best known for his roles as John Abruzzi in Prison Break and as Gaear Grimsrud, one of the two kidnappers in Fargo. \n\nPeter Stormare began his acting career at the Royal National Theatre of Sweden, performing for eleven years.  In 1990 he became the Associate Artistic Director at the Tokyo Globe Theatre and directed productions of many Shakespeare plays, including \"Hamlet\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q28auzak1QtzmZytMigaGC5XsTV.jpg", url:"https://themoviedb.org/person/53"}}, {tmdbId:"3906", properties:{bornIn:"Fargo, North Dakota, USA", imdbId:"0749021", born:date('1955-05-23'), name:"Kristin Rudrüd", bio:"From Wikipedia, the free encyclopedia\n\nKristin Rudrüd (Born May 23, 1955) is an American film, theater, and television actress. \n\nRudrüd was born in Fargo, North Dakota, and grew up in Moorhead, Minnesota.  She went to high school in Fargo, and after graduation attended Minnesota State University Moorhead...", url:"https://themoviedb.org/person/3906"}}, {tmdbId:"13240", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0000242", born:date('1971-06-05'), name:"Mark Wahlberg", bio:"Mark Robert Michael Wahlberg (born June 5, 1971) is an American actor, film and television producer, and former rapper.  He was known as Marky Mark in his earlier years, and became famous for his 1991 debut as a musician with the band Marky Mark and the Funky Bunch.  He was named No. 1 on VH1's 40 Hottest Hotties of the 90's...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bTEFpaWd7A6AZVWOqKKBWzKEUe8.jpg", url:"https://themoviedb.org/person/13240"}}, {tmdbId:"3713", properties:{bornIn:"Milford-on-the-sea, Hampshire, England, UK", imdbId:"0004920", born:date('1952-05-11'), name:"Frances Fisher", bio:"From Wikipedia, the free encyclopedia\n\nFrances Fisher (born 11 May 1952) is a British-born American actress.  She is known for her roles as Strawberry Alice, the madame prostitute in Unforgiven (1992), directed by Clint Eastwood; and Ruth DeWitt Bukater, the mother of Kate Winslet's character in Titanic (1997); directed by James Cameron.  Both films won the Academy Award for Best Picture...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tsyGcoXGRNM8KGLpLG3OuxAyxx2.jpg", url:"https://themoviedb.org/person/3713"}}, {tmdbId:"1761464", properties:{name:"Karishma Jhalani", url:"https://themoviedb.org/person/1761464"}}, {tmdbId:"1761470", properties:{name:"Ramanjeet Kaur", url:"https://themoviedb.org/person/1761470"}}, {tmdbId:"554929", properties:{bornIn:"New Dehli, India", imdbId:"0576549", name:"Dilip Mehta", url:"https://themoviedb.org/person/554929"}}, {tmdbId:"86086", properties:{imdbId:"0412917", born:date('1963-12-04'), name:"Javed Jaffrey", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5JvPPxLsDEUFy6qDVawM3Itl6NV.jpg", url:"https://themoviedb.org/person/86086"}}, {tmdbId:"72862", properties:{bornIn:"Minnesota", imdbId:"0682302", born:date('1980-11-14'), name:"Brock Pierce", bio:"​From Wikipedia, the free encyclopedia\n\nBrock Pierce (born November 14, 1980 in Minnesota), is an entrepreneur best known for pioneering the market for virtual goods in online games.  He has founded or co-founded seven companies, acquired more than thirty companies, and closed a dozen corporate finance transactions securing more than $200 million of funding on behalf of his companies...", url:"https://themoviedb.org/person/72862"}}, {tmdbId:"72863", properties:{bornIn:"Slidell, U.S.A.", imdbId:"0101711", born:date('1970-10-01'), name:"Blake Boyd", bio:"​From Wikipedia, the free encyclopedia\n\nBlake Nelson Boyd (born October 1, 1970) is an American film actor, comedian, and visual artist who lives and works in New Orleans, Louisiana and London.  Boyd was mentored by Andres Serrano and Andy Warhol Factory manager Billy Name in the 1990s.  Boyd's visual art takes many different forms of expression including painting, photography, drawing, sculpture, video and installation...", url:"https://themoviedb.org/person/72863"}}, {tmdbId:"783", properties:{bornIn:"Washington, D.C", imdbId:"0052186", born:date('1947-01-31'), name:"Jonathan Banks", bio:"Jonathan Banks (born January 31, 1947) is an American character actor in film and television.  He tends to play villains. \n\nBanks dropped out of Indiana University to join a touring company as a stage manager.  He went to Australia with the company and stayed on working in theatre there.  In 1974, he moved to Los Angeles and performed on stage before picking up bit parts on television.  Probably his best-known movie roles are in two films starring Eddie Murphy: 48 Hrs.  and Beverly Hills Cop...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/va6APAzwv68YxvYQkB3lHhpccCi.jpg", url:"https://themoviedb.org/person/783"}}, {tmdbId:"135571", properties:{imdbId:"0212588", born:date('1945-05-24'), name:"Robert Deacon", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/857AfN1EV76qQXmatXh91Upm0RK.jpg", url:"https://themoviedb.org/person/135571"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"4939", properties:{bornIn:"New York City, New York, USA", imdbId:"0000495", born:date('1966-02-25'), name:"Téa Leoni", bio:"Elizabeth Téa Pantaleoni ( born February 25, 1966), better known by her stage name Téa Leoni, is an American actress.  She has starred in a wide range of films including Jurassic Park III, The Family Man, Deep Impact, Fun with Dick and Jane, Spanglish, Bad Boys and Ghost Town. \n\nDescription above from the Wikipedia article Téa Leoni, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nWqwLS8w72eOMQTDrUiBYrgHxsf.jpg", url:"https://themoviedb.org/person/4939"}}, {tmdbId:"218563", properties:{bornIn:"Llanelli, South Wales, UK", imdbId:"0859005", born:date('1945-06-11'), name:"Jeffrey Thomas", bio:"is a Welsh-born New Zealand actor and writer, best known for his film, television and stage roles.  Thomas was born in Llanelli, south Wales, to a fluent Welsh-speaking family.  His grandmother's interest in drama awakened an early interest in acting.  After leaving school he trained as a quantity surveyor, but grew bored with office work.  He attended Liverpool University, completing a BA in English Literature and in Celtic Studies and English Literature...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/10ip8Fxn0LuVbsQiGjskw3hmXp9.jpg", url:"https://themoviedb.org/person/218563"}}, {tmdbId:"41558", properties:{bornIn:"Edwardsville, Illinois, USA", imdbId:"0123102", born:date('1973-10-03'), name:"Hedy Burress", bio:"Hedy Burress is an actress...", url:"https://themoviedb.org/person/41558"}}, {tmdbId:"91415", properties:{bornIn:"Las Vegas, Nevada, USA", imdbId:"0507343", born:date('1976-01-08'), name:"Jenny Lewis", bio:"Jenny Lewis is an American singer-songwriter, musician, and actress.  She was the lead singer and rhythm guitarist for the indie rock band Rilo Kiley, and has released three solo albums.  She is currently a member of the rock duo Nice As Fuck...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bfywGcK0YFyxWH2QDDlwyqtP8Po.jpg", url:"https://themoviedb.org/person/91415"}}, {tmdbId:"119311", properties:{bornIn:"San Jose, California, USA", imdbId:"0793652", born:date('1967-06-16'), name:"Jenny Shimizu", bio:"Jenny Lynn Shimizu is an American model and actress...", url:"https://themoviedb.org/person/119311"}}, {tmdbId:"998514", properties:{imdbId:"0768403", name:"Abbas Sayah", url:"https://themoviedb.org/person/998514"}}, {tmdbId:"998513", properties:{imdbId:"0229187", name:"Shaghayeh Djodat", url:"https://themoviedb.org/person/998513"}}, {tmdbId:"1806055", properties:{name:"Hossein Moharami", url:"https://themoviedb.org/person/1806055"}}, {tmdbId:"1806056", properties:{name:"Rogheih Moharami", url:"https://themoviedb.org/person/1806056"}}, {tmdbId:"6861", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0105672", born:date('1962-07-01'), name:"Andre Braugher", bio:"Andre Braugher (born July 1, 1962) is an American actor.  He is perhaps best known for his roles as in Glory as well as on Homicide: Life on the Street, Men of a Certain Age and Brooklyn Nine-Nine...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h8ZKYOuYvdatAuHAgoXm1WowD7r.jpg", url:"https://themoviedb.org/person/6861"}}, {tmdbId:"98889", properties:{bornIn:"Griffin, Georgia, USA", imdbId:"0126070", born:date('1950-01-01'), name:"Thomas Jefferson Byrd", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j3Q26CzFZKiNIEoahirupb05DRL.jpg", url:"https://themoviedb.org/person/98889"}}, {tmdbId:"51878", properties:{bornIn:"New Brighton, Port Elizabeth, Sudafrica", imdbId:"0437689", born:date('1943-11-30'), name:"John Kani", bio:"​From Wikipedia, the free encyclopedia.   \n\nBonsile John Kani (born 1943) is a South African actor, director and playwright.  He was born in New Brighton, South Africa.  Kani joined The Serpent Players (a group of actors whose first performance was in the former snake pit of the zoo, hence the name) in Port Elizabeth in 1965 and helped to create many plays that went unpublished but were performed to a resounding reception...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/g7tqg3q128a5O2qXMCwVnXsow9I.jpg", url:"https://themoviedb.org/person/51878"}}, {tmdbId:"4604", properties:{bornIn:"Los Angeles, California, U.S.", imdbId:"0005337", born:date('1964-12-27'), name:"Theresa Randle", bio:"​From Wikipedia, the free encyclopedia.   \n\nTheresa E.  Randle is an American stage, film and television actress. Randle also starred with Wesley Snipes in the film Sugar Hill (1994) and also appeared with Eddie Murphy in Beverly Hills Cop III the same year.  She later appeared in Space Jam (1996) with Michael Jordan and the film adaptation of the comic book Spawn (1997). \n\nIn 2006, Randle signed on to play Patricia Kent on Law &amp; Order: Criminal Intent, replacing Courtney B...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/myBU9qG6wXHJfYF9cl07rvQmhUB.jpg", url:"https://themoviedb.org/person/4604"}}, {tmdbId:"21353", properties:{bornIn:"Houston, Texas, USA", imdbId:"0913460", born:date('1963-08-03'), name:"Isaiah Washington", bio:"Isaiah Washington IV is an American actor.  A veteran of several Spike Lee films, Washington is probably best known for his role as Dr.  Preston Burke on the ABC medical drama Grey's Anatomy...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3yY5h1t7AKZpf4lfdSMwDQvCroQ.jpg", url:"https://themoviedb.org/person/21353"}}, {tmdbId:"15899", properties:{bornIn:"Kinloch, Missouri, USA", imdbId:"0507338", born:date('1957-01-25'), name:"Jenifer Lewis", bio:"Jenifer Jeanette Lewis (born January 25, 1957) is an American film and television actress and singer.   Description above from the Wikipedia article Jenifer Lewis, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/htrTYcoJQQpSYo6BrRehe3h46vo.jpg", url:"https://themoviedb.org/person/15899"}}, {tmdbId:"7796", properties:{bornIn:"Quincy, Massachusetts, USA", imdbId:"0001152", born:date('1965-07-25'), name:"Illeana Douglas", bio:"Illeana Hesselberg, most commonly known as Illeana Douglas, (born July 25, 1965) is an American actress, director, screenwriter, and producer.  Douglas has had a long-ranging diverse career as a character actor with a specialty in comedy.  She is a granddaughter of Hollywood Golden Age screen star Melvyn Douglas...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iwioN2tbwp8DrM8SkRds8Bx1L9N.jpg", url:"https://themoviedb.org/person/7796"}}, {tmdbId:"1877359", properties:{name:"Sissy Boyd", url:"https://themoviedb.org/person/1877359"}}, {tmdbId:"94978", properties:{bornIn:"Halifax, Yorkshire, England, UK", imdbId:"0681943", born:date('1935-02-17'), name:"Christina Pickles", bio:"From Wikipedia, the free encyclopedia.   Christina Pickles (born February 17, 1935) is an English actress, best known for role of Nurse Helen Rosenthal in the hospital drama St.  Elsewhere, for which she was nominated for four Emmys.   Description above from the Wikipedia article Christina Pickles, licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1gqG36AaeV2lxlskzipdZnnUEfc.jpg", url:"https://themoviedb.org/person/94978"}}, {tmdbId:"150202", properties:{imdbId:"0811935", name:"Jill Sobule", url:"https://themoviedb.org/person/150202"}}, {tmdbId:"109551", properties:{imdbId:"0572404", name:"Mike McLaughlin", url:"https://themoviedb.org/person/109551"}}] AS row
