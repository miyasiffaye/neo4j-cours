r:"https://image.tmdb.org/t/p/w440_and_h660_face/zQOI5cbcp2JxGJ9lK9NnIudcd82.jpg", url:"https://themoviedb.org/person/21942"}}, {tmdbId:"60959", properties:{bornIn:"Coral Springs, Florida, U.S.", imdbId:"0864490", born:date('1974-09-24'), name:"Jackie Sandler", bio:"Jacqueline Sandler (born September 24, 1974) is a model and actress, known for her supporting roles in numerous films with her husband Adam Sandler...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2q0sDJrxJ4bnznnHY3OEuDyx8Dw.jpg", url:"https://themoviedb.org/person/60959"}}, {tmdbId:"88736", properties:{bornIn:" Dallas, Texas, USA", imdbId:"0832852", born:date('1988-11-21'), name:"Austin Stout", url:"https://themoviedb.org/person/88736"}}, {tmdbId:"104799", properties:{bornIn:" Toronto, Canada", imdbId:"0799895", born:date('1986-06-28'), name:"Shadia Simmons", url:"https://themoviedb.org/person/104799"}}, {tmdbId:"81170", properties:{imdbId:"0540767", born:date('1984-11-17'), name:"Lauren Maltby", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8PvdqicJtcY9hQccH1tslMkZeym.jpg", url:"https://themoviedb.org/person/81170"}}] AS row
