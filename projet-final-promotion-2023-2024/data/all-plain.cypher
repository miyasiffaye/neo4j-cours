UNWIND [{tmdbId:"28745", properties:{imdbId:"0299028", born:date('1955-12-08'), name:"Deborra-Lee Furness", bio:"From Wikipedia, the free encyclopedia. \n\nDeborra-Lee Furness is an Australian actress, director and producer. \n\nDescription above from the Wikipedia article Deborra-Lee Furness, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/k8kAWpKyVj0EQ2MNs077reQZDmy.jpg", url:"https://themoviedb.org/person/28745"}}, {tmdbId:"143151", properties:{imdbId:"0722614", name:"Miranda Rhyne", url:"https://themoviedb.org/person/143151"}}, {tmdbId:"196180", properties:{imdbId:"0090033", name:"Charlotte Eve Blythe", url:"https://themoviedb.org/person/196180"}}, {tmdbId:"3711", properties:{bornIn:"New York City, New York, USA", imdbId:"0505764", born:date('1955-09-18'), name:"Anna Levine", bio:"From Wikipedia, the free encyclopedia. \n\nAnna Kluger Levine (born September 18, 1953) is an American actress.  She has also been credited as Anna Levine Thompson and Anna Thomson. \n\nDescription above from the Wikipedia article Anna Levine, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/3711"}}, {tmdbId:"87707", properties:{bornIn:"Ridgewood - Queens - New York, USA", imdbId:"0893247", born:date('1963-07-17'), name:"John Ventimiglia", bio:"John Ventimiglia is an actor and writer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1KSrI47Q3mdb3XXoEpiNaZoWsGp.jpg", url:"https://themoviedb.org/person/87707"}}, {tmdbId:"40900", properties:{bornIn:"Ashford, Kent, UK", imdbId:"0753314", born:date('1960-01-18'), name:"Mark Rylance", bio:"Sir David Mark Rylance Waters (born 18 January 1960 in Ashford, Kent, England) is an English actor, theatre director, and playwright. \n\nHe was the first artistic director of Shakespeare's Globe in London, between 1995 and 2005.  His film appearances include Prospero's Books (1991), Angels and Insects (1995), Institute Benjamenta (1996), and Intimacy (2001).  Rylance won the Academy Award and BAFTA Award for Best Supporting Actor for his portrayal of Rudolf Abel in Bridge of Spies (2015)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gpnwdLoAbhAKwXQzJ04ga7UeJhs.jpg", url:"https://themoviedb.org/person/40900"}}, {tmdbId:"14326", properties:{bornIn:"Hounslow, Greater London, England, UK", imdbId:"0000475", born:date('1968-03-04'), name:"Patsy Kensit", bio:"From Wikipedia, the free encyclopedia. \n\nPatricia Jude Francis \"Patsy\" Kensit (born 4 March 1968) is an English actress, singer and former child star, known for her television and film appearances.  Her films include Lethal Weapon 2 and she has been married to rock stars Jim Kerr and Liam Gallagher, as well as herself fronting the band Eighth Wonder.  In May 2004 she returned to television acting, taking the role of Sadie King in the ITV soap opera Emmerdale...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fp8059ZLrCiZFgdhcwHTHHe6kBr.jpg", url:"https://themoviedb.org/person/14326"}}, {tmdbId:"156413", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0031759", born:date('1959-12-11'), name:"Perry Anzilotti", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yV0dNPR1RRO6ygjXycS8uxMkMkg.jpg", url:"https://themoviedb.org/person/156413"}}, {tmdbId:"233298", properties:{bornIn:"Bucks County, Pennsylvania, USA", imdbId:"0193551", born:date('1957-01-01'), name:"Robert Curtis Brown", bio:"Robert Curtis Brown (born April 1957) is an American television, film and stageactor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rbMhXK1U9zZXcPHQKAoJ677qeak.jpg", url:"https://themoviedb.org/person/233298"}}, {tmdbId:"16666", properties:{bornIn:"Patchogue, Stato di New York, Stati Uniti", imdbId:"0175305", born:date('1974-03-05'), name:"Kevin Connolly", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1QDmx5t0anO0wkfABfgLtkuLFOy.jpg", url:"https://themoviedb.org/person/16666"}}, {tmdbId:"1420227", properties:{imdbId:"1513421", name:"Janny Brandes-Brilslijper", url:"https://themoviedb.org/person/1420227"}}, {tmdbId:"13506", properties:{bornIn:"Amsterdam, Noord-Holland, Netherlands", imdbId:"0002168", born:date('1944-04-05'), name:"Willeke van Ammelrooy", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aXwDoxmfLO7aBvJLDADODBhubqU.jpg", url:"https://themoviedb.org/person/13506"}}, {tmdbId:"13507", properties:{bornIn:"Leuven, Flanders, Belgium", imdbId:"0234579", born:date('1964-01-16'), name:"Els Dottermans", url:"https://themoviedb.org/person/13507"}}, {tmdbId:"13508", properties:{bornIn:"Antwerpen, Flanders, Belgium", imdbId:"0342869", born:date('1927-03-10'), name:"Dora van der Groen", died:date('2015-11-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q5r8a9p3bdbQqRZR5ohHNJw15y1.jpg", url:"https://themoviedb.org/person/13508"}}, {tmdbId:"13509", properties:{imdbId:"0887675", name:"Veerle van Overloop", url:"https://themoviedb.org/person/13509"}}, {tmdbId:"1314244", properties:{name:"Steve Lively", url:"https://themoviedb.org/person/1314244"}}, {tmdbId:"1833985", properties:{imdbId:"0140805", name:"Ed E. Carroll", url:"https://themoviedb.org/person/1833985"}}, {tmdbId:"58556", properties:{imdbId:"0205863", name:"Anatoli Davydov", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h612YfWBEymtZw13UQ6JVe0rXEs.jpg", url:"https://themoviedb.org/person/58556"}}, {tmdbId:"95789", properties:{bornIn:"Colchester, Essex, UK", imdbId:"0146061", born:date('1975-01-14'), name:"Georgina Cates", bio:"Georgina Cates is an English film and television actress and professional photographer based in the US.  Born in Colchester in 1975 as Clare Woodgate, she entered the acting profession under that name and first came to fame at the age of sixteen in the role of Jenny Porter in the BBC sitcom 2 Point 4 Children.  After two series, she moved on to appear in guest roles in long-running, popular drama series such as The Bill and Casualty...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cnZDz6tIPwR4RRfyEVeqqy5kRBC.jpg", url:"https://themoviedb.org/person/95789"}}, {tmdbId:"2629", properties:{bornIn:" Annfield Plain, County Durham, England, UK", imdbId:"0035605", born:date('1946-07-17'), name:"Alun Armstrong", bio:"From Wikipedia, the free encyclopedia\n\nAlun Armstrong (born 17 July 1946) is a prolific English character actor.  Armstrong grew up in County Durham in North East England.  He first became interested in acting through Shakespeare productions at his grammar school.  Since his career began in the early 1970s, he has played, in his words, \"the full spectrum of characters from the grotesque to musicals. . .  I always play very colourful characters, often a bit crazy, despotic, psychotic...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ixG4zFJBMOQyFY8e6u4CCsQ0Bj9.jpg", url:"https://themoviedb.org/person/2629"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"58136", properties:{bornIn:"Utah, United States", imdbId:"0004815", born:date('1963-08-16'), name:"Christine Cavanaugh", bio:"From Wikipedia, the free encyclopedia.   Christine Cavanaugh (born August 16, 1963) is an American former voice actress who had a distinctive speaking style and had provided the voice for a large range of cartoon characters.  She is best known as the voice of Babe in the hit film, Babe, Chuckie Finster on Rugrats and for being the original voice of Dexter on Dexter's Laboratory.  In 2001, she retired from voice acting for personal reasons...", died:date('2014-12-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qOUpGURljNhgFzZ5SmV5miAmT9x.jpg", url:"https://themoviedb.org/person/58136"}}, {tmdbId:"6199", properties:{bornIn:"Oxford, England, UK", imdbId:"0546816", born:date('1941-05-18'), name:"Miriam Margolyes", bio:"An English actress and voice artist.  Her earliest roles were in theatre and after several supporting roles in film and television she won a BAFTA Award for her role in The Age of Innocence (1993). \n\nDescription above from the Wikipedia article Miriam Margolyes, licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/93k0aFwiuDT5sIS3oTX1jKgUYXE.jpg", url:"https://themoviedb.org/person/6199"}}, {tmdbId:"70852", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0004922", born:date('1982-07-08'), name:"Schuyler Fisk", bio:"​Schuyler Elizabeth Fisk (pronounced “Sky-ler”; born July 8, 1982) is an American actress and singer-songwriter. \n\nDescription above from the Wikipedia article Schuyler Fisk, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5nQajFEGYNH8IeVhbWMKdF4lxu8.jpg", url:"https://themoviedb.org/person/70852"}}, {tmdbId:"131934", properties:{bornIn:"Canada", imdbId:"0086205", born:date('1980-04-29'), name:"Bre Blair", bio:"Bre Blair is a Canadian actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nDrqKb2I800qJ3UmME6FJEVOq0P.jpg", url:"https://themoviedb.org/person/131934"}}, {tmdbId:"38581", properties:{bornIn:"Minneapolis, Minnesota, USA", imdbId:"0000337", born:date('1979-10-04'), name:"Rachael Leigh Cook", bio:"​From Wikipedia, the free encyclopedia. \n\nRachael Leigh Cook (born October 4, 1979) is an American actress, model, voice artist and producer, who is best known for her starring role in films She's All That (1999), Josie and the Pussycats (2001), and the television series Into the West and Perception, as well as being the voice behind various characters in Robot Chicken and Tifa Lockhart in the English version of Final Fantasy VII: Advent Children...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kWsfrwshpWqB0Jhn43jcwC8BZsT.jpg", url:"https://themoviedb.org/person/38581"}}, {tmdbId:"40978", properties:{bornIn:"Santa Clara County, California, USA", imdbId:"0646351", born:date('1981-06-07'), name:"Larisa Oleynik", bio:"​From Wikipedia, the free encyclopedia.   \n\nLarisa Romanovna Oleynik ( born June 7, 1981) is an American actress.  She came to fame in the mid-1990s, after starring in the title role of the popular television series, The Secret World of Alex Mack, and has also appeared in theatrical films, including The Baby-Sitters Club and 10 Things I Hate About You.  Throughout the 2000s, she has mostly appeared in lower-budget films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i3W6ztn8kTKAaZoLS77Tz9GhP7C.jpg", url:"https://themoviedb.org/person/40978"}}, {tmdbId:"23646", properties:{bornIn:"San Diego, California, USA", imdbId:"0518718", born:date('1972-11-07'), name:"Jeremy London", bio:"Jeremy London (born November 7, 1972) is an American actor.  He is best known for his regular roles on Party of Five, 7th Heaven, and I'll Fly Away...", url:"https://themoviedb.org/person/23646"}}, {tmdbId:"23975", properties:{bornIn:"Teaneck, New Jersey, États-Unis", imdbId:"0307600", born:date('1953-07-20'), name:"Lee Garlington", bio:"Lee Garlington was born on July 20, 1953.  She is an actress and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tbXeeXUl9py2pCeMHchZAxd56Ua.jpg", url:"https://themoviedb.org/person/23975"}}, {tmdbId:"9313", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0102288", born:date('1964-08-06'), name:"Lisa Boyle", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gBzL7D5FxIWAuTgO9zU6sbTX5L8.jpg", url:"https://themoviedb.org/person/9313"}}, {tmdbId:"87360", properties:{bornIn:"Fort Worth, Texas, USA", imdbId:"0848075", born:date('1961-08-23'), name:"Michael Taliferro", bio:"Known for his intimidating stature, Taliferro was signed by the Washington Redskins in 1984, followed by two seasons in the USFL with the Denver Gold in 1985 and the Arizona Outlaws in 1986, finishing his career with the British Columbia Lions in the Canadian Football League the following year...", died:date('2006-05-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8Z9Q25tfNE1CqnveRkj5FJtwIoJ.jpg", url:"https://themoviedb.org/person/87360"}}, {tmdbId:"1034640", properties:{imdbId:"0595869", name:"Aida Mohammadkhani", url:"https://themoviedb.org/person/1034640"}}, {tmdbId:"1034642", properties:{imdbId:"0435760", name:"Mohsen Kafili", url:"https://themoviedb.org/person/1034642"}}, {tmdbId:"1034643", properties:{imdbId:"0649746", name:"Fereshteh Sadre Orafaiy", url:"https://themoviedb.org/person/1034643"}}, {tmdbId:"1387299", properties:{imdbId:"0096941", name:"Anna Borkowska", url:"https://themoviedb.org/person/1387299"}}, {tmdbId:"60142", properties:{imdbId:"0812427", born:date('1937-06-02'), name:"Marilyn Sokol", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ajvhG94d6uQ51YESTKRRROeWmTT.jpg", url:"https://themoviedb.org/person/60142"}}, {tmdbId:"65395", properties:{bornIn:"The Bronx, New York, USA", imdbId:"0534944", born:date('1975-11-22'), name:"James Madio", bio:"From Wikipedia, the free encyclopedia\n\nJames Madio (born November 22, 1975 in The Bronx, New York City, New York) is an American actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v17uyHhMLooVWKjMRS4NoGeTPyB.jpg", url:"https://themoviedb.org/person/65395"}}, {tmdbId:"571", properties:{bornIn:"Vienna, Austria", imdbId:"0248600", born:date('1958-09-17'), name:"Andrea Eckert", bio:"From Wikipedia, the free encyclopedia.  Andrea Eckert (born 17 September 1958) is an Austrian stage and film actress, singer and documentary filmmaker. \n\nBorn in Vienna, Eckert first studied literature in Paris, France, then decided on a stage career and trained with Dorothea Neff.  Her roles have included the eponymous heroines in Hebbel's Judith, Schiller's Maria Stuart, Jelinek's Clara S...", url:"https://themoviedb.org/person/571"}}, {tmdbId:"572", properties:{bornIn:"Vienna, Austria", imdbId:"0702541", born:date('1949-07-02'), name:"Hanno Pöschl", bio:"From Wikipedia, the free encyclopedia.   Hanno Pöschl (born 2 July 1949, Vienna, Austria) is an Austrian actor. \n\nPöschl has enjoyed a long and prolific career working with directors Maximilian Schell, Peter Patzak, Rainer Werner Fassbinder, Paulus Manker, Richard Linklater, and Götz Spielmann.  He also starred in several TV-Productions, and has occasionally appeared in theatrical productions at Vienna's Burgtheater and elsewhere...", url:"https://themoviedb.org/person/572"}}, {tmdbId:"19668", properties:{imdbId:"0461931", name:"U Aung Ko", url:"https://themoviedb.org/person/19668"}}, {tmdbId:"46423", properties:{bornIn:"Paddington, London, England, UK", imdbId:"0001882", born:date('1969-01-22'), name:"Olivia d'Abo", bio:"From Wikipedia, the free encyclopedia. \n\nOlivia Jane d'Abo (born 22 January 1969) is an English actress and singer-songwriter, best known for portraying Karen Arnold in The Wonder Years and Nicole Wallace, the recurring villain in Law & Order: Criminal Intent...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sQTqkjNyUSl25cIDr8xhjmO4DhA.jpg", url:"https://themoviedb.org/person/46423"}}] AS row
