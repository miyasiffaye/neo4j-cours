UNWIND [{tmdbId:"109552", properties:{imdbId:"0731959", name:"Melissa Robertson", url:"https://themoviedb.org/person/109552"}}, {tmdbId:"60581", properties:{imdbId:"0007825", name:"Riz Abbasi", url:"https://themoviedb.org/person/60581"}}, {tmdbId:"8318", properties:{bornIn:"Mexborough, Yorkshire, England, UK", imdbId:"0000306", born:date('1936-10-09'), name:"Brian Blessed", bio:"From Wikipedia, the free encyclopedia. \n\nBrian Blessed (born 9 October 1936) is an English actor.  He is known for his sonorous voice and \"hearty, king-sized portrayals\".  He has also distinguished himself as an author and adventurer. \n\nDescription above from the Wikipedia article Brian Blessed, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3mLIr94V5IOA5ndY6GyqKKcyrX6.jpg", url:"https://themoviedb.org/person/8318"}}, {tmdbId:"2235393", properties:{name:"Brent Baskin", url:"https://themoviedb.org/person/2235393"}}, {tmdbId:"2235407", properties:{name:"Greg Cox", url:"https://themoviedb.org/person/2235407"}}, {tmdbId:"31171", properties:{bornIn:"Baltimore, Maryland, USA", imdbId:"0100866", born:date('1970-03-03'), name:"Julie Bowen", bio:"Julie Bowen (born March 3, 1970) is an American film and television actress. \n\nShe is best known for playing Claire Dunphy on the sitcom Modern Family, Carol Vessey on Ed, and Denise Bauer on Boston Legal. \n\nBowen began her acting career in the soap opera Loving in 1992.  In 1994, she played the lead role opposite Paul Rudd, in the television film Runaway Daughters...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/y8oHR0SZCIoWKqFNbtwcJCCU6uq.jpg", url:"https://themoviedb.org/person/31171"}}, {tmdbId:"11794", properties:{bornIn:"Winnipeg, Manitoba, Canada", imdbId:"0062844", born:date('1919-01-23'), name:"Frances Bay", bio:"​From Wikipedia, the free encyclopedia.   \n\nFrances Goffman Bay (born January 23, 1919) is a Canadian-born United States-based character actress known for playing a variety of quirky elderly women on film and television. \n\nDescription above from the Wikipedia article Frances  Bay  , licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2011-09-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1mtcINBBbvb7E4ySgOr86u34XLJ.jpg", url:"https://themoviedb.org/person/11794"}}, {tmdbId:"67704", properties:{bornIn:"Kingston - Ontario - Canada", imdbId:"0227003", born:date('1963-05-31'), name:"Hugh Dillon", bio:"From Wikipedia, the free encyclopedia. \n\nHugh Dillon  (born May 31, 1963 in Kingston, Ontario, height 5' 10\" (1,78 m)) is a Canadian musician and actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/npY8dF5b1j5pUqt11sDBi89BDTi.jpg", url:"https://themoviedb.org/person/67704"}}, {tmdbId:"540", properties:{bornIn:"Sunderland, Tyne and Wear, England, UK", imdbId:"0719678", born:date('1960-09-14'), name:"Callum Keith Rennie", bio:"​From Wikipedia, the free encyclopedia.   \n\nCallum Keith Rennie (born 14 September 1960) is a Canadian television and film actor.  He started his career in Canadian film and television projects, where his portrayal of Stanley Raymond Kowalski in the TV series Due South was his first international success...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zOeA4IR4xYde2VlDsHZy2SoPZkc.jpg", url:"https://themoviedb.org/person/540"}}, {tmdbId:"95638", properties:{bornIn:"Mordiallic - Australia", imdbId:"0701561", born:date('1964-02-27'), name:"John Pyper-Ferguson", bio:"John Pyper-Ferguson  is an actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AiRGZDq2JZvmYyfLNMDt3FBAEhV.jpg", url:"https://themoviedb.org/person/95638"}}, {tmdbId:"49961", properties:{bornIn:"New York, City, New York, USA", imdbId:"0005502", born:date('1985-10-11'), name:"Michelle Trachtenberg", bio:"Michelle Christine Trachtenberg (born October 11, 1985) is an American television and film actress.  She is known for her roles as Dawn Summers in the television series Buffy the Vampire Slayer (2000–03) and as Georgina Sparks in Gossip Girl (2008–Present), and in the films Harriet the Spy (1996); Inspector Gadget (1999); EuroTrip (2004); Ice Princess (2005); Black Christmas (2006) and 17 Again (2009)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bWTWbd6tFiM8srgeU2uxVV08n59.jpg", url:"https://themoviedb.org/person/49961"}}, {tmdbId:"20814", properties:{bornIn:"Toronto, Ontario,  Canada", imdbId:"0808376", born:date('1983-07-06'), name:"Gregory Smith", bio:"Gregory Smith (born July 6, 1983) is an American-Canadian actor.  He began working as a child actor in the mid 1980s, initially appearing in a number of made-for-video and television films.  Smith has since appeared in several Hollywood films, and has become known for his role as Ephram Brown on the television series Everwood...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5qwhNXC5SZf3D7e1i6iNFvcp91P.jpg", url:"https://themoviedb.org/person/20814"}}, {tmdbId:"4938", properties:{imdbId:"0156345", born:date('1984-07-02'), name:"Vanessa Lee Chester", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/u5jWHnrCJO843KLHgkw1ZchbPOk.jpg", url:"https://themoviedb.org/person/4938"}}, {tmdbId:"93919", properties:{bornIn:"Kampala, Uganda", imdbId:"0449044", born:date('1948-01-01'), name:"Danny Keogh", bio:"Danny Keogh is a veteran actor whose work strongly ties itself to the theatre.  A native of South African, born in Uganda, Danny's theatrical career earned him numerous award nominations.  Danny's screen debut was in 1977 and since then added onto an extensive career spanning over 3 decades.  His most notable screen credits include the Clint Eastwood-directed film Invictus (2009) and the Sci-Fi trilogy-marker Starship Troopers 3: Marauder (2008)...", url:"https://themoviedb.org/person/93919"}}, {tmdbId:"107551", properties:{imdbId:"0787570", name:"Patrick Shai", url:"https://themoviedb.org/person/107551"}}, {tmdbId:"1139439", properties:{name:"Seputla Sebogodi", url:"https://themoviedb.org/person/1139439"}}, {tmdbId:"33718", properties:{bornIn:"Aldershot, Hampshire, England, UK", imdbId:"0642598", born:date('1931-05-05'), name:"Brian O'Shaughnessy", died:date('2001-07-14'), url:"https://themoviedb.org/person/33718"}}, {tmdbId:"2173", properties:{bornIn:"Santiago de Chile, Chile", imdbId:"0889926", born:date('1964-12-31'), name:"Valentina Vargas", bio:"From Wikipedia, the free encyclopedia\n\nValentina Vargas (born December 31, 1964) is a Chilean-born actress.  She developed most of her career in France, where she was raised. \n\nVargas began her career in the dramatic art within the workshop of Tania Balaschova in Paris and also later at the Yves Pignot School of Los Angeles...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/t9XsFATd4qw28KPTkjOZH7KZDmf.jpg", url:"https://themoviedb.org/person/2173"}}, {tmdbId:"73040", properties:{bornIn:"Liverpool - England - UK", imdbId:"0103208", born:date('1954-09-07'), name:"Doug Bradley", bio:"From Wikipedia, the free encyclopedia\n\nDouglas William \"Doug\" Bradley (born 7 September 1954) is an English actor best known for his roles in the Hellraiser film series...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tmJ2YlOAu6eifKSrNhhciWqVCAd.jpg", url:"https://themoviedb.org/person/73040"}}, {tmdbId:"55957", properties:{bornIn:"London, England", imdbId:"0154195", born:date('1975-01-01'), name:"Charlotte Chatton", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vhV0qc6leXokgUo0DnkpKYJIeCR.jpg", url:"https://themoviedb.org/person/55957"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"8853", properties:{bornIn:"White Plains - New York - USA", imdbId:"0906627", born:date('1928-06-22'), name:"Ralph Waite", bio:"From Wikipedia, the free encyclopedia\n\nRalph Waite (born June 22, 1928) is an American actor.  His most famous role may be John Walton Sr.  on the 1970s CBS TV series The Waltons, which he occasionally directed.  He is also well known for his portrayal of the slave ship first mate Slater in the mini-series Roots.  More recently, he appeared as Reverend Norman Balthus for 16 out of 24 episodes over the two seasons of the HBO series Carnivàle (2003–2005)...", died:date('2014-02-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9vZDzGZBytfRxY4e5RiwraC5UCJ.jpg", url:"https://themoviedb.org/person/8853"}}, {tmdbId:"160028", properties:{born:date('1944-11-12'), name:"Al Michaels", url:"https://themoviedb.org/person/160028"}}, {tmdbId:"133686", properties:{imdbId:"0098123", name:"Simon Bossell", url:"https://themoviedb.org/person/133686"}}, {tmdbId:"3059", properties:{bornIn:"Perth, Western Australia, Australia", imdbId:"0334886", born:date('1970-09-12'), name:"Pippa Grandison", bio:"From Wikipedia, the free encyclopedia. \n\nPippa Jody Grandison (born 12 September 1970 in Perth, Australia) is an Australian musical theatre performer.  She currently lives in Sydney, with husband Steve Le Marquand and daughter Charlie. \n\nDescription above from the Wikipedia article Pippa Grandison, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/3059"}}, {tmdbId:"83699", properties:{bornIn:"Loveland, Colorado, U.S.", imdbId:"0397445", born:date('1978-04-13'), name:"Kyle Howard", bio:"​From Wikipedia, the free encyclopedia.   \n\nKyle Alan Howard (born April 13, 1978) is an American film and television actor. \n\nDescription above from the Wikipedia article Kyle Howard, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bEpuGCBYeIoQeZkHXfnOV9dBaOb.jpg", url:"https://themoviedb.org/person/83699"}}, {tmdbId:"148114", properties:{imdbId:"0363954", name:"Herbert Russell", url:"https://themoviedb.org/person/148114"}}, {tmdbId:"30695", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0074834", born:date('1961-06-05'), name:"Mary Kay Bergman", bio:"​From Wikipedia, the free encyclopedia\n\nMary Kay Bergman (June 5, 1961 – November 11, 1999) was a well-known American voice artist, who was the lead female voice actress on South Park from the show's 1997 debut until her death. \n\nDescription above from the Wikipedia Mary Kay Bergman, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1999-11-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/heTLLKqi4g7QqFa2JtOfoOGNpWh.jpg", url:"https://themoviedb.org/person/30695"}}, {tmdbId:"173578", properties:{bornIn:"Santa Cruz - California - USA", imdbId:"0911897", born:date('1963-06-10'), name:"Tony Ward", bio:"Anthony Borden Ward aka Tony Ward was born in Santa Cruz, California on June 10, 1963 to Robert Borden Ward, from Kansas and Karen Elizabeth Castro of California.  Ward is the second of three sons and spent his childhood mostly in San Jose before moving to Sonora where he graduated from high school.  From there he moved to Los Angeles to pursue his dream of being an actor/model/dancer...", url:"https://themoviedb.org/person/173578"}}, {tmdbId:"1480846", properties:{imdbId:"0779450", name:"Kevin P. Scott", url:"https://themoviedb.org/person/1480846"}}, {tmdbId:"1480847", properties:{imdbId:"0425258", name:"Ivar Johnson", url:"https://themoviedb.org/person/1480847"}}, {tmdbId:"1077784", properties:{imdbId:"0013155", name:"Valerie M. Agnew", url:"https://themoviedb.org/person/1077784"}}, {tmdbId:"1702765", properties:{name:"Carrie Akre", url:"https://themoviedb.org/person/1702765"}}, {tmdbId:"83981", properties:{imdbId:"0024610", name:"Jeff Ament", url:"https://themoviedb.org/person/83981"}}, {tmdbId:"15440", properties:{bornIn:"London, England, UK", imdbId:"0364813", born:date('1961-08-24'), name:"Jared Harris", bio:"Jared Francis Harris (born 24 August 1961) is an English actor, well-known for his portrayal of Lane Pryce on the AMC series Mad Men...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mGODbYpkR1NKBOV3rtTfZ7EWoIl.jpg", url:"https://themoviedb.org/person/15440"}}, {tmdbId:"163951", properties:{imdbId:"0825784", name:"Margot Steinberg", url:"https://themoviedb.org/person/163951"}}, {tmdbId:"973", properties:{bornIn:"Putney, London, England", imdbId:"0002076", born:date('1966-09-25'), name:"Jason Flemyng", bio:"Jason Iain Flemyng (born 25 September 1966) is an English actor.  He is known for his film work, which has included roles in British films such as Lock, Stock and Two Smoking Barrels (1998) and Snatch (2000), both for Guy Ritchie, as well as Hollywood productions such as Rob Roy (1995) along with the Alan Moore comic book adaptations From Hell (2001) and The League of Extraordinary Gentlemen (2003).  He has also appeared in prominent roles in both theatre and television in the UK...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6E5KfjDwm00jIfN3LNLL9jZAvx3.jpg", url:"https://themoviedb.org/person/973"}}, {tmdbId:"77637", properties:{bornIn:"Cape Town, South Africa", imdbId:"0792029", born:date('1949-06-14'), name:"Antony Sher", bio:"Sir Antony Sher, KBE (born 14 June 1949) is an English actor of South African origin, a two-time Laurence Olivier Award winner and four-time nominee.  He joined the Royal Shakespeare Company in 1982 and toured in many roles, as well as appearing on film and TV, and working as a writer and theatre director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4FmJcwXYNvighmCKlEONy0py2VZ.jpg", url:"https://themoviedb.org/person/77637"}}, {tmdbId:"52951", properties:{bornIn:"Ilford, London, United Kingdom", imdbId:"0005137", born:date('1961-04-18'), name:"Jane Leeves", bio:"An English film, stage, and television actress, comedian and dancer.  Leeves made her screen debut with a small role in the 1983 popular British comedy television show Benny Hill Show, Leeves moved to the United States, where she performed in small roles until she secured a recurring part in the television sitcom Murphy Brown...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8IruLH6FPT4YPvlaivZbtYupWCb.jpg", url:"https://themoviedb.org/person/52951"}}, {tmdbId:"34901", properties:{bornIn:"Srinagar, Jammu and Kashmir, British India", imdbId:"0525921", born:date('1946-05-01'), name:"Joanna Lumley", bio:"An English actress, voice-over artist and author, best known for her roles in British television series \"Absolutely Fabulous\" portraying Edina Monsoon's best friend, Patsy Stone, as well as parts in \"The New Avengers\", \"Sapphire & Steel\", and \"Sensitive Skin\".  She is a former model and Bond girl.  Her distinctive voice has been supplied for animated characters, film narration, and AOL's \"You have email\" notification in the UK...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lOhYCDpgPsJNtctMPrPPcvIqwYs.jpg", url:"https://themoviedb.org/person/34901"}}, {tmdbId:"138560", properties:{imdbId:"0461025", name:"Nic Knight", url:"https://themoviedb.org/person/138560"}}] AS row
