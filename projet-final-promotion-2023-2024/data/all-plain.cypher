UNWIND [{tmdbId:"74227", properties:{bornIn:"Santa Monica - California  USA", imdbId:"2079681", born:date('2000-04-11'), name:"Morgan Lily", bio:"Morgan Lily (born April 11, 2000) is an American child actress and fashion child model.  She started modeling internationally at four years old and appeared in more than 21 television commercials, and many photo shoots before her role in Henry Poole Is Here as Millie Stupek.  Lily had supporting roles in He's Just Not That Into You, as Matthew Gray Gubler's daughter in Pornstar, and as Lilly Curtis in the apocalyptic film 2012...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bvSuq6yJstBeOSD0DpOtR2Cs8pC.jpg", url:"https://themoviedb.org/person/74227"}}, {tmdbId:"204505", properties:{imdbId:"2152695", born:date('2000-08-19'), name:"Trenton Rogers", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/68Spjxj8WnN7mNurFRExVU1tDGu.jpg", url:"https://themoviedb.org/person/204505"}}, {tmdbId:"1188569", properties:{imdbId:"1135678", name:"Will Clinger", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AtRQEsR5aSqZ64QD1jK7SAYaKAz.jpg", url:"https://themoviedb.org/person/1188569"}}, {tmdbId:"84678", properties:{bornIn:"Kingsland, Arkansas, U.S.", imdbId:"0143599", born:date('1932-02-26'), name:"Johnny Cash", bio:"From Wikipedia, the free encyclopedia. \n\nJohn R.  \"Johnny\" Cash (born J.  R.  Cash; February 26, 1932 – September 12, 2003) was an American singer-songwriter, actor, and author, who has been called one of the most influential musicians of the 20th century.  Although he is primarily remembered as a country music artist, his songs and sound spanned many other genres including rockabilly and rock and roll—especially early in his career—as well as blues, folk, and gospel...", died:date('2003-09-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8vIbqfss0GYh0ZgnfwE1ynzea6c.jpg", url:"https://themoviedb.org/person/84678"}}, {tmdbId:"76525", properties:{imdbId:"0066144", name:"Gerry Bednob", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aO2tNxVdnB8hVgTiK8BLW9TrKms.jpg", url:"https://themoviedb.org/person/76525"}}, {tmdbId:"438859", properties:{bornIn:"Bristol, England, UK", imdbId:"0114742", born:date('1946-05-06'), name:"Susan Brown", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rbi81V4GUsOqjUfLvnoHj4lIAMf.jpg", url:"https://themoviedb.org/person/438859"}}, {tmdbId:"1023482", properties:{imdbId:"1927126", name:"Alice da Cunha", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pcJiLN1iby7mAFNJVvygwLmWNZa.jpg", url:"https://themoviedb.org/person/1023482"}}, {tmdbId:"76789", properties:{bornIn:"Gorakhpur, India", imdbId:"0795661", born:date('1963-03-05'), name:"Saurabh Shukla", bio:"From Wikipedia, the free encyclopedia\n\nSaurabh Shukla is an Indian film and television actor, director and screenwriter. \n\nDescription above from the Wikipedia article Saurabh Shukla, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uFGVBmRIHLAQkYYSI2lSXOxMi4f.jpg", url:"https://themoviedb.org/person/76789"}}, {tmdbId:"72118", properties:{bornIn:"Mumbai, Maharashtra, India", imdbId:"0438463", born:date('1956-12-24'), name:"Anil Kapoor", bio:"Living in a Chawl in Tilak Nagar, Punjabi-speaking Anil was born in 1959 to Surinder and Nirmal aka Suchitra Kapoor.  He has an elder brother, Boney, a sister, Reena, and a younger brother, Sanjay.  His dad used to be Shammi Kapoor's Secretary. \n\nA loner, without many friends, he studied in the nearby O. L. P. S.  (Our Lady of Perpetual Succor) School, and was an ardent fan of Bollywood flicks that were telecast during the Ganesh Maha Utsav every year...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iYYkQCWaSReglEA0fD2OGb2Szxg.jpg", url:"https://themoviedb.org/person/72118"}}, {tmdbId:"76790", properties:{bornIn:"Srinagar, Jammu and Kashmir, India", imdbId:"0958861", born:date('1961-02-04'), name:"Rajendranath Zutshi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aJmWL08uj2oVGd2cJmBuzNSO2LY.jpg", url:"https://themoviedb.org/person/76790"}}, {tmdbId:"120356", properties:{bornIn:"Pittsburgh, Pennsylvania, USA", imdbId:"1089340", born:date('1972-01-01'), name:"Stacy Chbosky", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/m4A1RZc8GelxBufn9Ehqv7VcKZh.jpg", url:"https://themoviedb.org/person/120356"}}, {tmdbId:"120357", properties:{imdbId:"0582239", name:"Ben Messmer", url:"https://themoviedb.org/person/120357"}}, {tmdbId:"59061", properties:{bornIn:"Wandsworth, London, England, UK", imdbId:"0733490", born:date('1966-05-22'), name:"Samantha Robson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tLLRGZEXufQgC9LSTYxQa4tOjSf.jpg", url:"https://themoviedb.org/person/59061"}}, {tmdbId:"117598", properties:{bornIn:"St. Paul - Minnesota - USA", imdbId:"0111179", born:date('1947-01-10'), name:"Ivar Brogger", bio:"Ivar Brogger is an actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/g5SGHvfGKvNhCRBfjBXcaP9RKAO.jpg", url:"https://themoviedb.org/person/117598"}}, {tmdbId:"66914", properties:{bornIn:"Popayan, Cauca, Colombia", imdbId:"0136572", born:date('1977-04-25'), name:"Manolo Cardona", bio:"​From Wikipedia, the free encyclopedia.   \n\nManolo Cardona (born Manuel Julian Cardona Molano; April 25, 1977) is a Colombian actor. \n\nDescription above from the Wikipedia article Manolo Cardona, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9hPHLgO9lINwZynrFywTG9ms8Jl.jpg", url:"https://themoviedb.org/person/66914"}}, {tmdbId:"46364", properties:{bornIn:"Tokyo, Japan", imdbId:"1040419", born:date('1982-12-26'), name:"Shun Oguri", bio:"Shun Oguri is a Japanese actor, voice actor, and director most well-known for his roles in \"Rich Man, Poor Woman\", the \"Hana Yori Dango\" series, and the \"Crows Zero\" series.  He made his directorial debut with \"Surely Someday\" (2011)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4tfrhvqp3IGHPATor0lYE9X9UD3.jpg", url:"https://themoviedb.org/person/46364"}}, {tmdbId:"94017", properties:{bornIn:"Osaka, Japan", imdbId:"1092477", born:date('1973-11-12'), name:"Kyôsuke Yabe", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fLyj1b956OKGlwCcJOj1vwfCHXO.jpg", url:"https://themoviedb.org/person/94017"}}, {tmdbId:"94018", properties:{bornIn:"Nago, Okinawa Japan", imdbId:"1800338", born:date('1988-05-28'), name:"Meisa Kuroki", bio:"From Wikipedia, the free encyclopedia. \n\nSatsuki Shimabukuro (born May 28, 1988, height 5' 5\" (1,65 m)), better known by her stage name Meisa Kuroki is a Japanese actress, model and singer born in Nago, Okinawa, Japan.  She is represented by the agency Sweet Power and is signed to Sony Music Japan.  Among others, she has modeled for the popular Japanese fashion magazine JJ and is the current Japanese representative for Giorgio Armani...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tGtWHpb5vFrCDoW19PT5HZxcN6p.jpg", url:"https://themoviedb.org/person/94018"}}, {tmdbId:"44266", properties:{bornIn:" Palma de Mallorca, Mallorca, Spain", imdbId:"0767027", born:date('1979-06-29'), name:"Alejo Sauras", bio:"​From Wikipedia, the free encyclopedia.   \n\nAlejo Martín Sauras (born June 29, 1979 Palma de Mallorca, Mallorca, Spain) is Spanish actor who is best known as Raúl Martinez in Los Serrano. \n\nDescription above from the Wikipedia article  Alejo Martín Sauras, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mdqxyeniyvLw7pAH1VBA0PUJPf0.jpg", url:"https://themoviedb.org/person/44266"}}, {tmdbId:"44265", properties:{bornIn:"Madrid, Spain", imdbId:"0050787", born:date('1981-07-06'), name:"Elena Ballesteros", url:"https://themoviedb.org/person/44265"}}] AS row
