1128"}}, {tmdbId:"1133582", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"4582541", born:date('1942-07-10'), name:"Rodriguez", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cFxLnQIg146h6DOcVLXIvnW2rG9.jpg", url:"https://themoviedb.org/person/1133582"}}, {tmdbId:"1069644", properties:{bornIn:"Jackson, Mississippi, USA", imdbId:"4152547", born:date('1958-11-19'), name:"Julie Ann Doan", url:"https://themoviedb.org/person/1069644"}}, {tmdbId:"55082", properties:{imdbId:"1253950", name:"Yvonne Bezerra de Mello", url:"https://themoviedb.org/person/55082"}}, {tmdbId:"55083", properties:{imdbId:"1289413", name:"Sandro do Nascimento", bio:"From Wikipedia, the free encyclopedia\n\nSandro Rosa do Nascimento (July 7, 1978 - June 12, 2000) was the perpetrator of the Bus 174 hostage crisis in Jardim Botânico, Rio de Janeiro, Brazil.  Nascimento boarded a public bus, intending to rob the passengers.  However, the incident developed into a hostage situation, which was broadcast live by most Brazilian national television channels...", url:"https://themoviedb.org/person/55083"}}, {tmdbId:"52579", properties:{bornIn:"Rio de Janeiro, Rio de Janeiro, Brazil", imdbId:"1284081", name:"Rodrigo Pimentel", bio:"From Wikipedia, the free encyclopedia\n\nRodrigo Pimentel (born 1972) is a former member of BOPE, the elite group of the Brazilian Military Police.  He co-wrote both films of director José Padilha, The Elite Squad (Tropa de Elite) (based on a book he co-wrote with sociologist Luiz Eduardo Soares) and Bus 174 (Onibus 174).  Rodrigo Pimentel is also noted to have participated in the Brazilian documentary by João Moreira Salles, News From a Personal War (Noticias de uma Guerra Particular)...", url:"https://themoviedb.org/person/52579"}}, {tmdbId:"52578", properties:{bornIn:"Nova Friburgo, Rio de Janeiro", imdbId:"1284450", born:date('1954-03-12'), name:"Luiz Eduardo Soares", bio:"From Wikipedia, the free encyclopedia\n\nLuiz Eduardo Soares (March 12, 1954, Nova Friburgo, Rio de Janeiro), is a Brazilian anthropologist, philosopher and political scientist. \n\nDescription above from the Wikipedia article Luiz Eduardo Soares, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/52578"}}, {tmdbId:"67315", properties:{bornIn:"Taktser, Amdo, Tibet", imdbId:"0482730", born:date('1935-07-06'), name:"Tenzin Gyatso", bio:"Tenzin Gyatso, His Holiness, is the 14th Dalai Lama, the former head of state and spiritual leader of the people of Tibet.  He was awarded the Nobel Peace Prize in 1989...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ex0poiuSY5C3Iq3gpR14SQEGwRK.jpg", url:"https://themoviedb.org/person/67315"}}, {tmdbId:"941837", properties:{bornIn:"Harlem, Manhattan, New York City, New York, USA", imdbId:"0817491", born:date('1943-08-10'), name:"Ronnie Spector", bio:"From Wikipedia, the free encyclopedia\n\nRonnie Spector (born Veronica Yvette Bennett; August 10, 1943) is an American singer.  Spector was the lead singer of the rock/pop vocal girl group the Ronettes, who had a string of hits, such as \"Be My Baby\", \"Baby, I Love You\", and \"The Best Part of Breakin' Up\", during the early to mid–1960s.  Subsequently, Spector launched her solo career.  In 1968 she married Phil Spector, whose last name she took professionally.  The marriage ended in divorce in 1974...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hCBc1Xss3ve2K3MUeXVtXJaKoGB.jpg", url:"https://themoviedb.org/person/941837"}}, {tmdbId:"1591295", properties:{imdbId:"5902585", name:"Robert Huot", url:"https://themoviedb.org/person/1591295"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"115919", properties:{imdbId:"3011554", name:"Leif Edlund", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4kGG48o44uc2h6n2n6Xhy7lqSQj.jpg", url:"https://themoviedb.org/person/115919"}}, {tmdbId:"1163023", properties:{imdbId:"5530771", name:"Marcos Luna", url:"https://themoviedb.org/person/1163023"}}, {tmdbId:"57209", properties:{bornIn:"Thailand", imdbId:"0993109", born:date('1985-04-15'), name:"Bongkod Bencharongkul", url:"https://themoviedb.org/person/57209"}}, {tmdbId:"225573", properties:{bornIn:"Munich, Germany", imdbId:"0105751", born:date('1912-02-06'), name:"Eva Braun", bio:"Eva Anna Paula Braun was a photographer and the longtime companion of Adolf Hitler and, for fewer than 40 hours, his wife.  She met Hitler in Munich when she was a 17-year-old assistant and model for his personal photographer Heinrich Hoffmann...", died:date('1945-04-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qYADeqok5fU64c3R7phncimqsRY.jpg", url:"https://themoviedb.org/person/225573"}}, {tmdbId:"1219975", properties:{bornIn:"Mannheim, Germany", imdbId:"0817553", born:date('1905-03-19'), name:"Albert Speer", died:date('1981-09-01'), url:"https://themoviedb.org/person/1219975"}}, {tmdbId:"57493", properties:{imdbId:"1549745", name:"Daryl Isaacs", url:"https://themoviedb.org/person/57493"}}, {tmdbId:"57494", properties:{imdbId:"1655727", name:"Lisa Ganjhu", url:"https://themoviedb.org/person/57494"}}, {tmdbId:"57495", properties:{imdbId:"1659213", name:"Stephen Siegel", url:"https://themoviedb.org/person/57495"}}, {tmdbId:"940339", properties:{bornIn:"Hong Kong, British Crown Colony [now China]", imdbId:"0490513", born:date('1964-02-16'), name:"Lau Ching-Wan", bio:"Lau Ching-Wan (Chinese: 劉青雲; born February 16, 1964) is a Hong Kong Film Award winning and Golden Bauhinia Award winning film and former television actor based in Hong Kong.  Lau was born in Hong Kong in 1964.  He joined the TVB acting classes in 1983 and made his first appearance on TV the following year with TV drama Draw Out the Rainbow...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yzEx86TPAFCqeLd3uEbX5i3vTXP.jpg", url:"https://themoviedb.org/person/940339"}}, {tmdbId:"57609", properties:{bornIn:"Hong Kong, British Crown Colony [now China]", imdbId:"0950757", born:date('1950-09-02'), name:"Yuen Wah", bio:"Yuen Wah (born 2 September 1950) is a Hong Kong based Chinese action film actor, action choreographer, stuntman and martial artist who has appeared in over 160 films and over 20 television series...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yMkMgs0tWlJXdTjYkiMcjvhYnRw.jpg", url:"https://themoviedb.org/person/57609"}}, {tmdbId:"57893", properties:{bornIn:"Long Island, New York City, New York, USA", imdbId:"1211485", born:date('1994-11-17'), name:"Raquel Castro", bio:"​From Wikipedia, the free encyclopedia.   \n\nRaquel Castro (born November 17, 1994) is an American teen actress.  She is best known for her role in the 2004 film Jersey Girl as Gertie Trinké, the daughter of Ollie Trinké (Ben Affleck) and Gertrude Steiney (Jennifer Lopez), the role for which Castro won the Young Artist Award for the Best Performance in a Feature Film - Young Actress Age Ten or Younger.  She is a contestant in the American version of The Voice...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cYCgqZp1GKLNrZqcewpxlmw0F3k.jpg", url:"https://themoviedb.org/person/57893"}}, {tmdbId:"116277", properties:{bornIn:"Lima, Peru", imdbId:"2036142", born:date('1985-03-03'), name:"Nathalie Kelley", bio:"Nathalie Kelley (born 3 March 1985) is a Peruvian-born Australian actress, most notable for playing Neela in The Fast and the Furious: Tokyo Drift in 2006, along with her appearance in the music video of Bruno Mars's 2010 single \"Just the Way You Are\". \n\nDescription above from the Wikipedia article Nathalie Kelley, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wawAz251CPJelmOVwTeNvjrYnqO.jpg", url:"https://themoviedb.org/person/116277"}}, {tmdbId:"58604", properties:{bornIn:"Tokyo, Japan", imdbId:"1071413", born:date('1972-02-19'), name:"Nao Ōmori", bio:"Nao Ōmori is a Japanese actor, with his most notable role as Ichi in Ichi the Killer directed by Takashi Miike.  He is the son of Japanese actor Akaji Maro.  Nao is sometimes credited under the name Nao Ohmori.  He was given the Best Supporting Actor award at the 2004 Yokohama Film Festival...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/f30qq6dF2T2S7zkxM2gWwCCZc78.jpg", url:"https://themoviedb.org/person/58604"}}, {tmdbId:"58857", properties:{imdbId:"0350398", name:"Tencho Gyalpo", url:"https://themoviedb.org/person/58857"}}, {tmdbId:"47434", properties:{imdbId:"0701408", born:date('1950-07-31'), name:"Aleksandr Pyatkov", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/y0wX7SzaZTqCMAttC4fWWuLH43F.jpg", url:"https://themoviedb.org/person/47434"}}, {tmdbId:"161495", properties:{imdbId:"0106757", name:"Paulette Breen", url:"https://themoviedb.org/person/161495"}}] AS row
