UNWIND [{tmdbId:"64129", properties:{imdbId:"0516779", name:"Peter Locke", url:"https://themoviedb.org/person/64129"}}, {tmdbId:"73782", properties:{imdbId:"0341045", born:date('1923-11-05'), name:"Russ Grieve", died:date('1980-10-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6JS1P9EgCcLr5hIiUN1KKFDeFeG.jpg", url:"https://themoviedb.org/person/73782"}}, {tmdbId:"863", properties:{bornIn:"Burlington, Vermont, USA", imdbId:"0004730", born:date('1928-07-22'), name:"Orson Bean", bio:"From Wikipedia, the free encyclopedia\n\nOrson Bean (born Dallas Frederick Burrows; July 22, 1928 – February 7, 2020) was an American film, television, and stage actor, as well as a comedian, writer, and producer.  He appeared frequently on televised game shows from the 1960s through the 1980s and was a longtime panelist on the television game show To Tell the Truth...", died:date('2020-02-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2iz769YdycczgnGPZyXNsaN3TGR.jpg", url:"https://themoviedb.org/person/863"}}, {tmdbId:"101779", properties:{bornIn:"Sebastopol, California, USA", imdbId:"0884259", born:date('1947-05-25'), name:"Karen Valentine", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jkldO5b7PgosoLorzFwJdksDCEJ.jpg", url:"https://themoviedb.org/person/101779"}}, {tmdbId:"4965", properties:{bornIn:"Miami, Gila, Arizona, USA", imdbId:"0001181", born:date('1920-11-13'), name:"Jack Elam", bio:"From Wikipedia, the free encyclopedia\n\nWilliam Scott \"Jack\" Elam (November 13, 1918 – October 20, 2003) was an American film actor best known for his numerous roles as villains in Western films. \n\nDescription above from the Wikipedia article Jack Elam, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2003-10-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8GtBinhIcMiG0H0dQXXxEfBK1iG.jpg", url:"https://themoviedb.org/person/4965"}}, {tmdbId:"73595", properties:{bornIn:"Borgvattnet, Sweden", imdbId:"0084917", born:date('1928-09-22'), name:"Halvar Björk", bio:"Erik Halvar Bertil Björk was a Swedish stage and screen actor...", died:date('2000-11-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nZZ4MlcrBK2i4mZwaxuYMGMKJ7Q.jpg", url:"https://themoviedb.org/person/73595"}}, {tmdbId:"45471", properties:{bornIn:"Pine Bluff, Arkansas, USA", imdbId:"0444169", born:date('1947-07-20'), name:"Camille Keaton", bio:"An actress, known for I Spit on Your Grave (1978), I Spit on Your Grave: Deja Vu (2019) and Savage Vengance (1993).  She was previously married to Sidney Luft and Meir Zarchi...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/t9fgW40ubqngWak2CY3zPkyFQX4.jpg", url:"https://themoviedb.org/person/45471"}}, {tmdbId:"93412", properties:{imdbId:"0846036", name:"Eron Tabor", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/swtQNCLZezjVaMfg5aSYfobT3I.jpg", url:"https://themoviedb.org/person/93412"}}, {tmdbId:"93413", properties:{imdbId:"0655162", name:"Richard Pace", url:"https://themoviedb.org/person/93413"}}, {tmdbId:"1066964", properties:{imdbId:"0629534", name:"Anthony Nichols", url:"https://themoviedb.org/person/1066964"}}, {tmdbId:"15048", properties:{bornIn:"Dallas, Texas, USA", imdbId:"0000913", born:date('1956-01-21'), name:"Robby Benson", bio:"From Wikipedia, the free encyclopedia. \n\nRobby Benson (born January 21, 1956) is an American film and television actor, television director, educator and singer. \n\nDescription above from the Wikipedia article Robby Benson, licensed under CC-BY-SA, full list of contributors on Wikipedia. ​\n\nHe is best known for the films he's in Including Ice Castles 1978, Beauty and the Beast 1991 as the Beast.  He also voiced Prince Alexander in King's Quest VI Heir Today Gone Tomorrow 1992...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1hegCKexgyiaFZaNMnHADbeHM0T.jpg", url:"https://themoviedb.org/person/15048"}}, {tmdbId:"10502", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0000468", born:date('1958-12-13'), name:"Lynn-Holly Johnson", bio:"Lynn-Holly Johnson (born December 13, 1958) is an American professional ice skater and actress.  After achieving some success as a figure skater in the mid 1970s, she began an acting career, including a Golden Globe-nominated role in 1978's Ice Castles. \n\nSource: http://en. wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/piHnd0bAOYXhAT8ABekqDaR5ggq.jpg", url:"https://themoviedb.org/person/10502"}}, {tmdbId:"10559", properties:{bornIn:"Montréal, Québec, Canada", imdbId:"0223157", born:date('1924-06-03'), name:"Colleen Dewhurst", bio:"​From Wikipedia, the free encyclopedia.   \n\nColleen Rose Dewhurst (June 3, 1924 — August 22, 1991) was a Canadian-American actress known for a while as \"the Queen of Off-Broadway. \" In her autobiography, Dewhurst wrote: \"I had moved so quickly from one Off-Broadway production to the next that I was known, at one point, as the 'Queen of Off-Broadway'.  This title was not due to my brilliance but rather because most of the plays I was in closed after a run of anywhere from one night to two weeks...", died:date('1991-08-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rrUNC8d6lbIrZm4yCHS39bLDtL1.jpg", url:"https://themoviedb.org/person/10559"}}, {tmdbId:"13022", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0000297", born:date('1949-05-31'), name:"Tom Berenger", bio:"Tom Berenger is an American television and motion picture actor.  He was nominated for the Academy Award for Best Supporting Actor for his portrayal of Staff Sergeant Bob Barnes in Platoon.  He is also known for playing Jake Taylor in the Major League films and Thomas Beckett in the Sniper films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zLxzAdAfu7y02yEx29JSLDgXJZ4.jpg", url:"https://themoviedb.org/person/13022"}}, {tmdbId:"4160", properties:{bornIn:"St. Thomas, Ontario, Canada", imdbId:"0001726", born:date('1951-02-24'), name:"Helen Shaver", bio:"Helen Shaver is a Canadian stage, film and television actress and director.  She attended the Banff School of Fine Arts and studied Acting at the University of Victoria, British Columbia, Canada...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7DlGkBDdRcKPlPAXuoo6xz6hSAU.jpg", url:"https://themoviedb.org/person/4160"}}, {tmdbId:"164343", properties:{bornIn:"Odessa - Texas - USA", imdbId:"0341562", born:date('1953-09-07'), name:"Kristin Griffith", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dZ9IznYzRNazUFftHoAcsfUDJ2z.jpg", url:"https://themoviedb.org/person/164343"}}, {tmdbId:"54782", properties:{bornIn:"Marshalltown, Iowa, USA", imdbId:"0002148", born:date('1948-09-26'), name:"Mary Beth Hurt", bio:"Mary Beth Hurt (née Supinger; born September 26, 1946) is an American actress of stage and screen.  For her work on Broadway, she has been nominated for three Tony Awards.  She was previously married to actor William Hurt, and since 1982 she has been married to filmmaker Paul Schrader...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kX58VOb6a5c4kmjfCIudcWqU24H.jpg", url:"https://themoviedb.org/person/54782"}}, {tmdbId:"4785", properties:{bornIn:"Pittsburgh, Pennsylvania, USA", imdbId:"0000156", born:date('1952-10-22'), name:"Jeff Goldblum", bio:"Jeffrey Lynn \"Jeff\" Goldblum (born October 22, 1952) is an American actor.  His career began in the mid-1970s and he has appeared in major box-office successes including The Fly, Jurassic Park and its sequel Jurassic Park: The Lost World, and Independence Day.  He starred as Detective Zach Nichols for the eighth and ninth seasons of the USA Network's crime drama series Law & Order: Criminal Intent...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/m8p62pvkVtPxkfAIJhb5AgGw8kA.jpg", url:"https://themoviedb.org/person/4785"}}, {tmdbId:"5047", properties:{bornIn:"Bristol, England, UK", imdbId:"0001021", born:date('1949-04-20'), name:"Veronica Cartwright", bio:"Veronica Cartwright (born 20 April 1949) is an English-born actress who has worked mainly in American film and television...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7OLtjaTuuZYv6H0cl14StxTZSPu.jpg", url:"https://themoviedb.org/person/5047"}}, {tmdbId:"6769", properties:{bornIn:"West Hartford, Connecticut, U.S.", imdbId:"0556217", born:date('1929-03-13'), name:"Joseph Mascolo", bio:"From Wikipedia, the free encyclopedia. \n\nJoseph Mascolo (born March 13, 1929) is an American musician and dramatic actor.  During his long career, he has acted in numerous motion pictures and television series.  He is best known for playing Stefano DiMera, a role he originated in 1982 on NBC's long running Days of our Lives...", died:date('2016-12-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1RPKwBlQDGGp3WyDx2hPz1ULXp9.jpg", url:"https://themoviedb.org/person/6769"}}] AS row
