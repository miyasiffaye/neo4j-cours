UNWIND [{tmdbId:"13242", properties:{bornIn:"New Haven, Connecticut, USA", imdbId:"0316079", born:date('1967-06-06'), name:"Paul Giamatti", bio:"Paul Edward Valentine Giamatti (born June 6, 1967) is an American actor.  Giamatti began his career as a supporting actor in several commercially successful and critically acclaimed films produced during the 1990s including Private Parts, The Truman Show, Saving Private Ryan, The Negotiator, and Man on the Moon, before earning lead roles in several projects in the 2000s including American Splendor, Sideways, Cinderella Man, The Illusionist, John Adams, Cold Souls, and Barney's Version...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wbrVVJRr5TwhDZuvijBgOorzcAb.jpg", url:"https://themoviedb.org/person/13242"}}, {tmdbId:"12834", properties:{bornIn:"Cambell River - British Columbia - Canada", imdbId:"0001608", born:date('1970-04-04'), name:"Barry Pepper", bio:"Barry Robert Pepper is a Canadian actor.  He is best known for roles such as Private Daniel Jackson in Saving Private Ryan, Sergeant Michael Strank in Flags of Our Fathers, Dean Stanton in The Green Mile, Roger Maris in 61*, \"Lucky\" Ned Pepper in True Grit and Jonnie Goodboy Tyler in Battlefield Earth.  He has been nominated for three Screen Actors Guild Awards and a Golden Globe Award.  In 2011, for his role as Robert F...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pmdNUqrpsoozh7QYqUgEgZQ69cA.jpg", url:"https://themoviedb.org/person/12834"}}, {tmdbId:"154224", properties:{bornIn:"Queens, New York City, New York, USA", imdbId:"0779126", born:date('1953-04-13'), name:"Esther Scott", bio:"Esther Scott is an actress...", died:date('2020-02-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xWAL0RdURZqEIJppQWOiKXSF73G.jpg", url:"https://themoviedb.org/person/154224"}}, {tmdbId:"15453", properties:{bornIn:"Glendale, California, USA", imdbId:"0750468", born:date('1951-02-24'), name:"Debra Jo Rupp", bio:"Debra Jo Rupp is an American stage, film and television actress, best known for playing Kitty Forman on the television sitcom \"That '70s Show\".  She's a graduate in Drama from the University of Rochester, New York, USA...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9Ctz7eHGE1TSxELdxAUztp9Gt3t.jpg", url:"https://themoviedb.org/person/15453"}}, {tmdbId:"1572975", properties:{imdbId:"2864565", name:"Walker Jones", url:"https://themoviedb.org/person/1572975"}}, {tmdbId:"49818", properties:{bornIn:"San Fernando Valley, California, USA", imdbId:"0005283", born:date('1966-10-06'), name:"Jacqueline Obradors", bio:"Jacqueline Danell Obradors (born October 6, 1966) is an American actress. \n\nObradors was born in San Fernando Valley, California to Argentine immigrants Angie, a church worker, and Albert Obradors, an office cleaning business owner.  Before becoming an actress, Jaqueline was a cashier at Hughes Market (now Ralphs) in Canoga Park, California...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dnpJYaQT1Xy8J3EjBfVKGn69kEy.jpg", url:"https://themoviedb.org/person/49818"}}, {tmdbId:"1456300", properties:{imdbId:"0918934", name:"Bryna Weiss", bio:"Bryna Weiss is an American actress of stage, screen and television...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nsha5J8yFJfOhKjO0IMYv08c7BE.jpg", url:"https://themoviedb.org/person/1456300"}}, {tmdbId:"64710", properties:{imdbId:"0138840", born:date('1983-04-18'), name:"Reeve Carney", bio:"Reeve Jefferson Carney (born April 18, 1983) is an American singer-songwriter and actor most known for originating the role of Peter Parker/Spider-Man in Spider-Man: Turn Off the Dark on Broadway and playing Orpheus in the Original Broadway Cast of “Hadestown. ” He also played Dorian Gray in the Showtime series Penny Dreadful and Riff Raff in the Fox musical television film The Rocky Horror Picture Show: Let's Do the Time Warp Again...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wCiv5ExvZLO1YqOTu5Ydmv4gTkv.jpg", url:"https://themoviedb.org/person/64710"}}, {tmdbId:"43662", properties:{bornIn:"Setagaya, Tokyo", imdbId:"0840551", born:date('1987-04-27'), name:"Anne Suzuki", bio:"From Wikipedia, the free encyclopedia. \n\nAnne Suzuki ((born April 27, 1987) is a Japanese actress. \n\nA model since the age of three, she got an early break in her acting career at 12 when she starred in the Hollywood film Snow Falling on Cedars with Ethan Hawke.  She was next featured in the action movie Returner opposite Takeshi Kaneshiro, and won the Best New Actor at the 26th Japan Academy Awards.  She could also be seen in Hana and Alice, a film from director Shunji Iwai, and Juvenile...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5Q7QgYX8jsf1GTVMWCpv2zVeyLE.jpg", url:"https://themoviedb.org/person/43662"}}, {tmdbId:"22290", properties:{bornIn:"New York City - New York - USA", imdbId:"0005447", born:date('1982-06-10'), name:"Leelee Sobieski", bio:"Liliane Rudabet Gloria Elsveta Sobieski (born June 10, 1982), known professionally as Leelee Sobieski, is an American actress.  Sobieski achieved recognition in her mid-teens for her performance in the 1998 film Deep Impact.  She received an Emmy nomination for the 1999 TV movie Joan of Arc, and two Golden Globe nominations for Joan of Arc and the 2001 TV movie Uprising...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/py4vzuKIdYxV4op7drQxBAZZ8UL.jpg", url:"https://themoviedb.org/person/22290"}}, {tmdbId:"41557", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0139936", born:date('1974-08-06'), name:"Ever Carradine", bio:"Ever Dawn Carradine (born August 6, 1974) is an American actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9YoBSS1ny6BeEqCTGJLtEFWTuXx.jpg", url:"https://themoviedb.org/person/41557"}}, {tmdbId:"1034545", properties:{imdbId:"2993833", name:"Stephanie Chang", url:"https://themoviedb.org/person/1034545"}}, {tmdbId:"1034546", properties:{imdbId:"0534017", name:"Neal MacMillan", url:"https://themoviedb.org/person/1034546"}}, {tmdbId:"91849", properties:{imdbId:"0365421", born:date('1926-07-05'), name:"Viola Harris", died:date('2017-08-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eofEvaoELwoaXK52mHzBYdSC2Dk.jpg", url:"https://themoviedb.org/person/91849"}}, {tmdbId:"8767", properties:{bornIn:"Mount Vernon, Washington, USA", imdbId:"0001029", born:date('1968-09-26'), name:"Jim Caviezel", bio:"James Patrick Caviezel (born September 26, 1968) is an American actor.   Caviezel portrayed Jesus Christ in Mel Gibson's The Passion of the Christ (2004) and starred as John Reese on the CBS science-fiction crime drama series Person of Interest (2011-2016).   Caviezel's other notable roles include Private Witt in The Thin Red Line (1998), Detective John Sullivan in Frequency (2000), and Edmond Dantès in The Count of Monte Cristo (2002)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3dwavYsGYA6zzzipfdLIHbudIZW.jpg", url:"https://themoviedb.org/person/8767"}}, {tmdbId:"93396", properties:{bornIn:"Montreal, Quebec, Canada", imdbId:"0862932", born:date('1979-09-26'), name:"Jacob Tierney", bio:"Jacob Daniel Tierney (born September 26, 1979) is a Canadian actor, film director and screenwriter. \n\nTierney was born in Montreal, Quebec, the son of veteran producer Kevin Tierney.  He starred in the 1993 film Josh and S. A. M...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hg9JQWSfGryfIox8Z9b9NP8Yb1b.jpg", url:"https://themoviedb.org/person/93396"}}, {tmdbId:"63361", properties:{imdbId:"0212610", name:"Moira Deady", url:"https://themoviedb.org/person/63361"}}, {tmdbId:"1010073", properties:{imdbId:"0428965", name:"Osheen Jones", url:"https://themoviedb.org/person/1010073"}}, {tmdbId:"1185604", properties:{bornIn:"San Giuliano Milanese, Italy", imdbId:"0195083", born:date('1958-01-01'), name:"Dario D'Ambrosi", url:"https://themoviedb.org/person/1185604"}}, {tmdbId:"11155", properties:{bornIn:"Baltimore, Maryland, USA", imdbId:"0005048", born:date('1969-02-22'), name:"Thomas Jane", bio:"Thomas Jane (born Thomas Elliott III; February 22, 1969) is an American actor, known for his roles in the 1999 film Deep Blue Sea, the 2001 TV movie 61*, the 2004 film The Punisher and the 2007 Stephen King adaptation The Mist.  He currently stars in the HBO comedy-drama series Hung. \n\nDescription above from the Wikipedia article Thomas Jane, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9frnlc2zoDcoeqZALB6aeYSQddl.jpg", url:"https://themoviedb.org/person/11155"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"58692", properties:{bornIn:"Nicosia - Cyprus", imdbId:"0569927", born:date('1963-10-25'), name:"Melinda McGraw", bio:"​From Wikipedia, the free encyclopedia.   \n\nMelinda Leigh McGraw (born October 25, 1963) is an American actress.  She has starred in movies such as Albino Alligator (1996), Wrongfully Accused (1998), and Nutty Professor II: The Klumps (2000), and is also known for her television performances on The Commish, The X-Files and Mad Men...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/thG0lL7maozskCZHaa5iK4gBgg7.jpg", url:"https://themoviedb.org/person/58692"}}, {tmdbId:"12214", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0000096", born:date('1968-08-09'), name:"Gillian Anderson", bio:"Gillian Leigh Anderson (born August 9, 1968) is an American actress.  After beginning her career in theatre, Anderson achieved international recognition for her role as Special Agent Dana Scully on the American television series The X-Files.  Her film work includes The House of Mirth (2000), The Mighty Celt (2005), The Last King of Scotland (2006), and two X-Files films, The X-Files (1998) and The X-Files: I Want to Believe (2008)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5emeOf49lM2WSs4rc186Wc9Zgs3.jpg", url:"https://themoviedb.org/person/12214"}}, {tmdbId:"12643", properties:{bornIn:"\tToronto, Ontario, Canada", imdbId:"0205657", born:date('1938-01-13'), name:"William B. Davis", bio:"William Bruce Davis (born January 13, 1938) is a Canadian actor, known for his role as The Smoking Man on The X-Files.  He has also appeared in Stargate SG-1 as Damaris, a Prior of the Ori and as Mayor Tate on Smallville.  Most recently he has appeared in FOX's Human Target as an aging mobster. \n\nDavis was born in Toronto, Ontario, to an attorney father and psychologist mother.  In 1959, he graduated from the University of Toronto with a B. A.  in philosophy...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/b4imZtShd4kK6xFu2ccuPd0fqXA.jpg", url:"https://themoviedb.org/person/12643"}}, {tmdbId:"21165", properties:{bornIn:"Huntsville, Alabama, USA", imdbId:"0225332", born:date('1965-06-18'), name:"Kim Dickens", bio:"Kimberly Jan \"Kim\" Dickens (born June 18, 1965) is an American actress and model...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eaJky5Q6X51u0bnQkXyOrM8RnlG.jpg", url:"https://themoviedb.org/person/21165"}}, {tmdbId:"1298629", properties:{imdbId:"0340965", name:"Ralph Grierson", url:"https://themoviedb.org/person/1298629"}}, {tmdbId:"1140257", properties:{imdbId:"0061513", born:date('1948-08-13'), name:"Kathleen Battle", url:"https://themoviedb.org/person/1140257"}}, {tmdbId:"33196", properties:{bornIn:"Fort Collins, Colorado, U.S.", imdbId:"0005157", born:date('1989-03-05'), name:"Jake Lloyd", bio:"Jake Lloyd (born March 5, 1989) is a former American actor, who gained worldwide fame when he was chosen by George Lucas to play the young Anakin Skywalker in Star Wars Episode I: The Phantom Menace, the first film in the Star Wars prequel trilogy.  He reprised this role in five subsequent Star Wars video games.  Lloyd is also known for his recurring roles as Jimmy Sweet in ER, and Young Angelo in The Pretender.  He previously guest starred in the show as a character named Ronny Collins...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tp5PRiy8Ip8Vs70pUY1jeHbk2wH.jpg", url:"https://themoviedb.org/person/33196"}}, {tmdbId:"9657", properties:{bornIn:"Paterson, New Jersey, USA", imdbId:"0911320", born:date('1964-11-14'), name:"Patrick Warburton", bio:"From Wikipedia, the free encyclopedia. \n\nPatrick John Warburton (born November 14, 1964) is an American actor of television, film, and voice.  He is best known for his several TV roles, including the title role of The Tick, David Puddy on Seinfeld, the evil Johnny Johnson on NewsRadio, and anchorman Jeb Denton on Less Than Perfect...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eLqDtbFYmlTxov9vT9Dwldn839v.jpg", url:"https://themoviedb.org/person/9657"}}, {tmdbId:"1196242", properties:{imdbId:"1343450", name:"James B. Schwartz", url:"https://themoviedb.org/person/1196242"}}, {tmdbId:"1196243", properties:{imdbId:"0956729", name:"John Zimmerman", url:"https://themoviedb.org/person/1196243"}}, {tmdbId:"17244", properties:{bornIn:"Vancouver, British Columbia", imdbId:"0159789", born:date('1981-04-19'), name:"Hayden Christensen", bio:"Hayden Christensen (born April 19, 1981) is a Canadian actor.  He appeared in Canadian television programs when he was young, then diversified into American television in the late 1990s.  He moved on to minor acting roles before being praised for his role of Sam in Life as a House, for which he was nominated for a Golden Globe Award and Screen Actors Guild Award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/frtBolrtT4Nmweroyj9cCSjrxlb.jpg", url:"https://themoviedb.org/person/17244"}}, {tmdbId:"27762", properties:{bornIn:"Carnoustie, Tayside, Scotland, UK", imdbId:"0001519", born:date('1944-08-11'), name:"Ian McDiarmid", bio:"Ian McDiarmid is a Scottish actor and director best known for portraying Emperor Palpatine in the Star Wars film series.  He has received an Olivier Award for Best Actor and a Tony Award for Best Featured Actor in a Play for his performances...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cqEAblt0KJRIGyMXhj5OM5WJ9SN.jpg", url:"https://themoviedb.org/person/27762"}}, {tmdbId:"130840", properties:{bornIn:"Pittsburgh - Pennsylvania - USA", imdbId:"0752876", born:date('1962-08-01'), name:"Thomas Jay Ryan", bio:"Thomas Jay Ryan is an actor...", url:"https://themoviedb.org/person/130840"}}, {tmdbId:"58528", properties:{bornIn:"Bayonne - New Jersey - USA", imdbId:"0881672", born:date('1963-09-17'), name:"James Urbaniak", bio:"From Wikipedia, the free encyclopedia. \n\nJames Christian Urbaniak (born September 17, 1963) is an American actor.  Urbaniak was born in Bayonne, New Jersey.  He lives in Santa Monica, California with his wife Julie and their twins, son Severn Jerzy and daughter Esme Maeve. \n\nOne of his first noteworthy roles was in the avant-garde playwright/director Richard Foreman's The Universe, for which Urbaniak won an Obie...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zWC9vbcSK1Yl6EDPQZxjvWDslAb.jpg", url:"https://themoviedb.org/person/58528"}}, {tmdbId:"189458", properties:{imdbId:"0692216", name:"Maria Porter", url:"https://themoviedb.org/person/189458"}}, {tmdbId:"212", properties:{bornIn:"Atlanta - Georgia - USA", imdbId:"0189144", born:date('1964-04-04'), name:"David Cross", bio:"David Cross (born April 4, 1964) is an American actor, writer and stand-up comedian perhaps best known for his work on HBO's sketch comedy series Mr.  Show and for his role as Tobias Fünke in the Fox sitcom Arrested Development.  Cross currently stars in The Increasingly Poor Decisions of Todd Margaret and recently had a recurring role in the 2010 FOX sitcom Running Wilde...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/psU22y9yP3uheVc4LWeHjLkeqEM.jpg", url:"https://themoviedb.org/person/212"}}, {tmdbId:"177872", properties:{imdbId:"0932971", born:date('1968-07-17'), name:"Alexandra Wilson", url:"https://themoviedb.org/person/177872"}}, {tmdbId:"1219959", properties:{imdbId:"0861538", name:"James Thornton", url:"https://themoviedb.org/person/1219959"}}, {tmdbId:"1120", properties:{bornIn:"Nottingham, England", imdbId:"0416694", born:date('1965-10-11'), name:"Lennie James", bio:"Lennie James (born 11 October 1965) is an English actor and playwright. \n\nDescription above from the Wikipedia article Lennie James, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hfZrdEkBHxYYbMoGHAaVomlgMi.jpg", url:"https://themoviedb.org/person/1120"}}, {tmdbId:"5900", properties:{bornIn:"Leicestershire, England, UK", imdbId:"0935659", born:date('1964-05-01'), name:"Maurice Dean Wint", bio:"Born in Leicestershire, England, Wint immigrated to Canada 1967.  Wint is an stage, screen, and voice actor best known for The Cube...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6ayQI1h5gbxvZGrrVMzbehFQQMh.jpg", url:"https://themoviedb.org/person/5900"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"5892", properties:{bornIn:"Redhill, Surrey, England, UK", imdbId:"0382110", born:date('1968-04-18'), name:"David Hewlett", bio:"David Ian Hewlett (born April 18, 1968) is an English-born Canadian actor best known for his role as Dr.  Meredith Rodney McKay on the science fiction television shows Stargate SG1 and Stargate Atlantis. \n\nDescription above from the Wikipedia article David Hewlett, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hUcYyssAPCqnZ4GjolhOWXHTWSa.jpg", url:"https://themoviedb.org/person/5892"}}, {tmdbId:"5889", properties:{bornIn:"Montréal, Québec, Canada", imdbId:"0309914", name:"Nicky Guadagni", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qJCelkMEFOa86LC0xTPF8m9p5Rf.jpg", url:"https://themoviedb.org/person/5889"}}, {tmdbId:"31167", properties:{bornIn:"Los Angeles, California, U.S.", imdbId:"0593310", born:date('1970-03-27'), name:"Elizabeth Mitchell", bio:"Elizabeth Joanna Mitchell (née Robertson; born March 27, 1970), is an American actress who is known for her roles as Dr.  Juliet Burke on ABC's TV series Lost  and as FBI agent Erica Evans on V.  She has starred such films as The Santa Clause 2, The Santa Clause 3: The Escape Clause and Gia.  Mitchell currently co-stars in Eric Kripke's television series Revolution, airing on NBC. \n\nHer stepfather, Joseph Day Mitchell, and mother, Josephine Marian Mitchell (née Jenkins), are lawyers based in Dallas...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tpagVmiCbOQ8CPiRxF5MuZGfZGV.jpg", url:"https://themoviedb.org/person/31167"}}, {tmdbId:"83051", properties:{bornIn:"Sacramento, California, United States", imdbId:"0170541", born:date('1977-09-21'), name:"Eric Michael Cole", bio:"From Wikipedia, the free encyclopedia. \n\nEric Michael Cole (born September 21, 1976) is an American actor, producer and editor. \n\nDescription above from the Wikipedia article Eric Michael Cole, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v2eLFJQ0TOAFvGwCr2T1Y4dMOJt.jpg", url:"https://themoviedb.org/person/83051"}}, {tmdbId:"116321", properties:{bornIn:"Chigasaki, Kanagawa Prefecture, Japan", imdbId:"0353717", born:date('1971-08-21'), name:"Masato Hagiwara", bio:"From Wikipedia, the free encyclopedia. \n\nMasato Hagiwara (born August 21, 1971 in Kanagawa, Japan) is a Japanese actor.  He is employed by Alpha Agency. \n\nDescription above from the Wikipedia article Masato Hagiwara, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zxZ2SYm4n5AT1wxi1W0EtMcxBJ5.jpg", url:"https://themoviedb.org/person/116321"}}, {tmdbId:"137026", properties:{bornIn:"Tokyo, Japan", imdbId:"0880299", born:date('1957-09-18'), name:"Tsuyoshi Ujiki", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/b1LQzwzIVb4qzQ6chQfsElg5CtF.jpg", url:"https://themoviedb.org/person/137026"}}, {tmdbId:"115910", properties:{bornIn:"Suginami, Tokyo, Japan", imdbId:"0619953", born:date('1965-08-30'), name:"Anna Nakagawa", bio:"​From Wikipedia, the free encyclopedia.   \n\nAnna Nakagawa, real name Anna Kuriyama (born August 30, 1965 in Suginami, Tokyo, Japan) was a Japanese actress.  She won the award for best actress at the 11th Yokohama Film Festival for A Sign Days. \n\nDescription above from the Wikipedia article Anna Nakagawa, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2014-10-17'), url:"https://themoviedb.org/person/115910"}}, {tmdbId:"52057", properties:{bornIn:"Queens, New York, USA", imdbId:"0044762", born:date('1951-12-01'), name:"Obba Babatundé", bio:"Obba Babatundé (born December 1, 1951) is an American actor of stage and screen, known for his Emmy-nominated performance in the television movie Miss Evers' Boys, a NAACP Image Award-nominated performance in the TV movie Introducing Dorothy Dandridge, and a Tony Award-nominated role for his performance as C. C.  White in the original cast of the 1981 Broadway musical Dreamgirls. \n\nBabatundé was a protege of Sammy Davis, Jr. , who said of him, \"This is the only cat who can do everything I can do...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6XKA5ExqC1HUxCCpNNWHIsCLsRM.jpg", url:"https://themoviedb.org/person/52057"}}, {tmdbId:"114583", properties:{bornIn:"London, England, UK", imdbId:"0428201", born:date('1988-07-21'), name:"Hatty Jones", bio:"From Wikipedia, the free encyclopedia. \n\nHatty Jones is a British-born former child actress who played the role of the title character in the 1998 movie Madeline...", url:"https://themoviedb.org/person/114583"}}, {tmdbId:"27632", properties:{bornIn:"Nuneaton, Warwickshire, England, UK", imdbId:"0199842", born:date('1964-06-10'), name:"Ben Daniels", bio:"From Wikipedia, the free encyclopedia\n\nBen Daniels (born 10 June 1964) is a British actor.  A graduate of the London Academy of Music and Dramatic Art (LAMDA), he has taken on roles in numerous productions.  On television he has appeared in, among other shows, The Lost Language of Cranes (1991), Conspiracy (2001), Cutting It (2002–2005), Ian Fleming: Bondmaker (2005), The Virgin Queen (2005) and The State Within (2006)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8ngIQbSnkS783qlCWhfWDT2JQ7C.jpg", url:"https://themoviedb.org/person/27632"}}, {tmdbId:"5443", properties:{bornIn:"Boulogne-Billancourt, Hauts-de-Seine, France", imdbId:"0512071", born:date('1959-07-15'), name:"Vincent Lindon", bio:"Vincent Lindon (born July 15, 1959 in Boulogne-Billancourt, Hauts-de-Seine) is a French actor who has been active for more than 25 years. \n\nLindon was a lover of Princess Caroline of Monaco from 1990 to 1995.  He is currently separated from his wife, the French actress Sandrine Kiberlain. \n\nDescription above from the Wikipedia article Vincent Lindon, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/s4WW0wCMbC9S2SkYWHZVq1s5TJL.jpg", url:"https://themoviedb.org/person/5443"}}, {tmdbId:"7693", properties:{bornIn:"Paris, France", imdbId:"0075710", born:date('1952-04-22'), name:"François Berléand", bio:"From Wikipedia, the free encyclopedia. \n\nFrançois Berléand (born April 22, 1952) is a French actor. \n\nBerléand was born in Paris, France of Armenian descent.  He plays Gilles Triquet, the officer manager and equivalent of David Brent in Le Bureau, the French version of The Office, produced by Canal+.  He released a book about his childhood in 2006, Le fils de l'homme invisible (The son of the invisible man)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tqQIMOiTB6dxM76pYOs3Sn1mDUj.jpg", url:"https://themoviedb.org/person/7693"}}, {tmdbId:"146195", properties:{imdbId:"0075163", born:date('1938-07-21'), name:"Francine Bergé", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oc7yNkK6USa8DxPm8MoGHqaRxni.jpg", url:"https://themoviedb.org/person/146195"}}, {tmdbId:"3270", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0906031", born:date('1970-09-29'), name:"Natasha Gregson Wagner", bio:"Natasha Gregson Wagner (born September 29, 1970) is an American actress. \n\nGregson Wagner was born in Los Angeles, California, the daughter of Richard Gregson, a film producer, and the late actress Natalie Wood.  She left Emerson College to pursue an acting career. \n\nDescription above from the Wikipedia article Natasha Gregson Wagner, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aGVYPI40CdFzxdE3fRnKvpeM8iw.jpg", url:"https://themoviedb.org/person/3270"}}, {tmdbId:"37207", properties:{imdbId:"0202819", born:date('1970-07-13'), name:"Angel David", url:"https://themoviedb.org/person/37207"}}, {tmdbId:"55254", properties:{bornIn:"La Haye, Pays-Bas", imdbId:"0886479", born:date('1967-08-30'), name:"Frederique Van Der Wal", bio:"Frederique van der Wal est un mannequin néerlandais né le 30 août 1967 à La Haye (Pays-Bas).  Elle est apparue à la télévision et au cinéma (notamment dans Wild Wild West en 1999). \n\nFrederique van der Wal (also Frédérique van der Wal (born August 30, 1967) is a Dutch model, business woman and entrepreneur best known for her appearances in Victoria's Secret, and the covers of such magazines as Cosmopolitan, and Vogue.  Van der Wal grew up in The Hague...", url:"https://themoviedb.org/person/55254"}}, {tmdbId:"2221", properties:{bornIn:"San Francisco, California, USA", imdbId:"0650702", born:date('1960-08-06'), name:"Leland Orser", bio:"Leland Jones Orser (born August 6, 1960) is an American film and television actor.  Orser is a character actor, whose career has included playing a number of parts of deranged, psychotic, and degenerate characters.  Orser has appeared in small roles in a wide variety of films and television shows, including Chief of Surgery Dr.  Lucien Dubenko on the television show ER. \n\nDescription above from the Wikipedia article Leland Orser, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vvVcWhActW8k2gQz95UatVP4Duf.jpg", url:"https://themoviedb.org/person/2221"}}, {tmdbId:"557874", properties:{imdbId:"1675647", name:"Elaine Bly", url:"https://themoviedb.org/person/557874"}}, {tmdbId:"1332216", properties:{bornIn:"Albuquerque, New Mexico, USA", imdbId:"7098296", born:date('1974-11-14'), name:"Chip Carter", bio:"Chip Gaines is both co-owner and co-founder of Magnolia, and was co-star of HGTV’s Fixer Upper with his wife Joanna.  Born in Albuquerque, New Mexico and raised in Dallas, Chip graduated from Baylor University’s Hankamer School of Business with a Marketing degree...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rpjUZBlfMYEVrIcsd9TEc2uAFoZ.jpg", url:"https://themoviedb.org/person/1332216"}}, {tmdbId:"43479", properties:{bornIn:"Pittsburgh - Pennsylvania - USA", imdbId:"0175633", born:date('1967-08-17'), name:"David Conrad", bio:"​From Wikipedia, the free encyclopedia\n\nDavid Crawford Conrad (born August 17, 1967) is an American actor.  From 2005 to 2010, he starred in the television series Ghost Whisperer alongside Jennifer Love Hewitt...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3A8ZF3G6LfeHbYhGiwLjShueYyK.jpg", url:"https://themoviedb.org/person/43479"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"57685", properties:{bornIn:"Castle Air Force Base, ", imdbId:"0020931", born:date('1975-07-20'), name:"Ray Allen", bio:"​From Wikipedia, the free encyclopedia.   \n\nWalter Ray Allen (born July 20, 1975) is an American professional basketball player who is currently playing for the Boston Celtics in the National Basketball Association.  He has played professionally for the Milwaukee Bucks, Seattle SuperSonics, and the Boston Celtics; and collegiately for the University of Connecticut Huskies...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7lCaRg0zySaiZzHpiepHZTRdWXw.jpg", url:"https://themoviedb.org/person/57685"}}, {tmdbId:"5916", properties:{bornIn:"New York City, New York, USA", imdbId:"0206257", born:date('1979-05-09'), name:"Rosario Dawson", bio:"Rosario Isabel Dawson (born May 9, 1979) is an American actress, singer, and writer from New York City.  She made her film debut in Kids (1995) and has also appeared in a number of films including Men in Black II (2002), The Rundown (2003),  Alexander (2004), 25th Hour (2005), Sin City (2005), Rent (2005), Clerks II (2006), Death Proof (2007), Eagle Eye (2008), Seven Pounds (2008), Percy Jackson and the Olympians: The Lightning Thief (2010), Unstoppable (2010) and Top Five (2014)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9MyVwYM5JiMnQvNiRVwX5k7Y5m5.jpg", url:"https://themoviedb.org/person/5916"}}, {tmdbId:"55624", properties:{bornIn:" Denver, Colorado, USA", imdbId:"0045379", born:date('1970-10-26'), name:"Dian Bachar", bio:"From Wikipedia, the free encyclopedia\n\nDian Bachar (born October 26, 1970 in Denver, Colorado) is an American actor.  He is most notable for his roles in various films by or starring his friends Trey Parker and Matt Stone, such as Cannibal! The Musical (George Noon), Orgazmo (Ben Chapleski) and his most famous role as Kenny \"Squeak\" Scolari in 1998's BASEketball, as well as making the occasional appearance on South Park...", url:"https://themoviedb.org/person/55624"}}, {tmdbId:"55625", properties:{imdbId:"0704632", name:"Robyn Lynne Raab", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kdtB5oK3V2YUePuyTM4qy7u3E0y.jpg", url:"https://themoviedb.org/person/55625"}}, {tmdbId:"55623", properties:{imdbId:"0414554", name:"Michael Dean Jacobs", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wr6XAgsLMxnDYTaT7IXmC3s1Xfp.jpg", url:"https://themoviedb.org/person/55623"}}, {tmdbId:"217510", properties:{imdbId:"0535393", name:"Christian Maelen", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aCNnPxgaVQQbhs1NCjTt2kad0pG.jpg", url:"https://themoviedb.org/person/217510"}}, {tmdbId:"141610", properties:{bornIn:"Brooklyn, New York, United States", imdbId:"0904967", born:date('1964-11-02'), name:"Lauren Luna Vélez", bio:"Lauren Vélez (born November 2, 1964) is an American actress of Puerto Rican descent and the twin sister of actress Loraine Vélez.  Her most notable roles are as Maria LaGuerta on Dexter, Detective Nina Moreno on Fox's New York Undercover, and Dr.  Gloria Nathan on HBO's controversial jail drama, Oz. \n\nDescription above from the Wikipedia article Lauren Vélez, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w8Z6hiipTD5zXl4fnUpBImru85S.jpg", url:"https://themoviedb.org/person/141610"}}, {tmdbId:"86919", properties:{bornIn:"Taylorville - Illinois - USA", imdbId:"0365988", name:"Jamie Harrold", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vtBL6DCxCL2qCCh8aI6LRHOtc8V.jpg", url:"https://themoviedb.org/person/86919"}}, {tmdbId:"7025", properties:{bornIn:"Glasgow, Scotland, UK", imdbId:"0564500", born:date('1960-01-01'), name:"Richard McCabe", bio:"From Wikipedia, the free encyclopedia. \n\nRichard McCabe (born 1960) is a Scottish actor. \n\nDescription above from the Wikipedia article Richard McCabe, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qhQbGDqm5W8frysaKJeNwJOkL1M.jpg", url:"https://themoviedb.org/person/7025"}}, {tmdbId:"19849", properties:{imdbId:"0503443", born:date('1949-01-01'), name:"Chete Lera", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zXYXiFDqKedLMYJyyTk8YWhp8pj.jpg", url:"https://themoviedb.org/person/19849"}}, {tmdbId:"19468", properties:{bornIn:"St. Louis, Missouri, USA", imdbId:"0065418", born:date('1951-04-11'), name:"Gerry Becker", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/il1r1Iym5WFJyo8SQon60aqu4nC.jpg", url:"https://themoviedb.org/person/19468"}}, {tmdbId:"19470", properties:{imdbId:"0671761", name:"Greyson Erik Pendry", url:"https://themoviedb.org/person/19470"}}, {tmdbId:"52647", properties:{bornIn:"Frederick, Maryland, USA", imdbId:"0004999", born:date('1975-12-29'), name:"Shawn Hatosy", bio:"Shawn Wayne Hatosy (born December 29, 1975) is an actor with over 40 film and television credits to his name. \n\nDescription above from the Wikipedia article Shawn Hatosy, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lmgbgh4ALWuzLMfLWFNxJ6wqyJI.jpg", url:"https://themoviedb.org/person/52647"}}, {tmdbId:"2839", properties:{bornIn:"Staten Island, New York, USA", imdbId:"0786639", born:date('1980-02-21'), name:"Brendan Sexton III", bio:"From Wikipedia, the free encyclopedia\n\nBrendan Eugene Sexton III (born February 21, 1980) is an American actor. \n\nDescription above from the Wikipedia article Brendan Sexton III, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/36EvFVDqOKzUa91ixgGEAUPgnqA.jpg", url:"https://themoviedb.org/person/2839"}}, {tmdbId:"11661", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0005028", born:date('1979-04-19'), name:"Kate Hudson", bio:"From Wikipedia, the free encyclopedia. \n\nKate Garry Hudson (born April 19, 1979) is an American actress.  She came to prominence in 2001 after winning a Golden Globe and receiving several nominations, including a nomination for an Academy Award for Best Supporting Actress, for her role in Almost Famous.  She then starred in the hit film How to Lose a Guy in 10 Days (2003) which gained her wider fame...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vCSuPFndH3sbCYZdi1pMiKvzRIp.jpg", url:"https://themoviedb.org/person/11661"}}, {tmdbId:"73283", properties:{bornIn:"Dublin, Ireland", imdbId:"0567945", born:date('1972-01-28'), name:"Peter McDonald", bio:"Peter McDonald (born 28 January 1972 in Dublin) is an Irish stage and screen actor.  He grew up in Mount Merrion in South County Dublin.  His mother, Brenda Costigan is a cookery writer and his father, Richard McDonald sells bailer twine.  He is related to Leigh McDonald of Australia.   He was educated at St Michael's College on Ailesbury Road in Dublin and graduated from University College Dublin with a Bachelor of Arts, English and a Master of Fine Arts, English in 1994...", url:"https://themoviedb.org/person/73283"}}, {tmdbId:"73286", properties:{imdbId:"0126118", name:"Antoine Byrne", url:"https://themoviedb.org/person/73286"}}, {tmdbId:"73287", properties:{imdbId:"0932837", name:"David Wilmot", bio:"From Wikipedia, the free encyclopedia. \n\nDavid Wilmot is an award-winning Irish stage, screen, and television actor. \n\nWilmot's theatre credits include Six Characters in Search of an Author at the Abbey Theatre in Dublin, As You Like It with the Druid Theatre Company in Galway, and Juno and the Paycock in London's West End...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/epb46N0iJyAmSOguMdFn6qQGSsy.jpg", url:"https://themoviedb.org/person/73287"}}, {tmdbId:"73288", properties:{bornIn:"Terenure, Dublin, Ireland", imdbId:"0568385", born:date('1963-01-01'), name:"Michael McElhatton", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c06ednxWLMs4zgulKT9tdQ7F4MJ.jpg", url:"https://themoviedb.org/person/73288"}}, {tmdbId:"31164", properties:{bornIn:"Islington, London, England, UK", imdbId:"0015382", born:date('1967-08-22'), name:"Adewale Akinnuoye-Agbaje", bio:"Adewale Akinnuoye-Agbaje ( born 22 August 1967) is a Nigerian–English actor, and former fashion model best known for his roles as Mr.  Eko on Lost, Simon Adebisi on Oz and Nykwana Wombosi in The Bourne Identity. \n\nDescription above from the Wikipedia article Adewale Akinnuoye-Agbaje, licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/difjXzTkSMIa6ezBIafSfKayt5X.jpg", url:"https://themoviedb.org/person/31164"}}] AS row
