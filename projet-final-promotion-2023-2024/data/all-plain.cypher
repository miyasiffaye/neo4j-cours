UNWIND [{tmdbId:"77897", properties:{bornIn:"Inglewood, California, USA", imdbId:"0004723", born:date('1973-12-04'), name:"Tyra Banks", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tBxbcHB67P4UIWbtb4x1sQwWwsN.jpg", url:"https://themoviedb.org/person/77897"}}, {tmdbId:"230465", properties:{bornIn:"Tulsa, Oklahoma, USA", imdbId:"0884311", born:date('1970-08-09'), name:"Stacy Valentine", bio:"Stacy Valentine is an Adult Film Actress.  She chose her stage name as a fitting tribute to her first role in the industry took place on February 14, 1996...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/beStZf3wywhOkykM0vLtfXjlkBG.jpg", url:"https://themoviedb.org/person/230465"}}, {tmdbId:"1213758", properties:{imdbId:"1349130", name:"Jack Gallagher", url:"https://themoviedb.org/person/1213758"}}, {tmdbId:"1317639", properties:{imdbId:"0358924", name:"Russell Hampshire", url:"https://themoviedb.org/person/1317639"}}, {tmdbId:"98365", properties:{bornIn:"Las Vegas, Nevada, USA", imdbId:"0366573", born:date('1956-10-27'), name:"Veronica Hart", bio:"Born Jane Esther Hamilton on 27 October 1956, Las Vegas, Nevada, Veronica Hart is a respected porn star of the 70s and 80s who went on to minor roles more mainstream movies.  Awarded AFAA 1981/82 Best Actress, AFAA 1982 Best Supporting Actress, CAFA 1982 Best Actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w3gBvnH0CzJEbUHj808L1qxXvSP.jpg", url:"https://themoviedb.org/person/98365"}}, {tmdbId:"19764", properties:{imdbId:"0206225", name:"Paul Dawson", bio:"Paul Dawson is an actor and DJ perhaps best known for playing the secretly suicidal former prostitute James, one of the principal characters in Shortbus, a 2006 American comedy-drama film written and directed by John Cameron Mitchell...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wXPYPTGv62rFY0axEL2XjtobBxT.jpg", url:"https://themoviedb.org/person/19764"}}, {tmdbId:"116130", properties:{imdbId:"0122260", name:"Tam Dean Burn", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9KvZPsDzvP58t1vIvEK0m1x36YZ.jpg", url:"https://themoviedb.org/person/116130"}}, {tmdbId:"1339", properties:{bornIn:"Beijing, China", imdbId:"0955471", born:date('1979-02-09'), name:"Ziyi Zhang", bio:"Zhang Ziyi (Chinese: 章子怡; born 9 February 1979) is a Chinese actress.  Her first major role was in The Road Home (1999).  She later achieved fame for her role in Crouching Tiger, Hidden Dragon (2000), which was nominated for 10 Academy Awards. \n\nIn the West, Zhang is best known for her appearances in Rush Hour 2 (2001), Hero (2002), 2046 (2004) and House of Flying Daggers (2004)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sjtAc10h5LaIaKV6Y1LoZoeE7HT.jpg", url:"https://themoviedb.org/person/1339"}}, {tmdbId:"78041", properties:{bornIn:"Panorama City, Los Angeles, California, USA", imdbId:"0131647", born:date('1970-10-12'), name:"Kirk Cameron", bio:"From Wikipedia, the free encyclopedia. \n\nKirk Thomas Cameron (born October 12, 1970) is an American actor best-known for his role as Mike Seaver on the television situation comedy Growing Pains (1985–1992), as well as several other television and film appearances as a child actor.  In the 1980s and 1990s, Cameron appeared in dozens of television shows and in the films Like Father Like Son and Listen to Me...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oloVIPnlEBff1gXmzGlY7Fk1KWn.jpg", url:"https://themoviedb.org/person/78041"}}, {tmdbId:"54217", properties:{bornIn:" London, Ontario, Canada", imdbId:"0827048", born:date('1974-03-17'), name:"Janaya Stephens", bio:"Actress / Performer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/b2m3Plg86NTBUsL1vqJKtdeeVqs.jpg", url:"https://themoviedb.org/person/54217"}}, {tmdbId:"51581", properties:{bornIn:"Moses Lake, Washington, USA", imdbId:"0319739", born:date('1955-12-24'), name:"Clarence Gilyard Jr.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7YLriOqPwiq0x8piORPnFUYLrPB.jpg", url:"https://themoviedb.org/person/51581"}}, {tmdbId:"33670", properties:{imdbId:"0324340", name:"Jay Goede", url:"https://themoviedb.org/person/33670"}}, {tmdbId:"1079558", properties:{imdbId:"0204199", name:"Augie Davis", url:"https://themoviedb.org/person/1079558"}}, {tmdbId:"135901", properties:{bornIn:"Rasht, Iran", imdbId:"0536954", born:date('1948-08-01'), name:"Hossein Mahjoub", bio:"Hossein Mahjoub (حسین محجوب) was born in the city of Rasht in northern Iran.  He studied literature in high school and later took different acting classes with a number of famous actors and directors.  He made his film debut in Bahram Beizaee's Downpour...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l4jLGqcLJePC9gHIEd0KlSsnPw1.jpg", url:"https://themoviedb.org/person/135901"}}, {tmdbId:"1209927", properties:{imdbId:"0708216", name:"Mohsen Ramezani", url:"https://themoviedb.org/person/1209927"}}, {tmdbId:"1209928", properties:{imdbId:"1890935", name:"Salameh Feyzi", url:"https://themoviedb.org/person/1209928"}}, {tmdbId:"1209929", properties:{imdbId:"0755797", name:"Farahnaz Safari", url:"https://themoviedb.org/person/1209929"}}, {tmdbId:"35980", properties:{bornIn:"Arizona - USA", imdbId:"0486728", born:date('1970-11-27'), name:"Brooke Langton", bio:"An American actress.  She is best known for the role of Samantha Reilly on the original Melrose Place. \n\nEarly life and education\n\nLangton was born in Arizona to geologist Jackson Langton, and his wife, a surgical nurse.  Her maternal grandfather, Stephen Cummings, was a World War II bomber pilot and her aunt Sally Spalding is a script supervisor.  Langton was raised in Illinois and Texas and attended Herscher High School, L.  D.  Bell High School and San Diego State University...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7vNdKFRgedVWfRiZps26PlaVwtI.jpg", url:"https://themoviedb.org/person/35980"}}, {tmdbId:"17287", properties:{bornIn:"Sheffield, Yorkshire, England, UK", imdbId:"0922035", born:date('1969-10-15'), name:"Dominic West", bio:"Dominic Gerard Fe West (born 15 October 1969) is an English actor best known in the United States for his role as Detective Jimmy McNulty in the HBO drama series The Wire...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xOr7REvhVy9Ax83dlk2qRiwLC1G.jpg", url:"https://themoviedb.org/person/17287"}}, {tmdbId:"41555", properties:{bornIn:"Washington - District of Columbia - USA", imdbId:"0756089", born:date('1974-06-01'), name:"Melissa Sagemiller", bio:"From Wikipedia, the free encyclopedia. \n\nMelissa Sagemiller (born June 1, 1974, height 5' 6\" (1,68 m)) is an American television and film actress. \n\nSagemiller was born in Washington, D. C.  to a political activist mother and a professional American football player father, who played in the NFL for the New York Giants and the Washington Redskins.  She attended Georgetown Day School.  Her entry into the performing arts was at age 3 when she began studying tap dance, ballet, jazz dance and modern dance...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9MAWajKJF2R59UOFyIul1F5dFAV.jpg", url:"https://themoviedb.org/person/41555"}}] AS row
