UNWIND [{tmdbId:"135651", properties:{bornIn:"Santa Ana - California - USA", imdbId:"0430107", born:date('1987-02-09'), name:"Michael B. Jordan", bio:"Michael Bakari Jordan (born February 9, 1987) is an American actor.  Jordan's television roles include Wallace in the HBO series The Wire (2002), Reggie Montgomery in the ABC soap opera All My Children (2003–2006), and Vince Howard in the NBC drama series Friday Night Lights (2009–2011)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kfcn0yyEdN2aJfVaxW0NIoKVF4J.jpg", url:"https://themoviedb.org/person/135651"}}, {tmdbId:"101428", properties:{bornIn:"Washington, D.C", imdbId:"1685276", born:date('1951-02-03'), name:"Michael Ruppert", bio:"​From Wikipedia, the free encyclopedia\n\nMichael Craig Ruppert (February 3, 1951 – April 13, 2014) was an American author, a former Los Angeles Police Department officer and investigative journalist and peak oil theorist. \n\nUntil 2006, he published and edited From The Wilderness, a newsletter and website covering a range of topics including (international) politics, the C. I. A. , peak oil, civil liberties, drugs, economics, corruption and 9/11 alternative theories...", died:date('2014-04-13'), url:"https://themoviedb.org/person/101428"}}, {tmdbId:"121606", properties:{imdbId:"0691928", born:date('1967-10-29'), name:"Robert Portal", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n1HEjfvZrxTShTZ1HncsWJ5Sib7.jpg", url:"https://themoviedb.org/person/121606"}}, {tmdbId:"78452", properties:{bornIn:"Dallas County, Texas, USA", imdbId:"2442289", born:date('1982-04-16'), name:"Gina Carano", bio:"Gina Joy Carano (born April 16, 1982) is an American actress, television personality, fitness model and a former mixed martial artist.  Carano appeared as Crush, a Gladiator on American Gladiators.  She has been referred to as the \"Face of Women's MMA. \" Carano was formerly the third best 145 lb (66 kg) female fighter in the world, according to the Unified Women's MMA Rankings.  Carano starred in the 2012 action film, Haywire, and 2013 film Fast & Furious 6...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kDcHntDmMEzftUQc0ASV7FM71Ar.jpg", url:"https://themoviedb.org/person/78452"}}, {tmdbId:"999680", properties:{imdbId:"0743351", name:"Debby Lynn Ross", url:"https://themoviedb.org/person/999680"}}, {tmdbId:"939423", properties:{imdbId:"1524317", name:"Sizwe Msutu", url:"https://themoviedb.org/person/939423"}}, {tmdbId:"939422", properties:{bornIn:"Mbabane - Swaziland", imdbId:"3003116", born:date('1981-06-21'), name:"Mark Elderkin", url:"https://themoviedb.org/person/939422"}}, {tmdbId:"1254881", properties:{bornIn:"Harborne, Birmingham, England, UK", imdbId:"2932174", born:date('1984-06-19'), name:"Helen George", url:"https://themoviedb.org/person/1254881"}}, {tmdbId:"114034", properties:{bornIn:"Celle, Germany", imdbId:"0646792", born:date('1972-03-03'), name:"Christian Oliver", bio:"From Wikipedia, the free encyclopedia. \n\nChristian Oliver (born March 3, 1972) is a German actor. \n\nOliver was born in Celle and grew up in Frankfurt am Main.  He relocated to the US to work as a model and subsequently take acting lessons in New York and Los Angeles.  In 2003 and 2004, Christian Oliver co-starred in 28 episodes of the German action TV series Alarm für Cobra 11...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yhQ5NAd3oWCYbNg32dLWYU3UBYY.jpg", url:"https://themoviedb.org/person/114034"}}, {tmdbId:"63544", properties:{bornIn:"La Jolla - San Diego - California - USA", imdbId:"0191688", born:date('1955-12-03'), name:"Steven Culp", bio:"An actor, known for Thirteen Days (2000) as Robert F.  Kennedy, JAG (1995) as CIA Agent Clayton Webb and Desperate Housewives (2004) as Rex Van de Kamp.  Despite being killed-off in season 1, Rex has appeared since in every season (excluding season 4 and 6)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ssTkFDWr3O3N1nnU1Hn8SxaMs63.jpg", url:"https://themoviedb.org/person/63544"}}, {tmdbId:"136973", properties:{bornIn:"Montréal, Québec, Canada", imdbId:"1014989", born:date('1973-10-26'), name:"David Julian Hirsh", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4Pdmzzl4AjdqfTZmABKtNDj50ex.jpg", url:"https://themoviedb.org/person/136973"}}, {tmdbId:"1273231", properties:{imdbId:"5531542", name:"Shyaam Karra", url:"https://themoviedb.org/person/1273231"}}, {tmdbId:"1273232", properties:{imdbId:"3384786", name:"Brent Wendell Williams", url:"https://themoviedb.org/person/1273232"}}, {tmdbId:"1273233", properties:{imdbId:"2560461", name:"Jhil McEntyre", url:"https://themoviedb.org/person/1273233"}}, {tmdbId:"52144", properties:{bornIn:"Long Beach, California, USA", imdbId:"0165096", born:date('1962-04-05'), name:"Lana Clarkson", died:date('2003-02-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mPcfJBBENUFpXkK7eWGeljxhuun.jpg", url:"https://themoviedb.org/person/52144"}}, {tmdbId:"197061", properties:{imdbId:"0575830", born:date('1940-09-19'), name:"Bill Medley", url:"https://themoviedb.org/person/197061"}}, {tmdbId:"231718", properties:{imdbId:"3538545", name:"Oscar Van Rompay", url:"https://themoviedb.org/person/231718"}}, {tmdbId:"39847", properties:{bornIn:"Amsterdam, Noord-Holland, Netherlands", imdbId:"0717603", born:date('1975-11-10'), name:"Halina Reijn", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ypsQjJrnuL1QyxHmYFnVAokpO5h.jpg", url:"https://themoviedb.org/person/39847"}}, {tmdbId:"210262", properties:{imdbId:"1541892", name:"Leon Voorberg", url:"https://themoviedb.org/person/210262"}}, {tmdbId:"78803", properties:{bornIn:"Rotterdam, Netherlands", imdbId:"0450453", born:date('1960-10-06'), name:"Hans Kesting", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/u9EB0MIx1FLIbePNWYvWzpt0HMt.jpg", url:"https://themoviedb.org/person/78803"}}] AS row
