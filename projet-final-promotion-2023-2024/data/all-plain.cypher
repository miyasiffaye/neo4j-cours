UNWIND [{tmdbId:"1226513", properties:{bornIn:"New Jersey", imdbId:"1376372", born:date('1969-02-09'), name:"Tom Scharpling", bio:"Tom Scharpling is an American comedian, television writer, producer, music video director, and radio host.  He is best known for having hosted the weekly freeform radio call-in comedy program The Best Show on WFMU from 2000 to 2013, and for acting as a writer/executive producer for the TV show Monk. \n\nScharpling was also noted as a writer on Tom Goes to the Mayor and Tim and Eric Awesome Show, Great Job!...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yKPOtwDOIxSKN639JuNWxbPuqt7.jpg", url:"https://themoviedb.org/person/1226513"}}, {tmdbId:"99314", properties:{bornIn:"Hakkâri, Turkey", imdbId:"0258784", born:date('1967-11-04'), name:"Yilmaz Erdogan", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e16Q5H7nRGzLCUk8JQSpp5166ko.jpg", url:"https://themoviedb.org/person/99314"}}, {tmdbId:"1392586", properties:{bornIn:"Rosario, Argentina", born:date('1973-04-02'), name:"María Marull", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/k5ck2mpL9KZn6vfA7D48zQbleAl.jpg", url:"https://themoviedb.org/person/1392586"}}, {tmdbId:"74902", properties:{bornIn:"Buenos Aires, Argentina", imdbId:"0897640", born:date('1954-12-16'), name:"Mónica Villa", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/30LtaxXyvjseyWQk64JJWN3rzhv.jpg", url:"https://themoviedb.org/person/74902"}}, {tmdbId:"99113", properties:{bornIn:"Buenos Aires, Argentina", imdbId:"0181300", born:date('1949-08-05'), name:"Rita Cortese", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3CtvCjKbUPyWq5SLAbYeBbb9M8d.jpg", url:"https://themoviedb.org/person/99113"}}, {tmdbId:"1267329", properties:{bornIn:"Mexico City, Distrito Federal, Mexico", imdbId:"2143282", born:date('1983-03-01'), name:"Lupita Nyong'o", bio:"An actress, film and music video director of dual Kenyan and Mexican citizenship.  After graduating from Hampshire College with a bachelor's degree in film and theater studies, Nyong'o worked as a production assistant on several Hollywood films.  In 2008 she made her acting debut with the short film East River and subsequently starred in the Kenyan television series Shuga (2009).  Also in 2009, she wrote, produced and directed the documentary film In My Genes...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/y40Wu1T742kynOqtwXASc5Qgm49.jpg", url:"https://themoviedb.org/person/1267329"}}, {tmdbId:"1148130", properties:{bornIn:"Seabrook, New Hampshire, USA", imdbId:"3850986", born:date('2003-12-01'), name:"Jackson Nicoll", bio:"Jackson Nicoll is an American child actor, best known for portraying Billy, the grandson of the title character, in Jackass Presents: Bad Grandpa (2013). \n\nNicoll is from Seabrook, New Hampshire.  His other credits include The Fighter (2010), What's Your Number? (2011), and Fun Size (2012)...", url:"https://themoviedb.org/person/1148130"}}, {tmdbId:"1524955", properties:{imdbId:"6285641", name:"Grace Stottor", url:"https://themoviedb.org/person/1524955"}}, {tmdbId:"1206241", properties:{imdbId:"1176300", name:"Themis Panou", url:"https://themoviedb.org/person/1206241"}}, {tmdbId:"144464", properties:{imdbId:"0685877", name:"Reni Pittaki", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mn4WE9sCZrvBcickqpZaU0mZpkE.jpg", url:"https://themoviedb.org/person/144464"}}, {tmdbId:"1570664", properties:{bornIn:"Athens, Greece", born:date('1975-08-21'), name:"Eleni Roussinou", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/goqFVY18l423YLzRausoSlCTFFt.jpg", url:"https://themoviedb.org/person/1570664"}}, {tmdbId:"1206244", properties:{bornIn:"Athens, Greece", imdbId:"5827214", born:date('1989-01-01'), name:"Sissy Toumasi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5euJ4eAsp4GmqXUUsKODxhMfOnG.jpg", url:"https://themoviedb.org/person/1206244"}}, {tmdbId:"73710", properties:{imdbId:"0712562", name:"Raad Rawi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8RlUcBM1ggcHXmXLtIo3CQ8iDZW.jpg", url:"https://themoviedb.org/person/73710"}}, {tmdbId:"1231211", properties:{bornIn:"Newton, Massachusetts, USA", imdbId:"0149560", name:"Jessica Chaffin", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tR33HttgoicrmgXRx2Ceuk5sba4.jpg", url:"https://themoviedb.org/person/1231211"}}, {tmdbId:"31532", properties:{bornIn:"Lexington, Kentucky, USA", imdbId:"0005020", born:date('1970-09-12'), name:"Josh Hopkins", bio:"Josh Hopkins (born September 12, 1970) is an American actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gPcG3xAnuUP9pMxGWkhb5nQqOPQ.jpg", url:"https://themoviedb.org/person/31532"}}, {tmdbId:"1317846", properties:{imdbId:"1533421", name:"John Wojtowicz", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cABCDce9Uq6e5n4MpnsbunQXmjs.jpg", url:"https://themoviedb.org/person/1317846"}}, {tmdbId:"1317850", properties:{imdbId:"6683407", name:"Carmen Bifulco", url:"https://themoviedb.org/person/1317850"}}, {tmdbId:"1394418", properties:{imdbId:"2840352", name:"Jeremy Bowker", url:"https://themoviedb.org/person/1394418"}}, {tmdbId:"38951", properties:{bornIn:"Huntsville, Alabama, USA", imdbId:"0146146", born:date('1958-08-18'), name:"Reg E. Cathey", bio:"From Wikipedia, the free encyclopedia\n\nReginald \"Reg\" E.  Cathey (born August 18, 1958) was an American stage, film and television actor. \n\nCathey is a native of Huntsville, Alabama and a graduate of J. O.  Johnson High School.  He spent his childhood in Germany. \n\nOne of his earliest roles was starring in the children's television show Square One.  He later had guest roles in episodes of shows such as Star Trek: The Next Generation and Homicide: Life on the Street...", died:date('2018-02-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ss0qH33O7g9GjQ1kC3z3kH0UYyw.jpg", url:"https://themoviedb.org/person/38951"}}, {tmdbId:"1216606", properties:{bornIn:"Oxford, Oxfordshire, England UK", imdbId:"1813221", born:date('1983-04-21'), name:"Gugu Mbatha-Raw", bio:"Gugulethu Sophia Mbatha-Raw MBE is an English actress, known for her role as Kelly in Black Mirror, Dido Elizabeth Belle in Belle, Noni Jean in Beyond the Lights, and Plumette in Beauty and the Beast...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xhdkaZSloWkdyjFkKbXPxp5QI1F.jpg", url:"https://themoviedb.org/person/1216606"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"1276759", properties:{bornIn:"Houston, Texas, U.S.A.", imdbId:"0446622", born:date('1990-04-22'), name:"Machine Gun Kelly", bio:"Colson Baker is better known by his stage name Machine Gun Kelly.  His stage name was given for his rapid-fire lyrical flow and is a reference to notorious criminal George \"Machine Gun Kelly\" Barnes.  MGK was born in Houston, Texas and experienced multiple moves until 2005 when he and his family settled in Cleveland, Ohio - the city Kelly associates himself with the most.  He is signed to Bad Boy and Interscope Records...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sIMKmVbR6kTyBnLzmJTaDdZB1as.jpg", url:"https://themoviedb.org/person/1276759"}}, {tmdbId:"208296", properties:{bornIn:"Auckland, Dominion of New Zealand", imdbId:"0612534", born:date('1975-02-23'), name:"Callan Mulvey", bio:"Mulvey was born in New Zealand, and is of Maori and European heritage.  His family moved to Sydney, Australia when he was eight years old.  He is best known for his roles as Mark Moran on the popular Australian drama Underbelly, and as Bogdan 'Draz' Drazic in Heartbreak High.  Mulvey attended Beacon Hill High School (New South Wales) along with other Heartbreak High cast members Jon Pollard and Alle Brunning. \n\nMulvey was injured in a serious car accident in 2003, in a head-on collision at 100 km/h...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dSTWVK03Ajl1mWViJxMPypQUgqB.jpg", url:"https://themoviedb.org/person/208296"}}, {tmdbId:"980476", properties:{imdbId:"1898133", name:"José Luis Gutiérrez", url:"https://themoviedb.org/person/980476"}}, {tmdbId:"1282282", properties:{imdbId:"2019688", name:"José Navar", url:"https://themoviedb.org/person/1282282"}}, {tmdbId:"1062012", properties:{bornIn:"Barcelona, España", imdbId:"1296882", born:date('1973-02-14'), name:"Maria Molins", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/liTnf3KGe11ZZRUdrGOrGDgVmak.jpg", url:"https://themoviedb.org/person/1062012"}}, {tmdbId:"1265766", properties:{imdbId:"4339116", name:"Alvar Gordejuela", url:"https://themoviedb.org/person/1265766"}}, {tmdbId:"1219901", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0703800", born:date('1959-06-06'), name:"Colin Quinn", bio:"Colin Edward Quinn (born June 6, 1959) is an American stand-up comedian, actor, and writer.  On television, he is best known for his work on Saturday Night Live, where he anchored Weekend Update, on MTV's 1980s game show Remote Control, where he served as the announcer/sidekick, and as host of Comedy Central's late-night panel show Tough Crowd with Colin Quinn...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i1bEo7q7XJX6mYHA52Z7hhLyDg6.jpg", url:"https://themoviedb.org/person/1219901"}}, {tmdbId:"2446163", properties:{imdbId:"7106491", name:"Carla Oudin", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/f6txaK5OAyFxPeohiD6s4UR74gw.jpg", url:"https://themoviedb.org/person/2446163"}}, {tmdbId:"440414", properties:{bornIn:"New York, New York, USA", imdbId:"2154960", born:date('1981-06-01'), name:"Amy Schumer", bio:"Amy Schumer was born in Manhattan and grew up on Long Island, New York.  She attended South Side High School and was voted both \"Class Clown\" and \"Teacher's Worst Nightmare\" upon graduation in 1999.  Schumer graduated from Towson University in 2003 with a degree in theater.  She moved to New York City after college, where she studied at the William Esper Studio for two years and worked as a bartender and a waitress.  Through her father, she is the niece of Chuck Schumer, U. S.  Senator from New York...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/k1k78eml8x2085b0lr86gxrpJjG.jpg", url:"https://themoviedb.org/person/440414"}}, {tmdbId:"1513568", properties:{imdbId:"6451534", name:"Florence Mezzara", url:"https://themoviedb.org/person/1513568"}}, {tmdbId:"1312998", properties:{imdbId:"1220138", name:"Charlotte Miller", url:"https://themoviedb.org/person/1312998"}}, {tmdbId:"1754627", properties:{name:"Abram Rooney", url:"https://themoviedb.org/person/1754627"}}, {tmdbId:"144867", properties:{imdbId:"0573143", name:"Jim McManus", url:"https://themoviedb.org/person/144867"}}, {tmdbId:"146750", properties:{bornIn:"London, England, UK", imdbId:"1126657", born:date('1992-03-13'), name:"George MacKay", bio:"George MacKay (born 13 March 1992) is an English actor.  His first acting job was Peter Pan at the age of 10 and since then he has kept on acting.  George is best known for his roles in 'Sunshine on Leith, 'For Those in Peril', 'Pride', 'Captain Fantastic' and the recently Golden Globe and Bafta best picture winner '1917'.  His stage work is equally impressive; he has been on 'Ah, Wilderness' at the Young Vic and 'The Caretaker' with Timothy Spall and Daniel Mays at the Old Vic Theatre...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3igGY57QsdJPTChto3ZBDT9vXTg.jpg", url:"https://themoviedb.org/person/146750"}}, {tmdbId:"1277188", properties:{bornIn:"Vancouver, British Columbia, Canada", imdbId:"5016878", born:date('2006-10-05'), name:"Jacob Tremblay", bio:"Jacob Tremblay (born October 5, 2006) is a Canadian actor from Vancouver, British Columbia.  He began his acting career in television roles, and he made his film debut in The Smurfs 2 (2013).  Tremblay's breakthrough performance came in 2015, when he starred as Jack Newsome in Room alongside Brie Larson, the role earned him widespread acclaim including various awards.  The actor went on to appear in films such as Before I Wake (2016), The Book of Henry (2017) and Wonder (2017)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ngQAfH1GuKhnMSOQNm9zo7aWiqO.jpg", url:"https://themoviedb.org/person/1277188"}}, {tmdbId:"144160", properties:{bornIn:"Chapel Hill, North Carolina, USA", imdbId:"0108703", born:date('1968-03-15'), name:"Sean Bridgers", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lG8vV5g49RML5WkaN6Mb3GnLgge.jpg", url:"https://themoviedb.org/person/144160"}}, {tmdbId:"1106240", properties:{imdbId:"3193675", name:"Ben Huber", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1QiJA86GO7EtRBdbPeZbvpzG7O7.jpg", url:"https://themoviedb.org/person/1106240"}}, {tmdbId:"1290264", properties:{imdbId:"3813339", name:"Hanna Brown", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/atfzxwfvrNRKBCvzQquKCET4bUk.jpg", url:"https://themoviedb.org/person/1290264"}}, {tmdbId:"932091", properties:{bornIn:"Abilene - Texas - USA", imdbId:"4554428", born:date('1987-09-21'), name:"Ryan Guzman", bio:"Ryan Anthony Guzman is an American actor and model.  He is best known for portraying Sean Asa in the fourth installment of the Step Up series.  Before he began acting, he was a model. \n\nGuzman was born in Abilene, Texas, to Lisa (née Hudson) and Ray Guzman.  He moved to Sacramento, California, his mother's native city, at a young age.  He attended Sierra College.  Guzman has a younger brother, Steven.  His father is Mexican...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pHdc4VPIGDfi7r8g4tQBUTQenda.jpg", url:"https://themoviedb.org/person/932091"}}, {tmdbId:"2614763", properties:{imdbId:"4276728", name:"Adam B. Shapiro", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zfESo2zBrYI6TXlDcmTw01Tg43M.jpg", url:"https://themoviedb.org/person/2614763"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"1778320", properties:{name:"Evan Neumann", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hObKhjQ8q0TreWrDYvt3h53wEks.jpg", url:"https://themoviedb.org/person/1778320"}}, {tmdbId:"98187", properties:{imdbId:"0725550", name:"Allen Lewis Rickman", url:"https://themoviedb.org/person/98187"}}, {tmdbId:"1528398", properties:{name:"Brenda Myers-Powell", url:"https://themoviedb.org/person/1528398"}}, {tmdbId:"1361100", properties:{imdbId:"6092492", name:"Bailey Spry", url:"https://themoviedb.org/person/1361100"}}, {tmdbId:"1588334", properties:{name:"Carollette Phillips", url:"https://themoviedb.org/person/1588334"}}, {tmdbId:"1329297", properties:{imdbId:"3257024", name:"Loren Bass", url:"https://themoviedb.org/person/1329297"}}, {tmdbId:"144676", properties:{imdbId:"1992722", name:"Peter Djigirr", url:"https://themoviedb.org/person/144676"}}, {tmdbId:"55900", properties:{bornIn:"Kurri Kurri, New South Wales, Australia", imdbId:"1047329", born:date('1981-03-26'), name:"Luke Ford", bio:"From Wikipedia, the free encyclopedia.  Luke Ford (born 26 March 1981) is a Canadian-Australian actor.  Ford was born in Vancouver, British Columbia, Canada but raised in Sydney, Australia.  He attended Parramatta Marist High School in Westmead, Sydney, and once worked at the Winston Hills Hotel, and a short stint at Universal Magazines in North Ryde.  Ford studied acting at The Actor's Pulse in Sydney, becoming one of the school's earliest graduates...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/u40f3Q26n44yUrfxN4ZKjm9WGUn.jpg", url:"https://themoviedb.org/person/55900"}}, {tmdbId:"1199391", properties:{imdbId:"0030796", name:"Wayne Anthoney", url:"https://themoviedb.org/person/1199391"}}, {tmdbId:"1349720", properties:{imdbId:"4554036", name:"Parker Sawyers", url:"https://themoviedb.org/person/1349720"}}, {tmdbId:"105688", properties:{bornIn:"Dubai, United Arab Emirates", imdbId:"0706666", born:date('1974-10-20'), name:"Bashar Rahal", bio:"Bashar Mounzer Rahal is the second child to a Bulgarian mother Mariana \n\nRahal - an interior designer and Lebanese father Mounzer Rahal - an \n\nOB/GYN.  The family moved back to Bulgaria when Bashar was only 6 years \n\nold.  He first started acting in TV sketches when he was 12.  At the age \n\nof 14 he became a member of a professional theater group, called \"Tears \n\nand Laughs\", with which he took part in more than 15 performances \n\nincluding Shakespeare and Chekhov...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qhUhE1WtPUCSjoU3A9YtJxosc78.jpg", url:"https://themoviedb.org/person/105688"}}, {tmdbId:"1266313", properties:{imdbId:"4817257", name:"Royce Pierreson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oybeyUuA9zx1zo6RcJsMWt3lsip.jpg", url:"https://themoviedb.org/person/1266313"}}, {tmdbId:"1839996", properties:{name:"Scotty Bowman", url:"https://themoviedb.org/person/1839996"}}, {tmdbId:"582202", properties:{imdbId:"0212636", name:"Mark Deakins", url:"https://themoviedb.org/person/582202"}}, {tmdbId:"2334822", properties:{bornIn:"Moscow, RSFSR, USSR", imdbId:"1625396", born:date('1958-04-20'), name:"Viacheslav Fetisov", bio:"Soviet and Russian hockey player.  Honored Master of Sports of the USSR (1978), Honored Trainer of Russia (2002).  In 1975-1989 - in CSKA.  He was the captain of the team and the USSR team.  In 1989-1994 - in the \"New Jersey Devils\", in 1994-1998 - in the \"Detroit Red Wings. \" Two-time Olympic champion, multiple world and European champion...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1QZd6nsAHQpDlqZyDfWe2ouCwJL.jpg", url:"https://themoviedb.org/person/2334822"}}, {tmdbId:"225957", properties:{bornIn:"Zlatoust, USSR [now Russia]", imdbId:"0440024", born:date('1951-05-23'), name:"Anatoli Karpov", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fIvsfOBFN54OvaSsOhSPR0OriSY.jpg", url:"https://themoviedb.org/person/225957"}}, {tmdbId:"1360985", properties:{bornIn:"London, England, UK", imdbId:"3805083", born:date('1955-06-08'), name:"Tim Berners-Lee", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/r5XtvCZoOuMPN0eRnOUkHdKI7Bv.jpg", url:"https://themoviedb.org/person/1360985"}}, {tmdbId:"2051862", properties:{name:"Cindy Cohn", url:"https://themoviedb.org/person/2051862"}}, {tmdbId:"1411749", properties:{imdbId:"4944031", name:"Gabriella Coleman", url:"https://themoviedb.org/person/1411749"}}, {tmdbId:"90714", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"2189202", born:date('1971-07-17'), name:"Cory Doctorow", bio:"​From Wikipedia, the free encyclopedia.   \n\nCory Doctorow (  born July 17, 1971) is a Canadian blogger, journalist, and science fiction author who serves as co-editor of the blog Boing Boing.  He is an activist in favour of liberalising copyright laws and a proponent of the Creative Commons organization, using some of their licences for his books...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z3116iV49AXk0A4o9WWEFFG5Ltr.jpg", url:"https://themoviedb.org/person/90714"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"123512", properties:{imdbId:"1060510", name:"Linas Phillips", bio:"A graduate of New York University's Experimental Theater Wing, Linas Phillips started out as a live performer of experimental theater and alternative comedy while living in New York City.  Linas' day job for over 5 years was babysitting special needs kids, with whom he started making short videos. \n\nAfter many years of performing comedy and experimental theater work in New York City Linas switched to making films in 2006...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iP7c8Z9LJsRkl9niL7ZABfjAoTj.jpg", url:"https://themoviedb.org/person/123512"}}, {tmdbId:"1213572", properties:{imdbId:"1705050", name:"Leonora Pitts", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kXSOJoOZlwV2pWKhm8N0JLhUnL2.jpg", url:"https://themoviedb.org/person/1213572"}}, {tmdbId:"1404086", properties:{imdbId:"4989855", name:"Adam Chernick", url:"https://themoviedb.org/person/1404086"}}, {tmdbId:"56104", properties:{imdbId:"0560864", born:date('1951-06-22'), name:"Sharon Maughan", url:"https://themoviedb.org/person/56104"}}, {tmdbId:"35518", properties:{bornIn:"Augsburg, Bavaria, Germany", imdbId:"0342881", born:date('1951-09-10'), name:"Harry Groener", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3MAsDC1JtNqef1O4MwqakGjJkkI.jpg", url:"https://themoviedb.org/person/35518"}}, {tmdbId:"191228", properties:{bornIn:"Hollywood, Florida, USA", imdbId:"1842439", born:date('1993-02-19'), name:"Victoria Justice", bio:"Victoria Justice (born February 19, 1993) is an American actress, singer, songwriter, and dancer.  She debuted as an actress at the age of 10 and has since appeared in several films and television series including the Nickelodeon series Zoey 101 and Victorious.  She has made appearances in several theatrical releases, including Unknown as well as the 2006 thriller The Garden...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uKG1l8Mk4FSLYml1ZRRXK6WJvfi.jpg", url:"https://themoviedb.org/person/191228"}}, {tmdbId:"1310521", properties:{bornIn:"Moses Lake, Washington, USA", imdbId:"4943457", born:date('1990-11-06'), name:"Pierson Fode", url:"https://themoviedb.org/person/1310521"}}, {tmdbId:"1272291", properties:{bornIn:"New York City, New York, USA", imdbId:"4568989", born:date('1987-10-01'), name:"Matthew Daddario", bio:"Matthew Daddario was born and raised in New York to Richard and Christina Daddario, both lawyers.  He studied business at Indiana University in Bloomington.  He graduated in 2010, after which he began studying acting and started auditioning.   He is the middle child, with a younger sister, Catharine Daddarop, and an older sister,Alexandra Daddario, who is also an actress.   Matt has Italian, Irish, English, and Czech ancestry...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9gWBLo0QvZCFQ4wFR0CKpejgCkH.jpg", url:"https://themoviedb.org/person/1272291"}}, {tmdbId:"1391765", properties:{imdbId:"1362617", name:"Ryan Ward", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wAS9SNsh5Kk7juPcAYg9RcotcQp.jpg", url:"https://themoviedb.org/person/1391765"}}, {tmdbId:"934289", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"2215143", born:date('1999-11-10'), name:"Kiernan Shipka", bio:"Kiernan Shipka was born in Chicago, Illinois, to John Young Shipka, a real estate developer, and his wife, Erin Ann, a one-time queen of Chicago's St.  Patrick's Day parade.  The family relocated to Los Angeles when she was six to support her acting career.  Kiernan got her black belt in taekwondo in June, 2012.  Shipka began doing commercial print modeling when she was a baby...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aZeL5x1QfJ9LVpXfpTzyQilJTjN.jpg", url:"https://themoviedb.org/person/934289"}}, {tmdbId:"16607", properties:{bornIn:" Israel", imdbId:"0009530", born:date('1965-05-28'), name:"Alon Aboutboul", bio:"Alon Aboutboul is an actor and director...", url:"https://themoviedb.org/person/16607"}}, {tmdbId:"94431", properties:{imdbId:"0958206", name:"Waleed Zuaiter", url:"https://themoviedb.org/person/94431"}}, {tmdbId:"1186880", properties:{imdbId:"3612367", born:date('1993-01-22'), name:"Merlin Rose", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/18X06ccu6PEDQj6kHaK2IQfHfOK.jpg", url:"https://themoviedb.org/person/1186880"}}, {tmdbId:"569349", properties:{bornIn:"Berlin, Germany", imdbId:"3352729", born:date('1995-01-01'), name:"Julius Nitschkoff", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/m1SipE5OZT6sEQQdGn7t0433DCc.jpg", url:"https://themoviedb.org/person/569349"}}, {tmdbId:"223477", properties:{bornIn:"Zürich, Switzerland", imdbId:"2056274", born:date('1990-01-23'), name:"Joel Basman", bio:"Joel Basman (born 23 January 1990) is a Swiss-Israeli actor. \n\nBasman was born in Zurich to a Swiss mother and an Israeli father, both of whom were tailors in the Swiss fashion industry.  He grew up in the neighbourhood of Aussersihl and was raised bilingual (speaking Swiss German and Hebrew).  He has one older sister who now lives in Israel.  Basman is Jewish. \n\nIn 2004 he started his career and played a bold teenager named Zizou for the weekly soap opera Lüthi und Blanc...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pZrA3PcPdrMU1iUe9VoETSoEYeM.jpg", url:"https://themoviedb.org/person/223477"}}, {tmdbId:"1430482", properties:{imdbId:"6060268", name:"Marcel Heuperman", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x2WM36qmYEYMjXqGydCuRVqR4DF.jpg", url:"https://themoviedb.org/person/1430482"}}, {tmdbId:"1279249", properties:{bornIn:"Amsterdam, Netherlands", imdbId:"4714014", born:date('1997-01-02'), name:"Gijs Blom", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fBt9qOW4EA1miKaLXFIMYOHAled.jpg", url:"https://themoviedb.org/person/1279249"}}, {tmdbId:"934393", properties:{imdbId:"4531861", name:"Ko Zandvliet", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dRKHeihfZKodfDnZGYGwSrWeubJ.jpg", url:"https://themoviedb.org/person/