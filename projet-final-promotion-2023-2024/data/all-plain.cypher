UNWIND [{tmdbId:"144213", properties:{bornIn:"Buenos Aires, Argentina", imdbId:"0274184", born:date('1978-03-30'), name:"Lucas Ferraro", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8Fudl4iBDPb7koExXu6gxNShbUc.jpg", url:"https://themoviedb.org/person/144213"}}, {tmdbId:"144214", properties:{imdbId:"3655408", name:"Mercedes Quinteros", url:"https://themoviedb.org/person/144214"}}, {tmdbId:"978960", properties:{imdbId:"0133787", name:"Damián Canduci", url:"https://themoviedb.org/person/978960"}}, {tmdbId:"123879", properties:{bornIn:"Sydney, Australia.", imdbId:"2506835", born:date('1972-03-08'), name:"Matt Nable", bio:"Matthew Nable (born 8 March 1972) is an Australian film and television actor, writer and former professional rugby league footballer After playing in the Winfield Cup Premiership during the 1990s for the Manly-Warringah and South Sydney clubs, he wrote and starred in the rugby league-centered drama The Final Winter in 2007.  Nable went on to act in films such as Killer Elite and Riddick.  He appears on The CW's Arrow as Ra's al Ghul...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jSu8gDagYzRATvOl1APVixQc9ZR.jpg", url:"https://themoviedb.org/person/123879"}}, {tmdbId:"177596", properties:{imdbId:"0669351", born:date('1956-08-21'), name:"Patrick Pearson", url:"https://themoviedb.org/person/177596"}}, {tmdbId:"1005280", properties:{bornIn:"Worthing, West Sussex, England, UK", imdbId:"0225655", born:date('1927-08-19'), name:"Hugh Dickson", died:date('2018-11-26'), url:"https://themoviedb.org/person/1005280"}}, {tmdbId:"51992", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0951148", born:date('1985-05-10'), name:"Odette Annable", bio:"Odette Annable is an American film and television actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fWPmTC9QfqAKi3JKJKp2LKrm8Ix.jpg", url:"https://themoviedb.org/person/51992"}}, {tmdbId:"63312", properties:{bornIn:"Werrington Downs, Sydney, New South Wales, Australia", imdbId:"2088803", born:date('1982-07-30'), name:"Yvonne Strahovski", bio:"Yvonne Strahovski (born Strzechowski on 30 July 1982) is an Australian actress.  Born in Australia to Polish immigrant parents, Strahovski speaks Polish and English.  After graduating from University of Western Sydney she featured in a number of Australian television shows before winning the starring role of Sarah Walker in the American television series Chuck...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/agSsHLcKEosetlcIJ1QibJOFG2.jpg", url:"https://themoviedb.org/person/63312"}}, {tmdbId:"27740", properties:{bornIn:"Birmingham, Alabama, USA", imdbId:"0324658", born:date('1971-11-10'), name:"Walton Goggins", bio:"Walton Sanders Goggins, Jr.  (born November 10, 1971) is an American actor best known for his roles on the FX Networks series The Shield and Justified, portraying Detective Shane Vendrell and Boyd Crowder, respectively.  He is also known for his character roles in the films Miracle at St.  Anna and Predators.  Goggins co-produced and starred in the 2001 short film The Accountant, which won an Academy Award for Best Live Action Short Film...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xTXgANdDOVEVWLjcaoSmGlIkJ1B.jpg", url:"https://themoviedb.org/person/27740"}}, {tmdbId:"149192", properties:{bornIn:"São Paulo, São Paulo, Brazil", imdbId:"0784389", born:date('1960-03-21'), name:"Ayrton Senna", bio:"Ayrton Senna da Silva was a Brazilian racing driver who won three Formula One world championships for McLaren in 1988, 1990 and 1991, and is widely regarded as one of the greatest Formula One drivers of all time...", died:date('1994-05-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qnQoejAqWO6ECCZAZNGJmXwURWs.jpg", url:"https://themoviedb.org/person/149192"}}, {tmdbId:"149193", properties:{bornIn:"Saint-Chamond, France", imdbId:"1169354", born:date('1955-02-24'), name:"Alain Prost", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cV7P1fG1Bhb1Jr8IcqHNkCIVEY8.jpg", url:"https://themoviedb.org/person/149193"}}, {tmdbId:"229855", properties:{bornIn:"South Shields, County Durham, England, UK", imdbId:"2604029", born:date('1942-04-16'), name:"Frank Williams", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hJBHslzIb683cXTwCI5XiQLtU8y.jpg", url:"https://themoviedb.org/person/229855"}}, {tmdbId:"167391", properties:{bornIn:"Woking, England", imdbId:"2651182", born:date('1947-06-01'), name:"Ron Dennis", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kjcfPZqE9G5kaiAuVW6o84Dqmkz.jpg", url:"https://themoviedb.org/person/167391"}}, {tmdbId:"1260745", properties:{bornIn:"San Francisco, California, USA", imdbId:"0297306", born:date('1964-01-01'), name:"Tony Fucile", url:"https://themoviedb.org/person/1260745"}}, {tmdbId:"225986", properties:{imdbId:"1751461", name:"Lori Richardson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o0I2nhMHyN0QxoolRqs08yhZozu.jpg", url:"https://themoviedb.org/person/225986"}}, {tmdbId:"115699", properties:{bornIn:"Hokkaido, Japan", imdbId:"2440398", born:date('1986-01-23'), name:"Yukie Kawamura", bio:"From Wikipedia, the free encyclopedia\n\nYukie Kawamura (born January 23, 1986) is a Japanese gravure idol, tarento, and actress signed to Japan Art. \n\nDescription above from the Wikipedia article Yukie Kawamura, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4Q7sZmXakHbDlFPXPeE9CucuYAV.jpg", url:"https://themoviedb.org/person/115699"}}, {tmdbId:"115700", properties:{bornIn:"Tokyo, Japan", imdbId:"1102191", born:date('1981-08-22'), name:"Takumi Saitô", bio:"Takumi Saitō (斎 藤 工 Saitō Takumi, Tokyo, Japan, August 22, 1981) is a Japanese actor, singer and model. \n\nSaitō was born on August 22, 1981 in the city of Tokyo, Japan.  He made his acting debut in 1992, playing a small role in the Japanese drama Ippai no kakesoba.  In the following years I would work as a model for companies like Calvin Klein and Issey Miyake...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3O6VgunrTqhKSGbbfl8E2xZYgvt.jpg", url:"https://themoviedb.org/person/115700"}}, {tmdbId:"117116", properties:{bornIn:"Bangkok, Thailand", imdbId:"2937341", born:date('1982-10-12'), name:"Eri Otoguro", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2ltAXKqBr1wbNp9KI5jIstyeZkw.jpg", url:"https://themoviedb.org/person/117116"}}, {tmdbId:"115702", properties:{bornIn:"Fukui, Japan", imdbId:"2840020", born:date('1976-01-08'), name:"Sayaka Kametani", url:"https://themoviedb.org/person/115702"}}, {tmdbId:"93564", properties:{bornIn:"Helsinki, Finland", imdbId:"2273799", born:date('1982-09-30'), name:"Pihla Viitala", bio:"Pihla Viitala (b.  1982) is a Finnish actress.  She studied acting at the Helsinki Theatre Academy.  When she was younger, she used to play the viola.  More recently, Viitala gave birth to her daughter in 2012...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8vMyQVGnPkpLNrViKPsTLiE9hZS.jpg", url:"https://themoviedb.org/person/93564"}}] AS row
