UNWIND [{tmdbId:"62520", properties:{bornIn:"Baltimore, Maryland, U.S.", imdbId:"0005437", born:date('1978-11-09'), name:"Sisqó", bio:"​From Wikipedia, the free encyclopedia.   \n\nMark Althavean Andrews (born November 9, 1978), known by his stage name Sisqó, is an American R&B singer and actor.  He is best known as the lead singer of R&B group Dru Hill, and also for \"Thong Song\", a song from his first solo LP, Unleash the Dragon, that became an international hit. \n\nDescription above from the Wikipedia article Sisqó, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ll6ymdOz4RDi7HE41smAMr82fRd.jpg", url:"https://themoviedb.org/person/62520"}}, {tmdbId:"92857", properties:{bornIn:"Oshawa, Ontario, Canada", imdbId:"0363371", born:date('1973-12-05'), name:"Shalom Harlow", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gbMjE0SzC784rjey4OGztdQT80s.jpg", url:"https://themoviedb.org/person/92857"}}, {tmdbId:"29930", properties:{bornIn:"Sarajevo, Bosnia and Herzegovina, Yugoslavia [now Sarajevo, Bosnia and Herzegovina]", imdbId:"0587431", born:date('1974-04-26'), name:"Ivana Milicevic", bio:"Ivana Miličević (born April 26, 1974 in Sarajevo, Bosnia and Herzegovina, Yugoslavia) is a Bosnian-American actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9zfChGFSnvWpu6TdBRNF0OvMyRo.jpg", url:"https://themoviedb.org/person/29930"}}, {tmdbId:"555907", properties:{imdbId:"0279918", name:"Brian Fisk", url:"https://themoviedb.org/person/555907"}}, {tmdbId:"557139", properties:{bornIn:"Massachusetts, USA", imdbId:"0504875", name:"Fred A. Leuchter Jr.", bio:"From Wikipedia, the free encyclopedia. \n\nFrederick A.  (Fred) Leuchter, Jr.  (born 1944) is an American Federal Court qualified expert in execution technology and author of forensic Holocaust denial material.  He claims to have improved the design of instruments for capital punishment and had execution equipment contracts with several states...", url:"https://themoviedb.org/person/557139"}}, {tmdbId:"557140", properties:{imdbId:"0887721", name:"Robert Jan Van Pelt", bio:"From Wikipedia, the free encyclopedia. \n\nRobert Jan van Pelt (born August 15, 1955 in Haarlem, Netherlands) is an author, architectural historian, professor at the University of Waterloo and University of Toronto in Ontario and a Holocaust scholar.  One of the world's leading experts on Auschwitz, he regularly speaks on Holocaust related topics, through which he has come to address Holocaust denial...", url:"https://themoviedb.org/person/557140"}}, {tmdbId:"557141", properties:{bornIn:"Brentwood, Essex, England", imdbId:"0410257", born:date('1938-03-24'), name:"David Irving", bio:"From Wikipedia, the free encyclopedia. \n\nDavid John Cawdell Irving (born 24 March 1938) is an English writer specializing in the military history of World War II.  He is the author of 30 books on the subject, including The Destruction of Dresden (1963), Hitler's War (1977), Uprising! (1981), Churchill's War (1987), and Goebbels: Mastermind of the Third Reich (1996). \n\nHis work on Nazi Germany became controversial because of his sympathy for the Third Reich and antisemitism...", url:"https://themoviedb.org/person/557141"}}, {tmdbId:"557143", properties:{imdbId:"0504877", name:"Caroline Leuchter", url:"https://themoviedb.org/person/557143"}}, {tmdbId:"57686", properties:{bornIn:"Iowa City, Iowa, USA", imdbId:"0004991", born:date('1966-05-17'), name:"Hill Harper", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bUzVvgD066zYGJ9amJzgoGivlqD.jpg", url:"https://themoviedb.org/person/57686"}}, {tmdbId:"57451", properties:{bornIn:"Bismarck, North Dakota, USA", imdbId:"0004753", born:date('1974-11-17'), name:"Leslie Bibb", bio:"Leslie Louise Bibb (born November 17, 1974) is an American actress and former fashion model.  She transitioned into film and television in late 1990s.  She appeared in television shows such as Home Improvement (1996), before she appeared in her first film, the comedy Private Parts (1997), which was followed by her first show The Big Easy.  She received a role in This Space Between Us (1999)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w57rS8jcJ1aHPkCynta1J4dlah.jpg", url:"https://themoviedb.org/person/57451"}}, {tmdbId:"64880", properties:{bornIn:"Seoul, South Korea", imdbId:"0158856", born:date('1962-04-27'), name:"Min-sik Choi", bio:"Choi Min-Sik was born on January 22, 1962 and first achieved fame on the stage and on television.  He started appearing in films in 1992 and soon began making his mark in such notable works as Ji-Wun Kim’s The Quiet Family (1998).  Commercial success came his way in 1999, when he played a North Korean spy in Kang Je-Gyu’s blistering action film, Shiri, a huge box office smash...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sd7gIA6nEkq6zumkDCfxSE0YSSV.jpg", url:"https://themoviedb.org/person/64880"}}, {tmdbId:"28662", properties:{bornIn:"Seoul, South Korea", imdbId:"0453746", born:date('1973-11-07'), name:"Yunjin Kim", bio:"Yunjin Kim (born November 7, 1973) is a Korean American film and theater actress.  Although she is best known in the English-speaking world for her role as Sun on the American television series Lost, Kim has also appeared in numerous film and TV projects in South Korea. \n\nDescription above from the Wikipedia article Yunjin Kim, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xS7eco56mUiZGJGWDZ0pwzrUAei.jpg", url:"https://themoviedb.org/person/28662"}}, {tmdbId:"41421", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0607185", born:date('1979-04-12'), name:"Jennifer Morrison", bio:"Jennifer Morrison (born April 12, 1979) is an American actress, model and film producer.  She is best known for her roles on House and Once Upon A Time as well as How I Met Your Mother...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rZyw2K22rN9BgxP5FBclfr9uMcc.jpg", url:"https://themoviedb.org/person/41421"}}, {tmdbId:"82096", properties:{bornIn:"Montréal - Québec - Canada", imdbId:"0664175", born:date('1980-12-05'), name:"Jessica Paré", bio:"Jessica Paré (born December 5, 1980) is a Canadian film and television actress.  She has appeared in the films Stardom (2000), Lost and Delirious (2001), Wicker Park (2004), Hot Tub Time Machine (2010), and co-starred in the vampire horror-comedy Suck (2009).  She plays Megan on the fourth season of the American TV series Mad Men...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d6Xz1zmV8L0Zt04shYKDy4xOPV.jpg", url:"https://themoviedb.org/person/82096"}}, {tmdbId:"101798", properties:{imdbId:"0795281", name:"Victoria Snow", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wCGVrwbNcfbEnRUi481SsWzjhDB.jpg", url:"https://themoviedb.org/person/101798"}}, {tmdbId:"127495", properties:{bornIn:"Montréal, Québec, Canada", imdbId:"0340284", born:date('1968-06-07'), name:"Macha Grenon", bio:"Macha Grenon is a Montreal-based actress who has been working in film, television and the theatre for the past 20 years.  She has received Gemeaux, Gemini and Genie nominations for her work in both French and English including Juliette Pommerleau, Familia, Mon meilleur ennemi, as well as for her role of Nathalie Belding in Ann Wheeler's critically acclaimed CBC production of the Sleep Room...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2QPMfwGQY47KZ6AA2yaxMFuZgkV.jpg", url:"https://themoviedb.org/person/127495"}}, {tmdbId:"228424", properties:{bornIn:"Toyama prefecture, Japan.", born:date('1964-01-20'), name:"Yoshikazu Fujiki", bio:"From Wikipedia, the free encyclopedia. \n\nYoshikatsu Fujiki is an actor and veteran seiyū, or voice actor, born on January 20, 1964 in Japan. \n\nHe is famous for his roles in the Kerberos saga, as Inui (StrayDog: Kerberos Panzer Cops), Kazuki Fuse (Jin-Roh), Chuichi Koshiramaru (Tachiguishi-Retsuden) and also for his unusual stature of 190cm per 86kg. \n\nFujiki more recently featured in Mamoru Oshii's live-action movie Assault Girls (2009)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pVoDAcHDyR5g7lBkPw8QPG1nuw4.jpg", url:"https://themoviedb.org/person/228424"}}, {tmdbId:"1308714", properties:{name:"Sumi Mutoh", url:"https://themoviedb.org/person/1308714"}}, {tmdbId:"12192", properties:{imdbId:"1845401", name:"Hiroyuki Kinosha", url:"https://themoviedb.org/person/12192"}}, {tmdbId:"7691", properties:{bornIn:"Sainte-Adresse, Seine-Maritime, France", imdbId:"0239764", born:date('1977-01-01'), name:"Caroline Ducey", bio:"Caroline Ducey was born on December 12, 1976 in Sainte-Adresse, Seine-Maritime, France.  She is an actress, known for Romance (1999), The Soul Keeper (2002) and The Cage (2002)...", url:"https://themoviedb.org/person/7691"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"7692", properties:{imdbId:"0836683", born:date('1974-06-09'), name:"Sagamore Stévenin", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9br3ZNBbNqD3PhKOX3UXQwa5K12.jpg", url:"https://themoviedb.org/person/7692"}}, {tmdbId:"22159", properties:{bornIn:"Wimbledon, South London, England, UK", imdbId:"0167340", born:date('1961-11-28'), name:"Martin Clunes", bio:"From Wikipedia, the free encyclopedia. \n\nAlexander Martin Clunes (born 28 November 1961) is an English actor and comedian.  Clunes is perhaps best known for his roles as Gary Strang in Men Behaving Badly, Doctor Martin Ellingham in Doc Martin and the title character in Reggie Perrin. \n\nDescription above from the Wikipedia article Martin Clunes, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xoCgVr1h3uhES9MnKCoyd05bW1v.jpg", url:"https://themoviedb.org/person/22159"}}, {tmdbId:"6317", properties:{imdbId:"0225767", name:"Dawn Didawick", url:"https://themoviedb.org/person/6317"}}, {tmdbId:"17303", properties:{bornIn:"Cherry Hill, New Jersey, USA", imdbId:"0005123", born:date('1976-02-28'), name:"Ali Larter", bio:"Alison Elizabeth \"Ali\" Larter (born February 28, 1976) is an American actress best known for playing the dual roles of Niki Sanders and Tracy Strauss on the NBC science fiction drama Heroes. \n\nShe also appeared in guest roles on several television shows in the 1990s.  Her screen debut came in the 1999 film Varsity Blues, followed by the horror films House on Haunted Hill and Final Destination...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mdDD8ttiLGw91sEe1QLV1DJYPfe.jpg", url:"https://themoviedb.org/person/17303"}}, {tmdbId:"43442", properties:{bornIn:"Exton, Pennsylvania, USA", imdbId:"0005445", born:date('1972-03-09'), name:"Kerr Smith", bio:"Kerr Van Cleve Smith (born March 9, 1972) is an American actor best known for playing Jack McPhee on The WB drama series Dawson's Creek and more recently Axel Palmer in My Bloody Valentine 3D.  He is also known for portraying Carter Horton in Final Destination and Ryan Thomas in The CW drama series, Life Unexpected. \n\nDescription above from the Wikipedia article Kerr Smith, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tL6w7wxwWMiyy7DGTpYoPTeVqzZ.jpg", url:"https://themoviedb.org/person/43442"}}, {tmdbId:"58392", properties:{bornIn:"Van Nuys, California, USA", imdbId:"0167028", born:date('1968-09-02'), name:"Kristen Cloke", bio:"Kristen Cloke is an American film and television actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9MTNs9kMX6OTR6SJwMkwG3EVTsN.jpg", url:"https://themoviedb.org/person/58392"}}, {tmdbId:"51944", properties:{bornIn:"Indianapolis, Indiana, USA", imdbId:"0258402", born:date('1970-11-18'), name:"Mike Epps", bio:"From Wikipedia, the free encyclopedia. \n\nMichael Elliot \"Mike\" Epps (born November 18, 1970) is an American stand-up comedian, actor, film producer, writer, singer, musician, and rapper, best known for playing Day-Day Jones in Next Friday and the sequel-to-the-sequel, Friday After Next, and also starring alongside Ice Cube in All About The Benjamins.  He is known as the new voice of Boog in Open Season 2 and Open Season 3...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kDI4E3ALm2rVkF38GwhWwXmDq0a.jpg", url:"https://themoviedb.org/person/51944"}}, {tmdbId:"56902", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"0936762", born:date('1942-01-27'), name:"John Witherspoon", bio:"John Witherspoon was an African-American comedian and actor who has roles in over 20 movies and television shows.  Acting for over three decades, Witherspoon starred in films such as Hollywood Shuffle (1987), Boomerang (1992), and the Friday film series.  He also made appearances on television shows such as Barnaby Jones (1973), The Wayans Brothers (1994-99), The Tracy Morgan Show (2003), and Boondocks (2005)...", died:date('2019-10-29'), url:"https://themoviedb.org/person/56902"}}, {tmdbId:"54614", properties:{bornIn:"New Jersey, U.S.", imdbId:"0473329", name:"Shawn Ku", bio:"From Wikipedia, the free encyclopedia. \n\nShawn Ku is a U. S.  choreographer and motion picture director.  He has also danced on Broadway, and acted in an independent feature-length film.  Inspired by his family's personal connection to the Virginia Tech shooting and unexpected death of a visiting friend, Shawn Ku developed his 2010 film \"Beautiful Boy\" from those experiences. \n\nDescription above from the Wikipedia article Shawn Ku, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/54614"}}, {tmdbId:"54616", properties:{imdbId:"1146415", name:"Lhakpa Tsering", url:"https://themoviedb.org/person/54616"}}, {tmdbId:"65850", properties:{imdbId:"0768319", name:"Carolyn Saxon", url:"https://themoviedb.org/person/65850"}}, {tmdbId:"18315", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0444621", born:date('1979-05-28'), name:"Monica Keena", bio:"Monica C.  Keena (born May 28, 1979) is an American actress, known for her roles on Dawson's Creek, Undeclared, Entourage, and in Freddy vs.  Jason...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/f4dD2ohtjJZweo6nbvu38OpSsCO.jpg", url:"https://themoviedb.org/person/18315"}}, {tmdbId:"7905", properties:{bornIn:"Pasadena, California.", imdbId:"0316701", born:date('1996-01-01'), name:"Mary Gibbs", url:"https://themoviedb.org/person/7905"}}, {tmdbId:"1298108", properties:{name:"Michael Nuccio", url:"https://themoviedb.org/person/1298108"}}, {tmdbId:"2388714", properties:{name:"Allison Nega", url:"https://themoviedb.org/person/2388714"}}, {tmdbId:"36073", properties:{imdbId:"0782858", name:"Yusuke Sekiguchi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q6mtGxYOyeF5kp4iZwpSN9OpZXS.jpg", url:"https://themoviedb.org/person/36073"}}, {tmdbId:"2681252", properties:{name:"The Great Gidayû", url:"https://themoviedb.org/person/2681252"}}, {tmdbId:"150055", properties:{imdbId:"0154071", born:date('1986-05-17'), name:"Glenndon Chatman", url:"https://themoviedb.org/person/150055"}}, {tmdbId:"150057", properties:{imdbId:"0929615", name:"Jess Willard", url:"https://themoviedb.org/person/150057"}}, {tmdbId:"77196", properties:{bornIn:"Indianapolis, Indiana, USA", imdbId:"0912703", born:date('1990-01-15'), name:"Chris Warren", bio:"Chris Warren Jr.  (born January 15, 1990) is an American actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xBVDjsdeJacMJhSX2WkYRIuat1M.jpg", url:"https://themoviedb.org/person/77196"}}] AS row
