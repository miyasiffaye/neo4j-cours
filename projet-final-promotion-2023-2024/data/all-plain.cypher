UNWIND [{tmdbId:"16240", properties:{bornIn:"Roma", imdbId:"0227958", born:date('1966-10-01'), name:"Stefano Dionisi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ekgIO4EoXwy6FESDscT6f4eEcON.jpg", url:"https://themoviedb.org/person/16240"}}, {tmdbId:"27392", properties:{bornIn:"Palermo, Sicily, Italy", imdbId:"0516272", born:date('1964-01-18'), name:"Enrico Lo Verso", bio:"​From Wikipedia, the free encyclopedia\n\nEnrico Lo Verso (born January 18, 1964) is an Italian actor.  He studied acting at Centro Sperimentale di Cinematografia and INDA|Istituto Nazionale del Dramma Antico. \n\nDescription above from the Wikipedia article Enrico Lo Verso, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/riYINKQIv8mxYwtfj0L899K0iPu.jpg", url:"https://themoviedb.org/person/27392"}}, {tmdbId:"39195", properties:{bornIn:"Paris, France", imdbId:"0959113", born:date('1968-10-16'), name:"Elsa Zylberstein", bio:"Elsa Zylberstein (born 16 October 1968) is a French film, TV, and stage actress.  After studying drama, Zylberstein began her film career in 1989, and has appeared in about 50 films.  She won the César Award for Best Supporting Actress for I've Loved You So Long (2008). \n\nDescription above from the Wikipedia article Elsa Zylberstein, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bw1bIuyfyOyxRlx2qIKk4AwQLTU.jpg", url:"https://themoviedb.org/person/39195"}}, {tmdbId:"83882", properties:{bornIn:"Prague, Protectorate Bohemia and Moravia [now Czech Republic]", imdbId:"0148393", born:date('1940-09-16'), name:"Petr Cepek", bio:"Petr Čepek was a Czech actor associated with The Drama Club in Prague.  His final film was Faust, directed by Czech surrealist Jan Švankmajer.  Cepek attended the Academy of Performing Arts (DAMU) along with many notable Czech actors of the time, before appearing in Ostrava’s first theater, DPB until 1965...", died:date('1994-09-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aL4DF6fXFYE3S7Bwaqr1QpZcuCM.jpg", url:"https://themoviedb.org/person/83882"}}, {tmdbId:"136797", properties:{bornIn:"Prague, Czechoslovakia [now Czech Republic]", imdbId:"0470130", born:date('1953-08-15'), name:"Jan Kraus", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xyDo3C0VLseAqaP8jV5F3WTj45V.jpg", url:"https://themoviedb.org/person/136797"}}, {tmdbId:"1320281", properties:{imdbId:"0473773", name:"Vladimír Kudla", url:"https://themoviedb.org/person/1320281"}}, {tmdbId:"544286", properties:{imdbId:"0951711", born:date('1908-11-22'), name:"Antonin Zacpal", url:"https://themoviedb.org/person/544286"}}, {tmdbId:"37821", properties:{bornIn:"Independence - Mississippi - USA", imdbId:"0402011", born:date('1985-03-01'), name:"Michael Conner Humphreys", bio:"Michael Conner Humphreys was born in 1985 in Independence, Mississippi, USA.  He is an actor, known for Forrest Gump (1994), Pathfinders: In the Company of Strangers (2011) and Little Forrest (2009)...", url:"https://themoviedb.org/person/37821"}}, {tmdbId:"10726", properties:{bornIn:"Bilston, Staffordshire, England, UK", imdbId:"0281424", born:date('1952-03-11'), name:"James Fleet", bio:"​James Edward Fleet (born 11 March 1952) is an English actor.  He is most famous for his roles as the bumbling and well-meaning Tom in the 1994 British romantic comedy film Four Weddings and a Funeral, and the dim-witted Hugo Horton in the BBC situation comedy television series The Vicar of Dibley...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4aG8nTReLO0GhDCSoV4CtXejeYD.jpg", url:"https://themoviedb.org/person/10726"}}, {tmdbId:"4001", properties:{bornIn:"Streatham, London, England, UK", imdbId:"0001003", born:date('1949-06-13'), name:"Simon Callow", bio:"An English actor, writer and theatre director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/arDoYD78OjhczHy07KIOJynwATU.jpg", url:"https://themoviedb.org/person/4001"}}, {tmdbId:"10727", properties:{bornIn:"East Kilbride, Scotland, UK", imdbId:"0001314", born:date('1962-04-23'), name:"John Hannah", bio:"John Hannah (born 23 April 1962) is a Scottish actor of film and television.  He has appeared in Stephen Sommers' Mummy Series, Richard Curtis' Four Weddings and a Funeral and Sliding Doors with Gwyneth Paltrow...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iBMshh31YpMZPX3M3vUoL8itBa5.jpg", url:"https://themoviedb.org/person/10727"}}, {tmdbId:"75601", properties:{bornIn:"The Bronx, New York, USA", imdbId:"0625735", born:date('1980-05-09'), name:"Sean Nelson", bio:"Sean Nelson was born on May 9, 1980.  He is an actor and producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e6aVmnt8N6eMAilosvGpZ5YGmiM.jpg", url:"https://themoviedb.org/person/75601"}}, {tmdbId:"10824", properties:{bornIn:"New York City, New York, U.S.", imdbId:"0942668", born:date('1970-09-20'), name:"N'Bushe Wright", bio:"​From Wikipedia, the free encyclopedia.   \n\nN'Bushe Wright (pronounced nuh-BOO-shay, born September 20, 1970 in New York City, New York, U. S. ) is an American film and television actress, known mainly for her part in Blade.  A native of New York City, she is the daughter of jazzman Stanely Wright aka Suleiman-Marim Wright.  Her mother is a psychologist with the New York City Board of Education...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jSXuSko6tZQ69LfJEMmNLiXEOS8.jpg", url:"https://themoviedb.org/person/10824"}}, {tmdbId:"3712", properties:{bornIn:"Wolfratshausen, Germany", imdbId:"0007210", born:date('1948-07-02'), name:"Saul Rubinek", bio:"From Wikipedia, the free encyclopedia. \n\nSaul Rubinek (born July 2, 1948) is a Canadian film and television actor.  He has also directed and produced feature-length films. \n\nEarly life\n\nRubinek was born in Föhrenwald, Wolfratshausen, Germany, the son of Polish Jews Frania and Israel Rubinek, who was a factory worker, theatre company manager, Yiddish Theatre actor, and Talmudic scholar...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kW7w2yaVk5vertF6UnPLrCLExSN.jpg", url:"https://themoviedb.org/person/3712"}}, {tmdbId:"12312", properties:{bornIn:"Long Branch, New Jersey, USA", imdbId:"0027323", born:date('1926-08-08'), name:"Richard Anderson", bio:"Richard Norman Anderson (born August 8, 1926) was an American film and television actor...", died:date('2017-08-31'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AiAPSDhMNu7zoZRngj8dISNk1rA.jpg", url:"https://themoviedb.org/person/12312"}}, {tmdbId:"161537", properties:{imdbId:"0045057", name:"Thomas Babson", url:"https://themoviedb.org/person/161537"}}, {tmdbId:"44616", properties:{imdbId:"0051820", name:"Monty Bane", url:"https://themoviedb.org/person/44616"}}, {tmdbId:"1638928", properties:{name:"V.S. Brodie", url:"https://themoviedb.org/person/1638928"}}, {tmdbId:"32030", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0877587", born:date('1968-05-23'), name:"Guinevere Turner", bio:"From Wikipedia, the free encyclopedia\n\nGuinevere Turner (May 23, 1968) is an American actress, writer and director.  She was born in Boston, Massachusetts.  She is best known as the screenwriter of such films as American Psycho and The Notorious Bettie Page and for playing the lead role of the dominatrix, Tanya Cheex, in Preaching to the Perverted. \n\nDescription above from the Wikipedia article Guinevere Turner, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1j0RtYIayM7LOsT8bispVHsKBia.jpg", url:"https://themoviedb.org/person/32030"}}, {tmdbId:"1804391", properties:{name:"T. Wendy McMillan", url:"https://themoviedb.org/person/1804391"}}] AS row
