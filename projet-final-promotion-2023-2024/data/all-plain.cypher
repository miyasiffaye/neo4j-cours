UNWIND [{tmdbId:"232006", properties:{bornIn:"Los Angeles, California, USA", imdbId:"1822659", born:date('1994-12-17'), name:"Nat Wolff", bio:"Nathaniel Marvin \"Nat\" Wolff (born December 17, 1994) is an American child actor, and singer-songwriter, composer, and keyboardist.  He is the frontman of Nat & Alex Wolff.  He is best known for his role as himself on the Nickelodeon series The Naked Brothers Band...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oqDJSGjomTiOkgfFGHTQsIPFPyt.jpg", url:"https://themoviedb.org/person/232006"}}, {tmdbId:"96230", properties:{imdbId:"5367916", name:"Gottfrid Svartholm", url:"https://themoviedb.org/person/96230"}}, {tmdbId:"1150487", properties:{imdbId:"5460016", name:"Peter Sunde", url:"https://themoviedb.org/person/1150487"}}, {tmdbId:"96232", properties:{imdbId:"5461033", name:"Fredrik Neij", url:"https://themoviedb.org/person/96232"}}, {tmdbId:"1554785", properties:{name:"Sarah Jaffe", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dUU6G4qVecDLsnZ1cxjQxHedSt6.jpg", url:"https://themoviedb.org/person/1554785"}}, {tmdbId:"5208", properties:{bornIn:"Berlin, Germany", imdbId:"1269047", born:date('1980-03-25'), name:"Hanno Koffler", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/NP6gppr444mvP1BmHuEbPxt7bs.jpg", url:"https://themoviedb.org/person/5208"}}, {tmdbId:"28558", properties:{bornIn:"Banat, Romania", imdbId:"0096965", born:date('1968-07-18'), name:"Attila Borlan", url:"https://themoviedb.org/person/28558"}}, {tmdbId:"1153015", properties:{bornIn:"Santa Clara, California, USA", imdbId:"3849461", born:date('1984-03-15'), name:"Matthew Camp", bio:"Matthew Camp was born on March 15, 1984 in Santa Clara, California, USA as Matthew Stephen Camp.  He is an actor, known for Getting Go, the Go Doc Project (2013) and Sock Job (2016). \n\nHas made his mainstream adult film debut in Camp Chaos (2019)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6RQyW4qAIRmBB8W4RRzJAjD9I0v.jpg", url:"https://themoviedb.org/person/1153015"}}, {tmdbId:"2633548", properties:{name:"Ramon O. Torres", url:"https://themoviedb.org/person/2633548"}}, {tmdbId:"207150", properties:{imdbId:"1274797", born:date('1978-07-13'), name:"Jessica Barth", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vQBxmLtlGqT8CuOnBwtzIWdwnNH.jpg", url:"https://themoviedb.org/person/207150"}}, {tmdbId:"142213", properties:{bornIn:"Tehran, Iran", imdbId:"2258164", born:date('1980-05-22'), name:"Nazanin Boniadi", bio:"Nazanin Boniadi was born in Tehran, Iran, at the height of the Iranian Revolution; her parents relocated to London shortly thereafter.  She performed violin and ballet as a young girl. \n\nShe attended a private high school and later moved to the United States where she earned a bachelor's degree, with honors, in biological sciences from the University of California, Irvine...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vzpDjbrI2GlLJSSzp8jUE2cFYd.jpg", url:"https://themoviedb.org/person/142213"}}, {tmdbId:"117640", properties:{bornIn:"İzmir, Turkey", imdbId:"0082211", born:date('1954-06-05'), name:"Haluk Bilginer", bio:"Nihat Haluk Bilginer is a Turkish actor.  In addition to his acting career in Turkey, he has also worked in the United Kingdom and remains best known for his role as Mehmet Osman in the television soap opera EastEnders during the 1980s.  He has also starred in Hollywood movies as a minor actor.  He has won a Palme d'Or for his performance in Winter Sleep in 2014, and an Emmy for his performance in Şahsiyet in 2018...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fXZTXaJ76k9Np7v4KxkwRGvlNSX.jpg", url:"https://themoviedb.org/person/117640"}}, {tmdbId:"90060", properties:{bornIn:"Copenhagen, Denmark", imdbId:"1561982", born:date('1982-03-02'), name:"Pilou Asbæk", bio:"Johan Philip \"Pilou\" Asbæk (born 2 March 1982) is a Danish actor. \n\nAsbæk, the son of gallery owners Patricia and Jacob Asbæk, graduated from Denmark's Statens Teaterskole in summer 2008.  He is best known for his role as troubled spin doctor Kasper Juul in the Danish TV political drama Borgen, which is his biggest role to date.  In 2009 he played soldier David Grüner in an episode of the second season of another Danish TV series, Forbrydelsen...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iNLpeS6swvmeDGHgYYNMDPPNNIT.jpg", url:"https://themoviedb.org/person/90060"}}, {tmdbId:"1466778", properties:{imdbId:"1328512", name:"Tatyana Zbirovskaya", url:"https://themoviedb.org/person/1466778"}}, {tmdbId:"1944556", properties:{bornIn:"Vladivostok, USSR (Russia)", imdbId:"3573100", born:date('1987-07-23'), name:"Olya Zueva", bio:"Director, actress.  Born in Vladivostok.  From 2006-2016 lived and worked in New York.  Received actor’s training at the famous school of Susan Batson, studied at the film faculty at The New School.  In parallel to her studies appeared in episodic roles (e. g. , in the series “Orange is the New Black”), played the lead role in Anna Melikian’s short “Such a Mood.  Bach’s Adagio and a Small Fragment from the Life of the Girl Lena”, scripted and directed short films.  In 2016 moved to Moscow...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p7nsR05dN6PqqDUXwSzpdbBzYAY.jpg", url:"https://themoviedb.org/person/1944556"}}, {tmdbId:"556356", properties:{bornIn:"Wimbledon, London, England, UK", imdbId:"3948952", born:date('1988-04-18'), name:"Vanessa Kirby", bio:"Vanessa Kirby (born 18 April 1988) is an English stage, TV and film actress. \n\nShe starred as Estella in the BBC adaptation of Great Expectations in 2011, as Joanna in Richard Curtis' romantic comedy About Time in 2013, and as Princess Margaret in Peter Morgan's Netflix series The Crown.  She is known mostly for her stage work, with Variety in 2016 calling her \"the outstanding stage actress of her generation, capable of the most unexpected choices...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aB0o6r5msso6tCXTuVgKVO4wRqg.jpg", url:"https://themoviedb.org/person/556356"}}, {tmdbId:"971049", properties:{bornIn:"Hackney, London, England", imdbId:"2916966", name:"David Ajala", bio:"David Ajala is an actor and producer, known for The Dark Knight (2008), Fast & Furious 6 (2013) and Jupiter Ascending (2015).  Performing with the Royal Shakespeare Company at the Courtyard Theatre in Stratford-upon-Avon (2008)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iD0ztIXTm4fGKf5IJ2PlngSbt0G.jpg", url:"https://themoviedb.org/person/971049"}}, {tmdbId:"147894", properties:{bornIn:"Solihull, Birmingham, England", imdbId:"2168260", born:date('1979-12-27'), name:"Tom McKay", bio:"Tom McKay Is Most Known In British Productions.  He's Starred In The Amercian Film The Harrow Which Was Released After 2016...", url:"https://themoviedb.org/person/147894"}}, {tmdbId:"1021441", properties:{imdbId:"3122871", name:"George Finn", url:"https://themoviedb.org/person/1021441"}}, {tmdbId:"96841", properties:{bornIn:"Leeds, West Yorkshire, England, UK", imdbId:"0507535", born:date('1989-06-27'), name:"Matthew Lewis", bio:"Matthew David Lewis III is an English actor, best known for playing Neville Longbottom in the Harry Potter films. \n\nLewis was born in Horsforth,Leeds,West Yorkshire, England, the son of Adrian and Lynda Lewis.  He has two older brothers and a foster sister. \n\nLewis has been acting since he was five years old.  He started off with minor parts in television programmes, debuting in Some Kind of Life, and then went on to try out for the part of Neville Longbottom...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oDF0GxbLmbuZurVwdXvGn8vc78v.jpg", url:"https://themoviedb.org/person/96841"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"1556323", properties:{imdbId:"0946225", name:"Bettina Skye", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dySDFW9SNkPBn89xCAB8gQqvMko.jpg", url:"https://themoviedb.org/person/1556323"}}, {tmdbId:"150899", properties:{bornIn:" Shanghai, China", imdbId:"2854802", born:date('1989-02-28'), name:"Angelababy", bio:"Angela Yeung, better known by her stage name Angelababy, is a Chinese model, actress, and singer based in Hong Kong.  Her stage name came from the combination of her English name \"Angela\" and her nickname \"Baby\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1kaY6eHAmExiaauxFSyekmLpsNB.jpg", url:"https://themoviedb.org/person/150899"}}, {tmdbId:"1183546", properties:{bornIn:"Rochester, Minnesota, USA", imdbId:"2045884", born:date('1969-11-18'), name:"Dan Bakkedahl", bio:"Dan Bakkedahl was born on November 18, 1969.  He is an actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vo5sW2u8bGXJvfe6lL0KmrPNGGG.jpg", url:"https://themoviedb.org/person/1183546"}}, {tmdbId:"1503685", properties:{imdbId:"1026278", name:"Charlene Beck", url:"https://themoviedb.org/person/1503685"}}, {tmdbId:"40692", properties:{imdbId:"1095432", name:"Michael Bornhütter", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2Z8m9k4hezS6wxnhCaSkExKlWy8.jpg", url:"https://themoviedb.org/person/40692"}}, {tmdbId:"47720", properties:{bornIn:"Ashford, Surrey, England", imdbId:"2235721", born:date('1982-01-13'), name:"Ruth Wilson", bio:"Ruth Wilson (born 13 January 1982) is an English actress, perhaps best known for her performance in the title role of Jane Eyre. \n\nDescription above from the Wikipedia article Ruth Wilson (actress), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tm14lpdqb0CDkfiucc1NIiomdXQ.jpg", url:"https://themoviedb.org/person/47720"}}, {tmdbId:"125660", properties:{bornIn:" Dublin, Ireland", imdbId:"0778831", born:date('1976-10-21'), name:"Andrew Scott", bio:"Andrew Scott (born October 21, 1976) is an Irish film, television, and stage actor.  He received the 2005 Laurence Olivier Award for Outstanding Achievement in an Affiliate Theatre for the Jerwood Theatre Upstairs production of A Girl in a Car with a Man and an IFTA award for the film Dead Bodies.  Scott's notable television roles have included Paul McCartney in the BBC television drama Lennon Naked and arch-villain Moriarty in Sherlock...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8qyt6HheUQvLwargYvs5EcsceGz.jpg", url:"https://themoviedb.org/person/125660"}}, {tmdbId:"213001", properties:{bornIn:"Milton, Massachusetts, USA", imdbId:"2809577", born:date('1982-03-25'), name:"Jenny Slate", bio:"Jenny Sarah Slate (born March 25, 1982) is an American stand-up comedian, actress, voice actress and author, known for her role as Mona Lisa Saperstein on 'Parks and Recreation' as well as being the co-creator of the 'Marcel the Shell with Shoes On' short films and children's book series...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8YgcvpcNPjfIvnqXGJ31dzIWl17.jpg", url:"https://themoviedb.org/person/213001"}}, {tmdbId:"1899368", properties:{name:"Vivian Maier", url:"https://themoviedb.org/person/1899368"}}, {tmdbId:"1899369", properties:{name:"Daniel Arnaud", url:"https://themoviedb.org/person/1899369"}}, {tmdbId:"1899370", properties:{name:"Simon Amédé", url:"https://themoviedb.org/person/1899370"}}, {tmdbId:"566101", properties:{bornIn:"Szczecin, Poland", born:date('1971-09-27'), name:"Agata Kulesza", bio:"From Wikipedia, the free encyclopedia\n\nAgata Kulesza (Polish pronunciation: [aˈgata kuˈlɛʂa]; born 27 September 1971) is a Polish film, television and stage actress, and a member of the Polish Film Academy.  In 2013 she appeared in the critically acclaimed Ida.  She was a contestant in season eight of Taniec z gwiazdami (English: Dancing with Stars) in 2008.  She gained wide popularity in mass media after winning the competition...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mnBUebcvzaEWppZJUCq6FEOkDsk.jpg", url:"https://themoviedb.org/person/566101"}}, {tmdbId:"1192772", properties:{bornIn:"Polska", imdbId:"5531398", born:date('1992-01-01'), name:"Agata Trzebuchowska", bio:"From Wikipedia, the free encyclopedia\n\nAgata Trzebuchowska (Polish pronunciation: [aˈgata tʂɛbuˈxɔfska]; born 1992) is a Polish actress.  She is best known for playing the title role in the 2013 film Ida, which was her film debut.  For her role she was nominated for many festival and industry awards. \n\nIda director Paweł Pawlikowski was having trouble finding an actress to play his title character, so he put out word to the Warsaw film community to be on the lookout for talent...", url:"https://themoviedb.org/person/1192772"}}, {tmdbId:"1277198", properties:{bornIn:"Wagrowiec, Wielkopolskie, Poland", imdbId:"4221607", born:date('1986-01-01'), name:"Dawid Ogrodnik", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7wo7wVjq5S1enCMiTIGyG3tit0Q.jpg", url:"https://themoviedb.org/person/1277198"}}, {tmdbId:"2831", properties:{bornIn:"Leńcze, powiat wadowicki, małopolskie, Polska", imdbId:"0871827", born:date('1942-03-14'), name:"Jerzy Trela", url:"https://themoviedb.org/person/2831"}}, {tmdbId:"1514180", properties:{bornIn:"Pangboche, Nepal", imdbId:"7583273", born:date('1970-01-01'), name:"Ang Phula Sherpa", url:"https://themoviedb.org/person/1514180"}}, {tmdbId:"1212871", properties:{bornIn:"Melbourne - Victoria - Australia", imdbId:"0942876", born:date('1983-06-22'), name:"Thomas M. Wright", bio:"Thomas M.  Wright  is an actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nVBUjQvFHjzkz9Bz6BXAJ8c7XFD.jpg", url:"https://themoviedb.org/person/1212871"}}, {tmdbId:"19146", properties:{bornIn:"Newark, New Jersey, USA", imdbId:"0005575", born:date('1964-03-30'), name:"Ian Ziering", bio:"Ian Andrew Ziering is an American actor and voice actor best known for his role as Steve Sanders on the television series Beverly Hills, 90210, which he played from 1990 to 2000.  He is also the voice of Vinnie on Biker Mice from Mars...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/suoGgRhhbAzIBmWXQ7xow7Zuxjo.jpg", url:"https://themoviedb.org/person/19146"}}, {tmdbId:"78031", properties:{bornIn:"Long Island, New York, USA", imdbId:"2628561", born:date('1990-03-30'), name:"Cassie Scerbo", bio:"Cassandra Lynn \"Cassie\" Scerbo (born March 30, 1990) is an American actress, singer and dancer.  She is best known for her roles in Bring It On: In It to Win It and Make It or Break It.  She has Italian ancestry. \n\nDescription above from the Wikipedia article Cassie Scerbo, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uryWG1x98SPStw0SKnJjtsWl5Il.jpg", url:"https://themoviedb.org/person/78031"}}, {tmdbId:"1029292", properties:{bornIn:"Belgio", imdbId:"1595165", name:"Catherine Salée", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4BpOijEiMFxSIDkBS3GNppxW5Yp.jpg", url:"https://themoviedb.org/person/1029292"}}] AS row
