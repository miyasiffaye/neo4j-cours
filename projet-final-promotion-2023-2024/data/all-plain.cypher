UNWIND [{tmdbId:"307456", properties:{imdbId:"0196092", name:"Juliana Carneiro da Cunha", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jl4OC3nrL2TjMt7vFdqVd8qcM08.jpg", url:"https://themoviedb.org/person/307456"}}, {tmdbId:"931999", properties:{bornIn:"Curitiba, Paraná, Brazil", imdbId:"0819324", born:date('1979-10-29'), name:"Simone Spoladore", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jwOZdQKLxfevCjWD8mE5HNCUzJ2.jpg", url:"https://themoviedb.org/person/931999"}}, {tmdbId:"132078", properties:{bornIn:"Nashville - Tennessee - USA", imdbId:"0702809", born:date('1978-06-12'), name:"DJ Qualls", bio:"DJ Qualls grew up in the small city of Manchester in the Middle Tennessee, one of five children.  After studying at The University of London, he returned to Tennessee where he began acting in a local theatre.  During that time, he was discovered by photographers David La Chappelle and Steve Klein, which led to modeling work for Prada, as well as other advertising campaigns...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8Hw3oa9v0Kc0aXLBaAmEvVMH66f.jpg", url:"https://themoviedb.org/person/132078"}}, {tmdbId:"11664", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0221046", born:date('1980-01-17'), name:"Zooey Deschanel", bio:"Zooey Claire Deschanel (born January 17, 1980) is an American actress, model, and singer-songwriter.  She made her film debut in Mumford (1999) and next obtained a supporting role in Cameron Crowe's film Almost Famous (2000).  Deschanel is known for her deadpan roles in comedy films such as The Good Girl (2002), The New Guy (2002), Elf (2003), The Hitchhiker's Guide to the Galaxy (2005), Failure to Launch (2006), Yes Man (2008) and 500 Days of Summer (2009)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/30KQyjsXfrdm4Dcori7bDFTg9Le.jpg", url:"https://themoviedb.org/person/11664"}}, {tmdbId:"21804", properties:{imdbId:"0594302", born:date('1981-05-24'), name:"Jerod Mixon", url:"https://themoviedb.org/person/21804"}}, {tmdbId:"11671", properties:{bornIn:"Greenwich, Connecticut, U.S.", imdbId:"0005313", born:date('1980-04-01'), name:"Bijou Phillips", bio:"From Wikipedia, the free encyclopedia. \n\nBijou Lilly Phillips (born April 1, 1980) is an American actress, model, and singer.  Phillips began her career as a model but soon transitioned herself into acting and singing.  She made her musical debut with her album I'd Rather Eat Glass in 1999.  She has appeared in films such as Black and White (1999), Almost Famous (2000), Bully (2001), Octane (2003), The Door in the Floor (2004), Venom (2005), Hostel: Part II (2007), and Choke (2008)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wOFAgw3TRG0uA5ziEIB2qqxB8El.jpg", url:"https://themoviedb.org/person/11671"}}, {tmdbId:"54126", properties:{bornIn:"New York City, New York, USA", imdbId:"0001540", born:date('1980-07-29'), name:"Rachel Miner", bio:"Rachel Miner (born July 29, 1980) is a Broadway, film and television actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aauJNDwjC15IGU2cjYUGm85x3JR.jpg", url:"https://themoviedb.org/person/54126"}}, {tmdbId:"18976", properties:{bornIn:"Cedar Rapids, Iowa, USA", imdbId:"0005110", born:date('1978-02-07'), name:"Ashton Kutcher", bio:"Christopher Ashton Kutcher known as Ashton Kutcher, is an American actor, producer, former fashion model and comedian, best known for his portrayal of Michael Kelso in the Fox sitcom That '70s Show.  He also created, produced and hosted Punk'd, and played lead roles in the Hollywood films Dude, Where's My Car?, Just Married, The Butterfly Effect, The Guardian, and What Happens in Vegas...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l5qKSN9djUaMJnHYSc80xQiI7lT.jpg", url:"https://themoviedb.org/person/18976"}}, {tmdbId:"9278", properties:{bornIn:"Houston, Texas, USA", imdbId:"0004950", born:date('1972-04-17'), name:"Jennifer Garner", bio:"Jennifer Anne Garner (born April 17, 1972) is an American actress.  Garner gained recognition on television for her performance as CIA agent Sydney Bristow in the thriller drama series Alias, which aired on ABC for five seasons from 2001 to 2006.  While working on Alias, she gained minor roles in hit movies such as Pearl Harbor (2001) and Catch Me if You Can (2002)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2oojFB2K6FDDtC31kL7j44WrGkG.jpg", url:"https://themoviedb.org/person/9278"}}, {tmdbId:"21355", properties:{bornIn:"Mount Vernon, New York, U.S", imdbId:"0229422", born:date('1970-12-18'), name:"DMX", bio:"​From Wikipedia, the free encyclopedia\n\nEarl Simmons (born December 18, 1970), better known by his stage name DMX, is an American rapper and actor who rose to fame in the late 1990s.  His stage name pays tribute to the Oberheim DMX drum machine, an instrument he used when he made his own rap beats in the 80's.  To date, his best-selling album is his 1999 album . . . And Then There Was X, which featured the hit single \"Party Up (Up in Here)\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/irpNbiSoxwdMnryGE4jgxJjtNOs.jpg", url:"https://themoviedb.org/person/21355"}}, {tmdbId:"6365", properties:{bornIn:"Savannah, Georgia, USA", imdbId:"0004993", born:date('1976-10-19'), name:"Desmond Harrington", bio:"Desmond Harrington (born October 19, 1976) is an American actor.  He is known for movies such as The Hole, Wrong Turn and Ghost Ship.  He joined the cast of the Showtime series Dexter in its third season as Joey Quinn. \n\nDescription above from the Wikipedia article Desmond Harrington , licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hylBgwz1akNoX03glhMnqNxLCqm.jpg", url:"https://themoviedb.org/person/6365"}}, {tmdbId:"6367", properties:{bornIn:"Stratford-Upon-Avon, Warwickshire, England, UK", imdbId:"0110689", born:date('1979-12-21'), name:"Daniel Brocklebank", url:"https://themoviedb.org/person/6367"}}, {tmdbId:"6366", properties:{bornIn:"Yorkshire, England, UK", imdbId:"0289114", born:date('1978-05-26'), name:"Laurence Fox", bio:"​From Wikipedia, the free encyclopedia\n\nLaurence Fox (born 1978) is an English actor best known for his leading role as Detective Sergeant James Hathaway in the British TV drama series Lewis (2006–).  He is the scion of a show business family: his father is the actor James Fox, and Edward Fox, Robert Fox and Daniel Chatto are all uncles.  Fox's rebellious nature led to difficult times at Harrow School and the Royal Academy of Dramatic Art (RADA)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4x273XNUg23P8OkGx6O3f6PuTjw.jpg", url:"https://themoviedb.org/person/6366"}}, {tmdbId:"17142", properties:{bornIn:"New York City, New York, USA", imdbId:"0200452", born:date('1984-06-19'), name:"Paul Dano", bio:"Paul Franklin Dano (born June 19, 1984) is an American actor, writer, director, and producer.  He is known for films such as There Will Be Blood (2007), Little Miss Sunshine (2006), Prisoners (2013), Twelve Years a Slave (2013), Swiss Army Man (2016) and Okja (2017).  In 2018, he made his directing debut with Wildlife, which he co-wrote with his partner, Zoe Kazan...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gOD5bO0hKnzzJm7sJeGeEJjfBBw.jpg", url:"https://themoviedb.org/person/17142"}}, {tmdbId:"27545", properties:{bornIn:"The Bronx - New York - USA", imdbId:"0022883", born:date('1955-07-03'), name:"Bruce Altman", bio:"Married and has one daughterStudied in NYC with William Hickey and at the William Esper studio. A 1990 graduate of the Yale School of Drama...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n5y8Mg572LGT3eHyeZaa9NMMlAN.jpg", url:"https://themoviedb.org/person/27545"}}, {tmdbId:"177219", properties:{bornIn:"Long Island - New York - USA", imdbId:"0443004", born:date('1984-04-10'), name:"Billy Kay", url:"https://themoviedb.org/person/177219"}}, {tmdbId:"176594", properties:{imdbId:"0182184", name:"James Costa", url:"https://themoviedb.org/person/176594"}}, {tmdbId:"9443", properties:{bornIn:"Lauban, Lower Silesia, Prussia, Germany", imdbId:"0048127", born:date('1944-09-26'), name:"Helmut Bakaitis", bio:"Helmut Bakaitis (born 26 September 1944) is a German Australian director, actor and screenwriter...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p7YMk9Gk2BZsvo2EUp7x903gdLZ.jpg", url:"https://themoviedb.org/person/9443"}}, {tmdbId:"57278", properties:{bornIn:"Perth, Western Australia", imdbId:"0063571", born:date('1974-10-12'), name:"Kate Beahan", bio:"Kate Beahan (born October 12, 1974) is an Australian film actress.  Beahan was born in Perth.  Until 2005, with her major role in Flightplan, she appeared mostly in movies and TV series in Australia (notable as the title character's prostitute girlfriend in Chopper).  Her father, Michael Beahan, was an Australian Labor Party Senator from Western Australia from 1987 to 1996. \n\nDescription above from the Wikipedia article Kate Beahan, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mUp1n98wsdh2Is5g6kahkreL7If.jpg", url:"https://themoviedb.org/person/57278"}}, {tmdbId:"25934", properties:{bornIn:"Buffalo, New York, USA", imdbId:"0004770", born:date('1969-05-16'), name:"David Boreanaz", bio:"David Boreanaz (born May 16, 1969, height 6' 1\" (1,85 m)) is an American actor, television producer, and director, known for his role as Angel on the supernatural drama series Buffy the Vampire Slayer and Angel, and as Special Agent Seeley Booth on the television crime drama Bones...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oO619MACIfz7YoPiIGXYOfamhOE.jpg", url:"https://themoviedb.org/person/25934"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"2205", properties:{bornIn:"Columbia, Missouri, USA", imdbId:"0004800", born:date('1976-08-09'), name:"Jessica Capshaw", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ePpM2GPe5OXjtyesq06J3S1WCB.jpg", url:"https://themoviedb.org/person/2205"}}, {tmdbId:"2636535", properties:{name:"Trevor Jack Brooks", url:"https://themoviedb.org/person/2636535"}}, {tmdbId:"1327009", properties:{bornIn:"San Miguel de Allende - Guanajuato - Mexico", imdbId:"1085951", born:date('1994-05-29'), name:"Lorelei Linklater", bio:"Lorelei Grace Linklater (born May 29, 1994) is an American actress.  She is the daughter of Christina Harrison and director Richard Linklater.  She appears in her father's 2001 film Waking Life; and in his 2014 film Boyhood, playing the older sister to Ellar Coltrane's Mason...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tW89lIMvdP3EwtyoaOlFcn7y3YA.jpg", url:"https://themoviedb.org/person/1327009"}}, {tmdbId:"56934", properties:{bornIn:"Austin, Texas, USA", imdbId:"0927812", born:date('1976-11-06'), name:"Wiley Wiggins", bio:"From Wikipedia, the free encyclopedia\n\nWiley Ramsey Wiggins (November 6, 1976) is an American film actor and blogger.  A native of Austin, Texas, he is the nephew of Lanny Wiggins, who was a member of Janis Joplin's early band, The Waller Creek Boys. \n\nWiggins starred in Richard Linklater's films Dazed and Confused (at the age of 16) and Waking Life (at the age of 25)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rovsT9XjhdA3rS9phQcTKUzqbTf.jpg", url:"https://themoviedb.org/person/56934"}}, {tmdbId:"56936", properties:{imdbId:"0318666", name:"Glover Gill", url:"https://themoviedb.org/person/56936"}}, {tmdbId:"136437", properties:{imdbId:"0269002", name:"Faudel", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nMYwqy7fAQk0aC9X4aikNqz7ObN.jpg", url:"https://themoviedb.org/person/136437"}}, {tmdbId:"136438", properties:{imdbId:"0767710", name:"Eric Savin", url:"https://themoviedb.org/person/136438"}}, {tmdbId:"23672", properties:{imdbId:"0078605", name:"Nathalie Besançon", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4jyzGshnexywI0UNKDvvUSQxyS7.jpg", url:"https://themoviedb.org/person/23672"}}, {tmdbId:"9140", properties:{bornIn:"Hampstead, London, England, UK", imdbId:"0269077", born:date('1948-07-18'), name:"James Faulkner", bio:"From Wikipedia, the free encyclopedia. \n\nJames Sebastian Faulkner (born 18 July 1948) is a British actor, known for his many various appearance on television and in movies, usually in supporting roles. \n\nFaulkner made his big screen debut as Josef Strauss in The Great Waltz in 1972.  He appeared in other films such as Whispering Death, Minder on the Orient Express, played Lt Teignmouth Melvill in Zulu Dawn that he co-produced, and appeared as Uncle Geoffrey in both Bridget Jones films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wMDpbctF9cAL5nYnSL6AcXUTG5K.jpg", url:"https://themoviedb.org/person/9140"}}, {tmdbId:"56895", properties:{bornIn:"Cape Cod, Massachusetts, USA", imdbId:"0005057", born:date('1970-10-06'), name:"Amy Jo Johnson", bio:"Amy Jo Johnson (born October 6, 1970) is an American actress, singer, songwriter and musician.  She is best known for her roles as Kimberly Ann Hart, the first Pink Ranger of the Power Rangers franchise in Mighty Morphin Power Rangers and as Julie Emrick on The WB's college drama Felicity. \n\nShe also played Stacy Reynolds on the Lifetime police drama The Division, and in 2005 she joined the cast of the TV drama Wildfire as famous jockey Tina Sharp...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7GO1Uaf8LRoRl1n7xC4bB3DDFfG.jpg", url:"https://themoviedb.org/person/56895"}}, {tmdbId:"19047", properties:{bornIn:"Enniskillen, County Fermanagh, Northern Ireland, UK", imdbId:"0573223", born:date('1975-10-01'), name:"Ciarán McMenamin", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uZpVsgakGSpm9Lg3ICgSRXHPcqR.jpg", url:"https://themoviedb.org/person/19047"}}, {tmdbId:"2983", properties:{bornIn:"London, England, UK", imdbId:"0835016", born:date('1963-08-05'), name:"Mark Strong", bio:"A British actor, who played Jim Prideaux in the 2011 remake of Tinker Tailor Soldier Spy (2011), is often cast as cold, calculating villains.  But before he became a famous actor, he intended to pursue a career in law.  Strong was born Marco Giuseppe Salussolia on 30 August, 1963 in London, England, to an Austrian mother and an Italian father.  His father left the family not long after he was born, and his mother worked as an au pair to raise the boy on her own...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pw6AvwaBbr44Nje9JQMBBwhchiu.jpg", url:"https://themoviedb.org/person/2983"}}, {tmdbId:"187565", properties:{bornIn:"Berlin, Germany", imdbId:"0567653", born:date('1970-07-03'), name:"Audra McDonald", bio:"Audra Ann McDonald is an American actress and singer.  She has appeared on the stage in both musicals and dramas, such as Ragtime (musical) and A Raisin in the Sun.  She has also appeared in television, such as playing Dr.  Naomi Bennett on Private Practice.  She maintains an active concert and recording career, performing song cycles and operas as well as performing in concert throughout the US.  She has won the Tony Award four times and Grammy Award twice...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3YpPMKnhljAJwgcaFfHGNkL0rcv.jpg", url:"https://themoviedb.org/person/187565"}}, {tmdbId:"1185", properties:{imdbId:"0836742", name:"Anette Støvelbæk", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5P8G1D4WAZnz2Rd3JKTL1LjqNjG.jpg", url:"https://themoviedb.org/person/1185"}}, {tmdbId:"1183", properties:{bornIn:"Hjørring, Denmark", imdbId:"0433692", born:date('1965-10-16'), name:"Ann Eleonora Jørgensen", bio:"Ann Eleonora Jørgensen (born 16 October 1965 in Hjørring, Denmark) is a Danish film, television and stage actor. \n\nShe is best known for her television work in TAXA (1997 - 1999) and Forbrydelsen (The Killing) (2007), and for her film roles in Italian for Beginners (2000), for which she won a Robert Award for Best Supporting Actress, and In Your Hands (2004), for which she won the audience award at the Bordeaux International Festival of Women in Cinema...", url:"https://themoviedb.org/person/1183"}}, {tmdbId:"1181", properties:{bornIn:"Denmark", imdbId:"0304644", born:date('1958-09-28'), name:"Peter Gantzler", bio:"Peter Gantzler is a Danish actor.  He is married to actress Xenia Lach-Nielsen...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1oL9VT7YLfaly3BwAcKj5xquoCo.jpg", url:"https://themoviedb.org/person/1181"}}, {tmdbId:"104522", properties:{bornIn:"Tokyo, Japan", imdbId:"0594497", born:date('1985-11-30'), name:"Aoi Miyazaki", bio:"From Wikipedia, the free encyclopedia. \n\nAoi Miyazaki (born November 30, 1985) is a Japanese actress.  She is best known for her pure image and roles such as in Nana and Virgin Snow.  Her brother Masaru Miyazaki is an actor, and they starred together in the film Hatsukoi.  She married Sosuke Takaoka on June 15, 2007, her partner since she was fifteen.  They divorced 12/2011\n\nDescription above from the Wikipedia article Aoi Miyazaki, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8J2i8Da2FmqMsDqSlndEpzkPQYd.jpg", url:"https://themoviedb.org/person/104522"}}, {tmdbId:"111637", properties:{imdbId:"0594515", name:"Masaru Miyazaki", url:"https://themoviedb.org/person/111637"}}, {tmdbId:"20708", properties:{imdbId:"0756874", name:"Yôichirô Saitô", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8HeLk41pIFHkaeKiZmfJy2pQCPP.jpg", url:"https://themoviedb.org/person/20708"}}, {tmdbId:"143036", properties:{bornIn:"Juifang, Taipei County, Taiwan", imdbId:"0943150", born:date('1952-08-05'), name:"Nien-Jen Wu", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zqEl0ybSYwq7yQlG5SSoQQDyuCC.jpg", url:"https://themoviedb.org/person/143036"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"103598", properties:{bornIn:"Taiwan", imdbId:"0157805", born:date('1954-12-15'), name:"Elaine Jin", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8IgNPFH3uLfD0B4mbbwvy21dc6H.jpg", url:"https://themoviedb.org/person/103598"}}, {tmdbId:"143037", properties:{bornIn:"Fukuoka, Japan", imdbId:"0644521", born:date('1952-02-22'), name:"Issei Ogata", bio:"From Wikipedia, the free encyclopedia. \n\nIssey Ogata (born 22 February 1952 in Fukuoka, Fukuoka), is a Japanese actor and comedian.  He was interested in plays since childhood.  After he graduated from Toyotama High School in Japan, he joined a theatrical company and appeared on the stage.  Later, he jumped at the opportunity to be an entertainer when he took the gold medal at the audition called \"Birth of Comedians\".  Then, he started garnering roles on Japanese TV...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5ulpQaxDpqPP3toKZINSIkDVfC5.jpg", url:"https://themoviedb.org/person/143037"}}, {tmdbId:"143038", properties:{imdbId:"0497662", name:"Kelly Lee", url:"https://themoviedb.org/person/143038"}}, {tmdbId:"136796", properties:{bornIn:"Praha, Československo", imdbId:"0405402", born:date('1982-03-10'), name:"Krystof Hádek", bio:"Nejmladší ze tří synů dokumentaristky Jany Hádkové (starší bratr Matěj je také herec) se objevil před kamerou v menších rolích už jako dítě.  Proslavil se jednou ze dvou hlavních rolí - pilota Vojtíška - ve snímku režiséra Jana Svěráka Tmavomodrý svět.  Studoval státní konzervatoř, kterou nedokončil, rok a půl studoval herectví v Anglii na dramatické škole LAMDA...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/35mTGXSU81R2Z7vXq6OpmmwIwzk.jpg", url:"https://themoviedb.org/person/136796"}}, {tmdbId:"69287", properties:{imdbId:"0368971", born:date('1982-03-24'), name:"Eriko Hatsune", url:"https://themoviedb.org/person/69287"}}, {tmdbId:"69288", properties:{imdbId:"0266635", name:"Fhi Fan", url:"https://themoviedb.org/person/69288"}}, {tmdbId:"58664", properties:{bornIn:"Nara, Japan", imdbId:"0755725", born:date('1977-02-16'), name:"Hinako Saeki", bio:"From Wikipedia, the free encyclopedia. \n\nHinako Saeki (born 16 February 1977) is a Japanese actress.  She was born in Nara, Japan.  Her most famous role was probably Sadako Yamamura in Rasen, a sequel to the horror film Ring. \n\nShe also appears in a handful of other popular Japanese horror films, such as Uzumaki (2000) which was based on a Junji Ito manga of the same name and Eko Eko Azaraku: Misa the Dark Angel (1998), and she more featured in Mamoru Oshii's Assault Girls (2009)...", url:"https://themoviedb.org/person/58664"}}, {tmdbId:"55714", properties:{imdbId:"0348697", name:"Scott Gurney", url:"https://themoviedb.org/person/55714"}}, {tmdbId:"82338", properties:{imdbId:"0192181", name:"Michael Cunio", url:"https://themoviedb.org/person/82338"}}, {tmdbId:"82339", properties:{imdbId:"0206571", name:"Roxanne Day", url:"https://themoviedb.org/person/82339"}}, {tmdbId:"37043", properties:{bornIn:"Glendale, California, USA", imdbId:"0624510", born:date('1957-08-01'), name:"Taylor Negron", died:date('2015-01-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e0ciwWhyy7fav8seddR88cFrxTy.jpg", url:"https://themoviedb.org/person/37043"}}, {tmdbId:"72440", properties:{bornIn:"New Westminster, British Columbia, Canada", imdbId:"0270451", born:date('1977-10-29'), name:"Brendan Fehr", bio:"​Brendan Fehr is a Canadian film and television actor and model, best known for playing regular characters Michael Guerin on the television series \"Roswell\", Dan Cooper on \"CSI: Miami\", and Dr.  Drew Alister on the medical drama \"The Night Shift\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/401AgLwGGfGRmzUT5WxjKb9jUv4.jpg", url:"https://themoviedb.org/person/72440"}}, {tmdbId:"59592", properties:{bornIn:"Lódz, Lódzkie, Poland", imdbId:"0005232", born:date('1981-01-21'), name:"Izabella Miko", bio:"​Born to a pair of Polish actors, Grazyna Dylag and Aleksander Mikolajczak, Izabella Anna Mikolajczak made her first appearance in Lodz, Poland on January 21, 1981 at 3:15 a. m.  When she was ten years old she auditioned for the National Ballet School in Warsaw.  At the age of 14 Izabella left Warsaw for Biennale to study ballet in a summer workshop, where an American choreographer discovered her, and invited her to NYC to study ballet on a scholarship...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uh3KbEyFrsYcwifxqtBWDk2wB00.jpg", url:"https://themoviedb.org/person/59592"}}, {tmdbId:"34514", properties:{bornIn:"Hämeenlinna, Finland", imdbId:"0014261", born:date('1970-12-01'), name:"Jouko Ahola", bio:"Jouko Ahola (born 1 December 1970 in Hämeenlinna) is a Finnish strongman and actor.  He won the 1997 and 1999 World's Strongest Man, and finished second in 1998.  Ahola won the Europe's Strongest Man contest twice in 1998 and 1999, and finished fourth in 1996. [1] Jouko won the World's Strongest Team in 1997 and 1999, and was second in 1998.  Jouko was a very successful strongman competitor, at 6' 1\" (1. 85 m) and 270 lbs (122. 5 kg), corresponding to a BMI of 35. 8, which is low by WSM standards...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fUvT6AAxzyGPkkeMekav8zd3eFu.jpg", url:"https://themoviedb.org/person/34514"}}, {tmdbId:"282349", properties:{imdbId:"1139465", name:"Anna Gourari", url:"https://themoviedb.org/person/282349"}}, {tmdbId:"47237", properties:{bornIn:"Lünen, Germany", imdbId:"0704637", born:date('1962-12-12'), name:"Max Raabe", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bsNgD5c8ozCBYyfS6OS6P89Uw2D.jpg", url:"https://themoviedb.org/person/47237"}}, {tmdbId:"1177525", properties:{bornIn:"Williston, North Dakota, USA", born:date('1945-09-17'), name:"Phil Jackson", bio:"Philip Douglas Jackson (born September 17, 1945) is an American former professional basketball player, coach, and executive in the National Basketball Association (NBA).  A power forward, Jackson played 12 seasons in the NBA, winning NBA championships with the New York Knicks in 1970 and 1973. [1] Jackson was the head coach of the Chicago Bulls from 1989 to 1998, leading them to six NBA championships...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tpeWFZsOhKLYEOtswSwQHdbtJ6x.jpg", url:"https://themoviedb.org/person/1177525"}}, {tmdbId:"1286312", properties:{name:"Doug Collins", url:"https://themoviedb.org/person/1286312"}}, {tmdbId:"19587", properties:{bornIn:"Tokyo, Japan", imdbId:"0383708", born:date('1987-08-01'), name:"Rumi Hiiragi", bio:"From Wikipedia, the free encyclopedia  \n\n  Rumi Hiiragi (born August 1, 1987 in Tokyo) is a Japanese actress.   \n\n  Description above from the Wikipedia article Rumi Hiiragi, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zITaVtFyc4xSM3mxSoPRWHbqgJI.jpg", url:"https://themoviedb.org/person/19587"}}, {tmdbId:"19588", properties:{bornIn:"Tokyo, Japan", imdbId:"0997115", born:date('1988-02-19'), name:"Miyu Irino", bio:"is a Japanese actor and voice actor from Tokyo.  He voices the lead character Sora in the Kingdom Hearts video game series.  His major anime voice roles include Todomatsu Matsuno in Osomatsu-san, Haku in Spirited Away, Daisuke Niwa in D. N. Angel, Syaoran Li in Tsubasa Reservoir Chronicle, Sena Kobayakawa in Eyeshield 21, Astral in Yu-Gi-Oh! Zexal, Jintan in Anohana: The Flower We Saw That Day, Yuichiro Hyakuya in Seraph of the End, and Ishida Shouya in A Silent Voice...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dcZ4IJX8CBcJzxy8hhKFXv59LDE.jpg", url:"https://themoviedb.org/person/19588"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"19589", properties:{bornIn:"Tokyo, Japan", imdbId:"0622412", born:date('1952-05-02'), name:"Mari Natsuki", bio:"Junko Nakajima (中島 淳子 Nakajima Junko, born 2 May 1952), more commonly known by her stage name Mari Natsuki (夏木 マリ Natsuki Mari), is a Japanese singer, dancer and actress.  Born in Tokyo, she started work as a singer from a young age.  In 2007 she announced her engagement to percussionist Nobu Saitō, with their marriage taking place in Spring 2008...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aejaB87OVwPdoKgVXQPZRm9kRLR.jpg", url:"https://themoviedb.org/person/19589"}}, {tmdbId:"1544181", properties:{imdbId:"0022393", name:"Aria Alpert Adjani", bio:"Aria Alpert Adjani is an actress, known for Super Troopers (2001), Mercy (2009) and Freud's Magic Powder (2009)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8w8Om5Xz8Z99MMLORHCoZrMZlFg.jpg", url:"https://themoviedb.org/person/1544181"}}, {tmdbId:"1103690", properties:{imdbId:"0026047", name:"Ruben Anders", url:"https://themoviedb.org/person/1103690"}}, {tmdbId:"1603", properties:{bornIn:"Madrid, Spain", imdbId:"0319843", born:date('1961-05-15'), name:"Daniel Giménez Cacho", bio:"From Wikipedia, the free encyclopedia. \n\nDaniel Giménez Cacho (born May 15, 1961 in Madrid, Spain) is a Spanish-born Ariel award winner Mexican actor who has starred in several Mexican films such as Solo con tu pareja, Cronos, Midaq Alley and Arráncame la Vida, among others as well as in Spanish Films (La Mala Educación) and TV shows.  He is known for having worked with some of the most important hispanic filmmakers like Guillermo Del Toro, Alfonso Cuarón, Jorge Fons and Pedro Almodóvar...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/igRy8sO4Jahhl2KbPT548oBacuG.jpg", url:"https://themoviedb.org/person/1603"}}, {tmdbId:"17088", properties:{bornIn:"Mexico City, Distrito Federal, Mexico", imdbId:"1004635", born:date('1981-07-03'), name:"Ana López Mercado", url:"https://themoviedb.org/person/17088"}}, {tmdbId:"8688", properties:{bornIn:"Toluca, Estado de Mexico, Mexico", imdbId:"0526019", born:date('1979-12-29'), name:"Diego Luna", bio:"Diego Luna (born December 29, 1979) is a Mexican actor known for his childhood telenovela work, a starring role in the film Y tu mamá también, and supporting roles in American films.  He is also known for his roles in Rudo y Cursi and Milk.  Luna also had minor roles in Frida and Before Night Falls.  He also provides Spanish language narration for the National Geographic Channel documentary Great Migrations...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uH8sMbiMmy9sprKr1vJpoPBB40E.jpg", url:"https://themoviedb.org/person/8688"}}, {tmdbId:"258", properties:{bornIn:"Guadalajara, Jalisco, Mexico", imdbId:"0305558", born:date('1978-11-30'), name:"Gael García Bernal", bio:"​García Bernal was born in Guadalajara, Mexico, the son of Patricia Bernal, an actress and former model, and José Angel García, an actor and director.  His stepfather is Sergio Yazbek, whom his mother married when García Bernal was young.  He started acting at just a year old and spent most of his teen years starring in telenovelas.  Gael studied the International Baccalaureate, with chemistry being unquestionably his favorite subject...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6rTzWV80Z8AZbF6o3io1sYVOGhI.jpg", url:"https://themoviedb.org/person/258"}}, {tmdbId:"21596", properties:{bornIn:"Houston, Texas, USA", imdbId:"0002436", born:date('1973-09-07'), name:"Shannon Elizabeth", bio:"An American actress and former fashion model.  Elizabeth is well known for her roles in comedy films such as Scary Movie, American Pie, and Jay And Silent Bob Strike Back.  She as well is also known for her work in horror films such as Thirteen Ghosts, Cursed, and Night of the Demons.  She became widely known as a sex symbol for her role in the 1999 comedy film American Pie...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/52HNFkJEJTpt1scah5dvm3QzIDs.jpg", url:"https://themoviedb.org/person/21596"}}, {tmdbId:"35476", properties:{bornIn:"Gainesville - Florida - USA", imdbId:"0199590", born:date('1976-03-17'), name:"Brittany Daniel", bio:"From Wikipedia, the free encyclopedia. \n\nBrittany Ann Daniel (born March 17, 1976, height 5' 7\" (1,70 m)) is an American television and film actress.  She is the twin sister of actress and photographer Cynthia Daniel.  She is best known for her portrayal of Kelly Pitts on the CW/BET comedy-drama series The Game, and Candice in the 2010 science fiction film Skyline, and for her role as Jessica Wakefield on the 1990's teen show Sweet Valley High...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ggejsCiO94S2ZxljXN7LEypnaTQ.jpg", url:"https://themoviedb.org/person/35476"}}, {tmdbId:"263", properties:{bornIn:"Mexico", imdbId:"0248408", name:"Emilio Echevarría", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/akCnmsqWGgxIGslTFlcEe78uxdr.jpg", url:"https://themoviedb.org/person/263"}}, {tmdbId:"261", properties:{bornIn:"Arrecife, Lanzarote", imdbId:"0865949", born:date('1969-09-24'), name:"Goya Toledo", bio:"Goya Toledo is a Spanish film and television actress and model. Born at Arrecife on the island of Lanzarote, one of the Canary Islands, on the 24 September 1969, Toledo started out as a model before venturing into acting.  Her most well-known role to date has been playing the model Valeria in the 2000 film Amores Perros.  She also had a starring role in the 2003 Spanish thriller Killing Words...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ygZpmXYB1fDSnpeJx1PadEQLgA5.jpg", url:"https://themoviedb.org/person/261"}}, {tmdbId:"262", properties:{bornIn:"Mexico City, Mexico", imdbId:"0346270", born:date('1949-03-26'), name:"Álvaro Guerrero", bio:"Álvaro Guerrero is a Mexican actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fA6I8WQTZXlU9WHwDVGsgNLjbKC.jpg", url:"https://themoviedb.org/person/262"}}, {tmdbId:"5915", properties:{bornIn:"Omaha, Nebraska, USA", imdbId:"0454809", born:date('1979-04-23'), name:"Jaime King", bio:"An American actress and model.  In her modeling career and early film roles, she used the names Jamie King and James King, which was a childhood nickname given to King by her parents, because her agency already represented another Jaime — the older, then more famous model Jaime Rishar. \n\nCalled by Complex magazine \"one of the original model-turned-actresses\", King appeared in Vogue, Mademoiselle, and Harper's Bazaar, among other fashion magazines.  Afterwards, she began taking small film roles...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eiCjBHskyBFM2eomwQM3Oq3UsND.jpg", url:"https://themoviedb.org/person/5915"}}, {tmdbId:"10841", properties:{bornIn:"České Budějovice, Czechoslovakia", imdbId:"0734558", born:date('1962-05-18'), name:"Karel Roden", bio:"​From Wikipedia, the free encyclopedia\n\nKarel Roden (born May 18, 1962) is a Czech actor, known for his roles in Hellboy and The Bourne Supremacy. \n\nDescription above from the Wikipedia article Karel Roden, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zfxaI9n2kjlDyJUpSFvawQGV1Hg.jpg", url:"https://themoviedb.org/person/10841"}}, {tmdbId:"13391", properties:{bornIn:"Pittsburg, California, USA", imdbId:"0002364", born:date('1975-08-29'), name:"Dante Basco", bio:"Dante R.  Basco (born August 29, 1975) is an American actor and voice actor.  He is best known for his role as Rufio, the leader of the Lost Boys in Steven Spielberg's Hook and for his many voice acting roles, most notably Prince Zuko from Nickelodeon's Avatar: The Last Airbender and Jake Long from the Disney Channel's American Dragon: Jake Long...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2bfQho7MEo4wAQTmC687FkXUoKU.jpg", url:"https://themoviedb.org/person/13391"}}, {tmdbId:"149773", properties:{imdbId:"0004783", born:date('1974-09-20'), name:"Ryan Browning", url:"https://themoviedb.org/person/149773"}}, {tmdbId:"60460", properties:{bornIn:"Dublin, Ireland", imdbId:"0118568", born:date('1978-02-09'), name:"A.J. Buckley", bio:"A. J.  Buckley (born February 9, 1978) is an Irish-born, Canadian-raised television and film actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7mdIM5QdxnccD4YWC03FrI78EPc.jpg", url:"https://themoviedb.org/person/60460"}}, {tmdbId:"100372", properties:{imdbId:"0357818", name:"Derek Hamilton", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/utxxJVzPdQj41BGoumkr0wJTaNX.jpg", url:"https://themoviedb.org/person/100372"}}, {tmdbId:"325", properties:{bornIn:"St. Joseph, Missouri, USA", imdbId:"0004896", born:date('1972-10-17'), name:"Eminem", bio:"Marshall Bruce Mathers III, better known by his stage name Eminem and by his alter ego Slim Shady, is an American rapper, record producer, songwriter and actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cH1fz3xzw0Op5uWDDyFWKNUnpTc.jpg", url:"https://themoviedb.org/person/325"}}, {tmdbId:"34715", properties:{bornIn:"Ballymena, County Antrim, Northern Ireland", imdbId:"0626362", born:date('1965-01-15'), name:"James Nesbitt", bio:"From Wikipedia, the free encyclopedia. \n\nJames Nesbitt (born 15 January 1965) is a Northern Irish actor.  Born in Ballymena, County Antrim, Northern Ireland, Nesbitt grew up in the nearby village of Broughshane, before moving to Coleraine, County Londonderry.  He wanted to become a teacher, like his father, so began a degree in French at the University of Ulster.  He dropped out after a year when he decided to become an actor, and transferred to the Central School of Speech and Drama in London...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gdbR1DhI7dOi027mQgnWwYgYGxj.jpg", url:"https://themoviedb.org/person/34715"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"10882", properties:{bornIn:"Hammersmith, London, England, UK", imdbId:"0683253", born:date('1979-01-27'), name:"Rosamund Pike", bio:"Rosamund Mary Ellen Pike (born 27 January 1979) is an English actress who began her acting career by appearing in stage productions such as Romeo and Juliet and Skylight...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8ObNklHDi2hjdz0ayzJFB9jtqzm.jpg", url:"https://themoviedb.org/person/10882"}}, {tmdbId:"1579", properties:{bornIn:"Lower East Side, New York City, New York, USA", imdbId:"0350454", born:date('1977-11-16'), name:"Maggie Gyllenhaal", bio:"Margalit Ruth \"Maggie\" Gyllenhaal (born November 16, 1977) is a American actress and producer.  Part of the Gyllenhaal family, she is the daughter of filmmakers Stephen Gyllenhaal and Naomi Achs, and the older sister of actor Jake Gyllenhaal. \n\nShe began her career as a teenager with small roles in several of her father's films, and appeared with her brother in the cult favorite Donnie Darko (2001)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z4vCCNHoXbOTt2w1hZPMu9FwkyJ.jpg", url:"https://themoviedb.org/person/1579"}}, {tmdbId:"1580", properties:{bornIn:"Las Vegas, Nevada, USA", imdbId:"0153738", born:date('1990-07-24'), name:"Daveigh Chase", bio:"From Wikipedia, the free encyclopedia\n\nDaveigh Elizabeth Chase (born Daveigh Elizabeth Schwallier; July 24, 1990) is an Annie Award-winning American actress, singer, and voice over artist best known for playing Chihiro Ogino in the English adaptation of Spirited Away, Rhonda Volmer in the HBO series Big Love, Samara Morgan in The Ring and Lilo Pelekai in Lilo &amp; Stitch...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tZSGbN3mC1LWRgiGG1umb88YqxQ.jpg", url:"https://themoviedb.org/person/1580"}}, {tmdbId:"21657", properties:{bornIn:"Clifton, Passaic County, New Jersey, USA", imdbId:"0267812", born:date('1973-08-06'), name:"Vera Farmiga", bio:"Vera Ann Farmiga (born August 6, 1973) is an American actress and director.  Farmiga made her film debut in the 1998 drama thriller Return to Paradise.  This was followed by supporting roles in the 2000 romantic film Autumn in New York and the 2001 television series UC: Undercover.  She was also cast in the 2001 thriller 15 Minutes...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5Vs7huBmTKftwlsc2BPAntyaQYj.jpg", url:"https://themoviedb.org/person/21657"}}, {tmdbId:"41527", properties:{bornIn:"Asmara", imdbId:"0320969", born:date('1948-12-01'), name:"Remo Girone", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gRS90yn20ZMlq4pvVQjtUM5DLqN.jpg", url:"https://themoviedb.org/person/41527"}}, {tmdbId:"15917", properties:{bornIn:"Turin, Piedmont, Italy", imdbId:"0733625", born:date('1971-04-24'), name:"Stefania Rocca", bio:"Stefania Rocca was born on April 24, 1971 in Turin...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dRHhHfeu9OKIEwU84nTeGLZC06h.jpg", url:"https://themoviedb.org/person/15917"}}, {tmdbId:"25078", properties:{bornIn:"Angers, Maine-et-Loire, France", imdbId:"0248254", born:date('1967-10-03'), name:"Eriq Ebouaney", bio:"From Wikipedia, the free encyclopedia. \n\nEriq Ebouaney is a French film actor.  He is best known for his portrayal as the Congolese President Patrice Lumumba in the 2000 film Lumumba, as \"Blacktie\" in Brian De Palma's Femme Fatale and as \"Ice\" in the 2008 action film Transporter 3 in which he starred opposite Jason Statham. \n\nDescription above from the Wikipedia article Eriq Ebouaney, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5VJMH0rJE5b001FIaRD2Vr9ti80.jpg", url:"https://themoviedb.org/person/25078"}}, {tmdbId:"1200631", properties:{imdbId:"0816380", name:"Théophile Sowié", bio:"Moussa Théophile Sowie a suivi une formation notamment à l'Institut des études théâtrales Paris III Sorbonne Nouvelle et à l'Ecole d'art dramatique Jacques Lecoq à Paris.  Il a joué au théâtre dans Chute et Jeanne au bûcher mise en scène Claude Régy Le chariot de terre cuite mise en scène Patrick Le Mauff, Tabataba et Combat de nègre et de chiens mise en scène M...", url:"https://themoviedb.org/person/1200631"}}, {tmdbId:"122489", properties:{imdbId:"0467846", born:date('1961-12-07'), name:"Maka Kotto", url:"https://themoviedb.org/person/122489"}}, {tmdbId:"678", properties:{bornIn:"Munich, Germany", imdbId:"0311476", born:date('1961-09-14'), name:"Martina Gedeck", bio:"Martina Gedeck  (born 14 September 1961) is a German actress. \n\nShe came to international fame as the main character in the German films Mostly Martha and The Lives of Others...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/emy9tlDtmABYqtf6p5zomI4hLP7.jpg", url:"https://themoviedb.org/person/678"}}, {tmdbId:"33509", properties:{imdbId:"0283815", name:"Maxime Foerste", url:"https://themoviedb.org/person/33509"}}, {tmdbId:"11008", properties:{bornIn:"Berkeley, California, USA", imdbId:"0005381", born:date('1972-11-06'), name:"Rebecca Romijn", bio:"Rebecca Alie Romijn is an American actress.  Her father was Dutch-born and worked as a custom-furniture maker.  Her mother was American-born, with Dutch and English ancestry, and was a teacher of English.  Rebecca attended Berkeley High School where her nickname was the \"Jolly Blond Giant\", then she attended the University of California at Santa Cruz where she majored in Music, but left in 1995...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/t0Wpu3fZlfJANjwXyeU9wzLkWgN.jpg", url:"https://themoviedb.org/person/11008"}}, {tmdbId:"52117", properties:{bornIn:"Santiago, Chile", imdbId:"0764445", born:date('1969-06-04'), name:"Horatio Sanz", bio:"​From Wikipedia, the free encyclopedia\n\nHoratio Sanz (born June 4, 1969) is a Chilean-born American actor and comedian best known as a cast member on Saturday Night Live from 1998-2006.  Sanz most recently starred alongside his former SNL castmate Chris Parnell in the Comedy Central series Big Lake. \n\nDescription above from the Wikipedia article Horatio Sanz, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kRoPbW1wPePFnA2THXxNhj4wsvA.jpg", url:"https://themoviedb.org/person/52117"}}, {tmdbId:"20725", properties:{imdbId:"0307638", name:"Olatz López Garmendia", url:"https://themoviedb.org/person/20725"}}, {tmdbId:"1186604", properties:{imdbId:"0283029", name:"Giovanni Florido", url:"https://themoviedb.org/person/1186604"}}, {tmdbId:"982256", properties:{imdbId:"0622944", name:"Loló Navarro", died:date('2011-04-28'), url:"https://themoviedb.org/person/982256"}}, {tmdbId:"30614", properties:{bornIn:"London, Ontario, Canada", imdbId:"0331516", born:date('1980-11-12'), name:"Ryan Gosling", bio:"Ryan Thomas Gosling (born November 12, 1980) is a Canadian actor, musician, social activist and producer.  Gosling began acting at age 12 on the American variety television show The Mickey Mouse Club.  At the age of 17, Gosling was cast as Sean in the short lived Canadian television show Breaker High (1997–1998)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lyUyVARQKhGxaxy0FbPJCQRpiaW.jpg", url:"https://themoviedb.org/person/30614"}}, {tmdbId:"1192383", properties:{imdbId:"1092222", name:"Peter Meadows", url:"https://themoviedb.org/person/1192383"}}, {tmdbId:"39520", properties:{bornIn:"Castro Valley, California, USA", imdbId:"0226813", born:date('1964-11-24'), name:"Garret Dillahunt", bio:"An American actor.  He is married to actress Michelle Hurd...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w5Ziqypp23AMTOaAolAW7RM5pnH.jpg", url:"https://themoviedb.org/person/39520"}}, {tmdbId:"122250", properties:{imdbId:"0252196", name:"Kris Eivers", url:"https://themoviedb.org/person/122250"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
