UNWIND [{tmdbId:"1073785", properties:{imdbId:"1264513", name:"Daniel Magon", url:"https://themoviedb.org/person/1073785"}}, {tmdbId:"1758775", properties:{name:"Nitai Gvirtz", url:"https://themoviedb.org/person/1758775"}}, {tmdbId:"73985", properties:{bornIn:"San Francisco, California, USA", imdbId:"0573726", born:date('1916-06-09'), name:"Robert McNamara", bio:"Robert Strange McNamara was an American business executive and the eighth United States Secretary of Defense, serving from 1961 to 1968 under Presidents John F.  Kennedy and Lyndon B.  Johnson...", died:date('2009-07-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aN2SvNMSJ9bxk8NouE3FCjEVhyQ.jpg", url:"https://themoviedb.org/person/73985"}}, {tmdbId:"107761", properties:{bornIn:"Novosibirsk, USSR (Russia)", imdbId:"0233107", born:date('1941-09-14'), name:"Sergey Dreyden", url:"https://themoviedb.org/person/107761"}}, {tmdbId:"81751", properties:{imdbId:"0974692", name:"Mariya Kuznetsova", url:"https://themoviedb.org/person/81751"}}, {tmdbId:"125597", properties:{bornIn:"Tula, USSR", imdbId:"0610593", born:date('1941-04-17'), name:"Leonid Mozgovoy", bio:"Leonid Mozgovoy was born on April 17, 1941 in Tula. \n\nIn 1961-1965 he studied at the Leningrad state Institute of theater, music and cinematography (LGITMiK) at the faculty of dramatic art (course of Professor B.  V.  Zona).  His fellow students were Olga Antonova, Lev Dodin, Viktor Kostetsky, Sergei Nadporozhsky, Natalia Tenyakova, Vladimir Tykke.  About his teacher and the learning Process L.  Brain recalls in detail in the book \"School of Boris\".  Lessons of acting and directing\" (St.  Petersburg...", url:"https://themoviedb.org/person/125597"}}, {tmdbId:"2089650", properties:{name:"Mikhail Piotrovsky", url:"https://themoviedb.org/person/2089650"}}, {tmdbId:"1148359", properties:{imdbId:"1214542", name:"Georges Lopez", url:"https://themoviedb.org/person/1148359"}}, {tmdbId:"41804", properties:{imdbId:"1311833", name:"Alizé", url:"https://themoviedb.org/person/41804"}}, {tmdbId:"41809", properties:{imdbId:"1308860", name:"Axel Thouvenin", url:"https://themoviedb.org/person/41809"}}, {tmdbId:"41799", properties:{imdbId:"1308889", name:"Guillaume", url:"https://themoviedb.org/person/41799"}}, {tmdbId:"205117", properties:{born:date('1974-04-08'), name:"Derek Barbosa", url:"https://themoviedb.org/person/205117"}}, {tmdbId:"48071", properties:{imdbId:"0780957", name:"Lobo Sebastian", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jY11dhfqwvh5BTx0cVU5ZooHcpU.jpg", url:"https://themoviedb.org/person/48071"}}, {tmdbId:"8326", properties:{bornIn:"Old Windsor, United Kingdom", imdbId:"0568603", born:date('1932-05-09'), name:"Geraldine McEwan", bio:"Geraldine McEwan was an English actress, who had a long career in theatre, television and film.  Michael Coveney described her, in a tribute article, as \"a great comic stylist, with a syrupy, seductive voice and a forthright, sparkling manner\"...", died:date('2015-01-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tKcjt4kzcy5OYMtTzb0RHsAzuvz.jpg", url:"https://themoviedb.org/person/8326"}}, {tmdbId:"37058", properties:{bornIn:"Southall, London, England, UK", imdbId:"0240359", born:date('1970-10-08'), name:"Anne-Marie Duff", bio:"From Wikipedia, the free encyclopedia\n\nAnne-Marie Duff (born 8 October 1970) is an English stage and screen actress.  She rose to prominence playing Fiona Gallagher on the first two seasons of UK television series Shameless.  She then played Queen Elizabeth I in The Virgin Queen (2006), and also the lead role in the television series From Darkness in 2015...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fR3z8QgUDPb6Br5fUmm0ASPTWWx.jpg", url:"https://themoviedb.org/person/37058"}}, {tmdbId:"53998", properties:{bornIn:"Newcastle, Galway, Ireland", imdbId:"1172901", born:date('1984-03-08'), name:"Nora-Jane Noone", bio:"From Wikipedia, the free encyclopedia. \n\nNora-Jane Noone (born March 8, 1984) is an Irish film and television actress best known for her role in The Magdalene Sisters, where she played Bernadette. \n\nDescription above from the Wikipedia article Nora-Jane Noone, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hxrMzZFKflRMr3pJ7N2lrhqaksh.jpg", url:"https://themoviedb.org/person/53998"}}, {tmdbId:"54001", properties:{imdbId:"0240524", name:"Dorothy Duffy", url:"https://themoviedb.org/person/54001"}}, {tmdbId:"18478", properties:{bornIn:"Buenos Aires, Argentina", imdbId:"0209404", born:date('1976-04-18'), name:"Rodrigo De la Serna", bio:"Rodrigo de la Serna (born April 18, 1976) is an Argentine actor and musician.  He is most known for starring in the 2004 biopic The Motorcycle Diaries as Alberto Granado (for which he won the Silver Condor for best actor and the Independent Spirit Award for \"Best Debut Performance\"), the Argentine miniseries Okupas as Ricardo and the Spanish Netflix series Money Heist as Palermo...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vMuKUJSnEGOmjjLYzVDKGukiaCr.jpg", url:"https://themoviedb.org/person/18478"}}, {tmdbId:"18499", properties:{bornIn:"Concorán, San Luis, Argentina", imdbId:"0608187", born:date('1955-09-21'), name:"Mercedes Morán", bio:"From Wikipedia, the free encyclopedia\n\nMercedes Morán (born September 21, 1955, Concarán, San Luis, Argentina) is a film and television actress. \n\nShe works in the cinema of Argentina. \n\nDescription above from the Wikipedia article Mercedes Morán, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a5Qtlz2zRy73aFG6mTkynlpH9zb.jpg", url:"https://themoviedb.org/person/18499"}}, {tmdbId:"18041", properties:{bornIn:"Tel Aviv, Israel", imdbId:"0004912", born:date('1970-11-23'), name:"Oded Fehr", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qMLpZDMGoEMthDCb9dp5VbjKPVT.jpg", url:"https://themoviedb.org/person/18041"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"16867", properties:{bornIn:"Lugo, Galicia, Spain", imdbId:"0869088", born:date('1971-10-13'), name:"Luis Tosar", bio:"Luis Tosar (born 13 October 1971) is a Galician actor.  Born in Cospeito, Galicia, Spain, on 13th October 1971, he is best known internationally for his villain role in Miami Vice...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pMgqQVL0MMTd9Kcqtdo3q4RODZN.jpg", url:"https://themoviedb.org/person/16867"}}, {tmdbId:"16868", properties:{imdbId:"0251021", name:"José Ángel Egido", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wnptjnLVE7FtcekyuPNVZuHDzJ4.jpg", url:"https://themoviedb.org/person/16868"}}, {tmdbId:"16869", properties:{bornIn:"Spain", imdbId:"0210221", name:"Nieve de Medina", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eUciOKs4nXkDyr6MPnT7tHn5ri8.jpg", url:"https://themoviedb.org/person/16869"}}, {tmdbId:"34248", properties:{bornIn:"Arcadia, California, USA", imdbId:"0812133", born:date('1968-12-02'), name:"Rena Sofer", bio:"Rena Sherel Sofer is an American actress, known for her appearances in daytime television, episodic guest appearances, and made-for-television movies.  In 1995, Sofer received a Daytime Emmy Award for her portrayal of Lois Cerullo in the soap opera General Hospital.  Since 2013, she has played Quinn Fuller on the CBS soap opera The Bold and The Beautiful...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4zRCDbsRtTF7xoPNksQHzqI2Mhs.jpg", url:"https://themoviedb.org/person/34248"}}, {tmdbId:"52507", properties:{bornIn:"South Africa", imdbId:"0565973", born:date('1980-03-22'), name:"Kandyse McClure", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iSLT4fhAzIT4mqyDfqVkhBJF0on.jpg", url:"https://themoviedb.org/person/52507"}}, {tmdbId:"28158", properties:{imdbId:"0359398", name:"Martin Hancock", url:"https://themoviedb.org/person/28158"}}, {tmdbId:"3968", properties:{bornIn:"Newport, Monmouthshire, Wales, UK", imdbId:"0790688", born:date('1969-02-05'), name:"Michael Sheen", bio:"Michael Sheen (born 5 February 1969) is a Welsh film, television and stage actor.  Having worked with screenwriter Peter Morgan on five films, Sheen has become known for his portrayals of well-known public figures: Tony Blair in \"The Deal\", \"The Queen\" and \"The Special Relationship\", David Frost in the stage production and film version of \"Frost/Nixon\", and Brian Clough in \"The Damned United\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/k5snONVikijm5rhZxl6h72XcwsS.jpg", url:"https://themoviedb.org/person/3968"}}, {tmdbId:"17337", properties:{bornIn:"London, UK", imdbId:"1812523", name:"Nathalie Cox", bio:"Nathalie Cox is a British actress and model.  She is also known as Natalie Cox.  She is best known for her role as Juno Eclipse in the video game Star Wars: The Force Unleashed and its sequel...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/A5ULB0C1wS52vOZCoPx52SrNsiL.jpg", url:"https://themoviedb.org/person/17337"}}, {tmdbId:"3969", properties:{bornIn:"Belfast, Northern Ireland, UK", imdbId:"0111274", born:date('1970-03-06'), name:"Shane Brolly", bio:"Shane Brolly (born March 6, 1970) is an Irish actor, most known for his role as Kraven in Underworld. \n\nDescription above from the Wikipedia article Shane Brolly, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Arw4qi3nvBhp34hSaMFFk0xIUnf.jpg", url:"https://themoviedb.org/person/3969"}}, {tmdbId:"85689", properties:{bornIn:"Kruševac, Serbia", imdbId:"0812597", born:date('1975-08-27'), name:"Natasa Tapuskovic", bio:"Nataša Tapušković, maiden name Šolak is a Serbian actress.   The blonde green-eyed actress is most recognized for her role as Bosnian hostage, Sabaha, in Emir Kusturica's Life Is a Miracle, in 2004...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lOYfuv3LFiVu51o76lavx86xeIf.jpg", url:"https://themoviedb.org/person/85689"}}, {tmdbId:"85690", properties:{bornIn:"Belgrade, Serbia", imdbId:"0873190", born:date('1965-03-13'), name:"Vesna Trivalic", bio:"Vesna Trivalic is a famous serbian actress.  Studied at Dramatic Arts Academy in Belgrade.  Mainly plays supporting roles, but always quite effective.  Known for her ability to change voice.  Done numerous TV commercials, including commercials for JAT Airways.  She got married in 2006, and hyphenated her surname with Pandurovic.  She has a son...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mXBY0Qya3pL7jZnQ70cu7OZvEQQ.jpg", url:"https://themoviedb.org/person/85690"}}, {tmdbId:"85691", properties:{bornIn:"Belgrade, Serbia", imdbId:"0467451", born:date('1979-11-22'), name:"Vuk Kostic", bio:"​ Vuk Kostić, born November 22, 1979, in Belgrade, Serbia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/950Us9E7sdYJdzMT1w607PLDRII.jpg", url:"https://themoviedb.org/person/85691"}}, {tmdbId:"62122", properties:{bornIn:"New Orleans, Louisianna", imdbId:"0999075", born:date('1989-08-19'), name:"Romeo Miller", bio:"​From Wikipedia, the free encyclopedia.   \n\nPercy Romeo Miller, Jr.  (born August 19, 1989), better known by his stage name Romeo (previously Lil' Romeo), is an American rapper, actor, and model.  He is the son of entertainment mogul and entrepreneur Master P and former rapper Sonya C and nephew of C-Murder and Silkk the Shocker.  He has so far released three studio albums and two compilation albums.  He attended Beverly Hills High School in Beverly Hills, California...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a58BpHR47g1MsZoUR2r15nv3H8C.jpg", url:"https://themoviedb.org/person/62122"}}, {tmdbId:"1096796", properties:{name:"Douglas Sebern", url:"https://themoviedb.org/person/1096796"}}, {tmdbId:"56584", properties:{bornIn:"West Chester, Pennsylvania, USA", imdbId:"0546640", born:date('1979-09-28'), name:"Bam Margera", bio:"Bam Margera (born September 28, 1979) is an American professional skateboarder, television and radio personality, actor and daredevil.  He came to prominence after being drafted into MTV's Jackass crew.  He has since appeared in MTV's Viva La Bam and Bam's Unholy Union and all three Jackass movies...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rqqWLWYitZ8Pl8YDGbEVxyCKZIE.jpg", url:"https://themoviedb.org/person/56584"}}, {tmdbId:"56585", properties:{bornIn:"Wimbledon, London, England, UK", imdbId:"0828177", born:date('1974-06-13'), name:"Steve-O", bio:"Steve-O (born Stephen Gilchrist Glover; June 13, 1974) is an American stunt performer and television personality.  His entertainment career is most centered around his performance stunts on the American TV series Jackass. \n\nDescription above from the Wikipedia article Steve-O , licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/viEcY2cXRedj3XZ5n1py03BmoHR.jpg", url:"https://themoviedb.org/person/56585"}}, {tmdbId:"56586", properties:{bornIn:"Pasadena, California, USA", imdbId:"0690686", born:date('1974-07-16'), name:"Chris Pontius", bio:"From Wikipedia, the free encyclopedia. \n\nChristopher Andrew \"Chris\" Pontius (born July 16, 1974) is an American entertainer and daredevil.  Pontius is a member of Jackass, and along with Steve-O, was the co-host of Wildboyz...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kmsKLpPwN8KAMEIQFH3ELtaUVBa.jpg", url:"https://themoviedb.org/person/56586"}}, {tmdbId:"63522", properties:{bornIn:"Barranquilla, Colombia", imdbId:"0005527", born:date('1972-07-10'), name:"Sofía Vergara", bio:"​Sofia Vergara is the only Hispanic actress who started her career in a U. S.  Hispanic Network and successfully crossed over to the general market. \n\nThis Emmy nominated actress can currently be seen as one of the leads in ABC's six-time EMMY award winning series, \"Modern Family,\" Wednesdays at 9PM EST.  This year she also voiced the role of 'Carmen' in the 3D sequel of Warner Bros \"Happy Feet 2,\" and participated in one of the most anticipated films of 2011 Columbia Picture's \"The Smurfs...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l79eVtn6bSOaiq7R0UGu60foMrK.jpg", url:"https://themoviedb.org/person/63522"}}, {tmdbId:"231014", properties:{bornIn:"Houston, Texas, USA", born:date('1979-10-15'), name:"Jaci Velasquez", bio:"Jacquelyn Davette Velasquez (born October 15, 1979) is an American Contemporary Christian and Latin Pop singer—in both English and Spanish languages. \n\nDescription above from the Wikipedia article Jaci Velasquez, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yysCvqZuRoAwRKSMCBq2FRAoJM3.jpg", url:"https://themoviedb.org/person/231014"}}, {tmdbId:"72968", properties:{bornIn:"Mante, Tamaulipas, Mexico", imdbId:"0895150", born:date('1974-05-21'), name:"Eduardo Verástegui", bio:"From Wikipedia, the free encyclopedia\n\nMexican model, singer, actor and humanitarion. \n\nHe was part of band Kairo and later a solo music career, before he started appearing in Mexican telenovelas and eventually feature films like Chasing Papi, Bella, and Little Boy, the latter two produced by his own production company, Metanoia.   Description above from the Wikipedia article Eduardo Verástegui, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jUPrzJbA4ksTR0DYK10PKpq1yJG.jpg", url:"https://themoviedb.org/person/72968"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"159396", properties:{bornIn:"Stony Point, New York, USA", imdbId:"0183960", born:date('1970-02-08'), name:"Stephanie Courtney", bio:"Stephanie Courtney is an American actress best known for her comedic appearances as insurance agent Flo in a long-running series of Progressive insurance company commercials...", url:"https://themoviedb.org/person/159396"}}, {tmdbId:"1251070", properties:{imdbId:"3889671", name:"Matt Price", url:"https://themoviedb.org/person/1251070"}}, {tmdbId:"42324", properties:{bornIn:"Mobile, Alabama, USA", imdbId:"0348800", born:date('1961-11-04'), name:"Annabelle Gurwitch", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n06YLCPnWtFqYfNDgjGwO5ZQuAV.jpg", url:"https://themoviedb.org/person/42324"}}, {tmdbId:"69643", properties:{imdbId:"1461008", name:"Jonas Rimeika", url:"https://themoviedb.org/person/69643"}}, {tmdbId:"69644", properties:{imdbId:"1460246", name:"Björn Starrin", url:"https://themoviedb.org/person/69644"}}, {tmdbId:"69645", properties:{bornIn:"Enskede, Sweden", imdbId:"0075003", born:date('1953-02-23'), name:"Kjell Bergqvist", bio:"From Wikipedia, the free encyclopedia. \n\nKjell Bergqvist (full name Kjell Bertil Leonard Bergqvist), born 23 February 1953 in Enskede, Stockholm County; Swedish actor. \n\nBergqvist finished Dramatens elevskola in 1973 and made his debut in En enkel melodi and Jack.  He has since cooperated for many years with scriptwriter and director Ulf Malmros.  During the 1990s he has recorded several police films playing Martin Beck's colleague Kollberg...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mNvGXwhR3F27bgwWcHhxugy40IO.jpg", url:"https://themoviedb.org/person/69645"}}, {tmdbId:"72095", properties:{bornIn:"Chickasha, Oklahoma, USA", imdbId:"1195855", born:date('1979-03-25'), name:"Lee Pace", bio:"Lee Grinner Pace (born March 25, 1979) is an American actor. \n\nPace has been featured in film, stage and television.  He currently stars as protagonist Joe MacMillan in AMC's Halt and Catch Fire.  He also played Roy Walker/the Masked Bandit in the 2006 film The Fall.  He has appeared in film series, including The Twilight Saga: Breaking Dawn – Part 2 as Garrett and The Hobbit trilogy as Thranduil...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8DVo5jbEmYpKPrhIFHkA7gGs1X8.jpg", url:"https://themoviedb.org/person/72095"}}, {tmdbId:"14658", properties:{bornIn:"Derby, Derbyshire, England, UK", imdbId:"0175815", born:date('1890-10-14'), name:"Frank Conroy", bio:"From Wikipedia, the free encyclopedia\n\nFrank Parish Conroy (14 October 1890 – 24 February 1964) was a British film and stage actor who appeared in many films, notably Grand Hotel (1932), The Little Minister (1934) and The Ox-Bow Incident (1943).  He appeared on the Broadway stage and won a Tony Award for his performance in Graham Greene's The Potting Shed (1957)...", died:date('1964-02-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aBU425pudThvc3kSZfNR8rMlEo0.jpg", url:"https://themoviedb.org/person/14658"}}, {tmdbId:"1273286", properties:{imdbId:"0236208", name:"Robert C.S. Downs", url:"https://themoviedb.org/person/1273286"}}, {tmdbId:"9464", properties:{bornIn:"Chicago - Illinois - USA", imdbId:"0502015", born:date('1964-11-16'), name:"Harry Lennix", bio:"From Wikipedia, the free encyclopedia. \n\nHarry Joseph Lennix (born November 16, 1964) is an American actor.  He is best known for his roles as \"Dresser\" in the Robert Townsend film \"The Five Heartbeats\" & as \"Boyd Langton\" in the Joss Whedon television show Dollhouse...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kNGiizWpetf4pyAkINkjkWacmCL.jpg", url:"https://themoviedb.org/person/9464"}}, {tmdbId:"4390", properties:{bornIn:"Saint-Cloud, Hauts-de-Seine, France", imdbId:"0756203", born:date('1979-07-03'), name:"Ludivine Sagnier", bio:"Ludivine Sagnier (born 3 July 1979) is a French actress and model, who has worked in 33 movies since 1989.  She was nominated for two César Awards for Best Supporting Actress in Swimming Pool (2003) and Un secret (2007)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hi9oOnpe63UwgUxHmqVCi4q4Mk8.jpg", url:"https://themoviedb.org/person/4390"}}, {tmdbId:"4392", properties:{imdbId:"0483788", name:"Jean-Marie Lamour", bio:"Jean-Marie Lamour is an actor...", url:"https://themoviedb.org/person/4392"}}, {tmdbId:"41190", properties:{bornIn:"Bukarest-Romania", imdbId:"0367157", born:date('1973-03-09'), name:"Rona Hartner", url:"https://themoviedb.org/person/41190"}}, {tmdbId:"57514", properties:{bornIn:"New York City, New York, USA", imdbId:"0498713", born:date('1976-02-14'), name:"Erica Leerhsen", bio:"​From Wikipedia, the free encyclopedia. \n\nErica Lei Leerhsen  (born February 14, 1976) is an American actress.  She is best known for her lead roles in the horror films Book of Shadows: Blair Witch 2, The Texas Chainsaw Massacre, and Wrong Turn 2, and for which she is often referred to as a modern day scream queen.  She is also known for her acting on television series, such as her lead role in The Guardian and several guest appearances, including The Sopranos, Alias, and others...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1YZkzcZD5kDmxBxBHWWr3z0l3FA.jpg", url:"https://themoviedb.org/person/57514"}}, {tmdbId:"6858", properties:{bornIn:"Abington, Pennsylvania, USA", imdbId:"1036181", born:date('1979-07-17'), name:"Mike Vogel", bio:"From Wikipedia, the free encyclopedia. \n\nMichael James Vogel  (born July 17, 1979) is an American actor and former fashion model.  Vogel began acting in 2001, and has since appeared in several films and series, including The Texas Chainsaw Massacre, The Sisterhood of the Traveling Pants, Grind, Poseidon, and Cloverfield...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p85A2hSwdVNbr8qbmr70nJ8LUA0.jpg", url:"https://themoviedb.org/person/6858"}}, {tmdbId:"9827", properties:{bornIn:"Sydney, New South Wales, Australia", imdbId:"0126284", born:date('1979-07-24'), name:"Rose Byrne", bio:"Mary Rose Byrne (born 24 July 1979) is an Australian actress.  Byrne made her screen debut in 1994 with a small role in the film Dallas Doll.  In 2000, she played a leading role in the Australian film The Goddess of 1967, which brought her a Venice Film Festival award for Best Actress.  Since 2007, she has played Ellen Parsons in the cable television series Damages, which has earned her two Golden Globe and two Emmy nominations...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4oQWCLK7gd6RNKF0WJipJo7TyFP.jpg", url:"https://themoviedb.org/person/9827"}}, {tmdbId:"9824", properties:{bornIn:"Algermissen, Germany", imdbId:"1208167", born:date('1976-07-15'), name:"Diane Kruger", bio:"Diane Kruger (born 15 July 1976) is a German actress and former fashion model.  She is known for roles such as Helen in Troy, Dr.  Abigail Chase in National Treasure and its sequel, and Bridget von Hammersmark in Inglourious Basterds...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/phK5pMEWdBtNnhkPK1EQcwPyaUd.jpg", url:"https://themoviedb.org/person/9824"}}, {tmdbId:"60376", properties:{bornIn:"Tanzania", imdbId:"0115410", born:date('1962-01-01'), name:"Alison Bruce", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e4ZZDK9lObXflkOPDHTp84OKM3y.jpg", url:"https://themoviedb.org/person/60376"}}, {tmdbId:"5530", properties:{bornIn:"Port Glasgow, Scotland, UK", imdbId:"0564215", born:date('1979-04-21'), name:"James McAvoy", bio:"A Scottish stage and screen actor.  His best-known work includes the films The Last King of Scotland and Atonement, both of which earned him BAFTA Award nominations, and the TV series Shameless.  McAvoy has won the BAFTA Rising Star Award and a BAFTA Scotland award.  He has also been nominated for an ALFS Award, a European Film Award, and a Golden Globe award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vB6qYlFXgONGVwwxWXE4gf0F8SQ.jpg", url:"https://themoviedb.org/person/5530"}}, {tmdbId:"65261", properties:{bornIn:"Alor Setar, Kedah, Malaysia", imdbId:"0496806", born:date('1976-01-23'), name:"Angelica Lee", bio:"Angelica Lee Sin-Jie (Chinese: 李心潔; pinyin: Lee Sin-je; born 23 January 1976 in Kedah, Malaysia) is a Malaysian Chinese film actress and pop singer.  She started her career in singing and later moved on to acting in Taiwan and Hong Kong.  Lee starred in The Eye, the hit Asian horror film by the Pang Brothers, winning her the Golden Horse Award for Best Actress, Best Actress at the Hong Kong Film Festival and a Hong Kong Golden Bauhinia Award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/39Wwg2YasGP7XHq4n6gbolCEll4.jpg", url:"https://themoviedb.org/person/65261"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"65262", properties:{bornIn:"Hong Kong", imdbId:"1204831", born:date('1979-04-19'), name:"Lawrence Chou", bio:"Lawrence Chou (Chinese: 周俊偉, born 19 April 1979)  is a  Hong Kong-Canadian singer and actor. \n\nDescription above from the Wikipedia article Lawrence Chou, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yqWrM8qkIqnNjDTiz7zy926ixNz.jpg", url:"https://themoviedb.org/person/65262"}}, {tmdbId:"65265", properties:{imdbId:"1217958", name:"Yut Lai So", url:"https://themoviedb.org/person/65265"}}, {tmdbId:"20511", properties:{bornIn:"Hannover, Germany", imdbId:"0057368", born:date('1960-03-28'), name:"Chris Barrie", bio:"Christopher Jonathan Brown, known professionally as Chris Barrie (born 28 March 1960), is a British actor and impressionist.  He is best known for his roles as Arnold Rimmer in the science-fiction comedy, Red Dwarf, and as Gordon Brittas in the sitcom, The Brittas Empire...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/A6Uw4KzsUxx9dwcNxY93t6pkAZg.jpg", url:"https://themoviedb.org/person/20511"}}, {tmdbId:"9186", properties:{bornIn:"Mount Vernon - Washington - USA", imdbId:"0511349", born:date('1976-11-01'), name:"Chad Lindberg", bio:"Chad Tyler Lindberg (born November 1, 1976) is an American actor.  He is best known for his film role as Jesse in The Fast and the Furious and for a rape scene in the 2010 remake I Spit On Your Grave. \n\nDescription above from the Wikipedia article Chad Lindberg, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sUaxwqrwYjZGtLcRH3rsyBd1L9d.jpg", url:"https://themoviedb.org/person/9186"}}, {tmdbId:"8291", properties:{bornIn:"Palm Springs, California, USA", imdbId:"0517844", born:date('1979-09-18'), name:"Alison Lohman", bio:"Alison Marion Lohman is an American actress.  She has had lead roles in the films White Oleander, Where the Truth Lies, Nausicaa of the Valley of the Wind, Flicka and Drag Me to Hell as well as smaller parts in Matchstick Men, Big Fish, Gamer, and Beowulf.  She has also been on several television shows including 7th Heaven, Crusade, Tucker, and Pasadena. \n\nDescription above from the Wikipedia article Alison Lohman, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3jaI7RC27VEFWT3Jqg0qLChUN4P.jpg", url:"https://themoviedb.org/person/8291"}}, {tmdbId:"533195", properties:{bornIn:"Fürth, Germany", imdbId:"0457425", born:date('1923-05-27'), name:"Henry Kissinger", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/91UzhTU4tZUFNloNdn0lakKFdbH.jpg", url:"https://themoviedb.org/person/533195"}}, {tmdbId:"56322", properties:{bornIn:"Newton, Massachusetts, USA", imdbId:"0688132", born:date('1971-09-16'), name:"Amy Poehler", bio:"An American comedian, actress and voice actress.  She was a cast member on the NBC television entertainment show Saturday Night Live from 2001 to 2008.  In 2004, she starred in the film Mean Girls with Tina Fey, with whom she worked again in Baby Mama in 2008.  She is currently the lead of NBC's comedy Parks and Recreation...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c0Noxoo5ppaLSbHvV2GVN8ua70X.jpg", url:"https://themoviedb.org/person/56322"}}, {tmdbId:"83769", properties:{imdbId:"0541120", name:"Robert Mammone", bio:"​From Wikipedia, the free encyclopedia\n\nRobert Mammone is an Australian actor who has many television and film credits. \n\nDescription above from the Wikipedia article Robert Mammone, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6R2xAV1tpJow5mLUmewOdtDA2Rg.jpg", url:"https://themoviedb.org/person/83769"}}, {tmdbId:"94864", properties:{bornIn:"Kingston - New York - USA", imdbId:"0242882", born:date('1969-12-11'), name:"Max Martini", bio:"Maximilian Carlo \"Max\" Martini (born December 11, 1969) is an American film, theater and television actor known for his roles as Corporal Fred Henderson in Saving Private Ryan, Wiley in Level 9, First Sergeant Sid Wojo in The Great Raid, and as Sergeant Mack Gerhardt on the military television drama, The Unit...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gAnzTiy0rQ0CGLXXOreJJQZK03O.jpg", url:"https://themoviedb.org/person/94864"}}, {tmdbId:"93505", properties:{imdbId:"1173676", born:date('1990-03-09'), name:"Giuseppe Cristiano", url:"https://themoviedb.org/person/93505"}}, {tmdbId:"93506", properties:{imdbId:"1212778", name:"Mattia Di Pierro", url:"https://themoviedb.org/person/93506"}}, {tmdbId:"1862616", properties:{name:"Adriana Conserva", url:"https://themoviedb.org/person/1862616"}}, {tmdbId:"93508", properties:{imdbId:"1214634", name:"Fabio Tetta", url:"https://themoviedb.org/person/93508"}}, {tmdbId:"4495", properties:{bornIn:"Concord, Massachusetts, USA", imdbId:"0136797", born:date('1962-08-16'), name:"Steve Carell", bio:"Steven John Carell (born August 16, 1962) is an American actor, comedian, producer, writer and director.  He is best known for his portrayal of boss Michael Scott on the NBC sitcom The Office (2005–2013), on which he also worked as an occasional producer, writer and director. \n\nCarell was a correspondent on The Daily Show with Jon Stewart from 1999 to 2005...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dzJtsLspH5Bf8Tvw7OQC47ETNfJ.jpg", url:"https://themoviedb.org/person/4495"}}, {tmdbId:"27102", properties:{bornIn:"Portsmouth, Virginia, USA", imdbId:"0843100", born:date('1964-03-07'), name:"Wanda Sykes", bio:"Wanda Sykes (born March 7, 1964) is an American writer, stand-up comedian and actress.  She earned the 1999 Emmy Award for her writing on The Chris Rock Show.  In 2004 Entertainment Weekly named her as one of the 25 funniest people in America. \n\nShe is well known for her role as Barb on The New Adventures of Old Christine and for her appearances on HBO's Curb Your Enthusiasm.  In November 2009 The Wanda Sykes Show, her own late-night talkshow, premiered on Fox, airing Saturday nights...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ddMGHykrPp3PQ11WVRGNcDmvh0c.jpg", url:"https://themoviedb.org/person/27102"}}, {tmdbId:"64160", properties:{bornIn:"Alloa, Scotland, UK", imdbId:"0299481", born:date('1925-06-19'), name:"Robert Fyfe", bio:"​From Wikipedia, the free encyclopedia.   \n\nRobert Fyfe (born 19 June 1925; Alloa, Scotland) is a Scottish-born actor, who has appeared as Howard on the long running British sitcom Last of the Summer Wine from 1985 to 2010. \n\nHe also appeared in the movies Xtro, The 51st State, Around the World in 80 Days and Babel.  Other credits include guest appearances on Z Cars, Survivors, The Gentle Touch, The Adventures of Sherlock Holmes and Monarch of the Glen...", url:"https://themoviedb.org/person/64160"}}, {tmdbId:"2192", properties:{bornIn:"Neuilly-sur-Seine, Hauts-de-Seine, France", imdbId:"0933727", born:date('1958-08-03'), name:"Lambert Wilson", bio:"Lambert Wilson (born August 3, 1958) is a French actor.  He is internationally known for his portrayal of The Merovingian in The Matrix movies...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jFkr2kuFfpzS1plfOlNJ6kURV6O.jpg", url:"https://themoviedb.org/person/2192"}}, {tmdbId:"5539", properties:{bornIn:"Holyhead, Wales, UK", imdbId:"0294067", born:date('1957-10-11'), name:"Dawn French", bio:"From Wikipedia, the free encyclopedia\n\nDawn Roma French (born 11 October 1957) is a British actress, writer and comedienne.  She is best-known for starring in and writing for the comedy sketch show French and Saunders with comedy partner Jennifer Saunders and also for playing the lead role of Geraldine Granger in the sitcom The Vicar of Dibley.  She has been nominated for six BAFTA Awards and also won a Fellowship BAFTA along with Jennifer Saunders...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tbuyXaUMnNePjzIysUxa9isFafD.jpg", url:"https://themoviedb.org/person/5539"}}, {tmdbId:"12791", properties:{bornIn:"Stoke-on-Trent, Staffordshire, England, UK", imdbId:"0199215", born:date('1975-06-19'), name:"Hugh Dancy", bio:"Hugh Dancy (born 19 June 1975) is an English Emmy Award nominated actor and model...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sNdeWUm0aHUW4YMARuvZTLzpWwY.jpg", url:"https://themoviedb.org/person/12791"}}, {tmdbId:"47653", properties:{bornIn:"Dublin, Ireland", imdbId:"1264521", born:date('1970-01-01'), name:"Aidan McArdle", bio:"Aidan McArdle is an Irish stage, film and television actor.  He's a graduate of the Royal Academy of Dramatic Art in London, England, UK...", url:"https://themoviedb.org/person/47653"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"195325", properties:{imdbId:"0862539", name:"Ben Tibber", url:"https://themoviedb.org/person/195325"}}, {tmdbId:"8775", properties:{bornIn:"Sofia, Bulgaria", imdbId:"0794885", born:date('1964-01-04'), name:"Hristo Shopov", bio:"​From Wikipedia, the free encyclopedia.   \n\nHristo Naumov Shopov (Bulgarian: Христо Наумов Шопов) (born January 4, 1964 in Sofia) is a Bulgarian actor.  Shopov's father, Naum Shopov, is a famous Bulgarian actor as well. \n\nHe is most noted for his portrayal of Pontius Pilate in Mel Gibson's The Passion of the Christ.  He has become one of Bulgaria's most successful actors, making his debut in 1981 with Dishay, choveche (Breathe, Little Man!)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5b3xNLQwZK15eUiy8QiTGQjJVCA.jpg", url:"https://themoviedb.org/person/8775"}}, {tmdbId:"74329", properties:{bornIn:"Belleville - Illinois - USA", imdbId:"1186492", born:date('1967-08-25'), name:"Jeff Tweedy", url:"https://themoviedb.org/person/74329"}}, {tmdbId:"1389073", properties:{imdbId:"1218017", name:"John Stirratt", url:"https://themoviedb.org/person/1389073"}}, {tmdbId:"1389074", properties:{imdbId:"1218482", name:"Leroy Bach", url:"https://themoviedb.org/person/1389074"}}, {tmdbId:"1286643", properties:{imdbId:"1218681", name:"Glenn Kotche", url:"https://themoviedb.org/person/1286643"}}, {tmdbId:"35705", properties:{bornIn:"Washington, D.C., USA", imdbId:"0356021", born:date('1970-12-12'), name:"Regina Hall", bio:"An American actress and comedian.  She is best known for her multiple leading roles in Girls Trip (2017), Little (2019) and Shaft (2019).  Hall, who was an English major in college and studied journalism in graduate school, envisioned a career as a journalist, but ventured into acting in her late twenties...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zY1IoUVTghMBNUnbqGzjN5AfjA6.jpg", url:"https://themoviedb.org/person/35705"}}, {tmdbId:"1910066", properties:{name:"Antti Tarvainen", url:"https://themoviedb.org/person/1910066"}}, {tmdbId:"212814", properties:{bornIn:"Helsinki, Finland", imdbId:"0754396", born:date('1980-05-06'), name:"Joonas Saartamo", bio:"Joonas Saartamo, born in Helsinki in 1980, is among the finest actors in Finland today. \n\nJoonas graduated from Helsinki Theatre Academy in 2012.  He is known from the movies One-Way Ticket to Mombasa (2002), Beauty and the Bastard (2005), Silence (2011), The Mine (2016), The happiest day in the life of Olli Mäkiand (2016), which won the film award Un Certain Regard in Cannes.  In televison he is known from the series; Pelkovaara (2004), Protectors (2008) and Welcome To Texas, season 1 (2017)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/40M6qzOfolhBZ8v2TvI0BSYe35Y.jpg", url:"https://themoviedb.org/person/212814"}}, {tmdbId:"1910067", properties:{name:"Johanna Rönnlöf", url:"https://themoviedb.org/person/1910067"}}, {tmdbId:"59252", properties:{bornIn:"Los Angeles, California, USA", imdbId:"1223023", born:date('1988-05-17'), name:"Nikki Reed", bio:"From Wikipedia, the free encyclopedia\n\nNicole Houston \"Nikki\" Reed (born May 17, 1988) is an American film and television actress, and screenwriter.  She became known in 2003, after the release of the film Thirteen, for which she co-wrote the screenplay.  Reed has since appeared in several films, including Lords of Dogtown and Mini's First Time.  She also portrays Rosalie Hale in The Twilight Saga...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mIxezXEbSlr6OiS8JnyZQtphYH0.jpg", url:"https://themoviedb.org/person/59252"}}, {tmdbId:"38940", properties:{bornIn:"Raleigh, North Carolina, USA", imdbId:"0939697", born:date('1987-09-07'), name:"Evan Rachel Wood", bio:"Evan Rachel Wood (born September 7, 1987) is an American actress and singer.  Wood began her acting career in the late 1990s, appearing in several television series, including American Gothic and Once and Again.  She made her debut as a leading film actress in Little Secrets (2002) and became well-known after her transition to a more adult-oriented Golden Globe-nominated role in the teen drama film Thirteen (2003)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/g6XBBmsEd9fqP0gc4RuHsX0MXNl.jpg", url:"https://themoviedb.org/person/38940"}}, {tmdbId:"67599", properties:{bornIn:"Salinas, California, USA", imdbId:"1227814", born:date('1988-12-14'), name:"Vanessa Hudgens", bio:"Vanessa Anne Hudgens (born December 14, 1988) is an American actress and singer, best known for her role as Gabriella Montez in the High School Musical series (2006 - 08).  She made her film  screen debut in the 2003 drama film Thirteen...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ssFXWN5li5OWJLgUoFlUDY0ZyPc.jpg", url:"https://themoviedb.org/person/67599"}}, {tmdbId:"5412", properties:{bornIn:"Roma", imdbId:"0100556", born:date('1971-08-14'), name:"Raoul Bova", bio:"Raoul Bova  (born 14 August 1971) is an Italian actor. \n\nBova was born in Rome to Calabrian parents.  At the age of 16 he became a local champion in the 100 meter backstroke.  At the age of 21 he joined the Italian Army and performed his military duty in the Bersaglieri (sharpshooters) corps.  He enrolled in the ISEF, the Italian Institute of Physical Education, but dropped out to pursue a career in acting...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xATFToaMtpCanS5Dxv4W8N6vxd3.jpg", url:"https://themoviedb.org/person/5412"}}, {tmdbId:"20041", properties:{imdbId:"1235696", name:"Maryam Karimi", url:"https://themoviedb.org/person/20041"}}, {tmdbId:"56347", properties:{bornIn:"Sydney, Australia", imdbId:"1047143", born:date('1977-03-23'), name:"Clayton Watson", bio:"Clayton Watson (born 23 March 1977) is an Australian producer, actor, writer, and director.  He grew up in the Australian outback on a sheep station close to Morgan, a small town in South Australia.  He is best known for playing the role of Kid next to Keanu Reeves, Laurence Fishburne, and Carrie-Anne Moss in The Matrix Reloaded, The Matrix Revolutions, and the short film \"Kid's Story\" in The Animatrix...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7T4RCGl5jfpB1XcjXywb6ZmwGUC.jpg", url:"https://themoviedb.org/person/56347"}}, {tmdbId:"115736", properties:{bornIn:"Uppsala, Sweden", imdbId:"0921320", born:date('1972-03-12'), name:"Lisa Werlinder", bio:"​Lisa Werlinder (born 12 March 1972) is a Swedish actress, and jazz musician/singer.   She was born at in Vaksala, Uppsala.   She was educated at Royal Swedish Academy of Music in Stockholm and at Luleå Acting Academy between 1996-2000.  After graduation she was immediately picked to work with Ingmar Bergman at The Royal Dramatic Theatre in Stockholm where she has since starred in several productions, the latest as Cordelia in King Lear...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/db8rzlILFU8aW9wPgAun8O9B3ZH.jpg", url:"https://themoviedb.org/person/115736"}}, {tmdbId:"47153", properties:{bornIn:"Copenhagen, Denmark", imdbId:"0639152", born:date('1935-01-11'), name:"Ghita Nørby", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lYrBNFO0DUdwof0gLogpfBmLulT.jpg", url:"https://themoviedb.org/person/47153"}}, {tmdbId:"1150861", properties:{imdbId:"0803841", name:"Karina Skands", url:"https://themoviedb.org/person/1150861"}}, {tmdbId:"61959", properties:{bornIn:"Burbank, California, USA", imdbId:"0836836", born:date('1990-07-06'), name:"Jeremy Suarez", bio:"​From Wikipedia, the free encyclopedia.   \n\nJeremy Steven Suarez (born July 6, 1990) is an American actor perhaps best known for his starring role of Jordan Thomkins, Bernie Mac's nephew, on The Bernie Mac Show.  His first major movie role was in the 1996 film, Jerry Maguire, in which he played Tyson Tidwell, son of Cuba Gooding Jr. 's character Rod Tidwell.  He had an uncredited role on Sister, Sister in 1996, on Season 4 episode, \"Kid-Napped\"...", url:"https://themoviedb.org/person/61959"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"61960", properties:{imdbId:"0707262", born:date('1975-07-20'), name:"Jason Raize", died:date('2004-02-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4IpCfsu7KKlwlarrSsas13FTtWk.jpg", url:"https://themoviedb.org/person/61960"}}, {tmdbId:"16377", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0000632", born:date('1954-04-29'), name:"Jerry Seinfeld", bio:"Jerome \"Jerry\" Seinfeld (born April 29, 1954 in Brooklyn, New York, U. S. ) is an American stand-up comedian, actor, writer, and television and film producer, known for playing a semi-fictional version of himself in the situation comedy Seinfeld (1989–1998), which he co-created and co-wrote with Larry David, and, in the show's final two seasons, co-executive-produced...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ajmOd1zbf4XtDJw29nXocuMI80b.jpg", url:"https://themoviedb.org/person/16377"}}, {tmdbId:"105787", properties:{bornIn:"New York City, New York, USA", imdbId:"0320607", born:date('1965-12-10'), name:"Greg Giraldo", bio:"From Wikipedia, the free encyclopedia\n\nGreg Giraldo (December 10, 1965 – September 29, 2010) was a Colombian-American stand-up comedian, television personality, and retired lawyer.  Giraldo was best known for his appearances on Comedy Central's televised roast specials, and for his work on that network's television shows Tough Crowd with Colin Quinn, Lewis Black's Root of All Evil, and the programming block Stand-Up Nation, the last of which he hosted...", died:date('2010-09-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4fQ0n5dyohGWpZonnYO49Du0AuL.jpg", url:"https://themoviedb.org/person/105787"}}, {tmdbId:"566120", properties:{name:"Sherrod Small", url:"https://themoviedb.org/person/566120"}}, {tmdbId:"14950", properties:{bornIn:"Dublin - Ireland", imdbId:"0636235", born:date('1938-01-04'), name:"Jim Norton", bio:"Jim Norton is an Irish character actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xCYZumRSdVbRaRSwY7sUEQAslte.jpg", url:"https://themoviedb.org/person/14950"}}, {tmdbId:"170759", properties:{bornIn:"Los Angeles, California, USA ", imdbId:"270139", born:date('1959-06-22'), name:"Wayne Federman", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/y1Y0SxRCUBIVHPjuhPAh9Kipnof.jpg", url:"https://themoviedb.org/person/170759"}}, {tmdbId:"2478232", properties:{name:"Lucas Gregory", url:"https://themoviedb.org/person/2478232"}}, {tmdbId:"50094", properties:{bornIn:"Saskatchewan - Canada", imdbId:"0457090", born:date('1959-11-04'), name:"Ken Kirzinger", bio:"Ken Kirzinger (born November 4, 1959) is a Canadian stuntman and actor best known for his portrayals of Jason Voorhees in Freddy vs.  Jason (2003), Pa in Wrong Turn 2: Dead End (2007) and Rusty Nail in Joy Ride 3: Road Kill (2014).  He also played \"Mason\" Jason Voorhees character spoof in the horror film parody, Stan Helsing...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tUI1pFNniRsP6s9MMVEneVaUGTN.jpg", url:"https://themoviedb.org/person/50094"}}, {tmdbId:"50095", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0728762", born:date('1980-02-17'), name:"Jason Ritter", bio:"Jason Morgan Ritter (born February 17, 1980) is an American actor, son of the late actor John Ritter and actress Nancy Morgan.  Ritter is probably best known for his role as Kevin Girardi in the television series Joan of Arcadia and as Sean Walker in the NBC series The Event. \n\nDescription above from the Wikipedia article Jason  Ritter, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6BPbJD6nUHP4HNHXstWzZTSod6z.jpg", url:"https://themoviedb.org/person/50095"}}, {tmdbId:"18917", properties:{bornIn:"Darjeeling, India", imdbId:"0042805", born:date('1952-04-13'), name:"Erick Avari", bio:"Erick Avari is an Indian born American stage, film and television actor, best known for roles in feature films such as \"The Beast of War\", \"Independence Day\", \"The Mummy\", and \"Planet of the Apes\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aO53uKgLUCID9rCI0SRAIEdsIex.jpg", url:"https://themoviedb.org/person/18917"}}, {tmdbId:"15746", properties:{bornIn:"Fort Riley, Kansas, USA", imdbId:"0044823", born:date('1937-02-27'), name:"Barbara Babcock", bio:"Barbara Babcock was born on February 27, 1937 in Fort Riley, Kansas, USA.  She is an actress, known for Far and Away (1992), Space Cowboys (2000) and Dr.  Quinn, Medicine Woman (1993).  She was previously married to Jay Sheffield...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/etHVJI6BA0bZAP9zHbR95yIshLm.jpg", url:"https://themoviedb.org/person/15746"}}, {tmdbId:"6547", properties:{bornIn:"Paris, France", imdbId:"1227027", born:date('1987-08-08'), name:"Pierre Boulanger", url:"https://themoviedb.org/person/6547"}}, {tmdbId:"5079", properties:{bornIn:"Paris - France", imdbId:"0577841", born:date('1958-11-12'), name:"Gilbert Melki", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/it67JYTy11KBc3JH3JsNoNoc72D.jpg", url:"https://themoviedb.org/person/5079"}}, {tmdbId:"37332", properties:{imdbId:"0567184", born:date('1933-07-07'), name:"David McCullough", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wgWz9xD6ZXl547LR4VrSQifsKUr.jpg", url:"https://themoviedb.org/person/37332"}}, {tmdbId:"156889", properties:{imdbId:"0640476", name:"Paul Vincent O'Connor", url:"https://themoviedb.org/person/156889"}}, {tmdbId:"97185", properties:{bornIn:"Fort Worth, Texas, United States", imdbId:"1129383", born:date('1970-07-25'), name:"Eric Jacobson", bio:"​From Wikipedia, the free encyclopedia.   \n\nEric Jacobson (b.  July 25, 1970) is a puppeteer and Muppet performer, who has been the primary replacement puppeteer for Frank Oz's characters since 2001. \n\nJacobson initially started playing Bert in 1997, but officially joined the cast as Bert and additional Muppets in 2000.  His role expanded in 2002 to include new Grover segments, particularly Global Grover...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bB4DRQwKUswG8uvFmDDHHWFwzlz.jpg", url:"https://themoviedb.org/person/97185"}}, {tmdbId:"1833", properties:{bornIn:"Lochend, Edinburgh, Scotland", imdbId:"0803397", born:date('1973-08-02'), name:"Jamie Sives", bio:"Jamie Sives (born 1973) is a Scottish actor. \n\nDescription above from the Wikipedia article Jamie Sives, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/1833"}}, {tmdbId:"1643", properties:{bornIn:"Stoke-on-Trent, Staffordshire, England, UK", imdbId:"0712628", born:date('1958-03-27'), name:"Adrian Rawlins", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/G0PGZqTjenuVTAQiib4ScU7vAI.jpg", url:"https://themoviedb.org/person/1643"}}, {tmdbId:"1835", properties:{imdbId:"1229993", name:"Lisa McKinlay", url:"https://themoviedb.org/person/1835"}}, {tmdbId:"60736", properties:{bornIn:"Hapeville, Georgia, USA", imdbId:"0289344", born:date('1958-09-06'), name:"Jeff Foxworthy", bio:"Jeff Foxworthy is an American comedian, television and radio personality and author, known as a member of the Blue Collar Comedy Tour, a comedy troupe which also comprises Larry the Cable Guy, Bill Engvall and Ron White...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3kJ6uVvDddIrTudxlZIpJ5yg4bN.jpg", url:"https://themoviedb.org/person/60736"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"76997", properties:{bornIn:"Galveston, Texas, USA", imdbId:"0257821", born:date('1957-07-27'), name:"Bill Engvall", bio:"William Ray \"Bill\" Engvall, Jr.  (born July 27, 1957) is an American comedian and actor best known for his work as a stand-up comic and as a member of the Blue Collar Comedy group.  In 2007, TBS began airing his sitcom The Bill Engvall Show.  He has released multiple comedy albums on Warner Bros.  Records as well. \n\nDescription above from the Wikipedia article Bill Engvall, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bUn1oGOLqhQB2KDJBMXR54MuXJB.jpg", url:"https://themoviedb.org/person/76997"}}, {tmdbId:"83227", properties:{bornIn:"Fritch, Texas, USA", imdbId:"1247387", born:date('1956-12-18'), name:"Ron White", bio:"From Wikipedia, the free encyclopedia. \n\nRonald \"Tater Salad\" White (born December 18, 1956) is an American stand up comedian who has had two Grammy Award-nominations, and is RIAA certified 10x Platinum for CD and DVD sales of over 10 million units.  He is a charter member of the Blue Collar Comedy Tour and authored the book I Had the Right to Remain Silent But I Didn't Have the Ability (Dutton 2006, ISBN 978-0525949619), which appeared on the New York Times best seller list...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/A3h153cGYDWP66p0r4NbeN5ERhQ.jpg", url:"https://themoviedb.org/person/83227"}}, {tmdbId:"73952", properties:{bornIn:"Breckenridge, Minnesota, USA", imdbId:"0862841", born:date('1947-09-25'), name:"Cheryl Tiegs", bio:"Cheryl Rae Tiegs (born September 25, 1947) is an American model and fashion designer.  Frequently described as the first American supermodel.  Tiegs is best known for her multiple appearances on the covers of the Sports Illustrated Swimsuit Issue and TIME and for her 1978 \"Pink Bikini\" poster, which became an iconic image of 1970s pop culture. \n\nDescription above from the Wikipedia article Cheryl Tiegs, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h6GRPN9rdDHd9s4PNOtyXRTO84u.jpg", url:"https://themoviedb.org/person/73952"}}, {tmdbId:"73953", properties:{bornIn:"  United States", imdbId:"1686350", name:"Elizabeth Blake", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7daD7eVmjyNyZWdom3aZYQb4GI3.jpg", url:"https://themoviedb.org/person/73953"}}, {tmdbId:"1070523", properties:{bornIn:"Lake Arrowhead, California, USA", imdbId:"0393700", born:date('1972-01-15'), name:"Jeremy Hoop", bio:"Jeremy Hoop is an American musician, singer-songwriter, film and television actor.  He holds a BA in Theater and Music from Brigham Young University, Provo, Utah, USA...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qkgZKm7SH3VoUhn7d06gg60O5gy.jpg", url:"https://themoviedb.org/person/1070523"}}, {tmdbId:"1133440", properties:{imdbId:"1392550", name:"Randy King", url:"https://themoviedb.org/person/1133440"}}, {tmdbId:"229565", properties:{imdbId:"1235592", name:"Heather Beers", bio:"Heather Beers is an American actress, voice over artist, and freelance writer.  Her two most notable movie roles have been as the title character in Charly (a 2002 independent film based on the 1980 Jack Weyland novel of the same title) and as Charity (the lead female role) in Baptists at Our Barbecue...", url:"https://themoviedb.org/person/229565"}}, {tmdbId:"13249", properties:{bornIn:"Saitama, Japan", imdbId:"0437816", born:date('1977-08-22'), name:"Miho Kanno", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aexiULverg6lgXEYotU8xDg9Cpc.jpg", url:"https://themoviedb.org/person/13249"}}, {tmdbId:"13250", properties:{bornIn:"Tokyo Prefecture, Japan", imdbId:"0632689", born:date('1971-03-29'), name:"Hidetoshi Nishijima", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fZZqifOwir9HGXh84yqIV6ZGH2k.jpg", url:"https://themoviedb.org/person/13250"}}, {tmdbId:"13252", properties:{bornIn:"Ikeda, Gifu Prefecture, Japan", imdbId:"0559385", born:date('1945-01-06'), name:"Chieko Matsubara", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/t6ms64fzvYnAvvffxQST2kojvSe.jpg", url:"https://themoviedb.org/person/13252"}}, {tmdbId:"20053", properties:{bornIn:"Oldham, Lancashire, England, UK", imdbId:"0843059", born:date('1923-05-04'), name:"Eric Sykes", bio:"'Eric Sykes' started as a radio scriptwriter but he soon found he could perform as well as write.  The slight handicap of being very hard of hearing doesn't interfere with his wonderful comic timing.  The spectacles he wears have no lenses but contain a bone conducting hearing aid...", died:date('2012-07-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yr7R2TZatkuniQKnNwdJLHuebCz.jpg", url:"https://themoviedb.org/person/20053"}}, {tmdbId:"20049", properties:{bornIn:"Bathgate, West Lothian, Scotland, UK", imdbId:"0855039", born:date('1971-04-18'), name:"David Tennant", bio:"David Tennant (born David John McDonald on 18 April 1971) is a Scottish actor.  In addition to his work in theatre, including a widely praised Hamlet, Tennant is best known for his role as the tenth incarnation of the Doctor in Doctor Who, along with the title role in the 2005 TV serial Casanova and as Barty Crouch, Jr.  in the 2005 film adaptation, Harry Potter and the Goblet of Fire...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9PJteC0a8POnPhqgxvdtWNKHPsD.jpg", url:"https://themoviedb.org/person/20049"}}, {tmdbId:"7002", properties:{bornIn:"Hamilton, Ontario, Canada", imdbId:"0456186", born:date('1978-06-21'), name:"Luke Kirby", bio:"Luke Kirby (born June 29, 1978) is an American-Canadian actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2kTNxdMsgM8LuWzfKaBGsvSFf41.jpg", url:"https://themoviedb.org/person/7002"}}, {tmdbId:"7003", properties:{bornIn:"Montreal, Québec, Canada", imdbId:"0719729", born:date('1946-04-28'), name:"Ginette Reno", bio:"From Wikipedia, the free encyclopedia. \n\nGinette Reno, OC, CQ (born April 28, 1946) is a French-Canadian author, composer, singer, and actress.  She is known by the nickname \"La Reno\". \n\nBorn as Ginette Reynault (some sources indicate Raynault) in Montreal, Quebec, she played the role of Maria Barberini in the independent film Mambo Italiano and played the mother in Léolo. \n\nShe has recorded in both English and French.  Her biggest hit in English is the 1971 song \"Beautiful Second Hand Man\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zdu1Ko6x9VrmXA54SEGTW7kGlBS.jpg", url:"https://themoviedb.org/person/7003"}}, {tmdbId:"7005", properties:{bornIn:"St. John's, Newfoundland", imdbId:"0909763", born:date('1952-05-13'), name:"Mary Walsh", bio:"From Wikipedia, the free encyclopedia. \n\nMary Cynthia Walsh, CM was born on May 13, 1952, in St.  John's, Newfoundland, and is an actress and comedian and social activist.  A sufferer of macular degeneration, she has served from time to time as a spokesperson for the Canadian National Institute for the Blind (CNIB).  Walsh's son Jesse was born in 1989.  She has been married to Memorial University of Newfoundland English professor Don Nichol since 2002...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aMvQu5iI4I5fFjYrDI2UzUTDEbk.jpg", url:"https://themoviedb.org/person/7005"}}, {tmdbId:"1215657", properties:{imdbId:"0028551", name:"A. Russell Andrews", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/t78R2krL2pfV0un2j2DafjcXa7x.jpg", url:"https://themoviedb.org/person/1215657"}}, {tmdbId:"1223998", properties:{imdbId:"1357072", name:"Omar Avila", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gUhKo81FNJ7dKRZNcmnR4EHlfGS.jpg", url:"https://themoviedb.org/person/1223998"}}, {tmdbId:"53198", properties:{bornIn:"Albany, New York, USA", imdbId:"0139549", born:date('1975-08-13'), name:"James Carpinello", bio:"​From Wikipedia, the free encyclopedia\n\nJames Carpinello (born August 13, 1975) is an American film, television, and Broadway actor who came to national attention with his appearances in Tori Spelling's VH1 sitcom So NoTORIous.  He is also in Rock of Ages...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/18b4AHQ5P21I4tM7vN8jYvpJv6j.jpg", url:"https://themoviedb.org/person/53198"}}, {tmdbId:"53199", properties:{bornIn:"Waynesboro, Tennessee, USA", imdbId:"0171868", born:date('1956-01-18'), name:"Mark Collie", url:"https://themoviedb.org/person/53199"}}, {tmdbId:"57127", properties:{bornIn:"Sherman Oaks, California, USA", imdbId:"0380231", born:date('1982-01-11'), name:"Blake Heron", bio:"Blake Heron (January 11, 1982 - September 8, 2017) was an American screen actor.  He was best known for starring as Marty Preston in the 1996 film Shiloh...", died:date('2017-09-08'), url:"https://themoviedb.org/person/57127"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"68634", properties:{bornIn:" Vancouver, British Columbia, Canada", imdbId:"0717077", born:date('1980-09-19'), name:"Tanja Reichert", url:"https://themoviedb.org/person/68634"}}, {tmdbId:"11669", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0266422", born:date('1974-09-19'), name:"Jimmy Fallon", bio:"James Anthony \"Jimmy\" Fallon, Jr.  (born September 18, 1974) is an American actor, comedian, singer, musician and television host.  He currently hosts Late Night with Jimmy Fallon, a late-night talk show that airs Monday through Friday on NBC.  Prior to that, he was best known as a cast member on Saturday Night Live from 1998–2004, as well as appearing in several films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/49ouN0xbgEp7x4suJPtujFzhIKr.jpg", url:"https://themoviedb.org/person/11669"}}, {tmdbId:"74151", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"1555151", born:date('1997-04-28'), name:"Jason Spevack", url:"https://themoviedb.org/person/74151"}}, {tmdbId:"1240", properties:{bornIn:"Philadelphia, Pennsylvania, USA ", imdbId:"0444940", born:date('1946-05-22'), name:"Jack Kehler", bio:"Jack has appeared in over 60 feature films, including Men in Black II.  One of his most memorable performances was in film Love Liza as Denny, an energetic radio control hobbyist trying to help Philip Seymour Hoffman's character come to terms with the suicide of his wife.  He also had a brief but memorable role in The Big Lebowski as The Dude's (Jeff Bridges) landlord. \n\nHe guest starred in the Star Trek: Deep Space Nine episode \"Babel\", and in the Angel episode \"Long Day's Journey\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sknIxbSCr9jKn1pfYt1yCVFFXRs.jpg", url:"https://themoviedb.org/person/1240"}}, {tmdbId:"92999", properties:{bornIn:"U.S.A", imdbId:"1246238", born:date('1989-06-12'), name:"Valentina de Angelis", bio:"Valentina de Angelis was born on June 12, 1989 in the USA.  She is an actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hePp2CVUC5KldMXE6peI7Bj11oA.jpg", url:"https://themoviedb.org/person/92999"}}, {tmdbId:"11663", properties:{bornIn:"Salt Lake City, Utah, USA", imdbId:"0297578", born:date('1982-10-27'), name:"Patrick Fugit", bio:"Patrick Raymond Fugit (born October 27, 1982) is an American actor best known for his performance in the lead role of Cameron Crowe's film Almost Famous. \n\nDescription above from the Wikipedia article Patrick Fugit, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bsONcodcqRKV97p1Oo1jcPkEnDA.jpg", url:"https://themoviedb.org/person/11663"}}, {tmdbId:"17737", properties:{imdbId:"1306097", name:"Lucas Papaelias", bio:"Lucas Papaelias is an actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6RPB3aTQRj9EiIzZjyGHe7zlOpC.jpg", url:"https://themoviedb.org/person/17737"}}, {tmdbId:"17738", properties:{imdbId:"1083114", name:"Chris Stack", bio:"Chris Stack is an actor...", url:"https://themoviedb.org/person/17738"}}, {tmdbId:"24898", properties:{bornIn:"Gold Coast, Queensland, Australia ", imdbId:"0428923", born:date('1969-08-21'), name:"Nathan Jones", bio:"Nathan Jones rose upon the world strongman scene in 1995 and showed promise to become perhaps the top competitor in the world.  At 6' 11\" and 360 lbs. , the giant Australian known as Megaman was an imposing sight and used his great size and strength to place high in the World Musclepower Championships...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pUZdOzNKxkX5p0GRbsTDPrH9pNv.jpg", url:"https://themoviedb.org/person/24898"}}, {tmdbId:"20808", properties:{bornIn:"Pittsburgh, Pennsylvania, USA", imdbId:"0549538", born:date('1963-01-01'), name:"Adoni Maropis", bio:"Born and raised in Burgettstown, Pennsylvania, a small town near Pittsburgh.  He is the middle son of Petro and Despina Maropis and is very close to his brothers, Sam and Chris. \n\nBeing an exceptional all-around athlete in high school (Burgettstown High-school in southwest Pennsylvania), it appeared Adoni would pursue a professional career in some sport...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eMT9AihEqmnJdAqIqWvsWm590mn.jpg", url:"https://themoviedb.org/person/20808"}}, {tmdbId:"5368", properties:{imdbId:"1539292", name:"Kenneth Graymez", url:"https://themoviedb.org/person/5368"}}, {tmdbId:"5369", properties:{bornIn:"Frankfort, Kentucky, USA", imdbId:"0938045", born:date('1954-09-23'), name:"George C. Wolfe", bio:"From Wikipedia, the free encyclopedia. \n\nGeorge Costello Wolfe (born September 23, 1954) is an American playwright and director of theater and film.  He won a Tony Award in 1993 for directing Angels in America: Millennium Approaches and another Tony Award in 1996 for his direction of the musical, Bring in 'da Noise/Bring in 'da Funk. \n\nDescription above from the Wikipedia article George C...", url:"https://themoviedb.org/person/5369"}}, {tmdbId:"5370", properties:{bornIn:"Champaign-Urbana - Illinois - USA", imdbId:"1173786", born:date('1977-04-19'), name:"Austin Lysy", bio:"Austin Lysy is an actor...", url:"https://themoviedb.org/person/5370"}}, {tmdbId:"38334", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0177639", born:date('1961-08-28'), name:"Jennifer Coolidge", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dYPv8yReoF4EWp0aOoHfm7vmKOi.jpg", url:"https://themoviedb.org/person/38334"}}, {tmdbId:"2245920", properties:{name:"Stephen Fielding", url:"https://themoviedb.org/person/2245920"}}, {tmdbId:"2245921", properties:{name:"Tonya Gregory", url:"https://themoviedb.org/person/2245921"}}, {tmdbId:"2245922", properties:{name:"Bernice Hagler", url:"https://themoviedb.org/person/2245922"}}, {tmdbId:"82097", properties:{imdbId:"0461324", born:date('1976-09-28'), name:"Ohad Knoller", url:"https://themoviedb.org/person/82097"}}, {tmdbId:"82098", properties:{bornIn:"Petach Tikwa, Israel", imdbId:"1106990", born:date('1979-06-29'), name:"Yehuda Levi", bio:"Yehuda Levi was born in 1979, and grew up in the city of Hertzeliya.  He is a charismatic actor and a kind person in real life.  His noticeable breakthrough was in TV-series Lechayey Ha'ahava (2001), and he is much admired by plenty (mostly girls), maybe to his displeasure, since he is not left alone lately.  He attended the \"Telma-Yalin\" High school of stage art, and graduated with excellence...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tCbZoN3YopufGpH0hNnMge3J5Dl.jpg", url:"https://themoviedb.org/person/82098"}}, {tmdbId:"82100", properties:{imdbId:"1149650", name:"Aya Steinovitz", url:"https://themoviedb.org/person/82100"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"72723", properties:{imdbId:"1022440", born:date('1980-01-07'), name:"Anne Judson-Yager", bio:"From Wikipedia, the free encyclopedia\n\nJudson-Yager is known for her roles in Bring It On Again, the sequel to the film Bring It On and Believe In Me.  She was also seen in NCIS in episode 37. \n\nDescription above from the Wikipedia article Anne Judson-Yager, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/72723"}}, {tmdbId:"62065", properties:{bornIn:"Palo Alto, California, U.S.", imdbId:"0877430", born:date('1977-03-10'), name:"Bree Turner", bio:"Bree Nicole Turner (born March 10, 1977) is an American actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a6mpCcLHQpnkyjJVBtXH6oxfPGy.jpg", url:"https://themoviedb.org/person/62065"}}, {tmdbId:"25711", properties:{bornIn:"Houston, Texas, USA ", imdbId:"0004668", born:date('1945-10-02'), name:"Kevin Cooney", bio:"From Wikipedia, the free encyclopedia  Kevin Cooney (born October 2, 1945) is an American film and television actor.  He has appeared in the films Legally Blonde, Austin Powers in Goldmember, Con Air and many others, and the television series Dharma &amp; Greg, CSI: Crime Scene Investigation, and others.   Description above from the Wikipedia article Kevin Cooney, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iPhJ6276RTcdpyeuhi6U6y1p8Ci.jpg", url:"https://themoviedb.org/person/25711"}}, {tmdbId:"58953", properties:{bornIn:"Miami, Florida, U.S.", imdbId:"0150330", born:date('1976-09-23'), name:"Faune Chambers Watkins", bio:"Chambers has had roles in the films White Chicks (2004) and Epic Movie (2007).  She has also been featured in Austin Powers in Goldmember (2002), Breakin' All the Rules (2004), Bring It On Again (2004) and The Cutting Edge: Going for the Gold (2006).  Her television appearances include Las Vegas, All of Us, The Game, Eve, and Psych.  She is also featured on Trina and Tamara's video \"What'd You Come Here For?\", Ne-Yo's video \"Mad\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9dgiNAZgcWDUmPGgodqGWBEwQUO.jpg", url:"https://themoviedb.org/person/58953"}}, {tmdbId:"145204", properties:{imdbId:"0731732", name:"Barbara E. Robertson", url:"https://themoviedb.org/person/145204"}}, {tmdbId:"52414", properties:{bornIn:"Victoria, British Columbia, Canada", imdbId:"1080974", born:date('1993-01-26'), name:"Cameron Bright", bio:"From Wikipedia, the free encyclopedia. \n\nCameron Bright (born Cameron Douglas Crigger; January 26, 1993) is a Canadian actor.  He has appeared in the films Godsend, Birth, Running Scared, Ultraviolet, X-Men: The Last Stand and Thank You for Smoking and appeared in The Twilight Saga: New Moon as Alec. \n\nDescription above from the Wikipedia article Cameron Bright, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/b4DkwKvJ4ZqV87BmAWhrZYW7dHt.jpg", url:"https://themoviedb.org/person/52414"}}, {tmdbId:"1770", properties:{imdbId:"1440108", name:"Akiko Takeshita", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dKawZTpMtjAYZanVf20wr6a81sL.jpg", url:"https://themoviedb.org/person/1770"}}, {tmdbId:"1773", properties:{imdbId:"1440076", name:"Kazuyoshi Minamimagoe", url:"https://themoviedb.org/person/1773"}}, {tmdbId:"8768", properties:{bornIn:"Bucharest, Romania", imdbId:"0411581", born:date('1962-05-01'), name:"Maia Morgenstern", bio:"A Romanian film and stage actress,  described by Florin Mitu of AMOS News as \"a symbol of Romanian theater and film\".   In the English-speaking world, she is probably best known for the role of Mary, the mother of Jesus, in Mel Gibson's The Passion of the Christ.  In Romania, she has been nationally known since her 1992 role as Nela in Balanţa, a film known in the United States as The Oak, set during the waning days of Communist Romania...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i4wy2RnLmoJueeJooZ9b03BN7fr.jpg", url:"https://themoviedb.org/person/8768"}}, {tmdbId:"8769", properties:{bornIn:"Sofia, Bulgaria", imdbId:"0998941", born:date('1975-02-18'), name:"Christo Jivkov", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iv8gzmS4gswtk5KZBwgITKtzpzm.jpg", url:"https://themoviedb.org/person/8769"}}, {tmdbId:"8770", properties:{imdbId:"1357161", name:"Francesco De Vito", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tAYlseLIAFSjL7ijHkrhLS2HlOF.jpg", url:"https://themoviedb.org/person/8770"}}, {tmdbId:"19767", properties:{bornIn:"Long Beach, California, USA", imdbId:"0004879", born:date('1971-10-20'), name:"Snoop Dogg", bio:"Calvin Cordozar Broadus, Jr.  is an American rapper, singer-songwriter, record producer, and actor, well known by his stage names Snoop Doggy Dogg, Snoop Dogg, and Snoop Lion.  He has sold over 30 million albums worldwide...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xMNvAveE8gMxqhKa4zs2DPLgsas.jpg", url:"https://themoviedb.org/person/19767"}}, {tmdbId:"17052", properties:{bornIn:"New York City, New York, USA", imdbId:"0333410", born:date('1978-07-12'), name:"Topher Grace", bio:"Christopher John \"Topher\" Grace (born July 12, 1978) is an American actor.  He is best known for his portrayal of Eric Forman on the FOX sitcom That '70s Show, Eddie Brock/Venom in the Sam Raimi film Spider-Man 3, and Edwin in the 2010 film Predators...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oJQxl4DG0KSCtOGrpWNhYz9gUZA.jpg", url:"https://themoviedb.org/person/17052"}}, {tmdbId:"19536", properties:{bornIn:"Minot, North Dakota, USA", imdbId:"0241049", born:date('1972-12-14'), name:"Josh Duhamel", bio:"Joshua David \"Josh\" Duhamel (November 14, 1972) was born in Minot, North Dakota.  Duhamel is an American actor and former fashion model.  He first achieved acting success in 1999 as Leo du Pres on ABC's All My Children and later as the chief of security, Danny McCoy, on NBC's Las Vegas...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pImYEPzq2L9ndd4rsZLmiCjqbW5.jpg", url:"https://themoviedb.org/person/19536"}}, {tmdbId:"1528739", properties:{imdbId:"0550164", name:"Kim Marriner", url:"https://themoviedb.org/person/1528739"}}, {tmdbId:"35081", properties:{bornIn:"France", imdbId:"1301340", born:date('1977-11-19'), name:"Camille Natta", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ni2JKTLqk6hsFM35oZLe3LxNT3t.jpg", url:"https://themoviedb.org/person/35081"}}, {tmdbId:"1333", properties:{bornIn:"Ruislip, Middlesex, England, UK", imdbId:"0785227", born:date('1964-04-20'), name:"Andy Serkis", bio:"Andrew \"Andy\" Clement Serkis (born 20 April 1964) is an English film actor and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2aJLwOQK50Lx7PvIHGW1GMytTOL.jpg", url:"https://themoviedb.org/person/1333"}}, {tmdbId:"68307", properties:{bornIn:"London, England, UK", imdbId:"0531101", born:date('1976-03-01'), name:"Luke Mably", bio:"​From Wikipedia, the free encyclopedia.   \n\nLuke Mably (born Thomas Luke Mably on 1 March 1976) is an English actor, best known for playing Scott Lucas in Sky One's Dream Team, Prince Edvard in The Prince and Me and 'White' in the 2009 thriller, Exam.  He attended the Birmingham School of Speech and Drama. \n\nDescription above from the Wikipedia article Luke Mably , licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jTMAb14IELP0s2FjpFsM0Bo5rJk.jpg", url:"https://themoviedb.org/person/68307"}}, {tmdbId:"82820", properties:{bornIn:"Iqaluit, Nunavut, Canada", imdbId:"1266776", born:date('1982-12-19'), name:"Annabella Piugattuk", bio:"From Wikipedia, the free encyclopedia\n\nAnnabella Piugattuk (born December 19, 1982 in Iqaluit, Nunavut, Canada) is a Canadian Inuit actress, notable for her role in The Snow Walker.  Piugattuk was raised in Igloolik, a village with a population of 1286 in the Nunavut territory of Canada.  Since starring in The Snow Walker she has moved to Vancouver, British Columbia. \n\nShe was approached by a casting agent about auditioning for The Snow Walker while at a dance with some friends in Igloolik...", url:"https://themoviedb.org/person/82820"}}, {tmdbId:"23504", properties:{bornIn:"Creston, Iowa, USA", imdbId:"0912916", born:date('1965-11-04'), name:"Kiersten Warren", bio:"Kiersten Nicolla Dale Warren is an American actress.  Her best known roles include Alex Tabor on Saved by the Bell: The College Years and Nora Huntington on Desperate Housewives...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/83lqGpKZP61OPsfj6TfmX8jVCVt.jpg", url:"https://themoviedb.org/person/23504"}}] AS row
