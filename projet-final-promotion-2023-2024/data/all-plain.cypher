UNWIND [{tmdbId:"12073", properties:{bornIn:"Scarborough, Ontario, Canada", imdbId:"0000196", born:date('1963-05-25'), name:"Mike Myers", bio:"Michael John \"Mike\" Myers (born May 25, 1963) is a Canadian actor, comedian, screenwriter, and film producer of British parentage.  He was a long-time cast member on the NBC sketch show Saturday Night Live in the late 1980s and the early 1990s and starred as the title characters in the films Wayne's World, Austin Powers, and the Shrek film series. \n\nDescription above from the Wikipedia article Mike Myers, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gjfDl52Kk02MPgUYFjs9bOy33OY.jpg", url:"https://themoviedb.org/person/12073"}}, {tmdbId:"56159", properties:{bornIn:"Missoula, Montana, USA", imdbId:"0001022", born:date('1955-06-02'), name:"Dana Carvey", bio:"​From Wikipedia, the free encyclopedia.   \n\nDana Thomas Carvey (born June 2, 1955) is an American actor and stand-up comedian, best known for his work as a cast member on Saturday Night Live and for playing the role of Garth in the Wayne's World movies. \n\nDescription above from the Wikipedia article Dana Carvey, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qlb0apjFhoQ9UwCcvzrLm1mTIx0.jpg", url:"https://themoviedb.org/person/56159"}}, {tmdbId:"13445", properties:{bornIn:"Honolulu, Hawaii, USA", imdbId:"0000119", born:date('1967-01-02'), name:"Tia Carrere", bio:"Tia Carrere  (born Althea Rae Janairo; January 2, 1967) is an American actress, model, and singer, perhaps most widely known for her role as Cassandra Wong in the feature films Wayne's World and Wayne's World 2 and as Sydney Fox in the TV series Relic Hunter...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a3bJNCU0i1UttGKhnMGx6wwEd9D.jpg", url:"https://themoviedb.org/person/13445"}}, {tmdbId:"4810", properties:{bornIn:"Bushwick, Brooklyn, New York City, New York, USA", imdbId:"0001609", born:date('1964-09-06'), name:"Rosie Perez", bio:"Rosa María Perez (born September 6, 1964) is an American actress, community activist, talk show host, author, dancer, and choreographer.  Her film breakthrough performance was her portrayal of Tina in Spike Lee's Do the Right Thing (1989), which she followed with White Men Can't Jump (1992)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1AD61lJoegfgYIOMezaYlCpbitJ.jpg", url:"https://themoviedb.org/person/4810"}}, {tmdbId:"9782", properties:{bornIn:"Houston, Texas, US", imdbId:"0274508", born:date('1962-01-28'), name:"Tyra Ferrell", bio:"​From Wikipedia, the free encyclopedia\n\nTyra Ferrell (born January 28, 1962) is an American actress. \n\nDescription above from the Wikipedia article Tyra Ferrell, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/9782"}}, {tmdbId:"2231", properties:{bornIn:"Washington, D.C., USA", imdbId:"0000168", born:date('1948-12-21'), name:"Samuel L. Jackson", bio:"An American film and television actor and film producer.  After Jackson became involved with the Civil Rights Movement, he moved on to acting in theater at Morehouse College, and then films.  He had several small roles such as in the film Goodfellas, Def by Temptation, before meeting his mentor, Morgan Freeman, and the director Spike Lee.  After gaining critical acclaim for his role in Jungle Fever in 1991, he appeared in films such as Patriot Games, Amos & Andrew, True Romance and Jurassic Park...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mXN4Gw9tZJVKrLJHde2IcUHmV3P.jpg", url:"https://themoviedb.org/person/2231"}}, {tmdbId:"65992", properties:{bornIn:"Hong Kong, British Crown Colony [now China]", imdbId:"0596291", born:date('1960-12-02'), name:"Siu Chung Mok", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yTJvpKXrNHbvJPTzRtDDM2pIAfa.jpg", url:"https://themoviedb.org/person/65992"}}, {tmdbId:"65986", properties:{bornIn:"Suzhou, Jiangsu, China", imdbId:"0156955", born:date('1947-06-29'), name:"David Chiang", bio:"David Chiang Da-wei (Chinese: 姜大衛, born 29 June 1947 in Suzhou, Jiangsu), sometimes credited as David Chiang, is a Hong Kong actor, director and producer.  This 70's martial arts superstar signed by the Shaw Brothers Studio, has appeared in over 130 films and 30 television series...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8Px2kQf2KTCeSfch6RJaljEPgc.jpg", url:"https://themoviedb.org/person/65986"}}, {tmdbId:"24047", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"0005524", born:date('1960-03-12'), name:"Courtney B. Vance", bio:"Courtney B.  Vance (born March 12, 1960) is an American actor.  He was formerly a regular on Law & Order: Criminal Intent, FlashForward, and The Closer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q4oCmhqEPXKSRK2hTZzTz2Zt4Ba.jpg", url:"https://themoviedb.org/person/24047"}}, {tmdbId:"1190701", properties:{imdbId:"0267586", name:"Linda Faye Farkas", url:"https://themoviedb.org/person/1190701"}}, {tmdbId:"52419", properties:{bornIn:"New York City, New York, USA ", imdbId:"0357979", born:date('1969-06-09'), name:"Josh Hamilton", bio:"Josh C.  Hamilton (born June 9, 1969) is an American actor. \n\nHamilton was born in New York City, New York.  His father is actor Dan Hamilton, and his stepmother is actress Stephanie Braxton.  His Broadway credits include Proof and The Coast of Utopia (2007, Lincoln Center)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1TdB6DTRkFJgurWeXtJIOHtMOw7.jpg", url:"https://themoviedb.org/person/52419"}}, {tmdbId:"7039", properties:{bornIn:"Montrea - Quebec - Canada", imdbId:"0708873", born:date('1966-12-31'), name:"Bruce Ramsay", bio:"Bruce Ramsay was born on December 31, 1966 in Montreal, Canada.  He is an actor and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1ohZWBLAplxZRKfJBRWGYfDGk5u.jpg", url:"https://themoviedb.org/person/7039"}}, {tmdbId:"45396", properties:{bornIn:"Kingston, New York, USA", imdbId:"0664061", born:date('1968-02-26'), name:"Ross Partridge", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1M6OsklnlOT4MFrMjq1k8QCBq3c.jpg", url:"https://themoviedb.org/person/45396"}}, {tmdbId:"16578", properties:{bornIn:"Singapore", imdbId:"0630100", born:date('1958-09-11'), name:"Julia Nickson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lLtwvseiNe9pIjhC293nPmyRAET.jpg", url:"https://themoviedb.org/person/16578"}}, {tmdbId:"22072", properties:{bornIn:"Winter Park, Florida, USA", imdbId:"0806080", born:date('1970-10-12'), name:"Lala Sloatman", bio:"​From Wikipedia, the free encyclopedia. \n\nLala Cassandra Sloatman (born October 12, 1970) is an American model, actress and costumer.  Her uncle was musician Frank Zappa; her cousins are Ahmet, Diva, Moon and Dweezil Zappa.  She is frequently billed by her first name only, and sometimes as Lala Zappa...", url:"https://themoviedb.org/person/22072"}}, {tmdbId:"12929", properties:{bornIn:"Commack, Long Island, New York, USA", imdbId:"0005280", born:date('1962-03-21'), name:"Rosie O'Donnell", bio:"​From Wikipedia, the free encyclopedia.   \n\nRoseann \"Rosie\" O'Donnell (born March 21, 1962) is an American stand-up comedienne, actress, singer, lesbian, author and media personality.  She has also been a magazine editor and continues to be a celebrity blogger, LGBT rights activist, television producer and collaborative partner in the LGBT family vacation company R Family Vacations...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bfeIiPngsbLU7zK8sS18l3Pz3KR.jpg", url:"https://themoviedb.org/person/12929"}}, {tmdbId:"1117", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0001199", born:date('1944-02-29'), name:"Dennis Farina", bio:"​Dennis Farina was one of Hollywood's busiest actors and a familiar face  to moviegoers and television viewers alike.  Recently, he appeared in the  feature films, \"The Grand,\" a comedy about a Vegas poker tournament  with Woody Harrelson, Cheryl Hines and Ray Romano; \"Bottle Shock,\" also  starring Alan Rickman, Bill Pullman and Bradley Whitford; and Fox's  \"What Happens in Vegas,\" in which Dennis starred as Cameron Diaz's boss...", died:date('2013-07-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4hEWe0ZcDpGlB3nRizLkVMcG13B.jpg", url:"https://themoviedb.org/person/1117"}}, {tmdbId:"6368", properties:{bornIn:"Lafayette, Indiana, USA", imdbId:"0001110", born:date('1965-08-11'), name:"Embeth Davidtz", bio:"Embeth Jean Davidtz (born August 11, 1965) is an American-born South African actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3Z8Kx4AVXteLdUJ5IGXbJlPLTyW.jpg", url:"https://themoviedb.org/person/6368"}}, {tmdbId:"11763", properties:{bornIn:"United Kingdom", imdbId:"0317956", born:date('1958-07-29'), name:"Marcus Gilbert", bio:"From Wikipedia, the free encyclopedia. \n\nMarcus Gilbert (born 29 July 1958) is a British actor, known for his roles in Jilly Cooper's Riders and Army of Darkness (Evil Dead 3). \n\nSince 1984 he has appeared in films, including A Hazard of Hearts (1987), A Ghost in Monte Carlo (1990), Biggles (1986), Rambo III (1988) and Legacy (1990), and on television and in commercials...", url:"https://themoviedb.org/person/11763"}}, {tmdbId:"15887", properties:{bornIn:"Epsom - Surrey - England - UK", imdbId:"0000566", born:date('1965-01-04'), name:"Julia Ormond", bio:"​From Wikipedia, the free encyclopedia. \n\nJulia Karin Ormond  (born 4 January 1965 height 5' 7½\" (1,71 m)) is an English actress who has appeared in film and television and on stage...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/u7Oz6nHfMSlXuT34K7Ffp4f2qgP.jpg", url:"https://themoviedb.org/person/15887"}}] AS row
