UNWIND [{movieId:"44633", properties:{languages:["English"], year:2005, imdbId:"0436231", runtime:110, imdbRating:8.0, countries:["USA"], imdbVotes:7075, title:"Devil and Daniel Johnston, The", url:"https://themoviedb.org/movie/13222", tmdbId:"13222", plot:"Daniel Johnston, manic-depressive genius singer/songwriter/artist is revealed in this portrait of madness, creativity and love.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7c5FUlodgZl52tMlpw2G64kqttt.jpg", released:"2006-05-05"}}, {movieId:"44665", properties:{languages:["English"], year:2006, imdbId:"0425210", runtime:110, imdbRating:7.8, countries:["Germany", " USA"], imdbVotes:256407, title:"Lucky Number Slevin", url:"https://themoviedb.org/movie/186", revenue:56308881, tmdbId:"186", plot:"A case of mistaken identity lands Slevin into the middle of a war being plotted by two of the city's most rival crime bosses: The Rabbi and The Boss. Slevin is under constant surveillance by relentless Detective Brikowski as well as the infamous assassin Goodkat and finds himself having to hatch his own ingenious plot to get them before they get him.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x21s3p5wPww534nYj1cWakTcqz4.jpg", released:"2006-04-07", budget:27000000}}, {movieId:"44671", properties:{languages:["English"], year:2005, imdbId:"0443693", runtime:80, imdbRating:6.3, countries:["Germany", " France", " Austria", " UK"], imdbVotes:2700, title:"Wild Blue Yonder, The", url:"https://themoviedb.org/movie/8410", tmdbId:"8410", plot:"An alien narrates the story of his dying planet, his and his people's visits to Earth and Earth's man-made demise, while human astronauts attempt to find an alternate planet for surviving humans to live on.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iEs4KhPaQ0F514PscPJDtp0YclB.jpg", released:"2007-06-15"}}, {movieId:"44694", properties:{languages:["Spanish"], year:2006, imdbId:"0441909", runtime:121, imdbRating:7.6, countries:["Spain"], imdbVotes:74845, title:"Volver", url:"https://themoviedb.org/movie/219", revenue:85582407, tmdbId:"219", plot:"After her death, a mother returns to her home town in order to fix the situations she couldn't resolve during her life.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ljRPzuI1xybiFUGU1uCRdx68h0K.jpg", released:"2007-01-26", budget:12899867}}, {movieId:"44709", properties:{languages:["English"], year:2006, imdbId:"0437800", runtime:112, imdbRating:7.5, countries:["USA"], imdbVotes:14882, title:"Akeelah and the Bee", url:"https://themoviedb.org/movie/13751", revenue:18948425, tmdbId:"13751", plot:"A young girl from South Los Angeles tries to make it to the National Spelling Bee.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ApX6H8tZLGk0HSl44loULBpgNAe.jpg", released:"2006-04-28", budget:8000000}}, {movieId:"44717", properties:{languages:["Portuguese"], year:2003, imdbId:"0367975", runtime:106, imdbRating:7.5, countries:["Brazil"], imdbVotes:3238, title:"Lisbela e o Prisioneiro (Lisbela and the Prisoner)", url:"https://themoviedb.org/movie/52345", tmdbId:"52345", plot:"Lisbela is a young woman who loves going to the movies. Leléu is a con man, going from town to town selling all sort of things and performing as master of ceremonies for some cheesy numbers...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cZoykE7XMqPBdZBfM6ncSVMT8Wh.jpg", released:"2003-08-22"}}, {movieId:"44731", properties:{languages:["English"], year:2006, imdbId:"0441796", runtime:85, imdbRating:5.0, countries:["USA"], imdbVotes:25359, title:"Stay Alive", url:"https://themoviedb.org/movie/10069", revenue:27105095, tmdbId:"10069", plot:"For a group of teens, the answer to the mysterious death of their old friend lies within the world of an online video game based on the true story of an ancient noblewoman known as the Blood Countess.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hsSJwroE7jugEROB8tmyxJP91Ho.jpg", released:"2006-03-24", budget:9000000}}, {movieId:"44759", properties:{languages:["English"], year:2006, imdbId:"0430912", runtime:114, imdbRating:4.2, countries:["UK", " Germany", " Spain", " USA"], imdbVotes:30306, title:"Basic Instinct 2", url:"https://themoviedb.org/movie/3093", revenue:38629478, tmdbId:"3093", plot:"Novelist Catherine Tramell is once again in trouble with the law, and Scotland Yard appoints psychiatrist Dr. Michael Glass to evaluate her. Though, like Detective Nick Curran before him, Glass is entranced by Tramell and lured into a seductive game.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fT3ZTU2K3I9WkrqnQWH68ClByyi.jpg", released:"2006-03-31", budget:70000000}}, {movieId:"44761", properties:{languages:["English"], year:2005, imdbId:"0393109", runtime:110, imdbRating:7.4, countries:["USA"], imdbVotes:82944, title:"Brick", url:"https://themoviedb.org/movie/9270", revenue:3919254, tmdbId:"9270", plot:"A teenage loner pushes his way into the underworld of a high school crime ring to investigate the disappearance of his ex-girlfriend.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/84WBi81WfVTYKdk5K1C4Ci3SR7n.jpg", released:"2006-04-14", budget:475000}}, {movieId:"44788", properties:{languages:["English"], year:2006, imdbId:"0493459", runtime:98, imdbRating:7.5, countries:["UK", " USA"], imdbVotes:24790, title:"This Film Is Not Yet Rated", url:"https://themoviedb.org/movie/16070", revenue:302179, tmdbId:"16070", plot:"Kirby Dick's exposé about the American movie ratings board.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kO1k2Wg7ybuRvcXZPZvvwqAJrK6.jpg", released:"2006-09-01"}}, {movieId:"44828", properties:{languages:["English"], year:2006, imdbId:"0439815", runtime:95, imdbRating:6.5, countries:["Canada", " USA"], imdbVotes:59935, title:"Slither", url:"https://themoviedb.org/movie/9035", revenue:12834936, tmdbId:"9035", plot:"A small town is taken over by an alien plague, turning residents into zombies and all forms of mutant monsters.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zNlJvCY3Pz7SE09Lf4G7uPs5XFZ.jpg", released:"2006-03-31", budget:15000000}}, {movieId:"44840", properties:{languages:["English", " Spanish"], year:2006, imdbId:"0437863", runtime:80, imdbRating:5.6, countries:["USA"], imdbVotes:39493, title:"Benchwarmers, The", url:"https://themoviedb.org/movie/9957", tmdbId:"9957", plot:"A trio of guys try and make up for missed opportunities in childhood by forming a three-player baseball team to compete against standard children baseball squads.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5yMPCr4qhuNg6fT538xicHaMaG7.jpg", released:"2006-04-07"}}, {movieId:"44849", properties:{languages:["English", " French"], year:2006, imdbId:"0386741", runtime:105, imdbRating:6.7, countries:["France", " UK", " Luxembourg"], imdbVotes:14173, title:"Renaissance", url:"https://themoviedb.org/movie/9389", revenue:1831348, tmdbId:"9389", plot:"In 2054, Paris is a labyrinth where all movement is monitored and recorded. Casting a shadow over everything is the city's largest company, Avalon, which insinuates itself into every aspect of contemporary life to sell its primary export -- youth and beauty. In this world of stark contrasts and rigid laws the populace is kept in line and accounted for.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l7oWoc9vkGwVoYZQUEgblpq1PBG.jpg", released:"2006-03-15", budget:18000000}}, {movieId:"44864", properties:{languages:["English"], year:2006, imdbId:"0436331", runtime:88, imdbRating:5.9, countries:["USA"], imdbVotes:19303, title:"Friends with Money", url:"https://themoviedb.org/movie/8998", revenue:13368437, tmdbId:"8998", plot:"After she quits her lucrative job, Olivia finds herself unsure about her future and her relationships with her successful and wealthy friends.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/138DFtHjGQcDK4vQavLJ51xEBjZ.jpg", released:"2006-04-21", budget:6500000}}, {movieId:"44911", properties:{languages:["English"], year:1978, imdbId:"0077889", runti