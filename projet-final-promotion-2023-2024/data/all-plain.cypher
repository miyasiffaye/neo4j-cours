UNWIND [{tmdbId:"1485423", properties:{imdbId:"2317980", name:"Maggie McCollester", url:"https://themoviedb.org/person/1485423"}}, {tmdbId:"521564", properties:{bornIn:"Sacramento, California, U.S.", imdbId:"2981935", born:date('1984-03-02'), name:"Blake Anderson", bio:"Blake Raymond Anderson (born March 2, 1984) is an American actor, comedian, producer, screenwriter, and fashion designer.  He is best known for starring in and co-creating the Comedy Central series Workaholics...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6CAisTFUOPulSKZvDSSptZ6D299.jpg", url:"https://themoviedb.org/person/521564"}}, {tmdbId:"86626", properties:{bornIn:" Columbia, South Carolina, USA", imdbId:"2106637", born:date('1983-02-23'), name:"Aziz Ansari", bio:"Aziz Ansari (born February 23, 1983) is an American actor, writer, and stand-up comedian.  He formerly starred as Tom Haverford on the NBC show Parks and Recreation, and has since gone on to co-create, co-produce, and star in two seasons of the critically acclaimed comedy/drama Netflix series, Master of None...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yUeQHM4ycUXrUgRWgKVYKNmKxfJ.jpg", url:"https://themoviedb.org/person/86626"}}, {tmdbId:"1273228", properties:{imdbId:"3535974", name:"Allison Bills", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eO9mzjd5ragRdDTvV2h4KfWsdHT.jpg", url:"https://themoviedb.org/person/1273228"}}, {tmdbId:"964851", properties:{imdbId:"0175828", born:date('1970-09-17'), name:"Jim Conroy", url:"https://themoviedb.org/person/964851"}}, {tmdbId:"82885", properties:{bornIn:"New York City, New York, USA", imdbId:"1830380", born:date('1982-09-01'), name:"Zoe Lister-Jones", bio:"Zoe Lister-Jones (born September 1, 1982) is an American actress, producer, director and writer.  She graduated with honors from the Tisch School of the Arts of New York University...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ulLtTm8iVrSLU3o1oD6jqC1QEyI.jpg", url:"https://themoviedb.org/person/82885"}}, {tmdbId:"82886", properties:{bornIn:"Montevideo, Uruguay", imdbId:"2273984", name:"Francis Benhamou", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uoSgC79VIzkUrLS6FEKLbR6N9jK.jpg", url:"https://themoviedb.org/person/82886"}}, {tmdbId:"1226358", properties:{bornIn:"Cleveland, Ohio, USA", imdbId:"0509347", born:date('1956-03-01'), name:"Mimi Lieber", bio:"Mimi Lieber is an American stage and screen actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8Rf7hwUcFsb1anRNtuqJIqo5ra6.jpg", url:"https://themoviedb.org/person/1226358"}}, {tmdbId:"86637", properties:{bornIn:"Moscow, USSR [now Russia]", imdbId:"0541136", born:date('1951-04-14'), name:"Pyotr Mamonov", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/axYOHeR3gTeDheDfJ7w8A9m1LSp.jpg", url:"https://themoviedb.org/person/86637"}}, {tmdbId:"224079", properties:{bornIn:"Astrakhan, USSR (Russia)", imdbId:"1282927", born:date('1978-07-09'), name:"Dmitriy Dyuzhev", bio:"Dmitri Petrovich Dyuzhev (Russian: Дми́трий Петро́вич Дю́жев) is a Russian film and stage actor, singer. \n\nDmitri was born to actor Peter Dyuzhev and Ludmila Dyuzheva and attended the Moscow Philharmonic School (GITIS) to study acting and directing.    Prior to his film debut in “24 Hours” by Alexander Atanesyan in 2000, Dmitri performed in theatrical plays.   His first major success came in 2005, with his performance as Kosmos in Aleksei Sidorov’s “Brigada”...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ar0CMyQmBwvlr5CbZ3vvfvuWbou.jpg", url:"https://themoviedb.org/person/224079"}}, {tmdbId:"119211", properties:{bornIn:"Abakan, Khakassia, USSR [now Russia]", imdbId:"0476864", born:date('1946-09-03'), name:"Yuriy Kuznetsov", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uVe4ui9XSkg66IzHGd3qbFFDsXn.jpg", url:"https://themoviedb.org/person/119211"}}, {tmdbId:"40329", properties:{bornIn:" Tokyo, Japan", imdbId:"0394653", born:date('1941-08-01'), name:"Katsunosuke Hori", bio:"is a veteran Japanese voice actor, actor, and narrator from the Tokyo Metropolitan area.  He is a member of 81 Produce...", url:"https://themoviedb.org/person/40329"}}, {tmdbId:"206946", properties:{bornIn:"Keokuk, Iowa, USA", imdbId:"1965007", born:date('1960-07-20'), name:"Brian Keith Allen", url:"https://themoviedb.org/person/206946"}}, {tmdbId:"557885", properties:{bornIn:"Sparkhill, Birmingham, England", imdbId:"2546181", name:"Moazzam Begg", bio:"From Wikipedia, the free encyclopedia.   Moazzam Begg  (born in 1968 in Sparkhill, Birmingham, England), is a British Pakistani Muslim who was held in extrajudicial detention in the Bagram Theater Internment Facility and the Guantanamo Bay detainment camp, in Cuba, by the U. S.  government for nearly three years...", url:"https://themoviedb.org/person/557885"}}, {tmdbId:"557886", properties:{imdbId:"3254802", name:"Christopher Beiring", url:"https://themoviedb.org/person/557886"}}, {tmdbId:"56288", properties:{bornIn:"France", imdbId:"1574565", born:date('1984-05-29'), name:"Alysson Paradis", bio:"From Wikipedia, the free encyclopedia\n\nAlysson Paradis (born May 29, 1984) is a French actress.  She is the younger sister of French singer and actress Vanessa Paradis, who is 11 years older. \n\nDescription above from the Wikipedia article Alysson Paradis, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/r1If1qg2P9LCTFDincao7MOoVMi.jpg", url:"https://themoviedb.org/person/56288"}}, {tmdbId:"81048", properties:{imdbId:"2602462", name:"Jean-Baptiste Tabourin", url:"https://themoviedb.org/person/81048"}}, {tmdbId:"81049", properties:{imdbId:"1324984", name:"Claude Lulé", url:"https://themoviedb.org/person/81049"}}, {tmdbId:"19165", properties:{bornIn:"Rochefort - France", imdbId:"0296596", born:date('1962-08-23'), name:"Dominique Frot", bio:"Extrait de Wikipedia, l'Encyclopedie libre.  Après une double formation, celle du Conservatoire national d’art dramatique de Paris et celle de l’École normale supérieure de musique de Paris, Dominique Frot a travaillé au théâtre avec Gilles Dao, Luc Bondy, Peter Brook, Francois Verret, Thomas Ostermeier, Claude Régy, Robert Wilson, Serge Valletti, Hubert Colas, Pascal Rambert, Xavier Marchand, Jean-Claude Fall, François Orsoni, Hubert Colas. . ...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hvhM1SX3nMBT2PqGjuGb680Qb0C.jpg", url:"https://themoviedb.org/person/19165"}}, {tmdbId:"82103", properties:{bornIn:"Lebanon", imdbId:"1896736", born:date('1976-07-01'), name:"Haaz Sleiman", bio:"Haaz Sleiman is an American actor originally from Lebanon.  He is known for Eternals (2020)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vhNbQ8BTP6wK2jArwv2bwbuN31t.jpg", url:"https://themoviedb.org/person/82103"}}] AS row
