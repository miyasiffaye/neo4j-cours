UNWIND [{tmdbId:"75655", properties:{bornIn:"Sydney, New South Wales, Australia", imdbId:"0227317", born:date('1973-12-28'), name:"Alex Dimitriades", bio:"Alex Dimitriades is an Australian actor. \n\nHe was born on December 28, 1973 in Sydney, New South Wales, Australia as Alexander Dimitriades.  He is an actor, known for Ghost Ship (2002), Head On (1998) and Deuce Bigalow: European Gigolo (2005). \n\nHis parents are first generation immigrants to Australia from Greece.  They divorced when he was 12. \n\nHe has a brother, George, and a sister, Melissa. \n\nHis former partner is Australian shoe designer Terry Biviano...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6UjPOv2G4hLDwmWPSpwB0wv1Byu.jpg", url:"https://themoviedb.org/person/75655"}}, {tmdbId:"75657", properties:{bornIn:"Penang, Malaysia", imdbId:"0307724", born:date('1970-10-01'), name:"Julian Garner", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ul8AXiJ0ZDR6eSLbxo56xwmMNlW.jpg", url:"https://themoviedb.org/person/75657"}}, {tmdbId:"75658", properties:{imdbId:"0541605", name:"Elena Mandalis", bio:"Elena Mandalis is an Australian actress and acting coach best known for her television roles as Sarah Tomic in Raw FM (1997-1998), as Jett in Thunderstone (1999) and as Anna Vargas in Rush, in 2011...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v6sVjdt8NJES247p6uS8NkAFGwu.jpg", url:"https://themoviedb.org/person/75658"}}, {tmdbId:"75659", properties:{bornIn:"Melbourne - Australia", imdbId:"0631815", name:"Tony Nikolakopoulos", bio:"Tony Nikolakopoulos is a Greek Australian film, television and theatre actor.  He is best known for his work in the films of Nick Giannopoulos, The Wog Boy and The Wannabes, and for his role as Attilio in the television series Scooter: Secret Agent.  He has also performed in stage plays, including Cafe Rebetika in 2009...", url:"https://themoviedb.org/person/75659"}}, {tmdbId:"13922", properties:{bornIn:"Overbrook Park, West Philadelphia, Pennsylvania, U.S.", imdbId:"0001293", born:date('1974-02-08'), name:"Seth Green", bio:"Seth Benjamin Gesshel-Green (born February 8, 1974) is an American actor, comedian, voice actor, and television producer.  He is well known for his role as Daniel \"Oz\" Osbourne in Buffy the Vampire Slayer, as well as Dr.  Evil's son Scott in the Austin Powers series of comedy films and Mitch Miller in That '70s Show...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l4No5Eu6j0U80hCIkaSn17AOWrj.jpg", url:"https://themoviedb.org/person/13922"}}, {tmdbId:"5726", properties:{bornIn:"Missouri, USA", imdbId:"0147825", born:date('1964-04-24'), name:"Cedric the Entertainer", bio:"​From Wikipedia, the free encyclopedia.   \n\nCedric Antonio Kyles (born April 24, 1964), known professionally by his stage name Cedric the Entertainer, is an American actor and comedian.  He is perhaps best known as the co-star of the WB sitcom The Steve Harvey Show, as Eddie in the Barbershop films, and as one of the four comedians featured in the Spike Lee film The Original Kings of Comedy...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/btvh5FwNnknReftDdclHYZzkAlr.jpg", url:"https://themoviedb.org/person/5726"}}, {tmdbId:"92563", properties:{bornIn:"Aberdeen, Washington, USA", imdbId:"0001052", born:date('1967-02-20'), name:"Kurt Cobain", bio:"Kurt Donald Cobain (February 20, 1967 – c.  April 5, 1994) was an American singer-songwriter, musician and artist, best known as the lead singer and guitarist of the grunge band Nirvana. \n\nCobain formed Nirvana with Krist Novoselic in Aberdeen, Washington, in 1985 and established it as part of the Seattle music scene, having its debut album Bleach released on the independent record label Sub Pop in 1989...", died:date('1994-04-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mN6W5c1C7Wkd0UwmaYGn9eNlz9g.jpg", url:"https://themoviedb.org/person/92563"}}, {tmdbId:"2396611", properties:{bornIn:"Morrow, Ohio, USA", imdbId:"0247338", born:date('1889-05-13'), name:"Mari Earle", died:date('1984-11-04'), url:"https://themoviedb.org/person/2396611"}}, {tmdbId:"20879", properties:{bornIn:"Geneva, Switzerland", imdbId:"0123632", born:date('1957-09-10'), name:"Kate Burton", bio:"Kate Burton is a Swiss-born Welsh-American stage and screen actress.  She holds an BA in Russian Studies and European History from Brown University, Providence, Rhode Island, and an MFA from the Yale School of Drama, New Haven, Connecticut...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nG9uRBRM28meBweFOeA3adCntpf.jpg", url:"https://themoviedb.org/person/20879"}}, {tmdbId:"58682", properties:{bornIn:"San Diego, California, USA", imdbId:"0549436", born:date('1974-03-12'), name:"Heidi Marnhout", url:"https://themoviedb.org/person/58682"}}, {tmdbId:"6432", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0347797", born:date('1968-06-04'), name:"Sean Gullette", bio:"From Wikipedia, the free encyclopedia. \n\nSean Gullette (born June 4, 1968 in Boston, Massachusetts) is a writer, actor, and filmmaker...", url:"https://themoviedb.org/person/6432"}}, {tmdbId:"1173", properties:{bornIn:"Philadelphia, Pennsylvania, USA ", imdbId:"0546797", born:date('1939-11-26'), name:"Mark Margolis", bio:"Mark Margolis (born 26 November 1939) is an American actor, who has been making films since 1976. \n\nMargolis went to Temple University briefly before moving to New York City, where he studied drama with Stella Adler and at the Actors Studio.  He is perhaps most famous for his supporting roles in Scarface and the films of Darren Aronofsky: π, Requiem for a Dream, The Fountain, The Wrestler, and Black Swan.  Aronofsky wrote the role of Father Avila in The Fountain specifically for Margolis...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rT5TYJIPLBkTqsrUs00AixGeaMM.jpg", url:"https://themoviedb.org/person/1173"}}, {tmdbId:"6437", properties:{bornIn:"New York City, New York, USA", imdbId:"0791570", born:date('1968-09-26'), name:"Ben Shenkman", bio:"From Wikipedia, the free encyclopedia. \n\nBenjamin Shenkman (born September 26, 1968) is an American television, film and stage actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/b2sRG2IGuB6HrMydTGtSuUmTQpV.jpg", url:"https://themoviedb.org/person/6437"}}, {tmdbId:"177560", properties:{imdbId:"0366466", name:"Pamela Hart", url:"https://themoviedb.org/person/177560"}}, {tmdbId:"35054", properties:{imdbId:"0629062", name:"Ngoc Hiep Nguyen", url:"https://themoviedb.org/person/35054"}}, {tmdbId:"1396573", properties:{imdbId:"0905872", name:"Elisabeth Wagner", url:"https://themoviedb.org/person/1396573"}}, {tmdbId:"1371374", properties:{imdbId:"0035207", name:"Richard Arlook", url:"https://themoviedb.org/person/1371374"}}, {tmdbId:"11826", properties:{bornIn:"Southfield, Michigan, USA", imdbId:"0004757", born:date('1972-06-23'), name:"Selma Blair", bio:"​Blair was born Selma Blair Beitner in Southfield, Michigan, the daughter of Molly Ann, a judge, and Elliot Beitner.  She has three older sisters, Katherine (a book publicist), Elizabeth, and Marie.  Blair attended Hillel Day School, a Jewish day school in Farmington Hills, Michigan, and Cranbrook Kingswood school in Bloomfield Hills, Michigan.  She attended Kalamazoo College in Michigan, then later transferred to the University of Michigan, where she earned her bachelor's degree in 1994...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9OL2Epi86U97HcVz85IAscvwjQL.jpg", url:"https://themoviedb.org/person/11826"}}, {tmdbId:"19307", properties:{bornIn:"Brooklyn, New York City, New York, USA", imdbId:"0006816", born:date('1966-07-08'), name:"Suzanne Krull", bio:"Suzanne Krull (July 8, 1966 - July 27, 2013) was an American actress...", died:date('2013-07-27'), url:"https://themoviedb.org/person/19307"}}, {tmdbId:"59284", properties:{bornIn:"London, England", imdbId:"0004718", born:date('1972-12-17'), name:"Desmond Askew", bio:"Desmond Askew (born 17 December 1972) is an English actor of film and television.  In 1983 he had the lead role of 'naughty schoolboy' in the promo video of the Wham single Bad Boys. He has appeared in films such as Go (1999), Repli-Kate (2002), The Hills Have Eyes (2006) and Turistas (2006).  He has appeared in episodic television on series such as Grange Hill, Las Vegas, Charmed, the short-lived Then Came You, and as the recurring character Brody Davis on Roswell...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wDfB8U1fvLWP9ccqQhMLxBEFNlF.jpg", url:"https://themoviedb.org/person/59284"}}] AS row
