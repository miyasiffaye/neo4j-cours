UNWIND [{tmdbId:"16452", properties:{imdbId:"0801231", name:"Taylor Simpson", url:"https://themoviedb.org/person/16452"}}, {tmdbId:"16453", properties:{imdbId:"1102991", name:"Gabrielle Witcher", url:"https://themoviedb.org/person/16453"}}, {tmdbId:"17140", properties:{bornIn:"New York City, New York, USA", imdbId:"1113550", born:date('1996-04-14'), name:"Abigail Breslin", bio:"Abigail Kathleen Breslin (born April 14, 1996) is an American teen actress.  She is one of the youngest actresses ever to be nominated for an Academy Award. \n\nBreslin appeared in her first commercial when she was only three years old, and in her first movie, Signs, at the age of five.  Her subsequent films include Little Miss Sunshine, Nim's Island, Definitely, Maybe, My Sister's Keeper, Zombieland and Rango...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oOFCyH2uS6639w0XVR6DtimfNYb.jpg", url:"https://themoviedb.org/person/17140"}}, {tmdbId:"70437", properties:{bornIn:"Xiamen, Fujian Province, China", imdbId:"0628806", born:date('1952-01-02'), name:"Man Tat Ng", bio:"Ng Man Tat (born 2 January 1952) is a veteran actor in the Hong Kong film industry, with dozens of titles under his belt.  Ng has worked with famous actor and director Stephen Chow in a series of \"mo lei tau\" movies (\"mo lei tau\" translates to \"brainless\"/\"senseless or random,\" and it is a genre of slapstick comedy unique to Hong Kong)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9kemdd6ubjuOC0DMPqLedbuQQlo.jpg", url:"https://themoviedb.org/person/70437"}}, {tmdbId:"1554266", properties:{imdbId:"0506902", name:"Alex Lewis", url:"https://themoviedb.org/person/1554266"}}, {tmdbId:"78117", properties:{bornIn:" San Francisco, California, USA", imdbId:"0235004", born:date('1969-07-19'), name:"Cullen Douglas", bio:"From Wikipedia, the free encyclopedia\n\nCullen Douglas (born July 19, 1969) is an American film and television actor. He is best known for his television guest appearances on shows such as Prison Break, Kenan & Kel, CSI, Private Practice, and, most notably, as Mr.  Arnold, \"The Birdman,\" on Grey's Anatomy.  His film appearances include Sunshine State, Love Liza, and the Ace Ventura Jr. , which was scheduled to be released in September 2008, but was delayed to January 2009...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kvLrnUvvSvEqe71GJaknrNvqIGc.jpg", url:"https://themoviedb.org/person/78117"}}, {tmdbId:"58416", properties:{imdbId:"1569242", name:"Béatrice Bonifassi", bio:"From Wikipedia, the free encyclopedia. \n\nBéatrice \"Betty\" Bonifassi (born c.  1971) is a French-born vocalist based out of Montreal, Quebec, Canada.  She has a deep, contralto singing voice, sometimes referred to as \"masculine\", which has been compared to that of Shirley Bassey.  Bonifassi has performed music of many styles in both English and French—from jazz, to traditional music, to blues, to electronica...", url:"https://themoviedb.org/person/58416"}}, {tmdbId:"58417", properties:{imdbId:"1569293", name:"Lina Boudreau", url:"https://themoviedb.org/person/58417"}}, {tmdbId:"58418", properties:{imdbId:"1379544", name:"Michèle Caucheteux", url:"https://themoviedb.org/person/58418"}}, {tmdbId:"58419", properties:{imdbId:"0232357", born:date('1949-02-16'), name:"Jean-Claude Donda", url:"https://themoviedb.org/person/58419"}}, {tmdbId:"72306", properties:{imdbId:"0307498", name:"Alison Garland", url:"https://themoviedb.org/person/72306"}}, {tmdbId:"109390", properties:{bornIn:"Plumstead, London, England, UK", imdbId:"0014713", born:date('1920-06-08'), name:"Jean Ainslie", died:date('2001-10-26'), url:"https://themoviedb.org/person/109390"}}, {tmdbId:"42644", properties:{imdbId:"0882732", name:"Badi Uzzaman", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/U9oqmB7eajyNa13OyKnZmgPmDa.jpg", url:"https://themoviedb.org/person/42644"}}, {tmdbId:"231610", properties:{bornIn:"Leicester, England, UK", imdbId:"0619406", born:date('1975-10-05'), name:"Parminder Nagra", bio:"Parminder Kaur Nagra (born October 5, 1975) is an English actress of Indian descent.  She came to international prominence through Bend It Like Beckham.  She starred on ER for six years...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ix2VHqddGPtPBQi2QODbLsDwdVj.jpg", url:"https://themoviedb.org/person/231610"}}, {tmdbId:"116", properties:{bornIn:"Teddington, London, England, UK", imdbId:"0461136", born:date('1985-03-26'), name:"Keira Knightley", bio:"Keira Christina Knightley OBE, is an English actress and model.  She began acting as a child and came to international prominence in 2002 after co-starring in the films Bend It Like Beckham and Pirates of the Caribbean: The Curse of the Black Pearl...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bRC1B2VwV0wK3ElciFAK6QZf2wD.jpg", url:"https://themoviedb.org/person/116"}}, {tmdbId:"6217", properties:{bornIn:"Shimla, Himachal Pradesh, India", imdbId:"0451600", born:date('1955-03-07'), name:"Anupam Kher", bio:"Anupam Kher is an Indian stage, film and television actor and producer who has appeared in nearly 400 films and 100 plays...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/62IEjVcbXTzgM29lP2vDSPfeHae.jpg", url:"https://themoviedb.org/person/6217"}}, {tmdbId:"25246", properties:{bornIn:"Tai Po, Hong Kong, China", imdbId:"0490489", born:date('1961-09-27'), name:"Andy Lau", bio:"Andy Lau Tak-wah (born 27 September 1961) is a Hong Kong Cantopop singer, actor, presenter, and film producer.  Lau has been one of Hong Kong's most commercially successful film actors since the mid-1980s, performing in more than 160 films while maintaining a successful singing career at the same time. \n\nFor his contributions, a wax figure of Lau was unveiled on 1 June 2005 at the Madame Tussauds Hong Kong...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3bs0J3KwnAIocT1RxlT9akltcEt.jpg", url:"https://themoviedb.org/person/25246"}}, {tmdbId:"58050", properties:{bornIn:"Saitama, Saitama Prefecture, Japan", imdbId:"0815043", born:date('1973-12-19'), name:"Takashi Sorimachi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iuhsVaQUiWB3ZbQP9M4DS33c55D.jpg", url:"https://themoviedb.org/person/58050"}}, {tmdbId:"20519", properties:{bornIn:"Hong Kong, British Crown Colony [now China]", imdbId:"0945189", born:date('1955-03-19'), name:"Simon Yam", bio:"Simon Yam Tat-Wah, born March 19, 1955, is a Hong Kong actor and film producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fiSWkSTy8gKMkLCWN1iWHpcdgOj.jpg", url:"https://themoviedb.org/person/20519"}}, {tmdbId:"52575", properties:{bornIn:"Taiwan", imdbId:"0510914", born:date('1975-10-29'), name:"Kelly Lin", bio:"Kelly Lin Hsi-Lei (Chinese: 林熙蕾; pinyin: Lín Xīlěi, born 29 October 1975) is a Taiwanese actress and model who has appeared mainly in Hong Kong films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tHOFnyjr9TnrWV3dbmr5p7VIIE3.jpg", url:"https://themoviedb.org/person/52575"}}] AS row
