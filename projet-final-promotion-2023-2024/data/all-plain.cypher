UNWIND [{tmdbId:"586731", properties:{bornIn:"Île-de-France, France", imdbId:"0629195", born:date('1966-08-23'), name:"Adama Niane", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/r1mvrT2AXJwUFPBEzGPs1O1UdB7.jpg", url:"https://themoviedb.org/person/586731"}}, {tmdbId:"478", properties:{bornIn:"Billingham, Stockton on Tees, England, UK", imdbId:"0068260", born:date('1986-03-14'), name:"Jamie Bell", bio:"Jamie Bell (born Andrew James Matfin Bell; 14 March 1986) is an English actor.  He is best known for playing the title character in the film Billy Elliot (2000), for which he won the 2001 BAFTA Award for Best Actor.  Since then he has played a mix of leading roles in small independent films and supporting roles in big budget films such as Peter Jackson's version of King Kong. \n\nDescription above from the Wikipedia article Jamie Bell, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4Yfk2bwMbTBj0sJoLRi3fM3OCOz.jpg", url:"https://themoviedb.org/person/478"}}, {tmdbId:"481", properties:{bornIn:"Northumberand, England, UK", imdbId:"0382402", born:date('1921-07-15'), name:"Jean Heywood", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l788luv0jWEivj4d7KY1e3K7TVW.jpg", url:"https://themoviedb.org/person/481"}}, {tmdbId:"479", properties:{bornIn:"Wythenshawe, Manchester, Lancashire, England", imdbId:"0237237", born:date('1979-05-14'), name:"Jamie Draven", bio:"From Wikipedia, the free encyclopedia\n\nJamie Draven (born Jamie Donnelly on 14 May 1979) is an English actor whose career in films and television began in 1998.  One of his early notable parts was as Billy's elder brother, Tony, in the hit 2000 film Billy Elliot and as Jamie Dow in Ultimate Force. \n\nA native of the southern Manchester district of Wythenshawe, he is the youngest of three brothers (his mother is Kath and her other sons are John and Jason)...", url:"https://themoviedb.org/person/479"}}, {tmdbId:"69502", properties:{imdbId:"0489570", name:"James Lashly", url:"https://themoviedb.org/person/69502"}}, {tmdbId:"69503", properties:{bornIn:"U.S.A", imdbId:"0863473", born:date('1960-06-30'), name:"Rebecca Tilney", url:"https://themoviedb.org/person/69503"}}, {tmdbId:"69504", properties:{bornIn:"Aberdeen, South Dakota, USA", imdbId:"0600717", born:date('1947-08-28'), name:"Debra Mooney", bio:"Debra Mooney (born August 28, 1947) is an American actress known for her role as Edna Harper on Everwood...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4je0xiNyZwJZlDDupiHTjhzqVrB.jpg", url:"https://themoviedb.org/person/69504"}}, {tmdbId:"117087", properties:{bornIn:"New Haven - Connecticut - USA", imdbId:"0837942", born:date('1970-09-10'), name:"Larry Sullivan", bio:"​From Wikipedia, the free encyclopedia. \n\nLawrence Edward \"Larry\" Sullivan, Jr.  (born September 10, 1970) is an American actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oNYTlrHyNEF9Ls2BnwQ0cKSWpUJ.jpg", url:"https://themoviedb.org/person/117087"}}, {tmdbId:"10867", properties:{bornIn:"Winnipeg, Manitoba, Canada", imdbId:"0105853", born:date('1976-08-14'), name:"Steve Braun", bio:"Steve Braun (born August 14, 1976) is a Canadian television and movie actor from Winnipeg, Manitoba.  Braun's credits include The Immortal, a TV show in which he and co-star Lorenzo Lamas hunted demons; The Trip, a popular independent film about coming of age in the HIV era; and Harold &amp; Kumar Go to White Castle (2004), a major motion picture release in which he plays the lead villain.  He also played the role of \"Jonsey\" in the 2007 thriller movie Wrong Turn 2: Dead End...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gSUxpCsSpjjTEWbNGCnxGhNKVw7.jpg", url:"https://themoviedb.org/person/10867"}}, {tmdbId:"12889", properties:{bornIn:" Omaha, Nebraska, USA", imdbId:"0048844", born:date('1948-07-09'), name:"Ray Baker", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6DIBcIzCCTMxR1RdMbyItg0J6YW.jpg", url:"https://themoviedb.org/person/12889"}}, {tmdbId:"51551", properties:{bornIn:"New York City, New York USA", imdbId:"0359695", name:"James Handy", bio:"James Handy is an actor...", url:"https://themoviedb.org/person/51551"}}, {tmdbId:"21505", properties:{bornIn:" Washington, District of Columbia, USA", imdbId:"0936298", born:date('1953-09-14'), name:"Robert Wisdom", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5fd8CwnL2YpWyq2G9WooejgnKiX.jpg", url:"https://themoviedb.org/person/21505"}}, {tmdbId:"59257", properties:{bornIn:"Boring, Oregon, USA", imdbId:"0857215", born:date('1975-10-30'), name:"Maria Thayer", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/u2ydRBoqUsTfrjYn4O5H9Wxafaq.jpg", url:"https://themoviedb.org/person/59257"}}, {tmdbId:"87034", properties:{bornIn:"New York City, New York, USA", imdbId:"0117857", born:date('1965-09-22'), name:"Dan Bucatinsky", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5MmGUnWjNeOwcWhndqhQPi7URvv.jpg", url:"https://themoviedb.org/person/87034"}}, {tmdbId:"87035", properties:{bornIn:"Marlton, New Jersey, USA", imdbId:"0748483", born:date('1972-03-02'), name:"Richard Ruccolo", bio:"Richard Ruccolo (born March 2, 1972) is an American television and film actor...", url:"https://themoviedb.org/person/87035"}}, {tmdbId:"64154", properties:{bornIn:" Los Angeles, California, USA", imdbId:"0018734", born:date('1973-05-17'), name:"Sasha Alexander", bio:"From Wikipedia, the free encyclopedia. \n\nSasha Alexander (born May 17, 1973, height 5' 5\" (1,65 m))  is an American actress.  She is known for several roles, including: Gretchen Witter, the sister of Pacey Witter on Dawson's Creek; NCIS Special Agent Kate Todd in the first two seasons of NCIS; as Lucy in Yes Man (2008); and as Catherine in He's Just Not That Into You (2009).  She currently stars as Medical Examiner Maura Isles on the new Turner Network Television series Rizzoli and Isles...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hCeFMvNBEqhq61gEVrCUKma9yPK.jpg", url:"https://themoviedb.org/person/64154"}}, {tmdbId:"19487", properties:{bornIn:"Montebello, California, USA", imdbId:"0379596", born:date('1978-02-20'), name:"Jay Hernandez", bio:"Javier Manuel Hernandez Jr.  is an American actor and fashion model.  After making his television debut in NBC's Hang Time, Hernandez made his film debut opposite Kirsten Dunst in the romantic drama Crazy/Beautiful...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/86mlhxglLYYCac1CWWj4s9uR9U9.jpg", url:"https://themoviedb.org/person/19487"}}, {tmdbId:"67070", properties:{imdbId:"1007810", name:"Herman Osorio", url:"https://themoviedb.org/person/67070"}}, {tmdbId:"7803", properties:{bornIn:"Berlin, Germany", imdbId:"0075321", born:date('1957-10-28'), name:"Christian Berkel", bio:"From Wikipedia, the free encyclopedia. \n\nChristian Berkel (born October 28, 1957) is a German actor. \n\nBerkel was born in Berlin, Germany.  His father was a military doctor. \n\nFrom the age of 14 he lived in Paris where he took drama lessons with Jean-Louis Barrault and Pierre Berlin.  He then trained at the German Film and Television Academy in Berlin and appeared on stage in Augsburg, Düsseldorf, Munich, Vienna and at the Schiller Theatre, Berlin...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/phNI6gPxJuizP0WFsOewpM1nESM.jpg", url:"https://themoviedb.org/person/7803"}}, {tmdbId:"7804", properties:{bornIn:"Kassel, Germany", imdbId:"0831440", born:date('1962-08-08'), name:"Oliver Stokowski", url:"https://themoviedb.org/person/7804"}}] AS row
