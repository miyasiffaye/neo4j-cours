UNWIND [{tmdbId:"70601", properties:{imdbId:"0776601", name:"Colloseo Schulzendorf", url:"https://themoviedb.org/person/70601"}}, {tmdbId:"61289", properties:{imdbId:"0369860", name:"Hal Havins", url:"https://themoviedb.org/person/61289"}}, {tmdbId:"92841", properties:{imdbId:"0057629", born:date('1972-08-31'), name:"Allison Barron", url:"https://themoviedb.org/person/92841"}}, {tmdbId:"92840", properties:{bornIn:"New York City, New York, USA", imdbId:"0018977", name:"Alvin Alexis", url:"https://themoviedb.org/person/92840"}}, {tmdbId:"98527", properties:{imdbId:"0043751", born:date('1916-08-15'), name:"Harold Ayer", died:date('2003-03-06'), url:"https://themoviedb.org/person/98527"}}, {tmdbId:"4687", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0000099", born:date('1968-04-08'), name:"Patricia Arquette", bio:"Patricia Arquette (born April 8, 1968) is an American actress.  She made her feature film debut as Kristen Parker in A Nightmare on Elm Street 3: Dream Warriors (1987).  Her other notable films include True Romance (1993), Ed Wood (1994), Flirting with Disaster (1996), Lost Highway (1997), The Hi-Lo Country (1998), Bringing Out the Dead (1999), Stigmata (1999), Holes (2003), Fast Food Nation (2006), The Wannabe (2015), and Toy Story 4 (2019)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4QhSLWWVtwz3Q13MFPDm2kXzT3W.jpg", url:"https://themoviedb.org/person/4687"}}, {tmdbId:"5139", properties:{bornIn:"Glendale, California, USA", imdbId:"0000387", born:date('1947-06-06'), name:"Robert Englund", bio:"From Wikipedia, the free encyclopedia\n\nRobert Barton Englund (born June 6, 1947) is an American actor and voice-actor, best known for playing the fictional serial killer Freddy Krueger, in the Nightmare on Elm Street film series.  He received a Saturn Award nomination for Best Supporting Actor for A Nightmare on Elm Street 3: Dream Warriors in 1987 and A Nightmare on Elm Street 4: The Dream Master in 1988.  Englund is a classically trained actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h4LEgXsvbfmIbwktkiGWNwwtr8q.jpg", url:"https://themoviedb.org/person/5139"}}, {tmdbId:"11073", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0364973", born:date('1962-08-22'), name:"Lara Harris", bio:"Actress / Performer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xOezRDT2pQDXVBhDASAI9YlPMMu.jpg", url:"https://themoviedb.org/person/11073"}}, {tmdbId:"883", properties:{bornIn:"Charleston, South Carolina, USA", imdbId:"0001599", born:date('1954-06-14'), name:"Will Patton", bio:"William Rankin \"Will\" Patton (born June 14, 1954) is an American actor. \n\nDescription above from the Wikipedia article Will Patton, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qpycaaWP1oUx1Wd2lMBfQtR7qDO.jpg", url:"https://themoviedb.org/person/883"}}, {tmdbId:"92623", properties:{bornIn:"\tLos Angeles, California, United States", imdbId:"0012208", born:date('1966-12-08'), name:"Matt Adler", bio:"Matthew D.  \"Matt\" Adler is an American film actor.  He is best known for his work in the 1980s for his supporting roles in the teenage films: Teen Wolf, White Water Summer, North Shore, and Dream a Little Dream.  He currently works on additional dialogue recording for feature films. \n\nCC Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cxjNjMlGUXTUr6ieIxSsoyGvnU8.jpg", url:"https://themoviedb.org/person/92623"}}, {tmdbId:"29370", properties:{bornIn:"USA", imdbId:"0002129", born:date('1950-05-31'), name:"Gregory Harrison", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jAM849EA6rE8N6Ma6i9Ne9qw8gN.jpg", url:"https://themoviedb.org/person/29370"}}, {tmdbId:"19456", properties:{bornIn:"Hollywood, California, USA", imdbId:"0001604", born:date('1961-12-10'), name:"Nia Peeples", bio:"Virenia Gwendolyn \"Nia\" Peeples (born December 10, 1961) is an American R&B and dance music singer and actress.  Peeples is also famously known as Pam Fields, the mother of Emily Fields on hit TV drama, Pretty Little Liars, as Karen Taylor Winters on The Young and the Restless, and as Sydney Cooke on Walker, Texas Ranger.  Her most recent role is Grace's mom, Susan, on The Fosters...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8jHoDYNA739GXuQ82YjVo2Gdlzz.jpg", url:"https://themoviedb.org/person/19456"}}, {tmdbId:"103011", properties:{imdbId:"0679904", name:"John Philbin", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qROfKLIhfbXwcAgINg1hfH5VpHo.jpg", url:"https://themoviedb.org/person/103011"}}, {tmdbId:"33011", properties:{imdbId:"0958658", born:date('1951-09-24'), name:"Rick Zumwalt", died:date('2003-03-19'), url:"https://themoviedb.org/person/33011"}}, {tmdbId:"68452", properties:{bornIn:"Copenhagen, Denmark", imdbId:"0404817", born:date('1975-08-29'), name:"Pelle Hvenegaard", bio:"Pelle Hvenegaard is a Danish actor and TV writer.   For his role in the Palm d'Or-winning Pelle the Conqueror, he won the European Film Award for Best Young Actor and the Young Artist Award for Best Young Actor in a Foreign Film...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7NUSWF3T1ESvdJHLETREX16xB5J.jpg", url:"https://themoviedb.org/person/68452"}}, {tmdbId:"68454", properties:{imdbId:"0654994", born:date('1933-08-21'), name:"Erik Paaske", bio:"Erik Johannes Paaske, der var søn af cementstøber Frithjof Paaske (død 1982) og hustru Johanne Thomasen (død 1967), gik helt traditionelt i lære som murer i årene 1948-1952.  Derefter arbejdede han i seks år som murersvend på Kolding kanten og ernærede sig desuden som gårdsanger og balmusiker.  Hans hobby var at spille amatørkomedie.  Den kongelige skuespiller Søren Weiss opfordrede ham under et besøg i Kolding til at rejse til København for at blive professionel skuespiller...", died:date('1992-06-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9So1LdRyCBf3NItqF2TwOC5IYuX.jpg", url:"https://themoviedb.org/person/68454"}}, {tmdbId:"55002", properties:{bornIn:"Örgryte, Göteborg och Bohus län, Sweden", imdbId:"0334689", born:date('1946-04-05'), name:"Björn Granath", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x6H9cCe7yModCopeskGdcOKnONX.jpg", url:"https://themoviedb.org/person/55002"}}, {tmdbId:"137182", properties:{bornIn:"Wheaton, Illinois, United States", imdbId:"0259433", born:date('1974-07-08'), name:"Tami Erin", bio:"From Wikipedia, the free encyclopedia.  Tami Erin (born Tamara Erin Klicman on July 8, 1974) is an American actress and model from Wheaton, Illinois.  Erin began acting and modeling at 8 years old after becoming an Elite Model with Elite Model Management, one of the world's leading modeling agencies.  She is best known in over 18 languages as Pippi Longstocking of the Columbia Pictures film The New Adventures of Pippi Longstocking...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bKUwcgKQUbZU3NmySz5dgreIkhh.jpg", url:"https://themoviedb.org/person/137182"}}, {tmdbId:"137183", properties:{imdbId:"0780587", name:"David Seaman", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lsiLoX8yLRjkU3RRXXYu6PrKD2v.jpg", url:"https://themoviedb.org/person/137183"}}, {tmdbId:"137184", properties:{bornIn:"Rockford, Illinois, USA", imdbId:"0189532", born:date('1977-07-29'), name:"Cory Crow", url:"https://themoviedb.org/person/137184"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"27260", properties:{bornIn:" St. Paul, Minnesota, USA", imdbId:"0732309", born:date('1959-03-14'), name:"Laila Robins", bio:"From Wikipedia, the free encyclopedia. \n\nLaila Robins (born March 14, 1959) is an American stage, film and television actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iezRiFJWOFAD7GJDYLrBWirNAEr.jpg", url:"https://themoviedb.org/person/27260"}}, {tmdbId:"1102", properties:{bornIn:"Paracuaro, Michoacan, Mexico", imdbId:"0001990", born:date('1961-04-16'), name:"Elpidia Carrillo", bio:"​From Wikipedia, the free encyclopedia.   \n\nElpidia Carrillo (born August 16, 1961) is a Mexican actress who has appeared in various acclaimed Latin-American films and television shows, in addition to some Hollywood films.  She is also credited as Elpedia Carrillo on some of her films.  Carrillo was born in Parácuaro, Michoacán, Mexico.  Perhaps her best acted role in Hollywood to date has been that of \"Maria\" in the 1986 movie Salvador, where she acted alongside James Woods...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zYVzGHtODIUs83uOlGnNtBMwLwo.jpg", url:"https://themoviedb.org/person/1102"}}, {tmdbId:"658", properties:{bornIn:"London, England, UK", imdbId:"0000547", born:date('1953-05-24'), name:"Alfred Molina", bio:"Alfred Molina (born 24 May 1953) is an English-American actor.  He rose to fame on stage in the West End of London and has also appeared in many roles on Broadway.  He is known for films such as Raiders of the Lost Ark, Spider-Man 2 and An Education...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tnKpbFfBaSMD80O61PlZaZ1DwUv.jpg", url:"https://themoviedb.org/person/658"}}, {tmdbId:"27539", properties:{bornIn:"Fayetteville, Arkansas, U.S.", imdbId:"0089408", born:date('1957-07-01'), name:"Lisa Blount", bio:"Lisa Blount was an American film and television actress and Oscar-winning producer.   Lisa (5' 9\" | 1. 75 m) was born on July 1, 1957 (Cancer) in Fayetteville, Arkansas, USA as Lisa Suzanne Blount.   She has a brother, Greg Blount (who appeared on one episode of American Gladiators (1989) but was injured and unable to participate further).   Lisa Blount's second cousin is conservative filmmaker and inventor Cody G...", died:date('2010-10-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/b4RmlaaiZstrMKooh4GZbTWsdwU.jpg", url:"https://themoviedb.org/person/27539"}}, {tmdbId:"5170", properties:{bornIn:"Flushing, Queens, New York City, New York, USA", imdbId:"0823563", born:date('1950-07-29'), name:"Mike Starr", bio:"An American actor.  Known for his large size at 6' 3\" or 190 cm, he has typically been typecast as playing thugs or henchmen.  Starr was born in Flushing, Queens, New York to a retail employee mother and a meatpacker father.  His older brother Beau Starr is also an actor.  Mike Starr is a graduate of Hofstra University.  He and his family reside in Riverdale, New York...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mv5UWjH3ukiMQuuHuSZCsnZ9cOw.jpg", url:"https://themoviedb.org/person/5170"}}, {tmdbId:"58535", properties:{bornIn:"Brooklyn, New York,  USA", imdbId:"0379200", born:date('1946-03-29'), name:"Paul Herman", bio:"Paul Herman (born March 29, 1946) is an American actor.  Among other roles, he is known for playing Randy in David O.  Russell's dramedy Silver Linings Playbook (2012) and Whispers DiTullio in Martin Scorsese's crime epic The Irishman (2019). \n\nHis other appearances in movies include Once Upon a Time in America, At Close Range, We Own the Night, Heat, Crazy Heart, Sleepers, Cop Land, The Fan, Analyze That, The Day Trippers, and American Hustle...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4UMlDFKuOZ71hNPaSl8e4vVnA9N.jpg", url:"https://themoviedb.org/person/58535"}}, {tmdbId:"1220592", properties:{imdbId:"0661094", born:date('1918-02-22'), name:"Don Pardo", died:date('2014-08-18'), url:"https://themoviedb.org/person/1220592"}}, {tmdbId:"1726165", properties:{name:"Martin Rosenblatt", url:"https://themoviedb.org/person/1726165"}}, {tmdbId:"4039", properties:{bornIn:"Houston, Texas, USA", imdbId:"0934254", born:date('1948-01-21'), name:"Trey Wilson", bio:"From Wikipedia, the free encyclopedia. \n\nDonald Yearnsley \"Trey\" Wilson III (January 21, 1948 – January 16, 1989) was an American character actor known for playing rural, authoritarian type characters, most notably in comedies such as Raising Arizona and Bull Durham...", died:date('1989-01-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uGuMzY9b3oWt2dZ7XdYpAkeaDzC.jpg", url:"https://themoviedb.org/person/4039"}}, {tmdbId:"87003", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"0035664", born:date('1953-11-27'), name:"Curtis Armstrong", bio:"Curtis Armstrong (born November 27, 1953) is an American actor best known for the Revenge of the Nerds movies, Moonlighting, and Ray...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/psCxFYdotzPkLEVxSfLReQ6jql6.jpg", url:"https://themoviedb.org/person/87003"}}, {tmdbId:"2717", properties:{bornIn:"Palo Alto, California, USA", imdbId:"0001685", born:date('1957-08-28'), name:"Rick Rossovich", bio:"An American actor.  His brother, Tim Rossovich, is a former professional football player and also an actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uShNdPWbDHMejpMxuoNsqaaDbuc.jpg", url:"https://themoviedb.org/person/2717"}}, {tmdbId:"65866", properties:{bornIn:"Salford, Greater Manchester, England, UK", imdbId:"0451351", born:date('1961-05-21'), name:"Ayub Khan-Din", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nJc5PgJYvvDI7EW5Xa187i7uiHZ.jpg", url:"https://themoviedb.org/person/65866"}}, {tmdbId:"1226789", properties:{bornIn:"Garland, Texas, USA", imdbId:"0004751", born:date('1961-09-30'), name:"Crystal Bernard", bio:"From Wikipedia, the free encyclopedia\n\nHeight     5' 4\" (1,63 m)\n\nCrystal Lynn Bernard (born September 30, 1961) is an American singer-songwriter and television and film actress, most widely known for her seven-year-long role on the situation comedy Wings.  While her main work has been on television, she has appeared in some films, and also attempted to pursue a music career as a songwriter/performer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7ZxM1JOjDJhQCcgKVmWbQvw3pHa.jpg", url:"https://themoviedb.org/person/1226789"}}, {tmdbId:"27568", properties:{bornIn:"Rosiclare, Illinois, USA", imdbId:"0722451", born:date('1947-08-17'), name:"Jennifer Rhodes", url:"https://themoviedb.org/person/27568"}}, {tmdbId:"939789", properties:{bornIn:"Fort Worth, Texas, U.S.", imdbId:"0564129", born:date('1962-09-16'), name:"Kimberly McArthur", bio:"Gorgeously buxom and voluptuous brunette stunner Kimberly McArthur was born on September 16, 1962 in Fort Worth, Texas.  The youngest of three children, McArthur and her siblings were raised by her mother after their parents divorced.  Kimberly studied dance, song and dramatic art at a university in Fort Worth, Texas.  McArthur tried out for the Dallas Cowboy Cheerleaders, but failed to make the final cut...", url:"https://themoviedb.org/person/939789"}}, {tmdbId:"170193", properties:{imdbId:"0523018", name:"Patrick Lowe", url:"https://themoviedb.org/person/170193"}}, {tmdbId:"11478", properties:{bornIn:"Bay Ridge - Brooklyn - New York City - New York - USA", imdbId:"0000966", born:date('1954-10-02'), name:"Lorraine Bracco", bio:"From Wikipedia, the free encyclopedia. \n\nLorraine Bracco (born October 2, 1954) is an American actress.  She is known for her roles as Karen Hill in Goodfellas and Dr.  Jennifer Melfi on the HBO television series, The Sopranos. \n\nDescription above from the Wikipedia article Lorraine Bracco, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1lQiN8yggIJ8aGYLp4Nul3ALdXC.jpg", url:"https://themoviedb.org/person/11478"}}, {tmdbId:"8984", properties:{bornIn:"Hornell, New York, U.S.A.", imdbId:"0000597", born:date('1953-12-17'), name:"Bill Pullman", bio:"William James \"Bill\" Pullman (born December 17, 1953) is an American film, television, and stage actor.  Pullman made his film debut in the supporting role of Earl Mott in the 1986 film Ruthless People.  He has since gone on to star in other films, including Spaceballs, Independence Day, Lost Highway, Casper and Scary Movie 4.  He has starred in a number of plays and is also a Jury Member for Filmaka...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2XqJA4Nup1dsNrChl5Ep9nOMHIQ.jpg", url:"https://themoviedb.org/person/8984"}}, {tmdbId:"289", properties:{bornIn:"Los Angeles - California - USA", imdbId:"0000656", born:date('1958-08-18'), name:"Madeleine Stowe", bio:"Madeleine Stowe (born August 18, 1958) is an American actress.  Description the Wikipedia article Madeleine Stowe, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/k7iQLoCP11e7iVMp1LQimUQLZe8.jpg", url:"https://themoviedb.org/person/289"}}, {tmdbId:"61964", properties:{bornIn:"New York City, New York, USA", imdbId:"0364680", born:date('1932-04-04'), name:"Estelle Harris", bio:"Estelle Harris is an American actress, comedienne, and voice artist, often recognized for her shrill, grating voice.  She is best known for her role as Estelle Costanza on the TV series Seinfeld from 1992 to 1998.  She is also known as the voice of Mrs.  Potato Head in Toy Story 2 (1999) and Toy Story 3 (2010), and Muriel on The Suite Life of Zack & Cody...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8L9umRwdjVs9CysJW24hhm2wNZ2.jpg", url:"https://themoviedb.org/person/61964"}}] AS row
