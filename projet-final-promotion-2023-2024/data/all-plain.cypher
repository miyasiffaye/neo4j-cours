UNWIND [{tmdbId:"65829", properties:{bornIn:"Chicago, Illinois, United States", imdbId:"0365445", born:date('1969-10-17'), name:"Wood Harris", bio:"An American actor.  He is perhaps best known for his roles as drug kingpin Avon Barksdale on the HBO television drama The Wire, and as high-school football player Julius Campbell in the 2000 motion picture Remember the Titans. \n\nDescription above from the Wikipedia article Wood Harris, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9gvwUEu1fZTSTkykaCx2fSdSDWK.jpg", url:"https://themoviedb.org/person/65829"}}, {tmdbId:"43858", properties:{bornIn:"Santa Monica, California, U.S.", imdbId:"0403652", born:date('1976-06-19'), name:"Ryan Hurst", bio:"From Wikipedia, the free encyclopedia. \n\nRyan Douglas Hurst (born June 19, 1976) is an American actor who perhaps most notably starred as Gerry Bertier, an All-American linebacker in Disney's Remember the Titans and as Alison's brother, Michael, in the show Medium.  He also played the role of football player Lump Hudson in The Ladykillers, appeared in the movie We Were Soldiers as Sgt.  Savage, and starred in the TNT show Wanted...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5fdekwCpCzqpl3NfEE1DOtqUdnx.jpg", url:"https://themoviedb.org/person/43858"}}, {tmdbId:"65535", properties:{imdbId:"0262521", born:date('1971-08-02'), name:"Alice Evans", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bnqD4yDORWpJg8uQjwsngZjZdgd.jpg", url:"https://themoviedb.org/person/65535"}}, {tmdbId:"1177696", properties:{imdbId:"0656350", name:"Steven Page", url:"https://themoviedb.org/person/1177696"}}, {tmdbId:"230342", properties:{bornIn:"Scarborough - Ontario - Canada", imdbId:"0731821", born:date('1970-10-25'), name:"Ed Robertson", bio:"Ed Robertson was born on October 25, 1970 in Scarborough, Ontario, Canada as Lloyd Edward Elwyn Robertson.  He has been married to Natalie Herbert since June 1994.  They have three children...", url:"https://themoviedb.org/person/230342"}}, {tmdbId:"1177707", properties:{imdbId:"0187235", name:"Jim Creeggan", url:"https://themoviedb.org/person/1177707"}}, {tmdbId:"1177701", properties:{imdbId:"0829882", name:"Tyler Stewart", url:"https://themoviedb.org/person/1177701"}}, {tmdbId:"166495", properties:{bornIn:"Thunder Bay, Ontario, Canada", imdbId:"0311473", born:date('1975-06-28'), name:"Jeff Geddis", url:"https://themoviedb.org/person/166495"}}, {tmdbId:"69574", properties:{bornIn:"Toronto, Ontario,  Canada", imdbId:"0230693", born:date('1973-06-08'), name:"Lexa Doig", bio:"Lexa Doig (born Alexandra Lecciones Doig on June 8, 1973) is a Canadian TV and movie actress.  She portrayed the title role in the 2000 - 2005 Canadian-American science fiction-adventure television series Andromeda.  She also portrayed the female lead role of Rowan in the science fiction-horror movie Jason X (2002), the 10th installment of the Friday the 13th film series.  Lexa Doig was born Alexandra Lecciones Doig in Toronto, Ontario, Canada on June 8, 1973...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2YMhgkGtfyJW96RzyDsoy5o3apf.jpg", url:"https://themoviedb.org/person/69574"}}, {tmdbId:"2405", properties:{bornIn:"Beaumont, Puy-de-Dôme, France", imdbId:"0851582", born:date('1976-08-09'), name:"Audrey Tautou", bio:"Audrey Justine Tautou (French pronunciation: [o. dʁɛ to. tu]; born 9 August 1976) is a French actress and model.  Signed by an agent at age 17, she made her acting debut at 18 on television and her feature film debut the following year in Venus Beauty Institute (1999), for which she received critical acclaim and won the César Award for Most Promising Actress.  Her subsequent roles in the 1990s and 2000s included Le Libertin and Happenstance (2000)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d1HVrV8zXy1FJVptmOCkHWG8Jf2.jpg", url:"https://themoviedb.org/person/2405"}}, {tmdbId:"2409", properties:{bornIn:"Molières-sur-Cèze, Gard, France", imdbId:"0186677", born:date('1958-04-09'), name:"Lorella Cravotta", bio:"Lorella Cravotta (born 9 April 1958) is a French comedian and actress.  She is best known for her role in the cult TV series Les Deschiens (1993–2002), in which she appears alongside Yolande Moreau. \n\nSource: Article \"Lorella Cravotta\" from Wikipedia in english, licensed under CC-BY-SA 3. 0...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yhg52W7DcDMTYEFxxiOiqz9ba7A.jpg", url:"https://themoviedb.org/person/2409"}}, {tmdbId:"18288", properties:{bornIn:"Chicago, Illinois, USA ", imdbId:"0005024", born:date('1969-03-11'), name:"Terrence Howard", bio:"Terrence Dashon Howard (born March 11, 1969) is an Academy Award-nominated American actor.  Having his first major role in the 1995 film Mr.  Holland's Opus, which subsequently led to a number of roles in films and high visibility among African American audiences.  Howard broke into the mainstream with a succession of well-reviewed television and film roles between 2004 and 2006...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3x1N0sMUueY56nkCaBT8mIgLSIy.jpg", url:"https://themoviedb.org/person/18288"}}, {tmdbId:"35545", properties:{bornIn:"Milwaukee, Wisconsin, USA", imdbId:"0333888", born:date('1971-09-20'), name:"Aimee Graham", bio:"From Wikipedia, the free encyclopedia. \n\nAimee Lynn Graham (born September 20, 1971) is an American actress, and the younger sister of actress Heather Graham. \n\nGraham was born in Milwaukee, Wisconsin, the daughter of Joan, a schoolteacher and noted author of children's books, and James Graham, a retired FBI agent.  She has appeared in many movies, such as 100 Girls, Jackie Brown, Fellowship of the Dice, in which she starred, and TV series such as CSI...", url:"https://themoviedb.org/person/35545"}}, {tmdbId:"35546", properties:{imdbId:"0657548", name:"Chris Palermo", bio:"Chris has more than twenty years experience in all aspects of stunt work, specializing in vehicles...", url:"https://themoviedb.org/person/35546"}}, {tmdbId:"12670", properties:{bornIn:"Chiba, Chiba Prefecture, Japan", imdbId:"0454120", born:date('1972-11-13'), name:"Takuya Kimura", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8veGL6ZmCRA6mZvq9u6qyZTmpj9.jpg", url:"https://themoviedb.org/person/12670"}}, {tmdbId:"9641", properties:{bornIn:"Knoxville, Tennessee, USA", imdbId:"0858969", born:date('1990-01-30'), name:"Jake Thomas", bio:"Jake is the son of actor Bob Thomas and actress and TV reporter Kim Simms Thomas.  He is perhaps best known for his role as Matt McGuire on the Disney show Lizzie McGuire.  In addition to being an actor, Jake is also a Photographer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rM0IbCQcaCJe37YDu44uIhv6xJX.jpg", url:"https://themoviedb.org/person/9641"}}, {tmdbId:"76001", properties:{bornIn:"Ithaca, New York, USA", imdbId:"0215229", born:date('1963-06-12'), name:"Tim DeKay", bio:"​Timothy Robert DeKay  (born June 12, 1963) is an American character actor.  His first on screen acting job was as corporate giant Larry Deon on seaQuest 2032.  He was a cast member of the series Party of Five from 1997–1999, Carnivàle from 2003–2005 and Tell Me You Love Me in 2007.  He has also guest–starred on a number of top-rated television series, including Seinfeld, Friends, CSI, My Name Is Earl, NCIS, The New Adventures of Old Christine and Scrubs...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pHPSlTKNbcspyquAHJHWPAKZKPP.jpg", url:"https://themoviedb.org/person/76001"}}, {tmdbId:"149936", properties:{imdbId:"0655761", name:"Pilar Padilla", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fBIt5EBh9744pJ6uznY0vk8q2lX.jpg", url:"https://themoviedb.org/person/149936"}}, {tmdbId:"10489", properties:{bornIn:"South Bronx, New York, USA", imdbId:"0569079", born:date('1949-02-02'), name:"Jack McGee", bio:"From Wikipedia, the free encyclopedia\n\nJack McGee (born 1948) is an American television and film character actor.  He has appeared in over 100 films and television shows. \n\nMcGee is perhaps best known as Chief Jerry Reilly on the television series Rescue Me.  He was a regular cast member on the FX series for three seasons.  In 2010, he co-starred as Hickey on the Spike TV comedy series Players...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xzBLwEdWxxZbZ3qbGrddldXvnSS.jpg", url:"https://themoviedb.org/person/10489"}}, {tmdbId:"108437", properties:{bornIn:"Oakland, CA", imdbId:"0274298", name:"Chris Ferreira", url:"https://themoviedb.org/person/108437"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"63155", properties:{bornIn:"Burbank, California, U.S.", imdbId:"0278673", born:date('1975-03-06'), name:"Mackenzie Firgens", bio:"From Wikipedia, the free encyclopedia. \n\nMackenzie Firgens (born March 6, 1975) is an American actress. \n\nDescription above from the Wikipedia article Mackenzie Firgens, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dVclzoj0GWdxITbtGlgM5X5IRe1.jpg", url:"https://themoviedb.org/person/63155"}}, {tmdbId:"10128", properties:{bornIn:"Hudson, New York, U.S.", imdbId:"0005406", born:date('1973-07-06'), name:"William Lee Scott", bio:"From Wikipedia, the free encyclopedia. \n\nWilliam Lee Scott (born July 6, 1973) is an American actor.  He is best known for his portrayal of dim-witted high school student Stanley \"Bullethead\" Kuznocki on the WB sitcom The Steve Harvey Show.  Additionally, he appeared in the films Gone in 60 Seconds, Pearl Harbor, October Sky and The Butterfly Effect. \n\nDescription above from the Wikipedia article William Lee Scott, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p6mISLnDP84gaBOiXSpOenFO8Zd.jpg", url:"https://themoviedb.org/person/10128"}}, {tmdbId:"15762", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"0152839", born:date('1973-02-12'), name:"Tara Strong", bio:"Tara Lyn Charendoff-Strong (born February 12, 1973) is a Canadian-American actress, voice-over artist, comedian, musician, singer, and businesswoman, who is best known for her roles as Timmy Turner in the The Fairly OddParents, Bubbles in The Powerpuff Girls, Ben Tennyson in Ben 10 and Ben 10: Ultimate Alien, Dil Pickles in Rugrats and All Grown Up, and her recurring role as Miss Collins in Big Time Rush ...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/y9S3QzI3L5aARP8GYYO86rREKxU.jpg", url:"https://themoviedb.org/person/15762"}}, {tmdbId:"80719", properties:{bornIn:"Manville - New Jersey - USA", imdbId:"0153719", born:date('1958-12-25'), name:"Cheryl Chase", bio:"Cheryl Chase is best known as the voice of Angelica Pickles on Rugrats, All Grown Up! and Angelica and Susie's Pre-School Daze! Chase's character Angelica Pickles placed #7 in TV Guide's \"50 Greatest Cartoon Characters of All Time\" (August 2002)...", url:"https://themoviedb.org/person/80719"}}, {tmdbId:"68916", properties:{bornIn:"Katsuyama, Fukui Prefecture, Japan", imdbId:"0411167", born:date('1951-05-16'), name:"Unshô Ishizuka", bio:"Unsho Ishizuka, born as Yukinori Ishizuka, was a Japanese voice actor, narrator and actor affiliated with Aoni Production...", died:date('2018-08-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jSQPB45PbMYmSFGnlX9nGM9DRr4.jpg", url:"https://themoviedb.org/person/68916"}}, {tmdbId:"104712", properties:{imdbId:"0484174", name:"Kevin Seymour", url:"https://themoviedb.org/person/104712"}}, {tmdbId:"51857", properties:{bornIn:"Highland Park, Michigan, USA", imdbId:"0005218", born:date('1961-02-05'), name:"Tim Meadows", bio:"From Wikipedia, the free encyclopedia\n\nTimothy \"Tim\" Meadows (born February 5, 1961) is an American actor and comedian and one of the longest-running cast members on Saturday Night Live, where he appeared for ten seasons. \n\nDescription above from the Wikipedia article Tim Meadows, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c7NvUYdkUDRnPDpmQgyXIG4HrcN.jpg", url:"https://themoviedb.org/person/51857"}}, {tmdbId:"80987", properties:{bornIn:"Hollywood, Los Angeles, California, USA", imdbId:"0663854", born:date('1966-10-08'), name:"Karyn Parsons", bio:"Karyn Parsons decided to go into acting at the age of 13.  She had her first TV role in the NBC drama The Bronx Zoo (1987), but she made her big break as Will Smith's cousin \"Hilary Banks\" on the NBC sitcom The Fresh Prince of Bel-Air (1990).  During the show's six-year run, she starred in movies such as Class Act (1992) and Major Payne (1995)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iQzZ1Vedy1aP2i2qnMkOcJoElGS.jpg", url:"https://themoviedb.org/person/80987"}}, {tmdbId:"67612", properties:{bornIn:"Messina", imdbId:"0837868", born:date('1984-10-07'), name:"Giuseppe Sulfaro", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n2dGRXym6gJwwwkDt5IUjTnAHVt.jpg", url:"https://themoviedb.org/person/67612"}}, {tmdbId:"67613", properties:{bornIn:"Sanremo, Liguria, Italy", imdbId:"0270119", born:date('1968-08-28'), name:"Luciano Federico", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tkZN8uWDtnoMkjaJ1GCQoBKc7eo.jpg", url:"https://themoviedb.org/person/67613"}}, {tmdbId:"67614", properties:{bornIn:"Catania, italy", imdbId:"0681218", born:date('1958-06-07'), name:"Matilde Piana", url:"https://themoviedb.org/person/67614"}}, {tmdbId:"17243", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0006958", born:date('1982-05-31'), name:"Jonathan Tucker", bio:"Jonathan Tucker is an American film and television actor, best known for playing supporting characters in feature films such as \"The Texas Chainsaw Massacre\", \"Hostage\", and \"In the Valley of Elah\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gR1lthok818AcmJsg87f1On6Qnf.jpg", url:"https://themoviedb.org/person/17243"}}, {tmdbId:"59192", properties:{bornIn:"Montreal, Quebec, Canada", imdbId:"0004825", born:date('1975-12-10'), name:"Emmanuelle Chriqui", bio:"A Canadian actress of Moroccan descent who has appeared on both television and in cinema.  She is perhaps best known for her role on HBO's Entourage as Sloan McQuewick, as well as the love interest of Adam Sandler in the movie You Don't Mess with the Zohan.  In May 2010, she topped the AskMen. com Most Desirable Women of 2010 list. \n\nDescription above from the Wikipedia article Emmanuelle Chriqui, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aG8UxYWojEWulKSctUQaxhnVeoX.jpg", url:"https://themoviedb.org/person/59192"}}, {tmdbId:"57599", properties:{bornIn:"Cottage Grove, Minnesota, USA", imdbId:"0005405", born:date('1976-10-03'), name:"Seann William Scott", bio:"Seann William Scott (born October 3, 1976) is an American actor and comedian.  He is most widely known for having played Steve Stifler in the American Pie series of teen sex comedy films.  He is also known for his roles in the films Final Destination, Road Trip, Dude, Where's My Car?, Evolution, The Rundown, The Dukes of Hazzard, Role Models, and Cop Out. \n\nDescription above from the Wikipedia article Seann William Scott, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q7sOqLQPJCscw2oatxKS5sJvXpn.jpg", url:"https://themoviedb.org/person/57599"}}, {tmdbId:"20189", properties:{bornIn:"Topanga Canyon, California, USA", imdbId:"0005442", born:date('1976-03-26'), name:"Amy Smart", bio:"Amy Lysle Smart is an American actress and former fashion model.  Smart began her career modeling in Italy and subsequently enrolled in acting school.  Her first role in film was in director Martin Kunert's film Campfire Tales...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/noDadb44ECVzWFMgq8fkXcFO023.jpg", url:"https://themoviedb.org/person/20189"}}, {tmdbId:"57133", properties:{bornIn:"Brampton, Ontario, Canada", imdbId:"0182455", born:date('1978-09-21'), name:"Paulo Costanzo", bio:"Paulo Costanzo  (born September 21, 1978) is a Canadian actor who is best-known for his roles in the 2000 comedy Road Trip, the sitcom Joey which ran from 2004 to 2006, and as Evan R.  Lawson in the current USA Network series Royal Pains. \n\nCostanzo was born in Brampton, Ontario.  His mother is a singer/songwriter and his father an artist.  Costanzo is of half-Italian ancestry...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bNFyiVSSrEoQKI0mJCNE1JvhwnJ.jpg", url:"https://themoviedb.org/person/57133"}}, {tmdbId:"83813", properties:{bornIn:"Montreuil, France", imdbId:"0627245", born:date('1970-08-03'), name:"Thierry Neuvic", bio:"​From Wikipedia, the free encyclopedia.   \n\nThierry Neuvic (born 3 August 1970) is a French actor.  He has appeared in 32 films and television shows since 1996.  He starred in the film Code Unknown, which was entered into the 2000 Cannes Film Festival...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e0CvOz6q1hqunt57lrIzY4mtWnT.jpg", url:"https://themoviedb.org/person/83813"}}, {tmdbId:"11610", properties:{bornIn:"Ambach, Bavaria, Germany", imdbId:"0081547", born:date('1948-04-26'), name:"Josef Bierbichler", bio:"Josef Bierbichler is a German stage, film and television actor, writer and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/XbK3QlwxcXXceR06Ullp0Yr0Ng.jpg", url:"https://themoviedb.org/person/11610"}}, {tmdbId:"1362307", properties:{imdbId:"0357649", name:"Alexandre Hamidi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aMlWFpbDrigPcqKYjHNfn8bqgnP.jpg", url:"https://themoviedb.org/person/1362307"}}, {tmdbId:"67471", properties:{bornIn:" Tokyo, Japan", imdbId:"0848987", born:date('1950-11-12'), name:"Hideyuki Tanaka", bio:"Hideyuki Tanaka (田中 秀幸) is a Japanese voice actor, actor, and narrator...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1D1PmELZexM6aod77gbh9GwvvGG.jpg", url:"https://themoviedb.org/person/67471"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"617", properties:{bornIn:"Osaka, Japan", imdbId:"0619077", born:date('1931-05-10'), name:"Ichirô Nagai", bio:"Ichirō Nagai (永井 一郎 Nagai Ichirō, May 10, 1931 – January 27, 2014) was a Japanese voice actor from Ikeda, Osaka.  He was previously affiliated by Tokyo Actor's Consumer's Cooperative Society, and was affiliated with Aoni Production at the time of his death.  On January 27, 2014, while recording narration for a program in Hiroshima, Nagai suffered a bout of myocardial infarction and was found by a hotel employee...", died:date('2014-01-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1dU3N0bExrWiNYDocDK6iuKNruf.jpg", url:"https://themoviedb.org/person/617"}}, {tmdbId:"1953436", properties:{name:"Pras Michel", url:"https://themoviedb.org/person/1953436"}}, {tmdbId:"61658", properties:{bornIn:"Hollis, Queens, New York City, New York, USA", imdbId:"0750019", born:date('1976-02-29'), name:"Ja Rule", bio:"Jeffrey Atkins (born February 29, 1976), better known by his stage name Ja Rule, is an American rapper, singer, and actor.  Born in Hollis, Queens, he began his career in the group Cash Money Click and debuted in 1999 with Venni Vetti Vecci and its single \"Holla Holla\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jiYEwuTCkp0vW14eHLFDRJ9v111.jpg", url:"https://themoviedb.org/person/61658"}}, {tmdbId:"35324", properties:{bornIn:"Oran, Algérie", imdbId:"0023348", born:date('1951-10-29'), name:"Anne Alvaro", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qVGJMYoNm0wLLCVa8xSmDaHWBxe.jpg", url:"https://themoviedb.org/person/35324"}}, {tmdbId:"28281", properties:{bornIn:"Castiglione, Alger, France", imdbId:"0045870", born:date('1951-05-24'), name:"Jean-Pierre Bacri", bio:"Jean-Pierre Bacri (born 24 May 1951, Castiglione [now Bou Ismaïl], Algeria) is a French Jewish actor and screenwriter who frequently works in collaboration with Agnès Jaoui. \n\nDescription above from the Wikipedia article Jean-Pierre Bacri, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tAxULq3OY0l3ueYZTJdUoXk5JEa.jpg", url:"https://themoviedb.org/person/28281"}}, {tmdbId:"18178", properties:{bornIn:"Paris, France", imdbId:"0524217", born:date('1965-07-20'), name:"Laurent Lucas", bio:"Laurent Lucas (born 20 July 1965) is a French actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dMb87uO627isT2BbCHEVbaiCL2g.jpg", url:"https://themoviedb.org/person/18178"}}, {tmdbId:"67902", properties:{bornIn:"Paris, France", imdbId:"0347069", born:date('1977-12-01'), name:"Sophie Guillemin", bio:"Extrait de Wikipedia, l'Encyclopedie libre. \n\nSon bac en poche en 1996, Sophie Guillemin exerce plusieurs petits boulots, notamment figurante à Euro Disney et serveuse dans la restauration rapide.  En 1998, remarquée par Cédric Kahn, elle décroche le rôle principal de L'Ennui qui lui vaudra une nomination aux Césars dans la catégorie meilleur espoir féminin.  Elle est remarquée à l'époque pour ses formes généreuses, et considérée comme une « révélation ». \n\n« Je n'ai rien préparé...", url:"https://themoviedb.org/person/67902"}}, {tmdbId:"6212", properties:{bornIn:"Libertyville - Illinois - USA", imdbId:"0651008", born:date('1970-10-15'), name:"Zak Orth", bio:"Zak Orth (born October 15, 1970) is an American comedic actor known for his roles in Wet Hot American Summer, The Baxter, Melinda and Melinda, In and Out, and Music and Lyrics.  He also appeared as a man haunted by psychic visions named Roy in an episode of the Fox series Fringe. \n\nOrth was born Adam Zachary Orth in Libertyville, Illinois, the son of Jane, a piano teacher, and Robert Orth, an opera singer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ldywlWMt89PO3qLDL174TpTc0ce.jpg", url:"https://themoviedb.org/person/6212"}}, {tmdbId:"1218218", properties:{bornIn:"Bethany, Connecticut, USA", imdbId:"0755603", born:date('1976-01-01'), name:"Thomas Sadoski", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ciqrqKHUfFGlMPyUE35YSKEvxuL.jpg", url:"https://themoviedb.org/person/1218218"}}, {tmdbId:"65236", properties:{bornIn:"Tulsa, Oklahoma, USA", imdbId:"0004966", born:date('1966-12-27'), name:"Bill Goldberg", bio:"William Scott \"Bill\" Goldberg (born December 27, 1966) is a former professional wrestler best known for his time in World Championship Wrestling (WCW) and World Wrestling Entertainment (WWE).  He is famous for holding the record for the largest undefeated winning streak in professional wrestling.  The official count is listed as 173 wins and one loss, although some have disputed the legitimacy of that total...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bM2kVgFBGhp6gjbypFUiUP3Qg7c.jpg", url:"https://themoviedb.org/person/65236"}}, {tmdbId:"4012", properties:{bornIn:"New York City, New York, United States", imdbId:"0004829", born:date('1987-09-24'), name:"Spencer Treat Clark", bio:"Spencer Treat Clark (born September 24, 1987) is an American actor who has appeared in several films, including Gladiator, Mystic River, and Unbreakable. \n\nDescription above from the Wikipedia article Spencer Treat Clark, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/695AaV6QE3TubsJrTSRCY7O4JAV.jpg", url:"https://themoviedb.org/person/4012"}}, {tmdbId:"57342", properties:{bornIn:"Pinehurst, North Carolina, USA", imdbId:"0573093", born:date('1945-08-24'), name:"Vince McMahon", bio:"From Wikipedia, the free encyclopedia\n\nVincent Kennedy \"Vince\" McMahon (born August 24, 1945) is an American professional wrestling promoter, announcer, commentator, film producer, actor and former occasional professional wrestler, and is often referred to as the archetypal wrestling magnate...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wqpUeqCZLSvo3ErU9EEmLmEUee6.jpg", url:"https://themoviedb.org/person/57342"}}, {tmdbId:"1236783", properties:{bornIn:"La Porte, Indiana, USA", imdbId:"0576879", born:date('1968-01-14'), name:"Anthony Meindl", url:"https://themoviedb.org/person/1236783"}}, {tmdbId:"2525882", properties:{bornIn:"Chicago, Illinois, USA", born:date('1985-09-09'), name:"Grady Hutt", url:"https://themoviedb.org/person/2525882"}}, {tmdbId:"13253", properties:{bornIn:" Tokyo, Japan", imdbId:"0297906", born:date('1982-11-02'), name:"Kyoko Fukada", bio:"Kyôko Fukada is an actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fi7gJDbVY6tJ3Hy3HwkXZS16dUW.jpg", url:"https://themoviedb.org/person/13253"}}, {tmdbId:"58449", properties:{imdbId:"0463201", born:date('1954-01-23'), name:"Fumiyo Kohinata", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jgdletlEe3cKgGRh1vbEz6RgZOJ.jpg", url:"https://themoviedb.org/person/58449"}}, {tmdbId:"10859", properties:{bornIn:"Vancouver, British Columbia, Canada", imdbId:"0005351", born:date('1976-10-23'), name:"Ryan Reynolds", bio:"A Canadian actor.  He portrayed Michael Bergen on the ABC sitcom Two Guys and a Girl (1998–2001), Billy Simpson in the YTV Canadian teen soap opera Hillside (1991), as well as Marvel Comics characters Hannibal King in Blade: Trinity (2004), Wade Wilson / Weapon XI in X-Men Origins: Wolverine (2009), and the title character in Deadpool (2016) for which he received a Golden Globe Award nomination...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h1co81QaT2nJA41Sb7eZwmWl1L2.jpg", url:"https://themoviedb.org/person/10859"}}, {tmdbId:"75946", properties:{bornIn:"\tToronto, Ontario, Canada", imdbId:"0277116", born:date('1973-11-30'), name:"Fab Filippo", url:"https://themoviedb.org/person/75946"}}, {tmdbId:"75948", properties:{imdbId:"0217984", born:date('1974-08-09'), name:"Marya Delver", url:"https://themoviedb.org/person/75948"}}, {tmdbId:"83600", properties:{bornIn:"Queens, New York City, New York, USA", imdbId:"0036651", born:date('1971-06-28'), name:"Tichina Arnold", bio:"​From Wikipedia, the free encyclopedia.   \n\nTichina Rolanda Arnold (born June 28, 1971) is an American actress and singer.  She has portrayed the roles of Pamela James on the FOX sitcom Martin and the family matriarch Rochelle on the UPN/CW sitcom Everybody Hates Chris. \n\nDescription above from the Wikipedia article Tichina Arnold, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aBv6pccSsbO6DwfHfIz5wTZTux8.jpg", url:"https://themoviedb.org/person/83600"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"51547", properties:{bornIn:"Pughsville [now Suffolk], Virginia, USA", imdbId:"0043041", born:date('1945-11-27'), name:"James Avery", bio:"James LaRue Avery (November 27, 1945 – December 31, 2013) was an American actor. \n\nBest known for his portrayal of the patriarch and attorney (later judge) Philip Banks, Will Smith's character's uncle, in the TVsitcomThe Fresh Prince of Bel-Air.  This character was ranked #34 in TV Guide's \"50 Greatest TV Dads of All Time...", died:date('2013-12-31'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iPeiAsXEKaIkWshAkAFYTqaqOS4.jpg", url:"https://themoviedb.org/person/51547"}}, {tmdbId:"113818", properties:{imdbId:"0074410", born:date('1974-07-04'), name:"Jenica Bergere", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kyyH5jMD38hZySs6WfVv8jrpurW.jpg", url:"https://themoviedb.org/person/113818"}}, {tmdbId:"2267675", properties:{imdbId:"0081914", name:"Barrington Bignall", url:"https://themoviedb.org/person/2267675"}}, {tmdbId:"17276", properties:{bornIn:"Paisley, Scotland, UK ", imdbId:"0124930", born:date('1969-11-13'), name:"Gerard Butler", bio:"Gerard James Butler (born 13 November 1969) is a Scottish actor who has appeared on film, stage, and television. \n\nA trained lawyer, Butler turned to acting in the mid-1990s with small roles in productions such as the James Bond film Tomorrow Never Dies (1997), which he followed with steady work on television, most notably in the American miniseries Attila (2001)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cAlwtnkOTtLAPjCQzMYbM6VA41p.jpg", url:"https://themoviedb.org/person/17276"}}, {tmdbId:"42705", properties:{bornIn:"Johannesburg, South Africa", imdbId:"0905311", born:date('1976-11-04'), name:"Justine Waddell", bio:"Justine Waddell (born 4 November 1976) is a South African-born actress known for her role as Tess Durbeyfield in the 1998 television adaptation of Thomas Hardy's Tess of the d'Urbervilles and for her role in the BBC television serial, Wives and Daughters.  She has also appeared in various theatrical productions such as the 1997 London stage production of Anton Chekhov's Ivanov...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gVPTeUJW1Doq19LTPZfsfNqC06N.jpg", url:"https://themoviedb.org/person/42705"}}, {tmdbId:"1537819", properties:{bornIn:"Texas, USA", imdbId:"0535850", born:date('1946-12-11'), name:"Ken Magee", died:date('2015-12-31'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uAdTFwnXcTjrODawHbSVelZrBKN.jpg", url:"https://themoviedb.org/person/1537819"}}, {tmdbId:"35654", properties:{bornIn:"New York City, New York, USA", imdbId:"0107748", born:date('1992-05-18'), name:"Spencer Breslin", bio:"​From Wikipedia, the free encyclopedia.   \n\nSpencer Breslin (born May 18, 1992) is an American teen actor and musician. \n\nDescription above from the Wikipedia article Spencer Breslin, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jqZRcEjEt3iodgXoGOZUaahozjm.jpg", url:"https://themoviedb.org/person/35654"}}, {tmdbId:"1246", properties:{bornIn:"London, England, UK", imdbId:"0607865", born:date('1971-12-01'), name:"Emily Mortimer", bio:"Emily Kathleen A.  Mortimer (born 1 December 1971) is an English actress.  She began performing on stage, and has since appeared in several film and television roles, including Scream 3, Match Point, Lars and the Real Girl, and Shutter Island...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sBUQaBp5PcAkoA6Oh9TuNnxrTD3.jpg", url:"https://themoviedb.org/person/1246"}}, {tmdbId:"31711", properties:{bornIn:"Los Angeles - California - USA", imdbId:"0004949", born:date('1973-07-07'), name:"Troy Garity", bio:"Troy Garity (born July 7, 1973) is an American film actor.  He is best known for his role as Isaac Rosenberg in the Barbershop films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ygLnxDVARw8Av5tSZR0AuI5x4j4.jpg", url:"https://themoviedb.org/person/31711"}}, {tmdbId:"90453", properties:{imdbId:"0394251", name:"Nikita Hopkins", bio:"Nikita Hopkins is an American child actor who is most notable for his Annie Award-nominated portrayal of the character Roo in the recent Winnie the Pooh films...", url:"https://themoviedb.org/person/90453"}}, {tmdbId:"77482", properties:{bornIn:"Salt Lake City, Utah,USA", imdbId:"0763052", born:date('1927-04-02'), name:"Ken Sansom", bio:"From Wikipedia, the free encyclopedia. \n\nKenneth Sansom is an American actor who first began acting in the early seventies.  His first role was in an episode of Mayberry R. F. D. , a continuation of the Andy Griffith Show.  He is best known for his role as Rabbit in The New Adventures of Winnie the Pooh.  He would later be replaced by Tom Kenny in the upcoming film...", died:date('2012-10-08'), url:"https://themoviedb.org/person/77482"}}, {tmdbId:"133302", properties:{bornIn:"San Francisco, California, USA", imdbId:"0112001", born:date('1970-12-01'), name:"Golden Brooks", bio:"Golden Ameda Brooks (born December 1, 1970) is an American actress.  She is best known for her role as Maya Wilkes on Girlfriends...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tr3J6R668h1BAZQh3ZtecMiphW9.jpg", url:"https://themoviedb.org/person/133302"}}, {tmdbId:"156774", properties:{bornIn:"Santa Monica, California, USA", imdbId:"0205630", born:date('1969-08-19'), name:"Viveka Davis", url:"https://themoviedb.org/person/156774"}}, {tmdbId:"30435", properties:{bornIn:"Grey Abbey, Ards, Northern Ireland, UK", imdbId:"0599778", born:date('1974-01-04'), name:"Flora Montgomery", bio:"From Wikipedia, the free encyclopedia. \n\nFlora Montgomery (January 4, 1974) is an Northern Irish actress...", url:"https://themoviedb.org/person/30435"}}, {tmdbId:"69465", properties:{bornIn:"Sligo, Republic of Ireland", imdbId:"0572965", born:date('1962-07-11'), name:"Pauline McLynn", bio:"From Wikipedia, the free encyclopedia. \n\nPauline McLynn (born 11 July 1962) is an Irish actress, comedienne and author, best known for playing Mrs Doyle in the Channel 4 sitcom Father Ted, and Libby Croker in the Channel 4 comedy drama Shameless. \n\nDescription above from the Wikipedia article Pauline McLynn, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6awcWXWpltUcfFiPFdnOok8oqIG.jpg", url:"https://themoviedb.org/person/69465"}}, {tmdbId:"19803", properties:{bornIn:"Buenos Aires, Argentina", imdbId:"0768614", born:date('1970-06-30'), name:"Leonardo Sbaraglia", bio:"​From Wikipedia, the free encyclopedia. \n\nLeonardo Máximo Sbaraglia is one of the biggest movie stars in Argentina (born June 30, 1970)Argentine film, with extensive credits in Argentina and Spain.  He also has worked in Mexico and he just has filmed his first role in English with Robert De Niro, Sigourney Weaver and Cillian Murphy in Red Lights...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nMaQ61zgfYFTmHVdw5KhdnFNj86.jpg", url:"https://themoviedb.org/person/19803"}}, {tmdbId:"67262", properties:{bornIn:"Las Palmas de Gran Canaria, Gran Canaria, Canary Islands, Spain", imdbId:"0530286", born:date('1969-05-30'), name:"Mónica López", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Ak74zXxUAyEiWnEMuoT3Y1XEgg8.jpg", url:"https://themoviedb.org/person/67262"}}, {tmdbId:"6535", properties:{bornIn:"Sevilla, Andalucía, Spain", imdbId:"0213766", born:date('1960-02-16'), name:"Antonio Dechent", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3aZ2VQrsGmZl5QKlS5Z4kth5ch8.jpg", url:"https://themoviedb.org/person/6535"}}, {tmdbId:"8791", properties:{bornIn:"Montreal, Quebec, Canada", imdbId:"0189887", born:date('1970-02-23'), name:"Marie-Josée Croze", bio:"Marie-Josée Croze is a Canadian actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cGBcSPPfsXbtydml0taNOY4WVwu.jpg", url:"https://themoviedb.org/person/8791"}}, {tmdbId:"557284", properties:{imdbId:"0894830", born:date('1986-01-01'), name:"Jean-Nicolas Verreault", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/duETd1aBJ32CkIvcTik9m7QsJZL.jpg", url:"https://themoviedb.org/person/557284"}}] AS row
