UNWIND [{tmdbId:"1654285", properties:{imdbId:"0638075", name:"Queen Nunn", url:"https://themoviedb.org/person/1654285"}}, {tmdbId:"25990", properties:{bornIn:"New Boston, New Hampshire, U.S.", imdbId:"0173688", born:date('1970-10-19'), name:"Andy Comeau", bio:"Andy Comeau is an American actor, born on October 19, 1970, in New  Boston, New Hampshire.  He studied first at Guertin High School, where he  discovered his passion for the performing arts, was why he decided to  start a career in the University of New Hampshire.  Throughout his  career, participated in several telefilms, such as: \"out of control\" and  \"Virtual obsession\"...", url:"https://themoviedb.org/person/25990"}}, {tmdbId:"146523", properties:{imdbId:"0862923", name:"Brigid Tierney", url:"https://themoviedb.org/person/146523"}}, {tmdbId:"1578", properties:{imdbId:"0651660", born:date('1947-11-07'), name:"Holmes Osborne", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q2wZqaQO9ozSNQgl1fveC9qHZDe.jpg", url:"https://themoviedb.org/person/1578"}}, {tmdbId:"7431", properties:{bornIn:"Woodstock, Ontario, Canada", imdbId:"0954225", born:date('1984-09-19'), name:"Kevin Zegers", bio:"A Canadian actor and model.  He is best known for his leading roles as Josh Framm in the Air Bud series, as well as playing Damien Dalgaard in the Gossip Girl series and the protagonist in Rock Mafias The Big Bang.  On August 3rd, 2013, Zegers married Jaime Feld, an agent who was his girlfriend for several years. \n\nDescription above from the Wikipedia article Kevin Zegers , licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8IZWHzUElVhAyRqzWiCXzf7MHL4.jpg", url:"https://themoviedb.org/person/7431"}}, {tmdbId:"66586", properties:{bornIn:"Huntington, New York, USA", imdbId:"0001014", born:date('1970-03-27'), name:"Mariah Carey", bio:"Mariah Carey (born March 27, 1970 or 1969; sources vary) is an American R&B/pop singer-songwriter, record producer and actress.  She made her recording debut in 1990 under the guidance of Columbia Records executive Tommy Mottola, and became the first recording artist to have her first five singles top the U. S.  Billboard Hot 100 chart...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wSiQWbkMplbO5wnXYhwQ1g7jyG0.jpg", url:"https://themoviedb.org/person/66586"}}, {tmdbId:"66587", properties:{bornIn:"Burnage, Manchester, England", imdbId:"0066586", born:date('1971-04-16'), name:"Max Beesley", bio:"​From Wikipedia, the free encyclopedia.   \n\nMaxton Gig Beesley Jr.  (born 16 April 1971), known simply as Max Beesley, is an English actor and musician. \n\nBeesley rose to fame for his role of Andy Simpson in Every Woman, Every Man from 1993 to 1998, and has since appeared in a variety of television shows including Bodies, Hotel Babylon, London Ink, Survivors and Mad Dogs. \n\nHe also played the lead in a television adaptation of The History of Tom Jones, a Foundling in 1997...", url:"https://themoviedb.org/person/66587"}}, {tmdbId:"105881", properties:{imdbId:"0004771", born:date('1974-04-14'), name:"Da Brat", url:"https://themoviedb.org/person/105881"}}, {tmdbId:"68430", properties:{bornIn:"Louisiana, USA", imdbId:"0004137", born:date('1971-12-14'), name:"Tia Texada", bio:"​From Wikipedia, the free encyclopedia\n\nTia Texada (born Tia Nicole Tucker on December 14, 1971) is an American actress and singer.  She is probably best known for portraying the role of Sgt.  Maritza Cruz from the American television show Third Watch and for her role as Shay on ABC Family's Huge.  Texada was born in Louisiana to a reflexologist mother and an insurance agent father.  She has been acting since she was young...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e5QSQYpePYANIPSN527A7s6iecR.jpg", url:"https://themoviedb.org/person/68430"}}, {tmdbId:"58381", properties:{bornIn:"Joliet, Illinois, USA", imdbId:"0896735", born:date('1970-11-10'), name:"Vince Vieluf", bio:"Vincent Ernest \"Vince\" Vieluf is an American actor.  He is best known for his roles in Rat Race and the short-lived UPN sitcom Love, Inc...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q2ELa1TZfsZOfk5r1gshtF7c6XC.jpg", url:"https://themoviedb.org/person/58381"}}, {tmdbId:"154072", properties:{bornIn:"Queens, New York, USA", imdbId:"0118720", born:date('1969-11-18'), name:"Phil Buckman", url:"https://themoviedb.org/person/154072"}}, {tmdbId:"938", properties:{bornIn:"Cotonou, Benin", imdbId:"0005023", born:date('1964-04-24'), name:"Djimon Hounsou", bio:"A Beninese-American actor and model.  As an actor, Hounsou has been nominated for two Academy Awards. \n\nHounsou became a naturalized American citizen in 2007.  He was reluctant to renounce his Beninese citizenship and therefore opted to become a dual citizen of both Benin and the United States, effectively rendering him a Beninese-American. \n\nDjimon Hounsou was born in Cotonou, Benin, in 1964, to lbertine and Pierre Hounsou...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hco0KMbrxACYTmBfAkSzCf23CXV.jpg", url:"https://themoviedb.org/person/938"}}, {tmdbId:"21484", properties:{bornIn:"Ottawa, Ontario, Canada", imdbId:"0021112", born:date('1960-12-09'), name:"Todd Allen", bio:"From Wikipedia, the free encyclopedia. \n\nTodd Allen (born Ottawa, Ontario) is a comedian, writer and producer based out of Vancouver, British Columbia and Los Angeles, California. \n\nDescription above from the Wikipedia article Todd Allen, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xrbPXMUUwVft8NlwavDMxWkfVqW.jpg", url:"https://themoviedb.org/person/21484"}}, {tmdbId:"11866", properties:{bornIn:"Vancouver, British Columbia, Canada", imdbId:"0005045", born:date('1978-06-11'), name:"Joshua Jackson", bio:"Joshua Carter Jackson (born June 11, 1978) is a Canadian actor.  He has appeared in primetime television and in over 32 film roles.  He is best known for playing Charlie Conway in The Mighty Ducks film series, Pacey Witter in the television series Dawson's Creek and Peter Bishop in the television series Fringe. \n\nDescription above from the Wikipedia article Joshua Jackson, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fv7Huf146NK7docHszIEXOkzjzi.jpg", url:"https://themoviedb.org/person/11866"}}, {tmdbId:"55959", properties:{imdbId:"0183170", name:"Mickey Cottrell", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p9qp6XcXXCgidPxI5tr7T3wANEH.jpg", url:"https://themoviedb.org/person/55959"}}, {tmdbId:"21354", properties:{bornIn:"Troy, New York, USA", imdbId:"0005568", born:date('1963-03-01'), name:"Russell Wong", bio:"An American actor and photographer, as well as the brother of actor/model Michael Wong...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5S4ITB3tELBnfi0PFr9CWo9rmuZ.jpg", url:"https://themoviedb.org/person/21354"}}, {tmdbId:"7007", properties:{bornIn:"Montreal, Quebec, Canada", imdbId:"0274750", name:"Claudia Ferri", bio:"Claudia Ferri was born into a multicultural family in Montreal.  Her father of Italian Origins and her mother's ancestry is Irish, Scottish, French and Native American.  When all the members of her family got together for festivities, Italian, French, English or Arab was spoken among cousins or aunts and uncles.  It's no surprise that she is multilingual (English, Italian, French and Spanish) on screen too.   The eastern coast of U. S. A...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mWFY9va5C9w7MRZZzfd0nGk0i1r.jpg", url:"https://themoviedb.org/person/7007"}}, {tmdbId:"83099", properties:{imdbId:"0221754", born:date('1967-07-12'), name:"Natalie Desselle Reid", url:"https://themoviedb.org/person/83099"}}, {tmdbId:"1874", properties:{bornIn:"Kirchweyhe, Germany", imdbId:"0726257", born:date('1963-11-01'), name:"Katja Riemann", bio:"Katja Hannchen Leni Riemann (born 1 November 1963 in Weyhe-Kirchweyhe, Germany) is a German actress. \n\nDescription above from the Wikipedia article Katja Riemann, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4zFqTNNd7dv6bTczRVLLjOvdXCN.jpg", url:"https://themoviedb.org/person/1874"}}, {tmdbId:"683", properties:{imdbId:"0845915", born:date('1967-06-08'), name:"Jasmin Tabatabai", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dndUImgq5o664IzodTpK9lngzQY.jpg", url:"https://themoviedb.org/person/683"}}] AS row
