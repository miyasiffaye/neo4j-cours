UNWIND [{tmdbId:"52697", properties:{bornIn:"Washington, D.C., USA", imdbId:"0257077", born:date('1948-07-28'), name:"Georgia Engel", bio:"Georgia Bright Engel was an American film, television, and stage actress who is best known for her roles as Georgette Franklin on The Mary Tyler Moore Show and Pat MacDougall on Everybody Loves Raymond.  She was also the voice of Bobbie in the Open Season franchise...", died:date('2019-04-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4G6hN61zNRdIPu8dFShBbD1U1Ny.jpg", url:"https://themoviedb.org/person/52697"}}, {tmdbId:"68727", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"0861898", born:date('1976-12-13'), name:"Sunny Besen Thrasher", bio:"​From Wikipedia, the free encyclopedia.   \n\nSunny Besen Thrasher (born December 13, 1976 in Toronto, Ontario) was a Canadian child actor who starred as Paul Edison in Nelvana's live-action series, The Edison Twins, and supplied voices in the first two Care Bears movies. \n\nHe also played Max in both the film and TV series of My Pet Monster and voiced Reggie Mantle in The New Archies as well as several characters in the Care Bears television show, Garbage Pail Kids, Ultraforce and Babar...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qXMw3503B3A380lz8o95aJ46f0V.jpg", url:"https://themoviedb.org/person/68727"}}, {tmdbId:"7169", properties:{imdbId:"0454418", born:date('1927-12-26'), name:"Alan King", died:date('2004-05-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wq3yjC2S2SMxjs4tAAuryJ91Hum.jpg", url:"https://themoviedb.org/person/7169"}}, {tmdbId:"2333562", properties:{name:"Michael Blevins", url:"https://themoviedb.org/person/2333562"}}, {tmdbId:"19258", properties:{imdbId:"0096608", name:"Yamil Borges", url:"https://themoviedb.org/person/19258"}}, {tmdbId:"19259", properties:{imdbId:"0101794", name:"Jan Gan Boyd", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lxAjrdR2SjnYz0kohjGGq8JaoLJ.jpg", url:"https://themoviedb.org/person/19259"}}, {tmdbId:"95217", properties:{bornIn:"New York City, New York, USA", imdbId:"0114659", born:date('1962-01-11'), name:"Sharon Brown", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3a7LdK60Mj0I7X1kTwfnXDHzcAS.jpg", url:"https://themoviedb.org/person/95217"}}, {tmdbId:"21245", properties:{bornIn:"Milan, Lombardy, Italy", imdbId:"0000627", born:date('1960-02-18'), name:"Greta Scacchi", bio:"From Wikipedia, the free encyclopedia\n\nIn 1982, she made her film debut in the German movie Das Zweite Gesicht (The Second Face) and gave versatile performances in films such as Heat and Dust (1983), The Ebony Tower (1984), The Coca Cola Kid (1985), White Mischief (1987), Presumed Innocent (1990), The Player (1992) and Country Life (1994).  She turned down the role of Catherine Trammell in Basic Instinct (1992)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dO6VAsDntKWT47HQqSjGZnPMdP0.jpg", url:"https://themoviedb.org/person/21245"}}, {tmdbId:"3070", properties:{bornIn:"Billericay - Essex - England", imdbId:"0371824", born:date('1948-07-24'), name:"Chris Haywood", bio:"From Wikipedia, the free encyclopedia.  Chris Haywood (born 24 July 1948) is an English-born, Australian-based film and televisionactor/producer. \n\nDescription above from the Wikipedia article Chris Haywood, licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/k2dxqzfQ59eu9HppQd9DQa4uX8o.jpg", url:"https://themoviedb.org/person/3070"}}, {tmdbId:"30621", properties:{bornIn:"Glen Cove, Long Island, New York, USA", imdbId:"0719037", born:date('1925-02-25'), name:"Bert Remsen", bio:"From Wikipedia, the free encyclopedia\n\nBert Remsen (February 25, 1925 – April 22, 1999) was an American actor. \n\nRemsen was born in Glen Cove, New York, on Long Island.  He played character roles in numerous films directed by Robert Altman, including: Brewster McCloud (1970), McCabe &amp; Mrs...", died:date('1999-04-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2KOnofFMvseWKyo5LWO1uS6mtMc.jpg", url:"https://themoviedb.org/person/30621"}}, {tmdbId:"86499", properties:{bornIn:"St. Louis, Missouri, USA", imdbId:"0312973", born:date('1942-04-26'), name:"Mike Genovese", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dXUyMI5u9kL2Xh6C3YlyX6VYQD6.jpg", url:"https://themoviedb.org/person/86499"}}, {tmdbId:"2047", properties:{bornIn:"San Francisco, California, USA", imdbId:"0000418", born:date('1946-07-22'), name:"Danny Glover", bio:"Danny Lebern Glover (born July 22, 1946) is an American actor, film director, and political activist.  Glover is perhaps best known for his roles as Detective Roger Murtaugh in the Lethal Weapon film franchise. \n\nDescription above from the Wikipedia article Danny Glover, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2PJbpI9AyuhG4SWUIDxZwuBnuMb.jpg", url:"https://themoviedb.org/person/2047"}}, {tmdbId:"13307", properties:{bornIn:"Mangum, Oklahoma, U.S.", imdbId:"0001923", born:date('1944-01-20'), name:"Margaret Avery", bio:"Margaret Avery (born January 20, 1944) is an American actress and singer.  She was nominated for an Academy Award for Best Actress in a Supporting Role for her performance as Shug in The Color Purple (1985). \n\nDescription above from the Wikipedia article Margaret Avery, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/13307"}}, {tmdbId:"13309", properties:{bornIn:"Kosciusko, Mississippi, USA", imdbId:"0001856", born:date('1954-01-29'), name:"Oprah Winfrey", bio:"Oprah Winfrey, born Orpah Gail Winfrey on January 29, 1954, is an American television host, actress, producer, and philanthropist, best known for her self-titled, multi-award winning talk show, which has become the highest-rated program of its kind in history.  She has been ranked the richest African American of the 20th century, the greatest black philanthropist in American history, and was once the world's only black billionaire...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nNpYieaDLxKZWw2FY9wsDkjwURu.jpg", url:"https://themoviedb.org/person/13309"}}, {tmdbId:"26491", properties:{bornIn:"Rushworth, Victoria, Australia", imdbId:"0920460", born:date('1945-12-31'), name:"Vernon Wells", bio:"From Wikipedia, the free encyclopedia\n\nVernon George Wells (born 31 December 1945) is an Australian film and television actor who has built his career around action-type films, most often cast as a villain.  He began appearing on Australian television shows in the mid-1970s, such as Homicide and Matlock Police and All The Rivers Run. \n\nHe is best known to international audiences for his role of \"Wez\", in the 1981 science fiction action film Mad Max 2: The Road Warrior...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Aw4DEv720LzEsv55CBFgADTr6qQ.jpg", url:"https://themoviedb.org/person/26491"}}, {tmdbId:"8436", properties:{bornIn:"Southport, Lancashire, UK", imdbId:"0001669", born:date('1958-03-03'), name:"Miranda Richardson", bio:"Miranda Jane Richardson is an English actor.  She made her film debut playing Ruth Ellis in Dance with a Stranger (1985) and went on to receive Academy Award nominations for Damage (1992) and Tom & Viv (1994).  A seven-time BAFTA Award nominee, she won the BAFTA Award for Best Actress in a Supporting Role for Damage.  She has also been nominated for seven Golden Globe Awards, winning twice for Enchanted April (1992) and the TV film Fatherland (1994)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hgowM36yQz9oBIq4qNyua2Jkz5K.jpg", url:"https://themoviedb.org/person/8436"}}, {tmdbId:"4757", properties:{bornIn:"Burnham Deepdale, Norfolk, England, UK", imdbId:"0000391", born:date('1959-05-29'), name:"Rupert Everett", bio:"Rupert James Hector Everett (born 29 May 1959) is an English actor.  He first came to public attention in 1981, when he was cast in Julian Mitchell's play and subsequent film \"Another Country\" as an openly gay student at an English public school, set in the 1930s.  He has since appeared in many other films including \"My Best Friend's Wedding\", \"An Ideal Husband\", \"The Next Best Thing\" and the \"Shrek\" sequels...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7t77pzlJnSLSXTzQLUey3YAzaxQ.jpg", url:"https://themoviedb.org/person/4757"}}, {tmdbId:"62757", properties:{imdbId:"1784116", name:"Matthew Carroll", url:"https://themoviedb.org/person/62757"}}, {tmdbId:"54853", properties:{bornIn:"Pittsburgh, Pennsylvania, USA", imdbId:"0136440", born:date('1954-07-15'), name:"Lori Cardille", bio:"​From Wikipedia, the free encyclopedia. \n\nLori Cardille (born 1954) is an American actress, best known for her lead role in George A.  Romero's Day of the Dead (1985).  Her father, Bill \"Chilly Billy\" Cardille, appeared as a reporter in the original Night of the Living Dead (1968)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n0xnxURr1aUUVDxXJ4YHHLh4SiY.jpg", url:"https://themoviedb.org/person/54853"}}, {tmdbId:"54854", properties:{bornIn:" Detroit, Michigan, USA", imdbId:"0018777", born:date('1943-03-23'), name:"Terry Alexander", bio:"Terry Alexander is an African American actor, who is best known for his role as John in George A.  Romero's 1985 film Day of the Dead.  He had a regular role on the soap opera One Life to Live in the early 1990s, as police chief Troy Nichols...", died:date('2018-05-01'), url:"https://themoviedb.org/person/54854"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"54855", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0683334", born:date('1949-03-16'), name:"Joseph Pilato", bio:"Joseph Pilato (March 16, 1949 - March 24, 2019) was an American film and voice actor...", died:date('2019-03-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/msCVPwTXO9jWOhY6IGb6FP8oH6b.jpg", url:"https://themoviedb.org/person/54855"}}, {tmdbId:"54856", properties:{bornIn:"Galway, Ireland", imdbId:"0175826", born:date('1944-09-30'), name:"Jarlath Conroy", bio:"​From Wikipedia, the free encyclopedia. \n\nJarlath Conroy is a theater, film and television actor.  Since 1971, he has become a successful actor appearing in film and television, including NYPD Blue, Law &amp; Order, and Law &amp; Order: Criminal Intent.  He also appeared in the movie Day of the Dead.  His most recent appearance is as the Undertaker in the 2010 remake of True Grit...", url:"https://themoviedb.org/person/54856"}}, {tmdbId:"87120", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0706298", born:date('1953-03-13'), name:"Deborah Raffin", bio:"Deborah Iona Raffin was an American model, film and television actress who later became an audiobook publisher...", died:date('2012-11-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/waUD19F931qCc7Evj5zxEQnyl6X.jpg", url:"https://themoviedb.org/person/87120"}}, {tmdbId:"4161", properties:{bornIn:"Valley Stream, Long Island, New York, USA", imdbId:"0001997", born:date('1959-04-19'), name:"Patricia Charbonneau", bio:"Patricia Charbonneau (born April 19, 1959) is an American actress, probably best known for playing the part of Cay Rivvers in Desert Hearts, her first film role. \n\nCharbonneau was born in Valley Stream, New York on Long Island.  She graduated in 1977 from Valley Stream Central High School, which she had attended with fellow actors Steve Buscemi and Steve Hytner, as well as writer Ed Renehan.  She later attended Boston University...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z0qQgrPp86Vzj8qkbYWVVU2eFHv.jpg", url:"https://themoviedb.org/person/4161"}}, {tmdbId:"164660", properties:{imdbId:"0015199", born:date('1943-09-16'), name:"Andra Akers", died:date('2002-03-20'), url:"https://themoviedb.org/person/164660"}}, {tmdbId:"3125", properties:{bornIn:"Bay City, Michigan, USA", imdbId:"0000187", born:date('1958-08-16'), name:"Madonna", bio:"Madonna (born Madonna Louise Ciccone) is a recording artist, actress and entrepreneur.  Born in Bay City, Michigan, she moved to New York City in 1977 to pursue a career in modern dance.  After performing in the music groups Breakfast Club and Emmy, she released her debut album in 1983.  She followed it with a series of albums in which she found immense popularity by pushing the boundaries of lyrical content in mainstream popular music and imagery in her music videos, which became a fixture on MTV...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pI6g1iVlUy7cUAZ6AspVXWq4kli.jpg", url:"https://themoviedb.org/person/3125"}}, {tmdbId:"14103", properties:{bornIn:"Newark, New Jersey, USA", imdbId:"0089685", born:date('1950-05-14'), name:"Mark Blum", bio:"Mark Blum (May 14, 1950 - March 26, 2020) was an American actor in movies, on television and stage. \n\nDescription above from the Wikipedia article Mark Blum, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2020-03-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dC82jVDW6H04nG65l6FRnbrB3ww.jpg", url:"https://themoviedb.org/person/14103"}}, {tmdbId:"77024", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0179830", born:date('1955-05-18'), name:"Caris Corfman", died:date('2007-01-13'), url:"https://themoviedb.org/person/77024"}}, {tmdbId:"69747", properties:{imdbId:"0889001", name:"Yara Vaneau", url:"https://themoviedb.org/person/69747"}}, {tmdbId:"69749", properties:{imdbId:"0735543", name:"William Rodriguez", url:"https://themoviedb.org/person/69749"}}, {tmdbId:"591", properties:{bornIn:"Redlands, California, USA", imdbId:"0001397", born:date('1945-02-20'), name:"Brion James", bio:"From Wikipedia, the free encyclopedia\n\nBrion Howard James (February 20, 1945 – August 7, 1999) was an American character actor.  Known for playing the character of Leon Kowalski in the movie Blade Runner, James portrayed a variety of colorful roles in well-known American films such as 48 Hrs. , Another 48 Hours, Tango &amp; Cash, Silverado, Red Heat, The Player and The Fifth Element.  James' commanding screen presence and formidable physique at 6 feet 3 inches (1...", died:date('1999-08-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xVsM99MWIXWELP3dZeOgaL9qcJk.jpg", url:"https://themoviedb.org/person/591"}}, {tmdbId:"70782", properties:{imdbId:"0546172", name:"Richard Marcus", bio:"​Richard Marcus is an actor best known for his roles in St.  Elsewhere, Tremors, and The Pretender...", url:"https://themoviedb.org/person/70782"}}, {tmdbId:"741", properties:{bornIn:"Metolius, Oregon USA", imdbId:"0000203", born:date('1970-08-23'), name:"River Phoenix", bio:"River Jude Phoenix (August 23, 1970 – October 31, 1993) was an up-and-coming movie star when he died suddenly of drug-induced heart failure in 1993 at the age of 23.  His brief career was marked by critically-acclaimed performances in films such as Stand by Me (1986), Running on Empty (1988) and Gus Van Sant's My Own Private Idaho (1991, with Keanu Reeves)...", died:date('1993-10-31'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pAvGUfWQOX1fNFQbE9jGEsu7QpL.jpg", url:"https://themoviedb.org/person/741"}}, {tmdbId:"59941", properties:{bornIn:"Dallas, Texas, USA", imdbId:"0280045", born:date('1968-10-22'), name:"Bobby Fite", bio:"​From Wikipedia, the free encyclopedia.   \n\nBobby Fite (born October 22, 1968) is an American film and television actor.  A professional child actor and model since the age of 12, he is best known for his recurring role as J. T.  Martin on the popular 1980s NBC sitcom Silver Spoons, as well as for his feature film roles in The Best Little Whorehouse in Texas, The Legend of Billie Jean, and Explorers...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zvHkJibEwxwqWmDGajG5WGTitRa.jpg", url:"https://themoviedb.org/person/59941"}}, {tmdbId:"3039", properties:{bornIn:"Hollywood, Los Angeles, California, USA", imdbId:"0339562", born:date('1966-11-08'), name:"Bradley Gregg", bio:"Bradley Gregg is an American actor, director, writer, and producer.  Gregg's first film was the 1985 movie Explorers, but his big role came in 1986 in the hit drama film Stand by Me as Eyeball Chambers, the older brother of River Phoenix's character (Gregg and Phoenix had both appeared previously in Explorers).  In 1987, Gregg starred in the hit horror film A Nightmare on Elm Street 3: Dream Warriors as Phillip Anderson...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wdutERs05CdWND79gtzXA8WVYrD.jpg", url:"https://themoviedb.org/person/3039"}}, {tmdbId:"6200", properties:{bornIn:"East Hartford, Connecticut, USA", imdbId:"0893204", born:date('1952-08-10'), name:"Diane Venora", bio:"Diane Venora (born August 10, 1952) is an American stage, television, and film actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/khADLFValSYFYCViYEgLe3W2I1B.jpg", url:"https://themoviedb.org/person/6200"}}, {tmdbId:"21624", properties:{bornIn:"Portland - Maine - USA", imdbId:"0000555", born:date('1959-11-28'), name:"Judd Nelson", bio:"From Wikipedia, the free encyclopedia. \n\nJudd Asher Nelson (born November 28, 1959, height 5' 10\" (1,78 m)) is an American actor.  He is best known for being a member of the \"Brat Pack\" in the mid-1980s; and for his roles as John Bender in The Breakfast Club, Alec Newbary in St.  Elmo's Fire, and Jack Richmond in Suddenly Susan...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7kRf8vE0ZjMuunh8BaD50B3EhS5.jpg", url:"https://themoviedb.org/person/21624"}}, {tmdbId:"8213", properties:{bornIn:"New York City - New York - USA", imdbId:"0730168", born:date('1961-12-16'), name:"Sam Robards", bio:"Sam Robards was born on December 16, 1961 in New York City, New York, USA as Sam Prideaux Robards.  He is an actor and producer, known for American Beauty (1999), A. I.  Artificial Intelligence (2001) and Awake (2007).  He has been married to Sidsel Jensen since November 8, 1997.  They have two children.  He was previously married to Suzy Amis...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bUXMGjSmgFabbvlU2V6jhLmehhx.jpg", url:"https://themoviedb.org/person/8213"}}, {tmdbId:"85965", properties:{bornIn:"New Orleans, Louisiana, U.S.", imdbId:"0124107", born:date('1961-07-01'), name:"Chuck Bush", bio:"From Wikipedia, the free encyclopedia. \n\nCharles R.  Bush III (born July 1, 1961 in Louisiana) is a filmmaker primarily known for co-starring with Kevin Costner in the 1985 film Fandango.  In recent years Bush has become known as an entertainment entrepreneur, expanding his business holdings to film and television companies, a record label and a video game development studios...", url:"https://themoviedb.org/person/85965"}}, {tmdbId:"58866", properties:{bornIn:"New York City, New York, USA", imdbId:"0923984", born:date('1960-10-09'), name:"Dana Wheeler-Nicholson", bio:"From Wikipedia, the free encyclopedia. \n\nDana Wheeler-Nicholson (born New York City, New York, October 9, 1960) is an American actress. \n\nSometimes credited as Dana Wheeler Nicholson, she has appeared in numerous movies, but is probably best known for her role in Fletch as Gail Stanwyk (wife of the villain and love interest of the title character played by Chevy Chase) and in Tombstone (1993) as Mattie Blaylock (Wyatt Earp's common law wife)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aAILOh8IYu6dgKI59CJqZBTUoHT.jpg", url:"https://themoviedb.org/person/58866"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"75020", properties:{bornIn:"Cincinnati, Ohio, United States", imdbId:"0313267", born:date('1964-11-22'), name:"Stephen Geoffreys", bio:"​From Wikipedia, the free encyclopedia.   \n\nStephen Geoffreys (born November 22, 1964) is an American actor. \n\nDescription above from the Wikipedia article Stephen Geoffreys, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/75020"}}, {tmdbId:"51577", properties:{bornIn:"Rochester, Minnesota, USA", imdbId:"0934136", born:date('1958-12-12'), name:"Sheree J. Wilson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bqooOGsmXKtjFCtKH57ZjsLl2h7.jpg", url:"https://themoviedb.org/person/51577"}}, {tmdbId:"106696", properties:{bornIn:"New Orleans, Louisiana, USA", imdbId:"0245650", born:date('1959-12-13'), name:"Cameron Dye", bio:"From Wikipedia, the free encyclopedia\n\nCameron Dye (born December 13, 1959) is an American actor.  He played \"Fred\" in the movie Valley Girl. \n\nDye was born in New Orleans, Louisiana.  Dye's family moved around the United States and in the mid 1970's he attended Sylvania High School in Sylvania, Ohio.  Later, Dye moved to California and attended Mills High School in Millbrae, California and UCLA.  He was married to actress Laura San Giacomo from 1990–1998...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1SMzbESTqZQHxgmW43zwzLfK1Zk.jpg", url:"https://themoviedb.org/person/106696"}}, {tmdbId:"58819", properties:{imdbId:"0057450", name:"Anthony Barrile", bio:"From Wikipedia, the free encyclopedia\n\nAnthony Barrile is an actor, musician, writer, and native New Yorker who has starred in many film and stage productions.  He is well known to New York audiences for his memorable performance as 'Cousin Kevin', the twisted lout in the original Broadway production of the Tony Award winning 'The Who's Tommy', and can be heard on its original cast recording...", url:"https://themoviedb.org/person/58819"}}, {tmdbId:"58820", properties:{imdbId:"0060822", name:"Suzanne Bateman", url:"https://themoviedb.org/person/58820"}}, {tmdbId:"58821", properties:{imdbId:"0105350", name:"Dominick Brascia", url:"https://themoviedb.org/person/58821"}}, {tmdbId:"2080", properties:{bornIn:"Santa Monica, California, USA", imdbId:"0117245", born:date('1963-10-08'), name:"Todd Bryant", bio:"Actor / Entertainer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sauMN1jgnOhafbxMytr2x42kBdG.jpg", url:"https://themoviedb.org/person/2080"}}, {tmdbId:"14541", properties:{bornIn:"Beckley, West Virginia, USA", imdbId:"0001697", born:date('1942-07-24'), name:"Chris Sarandon", bio:"An American actor best known for playing Prince Humperdinck in the film The Princess Bride, the vampire Jerry Dandridge in Fright Night and Detective Mike Norris in the first entry of the Child's Play series, and providing the speaking voice of Jack Skellington from The Nightmare Before Christmas.  He was nominated for an Academy Award for Best Supporting Actor for his performance as Leon in Dog Day Afternoon...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8O2DoO5e2mvIpJx12L0tmbWQKc4.jpg", url:"https://themoviedb.org/person/14541"}}, {tmdbId:"31467", properties:{bornIn:"El Dorado, Arkansas, USA", imdbId:"0706619", born:date('1961-01-19'), name:"William Ragsdale", bio:"From Wikipedia, the free encyclopedia. \n\nRobert William Ragsdale (born January 19, 1961) is an American actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dfZlyVdWXmdGcKazSikuzx81FL4.jpg", url:"https://themoviedb.org/person/31467"}}, {tmdbId:"18981", properties:{bornIn:"Winter Park, Florida, U.S.", imdbId:"0000294", born:date('1958-08-09'), name:"Amanda Bearse", bio:"From Wikipedia, the free encyclopedia\n\nAmanda Bearse (born August 9, 1958) is an American actor, director and comedian best known for her role as wacky neighbor Marcy D'Arcy (formerly Marcy Rhoades) on Married. . .  with Children, a sitcom that ran in the United States between 1987 and 1997, and for her performance in the 1985 horror film Fright Night opposite William Ragsdale...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vsigj6WmFdm6w7O7uA7UOWuxuxG.jpg", url:"https://themoviedb.org/person/18981"}}, {tmdbId:"104926", properties:{bornIn:"Standardville, Utah, USA", imdbId:"0487597", born:date('1949-10-15'), name:"Peter Liapis", bio:"Peter Liapis was born on July 23, 1949 in Standardville, Utah, USA.  He is an actor and writer, known for Alone with a Stranger (2000), Ghoulies (1985) and Ghoulies IV (1994)...", url:"https://themoviedb.org/person/104926"}}, {tmdbId:"115888", properties:{bornIn:"San Francisco, California, USA", imdbId:"0670852", born:date('1954-07-12'), name:"Lisa Pelikan", bio:"​From Wikipedia, the free encyclopedia.   \n\nLisa Pelikan (born July 12, 1954) is an American stage, film and television actress. \n\nShe was born in Berkley, California, the daughter of American parents Helen L. , a psychologist, and Robert G.  Pelikan, an international economist who served as the minister-counselor from the United States at the Organization for Economic Cooperation and Development in Paris.  She attended the Juilliard School with a full scholarship to its drama division...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9pA1C6RTJ9OT2S0J2xeOKxVqvl4.jpg", url:"https://themoviedb.org/person/115888"}}, {tmdbId:"65334", properties:{bornIn:"London - England - UK", imdbId:"0220735", born:date('1948-01-24'), name:"Michael Des Barres", bio:"Michael Des Barres is a European Marquis, raised in England and living in Los Angeles.  As the host of Little Steven's Underground Garage on SiriusXM Radio Channel 21, he is heard by more than six million listeners, five days a week (5am-8am and 9pm-midnight PT).  He has appeared in over 150 hours of American television and more than 40 feature films, and has sold over 7 million albums as both a recording artist and songwriter...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1XVPUgGP7xJC7IP4ALNltHx2C1c.jpg", url:"https://themoviedb.org/person/65334"}}, {tmdbId:"520", properties:{bornIn:"Nelsonville, Ohio, USA", imdbId:"0000572", born:date('1965-03-25'), name:"Sarah Jessica Parker", bio:"Sarah Jessica Parker (born March 25, 1965 in Nelsonville, Ohio) is an American film, television, and theater actress and producer.  She is best known for her leading role as Carrie Bradshaw on the HBO television series Sex and the City (1998–2004), for which she won four Golden Globe Awards, three Screen Actors Guild Awards, and two Emmy Awards...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pv65NTk8g4v7ZNd0ldi6QhEcJLa.jpg", url:"https://themoviedb.org/person/520"}}, {tmdbId:"1916", properties:{imdbId:"0947010", name:"Biff Yeager", url:"https://themoviedb.org/person/1916"}}, {tmdbId:"44691", properties:{bornIn:"Winnipeg, Manitoba, Canada", imdbId:"0599837", born:date('1961-11-03'), name:"Lee Montgomery", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dOx2CtMbhaIx3KGs1WPdKKzKIxp.jpg", url:"https://themoviedb.org/person/44691"}}, {tmdbId:"100462", properties:{imdbId:"0813858", born:date('1962-05-09'), name:"Kristi Somers", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hwAznDr412RnSFWeStLf4ijii37.jpg", url:"https://themoviedb.org/person/100462"}}, {tmdbId:"1328", properties:{bornIn:"Santa Monica, California, USA", imdbId:"0000276", born:date('1971-02-25'), name:"Sean Astin", bio:"Sean Astin (born February 25, 1971) is an American film actor, director, and producer better known for his film roles as Mikey Walsh in The Goonies, the title character of Rudy, and Samwise Gamgee in the Lord of the Rings trilogy.  In television, he appeared as Lynn McGill in the fifth season of 24.  Most recently, he provided the voice for the title character in Disney's Special Agent Oso...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ywH1VvdwqlcnuwUVr0pV0HUZJQA.jpg", url:"https://themoviedb.org/person/1328"}}, {tmdbId:"16851", properties:{bornIn:"Santa Monica, Los Angeles, California, USA", imdbId:"0000982", born:date('1968-02-12'), name:"Josh Brolin", bio:"Josh James Brolin is an American film, stage and television actor.  He has won acting awards for his roles in the films W. , No Country for Old Men, Milk and Wall Street: Money Never Sleeps.  He appeared in True Grit, a 2010 western film adaptation of the 1968 novel by Charles Portis. \n\nBrolin plays two characters in the Marvel Universe.  He portrays Thanos in Guardians of the Galaxy (2014), Avengers: Age of Ultron (2015), Avengers: Infinity War (2018), and Avengers: Endgame (2019)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sX2etBbIkxRaCsATyw5ZpOVMPTD.jpg", url:"https://themoviedb.org/person/16851"}}, {tmdbId:"57371", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0169480", born:date('1976-06-25'), name:"Jeff Cohen", bio:"From Wikipedia, the free encyclopedia\n\nJeffrey Bertan Cohen, JD (born June 25, 1974) is an American attorney and the founding partner of Cohen &amp; Gardner LLP.  In his youth, he was a child actor best remembered for appearing as Chunk in the 1985 Steven Spielberg production The Goonies. \n\nDescription above from the Wikipedia article Jeff Cohen (actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iuD0UN3cdRc9ZSnmebeJUy14lde.jpg", url:"https://themoviedb.org/person/57371"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"3034", properties:{bornIn:"Chatsworth, California, USA", imdbId:"0000397", born:date('1971-07-16'), name:"Corey Feldman", bio:"Corey Scott Feldman is an American film and television actor.  He became known during the 1980s, with roles in the Hollywood films Friday the 13th: The Final Chapter, The Goonies, Stand by Me, The Lost Boys, License to Drive, Dream a Little Dream, Gremlins and Teenage Mutant Ninja Turtles...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zXQXO7RepbajuzbCHyDuqj2B6FR.jpg", url:"https://themoviedb.org/person/3034"}}, {tmdbId:"9625", properties:{bornIn:"Philadelphia, Pennsylvania, USA", imdbId:"0000400", born:date('1958-03-09'), name:"Linda Fiorentino", bio:"Linda Fiorentino (born March 9, 1958) is an American actress.  She is known for her roles in films such as Dogma, Vision Quest, Men in Black, After Hours and The Last Seduction. \n\nDescription above from the Wikipedia article Linda Fiorentino, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aKadq5uC9CjCKtkMYPYECNcGz3s.jpg", url:"https://themoviedb.org/person/9625"}}, {tmdbId:"13657", properties:{bornIn:"New York City, New York, United States", imdbId:"0006987", born:date('1963-10-06'), name:"Jsu Garcia", bio:"​From Wikipedia, the free encyclopedia.   \n\nJsu Garcia (born October 6, 1963) is an American actor who has starred in many films and television shows.  In his earlier years, he was credited under the name Nick Corri.  Together with long time friend and NY Times #1 Bestseller author John-Roger, he runs both his own production company Scott J-R Productions and his own distribution company Gilgamesh LLC.  Garcia and John-Roger have created five films, including the successful Spiritual Warriors...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fXbhpqgxV5a2mnZykuwxc6ecGyF.jpg", url:"https://themoviedb.org/person/13657"}}, {tmdbId:"20752", properties:{bornIn:"Cambridge, Massachusetts, U.S.", imdbId:"0733678", born:date('1936-02-29'), name:"Alex Rocco", bio:"​From Wikipedia, the free encyclopedia.   \n\nAlex Rocco (born February 29, 1936) is an American actor.  His roles have ranged from comedy to playing gangsters in Mafia movies. \n\nDescription above from the Wikipedia article Alex Rocco, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2015-07-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/u2JStL4Pk9Huq1xmrjqezfysivt.jpg", url:"https://themoviedb.org/person/20752"}}, {tmdbId:"59136", properties:{bornIn:"Chacarita, Buenos Aires City, Argentina", imdbId:"0022765", born:date('1929-09-21'), name:"Héctor Alterio", bio:"Alterio es de ascendencia italiana, sus padres eran originarios de Carpinone, Nápoles.  Al finalizar sus estudios de arte dramático, crea la compañía Nuevo Teatro, que le supone ser un renovador de la escena argentina de la década de los '60.  Su debut en los escenarios se produjo mucho antes, en 1948, cuando protagonizóProhibido suicidarse en primavera una obra escrita en 1937 por Alejandro Casona.  En 1950 fundó la compañía Nuevo Teatro, la que tuvo a pleno rendimiento hasta 1968...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e7CwtmAOYvMp2ZWRBMtQfCuGQeF.jpg", url:"https://themoviedb.org/person/59136"}}, {tmdbId:"46853", properties:{bornIn:"Buenos Aires, Argentina", imdbId:"0001903", born:date('1936-05-02'), name:"Norma Aleandro", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qLtwbxkAC7j6m9jRqzQMoLy5f4g.jpg", url:"https://themoviedb.org/person/46853"}}, {tmdbId:"543805", properties:{imdbId:"0897693", name:"Chunchuna Villafañe", url:"https://themoviedb.org/person/543805"}}, {tmdbId:"228441", properties:{bornIn:"Buenos Aires, Argentina", imdbId:"0032955", born:date('1943-07-23'), name:"Hugo Arana", bio:"From Wikipedia, the free encyclopedia.   Hugo Arana (July 23, 1943 in Buenos Aires, Argentina) is an Argentinian film, television and theatre actor. \n\nArana grew up in Monte Grande and moved with his family to Lomas de Zamora and then Lanus.  He studied acting with Marcello Lavalle and Augusto Fernandez. \n\nIn his first years as an actor, he was part of a theatre group called \"Errare Humanum Est\" and he acted in films such as El Santo de la Espada (1970) and La tregua (1974)...", url:"https://themoviedb.org/person/228441"}}, {tmdbId:"97168", properties:{bornIn:"Philadelphia, Pennsylvania", imdbId:"0402556", born:date('1946-04-15'), name:"Marsha A. Hunt", bio:"From Wikipedia, the free encyclopedia\n\nMarsha Hunt (born April 15, 1946) is an American actress, novelist, singer and former model, who has lived mostly in Britain and Ireland.  She achieved national fame when she appeared in London as Dionne in the long-running rock musical Hair.  She enjoyed close relationships with Marc Bolan and Mick Jagger, who is the father of her only child Karis. \n\nAccording to Hunt, The Rolling Stones' controversial hit song \"Brown Sugar\" was based on her...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/luNJ5Ax0ZvCiGzCXJYVE6b5E4ek.jpg", url:"https://themoviedb.org/person/97168"}}, {tmdbId:"97878", properties:{bornIn:"Brooklyn, New York City, New York, USA", imdbId:"0528433", born:date('1940-02-12'), name:"Richard Lynch", died:date('2012-06-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/f8DLv1pSSG85xEwqxOHIPQDa6t4.jpg", url:"https://themoviedb.org/person/97878"}}, {tmdbId:"105623", properties:{imdbId:"0698697", name:"Melissa Prophet", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sBHstIj9AHHF6PvQmhT2J8Vgh0k.jpg", url:"https://themoviedb.org/person/105623"}}, {tmdbId:"166204", properties:{imdbId:"0952402", name:"Alexander Zale", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aF2FlguhvQmKHmN0hUOY8jW8c9b.jpg", url:"https://themoviedb.org/person/166204"}}, {tmdbId:"199158", properties:{name:"Maria Mayenzet", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8dysgEKUBijljKDze2P3EANylLa.jpg", url:"https://themoviedb.org/person/199158"}}, {tmdbId:"1315977", properties:{imdbId:"0042359", name:"Dave Austin", url:"https://themoviedb.org/person/1315977"}}, {tmdbId:"6783", properties:{bornIn:"Greece", imdbId:"0283754", born:date('1937-08-17'), name:"Spiros Focás", bio:"From Wikipedia, the free encyclopedia. \n\nSpiros Focás  (born 17 August 1937) is a Greek actor who, in a career extending for over half-century, has appeared in over two hundred films (Rambo III, The Jewel of the Nile) and episodes of television series. \n\nBorn in Patras, Greece's third-largest urban area and the regional capital of West Greece Periphery, Spiros Focás made his initial screen appearances at the age of 22, when he acted in four films produced in 1959...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nF68PRY7rm91bL5a8qfWroIs7pt.jpg", url:"https://themoviedb.org/person/6783"}}, {tmdbId:"1338", properties:{bornIn:"Hong Kong, British Crown Colony [now China]", imdbId:"0001041", born:date('1964-09-20'), name:"Maggie Cheung", bio:"Maggie Cheung Man yuk (born 20 September 1964) is a Hong Kong actress.  Raised in England and Hong Kong, she has over 70 films to her credit since starting her career in 1983.  Some of her most commercially successful work was in the action genre, but Cheung once said in an interview that of all the work she has done, the films that really meant something to her are Song of the Exile, Center Stage, Comrades: Almost a Love Story and In the Mood for Love...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kwwU8czSAfzc69TSs6GnqfD6G83.jpg", url:"https://themoviedb.org/person/1338"}}, {tmdbId:"56830", properties:{bornIn:"Taipei, Taiwan", imdbId:"0510857", born:date('1954-11-03'), name:"Brigitte Lin", bio:"Brigitte Lin Ching-hsia (Chinese: 林青霞; pinyin: Lín Qīngxiá; born 3 November 1954) is a Taiwanese actress.  She was a popular actress, regarded as an icon of Chinese cinema,[1] who acted in both Taiwanese and Hong Kong films.  She retired in 1994, although she had a minor role in the 1998 film Bishonen. \n\nShe was born in Taipei, and was \"discovered\" in 1972 by a film producer, and first appeared in many Taiwanese romance films based on the novels of Chiung Yao.  Her movie debut is in Chuangwai...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5mFoilHKhJ5JXOD2hwPXqbBcxuf.jpg", url:"https://themoviedb.org/person/56830"}}, {tmdbId:"56831", properties:{imdbId:"0482647", name:"Kwok-Hung Lam", url:"https://themoviedb.org/person/56831"}}, {tmdbId:"18706", properties:{bornIn:"Malibu, California, U.S.", imdbId:"0001694", born:date('1970-03-14'), name:"Meredith Salenger", bio:"From Wikipedia, the free encyclopedia. \n\nMeredith Dawn Salenger (born 14 March 1970) is an American actress identified by her performances while a teenager.  Her best known role was the title role in the 1985 Disney film The Journey of Natty Gann. \n\nDescription above from the Wikipedia article Meredith Salenger, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yr1I1ovBucHEx4ifuO8CGg6xZss.jpg", url:"https://themoviedb.org/person/18706"}}, {tmdbId:"53647", properties:{bornIn:"New York City, New York, USA", imdbId:"0443577", born:date('1940-05-15'), name:"Lainie Kazan", bio:"From Wikipedia, the free encyclopedia\n\nLainie Kazan (born May 15, 1940) is an American actress and singer. \n\nDescription above from the Wikipedia article Lainie Kazan, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/y3ZsHv8X84FYpGxM8x8nOlJk4qZ.jpg", url:"https://themoviedb.org/person/53647"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"91724", properties:{imdbId:"0405310", born:date('1957-12-20'), name:"Joyce Hyser", bio:"Hyser appeared in various films in the early 1980s, the last of which — Just One of the Guys (1985) — achieved some cult status.  She then mainly guest-starred in TV shows, including a recurring role in L. A.  Law as Jimmy Smits's girlfriend.  Hyser was interested in the role of Dr.  Melfi on The Sopranos, but the role went to Lorraine Bracco...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/maG38Xi4zYiHrg0VVGi1HyQR0PX.jpg", url:"https://themoviedb.org/person/91724"}}, {tmdbId:"91725", properties:{bornIn:"Palo Alto, California, USA", imdbId:"0737553", born:date('1957-08-05'), name:"Clayton Rohner", bio:"From Wikipedia, the free encyclopedia. \n\nClayton Rohner (born August 5, 1957) is an American actor.  He is known for his role as Rick Morehouse in the 1985 comedy movie Just One of the Guys.  He also starred in the 1986 film Modern Girls as Clifford and Bruno X.  He is a main character in the 1994 film Caroline at Midnight.  Other credits include the films April Fool's Day, Destroyer and The Relic.  Clayton starred in the short-lived science fiction series E. A. R. T. H.  Force and G vs E...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fFxWE9DpMvOAdegkWiT6ylwMkvF.jpg", url:"https://themoviedb.org/person/91725"}}, {tmdbId:"84164", properties:{bornIn:"Queens, New York City, New York, USA", imdbId:"0419747", born:date('1969-04-10'), name:"Billy Jayne", bio:"Billy Jayne (born April 10, 1969) is an American actor, musician, and director.  He has been in many films, and has sometimes been credited as Billy Jacoby.  His siblings, Scott Jacoby, Robert Jayne, Susan Jayne and Laura Jacoby, are also actors. \n\nDescription above from the Wikipedia article Billy Jayne, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a36CEs8fyfW4wnaBsUb37Hznen7.jpg", url:"https://themoviedb.org/person/84164"}}, {tmdbId:"91726", properties:{imdbId:"0399981", name:"Toni Hudson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cyt98xAepqJFb26K4JFFAFbvchv.jpg", url:"https://themoviedb.org/person/91726"}}, {tmdbId:"4430", properties:{bornIn:"Meadville, Pennsylvania, USA", imdbId:"0000232", born:date('1958-03-10'), name:"Sharon Stone", bio:"Sharon Vonne Stone (born March 10, 1958) is an American actress, producer, and former fashion model.  She is the recipient of a Primetime Emmy Award and a Golden Globe Award, as well as having received nominations for an Academy Award and two Screen Actors Guild Awards. \n\nAfter modelling in television commercials and print advertisements, she made her film debut as an extra in Woody Allen's comedy-drama Stardust Memories (1980)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iR0lIYGTFFLzViK7s0xIzUfo8FI.jpg", url:"https://themoviedb.org/person/4430"}}, {tmdbId:"655", properties:{bornIn:"Ammanford, Wales, UK", imdbId:"0722636", born:date('1944-05-05'), name:"John Rhys-Davies", bio:"​From Wikipedia, the free encyclopedia.    John Rhys-Davies (born 5 May 1944) is a Welsh actor and vocal artist.  He is perhaps best known for playing the charismatic Arab excavator Sallah in the Indiana Jones films and the dwarf Gimli in The Lord of the Rings trilogy, in which he also voiced the ent, Treebeard...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dvT1NPY8CXIVQh0O1h6rpfYOgKz.jpg", url:"https://themoviedb.org/person/655"}}, {tmdbId:"77298", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0846818", born:date('1964-06-27'), name:"Taimak", bio:"From Wikipedia, the free encyclopedia\n\nTaimak (pronounced Tie-Mock) Guarriello (born June 27, 1964) is a martial arts actor and stuntman, best known as Leroy Green in the 1985 martial arts film The Last Dragon.  He was born in New York, to an African American mother, and an Italian father. \n\nDescription above from the Wikipedia article Taimak, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7YE1553cDszFMJHv6ePXoHAhiUD.jpg", url:"https://themoviedb.org/person/77298"}}, {tmdbId:"45481", properties:{bornIn:"Niagara Falls, Ontario, Canada", imdbId:"0889152", born:date('1959-01-04'), name:"Vanity", bio:"​From Wikipedia, the free encyclopedia.   \n\nDenise Katrina Matthews (born January 4, 1959), better known as Vanity, but sometimes credited as Denise Matthews-Smith or D. D.  Winters, is a Canadian-born Christian preacher and a former singer, songwriter, dancer, actress, and model from the 1980s until the early mid-90s.  She was the lead singer for the female trio Vanity 6, which recorded the 1982 R&amp;B hit \"Nasty Girl\"...", died:date('2016-02-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h658FXl2lShOPmiOeuQPlQsuOS8.jpg", url:"https://themoviedb.org/person/45481"}}, {tmdbId:"4256", properties:{bornIn:"Narragansett, Rhode Island, USA", imdbId:"0613997", born:date('1943-07-20'), name:"Christopher Murney", bio:"From Wikipedia, the free encyclopedia\n\nChristopher Murney (born July 20, 1943) is an American actor and vocal artist.  He is the father of singer and actress Julia Murney. \n\nMurney attended several universities before picking up several undergraduate degrees (in Business Administration, Speech, and in Drama), and one graduate level degree (Master of Fine Arts in Theatre from Pennsylvania State University). \n\nMurney has worked on the stage, in television series, and in movies...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kvQoimcKxNX5ow2yOmwK0UnmkKv.jpg", url:"https://themoviedb.org/person/4256"}}, {tmdbId:"77299", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0141114", born:date('1952-03-12'), name:"Julius Carry", bio:"From Wikipedia, the free encyclopedia\n\nJulius J.  Carry III (March 12, 1952 – August 19, 2008) was an American actor.  Carry appeared primarily in numerous television roles, including Dr.  Abraham Butterfield on Doctor, Doctor and the bounty hunter Lord Bowler in the The Adventures of Brisco County, Jr.  He also portrayed the main villain Sho'nuff in the cult classic film The Last Dragon...", died:date('2008-08-19'), url:"https://themoviedb.org/person/77299"}}, {tmdbId:"29091", properties:{bornIn:"Brooklyn Heights, New York, USA", imdbId:"0000214", born:date('1967-06-19'), name:"Mia Sara", bio:"Mia Sarapochiello (born June 19, 1967) better known as Mia Sara, is an American actress best known for her roles as Ferris Bueller's girlfriend, Sloane Peterson, in Ferris Bueller's Day Off (1986), as Jean Claude Van Damme's wife Melissa Walker in Timecop (1996), and as Lily, playing opposite Tom Cruise in Legend (1985), her first feature film role. \n\nDescription above from the Wikipedia article Mia Sara, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eu9mPnRpSac8mU4JcHfQfhQsgTc.jpg", url:"https://themoviedb.org/person/29091"}}, {tmdbId:"6637", properties:{bornIn:"Farnworth, Lancashire, UK", imdbId:"0277975", born:date('1926-08-06'), name:"Frank Finlay", bio:"Frank received Academy Award, Golden Globe and BAFTA Award nominations for his performance as William Shakespeare’s Iago in Stuart Burge’s 1965 film of Laurence Olivier’s staging of Othello.  He also won the Best Actor Award at the San Sebastian International Film Festival...", died:date('2016-01-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fz3sIozTo0L1eCKlwHdoe92dcXk.jpg", url:"https://themoviedb.org/person/6637"}}, {tmdbId:"44233", properties:{bornIn:"Saint Ouen, Seine Saint Denis, France", imdbId:"0000528", born:date('1965-02-08'), name:"Mathilda May", bio:"Born on February 8, 1965 in Saint-Ouen, Seine-Saint-Denis, France as Karima Mathilda Haim.  She is known for her work on Lifeforce (1985), The Jackal (1997) and Le cri du hibou (1987)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5UioWGneyS8mUo5qy3Vvxq7DtSO.jpg", url:"https://themoviedb.org/person/44233"}}, {tmdbId:"1124503", properties:{imdbId:"0268164", name:"Sylvia Farrel", url:"https://themoviedb.org/person/1124503"}}, {tmdbId:"1124504", properties:{imdbId:"0454202", name:"Tina Kincaid", url:"https://themoviedb.org/person/1124504"}}, {tmdbId:"1001970", properties:{imdbId:"0168284", name:"Adam Cockburn", url:"https://themoviedb.org/person/1001970"}}, {tmdbId:"1459", properties:{bornIn:"Nutbush, Tennessee, USA", imdbId:"0877913", born:date('1939-11-26'), name:"Tina Turner", bio:"​From Wikipedia, the free encyclopedia. \n\nTina Turner  (born Anna Mae Bullock; November 26, 1939) is an American singer and actress whose career has spanned more than 50 years.  She has won numerous awards and her achievements in the rock music genre have earned her the title The Queen of Rock 'n' Roll.  Turner started out her music career with husband Ike Turner as a member of the Ike &amp; Tina Turner Revue...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hUrDDxj4sWiGSepdJa8zEIerzvQ.jpg", url:"https://themoviedb.org/person/1459"}}, {tmdbId:"5223", properties:{imdbId:"0834130", name:"Tim Streeter", url:"https://themoviedb.org/person/5223"}}, {tmdbId:"5218", properties:{imdbId:"0176845", name:"Doug Cooeyate", url:"https://themoviedb.org/person/5218"}}, {tmdbId:"5221", properties:{imdbId:"0598017", name:"Ray Monge", url:"https://themoviedb.org/person/5221"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"5220", properties:{imdbId:"0565279", name:"Nyla McCarthy", url:"https://themoviedb.org/person/5220"}}, {tmdbId:"16431", properties:{bornIn:"Sacramento, California, USA", imdbId:"0000385", born:date('1944-08-09'), name:"Sam Elliott", bio:"Samuel Pack \"Sam\" Elliott (born August 9, 1944) is an American actor. \n\nHis rangy physique, thick horseshoe moustache, and deep, resonant voice (with a Western twang/drawl) match the iconic image of a cowboy or rancher, and he has often been cast in such roles...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1K2IvGXFbKsgkExuUsRvy4F0c9e.jpg", url:"https://themoviedb.org/person/16431"}}, {tmdbId:"7036", properties:{bornIn:"Whittier, California, USA", imdbId:"0000655", born:date('1961-09-30'), name:"Eric Stoltz", bio:"​From Wikipedia, the free encyclopedia\n\nEric Hamilton Stoltz (born September 30, 1961) is an American actor and director.  He is known for playing sensitive misfits (Mask, Kicking and Screaming, The Waterdance, Killing Zoe).  He was nominated for a Golden Globe Award for Best Supporting Actor in a Motion Picture for Mask.  He recently starred in the science fiction television series Caprica...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sP5tI3NVHrhmle5qotVz9q2mWfR.jpg", url:"https://themoviedb.org/person/7036"}}, {tmdbId:"59956", properties:{bornIn:"New York City, New York, USA", imdbId:"0001268", born:date('1923-07-25'), name:"Estelle Getty", bio:"From Wikipedia, the free encyclopedia\n\nEstelle Scher-Gettleman (July 25, 1923 – July 22, 2008), better known by her stage name Estelle Getty, was an American actress, who appeared in film, theatre and television.  She is best known for her role as Sophia Petrillo on The Golden Girls from 1985 to 1992, which won her an Emmy and a Golden Globe, on The Golden Palace from 1992 to 1993 and on Empty Nest from 1993 to 1995.  In her later years, after retiring from acting, she battled Lewy body dementia...", died:date('2008-07-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zaYz50QUVBABmFDSh5fy5y45Qi0.jpg", url:"https://themoviedb.org/person/59956"}}, {tmdbId:"56391", properties:{bornIn:"Copenhagen - Denmark", imdbId:"0321764", born:date('1974-04-11'), name:"Anton Glanzelius", bio:"Anton Glanzelius is a Swedish actor.   Of Danish descent on his father's side, he was born in Copenhagen but grew up in Gothenburg, Sweden.   For his role in 'My Life as a Dog' he won the Guldbagge Award for Best Actor.   Glanzelius is currently the Deputy Channel Director for The Swedish TV4 Group...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pEm0MeWQ1QEyU4OkVmOjmCTAE9V.jpg", url:"https://themoviedb.org/person/56391"}}, {tmdbId:"56392", properties:{bornIn:"Örgryte, Västra Götalands län, Sweeden", imdbId:"0902059", born:date('1943-05-08'), name:"Tomas von Brömssen", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/21vb1pl4Y9VfDpvBsz54YLx6nUN.jpg", url:"https://themoviedb.org/person/56392"}}, {tmdbId:"56393", properties:{bornIn:"Mölltorp, Västra Götalands Län, Sweden", imdbId:"0509258", born:date('1947-04-06'), name:"Anki Lidén", bio:"She has appeared in more than 50 films and television shows since 1971.  She is the mother of Tim Bergling, better known as Avicii...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oVTXH33SgZGvSamiPh53UMRyvRS.jpg", url:"https://themoviedb.org/person/56393"}}, {tmdbId:"231318", properties:{bornIn:"Stockholm, Stockholms län, Sweden", imdbId:"0455688", born:date('1971-11-09'), name:"Melinda Kinnaman", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i3VTmcAY0FDmvO8TrKkIKlRRj9E.jpg", url:"https://themoviedb.org/person/231318"}}, {tmdbId:"141452", properties:{imdbId:"0668954", name:"Joanne Pearce", url:"https://themoviedb.org/person/141452"}}, {tmdbId:"18065", properties:{bornIn:"Benton, Newcastle-upon-Tyne, England, UK", imdbId:"0619700", born:date('1954-03-16'), name:"Jimmy Nail", bio:"Jimmy Nail (born 16 March 1954) is an English singer-songwriter, actor and musician. \n\nHe has starred in numerous roles on television since 1983.  He is 6'3\" tall and a Newcastle United F. C.  supporter.  He is most famous for his role as Leonard \"Oz\" Osbourne in the hit television show Auf Wiedersehen, Pet, his title role in Spender, and his 1992 number one single \"Ain't No Doubt\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nsQI0Q78UtlQqSC5dKjIbMJyinW.jpg", url:"https://themoviedb.org/person/18065"}}, {tmdbId:"141453", properties:{imdbId:"0101424", name:"Paul Bown", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w5OmJtF0Ouipcfhqn5tB6mgrxbE.jpg", url:"https://themoviedb.org/person/141453"}}, {tmdbId:"50464", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0450116", born:date('1949-10-25'), name:"Brian Kerwin", bio:"Brian Kerwin (born October 25, 1949) is an American actor. \n\nBorn in Chicago, Illinois, Kerwin won the Theatre World Award in 1988 for the off-Broadway play Emily.  His Broadway theatre credits include the 1997 revival of The Little Foxes and the Elaine May comedy After the Night and the Music in 2005...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4OSrhPMEkRHcDXEkXba0FxF0WQD.jpg", url:"https://themoviedb.org/person/50464"}}, {tmdbId:"82220", properties:{bornIn:"North Hollywood, Los Angeles, California, USA", imdbId:"0903272", born:date('1966-12-21'), name:"Danielle von Zerneck", bio:"From Wikipedia, the free encyclopedia. \n\nDanielle von Zerneck (born December 21, 1965) in North Hollywood, Los Angeles, is an American film and television actress.  She is best remembered for her portrayal of Donna, Ritchie Valens blonde girlfriend in La Bamba (1987).  She is the daughter of Frank von Zerneck, a well known television film producer. \n\nDescription above from the Wikipedia article Danielle von Zerneck, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bGzuPQgs2Xvptiydgf9qtYp3W1A.jpg", url:"https://themoviedb.org/person/82220"}}, {tmdbId:"97943", properties:{bornIn:"New York City - New York - USA", imdbId:"0768620", born:date('1964-02-12'), name:"Raphael Sbarge", bio:"​From Wikipedia, the free encyclopedia.   \n\nRaphael Sbarge (born February 12, 1964) is an American actor and voice actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jOm9Yd5VKiCA2RX2q16fPXwCMAs.jpg", url:"https://themoviedb.org/person/97943"}}, {tmdbId:"69344", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0384162", born:date('1964-05-06'), name:"Dana Hill", bio:"From Wikipedia, the free encyclopedia. \n\nDana Hill (born Dana Lynne Goetz; May 6, 1964 – July 15, 1996) was an American actress and voice actor with a raspy voice and childlike appearance, which allowed her to play adolescent roles into her 30s.  Hill is perhaps best known for playing Audrey Griswold in National Lampoon's European Vacation and Sherry Dunlap in Shoot the Moon...", died:date('1996-07-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kLFYJSiPfBmXTla2MKInPi4YAqX.jpg", url:"https://themoviedb.org/person/69344"}}, {tmdbId:"69345", properties:{imdbId:"0515128", born:date('1968-03-12'), name:"Jason Lively", bio:"Jason Lively, standing in at 6' 2\" (1. 88 m), was born on March 12, 1968 to Elaine Lively, a talent manager and her first husband Ronnie Lively.  He is the brother of Lori Lively and Robyn Lively, and older half-brother of Eric Lively and Blake Lively.  He is an actor and director, known for National Lampoon's European Vacation (1985), Night of the Creeps (1986) and The Dukes of Hazzard (1979).  He is married to Lani.  They have two children...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zLU4UL8oPlSzCmeY3DCBA2yulQV.jpg", url:"https://themoviedb.org/person/69345"}}, {tmdbId:"62018", properties:{bornIn:"Riverside, Missouri, USA", imdbId:"0666593", born:date('1958-09-22'), name:"Mark Patton", bio:"Mark Patton (born September 22, 1958) is an American interior designer and former actor.  Patton grew up in Riverside, Missouri and, after graduating high school, he moved to New York City to pursue an acting career.  Within a few years he landed the role of Joe Qualley in the 1982 Broadway production of Come Back to the Five and Dime, Jimmy Dean, Jimmy Dean.  Patton reprised the role in the 1982 film of the same name...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5v6dcMn2WXYPJRqHrIkOzwoxW7M.jpg", url:"https://themoviedb.org/person/62018"}}, {tmdbId:"55958", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0616766", born:date('1966-02-15'), name:"Kim Myers", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ksCkQ3X8asFTRAHPKaoKmp9yALv.jpg", url:"https://themoviedb.org/person/55958"}}, {tmdbId:"52306", properties:{bornIn:"Fort Wayne, Indiana, USA", imdbId:"0750852", born:date('1965-09-20'), name:"Robert Rusler", bio:"​From Wikipedia, the free encyclopedia.   \n\nRobert Rusler (born September 20, 1965) is an American film and television actor. \n\nRusler was born in Fort Wayne, Indiana, the son of Maria Elena (née Varela) and Richard C.  Rusler.  He moved to Waikiki Beach in Hawaii, where he started surfing and skateboarding on a semi-professional level, competiting in local tournaments.  Then he and his family moved to Los Angeles, where he studied martial arts and entered many competitions...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dZ9ZU5afsftWHThl3YmoekhzJNA.jpg", url:"https://themoviedb.org/person/52306"}}, {tmdbId:"206", properties:{bornIn:"Newmarket, Ontario, Canada", imdbId:"0000120", born:date('1962-01-17'), name:"Jim Carrey", bio:"James Eugene \"Jim\" Carrey is a Canadian-American actor, comedian, singer and writer.  He has received two Golden Globe Awards and has also been nominated on four occasions. \n\nCarrey began stand-up comedy in 1979, performing at Yuk Yuk's in Toronto, Ontario.  After gaining prominence in 1981, he began working at The Comedy Store in Los Angeles where he was soon noticed by comedian Rodney Dangerfield, who immediately signed him to open his tour performances...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ienbErTKd9RHCV1j7FJLNEWUAzn.jpg", url:"https://themoviedb.org/person/206"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"145747", properties:{bornIn:"Ridgefield, Connecticut, USA", imdbId:"0465789", born:date('1958-10-10'), name:"Karen Kopins", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4RYiBWqMJx3dKu7O7Q4hPM6Ixfw.jpg", url:"https://themoviedb.org/person/145747"}}, {tmdbId:"96228", properties:{bornIn:"Edmonton - Alberta - Canada", imdbId:"0059630", born:date('1959-03-16'), name:"Gary Basaraba", bio:"From Wikipedia, the free encyclopedia\n\nGary Basaraba (born March 16, 1959) is a Canadian actor best known for playing American police officers.  He appeared as Sergeant Richard Santoro on Steven Bochco's Brooklyn South and Officer Ray Heckler on Boomtown. \n\nAccording to the DVD commentary for the first season of the police drama Boomtown, he did most of his driving stunts in the series and he made sure he accurately portrayed police procedures...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dH6zocqD5heDerhCANUtfy00gHm.jpg", url:"https://themoviedb.org/person/96228"}}, {tmdbId:"10648", properties:{bornIn:"Leicester, Leicestershire, England, UK", imdbId:"0457655", born:date('1948-10-31'), name:"Michael Kitchen", bio:"Michael Kitchen (born 31 October 1948 in Leicester) is an English actor and television producer, best known for his starring role as DCS Foyle in the British TV series Foyle's War. \n\nDescription above from the Wikipedia article Michael Kitchen, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gssCZjXmRcRhuOrGOR9cwd6TcXj.jpg", url:"https://themoviedb.org/person/10648"}}, {tmdbId:"2969", properties:{bornIn:"Los Angeles - California - USA", imdbId:"0001606", born:date('1965-10-10'), name:"Chris Penn", bio:"Christopher Shannon \"Chris\" Penn (October 10, 1965 – January 24, 2006) was an American film and television actor known for his roles in such films as The Wild Life, Reservoir Dogs, Footloose, Rush Hour, True Romance, All the Right Moves and Pale Rider. \n\nDescription above from the Wikipedia article Chris Penn, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2006-01-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oglIon8B0nRvroShuMChPe5Vfwk.jpg", url:"https://themoviedb.org/person/2969"}}, {tmdbId:"5129", properties:{bornIn:"Peekskill, New York, USA", imdbId:"0000607", born:date('1952-08-27'), name:"Paul Reubens", bio:"From Wikipedia, the free encyclopedia\n\nPaul Reubens (born Paul Rubenfeld; August 27, 1952) is an American actor, writer, film producer, game show host, and comedian, best known for his character Pee-wee Herman.  Reubens joined the Los Angeles troupe The Groundlings in the 1970s and started his career as an improvisational comedian and stage actor.  In 1982 he began appearing in a show about a character he had been developing for years...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7T0ExonMf6PAvphKVaTm73BXdLW.jpg", url:"https://themoviedb.org/person/5129"}}, {tmdbId:"44818", properties:{bornIn:"Oklahoma City, Oklahoma, USA", imdbId:"0392625", born:date('1958-07-19'), name:"Mark Holton", bio:"​From Wikipedia, the free encyclopedia.   \n\nMark Holton is an American actor. \n\nDescription above from the Wikipedia article Mark Holton, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2NleIh4ohQcw9M5i8mNYzq5qqwE.jpg", url:"https://themoviedb.org/person/44818"}}, {tmdbId:"5131", properties:{bornIn:" Philadelphia, Pennsylvania, USA", imdbId:"0758405", born:date('1951-01-25'), name:"Diane Salinger", bio:"Diane Louise Salinger is an American actress and voice actress...", url:"https://themoviedb.org/person/5131"}}, {tmdbId:"3434", properties:{bornIn:"Cananea Sonora, Mexico", imdbId:"0069608", born:date('1919-08-22'), name:"Alma Beltran", died:date('2007-06-09'), url:"https://themoviedb.org/person/3434"}}, {tmdbId:"106803", properties:{bornIn:"Nueva Gerona, Isla de Pinos, Cuba", imdbId:"0910112", born:date('1933-01-24'), name:"Perla Walter", bio:"Former Actress...", died:date('2007-05-19'), url:"https://themoviedb.org/person/106803"}}, {tmdbId:"157078", properties:{imdbId:"0603740", name:"Gina Morelli", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3C9jpMpPXFuqd3SL4cpOvBkJg1q.jpg", url:"https://themoviedb.org/person/157078"}}, {tmdbId:"4391", properties:{bornIn:"Redditch, Worcestershire, Engeland, UK", imdbId:"0001097", born:date('1946-10-10'), name:"Charles Dance", bio:"Charles Dance (born October 10, 1946) is an English actor, screenwriter and director.  He typically plays assertive bureaucrats or villains.  He is probably most famous for his roles in Game of Thrones, The Jewel in the Crown, Alien 3 and for playing the one-eyed hitman Mr Benedict in Last Action Hero. \n\nCharles was appointed an Officer of the Order of the British Empire (OBE) on 17 June 2006...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xV3TX1E1N7bAbkQOS3ZxHW5A3u7.jpg", url:"https://themoviedb.org/person/4391"}}, {tmdbId:"30364", properties:{bornIn:"Slough, Berkshire, England, UK", imdbId:"0001808", born:date('1959-12-30'), name:"Tracey Ullman", bio:"​From Wikipedia, the free encyclopedia. \n\nTracey Ullman (born 30 December 1959) is an English-born stage and television actress, comedian, singer, dancer, screenwriter and author. \n\nHer early appearances were on British TV sketch comedy shows A Kick Up the Eighties (with Rik Mayall and Miriam Margolyes) and Three of a Kind (with Lenny Henry and David Copperfield).  After a brief singing career, she appeared as Candice Valentine in Girls On Top with Dawn French and Jennifer Saunders...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2gg9R0npVJryYbYFpR1i8QrNjQY.jpg", url:"https://themoviedb.org/person/30364"}}, {tmdbId:"57353", properties:{bornIn:"Lancaster, Ohio, USA", imdbId:"0333701", born:date('1950-04-16'), name:"David Graf", bio:"Paul David Graf (April 16, 1950 – April 7, 2001) was an American actor, best known for his role as Sgt.  Eugene Tackleberry in the Police Academy series of films.  He married Kathryn Graf in 1985; they had two sons, Daniel and Sean. \n\nDescription above from the Wikipedia article David Graf, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2001-04-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iLhtOtkLwwGqMxmCHJBDpvUUHh0.jpg", url:"https://themoviedb.org/person/57353"}}, {tmdbId:"14672", properties:{bornIn:"Spokane, Washington, U.S.", imdbId:"0935498", born:date('1958-09-06'), name:"Michael Winslow", bio:"​From Wikipedia, the free encyclopedia\n\nMichael Winslow (born September 6, 1958) is an American actor and a comedian known as the \"Man of 10,000 Sound Effects\" for his ability to make realistic sound effects using only his voice.  He lives in Winter Springs, Florida, an outlying suburb of Orlando. \n\nDescription above from the Wikipedia article Michael Winslow, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uSRS2MOI1fNFAdvUgrhatBvfsvv.jpg", url:"https://themoviedb.org/person/14672"}}, {tmdbId:"3010", properties:{imdbId:"0304393", born:date('1959-10-21'), name:"Tony Ganios", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AmYgThhIQv7KwzDyFW08C4Xcbcx.jpg", url:"https://themoviedb.org/person/3010"}}, {tmdbId:"1486746", properties:{name:"Lori Bowen", url:"https://themoviedb.org/person/1486746"}}, {tmdbId:"2602964", properties:{name:"Carla Dunlap", url:"https://themoviedb.org/person/2602964"}}, {tmdbId:"8447", properties:{bornIn:"Athens, Georgia, USA", imdbId:"0001099", born:date('1955-02-19'), name:"Jeff Daniels", bio:"Jeffrey Warren \"Jeff\" Daniels (born February 19, 1955) is an American actor, musician and playwright.  He founded a non-profit theatre company, the Purple Rose Theatre Company, in his home state of Michigan.  He has performed in a number of stage productions, both on and off Broadway.  He has been nominated for the Tony Award as Best Actor for the Broadway play God of Carnage (2009), along with his other three cast-mates...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/r0mkZJZnTSJO3HJRsMW5HtszxE8.jpg", url:"https://themoviedb.org/person/8447"}}, {tmdbId:"1004", properties:{bornIn:"Manhattan, New York City, New York, USA", imdbId:"0000732", born:date('1933-06-20'), name:"Danny Aiello", bio:"​From Wikipedia, the free encyclopedia\n\nDaniel Louis Aiello Jr.  (June 20, 1933 – December 12, 2019) was an American actor who appeared in numerous motion pictures, including The Godfather Part II (1974), The Front (1976), Once Upon a Time in America (1984), The Purple Rose of Cairo (1985), Moonstruck (1987), Harlem Nights (1989), Hudson Hawk (1991), Ruby (1992), Léon: The Professional (1994), 2 Days in the Valley (1996), Dinner Rush (2000), and Lucky Number Slevin (2006)...", died:date('2019-12-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vl71InQaqL3khAPJrvUjsxtynVP.jpg", url:"https://themoviedb.org/person/1004"}}, {tmdbId:"12857", properties:{imdbId:"0582778", name:"Irving Metzman", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fh2mMxOCqx2eENBkM0Qb87JlIqY.jpg", url:"https://themoviedb.org/person/12857"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"64091", properties:{bornIn:"Worthing, West Sussex, England", imdbId:"0492649", born:date('1941-02-12'), name:"Bruno Lawrence", bio:"Born David Charles Lawrence in Worthing, West Sussex, England, he migrated with his family to New Zealand in 1946, settling in New Plymouth before moving to Wellington in 1948. \n\nLawrence spent most of his life in New Zealand, but also worked extensively in Australia.  He was a renowned jazz and rock drummer, playing drums in many bands, including Max Merritt &amp; The Meteors, Quincy Conserve,Blerta, and The Crocodiles...", died:date('1995-06-10'), url:"https://themoviedb.org/person/64091"}}, {tmdbId:"64092", properties:{imdbId:"0746147", born:date('1960-04-29'), name:"Alison Routledge", bio:"The globetrotting daughter of an English army officer, Alison Routledge  moved to NZ as a teen.  After winning a place at Drama School on a dare,  Routledge scored lead roles in TV’s The Garden Party (1983) and end-of-the-world classic The Quiet Earth.  Since then the singer and ex-Wildtrack presenter has acted in ghost tale The Returning, acclaimed movie Rain, and played a memorably loopy Mum in 2005 short Nothing Special...", url:"https://themoviedb.org/person/64092"}}, {tmdbId:"7249", properties:{imdbId:"0809572", name:"Pete Smith", bio:"Pete is one of New  Zealand's most well-known and respected Maori actors.  He has been  working in the industry as an actor, writer, producer, director and  voice artist for over 20 years.  Pete helped set up the production  company Puriri Films, where  works as a producer, director, writer and  presenter...", url:"https://themoviedb.org/person/7249"}}, {tmdbId:"64093", properties:{imdbId:"0908525", name:"Anzac Wallace", bio:"Anzac Wallace made one of the most memorable debuts in New Zealand  cinema when he starred as avenging guerilla leader Te Wheke in Geoff  Murphy's 1983 'Puha Western' Utu.  The former trade union delegate followed it with roles in movies The Silent One (1984), Mauri (1988) and pioneering Māori TV series E Tipu E Rea...", died:date('2019-04-08'), url:"https://themoviedb.org/person/64093"}}, {tmdbId:"16119", properties:{bornIn:"Scottsville, Kentucky, USA", imdbId:"0621008", born:date('1936-04-12'), name:"Charles Napier", bio:"From Wikipedia, the free encyclopedia. \n\nCharles L.  Napier (born April 12, 1936) is an American actor, known for his portrayals of square-jawed tough guys and military types. \n\nDescription above from the Wikipedia article Charles Napier (actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2011-10-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w16LEJlHDtqGWeFCk5a7a2GDeBK.jpg", url:"https://themoviedb.org/person/16119"}}, {tmdbId:"782", properties:{imdbId:"0000925", born:date('1937-08-03'), name:"Steven Berkoff", bio:"​From Wikipedia, the free encyclopedia.   \n\nSteven Berkoff (born 3 August 1937) is an English actor, writer and director. Best known for his performance as General Orlov in the James Bond film Octopussy, he is typically cast in villanous roles, such as Lt.  Col Podovsky in Rambo: First Blood Part II, Victor Maitland in Beverly Hills Cop, and Adolf Hitler in epic mini-series War and Remembrance...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pNVdTLSFxPY9Jq2MkYRhkLgAATp.jpg", url:"https://themoviedb.org/person/782"}}, {tmdbId:"70132", properties:{bornIn:"Kanagawa, Japan", imdbId:"0855417", born:date('1947-05-18'), name:"Akira Terao", bio:"From Wikipedia, the free encyclopedia\n\nAkira Terao (寺尾 聰, Terao Akira, born May 18, 1947) is Japanese musician and movie actor. \n\nDescription above from the Wikipedia article Akira Terao, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/f80YvpGtC3BDnPiH9PVkojilYRF.jpg", url:"https://themoviedb.org/person/70132"}}, {tmdbId:"70134", properties:{bornIn:"Tokyo, Japan", imdbId:"0753480", born:date('1957-02-14'), name:"Daisuke Ryû", bio:"From Wikipedia, the free encyclopedia. \n\nDaisuke Ryu (Japanese: 隆大介, Korean: 장명남, Jang Myeong-nam, hanja: 張明男) is a Japanese actor born in Tokyo, Japan on 14 February 1957.  He won the Japanese \"best new actor\" Blue ribbon award for his performance as the legendary warrior Oda Nobunaga in Akira Kurosawa's movie Kagemusha (The Shadow Warrior)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ugya6CsZGy4bHpbHcIifYQYFjU2.jpg", url:"https://themoviedb.org/person/70134"}}, {tmdbId:"27993", properties:{bornIn:"Oxnard - California - USA", imdbId:"0001062", born:date('1954-09-09'), name:"Jeffrey Combs", bio:"Jeffrey Alan Combs (born September 9, 1954) is an American actor known for his horror film roles and his appearances playing a number of characters in the Star Trek franchise. \n\nDescription above from the Wikipedia article Jeffrey Combs, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dfWcxKNsyGuN18GjWkbOmMhO4c9.jpg", url:"https://themoviedb.org/person/27993"}}, {tmdbId:"27994", properties:{bornIn:"Portland, Oregon, U.S.", imdbId:"0007940", born:date('1954-07-28'), name:"Bruce Abbott", bio:"From Wikipedia, the free encyclopedia. \n\nBruce Paul Abbott (born July 28, 1954; Portland, Oregon) is an American actor.  He has appeared in movies such as Re-Animator, Bad Dreams, The Prophecy II, Out of Time, and Bride of Re-Animator, and the TV series Dark Justice. \n\nAbbott's career began as a dancer/actor in the Oregon Shakespeare Festival in Ashland, Oregon, where he spent three seasons in the late 1970s...", url:"https://themoviedb.org/person/27994"}}, {tmdbId:"27995", properties:{bornIn:"Levittown, New York, USA", imdbId:"0186225", born:date('1958-12-27'), name:"Barbara Crampton", bio:"Barbara Crampton (born December 27, 1958) is an American actress.  She made her screen debut on the daytime drama Days of Our Lives (1983), and her film debut in 1984's Body Double before starring in the horror comedy Re-Animator (1985).  Crampton grew up in Vermont, was raised Catholic, and spent summers while growing up traveling the country with the carnival, as her father was a carny...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fQcb7Wgz176FQ81wYqnNP6Pecif.jpg", url:"https://themoviedb.org/person/27995"}}, {tmdbId:"27996", properties:{bornIn:"Wimbledon - London - England, UK", imdbId:"0301834", born:date('1936-10-02'), name:"David Gale", died:date('1991-08-18'), url:"https://themoviedb.org/person/27996"}}, {tmdbId:"92808", properties:{bornIn:"Los Angeles, California", imdbId:"0418909", born:date('1970-01-01'), name:"Gabriel Jarret", bio:"From Wikipedia, the free encyclopedia\n\nGabriel Jarret (born Gabriel Kronsberg; January 1, 1970) is an American actor.  He is best known for his role as the young genius Mitch Taylor in the 1985 comedy film Real Genius in which he co starred with Val Kilmer. \n\nJarret's first film was Going Ape! in 1981.  Other film roles include The Karate Kid Part III, Apollo 13, Last Days, and Dry Cycle.  Jarret made guest appearances in 21 Jump Street, L. A.  Law, Party of Five, and The West Wing...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8q0FdYkRX7IorXxX0e6HqLQPLpB.jpg", url:"https://themoviedb.org/person/92808"}}, {tmdbId:"2885", properties:{bornIn:"Vancouver, British Columbia", imdbId:"0001534", born:date('1962-09-01'), name:"Michelle Meyrink", bio:"From Wikipedia, the free encyclopedia\n\nMichelle Meyrink (born September 1, 1962) is a Canadian actress who performed roles during the 1980s in both television and in films, mostly playing roles as offbeat teen girls.  She is best remembered as the hyperactive whiz-kid Jordan Cochran in the 1985 film Real Genius and as the female nerd Judy in 1984's Revenge of the Nerds. \n\nMeyrink was born in Vancouver, British Columbia, Canada...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2wKtBUDzYoZ5u0lKR78OZpEyb4C.jpg", url:"https://themoviedb.org/person/2885"}}, {tmdbId:"921", properties:{bornIn:"Rødovre, Denmark", imdbId:"0000557", born:date('1963-07-15'), name:"Brigitte Nielsen", bio:"Brigitte Nielsen (born 15 July 1963) is a Danish actress, musician and television personality, who began her career with appearances in the 1985 films Red Sonja and Rocky IV and is also known for her marriage to Sylvester Stallone.  She subsequently appeared with him in the 1986 film Cobra, and was noted for her widely publicized breakup with Stallone in 1987, and her relationship with New York Jets Mark Gastineau in 1988...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xyizxM47pXeowS6MDksdqhdlU0Q.jpg", url:"https://themoviedb.org/person/921"}}, {tmdbId:"39782", properties:{bornIn:"Everett, Massachusetts, USA", imdbId:"0809544", born:date('1939-02-05'), name:"Paul L. Smith", bio:"Paul L.  Smith (born February 5, 1939) is an American character actor.  Burly, bearded, and imposing, he has appeared in films and occasionally on TV since the 1970s, generally playing \"heavies\" and bad guys.  His most notable roles include Hamidou, the vicious prison warden in Midnight Express (1978), Bluto in Robert Altman's Popeye (1980) and the Beast Rabban in David Lynch's Dune (1984)...", died:date('2012-04-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j2gVkdXVjnx0ZXdYYNZatxYzDf3.jpg", url:"https://themoviedb.org/person/39782"}}, {tmdbId:"41262", properties:{bornIn:" Brooklyn, New York, USA", imdbId:"0129883", born:date('1939-12-03'), name:"Don Calfa", url:"https://themoviedb.org/person/41262"}}, {tmdbId:"64198", properties:{bornIn:"Los Angeles, California", imdbId:"0558726", born:date('1958-11-28'), name:"Thom Mathews", bio:"​From Wikipedia, the free encyclopedia\n\nThom Mathews (born November 28, 1958) in Los Angeles, California is an actor who is perhaps best known for his appearance in the horror films Return of the Living Dead and Friday the 13th Part VI: Jason Lives. \n\nDescription above from the Wikipedia article Thom Mathews, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/64198"}}, {tmdbId:"826", properties:{bornIn:"Point Reyes, California, USA", imdbId:"0000103", born:date('1974-05-21'), name:"Fairuza Balk", bio:"Fairuza Balk (born Fairuza Alejandra Feldthouse; May 21, 1974) is an American actress and musician.  She made her theatrical film debut as Dorothy Gale in Disney's 1985 film Return to Oz.  Balk also appeared in Valmont, The Craft, The Island of Dr.  Moreau, American History X, The Waterboy, Almost Famous, and Personal Velocity: Three Portraits...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z5KnPiNLkWxBfYu4GRy1iz37bPX.jpg", url:"https://themoviedb.org/person/826"}}, {tmdbId:"19161", properties:{bornIn:"Clermont-Ferrand, France", imdbId:"0094789", born:date('1967-05-31'), name:"Sandrine Bonnaire", bio:"From Wikipedia, the free encyclopedia\n\nSandrine Bonnaire (born 31 May 1967) is a French actress, who has appeared in more than 40 films including Hollywood movies. \n\nBonnaire was born in the town of Gannat, Allier, in the Auvergne region.  She was born into a working-class family, the seventh of eleven children.  Her acting career began at the age of 16 in 1983, when she starred in the Maurice Pialat film À nos amours.  She played a girl from the suburbs beginning her sexual awakening...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iTHkJuVdFcAuZZtBH2frKTeujKG.jpg", url:"https://themoviedb.org/person/19161"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"1330556", properties:{imdbId:"0708136", name:"Setti Ramdane", url:"https://themoviedb.org/person/1330556"}}, {tmdbId:"1232", properties:{bornIn:"Vinton, Virginia, USA", imdbId:"0399663", born:date('1930-09-17'), name:"David Huddleston", bio:"David Huddleston (1930-2016) was an American actor, best known for his roles in Blazing Saddles, Santa Claus: The Movie and The Big Lebowski...", died:date('2016-08-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/QJwOie4L3eeba9c2YXFhnymQi0.jpg", url:"https://themoviedb.org/person/1232"}}, {tmdbId:"109887", properties:{bornIn:"Waltham, Massachusetts, U.S.", imdbId:"0818973", born:date('1933-12-26'), name:"Caroll Spinney", bio:"​From Wikipedia, the free encyclopedia.   \n\nCaroll Edwin Spinney, sometimes credited as Carroll Spinney or Ed Spinney (born December 26, 1933), is an American puppeteer most famous for playing Big Bird and Oscar the Grouch on the children's television show Sesame Street. \n\nDescription above from the Wikipedia article Caroll Spinney, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2019-12-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z23C29e2UREJNcO7eArxn3qrY5g.jpg", url:"https://themoviedb.org/person/109887"}}, {tmdbId:"1197444", properties:{imdbId:"1587253", name:"Simon Srebnik", url:"https://themoviedb.org/person/1197444"}}, {tmdbId:"1197445", properties:{imdbId:"1586660", name:"Michael Podchlebnik", url:"https://themoviedb.org/person/1197445"}}, {tmdbId:"1197446", properties:{imdbId:"1587792", name:"Motke Zaidl", url:"https://themoviedb.org/person/1197446"}}, {tmdbId:"56933", properties:{bornIn:"Alexandria, Virginia, U.S.", imdbId:"0001146", born:date('1957-07-20'), name:"Donna Dixon", bio:"From Wikipedia, the free encyclopedia. \n\nDonna Dixon (born July 20, 1957) is an American actress. \n\nDonna Dixon was born in Alexandria, Virginia; her father, Earl Dixon, owned a club on U. S.  1, called \"Hillbilly Heaven. \" She is a 1975 graduate of Groveton High School and attended The George Washington University.  She began her career as a model and was named Miss Virginia USA in 1976 and Miss Washington DC World in 1977...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6Rykbh71Nuh4Pk18QT4Xho249m0.jpg", url:"https://themoviedb.org/person/56933"}}, {tmdbId:"30489", properties:{bornIn:"Welch - West Virginia - USA", imdbId:"0042438", born:date('1955-10-24'), name:"Karen Austin", url:"https://themoviedb.org/person/30489"}}, {tmdbId:"57372", properties:{bornIn:"Fort Lee, New Jersey, Stati Uniti", imdbId:"0338061", born:date('1967-01-14'), name:"Kerri Green", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/u59mLMNfSPjkaEGzLRgPwrmwM1h.jpg", url:"https://themoviedb.org/person/57372"}}, {tmdbId:"51750", properties:{bornIn:"Philadelphia, Pennsylvania, USA ", imdbId:"0005129", born:date('1976-04-20'), name:"Joey Lawrence", bio:"Joseph \"Joey\" Lawrence (born Joseph Lawrence Mignogna Jr. , April 20, 1976) is an American actor, singer, and television host.  He is known for his roles in the television series Gimme a Break!, Blossom, and Melissa &amp; Joey. \n\nDescription above from the Wikipedia article Joey Lawrence, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ohJpQbDTkWJxt31g7hbAOLM6ION.jpg", url:"https://themoviedb.org/person/51750"}}, {tmdbId:"14668", properties:{bornIn:"Berkeley, California, USA", imdbId:"0001879", born:date('1962-10-28'), name:"Daphne Zuniga", bio:"Daphne Zuniga is an American actress known for her roles as Jo Reynolds on Melrose Place, as Victoria Davis on One Tree Hill and as Princess Vespa in Spaceballs...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jzxXGApvXYqYJKFpSH1WUnr8qCa.jpg", url:"https://themoviedb.org/person/14668"}}, {tmdbId:"32389", properties:{bornIn:"Atlanta, Georgia, USA", imdbId:"0301305", born:date('1953-05-11'), name:"Boyd Gaines", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8bbGx9VFkxV89vUChxyYmrWRwBo.jpg", url:"https://themoviedb.org/person/32389"}}, {tmdbId:"70612", properties:{imdbId:"0882151", name:"Susan Ursitti", bio:"From Wikipedia, the free encyclopedia\n\nSusan Ursitti is an American actress. \n\nUrsitti graduated from St.  Mary's College and then spent several years acting in commercials, TV, film and stage.  Her filmography includes Zapped!, Teen Wolf and Defense Play, as well as television guest roles on 21 Jump Street and Charles in Charge. \n\nShe later received her Master's degree in Design and Manufacturing...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iuS1HbMzvrMtfoCXJ1yTb9PRdP3.jpg", url:"https://themoviedb.org/person/70612"}}, {tmdbId:"26470", properties:{bornIn:"New Brunswick, New Jersey, USA", imdbId:"0505842", born:date('1957-03-12'), name:"Jerry Levine", bio:"Jerry Levine (born March 12, 1957) is an American actor and director, best known for his role in Teen Wolf.  He also appears in Born on the Fourth of July...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xbaUQojYKZGlD7kejb4sQXGrRq0.jpg", url:"https://themoviedb.org/person/26470"}}, {tmdbId:"4138", properties:{bornIn:"York, Pennsylvania, USA", imdbId:"0001729", born:date('1960-04-23'), name:"Craig Sheffer", bio:"Craig Sheffer is an American actor.  He is known for the role of Keith Scott on One Tree Hill...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w8wAAyXDifuxZDgvuL8U0fuLsLG.jpg", url:"https://themoviedb.org/person/4138"}}, {tmdbId:"67893", properties:{bornIn:"New York City, New York, USA", imdbId:"0779467", born:date('1961-08-17'), name:"Larry B. Scott", bio:"An American actor and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5T6qtSbpDlI7GLOdd8eZKPtjhjj.jpg", url:"https://themoviedb.org/person/67893"}}, {tmdbId:"81598", properties:{imdbId:"0227827", born:date('1959-08-06'), name:"Reece Dinsdale", bio:"From Wikipedia, the free encyclopedia.   Reece Dinsdale (born 6 August 1959 in Normanton, Wakefield, West Yorkshire) is an English actor of stage, screen and television.   Description above from the Wikipedia article Reece Dinsdale, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/81598"}}, {tmdbId:"252533", properties:{imdbId:"0108931", name:"David Brierly", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oYQ0sjMT9m9Nl6qfEs5cVSkmL9c.jpg", url:"https://themoviedb.org/person/252533"}}, {tmdbId:"118612", properties:{imdbId:"0562109", name:"Rita May", bio:"Rita May is an English film and television actress and singer, best known for playing supermarket employee Maragaret in the comedy series \"Trollied\".  She's also the only original cast remember who appeared in all episodes on the drama series \"Children's Ward\" from 1989 to 2000...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8232st1gy2HiaBbou2iKKEBKmLd.jpg", url:"https://themoviedb.org/person/118612"}}, {tmdbId:"52267", properties:{bornIn:"Evanston, Illinois, USA", imdbId:"0676973", born:date('1953-02-21'), name:"William Petersen", bio:"William Louis Petersen is an American actor and producer, best known for playing Dr.  Gilbert \"Gil\" Grissom on the hit CBS series CSI: Crime Scene Investigation, Richard Chance in the film To Live and Die in L. A. , and Will Graham in the film Manhunter.  Born in Evanston, Illinois, Petersen attended Idaho State University on a football scholarship, where he first tried acting and immediately joined the drama department, before leaving to work in the Basque country as a Shakespearean actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/844k8tbN8mr5Nk69Ge2yzFR4k9r.jpg", url:"https://themoviedb.org/person/52267"}}] AS row
