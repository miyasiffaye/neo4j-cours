UNWIND [{tmdbId:"65010", properties:{bornIn:"Hobart, Tasmania, Australia", imdbId:"0605388", born:date('1964-06-23'), name:"Tara Morice", bio:"Tara Morice is an Australian actress, singer, and dancer...", url:"https://themoviedb.org/person/65010"}}, {tmdbId:"23", properties:{bornIn:"Ballarat, Victoria, Australia", imdbId:"0402730", born:date('1940-02-27'), name:"Bill Hunter", bio:"​From Wikipedia, the free encyclopedia.   \n\nWilliam John \"Bill\" Hunter (27 February 1940 – 21 May 2011) was an Australian actor of film, stage and television.  He appeared in more than 60 films and won two Australian Film Institute Awards. \n\nDescription above from the Wikipedia article Bill Hunter (actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2011-05-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gvrRsTfx47KupgRwTKp0gqryHPe.jpg", url:"https://themoviedb.org/person/23"}}, {tmdbId:"65011", properties:{bornIn:"London, England, UK", imdbId:"0861066", born:date('1940-09-07'), name:"Pat Thomson", died:date('1992-04-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mznvVpQAdxbSunxcAPRHCKS9dH6.jpg", url:"https://themoviedb.org/person/65011"}}, {tmdbId:"124713", properties:{bornIn:"Salt Lake City, Utah, USA", imdbId:"0827294", born:date('1978-02-28'), name:"Michael Stephenson", bio:"From Wikipedia, the free encyclopedia.   Michael Paul Stephenson (born February 28, 1978 in Salt Lake City, Utah) is an American actor, screenwriter, and director. \n\nDescription above from the Wikipedia article Michael Stephenson, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/124713"}}, {tmdbId:"124716", properties:{imdbId:"0362643", name:"George Hardy", url:"https://themoviedb.org/person/124716"}}, {tmdbId:"932323", properties:{imdbId:"0696705", name:"Margo Prey", url:"https://themoviedb.org/person/932323"}}, {tmdbId:"38710", properties:{imdbId:"0568750", born:date('1969-09-09'), name:"Connie Young", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1cfpMfR4WPsFoTIMPxIIhVch3tM.jpg", url:"https://themoviedb.org/person/38710"}}, {tmdbId:"6726", properties:{bornIn:"Augsburg, Germany", imdbId:"0498247", born:date('1967-04-22'), name:"Sheryl Lee", bio:"Sheryl Lee (born April 22, 1967) is an American actress.  She came to international attention for her performances as Laura Palmer and Maddy Ferguson on the 1990 cult TV series Twin Peaks and in the 1992 film Twin Peaks: Fire Walk with Me.  She is also known for portraying photographer Astrid Kirchherr in Backbeat (1994) and for her roles in Vampires (1998) and Winter's Bone (2010), as well as for her television series roles in LA Doctors, Kingpin, One Tree Hill and Dirty Sexy Money...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ixrpWWjjtHokOyMa0V3EDQB7DVR.jpg", url:"https://themoviedb.org/person/6726"}}, {tmdbId:"6715", properties:{bornIn:"San Diego, California, USA", imdbId:"0000796", born:date('1967-05-24'), name:"Dana Ashbrook", bio:"From Wikipedia, the free encyclopedia. \n\nDana V.  Ashbrook (born May 24, 1967) is an American actor, perhaps best known for playing Bobby Briggs on the cult TV series Twin Peaks (1990–1991, 2017) and its 1992 prequel film Twin Peaks: Fire Walk with Me...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sAR3KoRwOxV9sztnEuTi5nLrTlz.jpg", url:"https://themoviedb.org/person/6715"}}, {tmdbId:"58646", properties:{bornIn:"Dayton, Ohio, USA", imdbId:"0152082", born:date('1963-10-29'), name:"Damian Chapa", bio:"Damian Robert Chapa (born October 29, 1963) is a Mexican-American actor, film director and film producer. \n\nChapa was born in Dayton, Ohio, USA.  He was briefly married to Natasha Henstridge.  Among his earlier notable film roles are one of the leads in Taylor Hackford's Blood In Blood Out and the part of Ken in the film adaptation of Street Fighter.  Subsequently, Chapa has directed and produced, in addition to starring in, his own films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/MAJFUqA0FP3wbRqMSw9ALEuSgP.jpg", url:"https://themoviedb.org/person/58646"}}, {tmdbId:"31006", properties:{imdbId:"0263283", born:date('1948-02-16'), name:"Troy Evans", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/56m9RDIDGH0DfNrRVMPuiTqi5m4.jpg", url:"https://themoviedb.org/person/31006"}}, {tmdbId:"1464036", properties:{imdbId:"0572033", name:"David McKnight", url:"https://themoviedb.org/person/1464036"}}, {tmdbId:"18316", properties:{bornIn:"Tullahoma, Tennessee, USA", imdbId:"0001824", born:date('1961-08-25'), name:"Ally Walker", bio:"Allene Damian \"Ally\" Walker (born August 25, 1961) is an American actress.  She made her television debut in the NBC daytime soap opera, Santa Barbara (1988), before landing the leading roles on the short-lived dramas True Blue (1989–90), and Moon Over Miami (1993). \n\nDuring 1990s, Walker had roles in films such as Universal Soldier (1992), Singles (1992), When the Bough Breaks (1994), While You Were Sleeping (1995), Kazaam (1996), and Happy, Texas (1999)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/YpBscMWFIZwCG5StxWAfbfX3XL.jpg", url:"https://themoviedb.org/person/18316"}}, {tmdbId:"71359", properties:{bornIn:"San Isidro, Buenos Aires, Argentina", imdbId:"9048868", born:date('1972-11-13'), name:"Walter Quiroz", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2W3Sf9Ev8yuQ502pu3A4Kryzs3T.jpg", url:"https://themoviedb.org/person/71359"}}, {tmdbId:"71360", properties:{imdbId:"0019093", name:"Soledad Alfaro", url:"https://themoviedb.org/person/71360"}}, {tmdbId:"71361", properties:{imdbId:"0058728", name:"Ricardo Bartis", url:"https://themoviedb.org/person/71361"}}, {tmdbId:"71362", properties:{imdbId:"0064914", name:"Christina Becerra", url:"https://themoviedb.org/person/71362"}}, {tmdbId:"9965", properties:{bornIn:"New Orleans, Louisiana, USA", imdbId:"0005679", born:date('1942-06-14'), name:"Allen Daviau", bio:"Allen Daviau (June 14, 1942 – April 15, 2020) was an American cinematographer known for his collaborations with Steven Spielberg work on E. T.  the Extra-Terrestrial (1982), The Color Purple (1985), and Empire of the Sun (1987).  He received five Academy Award nominations and two British Academy Film Award nominations, with one win.  In addition to his work in film, Daviau served as Cinematographer-in-Residence at the University of California, Los Angeles...", died:date('2020-04-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iz7TiZQ2YaPn47j7Gj8mMDGUT3W.jpg", url:"https://themoviedb.org/person/9965"}}, {tmdbId:"8750", properties:{bornIn:"Philadelphia, Pennsylvania, USA", imdbId:"0221042", born:date('1944-09-21'), name:"Caleb Deschanel", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2TsYnZibZRfHY3vcmEdLTJSR4kl.jpg", url:"https://themoviedb.org/person/8750"}}, {tmdbId:"53087", properties:{bornIn:"Washington - District of Columbia - USA", imdbId:"0950165", born:date('1954-01-24'), name:"William Allen Young", bio:"From Wikipedia, the free encyclopedia. \n\nWilliam Allen Young (born January 1954) is an American actor best known for playing a role of Frank Mitchell on UPN's Moesha in 1996 and directing a few episodes of the show, and made a guest appearance on UPN's The Parkers as Frank Mitchell.  His other television credits include The Day After, Matlock, Babylon 5, CBS's JAG, Knots Landing, The Jeffersons, The Women of Brewster Place, among other shows...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3QMYa0lOFs76wXmPuvdmTyz0KUA.jpg", url:"https://themoviedb.org/person/53087"}}] AS row
