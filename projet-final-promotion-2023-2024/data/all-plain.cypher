UNWIND [{tmdbId:"64825", properties:{bornIn:"Pasadena, California, USA", imdbId:"0002122", born:date('1951-10-30'), name:"Harry Hamlin", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n1PedvBIAJ7Kd5T8fJ38ZMjf6HF.jpg", url:"https://themoviedb.org/person/64825"}}, {tmdbId:"73489", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"0001979", born:date('1956-02-14'), name:"Tom Burlinson", bio:"From Wikipedia, the free encyclopedia\n\nTom Burlinson, an actor and singer born on 14th February 1956 in Toronto, Canada.  His English parents had migrated to Canada after World War II.  The family transferred to New Jersey in 1958, and Tom was the typical all-American youngster with the Little League baseball cap, striped T-shirt and turned-up jeans.  In 1962 the family transferred to England with the father's job and young Tom went to school with a North American accent...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zhbc2oKEh2ShPLRyF3duu8W7oB5.jpg", url:"https://themoviedb.org/person/73489"}}, {tmdbId:"75394", properties:{bornIn:"Staines, Middlesex, England", imdbId:"0233065", born:date('1942-10-28'), name:"Terence Donovan", bio:"From Wikipedia, the free encyclopedia\n\nTerence Donovan (born 28 October 1942), also known as Terry Donovan, is an English-born Australian actor and the father of fellow actor and entertainer Jason Donovan.  He has had major roles in many Australian TV drama series, including Division 4, Cop Shop, Prisoner, Sons and Daughters and Neighbours. \n\nDescription above from the Wikipedia article Terence Donovan (actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rpOq4QkxDnVOOHXRsIw3Ko1WpDW.jpg", url:"https://themoviedb.org/person/75394"}}, {tmdbId:"91486", properties:{bornIn:"Scotland, UK", imdbId:"0246005", name:"Tommy Dysart", bio:"Tommy Dysart is a Scottish-born actor, currently resident in Australia.  Dysart has been a regular fixture on Australian television for several decades, frequently appearing in guest-starring roles in drama series and comedies, and in character roles in films and miniseries. \n\nHigh-profile early roles included appearances in Skippy the Bush Kangaroo, Phoenix Five, and several roles in the Crawford Productions police drama series Homicide, Division 4 and Matlock Police...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2Am798CyNCmjc8jJUfkkPzumB4o.jpg", url:"https://themoviedb.org/person/91486"}}, {tmdbId:"78439", properties:{bornIn:"North Conway, New Hampshire, USA", imdbId:"0790291", born:date('1949-04-14'), name:"John Shea", bio:"​From Wikipedia, the free encyclopedia\n\nJohn Victor Shea III (born April 14, 1949) is an American actor and director who has starred on stage, television and in film.  He is best known for his role as Lex Luthor in the 1990s TV series Lois &amp; Clark: The New Adventures of Superman and also starred in the short lived 1990s TV series WIOU as Hank Zaret.  Later on in the 2000s he starred on the series Mutant X as Adam Kane...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wJN9RqOC666WZay9ABgAhKm4DDK.jpg", url:"https://themoviedb.org/person/78439"}}, {tmdbId:"28871", properties:{bornIn:"Wansford Camp, England, UK", imdbId:"0513468", born:date('1956-11-05'), name:"Eugene Lipinski", bio:"Eugene Lipinski is a British actor and screenwriter.  He was born in Wansford Camp, Cambridgeshire and raised in Regina, Saskatchewan, Canada.  He began acting at the age of twelve in amateur theater.  After graduating from the University of Regina, he returned to the UK and attended the Royal Academy of Arts as well as the Drama Studio London.  He is well-known TV series such as Animorphs as Visser Three, Fringe as December and Da Vinci's City Hall and Da Vinci's Inquest as Lloyd Manning...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n9SC7Ka8pVcSZnJadTpSFswBNyo.jpg", url:"https://themoviedb.org/person/28871"}}, {tmdbId:"932370", properties:{bornIn:"Ivančice, Československo", imdbId:"0822321", born:date('1946-12-03'), name:"Jirí Stanislav", died:date('2020-08-01'), url:"https://themoviedb.org/person/932370"}}, {tmdbId:"1348673", properties:{imdbId:"0352598", name:"Eugeniusz Haczkiewicz", url:"https://themoviedb.org/person/1348673"}}, {tmdbId:"95975", properties:{bornIn:"St. Louis, Missouri, USA", imdbId:"0513021", born:date('1954-06-17'), name:"Mark Linn-Baker", bio:"Mark Linn-Baker is an American stage and screen actor and director, best known for his portrayal of Larry Appleton on the television sitcom \"Perfect Strangers\".  He holds an MFA in Drama from the Yale School of Drama, New Haven, Connecticut...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ftf6coOBy95LrcVvhPnbsabKnC.jpg", url:"https://themoviedb.org/person/95975"}}, {tmdbId:"115488", properties:{bornIn:"Glendora, California, USA", imdbId:"0746577", born:date('1952-06-01'), name:"Misty Rowe", url:"https://themoviedb.org/person/115488"}}, {tmdbId:"157467", properties:{bornIn:"Grand Rapids, Michigan", born:date('1935-08-19'), name:"Blackie Dammett", bio:"He was married to Peggy - real name Margaret - and they divorced when their son Anthony was young.  Blackie has two children - Anthony who was born in 1962, and James, who was born in 1991.  He lived in Los Angeles for many years and whilst living there, he changed his name from John Kiedis to Blackie Dammett.  He raised wolves and wolf hybrids in Michigan in the 1990s.  In 2007, he moved to Portland, Oregon.  Father of Anthony Kiedis from the Red Hot Chili Peppers...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4RrnJ9ggwWScJghPcnIlkiCMFA.jpg", url:"https://themoviedb.org/person/157467"}}, {tmdbId:"2232", properties:{bornIn:"Coraopolis, Pennsylvania, USA", imdbId:"0000474", born:date('1951-09-05'), name:"Michael Keaton", bio:"Michael John Douglas (born September 5, 1951), better known as Michael Keaton, is an American actor, well known for his early comedic roles in films such as Night Shift, Mr.  Mom, Johnny Dangerously, Beetlejuice, and for his dramatic portrayal of Batman in Tim Burton's Batman and Batman Returns, as well as lead roles in other films including The Paper, Jackie Brown, Jack Frost, White Noise, Cars, The Other Guys and Toy Story 3...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/baeHNv3qrVsnApuKbZXiJOhqMnw.jpg", url:"https://themoviedb.org/person/2232"}}, {tmdbId:"156818", properties:{bornIn:"Houston - Texas - USA", imdbId:"0372958", born:date('1953-12-06'), name:"Gina Hecht", bio:"Gina Hecht was born on December 6, 1952.  She is an actress and producer...", url:"https://themoviedb.org/person/156818"}}, {tmdbId:"16314", properties:{bornIn:"Tetuan, Spanish protectorate in Morocco", imdbId:"0523597", born:date('1931-02-14'), name:"Margarita Lozano", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xsSBfAnXd6fFgf2BJPL3fXu5lyI.jpg", url:"https://themoviedb.org/person/16314"}}, {tmdbId:"119950", properties:{bornIn:"Montale, Tuscany, Italy", imdbId:"0081702", born:date('1955-12-08'), name:"Claudio Bigagli", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Au3H49qjanQA2hYIrN6tNyyirxy.jpg", url:"https://themoviedb.org/person/119950"}}, {tmdbId:"995398", properties:{imdbId:"0346732", name:"Miriam Guidelli", url:"https://themoviedb.org/person/995398"}}, {tmdbId:"18181", properties:{bornIn:"Knoxville - Tennessee - USA", imdbId:"0001418", born:date('1954-05-08'), name:"David Keith", bio:"David Lemuel Keith (born May 8, 1954, height 5' 11\" (1,80 m)) is an American actor and director.  He received Golden Globe nominations for Best Supporting Actor and New Star of the Year – Actor for his performance in An Officer and a Gentleman. \n\nDescription above from the Wikipedia article David Keith, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ayfqRXPc3GFUXIMQ4bkrIe1B6hs.jpg", url:"https://themoviedb.org/person/18181"}}, {tmdbId:"1162", properties:{bornIn:"Staten Island, New York, USA", imdbId:"0005162", born:date('1930-01-03'), name:"Robert Loggia", bio:"Robert Loggia (1930–2015) is an American film and television actor and director, who specializes in character parts...", died:date('2015-12-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i2h163BYdLkmXTlW5QgkxMmbIFo.jpg", url:"https://themoviedb.org/person/1162"}}, {tmdbId:"27888", properties:{bornIn:"San Juan, Puerto Rico", imdbId:"0000471", born:date('1940-03-09'), name:"Raul Julia", bio:"Raúl Rafael Juliá y Arcelay (March 9, 1940 – October 24, 1994) was a Puerto Rican actor.  His film career peaked in the US in the early 1990s. \n\nBorn in San Juan, he gained interest in acting while still in school.  Upon completing his studies, Juliá decided to pursue a career in acting.  After performing in the local scene for some time, he was convinced by entertainment personality Orson Bean to move and work in New York City...", died:date('1994-10-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rC9ALBVjGMWQEFtRiIS20Ps38dq.jpg", url:"https://themoviedb.org/person/27888"}}, {tmdbId:"140252", properties:{imdbId:"0322165", name:"Robert Glaudini", url:"https://themoviedb.org/person/140252"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"3416", properties:{bornIn:"Roswell, New Mexico, US", imdbId:"0000193", born:date('1962-11-11'), name:"Demi Moore", bio:"Demi Gene Guynes (born November 11, 1962), professionally known as Demi Moore, is an American actress and film producer.  After making her film debut in 1981, she appeared on the soap opera General Hospital and subsequently gained recognition as a member of the Brat Pack with roles in Blame It on Rio (1984), St.  Elmo's Fire (1985), and About Last Night. . .  (1986).  Her starring role in Ghost (1990), the highest-grossing film of that year, earned her a Golden Globe nomination...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lgojmzzzNS6qnho24NdUYDy9nxS.jpg", url:"https://themoviedb.org/person/3416"}}, {tmdbId:"84653", properties:{imdbId:"0203358", name:"James Davidson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3XtaAHh4snISOf4s91dYxKCrxaz.jpg", url:"https://themoviedb.org/person/84653"}}, {tmdbId:"1768652", properties:{name:"Chris Parker", url:"https://themoviedb.org/person/1768652"}}, {tmdbId:"127073", properties:{imdbId:"0309435", name:"Leila Gastil", url:"https://themoviedb.org/person/127073"}}, {tmdbId:"6394", properties:{bornIn:"Minneapolis, Minnesota", imdbId:"0527099", born:date('1952-12-14'), name:"John Lurie", bio:"John Lurie (born December 14, 1952) is an American musician, painter, actor, director, and producer.  He co-founded The Lounge Lizards jazz ensemble, has acted in 19 films, including Stranger than Paradise and Down by Law, has composed and performed music for 20 television and film works, and produced, directed, and starred in the Fishing with John television series...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ePnMEUo9cH3sku26gi2sJroTZFM.jpg", url:"https://themoviedb.org/person/6394"}}, {tmdbId:"4811", properties:{imdbId:"0091369", name:"Richard Boes", url:"https://themoviedb.org/person/4811"}}, {tmdbId:"1164017", properties:{name:"Patrice Donnelly", url:"https://themoviedb.org/person/1164017"}}, {tmdbId:"588114", properties:{imdbId:"0601465", name:"Kenny Moore", url:"https://themoviedb.org/person/588114"}}, {tmdbId:"47991", properties:{bornIn:" Dublin, Ireland", imdbId:"0002097", born:date('1951-10-05'), name:"Bob Geldof", bio:"Robert Frederick Zenon \"Bob\" Geldof, KBE, (born 5 October 1951) is an Irish singer, songwriter, author, occasional actor and political activist.  He rose to prominence as the lead singer of the Irish rock band The Boomtown Rats in the late 1970s and early 1980s alongside the punk rock movement.  The band had hits with his compositions \"Rat Trap\" and \"I Don't Like Mondays\".  He co-wrote \"Do They Know It's Christmas?\", one of the best-selling singles of all time...", url:"https://themoviedb.org/person/47991"}}, {tmdbId:"71247", properties:{bornIn:"Salford, Lancashire, England, UK", imdbId:"0362959", born:date('1939-03-22'), name:"Christine Hargreaves", died:date('1984-08-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7zLjJbWFRiSGq4LPxbhX2NF8mvb.jpg", url:"https://themoviedb.org/person/71247"}}, {tmdbId:"71248", properties:{bornIn:"Marton, New Zealand", imdbId:"0491190", born:date('1940-02-17'), name:"James Laurenson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fW9gq3GzJGjICmTIgmzzGQ4fQyz.jpg", url:"https://themoviedb.org/person/71248"}}, {tmdbId:"71249", properties:{bornIn:"Lincolnshire, England, UK", imdbId:"0202870", born:date('1956-03-14'), name:"Eleanor David", url:"https://themoviedb.org/person/71249"}}, {tmdbId:"42195", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0001531", born:date('1962-09-11'), name:"Kristy McNichol", bio:"​Christina Ann \"Kristy\" McNichol (born September 11, 1962) is an American actress.  She is best known for her roles as Leticia “Buddy” Lawrence on the television drama series Family and as Barbara Weston on the sitcom Empty Nest.  She is also the sister of former child actor Jimmy McNichol.  McNichol retired from acting when she was diagnosed with bipolar disorder in 1992.   Description above from the Wikipedia article Kristy McNichol, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fU6P8bhujOslnLoaUBKm0UnjrsG.jpg", url:"https://themoviedb.org/person/42195"}}, {tmdbId:"94288", properties:{imdbId:"0358186", name:"Ted Hamilton", url:"https://themoviedb.org/person/94288"}}, {tmdbId:"94021", properties:{bornIn:"Trowbridge, Wiltshire, England", imdbId:"0071290", born:date('1934-12-27'), name:"Christopher Benjamin", bio:"From Wikipedia, the free encyclopedia. \n\nChristopher Benjamin is a British actor, born 27 December 1934 in Trowbridge, Wiltshire, England. \n\nHe is well known for his roles in some of the UK's biggest cult television programmes.  This included playing the same character in two Patrick McGoohan dramas, Danger Man and The Prisoner, fuelling speculation that they are possibly linked.  He was also a regular in The Avengers and Doctor Who, playing in three episodes of each, mostly in comedy roles...", url:"https://themoviedb.org/person/94021"}}, {tmdbId:"79357", properties:{imdbId:"0092639", born:date('1935-06-16'), name:"James Bolam", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zYiJ5K980SfkpifsU0yxfop00mz.jpg", url:"https://themoviedb.org/person/79357"}}, {tmdbId:"15788", properties:{bornIn:"Hertfordshire, England, UK", imdbId:"0001329", born:date('1929-04-05'), name:"Nigel Hawthorne", bio:"From Wikipedia, the free encyclopedia. \n\nSir Nigel Barnard Hawthorne, CBE (5 April 1929 – 26 December 2001) was an English actor, perhaps best remembered for his role as Sir Humphrey Appleby, the Permanent Secretary in the 1980s sitcom Yes Minister and the Cabinet Secretary in its sequel, Yes, Prime Minister.  For this role he would win four Bafta Awards during the 1980s in the 'Best Light Entertainment Performance' Category...", died:date('2001-12-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v8bin2HUa9gayqxmCnlRlh0taxq.jpg", url:"https://themoviedb.org/person/15788"}}, {tmdbId:"8977", properties:{bornIn:"Spokane, Washington, U.S.", imdbId:"0005266", born:date('1944-04-04'), name:"Craig T. Nelson", bio:"Craig Theodore Nelson (born April 4, 1944) is an American actor.  He is probably best known for his Emmy-winning role as Hayden Fox on the TV series Coach.  He also starred in The Incredibles in 2004 as Mr.  Incredible, and reprised the role in 2018 for Incredibles 2. \n\nDescription above from the Wikipedia article Craig T.  Nelson, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rMh8qdexFKmc7mq7oLzsLLvCCjs.jpg", url:"https://themoviedb.org/person/8977"}}, {tmdbId:"10083", properties:{bornIn:"Old Westbury, New York, USA", imdbId:"0833152", born:date('1914-08-02'), name:"Beatrice Straight", bio:"From Wikipedia, the free encyclopedia\n\nBeatrice Whitney Straight (August 2, 1914 – April 7, 2001) was an American theatre, film, and television actress.  Hers remains the shortest acting performance in a film to win an Oscar.  In her winning role in the 1976 film Network, she was on screen for five minutes and forty seconds.  She also received an Emmy nomination for her role in The Dain Curse.  Straight can also be recognized as Dr.  Lesh in Poltergeist...", died:date('2001-04-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iCNm0pSNFStUBKpvY6Ou5F7Nap6.jpg", url:"https://themoviedb.org/person/10083"}}, {tmdbId:"10084", properties:{bornIn:"Santa Monica, California, USA", imdbId:"0001161", born:date('1959-11-23'), name:"Dominique Dunne", bio:"From Wikipedia, the free encyclopedia\n\nDominique Ellen Dunne (November 23, 1959 – November 4, 1982) was an American actress. \n\nDunne made appearances in several made for television movies, television series, and films, and played a supporting role as the oldest daughter, Dana Freeling, in the 1982 film Poltergeist.  She was strangled to death by her former boyfriend. \n\nDescription above from the Wikipedia article Dominique Dunne, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1982-11-04'), url:"https://themoviedb.org/person/10084"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"64221", properties:{imdbId:"0597517", born:date('1955-07-20'), name:"Dan Monahan", url:"https://themoviedb.org/person/64221"}}, {tmdbId:"64222", properties:{imdbId:"0380628", born:date('1954-10-06'), name:"Mark Herrier", bio:"​From Wikipedia, the free encyclopedia.   \n\nMark Herrier (born October 6, 1954) is an American actor and film director, best known for his role as Billy in the 80's teen trilogy Porky's.  He graduated from Lompoc High School in 1972. \n\nHe has since made numerous appearances on shows such as M*A*S*H, Freddy's Nightmares, Paradise, Murder, She Wrote, The Practice and Gideon's Crossing...", url:"https://themoviedb.org/person/64222"}}, {tmdbId:"64223", properties:{bornIn:"New York, New York, USA", imdbId:"0461129", born:date('1955-01-20'), name:"Wyatt Knight", died:date('2011-10-26'), url:"https://themoviedb.org/person/64223"}}, {tmdbId:"174653", properties:{imdbId:"0934059", born:date('1956-10-08'), name:"Roger Wilson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3E2ku6nWKCOcJuhRjT7OYWN5zoA.jpg", url:"https://themoviedb.org/person/174653"}}, {tmdbId:"233531", properties:{bornIn:"Bayonne, France", imdbId:"0539399", born:date('1955-09-03'), name:"Laurent Malet", bio:"Laurent Marie Guespin-Malet (born 3 September 1955 in Bayonne) is a French actor, and the twin brother of actor Pierre Malet. \n\nMalet's stage debut came in La guerre de Troie n'aura pas lieu as Troilus alongside Claude Jade in 1975.  In 1978 he was made famous by his Andrew alongside Donald Sutherland and Stéphane Audran in Les Liens de sang by Claude Chabrol.  That same year, Gilles Béhat gave him the lead role in Haro...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bUG6xM4B3psQehGk8gGX7px3SYq.jpg", url:"https://themoviedb.org/person/233531"}}, {tmdbId:"136761", properties:{bornIn:"Mainneville, Eure, France", imdbId:"0000882", born:date('1948-07-06'), name:"Nathalie Baye", bio:"Nathalie Baye was born on July 6, 1948 in Mainneville, Eure, France.  She is an actress, known for Catch Me If You Can (2002), A Pornographic Affair (1999) and Laurence Anyways (2012)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q0TPwOxbTGFgIh1HdCUs3bPtRjo.jpg", url:"https://themoviedb.org/person/136761"}}, {tmdbId:"38499", properties:{bornIn:"Malicorne sur Sarthe, Sarthe, Pays de la Loire, France", imdbId:"0057428", born:date('1932-06-08'), name:"Maurice Barrier", bio:"Maurice Barrier (8 June 1932 – 12 April 2020) was a French actor and singer. \n\nBarrier was the son of a cabinetmaker, and had his first job working in his father's workshop.  While in Rennes at age 28, he met several resident actors at the Théâtre National de Bretagne and made his stage debut in Caligula, written by Albert Camus. \n\nHis first major role on television was in the film The Taking of Power by Louis XIV...", died:date('2020-04-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2J5JiuJglOhCbS4Z4AYs3fihfRJ.jpg", url:"https://themoviedb.org/person/38499"}}, {tmdbId:"38500", properties:{bornIn:"Paris, France", imdbId:"0232627", born:date('1949-07-02'), name:"Bernard-Pierre Donnadieu", bio:"From Wikipedia, the free encyclopedia\n\nBernard-Pierre Donnadieu (2 July 1949 – 27 December 2010) was a French actor. \n\nDescription above from the Wikipedia article Bernard-Pierre Donnadieu, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2010-12-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ecjTG2mF2Fx1Vij2LZh8xLkGwCA.jpg", url:"https://themoviedb.org/person/38500"}}, {tmdbId:"222259", properties:{bornIn:"Paris, France", imdbId:"0140316", born:date('1941-03-19'), name:"Florence Delay", bio:"From Wikipedia, the free encyclopedia. \n\nFlorence Delay (born March 19, 1941 in Paris) is a French academician and actress. \n\nDescription above from the Wikipedia article Florence Delay, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ci10iGFWeStka54O1TjS5E6suW9.jpg", url:"https://themoviedb.org/person/222259"}}, {tmdbId:"28626", properties:{bornIn:"Norwich, Connecticut, USA", imdbId:"0231319", born:date('1953-04-27'), name:"Arielle Dombasle", bio:"From Wikipedia, the free encyclopedia. \n\nArielle Dombasle (born April 27, 1958) is a French-American singer, actress, director and model.  Her breakthrough roles were in Éric Rohmer's Pauline at the Beach (1983) and Alain Robbe-Grillet's The Blue Villa (1995).  She is best known to American audiences for her appearances on Miami Vice and the 1984 miniseries Lace.  She has released eight singles between 1978 and 2011 and seven albums...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yzrLz3f4uXsiEJeG5FRiIqbGKPS.jpg", url:"https://themoviedb.org/person/28626"}}, {tmdbId:"222260", properties:{bornIn:"Osaka, Japan", imdbId:"0407441", born:date('1947-12-18'), name:"Riyoko Ikeda", bio:"Riyoko Ikeda (池田 理代子 Ikeda Riyoko, born December 18, 1947) is a Japanese manga artist and singer.  She is included in the Year 24 Group. [1] She was one of the most popular Japanese comic artists in the 1970s, being best known for The Rose of Versailles...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/snjbIQlysjhaQd0tn9UJ5YVhfXt.jpg", url:"https://themoviedb.org/person/222260"}}, {tmdbId:"44510", properties:{bornIn:"Frankfurt am Main", imdbId:"0449667", born:date('1927-05-29'), name:"Charlotte Kerr", died:date('2011-12-28'), url:"https://themoviedb.org/person/44510"}}, {tmdbId:"57968", properties:{bornIn:"Houston, Texas, USA", imdbId:"0588903", born:date('1924-11-20'), name:"Mark Miller", bio:"Mark Miller is an American stage, film and television actor and writer.  He's a graduate from New York City's American Academy of Dramatic Arts, New York, USA...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uUfVbHKHYDcnOpjPLyg0i1aWV5a.jpg", url:"https://themoviedb.org/person/57968"}}, {tmdbId:"57350", properties:{bornIn:"Chico, California, USA", imdbId:"0779073", born:date('1946-09-29'), name:"Donovan Scott", bio:"​From Wikipedia, the free encyclopedia\n\nDonovan Scott (born 29 September 1946) is an American character film actor best known for his role of cadet Leslie Barbara in the 1984 film Police Academy starring together with Steve Guttenberg.  He also appeared in the music video for Olivia Newton-John's 1981 hit \"Physical\", and co-starred in Lucille Ball's 1986 ABC-TV series Life with Lucy...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zs0rbBBujZATXeEV3E7RMrXQ2W2.jpg", url:"https://themoviedb.org/person/57350"}}, {tmdbId:"160321", properties:{bornIn:"Ingelwood, CA", imdbId:"0026106", born:date('1975-07-11'), name:"Bridgette Andersen", bio:"Born Marriah Bridget Andersen in Inglewood, California to Frank Glass and Teresa Andersen, Bridgette Andersen (as she was known professionally) was raised in Malibu, California, and from an early age, she showed exceptional intelligence.  By age two, she decided she wanted to be an actress and eventually began a career as a child model before breaking into acting at age seven in the 1982 TV movie, Washington Mistress...", died:date('1997-05-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v121y0naBMakODFj69gEKHhoxjz.jpg", url:"https://themoviedb.org/person/160321"}}, {tmdbId:"1087451", properties:{bornIn:"West Palm Beach, Florida, USA", imdbId:"0732468", born:date('1938-11-05'), name:"Chris Robinson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e4uknn1qW12yv6ynqpO3X3KPIAp.jpg", url:"https://themoviedb.org/person/1087451"}}, {tmdbId:"10730", properties:{bornIn:"Consett, County Durham, UK", imdbId:"0000100", born:date('1955-01-06'), name:"Rowan Atkinson", bio:"Rowan Sebastian Atkinson CBE, is an English comedian, screenwriter, and actor.  He is most famous for his work on the satirical sketch comedy show Not The Nine O'Clock News, and the sitcoms Blackadder, Mr.  Bean, and The Thin Blue Line.  He has been listed in The Observer as one of the 50 funniest actors in British comedy, and amongst the top 50 comedy actors ever in a 2005 poll of fellow comedians. \n\nAtkinson was born in Consett, County Durham, England...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wxTgS4SFanVKbnvu9xqOzNJWJwz.jpg", url:"https://themoviedb.org/person/10730"}}, {tmdbId:"107602", properties:{bornIn:"Wallington, Surrey, England, UK", imdbId:"0065169", born:date('1944-06-24'), name:"Jeff Beck", bio:"Beck grew up in Wallington, England.  His mother’s piano playing and the family’s radio tuned to everything from dance to classical made sure Beck was surrounded by music from a young age.  Today he is recognized as a groundbreaking artist who’s inimitable combination of primal shredding and cool perfectionism has left and indelible mark on everything from hard rock and jazz fusion to rockabilly and techno during the past 40-plus years...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/X16Bn8VOBYiLenre7ufN7Kzdi.jpg", url:"https://themoviedb.org/person/107602"}}, {tmdbId:"55477", properties:{bornIn:"Leeds, Yorkshire, England, UK", imdbId:"0003141", born:date('1934-05-09'), name:"Alan Bennett", bio:"Alan Bennett (born 9 May 1934) is an English playwright, screenwriter and author.  Born in Leeds, he attended Oxford University where he studied history and performed with The Oxford Revue.  He stayed to teach and research medieval history at the university for several years.  His collaboration as writer and performer with Dudley Moore, Jonathan Miller and Peter Cook in the satirical revue Beyond the Fringe at the 1960 Edinburgh Festival brought him instant fame...", url:"https://themoviedb.org/person/55477"}}, {tmdbId:"937", properties:{bornIn:"Leytonstone, London, England", imdbId:"0001394", born:date('1938-10-22'), name:"Derek Jacobi", bio:"From Wikipedia, the free encyclopedia. \n\nSir Derek George Jacobi, CBE, (born 22 October 1938) is an English actor and film director. \n\nA \"forceful, commanding stage presence\", Jacobi has enjoyed a highly successful stage career, appearing in such stage productions as Hamlet, Uncle Vanya, and Oedipus the King.  He received a Tony Award for his performance in Much Ado About Nothing...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/htc4eCYmNlVotcu8AFTbDiLBzsJ.jpg", url:"https://themoviedb.org/person/937"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"13392", properties:{bornIn:"Lee-on-Solent, Hampshire, England, UK", imdbId:"0539395", born:date('1927-09-24'), name:"Arthur Malet", bio:"From Wikipedia, the free encyclopedia\n\nArthur Malet (born 24 September 1927) is an English actor. \n\nArthur Malet was born in Lee-on-Solent, Hampshire, England in 1927.  He emigrated to the United States in the 1950s, starting out onstage and winning two Drama Desk Awards in 1957.  He came to some prominence in the 1960s, starring in films playing characters much older than his real age, such as Mr.  Dawes, Jr.  in Mary Poppins...", url:"https://themoviedb.org/person/13392"}}, {tmdbId:"23340", properties:{bornIn:"Berlin, Germany", imdbId:"0954114", born:date('1940-07-07'), name:"Rosel Zech", died:date('2011-08-31'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4lut9vnYfJTfPUlRaNYMFiQBUrz.jpg", url:"https://themoviedb.org/person/23340"}}, {tmdbId:"23342", properties:{bornIn:"Dölau, Germany", imdbId:"0857150", born:date('1931-04-17'), name:"Hilmar Thate", died:date('2016-09-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ovnwx6geNTEtLi5G9sj1n5c0ASA.jpg", url:"https://themoviedb.org/person/23342"}}, {tmdbId:"1857", properties:{bornIn:"Wriezen, Germany", imdbId:"0175555", born:date('1943-10-28'), name:"Cornelia Froboess", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7G75SjsdhqHBJYg1WzECPH3TYP.jpg", url:"https://themoviedb.org/person/1857"}}, {tmdbId:"23344", properties:{bornIn:"Arlesheim", imdbId:"0246947", born:date('1925-11-26'), name:"Annemarie Düringer", died:date('2014-11-26'), url:"https://themoviedb.org/person/23344"}}, {tmdbId:"27811", properties:{bornIn:"Stevens Point, Wisconsin, USA", imdbId:"0000693", born:date('1947-06-24'), name:"Peter Weller", bio:"Peter Frederick Weller (born June 24, 1947) is an American film and stage actor, director and lecturer. \n\nHe is best known for his roles as the title character in the first two RoboCop films and Buckaroo Banzai in the cult classic The Adventures of Buckaroo Banzai Across the 8th Dimension.  He received an Academy Award nomination for his direction for the 1993 short Partners, in which he also acted.  He also hosted the show Engineering an Empire on the History channel...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mVRJX38zabRadVPJe0XOTObVzhp.jpg", url:"https://themoviedb.org/person/27811"}}, {tmdbId:"1891382", properties:{bornIn:"Evansville, Indiana, USA", imdbId:"0584445", born:date('1966-08-30'), name:"Michelle Michaels", bio:"Michael is the eldest of two daughters.  Her white father, Jerry, is an entrepreneur.  Her African American mother, Thersa, is a corporate manager.  In high school she played volleyball, basketball, and ran track.  After high school, she moved to New York and quickly got commercial work.  This led to a role in Eddie Murphy's 1989 film Harlem Nights (1989).  But that role dissolved when she spurned his advances and she filed a sexual harrassment suit against him...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bL3e7WDoiRWuF75oJKX2mzdgvHi.jpg", url:"https://themoviedb.org/person/1891382"}}, {tmdbId:"97620", properties:{imdbId:"0830241", born:date('1961-11-24'), name:"Robin Stille", died:date('1996-02-09'), url:"https://themoviedb.org/person/97620"}}, {tmdbId:"97849", properties:{imdbId:"0898252", name:"Michael Villella", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9nyYNzclhw9GLh4MhQnFhqMEci.jpg", url:"https://themoviedb.org/person/97849"}}, {tmdbId:"97850", properties:{bornIn:"Alameda, California, USA", imdbId:"0217231", born:date('1956-05-03'), name:"Debra De Liso", bio:"Debra De Liso is an American actor, dancer, director, choreographer, playwright, and teacher...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/A4SdcVt0KgKSGP0yvd79IDTmNDw.jpg", url:"https://themoviedb.org/person/97850"}}, {tmdbId:"67269", properties:{imdbId:"0109076", born:date('1934-01-18'), name:"Raymond Briggs", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/spPHRkRat1DKcRf4dW3ZrwQQdFq.jpg", url:"https://themoviedb.org/person/67269"}}, {tmdbId:"8945", properties:{bornIn:"St. Louis, Missouri, USA", imdbId:"0000177", born:date('1947-10-24'), name:"Kevin Kline", bio:"Kevin Delaney Kline (born October 24, 1947) is an American actor.  He has won an Academy Award and three Tony Awards, and has been nominated for five Golden Globe Awards, two BAFTA Awards and an Emmy Award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ArH5dACd9AmWNNMnI6bGEkiFYIM.jpg", url:"https://themoviedb.org/person/8945"}}, {tmdbId:"135170", properties:{born:date('1919-10-24'), name:"Rita Karin", died:date('1993-09-10'), url:"https://themoviedb.org/person/135170"}}, {tmdbId:"10507", properties:{bornIn:"London, England, UK", imdbId:"0373324", born:date('1930-10-28'), name:"Jack Hedley", bio:"From Wikipedia, the free encyclopedia\n\nJack Hedley (born in London on 28 October 1930 as Jack Hawkins, name changed to avoid confusion with his namesake) is an English actor, best known for his performances on television. \n\nHis screen career began in 1950 with a 13-minute drama-documentary about polio called A Life to be Lived...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xqt5KugV4PjzKquLIip7aVJYmwt.jpg", url:"https://themoviedb.org/person/10507"}}, {tmdbId:"1027788", properties:{imdbId:"4105662", name:"Almanta Suska", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oSWJIVX75ZI7LMI6GxrVsurKA3J.jpg", url:"https://themoviedb.org/person/1027788"}}, {tmdbId:"27383", properties:{bornIn:" Rome, Italy", imdbId:"0001886", born:date('1941-01-10'), name:"Howard Ross", bio:"Howard Ross (born Renato Rossini; 10 January 1941) is an Italian film actor. \n\nBorn in Rome, Rossini got his first major roles in peplum films.   In the mid-1960s he eventually adopted the stage name Howard Ross.   He was mainly active in genre films, specializing in adventure films, giallo films and poliziotteschi...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e9FbuObq7wOGLHcrdNaHm5HZopk.jpg", url:"https://themoviedb.org/person/27383"}}, {tmdbId:"31011", properties:{bornIn:"Milan, Lombardy, Italy", imdbId:"0643647", born:date('1957-09-12'), name:"Andrea Occhipinti", bio:"From Wikipedia, the free encyclopedia\n\nAndrea Occhipinti (born September 12, 1957) is an Italian actor and producer (Lucky Red).  He was born in Milan.  Among the many films he has appeared in, he worked with director Lucio Fulci in the films The New York Ripper and Conquest. \n\nDescription above from the Wikipedia article Andrea Occhipinti, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/juFzfnpQ8JX5Hvj5NBmSm0Dj9xa.jpg", url:"https://themoviedb.org/person/31011"}}, {tmdbId:"140055", properties:{imdbId:"0667414", born:date('1954-05-28'), name:"Rebecca Pauly", url:"https://themoviedb.org/person/140055"}}, {tmdbId:"140056", properties:{imdbId:"0453934", name:"Jeffrey Kime", url:"https://themoviedb.org/person/140056"}}, {tmdbId:"134514", properties:{imdbId:"0136953", name:"Geoffrey Carey", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yLeeD8yH06bVaFVIREo22Y1DSTm.jpg", url:"https://themoviedb.org/person/134514"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"8212", properties:{bornIn:"New York City, New York, USA", imdbId:"0001251", born:date('1955-08-19'), name:"Peter Gallagher", bio:"Peter Killian Gallagher (born August 19, 1955 height 5' 10\" (1,78 m)) is an American actor, musician and writer.  Since 1980, Gallagher has played many roles in numerous Hollywood films.  He starred as Sandy Cohen in the television drama series The O. C.  from 2003 to 2007.  He currently appears in a recurring role on the USA Network drama Covert Affairs as CIA Clandestine Services Director Arthur Campbell...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AtsnIt7L6C0xuuynchKVWrfFsnf.jpg", url:"https://themoviedb.org/person/8212"}}, {tmdbId:"589", properties:{bornIn:"Chicago, Illinois, USA ", imdbId:"0000435", born:date('1960-12-03'), name:"Daryl Hannah", bio:"Daryl Hannah was born and raised in Chicago, Illinois.  She attend the University of Southern California (USC) and made her film debut in the Brian De Palma film The Fury (1978).  She starred in such films as Ron Howard's Splash (1984) and 'Herbert Ross' Steel Magnolias (1989).  She won the Jury Award from the Berlin International Film Festival for Best Short in 1994 for a film titled The Last Supper (1993), which she directed, wrote, and produced...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4LLmp6AQdlj6ueGCRbVRSGvvFSt.jpg", url:"https://themoviedb.org/person/589"}}, {tmdbId:"100564", properties:{bornIn:"Paris, France", imdbId:"0703211", born:date('1957-12-03'), name:"Valérie Quennessen", bio:"From Wikipedia, the free encyclopedia\n\nValérie Quennessen (3 December 1957 – 19 March 1989) was a French film actress. \n\nQuennessen was born in Paris and dedicated much of her childhood to pursuing her dream of becoming an acrobat.  She quickly reached a level of competence and received an award for her expertise at the age of ten...", died:date('1989-03-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wMmCW7jgElnad2ZpCVnUAt00IP7.jpg", url:"https://themoviedb.org/person/100564"}}, {tmdbId:"6719", properties:{bornIn:"Akron, Ohio, USA", imdbId:"0936403", born:date('1947-08-20'), name:"Ray Wise", bio:"From Wikipedia, the free encyclopedia. \n\nRaymond Nicolas \"Ray\" Wise (born August 20, 1947) is an American actor, known for his roles as Leland Palmer in Twin Peaks, as Leon C.  Nash, right-hand henchman to villain Clarence Boddicker in the science fiction classic RoboCop, and recently as the Devil in the CW television series Reaper...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eWTLIEErX41wDpm6eMlbQcJ5oMf.jpg", url:"https://themoviedb.org/person/6719"}}, {tmdbId:"43628", properties:{imdbId:"0195291", born:date('1956-08-16'), name:"Mirella D'Angelo", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xtws8mbJQFFNYOjseFqZJYpNvbm.jpg", url:"https://themoviedb.org/person/43628"}}, {tmdbId:"1139221", properties:{imdbId:"0488194", born:date('1956-07-19'), name:"Veronica Lario", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/f29TTzeFGUIs4rhxsIpz9gM3lyh.jpg", url:"https://themoviedb.org/person/1139221"}}, {tmdbId:"79740", properties:{bornIn:"Oneonta, New York, USA", imdbId:"0582773", born:date('1951-06-23'), name:"Jim Metzler", bio:"​From Wikipedia, the free encyclopedia.   \n\nJim Metzler (born June 23, 1951) is an American television and film actor, best known for guest-appearances on popular TV series.  In 1983, he received a Golden Globe nomination for his supporting role in the 1982 film Tex. \n\nFormer jobs of his include a minor league baseball player, a sports reporter, and a job that required him to repair cracks on airline runways...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1suCtSYliqGRdN6BOSWsvPZoHDz.jpg", url:"https://themoviedb.org/person/79740"}}, {tmdbId:"39117", properties:{bornIn:"Long Beach, California, USA", imdbId:"0000672", born:date('1960-02-14'), name:"Meg Tilly", bio:"​From Wikipedia, the free encyclopedia\n\nMeg Tilly (born Margaret Elizabeth Chan; February 14, 1960) is a Canadian-American actress and novelist. \n\nFor her role in the 1985 film Agnes of God, she won a Golden Globe Award and was nominated for the Academy Award for Best Supporting Actress.  For her role in the television series Bomb Girls (2012–13), she won the 2013 Canadian Screen Award for Best Lead Actress in a Drama Series...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9XuXXuJliK8UDIXJBWzoBTnoX8b.jpg", url:"https://themoviedb.org/person/39117"}}, {tmdbId:"11065", properties:{bornIn:"Salt Lake City, Utah, USA", imdbId:"0000979", born:date('1934-09-27'), name:"Wilford Brimley", bio:"From Wikipedia, the free encyclopedia\n\nAnthony Wilford Brimley (September 27, 1934 – August 1, 2020) was an American actor and singer.  After serving in the Marines and taking on a variety of odd jobs, he became an extra for Western films, and in little more than a decade he had established himself as a character actor in films such as The China Syndrome (1979), The Thing (1982), and The Natural (1984).  Brimley was the longtime face of television advertisements for the Quaker Oats Company...", died:date('2020-08-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qDW8Sv7RzP5nP2d5LQaQ07jxAtp.jpg", url:"https://themoviedb.org/person/11065"}}, {tmdbId:"15411", properties:{bornIn:"New York City, New York, USA", imdbId:"0141953", born:date('1956-12-18'), name:"T.K. Carter", bio:"An American comedian and actor.  He is best known for playing Michael \"Mike\" Fulton, an elementary school teacher, on the NBC series Punky Brewster and Mylo Williams on the Disney Channel series Good Morning, Miss Bliss as a supervisor, whose catchphrase was \"Mylo gots to get his!\" He is also well known for playing the role of drug addicted Gary McCullough in the hard hitting dramatic HBO miniseries The Corner...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rqlDLtg8USZsO07VEiYQpQyjyA2.jpg", url:"https://themoviedb.org/person/15411"}}, {tmdbId:"15412", properties:{bornIn:"Waukegan, Illinois, United States", imdbId:"0166359", born:date('1943-05-10'), name:"David Clennon", bio:"​From Wikipedia, the free encyclopedia\n\nDavid Clennon (born May 10, 1943) is an American actor perhaps best known for his portrayal of Miles Drentel in the ABC series Thirtysomething, a role he reprised on Once and Again. \n\nClennon was born in Waukegan, Illinois, the son of Virginia, a homemaker, and Cecil Clennon, an accountant.  Clennon is well known for his political activism. \n\nIn 1980, David Clennon provided the voice for Admiral Motti in NPR's Star Wars The Original Radio Drama...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p8TcS7O7xtCCW8MlnalFiwZomkX.jpg", url:"https://themoviedb.org/person/15412"}}, {tmdbId:"12710", properties:{bornIn:"Sacramento, California, USA", imdbId:"0777432", born:date('1968-05-12'), name:"Scott Schwartz", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h4GsN59T9UgdWRO8srnL1HOXnzE.jpg", url:"https://themoviedb.org/person/12710"}}, {tmdbId:"58661", properties:{bornIn:"New York City, New York, USA", imdbId:"0612321", born:date('1932-11-13'), name:"Richard Mulligan", bio:"From Wikipedia, the free encyclopedia\n\nRichard Mulligan (November 13, 1932 – September 26, 2000) was an American television and film actor. \n\nDescription above from the Wikipedia article Richard Mulligan, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2000-09-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tYy2aV5dzOLruCYNQIFYSAaRF1j.jpg", url:"https://themoviedb.org/person/58661"}}, {tmdbId:"2547", properties:{bornIn:"Elgin, Illinois, USA", imdbId:"0000310", born:date('1950-05-12'), name:"Bruce Boxleitner", bio:"From Wikipedia, the free encyclopedia.   \n\nBruce William Boxleitner (born May 12, 1950) is an American actor, and science fiction and suspense writer.  He is known for his leading roles in the television series How the West Was Won, Bring 'Em Back Alive, Scarecrow and Mrs.  King (with Kate Jackson), and Babylon 5 (as John Sheridan in seasons 2–5, 1994–1998)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gBB5XKWGXFA4Y9s1mV15wTZUkSD.jpg", url:"https://themoviedb.org/person/2547"}}, {tmdbId:"2548", properties:{bornIn:"Chicago, Illinois, U.S.", imdbId:"0604563", born:date('1954-09-29'), name:"Cindy Morgan", bio:"Cindy Morgan is an American actress best known for her appearances as Lora/Yori in Tron and Lacey Underall in Caddyshack...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7VRUz6w2PDN75gOM12cRAREWu5f.jpg", url:"https://themoviedb.org/person/2548"}}, {tmdbId:"246358", properties:{bornIn:"Winterberg, North Rhine-Westphalia, Germany", imdbId:"0485713", born:date('1943-12-23'), name:"Christa Lang", url:"https://themoviedb.org/person/246358"}}, {tmdbId:"119782", properties:{bornIn:"Hattieburg, Mississippi, USA", imdbId:"0917136", born:date('1935-08-24'), name:"Vernon Weddle", url:"https://themoviedb.org/person/119782"}}, {tmdbId:"515", properties:{bornIn:"Greenwich, Connecticut, USA", imdbId:"0000335", born:date('1947-03-19'), name:"Glenn Close", bio:"Glenn Close (born March 19, 1947) is an American actress and singer of theatre and film, known for her roles as a femme fatale (the scheming Marquise de Merteuil in Dangerous Liaisons (1988), and deranged stalker Alex Forrest in Fatal Attraction (1987).  She is also known for playing Cruella de Vil in 101 Dalmatians (1996), and its sequel 102 Dalmatians (2000).  She has been more recently known for her Emmy winning role as Patty Hewes in the FX TV series Damages...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8FlKKFpUZ72oTpVKdVsjMmq1CWQ.jpg", url:"https://themoviedb.org/person/515"}}, {tmdbId:"21731", properties:{bornIn:"New York City, New York, USA", imdbId:"0571106", born:date('1947-10-17'), name:"Michael McKean", bio:"Michael McKean (born October 17, 1947) is an American actor, comedian, writer, composer and musician, perhaps best known for Laverne & Shirley and Spinal Tap...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xSwMjo3hLLVeopaHwYDdM1m5enl.jpg", url:"https://themoviedb.org/person/21731"}}, {tmdbId:"182851", properties:{imdbId:"0295055", name:"Gary Friedkin", url:"https://themoviedb.org/person/182851"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"31115", properties:{bornIn:"Chicago, Illinois", imdbId:"0373600", name:"Kyle T. Heffner", bio:"From Wikipedia, the free encyclopedia\n\nKyle Troy Heffner is an American television and film actor. \n\nHeffner graduated from Northwestern University.  After graduation he moved to Los Angeles and met Garry Marshall, who cast him in Young Doctors in Love (1982).  Heffner also appeared in the films Flashdance (1983), The Woman in Red (1984), Runaway Train (1985), Spellbinder (1988), and When Harry Met Sally (1989)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q1gtv6XvTCyCwaop5kelxajXdSW.jpg", url:"https://themoviedb.org/person/31115"}}, {tmdbId:"234297", properties:{bornIn:"Wichita, Kansas, USA", imdbId:"0175060", born:date('1941-09-08'), name:"Christopher Connelly", died:date('1988-12-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3kN6SQXpnZhP3U0NiYTyv4RAtxd.jpg", url:"https://themoviedb.org/person/234297"}}, {tmdbId:"234314", properties:{imdbId:"0339888", born:date('1965-07-12'), name:"Mark Gregory", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jsIyY7n0hGmZSN9r527AwrOdySJ.jpg", url:"https://themoviedb.org/person/234314"}}, {tmdbId:"62424", properties:{bornIn:"Zhutian, Taiwan", imdbId:"0526714", born:date('1953-04-15'), name:"Dick Wei", bio:"Dick Wei (Chinese: 狄威, born April 15, 1953) is a Taiwanese actor, director and writer who specializes in martial arts and action films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pkllOdDN2CGukmyOv2XlzoMAQfC.jpg", url:"https://themoviedb.org/person/62424"}}, {tmdbId:"500", properties:{bornIn:"Syracuse, New York, USA", imdbId:"0000129", born:date('1962-07-03'), name:"Tom Cruise", bio:"An American actor and filmmaker.  He has been nominated for three Academy Awards and has won three Golden Globe Awards.  He started his career at age 19 in the 1981 film Endless Love.  After portraying supporting roles in Taps (1981) and The Outsiders (1983), his first leading role was in Risky Business, released in August 1983.  Cruise became a full-fledged movie star after starring as Pete \"Maverick\" Mitchell in Top Gun (1986)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gThaIXgpCm3PCiXwFNDBJCme85y.jpg", url:"https://themoviedb.org/person/500"}}, {tmdbId:"1063", properties:{bornIn:"Rochester, Minnesota, USA", imdbId:"0000670", born:date('1961-05-31'), name:"Lea Thompson", bio:"From Wikipedia, the free encyclopedia. \n\nLea Katherine Thompson (born May 31, 1961, height 5' 3\" (1,60 m)) is an American actress and director.  She is best known for her 1990s NBC situation comedy Caroline in the City and her portrayal of Lorraine Baines McFly, Marty McFly's mother, in the Back to the Future trilogy...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zzWDfd3DJXFc4010U1I9VGSxnTb.jpg", url:"https://themoviedb.org/person/1063"}}, {tmdbId:"41249", properties:{bornIn:"Mammoth Spring, Arkansas, USA", imdbId:"0002128", born:date('1950-08-15'), name:"Tess Harper", bio:"Tessie Jean \"Tess\" Harper is an American actress.  She was nominated for the Golden Globe Award for Best Supporting Actress for her first film role in 1983's Tender Mercies, and for the Academy Award for Best Supporting Actress for the 1986 film Crimes of the Heart.  Her other film appearances include Flashpoint (1984), Ishtar (1987), Far North (1988), and No Country for Old Men (2007).  She also had a recurring role on the first three seasons of Breaking Bad (2008–2010)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8Z770Kk13MK1NP7skWmTxvRGx3V.jpg", url:"https://themoviedb.org/person/41249"}}, {tmdbId:"19976", properties:{bornIn:"St. Johns - Newfoundland - Canada", imdbId:"0431451", born:date('1951-08-17'), name:"Robert Joy", bio:"Robert Joy (born August 17, 1951) is a Canadian actor and producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6Qb4FGtEjdqLNyR3ZmqA7ZTLBhw.jpg", url:"https://themoviedb.org/person/19976"}}, {tmdbId:"74828", properties:{bornIn:"Portsmouth, Virginia", imdbId:"0600490", born:date('1949-09-25'), name:"Jim Moody", bio:"​From Wikipedia, the free encyclopedia.   \n\nJim Moody (born September 25, 1949 in Portsmouth, Virginia) is a television and film character actor.  He played the tough talking counselor/teacher Gene Daniels in Bad Boys.  His first feature film was in the 1980 hit film Fame, which he played Mr.  Farrell, a drama teacher.  Jim starred in the 1983 comedy film D. C.  Cab as Arnie, a member of the rival cab company, Emerald Cab.  He also appeared in the 1999 drama The Best Man and as Leroy Greene, Sr...", url:"https://themoviedb.org/person/74828"}}, {tmdbId:"74829", properties:{imdbId:"0348747", born:date('1966-12-14'), name:"Eric Gurry", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jXJJp80dhGAjRIzwMe39bdzOG3V.jpg", url:"https://themoviedb.org/person/74829"}}, {tmdbId:"15211", properties:{bornIn:"Neuilly-sur-Seine, Hauts-de-Seine, France", imdbId:"0438585", born:date('1962-08-19'), name:"Valérie Kaprisky", bio:"Valérie Kaprisky (born August 19, 1962) is a French actress.  She was born Valerie Chérès in Neuilly-sur-Seine, Hauts-de-Seine, France.  Kaprisky is her mother's maiden name.  She appeared in soft-core exploitation (Aphrodite), then made her American debut in the A Bout de Souffle remake Breathless (1983) frolicking with Richard Gere with whom she subsequently had a reportedly-tempestuous affair.  The film was critically panned and she returned to filming in France...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1oO93TRsh4xHBJL7HhGgvhBHmed.jpg", url:"https://themoviedb.org/person/15211"}}, {tmdbId:"15212", properties:{bornIn:"New York City, New York, USA", imdbId:"0582586", born:date('1936-09-22'), name:"Art Metrano", bio:"Arthur \"Art\" Metrano (born September 22, 1936) is an American actor and comedian, born in Brooklyn, New York City.  Metrano may be best known for his role as Lt. /Capt. /Cmdt.  Mauser in Police Academy 2 and Police Academy 3. \n\nMetrano's first film role was as a truck driver in the 1961 Cold War thriller Rocket Attack U. S. A. .  Among Metrano's TV guest appearances was a 1968 episode of Ironside...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/73Z3AAdHvtDbpm3MnakRSp6axPS.jpg", url:"https://themoviedb.org/person/15212"}}, {tmdbId:"15213", properties:{bornIn:"New York City, New York, USA", imdbId:"0752636", born:date('1936-07-30'), name:"John P. Ryan", bio:"Character actor John P.  Ryan was born on July 30, 1936 in New York City.  The son of Irish immigrant parents, Ryan graduated from Rice High School and studied English at the City College of New York, where he first developed an interest in acting.  He served six years in the US Army and worked as a welfare investigator prior to pursuing an acting career.  John made his film debut in the 1967 comedy \"The Tiger Makes Out...", died:date('2007-03-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6WV5Sv2YnFG0W1rVnxOxpLyIFUM.jpg", url:"https://themoviedb.org/person/15213"}}, {tmdbId:"133182", properties:{bornIn:"Elda - Alicante - Comunidad Valenciana - Spain", imdbId:"0300565", born:date('1936-11-14'), name:"Antonio Gades", bio:"Spanish-born actor Antonio Gades was born on November 14, 1936.  He is best known for his work on Carmen (1983), Blood Wedding (1981) and Los tarantos (1963)...", died:date('2004-07-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zaenE6RjlKmMHdxwVSnMDUWjBH.jpg", url:"https://themoviedb.org/person/133182"}}, {tmdbId:"103670", properties:{bornIn:"Barcelona, Spain", imdbId:"0812556", born:date('1961-11-27'), name:"Laura del Sol", bio:"Laura del Sol  is a Spanish flamenco dancer, stage and screen actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4aYjp9Yolm2XgLwaETUXeJZS4TJ.jpg", url:"https://themoviedb.org/person/103670"}}, {tmdbId:"84959", properties:{bornIn:"Algeciras, Cadiz, Spain, EU", imdbId:"0524834", born:date('1947-12-21'), name:"Paco de Lucía", died:date('2014-02-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zv8VYWrBSswZl8YKPjdbtL59j30.jpg", url:"https://themoviedb.org/person/84959"}}, {tmdbId:"71524", properties:{imdbId:"0548114", born:date('1948-02-04'), name:"Marisol", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/63o6ljdllDNQeMaI1f839aVeZm9.jpg", url:"https://themoviedb.org/person/71524"}}, {tmdbId:"55567", properties:{bornIn:"New York City, New York, USA", imdbId:"0000575", born:date('1963-07-29'), name:"Alexandra Paul", bio:"Alexandra Elizabeth Paul (born July 29, 1963) is an American actress.  She is best known for her role as Lt.  Stephanie Holden in the television series Baywatch from 1992–97.  She has starred in over 60 movies and television programs. \n\nDescription above from the Wikipedia article Alexandra Paul, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aih7W4GZFVhX3VF0yJvhuvIUdbS.jpg", url:"https://themoviedb.org/person/55567"}}, {tmdbId:"10360", properties:{bornIn:"Philadelphia, Pennsylvania, USA", imdbId:"0698764", born:date('1930-12-13'), name:"Robert Prosky", bio:"From Wikipedia, the free encyclopedia.   Robert Prosky (December 13, 1930 — December 8, 2008) was an American stage, film, and television actor. \n\nDescription above from the Wikipedia article Robert Prosky, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2008-12-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yV95RE8UGyN8rZYF9W4fOGaAV6U.jpg", url:"https://themoviedb.org/person/10360"}}, {tmdbId:"2879", properties:{bornIn:"Charlottesville, Virginia, USA", imdbId:"0000507", born:date('1964-03-17'), name:"Rob Lowe", bio:"Robert Hepler \"Rob\" Lowe (born March 17, 1964) is an American actor.  Lowe came to prominence after appearing in films such as The Outsiders, Oxford Blues, About Last Night. . . , and St.  Elmo's Fire.  On television, Lowe is known for his role as Sam Seaborn on The West Wing and his role as Senator Robert McCallister on Brothers & Sisters.  He is currently a main cast member of Parks and Recreation, playing the role of Chris Traeger...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/77decDyKXB34i9A1FnMM1suI5cA.jpg", url:"https://themoviedb.org/person/2879"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"37041", properties:{bornIn:"New York City, New York, USA", imdbId:"0000530", born:date('1962-11-29'), name:"Andrew McCarthy", bio:"From Wikipedia, the free encyclopedia.  Andrew Thomas McCarthy (born November 29, 1962) is an American actor.  He is best known for his roles in the 1980s films St.  Elmo's Fire, Mannequin, Weekend at Bernie's, Pretty in Pink, and Less Than Zero, and more recently for his role in the television shows Lipstick Jungle and Royal Pains. \n\nDescription above from the Wikipedia article Andrew McCarthy, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/swlewiX5zUjF5za9JOFXIVrL3kH.jpg", url:"https://themoviedb.org/person/37041"}}, {tmdbId:"65403", properties:{bornIn:"Milltown, New Jersey, USA", imdbId:"0001622", born:date('1976-01-06'), name:"Danny Pintauro", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wjw8xvFHihPChelLn3ymiY29ksZ.jpg", url:"https://themoviedb.org/person/65403"}}, {tmdbId:"22111", properties:{bornIn:"Elizabeth, New Jersey, USA", imdbId:"0446298", born:date('1952-08-10'), name:"Daniel Hugh Kelly", bio:"The middle of five children.  His father was a police officer/detective and his mother was a social worker.  He received his B. A.  from St.  Vincent College in Latrobe, Pennsylvania and pursued his M. F. A.  on a full scholarship at the Catholic University of America in Washington, D. C.  Kelly has appeared in numerous off-Broadway and off-off-Broadway productions, primarily at the Public Theater and the Second Stage...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bueEXd57jY2PWZUC1nRRBmIE2Ou.jpg", url:"https://themoviedb.org/person/22111"}}, {tmdbId:"53085", properties:{bornIn:"Knoxville, Tennessee", imdbId:"0191633", born:date('1930-03-02'), name:"John Cullum", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wcxrgq42tlSUu49D2X6tVAQ88BB.jpg", url:"https://themoviedb.org/person/53085"}}, {tmdbId:"9283", properties:{bornIn:"Brooklyn, New York, U.S.", imdbId:"0044489", born:date('1945-05-18'), name:"Candice Azzara", bio:"​From Wikipedia, the free encyclopedia.   \n\nCandice \"Candy\" Azzara (born May 18, 1945) is an American character actress frequently cast in Italian or Jewish roles. \n\nAzzara was born in Brooklyn, the daughter of Josephine (née Bravo) and Samuel Azzara.  She was inspired to pursue acting by the film La Strada and theatre legend Eleanora Duse.  She studied with Lee Strasberg and Gene Frankel and soon began appearing off-Broadway and in regional theatres...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4H5oacxmRVgqc2oGU9SmjRaOr1A.jpg", url:"https://themoviedb.org/person/9283"}}, {tmdbId:"1090800", properties:{imdbId:"2870274", name:"James Argiro", url:"https://themoviedb.org/person/1090800"}}, {tmdbId:"60650", properties:{bornIn:"Brooklyn, New York City, New York, USA", imdbId:"0001595", born:date('1958-10-09'), name:"Michael Paré", bio:"Michael Paré (born October 9, 1958) is an American actor.  His first starring role was as Tony Villicana on the television series The Greatest American Hero.  His best-known film roles were as Eddie Wilson in Eddie and the Cruisers (1983) and its sequel Eddie and the Cruisers II: Eddie Lives! (1989), as well as Streets of Fire (1984) and The Philadelphia Experiment (1984)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jxrXW8OL6hwJgtJgePdMO5yHuAM.jpg", url:"https://themoviedb.org/person/60650"}}, {tmdbId:"532", properties:{bornIn:"Hoboken, New Jersey, USA", imdbId:"0001592", born:date('1951-09-12'), name:"Joe Pantoliano", bio:"An American film and television actor.  He played the character of Ralph Cifaretto on The Sopranos, Bob Keane in La Bamba, Cypher in The Matrix, Teddy in Memento, Francis Fratelli in The Goonies, Guido \"the Killer Pimp\" in Risky Business, and Jennifer Tilly's violent mobster boyfriend, Caesar, in Bound.  He also played US Marshall Renfro in both The Fugitive and U. S.  Marshals.  He is often referred to as \"Joey Pants\", due to the difficulty some have pronouncing his Italian surname...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aDOm4xPRtIwBpLd8O2oCz0aVC3s.jpg", url:"https://themoviedb.org/person/532"}}, {tmdbId:"164723", properties:{bornIn:"Queens, New York, USA", imdbId:"0491005", born:date('1950-03-02'), name:"Matthew Laurance", url:"https://themoviedb.org/person/164723"}}, {tmdbId:"477", properties:{bornIn:"Smethwick, England, UK", imdbId:"0910278", born:date('1950-02-22'), name:"Julie Walters", bio:"An English actress and novelist.  Walters was born as Julia Mary Walters in Smethwick, Sandwell, the daughter of Mary Bridget, a postal clerk of Irish Catholic extraction, and Thomas Walters, a builder and decorator.  Walters met her husband, Grant Roffey, an AA patrol man, in a whirlwind romance.  The couple have a daughter, Maisie Mae Roffey (born 1988, City of Westminster, London), but did not marry until 1997, 11 years into their relationship, when they went to New York...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bCTkV2OUgzbJdQEoCk3GesE4DXq.jpg", url:"https://themoviedb.org/person/477"}}, {tmdbId:"138411", properties:{bornIn:"Liverpool, Lancashire, England, UK", imdbId:"0931302", born:date('1935-07-09'), name:"Michael Williams", bio:"​Michael Williams was a British stage, film and television actor.  He was married to actress Dame Judi Dench...", died:date('2001-01-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kAULYzkbCITWBJxrQOxz47y96w4.jpg", url:"https://themoviedb.org/person/138411"}}, {tmdbId:"6638", properties:{bornIn:"Hull, Yorkshire, England, UK", imdbId:"0513520", born:date('1946-05-10'), name:"Maureen Lipman", bio:"From Wikipedia, the free encyclopedia. \n\nMaureen Diane Lipman CBE (born 10 May 1946) is a British film, theatre and television actress, columnist, and comedienne. \n\nDescription above from the Wikipedia article Maureen Lipman, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/6638"}}, {tmdbId:"7368", properties:{bornIn:"Veracruz, Mexico", imdbId:"0350884", born:date('1933-11-07'), name:"Ernesto Gómez Cruz", bio:"From Wikipedia, the free encyclopedia.   Ernesto Gómez Cruz (born 7 November 1933) is a prolific Mexican actor with more than 154 films.   He has been nominated several times for the Ariel Award.  These include his acting in El Infierno (2010), El crimen del Padre Amaro (2002), El imperio de la fortuna by Arturo Ripstein (1987), La víspera de Alejandro Pelayo (1983), Cadena perpetua by Ripstein (1979), La venida del Rey Olmos by Julián Pastor (1975), and Rosa by José Estrada (1969)...", url:"https://themoviedb.org/person/7368"}}, {tmdbId:"146797", properties:{bornIn:"Mexico City, Distrito Federal, Mexico", imdbId:"0897813", born:date('1959-01-02'), name:"David Villalpando", bio:"David Villalpando (born January 2, 1959 in Mexico City, Mexico) is a Mexican actor.  His break out role was in the film El Norte (1983).  Since then he's had small roles in American films such as The Arrival, The Mask of Zorro, and the John Sayles film Men with Guns (1997).  He was also in an episode in the television series Acapulco H. E. A. T. , and has done a lot of work in Mexican cinema...", url:"https://themoviedb.org/person/146797"}}, {tmdbId:"36635", properties:{bornIn:"Mexico City, Distrito Federal, Mexico", imdbId:"0349611", born:date('1959-11-02'), name:"Zaide Silvia Gutiérrez", bio:"From Wikipedia, the free encyclopedia.  Zaide Silvia Gutiérrez (born November 2, 1959 in Mexico City, Mexico) is a Mexican-born actress whose breakout role was the 1983 film El Norte...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7QLXh5pF73ozOtPAIWtFRuTo1az.jpg", url:"https://themoviedb.org/person/36635"}}, {tmdbId:"1026995", properties:{bornIn:"Patzcuaro, Michoacan, Mexico", imdbId:"0215606", born:date('1935-01-11'), name:"Alicia del Lago", bio:"Alicia del Lago was born on January 11, 1935 in Patzcuaro, Michoacan, Mexico.  She was an actress...", died:date('2015-07-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1n5hFOy625SaSiwREzQGWagjroi.jpg", url:"https://themoviedb.org/person/1026995"}}, {tmdbId:"37549", properties:{bornIn:"  Madrid, Spain", imdbId:"0664440", born:date('1959-05-21'), name:"Cristina Sánchez Pascual", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/769fWClNHaqqs4ShmqGOc922d1c.jpg", url:"https://themoviedb.org/person/37549"}}, {tmdbId:"37518", properties:{imdbId:"0603346", name:"Will More", url:"https://themoviedb.org/person/37518"}}, {tmdbId:"19812", properties:{imdbId:"0148387", name:"Laura Cepeda", url:"https://themoviedb.org/person/19812"}}, {tmdbId:"54135", properties:{imdbId:"0959245", name:"Miguel Zúñiga", url:"https://themoviedb.org/person/54135"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"91620", properties:{imdbId:"0636278", name:"Randy Norton", url:"https://themoviedb.org/person/91620"}}, {tmdbId:"91621", properties:{bornIn:" Los Angeles, California, USA", imdbId:"0495022", born:date('1957-04-20'), name:"Cynthia Leake", url:"https://themoviedb.org/person/91621"}}, {tmdbId:"15999", properties:{bornIn:"Pittsburgh, Pennsylvania, USA", imdbId:"0762080", born:date('1937-10-27'), name:"Steve Sandor", died:date('2017-04-05'), url:"https://themoviedb.org/person/15999"}}, {tmdbId:"91622", properties:{imdbId:"0360484", name:"Sean Hannon", url:"https://themoviedb.org/person/91622"}}, {tmdbId:"3130", properties:{bornIn:"Chicago - Illinois - USA", imdbId:"0000884", born:date('1963-12-19'), name:"Jennifer Beals", bio:"Jennifer Beals (born December 19, 1963, height 5' 8½\" (1,74 m)) is an American actress and a former teen model.  She is known for her roles as Alexandra \"Alex\" Owens in the 1983 film Flashdance, and as Bette Porter on the Showtime drama series The L Word.  She earned an NAACP Image Award and a Golden Globe Award nomination for the former.  She has appeared in more than 50 films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x4Nb5AGjV0WQxWpF04NZY6brzlx.jpg", url:"https://themoviedb.org/person/3130"}}, {tmdbId:"8699", properties:{bornIn:"Washington, District of Columbia, USA", imdbId:"0636694", born:date('1945-12-09'), name:"Michael Nouri", bio:"From Wikipedia, the free encyclopedia\n\nMichael Nouri (born December 9, 1945) is an American television and film actor.  He may be best known for his role as Nick Hurley, in the 1983 film Flashdance.  He has had recurring roles in numerous television series, including NCIS as Eli David, the father of Mossad officer (now Special Agent) Ziva David, The O. C.  as Dr.  Neil Roberts, and Damages as Phil Gray...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qA5xzpJiUHxfoBERmoxqJFqmWfp.jpg", url:"https://themoviedb.org/person/8699"}}, {tmdbId:"31116", properties:{bornIn:"San Bernardino County, California, USA", imdbId:"1230879", born:date('1953-09-21'), name:"Sunny Johnson", died:date('1984-06-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/foLbiFLTAYM7SxwW6c2Ojc2Vo38.jpg", url:"https://themoviedb.org/person/31116"}}, {tmdbId:"11784", properties:{bornIn:"Pittsburgh, Pennsylvania, USA", imdbId:"0040662", born:date('1935-11-13'), name:"Tom Atkins", bio:"​From Wikipedia, the free encyclopedia. \n\nTom Atkins  (born November 13, 1935) is an American television and film actor.  He is primarily known for his work in the horror film genre, having worked with writers and directors such as John Carpenter, Stephen King, and George A.  Romero.  He is also a familiar face to mainstream viewers, often playing police officers...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cqQnpAlq3FNLDr1jrAkUJokLw1M.jpg", url:"https://themoviedb.org/person/11784"}}, {tmdbId:"66199", properties:{bornIn:"New York City, New York, USA", imdbId:"0625030", born:date('1959-09-10'), name:"Stacey Nelkin", url:"https://themoviedb.org/person/66199"}}, {tmdbId:"66200", properties:{imdbId:"0192980", born:date('1928-07-24'), name:"Michael Currie", died:date('2009-12-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ubD2zMK84haR72tgaxSaDCcrpPE.jpg", url:"https://themoviedb.org/person/66200"}}, {tmdbId:"44301", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0002037", born:date('1945-02-12'), name:"Cliff De Young", bio:"Clifford Tobin DeYoung (born February 12, 1945), better known as Cliff DeYoung, is an American actor and musician. \n\nPrior to his acting career, he was the lead singer of the 1960s rock group Clear Light, which played with The Doors, Jimi Hendrix, and Janis Joplin.  After the band broke up, he starred in the Broadway production of Hair and the Tony Award-winning Sticks and Bones...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ldR2Io08NFxj0K2fACm7Uii8qoW.jpg", url:"https://themoviedb.org/person/44301"}}, {tmdbId:"29710", properties:{bornIn:"Baltimore, Maryland, USA", imdbId:"0000787", born:date('1953-12-11'), name:"Bess Armstrong", bio:"Bess Armstrong (born December 11, 1953) is an American film and television actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3kQttHj9mbsDsP2GUljpjTAoWVi.jpg", url:"https://themoviedb.org/person/29710"}}, {tmdbId:"24743", properties:{bornIn:"Ely, Cambridgeshire, England, UK", imdbId:"0531546", born:date('1952-02-12'), name:"Simon MacCorkindale", bio:"Simon Charles Pendered MacCorkindale was a British actor, film director, writer and producer.  He spent much of his childhood moving around due to his father serving as an Officer with the Royal Air Force.  Poor eyesight prevented him following a similar career in the RAF, so he instead planned to become a theatre director.  Training at the Theatre of Arts in London, he started work as an actor, making his West End debut in 1974...", died:date('2010-10-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rlNnpXapxZTw3LkNcqqdbJUki2Y.jpg", url:"https://themoviedb.org/person/24743"}}, {tmdbId:"20959", properties:{bornIn:"Brooklyn, New York City, New York, USA", imdbId:"0001283", born:date('1936-05-27'), name:"Louis Gossett Jr.", bio:"Louis Gossett Jr.  is an American film and television actor, best known for his role as Gunnery Sergeant Emil Foley in the movie \"An Officer and a Gentleman\" and as Fiddler in the television miniseries \"Roots\".  He has won an Academy Award, an Emmy Award, and two Golden Globe Awards in an acting career that spans over five decades...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dgdrMn6a5WSuFcZwy0OEjGHdtQy.jpg", url:"https://themoviedb.org/person/20959"}}, {tmdbId:"104598", properties:{bornIn:"Childress County, Texas, USA", imdbId:"1463161", born:date('1945-09-24'), name:"Lou Dobbs", bio:"Louis Carl Dobbs is an American television commentator, author, conspiracy theorist, anti-immigration advocate, radio show host, and the anchor of Lou Dobbs Tonight on Fox Business Network.  Dobbs started working with CNN at its inception in 1980, serving as a reporter and network vice president...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qszdPzP4UUB65IM6Yd0SBBxhmsK.jpg", url:"https://themoviedb.org/person/104598"}}, {tmdbId:"1215120", properties:{imdbId:"0465901", name:"Ted Koppel", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/juTocqap2nkGdoPh1PLIZhGbLej.jpg", url:"https://themoviedb.org/person/1215120"}}, {tmdbId:"12811", properties:{bornIn:"Harlem, New York City, New York, USA", imdbId:"0550989", born:date('1950-06-27'), name:"Ken Marshall", bio:"From Wikipedia, the free encyclopedia\n\nKenneth Marshall (b.  27 June 1950, New York City) is an American actor.  He is probably best known for his portrayal of the character Michael Eddington in the television series Star Trek: Deep Space Nine and his starring role as Prince Colwyn in Krull.  He also appeared in the movie Tilt with Brooke Shields and in the title role in Giuliano Montaldo's 1982 television miniseries Marco Polo...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mGzxFXkACEimeJN4Ol9bisdk3kp.jpg", url:"https://themoviedb.org/person/12811"}}, {tmdbId:"12812", properties:{bornIn:" London, England, UK", imdbId:"0000771", born:date('1963-09-26'), name:"Lysette Anthony", bio:"Lysette Anthony (born on 26 September 1963) is an English film, television, and theatre actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x48FYc2hgzcJrqcZhKjp9bzBwOF.jpg", url:"https://themoviedb.org/person/12812"}}, {tmdbId:"68686", properties:{bornIn:"Paisley, Scotland, UK", imdbId:"0533161", born:date('1922-08-12'), name:"Fulton Mackay", bio:"​From Wikipedia, the free encyclopedia\n\nFulton Mackay OBE (12 August 1922 - 6 June 1987) was a Scottish actor and playwright, best known for his role as prison officer Mr.  Mackay in the 1970s sitcom Porridge. \n\nDescription above from the Wikipedia article Fulton Mackay, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1987-06-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qba1sKOTG79BjQa2VYiHnLc1ErE.jpg", url:"https://themoviedb.org/person/68686"}}, {tmdbId:"47698", properties:{bornIn:"Perthshire, Scotland, UK", imdbId:"0493200", born:date('1947-09-27'), name:"Denis Lawson", bio:"​From Wikipedia, the free encyclopedia\n\nDenis Stamper Lawson (born 27 September 1947) is a Scottish actor and director.  He is perhaps best known for his roles as John Jarndyce in the BBC's adaptation of Bleak House and as Gordon Urquhart in the film Local Hero. \n\nDescription above from the Wikipedia article Denis Lawson, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/31CpvrSXT5UQv2LjW6T1fBTLrN5.jpg", url:"https://themoviedb.org/person/47698"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"4756", properties:{bornIn:"New York City, New York, USA", imdbId:"0000111", born:date('1962-03-21'), name:"Matthew Broderick", bio:"Matthew Broderick is an American actor whose career has spanned both the silver screen and the stage.   Broderick got his start off broadway but quickly wound up as the lead in Neil Simon's Brighton Beach Memoirs.  His first screen role was Max Dugan Returns, also penned by Neil Simon.   His breakout role came the same year for his role as a young hacker in Wargames...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2Pq8pwOX5ZFfT2p5pNLGfvUi9Pp.jpg", url:"https://themoviedb.org/person/4756"}}, {tmdbId:"76513", properties:{bornIn:"Queens - New York City - New York - USA", imdbId:"0462735", born:date('1975-06-16'), name:"Fred Koehler", bio:"From Wikipedia, the free encyclopedia\n\nFrederick Koehler (born June 16, 1975) is an American actor best known for his role as Chip on Kate and Allie as well as Andrew Schillinger on the HBO drama Oz...", url:"https://themoviedb.org/person/76513"}}, {tmdbId:"37713", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0043552", born:date('1977-01-19'), name:"Taliesin Jaffe", bio:"Taliesin Jaffe (born January 19, 1977) is an American voice director, script writer, voice actor, and former child actor. \n\nJaffe was born in Los Angeles, California.  He is known for directing and writing many English language anime titles for New Generation Pictures, most notably R. O. D the TV and Hellsing.  He is also co-directing BECK: Mongolian Chop Squad with Christopher Bevins for FUNimation.  Together with Amanda Winn Lee and Jason C...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6J7WD9B9ijvP8rw5hREV47MQbUt.jpg", url:"https://themoviedb.org/person/37713"}}, {tmdbId:"22489", properties:{bornIn:"New York City, New York, USA", imdbId:"0443268", born:date('1951-03-12'), name:"Caren Kaye", bio:"​From Wikipedia, the free encyclopedia. \n\nCaren Kaye  (born March 12, 1951) is an American television and film actress who is best known for her roles in the 1983 film My Tutor and the short-lived NBC sitcom It's Your Move...", url:"https://themoviedb.org/person/22489"}}, {tmdbId:"22490", properties:{bornIn:"Portland, Oregon, USA", imdbId:"0490402", born:date('1959-02-01'), name:"Matt Lattanzi", bio:"Matt Lattanzi was born in Portland, Oregon, the son of Jeanette (née Slowikowski) and Charles Paul Lattanzi His father is a maintenance foreman of Italian descent, while his mother is of Polish ancestry.  He was raised in Portland as well, graduating from Benson Polytechnic High School in 1977.  While filming Xanadu, he met Olivia Newton-John, whom he married in 1984.  The couple have one daughter, Chloe Rose Lattanzi, born on January 17, 1986...", url:"https://themoviedb.org/person/22490"}}, {tmdbId:"22492", properties:{bornIn:"New York City, New York, USA", imdbId:"0104745", born:date('1958-12-13'), name:"Clark Brandon", bio:"​From Wikipedia, the free encyclopedia. \n\nClark Brandon  (born December 13, 1958) is an American actor.  His most notable roles were as Max Merlin's apprentice Zachary Rogers in the CBS series Mr.  Merlin and as Sean Fitzpatrick in the CBS series The Fitzpatricks.  He also starred with Jim Varney in the 1989 comedy film, Fast Food...", url:"https://themoviedb.org/person/22492"}}, {tmdbId:"70089", properties:{bornIn:"Philadelphia, Pennsylvania, USA ", imdbId:"0168042", born:date('1908-11-18'), name:"Imogene Coca", bio:"​From Wikipedia, the free encyclopedia.   \n\nImogene Fernandez de Coca (November 18, 1908 – June 2, 2001) was an American comic actress best known for her role opposite Sid Caesar on Your Show of Shows. \n\nStarting out in vaudeville as a child acrobat, she studied ballet and wished to have a serious career in music and dance, graduating to decades of stage musical revues, cabaret and summer stock...", died:date('2001-06-02'), url:"https://themoviedb.org/person/70089"}}, {tmdbId:"127533", properties:{imdbId:"0411814", name:"Zachary Ittimangnaq", url:"https://themoviedb.org/person/127533"}}, {tmdbId:"127534", properties:{imdbId:"0429786", name:"Samson Jorah", url:"https://themoviedb.org/person/127534"}}, {tmdbId:"30620", properties:{bornIn:"Manila, Philippines", imdbId:"0707043", born:date('1952-02-28'), name:"Cristina Raines", bio:"From Wikipedia, the free encyclopedia\n\nCristina Raines (birth name Tina Herazo, born 28 February 1952 in Manila, Philippines) is an American actress.  She achieved her big break on the TV movie Sunshine, with Cliff De Young. \n\nShe co-starred in the TV mini-series \"Centennial\", a 26 hour epic depicting the history of Colorado.  She appeared as Lucinda McKeag-Zendt, a woman who lived in the 1840s through the 1880s and married a Pennsylvania farmer who left for the West...", url:"https://themoviedb.org/person/30620"}}, {tmdbId:"1054852", properties:{imdbId:"0483379", name:"Joe Lambie", url:"https://themoviedb.org/person/1054852"}}, {tmdbId:"9031", properties:{bornIn:"Roma, Lazio, Italia", imdbId:"0320323", born:date('1959-09-04'), name:"Domiziana Giordano", bio:"From Wikipedia, the free encyclopedia\n\nDomiziana Giordano (born 4 September 1959) is an artist, actress, photographer and video artist.  Domiziana has played the lead role in films directed by Nicolas Roeg, Jean-Luc Godard, Andrei Tarkovsky, Mauro Bolognini, Neil Jordan, Ken McMullen and many others...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w99tdRPvDUw0rlbDWn6RWnM9Rq.jpg", url:"https://themoviedb.org/person/9031"}}, {tmdbId:"150825", properties:{imdbId:"0855837", name:"Patrizia Terreno", url:"https://themoviedb.org/person/150825"}}, {tmdbId:"10509", properties:{bornIn:"Nybro, Småland, Sweden", imdbId:"0915468", born:date('1950-09-24'), name:"Kristina Wayborn", bio:"From Wikipedia, the free encyclopedia\n\nKristina Wayborn (born 24 September 1950) is a Swedish-born actress who worked mostly in the United Kingdom and in the United States. \n\nDescription above from the Wikipedia article Kristina Wayborn, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/698zgC4CyRy3sDRsXm9QvcUKVQn.jpg", url:"https://themoviedb.org/person/10509"}}, {tmdbId:"2878", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0001367", born:date('1966-12-07'), name:"C. Thomas Howell", bio:"From Wikipedia, the free encyclopedia. \n\nChristopher Thomas Howell (born December 7, 1966), usually credited as C.  Thomas Howell, is an American actor and film director.  He starred in the films The Outsiders as Ponyboy Curtis and in The Hitcher as Jim Halsey.  He has appeared in Soul Man, Red Dawn, Secret Admirer, Gettysburg, H.  G.  Wells' War of the Worlds, The Day the Earth Stopped and Gods and Generals.  He is scheduled to appear in 2012's The Amazing Spider-Man...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jbe1EIWMlIvnIJjPX5H5hAVLBbJ.jpg", url:"https://themoviedb.org/person/2878"}}, {tmdbId:"2877", properties:{bornIn:"Huntington, Long Island, New York, USA", imdbId:"0001494", born:date('1961-11-04'), name:"Ralph Macchio", bio:"Ralph George Macchio (born November 4, 1961) is an American actor, best known for his roles as Daniel LaRusso in the Karate Kid series, Billy Gambini in My Cousin Vinny, and Johnny Cade in The Outsiders.  He is also known to American television audiences for his season five recurring role as Jeremy Andretti on the comedy-drama Eight Is Enough.  He competed on the twelfth season of Dancing with the Stars...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AoqqL9UlyPrcTLnpzbQvKXPvXrz.jpg", url:"https://themoviedb.org/person/2877"}}, {tmdbId:"723", properties:{bornIn:"Houston, Texas, USA", imdbId:"0000664", born:date('1952-08-18'), name:"Patrick Swayze", bio:"Patrick Wayne Swayze (August 18, 1952 – September 14, 2009)  was an American actor, dancer and singer-songwriter.  He was best-known for his tough-guy roles, as romantic leading men in the hit films Dirty Dancing and Ghost and as Orry Main in the North and South television miniseries.  He was named by People magazine as its \"Sexiest Man Alive\" in 1991.  His film and TV career spanned 30 years...", died:date('2009-09-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cjOI4kvoLIec0ZnqXibjSTDfq3y.jpg", url:"https://themoviedb.org/person/723"}}, {tmdbId:"99538", properties:{bornIn:"Milan, Lombardy, Italy", imdbId:"0778634", born:date('1961-10-28'), name:"Gioia Scola", bio:"Gioia Scola was born on October 28, 1961 in Milan, Lombardy, Italy as Gioia Maria Tibiletti.  She is an actress and producer, known for The Raiders of Atlantis (1983), Per sempre (1991) and Conquest (1983)...", url:"https://themoviedb.org/person/99538"}}, {tmdbId:"55672", properties:{bornIn:"Canton, Ohio, U.S.", imdbId:"0268094", born:date('1947-05-06'), name:"Tony King", url:"https://themoviedb.org/person/55672"}}, {tmdbId:"103125", properties:{bornIn:"Milan, Lombardy, Italy", born:date('1949-01-04'), name:"Stefano Mingardo", died:date('2014-11-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jvAC8iKPqh4ZZDqTWmheOc3nlsC.jpg", url:"https://themoviedb.org/person/103125"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"16171", properties:{bornIn:"New York City, New York, USA", imdbId:"0000121", born:date('1963-07-16'), name:"Phoebe Cates", bio:"Phoebe Belle Cates (born July 16, 1963) is an American actress, model and entrepreneur known for her roles in several teen films, most notably Fast Times at Ridgemont High and Gremlins...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7D6e0W4O7oSFceHBDjARLPuK7sl.jpg", url:"https://themoviedb.org/person/16171"}}, {tmdbId:"22434", properties:{bornIn:"San Diego, California, USA", imdbId:"0751018", born:date('1963-09-06'), name:"Betsy Russell", bio:"From Wikipedia, the free encyclopedia.  Betsy Russell (born Elizabeth Russell; September 6, 1963) is an American actress who is best known for her role in Private School, and as Jill Tuck, the ex-wife of the Jigsaw Killer in the Saw film series. \n\nDescription above from the Wikipedia article Betsy Russell, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yogajrJdBD4vtHuatOvo2rSZeHt.jpg", url:"https://themoviedb.org/person/22434"}}, {tmdbId:"8654", properties:{bornIn:"Loma Linda, California, USA", imdbId:"0000546", born:date('1959-03-22'), name:"Matthew Modine", bio:"Matthew Avery Modine (born March 22, 1959) is an award-winning American actor.  His film roles include Private Joker in Stanley Kubrick's Full Metal Jacket, the title character in Alan Parker's Birdy, high school wrestler Louden Swain in Vision Quest, and the oversexed Sullivan Groff in Weeds...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2nmw8YkQq4cZT0GtmUfaAw1I8nT.jpg", url:"https://themoviedb.org/person/8654"}}, {tmdbId:"124133", properties:{bornIn:"New York City, New York, USA", imdbId:"0957905", born:date('1960-05-25'), name:"Michael Zorek", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tifytCWkWL03V3VtT2O9D25Qzti.jpg", url:"https://themoviedb.org/person/124133"}}, {tmdbId:"28412", properties:{bornIn:"Santa Rosa, California, USA", imdbId:"0000360", born:date('1959-08-29'), name:"Rebecca De Mornay", bio:"Rebecca De Mornay  (born August 29, 1959, height 5' 5½\" (1,66 m)) is an American film and television actress.  Her breakthrough film role came in 1983, when she played Lana in Risky Business opposite Tom Cruise.  Her other notable film roles include Sara in Runaway Train in 1985, Helen McCaffrey in the thriller Backdraft in 1991 and her portrayal of the chillingly twisted nanny Peyton Flanders in the popular 1992 thriller The Hand That Rocks the Cradle...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bGSvflCmfywasc3U8QAsJPaAek4.jpg", url:"https://themoviedb.org/person/28412"}}, {tmdbId:"15416", properties:{bornIn:"New York City, New York, USA", imdbId:"0557956", born:date('1948-11-20'), name:"Richard Masur", bio:"An American actor who has appeared in more than 80 movies during his career.  From 1995-1999, he served two terms as president of the Screen Actors Guild (SAG).  Masur sits on the Corporate Board of the Motion Picture & Television Fund...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eTKFP76mnSgIhoknfxtebqnWb6K.jpg", url:"https://themoviedb.org/person/15416"}}, {tmdbId:"1159", properties:{bornIn:"Havana - Cuba", imdbId:"0000874", born:date('1956-12-02'), name:"Steven Bauer", bio:"Steven Bauer (born December 2, 1956) is a Cuban-American actor.  He is known for his role as Manny Ribera in the 1983 film Scarface, and his role on the bilingual PBS show Que Pasa, USA...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iBeruDkd1Z3xxUjrgz2YeNjB3q8.jpg", url:"https://themoviedb.org/person/1159"}}, {tmdbId:"1161", properties:{bornIn:"Lombard, Illinois, USA", imdbId:"0001512", born:date('1958-11-17'), name:"Mary Elizabeth Mastrantonio", bio:"Mary Elizabeth Mastrantonio (born November 17, 1958) is an American actress and singer known for her role in The Color of Money, The Abyss, Scarface, and Robin Hood: Prince of Thieves...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2OTi0bec1tAIYkUF2L3vhomlrPf.jpg", url:"https://themoviedb.org/person/1161"}}, {tmdbId:"74673", properties:{bornIn:"Greenwich Village, New York City, New York, USA", imdbId:"0741378", born:date('1969-05-23'), name:"Felissa Rose", bio:"An American actress and producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vwryYkM4atZaOexTq0HVWWCQRY6.jpg", url:"https://themoviedb.org/person/74673"}}, {tmdbId:"74674", properties:{bornIn:"Queens, New York City, New York, USA", imdbId:"0862962", born:date('1965-08-11'), name:"Jonathan Tiersten", bio:"From Wikipedia, the free encyclopedia\n\nJonathan Tiersten (born August 11, 1965) is an American actor and singer, who is mostly known for his role as Ricky Thomas in the 1983 cult classic Sleepaway Camp.  He reprised the role in the 2008 sequel Return to Sleepaway Camp. \n\nIn between acting Jonathan took to music, fronting a number of bands, mostly based out of the Fort Collins, Colorado area...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zghNu1tvLWoAfkLs3B1FpwLC6Ky.jpg", url:"https://themoviedb.org/person/74674"}}, {tmdbId:"1270519", properties:{imdbId:"0276290", name:"Karen Fields", bio:"Voice / Performer...", url:"https://themoviedb.org/person/1270519"}}, {tmdbId:"114058", properties:{bornIn:"New York City, New York, U.S.", imdbId:"0171754", born:date('1968-03-13'), name:"Christopher Collet", bio:"​From Wikipedia, the free encyclopedia.   \n\nChristopher Collet (born March 13, 1968) is an American actor who is perhaps best known for his portrayal of Jake Livingston in the 1984 movie Firstborn, and for his lead role in the 1986 film The Manhattan Project. \n\nCollet was born in New York City.  He has one younger sister, Jennifer (not an actress). \n\nDuring his teen years, Collet decided to break into show business, and acquired an agent...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iJiIpd6DiPNAJrxasj77bOj2RMf.jpg", url:"https://themoviedb.org/person/114058"}}, {tmdbId:"45611", properties:{imdbId:"0566588", born:date('1927-06-30'), name:"Pat McCormick", died:date('2005-07-29'), url:"https://themoviedb.org/person/45611"}}, {tmdbId:"378", properties:{bornIn:"Carmel, Flintshire, Reino Unido", imdbId:"0000596", born:date('1947-06-01'), name:"Jonathan Pryce", bio:"Jonathan Pryce, CBE (born 1 June 1947) is a Welsh stage and film actor and singer. \n\nAfter studying at the Royal Academy of Dramatic Art and meeting his long time partner, English actress Kate Fahy, in 1974, he began his career as a stage actor in the 1970s.  His work in theatre, including an award-winning performance in the title role of the Royal Court Theatre's \"Hamlet\", led to several supporting roles in film and television...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zwSv5uXzPTtmitFe39UdqnVwmdL.jpg", url:"https://themoviedb.org/person/378"}}, {tmdbId:"19968", properties:{bornIn:"New York City, New York USA", imdbId:"0200455", born:date('1922-11-16'), name:"Royal Dano", bio:"​From Wikipedia, the free encyclopedia.   \n\nRoyal Edward Dano (November 16, 1922 – May 15, 1994) was an American film and television character actor. \n\nDescription above from the Wikipedia article Royal Dano, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1994-05-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qg2cZRP9jtq3euKBY4FbO9x7Cl9.jpg", url:"https://themoviedb.org/person/19968"}}, {tmdbId:"21368", properties:{bornIn:"Croton-on-Hudson, New York, U.S.", imdbId:"0005471", born:date('1947-02-20'), name:"Peter Strauss", bio:"From Wikipedia, the free encyclopedia\n\nPeter Strauss (born February 20, 1947) is an American television and movie actor, known for his roles in several television miniseries in the 1970s and 1980s.  He was born in Croton-on-Hudson, New York. \n\nDescription above from the Wikipedia article Peter Strauss, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2Eq3v3TV2f1EGyYeSAQQEHtURqZ.jpg", url:"https://themoviedb.org/person/21368"}}, {tmdbId:"21625", properties:{bornIn:"Roseville, California, USA", imdbId:"0000208", born:date('1968-02-18'), name:"Molly Ringwald", bio:"Molly Ringwald (born February 18, 1968) is an American actress and singer, famous for her roles in several coming-of-age films in the 1980s such as Sixteen Candles, The Breakfast Club, and Pretty in Pink...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i9NTMtw5Ydukz0Lu5r7VBuZ7dOj.jpg", url:"https://themoviedb.org/person/21625"}}, {tmdbId:"8874", properties:{bornIn:"Benton Harbor, Michigan, USA", imdbId:"0001368", born:date('1945-12-17'), name:"Ernie Hudson", bio:"An American actor known for his roles as Winston Zeddemore in the Ghostbusters film series, Warden Leo Glynn on HBO's Oz, and Sergeant Albrecht in The Crow. \n\nDescription above from the Wikipedia article Ernie Hudson, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zRUTN973PheMqe8kuBpchM5P1cC.jpg", url:"https://themoviedb.org/person/8874"}}, {tmdbId:"724", properties:{bornIn:"Nashville, Tennessee, USA", imdbId:"0722407", born:date('1956-11-21'), name:"Cynthia Rhodes", bio:"From Wikipedia, the free encyclopedia. \n\nCynthia Rhodes (born November 21, 1956) is an American actress, singer and dancer most noted for her roles in Dirty Dancing and Flashdance. \n\nDescription above from the Wikipedia article Cynthia Rhodes, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sqLHvm1kKfIn17RZDgzNVrhNrvK.jpg", url:"https://themoviedb.org/person/724"}}, {tmdbId:"66881", properties:{bornIn:"Kensington, London, England, UK", imdbId:"0001370", born:date('1959-10-29'), name:"Finola Hughes", bio:"​From Wikipedia, the free encyclopedia. \n\nFinola Hughes  (born 29 October 1959; London, England) is an English actress and author, who is best known for her portrayal of Anna Devane on the soap operas General Hospital, All My Children and General Hospital: Night Shift (season 2), and her portrayal of Anna Devane's identical twin sister, Doctor Alexandra Devane Marick, on All My Children.  She also guest starred as Patty Halliwell on the supernatural series, Charmed...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6VQEOrue9NrsC2VnkhzO6R8udWR.jpg", url:"https://themoviedb.org/person/66881"}}] AS row
