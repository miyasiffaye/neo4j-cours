UNWIND [{tmdbId:"20056", properties:{bornIn:"Gorseinon, Glamorgan, Wales, UK", imdbId:"0020717", born:date('1953-06-02'), name:"Keith Allen", bio:"Keith Philip George Allen is a Welsh actor, comedian, musician, singer-songwriter, artist, director, author, and television presenter.  \n\nHe is the father of singer-songwriter Lily Allen and actor Alfie Owen-Allen, and brother of Kevin Allen, the Welsh actor, screenwriter, film director and film producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1azvWtgKZ9u8oadJdsykij62X1z.jpg", url:"https://themoviedb.org/person/20056"}}, {tmdbId:"148543", properties:{bornIn:"Stepney, London, England, UK", imdbId:"0229886", born:date('1949-04-29'), name:"Anita Dobson", bio:"Anita Dobson (born 29 April 1949 in Stepney London) is an English Actress and singer.  She is best known for playing Angie Watts in the BBC soap, Eastenders...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ntoDqieEo6bXrKSQDpitOQgsAL7.jpg", url:"https://themoviedb.org/person/148543"}}, {tmdbId:"158632", properties:{name:"Kim Vithana", url:"https://themoviedb.org/person/158632"}}, {tmdbId:"218402", properties:{name:"Jimmi Harkishin", url:"https://themoviedb.org/person/218402"}}, {tmdbId:"550127", properties:{imdbId:"0451045", name:"Sarita Khajuria", url:"https://themoviedb.org/person/550127"}}, {tmdbId:"2981", properties:{bornIn:"London, England, UK", imdbId:"0475988", name:"Akbar Kurtha", bio:"Akbar Kurtha is an English actor of Indian descent...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tQdMgcll5GhVhuDhda0ejss1J9I.jpg", url:"https://themoviedb.org/person/2981"}}, {tmdbId:"11067", properties:{bornIn:"Lincoln - Illinois - USA", imdbId:"0455767", born:date('1954-01-29'), name:"Terry Kinney", bio:"Terry Kinney (born January 29, 1954) is an American actor and theatre director, and is a founding member of the Steppenwolf Theatre Company with Gary Sinise and Jeff Perry. \n\nDescription above from the Wikipedia article Terry Kinney, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5y2rzFRQxRktRobRSKdgsJ1ygsg.jpg", url:"https://themoviedb.org/person/11067"}}, {tmdbId:"39115", properties:{imdbId:"0614641", name:"Reilly Murphy", url:"https://themoviedb.org/person/39115"}}, {tmdbId:"1007561", properties:{bornIn:"Harvey, North Dakota, USA", imdbId:"0148061", born:date('1929-04-17'), name:"Michael Forest", bio:"Michael Forest is an American stage, film, television and voice over actor.  He holds a BA in English and Drama from San Jose State University, California, USA...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3hsY0cOtTirglpIfhZ69o0VzWr.jpg", url:"https://themoviedb.org/person/1007561"}}, {tmdbId:"15414", properties:{bornIn:"Philadelphia, Pennsylvania, U.S.A.", imdbId:"0356251", born:date('1943-07-29'), name:"Charles Hallahan", bio:"Was an American film, television and stage actor best known for his performances in Going in Style, The Thing, and Dante's Peak. \n\nDescription above from the Wikipedia article Charles Hallahan, licensed under CC-BY-SA,full list of contributors on Wikipedia...", died:date('1997-11-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zQr2ytNB23Dy3uzbGkxfIsANw3y.jpg", url:"https://themoviedb.org/person/15414"}}, {tmdbId:"58647", properties:{imdbId:"0001963", born:date('1962-08-01'), name:"Jesse Borrego", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bK9cPqXTJSRN72ZDKN3UXlKN3gU.jpg", url:"https://themoviedb.org/person/58647"}}, {tmdbId:"4589", properties:{bornIn:"San Francisco, California, USA", imdbId:"0000973", born:date('1963-12-16'), name:"Benjamin Bratt", bio:"Benjamin Bratt (born December 16, 1963) is an American actor.  He is most famous for his role as Rey Curtis on the TV series Law &amp; Order; and his appearances in the movies Blood in Blood Out, Miss Congeniality, Cloudy with a Chance of Meatballs, Traffic, and Piñero.  He starred on the A&amp;E Network drama The Cleaner...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jixSFwipypcSEdZsNte1pyhXWjN.jpg", url:"https://themoviedb.org/person/4589"}}, {tmdbId:"16427", properties:{bornIn:"Calexico, California, USA", imdbId:"0145049", born:date('1949-12-10'), name:"Enrique Castillo", bio:"Castillo was a founding member of The Latino Theater Company.  He co-wrote the company’s plays Stone Wedding and August 29.  In addition to the plays, he wrote and directed the film The History of The Latino Theater Company, a documentary chronicling the theater company, and co-produced the company’s annual comedy fundraiser Noche de Risa y Susto.   In 1997 Castillo created Four Brown Hats Entertainment (FBHE), a film\n\n and theater production company...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aKuTti43jY8LZr2oKDcQWdAhnLq.jpg", url:"https://themoviedb.org/person/16427"}}, {tmdbId:"15319", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"0001089", born:date('1959-02-08'), name:"Henry Czerny", bio:"Henry Czerny is a Canadian stage, film and television actor, best known for playing regular character Conrad Grayson in the television series \"Revenge\".  He's a graduate of the National Theatre School in Montreal, Quebec, Canada...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zOWZzRmliKf9032IOOq0a3jXhVv.jpg", url:"https://themoviedb.org/person/15319"}}, {tmdbId:"198643", properties:{bornIn:"Canada -", imdbId:"0605601", born:date('1981-10-10'), name:"Johnny Morina", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aCkyW20QjhzJGXTF1Bgb6IZ8Wyr.jpg", url:"https://themoviedb.org/person/198643"}}, {tmdbId:"1195879", properties:{imdbId:"0233188", name:"Brian Dooley", url:"https://themoviedb.org/person/1195879"}}, {tmdbId:"946161", properties:{bornIn:"Canada ", imdbId:"0227767", name:"Philip Dinn", died:date('2013-11-21'), url:"https://themoviedb.org/person/946161"}}, {tmdbId:"17917", properties:{bornIn:"Bogotá, Colombia", imdbId:"0000969", born:date('1976-03-30'), name:"Lillo Brancato", bio:"Lillo Brancato, Jr.  (born March 30, 1976) is a Colombian-born American actor, known for his performance as \"Calogero Anello\" in Robert De Niro's 1993 directorial debut, A Bronx Tale.  He also played Matthew Bevilaqua, a young mobster on The Sopranos.  In December 2005, Brancato was charged with second-degree murder for his role in a burglary in the Bronx, New York.  Authorities say that an off-duty police officer, Daniel Enchautegui, confronted two burglars and was killed in a shootout...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2CS16gyQ07MZDCCur9mPlGQ9QDB.jpg", url:"https://themoviedb.org/person/17917"}}, {tmdbId:"17918", properties:{bornIn:"Bronx - New York - USA", imdbId:"0135584", born:date('1983-04-22'), name:"Francis Capra", bio:"Francis Capra (born April 22, 1983) is an American actor.  He is best known for the roles of Max Connor in Kazaam and Eli \"Weevil\" Navarro in the TV series Veronica Mars...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iMbTbfIKNqjNwtwtdMLMRJUG1ej.jpg", url:"https://themoviedb.org/person/17918"}}, {tmdbId:"1534", properties:{bornIn:"New York City - New York - USA", imdbId:"0254402", born:date('1960-05-31'), name:"Chris Elliott", bio:"Christopher Nash \"Chris\" Elliott (born May 31, 1960) is an American actor, comedian and writer.  He is best known for his comedic sketches on Late Night with David Letterman, starring in the cult comedy series Get a Life and for his recurring role as Peter MacDougall on Everybody Loves Raymond.  He is also known for appearing in movies such as Cabin Boy, There's Something About Mary, Scary Movie 2 and Groundhog Day.  Elliott currently stars in the Adult Swim series Eagleheart...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oQ4ZuOGoZ5dPDiLxri6ZPQLewAU.jpg", url:"https://themoviedb.org/person/1534"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"5723", properties:{bornIn:" Bogotá, Colombia", imdbId:"0000491", born:date('1964-07-22'), name:"John Leguizamo", bio:"John Leguizamo (born July 22, 1964) is a Colombian-American actor, comedian, voice artist, and producer.  Leguizamo is of Puerto Rican and Colombian descent...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rgDsVNOJ0xRoHNt3xdnADSGdqZX.jpg", url:"https://themoviedb.org/person/5723"}}, {tmdbId:"101652", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0001690", born:date('1960-04-01'), name:"Jennifer Runyon", bio:"​She is known for guest appearances or secondary characters in various sitcoms and dramas, as well as a couple of made-for-TV movies.  Among her roles are Sally Frame on Another World (1981–1983), Gwendolyn Pierce on Charles in Charge (1984–1985), and replacing Susan Olsen as Cindy Brady in A Very Brady Christmas (1988).  Runyon also had a small part inGhostbusters (1984) alongside Bill Murray and she starred in Up the Creek that same year.  She was a guest on Beverly Hills, 90210 in 1991...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/WBEYuWsqxRi6jFwtoQnjQj8J3T.jpg", url:"https://themoviedb.org/person/101652"}}, {tmdbId:"45101", properties:{bornIn:"Atlanta, Georgia, USA", imdbId:"0656188", born:date('1941-08-27'), name:"Harrison Page", bio:"From Wikipedia, the free encyclopedia\n\nHarrison Page (born August 27, 1941) is an American television and film actor who has appeared in many popular shows, including Cold Case, JAG, ER, Ally McBeal, Melrose Place, Quantum Leap, The Wonder Years, 21 Jump Street, Murder She Wrote, Fame, Gimme a Break!, Benson, Hill Street Blues, Webster, The Dukes of Hazzard, Kung Fu, Kojak, Mannix, and Bonanza...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uqoZdiO6ar3hVeX09u9JARVvfkA.jpg", url:"https://themoviedb.org/person/45101"}}, {tmdbId:"31945", properties:{bornIn:"London, England, U.K.", imdbId:"0731716", born:date('1974-01-01'), name:"Andrew Robertson", bio:"Dr.  Andrew Robertson (born 1974) is a British actor best remembered for his performances in The Cement Garden and the Gormenghast series.   He is also a musician and academic, fronting UK-based band Truck, and has published work on automatic accompaniment for rock music at the conference on New Interfaces for Musical Expression.   In May 2009, Robertson was awarded a research fellowship of the Royal Academy of Engineering for his work on digital music...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l8X5JRYxdRFQeKDu8cnyyldWOyu.jpg", url:"https://themoviedb.org/person/31945"}}, {tmdbId:"4273", properties:{bornIn:"London, England, UK", imdbId:"0001250", born:date('1971-07-21'), name:"Charlotte Gainsbourg", bio:"Charlotte Lucy Gainsbourg (born 21 July 1971) is an Anglo-French actress and singer-songwriter.  She is most known in American cinema for her roles in The Science of Sleep, I'm Not There, 21 Grams, Jane Eyre, and Antichrist...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5RatxoLmiHMCS52dL2NTe2HF92j.jpg", url:"https://themoviedb.org/person/4273"}}, {tmdbId:"143447", properties:{bornIn:"London - England - UK", imdbId:"0183553", born:date('1983-01-01'), name:"Alice Coulthard", bio:"Alice Coulthard  is an actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jQuGc6IvWOSCgjaiYrElVK58k9i.jpg", url:"https://themoviedb.org/person/143447"}}, {tmdbId:"143448", properties:{imdbId:"0083607", name:"Ned Birkin", url:"https://themoviedb.org/person/143448"}}, {tmdbId:"120725", properties:{bornIn:"Beijing, China", imdbId:"0950552", born:date('1958-08-10'), name:"Rongguang Yu", bio:"Yu Rong-Guang is a Chinese actor and martial artist from Beijing who started his career in Hong Kong.  He is perhaps most famous for the title role in Iron Monkey along with Donnie Yen as well as being featured in prominent movies.  He is also known for appearing in roles for films with Jackie Chan...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/18ZZNsJEJk2jCsg56zwXeb6RtMb.jpg", url:"https://themoviedb.org/person/120725"}}, {tmdbId:"87942", properties:{bornIn:"Hong Kong, British Crown Colony [now China]", imdbId:"0160803", born:date('1971-10-25'), name:"Athena Chu", bio:"Athena Chu is a Chinese film and television actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/opemlo5xlLSWnld15A3rW6kjDoQ.jpg", url:"https://themoviedb.org/person/87942"}}, {tmdbId:"102714", properties:{imdbId:"0461679", born:date('1946-12-16'), name:"Terence Knox", bio:"Terence Knox was born on December 16, 1946 in Richland, Washington, USA as Terry Davis.  He is an actor, known for Tour of Duty (1987), Lois & Clark: The New Adventures of Superman (1993) and Children of the Corn II: The Final Sacrifice (1992).  He was previously married to Susan Gay Knox...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xo3naT9b3W0xF1sKj94FJtpv4e8.jpg", url:"https://themoviedb.org/person/102714"}}, {tmdbId:"102715", properties:{bornIn:"Rochester, New York, USA", imdbId:"0771121", born:date('1968-12-16'), name:"Paul Scherrer", url:"https://themoviedb.org/person/102715"}}, {tmdbId:"95645", properties:{bornIn:"St. Louis, Missouri, USA", imdbId:"0093174", born:date('1972-08-09'), name:"Ryan Bollman", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jShOCZc85aSt1yPI3QPKioS1TM5.jpg", url:"https://themoviedb.org/person/95645"}}, {tmdbId:"102716", properties:{imdbId:"0163775", born:date('1973-12-13'), name:"Christie Clark", url:"https://themoviedb.org/person/102716"}}, {tmdbId:"51580", properties:{bornIn:"Lincoln, Nebraska, USA", imdbId:"0005508", born:date('1962-12-06'), name:"Janine Turner", bio:"​From Wikipedia, the free encyclopedia.   \n\nJanine Turner (born Janine Loraine Gauntt; December 6, 1962) is an American actress who starred on the prime time television show Northern Exposure from 1990 to 1995.  From 2000 to 2002, she appeared on the Lifetime original series Strong Medicine.  In 2008, Turner became a published author when Thomas Nelson released Holding Her Head High: Inspiration from 12 Single Mothers Who Championed Their Children and Changed History...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rOaowqnvZokC5CNXWNCAjJt0tFR.jpg", url:"https://themoviedb.org/person/51580"}}, {tmdbId:"16430", properties:{imdbId:"0461446", name:"Robert Knott", url:"https://themoviedb.org/person/16430"}}, {tmdbId:"226651", properties:{bornIn:"New York, USA", imdbId:"0672103", born:date('1962-03-05'), name:"Jonathan Penner", bio:"From Wikipedia, the free encyclopedia  Jonathan Lindsay Penner (born March 5, 1962) is an American actor, writer and film producer known for starring in The Last Supper and the television series Rude Awakening and The Naked Truth, as well as for appearing on the television show Survivor.   Description above from the Wikipedia article Jonathan Penner,licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/st2Z8YrpuSilbVLyg2dhxyDFqgS.jpg", url:"https://themoviedb.org/person/226651"}}, {tmdbId:"11089", properties:{bornIn:"New York City, New York, USA", imdbId:"0399531", born:date('1957-05-17'), name:"Whip Hubley", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lqwleuUWQhLWMJ4ZvAdRGrXgvjT.jpg", url:"https://themoviedb.org/person/11089"}}, {tmdbId:"12974", properties:{bornIn:"New York City, New York, USA", imdbId:"0502442", born:date('1962-03-08'), name:"Leon", bio:"Leon Preston Robinson IV (usually credited as simply \"Leon\") is an American actor and singer, who began his professional career as an actor in 1981...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uhLVZV2rH0nnXwQKtsIT0qGsTyg.jpg", url:"https://themoviedb.org/person/12974"}}, {tmdbId:"12975", properties:{bornIn:"Brooklyn, New York City, New York, USA", imdbId:"0234791", born:date('1970-01-07'), name:"Doug E. Doug", bio:"Doug E.  Doug is an actor and producer...", url:"https://themoviedb.org/person/12975"}}, {tmdbId:"12976", properties:{