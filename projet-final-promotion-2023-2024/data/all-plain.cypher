UNWIND [{tmdbId:"58986", properties:{imdbId:"0428575", name:"Kevin Knapman", url:"https://themoviedb.org/person/58986"}}, {tmdbId:"38948", properties:{imdbId:"0752730", name:"Michael Ryan", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1R37Eh92QaFhMV4ky60D6nH7TiT.jpg", url:"https://themoviedb.org/person/38948"}}, {tmdbId:"1254322", properties:{imdbId:"0526537", name:"Kristopher Lundon", url:"https://themoviedb.org/person/1254322"}}, {tmdbId:"1610", properties:{bornIn:"La Rioja, Spain", imdbId:"0194572", born:date('1967-01-19'), name:"Javier Cámara", bio:"Javier Cámara Rodríguez (born 19 January 1967) is a Spanish actor.  He starred in the Pedro Almodóvar films Talk to Her (2002), Bad Education (2004) and I'm So Excited (2013), and the television series 7 Vidas (Seven Lives).  He played Cardinal Bernardo Gutierrez in the HBO series The Young Pope as well as Guillermo Pallomari, the chief accountant of the Cali Cartel, in season 3 of the Netflix series Narcos. \n\nHe was born in Albelda de Iregua, La Rioja...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pG2uOSwthuTXn8LAV2MTZbyOre9.jpg", url:"https://themoviedb.org/person/1610"}}, {tmdbId:"3618", properties:{bornIn:"Rosario, Santa Fe, Argentina", imdbId:"0334882", born:date('1959-03-05'), name:"Darío Grandinetti", bio:"Darío Grandinetti (born March 5, 1959 in Rosario) is an Argentine actor.  Among many other films, he worked under the direction of Pedro Almodóvar in the Academy Award winner Talk to Her. \n\nGrandinetti started as a television actor to slowly move towards the cinema.  His filmography is mainly of Argentine production or co-productions with his country...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l1Gw8OLzw7FehGeQK7pZ5wJOIgF.jpg", url:"https://themoviedb.org/person/3618"}}, {tmdbId:"101", properties:{bornIn:"Madrid, Spain", imdbId:"0914455", born:date('1975-07-28'), name:"Leonor Watling", bio:"Leonor Elizabeth Ceballos Watling (born July 28, 1975) is an award-winning Spanish film actress and singer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/m8vq9hy6bD4ET43qX6NUzjaeS2K.jpg", url:"https://themoviedb.org/person/101"}}, {tmdbId:"398", properties:{bornIn:"Madrid, Spain", imdbId:"0282936", born:date('1963-11-04'), name:"Rosario Flores", bio:"From Wikipedia, the free encyclopedia.   Rosario Flores (born November 4, 1963) is a two-time Latin Grammy Award-winning Spanish gypsy singer and actress. \n\nShe was born in Madrid, Spain as the daughter of Antonio González ('El Pescaílla') and Lola Flores.  She is the sister of actress Lolita Flores and singer-songwriter Antonio Flores.  She has a daughter with her ex boyfriend Carlos Orellana.  Her second son, Pedro Antonio, was born January 21, 2006, the same day as his grandmother Lola Flores...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zS8UNKXADu6USCf6WXvNqo2OHMS.jpg", url:"https://themoviedb.org/person/398"}}, {tmdbId:"13364", properties:{bornIn:"Ely, Cambridgeshire, England, UK", imdbId:"0185107", born:date('1973-04-24'), name:"Julie Cox", bio:"​From Wikipedia, the free encyclopedia.   \n\nJulie Cox (born on 24 April 1973 in Ely, England) is an English actress perhaps best known for her role as Princess Irulan in the Sci Fi channel's 2000 Dune miniseries and its 2003 follow-up, Children of Dune. \n\nIn 2007, Cox was the female lead in The Riddle alongside Vinnie Jones, Sir Derek Jacobi, and Vanessa Redgrave.  Cox starred in The Oxford Murders (2008) with Elijah Wood and John Hurt and in Second in Command (2006) with Jean-Claude Van Damme...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iEuysgJLFqvj98HwefDliZ1RRQl.jpg", url:"https://themoviedb.org/person/13364"}}, {tmdbId:"72865", properties:{imdbId:"0312064", born:date('1976-04-17'), name:"Anna Geislerová", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4M4GTTRmHME818MDptmHzWbaTfd.jpg", url:"https://themoviedb.org/person/72865"}}, {tmdbId:"42077", properties:{bornIn:"Budapest, Hungary", imdbId:"0190691", born:date('1948-02-17'), name:"György Cserhalmi", url:"https://themoviedb.org/person/42077"}}, {tmdbId:"1385340", properties:{imdbId:"0010702", born:date('1925-03-15'), name:"Jaroslava Adamová", died:date('2012-06-16'), url:"https://themoviedb.org/person/1385340"}}, {tmdbId:"124141", properties:{bornIn:"Třebíč - Czechoslovakia", imdbId:"0233109", born:date('1951-02-07'), name:"Miroslav Donutil", bio:"Miroslav Donutil was born on February 7, 1951 in Trebíc, Czechoslovakia [now Czech Republic].  He is an actor and writer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6MPAXpLFECA1Do6x2rE92dj7pj4.jpg", url:"https://themoviedb.org/person/124141"}}, {tmdbId:"59216", properties:{bornIn:"Ottawa, Ontario, Canada", imdbId:"0146915", born:date('1963-10-26'), name:"Tom Cavanagh", bio:"Thomas Cavanagh is a Canadian film and television actor.  He was born on October 26th, 1963 in Ottawa, Ontario, the second-oldest of five children.  His close-knit family moved to Ghana, Africa when Tom was six.  His father educated teachers there.  The family moved back to Canada before Tom started high school (which he attended in southern Quebec)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iFkViDKW65daGl74VYK3FOvCLfZ.jpg", url:"https://themoviedb.org/person/59216"}}, {tmdbId:"80965", properties:{bornIn:"Nashua, New Hampshire, USA", imdbId:"0365826", born:date('1977-11-02'), name:"Randy Harrison", url:"https://themoviedb.org/person/80965"}}, {tmdbId:"2060", properties:{imdbId:"0658099", name:"Alex Palmer", url:"https://themoviedb.org/person/2060"}}, {tmdbId:"2061", properties:{imdbId:"0211869", born:date('1976-12-19'), name:"Bindu De Stoppani", url:"https://themoviedb.org/person/2061"}}, {tmdbId:"2063", properties:{imdbId:"0385330", born:date('1965-04-16'), name:"Jukka Hiltunen", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3Y2uIotlYj1mlVaN8uC2r9uZ6G6.jpg", url:"https://themoviedb.org/person/2063"}}, {tmdbId:"2065", properties:{imdbId:"0773768", born:date('1963-05-22'), name:"David Schneider", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8zl8TX0OtQK4Zl3yRYgAp1sFkjI.jpg", url:"https://themoviedb.org/person/2065"}}, {tmdbId:"4766", properties:{bornIn:"Dhahran, Saudi Arabia", imdbId:"0001828", born:date('1960-10-21'), name:"Melora Walters", bio:"Melora Walters is an American film and television actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/55UsAueo3kpbuQNJ302EjWfyHMT.jpg", url:"https://themoviedb.org/person/4766"}}, {tmdbId:"7574", properties:{bornIn:"St. Louis - Missouri - USA", imdbId:"0454598", born:date('1962-08-21'), name:"Cleo King", bio:"Cleo King is an actress known for her performance as 'Grandma' in Mike and Molly...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/teEPJgvrvPrNEh83FdOroNSLJzO.jpg", url:"https://themoviedb.org/person/7574"}}] AS row
