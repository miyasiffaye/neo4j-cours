b.org/movie/47906", tmdbId:"47906", plot:"Respected liberal Senator Joe Tynan is asked to lead the opposition to a Supreme Court appointment. It means losing an old friend and fudging principles to make the necessary deals, as well...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bG1dObttR6pDn5Jzt8SUSjknjoD.jpg", released:"1979-08-17"}}, {movieId:"68659", properties:{languages:["English"], year:2009, imdbId:"0489049", runtime:90, imdbRating:6.6, countries:["USA"], imdbVotes:49105, title:"Fanboys", url:"https://themoviedb.org/movie/13532", revenue:948753, tmdbId:"13532", plot:"Star Wars fanatics take a cross-country trip to George Lucas' Skywalker Ranch so their dying friend can see a screening of Star Wars: Episode I - The Phantom Menace (1999) before its release.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fitksX4J3xfBjT38YgDUXOlBkHk.jpg", released:"2009-02-13"}}, {movieId:"68791", properties:{languages:["English", " Italian"], year:2009, imdbId:"0438488", runtime:115, imdbRating:6.6, countries:["USA", " Germany", " UK", " Italy"], imdbVotes:278072, title:"Terminator Salvation", url:"https://themoviedb.org/movie/534", revenue:371353001, tmdbId:"534", plot:"In 2018, a mysterious new weapon in the war against the machines, half-human and half-machine, comes to John Connor on the eve of a resistance attack on Skynet. But whose side is he on, and can he be trusted?", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gw6JhlekZgtKUFlDTezq3j5JEPK.jpg", released:"2009-05-21", budget:200000000}}, {movieId:"68793", properties:{languages:["English"], year:2009, imdbId:"1078912", runtime:105, imdbRating:5.9, countries:["USA", " Canada"], imdbVotes:125238, title:"Night at the Museum: Battle of the Smithsonian", url:"https://themoviedb.org/movie/18360", revenue:413106170, tmdbId:"18360", plot:"Security guard Larry Daley infiltrates the Smithsonian Institution in order to rescue Jedediah and Octavius, who have been shipped to the museum by mistake.", pos