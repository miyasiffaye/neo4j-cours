UNWIND [{tmdbId:"1055290", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0396012", born:date('1920-08-09'), name:"Clayton Allen", bio:"Allen 'Farina' Hoskins was born on August 9, 1920 in Boston, Massachusetts, USA as Allen Clayton Hoskins.  He was an actor, known for Pups Is Pups (1930), Shivering Shakespeare(1930) and Bear Shooters (1930).  He was married to Frances.  Has two children: a daughter Candy and a son Chris.  He died on July 26, 1980 in Oakland, California, USA.  Brother of actress Jannie Hoskins.  \n\nOn screen from the age of 14 months, he acquired the name 'Farina' from the cereal...", died:date('1980-07-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dpRqNv9R1k2YFVWaplHsBFNu086.jpg", url:"https://themoviedb.org/person/1055290"}}, {tmdbId:"4720", properties:{bornIn:"Atlanta, Georgia, USA", imdbId:"1577190", born:date('1977-06-08'), name:"Kanye West", bio:"Kanye Omari West is an American rapper, singer, and record producer.  West first rose to fame as a producer for Roc-A-Fella Records, where he eventually achieved recognition for his work on Jay-Z's album The Blueprint, as well as hit singles for musical artists including Alicia Keys, Ludacris, and Janet Jackson.  His style of production originally used pitched-up vocal samples from soul songs incorporated with his own drums and instruments...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xMGWSdT0mcqzentuImFmVhkEgAQ.jpg", url:"https://themoviedb.org/person/4720"}}, {tmdbId:"71531", properties:{bornIn:"New Delhi, India", imdbId:"0159149", born:date('1947-10-22'), name:"Deepak Chopra", bio:"Deepak Chopra is an American author, public speaker, alternative medicine advocate, and a prominent figure in the New Age movement.  Through his books and videos, he has become one of the best-known and wealthiest figures in alternative medicine. \n\nDescription above from the Wikipedia article Deepak Chopra, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4k7fEYrJLNsEYPIIuENZfliKchs.jpg", url:"https://themoviedb.org/person/71531"}}, {tmdbId:"1492548", properties:{name:"Dries Vanhegen", url:"https://themoviedb.org/person/1492548"}}, {tmdbId:"76283", properties:{imdbId:"0046408", name:"Norman Baert", url:"https://themoviedb.org/person/76283"}}, {tmdbId:"76284", properties:{imdbId:"2131701", name:"Gunter Lamoot", url:"https://themoviedb.org/person/76284"}}, {tmdbId:"76285", properties:{bornIn:"Bruges, Belgium", imdbId:"0522205", born:date('1966-01-01'), name:"Sam Louwyck", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lNBebf27sqh0FTYyyvikp77R197.jpg", url:"https://themoviedb.org/person/76285"}}, {tmdbId:"38459", properties:{bornIn:"Vienna, Austria", imdbId:"0548686", born:date('1963-08-23'), name:"Karl Markovics", bio:"From Wikipedia, the free encyclopedia. \n\nKarl Markovics (born August 29, 1963) is an Austrian actor. \n\nHe starred as Salomon Sorowitsch in Stefan Ruzowitzky's 2007 film The Counterfeiters, which was awarded the Academy Award for Best Foreign Language Film for that year...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gQrQLzFze9rPz40kkr1RWuqLAJN.jpg", url:"https://themoviedb.org/person/38459"}}, {tmdbId:"6086", properties:{bornIn:"Bergen auf Rügen, Germany", imdbId:"0834479", born:date('1973-10-01'), name:"Devid Striesow", bio:"Devid Striesow (born October 1, 1973 in Bergen auf Rügen) is a German actor.  He starred as \"Sturmbannführer Herzog\" (Bernhard Krüger) in Stefan Ruzowitzky's 2007 film The Counterfeiters, which was awarded the Academy Award for Best Foreign Language Film for that year. \n\nDescription above from the Wikipedia article Devid Striesow, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qp6kyEzczKQgnHVIjms8G8LKuz5.jpg", url:"https://themoviedb.org/person/6086"}}, {tmdbId:"44393", properties:{bornIn:"Dresden, Germany", imdbId:"0104180", born:date('1967-01-01'), name:"Martin Brambach", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Gso7o3DTnxlGbtIE8CL6swdxox.jpg", url:"https://themoviedb.org/person/44393"}}, {tmdbId:"1956", properties:{bornIn:"Paris, Tennessee, U.S.", imdbId:"0427728", born:date('1956-11-21'), name:"Cherry Jones", bio:"From Wikipedia, the free encyclopedia. \n\nCherry Jones (born November 21, 1956) is an American actress. \n\nDescription above from the Wikipedia article Cherry Jones, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eAq9waPDjKV9kaKiiCT5x7vR0o.jpg", url:"https://themoviedb.org/person/1956"}}, {tmdbId:"74747", properties:{bornIn:"Thailand", imdbId:"1395312", born:date('1978-06-25'), name:"Shahkrit Yamnarm", bio:"From Wikipedia, the free encyclopedia\n\nChakrit Yamnam  (born 25 June 1978 in Bangkok, Thailand) is a Thai film and television actor. \n\nHis films include O-Negative (1998) with Tata Young, directed by Yuthlert Sippapak.  His latest film is Bangkok Dangerous with Nicolas Cage. \n\nHe is a famous thai actor in high demand, due to his extraordinary acting skills.  He has acted in numerous popular lakorns, sitcoms and commercials...", url:"https://themoviedb.org/person/74747"}}, {tmdbId:"76484", properties:{bornIn:"Betong District, Thailand", imdbId:"2486428", born:date('1983-11-11'), name:"Panward Hemmanee", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9lvg5lqW3wBmkZ1DNNaQxw7Tr4C.jpg", url:"https://themoviedb.org/person/76484"}}, {tmdbId:"557024", properties:{imdbId:"2643166", name:"Adam", url:"https://themoviedb.org/person/557024"}}, {tmdbId:"557026", properties:{bornIn:"Marktl, Bavaria, Germany", imdbId:"1909127", born:date('1927-04-16'), name:"Pope Benedict XVI", bio:"His Holiness Pope Benedict XVI (Latin: Benedictus PP.  XVI; Italian: Benedetto XVI; German: Benedikt XVI. ; born Joseph Aloisius Ratzinger on 16 April 1927) is the 265th and current Pope, by virtue of his office of Bishop of Rome, the Sovereign of the Vatican City State and the head of the Roman Catholic Church.  He was elected on 19 April 2005 in a papal conclave, celebrated his Papal Inauguration Mass on 24 April 2005, and took possession of his cathedral, the Basilica of St...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3unCeO9x6MyJMwXcOc4F5yeazW9.jpg", url:"https://themoviedb.org/person/557026"}}, {tmdbId:"557027", properties:{imdbId:"2930734", name:"Monsignor Cain", url:"https://themoviedb.org/person/557027"}}, {tmdbId:"53336", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"1040365", born:date('1984-03-07'), name:"Brandon T. Jackson", bio:"From Wikipedia, the free encyclopedia. \n\nBrandon Timothy Jackson (born March 7, 1984) is an American stand-up comedian, actor, and comedian.  He is best known for his supporting roles in the Hollywood films Tropic Thunder, Percy Jackson &amp; the Olympians: The Lightning Thief, Lottery Ticket, and a leading role in Big Mommas: Like Father, Like Son. \n\nDescription above from the Wikipedia article Brandon T.  Jackson, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/atdkrv0XzuZNYpjqn0kDub78TjQ.jpg", url:"https://themoviedb.org/person/53336"}}, {tmdbId:"109513", properties:{bornIn:"New York City, New York, USA", imdbId:"1275259", born:date('1986-03-16'), name:"Alexandra Daddario", bio:"Alexandra Anna Daddario (born March 16, 1986) is an American actress, known to film audiences as Annabeth Chase in the 2010 film Percy Jackson & the Olympians: The Lightning Thief.  Daddario was also in The Squid and the Whale, All My Children, The Babysitters, The Attic, The Hottest State, White Collar, It's Always Sunny in Philadelphia, and Bereavement.  She will star as the protagonist \"Heather Miller\" in the 2013 horror film Texas Chainsaw 3D...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lh5zibQXYH1MNqkuX8TmxyNYHhK.jpg", url:"https://themoviedb.org/person/109513"}}, {tmdbId:"105727", properties:{bornIn:"Canton, Ohio, USA", imdbId:"1831976", born:date('1987-11-18'), name:"Jake Abel", bio:"From Wikipedia, the free encyclopedia. \n\nJacob Allen \"Jake\" Abel (born November 18, 1987) is an American actor. \n\nAbel was born in Canton, Ohio.  His first break was landing a role in the Disney Channel Original Movie Go Figure as Spencer, and later had a recurring role on Threshold, and numerous guest starring roles on such shows as Cold Case and ER.  He was honored with a Rising Star award at the 16th Hamptons International Film Festival in October, 2008 for his work in the film Flash of Genius...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7Z5BBB0x73NOOASuHTibgsJpWSJ.jpg", url:"https://themoviedb.org/person/105727"}}, {tmdbId:"8177", properties:{bornIn:"Washington, D.C., USA", imdbId:"1013003", born:date('1973-08-03'), name:"Michael Ealy", bio:"Michael Brown (born August 3, 1973), professionally known as Michael Ealy, was born on August 3, 1973 in Silver Spring, Maryland.  He attended SpringbrookHigh School and the University of Maryland, College Park.  Ealy started his acting career in the late-1990s, appearing in a number of off-Broadway stage productions.  Among his first film roles were Bad Company and Kissing Jessica Stein...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j6DDsuHgoXKNLICrPElchRok5gV.jpg", url:"https://themoviedb.org/person/8177"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"82314", properties:{bornIn:"Cannes, French Riviera, France", imdbId:"1675534", born:date('1981-08-05'), name:"Karina Testa", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lqNL5RNFOOSZyuy5ING1Zw7FX0U.jpg", url:"https://themoviedb.org/person/82314"}}, {tmdbId:"77192", properties:{bornIn:"Rouen, France", imdbId:"0356803", born:date('1966-05-11'), name:"Estelle Lefébure", bio:"From Wikipedia, the free encyclopedia\n\nEstelle Lefébure ([ɛstɛl ləfebyʁ]; born 11 May 1966) is a French actress and model.  She was one of the top fashion models in the 1980s and 1990s.  Estelle Lefebure, as she was known in the early 1980s, was discovered by George Gallier and managed by him exclusively at Prestige Models in Paris, France.  George Gallier then moved to New York City to start American Model Management, and managed her career until 1991...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l02UplB8CmwOTDkmAwmflnxFl7Z.jpg", url:"https://themoviedb.org/person/77192"}}, {tmdbId:"25342", properties:{bornIn:"Deauville, Calvados, France", imdbId:"0927907", born:date('1980-09-24'), name:"Aurélien Wiik", bio:"Aurélien Wiik (born 24 September 1980) is a French actor and filmmaker.  He is the son of a Norwegian father and of the French actress Françoise Deldick. \n\nHe made his cinematic acting debut at the age of twelve, playing Antoine in the 1994 film Cache cash, directed by Claude Pinoteau.  In 1997, he played \"Pierrot\" in Roger Hanin's film Soleil, starring Sophia Loren, Philippe Noiret and Marianne Sägebrecht...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kCQie180Yry11GcAIWGR6sTYvHK.jpg", url:"https://themoviedb.org/person/25342"}}, {tmdbId:"51990", properties:{bornIn:"Denver, Colorado, United States", imdbId:"2554352", born:date('1981-06-04'), name:"T.J. Miller", bio:"Todd Joseph Miller, better known as T.  J.  Miller, is an American actor and stand-up comedian.  He starred as Erlich Bachman in the HBO sitcom Silicon Valley.  Miller has also performed in such films as Cloverfield (2008), Yogi Bear (2010), How to Train Your Dragon (2010), How to Train Your Dragon 2 (2014), Transformers: Age of Extinction (2014), Big Hero 6 (2014) and Deadpool (2016)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rRrVvBxOkyYM5XdLXimShHR1Itn.jpg", url:"https://themoviedb.org/person/51990"}}, {tmdbId:"191441", properties:{name:"Tal Bachman", url:"https://themoviedb.org/person/191441"}}, {tmdbId:"554096", properties:{imdbId:"3937434", name:"Jonathan Boulden", url:"https://themoviedb.org/person/554096"}}, {tmdbId:"74089", properties:{imdbId:"0073903", name:"Steve Burg", url:"https://themoviedb.org/person/74089"}}, {tmdbId:"66536", properties:{imdbId:"2358430", born:date('1984-09-18'), name:"Jack Carpenter", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rptmopCWO0hLfEbBhQHy4FdW0Gr.jpg", url:"https://themoviedb.org/person/66536"}}, {tmdbId:"1008607", properties:{bornIn:"Windsor, Ontario, Canada", imdbId:"4563869", born:date('2000-03-27'), name:"Sophie Nélisse", bio:"Marie-Sophie Nélisse is a Canadian teen actress.  She is known for her Genie Award–winning performance in Monsieur Lazhar and for her starring role in The Book Thief.  Nélisse was born in Windsor, Ontario, but moved to Montréal, Québec, with her family when she was four.  She is of French Canadian descent.  Besides her Genie Award for Monsieur Lazhar, she won a Jutra Award for her performance and a Young Artist Award nomination as Best Leading Young Actress in an International Feature Film...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/roQc7GThsv5gpzR1TfDvrnq2T1q.jpg", url:"https://themoviedb.org/person/1008607"}}, {tmdbId:"1327255", properties:{imdbId:"6065914", name:"Julian Lehmann", url:"https://themoviedb.org/person/1327255"}}, {tmdbId:"97586", properties:{imdbId:"1647620", name:"Rosie Traynor", url:"https://themoviedb.org/person/97586"}}, {tmdbId:"97587", properties:{imdbId:"0687109", name:"David Pledger", url:"https://themoviedb.org/person/97587"}}, {tmdbId:"97588", properties:{bornIn:"Melbourne, Victoria, Australia", imdbId:"2089454", name:"Martin Sharpe", bio:"Martin Sharpe is an Australian film, stage and television actor.  He received a drama scholarship to Kingswood College in Melbourne in 2000 and later studied at the Academy of Interactive Entertainment (AIE).  Martin played a lead role in his first film, \"Lake Mungo\", released in 2007.   He is now a Motion Graphics & 3D animation specialist...", url:"https://themoviedb.org/person/97588"}}, {tmdbId:"2433583", properties:{name:"Talia Zucker", url:"https://themoviedb.org/person/2433583"}}, {tmdbId:"851784", properties:{bornIn:"Los Angeles, California, USA", imdbId:"3237775", born:date('2000-11-10'), name:"Mackenzie Foy", bio:"Mackenzie Christine Foy (born November 10, 2000) is an American model and actress.  She is best known for her role as Renesmee Cullen in the 2012 film The Twilight Saga: Breaking Dawn – Part 2, which earned her a Young Artist Award nomination as Best Supporting Young Actress in a Feature Film, and as the young Murphy in the 2014 space epic Interstellar, for which she received critical acclaim and several awards and nominations...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/u6Dt9C6VwWt4kRTGEcr3p2shxgt.jpg", url:"https://themoviedb.org/person/851784"}}, {tmdbId:"175826", properties:{bornIn:"Houston - Texas - USA", imdbId:"0257969", born:date('1975-09-22'), name:"Mireille Enos", bio:"Mireille Enos (born 22 September 1975, height 5' 2\" (1,57 m)) is an actress who grew up in Houston, Texas. \n\nEnos studied at Brigham Young University.  She is a member of The Church of Jesus Christ of Latter-day Saints. \n\nShe was nominated for a Tony Award (Best Featured Actress in a Play) in 2005 for her performance in the Broadway production of Who's Afraid of Virginia Woolf. \n\nShe also has numerous television appearances, notably playing Kathy and Jodeen Marquart, twin sisters, in HBO's Big Love...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hk416QVnxXGMlvdx5RT9k6ht6z.jpg", url:"https://themoviedb.org/person/175826"}}, {tmdbId:"1180907", properties:{bornIn:"Jerusalem, Israel", imdbId:"2020146", born:date('1989-03-11'), name:"Daniella Kertesz", bio:"Daniella Kertesz \" דניאלה קרטס‎ \" is an actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uAl2qNnWGSO5AVGQMujFSKUOR5h.jpg", url:"https://themoviedb.org/person/1180907"}}, {tmdbId:"62564", properties:{bornIn:"Los Angeles, California, USA", imdbId:"1630992", born:date('1996-03-18'), name:"Madeline Carroll", bio:"Madeline Carroll (born March 18, 1996) is an American teen actress she is best known for playing Julianna \"Juli\" Baker in her feature film Flipped. \n\nDescription above from the Wikipedia article Madeline Carroll, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o1r5be1TEohcok1EZMgwvG3TFqj.jpg", url:"https://themoviedb.org/person/62564"}}, {tmdbId:"236851", properties:{bornIn:"Sydney, New South Wales, Australia", imdbId:"2786608", born:date('1995-01-24'), name:"Callan McAuliffe", bio:"From Wikipedia, the free encyclopedia.  Callan McAuliffe (born Callan Ryan Claude McAuliffe, on 24 January 1995) is an Australian actor.  He starred in the American feature films Flipped and I Am Number Four. \n\nDescription above from the Wikipedia article Callan McAuliffe, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n3DaJlAj4bzIAiokLxYaVhJEnAl.jpg", url:"https://themoviedb.org/person/236851"}}, {tmdbId:"55097", properties:{bornIn:"Ravenna - Ohio - USA", imdbId:"2107837", born:date('1992-01-17'), name:"Nate Hartley", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dCw5LGB03eiWLsr5qKGJxlMIfnH.jpg", url:"https://themoviedb.org/person/55097"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"13101", properties:{bornIn:"Secaucus - New Jersey - USA", imdbId:"0731168", born:date('1965-07-29'), name:"Ian Roberts", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jCc6zI4JceFAyeXIHXNR0blnzSe.jpg", url:"https://themoviedb.org/person/13101"}}, {tmdbId:"86329", properties:{bornIn:"South Korea", imdbId:"1045777", born:date('1966-08-24'), name:"Kil-kang Ahn", bio:"Ahn Gil-kang (Korean: 안길강; born August 24, 1966) is a South Korean actor.  His role in the popular period drama Queen Seon Duk earned him the Golden Acting Award at the 2009 MBC Drama Awards...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fLxQ5zwiMxREFaXsxOekU0VwYfb.jpg", url:"https://themoviedb.org/person/86329"}}, {tmdbId:"2441", properties:{bornIn:"Oxford, Oxfordshire, England, UK", imdbId:"0390903", born:date('1967-08-25'), name:"Tom Hollander", bio:"Thomas Anthony \"Tom\" Hollander (born 25 August 1967) is an English actor who has appeared in productions such as Enigma, Gosford Park, Cambridge Spies, Pride and Prejudice, Pirates of the Caribbean, In the Loop, Valkyrie and Hanna.   Description above from the Wikipedia article Tom Hollander, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lGkENAqtbv5S1Fg7ax7qMFcjfhJ.jpg", url:"https://themoviedb.org/person/2441"}}, {tmdbId:"74245", properties:{imdbId:"2037879", name:"Shane Jacobson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9AatyV42M7x6JufAOpHKqOTGts3.jpg", url:"https://themoviedb.org/person/74245"}}, {tmdbId:"1485969", properties:{imdbId:"2635146", name:"Chris Davis", url:"https://themoviedb.org/person/1485969"}}, {tmdbId:"58115", properties:{bornIn:"San Francisco, California, USA", imdbId:"0199312", born:date('1972-11-09'), name:"Eric Dane", bio:"​Eric Dane is an American actor; After appearing in television roles throughout the 1990s and 2000s, he became known for playing Dr.  Mark \"McSteamy\" Sloan on the series Grey's Anatomy, and has recently branched into film, co-starring in Marley & Me, Valentine's Day, and Burlesque. \n\nIn 1993, Dane moved to Los Angeles, where he played small roles in the television series Saved by the Bell, The Wonder Years, Roseanne, and Married With Children, among others...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rTQqWQnvnHDy35otg2KArofOcgv.jpg", url:"https://themoviedb.org/person/58115"}}, {tmdbId:"55086", properties:{bornIn:"Tacoma, Washington, USA", imdbId:"1544217", born:date('1982-08-16'), name:"Cam Gigandet", bio:"​Cam Joslin Gigandet is an American actor, whose roles have included Twilight, The O. C. , Never Back Down and Burlesque.  In 2003, Gigandet made his acting debut making a guest appearance in the Crime television series CSI: Crime Scene Investigation.  In 2004 and 2005 Gigandet continued his television career making noticeable recurring roles in television shows such as The Young and The Restless and Jack and Bobby...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kdSVRqCR0p8KZTvVkRccBLoim7L.jpg", url:"https://themoviedb.org/person/55086"}}, {tmdbId:"454", properties:{bornIn:"Chicago, Illinois, USA ", imdbId:"0671567", born:date('1976-01-13'), name:"Michael Peña", bio:"Michael Anthony Peña (born January 13, 1976) is an American film and television actor, probably best known for his prominent roles in Crash, Observe and Report, and Oliver Stone's World Trade Center.  He also appeared in the Nickelback music video for their song Savin' Me. \n\nDescription above from the Wikipedia article Michael Peña, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tu5CtDtVP4oZBVQgi0s4vgZErIg.jpg", url:"https://themoviedb.org/person/454"}}, {tmdbId:"51072", properties:{bornIn:"Bedford, New York, USA", imdbId:"0544718", born:date('1983-02-27'), name:"Kate Mara", bio:"Kate Rooney Mara is an American television and film actress.  Beginning acting in her hometown of Bedford, New York, she moved from the stage to her first film, Random Hearts (1999).  Her notable roles include appearances in the Academy Award-winning film Brokeback Mountain (2005), playing the daughter of Heath Ledger's character, and on the Fox television series 24, as computer analyst Shari Rothenberg...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lzbWAI16nuekDM4AAESBCnDUmcf.jpg", url:"https://themoviedb.org/person/51072"}}, {tmdbId:"117885", properties:{bornIn:"California, U.S.", imdbId:"1072959", born:date('1998-11-13'), name:"Gattlin Griffith", bio:"From Wikipedia, the free encyclopedia\n\nGattlin Tadd Griffith (born November 13, 1998) is an American child actor, best known for portraying Walter Collins in the 2008 film Changeling.  He also had episodic roles on TV series such as Supernatural.  Griffith was born to Tad and Wendy Griffith.  He has three younger brothers, Callder (born June 30), Arrden and Garrison. \n\nDescription above from the Wikipedia article Gattlin Griffith, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/117885"}}, {tmdbId:"85101", properties:{imdbId:"1162421", name:"Michelle Gunn", url:"https://themoviedb.org/person/85101"}}, {tmdbId:"50217", properties:{bornIn:"Филаделфия, Пенсилвания, САЩ", imdbId:"0446672", born:date('1969-05-22'), name:"Michael Kelly", bio:"Michael Joseph Kelly (born May 22, 1969) is an American actor. \n\nDescription above from the Wikipedia article Michael Kelly (American actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8V6RKWbbx8lyt3Xxz9B1OAPvHRt.jpg", url:"https://themoviedb.org/person/50217"}}, {tmdbId:"53442", properties:{bornIn:"Lebanon", imdbId:"2316907", born:date('1978-11-21'), name:"Yasmine Al Massri", bio:"Yasmine Al Massri (born November 21, 1978) is a Lebanese-born American actress.  She made her movie debut in the 2007 film Caramel.  In 2015, Massri began starring as Nimah and Raina Amin, identical twins in the ABC thriller series Quantico...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aXeuXplDxA0fmG0R6BpbbQRSNI8.jpg", url:"https://themoviedb.org/person/53442"}}, {tmdbId:"53443", properties:{imdbId:"2320614", name:"Joanna Moukarzel", url:"https://themoviedb.org/person/53443"}}, {tmdbId:"53444", properties:{imdbId:"2318355", name:"Gisèle Aouad", url:"https://themoviedb.org/person/53444"}}, {tmdbId:"71610", properties:{bornIn:"Oslo, Norway", imdbId:"0509264", born:date('1979-01-01'), name:"Anders Danielsen Lie", bio:"Anders Danielsen Lie (born 1 January 1979) is a Norwegian actor, musician and medical doctor. \n\nDanielsen Lie made his film debut when he was 11 years old in the title role of Herman (1990) by Erik Gustavson.  He is best known for his leading roles in multi-award winning Reprise (2006) and Oslo, 31 August (2011) by Danish-Norwegian director Joachim Trier.  Oslo, 31 August was selected for Un Certain Regard at the 2011 Cannes Film Festival...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7qdJdzFFXhoSVvBCi53ryF1wkCn.jpg", url:"https://themoviedb.org/person/71610"}}, {tmdbId:"71611", properties:{imdbId:"1454907", born:date('1981-08-31'), name:"Espen Klouman Høiner", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kJK72kZDtO7nqi8BUONhvxrQDYy.jpg", url:"https://themoviedb.org/person/71611"}}, {tmdbId:"71612", properties:{bornIn:"Oslo, Norway", imdbId:"2275824", born:date('1980-03-05'), name:"Viktoria Winge", bio:"Viktoria Winge is a Norwegian stage and screen actress, vocalist and former model.  She is the daughter of actor and director Stein Winge and actress and singer Kari Onstad...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kxPhO9diaYveo40HAZiJaHQIXmT.jpg", url:"https://themoviedb.org/person/71612"}}, {tmdbId:"559194", properties:{imdbId:"2322351", born:date('1980-09-14'), name:"Odd-Magnus Williamson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5M3HLPc1ReGbf5OSSeTiurA4orT.jpg", url:"https://themoviedb.org/person/559194"}}, {tmdbId:"112200", properties:{bornIn:"Ljubljana, Republic of Slovenia", imdbId:"1670978", born:date('1949-03-21'), name:"Slavoj Zizek", bio:"A Slovenian continental philosopher and critical theorist working in the traditions of Hegelianism, Marxism and Lacanian psychoanalysis.  He has made contributions to political theory, film theory, and theoretical psychoanalysis. \n\nŽižek is a senior researcher at the Institute of Sociology, University of Ljubljana, Slovenia, and a professor at the European Graduate School...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p7otWg1LyOF4rWpc0uWzbFIu7BU.jpg", url:"https://themoviedb.org/person/112200"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"114019", properties:{bornIn:"Pontypool, Wales, UK", imdbId:"1812656", born:date('1979-04-15'), name:"Luke Evans", bio:"Luke George Evans (born 15 April 1979) is a Welsh actor.  Evans began his career on the stage, performing in many of London's West End productions such as Rent, Miss Saigon, and Piaf before making his film breakthrough in the Clash of the Titans 2010 remake.  Following his debut, Evans was cast in such action and thriller films as Immortals (2011), The Raven (2012), and the re-imagined The Three Musketeers (2011)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qUkYJcrDc4M0LHNYASs30luFvw0.jpg", url:"https://themoviedb.org/person/114019"}}, {tmdbId:"190895", properties:{bornIn:"Toronto, Ontario,  Canada", imdbId:"0300589", born:date('1987-04-04'), name:"Sarah Gadon", bio:"Sarah Gadon (born April 4, 1987) is a Canadian actress.  She has had roles in David Cronenberg's A Dangerous Method and Cosmopolis.  She has guest starred in a number of notable television series including Are You Afraid of the Dark?, Dark Oracle, Doc, In a Heartbeat, La Femme Nikita, Life with Derek, and Mutant X.  She has voice-acted for Mattimeo, My Dad the Rock Star, Ruby Gloom, Total Drama, and Wayside...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wn1JyDdcpBkrGMwRbdPXhkxVc9a.jpg", url:"https://themoviedb.org/person/190895"}}, {tmdbId:"55470", properties:{bornIn:"Greenwich, London, England, UK", imdbId:"1002641", born:date('1978-06-02'), name:"Dominic Cooper", bio:"Dominic Edward Cooper (born 2 June 1978) is an English actor.  He has worked in TV, film, theatre and radio, in productions including Mamma Mia!, The Duchess, The History Boys, The Devil's Double, Captain America: The First Avenger, and Abraham Lincoln: Vampire Hunter...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bz2nzQ1lDiu62R0e4GOncuq1hIk.jpg", url:"https://themoviedb.org/person/55470"}}, {tmdbId:"1050248", properties:{bornIn:"Moville, County Donegal, Ireland", imdbId:"3280686", born:date('2001-10-19'), name:"Art Parkinson", bio:"Art Parkinson is an actor, known for Dracula Untold (2014), The Anomaly (2014) and Game of Thrones (2011)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ejAKOJME1DsvHECLWdQ7dEtXyyc.jpg", url:"https://themoviedb.org/person/1050248"}}, {tmdbId:"1107800", properties:{bornIn:"Elmhurst, Illinois, USA", imdbId:"2640264", born:date('2000-04-06'), name:"CJ Adams", bio:"CJ Adams is an American actor perhaps best known for his role as Timothy Green in the movie The Odd Life of Timothy Green...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fk1zZZwkEgoqWSBQMaCTI7ECwMj.jpg", url:"https://themoviedb.org/person/1107800"}}, {tmdbId:"84028", properties:{bornIn:"Kasuga, Fukuoka", imdbId:"1066974", born:date('1985-08-17'), name:"Yû Aoi", bio:"From Wikipedia, the free encyclopedia. \n\nYū Aoi (born August 17, 1985) is a Japanese actress and model.  She made her film debut as Shiori Tsuda in Shunji Iwai's 2001 film All About Lily Chou-Chou.  She subsequently portrayed Tetsuko Arisugawa in Hana and Alice (2004), also directed by Iwai, Kimiko Tanigawa in the hula dancing film Hula Girls and Hagumi Hanamoto in the 2006 live-action adaptation of the popular Honey and Clover manga series...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4e7kKzwuP8VY8fGo6SX3mwH2kEQ.jpg", url:"https://themoviedb.org/person/84028"}}, {tmdbId:"70209", properties:{bornIn:"Tokyo, Japan", imdbId:"0410832", born:date('1976-05-29'), name:"Yûsuke Iseya", bio:"From Wikipedia, the free encyclopedia. \n\nYūsuke Iseya (伊勢谷 友介 Iseya Yūsuke, born 29 May 1976) is a Japanese actor. \n\nHe was born in Tokyo, Japan.  With his modeling career (Japan), Yūsuke is known for Loreal (Japan), Men's Nonno magazine, Prada (Milan), and Asahi Aqua Blue. \n\nYūsuke extended his career from modeling and being an artist to director and actor.  He made his directorial debut in 2003 with Kakuto.  He is also known for his performance in Casshern...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Api6CNgxMxoR4BBmvwptZeDfoeQ.jpg", url:"https://themoviedb.org/person/70209"}}, {tmdbId:"87661", properties:{bornIn:"Miyagi, Japan", imdbId:"1077107", born:date('1970-07-19'), name:"Kankurô Kudô", bio:"Kankurō Kudō  (宮藤 官九郎 Kudō Kankurō, born 19 July 1970) is a Japanese screenwriter, dramatist, director, actor and member of the theater company Otona Keikaku.  He won the 'Best Screenplay' award at the 2002 Japanese Academy Awards for Go, which explores problems faced by people of Korean-heritage living in Japan.  He acted in the hugely popular tear-jerker, Crying Out Love, In the Center of the World, and is also guitarist in the Japanese Comedy Rock Band Group Tamashii...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kxRBpwXecaJDStMshwgW4mok5q1.jpg", url:"https://themoviedb.org/person/87661"}}, {tmdbId:"1142303", properties:{imdbId:"2480549", name:"An Nguyen", url:"https://themoviedb.org/person/1142303"}}, {tmdbId:"138508", properties:{bornIn:"Seoul, South Korea", imdbId:"0453670", born:date('1969-02-24'), name:"Seung-woo Kim", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ckWoBoL3OBg5Y4mUbsA2rucHLZS.jpg", url:"https://themoviedb.org/person/138508"}}, {tmdbId:"1245069", properties:{bornIn:"Hwasun, South Jeolla, South Korea", imdbId:"2339907", born:date('1971-03-02'), name:"Hyun-jung Go", bio:"Go Hyun-jung (Hangul: 고현정; born March 2, 1971) is a South  Korean actress.  She debuted in the entertainment scene as a Miss  Korea runner-up in 1989 and went on to star in Sandglass, one of the  highest-rated and critically acclaimed dramas in Korean television  history.  She retired after marrying chaebol Chung Yong-jin in 1995, then  returned to acting after their divorce in 2003...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3ecBvwLv7V4cWsJssI4UTngN1q6.jpg", url:"https://themoviedb.org/person/1245069"}}, {tmdbId:"27980", properties:{bornIn:"Paris, France", imdbId:"0778568", born:date('1937-10-21'), name:"Edith Scob", bio:"Edith Scob (October 21, 1937 - June 26, 2019) was a french actress...", died:date('2019-06-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mJqz3YZivskBit9eEXE0JXGNtHz.jpg", url:"https://themoviedb.org/person/27980"}}, {tmdbId:"77948", properties:{bornIn:"Grand Prairie, Texas, USA ", imdbId:"1411125", born:date('1992-07-22'), name:"Selena Gomez", bio:"Selena Marie Gomez (born July 22, 1992) is an American actress, singer, and UNICEF Goodwill Ambassador, best known for portraying Alex Russo in the Emmy Award-winning Disney Channel television series Wizards of Waverly Place.  She subsequently ventured into feature films and has starred in the television movies Another Cinderella Story, Wizards of Waverly Place: The Movie, and Princess Protection Program.   She made her starring theatrical film debut in Ramona and Beezus...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vUHAd9bBM0EYzMnExgnFaUcoaSy.jpg", url:"https://themoviedb.org/person/77948"}}, {tmdbId:"67206", properties:{bornIn:"Cardiff, Wales, UK", imdbId:"0397110", born:date('1969-06-12'), name:"Andrew Howard", bio:"Andrew Howard is a Welsh theatre, television and film actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lKuZYelO5zUzJ3AqkjV9us1mZLa.jpg", url:"https://themoviedb.org/person/67206"}}, {tmdbId:"92648", properties:{imdbId:"2173223", name:"Pollyanna Rose", url:"https://themoviedb.org/person/92648"}}, {tmdbId:"62360", properties:{imdbId:"2326614", name:"Olivia Hill", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zpcoDWvI9Tyw9yzxwBWi1dPUOwa.jpg", url:"https://themoviedb.org/person/62360"}}, {tmdbId:"62357", properties:{imdbId:"0104504", born:date('1975-12-22'), name:"Nadja Brand", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/29I43YVKJhyzqWIYFKM4vBUGfel.jpg", url:"https://themoviedb.org/person/62357"}}, {tmdbId:"7822", properties:{bornIn:"Brilon, Germany", imdbId:"0783124", born:date('1948-03-27'), name:"Edgar Selge", bio:"Edgar Selge was born on March 27, 1948 in Brilon, North Rhine-Westphalia, Germany.  He is an actor, known for Das Experiment (2001), Reine Geschmacksache (2007) andPoll (2010).  He has been married to Franziska Walser since 1985.  They have two children...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/27bNgjrdwsigAvHPe84T8QDLrOl.jpg", url:"https://themoviedb.org/person/7822"}}, {tmdbId:"231835", properties:{bornIn:"Frankfurt am Main - Germany", imdbId:"1921479", born:date('1987-01-10'), name:"Florian Bartholomäi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7iILONJhMET8FHXc1vhYQffQC9s.jpg", url:"https://themoviedb.org/person/231835"}}, {tmdbId:"36437", properties:{bornIn:"Bautzen, Germany", imdbId:"0461210", born:date('1970-02-08'), name:"Roman Knizka", url:"https://themoviedb.org/person/36437"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"48702", properties:{bornIn:"Stuttgart; Germany", imdbId:"0909515", born:date('1952-03-23'), name:"Franziska Walser", url:"https://themoviedb.org/person/48702"}}, {tmdbId:"66443", properties:{bornIn:"Wimbledon, London, UK", imdbId:"2496312", born:date('1984-01-01'), name:"Amara Karan", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ebgCz8rKhVUIUb8EHpVXGX4FEJ8.jpg", url:"https://themoviedb.org/person/66443"}}, {tmdbId:"65717", properties:{bornIn:"St. Louis, Missouri, USA", imdbId:"0358316", born:date('1971-03-10'), name:"Jon Hamm", bio:"Jonathan Daniel \"Jon\" Hamm (born March 10, 1971) is an American actor who works primarily in television.  For much of the mid-1990s, Hamm lived in Los Angeles as a struggling actor appearing in small parts in multiple television series, including Providence, The Division, What About Brian and Related.  In 2000 he made his feature film debut in Clint Eastwood's space adventure, Space Cowboys.  The following year, Hamm appeared in the independent comedy, Kissing Jessica Stein (2001) in a minor role...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a6hRdWpneWtXYbb1wxtA72hpKqL.jpg", url:"https://themoviedb.org/person/65717"}}, {tmdbId:"62960", properties:{bornIn:"Lincolnshire, England, UK", imdbId:"0916267", born:date('1972-09-29'), name:"Robert Webb", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hPvNUIMkg0hpvPm2rkzt1spE8fk.jpg", url:"https://themoviedb.org/person/62960"}}, {tmdbId:"139075", properties:{bornIn:"Salisbury, Wiltshire, England, UK", imdbId:"0593267", born:date('1974-07-14'), name:"David Mitchell", bio:"British comedian, actor and writer.  He is half of the comedy duo Mitchell and Webb alongside Robert Webb...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mHN2NWjBsXseWqq7Zg8K31NS91n.jpg", url:"https://themoviedb.org/person/139075"}}, {tmdbId:"62961", properties:{imdbId:"0352864", born:date('1971-02-20'), name:"Sarah Hadland", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aVEhNxCplkThxE2flILB3YOoVPp.jpg", url:"https://themoviedb.org/person/62961"}}, {tmdbId:"62962", properties:{imdbId:"0254585", name:"Paul Mark Elliott", url:"https://themoviedb.org/person/62962"}}, {tmdbId:"1224835", properties:{bornIn:"Dickson, Tennessee, USA", imdbId:"1739782", born:date('1999-04-07'), name:"Conner Rayburn", bio:"From Wikipedia, the free encyclopedia\n\nConner Rayburn was born in Dickson,  Tennessee (about 40 miles west of Nashville) on April 7, 1999.  He is  best known for his role of Kyle Orenthal on the American sitcom According to Jim...", url:"https://themoviedb.org/person/1224835"}}, {tmdbId:"556526", properties:{imdbId:"1578229", name:"Bill Baird", url:"https://themoviedb.org/person/556526"}}, {tmdbId:"556527", properties:{imdbId:"2346706", name:"Flip Benham", url:"https://themoviedb.org/person/556527"}}, {tmdbId:"76070", properties:{bornIn:"Canberra, Australia", imdbId:"1985859", born:date('1989-10-25'), name:"Mia Wasikowska", bio:"From Wikipedia, the free encyclopedia\n\nMia Wasikowska (born 25 October 1989) is an Australian actress.  After starting her career in Australian television and film, she first became known to a wider audience following her critically acclaimed work on the HBO television series In Treatment...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1slhjKDGrjYRKesNLvVYPCbUvBV.jpg", url:"https://themoviedb.org/person/76070"}}, {tmdbId:"20478", properties:{bornIn:" Portland, Oregon, USA", imdbId:"2437336", born:date('1991-08-26'), name:"Gabe Nevins", bio:"​From Wikipedia, the free encyclopedia.   \n\nGabriel \"Gabe\" Nevins (born August 26, 1991) is a professional actor who landed the star role in Gus Van Sant’s 2007 film Paranoid Park.  The film premiered at the 2007 Cannes Film Festival as one of the 22 films in the competition, and won the extra-special 60th anniversary prize. \n\nIn 2006, the Milwaukie, Oregon, native was spotted and cast as the lead in director Gus Van Sant's Paranoid Park while auditioning to be a skateboarding extra...", url:"https://themoviedb.org/person/20478"}}, {tmdbId:"20479", properties:{imdbId:"2436421", name:"Daniel Liu", url:"https://themoviedb.org/person/20479"}}, {tmdbId:"20481", properties:{imdbId:"2683844", name:"Jake Miller", url:"https://themoviedb.org/person/20481"}}, {tmdbId:"18054", properties:{bornIn:"Hadano, Kanagawa Prefecture, Japan", imdbId:"0452860", born:date('1981-01-06'), name:"Rinko Kikuchi", bio:"Rinko Kikuchi, born Yuriko Kikuchi, January 6, 1981, is a Japanese actress.  Kikuchi is the first Japanese actress to be nominated for an Academy Award in 50 years.  She is currently Japan's only living female Academy Award nominee in acting categories.  The only other nominee was Miyoshi Umeki, who won the Best Supporting Actress award in 1957 for Sayonara...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lv4UuorZtC37VaFAHO205u4lS73.jpg", url:"https://themoviedb.org/person/18054"}}, {tmdbId:"42276", properties:{bornIn:"London, England, UK", imdbId:"0672303", born:date('1970-09-22'), name:"Rupert Penry-Jones", bio:"​From Wikipedia, the free encyclopedia. \n\nRupert William Penry-Jones  (born 22 September 1970) is an English actor, best known for his role as Adam Carter in the British television series Spooks, also broadcast under the title MI-5...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4qRzWtQtxjbSZKOrV68hDQWGZgE.jpg", url:"https://themoviedb.org/person/42276"}}, {tmdbId:"15121", properties:{bornIn:" Vienna, Austria", imdbId:"0777649", born:date('1971-01-10'), name:"Simon Schwarz", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wDbRRaQxOgKswjwslu6LMwosNxq.jpg", url:"https://themoviedb.org/person/15121"}}, {tmdbId:"68276", properties:{bornIn:"San Diego - California - USA", imdbId:"0086883", born:date('1975-03-05'), name:"Jolene Blalock", bio:"From Wikipedia, the free encyclopedia\n\nJolene K.  Blalock (born March 5, 1975, height 5' 6\" (1,68 m)) is an American film and television actress and model, perhaps best known for playing the Vulcan T'Pol on the UPN science fiction series Star Trek: Enterprise.  The star of several feature films, she is a regular guest star in television films and series.    Description above from the Wikipedia article Jolene Blalock, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1RCFW6q8hMMarwmPkPyiCaQEPBB.jpg", url:"https://themoviedb.org/person/68276"}}, {tmdbId:"76415", properties:{imdbId:"0389621", name:"Stephen Hogan", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wLmVf0LGfYsgH5PNDxRGO7MlzwK.jpg", url:"https://themoviedb.org/person/76415"}}, {tmdbId:"80758", properties:{bornIn:"Vienna, Austria", imdbId:"0462673", born:date('1973-03-08'), name:"Boris Kodjoe", bio:"Boris Frederic Cecil Tay-Natey Ofuatey-Kodjoe was born on 8 March 1973 in Vienna, Austria...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fo6bMq96LUDEatiXlQlMctOMGI3.jpg", url:"https://themoviedb.org/person/80758"}}] AS row
