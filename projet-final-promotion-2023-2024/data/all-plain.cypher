ps://image.tmdb.org/t/p/w440_and_h660_face/tdZ6XLzIaK0HWWPSM2B5OrOqUC0.jpg", url:"https://themoviedb.org/person/220088"}}, {tmdbId:"149089", properties:{imdbId:"0012245", born:date('1901-02-10'), name:"Stella Adler", died:date('1992-12-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3dgOzNIyBC1TUFHSrN5jwoNazq2.jpg", url:"https://themoviedb.org/person/149089"}}, {tmdbId:"1159956", properties:{imdbId:"0123548", born:date('1882-05-10'), name:"Clarence Burton", died:date('1933-12-02'), url:"https://themoviedb.org/person/1159956"}}, {tmdbId:"162524", properties:{imdbId:"0550233", name:"Marlo Marron", url:"https://themoviedb.org/person/162524"}}, {tmdbId:"109255", properties:{bornIn:"New York City, New York, USA", imdbId:"0540795", born:date('1950-12-18'), name:"Leonard Maltin", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5jQo1L8Vv10nZQQeMgSaCjLxJlB.jpg", url:"https://themoviedb.org/person/109255"}}] AS row
