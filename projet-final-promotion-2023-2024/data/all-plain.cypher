UNWIND [{tmdbId:"1533831", properties:{imdbId:"0472164", name:"Barbara Kroner", url:"https://themoviedb.org/person/1533831"}}, {tmdbId:"163698", properties:{imdbId:"0546192", name:"Steven Marcus", url:"https://themoviedb.org/person/163698"}}, {tmdbId:"39759", properties:{bornIn:"New York City, New York", imdbId:"0801883", born:date('1928-04-18'), name:"Alexander Singer", bio:"From Wikipedia, the free encyclopedia  Alexander Singer (born 1932, in New York City, New York) is an American director.  He began his career behind the camera in 1951 as a cinematographer on the short documentary Day of the Fight, directed by his high school friend, Stanley Kubrick.  Singer himself turned to directing a decade later with the film, A Cold Wind in August...", url:"https://themoviedb.org/person/39759"}}, {tmdbId:"28032", properties:{imdbId:"0233646", name:"Bob Dorian", url:"https://themoviedb.org/person/28032"}}, {tmdbId:"58543", properties:{imdbId:"0552423", name:"Ivan Martin", url:"https://themoviedb.org/person/58543"}}, {tmdbId:"550606", properties:{bornIn:"Hiroshima Prefecture, Japan", imdbId:"0794027", born:date('1975-11-06'), name:"Mayumi Shintani", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/s3aH3ZIFf03YqjVLHIHXG9RJuRl.jpg", url:"https://themoviedb.org/person/550606"}}, {tmdbId:"931461", properties:{imdbId:"0440374", name:"Izumi Kasagi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9YLwzXRIiDuG7vEnY4LwADMaKMZ.jpg", url:"https://themoviedb.org/person/931461"}}, {tmdbId:"58613", properties:{bornIn:"Fukuoka, Japan", imdbId:"0559618", born:date('1962-12-15'), name:"Suzuki Matsuo", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aEPjvo4clIRPX4EcpkTxr8kRYR7.jpg", url:"https://themoviedb.org/person/58613"}}, {tmdbId:"155940", properties:{bornIn:"USA", imdbId:"0008651", born:date('1957-08-05'), name:"Donzaleigh Abernathy", url:"https://themoviedb.org/person/155940"}}, {tmdbId:"1927824", properties:{imdbId:"1035021", name:"Mark Aldrich", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vGxVyXaHa7U33AKPZU5lwOHwKfO.jpg", url:"https://themoviedb.org/person/1927824"}}, {tmdbId:"181588", properties:{imdbId:"0021456", name:"Keith Allison", url:"https://themoviedb.org/person/181588"}}, {tmdbId:"44830", properties:{imdbId:"0750658", born:date('1954-04-10'), name:"Deborah Rush", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Al8lsQSVHluyFmb8YbA3O5TeEhe.jpg", url:"https://themoviedb.org/person/44830"}}, {tmdbId:"3911", properties:{bornIn:"Boulder, Colorado, USA", imdbId:"0002253", born:date('1963-08-01'), name:"John Carroll Lynch", bio:"John Carroll Lynch (born August 1, 1963) is an American actor, known for his role as Drew Carey's cross-dressing brother on The Drew Carey Show, and for his role as Norm, the unassuming husband of Margie Gunderson (Frances McDormand) in Fargo. \n\nIn the fall of 2003, he starred in the CBS show The Brotherhood of Poland, New Hampshire, with Randy Quaid, Chris Penn, Mare Winningham, Elizabeth McGovern, and Ann Cusack.  The show was cancelled after only a few episodes...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3ndjcTPpPiFCJ3peVlf1JjX5B4e.jpg", url:"https://themoviedb.org/person/3911"}}, {tmdbId:"77073", properties:{bornIn:"Laurel, Mississippi, USA", imdbId:"0004726", born:date('1979-05-04'), name:"Lance Bass", bio:"James Lance Bass is an American singer, dancer, actor, film and television producer, and author.  He grew up in Mississippi and rose to fame as the bass singer for the American pop boy band NSYNC.  NSYNC's success led Bass to work in film and television.  He starred in the 2001 film On the Line, which his company, Bacon & Eggs, also produced...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sxwb6xvaZu1MRztxLc2oiITVgJj.jpg", url:"https://themoviedb.org/person/77073"}}, {tmdbId:"54651", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0004909", born:date('1977-01-28'), name:"Joey Fatone", bio:"Joseph Anthony Fatone Jr.  is an American singer, dancer, actor, and television personality.  He is best known as a member of the boyband NSYNC, in which he sang baritone.  In 2007, he came in second place on the ABC reality show Dancing with the Stars. \n\nFrom Wikipedia, the free encyclopedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1VZTrzdu5xczHV6H0PuI5slyYXE.jpg", url:"https://themoviedb.org/person/54651"}}, {tmdbId:"60847", properties:{bornIn:"Chicago - Illinois - USA", imdbId:"1240342", born:date('1976-02-06'), name:"GQ", url:"https://themoviedb.org/person/60847"}}, {tmdbId:"100", properties:{bornIn:"London, England, UK", imdbId:"0005454", born:date('1975-09-01'), name:"Scott Speedman", bio:"Scott Speedman (born September 1, 1975) is a British-born Canadian film and television actor.  He is best known for playing Ben Covington in the coming-of-age television drama Felicity and Lycan-Vampire hybrid Michael Corvin in the gothic horror/action Underworld films. \n\nDescription above from the Wikipedia article Scott Speedman, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tGgD96WOhmuQU4e6ZTU5IEx4W9E.jpg", url:"https://themoviedb.org/person/100"}}, {tmdbId:"71857", properties:{imdbId:"0609137", born:date('1964-12-10'), name:"Mark Moseley", url:"https://themoviedb.org/person/71857"}}, {tmdbId:"107358", properties:{imdbId:"0654156", name:"Harriet Owen", url:"https://themoviedb.org/person/107358"}}, {tmdbId:"131867", properties:{bornIn:"Montevideo, Uruguay", imdbId:"0376655", born:date('1976-01-03'), name:"Daniel Hendler", bio:"Daniel Hendler (born 3 January 1976) is a Uruguayan film, television, and theatre actor who works mainly in the cinema of Argentina, where he lives.  He is known for his starring roles in films such as Bottom of the Sea, Family Law, The Paranoids, Phase 7 and Lost Embrace.  Working on both sides of the Río de la Plata, Hendler achieved international recognition due to his awards as an actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8Q36TGfbnm4CjuKVWz1XGmTiZtk.jpg", url:"https://themoviedb.org/person/131867"}}] AS row
