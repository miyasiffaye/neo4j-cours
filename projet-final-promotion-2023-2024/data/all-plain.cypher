UNWIND [{tmdbId:"67209", properties:{bornIn:"Sarajevo, Bosnia and Hercegovina", imdbId:"0699306", born:date('1968-04-27'), name:"Faruk Pruti", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uSV0IzuMfvLTSSZt2i30IbzdiHv.jpg", url:"https://themoviedb.org/person/67209"}}, {tmdbId:"1803534", properties:{name:"Tony Peters", url:"https://themoviedb.org/person/1803534"}}, {tmdbId:"998027", properties:{imdbId:"0420448", name:"Dado Jehan", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ezU5heerTe7DoJXvsnnHeFm2OLE.jpg", url:"https://themoviedb.org/person/998027"}}, {tmdbId:"16856", properties:{bornIn:"The Bronx, New York, USA", imdbId:"0532683", born:date('1972-01-22'), name:"Gabriel Macht", bio:"Gabriel Macht is an American actor.  He was born in the Bronx, New York, to Suzanne, a museum curator and archivist, and actor Stephen Macht.  Gabriel has three siblings, and moved with his parents to California when he was young. \n\nGabriel had his first success on screen when he was 8-years-old.  He was nominated for a Best Young Motion Picture Actor Award for his performance in the movie Why Would I Lie? (1980)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lacMH4Ju1x9AsKXm7mDkklSsPyV.jpg", url:"https://themoviedb.org/person/16856"}}, {tmdbId:"53572", properties:{bornIn:"The Bronx, New York, USA", imdbId:"0925916", born:date('1971-08-01'), name:"Charles Malik Whitfield", bio:"Charles Malik Whitfield is an American actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/94C1eqU1IGj8IkWZNpRiimz77eW.jpg", url:"https://themoviedb.org/person/53572"}}, {tmdbId:"73946", properties:{bornIn:"London, England", imdbId:"0714919", born:date('1962-08-31'), name:"Nick Reding", bio:"From Wikipedia, the free encyclopedia. \n\nNick Reding (born 31 August 1962 in London, England) is a British actor.  During a career of more than two decades, he is probably best known for playing PC Pete Ramsey in The Bill and DI Michael Conner in Silent Witness...", url:"https://themoviedb.org/person/73946"}}, {tmdbId:"26707", properties:{bornIn:"Royal Leamington Spa, Warwickshire, England", imdbId:"0050437", born:date('1946-04-11'), name:"Nicholas Ball", bio:"From Wikipedia, the free encyclopedia. \n\nNicholas Ball (born 11 April 1946) is an English actor.  He is best known for playing the title role of James Hazell in the television series Hazell. \n\nHe recently portrayed the violent gangster Terry Bates in EastEnders between 2007 and 2009.  He played Garry Ryan in series five of Footballers' Wives and both series of its spin-off programme Footballers' Wives: Extra Time...", url:"https://themoviedb.org/person/26707"}}, {tmdbId:"32808", properties:{bornIn:"Glasgow, Scotland", imdbId:"0607916", born:date('1945-03-24'), name:"Alexander Morton", bio:"From Wikipedia, the free encyclopedia. \n\nAlexander \"Sandy\" Morton (born 24 March 1945 in Glasgow) is a Scottish actor. \n\nDescription above from the Wikipedia article Alexander Morton, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/32808"}}, {tmdbId:"77156", properties:{bornIn:"Turners Station, Baltimore County, Maryland, United States", imdbId:"0165159", born:date('1960-09-17'), name:"Kevin Clash", bio:"​From Wikipedia, the free encyclopedia.   \n\nKevin Jeffrey Clash (born September 17, 1960) is an American voice actor and puppeteer whose characters include Elmo, Baby Sinclair, Clifford, Splinter and Hoots the Owl.  He currently serves as Sesame Street Muppet Captain and co-executive producer. \n\nIn the fall of 2006, Clash released an autobiography titled My Life as a Furry Red Monster: What Being Elmo Has Taught Me About Life, Love and Laughing Out Loud...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yZ5EdQQvjifJ0hLh8CU7Ug7kz1e.jpg", url:"https://themoviedb.org/person/77156"}}, {tmdbId:"120608", properties:{bornIn:"New York City, New York, USA", imdbId:"0544448", born:date('1950-06-12'), name:"Sonia Manzano", bio:"Sonia Manzano is an actress and writer, known for Sesame Street (1969), Follow That Bird (1985) and Firepower (1979).  She has been married to Richard Reagan since 1986.  They have one child...", url:"https://themoviedb.org/person/120608"}}, {tmdbId:"16218", properties:{bornIn:"Jamestown, New York, USA", imdbId:"0027223", born:date('1961-08-21'), name:"Mitchell Anderson", bio:"Mitchell Ogren Anderson is an American character actor and chef.  Anderson was born in Jamestown, New York, to a retail store owner mother and a businessman father.  He attended Jamestown High School and Williams College before going on to attend Juilliard School...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qCcuJHGk1tseCJqGMXImoiom3Pr.jpg", url:"https://themoviedb.org/person/16218"}}, {tmdbId:"233191", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0141333", born:date('1958-11-19'), name:"Terrence 'T.C.' Carson", bio:"Terrence 'T. C. ' Carson, is an American singer and stage, film, and television actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3cKzbe7UY61ELyQSEWCHWzDSnNG.jpg", url:"https://themoviedb.org/person/233191"}}, {tmdbId:"61696", properties:{imdbId:"0559069", born:date('1971-09-12'), name:"Marie Matiko", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/71yvczfGaC6ggiggz9RSS8ePEXk.jpg", url:"https://themoviedb.org/person/61696"}}, {tmdbId:"140", properties:{bornIn:"Queens, New York, USA", imdbId:"0005154", born:date('1968-12-02'), name:"Lucy Liu", bio:"Lucy Alexis Liu (born Lucy Liu; December 2, 1968) is an American actress, voice actress, director, producer, singer and artist.  She became known for playing the role of the vicious and ill-mannered Ling Woo in the television series Ally McBeal (1998–2002), for which she was nominated for a Primetime Emmy Award for Outstanding Supporting Actress in a Comedy Series and a Screen Actors Guild Award for Outstanding Performance by a Female Actor in a Comedy Series...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9nbtjqsx3De7hO2XDtrBQ7M9VCH.jpg", url:"https://themoviedb.org/person/140"}}, {tmdbId:"5376", properties:{bornIn:"Seattle, Washington, USA", imdbId:"0005443", born:date('1951-09-13'), name:"Jean Smart", bio:"Jean Smart is an American stage, film and television actress, best known for her comedic roles on television, especially for playing Charlene Frazier Stillfield on the CBS sitcom Designing Women.  She also portrayed Martha Logan on the television series 24, Regina Newly on the ABC sitcom Samantha Who?, and Dr.  Melanie Bird on Legion...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gOvEAOtrtedfgS7oQvPgHuJV4F8.jpg", url:"https://themoviedb.org/person/5376"}}, {tmdbId:"1141113", properties:{bornIn:"New York City, New York, USA", imdbId:"0634455", born:date('1968-10-05'), name:"Christiane Noll", bio:"Christiane Noll is an American stage and screen actress and singer.  She is a graduate of Carnegie Mellon University, Pittsburgh, Pennsylvania...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/blY4SfRFdf3kb4GJT0MJDQ5wTgx.jpg", url:"https://themoviedb.org/person/1141113"}}, {tmdbId:"139216", properties:{imdbId:"0896517", name:"Martin Vidnovic", url:"https://themoviedb.org/person/139216"}}, {tmdbId:"41819", properties:{bornIn:"Newcastle, New South Wales, Australia", imdbId:"0944077", born:date('1973-02-15'), name:"Sarah Wynter", bio:"Sarah Wynter (born 15 February 1973) is an Australian actress, most widely known for her roles on American television – such as Kate Warner on the television drama 24 and as Beth on Windfall...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o5UVTcGOrORESrMjQhUrdivtrnH.jpg", url:"https://themoviedb.org/person/41819"}}, {tmdbId:"1626487", properties:{imdbId:"0258250", name:"Eloise Eonnet", bio:"Eloise Eonnet is a French/American actress living between Paris and New York.  She earned a BA in Psychology from Barnard College before fully dedicated herself to acting.  Her film credits include Madeline (Dir.  Daisy von Scherler Mayer), Passion of Mind (Dir.  Alain Berliner), and 3 Women (Dir.  Luciano Emmer).  In New York, she gained first recognition on stage with her role in SeaWife (Dir.  Liz Carlson), These Seven Sicknesses (Dir.  Sylvanus Iskander), and Restoration Comedy (Dir...", url:"https://themoviedb.org/person/1626487"}}, {tmdbId:"21058", properties:{bornIn:"Canada ", imdbId:"0719705", born:date('1987-12-02'), name:"Colleen Rennison", bio:"Colleen Rennison standing in at 5' 6\" (1. 68 m) was born on December 2, 1987 (Sagittarius) in Canada as Colleen Patricia Catherine Rennison.  She is an actress, known for Down River (2013), Stargate SG-1 (1997) and Unforgettable (1996)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1tGihxyjS8FD9fSzSFQVAMcaG9a.jpg", url:"https://themoviedb.org/person/21058"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"71725", properties:{imdbId:"0762424", born:date('1986-09-08'), name:"Jake Sandvig", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cV0S8UDBbS9RsraOVUGood1dYvH.jpg", url:"https://themoviedb.org/person/71725"}}, {tmdbId:"43893", properties:{bornIn:"Lexington, Kentucky, U.S.", imdbId:"0004782", born:date('1984-11-16'), name:"Kimberly J. Brown", bio:"From Wikipedia, the free encyclopedia. \n\nKimberly J.  Brown (born Kimberly Jean Brown on November 16, 1984) Is an American actress.  She is known for her role as Marah Lewis #3 on The Guiding Light and for her role as Marnie Piper on the Halloweentown series (1-3 only). \n\nDescription above from the Wikipedia article Kimberly J.  Brown, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vCXAB0fTpYLuHmYRRna34ZYtS2X.jpg", url:"https://themoviedb.org/person/43893"}}, {tmdbId:"15012", properties:{bornIn:"Hollywood, California, USA.", imdbId:"0870007", born:date('1978-07-16'), name:"Katharine Towne", bio:"​From Wikipedia, the free encyclopedia.   \n\nKatharine Payne Towne (born July 17, 1978) is an American actress.  Towne was born in Hollywood, California, the daughter of actress Julie Payne and Robert Towne, an Oscar-winning screenwriter, director, and actor.  Towne's career began with a small role in the 1998 movie Girl.  She then appeared in Go, She's All That, But I'm a Cheerleader and The Bachelor, as well as guest-starring as Sunday on Buffy the Vampire Slayer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bpgrtlfr2oJw07FiuXWPZHzvtxo.jpg", url:"https://themoviedb.org/person/15012"}}, {tmdbId:"502", properties:{bornIn:"Brisbane, Queensland, Australia", imdbId:"0001584", born:date('1967-12-16'), name:"Miranda Otto", bio:"Miranda Otto  (born 16 December 1967) is an Australian actress.  The daughter of actors Lindsay and Barry Otto and the sister of actress Gracie Otto, she began acting at age eighteen, and has performed in a variety of independent and major studio films.  Her first major film appearance was in the 1986 film Emma's War, in which she played a teenager who moves to Australia's bush country during World War II...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/szME1IBVTLgiKrO5D5wvOGnvUDW.jpg", url:"https://themoviedb.org/person/502"}}, {tmdbId:"1108333", properties:{imdbId:"0852328", name:"Elayn J. Taylor", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c7oNxHFSy4jKA7CBCV7XqR9dlyn.jpg", url:"https://themoviedb.org/person/1108333"}}, {tmdbId:"17817", properties:{bornIn:"Tbilisi, USSR", imdbId:"0632457", born:date('1965-11-03'), name:"Merab Ninidze", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jnJ4lQULt6Ga3lXkIqAhMR7xYdE.jpg", url:"https://themoviedb.org/person/17817"}}, {tmdbId:"17818", properties:{imdbId:"0648943", born:date('1955-01-01'), name:"Sidede Onyulo", died:date('2008-01-01'), url:"https://themoviedb.org/person/17818"}}, {tmdbId:"4534", properties:{bornIn:"Gdańsk, Poland", imdbId:"0352278", born:date('1940-01-12'), name:"Matthias Habich", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dzrlyzf3yxOTibLLBEbawytMDKs.jpg", url:"https://themoviedb.org/person/4534"}}, {tmdbId:"1218094", properties:{imdbId:"0690975", name:"Bray Poor", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mjUS21OqZUqOc7ob9pP9uEGWNmg.jpg", url:"https://themoviedb.org/person/1218094"}}, {tmdbId:"22058", properties:{imdbId:"0236339", name:"Denise Doyle", url:"https://themoviedb.org/person/22058"}}, {tmdbId:"11892", properties:{imdbId:"0584052", name:"Paul Sanchez", url:"https://themoviedb.org/person/11892"}}, {tmdbId:"55433", properties:{imdbId:"0925096", born:date('1965-05-13'), name:"Lari White", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lIag4eML9njr1I9j8TlAKBk50gc.jpg", url:"https://themoviedb.org/person/55433"}}, {tmdbId:"55434", properties:{imdbId:"0162904", name:"Leonid Citer", url:"https://themoviedb.org/person/55434"}}, {tmdbId:"55435", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0111948", born:date('1974-01-09'), name:"David Allen Brooks", url:"https://themoviedb.org/person/55435"}}, {tmdbId:"1245", properties:{bornIn:"New York City, New York, USA", imdbId:"0424060", born:date('1984-11-22'), name:"Scarlett Johansson", bio:"Scarlett Johansson, born November 22, 1984, is an American actress, model and singer.  She made her film debut in North (1994) and was later nominated for the Independent Spirit Award for Best Female Lead for her performance in Manny & Lo (1996), garnering further acclaim and prominence with roles in The Horse Whisperer (1998) and Ghost World (2001)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6NsMbJXRlDZuDzatN2akFdGuTvx.jpg", url:"https://themoviedb.org/person/1245"}}, {tmdbId:"33349", properties:{bornIn:"New York City", imdbId:"0553796", born:date('1975-12-02'), name:"Derick Martini", bio:"​From Wikipedia, the free encyclopedia.   \n\nDerick Patrick Martini (born December 2, 1975) is an American screenwriter and film director. \n\nDescription above from the Wikipedia article Derick Martini, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/33349"}}, {tmdbId:"181851", properties:{imdbId:"0007115", born:date('1974-01-01'), name:"Amy Hathaway", url:"https://themoviedb.org/person/181851"}}, {tmdbId:"204411", properties:{imdbId:"0553855", name:"Steven Martini", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/abNHa9hAM8IJafgS1dE19GIbHQs.jpg", url:"https://themoviedb.org/person/204411"}}, {tmdbId:"11263", properties:{bornIn:"Keminmaa, Finland", imdbId:"0291918", born:date('1971-08-14'), name:"Peter Franzén", bio:"Peter Vilhelm Franzén (born 14 August 1971) is a Finnish actor, author, screenwriter, and director. \n\nAs an actor, Franzén has appeared in over 50 films and TV series.  For his role in Dog Nail Clipper, Franzén was awarded a Jussi Award for Best Actor as well as earning praise from film critic Jay Weissberg from Variety magazine who called the actor \"one of the most talented and versatile thesps in Finland\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oyOHvNdJcOTQGZuAimene2Wlghw.jpg", url:"https://themoviedb.org/person/11263"}}, {tmdbId:"85386", properties:{bornIn:"Danderyd, Stockholms län, Sweden", imdbId:"0084950", born:date('1973-02-07'), name:"Irina Björklund", bio:"​From Wikipedia, the free encyclopedia\n\nIrina Björklund (born 7 February 1973) is a Finnish actress. \n\nBjörklund was born in Danderyd, Stockholm County but she quickly moved to Finland with her family. [citation needed] She has acted in movies and in television series.  Some well known movies include Rukajärven tie (int.  Ambush), Levottomat (int.  Restless), Minä ja Morrison (int.  Me and Morrison), and Vieraalla Maalla (int.  Land of Love).  Björklund is married to Finnish actor Peter Franzén...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3kHlo4M9TxGpbMQsM8ST4FjH4sp.jpg", url:"https://themoviedb.org/person/85386"}}] AS row
