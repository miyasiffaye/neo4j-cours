UNWIND [{tmdbId:"552467", properties:{imdbId:"0565731", born:date('1959-08-18'), name:"Michael McCleery", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e75eNLboS4uXJgZnSfYuIWqCA4u.jpg", url:"https://themoviedb.org/person/552467"}}, {tmdbId:"120575", properties:{bornIn:"Denison, Texas, USA", imdbId:"0252032", born:date('1890-10-14'), name:"Dwight D. Eisenhower", bio:"Dwight David Eisenhower (prononcé [ˈaɪzənhaʊər]) (14 octobre 1890 - 28 mars 1969), surnommé « Ike », est le 34e président des États-Unis, durant deux mandats du 20 janvier 1953 au20 janvier 1961.  Durant la Seconde Guerre mondiale, il est General of the Army et commandant en chef des forces alliées en Europe.  Il est membre du parti républicain...", died:date('1969-03-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ouTr8dJZrNkuJUkkqEqR7r6mNSa.jpg", url:"https://themoviedb.org/person/120575"}}, {tmdbId:"35031", properties:{bornIn:"Moline, Illinois, USA", imdbId:"0077607", born:date('1933-11-03'), name:"Ken Berry", bio:"From Wikipedia, the free encyclopedia\n\nKenneth Ronald Berry (November 3, 1933 – December 1, 2018) was an American actor, dancer and singer.  Berry starred on the television series F Troop, The Andy Griffith Show, Mayberry R. F. D.  and Mama's Family.  He also appeared on Broadway in The Billy Barnes Revue, headlined as George M.  Cohan in the musical George M! and provided comic relief for the medical drama Dr.  Kildare...", died:date('2018-12-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qWFdtpuijr0zBu3wlLZcJXZOpo6.jpg", url:"https://themoviedb.org/person/35031"}}, {tmdbId:"39762", properties:{bornIn:"Hollywood, California, U.S.", imdbId:"0694619", born:date('1942-11-02'), name:"Stefanie Powers", bio:"From Wikipedia, the free encyclopedia. \n\nStefanie Powers (born Stefanie Zofya Paul;November 2, 1942) is an American actress best known for her role as Jennifer Hart in the 1980s television series Hart to Hart. \n\nDescription above from the Wikipedia article Stefanie Powers, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oiTlbv7QC5qaF1BYTY6Qaij5rtq.jpg", url:"https://themoviedb.org/person/39762"}}, {tmdbId:"55123", properties:{imdbId:"0758360", name:"Horacio Salinas", url:"https://themoviedb.org/person/55123"}}, {tmdbId:"55124", properties:{imdbId:"0766993", name:"Zamira Saunders", url:"https://themoviedb.org/person/55124"}}, {tmdbId:"55125", properties:{bornIn:"Ciudad de México, México", imdbId:"0273988", born:date('1943-10-08'), name:"Juan Ferrara", url:"https://themoviedb.org/person/55125"}}, {tmdbId:"52611", properties:{bornIn:"Greenwich, Connecticut, USA", imdbId:"0246814", born:date('1943-10-14'), name:"Dyanne Thorne", bio:"Dyanne Thorne is an American actress, nude model for pin-up magazines, and former Las Vegas showgirl.  She is best known for starring in four \"Ilsa\" sexploitation movies that influenced the Nazi exploitation film genre...", died:date('2020-01-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sRb6zLCfYevFDCZlwOLjQWQVmiW.jpg", url:"https://themoviedb.org/person/52611"}}, {tmdbId:"86642", properties:{imdbId:"0461361", name:"Gregory Knoph", url:"https://themoviedb.org/person/86642"}}, {tmdbId:"86643", properties:{bornIn:"Los Angeles County, California, USA", imdbId:"0612611", born:date('1940-11-02'), name:"Tony Mumolo", url:"https://themoviedb.org/person/86643"}}, {tmdbId:"86644", properties:{imdbId:"0555642", name:"Maria Marx", url:"https://themoviedb.org/person/86644"}}, {tmdbId:"70273", properties:{bornIn:"Berlin, Germany", imdbId:"0754165", born:date('1932-06-02'), name:"Bruno S.", died:date('2010-08-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cOMKFMlMta7XpUDFFratXSJflyw.jpg", url:"https://themoviedb.org/person/70273"}}, {tmdbId:"49506", properties:{imdbId:"0480512", born:date('1899-07-04'), name:"Walter Ladengast", died:date('1980-07-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/znnPyPSa4wdreODEdoTUpWmBC1s.jpg", url:"https://themoviedb.org/person/49506"}}, {tmdbId:"26533", properties:{bornIn:"Berlin, Germany", imdbId:"0783848", born:date('1923-03-15'), name:"Willy Semmelrogge", died:date('1984-09-10'), url:"https://themoviedb.org/person/26533"}}, {tmdbId:"26483", properties:{bornIn:"Galveston - Texas - USA", imdbId:"0674781", born:date('1943-09-03'), name:"Valerie Perrine", bio:"After making her debut in the Kurt Vonnegut classic Slaughterhouse Five, she has played with some of the most respected actors of our time; Gene Hackman in Superman, Jack Nicholson and Harvey Keitel in The Border, Robert Mitchum in Agency, Jackie Gleason in Mr.  Billion, Dennis Hopper and Wesley Snipes in Boiling Point, Robert Redford and Jane Fonda in The Electric Horseman, etc.  There have also been numerous MOW's, pilots, and guest appearances on Nash Bridges, The Practice, Homicide, and ER...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dOCVB0kK79ndxIp1ybdArlgka4j.jpg", url:"https://themoviedb.org/person/26483"}}, {tmdbId:"162287", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0591149", born:date('1917-10-15'), name:"Jan Miner", bio:"Jan Miner was an American actress of film, television, radio and stage...", died:date('2004-02-15'), url:"https://themoviedb.org/person/162287"}}, {tmdbId:"164817", properties:{born:date('1936-06-05'), name:"Stanley Beck", url:"https://themoviedb.org/person/164817"}}, {tmdbId:"21523", properties:{bornIn:"Long Beach, Long Island, New York, USA", imdbId:"0491590", born:date('1938-10-30'), name:"Ed Lauter", bio:"An American actor.  He has appeared in numerous movies and was a stand up comic before getting into acting.  Lauter was born in Long Beach, Long Island, New York...", died:date('2013-10-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5q1CNG6M4cKIrFjFmy7typjEPqt.jpg", url:"https://themoviedb.org/person/21523"}}, {tmdbId:"40390", properties:{bornIn:"New York City - New York - USA", imdbId:"0175700", born:date('1925-10-16'), name:"Michael Conrad", bio:"Michael Conrad (October 16, 1925 – November 22, 1983) was an American actor, primarily on television. \n\n Conrad had a long acting career in television from the 1950s to the 1980s.  In 1963 he played Felton Grimes, the title character and murder victim in the Perry Mason episode, \"The Case of the Bigamous Spouse. \" He played far left-wingMichael Stivic's, Uncle Casimir on All in the Family, and gave bigoted Archie Bunker as good as he got...", died:date('1983-11-22'), url:"https://themoviedb.org/person/40390"}}, {tmdbId:"64457", properties:{bornIn:"Alliance, Ohio, U.S.", imdbId:"0455133", born:date('1948-04-30'), name:"Perry King", bio:"Perry King, born Perry Firestone King, made his film debut, aged around 23, in the 1972 film Slaughterhouse-Five.  In 1975, he portrayed Hammond Maxwell in the exploitation film Mandingo.  Since the 1970s, he has appeared in dozens of feature films, television series and television movies.  He auditioned for the role of Han Solo in Star Wars, but the role ultimately went to Harrison Ford.  However, he played the character in the radio adaptations of Star Wars and both its sequels...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lJY4cDzskSL0THZAS6BXqBD814D.jpg", url:"https://themoviedb.org/person/64457"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"31903", properties:{bornIn:"New York City, New York, USA", imdbId:"0001857", born:date('1945-10-30'), name:"Henry Winkler", bio:"Henry Franklin Winkler (born October 30, 1945) is an American actor, director, producer, and author. \n\nWinkler is best known for his role as Fonzie on the 1970s American sitcom Happy Days.  \"The Fonz,\" a leather-clad greaser and auto mechanic, started out as a minor character at the show's beginning but had achieved top billing by the time the show ended...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7YyLHBtoJLSexYJEtrB9DApFTG8.jpg", url:"https://themoviedb.org/person/31903"}}, {tmdbId:"121646", properties:{imdbId:"0532083", born:date('1950-04-04'), name:"Paul Mace", died:date('1983-08-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5OsoWqIL2stNe75syLCxlMybxwh.jpg", url:"https://themoviedb.org/person/121646"}}, {tmdbId:"24682", properties:{bornIn:"Salford, Manchester, England, UK", imdbId:"0694293", born:date('1944-06-01'), name:"Robert Powell", bio:"Robert Powell was born on June 1, 1944 in Salford, Manchester, England.  \n\nIn 1964, he started his acting career while attending Manchester \n\nUniversity.  In 1967, he made his film debut, and later landed his first starring role in The Italian Job (1969).  Some of his well known movies include Franco Ziefirelli's \"Jesus of Nazareth\" (1977), Ken Russell's Tommy (1975) and Mahler (1974), the remake of The Thirty Nine Steps (1978), and the popular TV series \"Doomwatch\"\n\n (1970)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3KikDDNAxq0a8tLbxYD1nvXZhGv.jpg", url:"https://themoviedb.org/person/24682"}}, {tmdbId:"92434", properties:{imdbId:"0354914", born:date('1943-08-04'), name:"Georgina Hale", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/raEd1NnWjYYeWG0LdiWun3QxQ51.jpg", url:"https://themoviedb.org/person/92434"}}, {tmdbId:"24699", properties:{bornIn:"Bow, London, England, UK", imdbId:"0598777", born:date('1927-10-16'), name:"Lee Montague", bio:"From Wikipedia, the free encyclopedia.   Lee Montague (born 16 October 1927 in London) is an English actor noted for his roles on film and television, usually playing tough guys. \n\nFilm credits include: Moulin Rouge, The Camp on Blood Island, The Savage Innocents, Billy Budd, The Secret of Blood Island, Deadlier Than the Male, The Legacy and Brother Sun, Sister Moon...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fIgb4hTX4XAc19kOM92H7Kifopg.jpg", url:"https://themoviedb.org/person/24699"}}, {tmdbId:"2274", properties:{bornIn:"London, England, UK", imdbId:"0439507", born:date('1925-06-23'), name:"Miriam Karlin", bio:"From Wikipedia, the free encyclopedia. \n\nMiriam Karlin, OBE (23 June 1925 – 3 June 2011) was a British actress. \n\nDescription above from the Wikipedia article Miriam Karlin, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2011-06-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uCQHjnB0FrAbTAUat5RRIQDu4kB.jpg", url:"https://themoviedb.org/person/2274"}}, {tmdbId:"10342", properties:{bornIn:"Luleå, Norrbottens län, Sweden", imdbId:"0000726", born:date('1945-02-12'), name:"Maud Adams", bio:"Maud Solveig Christina Wikström (born 12 February 1945), known professionally as Maud Adams, is a Swedish actress, known for her roles as two different Bond girls: in The Man with the Golden Gun (1974), and as the eponymous character in Octopussy (1983) as well as making a brief uncredited appearance in A View to a Kill (1985). \n\nDescription above from the Wikipedia article Maud Adams, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3gOZgy6pmWeu5xKyXYZQQRUqzI6.jpg", url:"https://themoviedb.org/person/10342"}}, {tmdbId:"25333", properties:{bornIn:"Paris, France", imdbId:"0006573", born:date('1930-10-15'), name:"Philippe Leroy", bio:"From Wikipedia, the free encyclopedia. \n\nPhilippe Leroy, full name Philippe Leroy-Beaulieu (born 15 October 1930, Paris, France) is a French film actor.  He has appeared in over 150 films since 1960.  Leroy has been living mostly in Italy since the 1960s and has worked extensively in Italian cinema, as well as in his native country.  He is sometimes credited under his full name. \n\nHis daughter is the actress Philippine Leroy-Beaulieu...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/woG9lyvZSEEF4j5Kl03rSnHTW5R.jpg", url:"https://themoviedb.org/person/25333"}}, {tmdbId:"1374479", properties:{bornIn:"Chicago - Illinois - USA", imdbId:"0741629", born:date('1940-07-30'), name:"Reva Rose", bio:"Reva Rose was born on July 30, 1940...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/r4y0t7TFrUONRV64Lfg9XixNFXR.jpg", url:"https://themoviedb.org/person/1374479"}}, {tmdbId:"33482", properties:{imdbId:"0357090", born:date('1928-12-28'), name:"Bob Holt", died:date('1985-08-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8u2FSZRgWYIfFpAdmEggVq5jevv.jpg", url:"https://themoviedb.org/person/33482"}}, {tmdbId:"25626", properties:{bornIn:"Teaneck, New Jersey, USA", imdbId:"0725894", born:date('1931-12-24'), name:"Robert Ridgely", died:date('1997-02-08'), url:"https://themoviedb.org/person/25626"}}, {tmdbId:"81734", properties:{bornIn:"Providence, Rhode Island, USA", imdbId:"0569350", born:date('1936-07-06'), name:"Walter McGinn", died:date('1977-03-31'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/k13nfXfMPCBhiGOCg0imlrSjMLs.jpg", url:"https://themoviedb.org/person/81734"}}, {tmdbId:"69055", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0363888", born:date('1949-10-10'), name:"Jessica Harper", bio:"Jessica Harper (born October 10, 1949) is an American actress, producer, and singer.  Harper began her feature film career with a starring role in Brian De Palma's Phantom of the Paradise (1974), My Favorite Year (1982), as well as a role in Inserts (1975). \n\nDescription above from the Wikipedia article Jessica Harper, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dM4chL4BBo53cbI70Ptwk2izhr1.jpg", url:"https://themoviedb.org/person/69055"}}, {tmdbId:"26283", properties:{bornIn:"New York City, New York, USA", imdbId:"0334057", born:date('1949-11-27'), name:"Gerrit Graham", bio:"Gerrit Graham (born November 27, 1949) is an American actor and songwriter.  He's appeared in such films as Used Cars, TerrorVision, National Lampoon's Class Reunion, and Greetings, where he worked with Brian DePalma for the first time.  He would again work with DePalma on Hi, Mom and Home Movies, as well as The Phantom of the Paradise, where he played Beef, the Alice Cooper-inspired rock star...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8fCrbCTcRwhtFjlgfHyD6ddUzwp.jpg", url:"https://themoviedb.org/person/26283"}}, {tmdbId:"18915", properties:{bornIn:"Budapest, Hungary", imdbId:"0770711", born:date('1944-07-17'), name:"Catherine Schell", bio:"From Wikipedia, the free encyclopedia\n\n​\n\nKatherina Freiin Schell von Bauschlott (born 17 July 1944, in Budapest) is an Hungarian-born actress best known for her work in England with the BBC. \n\nSchell rose to fame in various British film and television productions in the 1960s and 1970s.  She acted under the name Catherine von Schell early in her career, but is better known by the name Catherine Schell...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qcAxL1wpDEyzG5Eqre8jBgERuoV.jpg", url:"https://themoviedb.org/person/18915"}}, {tmdbId:"7676", properties:{bornIn:"Orange - Connecticut - USA", imdbId:"0040472", born:date('1947-07-30'), name:"William Atherton", bio:"From Wikipedia, the free encyclopedia\n\nWilliam Atherton (born July 30, 1947), born William Atherton Knight II, is an American film, stage and television actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d4ArFBoywyW3yZ3RuD1KAC0fXiA.jpg", url:"https://themoviedb.org/person/7676"}}, {tmdbId:"1210", properties:{bornIn:"New York City, New York, USA", imdbId:"0001185", born:date('1936-12-22'), name:"Hector Elizondo", bio:"​From Wikipedia, the free encyclopedia\n\nHéctor Elizondo (born December 22, 1936) is an American actor.  Elizondo excelled in sports and later contemplated becoming an educator.  Elizondo's first major role was that of \"God\" in a play for which he won an Obie Award.  Since then Elizondo has participated in over eighty films and has made numerous television appearances, including his Emmy Award-winning role on the series Chicago Hope...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7Mfx9xeOFKXtzVpAc1488LiHs0b.jpg", url:"https://themoviedb.org/person/1210"}}, {tmdbId:"27798", properties:{bornIn:"Erie, Pennsylvania, USA", imdbId:"0122782", born:date('1949-07-05'), name:"Marilyn Burns", died:date('2014-08-05'), url:"https://themoviedb.org/person/27798"}}, {tmdbId:"122454", properties:{bornIn:"Boston - Massachusetts - USA", imdbId:"0200758", born:date('1942-07-23'), name:"Allen Danziger", bio:"Allen Danziger (born July 23, 1942) is an American actor, perhaps best known for his role as Jerry in The Texas Chain Saw Massacre (1974).  Danziger was born in Boston, Massachusetts.  He graduated from City College of New York with a Bachelor of Science inPsychology in 1964, and in 1970, he graduated from the University of Texas at Austin with a degree in Drama.  In 1969, he made his movie debut in Eggshells...", url:"https://themoviedb.org/person/122454"}}, {tmdbId:"122455", properties:{bornIn:"Austin, Texas, USA", imdbId:"0663935", born:date('1946-11-22'), name:"Paul A. Partain", bio:"Paul Alan Partain (November 22, 1946 – January 28, 2005) billed professionally as Paul A.  Partain was an American actor, perhaps best known for his role in the original The Texas Chain Saw Massacre (1974) as the handicapped wheel-chair bound Franklin Hardesty...", died:date('2005-01-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/spWMVgwGFPj2hUgfnIQuFIgPN6z.jpg", url:"https://themoviedb.org/person/122455"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"122456", properties:{bornIn:"San Antonio - Texas - USA", imdbId:"0883211", born:date('1950-11-30'), name:"William Vail", bio:"Wlliam Vail (born November 30, 1950) is an American set decorator and actorbest known for his role as \"Kirk\" in the 1974 American horror classic The Texas Chain Saw Massacre. \n\nVail was born in San Antonio, Texas.  He began his film career in 1974, when he played the character of \"Kirk\" in the Texas Chainsaw Massacre.  He then starred in three more films titled Poltergeist (1982), Mausoleum (1983), and Glitch! (1988)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hdmd9uNUEOtYwQmIW4KlH5SeKaT.jpg", url:"https://themoviedb.org/person/122456"}}, {tmdbId:"28906", properties:{bornIn:"Beverly Hills, California, USA", imdbId:"0000328", born:date('1934-03-31'), name:"Richard Chamberlain", bio:"​From Wikipedia, the free encyclopedia.   \n\nGeorge Richard Chamberlain (born March 31, 1934) is an American actor of stage and screen who became a teen idol in the title role of the television show Dr.  Kildare (1961–1966).  He subsequently appeared in several TV mini-series, such as Shōgun (1980) and The Thorn Birds (1983) and was the first to play Jason Bourne in the 1988 made for TV movie \"The Bourne Identity\".  Chamberlain has also performed classical stage roles and worked in musical theatre...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jZBuw26HNPsoBLu7ywQLbHFvNpS.jpg", url:"https://themoviedb.org/person/28906"}}, {tmdbId:"77707", properties:{bornIn:"Gothenburg, Västra Götalands län, Sweden", imdbId:"0511350", born:date('1950-12-06'), name:"Christina Lindberg", bio:"Britt Christina Marinette Lindberg (born 6 December 1950, in Gothenburg, Sweden) is a Swedish journalist known internationally for her work as an actress and glamour model in the late 1960s and early 1970s. \n\nDuring her high school years (she was around 18 years old) she started posing nude for men's magazines, such as FIB aktuellt and Lektyr, after having garnered some attention posing in bathing suits for newspapers.  She later appeared in men's magazines such as Penthouse (UK), Playboy (U. S...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/htubio6z5xLupcUnQngCOAtlC5k.jpg", url:"https://themoviedb.org/person/77707"}}, {tmdbId:"77708", properties:{bornIn:"Stockholm, Stockholms län, Sweden", imdbId:"0394077", born:date('1934-11-11'), name:"Heinz Hopf", bio:"Heinz Willy Gustav Hopf was a Swedish actor on stage and in films.  He appeared in more than 80 feature films and tv-productions between 1956-1994...", died:date('2001-01-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2ICYKAo74bmPedOoPN1UFJ5RTid.jpg", url:"https://themoviedb.org/person/77708"}}, {tmdbId:"133716", properties:{imdbId:"0866537", name:"Despina Tomazani", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/geQzhlLZq3lN5WWyLethpApZTeX.jpg", url:"https://themoviedb.org/person/133716"}}, {tmdbId:"24369", properties:{bornIn:"Norberg, Västmanlands län, Sweden", imdbId:"0037036", born:date('1920-11-07'), name:"Per-Axel Arosenius", bio:"From Wikipedia, the free encyclopedia\n\nPer Axel Daniel Rank Arosenius (November 7, 1920 – March 21, 1981) was a Swedish actor of mostly supporting parts.  His most prominent film role was that of Soviet defector Boris Kusenov in Alfred Hitchcock's 1969 film Topaz. \n\nAfter a dispute with the Swedish taxation authorities on March 21 1981, Arosenius protested by setting himself on fire outside their office in Nacka.  He died in the ambulance on the way to the hospital.  He was 60 years old...", died:date('1981-03-21'), url:"https://themoviedb.org/person/24369"}}, {tmdbId:"18071", properties:{bornIn:"San Diego, California, U.S.", imdbId:"0507212", born:date('1935-07-31'), name:"Geoffrey Lewis", bio:"​From Wikipedia, the free encyclopedia\n\nGeoffrey Lewis (born July 31, 1935) is an American character actor. \n\nHis filmography includes television shows such as Law &amp; Order: Criminal Intent and My Name is Earl, as well as films such as Down in the Valley, alongside Edward Norton, The Butcher, alongside Eric Roberts, Maverick, alongside Mel Gibson, and When Every Day Was the Fourth of July alongside Dean Jones...", died:date('2015-04-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2os1QyqVnBRwHrMLsoMRnsZk0kw.jpg", url:"https://themoviedb.org/person/18071"}}, {tmdbId:"34581", properties:{bornIn:"Saint-Brieuc, Côtes-d'Armor, France", imdbId:"0223033", born:date('1947-01-26'), name:"Patrick Dewaere", bio:"Patrick Bourdeaux, dit Patrick Dewaere, est un acteur français né le 26 janvier 1947 à Saint-Brieuc (Côtes-d'Armor) et mort le 16 juillet 1982 à Paris 14e.   Considéré comme un des acteurs les plus brillants de sa génération, Patrick Dewaere a incarné la « fureur de vivre » à la française et demeure un modèle pour les générations de jeunes comédiens qui lui ont succédé...", died:date('1982-07-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hxFTdyhyn0zfrPpX3H7tZ75BrhC.jpg", url:"https://themoviedb.org/person/34581"}}, {tmdbId:"4274", properties:{bornIn:"Paris, France", imdbId:"0591877", born:date('1950-02-22'), name:"Miou-Miou", bio:"Miou-Miou (born 22 February 1950) is a French actress.  In her career she has worked with a number of international directors, including Michel Gondry, Bertrand Blier, Yves Boisset, Claude Berri, Jacques Deray, Michel Deville, Diane Kurys, Radu Mihăileanu, Patrice Leconte, Joseph Losey and Louis Malle...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kjQD9nNjcakYxOmXq1IG66y1RtU.jpg", url:"https://themoviedb.org/person/4274"}}, {tmdbId:"565253", properties:{imdbId:"0924260", name:"Dori Whitaker", url:"https://themoviedb.org/person/565253"}}, {tmdbId:"77548", properties:{bornIn:"New York City, New York, USA", imdbId:"0934593", born:date('1922-12-21'), name:"Paul Winchell", bio:"Born Paul Wilchinsky on December 21, 1922, the son of Sol and Clara Wilchinsky, Paul Winchell grew up to be the most beloved ventriloquist of American children.  Ironically, as famous as Paul was, his dummy, Jerry Mahoney, was probably more famous.  Not since Edgar Bergen and Charlie McCarthy in the previous two decades had a ventriloquist and his dummy known equal celebrity...", died:date('2005-06-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aZjzqTlzhBpcXogubUP8wcPE4Da.jpg", url:"https://themoviedb.org/person/77548"}}, {tmdbId:"146711", properties:{bornIn:"Arkansas, USA", imdbId:"0746767", born:date('1904-08-12'), name:"Lady Rowlands", died:date('1999-05-28'), url:"https://themoviedb.org/person/146711"}}, {tmdbId:"29802", properties:{bornIn:"London, England, UK", imdbId:"0001204", born:date('1934-07-08'), name:"Marty Feldman", bio:"From Wikipedia, the free encyclopedia\n\nMartin Alan Feldman (8 July 1934 – 2 December 1982) was a British actor, comedian and comedy writer, known for his prominent eyes; he suffered from thyroid disease and developed Graves' ophthalmopathy, causing his eyes to protrude and become misaligned.  He recognized his appearance as a factor in his career success...", died:date('1982-12-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bNUinz6ZGp4F2ZVyuhrfD7ricXT.jpg", url:"https://themoviedb.org/person/29802"}}, {tmdbId:"55512", properties:{bornIn:"Turinsk, USSR", imdbId:"0855486", born:date('1942-08-25'), name:"Margarita Terekhova", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d7Ssc0XPFlv0XZMhOHcwOoACZBQ.jpg", url:"https://themoviedb.org/person/55512"}}, {tmdbId:"1090481", properties:{bornIn:"Bolshoy Dzhezkazgan, USSR [now Zhezkazgan, Kazakhstan]", imdbId:"0946160", born:date('1944-02-23'), name:"Oleg Yankovskiy", bio:"From Wikipedia, the free encyclopedia\n\nOleg Ivanovich Yankovsky (Russian: Оле́г Ива́нович Янко́вский; February 23, 1944 – May 20, 2009) was a Soviet/Russian actor who has excelled in psychologically sophisticated roles of modern intellectuals.  In 1991, he became, together with Alla Pugacheva, the last person to be named a People's Artist of the USSR...", died:date('2009-05-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4Mw5mEOQKSkpV0zKEGZcfHOYSGL.jpg", url:"https://themoviedb.org/person/1090481"}}, {tmdbId:"55516", properties:{bornIn:"Saratov, RSFSR, USSR [now Russia]", born:date('1968-10-10'), name:"Filipp Yankovskiy", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5f8oEkxmnoz4G3FiidBiV2Sax61.jpg", url:"https://themoviedb.org/person/55516"}}, {tmdbId:"55514", properties:{imdbId:"0200246", born:date('1962-02-16'), name:"Ignat Daniltsev", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cf63G5PBEcqVWcHcgkWoTFZ0PU0.jpg", url:"https://themoviedb.org/person/55514"}}, {tmdbId:"55643", properties:{bornIn:"Sutton Abinger, Surrey, UK", imdbId:"0768795", born:date('1932-06-22'), name:"Prunella Scales", bio:"From Wikipedia, the free encyclopedia. \n\nPrunella Scales (born Prunella Margaret Rumney Illingworth) CBE (born 22 June 1932) is an English actress, known for her role as Basil Fawlty's long-suffering wife in the British comedy Fawlty Towers and her award-nominated role as Queen Elizabeth II in the British film A Question of Attribution. \n\nDescription above from the Wikipedia article Prunella Scales, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sni2JyaL9z8uId9lq2RYB7lqWsX.jpg", url:"https://themoviedb.org/person/55643"}}, {tmdbId:"149979", properties:{bornIn:" Indianapolis, Indiana, USA", imdbId:"0095665", born:date('1940-12-02'), name:"Connie Booth", bio:"From Wikipedia, the free encyclopedia. \n\nConstance \"Connie\" Booth (born 2 December 1940) is an American writer and actress, known for appearances on British television and particularly for her portrayal of Polly Sherman in the popular 1970s television show Fawlty Towers, which she co-wrote with her then husband John Cleese. \n\nDescription above from the Wikipedia article Connie Booth, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wbqzdZDC0WjS1nYrfJxxKmB9Fzn.jpg", url:"https://themoviedb.org/person/149979"}}, {tmdbId:"83414", properties:{bornIn:"Willoughby, Ohio, USA", imdbId:"0176792", born:date('1933-12-15'), name:"Tim Conway", bio:"From Wikipedia, the free encyclopedia. \n\nThomas Daniel \"Tim\" Conway (December 15, 1933 - May 14, 2019) was an American comedian and actor, primarily known for his roles in sitcoms, films and television.  Conway is best-known for his role as the inept second-in-command officer, Ensign Charles Parker, to Lt.  Commander Quinton McHale (played by Ernest Borgnine), in the popular 1960s WWII sitcom McHale's Navy, and for co-starring alongside Carol Burnett on The Carol Burnett Show...", died:date('2019-05-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ejIaBqJt4shL7n7LfphvKWAIgWl.jpg", url:"https://themoviedb.org/person/83414"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"31071", properties:{bornIn:"New York City, New York, USA", imdbId:"0001943", born:date('1947-02-15'), name:"Marisa Berenson", bio:"From Wikipedia, the free encyclopedia. \n\nVittoria Marisa Schiaparelli Berenson (born February 15, 1947, New York City) is an American actress and model. \n\nDescription above from the Wikipedia article Marisa Berenson, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qF2AIKo7cYrIFXPwW7qlFEtOeE2.jpg", url:"https://themoviedb.org/person/31071"}}, {tmdbId:"136835", properties:{born:date('1959-05-25'), name:"Cathryn Harrison", bio:"​Cathryn Mary Lee Harrison (born 29 May 1959) is an English actress.  Cathryn was baptised on 27 September 1959 at St. John's Church,Hampstead,London,England.  She is the daughter of the actor and singer Noel Harrison and Sara Lee Eberts and also the grand daughter of legendary actor Sir Rex Harrison. Her brother Simon Harrison is also an actor as well as her sister Harriet Harrison...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9nLMKHzlRAVYo9nrysoNPY8iNIm.jpg", url:"https://themoviedb.org/person/136835"}}, {tmdbId:"40251", properties:{bornIn:"München, Germany", imdbId:"0317340", born:date('1898-03-06'), name:"Therese Giehse", bio:"Therese Giehse (6 March 1898 – 3 March 1975), born Therese Gift, was a distinguished German actress.  Born in Munich to German-Jewish parents, she first appeared on the stage in 1920.  She became a major star on stage, in films, and in political cabaret.  In the late 1920s through 1933, she was a leading actress at the famous Munich Kammerspiele...", died:date('1975-03-03'), url:"https://themoviedb.org/person/40251"}}, {tmdbId:"25129", properties:{bornIn:"Flat Creek, Missouri, United States", imdbId:"0000467", born:date('1949-12-15'), name:"Don Johnson", bio:"Donnie Wayne Johnson (born December 15, 1949) is an American actor, producer, director, singer, and songwriter.  He played the role of James \"Sonny\" Crockett in the 1980s television series Miami Vice, winning a Golden Globe for his work in the role.  He also had the eponymous lead role in the 1990s cop series Nash Bridges.   Description above from the Wikipedia article Don Johnson, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6s6oav541p7xspCG6PvXut7knkP.jpg", url:"https://themoviedb.org/person/25129"}}, {tmdbId:"40000", properties:{imdbId:"0072971", born:date('1948-02-03'), name:"Susanne Benton", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d6yKpCepyxOOKl8JyowdCJLO2eS.jpg", url:"https://themoviedb.org/person/40000"}}, {tmdbId:"1221906", properties:{bornIn:"Minneapolis, Minnesota", imdbId:"0028739", born:date('1911-07-06'), name:"Laverne Andrews", bio:"Laverne Andrews and her sisters, Patty and Maxene, were one of the most  successful women's singing groups, with 19 gold records and sales of  nearly 100 million copies.  The sisters began performing in the early  1930s when the Depression wiped out their father's business.  In 1937,  the sisters scored their first big hit with 'Bei Mir Bist Du Schoen. ' In  addition to 'Boogie Woogie Bugle Boy', their best-known songs included  'Don't Sit Under the Apple Tree' and 'Rum and Coca Cola'...", died:date('1967-05-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zLIHdZO1wvLat7plMjLEy8TAO92.jpg", url:"https://themoviedb.org/person/1221906"}}, {tmdbId:"1221905", properties:{bornIn:"Minneapolis, Minnesota", imdbId:"0028782", born:date('1916-07-03'), name:"Maxene Andrews", bio:"Maxene Andrews and her sisters, Patty and Laverne, were one of the most  successful women's singing groups, with 19 gold records and sales of  nearly 100 million copies.  The sisters began performing in the early  1930's when the Depression wiped out their father's business.  In 1937,  the trio of sisters scored their first big hit with 'Bei Mir Bist Du  Schoen'.  In addition to 'Boogie Woogie Bugle Boy, ' their best-known  songs included 'Don't Sit Under the Apple Tree' and 'Rum and Coca Cola'...", died:date('1995-10-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ttODwiMMz5UMkG3zM36G9xi4I0S.jpg", url:"https://themoviedb.org/person/1221905"}}, {tmdbId:"1578527", properties:{bornIn:"Mound, Minnestota", imdbId:"0028809", born:date('1918-02-16'), name:"Patty Andrews", bio:"Patty Andrews was born in Mound, Minnesota on 16 February 1918, the daughter of Peter Andreos (changed to 'Andrews' upon arriving in the US) and Olga Sollie.  Her real name was Patricia Marie.  Her father was a Greek Catholic immigrant and her mother a Lutheran from Norway who ran the pure food café, a Greek café in Minneapolis which was located adjacent to the Orpheum Theater.  Her sisters were Lavern Sophie born July 6, 1911, died 1967 (cancer); Maxene Angelyn born Jan...", died:date('2013-01-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/23UXdG3XZtspSo5Q9rEv1hWViG2.jpg", url:"https://themoviedb.org/person/1578527"}}, {tmdbId:"25180", properties:{bornIn:"Paris, France", imdbId:"0487022", born:date('1936-06-18'), name:"Victor Lanoux", bio:"From Wikipedia, the free encyclopedia.   \n\nVictor Lanoux (born 18 June 1936 in Paris) is a French actor. He started out in cabaret, where he collaborated with Pierre Richard.  He made one of his earliest film appearances in The Shameless Old Lady.  He received two César nominations in 1976, for his roles in Cousin, cousine and Adieu poulet.  His best known role outside of Europe is perhaps that of The Thief in the 1985 comedy classic National Lampoon's European Vacation...", died:date('2017-05-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AuEzBr4wR5tZONg3t8z311AN5Wg.jpg", url:"https://themoviedb.org/person/25180"}}, {tmdbId:"3536", properties:{bornIn:"Dalat, French Indochina", imdbId:"0685494", born:date('1944-05-10'), name:"Marie-France Pisier", bio:"Marie-France Pisier (10 May 1944 – 24 April 2011) was a French actress.  She appeared in numerous films of the French New Wave and twice earned the national César Award for Best Supporting Actress. \n\nDescription above from the Wikipedia article  Marie-France Pisier , licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2011-04-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o7Wcns5bkomH7mVDiYhP2hFHwvR.jpg", url:"https://themoviedb.org/person/3536"}}, {tmdbId:"38901", properties:{bornIn:"Paris, France", imdbId:"0545383", born:date('1937-05-22'), name:"Guy Marchand", bio:"​From Wikipedia, the free encyclopedia.   \n\nGuy Marchand (born 22 May 1937) is a French actor and singer. \n\nDescription above from the Wikipedia article  Guy Marchand, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/A0txUn9cpfgLzwiiNentjkHGOw.jpg", url:"https://themoviedb.org/person/38901"}}, {tmdbId:"74351", properties:{imdbId:"0341097", born:date('1950-04-04'), name:"Simone Griffeth", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vRQL76IPzugNGJQ2mc1sTM4CXoc.jpg", url:"https://themoviedb.org/person/74351"}}, {tmdbId:"100552", properties:{bornIn:"Palm Beach, Florida, USA", imdbId:"0001862", born:date('1943-12-08'), name:"Mary Woronov", bio:"Mary Woronov (born December 8, 1943) is an American actress and writer.  She is primarily known for her roles in independent and cult films.  Woronov has appeared in over 80 movies, as well as numerous appearances in mainstream television series, such as Charlie's Angels and Knight Rider...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z2LjTvoUwYOougQCZ5AgrvTq42X.jpg", url:"https://themoviedb.org/person/100552"}}, {tmdbId:"14544", properties:{bornIn:"USA", imdbId:"0020897", name:"Penelope Allen", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e9C2At9GpsvCmYGdMOce7uyNL7T.jpg", url:"https://themoviedb.org/person/14544"}}, {tmdbId:"14545", properties:{imdbId:"0101604", born:date('1923-12-14'), name:"Sully Boyar", died:date('2001-03-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oQAiwLBv3rEg4Y2T8VQGyRIiJcz.jpg", url:"https://themoviedb.org/person/14545"}}, {tmdbId:"14546", properties:{imdbId:"0308242", born:date('1921-06-12'), name:"Beulah Garrick", url:"https://themoviedb.org/person/14546"}}, {tmdbId:"139921", properties:{born:date('1957-01-01'), name:"Chung-Erh Lung", url:"https://themoviedb.org/person/139921"}}, {tmdbId:"131955", properties:{bornIn:"Jiangmen, Guangdong, China", imdbId:"0514905", born:date('1944-01-01'), name:"Chia Yung Liu", bio:"Lau Kar Wing ((simplified Chinese: 刘家荣; traditional Chinese: 劉家榮; pinyin: Liú Jiārong, Liu Jiayung; born 1944) is a Hong Kong martial arts film director, action choreographer and actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8MS3njcVG5LcWWeMUoD9YXWWYJA.jpg", url:"https://themoviedb.org/person/131955"}}, {tmdbId:"53261", properties:{bornIn:"Mineola, New York, USA", imdbId:"0001668", born:date('1964-09-19'), name:"Kim Richards", bio:"Kimberly \"Kim\" Richards (born September 19, 1964) is an American former child actress (Nanny and the Professor) and television personality (The Real Housewives of Beverly Hills). \n\nDescription above from the Wikipedia article Kim Richards, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/93hMMquZy66EReaQ1sxwRPnqfRg.jpg", url:"https://themoviedb.org/person/53261"}}, {tmdbId:"39006", properties:{bornIn:"Bad Segeberg, Germany", imdbId:"0153998", born:date('1943-12-07'), name:"Peter Chatel", died:date('1986-08-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xWlshh3F6fLXqHvgLo863bei8x1.jpg", url:"https://themoviedb.org/person/39006"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"10162", properties:{bornIn:"El Dorado, Kansas, USA", imdbId:"0110917", born:date('1919-11-25'), name:"Steve Brodie", bio:"​From Wikipedia, the free encyclopedia\n\nSteve Brodie (November 21, 1919 — January 9, 1992) was an American movie and television actor. \n\nBorn as John Stevenson in El Dorado, Kansas, he reportedly selected his screen name in tribute to Steve Brodie, who jumped from the Brooklyn Bridge in 1886 and survived. \n\nMost of his acting work was from the mid 1940s to the early 1950s working at MGM, RKO and Republic Pictures appearing mostly in westerns and B-movies...", died:date('1992-01-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6VYbST642hu6GwXvppjcpGBD2p3.jpg", url:"https://themoviedb.org/person/10162"}}, {tmdbId:"109701", properties:{bornIn:"DeKalb, Illinois, USA", imdbId:"0354853", born:date('1922-04-18'), name:"Barbara Hale", bio:"Barbara Hale is an American actress best known for her role as legal secretary Della Street on more than 250 episodes of the long-running Perry Mason television series and later reprising the role in 30 made-for-TV movies. \n\nHale was born in DeKalb, Illinois, to Luther Ezra Hale, a landscape gardener, and his wife, Wilma Colvin.  She is of Scots-Irish ancestry.  Hale graduated from high school in Rockford, Illinois, then attended the Chicago Academy of Fine Arts, planning to become an artist...", died:date('2017-01-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7ORAxB1D30kQesqWHN7RU8zxNMi.jpg", url:"https://themoviedb.org/person/109701"}}, {tmdbId:"32494", properties:{bornIn:"Milwaukee, Wisconsin, USA", imdbId:"0247691", born:date('1930-11-23'), name:"Robert Easton", died:date('2011-12-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tGD5qenqf5u1qrnmNrG8afSZovK.jpg", url:"https://themoviedb.org/person/32494"}}, {tmdbId:"14733", properties:{bornIn:"Melrose, Massachusetts, Stati Uniti", imdbId:"0663562", born:date('1935-03-18'), name:"Leslie Parrish", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/km2KBITjWgTjPS961HWKSe5N0gw.jpg", url:"https://themoviedb.org/person/14733"}}, {tmdbId:"83047", properties:{bornIn:"New York City, New York", imdbId:"0063643", born:date('1917-11-07'), name:"Edith Bouvier Beale", bio:"​From Wikipedia, the free encyclopedia.   \n\nEdith Bouvier Beale (November 7, 1917 – circa January 9, 2002) was an American socialite, fashion model and cabaret performer.  She was a first cousin of Jacqueline Kennedy Onassis and Lee Radziwill.  She is best known as \"Little Edie,\" one of the subjects of the documentary film Grey Gardens by Albert and David Maysles detailing life at the East Hampton home...", died:date('2002-01-14'), url:"https://themoviedb.org/person/83047"}}, {tmdbId:"1178288", properties:{imdbId:"0386343", name:"Brooks Hyers", url:"https://themoviedb.org/person/1178288"}}, {tmdbId:"1178289", properties:{imdbId:"0668866", name:"Norman Vincent Peale", url:"https://themoviedb.org/person/1178289"}}, {tmdbId:"10401", properties:{bornIn:"Philadelphia, Pennsylvania, USA", imdbId:"0001100", born:date('1943-02-03'), name:"Blythe Danner", bio:"Blythe Katherine Danner (born February 3, 1943) is an American actress.  She is the mother of actress Gwyneth Paltrow and director Jake Paltrow. \n\nDescription above from the Wikipedia article Blythe Danner , licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3Dx9iCenZvT0wNRgMN4huVSbfxC.jpg", url:"https://themoviedb.org/person/10401"}}, {tmdbId:"10556", properties:{bornIn:"Cleveland, Ohio, USA", imdbId:"0001406", born:date('1952-06-18'), name:"Carol Kane", bio:"Carolyn Laurie Kane (born June 18, 1952) is an American actress and comedian. \n\nShe became known in the 1970s in films such as Hester Street (for which she received an Oscar nomination) and Annie Hall.  She appeared on the television series Taxi in the early 1980s, as Simka Gravas, the wife of Latka, the character played by Andy Kaufman, winning two Emmy Awards for her work...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dm3Ci8XuVYZBqqlYtaLgth94VUe.jpg", url:"https://themoviedb.org/person/10556"}}, {tmdbId:"1435051", properties:{imdbId:"0397495", name:"Mel Howard", url:"https://themoviedb.org/person/1435051"}}, {tmdbId:"160610", properties:{imdbId:"0442598", name:"Dorrie Kavanaugh", url:"https://themoviedb.org/person/160610"}}, {tmdbId:"6553", properties:{bornIn:"Gennevilliers, Hauts-de-Seine, France", imdbId:"0000254", born:date('1955-06-27'), name:"Isabelle Adjani", bio:"Isabelle Yasmine Adjani (born 27 June 1955) is a French film actress and singer.  Adjani has appeared in 30 films since 1970.  She holds the record for most César Award for Best Actress with five, for Possession (1981), One Deadly Summer (1983), Camille Claudel (1988), Queen Margot (1994) and Skirt Day (2009).  She was also given a double Cannes Film Festival Best Actress Award in 1981.  She also received two Academy Award nominations for Best Actress.  She performs in French, English, and German...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/waAtxlj2TizxEfc66hCWPPGi8Z1.jpg", url:"https://themoviedb.org/person/6553"}}, {tmdbId:"19338", properties:{bornIn:"London, England, UK", imdbId:"0550204", born:date('1917-05-29'), name:"Sylvia Marriott", bio:"Sylvia Marriott was an English actress...", died:date('1995-07-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l1ILoWuX5JUjw5fk9gk7T4awMDZ.jpg", url:"https://themoviedb.org/person/19338"}}, {tmdbId:"19339", properties:{bornIn:"London, England, UK", imdbId:"0087805", born:date('1948-11-27'), name:"Joseph Blatchley", bio:"Joseph Blatchley was born on November 27, 1948 in London, England.  He is an actor and director. \n\nHe has been married to Geraldine James since June 1986.  They have one child...", url:"https://themoviedb.org/person/19339"}}, {tmdbId:"10476", properties:{bornIn:"Paris, France", imdbId:"0166452", born:date('1950-03-23'), name:"Corinne Cléry", bio:"Born near Paris, and raised in Saint Germain-en-Laye, Cléry started her acting career in the late 1960s very shortly under the name 'Corinne Piccoli'.  Her first important film was Joël Le Moigne's Les Ponettes with Johnny Halliday and famous DJ Hubert Wayaffe, whom she married at the end of the filming, aged 17. \n\nCléry first came to prominence in the controversial movie Story of O (1975) (Histoire d'O)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oyda6VivwSgqoZ841JoAbmxQ7CD.jpg", url:"https://themoviedb.org/person/10476"}}, {tmdbId:"33547", properties:{bornIn:"London, England, UK", imdbId:"0824389", born:date('1920-05-21'), name:"Anthony Steel", bio:"From Wikipedia, the free encyclopedia\n\nAnthony Maitland Steel (21 May 1920 – 21 March 2001)[1] was an English actor and singer. \n\nDescription above from the Wikipedia article Anthony Steel (actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2001-03-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aig5M3tqZg5qimyNauOVUuBJJ9u.jpg", url:"https://themoviedb.org/person/33547"}}, {tmdbId:"36210", properties:{imdbId:"0310481", born:date('1922-01-16'), name:"Jean Gaven", died:date('2014-05-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uUybDrQ80cEC9TA34GBr4Pt9Ji6.jpg", url:"https://themoviedb.org/person/36210"}}, {tmdbId:"8607", properties:{bornIn:"New York City, New York, USA", imdbId:"0308882", born:date('1937-08-16'), name:"Lorraine Gary", bio:"Lorraine Gary (born Lorraine Gottfried; August 16, 1937) is an American actress best known for her role as Ellen Brody in Jaws, Jaws 2, and Jaws: The Revenge.  She also appeared in 1941 and Car Wash. \n\nDescription above from the Wikipedia article Lorraine Gary , licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9RAY5bWIXZko9Yx3QBhaXIqVRyT.jpg", url:"https://themoviedb.org/person/8607"}}, {tmdbId:"70257", properties:{bornIn:"Paris, France", imdbId:"0011948", born:date('1894-07-22'), name:"Georges Adet", died:date('1979-03-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lHpaReCrLnJeQjY8uAR1heDpUTr.jpg", url:"https://themoviedb.org/person/70257"}}, {tmdbId:"1042", properties:{bornIn:"White Plains, New York, USA", imdbId:"0012524", born:date('1937-04-25'), name:"Frank Adu", died:date('2018-12-01'), url:"https://themoviedb.org/person/1042"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"11852", properties:{bornIn:"Maler Kotla, Punjab, India", imdbId:"0006762", born:date('1929-01-08'), name:"Saeed Jaffrey", bio:"​From Wikipedia, the free encyclopedia\n\nSaeed Jaffrey OBE (born 8 January 1929) is an Indian-born British actor, who has done numerous British movies.  He was born in Malerkotla, Punjab.  His film credits include The Man Who Would Be King (1975), Shatranj Ke Khiladi (The Chess Players) (1977), Gandhi (1982), A Passage to India (1965 BBC version and 1984 film) and My Beautiful Laundrette (1985).  He has also appeared in many Bollywood films in the 1980s and 1990s...", died:date('2015-11-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vfESx8h4d8xfGfGasqreTdJgYQP.jpg", url:"https://themoviedb.org/person/11852"}}, {tmdbId:"10671", properties:{bornIn:"Groesbeck, Texas, USA", imdbId:"0000833", born:date('1936-02-12'), name:"Joe Don Baker", bio:"From Wikipedia, the free encyclopedia\n\nJoe Don Baker (born February 12, 1936) is an American film actor, perhaps best known for his roles as a Mafia hitman in Charley Varrick, real-life Tennessee sheriff Buford Pusser in Walking Tall, James Bond villain Brad Whitaker in The Living Daylights, and CIA agent Jack Wade in the James Bond films GoldenEye and Tomorrow Never Dies...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xoDD4nFUvIWLdmKER5wQUbnB2tG.jpg", url:"https://themoviedb.org/person/10671"}}, {tmdbId:"20928", properties:{bornIn:"Hartford, Connecticut, USA", imdbId:"0002067", born:date('1942-11-18'), name:"Linda Evans", bio:"Linda Evans  (born on November 18, 1942) is an American actress known primarily for her roles on television.  She rose to fame playing Victoria Barkley's (played by Barbara Stanwyck) daughter, Audra Barkley, in the 1960s Western TV series, The Big Valley (1965–1969).  Her most prominent role was that of long-suffering heroine Krystle Carrington, the wife of Blake Carrington (played by John Forsythe), in the 1980s ABC prime time television soap opera Dynasty, a role she played from 1981 to 1989...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8URiq5sdmonfNoiyqJyIEV6Q4xw.jpg", url:"https://themoviedb.org/person/20928"}}, {tmdbId:"9808", properties:{imdbId:"0035069", born:date('1941-12-24'), name:"David Arkin", died:date('1991-01-14'), url:"https://themoviedb.org/person/9808"}}, {tmdbId:"30610", properties:{bornIn:"Porterville, California, U.S.", imdbId:"0062642", born:date('1923-01-01'), name:"Barbara Baxley", bio:"​From Wikipedia, the free encyclopedia.   \n\nBarbara Baxley (January 1, 1923 – June 7, 1990) was an American actress of stage, film and television. \n\nDescription above from the Wikipedia article  licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1990-06-07'), url:"https://themoviedb.org/person/30610"}}, {tmdbId:"70241", properties:{bornIn:"Greenwich Village, New York, USA", imdbId:"0912874", born:date('1941-08-12'), name:"Jennifer Warren", bio:"From Wikipedia, the free encyclopedia. \n\nJennifer Warren (born August 12, 1941) is an American actress and film director. \n\nWarren was born in the Greenwich Village section of New York City, the daughter of Paula Bauersmith, an actress, and Barnet M.  Warren, a dentist.  Her uncle was Yiddish theatre actor and director Jacob Ben-Ami.  Warren graduated from Elisabeth Irwin High School.  Warren married producer Roger Gimbel in 1976.  They have a son, Barney, a writer and editor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vSiH9S9u4B3VUPOaWOa43k6K1d3.jpg", url:"https://themoviedb.org/person/70241"}}, {tmdbId:"1166", properties:{bornIn:" Los Angeles, California, USA", imdbId:"0950867", born:date('1937-11-05'), name:"Harris Yulin", bio:"​From Wikipedia, the free encyclopedia. \n\nHarris Yulin (born November 5, 1937) is an American actor who has appeared in dozens of Hollywood and television films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rKEWwNwhaE4AsubDGoLu6pDIxZy.jpg", url:"https://themoviedb.org/person/1166"}}, {tmdbId:"7073", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0077720", born:date('1948-09-04'), name:"Michael Berryman", bio:"An American actor.  He has appeared in several horror movies and other B movies.  Berryman is famous for having a distinctive physical appearance as a result of hypohidrotic ectodermal dysplasia, a rare genetic condition which prevents him from developing hair, sweat glands or fingernails.  According to his own statements in an interview for the DVD release of The Hills Have Eyes, he was born with \"twenty-six birth defects...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jnyXbS5NqYdfZyvRUX2PHeKuOg4.jpg", url:"https://themoviedb.org/person/7073"}}, {tmdbId:"7074", properties:{bornIn:"Reading, Pennsylvania, USA", imdbId:"0110480", born:date('1903-01-16'), name:"Peter Brocco", died:date('1992-12-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aZhOvx1UiUoxGqzNbTHvzMJCAgN.jpg", url:"https://themoviedb.org/person/7074"}}, {tmdbId:"7075", properties:{bornIn:"Colony, Kansas, USA", imdbId:"0111954", born:date('1916-07-22'), name:"Dean R. Brooks", died:date('2013-05-30'), url:"https://themoviedb.org/person/7075"}}, {tmdbId:"7076", properties:{imdbId:"0113000", name:"Alonzo Brown", url:"https://themoviedb.org/person/7076"}}, {tmdbId:"67829", properties:{bornIn:"Cleethorpes, Lincolnshire, England, UK", imdbId:"0337003", born:date('1924-07-20'), name:"Vivean Gray", bio:"​From Wikipedia, the free encyclopedia. \n\nVivean Gray  (born Jean Vivra Gray on 20 July 1924 in Cleethorpes, Lincolnshire) is an English actress, who found her niche playing gossipy characters in Australian television series.  In her early life, she lived in England but moved to Australia after she had trouble finding any acting opportunities.  She portrayed mathematics teacher Miss McGraw in Peter Weir's film adaptation of Picnic at Hanging Rock (1975)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hIGxRT0nd1hABpD6ddc0DfrK0ie.jpg", url:"https://themoviedb.org/person/67829"}}, {tmdbId:"67835", properties:{bornIn:"Harrow-on-the-Hill, Middlesex, England, UK", imdbId:"0607609", born:date('1947-01-24'), name:"Helen Morse", bio:"​From Wikipedia, the free encyclopedia. \n\nHelen Morse  (born 24 January 1947) is an Australian actress who has appeared in films, on television, and on stage. \n\nMorse was born in Harrow on the Hill, Middlesex, England.  She was the oldest of four children; her parents were a doctor and nurse.  She attended school at Presbyterian Ladies' College, in Burwood, Victoria, and studied acting at the National Institute of Dramatic Art, in the Sydney suburb of Kensington...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tDFshDM2qq0VxJt31hYFhnEMM9l.jpg", url:"https://themoviedb.org/person/67835"}}, {tmdbId:"67836", properties:{imdbId:"0157467", name:"Kirsty Child", bio:"​From Wikipedia, the free encyclopedia. \n\nKirsty Child is an Australian actress, best known for playing three roles in the cult drama Prisoner.  She played two guest roles – prison officer turned drug dealer Anne Yates in 1979, and Glynis Johnson, the sister of an inmate, in 1983.  In 1985 she played a more prominent part in the series as supercilious fence Willie Beecham.  She returned for a cameo in late 1986...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uYC69RONSOUokNVd86jXay1Fpfj.jpg", url:"https://themoviedb.org/person/67836"}}, {tmdbId:"39027", properties:{bornIn:"Cape Town, South Africa", imdbId:"0750192", born:date('1943-08-18'), name:"Jenny Runacre", bio:"From Wikipedia, the free encyclopedia. \n\nJenny Runacre (born 18 August 1946) is an actress. \n\nRunacre was born in Cape Town, South Africa.  She relocated to London as a child, attended The Actor's Workshop there, and trained in the Stanislavski System...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2kqnfVBgUBZFmUKWdLy6z3XizcZ.jpg", url:"https://themoviedb.org/person/39027"}}, {tmdbId:"44959", properties:{bornIn:"Florence, Italy", imdbId:"0630453", born:date('1950-06-19'), name:"Daria Nicolodi", bio:"​From Wikipedia, the free encyclopedia.   \n\nDaria Nicolodi (born June 19, 1950) is an Italian actress and screenwriter. \n\nDescription above from the Wikipedia article  Daria Nicolodi, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6BCv49T4N8G26i7CtmqTdwKIUeS.jpg", url:"https://themoviedb.org/person/44959"}}, {tmdbId:"80503", properties:{bornIn:"Milan", imdbId:"0492006", born:date('1942-10-10'), name:"Gabriele Lavia", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xjLiYd6fHszM8w5NiGBcSKd1mk9.jpg", url:"https://themoviedb.org/person/80503"}}, {tmdbId:"9766", properties:{bornIn:"Rabat, Maroc", imdbId:"0617736", born:date('1940-09-03'), name:"Macha Méril", bio:"Macha Méril, born Princess Maria-Magdalena Vladimirovna Gagarina on 3 September 1940, Rabat, Morocco, is a French actress and writer, descended by her father from the Russian princely house Gagarin and by her mother from a Ukrainian noble family.  She has appeared in 119 films between 1959 and 2007, including roles in films directed by Jean-Luc Godard (Une femme mariée, 1964), Luis Buñuel (Belle de jour, 1967) and Rainer Werner Fassbinder (Chinese Roulette, 1976)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6y5tnXwYFwOt7MgUEsN3mX787e4.jpg", url:"https://themoviedb.org/person/9766"}}, {tmdbId:"13472", properties:{bornIn:" Grappenhall, Warrington, England, UK", imdbId:"0000347", born:date('1946-04-19'), name:"Tim Curry", bio:"Timothy James Curry (born 19 April 1946) is an English actor and singer.  He is known for working in a diverse range of theatre, film, and television, most often portraying villainous characters.  Curry rose to prominence with his portrayal of Dr.  Frank-N-Furter in The Rocky Horror Picture Show (1975), reprising the role he had originated in the 1973 London and the 1974 Los Angeles stage productions of The Rocky Horror Show...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8ZsGg3N3OZgxshqLOtA2kl5ckOP.jpg", url:"https://themoviedb.org/person/13472"}}, {tmdbId:"13473", properties:{bornIn:"San Mateo, California, USA", imdbId:"0000960", born:date('1945-02-24'), name:"Barry Bostwick", bio:"Barry Knapp Bostwick (born February 24, 1945) is an American actor and singer.  He is known for playing Brad Majors in the 1975 cult classic The Rocky Horror Picture Show, replacing Peter Scolari as Mr.  Tyler in the sitcom What I Like About You, and playing Mayor Randall Winston in the sitcom Spin City.  He has also had considerable fame in musical theater...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z2jlL5g5PMxelSHMXFF03fTSsLl.jpg", url:"https://themoviedb.org/person/13473"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"13474", properties:{bornIn:"Cheltenham, Gloucestershire, England, UK", imdbId:"0639782", born:date('1942-03-25'), name:"Richard O'Brien", bio:"Richard O'Brien  is an English actor, television presenter, writer and theatre performer. \n\nO'Brien was born Richard Timothy Smith in Cheltenham, Gloucestershire, England.  In 1951, the family emigrated to Tauranga, New Zealand but he moved back to England in 1964.  On becoming an actor, he changed his name to Richard O'Brien (his maternal grandmother's surname)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pkwBMJPLuMDNK5mGMjd9kMTEjof.jpg", url:"https://themoviedb.org/person/13474"}}, {tmdbId:"4819", properties:{bornIn:"Rome, Italy", imdbId:"0093678", born:date('1939-02-28'), name:"Paolo Bonacelli", bio:"From Wikipedia, the free encyclopedia. \n\nPaolo Bonacelli (born February 28, 1939) is an Italian actor. \n\nHe is best known for his performance as The Duke de Blangis in Pasolini's notorious Salò (1975).  He can also be seen in Midnight Express (1978) and Caligula (1979), in which he plays the role of Cassius Chaerea. \n\nHe also co-starred with Roberto Benigni in the films Johnny Stecchino and Night on Earth, both from 1991...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7h2EJQ19m9pZCfyGEoXb8aEFIF2.jpg", url:"https://themoviedb.org/person/4819"}}, {tmdbId:"42845", properties:{bornIn:"Italy", imdbId:"0145863", born:date('1950-11-11'), name:"Giorgio Cataldi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kCfKutu4gxnqQwNNKlaTrFm3yU2.jpg", url:"https://themoviedb.org/person/42845"}}, {tmdbId:"2608421", properties:{bornIn:"Milan, Lombardy, Italy", born:date('1926-11-01'), name:"Umberto Paolo Quintavalle", bio:"Quintavalle was an Italian author (In Cerca Di Upamanyu (1995), La Festa (1953)) with no prior film experience, chosen by Pasolini for the role of His Excellency \"for your physical aspect, which is perfect for the role of a decadent intellectual, which I need...", died:date('1997-11-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qblAfIQUAdBS1bmXdpxsR9GWGsL.jpg", url:"https://themoviedb.org/person/2608421"}}, {tmdbId:"42847", properties:{bornIn:"Roma", imdbId:"0885084", born:date('1930-01-01'), name:"Aldo Valletti", died:date('1992-01-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nLrJfvuSEtSHucomoxCGV1xEJqZ.jpg", url:"https://themoviedb.org/person/42847"}}, {tmdbId:"98476", properties:{imdbId:"0359035", born:date('1937-08-20'), name:"Paul Hampton", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ayJd34mycfSKp0HZ0AKbxGFoxxr.jpg", url:"https://themoviedb.org/person/98476"}}, {tmdbId:"98477", properties:{imdbId:"0798718", born:date('1922-09-28'), name:"Joe Silver", died:date('1989-02-27'), url:"https://themoviedb.org/person/98477"}}, {tmdbId:"98420", properties:{bornIn:"East St. Louis, Illinois, USA", imdbId:"0523344", born:date('1947-10-15'), name:"Lynn Lowry", bio:"Linda Kay Lowry is an American actress, screenwriter and producer. \n\nDescription above from the Wikipedia article Lynn Lowry, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mBqg1ecbhyYRGqZFRX7RRJVgnMp.jpg", url:"https://themoviedb.org/person/98420"}}, {tmdbId:"31533", properties:{imdbId:"0464255", name:"Allan Kolman", url:"https://themoviedb.org/person/31533"}}, {tmdbId:"85655", properties:{bornIn:"Ludhiana, Punjab, India", imdbId:"0004429", born:date('1935-12-08'), name:"Dharmendra", bio:"Dharmendra Singh Deol known as Dharmendra, is an award-winning Legendary Hindi film star who has appeared in more than 200 Hindi-language films.  In 1997 he received the Filmfare Lifetime Achievement Award for his contribution to Hindi cinema.  He is regarded as the Undisputed \"Action King\" of Hindi cinema having starred in numerous action blockbusters and is greatly considered a Living legend.  He is father of notable actors Sunny Deol, Bobby Deol and Esha Deol...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qRT0nOpxt14osa76nTrNduawX0l.jpg", url:"https://themoviedb.org/person/85655"}}, {tmdbId:"86509", properties:{imdbId:"0474876", born:date('1938-07-09'), name:"Sanjeev Kumar", died:date('1985-11-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xfqirwZjtRdzioJ66dUZTBU2KgB.jpg", url:"https://themoviedb.org/person/86509"}}, {tmdbId:"35781", properties:{bornIn:"Ammankudi , Thanjavur , Tamil Nadu", imdbId:"0004564", born:date('1948-10-16'), name:"Hema Malini", bio:"Hema Malini was born on 16-10-1948 in Ammankudi, Thanjavur in the state of Tamil Nadu, India.  She is an Indian Film Actress, Film Director, Film Producer, Dancer, Television Actress & Politician who best known for her work in Bollywood Industry as well as in Tamil and Telugu Cinema...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dfNRjtvbxisRSBDhCoUMuEFyY3V.jpg", url:"https://themoviedb.org/person/35781"}}, {tmdbId:"35780", properties:{bornIn:"Allahabad, Uttar Pradesh, India.", imdbId:"0000821", born:date('1942-10-11'), name:"Amitabh Bachchan", bio:"Amitabh Bachchan, is an Indian film actor.  He first gained popularity in the early 1970s as the \"angry young man\" of Hindi cinema, and has since become one of the most prominent figures in the history of Indian cinema.   Bachchan has won numerous major awards in his career, including four National Film Awards, three of which are in the Best Actor category, and fourteen Filmfare Awards.  He is the most-nominated performer in any major acting category at Filmfare, with 36 nominations overall...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yAvq3EG5W5WaegZHB7gNdlM2KED.jpg", url:"https://themoviedb.org/person/35780"}}, {tmdbId:"87156", properties:{bornIn:"Bethel Park, Pennsylvania, United States of America", imdbId:"0271156", born:date('1933-03-12'), name:"Barbara Feldon", bio:"From Wikipedia, the free encyclopedia. \n\nBarbara Feldon (born March 12, 1933) is an American character actress of stage who is primarily known for her roles on television.  Her most prominent role was that of Agent 99 on the popular 1960s sitcom, Get Smart.  She also worked as a model. \n\nDescription above from the Wikipedia article Barbara Feldon, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cJIQYxNI63XjEUaWxK1dvkQLoLo.jpg", url:"https://themoviedb.org/person/87156"}}, {tmdbId:"82130", properties:{bornIn:"New York City, New York, USA", imdbId:"0452264", born:date('1915-08-12'), name:"Michael Kidd", bio:"​From Wikipedia, the free encyclopedia\n\nMichael Kidd (August 12, 1915 – December 23, 2007) was an American film and stage choreographer. \n\nDescription above from the Wikipedia article Michael Kidd, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2007-12-23'), url:"https://themoviedb.org/person/82130"}}, {tmdbId:"71733", properties:{bornIn:"Northampton, Northamptonshire, England", imdbId:"0628216", born:date('1934-05-29'), name:"Nanette Newman", bio:"From Wikipedia, the free encyclopedia. \n\nNanette Newman (born 29 May 1934) is an English actress and author. \n\nDescription above from the Wikipedia article Nanette Newman, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7zxdhBUD65gUqLDEsHOChLOWrYj.jpg", url:"https://themoviedb.org/person/71733"}}, {tmdbId:"2537", properties:{bornIn:"Fukuoka, Japan", imdbId:"0002002", born:date('1939-01-23'), name:"Shin'ichi Chiba", bio:"From Wikipedia, the free encyclopedia.  Shinichi Chiba  (born January 23, 1939), also known as Sonny Chiba, is a Japanese actor and martial artist.  Chiba was one of the first actors to achieve stardom through his skills in martial arts, initially in Japan and later before an international audience.  Description above from the Wikipedia article Sonny Chiba, licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/k3kHcYUBj8RskpAEDaJ0FR6ynSx.jpg", url:"https://themoviedb.org/person/2537"}}, {tmdbId:"1168048", properties:{bornIn:"Setana, Hokkaido, Japan", imdbId:"0945214", born:date('1933-02-10'), name:"Goichi Yamada", died:date('2012-10-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mJWGbSXkpZapnn0oRtGGyc0i7jh.jpg", url:"https://themoviedb.org/person/1168048"}}, {tmdbId:"127833", properties:{bornIn:"Mito, Ibaraki Prefecture, Japan", imdbId:"0620073", born:date('1952-10-05'), name:"Yutaka Nakajima", bio:"Actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6Ml22rFPWJsTziR12dSAh12snYB.jpg", url:"https://themoviedb.org/person/127833"}}, {tmdbId:"1015138", properties:{bornIn:"United States of America", imdbId:"0149127", born:date('1938-10-09'), name:"Tony Cetera", url:"https://themoviedb.org/person/1015138"}}] AS row
