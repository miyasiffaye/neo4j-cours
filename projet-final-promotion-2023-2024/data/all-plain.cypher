UNWIND [{tmdbId:"63871", properties:{bornIn:"Vancouver, British Columbia, Canada", imdbId:"0186160", born:date('1973-08-23'), name:"Joey Cramer", bio:"Joey Cramer was born on August 23, 1973 in Vancouver, British Columbia, Canada as Deleriyes August Joe Fisher Cramer.  His debut was in the Sci-Fi movie Runaway (1984), directed by Jurassic Park (1993)'s writer, Michael Crichton...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tqTPKuXwcP4s0dgON4m8vp2McU2.jpg", url:"https://themoviedb.org/person/63871"}}, {tmdbId:"16935", properties:{bornIn:"Wareham, Massachusetts, USA", imdbId:"0000133", born:date('1956-01-21'), name:"Geena Davis", bio:"Virginia Elizabeth \"Geena\" Davis (born January 21, 1956)  is an American actress, film producer, writer, former fashion model, and a women's Olympics archery team semi-finalist.  She is known for her roles in The Fly, Beetlejuice, Thelma &amp; Louise, A League of Their Own, and The Accidental Tourist, for which she won the 1988 Academy Award for Best Supporting Actress.  In 2005, she won the Golden Globe Award for Best Actress – Television Series Drama for her role in Commander in Chief...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bx9ufx5cS7FfHDFFeT71syBh428.jpg", url:"https://themoviedb.org/person/16935"}}, {tmdbId:"57626", properties:{imdbId:"0100205", born:date('1959-12-15'), name:"Joy Boushel", bio:"​From Wikipedia, the free encyclopedia.   \n\nJoy Boushel (born 1959) is an actress who appeared in a handful of movies and TV shows. \n\nBoushel's acting career has consisted of Cursed (1990), Look Who's Talking (1989), Keeping Track (1987), The Fly (1986), Thrillkill (1984), Humongous (1982), Quest for Fire (1982), and Terror Train (1980). \n\nDescription above from the Wikipedia article Joy Boushel, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/po8OofwBBW6L03CIQdpjyEBB6vc.jpg", url:"https://themoviedb.org/person/57626"}}, {tmdbId:"64199", properties:{bornIn:"New York City, New York USA", imdbId:"0177438", born:date('1964-09-19'), name:"Jennifer Cooke", bio:"​From Wikipedia, the free encyclopedia\n\nJennifer Cooke (born September 19, 1964) is an American actress. \n\nShe is perhaps best known for her role as the \"Star Child\", Elizabeth, who is half Human/half Visitor in the 1984 television series V.  She also starred in the soap opera Guiding Light as Morgan Richards Nelson from 1981-1983.  Cooke played \"Debbie\" on the critically acclaimed NBC series \"A Year in The Life\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6GhWtRLnhcuKpYIDSaeQoK5I1pE.jpg", url:"https://themoviedb.org/person/64199"}}, {tmdbId:"64200", properties:{bornIn:"Somers Point, New Jersey, U.S.A.", imdbId:"0434563", born:date('1948-09-27'), name:"David Kagen", bio:"​From Wikipedia, the free encyclopedia\n\nDavid Kagen (born September 27, 1948) is an American film and television actor, best known for playing Sheriff Michael Garris in Friday the 13th Part VI: Jason Lives. \n\nKagen was born and raised in Somers Point, New Jersey.  He is a Carnegie-Mellon graduate and runs his own acting school, David Kagen's School of Film Acting, situated in Studio City, California.  Kagen also attended the Juilliard Preparatory School where he studied piano...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rSWoYVqOYjjcDobBAmqRrDXDfCV.jpg", url:"https://themoviedb.org/person/64200"}}, {tmdbId:"1394114", properties:{imdbId:"0634729", name:"Kerry Noonan", url:"https://themoviedb.org/person/1394114"}}, {tmdbId:"99036", properties:{bornIn:"San Francisco, California, USA", imdbId:"0814811", born:date('1936-11-14'), name:"Ted Sorel", died:date('2010-11-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8oPf70bi0vHj2dcDJ3xY50gKhnL.jpg", url:"https://themoviedb.org/person/99036"}}, {tmdbId:"91971", properties:{bornIn:"Nisko, Poland", imdbId:"0496428", born:date('1900-06-03'), name:"Friedrich von Ledebur", bio:"Friedrich Anton Maria Hubertus Bonifacius Graf von Ledebur-Wicheln (June 3, 1900 – December 25, 1986) was an actor who was known for Moby Dick (1956), Alexander the Great (1955) and Slaughterhouse-Five (1972). \n\nLedebur was born in Austria-Hungary (later Poland) in 1900.  Friedrich enlisted in the Austro-Hungarian Imperial Army in 1916, and was an officer in the Austrian Cavalry Division during the last years of World War I...", died:date('1986-12-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bBRaajqzljFK8PYsaiY2rEnvOYq.jpg", url:"https://themoviedb.org/person/91971"}}, {tmdbId:"559312", properties:{bornIn:"Monterey, California, United States", imdbId:"0714164", born:date('1979-09-14'), name:"J.L. Reate", bio:"J. L.  Reate was born on September 14, 1979 in Monterey County, California, USA as Jasmine Lauren Reate.  She is an actress, known for The Golden Child (1986)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7HBM2slsY1UAcMYyyJBmtlbgwYl.jpg", url:"https://themoviedb.org/person/559312"}}, {tmdbId:"42558", properties:{bornIn:"Kensington, London, England, UK", imdbId:"0001470", born:date('1967-08-07'), name:"Charlotte Lewis", bio:"From Wikipedia, the free encyclopedia\n\nCharlotte Lewis (born 7 August 1967) is an English actress. \n\nDescription above from the Wikipedia article Charlotte Lewis, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jqqlv2LM6ABxl6F3freNBkkeGZI.jpg", url:"https://themoviedb.org/person/42558"}}, {tmdbId:"5168", properties:{bornIn:"Dublin, Ireland ", imdbId:"0000321", born:date('1950-05-12'), name:"Gabriel Byrne", bio:"An Irish actor, film director, film producer, writer, cultural ambassador and audiobook narrator.  His acting career began in the Focus Theatre before he joined London’s Royal Court Theatre in 1979.  Byrne's screen début came in the Irish soap opera The Riordans and the spin-off show Bracken.  The actor has now starred in over 35 feature films, such as The Usual Suspects, Miller's Crossing and Stigmata, in addition to writing two...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vZ5amSGl8iSSK7C7WLKCN4EewnM.jpg", url:"https://themoviedb.org/person/5168"}}, {tmdbId:"20162", properties:{bornIn:"London, England, United Kingdom", imdbId:"0001670", born:date('1963-05-11'), name:"Natasha Richardson", bio:"From Wikipedia, the free encyclopedia. \n\nNatasha Jane Richardson (11 May 1963 – 18 March 2009) was an English actress of stage and screen.  A member of the Redgrave family, she was the daughter of actress Vanessa Redgrave and director/producer Tony Richardson and the granddaughter of Michael Redgrave and Rachel Kempson...", died:date('2009-03-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eQNhOUDQY4NZD2cbaUpltLxrcG.jpg", url:"https://themoviedb.org/person/20162"}}, {tmdbId:"30611", properties:{bornIn:"Moncton, New Brunswick, Canada", imdbId:"0194267", born:date('1960-01-01'), name:"Myriam Cyr", url:"https://themoviedb.org/person/30611"}}, {tmdbId:"39949", properties:{bornIn:"Halifax, Yorkshire, England, UK", imdbId:"0408813", born:date('1934-02-10'), name:"Barrie Ingham", died:date('2015-01-23'), url:"https://themoviedb.org/person/39949"}}, {tmdbId:"61674", properties:{imdbId:"0079353", name:"Val Bettin", url:"https://themoviedb.org/person/61674"}}, {tmdbId:"61675", properties:{imdbId:"0689527", name:"Susanne Pollatschek", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xgRir6AV2FrqTmac9w0RKZSAa93.jpg", url:"https://themoviedb.org/person/61675"}}, {tmdbId:"16183", properties:{bornIn:"Ogden, Utah, USA", imdbId:"0913797", born:date('1955-06-26'), name:"Gedde Watanabe", bio:"​From Wikipedia, the free encyclopedia. \n\nGedde Watanabe  (born Gary Watanabe, June 26, 1955, Ogden, Utah) is an American theatre, film, and television actor. \n\nHe was in several dramatic productions in high school, both acting and singing.  After graduation, Watanabe left Ogden for San Francisco, where he hoped to make his living as a street musician while honing his acting skills...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4uI6QEicUA0cR5suA0B2bEM7JBt.jpg", url:"https://themoviedb.org/person/16183"}}, {tmdbId:"13920", properties:{bornIn:"Coral Gables, Florida, U.S.", imdbId:"0000211", born:date('1956-01-27'), name:"Mimi Rogers", bio:"Mimi Rogers (born January 27, 1956) is an American movie actress and competitive poker player. \n\nDescription above from the Wikipedia article Mimi Rogers, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tRgFtPEr9eSwGjKXpg0p0MNItry.jpg", url:"https://themoviedb.org/person/13920"}}, {tmdbId:"188457", properties:{imdbId:"0442576", name:"Patrick Kavanagh", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uSgsKTLRMdxrvAUMbAfJNeMX07K.jpg", url:"https://themoviedb.org/person/188457"}}, {tmdbId:"219000", properties:{imdbId:"0448741", name:"Faith Kent", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e1hh6YE04iA7SzyIpHK1j5QK5zO.jpg", url:"https://themoviedb.org/person/219000"}}] AS row
