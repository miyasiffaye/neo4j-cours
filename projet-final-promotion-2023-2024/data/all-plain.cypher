UNWIND [{tmdbId:"1308762", properties:{imdbId:"2675985", name:"Jon Roberts", url:"https://themoviedb.org/person/1308762"}}, {tmdbId:"1308766", properties:{imdbId:"2428359", name:"Al Sunshine", url:"https://themoviedb.org/person/1308766"}}, {tmdbId:"1333680", properties:{name:"Sam Burstyn", url:"https://themoviedb.org/person/1333680"}}, {tmdbId:"1308763", properties:{imdbId:"2666992", name:"Mickey Munday", url:"https://themoviedb.org/person/1308763"}}, {tmdbId:"100197", properties:{bornIn:"London,  England", imdbId:"0390735", born:date('1958-01-24'), name:"Jools Holland", bio:"Jools Holland was born on January 24, 1958 in London, England as Julian Miles Holland.  He is known for his work on Later with Jools Holland (1992), The Tube (1982) and Juke Box Jury (1959).  He has been married to Christabel McEwen since August 29, 2005.  They have one child...", url:"https://themoviedb.org/person/100197"}}, {tmdbId:"1175198", properties:{bornIn:"Stratford, West Ham, Essex (now Greater London), England, UK", imdbId:"0114628", born:date('1964-10-07'), name:"Sam Brown", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lrYJk35GR8gs6LPbxpa1sEkd9UJ.jpg", url:"https://themoviedb.org/person/1175198"}}, {tmdbId:"118206", properties:{bornIn:"Marbella, Málaga, Andalusia, Spain", imdbId:"0631326", born:date('1967-01-20'), name:"Pepón Nieto", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mjyEXTCJEIZNROdSUpvAg6HG01e.jpg", url:"https://themoviedb.org/person/118206"}}, {tmdbId:"102221", properties:{imdbId:"0643679", name:"Rubén Ochandiano", url:"https://themoviedb.org/person/102221"}}, {tmdbId:"16900", properties:{bornIn:"Glasgow, Scotland, UK", imdbId:"1460618", name:"Atta Yaqub", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xlJ8Z0uUDC1McHfEhYi9OJ7N81G.jpg", url:"https://themoviedb.org/person/16900"}}, {tmdbId:"16901", properties:{bornIn:"Bray, Co. Wicklow, Ireland", imdbId:"0083795", born:date('1974-01-01'), name:"Eva Birthistle", bio:"Eva Birthistle (born 1974 in Bray, Co.  Wicklow) is an Irish actress, best known for her role in Ae Fond Kiss.  She won the London Film Critics Circle British Actress of the Year award in 2004 and has twice won the IFTA Best Actress in a Leading Role (Film) award. \n\nDescription above from the Wikipedia article Eva Birthistle, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8pNF8N4kgzxBjrLwecgV1Mo2oSi.jpg", url:"https://themoviedb.org/person/16901"}}, {tmdbId:"16905", properties:{imdbId:"1566212", name:"Ahmad Riaz", url:"https://themoviedb.org/person/16905"}}, {tmdbId:"16902", properties:{imdbId:"1566336", name:"Shamshad Akhtar", url:"https://themoviedb.org/person/16902"}}, {tmdbId:"3542", properties:{bornIn:"Hackney, London, England, UK", imdbId:"1263280", born:date('1993-06-25'), name:"Barney Clark", bio:"Barney Ivan S.  Clark (born 25 June 1993 in Hackney, London) is an English actor. \n\nClark began acting in school plays and appeared in the 2001 film Lawless Heart.  He successfully auditioned for the title role in the 2005 version of Oliver Twist, directed by Roman Polanski; 800 children had auditioned for the role.  \n\nThe film opened in September 2005 and was mostly considered a financial and critical disappointment, although Clark received positive reviews for his performance...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zkJCYJoCuXQcIIVDU3IrPlLCBeC.jpg", url:"https://themoviedb.org/person/3542"}}, {tmdbId:"3555", properties:{bornIn:"Stockton-on-Tees, Durham, England", imdbId:"0842596", born:date('1960-01-01'), name:"Jeremy Swift", bio:"Jeremy Swift is an English actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/muRh4WbyEE4S2763bv777ywpKP3.jpg", url:"https://themoviedb.org/person/3555"}}, {tmdbId:"120833", properties:{bornIn:"Hendon, Middlesex, England, UK", imdbId:"0243983", born:date('1944-02-08'), name:"Richard Durden", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eH5gdjtoCMFNs2OlSyWb0ha2yHn.jpg", url:"https://themoviedb.org/person/120833"}}, {tmdbId:"37260", properties:{bornIn:"Lochinvar, New South Wales, Australia", imdbId:"0180411", born:date('1982-08-07'), name:"Abbie Cornish", bio:"Abbie Cornish, born on 7th August 1982, is an Australian actress.  She is well known in Australia for a number of film and television roles, including Penne in the comedy/lifestyle parody Life Support, her award-winning lead performance in 2004's Somersault and her role as Fannie Brawne in Bright Star. \n\nHer career began at the age of thirteen, when she began taking jobs as a model after reaching the finals of a Dolly Magazine competition...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AgIA8uPnwySIbqaPjr5jEXwZbS.jpg", url:"https://themoviedb.org/person/37260"}}, {tmdbId:"985070", properties:{imdbId:"0210407", name:"Damian de Montemas", url:"https://themoviedb.org/person/985070"}}, {tmdbId:"1236200", properties:{imdbId:"0683026", name:"Olivia Pigeot", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iEVm3PaPXJy29OWjewPtuuLfXJk.jpg", url:"https://themoviedb.org/person/1236200"}}, {tmdbId:"125325", properties:{imdbId:"1456390", name:"Alex Babic", url:"https://themoviedb.org/person/125325"}}, {tmdbId:"649", properties:{bornIn:"Nimes, France", imdbId:"0229943", born:date('1934-08-14'), name:"Vernon Dobtcheff", bio:"From Wikipedia, the free encyclopedia\n\nDobtcheff was born in Nîmes, [[France] to a British mother (Vernon) and a father of Bulgarian descent (Dobtcheff).  He attended Ascham Preparatory School in Eastbourne, Sussex, England, in the 1940s, where he won the Acting Cup.  One of his many television roles was as the Chief Scientist in the Doctor Who story The War Games in 1969...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o3zjo0Q8BDJQFqHMIIaFbUnckBY.jpg", url:"https://themoviedb.org/person/649"}}] AS row
