UNWIND [{tmdbId:"1018", properties:{bornIn:"Glostrup, Denmark", imdbId:"0509263", born:date('1973-05-22'), name:"Nikolaj Lie Kaas", bio:"Nikolaj Lie Kaas (born 22 May 1973) is a prominent Danish actor whose career rose in the 1990s and who is still actively working today.  He is the son of actor Preben Kaas and actor and writer Anne Mari Lie and father of two...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zT1RZNV3JG2Fy0MeIy3fgRMYxUP.jpg", url:"https://themoviedb.org/person/1018"}}, {tmdbId:"3401", properties:{imdbId:"0421716", name:"Tomas Villum Jensen", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uM9maOCje4FjqFq99Khqgewvl8k.jpg", url:"https://themoviedb.org/person/3401"}}, {tmdbId:"112107", properties:{bornIn:"Rio de Janeiro, Rio de Janeiro, Brazil", imdbId:"0265155", born:date('1949-04-18'), name:"Antônio Fagundes", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wDFH1oqQcOLohAynIU4Vm8OxrL7.jpg", url:"https://themoviedb.org/person/112107"}}, {tmdbId:"115173", properties:{bornIn:"Santos, São Paulo, Brazil", imdbId:"0096542", born:date('1966-02-23'), name:"Alexandre Borges", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q8h8vHwl6G4nx9JFIQ5qlCsbLkG.jpg", url:"https://themoviedb.org/person/115173"}}, {tmdbId:"123256", properties:{bornIn:"Belo Horizonte, Minas Gerais, Brazil", imdbId:"0088614", born:date('1963-05-29'), name:"Débora Bloch", bio:"Débora Bloch (May 29, 1963 in Belo Horizonte, Minas Gerais, Brazil) is a Brazilian actress.  She is the daughter of actor Jonas Bloch, and is descendant of Ukrainian Jewish immigrants...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/csBEAgpI3WLPADQgrsHxEBxZrLV.jpg", url:"https://themoviedb.org/person/123256"}}, {tmdbId:"87794", properties:{bornIn:"Milwaukee, Wisconsin, USA", imdbId:"0096013", born:date('1966-08-20'), name:"Mark Borchardt", bio:"From Wikipedia, the free encyclopedia. \n\nMark Borchardt (born August 20, 1966) is an American independent filmmaker.  He is best known as the subject of the 1999 film American Movie: The Making of Northwestern, which documented two years he spent writing, shooting and editing his horror short, Coven (1997)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ao1gfbyLRGsGYiQswhuuFv44WR.jpg", url:"https://themoviedb.org/person/87794"}}, {tmdbId:"545831", properties:{imdbId:"0771794", name:"Tom Schimmels", url:"https://themoviedb.org/person/545831"}}, {tmdbId:"1502565", properties:{imdbId:"0096014", name:"Monica Borchardt", url:"https://themoviedb.org/person/1502565"}}, {tmdbId:"1502566", properties:{imdbId:"0096007", name:"Alex Borchardt", url:"https://themoviedb.org/person/1502566"}}, {tmdbId:"10689", properties:{bornIn:"Harlem, New York City, New York, USA", imdbId:"0114532", born:date('1984-03-01'), name:"Rob Brown", bio:"From Wikipedia, the free encyclopedia\n\nRob Brown (born March 1, 1984) is an American actor.  He is known for his roles in the films Finding Forrester (2000), Coach Carter (2005), Take the Lead (2006), The Express (2008), and currently stars in the HBO series Treme. \n\nDescription above from the Wikipedia article Rob Brown (actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jVevsp9OsdImQ8YxNjdG3KLYket.jpg", url:"https://themoviedb.org/person/10689"}}, {tmdbId:"87421", properties:{imdbId:"3251022", name:"Doudou Gueye Thiaw", url:"https://themoviedb.org/person/87421"}}, {tmdbId:"87422", properties:{imdbId:"0618460", name:"Maimouna N'Diaye", url:"https://themoviedb.org/person/87422"}}, {tmdbId:"87424", properties:{imdbId:"0765499", name:"Awa Sene Sarr", url:"https://themoviedb.org/person/87424"}}, {tmdbId:"87425", properties:{imdbId:"0509672", name:"Robert Liensol", url:"https://themoviedb.org/person/87425"}}, {tmdbId:"2202", properties:{bornIn:"Chicago - Illinois - USA", imdbId:"0004996", born:date('1965-12-03'), name:"Steve Harris", bio:"Steve J.  Harris (born December 3, 1965) is an American actor who has appeared in a number of films including; Quarantine, Tyler Perry's Diary of a Mad Black Woman, Bringing Down The House, The Rock, The Mod Squad, and Minority Report.  He is most famous for his role as Eugene Young on the legal drama The Practice.  He has done voice work for the animated television show The Batman as Ethan Bennett...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6qD0I3RPe2ivV5GdXgW3tJHSu1e.jpg", url:"https://themoviedb.org/person/2202"}}, {tmdbId:"2203", properties:{bornIn:"Dorchester, Massachusetts, USA", imdbId:"0568180", born:date('1966-02-13'), name:"Neal McDonough", bio:"Neal McDonough was trained at the London Academy of Dramatic Arts and Sciences.  His theatre credits include 'Cheap Talk', 'Foreigner', 'As You Like It', 'Rivals', 'A Midsummer Night's Dream', 'Bald Soprano', and 'Waiting for Lefty'.  The young actor won a 1991 Best Actor Dramalogue Award for 'Away Alone'.  McDonough has been a 'Star Trek' fan since he was a kid.  Playing Lieutenant Hawk in 'Star Trek First Contact' was a life-long dream.  McDonough has three pictures on his bedroom wall...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/G9JkXQAqjXooHkzH3TgGCOwa1z.jpg", url:"https://themoviedb.org/person/2203"}}, {tmdbId:"228570", properties:{imdbId:"0159026", born:date('1972-05-22'), name:"Annabel Chong", url:"https://themoviedb.org/person/228570"}}, {tmdbId:"1703452", properties:{name:"Ed Powers", url:"https://themoviedb.org/person/1703452"}}, {tmdbId:"20492", properties:{bornIn:"Hollywood, California, USA", imdbId:"0480465", born:date('1975-01-14'), name:"Jordan Ladd", bio:"​From Wikipedia, the free encyclopedia\n\nJordan Elizabeth Ladd (born January 14, 1975) is an American actress.  She began taking small film roles before landing her first high-profile role in Never Been Kissed (1999).  Since then, Ladd has portrayed supporting as well as lead roles in films, including Cabin Fever (2002), Club Dread (2004), and Death Proof (2007).  She has earned acclaim recently for her lead role in the horror film Grace (2009)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oKMEEeCeqIPz65ZxOHKDytxHAoF.jpg", url:"https://themoviedb.org/person/20492"}}, {tmdbId:"6213", properties:{bornIn:"Upper Darby - Pennsylvania - USA", imdbId:"0005085", born:date('1970-05-25'), name:"Jamie Kennedy", bio:"​From Wikipedia, the free encyclopedia\n\nJames Harvey \"Jamie\" Kennedy (born May 25, 1970) is an American comedian, rapper and actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zSBGgxJOS6c06ucEcoD9JYwZ4Rw.jpg", url:"https://themoviedb.org/person/6213"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"7218", properties:{bornIn:"Ghent, New York, USA", imdbId:"0518085", born:date('1979-10-08'), name:"Kristanna Loken", bio:"An American actress known for her work in both film and television, and as a fashion model. \n\nDescription above from the Wikipedia article Kristanna Loken, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mO4d5gVBspInBFvNXQFGvoZPhlM.jpg", url:"https://themoviedb.org/person/7218"}}, {tmdbId:"33623", properties:{imdbId:"0005398", name:"Michael Saucedo", url:"https://themoviedb.org/person/33623"}}, {tmdbId:"5346", properties:{bornIn:"Silver Spring, Maryland, USA", imdbId:"0001246", born:date('1967-06-08'), name:"Dan Futterman", bio:"From Wikipedia, the free encyclopedia. \n\nDaniel Futterman (born June 8, 1967) is an American actor and screenwriter.  Although he is known for several high-profile acting roles, including Val Goldman in the film The Birdcage, and Vincent Gray on the CBS television series Judging Amy, he is also a screenwriter...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dgmPcQe3tf616zB5hDpDStFunxO.jpg", url:"https://themoviedb.org/person/5346"}}, {tmdbId:"77553", properties:{imdbId:"0730993", name:"David Roberts", bio:"​From Wikipedia, the free encyclopedia. \n\nDavid Roberts is an Australian actor who has appeared in television, film and theatre...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n263zF76GX42aEK1AeMwcJDwKpd.jpg", url:"https://themoviedb.org/person/77553"}}, {tmdbId:"1344406", properties:{imdbId:"0936087", name:"Sandy Winton", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wtN7wD0vIf32booXrMslABxyE1C.jpg", url:"https://themoviedb.org/person/1344406"}}, {tmdbId:"1028560", properties:{bornIn:" Sydney, Australia", imdbId:"0832227", born:date('1985-03-06'), name:"Yael Stone", bio:"Yael Stone is an Australian actress.  She has worked extensively in Australian theatre and has won two Sydney Theatre Awards.  Outside of Australian theatre, she is best known for her portrayal of Lorna Morello in the Netflix series Orange Is the New Black...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fTKw7YSDZSaLsZKZLODtlIkNoIN.jpg", url:"https://themoviedb.org/person/1028560"}}, {tmdbId:"18471", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0026364", born:date('1970-08-15'), name:"Anthony Anderson", bio:"Anthony Anderson (born August 15, 1970) is an American actor, comedian, and writer.  He has starred in his own sitcom All About the Andersons, as well as the Fox sitcom The Bernie Mac Show during the fifth and final season of the show.  He is also known for his leading roles in television dramas such as K-Ville, The Shield and Law & Order.  He has also had supporting roles in films such as Transformers, The Departed, Agent Cody Banks 2: Destination London and Scream 4...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/reO1OjwFdtXmiO4LMDaBj6eatzK.jpg", url:"https://themoviedb.org/person/18471"}}, {tmdbId:"21802", properties:{imdbId:"0115236", name:"Mongo Brownlee", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/chHO4vrhTtngLPrU01ngN7MP5v9.jpg", url:"https://themoviedb.org/person/21802"}}, {tmdbId:"58531", properties:{imdbId:"0716452", name:"Molly Regan", url:"https://themoviedb.org/person/58531"}}, {tmdbId:"27855", properties:{bornIn:"Honolulu, Hawaii, USA", imdbId:"0815370", born:date('1978-10-03'), name:"Shannyn Sossamon", bio:"Shannon Sossamon (born October 3, 1978) is an American film and television actress, dancer, model, and musician, best known for starring in feature films such as \"A Knight's Tale\" and \"Wristcutters: A Love Story\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nJUFCRm7Y0YVR3GQ8GSZUzDavH1.jpg", url:"https://themoviedb.org/person/27855"}}, {tmdbId:"6162", properties:{bornIn:"Harlesden, London, England, UK ", imdbId:"0079273", born:date('1971-05-27'), name:"Paul Bettany", bio:"Paul Bettany was born into a theatre family.  His father, Thane Bettany, is still an actor but his mother, Anne Kettle, has retired from acting.  His maternal grandmother, Olga Gwynne, was a successful actress, while his maternal grandfather, Lesley Kettle, was a musician and promoter.  He was brought up in North West London and, after the age of 9, in Hertfordshire (Brookmans Park)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vcAVrAOZrpqmi37qjFdztRAv1u9.jpg", url:"https://themoviedb.org/person/6162"}}, {tmdbId:"23944", properties:{bornIn:"Stockholm, Stockholms län, Sweden", imdbId:"0803558", born:date('1968-09-13'), name:"Emma Wiklund", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1Frf4bFhnHyZCsZkPFTkQjCfSe9.jpg", url:"https://themoviedb.org/person/23944"}}, {tmdbId:"40979", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0005080", born:date('1979-01-29'), name:"Andrew Keegan", bio:"Andrew Keegan (born January 29, 1979) is an American actor and producer.  He is best known for his role in 10 Things I Hate About You...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4QWgKVO8tgOiyzxZeGoGfVLJcOo.jpg", url:"https://themoviedb.org/person/40979"}}, {tmdbId:"554093", properties:{imdbId:"0835893", born:date('1970-11-14'), name:"Dana Stubblefield", url:"https://themoviedb.org/person/554093"}}, {tmdbId:"32751", properties:{bornIn:"Edmonton, Alberta, Canada", imdbId:"0009811", born:date('1957-09-19'), name:"Mark Acheson", bio:"From Wikipedia, the free encyclopedia\n\nMark Acheson (born September 19, 1957) is a Canadian film, television and voice actor. \n\nAt 15 Acheson began studying acting at Langara College’s Studio 58.  Founding member of Janus Theatre and appeared on stage for eight years including a full season at the Arts Club as well as The NewPlay center, Carousel Theatre, Western Canadian theater in Kamloops,Sunshine theatre in Kelowna and The Belfry in Victoria and StageWest in Edmonton...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gY6VEIa7BoLjzMCaO3slSnocuah.jpg", url:"https://themoviedb.org/person/32751"}}, {tmdbId:"554278", properties:{imdbId:"0581266", name:"Brandon Merrill", url:"https://themoviedb.org/person/554278"}}, {tmdbId:"958", properties:{bornIn:"Gavà, Barcelona, Catalonia, Spain", imdbId:"0679150", born:date('1973-07-14'), name:"Candela Peña", bio:"From Wikipedia, the free encyclopedia.   María del Pilar Peña Sánchez, (Candela Peña) (born 14 July 1973 in Gavà, Barcelona, Catalonia, Spain) is a Spanish actress.   She was the only child of a couple who had a bar in Barcelona.  When she was four years old she started to learn dance in the city and after finishing high-school she went to Seville to begin theatre classes there and eventually in Madrid.  Encouraged by Pedro Almodóvar, she published the novel Pérez Príncipe, María Dolores in 2001...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dEVevcKQrgTJ9IQ9i7GF0GiNg47.jpg", url:"https://themoviedb.org/person/958"}}, {tmdbId:"961", properties:{bornIn:"Las Palmas, Canary Islands, Spain", imdbId:"0760665", born:date('1961-05-22'), name:"Antonia San Juan", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xODgCoDHHirOgv7BZj17UwCxsJx.jpg", url:"https://themoviedb.org/person/961"}}, {tmdbId:"20186", properties:{bornIn:"St. John's Wood, London, England, UK", imdbId:"0507073", born:date('1971-02-11'), name:"Damian Lewis", bio:"Damian Watcyn Lewis (born 11 February 1971) is an English actor and producer.  He is probably best known in the United States for starring as Detective Charlie Crews in the NBC drama Life as well as portraying Major Richard Winters in the HBO miniseries Band of Brothers. \n\nDescription above from the Wikipedia article Damian Lewis, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qm4M15FTUmuf1j8Kp3M7p0LaqC2.jpg", url:"https://themoviedb.org/person/20186"}}, {tmdbId:"26851", properties:{bornIn:"Upper Darby, Pennsylvania, USA", imdbId:"0231946", born:date('1974-12-22'), name:"Heather Donahue", bio:"From Wikipedia, the free encyclopedia. \n\nHeather Donahue (born December 22, 1974) is an American actress who first came to public attention after appearing as the lead character in Haxan Film's 1999 surprise horror hit The Blair Witch Project.  Following the success of the film, she went on to appear in an array of independent films, as well as guest appearances on several television shows, most notably for her starring role in the science fiction miniseries Taken...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Ootqoaw1eJF9cJ38FfAgblgJjh.jpg", url:"https://themoviedb.org/person/26851"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"26852", properties:{bornIn:"Houston, Texas, USA", imdbId:"0502671", born:date('1975-06-17'), name:"Joshua Leonard", bio:"Joshua Leonard is an American film and television writer, director and actor, best known for his debut role in the feature indie film \"The Blair Witch Project\" and many other supporting roles in film and television...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5ixyAcgWAHH5yQvgbD8L1VKAI68.jpg", url:"https://themoviedb.org/person/26852"}}, {tmdbId:"26853", properties:{bornIn:"The Bronx, New York, USA", imdbId:"0931321", born:date('1973-07-25'), name:"Michael C. Williams", bio:"From Wikipedia, the free encyclopedia. \n\nMichael C.  Williams (born July 25, 1973) is an American actor, famous for his role (using his own name) in The Blair Witch Project.  Williams also appeared on Law &amp; Order in February 2000 as a man whose ex-wife killed their son.  Williams also appeared in The Objective. \n\nWilliams was born in The Bronx, New York and attended Westlake High School in Thornwood, New York.  He graduated from SUNY New Paltz...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j9vjZt0gMqzOz977f3rDhFuRpM.jpg", url:"https://themoviedb.org/person/26853"}}, {tmdbId:"25878", properties:{bornIn:"Wabush, Newfoundland, Canada", imdbId:"0236495", born:date('1968-01-01'), name:"Shawn Doyle", bio:"​From Wikipedia, the free encyclopedia.   \n\nShawn Doyle (born 1968) is a Canadian actor. \n\nDoyle was born and raised in Wabush, Newfoundland, the son of actor Jerry Doyle.  He moved to Toronto to study theatre at York University. \n\nHe has won three awards for his critically acclaimed performance as Dennis Langley in The Eleventh Hour.  Since moving to Los Angeles, he has also starred in the American shows 24 as Ronnie Lobell, Desperate Housewives as Mr.  Hartley and as Joey Henrickson in Big Love...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eH2JS1ztMoq0lvhPsFfD4KCBEiL.jpg", url:"https://themoviedb.org/person/25878"}}, {tmdbId:"1070313", properties:{imdbId:"2333828", name:"Robert Michael Kelly", url:"https://themoviedb.org/person/1070313"}}, {tmdbId:"1326545", properties:{imdbId:"0782158", name:"Compay Segundo", url:"https://themoviedb.org/person/1326545"}}, {tmdbId:"1196996", properties:{imdbId:"0643733", name:"Eliades Ochoa", url:"https://themoviedb.org/person/1196996"}}, {tmdbId:"6918", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0176839", born:date('1947-03-15'), name:"Ry Cooder", bio:"Ryland \"Ry\" Peter Cooder is an American prominent guitarist, singer and composer.  He is known for his slide guitar work, his interest in blues-rock, roots music from his native North America, and for his collaborations with traditional musicians from many countries. \n\nCooder's solo work has been an eclectic mix, taking in dust bowl folk, blues, Tex-Mex, soul, gospel, rock, and much else...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bHxTP9V9s67uveh651EvWl7He77.jpg", url:"https://themoviedb.org/person/6918"}}, {tmdbId:"70474", properties:{bornIn:"Santa Monica, California, USA", imdbId:"0176837", born:date('1978-08-23'), name:"Joachim Cooder", url:"https://themoviedb.org/person/70474"}}, {tmdbId:"80109", properties:{bornIn:"San Francisco, California, USA", imdbId:"0005448", born:date('1980-12-19'), name:"Marla Sokoloff", bio:"Marla Lynne Sokoloff (born December 19, 1980) is an American actress and musician, known for playing the part of Lucy Hatcher on the show The Practice, and Gia Mahan on the ABC sitcom Full House. \n\nDescription above from the Wikipedia article Marla Sokoloff, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dM8ea9YE6lWKSOPp8zTbAhqvtDj.jpg", url:"https://themoviedb.org/person/80109"}}, {tmdbId:"27755", properties:{bornIn:"Perth, Western Australia, Australia", imdbId:"0313534", born:date('1976-08-06'), name:"Melissa George", bio:"Melissa Suzanne George (born 6 August 1976) is an Australian film and television actress who has worked in Australia, the United Kingdom and the United States.  Melissa is perhaps best known for her role as Angel Parrish on the Australian soap opera Home and Away.  The show was followed for appearances in the series, including Roar and Thieves.  Melissa also has appeared in the hit shows Alias and In Treatment...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lEpEsP8CtXZRrz1693acGi5cK9e.jpg", url:"https://themoviedb.org/person/27755"}}, {tmdbId:"8211", properties:{bornIn:"Newport, Rhode Island, USA", imdbId:"0002546", born:date('1979-02-13'), name:"Mena Suvari", bio:"Mena Alexandra Suvari (born February 13, 1979) is an American actress, fashion designer, and model.  Shortly after beginning her career as a model, she soon transitioned into acting after appearing in guest roles on 1990's television shows such as Boy Meets World and High Incident.  She made her film debut in the 1997 drama film Nowhere...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x9sNSSb6kzwbjud4YSonRvZhRKk.jpg", url:"https://themoviedb.org/person/8211"}}, {tmdbId:"90772", properties:{imdbId:"0832653", born:date('1984-04-08'), name:"Kirsten Storms", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hnM40jZeoPKXjIRhVh2wg3PU6No.jpg", url:"https://themoviedb.org/person/90772"}}, {tmdbId:"66896", properties:{bornIn:"Atlanta, Georgia, USA", imdbId:"0712368", born:date('1985-12-10'), name:"Raven-Symoné", bio:"Raven-Symoné Christina Pearman (born December 10, 1985 in Atlanta, Georgia), known professionally as Raven-Symoné, or simply Raven, is an American actress, singer, songwriter, comedian, dancer, television producer and model.  Symone launched her successful career in 1989 after appearing in the show A Different World as Olivia.  She released her debut album, Here's to New Dreams in 1993; the single, \"That's What Little Girls Are Made Of\" charted number sixty-eight on the US Billboard Hot 100...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wgfSDndjDTObLAYWvG04ppyc8xK.jpg", url:"https://themoviedb.org/person/66896"}}, {tmdbId:"104803", properties:{imdbId:"0298104", name:"Holly Fulger", url:"https://themoviedb.org/person/104803"}}, {tmdbId:"67579", properties:{imdbId:"0249962", name:"Edward Edwards", url:"https://themoviedb.org/person/67579"}}, {tmdbId:"58497", properties:{imdbId:"0189278", name:"T.J. Cross", url:"https://themoviedb.org/person/58497"}}, {tmdbId:"11953", properties:{bornIn:"Berlin-Kreuzberg, West Germany", imdbId:"0299811", born:date('1972-01-17'), name:"Benno Fürmann", bio:"​From Wikipedia, the free encyclopedia\n\nBenjamin \"Benno\" Fürmann (born 17 January 1972) is a German film and television actor. \n\nDescription above from the Wikipedia article Benno Fürmann, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nYSvyEu2FJhEudXP3pei5Qbgnt8.jpg", url:"https://themoviedb.org/person/11953"}}, {tmdbId:"28361", properties:{bornIn:"Brandenburg, Germany", imdbId:"0519756", born:date('1970-11-18'), name:"Anna Loos", url:"https://themoviedb.org/person/28361"}}, {tmdbId:"6268", properties:{bornIn:"Bergisch-Gladbach - North Rhine-Westphalia - Germany", imdbId:"0088935", born:date('1972-05-24'), name:"Sebastian Blomberg", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2Gxb6H5ujan1lfpXQkzW1U9D71O.jpg", url:"https://themoviedb.org/person/6268"}}, {tmdbId:"10839", properties:{bornIn:"Santiago - Chile", imdbId:"0007237", born:date('1972-12-29'), name:"Leonor Varela", bio:"Leonor Varela Palma (born December 29, 1972) is a Chilean actress and model.  She played the character Cleopatra in the 1999 film Cleopatra.  She also has actively participated in various ecological causes such as \"Save Whales Again\". \n\nDescription above from the Wikipedia article Leonor Varela, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ooZQvMganzssNGoTKaIgFXM38U7.jpg", url:"https://themoviedb.org/person/10839"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"171544", properties:{imdbId:"0570487", name:"Thomas McHugh", url:"https://themoviedb.org/person/171544"}}, {tmdbId:"196714", properties:{name:"Fred Newman", url:"https://themoviedb.org/person/196714"}}, {tmdbId:"115502", properties:{imdbId:"0680303", name:"Chris Phillips", url:"https://themoviedb.org/person/115502"}}, {tmdbId:"58521", properties:{imdbId:"0795723", born:date('1958-04-04'), name:"Constance Shulman", url:"https://themoviedb.org/person/58521"}}, {tmdbId:"127293", properties:{imdbId:"0275509", name:"Richard Feynman", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hHRIn11A69oDvZtgc3vHXmF5k65.jpg", url:"https://themoviedb.org/person/127293"}}, {tmdbId:"44999", properties:{bornIn:"Itta Bena, Mississippi, USA", imdbId:"0454475", born:date('1925-09-16'), name:"B.B. King", bio:"​From Wikipedia, the free encyclopedia.   \n\nRiley B.  King (born September 16, 1925), known by the stage name B. B.  King, is an American blues guitarist and singer-songwriter acclaimed for his expressive singing and fluid, complex guitar playing. \n\nRolling Stone magazine ranked him at #3 on its list of the \"100 greatest guitarists of all time\".  According to Edward M...", died:date('2015-05-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/adlMmFV2EPGKzt5QDhrf2EOs3Ff.jpg", url:"https://themoviedb.org/person/44999"}}, {tmdbId:"111424", properties:{imdbId:"0648547", name:"Kongar-ol Ondar", url:"https://themoviedb.org/person/111424"}}, {tmdbId:"111423", properties:{imdbId:"0671571", name:"Paul Pena", url:"https://themoviedb.org/person/111423"}}, {tmdbId:"115106", properties:{bornIn:"Santiago de Compostela, A Coruña, Galicia, Spain", imdbId:"0523595", born:date('1990-05-30'), name:"Manuel Lozano", bio:"Spanish child actor who at this writing (2000) has proven himself in a big movie \"La Lengua de las Mariposas\" (1999) perhaps is the best Spanish child actor of his generation.  Born in 1990, Manuel Lozano started his acting career like many other child actors, making some commercials.  When he was still 9, Manuel was chosen to play Moncho with Fernando Fernan Gomez in the Spanish critically acclaimed La Lengua de las Mariposas...", url:"https://themoviedb.org/person/115106"}}, {tmdbId:"116068", properties:{bornIn:"Touro, A Coruña, Galicia, Spain", imdbId:"0087343", born:date('1952-01-01'), name:"Uxía Blanco", bio:"Uxía Blanco was born in 1952 in Touro, A Coruña, Galicia, Spain as Uxía Blanco Iglesia.  She is an actress and director, known for Butterfly (1999), Dagon - Az elveszett sziget (2001) and Sempre Xonxa (1989)...", url:"https://themoviedb.org/person/116068"}}, {tmdbId:"116071", properties:{bornIn:"A Coruña, A Coruña, Galicia, Spain", imdbId:"0881891", born:date('1952-01-01'), name:"Gonzalo Uriarte", bio:"Gonzalo Uriarte was born in 1952 in A Coruña, A Coruña, Galicia, Spain as Gonzalo Martín Uriarte.  He is an actor, known for Pan's Labyrinth (2006), Butterfly (1999) and Libro de familia (2005)...", url:"https://themoviedb.org/person/116071"}}, {tmdbId:"66152", properties:{bornIn:"Tokyo, Japan", imdbId:"0613598", born:date('1960-03-18'), name:"Takehiro Murata", bio:"Takehiro Murata (村田雄浩 Murata Takehiro) is a Japanese actor who has appeared in various Godzilla films in both the Heisei and Millennium series, in both major roles and small cameos...", url:"https://themoviedb.org/person/66152"}}, {tmdbId:"66155", properties:{bornIn:"Kanagawa, Japan", imdbId:"0008346", born:date('1964-06-22'), name:"Hiroshi Abe", bio:"Hiroshi Abe (born June 22, 1964) is a Japanese model and actor.  He began his career as a model, but he successfully made the transition to acting, becoming one of the most regularly visible presences in Japanese media.  He is a 1988 graduate of Chuo University. \n\nDescription above from the Wikipedia article Hiroshi Abe (actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3W6eKcSxhA7WQC42n2vr2DBrvEv.jpg", url:"https://themoviedb.org/person/66155"}}, {tmdbId:"66153", properties:{bornIn:"Hiroshima, Japan", imdbId:"0632656", born:date('1972-02-16'), name:"Naomi Nishida", bio:"From Wikipedia, the free encyclopedia\n\nNaomi Nishida (born 16 February 1972 in Fukuyama, Hiroshima, Japan) is an actress.  She won the Best Supporting Actress award at the 2001 Yokohama Film Festival and at the 25th Hochi Film Award for her performance in Nabbie's Love. \n\nShe married a Japanese shoe designer in 2005, and gave birth a girl on April 7, 2008.  She has announced that she will continue working as an actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yr9lnSPW0tbLDTDdgQsVkmbfbcK.jpg", url:"https://themoviedb.org/person/66153"}}, {tmdbId:"66154", properties:{imdbId:"0840639", name:"Mayu Suzuki", url:"https://themoviedb.org/person/66154"}}, {tmdbId:"42604", properties:{bornIn:"Leeds, West Yorkshire, England, UK", imdbId:"0799591", born:date('1970-07-10'), name:"John Simm", bio:"John Simm was born on 10th July 1970 in Leeds, West Yorkshire and grew up in Nelson, Lancashire.  He attended Edge End High School, Nelson, Lancashire followed by Blackpool Drama College at 16 and the Drama Centre, London at 19.  He lives with his wife, actress Kate Magowan, and their children Ryan (born 13th August 2001) and Molly (born February 2007).  Simm won the best actor award at the Valencia Film Festival for his film debut in \"Boston Kickout\" (1996)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tTiUpHt2raPRjEIeFvIh12cRGAt.jpg", url:"https://themoviedb.org/person/42604"}}, {tmdbId:"68284", properties:{bornIn:"Dublin, Ireland", imdbId:"0683455", born:date('1974-04-18'), name:"Lorraine Pilkington", bio:"From Wikipedia, the free encyclopedia\n\nLorraine Pilkington is an Irish actress from Dublin, who is best known for her role as Katrina Finlay on Monarch of the Glen.  Trained at the Gaiety School of Acting, Pilkington began her career at the age of 15 when she appeared in The Miracle directed by Neil Jordan.  She appeared onstage in the plays The Plough and the Stars and The Iceman Cometh.  At age 18 she moved to London where she was given a part in a Miramax film which eventually fell through...", url:"https://themoviedb.org/person/68284"}}, {tmdbId:"30316", properties:{bornIn:"London, England, UK", imdbId:"0662744", born:date('1973-02-09'), name:"Shaun Parkes", url:"https://themoviedb.org/person/30316"}}, {tmdbId:"68286", properties:{bornIn:"Pontypridd, Glamorgan, Wales", imdbId:"0721885", born:date('1972-07-26'), name:"Nicola Reynolds", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bpsFdyGDNqDpOeAGgsfqebIOm0Z.jpg", url:"https://themoviedb.org/person/68286"}}, {tmdbId:"67711", properties:{bornIn:"Albuquerque, New Mexico, USA", imdbId:"0829390", born:date('1964-02-20'), name:"French Stewart", bio:"From Wikipedia, the free encyclopedia. \n\nMilton French Stewart (born February 20, 1964, height 5' 10\" (1,78 m)) better known by his stage name French Stewart is an American actor, best known for his role as Harry Solomon on the 1990s sitcom 3rd Rock from the Sun...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a8mUqejNKnuqum0OtBIn8Tr6K3b.jpg", url:"https://themoviedb.org/person/67711"}}] AS row
