UNWIND [{tmdbId:"135067", properties:{imdbId:"0337619", name:"Austin Green", url:"https://themoviedb.org/person/135067"}}, {tmdbId:"102269", properties:{bornIn:"Taean, South Chungcheong, South Korea", imdbId:"1022228", born:date('1974-09-13'), name:"Song Seon-mi", bio:"Song Seon-mi (송선미) is a South Korean actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eBqFhQm58VFfghc2l2dv438JyX3.jpg", url:"https://themoviedb.org/person/102269"}}, {tmdbId:"63563", properties:{bornIn:"Nairobi, Kenya", imdbId:"0814552", name:"Veena Sood", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yze2fvd4rvzovqyjtKbCpFaw1UM.jpg", url:"https://themoviedb.org/person/63563"}}, {tmdbId:"57949", properties:{bornIn:"Richmond, Virginia", imdbId:"0004366", born:date('1931-03-02'), name:"Tom Wolfe", bio:"Thomas Kennerly Wolfe Jr.  (March 2, 1930 – May 14, 2018) was an American author and journalist widely known for his association with New Journalism, a style of news writing and journalism developed in the 1960s and 1970s that incorporated literary techniques.   Description above from the Wikipedia article Tom Wolfe, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2018-05-14'), url:"https://themoviedb.org/person/57949"}}, {tmdbId:"89815", properties:{bornIn:"London, England, UK", imdbId:"1659661", born:date('1949-11-03'), name:"Anna Wintour", bio:"Anna Wintour, OBE (born November 3, 1949) is the British-born editor-in-chief of American Vogue, a position she has held since 1988.  With her trademark pageboy bob haircut and sunglasses, Wintour has become an institution throughout the fashion world, widely praised for her eye for fashion trends and her support for younger designers.  Her reportedly aloof and demanding personality has earned her the nickname \"Nuclear Wintour\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n14ZUjdjBkdFKDJsbvUubcYPA4i.jpg", url:"https://themoviedb.org/person/89815"}}, {tmdbId:"122662", properties:{imdbId:"0632681", name:"Kumiko Nishihara", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xe7FcmMU8n30cEJbfG0LTbHGFGq.jpg", url:"https://themoviedb.org/person/122662"}}, {tmdbId:"1126292", properties:{bornIn:"Tokyo, Japan", imdbId:"0793097", born:date('1964-11-21'), name:"Yumiko Shibata", bio:"Yumiko Shibata is a Japanese voice actress associated with the talent management firm 81 Produce.  She has voiced in a number of anime shows and video games, most notably as Maki in the Burn Up! anime series and Kan Kumanoff in Maple Town...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9ehPm6zaX8j589DfijDZvoYqDqm.jpg", url:"https://themoviedb.org/person/1126292"}}, {tmdbId:"1126293", properties:{name:"Hirokazu Hiramatsu", url:"https://themoviedb.org/person/1126293"}}, {tmdbId:"84504", properties:{bornIn:"Yamaguchi, Japan", imdbId:"0906696", born:date('1945-10-18'), name:"Norio Wakamoto", bio:"Graduated from Waseda University...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sYHA1BlH2itS3XGv9K2xjqsTFcC.jpg", url:"https://themoviedb.org/person/84504"}}, {tmdbId:"1204882", properties:{imdbId:"0703947", born:date('1937-06-20'), name:"Pat Quinn", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yhfNHTyo5Y74GpnZA3hRsLC5NA2.jpg", url:"https://themoviedb.org/person/1204882"}}, {tmdbId:"44625", properties:{imdbId:"1035138", name:"Lew Bracker", url:"https://themoviedb.org/person/44625"}}, {tmdbId:"44626", properties:{imdbId:"1035192", name:"Marvin Carter", url:"https://themoviedb.org/person/44626"}}, {tmdbId:"120689", properties:{bornIn:" Tokyo, Japan", imdbId:"1973760", born:date('1988-07-22'), name:"Yuriko Yoshitaka", bio:"Yuriko Yoshitaka (吉高 由里子, Yoshitaka Yuriko) (born July 22, 1988) is a Japanese actress who is represented by the Japanese agency Amuse.  Yoshitaka made her acting debut in 2006.  She was given the lead role in the live-action adaptation of Hitomi Kanehara's award-winning novel \"Snakes and Earrings\" in 2007.  Portraying Lui, a teenager whose life goes into a downward spiral after meeting the forked-tongued and tattooed Ama, the role was Yoshitaka's breakthrough role...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Zqd3qjiVAfNtBcMAAUNPtvYDV8.jpg", url:"https://themoviedb.org/person/120689"}}, {tmdbId:"7064", properties:{bornIn:"La Junta, Colorado, USA", imdbId:"0450181", born:date('1935-09-17'), name:"Ken Kesey", bio:"From Wikipedia, the free encyclopedia\n\nKenneth Elton \"Ken\" Kesey (September 17, 1935 – November 10, 2001) was an American author, best known for his novel One Flew Over the Cuckoo's Nest (1962), and as a counter-cultural figure who considered himself a link between the Beat Generation of the 1950s and the hippies of the 1960s.  \"I was too young to be a beatnik, and too old to be a hippie,\" Kesey said in a 1999 interview with Robert K.  Elder...", died:date('2001-11-10'), url:"https://themoviedb.org/person/7064"}}, {tmdbId:"45592", properties:{imdbId:"0052343", name:"Subir Banerjee", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dYUcCuK159NQdptALzcXwGj5JH5.jpg", url:"https://themoviedb.org/person/45592"}}, {tmdbId:"550704", properties:{imdbId:"4321800", name:"Dominique Baffier", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jHWcDWYUnKcKVFJQIBRo0fRY9BA.jpg", url:"https://themoviedb.org/person/550704"}}, {tmdbId:"559566", properties:{bornIn:"New York, New York, USA", imdbId:"1818216", born:date('1970-07-30'), name:"Peyman Maadi", bio:"Peyman Maadi (پیمان معادی) was born in 1970 in New York City to an Iranian couple.  His father was a lawyer.  Peyman Maadi's family moved back to Iran when he was 5 years old.  He graduated in Metallurgical Engineering from Karaj Azad University.  Maadi started his film career as a screenwriter in late 2000s.  He is the writer of several famous Iranian films.  Peyman Maadi started his acting career in Asghar Farhadi's film About Elly (2009)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zU7JiCpt7wXp0hNRDLoO6wEt2BM.jpg", url:"https://themoviedb.org/person/559566"}}, {tmdbId:"47983", properties:{bornIn:"Harlow, Essex, England", imdbId:"0065751", born:date('1974-04-17'), name:"Victoria Beckham", bio:"Victoria Caroline Beckham (née Adams; born 17 April 1974) is an English singer, fashion designer and businesswoman.  In the late 1990s, Beckham rose to fame with the all-female pop group Spice Girls and was dubbed Posh Spice by the July 1996 issue of the British pop music magazine Top of the Pops.  Since the Spice Girls split, she has had a solo pop music career, scoring four UK Top 10 singles...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6rILDckXRGYZyVbBq4ROLHqq37M.jpg", url:"https://themoviedb.org/person/47983"}}, {tmdbId:"58141", properties:{bornIn:"London, England, UK", imdbId:"6230258", born:date('1967-08-16'), name:"Donovan Leitch", bio:"Donovan Jerome Leitch (born 16 August 1967) is a British-born American actor.  He is a member of the band Camp Freddy, and was a founding member of neo-glam group Nancy Boy along with Jason Nesmith (son of The Monkees' Michael Nesmith).  Leitch appeared in the films . . . And God Created Woman (1988 remake), Breakin' 2: Electric Boogaloo, Glory (portraying Charles Fessenden Morse), Cutting Class, The Blob, The In Crowd, Jack the Bear and I Shot Andy Warhol, among others...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6dzq4UopKtHTpJ2PMYyK5KXXGY0.jpg", url:"https://themoviedb.org/person/58141"}}, {tmdbId:"235284", properties:{name:"Frank Sampedro", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wj7mDzVNSZIjfNRrdiA4zcIJprh.jpg", url:"https://themoviedb.org/person/235284"}}] AS row
