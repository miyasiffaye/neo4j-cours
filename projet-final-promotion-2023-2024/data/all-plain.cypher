:"558466", properties:{bornIn:"Queensland, Australia", imdbId:"3887625", born:date('1987-12-11'), name:"Alex Russell", bio:"Alex Russell is an Australian actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o1Z5Fo1wzKBGrzOsfxDq9vPbnq0.jpg", url:"https://themoviedb.org/person/558466"}}, {tmdbId:"82700", properties:{bornIn:"La Coruña, Galicia, Spain", imdbId:"1832584", born:date('1986-06-12'), name:"Mario Casas", bio:"Mario Casas, has 4 siblings.  Born in La Coruña, although very young, at just 4 years old, he left with his family to Barcelona.  Later, at the age of 18, he emigrated to the Spanish capital in an adventure in which he took his whole family with him. \n\nHis parents were very young when they had him; his mother, Heidi, was only 17 and his father, Ramon, 19.  Only a year and a half later they had their sister, so they were very young and had two children...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/y0H8jDiOZqYKZkamv2z4cV9FLsl.jpg", url:"https://themoviedb.org/person/82700"}}, {tmdbId:"1205497", properties:{imdbId:"2435667", name:"Ella Kweku", url:"https://themoviedb.org/person/1205497"}}, {tmdbId:"1188558", properties:{bornIn:"Corpus Christi, Texas, USA", imdbId:"2921091", born:date('1984-11-20'), name:"Jeremy Jordan", bio:"Jeremy Michael Jordan (born November 20, 1984) is a Tony-nominated American actor and singer.  He has performed on Broadway, in television and film, as well as in other theatrical productions.  He is known for his role of 'Jamie' in the 2014 movie adaptation of the musical, 'The Last Five Years'. \n\nHe has played the roles of Jack Kelly in the 2012 musical Newsies, Clyde Barrow in the 2011 musical Bonnie & Clyde, Dr...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/idYjWWH7LbXFxQlqJes0DWbztpf.jpg", url:"https://themoviedb.org/person/1188558"}}, {tmdbId:"130227", properties:{bornIn:"Pennsylvania, United States", imdbId:"1926948", born:date('1986-03-22'), name:"Matt Bush", bio:"From Wikipedia, the free encyclopedia. \n\nMatt Bush (born March 22, 1986) is an American actor, best known for the film Adventureland and his AT&amp;T Rollover Minutes commercials.  He stars in the TBS comedy Glory Daze as Eli, a freshman who rushes the wildest fraternity on a 1980s college campus. \n\nBush was born in Pennsylvania and raised in Cherry Hill, New Jersey.  He is of Italian descent.  His parents, Linda and Dennis Bush, run a magic act...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nV9PYSuBigTt7J3PmELuNePqoHH.jpg", url:"https://themoviedb.org/person/130227"}}, {tmdbId:"198855", properties:{bornIn:"Glendora, California, USA", imdbId:"1642004", born:date('1993-07-23'), name:"Masam Holden", url:"https://themoviedb.org/person/198855"}}, {tmdbId:"92730", properties:{bornIn:"Edinburgh, Scotland, UK", imdbId:"1717573", born:date('1979-03-15'), name:"Pollyanna McIntosh", bio:"Pollyanna McIntosh grew up in Portugal and Colombia before returning to her birthplace of Scotland, where she first began performing, on stage, at The Edinburgh Festival.  At 16, she left for London and soon became involved in indie filmmaking (her first paid gig was as a stoner in Irvine Welsh's The Acid House (1998)) and theatre, both as an actress and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n9jfF6pEutTz6qeofHFz2mxh95e.jpg", url:"https://themoviedb.org/person/92730"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"543726", properties:{imdbId:"3354777", name:"Lauren Ashley Carter", bio:"Lauren Ashley Carter is an American actress and producer.  She graduated from the University of Cincinnati – College-Conservatory of Music in 2008 and is a fan of horror and science fiction...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mBC2L5iLCjqw91w5boDYVkQFoRG.jpg", url:"https://themoviedb.org/person/543726"}}, {tmdbId:"2193888", properties:{name:"Chris Krzykowski", url:"https://themoviedb.org/person/2193888"}}, {tmdbId:"586000", properties:{bornIn:"Aberystwyth, Wales, UK", imdbId:"3665787", born:date('1985-07-17'), name:"Tom Cullen", bio:"Tom Cullen is a Welsh stage and screen actor, best known for his leading role as Russell in the feature film \"Weekend\".  He graduated from the Royal Welsh College of Music and Drama, Cardiff, Wales, UK...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c3WqIFRXA6EhU6h2etA6O9u6Xnz.jpg", url:"https://themoviedb.org/person/586000"}}, {tmdbId:"586001", properties:{imdbId:"2773325", name:"Chris New", bio:"CHRIS (Glen) trained at RADA and since graduating in 2006 has built up an impressive reputation for his stage work.  He started opposite Alan Cumming in the 2006 revival of Martin Sherman’s iconic play ‘Bent’ for which he was nominated for the Evening Standard Award for Outstanding Newcomer.  He then went on to work at the National Theatre, under the direction of Richard Eyre as well as The RSC, The Young Vic and London Sadler’s Wells...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2maQpMIsd5cDncWDWOc8BJtPp4X.jpg", url:"https://themoviedb.org/person/586001"}}, {tmdbId:"1562478", properties:{name:"Jonathan Race", url:"https://themoviedb.org/person/1562478"}}, {tmdbId:"1482847", properties:{imdbId:"3631876", name:"Laura Freeman", url:"https://themoviedb.org/person/1482847"}}, {tmdbId:"515875", properties:{bornIn:"Cape Town - South Africa", imdbId:"2788229", born:date('1981-12-02'), name:"Lesley-Ann Brandt", bio:"Born and raised in Cape Town, South Africa, Lesley-Ann Brandt has shot to stardom rapidly in New Zealand.  She immigrated to Auckland with her parents and younger brother in 1999.  Her unusual path to acting has seen her go from IT Recruitment Consultant to landing the lead role in the hit comedy series 'Diplomatic Immunity', starring alongside Craig Parker (of Spartacus, Lord of the Rings and Underworld: Rise of the Lycans), quickly moving her into the hearts of the nation...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fKCs8ANOPojfWXerhJ8aDX9fJZI.jpg", url:"https://themoviedb.org/person/515875"}}, {tmdbId:"1203030", properties:{imdbId:"2527406", name:"Aaron Glenane", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8k3Y6fG2woivGN4rniNI6vXUZbR.jpg", url:"https://themoviedb.org/person/1203030"}}, {tmdbId:"218948", properties:{bornIn:"Guildford, Surrey, England, UK", imdbId:"3020713", born:date('1984-08-19'), name:"Simon Bird", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c626edNGkm1WfJB6Cm7ufc3wkeJ.jpg", url:"https://themoviedb.org/person/218948"}}, {tmdbId:"207321", properties:{bornIn:"Croydon, England, UK", imdbId:"0118617", born:date('1987-08-14'), name:"James Buckley", bio:"James Patrick Buckley (born 14 August 1987, Croydon, England) is an English stand-up comedian, actor, musician and YouTuber.  He is known for playing Jay Cartwright in the BAFTA-winning E4 sitcom The Inbetweeners. \n\nBuckley was born in Croydon, where he attended Thornton School.  It was here, while taking part in school plays, that Buckley found out how much he enjoyed performing and, from the age of seven, started going to a stage school at the weekends...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dDVwMhnWGEICmfwjNh2eOxqb9f2.jpg", url:"https://themoviedb.org/person/207321"}}, {tmdbId:"222068", properties:{bornIn:"Peckham, London, England, UK", imdbId:"3002919", born:date('1985-06-23'), name:"Blake Harrison", bio:"Blake Harrison Keenan, better known as Blake Harrison (born 22 July 1985), is an English actor, best known for playing Neil Sutherland in the E4 comedy The Inbetweeners. \n\nBlake starred in three series and two subsequent films of the multi-award winning comedy The Inbetweeners.  Harrison's other television work includes the BBC Three Comedy Way to Go and Him & Her, Comedy Central's Big Bad World, The Bleak Old Shop of Stuff, and The Bill...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nySNwcX863hwevtLbJPOdlTLftf.jpg", url:"https://themoviedb.org/person/222068"}}, {tmdbId:"1240639", properties:{bornIn:"Chelmsford, Essex, England, UK", imdbId:"3022504", born:date('1983-10-28'), name:"Joe Thomas", bio:"Joseph \"Joe\" Thomas (born 28 October 1983) is an English actor.  He is best known for playing Simon Cooper in the E4 sitcom The Inbetweeners and Kingsley Owen in the Channel 4 comedy-drama series Fresh Meat...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9hLyKTTauKa0gnmDAaEQahg0zyI.jpg", url:"https://themoviedb.org/person/1240639"}}, {tmdbId:"928908", properties:{imdbId:"2579443", name:"Michael Hall D'Addario", url:"https://themoviedb.org/person/928908"}}, {tmdbId:"930214", properties:{imdbId:"3598337", name:"Rachel Hendrix", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xto1ZBHioATH1dLWcLOP6eKgB4f.jpg", url:"https://themoviedb.org/person/930214"}}, {tmdbId:"930215", properties:{imdbId:"3600327", name:"Jason Burkey", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wdiwFFH5xSx8AquNFRSwL5lUH0J.jpg", url:"https://themoviedb.org/person/930215"}}, {tmdbId:"55779", properties:{bornIn:"Mount Kisco, New York, U.S.", imdbId:"0773884", born:date('1960-04-08'), name:"John Schneider", bio:"John Schneider (born April 8, 1960) is an American actor and singer.  He is best known for his portrayal of Bo Duke in the 1980s American television series The Dukes of Hazzard, and as Jonathan Kent on Smallville, a 2001 television adaptation of Superman.  Alongside his acting career, Schneider performed as a country music singer in the 1980s, releasing nine studio albums and a greatest hits package, as well as eighteen singles...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c3cM4MuGSfDFQScZsYyWzVkD0pp.jpg", url:"https://themoviedb.org/person/55779"}}, {tmdbId:"1141384", properties:{imdbId:"3046705", name:"Lucy Walters", bio:"Lucy Walters is an actress. \n\nAwards Won: Tallgrass International Film Festival (2016), Golden Strands winner for Outstanding Female Performer...", url:"https://themoviedb.org/person/1141384"}}, {tmdbId:"2063665", properties:{name:"Mari-Ange Ramirez", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dxgU2G0SuZ9K5mMxmPNA1eyrJlj.jpg", url:"https://themoviedb.org/person/2063665"}}, {tmdbId:"563570", properties:{imdbId:"2293451", name:"Cristian Valencia", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1CJyr00qifpyVcb5c8pgfy1cjSJ.jpg", url:"https://themoviedb.org/person/563570"}}, {tmdbId:"563569", properties:{imdbId:"1280791", name:"Chus Pereiro", url:"https://themoviedb.org/person/563569"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"135482", properties:{imdbId:"2602328", name:"Bel Deliá", url:"https://themoviedb.org/person/135482"}}, {tmdbId:"81332", properties:{imdbId:"1500343", name:"Andy Rodoreda", url:"https://themoviedb.org/person/81332"}}, {tmdbId:"42182", properties:{imdbId:"0205508", name:"Steve Davis", url:"https://themoviedb.org/person/42182"}}, {tmdbId:"135483", properties:{bornIn:"Adelaide, South Australia, Australia", imdbId:"2315197", born:date('1984-01-24'), name:"Luke Arnold", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/b19aJzhUAfyQXd0mtmDvLAyOth8.jpg", url:"https://themoviedb.org/person/135483"}}, {tmdbId:"237455", properties:{bornIn:"Ipswich, Suffolk, UK", imdbId:"3510471", born:date('1986-06-27'), name:"Sam Claflin", bio:"Samuel George \"Sam\" Claflin (born 27 June 1986) is an English actor, perhaps best known for his role in Pirates of the Caribbean: On Stranger Tides. \n\nClaflin was born in Norwich, Norfolk.  His father is an accountant/financial manager and his mother is a classroom assistant.  In 2010, Claflin appeared on the television series The Pillars of the Earth and Any Human Heart...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5DtmRlRZc7wPbat1INQPqsxaH4a.jpg", url:"https://themoviedb.org/person/237455"}}, {tmdbId:"931611", properties:{bornIn:"Stockholm, Sweden", imdbId:"1715257", born:date('1978-08-22'), name:"Malin Crépin", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fVSMMwh9Au3zZwTxhGzpDAjFM9z.jpg", url:"https://themoviedb.org/person/931611"}}, {tmdbId:"1668753", properties:{name:"Aksel Thanke", url:"https://themoviedb.org/person/1668753"}}, {tmdbId:"574243", properties:{imdbId:"1282571", name:"Hans Olav Brenner", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/b1KniLUbYuys1U7CXMpIYSrOhXI.jpg", url:"https://themoviedb.org/person/574243"}}, {tmdbId:"177", properties:{bornIn:"Bear Creek, North Carolina, USA ", imdbId:"1626256", born:date('1982-11-20'), name:"Margo Stilley", bio:"Margo Stilley (born November 20, 1982) is an American actress and former model. \n\nDescription above from the Wikipedia article Margo Stilley, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nUuhYYiKp1Ii0S25PqSxQjfYKMk.jpg", url:"https://themoviedb.org/person/177"}}, {tmdbId:"141999", properties:{bornIn:"Farsund, Norway", imdbId:"0422151", born:date('1954-07-21'), name:"Otto Jespersen", bio:"Otto Jespersen (born 21 July 1954) is a controversial Norwegian comedian, actor and television personality. \n\nDescription above from the Wikipedia article Otto Jespersen (comedian), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5O5DgCs0kOy9kgxZJEAKULvgbOA.jpg", url:"https://themoviedb.org/person/141999"}}, {tmdbId:"142004", properties:{imdbId:"3331177", name:"Glenn Erland Tosterud", url:"https://themoviedb.org/person/142004"}}, {tmdbId:"142001", properties:{imdbId:"2943075", name:"Johanna Mørck", bio:"Johanna Mørck is a Norwegian actress.  She is best known for the features Troll Hunter (2010) and Cold Prey II (2008)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yBIyKrzDW0VlNXcMJNdaNRdTvlB.jpg", url:"https://themoviedb.org/person/142001"}}, {tmdbId:"87880", properties:{imdbId:"2274210", name:"Tomas Alf Larsen", bio:"​Tomas Alf Larsen is an actor, director, and writer.   He wrote and directed the short film Congratulations (2010).   He has had roles in Trollhunter (2010), Cold Prey (2006), Cold Prey II (2008)...", url:"https://themoviedb.org/person/87880"}}, {tmdbId:"163906", properties:{bornIn:"Royal Oak - Michigan - USA", imdbId:"1674464", born:date('1972-05-12'), name:"Erin Dilly", url:"https://themoviedb.org/person/163906"}}, {tmdbId:"61510", properties:{imdbId:"1706832", name:"Christopher Denham", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ffPY0KrV5KP9Nuv27m3JQU6j3Tq.jpg", url:"https://themoviedb.org/person/61510"}}, {tmdbId:"18516", properties:{imdbId:"1656122", name:"Nicole Vicius", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2fbnlg9qosZ8k5GIQWb5pR8oqgp.jpg", url:"https://themoviedb.org/person/18516"}}, {tmdbId:"75620", properties:{imdbId:"0568672", born:date('1961-02-21'), name:"Davenia McFadden", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/edoxqYrRPUHb7YJ3b5Ijwwn0Yan.jpg", url:"https://themoviedb.org/person/75620"}}, {tmdbId:"40039", properties:{bornIn:"Diana, West Virginia, USA", imdbId:"1577637", born:date('1977-02-06'), name:"Josh Stewart", bio:"From Wikipedia, the free encyclopedia. \n\nJoshua Regnall Stewart (born February 6, 1977) is an American actor best known for his role as Holt McLaren in the FX TV series Dirt...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vZm8QSMhDq6GMZgdgV3uIxi44TR.jpg", url:"https://themoviedb.org/person/40039"}}, {tmdbId:"1011107", properties:{bornIn:"Marion Ohio, USA", imdbId:"3500747", born:date('1985-03-20'), name:"Emma Fitzpatrick", bio:"Actress / Performer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1Jh67wJnYX55UWPHIYr7Yk9MpEJ.jpg", url:"https://themoviedb.org/person/1011107"}}, {tmdbId:"550680", properties:{bornIn:"Sheboygan, Wisconsin, U.S.", imdbId:"0105131", name:"Buck Brannaman", bio:"From Wikipedia, the free encyclopedia. \n\nDan M.  \"Buck\" Brannaman is a horse trainer and a leading practitioner within the field of Natural horsemanship, which is a philosophy of working with horses based on the idea of working with the horse's nature, using an understanding of how horses think and communicate to train the horse to accept humans and work confidently and responsively with them...", url:"https://themoviedb.org/person/550680"}}] AS row
