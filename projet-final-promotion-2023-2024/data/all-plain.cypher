UNWIND [{tmdbId:"497796", properties:{bornIn:"Orlando, Florida, USA", imdbId:"2367823", born:date('1979-11-28'), name:"Brian Nolan", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nAne0D5M9q5QWO4ah6nl2NBKAM7.jpg", url:"https://themoviedb.org/person/497796"}}, {tmdbId:"150028", properties:{imdbId:"3868604", name:"Linda Doudaeva", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8i6iHFlrhl1JjbBO0cc5jF24JEx.jpg", url:"https://themoviedb.org/person/150028"}}, {tmdbId:"1158460", properties:{imdbId:"3868433", name:"Jules Ritmanic", url:"https://themoviedb.org/person/1158460"}}, {tmdbId:"1158461", properties:{imdbId:"3868594", name:"Louna Klanit", url:"https://themoviedb.org/person/1158461"}}, {tmdbId:"1142720", properties:{bornIn:"Portland, Oregon, USA", imdbId:"3287038", born:date('1991-09-27'), name:"Thomas Mann", bio:"Thomas Randall Mann, Jr.  (born September 27, 1991) is an American actor.  He is known for his roles in the films Project X (2012), Hansel & Gretel: Witch Hunters (2013), Me and Earl and the Dying Girl (2015), and Kong: Skull Island (2017)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cJO10vU19SL82pgMB6LdAijDSJv.jpg", url:"https://themoviedb.org/person/1142720"}}, {tmdbId:"225694", properties:{bornIn:"Toledo, Ohio, USA", imdbId:"3967796", born:date('1989-01-01'), name:"Oliver Cooper", bio:"Oliver Cooper was born on December 2, 1989 in Toledo, Ohio.  In 2009, at the age of 19, he moved to Los Angeles to pursue a career as an actor and quickly landed an internship at CONAN.  While taking an acting class, a fellow classmate told him that Warner Brothers was looking for fresh young faces to star in the Todd Phillips produced Project X and that Cooper would be perfect.  With no representation, Oliver enlisted his friend, a former child star, Shaun Weiss, to help him secure an audition...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dZyCpnWaW7gkTWOyhGUgg1xy19y.jpg", url:"https://themoviedb.org/person/225694"}}, {tmdbId:"225695", properties:{bornIn:"Tarzana, California, USA", imdbId:"3967854", name:"Jonathan Daniel Brown", bio:"Jonathan Daniel Brown is an American actor and director.  He is the star of Kid Cannabis and got his start with the role of J.  B.  in Project X.  Brown was offered one of the lead roles in the film Project X after a national open casting call.  He, Thomas Mann and Oliver Cooper were three unknown actors when cast in the film. \n\nIn 2014, he starred in the lead role in the film Kid Cannabis.  In 2017, his directorial debut Horseshoe Theory received a jury prize award at the Slamdance Film Festival...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xDsPJNDnrn3N0jelVrxdOchzhoo.jpg", url:"https://themoviedb.org/person/225695"}}, {tmdbId:"996700", properties:{bornIn:"United States", imdbId:"3967702", born:date('1991-11-05'), name:"Dax Flame", bio:"Madison Patrello, better known online as Daxflame, is an American YouTube Vlogger and actor, who joined YouTube in 2007.  some of his known movie credits are 21 Jump Street (2012), Project X (2012), and 22 Jump Street (2014)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z4maTsn8UfJ1QSWxA72EpJWZvO4.jpg", url:"https://themoviedb.org/person/996700"}}, {tmdbId:"1011100", properties:{imdbId:"3618685", born:date('2002-01-01'), name:"Shyloh Oostwald", bio:"Shyloh Oostwald honed her craft in lead roles in several Indy films.  \n\nOn television, her first role was on iCarly when she was age 7, followed\n\n by several guest starring roles on shows such as House, Criminal Minds:\n\n Suspect Behavior, The Event and Happy Endings etc.  On one film she had \n\nto learn to speak Romanian - which she mastered within two weeks. \n\nShe\n\n loves animals and going to her performing arts magnet school...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lJ11SX8pSBw6ElVVXkifoOO6oMX.jpg", url:"https://themoviedb.org/person/1011100"}}, {tmdbId:"1648755", properties:{imdbId:"0838267", name:"Nick Sullivan", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w4XM6Z6avGqlLRERKrLc2R5ZzrG.jpg", url:"https://themoviedb.org/person/1648755"}}, {tmdbId:"1723660", properties:{name:"Francesca Papalia", url:"https://themoviedb.org/person/1723660"}}, {tmdbId:"17449", properties:{bornIn:"Oxnard, California, USA", imdbId:"0827307", born:date('1967-05-18'), name:"Bob Stephenson", bio:"Bob Stephenson is an American film and television actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AczLnt4baxBT4gqSroSjCqD7S9D.jpg", url:"https://themoviedb.org/person/17449"}}, {tmdbId:"74949", properties:{bornIn:"Rome, Lazio, Italy", imdbId:"0570364", born:date('1971-11-20'), name:"Joel McHale", bio:"Joel Edward McHale (born November 20, 1971) is an Italian-American stand-up comedian, actor, writer, television producer, television personality, and voice artist.  He is best known for hosting The Soup and for his role as Jeff Winger on Community. \n\nMcHale's role as a voice actor includes Elliot in Open Season 2, filling in for Ashton Kutcher.  He also appeared in Spider-Man 2 in a cameo appearance as bank manager Mr...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jFtqHLCrmGSIJtwdxloO3KM98iC.jpg", url:"https://themoviedb.org/person/74949"}}, {tmdbId:"1178738", properties:{bornIn:"Téhéran, Iran", imdbId:"1454306", born:date('1953-11-11'), name:"Hamid Djavadan", bio:"Hamid Réza Javdan débute sa carrière aux Etats-Unis en 1976, au sein du Théâtre Iranien et du Living Théâtre.  Il poursuit sa formation au Canada en étudiant la Comédia dell’Arte et d’autres formes théâtrales telles que le masque et l’art martial Bâlinais, la danse, le maquillage, le chant ; en France il travaille à la Cartoucherie de Vincennes ainsi qu’avec d’autres compagnies.  Il met en scène de nombreuses pièces de théâtre et joue aussi en qualité d’acteur de cinéma...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xIa7nvR64z3m7y8Q7udwc08TKBL.jpg", url:"https://themoviedb.org/person/1178738"}}, {tmdbId:"1178739", properties:{imdbId:"4947025", name:"Hassina Burgan", url:"https://themoviedb.org/person/1178739"}}, {tmdbId:"1178740", properties:{imdbId:"4947057", name:"Massi Mrowat", url:"https://themoviedb.org/person/1178740"}}, {tmdbId:"1133349", properties:{bornIn:"Paris, France", imdbId:"4456120", born:date('1990-08-24'), name:"Elizabeth Debicki", bio:"Elizabeth Debicki (born 24 August 1990) is an Australian actress.  After making her feature film debut in A Few Best Men (2011), she appeared in The Great Gatsby (2013) as Jordan Baker.  Other roles are in the limited series The Night Manager (2016) and Widows (2018)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sJxj44aKdY0pjSIgnxBgMWLrQmw.jpg", url:"https://themoviedb.org/person/1133349"}}, {tmdbId:"1332680", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"2499064", born:date('1981-02-10'), name:"Uzo Aduba", bio:"Uzo Aduba is an American film and television actress, best known for playing regular character Suzanne \"Crazy Eyes\" Warren on the television series \"Orange Is the New Black\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iXaNDjNqKfTVL3DLD27OPNQ7QzT.jpg", url:"https://themoviedb.org/person/1332680"}}, {tmdbId:"1180166", properties:{imdbId:"3395644", name:"Pasha Ebrahimi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sFSMPVes4wDbeqgksaiRjTKFo7K.jpg", url:"https://themoviedb.org/person/1180166"}}, {tmdbId:"117458", properties:{bornIn:"St. John's, Newfoundland, Canada", imdbId:"0235978", born:date('1944-10-31'), name:"Brian Downey", bio:"From Wikipedia, the free encyclopedia. \n\nBrian Downey (born 31 October 1944 in Newfoundland, Canada) is a Canadian actor perhaps best-known for his portrayal of Stanley Tweedle, in the science-fiction television series Lexx. \n\nDowney is a character actor who has appeared in various films and guest starring roles on TV, including a recurring role on Millennium.  His first film role was in a 1986 Andy Jones film called The Adventure of Faustus Bidgood, which features the entire cast of CODCO...", url:"https://themoviedb.org/person/117458"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"84224", properties:{bornIn:"Pasadena - California - USA", imdbId:"1589312", born:date('1990-09-21'), name:"Christian Serratos", bio:"Born and raised in Southern California, Christian knew from an early age that she wanted to be an actress.  As a toddler, she was already a compulsive performer.  She would entertain her family nightly by re-enacting television shows.  Christian put all that passion into dance and studied ballet along with ice-skating.  Christian competed frequently in ice-skating competitions.  She enjoyed dance and ice-skating so much that she decided to study multiple dance styles...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7hO9oF65f4SD6WH905mMIRMv6S0.jpg", url:"https://themoviedb.org/person/84224"}}, {tmdbId:"94103", properties:{bornIn:"Greenwich, Connecticut, USA", imdbId:"1963091", born:date('1988-08-26'), name:"Evan Ross", bio:"From Wikipedia, the free encyclopedia\n\nEvan Olav Næss (born August 26, 1988) is an American actor and musician.  He is the son of entertainer Diana Ross and Norwegian businessman and mountaineer, Arne Næss, Jr. .  He is the brother of actresses Rhonda Ross Kendrick and Tracee Ellis Ross, and of singer Leona Naess.  He began acting in the late 2000s, appearing in the films ATL and Pride.  Evan released his first single in February 2011, called \"Yes Me\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w9c9AdgqC8EM8sc4EgdkqXJGEPd.jpg", url:"https://themoviedb.org/person/94103"}}, {tmdbId:"8700", properties:{bornIn:"Los Angeles - California - USA", imdbId:"0818587", born:date('1990-05-14'), name:"Sasha Spielberg", bio:"asha Spielberg was born on May 14, 1990 in Los Angeles, California, USA as Sasha Rebecca Spielberg.  She is an actress and writer, known for Terminal (2004), Indiana Jones und das Königreich des Kristallschädels (2008) and The Kids Are All Right (2010)...", url:"https://themoviedb.org/person/8700"}}, {tmdbId:"34111", properties:{imdbId:"1634963", born:date('1993-02-24'), name:"Marcus Carl Franklin", bio:"From Wikipedia, the free encyclopedia\n\nMarcus Carl Franklin (born February 24, 1993) is an American actor.  He is best known for portraying an incarnation of Bob Dylan who calls himself \"Woody Guthrie\" in the Bob Dylan biopic I'm Not There, written and directed by Todd Haynes.  Franklin is seen as a young hobo, hitching rides on freight trains, while clutching a guitar case bearing the inscription \"This Machine Kills Fascists\" (this inscription adorned the guitar of Woody Guthrie)...", url:"https://themoviedb.org/person/34111"}}, {tmdbId:"1331425", properties:{imdbId:"4227439", name:"William Ackman", url:"https://themoviedb.org/person/1331425"}}, {tmdbId:"1059479", properties:{imdbId:"4227650", name:"Daniel Alpert", url:"https://themoviedb.org/person/1059479"}}, {tmdbId:"1331426", properties:{imdbId:"4226808", name:"Jonathan Alpert", url:"https://themoviedb.org/person/1331426"}}, {tmdbId:"173810", properties:{bornIn:"Port Said, Egypt", imdbId:"0046223", born:date('1957-05-01'), name:"Sayed Badreya", bio:"Egyptian-born film-maker and actor Sayed Badreya realized a childhood dream by winning roles in major Hollywood films such as The Insider, Three Kings, and Independence Day.   Growing up in poverty in Port Said, Sayed Badreya's dreams of movie stardom looked as bleak as the prospect of peace in the Middle East.  From the Six Day War in '67 through the Yom Kippur War in '73, his only escape from the world he knew was the movie theater, where films transported him to a magical land...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sVvwmMsjXd5YqyZEfWcWQEkBScu.jpg", url:"https://themoviedb.org/person/173810"}}, {tmdbId:"1978679", properties:{name:"Liam Campora", url:"https://themoviedb.org/person/1978679"}}, {tmdbId:"123846", properties:{bornIn:"Huntsville, Alabama, USA", imdbId:"2913275", born:date('1993-05-13'), name:"Debby Ryan", bio:"Deborah Ann Ryan (born May 13, 1993) is an American actress and singer.  Ryan started acting in professional theatres at the age of seven; in 2007 she appeared in the Barney & Friends straight-to-DVD film Barney: Let's Go to the Firehouse and then was discovered in a nationwide search by Disney.  She is also known for appearing in the 2008 feature film The Longshots as Edith.  From 2008 to 2011, she starred as Bailey Pickett in The Suite Life on Deck...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yqpxtPknFel9TQdb0RUGgptjj9O.jpg", url:"https://themoviedb.org/person/123846"}}, {tmdbId:"205204", properties:{bornIn:"Vancouver, British Columbia, Canada", imdbId:"1700638", born:date('1990-11-04'), name:"Jean-Luc Bilodeau", bio:"From Wikipedia, the free encyclopedia. \n\nJean-Luc Bilodeau (born November 4, 1990) is a Canadian actor best known for his role as Josh Trager in the ABC Family channel program Kyle XY.  He has also appeared in films such as Ill Fated, Trick 'r Treat, 16 Wishes, No Ordinary Family, and he also is a recurring character in Nickoledeon's Best Player starring Jerry Trainor and Jennette McCurdy.  Jean-Luc was rumoured to be cast as Tony on the new Disney channel show Jessie...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rQle6OcSScG79aoNnf3zm4djzTN.jpg", url:"https://themoviedb.org/person/205204"}}, {tmdbId:"143329", properties:{bornIn:"Berlin, Germany", imdbId:"2470629", born:date('1981-12-23'), name:"Anna Mae Wills", bio:"From Wikipedia, the free encyclopedia. \n\nAnna Mae Routledge - (born December 23, 1981), is a Canadian actress.  She is best known for her role as Celeste Jeansen in the Disney Channel Original Movie, 16 Wishes. \n\nDescription above from the Wikipedia article Anna Mae Routledge, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ukZhPlCyoca4YdVvqqk9OoTEq3G.jpg", url:"https://themoviedb.org/person/143329"}}, {tmdbId:"144853", properties:{imdbId:"2735061", name:"Karissa Tynes", bio:"From Wikipedia, the free encyclopedia. \n\nKarissa Tynes is an American actress, best known for playing \"Krista Cooks\" in the Disney Channel movie 16 Wishes.  She has been in numerous films and television shows.  is an American actress, best known for playing \"Krista Cooks\" in the Disney Channel movie 16 Wishes.  She has been in numerous films and television shows. \n\nDescription above from the Wikipedia article Karissa Tynes, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/RTjVhdIpbh6r8IiTtHAQ18m3pE.jpg", url:"https://themoviedb.org/person/144853"}}, {tmdbId:"225163", properties:{bornIn:"Nayagarh, Odisha, India", imdbId:"3329873", name:"Pitobash", bio:"Pitobash Tripathy is a Bollywood actor, originally from the state of Odisha, India.  He is known for his role in the movies I Am Kalam and Shor in the City...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p6BMCwXziu3tiqOfXYbHaS3ZZX1.jpg", url:"https://themoviedb.org/person/225163"}}, {tmdbId:"964549", properties:{imdbId:"2639934", born:date('1987-01-01'), name:"Madhur Mittal", url:"https://themoviedb.org/person/964549"}}, {tmdbId:"1304662", properties:{bornIn:"Kensington, London, England, UK", imdbId:"4575328", born:date('2002-01-18'), name:"Samuel Joslin", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cVVp0DEfC0Hsu1s2oalM6iQyTMi.jpg", url:"https://themoviedb.org/person/1304662"}}, {tmdbId:"90498", properties:{bornIn:"Toronto - Ontario - Canada", imdbId:"1256602", born:date('1991-11-13'), name:"Devon Bostick", bio:"Devon Bostick (born November 13, 1991) is a Canadian actor known for playing Rodrick Heffley in the first three Diary of a Wimpy Kid movies, the lead role of Simon in the Atom Egoyan-directed film Adoration, Brent in Saw VI, and Jasper Jordan on The CW television series The 100 from 2014 to 2017...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lL0yRbFsSWw8HULM5eZ2EOqFO2G.jpg", url:"https://themoviedb.org/person/90498"}}, {tmdbId:"518627", properties:{bornIn:"Monterey, California, USA", imdbId:"1525807", born:date('1996-01-31'), name:"Joel Courtney", bio:"Joel Courtney (born January 31, 1996) is an American actor known for his role as Joe Lamb in the 2011 film Super 8.  He also played the lead role of Peter Moore on The CW's series The Messengers...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2PSvG7Qd9dUMFonifSZCvDnDBrL.jpg", url:"https://themoviedb.org/person/518627"}}, {tmdbId:"156689", properties:{bornIn:"New York City, New York, USA", imdbId:"0875768", born:date('1963-02-19'), name:"Jessica Tuck", bio:"Jessica Tuck is an actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jxBUK4AO2CAJs1WmVERHUnP8gE1.jpg", url:"https://themoviedb.org/person/156689"}}, {tmdbId:"88950", properties:{bornIn:"Rockford, Minnesota USA", imdbId:"0571930", born:date('1960-02-21'), name:"Joel McKinnon Miller", bio:"​From Wikipedia, the free encyclopedia.   \n\nJoel McKinnon Miller, or sometimes credited as Joel McKinnon (born in Minnesota) is an American film and television actor who has been living in Los Angeles since 1991.  His most significant role is that of Don Embry on HBO's drama series Big Love. \n\nDescription above from the Wikipedia article Joel McKinnon Miller, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oSZfZNYkhncAmpCl8wKjK5j5XFk.jpg", url:"https://themoviedb.org/person/88950"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"984658", properties:{bornIn:"Lafayette, Indiana, U.S.", imdbId:"4932304", born:date('1996-06-20'), name:"Claudia Lee", bio:"Claudia Lee (born June 20, 1996) is an American actress, singer and songwriter best known for her role as Magnolia Breeland on the CW comedy-drama, Hart of Dixie.  She also played Bridget on the comedy Zeke and Luther...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3lL5ZJwXp6stVpPpsdLXHcY8rQ8.jpg", url:"https://themoviedb.org/person/984658"}}, {tmdbId:"95266", properties:{bornIn:"Levin, Manawatu-Wanganui, New Zealand", imdbId:"0316805", born:date('1964-12-14'), name:"Rebecca Gibney", bio:"Rebecca Catherine Gibney (born 14 December 1964 in Levin, New Zealand) is a New Zealand born Australian actress.  She has appeared regularly in Australian film and television since the mid 1980's.  She won the Gold Logie in 2010 for her role in Packed to the Rafters.   From Wikipedia, the free encyclopedia.  Description above from the Wikipedia article Rebecca Gibney, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Q0CasoMOqBVVKdm4SNOJ0YUnf9.jpg", url:"https://themoviedb.org/person/95266"}}, {tmdbId:"1375948", properties:{imdbId:"3851308", born:date('1989-01-25'), name:"Hayley Magnus", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ocCMNvj3xiPLiZUp5c5pj6R0kFM.jpg", url:"https://themoviedb.org/person/1375948"}}, {tmdbId:"1186663", properties:{imdbId:"3910149", name:"Chelsea Bennett", url:"https://themoviedb.org/person/1186663"}}, {tmdbId:"91520", properties:{bornIn:"Amstelveen, Noord-Holland, Netherlands", imdbId:"0401264", born:date('1981-07-18'), name:"Michiel Huisman", bio:"Michiel Huisman was born on July 18, 1981 in Amstelveen, Noord-Holland, which is near Amsterdam, the Netherlands.  He is a Dutch film and television actor, musician, and singer-songwriter, who has acted in both Dutch and English-language productions.  He's best known for playing recurring roles on television series' \"Treme\" as Sonny, \"Game of Thrones\" as Daario Naharis, \"Nashville\" as Liam McGuinnis, and \"Orphan Black\" as Cal Morrison...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7zfahRtVJw7zfmSWfcgbueBzI8Q.jpg", url:"https://themoviedb.org/person/91520"}}, {tmdbId:"56024", properties:{bornIn:"Rueil-Malmaison, France", imdbId:"0241121", born:date('1972-06-19'), name:"Jean Dujardin", bio:"Jean Dujardin is a French actor, director and comedian. \n\nHe won an award for \"Best Actor\" at the 84th Academy Awards (2012) with the silent film \"The Artist\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v74UU6RgjpEmdnN8b5Q7XIokl0g.jpg", url:"https://themoviedb.org/person/56024"}}, {tmdbId:"82923", properties:{bornIn:"Buenos Aires, Argentina.", imdbId:"0067367", born:date('1976-07-07'), name:"Bérénice Bejo", bio:"Bérénice Bejo (born July 7, 1976 in Buenos Aires) is a French - Argentine actress, best known for her role in The Artist (2011), for which she received a nomination for Best Supporting Actress at the Academy Awards and won her the César Award for Best Actress.  She also won Best Actress at the Cannes Film Festival in 2013 for her performance in The Past...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jC17et46NKU16cztl9iAuckYNib.jpg", url:"https://themoviedb.org/person/82923"}}, {tmdbId:"561869", properties:{bornIn:"Los Angeles, California, USA", imdbId:"3964350", born:date('1998-10-23'), name:"Amandla Stenberg", bio:"Amandla Stenberg (born October 23, 1998) is an American teen actor.  They are best known for their portrayal of young Cataleya in Colombiana and Rue in The Hunger Games. \n\nAmandla (which means \"power\" in Zulu) Stenberg was born in Los Angeles, California, on October 23, 1998.  Their mother, Karen Brailsford, is African-American, and their father, Tom Stenberg, is Danish (he was born in Copenhagen).  Their paternal grandmother was from Greenland and had Inuit ancestry...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kgLB6xhhZKqqwn1lnL5YjIv5frS.jpg", url:"https://themoviedb.org/person/561869"}}, {tmdbId:"1107313", properties:{imdbId:"4326490", name:"Patrick de Ledebur", url:"https://themoviedb.org/person/1107313"}}, {tmdbId:"512991", properties:{bornIn:"Elderslie, Renfrewshire, Scotland, UK", imdbId:"0534635", born:date('1986-06-18'), name:"Richard Madden", bio:"Richard Madden (born 18 June 1986) is a Scottish stage, film, and television actor, known for his work in theatre and for his roles in both film and television.  Currently he is best known for his portrayal of Robb Stark in the fantasy TV series, Game of Thrones...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/67HfnUIyYsxd11u99BHBFgFgCQf.jpg", url:"https://themoviedb.org/person/512991"}}, {tmdbId:"1746888", properties:{born:date('1949-04-08'), name:"Jim Lampley", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dU7YRcSHN8tt7hTHhZCQQ49KsDV.jpg", url:"https://themoviedb.org/person/1746888"}}, {tmdbId:"72132", properties:{bornIn:"Miami, Florida, USA", imdbId:"0992694", born:date('1974-04-15'), name:"Danny Pino", bio:"Danny Pino  (born April 15, 1974) is an American actor of Cuban descent...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9S61CFH3wwAsWTFF3xYud3QLo1c.jpg", url:"https://themoviedb.org/person/72132"}}, {tmdbId:"142193", properties:{bornIn:"French River, Nova Scotia, Canada", imdbId:"1459109", born:date('1979-11-30'), name:"Diego Klattenhoff", bio:"Diego Klattenhoff is a Canadian actor known for his portrayals of Mike Faber in the Showtime series Homeland and as FBI Agent Donald Ressler in The Blacklist.  He has also appeared as Derek in Whistler and Ivan in Men in Trees...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6OV26Iq6qTXg4S3M7UnJglHBwHZ.jpg", url:"https://themoviedb.org/person/142193"}}, {tmdbId:"550705", properties:{bornIn:" French Pyrénées", imdbId:"2957582", name:"Jean Clottes", bio:"From Wikipedia, the free encyclopedia. \n\nJean Clottes is a prominent French prehistorian.  He was born in the French Pyrénées in 1933 and began to study archaeology in 1959, while teaching high school.  He initially focused on Neolithic dolmens, which were the topic of his 1975 Ph. D.  thesis at the University of Toulouse...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kMjHPfdeXnZuxvLXkZfRcJtP8cc.jpg", url:"https://themoviedb.org/person/550705"}}, {tmdbId:"550706", properties:{imdbId:"0312785", name:"Jean-Michel Geneste", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8QLshfTJvlCZnMymxWuEOst1guj.jpg", url:"https://themoviedb.org/person/550706"}}, {tmdbId:"129024", properties:{bornIn:"Toronto, Canada", imdbId:"3834164", born:date('1987-08-08'), name:"Jenn Proske", bio:"After acting in several shows while in high school and college, Proske was hired for her first professional role in Steel Magnolias by Robert Harling, in 2008.  She portrayed Shelby.  In 2009, she portrayed Titania and Hippolyta in A Midsummer Night's Dream at Mysterium Theater of Santa Ana and had the role of Mariah in an Off-Broadway production of Pope Joan. \n\nShe was hired for her first movie role in 2010, as Becca Crane — a parody of Bella Swan from the Twilight saga — in Vampires Suck...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bdCrYqRhzZJADlReqA6CbGEcXvp.jpg", url:"https://themoviedb.org/person/129024"}}, {tmdbId:"108919", properties:{bornIn:"New York City - New York - USA", imdbId:"2861180", born:date('1985-09-18'), name:"Chris Riggi", bio:"Chris Riggi was born on September 18, 1985 in New York, USA as Christopher Nicholas Riggi.  He is an actor and producer, known for The Wolf of Wall Street (2013), Vampires Suck (2010) and Brotherhood (2008)...", url:"https://themoviedb.org/person/108919"}}, {tmdbId:"1223726", properties:{bornIn:"Toronto, Canada", imdbId:"2064412", born:date('1988-04-21'), name:"Robbie Amell", bio:"Robert Patrick \"Robbie\" Amell (born April 21, 1988) is a Canadian actor, who is best known for his role on the Nickelodeon series True Jackson, VP, Picture This, and Fred Jones in the television films Scooby-Doo! The Mystery Begins and Scooby-Doo! Curse of the Lake Monster.  In 2011, he appeared in the role of \"Scooby\", Robin's Canadian dog-like boyfriend in the CBS comedy series How I Met Your Mother...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qRDwwBVJmYk7yhlo8VwRMook4yd.jpg", url:"https://themoviedb.org/person/1223726"}}, {tmdbId:"98285", properties:{bornIn:"Pembroke Pines, Florida, USA", imdbId:"2254074", born:date('1997-10-08'), name:"Bella Thorne", bio:"Annabella Avery Thorne (born October 8, 1997) is an American actress, director, singer, and model.  She played Ruthy Spivey in the television series My Own Worst Enemy (2008) and Tancy Henrickson in the fourth season of Big Love (2010), before gaining prominence for her role as CeCe Jones on the Disney Channel series Shake It Up (2010–2013)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jDbek5k4nf5OzvO4zuVuheKN08f.jpg", url:"https://themoviedb.org/person/98285"}}, {tmdbId:"1207369", properties:{imdbId:"3509417", name:"Dennis Lafond", url:"https://themoviedb.org/person/1207369"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"166772", properties:{bornIn:"Brooklyn, New York, US", imdbId:"0066877", born:date('1942-10-07'), name:"Joy Behar", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4zw5nNwsgoPaMZdvE2HL3yeg5Gm.jpg", url:"https://themoviedb.org/person/166772"}}, {tmdbId:"1315615", properties:{imdbId:"0132308", name:"Christopher Campbell", url:"https://themoviedb.org/person/1315615"}}, {tmdbId:"17245", properties:{bornIn:"Austin, Texas, USA", imdbId:"1360270", born:date('1978-09-12'), name:"Ben McKenzie", bio:"McKenzie is the son of the lawyer Pieter Meade Schenkkan.  His mother Mary Frances is a writer, journalist and professor at a university in Texas.  He was born in Austin, Texas, where he grew up with his two younger brothers Zack and Nate.  His uncle is actor and Pulitzer Prize winner Robert Schenkkan; his second cousin Sarah Drew is also an actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dHj2xtDOuZc193W4UpQkq4niZcy.jpg", url:"https://themoviedb.org/person/17245"}}, {tmdbId:"60458", properties:{bornIn:"Galveston, Texas, USA", imdbId:"1882929", born:date('1995-08-20'), name:"Liana Liberato", bio:"Liana Daine Liberato (born August 20, 1995) is an American television and film actress.  She played the younger version of the female lead in the 2014 film The Best of Me and starred in the 2010 films, Trust and The Last Sin Eater. \n\nDescription above from the Wikipedia article Liana Liberato, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5EEvVU9EDZ1ricNizDYUgclG1BF.jpg", url:"https://themoviedb.org/person/60458"}}, {tmdbId:"1608910", properties:{name:"Danny Abelson", url:"https://themoviedb.org/person/1608910"}}, {tmdbId:"1059130", properties:{imdbId:"1088287", name:"Henry Beard", url:"https://themoviedb.org/person/1059130"}}, {tmdbId:"938292", properties:{imdbId:"3964962", name:"Tova Stewart", url:"https://themoviedb.org/person/938292"}}, {tmdbId:"78423", properties:{bornIn:"Trappes, France", imdbId:"1082477", born:date('1978-01-20'), name:"Omar Sy", bio:"Omar Sy (born 20 January 1978) is a French film actor, best known for his duo with Fred Testot, Omar et Fred, and for his role in The Intouchables, written and directed by Olivier Nakache and Éric Toledano, which became the second highest grossing French film of all time in the French box office.  He received the César Award for Best Actor on 24 February 2012 for his role in The Intouchables and in doing so also became the first black actor to win the honorary French award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o34IwFPlOvE00yJA2E4nvp5RQB7.jpg", url:"https://themoviedb.org/person/78423"}}, {tmdbId:"19370", properties:{bornIn:"Antony, France", imdbId:"0494504", born:date('1962-12-16'), name:"Anne Le Ny", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aBNMt6uTYj7JhSwDsXi3UMDAlNA.jpg", url:"https://themoviedb.org/person/19370"}}, {tmdbId:"219708", properties:{bornIn:"Mantes-sur-Seine, Seine-et-Oise [now Mantes-la-Jolie, Yvelines], France", imdbId:"1109153", born:date('1977-07-06'), name:"Audrey Fleurot", bio:"Audrey Fleurot (born 6 July 1977) is a French actress.  She is best known for playing the Lady of the Lake in Kaamelott, Joséphine Karlsson in Spiral and Hortense Larcher in Un village français.  In 2011, she played Magalie in the international hit, The Intouchables. \n\nDescription above from the Wikipedia article Audrey Fleurot, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/83wsYI6oRWrtkcKr7ozobh1VWrm.jpg", url:"https://themoviedb.org/person/219708"}}, {tmdbId:"944159", properties:{imdbId:"0019207", name:"David Alford", url:"https://themoviedb.org/person/944159"}}, {tmdbId:"221611", properties:{bornIn:"Lancaster, Pennsylvania, USA", imdbId:"2676147", born:date('1985-03-26'), name:"Jonathan Groff", bio:"Jonathan Drew Groff (born March 26, 1985) is an American actor and singer. \n\nGroff rose to prominence in 2006 for his performance in the lead role of Melchior Gabor in the original Broadway production of Spring Awakening, for which he was nominated for the Tony Award for Best Actor in a Musical.  He returned to Broadway in 2015 to play the role of King George III in Hamilton, a performance for which he earned a nomination for the Tony Award for Best Featured Actor in a Musical...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3kmnYKAzSc3Lp7iK5pcj97Hx9Cm.jpg", url:"https://themoviedb.org/person/221611"}}, {tmdbId:"152486", properties:{imdbId:"0696894", name:"Felicity Price", url:"https://themoviedb.org/person/152486"}}, {tmdbId:"60373", properties:{bornIn:" New Zealand", imdbId:"1102278", born:date('1975-10-25'), name:"Antony Starr", bio:"Antony Starr is a New Zealand television actor best known for his dual role as twins Jethro and Van West in New Zealand's hit comedy/drama Outrageous Fortune.  He also starred in the television series Banshee, which aired on HBO-owned Cinemax...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cMFniH2Esle7QNyJcFZ9D3XUxRk.jpg", url:"https://themoviedb.org/person/60373"}}, {tmdbId:"1270717", properties:{imdbId:"4302299", name:"Hiroaki Aikawa", url:"https://themoviedb.org/person/1270717"}}, {tmdbId:"151073", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0046337", born:date('1969-12-08'), name:"Cindy Baer", url:"https://themoviedb.org/person/151073"}}, {tmdbId:"1998559", properties:{name:"Ester Brym", url:"https://themoviedb.org/person/1998559"}}, {tmdbId:"17743", properties:{bornIn:"Los Angeles, California, USA ", imdbId:"1388927", born:date('1993-05-14'), name:"Miranda Cosgrove", bio:"Miranda Taylor Cosgrove (born May 14, 1993) is an American actress, singer and songwriter.  Her career began at the age of 3 with several television commercial appearances.  Cosgrove's film debut came in 2003, when she appeared as Summer Hathaway in School of Rock.  She appeared in a number of minor television roles over several years before coming to prominence as Megan Parker on the Nickelodeon television series Drake &amp; Josh...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xwJxbOTWJc1AKvC33v9PNsuYX6Q.jpg", url:"https://themoviedb.org/person/17743"}}, {tmdbId:"18", properties:{bornIn:"Woodland Hills, Los Angeles, California, USA", imdbId:"0004951", born:date('1960-04-14'), name:"Brad Garrett", bio:"Brad Garrett (born April 14, 1960) is an American actor, voice actor, and stand-up comedian.  He is best known for Everybody Loves Raymond and 'Til Death...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hYh3fR8UeKPVD4LcfDrit4JkCqD.jpg", url:"https://themoviedb.org/person/18"}}, {tmdbId:"143674", properties:{bornIn:"San Pietroburgo, Russia", imdbId:"0785104", born:date('1960-08-14'), name:"Igor Sergeev", url:"https://themoviedb.org/person/143674"}}] AS row
