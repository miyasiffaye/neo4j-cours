UNWIND [{tmdbId:"90180", properties:{bornIn:"Knoxville, Tennessee, USA", imdbId:"0220598", born:date('1953-05-15'), name:"Cleavant Derricks", bio:"From Wikipedia, the free encyclopedia. \n\nCleavant Derricks, Jr.  (born May 15, 1953) is an American actor and singer-songwriter. \n\nDescription above from the Wikipedia article Cleavant Derricks (actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2IujS80yQRVyM5RKo75HvGghGlf.jpg", url:"https://themoviedb.org/person/90180"}}, {tmdbId:"83851", properties:{bornIn:"Buenos Aires, Argentina", imdbId:"0721031", born:date('1930-02-08'), name:"Alejandro Rey", died:date('1987-05-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2kFWeqhkadCmfxWIuKV3opRsDPi.jpg", url:"https://themoviedb.org/person/83851"}}, {tmdbId:"64180", properties:{bornIn:"Atlanta, Georgia", imdbId:"0926209", born:date('1958-09-24'), name:"Steve Whitmire", bio:"From Wikipedia, the free encyclopedia. \n\nSteven Whitmire (born September 24, 1958) is an American puppeteer who works with The Jim Henson Company and Sesame Workshop.  He has been the performer of two signature Muppets - Kermit the Frog and Sesame Street's Ernie - since the death of their creator, Jim Henson, in 1990.  Characters original to Whitmire include Rizzo the Rat, Lips (the trumpet player from Dr...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8M9Pq4UljjgEAqzOlakmwBuHFAW.jpg", url:"https://themoviedb.org/person/64180"}}, {tmdbId:"326", properties:{bornIn:"Athens, Georgia, USA", imdbId:"0000107", born:date('1953-12-08'), name:"Kim Basinger", bio:"Kimila Ann \"Kim\" Basinger is an American actress and former fashion model.  She is known for her portrayals of Domino Petachi, the Bond girl in Never Say Never Again (1983), and Vicki Vale, the female lead in Batman (1989).  Basinger received a Golden Globe Award for Best Supporting Actress - Motion Picture nomination for her work in The Natural (1984).  She won an Academy Award, Golden Globe, and Screen Actors Guild Award for Best Supporting Actress for her performance in L. A.  Confidential (1997)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6gLzz9y3v92Fs8VHtKLNdl1h20t.jpg", url:"https://themoviedb.org/person/326"}}, {tmdbId:"55266", properties:{bornIn:"Edmonton, Alberta, Canada", imdbId:"0829252", born:date('1959-04-22'), name:"Catherine Mary Stewart", bio:"From Wikipedia, the free encyclopedia\n\nCatherine Mary Stewart (born Catherine Mary Nursall on April 22, 1959, in Edmonton, Alberta) is a Canadian actress.  Her first notable role was as Kayla Brady on the soap opera Days of our Lives from 1981 to 1983.  In 1984 she starred in two feature films, The Last Starfighter as Maggie Gordon and Night of the Comet as Regina Belmont. \n\nIn the mid 1980s, Stewart appeared in two highly-rated mini-series; Hollywood Wives (1985) and Sins (1986)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bnzxmEpVmQT29okflCNwwLA63rz.jpg", url:"https://themoviedb.org/person/55266"}}, {tmdbId:"83151", properties:{bornIn:"Minneapolis, Minnesota, U.S.", imdbId:"0549526", born:date('1960-12-30'), name:"Kelli Maroney", bio:"From Wikipedia, the free encyclopedia. \n\nKelli Joan Maroney is an American actress who has starred in film and in television. \n\nDescription above from the Wikipedia article Kelli Maroney, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zGzOX9doZPIfoTw5t0zYGZH0Lj4.jpg", url:"https://themoviedb.org/person/83151"}}, {tmdbId:"19434", properties:{bornIn:"Sioux City, Iowa, U.S", imdbId:"0268331", born:date('1940-12-24'), name:"Sharon Farrell", bio:"​From Wikipedia, the free encyclopedia\n\nSharon Farrell (born December 24, 1940) is an American television and film actress. \n\nDescription above from the Wikipedia article Sharon Farrell, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/42dQ4WRePvqrdNwLjoRfimngWdo.jpg", url:"https://themoviedb.org/person/19434"}}, {tmdbId:"13652", properties:{bornIn:"Nampa, Idaho, USA", imdbId:"0086867", born:date('1945-08-24'), name:"Ronee Blakley", bio:"From Wikipedia, the free encyclopedia\n\nRonee Blakley (born August 24, 1945) is an American entertainer.  Though an accomplished singer, songwriter, composer, producer and director, she is perhaps best known as an actress.  Her most famous role was as the fictional country superstar Barbara Jean in Robert Altman's 1975 film Nashville, for which she won a National Board of Review Award for Best Supporting Actress and was nominated for an Academy Award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fLdnGFUv9bpT0Tk1iqKBV1k1TH0.jpg", url:"https://themoviedb.org/person/13652"}}, {tmdbId:"5141", properties:{bornIn:"Tulsa, Oklahoma, USA", imdbId:"0000486", born:date('1964-07-17'), name:"Heather Langenkamp", bio:"Heather Langenkamp (born July 17, 1964) is an American film and television actress.  She is best known for her role as Nancy Thompson from the A Nightmare on Elm Street films.  She also played Marie Lubbock on the sitcom Just the Ten of Us. \n\nDescription above from the Wikipedia article Heather Langenkamp, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eqsaCuWAKbWJORS84dqpXzmg8b0.jpg", url:"https://themoviedb.org/person/5141"}}, {tmdbId:"13656", properties:{bornIn:"Manhattan Beach, California, USA", imdbId:"0944143", born:date('1960-11-24'), name:"Amanda Wyss", bio:"From Wikipedia, the free encyclopedia\n\nAmanda Wyss (born November 24, 1960) is an American film and television actress. \n\nDescription above from the Wikipedia article Amanda Wyss, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n9RwPdbitByiUEd5Lw1Vpyo8mXj.jpg", url:"https://themoviedb.org/person/13656"}}, {tmdbId:"10652", properties:{bornIn:"London, England ", imdbId:"0358180", born:date('1960-01-01'), name:"Suzanna Hamilton", bio:"Suzanna Hamilton (born 8 February 1960) is an English actress.  She is known for her performance as Julia in the 1984 film adaptation of George Orwell's classic novel, Nineteen Eighty-Four.  Her other film roles include Tess (1979), Brimstone and Treacle(1982), Wetherby (1985) and Out of Africa (1985).  On television, she starred in the ITV drama Wish Me Luck (1988), the BBCmedical drama Casualty (1993–94) and the STV drama McCallum (1995–97)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/udhx0uTjAC01b6styoHNjvJ539j.jpg", url:"https://themoviedb.org/person/10652"}}, {tmdbId:"69718", properties:{bornIn:"New York City, New York, USA", imdbId:"0001083", born:date('1965-04-16'), name:"Jon Cryer", bio:"​From Wikipedia, the free encyclopedia.   \n\nJonathan Niven \"Jon\" Cryer (born April 16, 1965, height 5' 9\" (1,75 m)) is an American actor, screenwriter and film producer.  He is the son of actress–singer Gretchen Cryer.  He made his motion picture debut in the 1984 romantic comedy No Small Affair, but gained greater fame as \"Duckie\" in the 1986 John Hughes-scripted film Pretty in Pink.  In 1998, he finished writing and producing the independent film Went to Coney Island on a Mission from God. . ...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z2LPFc4oLDaDOYipKTAzZ9rARQ5.jpg", url:"https://themoviedb.org/person/69718"}}, {tmdbId:"66606", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0001841", born:date('1948-10-17'), name:"George Wendt", bio:"From Wikipedia, the free encyclopedia. \n\nGeorge Robert Wendt III(born October 17, 1948) is an American actor, best known for the role of Norm Peterson on the television show Cheers. \n\nDescription above from the Wikipedia article George Wendt, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/noQKS06TbuPJQ9o91CzKbEvTwZR.jpg", url:"https://themoviedb.org/person/66606"}}, {tmdbId:"5300", properties:{bornIn:"Warwick - Rhode Island - USA", imdbId:"0292691", born:date('1956-10-03'), name:"Peter Frechette", bio:"Peter Frechette is an American film, stage and television actor. \n\n Born and raised in Coventry, Rhode Island, Peter Frechette earned a B. F. A.  in Theater from the University of Rhode Island before moving to New York City to pursue acting there on stage.  He earned Tony Award nominations for his performances in the play Eastern Standard which played on Broadway, and the off-Broadway production of Our Country's Good.  Additional stage credits include Night and Her Stars, and The Destiny of Me...", url:"https://themoviedb.org/person/5300"}}, {tmdbId:"351", properties:{bornIn:"Perth, Western Australia, Australia", imdbId:"0001114", born:date('1955-04-23'), name:"Judy Davis", bio:"Judy Davis (born 23 April 1955) is an Australian actress best known for her roles in Husbands and Wives, Barton Fink, A Passage to India and in the TV miniseries Life with Judy Garland: Me and My Shadows.  Davis first came to attention for her role as the fiery Sybylla Melvyn in the 1979 film My Brilliant Career.  She has won many acting awards, including two Golden Globe Awards, three Emmy Awards, one BAFTA and five AFI Awards.  She has also been nominated twice for an Academy Award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hKp3xTmdNzqbzSbAAbqKLmJHJ41.jpg", url:"https://themoviedb.org/person/351"}}, {tmdbId:"78951", properties:{bornIn:"Calcutta, West Bengal, India", imdbId:"0051856", born:date('1946-10-16'), name:"Victor Banerjee", bio:"Victor Banerjee (born Partho Sarathi Banerjee, 15 October 1946) is an Indian actor who appears in English, Hindi, Bengali and Assamese language films.  He has worked for directors including Roman Polanski, James Ivory, Sir David Lean, Jerry London, Ronald Neame, Satyajit Ray, Mrinal Sen, Shyam Benegal, Montazur Rahman Akbar and Ram Gopal Varma...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zjTtNbm2HZ70CpwotPk4HrNrTW3.jpg", url:"https://themoviedb.org/person/78951"}}, {tmdbId:"6161", properties:{bornIn:"Catskill Mountains, New York, USA", imdbId:"0000124", born:date('1970-12-12'), name:"Jennifer Connelly", bio:"Jennifer Lynn Connelly (born December 12, 1970), is an American film actress and former child model who started modeling after a friend of her parents suggested an audition. \n\nShe subsequently appeared in magazine, newspaper and television advertising.  Connelly made her motion picture debut in the 1984 crime film Once Upon a Time in America, then, while continuing her career as a model, starred as a teenager in films such as Labyrinth and Career Opportunities...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3oYDftEbM3YgBiHYcbbIPRNZrTL.jpg", url:"https://themoviedb.org/person/6161"}}, {tmdbId:"99550", properties:{bornIn:"Roma, Italia", imdbId:"0034485", born:date('1970-01-03'), name:"Fiore Argento", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aQhMYrPwjoHbYyxFLgMlqPUOt2M.jpg", url:"https://themoviedb.org/person/99550"}}, {tmdbId:"103058", properties:{imdbId:"0557861", name:"Federica Mastroianni", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qc14lYpzLJVlxglm5sEBpWPf5ju.jpg", url:"https://themoviedb.org/person/103058"}}, {tmdbId:"4976", properties:{bornIn:"London, England, UK", imdbId:"0160452", born:date('1916-03-19'), name:"Eric Christmas", bio:"Was a British stage and screen actor, with over 40 films and several more television roles to his credit.  He was well-known for his role as Mr.  Carter, the principal of Angel Beach High School, in the 1982 hit comedy Porky's, the 1983 sequel Porky's II: The Next Day, and the 1985 sequel Porky's Revenge!.  He was also well-known for his sporadic role as Reverend Diddymoe in the NBC sitcom, Amen.  Christmas was born in London, UK and later immigrated to Canada...", died:date('2000-07-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2x0F0RSlWXbi1qDPbg0H3SijNl6.jpg", url:"https://themoviedb.org/person/4976"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"32225", properties:{bornIn:"New York City, New York, USA", imdbId:"0001080", born:date('1948-05-12'), name:"Lindsay Crouse", bio:"An actress, known for The Arrival (1996), The Insider (1999) and Slap Shot (1977).  She has been married to Rick Blue since 1998.  She was previously married to David Mamet...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p4RmAiZclkk8DWK9zFvqp9gma6H.jpg", url:"https://themoviedb.org/person/32225"}}, {tmdbId:"23882", properties:{bornIn:"Chicago - Illinois - USA", imdbId:"0001496", born:date('1950-09-11'), name:"Amy Madigan", bio:"Amy Marie Madigan (born September 11, 1950) is an American actress who is known for her role as Annie Kinsella in the 1989 film Field of Dreams and Iris Crowe in the HBO television series Carnivale. \n\nDescription above from the Wikipedia article Amy Madigan, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xgtQOuPAmQZXWUO2PXetNpXm08A.jpg", url:"https://themoviedb.org/person/23882"}}, {tmdbId:"2109", properties:{bornIn:"Mossley Hill, Liverpool, England, UK", imdbId:"0000326", born:date('1956-08-21'), name:"Kim Cattrall", bio:"Kim Victoria Cattrall (pronounced /kəˈtræl/, born 21 August 1956) is an English actress.  She is known for her role as Samantha Jones in the HBO comedy/romance series Sex and the City, and for her leading roles in the 1980s films Police Academy, Big Trouble in Little China, Mannequin, and Porky's. \n\nDescription above from the Wikipedia article Kim Cattrall , licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2mXIZzn8NsuF5DdIKHRggvXpLpu.jpg", url:"https://themoviedb.org/person/2109"}}, {tmdbId:"27237", properties:{bornIn:"Port Arthur, Texas, USA", imdbId:"0047265", born:date('1944-08-27'), name:"G.W. Bailey", bio:"​George William Bailey was born on August 27, 1944, in Port Arthur, Texas.  Bailey started college at Lamar University in Beaumont and eventually transferred to Texas Tech University in Lubbock; but he did not complete his studies.  He worked at local theater companies during the mid 1960s until his move to California in the 1970s.  Here he began work on television series such as Starsky and Hutch (1975), Charlie's Angels (1976) and CHiPs (1977)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/doZuJwI446yhQ28PHT9vyM6pa0f.jpg", url:"https://themoviedb.org/person/27237"}}, {tmdbId:"57349", properties:{bornIn:"Beaumont, Texas, USA", imdbId:"0807571", born:date('1945-02-28'), name:"Bubba Smith", bio:"​From Wikipedia, the free encyclopedia. \n\nCharles Aaron \"Bubba\" Smith (February 28, 1945 – August 3, 2011) was an American actor and former athlete.  He was a professional football player in the 1960s and 1970s who became an actor in the late 1970s.  Born in Orange, Texas, he attended high school in Beaumont, Texas.  He is well known for his tremendous size at 6 ft 7 in (2 m)...", died:date('2011-08-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ew7CpCLyD4FP1zqgtxUV8jDg8cX.jpg", url:"https://themoviedb.org/person/57349"}}, {tmdbId:"21037", properties:{bornIn:"Minneapolis, Minnesota, Estados Unidos", imdbId:"0002239", born:date('1958-06-07'), name:"Prince", bio:"Prince Rogers Nelson (June 7, 1958 – April 21, 2016) was an American singer-songwriter, actor, multi-instrumentalist, philanthropist, dancer, filmmaker and record producer.  He was a musical innovator who was known for his eclectic work, flamboyant stage presence, extravagant dress and makeup, and wide vocal range.  His music integrates a wide variety of styles, including funk, rock, R&amp;B, new wave, soul, psychedelia, and pop...", died:date('2016-04-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5HPqjSXEQukk6ta8v1i9mPHUeqk.jpg", url:"https://themoviedb.org/person/21037"}}, {tmdbId:"191104", properties:{bornIn:"Santa Monica - California  USA", imdbId:"0467664", born:date('1959-08-02'), name:"Apollonia Kotero", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q9NO9FrjQRDJKDMdYJAF1l6wCgB.jpg", url:"https://themoviedb.org/person/191104"}}, {tmdbId:"57907", properties:{imdbId:"0206528", born:date('1957-12-13'), name:"Morris Day", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wXoaeMKhzvSvchJEqgxkIKMfyBQ.jpg", url:"https://themoviedb.org/person/57907"}}, {tmdbId:"50744", properties:{bornIn:"Athens, Greece", imdbId:"0439466", born:date('1947-04-20'), name:"Olga Karlatos", bio:"Olga Karlatos (Greek: Όλγα Καρλάτου; born 20 April 1947) is a Greek actress known primarily for performing in Italian horror cinema . Karlatos is best known for performances in such films as Zombi 2, Murder Rock, Purple Rain, My Friends and Once Upon A Time In America.  In 2007 Karlatos graduated from Kent University with a law degree and was admitted to the Bermuda Bar Association in 2010.  She moved to Bermuda with her husband, famous animator Arthur Rankin Jr...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cdsJAabO7RlSzzQzTYv49n245qG.jpg", url:"https://themoviedb.org/person/50744"}}, {tmdbId:"2022", properties:{bornIn:"New York City, New York, United States", imdbId:"0382819", born:date('1951-08-06'), name:"Catherine Hicks", bio:"Catherine Hicks (born August 6, 1951) is an American stage, film, television actress and singer.  She is best known for her role as Annie Camden on the long-running television series 7th Heaven...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eGgCeUbtsq69nCPG1w7vU7DzJpO.jpg", url:"https://themoviedb.org/person/2022"}}, {tmdbId:"18992", properties:{bornIn:"Chicago - Illinois - USA", imdbId:"0001644", born:date('1959-03-08'), name:"Aidan Quinn", bio:"Aidan Quinn is an Irish-American actor.  He made his film debut in 1984 in Reckless.  His films include Desperately Seeking Susan, The Mission, Stakeout, Benny and Joon, Legends of the Fall, Frankenstein, and Michael Collins. \n\nQuinn was born in Chicago, Illinois, to Irish parents.  He was brought up as a Roman Catholic and raised in Chicago and Rockford, Illinois, as well as in Dublin and Birr, County Offaly, in Ireland...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2JYHrkrmdOLZmRYy1A1OOBcv3x8.jpg", url:"https://themoviedb.org/person/18992"}}, {tmdbId:"6952", properties:{bornIn:"New York City, New York, USA", imdbId:"0000221", born:date('1965-09-03'), name:"Charlie Sheen", bio:"An American film and television actor.  He is the youngest son of actor Martin Sheen.  His character roles in films have included Chris Taylor in the 1986 Vietnam War drama Platoon, Jake Kesey in the 1986 film The Wraith, and Bud Fox in the 1987 film Wall Street.  His career has also included more comedic films such as Major League, the Hot Shots! films, and Scary Movie 3 and Scary Movie 4...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qgqHqsmiZVW3suEVONpofJNhOJk.jpg", url:"https://themoviedb.org/person/6952"}}, {tmdbId:"3801", properties:{bornIn:"Jersey City, New Jersey, United States", imdbId:"0910145", born:date('1947-11-25'), name:"Tracey Walter", bio:"From Wikipedia, the free encyclopedia.   Tracey Walter (born November 25, 1947) is an American character actor.  He has appeared in over 100 films and television shows. \n\nDescription above from the Wikipedia article Tracey Walter, licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9aALfdCcP0PDYcBmqB6auHF0Eud.jpg", url:"https://themoviedb.org/person/3801"}}, {tmdbId:"65554", properties:{imdbId:"0000848", born:date('1965-01-11'), name:"Olivia Barash", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eG2ulpCJlopuqQi7mROEDpKAlG2.jpg", url:"https://themoviedb.org/person/65554"}}, {tmdbId:"11085", properties:{bornIn:"Santa Barbara, California, USA", imdbId:"0000381", born:date('1962-07-19'), name:"Anthony Edwards", bio:"Anthony Edwards (born July 19, 1962) is an American actor and director.  He has appeared in various movies and television shows, including Fast Times at Ridgemont High, Top Gun, Zodiac, Revenge of the Nerds, Northern Exposure and ER...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a190BIbGGpM68pq1VarhaDNHZci.jpg", url:"https://themoviedb.org/person/11085"}}, {tmdbId:"23881", properties:{bornIn:"Lansing, Michigan, USA", imdbId:"0124079", born:date('1957-06-12'), name:"Timothy Busfield", bio:"Timothy Busfield (born June 12, 1957) is an American actor and director best known for his role as Eliot Weston on the television series Thirtysomething and his recurring role as Danny Concannon on the television series The West Wing.  In 1991 he received a Primetime Emmy Award as best supporting actor in a drama series. \n\nDescription above from the Wikipedia article Timothy Busfield, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/r2VQ4Ar1WCISJoTqOOcO3HEgN4p.jpg", url:"https://themoviedb.org/person/23881"}}, {tmdbId:"92809", properties:{imdbId:"0144119", born:date('1972-02-12'), name:"Andrew Cassese", bio:"From Wikipedia, the free encyclopedia\n\nAndrew Martin Cassese (born 12 February 1972) is an American actor best known for starring in the 1984 comedy film Revenge of the Nerds as Harold Wormser.  From January 25 to February 25, 2007, he starred as Microsoft co-founder Paul Allen in the Philadelphia Theatre Company premiere of Nerds://A Musical Software Satire. \n\nDescription above from the Wikipedia article Andrew Cassese, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iHNUuk8TBDaOSmbvnQeBflmHFcc.jpg", url:"https://themoviedb.org/person/92809"}}, {tmdbId:"1777523", properties:{name:"Shane Bailey", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mCWlPLDW0xqS0YhoT5JpGl8y5aT.jpg", url:"https://themoviedb.org/person/1777523"}}, {tmdbId:"1777524", properties:{name:"Becky Jo Lynch", url:"https://themoviedb.org/person/1777524"}}, {tmdbId:"57312", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0635649", born:date('1940-05-27'), name:"Zack Norman", url:"https://themoviedb.org/person/57312"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"15112", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"0000633", born:date('1945-01-29'), name:"Tom Selleck", bio:"From Wikipedia, the free encyclopedia. \n\nThomas William \"Tom\" Selleck (born January 29, 1945) is an American actor and film producer, best known for his starring role as Hawaii-based private investigator Thomas Magnum on the 1980s television show Magnum, P. I. .  He also plays Jesse Stone in a series of made-for-TV movies based on the Robert B.  Parker novels.  In 2010, he appears as Commissioner Frank Reagan in the drama Blue Bloods on CBS...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jCnmP0qYpCwWdVlZM4j9VNugmTj.jpg", url:"https://themoviedb.org/person/15112"}}, {tmdbId:"57756", properties:{bornIn:"Tirat HaCarmel - Israel", imdbId:"0005430", born:date('1949-08-25'), name:"Gene Simmons", bio:"​From Wikipedia, the free encyclopedia.   \n\nGene Simmons (born Chaim Witz; August 25, 1949) is an Israeli American rock bassist, singer, songwriter, musician, actor, and businessman.  Known as \"The Demon,\" he is the bassist/vocalist of Kiss, a hard rock band he co-founded in the early 1970s.  Simmons was ranked number 12 in Roadrunner's list of 50 Best Frontmen in Metal History...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c1t3QgTO4XTDZZG5Ndjxjt8Jt0a.jpg", url:"https://themoviedb.org/person/57756"}}, {tmdbId:"1796", properties:{bornIn:"Wichita, Kansas, USA", imdbId:"0000263", born:date('1951-01-12'), name:"Kirstie Alley", bio:"From Wikipedia, the free encyclopedia.   Kirstie Louise Alley (born January 12, 1951) is an American actress known for her role in the TV show Cheers, in which she played Rebecca Howe from 1987–1993, winning an Emmy Award and a Golden Globe Award as the Outstanding Lead Actress in a Comedy Series in 1991.  She is also known for her role in the Look Who's Talking film series as Mollie Ubriacco...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9XZOeQtmvHdBkuMrlxO5PHPZwJo.jpg", url:"https://themoviedb.org/person/1796"}}, {tmdbId:"66469", properties:{bornIn:"Chorzów, Polska", imdbId:"0525557", born:date('1946-09-07'), name:"Olgierd Lukaszewicz", bio:"From Wikipedia, the free encyclopedia\n\nOlgierd Łukaszewicz (born 7 September 1946) is a Polish film actor.  He has appeared in over 60 films since his 1969 graduation from the Ludwik Solski Academy for the Dramatic Arts in Kraków.  Between 2002 and 2005, he was the President of the Polish Union of Stage Actors (Związek Artystów Scen Polskich)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mi1G2PxnZqf8iMpiqApYkLYQOjr.jpg", url:"https://themoviedb.org/person/66469"}}, {tmdbId:"1148", properties:{bornIn:"Kraków, Poland", imdbId:"0836136", born:date('1947-04-18'), name:"Jerzy Stuhr", bio:"Jerzy Oskar Stuhr (Polish pronunciation: [ˈjɛʐɨ ˈʂtur]; born 18 April 1947) is one of the most popular, influential and versatile Polish film and theatre actors.  He also works as a screenwriter, film director and drama professor.  He served as the Rector of the Ludwik Solski Academy for the Dramatic Arts in Kraków for two terms: from 1990 to 1996 and again from 2002 to 2008...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1higxfq9DSYDufImetO5qwfa0tX.jpg", url:"https://themoviedb.org/person/1148"}}, {tmdbId:"87233", properties:{bornIn:"Warsaw, Poland", imdbId:"0835423", born:date('1954-08-09'), name:"Bozena Stryjkówna", url:"https://themoviedb.org/person/87233"}}, {tmdbId:"87234", properties:{bornIn:"Gdańsk, Poland", imdbId:"0667991", born:date('1954-06-22'), name:"Boguslawa Pawelec", url:"https://themoviedb.org/person/87234"}}, {tmdbId:"140777", properties:{bornIn:"Wilkes-Barre, PA, United States", imdbId:"0001706", born:date('1960-12-10'), name:"Michael Schoeffling", bio:"From Wikipedia, the free encyclopedia. \n\nMichael Schoeffling (born December 10, 1960) is an American former actor, and male model, best known for playing Jake Ryan in Sixteen Candles, Kuch in Vision Quest, and Joe in Mermaids. \n\nDescription above from the Wikipedia article Michael Schoeffling, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q420krBjb0JTCdU52oNQl01RrY9.jpg", url:"https://themoviedb.org/person/140777"}}, {tmdbId:"16181", properties:{bornIn:"New Jersey - USA", imdbId:"0606584", born:date('1959-09-14'), name:"Haviland Morris", bio:"From Wikipedia, the free encyclopedia. \n\nHaviland Morris (born September 14, 1959) is an American film, television, and Broadway actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/drh2Zb3p2VIVCupDSYg2w0Z9jqE.jpg", url:"https://themoviedb.org/person/16181"}}, {tmdbId:"95621", properties:{bornIn:"Baltimore, Maryland, U.S.", imdbId:"0738415", born:date('1950-10-17'), name:"Howard E. Rollins Jr.", bio:"Howard Rollins (1950–1996) was an American television, film, and stage actor. \n\nHe is perhaps best known for his portrayal of Coalhouse Walker Jr.  in Ragtime and Virgil Tibbs on In the Heat of the Night...", died:date('1996-12-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tuCYS3UhxTanQ7TVCXk3F36UrrZ.jpg", url:"https://themoviedb.org/person/95621"}}, {tmdbId:"13313", properties:{bornIn:"New York City, New York, USA", imdbId:"0128360", born:date('1933-12-05'), name:"Adolph Caesar", bio:"​From Wikipedia, the free encyclopedia.   \n\nAdolph Caesar (December 5, 1933 – March 6, 1986) was an American actor. \n\nDescription above from the Wikipedia article  Adolph Caesar, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1986-03-06'), url:"https://themoviedb.org/person/13313"}}, {tmdbId:"56183", properties:{bornIn:"Berkeley, California, U.S.", imdbId:"0262543", born:date('1942-03-27'), name:"Art Evans", bio:"​From Wikipedia, the free encyclopedia.   \n\nArthur James \"Art\" Evans (born March 27, 1942) is an American actor who has made multiple film and television program appearances over the span of three decades.  Evans was born in Berkeley, California.  His acting career, spanning over 30 years, started with Frank Silvera's Theater of Being in Los Angeles.  He took a starring role in The Amen Corner which transferred to Broadway in 1965...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hgDIXXzP4216aCttw7kK8HateCO.jpg", url:"https://themoviedb.org/person/56183"}}, {tmdbId:"1192691", properties:{bornIn:"Long Beach, New Jersey, USA", imdbId:"0941600", born:date('1944-04-19'), name:"Bernie Worrell", died:date('2016-06-24'), url:"https://themoviedb.org/person/1192691"}}, {tmdbId:"1084016", properties:{imdbId:"0918569", name:"Alex Weir", url:"https://themoviedb.org/person/1084016"}}, {tmdbId:"1194050", properties:{imdbId:"0768796", name:"Steven Scales", url:"https://themoviedb.org/person/1194050"}}, {tmdbId:"225113", properties:{name:"Lynn Mabry", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cP7f5EBEqxYVux2ynzT0PCgefS8.jpg", url:"https://themoviedb.org/person/225113"}}, {tmdbId:"6395", properties:{imdbId:"0050264", born:date('1966-07-07'), name:"Eszter Balint", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/t6Ccn2zEjalx4zKnuCFTnt5mvmO.jpg", url:"https://themoviedb.org/person/6395"}}, {tmdbId:"6396", properties:{bornIn:"New Rochelle - New York - USA", imdbId:"0002057", born:date('1954-01-01'), name:"Richard Edson", bio:"Richard Edson (born January 1, 1954) is an American actor and musician...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vuuU7beZrawR6VZB3a2QhDVtkjg.jpg", url:"https://themoviedb.org/person/6396"}}, {tmdbId:"6397", properties:{imdbId:"0823144", name:"Cecillia Stark", url:"https://themoviedb.org/person/6397"}}, {tmdbId:"33488", properties:{bornIn:"Massapequa, Long Island, New York, USA", imdbId:"0000644", born:date('1963-12-15'), name:"Helen Slater", bio:"Helen Rachel Slater (born December 15, 1963) is an American actress and singer-songwriter. \n\nShe appeared in the title role in the 1984 film Supergirl.  In the following years she starred in several very successful comedy-drama films such as Ruthless People, The Secret of My Success, and City Slickers.  Since then she has found regular work as an actress in various film, television, and stage projects, including guest appearances on the series Smallville...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6WGhch6xLlFh0mQ9NR5BQ1UHaT9.jpg", url:"https://themoviedb.org/person/33488"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"2712", properties:{bornIn:"Anniston, Alabama, USA", imdbId:"0000299", born:date('1956-07-31'), name:"Michael Biehn", bio:"An American actor.  He is best known for his roles in James Cameron's science fiction action films The Terminator as Kyle Reese, Aliens as Cpl.  Dwayne Hicks, and The Abyss as Lt.  Coffey.  He has also acted in other genres in such films as Tombstone, The Rock, and Planet Terror.  On television, Biehn appeared in the cast of the Emmy Award-winning 1980s television series Hill Street Blues...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9oFLsADWQm2TvU8XzLIzBbjdMkU.jpg", url:"https://themoviedb.org/person/2712"}}, {tmdbId:"35340", properties:{bornIn:" Vancouver Island, British Columbia, Canada", imdbId:"0930062", born:date('1953-01-01'), name:"Barbara Williams", bio:"​From Wikipedia, the free encyclopedia.   \n\nBarbara Williams (born 1953) is a Canadian-born American actress.  Williams starred in the 1984 Paramount film Thief of Hearts and in the 1992 film Oh, What a Night.  Williams was born in Vancouver Island, British Columbia, the daughter of Simone and Jack Williams, a tugboat skipper and logger.  She is the wife of Tom Hayden. \n\nDescription above from the Wikipedia article Barbara Williams,  licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/35340"}}, {tmdbId:"16560", properties:{bornIn:"Forest Hills, Queens, New York City, New York, USA", imdbId:"0000325", born:date('1956-01-07'), name:"David Caruso", bio:"David Caruso (born January 7, 1956) is an American film and television actor and producer. \n\nHe is best known for his role on NYPD Blue and CSI: Miami...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7XjPzadIBQ0mIVwVT7o87B7NkJJ.jpg", url:"https://themoviedb.org/person/16560"}}, {tmdbId:"67858", properties:{imdbId:"0834571", name:"Kimberly Stringer", url:"https://themoviedb.org/person/67858"}}, {tmdbId:"67859", properties:{imdbId:"0231551", name:"Chazz Dominguez", url:"https://themoviedb.org/person/67859"}}, {tmdbId:"67860", properties:{imdbId:"0356098", name:"Shari Hall", url:"https://themoviedb.org/person/67860"}}, {tmdbId:"926", properties:{bornIn:"St. Louis, Missouri, USA", imdbId:"0712954", born:date('1960-08-26'), name:"Ola Ray", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kUpBeOeoCIkLsIDoIXFch9GhEN0.jpg", url:"https://themoviedb.org/person/926"}}, {tmdbId:"1897702", properties:{name:"Tiana Davidson 'Thelma' Davis", url:"https://themoviedb.org/person/1897702"}}, {tmdbId:"110168", properties:{bornIn:"Woodmere, New York", imdbId:"0587548", born:date('1930-05-22'), name:"Harvey Milk", bio:"​From Wikipedia, the free encyclopedia\n\nHarvey Bernard Milk (May 22, 1930 – November 27, 1978) was an American politician who became the first openly gay man to be elected to public office in California, when he won a seat on the San Francisco Board of Supervisors.  Politics and gay activism were not his early interests; he was not open about his homosexuality and did not participate in civic matters until around the age of 40, after his experiences in the counterculture of the 1960s...", died:date('1978-11-27'), url:"https://themoviedb.org/person/110168"}}, {tmdbId:"7420", properties:{bornIn:"Brooklyn, New York, U.S.", imdbId:"0001213", born:date('1954-06-06'), name:"Harvey Fierstein", bio:"Harvey Forbes Fierstein is an American actor, playwright, and voice actor.  Fierstein has won the Tony Award for Best Actor in a Play for his own play Torch Song Trilogy (about a gay drag-performer and his quest for true love and family) and the Tony Award for Best Actor in a Musical for playing Edna Turnblad in Hairspray...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4th4mr9iR23DdjFjVGhrtCnJRNq.jpg", url:"https://themoviedb.org/person/7420"}}, {tmdbId:"1780067", properties:{name:"Anne Kronenberg", url:"https://themoviedb.org/person/1780067"}}, {tmdbId:"1780068", properties:{name:"Tory Hartmann", url:"https://themoviedb.org/person/1780068"}}, {tmdbId:"5576", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0000174", born:date('1959-12-31'), name:"Val Kilmer", bio:"Val Edward Kilmer (born December 31, 1959) is an American actor.  Originally a stage actor, Kilmer became popular in the mid-1980s after a string of appearances in comedy films, starting with Top Secret! (1984), then the cult classic Real Genius (1985), as well as blockbuster action films, including a role in Top Gun and a lead role in Willow...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/asscfTVTglxMBEeJiDYxUXM4bm9.jpg", url:"https://themoviedb.org/person/5576"}}, {tmdbId:"55907", properties:{bornIn:"London, England, UK", imdbId:"0349706", born:date('1956-11-28'), name:"Lucy Gutteridge", bio:"Lucy Karima Gutteridge (born 28 November 1956) is an English actress. \n\nGutteridge was born in London, the eldest daughter of Bernard Hugh Gutteridge by his marriage to Nabila Farah Karima Halim, the daughter of Prince Muhammad Said Bey Halim of Egypt and his British second wife, Nabila Malika (née Morwena Bird).  Gutteridge is a great-great-great-granddaughter of Muhammad Ali of Egypt, a Muslim subject of the Ottoman Empire (likely of Albanian ethnicity) who became the father of modern Egypt...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/atVD6PfgrBN1gGagnI63nNaQYdJ.jpg", url:"https://themoviedb.org/person/55907"}}, {tmdbId:"21170", properties:{bornIn:" Paris, France", imdbId:"0042104", born:date('1936-10-16'), name:"Michel Aumont", bio:"Michel Henri Aumont (15 October 1936 – 28 August 2019) was a French theatre, film, and television actor.  Throughout his career, he gained four Molière Awards and nominations for three César Awards.  In 2015, he was made Grand Officer of the National Order of Merit. \n\nBorn October 15, 1936 in Paris.  He studied at the Paris Conservatory of Dramatic Art. \n\nFrom the 1970s, he became one of the leading comedic actors in French cinema, despite having played mostly supporting roles...", died:date('2019-08-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4hplpAVRi4nxSTWwQcmH2Ok2AXF.jpg", url:"https://themoviedb.org/person/21170"}}, {tmdbId:"20851", properties:{bornIn:"Paris, France", imdbId:"0044535", born:date('1949-09-20'), name:"Sabine Azéma", bio:"From Wikipedia, the free encyclopedia\n\nSabine Azéma (born 20 September 1949) is a French actress.  Born in Paris, she graduated from the Paris Conservatory of Dramatic Arts, and began her film career in 1975...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kFbTZM6WRfTNW1B2zQGnaBe2t9F.jpg", url:"https://themoviedb.org/person/20851"}}, {tmdbId:"26659", properties:{bornIn:"London, England, UK", imdbId:"0000762", born:date('1948-01-12'), name:"Anthony Andrews", bio:"Anthony Andrews made his West End theater debut at the Apollo Theatre as one of twenty young schoolboys in Alan Bennett's \"Forty Years On\" with John Gielgud.  He began his career at the Chichester Festival Theatre in the UK.  His theater credits include spells with the New Shakespeare Company - \"Romeo and Juliet\" and \"A Midsummer Night's Dream\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kIZDuiguj7vQgc2md3XrZUBFAfO.jpg", url:"https://themoviedb.org/person/26659"}}, {tmdbId:"29508", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0646768", born:date('1973-08-24'), name:"Barret Oliver", bio:"Barret Spencer Oliver (born August 24, 1973) is an American photographer and former child actor.  He is known for his role as Bastian Balthazar Bux in the film adaptation of Michael Ende's novel The NeverEnding Story, followed by roles in D. A. R. Y. L. ,Cocoon and Cocoon: The Return...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3I2WOtca5upKiBAWVcRItCWCSog.jpg", url:"https://themoviedb.org/person/29508"}}, {tmdbId:"29512", properties:{bornIn:"Collins, Mississippi, USA", imdbId:"0574468", born:date('1947-08-19'), name:"Gerald McRaney", bio:"Gerald McRaney is an American film and television actor, best known for playing Rick Simon on the CBS television series \"Simon & Simon\" as well as Major John D.  MacGillis on the networks \"Major Dad\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qSqmLqAwK2gIdQ8aaiSzgBfcQiK.jpg", url:"https://themoviedb.org/person/29512"}}, {tmdbId:"62870", properties:{imdbId:"0308110", name:"Chris Eastman", bio:"Chris Eastman, or Drum Garrett early in the career, is an actor and producer, known for The NeverEnding Story (1984), It(1990) and Hot Rod (2007)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oLSYxZJafpabNBEHLlbcp3RAeTa.jpg", url:"https://themoviedb.org/person/62870"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"124433", properties:{imdbId:"0177530", name:"Darryl Cooksey", bio:"Darryl Cooksey is an actor, known for The NeverEnding Story (1984), The Love Tapes(1980) and Emerald Point N. A. S.  (1983)...", url:"https://themoviedb.org/person/124433"}}, {tmdbId:"19239", properties:{bornIn:"El Paso - Texas - USA", imdbId:"0412382", born:date('1951-09-04'), name:"Judith Ivey", bio:"From Wikipedia, the free encyclopedia\n\nJudith Lee Ivey (born September 4, 1951) is an American actress and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yaeKvc55qRoE3snY5axr86dQnHp.jpg", url:"https://themoviedb.org/person/19239"}}, {tmdbId:"38691", properties:{bornIn:"Westfield, Massachusetts, USA", imdbId:"0685771", born:date('1922-03-30'), name:"Anne Pitoniak", bio:"Anne Pitoniak (March 30, 1922 – April 22, 2007) was an American actress.  She was nominated twice for Broadway's Tony Award: as Best Actress (Play) in 1983, for 'night, Mother, and as Best Actress (Featured Role - Play) in 1994, for a revival of William Inge's Picnic. \n\nDescription above from the Wikipedia article Anne Pitoniak, licensed under CC-BY-SA, full list of contributors on  Wikipedia...", died:date('2007-04-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zcQf85EI3UyqDc9SKqrVCSKIOx5.jpg", url:"https://themoviedb.org/person/38691"}}, {tmdbId:"24535", properties:{bornIn:"Westport, Connecticut, U.S.", imdbId:"0335344", born:date('1955-06-21'), name:"David Marshall Grant", bio:"From Wikipedia, the free encyclopedia.   David Marshall Grant (born June 21, 1955) is an American actor and playwright. \n\nDescription above from the Wikipedia article David Marshall Grant, licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/81E0yZVUrojvq10qKRdSvNkq9up.jpg", url:"https://themoviedb.org/person/24535"}}, {tmdbId:"21259", properties:{bornIn:"Redondo Beach, California, USA", imdbId:"0001154", born:date('1954-10-08'), name:"Michael Dudikoff", bio:"From Wikipedia, the free encyclopedia. \n\nMichael Joseph Dudikoff II (born October 8, 1954) is an American actor who has been in numerous films, including the American Ninja series (1985-1990), Tron (1982), Bachelor Party (1984), Platoon Leader (1988), River of Death (1989), Soldier Boyz (1996), Ringmaster (1998), and The Silencer (1999), to name a few.  He is in pre-production for Havana Heat, an action thriller scheduled for release in 2011...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zumDXyG3uLvL87fSzGXybY4908e.jpg", url:"https://themoviedb.org/person/21259"}}, {tmdbId:"72542", properties:{bornIn:"Austin, Texas, U.S.", imdbId:"0465515", born:date('1944-07-22'), name:"Guich Koock", bio:"A sixth generation Texan, born and raised on a Texas ranch outside of Austin, Texas, Guich Koock (his stage name) attended Texas A&amp;M University, where he earned a BA in English and worked on an MA in Texas folklore by collecting stories from children of slaves.  After school he worked at various jobs including some small acting parts, school Headmaster, and restaurant manager...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/loRBK51lUh3J4H49XecsD0UiL3Z.jpg", url:"https://themoviedb.org/person/72542"}}, {tmdbId:"45446", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"0001227", born:date('1968-03-14'), name:"Megan Follows", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xs9N7l14E3e7UImspJgChLAhQZN.jpg", url:"https://themoviedb.org/person/45446"}}, {tmdbId:"521", properties:{bornIn:"Edmonton, Alberta, Canada", imdbId:"0000150", born:date('1961-06-09'), name:"Michael J. Fox", bio:"Born Michael Andrew Fox in Edmonton, Alberta, Canada, he adopted the \"J\" as an homage to character actor Michael J.  Pollard.  Moving several times during the course of his childhood, Michael and his family settled in Burnaby, a suburb of Vancouver.  At the age of 15 he made his professional acting debut in the situation comedy \"Leo and Me\" (1981). \n\nMoving to Los Angeles at the age of 18, Fox appeared in several small parts and a television series, \"Palmerstown, U. S. A...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2JB4FMgQmnhbBlQ4SxWFN9EIVDi.jpg", url:"https://themoviedb.org/person/521"}}, {tmdbId:"1062", properties:{bornIn:"Stamford, Connecticut, USA", imdbId:"0000502", born:date('1938-10-22'), name:"Christopher Lloyd", bio:"From Wikipedia, the free encyclopedia.  Christopher Allen Lloyd (born October 22, 1938) is an American actor.  He is best known for playing Doc Brown in the Back to the Future trilogy, Uncle Fester in The Addams Family films, and Judge Doom in Who Framed Roger Rabbit.  He played Reverend Jim Ignatowski in the television series Taxi and most recently Mr.  Goodman in Piranha 3D...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nxVjpyb3UrfbPZnEyDNlQVlFAs5.jpg", url:"https://themoviedb.org/person/1062"}}, {tmdbId:"1064", properties:{bornIn:"New York City, New York, USA", imdbId:"0000417", born:date('1964-04-20'), name:"Crispin Glover", bio:"Crispin Hellion Glover (born April 20, 1964) is an American film actor, director and screenwriter, recording artist, publisher and author...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/imBnLpSXvg61qDDdEfvL6R4ITKt.jpg", url:"https://themoviedb.org/person/1064"}}, {tmdbId:"3036", properties:{bornIn:"Evanston, Illinois, USA", imdbId:"0000131", born:date('1966-06-28'), name:"John Cusack", bio:"John Paul Cusack (born June 28, 1966 - Height: 6' 2½\" (1,89 m)) is an American film actor and screenwriter.  He has appeared in more than 50 films, including The Journey of Natty Gann, Say Anything. . . , Grosse Point Blank, Con Air, High Fidelity, and 2012. \n\nCusack was born in Evanston, Illinois, to a Catholic Irish-American family.  His mother, Ann Paula \"Nancy\" (née Carolan), is a former mathematics teacher and political activist...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lJ05lxBFZXJAZvmjp1ARxUmwrhA.jpg", url:"https://themoviedb.org/person/3036"}}, {tmdbId:"28010", properties:{bornIn:"Peoria, Illinois, USA", imdbId:"0001773", born:date('1942-10-31'), name:"David Ogden Stiers", bio:"From Wikipedia, the free encyclopedia\n\nDavid Ogden Stiers (October 31, 1942 – March 3, 2018) is an American actor, director, vocal actor, and musician, noted for his role in the television series MAS*H as Major Charles Emerson Winchester III and the science fiction drama The Dead Zone as Reverend Gene Purdy.  He was also known for his character Attorney Michael Reston in the Perry Mason TV Movies...", died:date('2018-03-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4pxfrWgLvoX2M1foU5MAC4jTdvK.jpg", url:"https://themoviedb.org/person/28010"}}, {tmdbId:"87562", properties:{bornIn:"California - USA", imdbId:"0805164", born:date('1972-08-15'), name:"Demian Slade", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3eKtsyXImI81s25566FECbJw9hG.jpg", url:"https://themoviedb.org/person/87562"}}, {tmdbId:"67620", properties:{imdbId:"0054344", name:"Grant Bardsley", url:"https://themoviedb.org/person/67620"}}, {tmdbId:"67621", properties:{imdbId:"0792262", born:date('1947-01-01'), name:"Susan Sheridan", bio:"Susan Sheridan  (born 1947) is a British actress.  Her voice acting roles include Noddy in the Cosgrove Hall/BBC Television series Noddy's Toyland Adventures, Trillian in the radio series The Hitchhiker's Guide to the Galaxy and Princess Eilonwy in the animated film The Black Cauldron...", url:"https://themoviedb.org/person/67621"}}, {tmdbId:"7675", properties:{bornIn:"Jersey City, New Jersey, U.S.", imdbId:"0322339", born:date('1939-05-04'), name:"Paul Gleason", bio:"From Wikipedia, the free encyclopedia\n\nPaul Xavier Gleason (May 4, 1939 – May 27, 2006) was an American film and television actor, known for his roles on TV series such as All My Children and films such as The Breakfast Club and Die Hard. \n\nDescription above from the Wikipedia article Paul Gleason, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2006-05-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a7PJofFcVpDxw2wAak1d56J7L4k.jpg", url:"https://themoviedb.org/person/7675"}}, {tmdbId:"1904", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0001309", born:date('1968-04-14'), name:"Anthony Michael Hall", bio:"Michael Anthony Hall (born April 14, 1968), known professionally as Anthony Michael Hall, is an American actor, producer and director who starred in several teen-oriented films of the 1980s.  Hall began his career in commercials and on stage as a child, and made his screen debut in 1980.  His films with director-screenwriter John Hughes, beginning with the popular 1984 coming-of-age comedy Sixteen Candles, shaped his early career...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eQnkUzHVrO69bQ08W82Qa9idJxp.jpg", url:"https://themoviedb.org/person/1904"}}, {tmdbId:"55554", properties:{bornIn:"London, Ontario, Canada", imdbId:"0438127", born:date('1956-03-08'), name:"John Kapelos", bio:"is an actor and producer is an actor and producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9buu5iq8FxJXMqMjmqEjm1zl2A6.jpg", url:"https://themoviedb.org/person/55554"}}, {tmdbId:"1756", properties:{bornIn:"Des Moines, Iowa, USA", imdbId:"0004834", born:date('1947-10-01'), name:"Stephen Collins", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ncig7dxNlbR6URDY4nUHkh008Mx.jpg", url:"https://themoviedb.org/person/1756"}}, {tmdbId:"61185", properties:{bornIn:"Lancashire, England, UK", imdbId:"0123201", born:date('1939-02-02'), name:"Jackie Burroughs", bio:"Jacqueline Burroughs (February 2, 1939 – September 22, 2010) was an English-born Canadian actress. \n\nDescription above from the Wikipedia article Jackie Burroughs, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2010-09-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mdLIWVAVQgHXPoP3nc6RJ9OFoCn.jpg", ur