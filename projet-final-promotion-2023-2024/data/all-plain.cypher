UNWIND [{tmdbId:"9158", properties:{bornIn:"Coventry, England, UK", imdbId:"0536632", born:date('1960-11-28'), name:"Sharon Maguire", bio:"​From Wikipedia, the free encyclopedia.   \n\nSharon Maguire (born 1960) made her name as a film director when she landed the job of directing Bridget Jones's Diary.  The film was based on the book by her close friend Helen Fielding, and one of the main characters - Shazzer - is actually based on Maguire...", url:"https://themoviedb.org/person/9158"}}, {tmdbId:"52044", properties:{bornIn:"Calgary, Alberta, Canada", imdbId:"0003941", born:date('1961-05-08'), name:"David Winning", bio:"​From Wikipedia, the free encyclopedia\n\nDavid Winning (born May 8, 1961) is a Canadian-born and American dual Citizen film and television director, screenwriter, producer, editor, and occasional actor.  Although Winning has worked in numerous film and TV genres, his name is most commonly associated with science fiction, thrillers and drama. \n\nDescription above from the Wikipedia article David Winning, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/52044"}}, {tmdbId:"1458224", properties:{imdbId:"0788488", name:"David Shapiro", bio:"David Shapiro has been a prolific filmmaker and visual artist for over twenty years.  He wrote, produced, and shares a film by credit for FINISHING HEAVEN (HBO, 2009), for which he was nominated for a 2010 Emmy as producer.  The film premiered at the Los Angeles Film Festival in 2009.  Shapiro co-directed, wrote and produced KEEP THE RIVER ON YOUR RIGHT.  The film had its international premiere at the Toronto Film Festival in 2000...", url:"https://themoviedb.org/person/1458224"}}, {tmdbId:"145605", properties:{bornIn:"Abilene, Kansas, USA", born:date('1888-02-10'), name:"Harry Beaumont", bio:"From Wikipedia\n\nHarry Beaumont (February 10, 1888 – December 22, 1966) was\n\nan American film director, actor, and screenwriter.  He worked for a variety of\n\nproduction companies including Fox, Goldwyn, Metro, Warner Brothers, and\n\nMetro-Goldwyn-Mayer. \n\nBeaumont's greatest successes were during the silent film\n\nera, when he directed films including John Barrymore's Beau Brummel (1924) and\n\nthe silent youth movie Our Dancing Daughters (1928), featuring Joan Crawford...", died:date('1966-12-22'), url:"https://themoviedb.org/person/145605"}}, {tmdbId:"53215", properties:{imdbId:"0585086", born:date('1964-12-15'), name:"Pete Michels", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2aGKvszKBp5eaPjpFQICN50UWlA.jpg", url:"https://themoviedb.org/person/53215"}}, {tmdbId:"1041420", properties:{imdbId:"2095742", name:"Kent Jones", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jMGQmcABPVrGQIUbvq6PvbIGtAA.jpg", url:"https://themoviedb.org/person/1041420"}}, {tmdbId:"39022", properties:{bornIn:"Bangalore, Karnataka, India", imdbId:"0656108", born:date('1935-09-21'), name:"Anthony Page", bio:"From Wikipedia, the free encyclopedia\n\nAnthony Page (21 September 1935, Bangalore, Karnataka, India) is a British stage- and film director. \n\nDescription above from the Wikipedia article Anthony Page (21 September 1935, Bangalore, Karnataka, India) is a British stage- and film director. , licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hgQmWvsqcW4ZQCZkrS6nearUmnZ.jpg", url:"https://themoviedb.org/person/39022"}}, {tmdbId:"137932", properties:{imdbId:"0093322", born:date('1952-05-09'), name:"Ben Bolt", url:"https://themoviedb.org/person/137932"}}, {tmdbId:"1218992", properties:{bornIn:"England", imdbId:"1414582", born:date('1977-01-01'), name:"Ben Palmer", bio:"Ben Palmer is an award winning British director who is made his name in television with comedy programmes such as Bo' Selecta, Star Stories and The Inbetweeners.  In 2011, Palmer was chosen to direct the big screen spin off of the latter, the hugely successful The Inbetweeners Movie, and in 2015 he subsequently followed this cinematic success up with the Simon Pegg/Lake Bell romcom Man Up...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/amHZxuDKfrCNHUR6uVomq7JafXk.jpg", url:"https://themoviedb.org/person/1218992"}}, {tmdbId:"218873", properties:{bornIn:"Manchukuo, China", born:date('1937-03-17'), name:"Hiroshi Saitou", bio:"Hiroshi Saitou is an animator and director.  He started his career at Mushi Pro...", url:"https://themoviedb.org/person/218873"}}, {tmdbId:"51845", properties:{bornIn:"USA", imdbId:"0068385", born:date('1943-01-16'), name:"Martin Bell", bio:"Martin Bell is an American film director best known for films such as Streetwise and American Heart...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iDcZNf1opK4l8FReBPEFCAGvIEH.jpg", url:"https://themoviedb.org/person/51845"}}, {tmdbId:"67593", properties:{bornIn:"Belfast, Northern Ireland", imdbId:"0576282", born:date('1944-12-22'), name:"Leslie Megahey", bio:"Leslie Megahey (born 22 December 1944) is a British television producer, director and writer. \n\nBorn in Belfast, Northern Ireland, the son of Thomas Megahey (a minister) and Beatrice (née Walton), Leslie Megahey was educated at King Edward VI School in Lichfield.  Early works for the BBC included Canvas: 7: Sunflowers: Van Gogh (1971), and Omnibus File: Thrillers and Crime Fiction (1972)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ArMlaHvJs42D48BC4zPQmUVKzS9.jpg", url:"https://themoviedb.org/person/67593"}}, {tmdbId:"562180", properties:{imdbId:"1381806", name:"J.T. Tepnapa", url:"https://themoviedb.org/person/562180"}}, {tmdbId:"563577", properties:{imdbId:"3011138", name:"Fernando Barreda Luna", url:"https://themoviedb.org/person/563577"}}, {tmdbId:"62797", properties:{bornIn:"New York City, New York, USA", imdbId:"0347657", born:date('1957-12-19'), name:"John Gulager", bio:"​From Wikipedia, the free encyclopedia.   \n\nJohn Thompson Gulager (born December 19, 1957) is an actor, cinematographer and film director. \n\nDescription above from the Wikipedia article John Gulager, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/62797"}}, {tmdbId:"184475", properties:{imdbId:"0710372", born:date('1933-08-16'), name:"Mort Ransen", url:"https://themoviedb.org/person/184475"}}, {tmdbId:"97755", properties:{bornIn:"Vicksburg, Mississippi, USA", imdbId:"0122344", born:date('1944-04-13'), name:"Charles Burnett", bio:"Charles Burnett is an African-American film director, producer, writer, editor, actor, photographer, and cinematographer.  His most popular films include Killer of Sheep (1977), My Brother’s Wedding (1983), To Sleep with Anger (1990), The Glass Shield (1994), and Namibia: The Struggle for Liberation (2007).  He has been involved in other types of motion pictures including shorts, documentaries, and a TV series...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/798g9dlNawhj20PbP0w5U4eqq.jpg", url:"https://themoviedb.org/person/97755"}}, {tmdbId:"1216147", properties:{imdbId:"0376006", name:"Anthony Hemingway", bio:"Anthony Hemingway is an assistant director and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3npAesb4X5yvxPlUWRHTOFz9RCi.jpg", url:"https://themoviedb.org/person/1216147"}}, {tmdbId:"935910", properties:{imdbId:"0815541", name:"Javier Soto", url:"https://themoviedb.org/person/935910"}}, {tmdbId:"7865", properties:{bornIn:"Madison - Wisconsin - USA", imdbId:"0104973", born:date('1968-10-01'), name:"Michael Brandt", bio:"Michael Brandt was born on October 1, 1968.  He is a writer and producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o162mmabhhfnciLAg2Lh33aRjG2.jpg", url:"https://themoviedb.org/person/7865"}}] AS row
