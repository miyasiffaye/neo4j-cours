UNWIND [{tmdbId:"4621", properties:{bornIn:"Eutin, Schleswig-Holstein, Germany", imdbId:"0695127", born:date('1960-03-26'), name:"Axel Prahl", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c5DLDLoo62cHCnDnEdMmQypNuNQ.jpg", url:"https://themoviedb.org/person/4621"}}, {tmdbId:"11213", properties:{bornIn:"Hannover, Germany", imdbId:"0274913", born:date('1948-05-11'), name:"Pam Ferris", bio:"Pamela Ann 'Pam' Ferris is a German-born Welsh actress.  She is best known for her starring roles on television as Ma Larkin in \"The Darling Buds of May\", as Laura Thyme in \"Rosemary & Thyme\", and for playing Miss Trunchbull in the movie \"Matilda\".  She also played the part of Aunt Marge in \"Harry Potter and the Prisoner of Azkaban\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vj6to5lMiIdFtYXIuHSPjbVBjgI.jpg", url:"https://themoviedb.org/person/11213"}}, {tmdbId:"27970", properties:{imdbId:"1423738", name:"Chris Ambrose", url:"https://themoviedb.org/person/27970"}}, {tmdbId:"27971", properties:{imdbId:"1423746", name:"Joey Krajcar", url:"https://themoviedb.org/person/27971"}}, {tmdbId:"27972", properties:{bornIn:"Union, Kentucky, USA", imdbId:"1242688", born:date('1992-10-12'), name:"Josh Hutcherson", bio:"Joshua Ryan \"Josh\" Hutcherson (born October 12, 1992) is an American film and television actor.  He began working in the early 2000s, appearing in several minor film and television roles.  He gained wider exposure with major roles in the 2005 films Little Manhattan and Zathura, the 2006 comedy RV, the 2007 family adventure film Firehouse Dog, and the film adaptations of Bridge to Terabithia, Journey to the Center of the Earth and Cirque du Freak: The Vampire's Assistant...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9VpZOzJnmuajtAdBizBhQBnjFrG.jpg", url:"https://themoviedb.org/person/27972"}}, {tmdbId:"27973", properties:{bornIn:"Poland, Ohio, USA", imdbId:"2895093", born:date('1922-03-13'), name:"Cameron Carter", url:"https://themoviedb.org/person/27973"}}, {tmdbId:"559670", properties:{bornIn:"Essendon, Victoria, Australia", imdbId:"0410455", born:date('1962-02-22'), name:"Steve Irwin", bio:"Steve Irwin was born in 1962 to parents Lyn and Bob Irwin, who were animal naturalists.  He shared the love for animals all his life, stemming from being raised at the Queensland Reptile and Fauna Park.  There, he partook in daily duties of animal feeding and care...", died:date('2006-09-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eEJGUmgpuaGVCWVGYuvdkXfNaA4.jpg", url:"https://themoviedb.org/person/559670"}}, {tmdbId:"559671", properties:{bornIn:"Eugene, Oregon, USA", imdbId:"0410457", born:date('1964-07-20'), name:"Terri Irwin", bio:"Theresa Penelope \"Terri\" Irwin, AM (née Raines; born July 20, 1964) is an Australian-based,[1] American-born naturalist, author, the widow of Australian naturalist Steve Irwin and owner of Australia Zoo at Beerwah, Queensland, Australia.  She co-starred with her husband on The Crocodile Hunter, their unconventional television nature documentary series along with its spin-off series, Croc Files and The Crocodile Hunter Diaries.  She has lived in Australia since 1992, when she married Steve Irwin...", url:"https://themoviedb.org/person/559671"}}, {tmdbId:"1371", properties:{bornIn:"Marrickville, Sydney, Australia", imdbId:"0920992", born:date('1965-09-21'), name:"David Wenham", bio:"David Wenham (born 21 September 1965) is an Australian actor who has appeared in movies, television series and theatre productions.  He is known in Hollywood for his roles as Faramir in The Lord of the Rings film trilogy, Carl in Van Helsing and Dilios in 300.  He is also known in his native Australia for his role as Diver Dan in SeaChange. \n\nDescription above from the Wikipedia David Wenham, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xDUXLTF5i2fYx7eSEAR3IdaUb9y.jpg", url:"https://themoviedb.org/person/1371"}}, {tmdbId:"35597", properties:{bornIn:"Chicago - Illinois - USA", imdbId:"0000189", born:date('1972-11-01'), name:"Jenny McCarthy", bio:"From Wikipedia, the free encyclopedia. \n\nJennifer Ann \"Jenny\" McCarthy (born November 1, 1972) is an American model, comedian, actress, author and activist.  She began her career as a Playboy magazine model in 1993, before launching a television and film acting career.  Most recently, she has written books about parenting, and has become an activist promoting claims—not supported by medical evidence—that vaccines cause autism and chelation therapy helps cure it...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cXg5kYrNRWLtss3nrolpX3wGFNq.jpg", url:"https://themoviedb.org/person/35597"}}, {tmdbId:"35799", properties:{bornIn:"Port Alberni, British Columbia, Canada", imdbId:"0256988", name:"Marny Eng", bio:"From Wikipedia, the free encyclopedia. \n\nMarny Eng (sometimes credited as Marney Eng, Marnie Eng or Marni Eng) is a Canadian stuntwoman and stunt coordinator who has performed stunts in well over 100 films since the early 1990s.  She has been the stunt double for numerous famous actresses such as Lucy Liu, Christina Ricci, Kristin Kreuk and Rachael Leigh Cook.  As an actress, she is most famous for portraying Tabitha, the Samara Morgan parody from Scary Movie 3...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sRyJNvQdYD4a6AiTYPY2ruuYBMU.jpg", url:"https://themoviedb.org/person/35799"}}, {tmdbId:"1913797", properties:{name:"Jean-Marie Lhomme", url:"https://themoviedb.org/person/1913797"}}, {tmdbId:"57737", properties:{imdbId:"1431237", name:"Esmée Buchet-Deàk", url:"https://themoviedb.org/person/57737"}}, {tmdbId:"5958", properties:{bornIn:"Houston, Texas, USA", imdbId:"0240381", born:date('1987-09-28'), name:"Hilary Duff", bio:"Hilary Erhard Duff (born September 28, 1987) is an American actress, singer song-writer and book author.  After working in local theater plays and television commercials in her childhood, Duff gained fame for playing the title role in the Disney Channel television series Lizzie McGuire.  She subsequently ventured into motion pictures and has many successful films to her credit including The Lizzie McGuire Movie, Cheaper by the Dozen, A Cinderella Story and Cheaper by the Dozen 2...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/48Pwyp6ASq8MjW2g4JERj47TeO4.jpg", url:"https://themoviedb.org/person/5958"}}, {tmdbId:"143330", properties:{bornIn:"New York City, New York, USA", imdbId:"0483047", born:date('1984-09-14'), name:"Adam Lamberg", bio:"From Wikipedia, the free encyclopedia.   Adam Lamberg (born September 14, 1984) is an American actor, perhaps best known for his portrayal of David \"Gordo\" Gordon in the Disney Channel series Lizzie McGuire from 2001 through 2004.   Lamberg was born in New York City, the son of Suzanne, a public high school teacher, and Marc Lamberg.  His father is Jewish and his mother is French Canadian; Lamberg considers himself to be a \"cultural Jew...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mKA29qvePmhGe3dPFM5CQXPZd9H.jpg", url:"https://themoviedb.org/person/143330"}}, {tmdbId:"82625", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0604699", born:date('1962-01-07'), name:"Hallie Todd", bio:"Hallie Todd (born January 7, 1962) is an American actress, producer and writer, known for her roles as Penny Waters on Brothers and as Jo McGuire on Lizzie McGuire...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zWLK37dG5FnBFPMFf2ahWdHUd6I.jpg", url:"https://themoviedb.org/person/82625"}}, {tmdbId:"88838", properties:{imdbId:"0662904", born:date('1951-03-01'), name:"Andrew Parks", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7mBajdAZ0vEorHpDuL6wIL6rRBX.jpg", url:"https://themoviedb.org/person/88838"}}, {tmdbId:"88839", properties:{imdbId:"1120738", name:"Susan McConnell", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qgpVIrHq3hAXVxpgfqTd3shGCU1.jpg", url:"https://themoviedb.org/person/88839"}}, {tmdbId:"1990", properties:{imdbId:"0397788", name:"Brian Howe", bio:"Brian Howe is an American film and television actor, best known for playing stockbroker Jay Twistle in the feature film \"The Pursuit of Happyness\" and many other film supporting roles, as well as guest roles in a number of television series', including \"Crossing Jordan\", \"Boston Legal\", and \"Westworld\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dOBRUHkmvQ8uuMVriumqZZTqFx3.jpg", url:"https://themoviedb.org/person/1990"}}, {tmdbId:"1577419", properties:{name:"Ann Finnell", url:"https://themoviedb.org/person/1577419"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"1577420", properties:{name:"Patrick McGuinness", url:"https://themoviedb.org/person/1577420"}}, {tmdbId:"1577421", properties:{name:"James Williams", url:"https://themoviedb.org/person/1577421"}}, {tmdbId:"1577422", properties:{name:"Michael Glover", url:"https://themoviedb.org/person/1577422"}}, {tmdbId:"64453", properties:{bornIn:"Seoul, South Korea", imdbId:"0128345", born:date('1965-06-30'), name:"Jae-hyeon Jo", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/54ZAfu0l1xzfzEpcyhk668c26IS.jpg", url:"https://themoviedb.org/person/64453"}}, {tmdbId:"2429613", properties:{name:"Yun-tae Kim", url:"https://themoviedb.org/person/2429613"}}, {tmdbId:"105763", properties:{imdbId:"1118214", name:"Andy Goldsworthy", bio:"Andy Goldsworthy OBE is a British sculptor, photographer and environmentalist, producing site-specific sculptures and land art situated in natural and urban settings.  He lives and works in Scotland...", url:"https://themoviedb.org/person/105763"}}, {tmdbId:"19492", properties:{bornIn:"Saint Matthews, South Carolina, USA", imdbId:"0205626", born:date('1965-08-11'), name:"Viola Davis", bio:"Viola Davis (born August 11, 1965) is an American actress.  Known primarily as a stage actress, Davis won a Tony Award for Best Performance by a Featured Actress in a Play and a Drama Desk Award for her role in King Hedley II (2001).  She won a Tony Award for Best Performance by a Leading Actress in a Play for her role in Fences.  She won a second Drama Desk Award for Intimate Apparel (2004). \n\nHer films include Traffic (2000), Antwone Fisher (2002), and Solaris (2002)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xDssw6vpYNRjsybvMPRE30e0dPN.jpg", url:"https://themoviedb.org/person/19492"}}, {tmdbId:"19754", properties:{bornIn:"Uniontown, Alabama, USA", imdbId:"0185272", born:date('1958-03-31'), name:"Tony Cox", bio:"Joseph Anthony \"Tony\" Cox is an American actor known for his comedic performances in Bad Santa, Me, Myself and Irene, Date Movie, Epic Movie and Disaster Movie.  He is also known for his work in George Lucas's Willow, as an Ewok in Star Wars Episode VI: Return of the Jedi and as The Preacher in Tim Burton's Beetlejuice.  Cox also appeared in the music videos \"Just Lose It\" by Eminem and \"From tha Chuuuch to da Palace\" by Snoop Dogg...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wMXBdnkCOoPM8iPPALcaKaO77Oc.jpg", url:"https://themoviedb.org/person/19754"}}, {tmdbId:"63992", properties:{bornIn:" Vancouver, British Columbia, Canada", imdbId:"0962260", born:date('1993-10-30'), name:"Brett Kelly", bio:"Brett Edward Kelly is a Canadian actor who has starred in the motion pictures Bad Santa, and Like Mike 2: Streetball as well as The Sandlot 2 and Unaccompanied Minors.  More recently, he starred in the movie Trick 'r Treat.  Kelly was born in Vancouver, British Columbia and currently attends The University of British Columbia; he lives in Surrey, British Columbia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kHPBsKWF4Cap70LVy41vL5ADyLW.jpg", url:"https://themoviedb.org/person/63992"}}, {tmdbId:"52847", properties:{bornIn:"New York City, New York, USA", imdbId:"0117146", born:date('1974-10-18'), name:"Joy Bryant", bio:"Joy Bryant is an American actress and former fashion model.  She has appeared in numerous films and television series since beginning her acting career in 2001.  Her accolades include two NAACP Image Award nominations and one Screen Actors Guild Award nomination...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z0QhsSGfgUQRc8nHVNtxkszf5ta.jpg", url:"https://themoviedb.org/person/52847"}}, {tmdbId:"11007", properties:{bornIn:"Glasgow, Scotland, UK", imdbId:"0661917", born:date('1974-08-23'), name:"Ray Park", bio:"Raymond Park is a British actor, stuntman and martial artist, best known for his playing the physical part of Darth Maul in Star Wars Episode I: The Phantom Menace, Toad in X-Men, Snake-Eyes in G. I.  Joe: The Rise of Cobra, and Edgar on Heroes...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9vXMsJrrTFHPsBewHQ19sckn9JJ.jpg", url:"https://themoviedb.org/person/11007"}}, {tmdbId:"71641", properties:{bornIn:"Fukuoka, Japan", imdbId:"0475878", born:date('1960-10-05'), name:"Hitomi Kuroki", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4rGUnsCPTkgWTOq6CWfkD3BT1sl.jpg", url:"https://themoviedb.org/person/71641"}}, {tmdbId:"71644", properties:{imdbId:"1287602", name:"Rio Kanno", url:"https://themoviedb.org/person/71644"}}, {tmdbId:"71642", properties:{imdbId:"1290029", name:"Mirei Oguchi", url:"https://themoviedb.org/person/71642"}}, {tmdbId:"71643", properties:{bornIn:"Kyoto, Japan", imdbId:"0594655", born:date('1983-07-24'), name:"Asami Mizukawa", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/s65mobAWexnr8QroTXvJUeem6o1.jpg", url:"https://themoviedb.org/person/71643"}}, {tmdbId:"156509", properties:{bornIn:"Olympia, Washington, USA", imdbId:"0353631", born:date('1969-02-09'), name:"Dylan Haggerty", url:"https://themoviedb.org/person/156509"}}, {tmdbId:"96900", properties:{bornIn:"Bedford, Ohio, USA", imdbId:"0265309", name:"Renee Faia", url:"https://themoviedb.org/person/96900"}}, {tmdbId:"1574427", properties:{name:"Kelsey Kemper", url:"https://themoviedb.org/person/1574427"}}, {tmdbId:"58197", properties:{bornIn:"Columbus, Ohio, USA", imdbId:"0510168", born:date('1987-03-09'), name:"Shad Moss", bio:"​From Wikipedia, the free encyclopedia.   \n\nShad Gregory Moss (born March 9, 1987) is an American rapper and actor.  As Lil' Bow Wow, Moss made his rap debut with Beware of Dog in 2000 at the age of 13.  He followed with Doggy Bag in 2002 and became Bow Wow.  Bow Wow made his first movie appearance in All About the Benjamins, in 2002 as a cameo.  In the same year, Bow Wow made his debut as the lead role in, Like Mike...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xsvJmcOQiocYcKtRmfiQbjzVrVw.jpg", url:"https://themoviedb.org/person/58197"}}, {tmdbId:"88123", properties:{bornIn:"Carmichael, California, U.S.", imdbId:"0814259", born:date('1988-03-27'), name:"Brenda Song", bio:"Brenda Song (born March 27, 1988) is an American actress, film producer, and model.  Song started in show business as a child fashion model.  Her early television work included roles in the shows Fudge (1995) and 100 Deeds for Eddie McDowd (1999).  After many commercials and television roles in the late 1990s, Song won a Young Artist Award for her performance in The Ultimate Christmas Present (2000)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nJOB9ZbIchbk0omaMq9E2C22J8x.jpg", url:"https://themoviedb.org/person/88123"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"108322", properties:{bornIn:"Montebello, California, USA", imdbId:"1226872", born:date('1971-02-13'), name:"Rochelle Ballard", bio:"From Wikipedia, the free encyclopedia\n\nRochelle Ballard is a professional female surfer who is a 10 year veteran the Association of Surfing Professional’s (ASP) World Championship Tour.  She is considered the best female tube rider in the world and has been a pioneer to the advancement of women’s surfing in the past two decades.  Ballard's mastery of big waves and support of women's surfing rank her among the surfing most elite...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qXpcbPX1hGH1oJ8WZCvdrNohRjj.jpg", url:"https://themoviedb.org/person/108322"}}, {tmdbId:"108323", properties:{imdbId:"1304124", name:"Shawn Barron", url:"https://themoviedb.org/person/108323"}}, {tmdbId:"108324", properties:{bornIn:"Sydney, New South Wales, Australia", imdbId:"1226909", born:date('1972-05-24'), name:"Layne Beachley", bio:"From Wikipedia, the free encyclopedia\n\nLayne Beachley is a former professional surfer from Manly, Australia.  She won the World Championship seven times. \n\nDescription above from the Wikipedia article Layne Beachley, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kMqQ4N6O1VjnkbbnoDAX31ViVF9.jpg", url:"https://themoviedb.org/person/108324"}}, {tmdbId:"19725", properties:{bornIn:"London, England, UK", imdbId:"0342617", born:date('1952-10-28'), name:"Tony Grisoni", bio:"​From Wikipedia, the free encyclopedia\n\nTony Grisoni (born October 28, 1952) is a British screenwriter. \n\nDescription above from the Wikipedia article Tony Grisoni, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/19725"}}, {tmdbId:"59792", properties:{imdbId:"0666353", name:"Philip A. Patterson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kPUlWbXC2rTtZhMGRMWjrbocG37.jpg", url:"https://themoviedb.org/person/59792"}}, {tmdbId:"34906", properties:{imdbId:"0165983", name:"René Cleitman", url:"https://themoviedb.org/person/34906"}}, {tmdbId:"132039", properties:{bornIn:"Helsinki, Finland", imdbId:"1127735", born:date('1969-12-28'), name:"Linus Torvalds", url:"https://themoviedb.org/person/132039"}}, {tmdbId:"132038", properties:{bornIn:"Manhattan, New York, USA", imdbId:"1128476", born:date('1953-03-16'), name:"Richard M. Stallman", url:"https://themoviedb.org/person/132038"}}, {tmdbId:"1480810", properties:{imdbId:"0673302", born:date('1958-01-01'), name:"Bruce Perens", url:"https://themoviedb.org/person/1480810"}}, {tmdbId:"57991", properties:{bornIn:"Manhattan, New York, U.S.", imdbId:"0208962", born:date('1958-08-26'), name:"Wanda De Jesus", bio:"From Wikipedia, the free encyclopedia.   Wanda De Jesus (born August 26, 1958) is a American actress.  She is most notably recognized for her role as the fourth actress to portray Santana Andrade in NBC's soap opera Santa Barbara.  Aside from her work on soap operas, Wanda appeared in several TV shows in a guest starring role, and she had a recurring role on CBS' crime series CSI: Miami as MDPD Detective Adelle Sevilla...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cJNzcJqYE4oBuYaj2SsEtL7K1Xs.jpg", url:"https://themoviedb.org/person/57991"}}, {tmdbId:"34490", properties:{bornIn:"Tampa, Florida, USA", imdbId:"0005299", born:date('1974-12-17'), name:"Sarah Paulson", bio:"Sarah Catharine Paulson (born December 17, 1974) is an American actress. \n\nDescription above from the Wikipedia article Sarah Paulson, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jkhpv4oPNcMSvPPDUuCyPIFwYyS.jpg", url:"https://themoviedb.org/person/34490"}}, {tmdbId:"17236", properties:{bornIn:"Oshawa, Ontario, Canada", imdbId:"0176882", born:date('1978-07-22'), name:"A.J. Cook", bio:"Andrea Joy \"A. J. \" Cook (born July 22, 1978) is a Canadian actress best known for her role as Supervisory Special Agent Jennifer \"JJ\" Jareau in the CBS crime drama Criminal Minds.  She has also appeared in several Hollywood films including The Virgin Suicides, Out Cold, and Final Destination 2. \n\nCook was born in Oshawa, Ontario, and spent most of her life growing up in Whitby, where she attended Anderson Collegiate Vocational Institute...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tvEjGDQVuu7jiOvWXwEU6tEE7NW.jpg", url:"https://themoviedb.org/person/17236"}}, {tmdbId:"33293", properties:{bornIn:"Vancouver, British Columbia, Canada", imdbId:"0655959", born:date('1978-11-10'), name:"David Paetkau", bio:"David E.  Paetkau (born November 10, 1972) is a Canadian actor who is perhaps best known for his roles of Evan Lewis in Final Destination 2 (2003) (in which his character meets a grisly fate with a ladder) and the deceased Beck McKaye in Whistler (2006–08).  He has also appeared in I'll Always Know What You Did Last Summer (2006), Aliens vs...", url:"https://themoviedb.org/person/33293"}}, {tmdbId:"44557", properties:{bornIn:" Essex, England, UK", imdbId:"0278746", born:date('1967-04-06'), name:"Jonathan Firth", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nQ9H2xRh5uLy047AEeKtTNas9cu.jpg", url:"https://themoviedb.org/person/44557"}}, {tmdbId:"44635", properties:{imdbId:"0184967", born:date('1975-12-19'), name:"Claire Cox", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wXVQUuNXgJagSxPccoZwgdr5k5N.jpg", url:"https://themoviedb.org/person/44635"}}, {tmdbId:"134699", properties:{bornIn:"Greenock, Scotland, UK", imdbId:"0327291", born:date('1963-05-08'), name:"Stella Gonet", bio:"Stella Gonet is a Scottish theatre, film and television actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cUmDfX4fNvtAl5199HUc29ZDsAc.jpg", url:"https://themoviedb.org/person/134699"}}, {tmdbId:"176191", properties:{bornIn:"UK", imdbId:"0369854", born:date('1965-01-01'), name:"Andrew Havill", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/135ru0B7vX7PXGQ7IjbDnBshk1C.jpg", url:"https://themoviedb.org/person/176191"}}, {tmdbId:"2173015", properties:{name:"Henry McGrath", url:"https://themoviedb.org/person/2173015"}}, {tmdbId:"1364032", properties:{bornIn:"England - UK", imdbId:"1087234", born:date('1989-09-07'), name:"Hugh Mitchell", bio:"Hugh Mitchell was born on September 7, 1989 in England as Hugh William Mitchell.  He is an actor, known for Harry Potter and the Chamber of Secrets (2002), The Da Vinci Code (2006) and Nicholas Nickleby (2002)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iKGEuJnUbYqxg0DaVexx10X9yNi.jpg", url:"https://themoviedb.org/person/1364032"}}, {tmdbId:"10912", properties:{bornIn:"Paris, France", imdbId:"1200692", born:date('1980-07-06'), name:"Eva Green", bio:"Eva Gaëlle Green, born July 6th 1980, is a French actress and model.  She started her career in theatre before making her film debut in 2003 in Bernardo Bertolucci's controversial The Dreamers.  She achieved international recognition when she appeared in Ridley Scott's Kingdom of Heaven, and portrayed Vesper Lynd in the James Bond film Casino Royale.  In 2006, Green was awarded the BAFTA Rising Star Award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8MqXy7Jd6HsRSBFK05J0KrR2x5Z.jpg", url:"https://themoviedb.org/person/10912"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"16269", properties:{bornIn:"Paris, France", imdbId:"0308039", born:date('1983-06-14'), name:"Louis Garrel", bio:"Louis Garrel (born 14 June 1983 in Paris) is a French actor.  He is best known for his starring role in The Dreamers, directed by Bernardo Bertolucci.  He regularly appears in films by French director Christophe Honoré, including Ma mère, Dans Paris, Les Chansons d'amour, La Belle Personne and Non ma fille, tu n'iras pas danser...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lrGbGrTogl6f1by8OnZEsvI63kY.jpg", url:"https://themoviedb.org/person/16269"}}, {tmdbId:"10731", properties:{bornIn:"Richmond, Surrey, England, UK", imdbId:"0151250", born:date('1965-04-27'), name:"Anna Chancellor", bio:"Anna Chancellor is a British actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gKU8hHdC45q9WpYy4SeNLEhPwtK.jpg", url:"https://themoviedb.org/person/10731"}}, {tmdbId:"116235", properties:{imdbId:"1277721", name:"Jamal Udin Torabi", url:"https://themoviedb.org/person/116235"}}, {tmdbId:"116236", properties:{imdbId:"1275494", name:"Enayatullah", url:"https://themoviedb.org/person/116236"}}, {tmdbId:"116237", properties:{imdbId:"1276937", name:"Imran Paracha", url:"https://themoviedb.org/person/116237"}}, {tmdbId:"1216016", properties:{imdbId:"0604272", name:"Jim Moret", url:"https://themoviedb.org/person/1216016"}}, {tmdbId:"60634", properties:{imdbId:"0067506", born:date('1975-09-19'), name:"Marty Belafsky", url:"https://themoviedb.org/person/60634"}}, {tmdbId:"25004", properties:{bornIn:"Seoul, South Korea", imdbId:"0793784", born:date('1974-05-30'), name:"Ha-kyun Shin", bio:"Shin Ha-kyun (Sin Ha-gyun) (born May 30, 1974) is a South Korean actor.  He first trained as a stage actor at the Seoul Institute of the Arts, before transitioning to film and gaining national fame with his role as a North Korean soldier in Joint Security Area.  After the success of JSA, Shin has appeared in many critically or popularly acclaimed roles, including parts in Guns & Talks, Sympathy for Mr.  Vengeance and Save the Green Planet!...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4UF7bfqwWUt8gZPH8t7fWuoGQVX.jpg", url:"https://themoviedb.org/person/25004"}}, {tmdbId:"21688", properties:{bornIn:"Jongno, Seoul, South Korea", imdbId:"0046277", born:date('1979-10-11'), name:"Doona Bae", bio:"Bae Doo-na (born October 11, 1979) is a South Korean actress and photographer.  She is best known outside Korea for her role as the protagonist's political activist girlfriend, Cha Yeong-mi, in Park Chan-wook's film Sympathy for Mr.  Vengeance (2002) and as archer Park Nam-ju in The Host (2006). \n\nDescription above from the Wikipedia article Bae Doo-na, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zdpukWKhdeb2Xw0lLnR85ONdorp.jpg", url:"https://themoviedb.org/person/21688"}}, {tmdbId:"39256", properties:{bornIn:"Seoul - South Korea", imdbId:"0510546", born:date('1973-02-27'), name:"Ji-Eun Lim", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pV9lnRdARU7BmT1TOJxZYziAIdk.jpg", url:"https://themoviedb.org/person/39256"}}, {tmdbId:"566295", properties:{born:date('1908-06-26'), name:"Salvador Allende", died:date('1973-09-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hq7aDg0xHPXWyLatwE7s637uyTF.jpg", url:"https://themoviedb.org/person/566295"}}, {tmdbId:"1335009", properties:{imdbId:"0033359", name:"Jacobo Arbenz", url:"https://themoviedb.org/person/1335009"}}, {tmdbId:"1335010", properties:{imdbId:"1706807", name:"Mike Bradley", url:"https://themoviedb.org/person/1335010"}}, {tmdbId:"19655", properties:{bornIn:"London, England, UK", imdbId:"0195439", born:date('1975-08-24'), name:"James D'Arcy", bio:"An English actor.  His first appearances on television were small roles in the TV series Silent Witness (1996) and Dalziel and Pascoe (1996), followed by roles in TV movies such as Nicholas Hawthorne in Ruth Rendell's Bribery and Corruption (1997), Lord Cheshire in The Canterville Ghost (1997) and Jonathan Maybury in The Ice House (1997).  In 1997 he furthermore played Blifil in the Mini-series The History of Tom Jones, a Foundling...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/m2yEhWXGpxUC9aBFLfJQFEnt0yn.jpg", url:"https://themoviedb.org/person/19655"}}, {tmdbId:"219496", properties:{imdbId:"0940105", name:"Edward Woodall", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w0T7X9qNU5P0IhiLhurvshjpqoB.jpg", url:"https://themoviedb.org/person/219496"}}, {tmdbId:"10959", properties:{bornIn:"Los Angeles, California, USA ", imdbId:"0479471", born:date('1986-06-11'), name:"Shia LaBeouf", bio:"Shia Saide LaBeouf is an American actor, voice actor, and comedian.  LaBeouf began his comedy career when he was 10 years old, and then launched his acting career in 1998 at the age of 12.  He became known among younger audiences for his part in the Disney Channel series Even Stevens, also appearing in three Disney TV movies.  In 2003, LaBeouf made his theatrical film debut in Holes, also appearing in the lead role in The Battle of Shaker Heights that same year...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/frYAEeYMi9jdt9MIjGA8vCr5yUC.jpg", url:"https://themoviedb.org/person/10959"}}, {tmdbId:"8809", properties:{bornIn:" Munich, Bavaria, Germany", imdbId:"0432622", born:date('1920-03-16'), name:"Traudl Junge", bio:"Gertraud \"Traudl\" Junge , born Humps, was a German editor who worked as Adolf Hitler's last private secretary from December 1942 to April 1945.  After typing out Hitler's will, she remained in the Berlin Führerbunker until his death...", died:date('2002-02-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eCOxqAWD7ITzvSYX8YyFjX5V6xC.jpg", url:"https://themoviedb.org/person/8809"}}, {tmdbId:"42307", properties:{bornIn:"Sydney, New South Wales, Australia", imdbId:"0933959", born:date('1970-11-18'), name:"Peta Wilson", bio:"From Wikipedia, the free encyclopedia\n\nPeta Gia Wilson (born 18 November 1970) is an Australian actress and model.  She is best known as Nikita in the television series La Femme Nikita. \n\nDescription above from the Wikipedia article Peta Wilson, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jGx9RCL465DCisyOunqYTUzR4N5.jpg", url:"https://themoviedb.org/person/42307"}}, {tmdbId:"2220", properties:{bornIn:"Port Glasgow, Scotland, UK", imdbId:"0192889", born:date('1969-12-13'), name:"Tony Curran", bio:"Anthony \"Tony\" Curran (born 13 December 1969) is a Scottish actor. \n\nCurran was born in Glasgow, Scotland.  He is an alumnus of Holyrood Secondary School and is a graduate of the Royal Scottish Academy of Music and Drama. \n\nTony rose to fame in the BBC television series This Life.  Since then, the Scots star has appeared in a number of major film and television roles. \n\nSome of his roles have included The Invisible Man in The League of Extraordinary Gentlemen...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pmEt3NTwNO7Tnoeu9qUCtqaYaMV.jpg", url:"https://themoviedb.org/person/2220"}}, {tmdbId:"52355", properties:{bornIn:"Helsinki, Finland", imdbId:"0671326", born:date('1956-07-12'), name:"Markku Peltola", bio:"From Wikipedia, the free encyclopedia. \n\nMarkku Peltola (12 July 1956 – 31 December 2007) was a Finnish actor and musician.  He was born in Helsinki and grew up there.  He was actively involved in founding and acting with the Telakka Theater in Tampere. \n\nPeltola is best known for starring opposite Kati Outinen in Aki Kaurismäki's Academy Award nominated film from 2002 The Man Without a Past...", died:date('2007-12-31'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kdrwQ83lq6ua51W90cJkIvLmOyc.jpg", url:"https://themoviedb.org/person/52355"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"52356", properties:{bornIn:"Iitti, Finland", imdbId:"0631112", born:date('1941-06-17'), name:"Juhani Niemelä", url:"https://themoviedb.org/person/52356"}}, {tmdbId:"52357", properties:{bornIn:"Rääkkylä, Finland", imdbId:"0657090", born:date('1954-01-07'), name:"Kaija Pakarinen", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9wEKd2q2pQLFiXHL7m0snxuOC4Q.jpg", url:"https://themoviedb.org/person/52357"}}, {tmdbId:"17486", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"0683467", born:date('1985-11-27'), name:"Alison Pill", bio:"Alison Courtney Pill (born November 27, 1985) is a Canadian film, television and theatre actress. \n\nDescription above from the Wikipedia article Alison Pill, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/A9T51aMP3xQ6CkyHA0uFYlavTVF.jpg", url:"https://themoviedb.org/person/17486"}}, {tmdbId:"7318", properties:{bornIn:"Farnworth, Lancashire, UK", imdbId:"0443153", born:date('1973-07-02'), name:"Peter Kay", url:"https://themoviedb.org/person/7318"}}, {tmdbId:"41508", properties:{bornIn:"Bronx - New York - USA", imdbId:"0835725", born:date('1959-01-13'), name:"Jason Stuart", url:"https://themoviedb.org/person/41508"}}, {tmdbId:"85210", properties:{bornIn:"Casper, Wyoming, USA", imdbId:"0120160", born:date('1955-02-09'), name:"Jim J. Bullock", url:"https://themoviedb.org/person/85210"}}, {tmdbId:"85211", properties:{imdbId:"0184545", name:"Christopher Cowan", url:"https://themoviedb.org/person/85211"}}, {tmdbId:"1235908", properties:{name:"Fritz Greve", url:"https://themoviedb.org/person/1235908"}}, {tmdbId:"43131", properties:{bornIn:" Omagh, County Tyrone, Northern Ireland", imdbId:"0574561", born:date('1950-09-14'), name:"Gerard McSorley", bio:"​From Wikipedia, the free encyclopedia.   \n\nGerard McSorley (born 1950) is a theatre, television and an Irish film actor. \n\nDescription above from the Wikipedia article  Gerard McSorley, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1TcMqQbW5Uu8ChxS1lg3BlVHhBn.jpg", url:"https://themoviedb.org/person/43131"}}, {tmdbId:"145928", properties:{imdbId:"0389880", name:"Mai Hosho", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qpTb1srRE0205QjOgqFyJ88j1vP.jpg", url:"https://themoviedb.org/person/145928"}}, {tmdbId:"1025312", properties:{born:date('1973-01-02'), name:"Tamao Satô", url:"https://themoviedb.org/person/1025312"}}, {tmdbId:"7351", properties:{bornIn:"Cancun, Quintana Roo, Mexico", imdbId:"0847799", born:date('1980-05-01'), name:"Ana Claudia Talancón", bio:"​From Wikipedia, the free encyclopedia.             Ana Claudia Talancon was born on May 1st, 1980 in Cancun, Mexico.  Her first performance was in her home town Quintana Roo in Cancun.   She studied acting in Cancun with the Cuban professor Albio Paz.  She later went to Mexico City to continue her studies at the Acting Workshop of Héctor Mendoza and Raúl Quintanilla...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/es8No01z8G0MFX2KeiAa2ouRfCD.jpg", url:"https://themoviedb.org/person/7351"}}, {tmdbId:"7352", properties:{bornIn:"Madrid", imdbId:"0333466", born:date('1936-09-27'), name:"Sancho Gracia", died:date('2012-08-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gxX2SlP8JkTUW5Nc4n0wyn2AxZU.jpg", url:"https://themoviedb.org/person/7352"}}, {tmdbId:"7353", properties:{bornIn:"Mexico City, Mexico", imdbId:"0032793", born:date('1953-07-11'), name:"Angélica Aragón", bio:"​From Wikipedia, the free encyclopedia\n\nAngélica Aragón (born July 11, 1953) is a Mexican actress of telenovelas and such films as Dune, A Walk in the Clouds, Bella, Dirty Dancing: Havana Nights, Mirada de mujer, Novia que te vea, and the blockbuster film Sexo, pudor y lágrimas. \n\nDescription above from the Wikipedia article Angélica Aragón, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jUTBlm2ioMLODzRV9Su0e1Ljwq5.jpg", url:"https://themoviedb.org/person/7353"}}, {tmdbId:"8170", properties:{bornIn:"Miami - Florida - USA", imdbId:"0578949", born:date('1974-03-05'), name:"Eva Mendes", bio:"Eva Mendes (born March 5, 1974, height 5' 6\" (1,68 m)) is an American actress, model, singer, and homeware and fashion designer.  She began acting in the late 1990s, and after a series of roles in B movies such as Children of the Corn V: Fields of Terror (1998) and Urban Legends: Final Cut (2000), she broke into the Hollywood mainstream with an appearance in Training Day (2001)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uj6IaUDEUB7swj46dPjHAi3TEk4.jpg", url:"https://themoviedb.org/person/8170"}}, {tmdbId:"16628", properties:{bornIn:"Greenock, Inverclyde, Scotland", imdbId:"1161994", born:date('1984-05-08'), name:"Martin Compston", bio:"From Wikipedia, the free encyclopedia\n\nMartin Compston (born 8 May 1984) is a Scottish actor and former professional footballer.  He is perhaps most notable for his role as Liam in Sweet Sixteen, and for his role as Ewan Brodie in Monarch of the Glen. \n\nDescription above from the Wikipedia article Martin Compston, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4w5NVp8MWF51bRdcB4A91ecxHnv.jpg", url:"https://themoviedb.org/person/16628"}}, {tmdbId:"15501", properties:{bornIn:"Glasgow, Scotland, UK", imdbId:"1162048", born:date('1985-06-07'), name:"William Ruane", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pBifUMam1skz6zAcgWfDUNblFkV.jpg", url:"https://themoviedb.org/person/15501"}}, {tmdbId:"16629", properties:{imdbId:"1161997", name:"Annmarie Fulton", url:"https://themoviedb.org/person/16629"}}, {tmdbId:"16630", properties:{imdbId:"1178099", name:"Michelle Abercromby", url:"https://themoviedb.org/person/16630"}}, {tmdbId:"13314", properties:{bornIn:" Atlanta, Georgia, USA", imdbId:"0412374", born:date('1941-08-12'), name:"Dana Ivey", bio:"Dana Ivey was born in Atlanta, Georgia.  She decided at age six that she wanted to act, and throughout school she pursued it.  She majored in theatre at Rollins College in Florida.  She received a grant to study drama in England at the London Academy of Music and Art.  She has received critical acclaim on the stage, winning many honors, such as a Tony Nomination, an Outer Critics award, a Drama Desk Award.  She has appeared on such television shows as \"Law &amp; Order\" (1990) and \"Frasier\" (1993)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oQEeRwEb9w4TuSVp334OP9z6Ljm.jpg", url:"https://themoviedb.org/person/13314"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"52929", properties:{bornIn:"Highland Park, Texas, USA", imdbId:"0004990", born:date('1972-08-10'), name:"Angie Harmon", bio:"​From Wikipedia, the free encyclopedia. \n\nAngela Michelle \"Angie\" Harmon (born August 10, 1972, height 5' 9½\" (1,77 m)) is an American fashion model and television/film actress.  She became a well-known model in the 1990s and developed a career as a television star after roles on Baywatch Nights and Law & Order.  Since July 2010, she has starred as Detective Jane Rizzoli on the TNT series Rizzoli & Isles...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xN06w1BbMBtsvesz5qh5kvYjXdD.jpg", url:"https://themoviedb.org/person/52929"}}, {tmdbId:"82528", properties:{imdbId:"0458981", born:date('1986-08-31'), name:"Spencer Klein", url:"https://themoviedb.org/person/82528"}}, {tmdbId:"35093", properties:{imdbId:"0808216", born:date('1985-03-26'), name:"Francesca Marie Smith", url:"https://themoviedb.org/person/35093"}}, {tmdbId:"82529", properties:{bornIn:"New York City, New York, U.S.", imdbId:"0808606", born:date('1982-08-20'), name:"Jamil Walker Smith", bio:"From Wikipedia, the free encyclopedia. \n\nJamil Walker Smith (born August 20, 1982) is an American actor.  His best known role is as the voice of Gerald, a fourth grader and Arnold's best friend in the Nickelodeon TV series Hey Arnold!.  He also appeared on various shows like Sister, Sister, Girlfriends, Bones, The X-Files, and The Bernie Mac Show.  He is an actor by trade and writes, acts and directs his own short film projects...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6JFyY8IUHxdndhHbnUgpItNvdvS.jpg", url:"https://themoviedb.org/person/82529"}}, {tmdbId:"198", properties:{bornIn:"Chicago, Illinois, USA ", imdbId:"0144657", born:date('1957-10-29'), name:"Dan Castellaneta", bio:"Dan Castellaneta (born October 29, 1957) is an American film, theatre and television actor, comedian, voice artist, singer and television writer.  Noted for his long-running role as Homer Simpson on The Simpsons, he voices many other regular characters on it...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AmeqWhP4A46AWkM4kVphg6jOTQX.jpg", url:"https://themoviedb.org/person/198"}}, {tmdbId:"7053", properties:{bornIn:"Glasgow, Scotland, UK", imdbId:"0279524", born:date('1953-12-22'), name:"Gregor Fisher", bio:"From Wikipedia, the free encyclopedia\n\nGregor Fisher (born 22 December 1953) is a Scottish comedian and actor. \n\nDescription above from the Wikipedia article Gregor Fisher, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Dcn4zDxFbU4eFw4i5M6KUepmnu.jpg", url:"https://themoviedb.org/person/7053"}}, {tmdbId:"7054", properties:{bornIn:"London, England, UK", imdbId:"1141990", born:date('1976-08-02'), name:"Rory MacGregor", bio:"From Wikipedia, the free encyclopedia\n\nRory MacGregor (born 2 August 1976 in London, England, UK) is a British actor, who has played a variety of roles on television, generally in the 2000s.  He is best known as Colin Wells in the BBC television series Spooks, a part he performed from 2002-2006. \n\nHe trained at Rose Bruford College of Speech and Drama, graduating in 1999. \n\nDescription above from the Wikipedia article Rory MacGregor, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3SJWBGzBliCgAmu0xQl3jGkOPbz.jpg", url:"https://themoviedb.org/person/7054"}}, {tmdbId:"19299", properties:{bornIn:"London, England, UK", imdbId:"0907708", born:date('1962-06-12'), name:"Eamonn Walker", bio:"Eamonn Walker (born 12 June 1962) is an English film, television and theatre actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mJ2pENrcO4uRy2TNVUzg5cEI9b3.jpg", url:"https://themoviedb.org/person/19299"}}, {tmdbId:"23821", properties:{bornIn:" Omaha, Nebraska, USA", imdbId:"1034965", born:date('1978-05-24'), name:"Bryan Greenberg", bio:"Bryan Greenberg is an American actor and musician, known for his starring role as Ben Epstein in How to Make It in America as well as a recurring role as Jake Jagielski on One Tree Hill and as Nick Garrett on October Road.  His film work includes The Good Guy, Bride Wars, Nobel Son and The Perfect Score...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bJJVWRtnK4KBpyZ6Y1rASfCF7QX.jpg", url:"https://themoviedb.org/person/23821"}}, {tmdbId:"24200", properties:{bornIn:"Buenos Aires, Argentina", imdbId:"1211344", born:date('1979-01-01'), name:"Leonardo Nam", bio:"Born in Argentina and grown up in Australia, Leonardo Nam is a film and television actor of Korean descent, primarily working in the USA and best known for playing recurring character Felix Lutz in HBO's \"Westworld\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Ag9c5pseAJvNl2U21VNHFGYLAAj.jpg", url:"https://themoviedb.org/person/24200"}}, {tmdbId:"554460", properties:{bornIn:"Memphis, Tennessee, USA", imdbId:"1174936", born:date('1932-08-12'), name:"Richard 'Pistol' Allen", bio:"Richard \"Pistol\" Allen was the king of the shuffle styled drum beat at Motown records in the early 60s, second only to Motown drummer extraordinare Benny 'Papa Zita' Benjamin.  When Benjamin wasn't available to play, Allen was called in to replace him. \n\nAllen played drums on major Motown hits such as The Supremes's \"Baby Love\", The Four Tops's \"I Can't Help Myself\", 'Jr.  Walker\"s \"How Sweet It Is (To Be Loved By You)\" and 'Martha & the Vandellas\" \"(Love Is Like a) Heat Wave\"...", url:"https://themoviedb.org/person/554460"}}, {tmdbId:"554461", properties:{imdbId:"1176973", name:"Jack Ashford", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5fLfjG2EUqPxwrtFPP01o9SQ5Fv.jpg", url:"https://themoviedb.org/person/554461"}}, {tmdbId:"554462", properties:{imdbId:"1174597", born:date('1937-11-26'), name:"Bob Babbitt", died:date('2012-07-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fICV8djofH8sKinMt7vdfJty9Gt.jpg", url:"https://themoviedb.org/person/554462"}}, {tmdbId:"554463", properties:{imdbId:"1175028", name:"Benny 'Papa Zita' Benjamin", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/A7KY7bPCI4Q46FcWheBiMFaP0MZ.jpg", url:"https://themoviedb.org/person/554463"}}, {tmdbId:"51798", properties:{bornIn:"Portland, Oregon, USA", imdbId:"0755267", born:date('1980-04-08'), name:"Katee Sackhoff", bio:"Kathryn Ann \"Katee\" Sackhoff (born April 8, 1980) is an American actress known mainly for playing Captain Kara \"Starbuck\" Thrace on the Sci Fi Channel's television program Battlestar Galactica.  In 2004 she was nominated for a Saturn Award in the \"Best Supporting Actress in a Television Series\" category for her work in the Battlestar Galactica miniseries.  In May 2006, she won the Saturn Award for the same role.  She starred in the eighth season of 24 as Dana Walsh...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7xad5epebHEfd8tZDRnGboVmb8P.jpg", url:"https://themoviedb.org/person/51798"}}, {tmdbId:"50668", properties:{bornIn:"Hammersmith - London - England - UK", imdbId:"0051397", born:date('1973-04-03'), name:"Jamie Bamber", bio:"Jamie Bamber (born 3 April 1973) is a British actor, known most widely for his roles as Lee Adama on Battlestar Galactica and Detective Sergeant Matt Devlin on the ITV series Law & Order: UK.  He also had a supporting role in the Hornblower series, was a regular on UK series Ultimate Force and Peak Practice, and has made numerous television guest appearances including Cold Case, Dollhouse, Ghost Whisperer and The Last Detective...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kP1YvBoutrDMK8FWQseR3rfL5Yn.jpg", url:"https://themoviedb.org/person/50668"}}, {tmdbId:"6413", properties:{bornIn:"Rome, Italy", imdbId:"0396812", born:date('1962-05-14'), name:"Danny Huston", bio:"Daniel \"Danny\" Huston (born May 14, 1962) is an American actor and director. \n\nDescription above from the Wikipedia article Danny Huston, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mNz9t7MNANopavbLgcsZMMQBJ0u.jpg", url:"https://themoviedb.org/person/6413"}}, {tmdbId:"6830", properties:{imdbId:"1491202", name:"Carly Nahon", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4sQxdGmJD05wDn7KovMUlZgRH4K.jpg", url:"https://themoviedb.org/person/6830"}}, {tmdbId:"59251", properties:{bornIn:"New York City, New York, USA", imdbId:"0711559", born:date('1984-01-15'), name:"Victor Rasuk", bio:"​Victor Rasuk (born January 15, 1984) is an American actor.  Rasuk was born in Harlem, New York to Dominican parents.  He has one brother, Silvestre, with whom he starred in Raising Victor Vargas.  Rasuk attended performing arts school as a teenager, and began acting at 14.  He garnered his first movie role at 16 in Five Feet High and Rising.  The film—less than 30 minutes long—was a hit at the Independent Spirit Film Festival...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1vh2Yzp9bhmaxLfpNCrO7DVoURd.jpg", url:"https://themoviedb.org/person/59251"}}, {tmdbId:"93827", properties:{imdbId:"0539208", name:"Donna Maldonado", url:"https://themoviedb.org/person/93827"}}] AS row
