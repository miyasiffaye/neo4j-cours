UNWIND [{tmdbId:"694", properties:{bornIn:"Kirkstall,  Leeds, West Yorkshire, England, UK", imdbId:"0832104", born:date('1924-04-14'), name:"Philip Stone", bio:"From Wikipedia, the free encyclopedia  Philip Stone (14 April 1924 – 15 June 2003) was an English actor.   He was born Philip Stones in Leeds, West Riding of Yorkshire.  Stone appeared in three successive Stanley Kubrick films: playing the central character Alex's \"Dad\" in A Clockwork Orange (1971), \"Graham\" (the Lyndon family lawyer) in Barry Lyndon (1975) and as \"Delbert Grady,\" the original caretaker in The Shining (1980)...", died:date('2003-06-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wKIz8L0TcKk26TNGj7rKfgP02UG.jpg", url:"https://themoviedb.org/person/694"}}, {tmdbId:"146758", properties:{imdbId:"0479933", name:"Jonathan Lacey", url:"https://themoviedb.org/person/146758"}}, {tmdbId:"10985", properties:{bornIn:"Knotty Ash, Liverpool, Merseyside, England, UK", imdbId:"0001324", born:date('1964-10-08'), name:"Ian Hart", bio:"Ian Hart (born Ian Davies) is an English stage, television, and screen actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xMC8aPDwhEZcjRHEFcgytSr3BzM.jpg", url:"https://themoviedb.org/person/10985"}}, {tmdbId:"73180", properties:{imdbId:"0049049", name:"Gary Bakewell", url:"https://themoviedb.org/person/73180"}}, {tmdbId:"81172", properties:{bornIn:"Manchester, England, UK", imdbId:"0394034", born:date('1958-12-25'), name:"Nicholas Hope", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jwl6mahxUgnLvaCfmKiQLN9M2f6.jpg", url:"https://themoviedb.org/person/81172"}}, {tmdbId:"559315", properties:{imdbId:"0071239", name:"Claire Benito", url:"https://themoviedb.org/person/559315"}}, {tmdbId:"97331", properties:{imdbId:"0182995", name:"Ralph Cotterill", url:"https://themoviedb.org/person/97331"}}, {tmdbId:"112705", properties:{imdbId:"0109771", name:"Syd Brisbane", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/35eZC56vwpkkmQoQ8YqI3ZfcXAF.jpg", url:"https://themoviedb.org/person/112705"}}, {tmdbId:"2179", properties:{bornIn:"Oklahoma City, Oklahoma, USA", imdbId:"0000751", born:date('1962-01-05'), name:"Suzy Amis", bio:"Susan Elizabeth \"Suzy\" Amis (born January 5, 1962) is an American former film actress and former model. \n\nDescription above from the Wikipedia article Suzy Amis, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mh9BpsP6eQ2ereP0rPTzD5KURUl.jpg", url:"https://themoviedb.org/person/2179"}}, {tmdbId:"99848", properties:{imdbId:"0161206", name:"David Chung", url:"https://themoviedb.org/person/99848"}}, {tmdbId:"34947", properties:{bornIn:"Westbury, New York, U.S.", imdbId:"0175834", born:date('1955-11-30'), name:"Kevin Conroy", bio:"From Wikipedia, the free encyclopedia. \n\nKevin Conroy (born November 30, 1955) is an American actor of stage, screen and voice, best known for his voice role as Batman in numerous animated television series, feature films, and video games that make up the DC Animated Universe.   Description above from the Wikipedia article Kevin Conroy, licensed under CC-BY-SA, full list of contributors on Wikipedia ...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4MVApMiARrecuVjTCPfi6Z7biLW.jpg", url:"https://themoviedb.org/person/34947"}}, {tmdbId:"65299", properties:{bornIn:"Orange County, California, U.S.", imdbId:"0144938", born:date('1980-06-15'), name:"Christopher Castile", bio:"From Wikipedia, the free encyclopedia. \n\nChristopher Jon Castile (born June 15, 1980) is an American actor from Orange County, California.  He is best known for his roles as Ted Newton in the movies Beethoven and Beethoven's 2nd, playing the voice of Zachary Sellers and Nick Mulligan in Focus on the Family's Adventures in Odyssey, as well as playing Mark Foster on the sitcom Step by Step.  He also voiced Eugene Horowitz in Hey Arnold!...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sTHOLnqUS8qOqIxqsWCZci8Ekpi.jpg", url:"https://themoviedb.org/person/65299"}}, {tmdbId:"192940", properties:{bornIn:"Battersea, London, England, UK", imdbId:"0402901", born:date('1963-07-21'), name:"Kelly Hunter", bio:"From Wikipedia, the free encyclopedia\n\nKelly Hunter MBE (born 21 July 1963) is a British film, television, radio, stage and musical actress, a member of the Royal Shakespeare Company and the National Theatre.  She is a Laurence Olivier Award nominee and Radio Academy Award and TMA Awards winner...", url:"https://themoviedb.org/person/192940"}}, {tmdbId:"137780", properties:{imdbId:"0425788", name:"Maudie Johnson", url:"https://themoviedb.org/person/137780"}}, {tmdbId:"137781", properties:{imdbId:"0425790", name:"Max Johnson", url:"https://themoviedb.org/person/137781"}}, {tmdbId:"134340", properties:{imdbId:"0343361", name:"Edan Gross", url:"https://themoviedb.org/person/134340"}}, {tmdbId:"5727", properties:{bornIn:"Alexandria, Virginia, USA", imdbId:"0046033", born:date('1966-12-24'), name:"Diedrich Bader", bio:"From Wikipedia, the free encyclopedia. \n\nKarl Diedrich Bader (born December 24, 1966), better known as Diedrich Bader, is an American actor, voice actor and comedian.  Many know him for his roles as Oswald Lee Harvey on The Drew Carey Show, Lawrence from the film Office Space, and his voice portrayal of Batman on Batman: The Brave and the Bold. \n\nDescription above from the Wikipedia article Diedrich Bader, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j3ARZGysag7RZ96ISYBAu51GpnK.jpg", url:"https://themoviedb.org/person/5727"}}, {tmdbId:"23764", properties:{bornIn:"Glendale, California, USA", imdbId:"0000143", born:date('1969-09-29'), name:"Erika Eleniak", bio:"Erika Eleniak (born September 29, 1969) is an American Playboy Playmate and actress, perhaps best known for her role in Baywatch as Shauni McClain.  She also starred in the films Under Siege and The Beverly Hillbillies. \n\nDescription above from the Wikipedia article Erika Eleniak, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aCOOsCp8wilIkdYQgX04jkl8OvE.jpg", url:"https://themoviedb.org/person/23764"}}, {tmdbId:"51799", properties:{bornIn:"Stepney, London, England, UK", imdbId:"0265492", born:date('1964-05-06'), name:"Craig Fairbrass", bio:"Craig Fairbrass (born 1964) is an English actor.  He is known for his distinctive Cockney accent. \n\nDescription above from the Wikipedia article Craig Fairbrass, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z5WnSqwkM0Ax0Z47etVNmcew5Pn.jpg", url:"https://themoviedb.org/person/51799"}}, {tmdbId:"13918", properties:{bornIn:"Basingstoke, Hampshire, England, UK", imdbId:"0000167", born:date('1965-06-10'), name:"Elizabeth Hurley", bio:"Elizabeth Jane Hurley is an English model and actress who became known as a girlfriend of Hugh Grant in the 1990s.  In 1994, as Grant became the focus of worldwide media attention due to the global box office success of his film Four Weddings and a Funeral, Hurley accompanied him to the film's Los Angeles premiere in a plunging black Versace dress held together with gold safety pins, which gained her instant media notice...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1z6bx9I3J8gTQAQPrA5cJgzkiqt.jpg", url:"https://themoviedb.org/person/13918"}}] AS row
