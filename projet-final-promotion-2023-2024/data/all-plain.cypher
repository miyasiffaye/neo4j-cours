UNWIND [{tmdbId:"929092", properties:{imdbId:"2374063", name:"Carla Bianco", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9XyWBXlVvzYY7UhalTCiF1ZBTtA.jpg", url:"https://themoviedb.org/person/929092"}}, {tmdbId:"1007683", properties:{bornIn:"Longmont, Colorado, USA", imdbId:"2930503", born:date('1992-01-23'), name:"Jack Reynor", bio:"Jack Reynor (born January 23, 1992) is an Irish actor.  Notable roles include a lead character in Lenny Abrahamson's critically acclaimed Irish film What Richard Did (2012), for which he won an IFTA Award for Best Film Actor, in Transformers: Age of Extinction, Gerard Barrett's film Glassland where Reynor won the World Cinema Dramatic Special Jury Award for Acting at the Sundance Film Festival, in Macbeth and lead role in Irish film Sing Street...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vbPewOkSGGQl93wgshDlczMqiOk.jpg", url:"https://themoviedb.org/person/1007683"}}, {tmdbId:"1168929", properties:{bornIn:"Dublin, Ireland", imdbId:"4753979", name:"Fionn Walton", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aiWSP4wIcTW0cAAX1z94f47rlwU.jpg", url:"https://themoviedb.org/person/1168929"}}, {tmdbId:"1168928", properties:{imdbId:"4754308", name:"Gavin Drea", url:"https://themoviedb.org/person/1168928"}}, {tmdbId:"1379407", properties:{bornIn:"Ireland", imdbId:"2617600", born:date('1995-04-19'), name:"Patrick Gibson", bio:"Patrick Gibson (born 19 April 1995) is an Irish actor known for his roles in The Tudors, The Passing Bells, and The OA.  He was given the 'Rising Star Reward' at the 2017 IFTAs...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1pCUKn2BqJJB5IuktEZGgYw6hbt.jpg", url:"https://themoviedb.org/person/1379407"}}, {tmdbId:"86543", properties:{bornIn:"London, England, UK", imdbId:"0041003", born:date('1926-05-08'), name:"David Attenborough", bio:"Sir David Attenborough is a broadcaster and naturalist.  His career as the respected face and voice of natural history programmes has endured for more than 50 years.  He is best known for writing and presenting the nine \"Life\" series, in conjunction with the BBC Natural History Unit, which collectively form a comprehensive survey of all life on the planet...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tt3LW3XftcvxOZtMXmIaJSWFN7y.jpg", url:"https://themoviedb.org/person/86543"}}, {tmdbId:"169200", properties:{bornIn:"Lemay, Missouri, USA", imdbId:"0809613", born:date('1951-07-10'), name:"Phyllis Smith", bio:"Phyllis Smith (born July 10, 1951) is an American film and television actress who is best known for playing Phyllis Lapin-Vance on The Office. \n\nDescription above from the Wikipedia article Phyllis Smith, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h9w9pQbiderRWAC2mi7spjzuIGz.jpg", url:"https://themoviedb.org/person/169200"}}, {tmdbId:"1557921", properties:{name:"Ramiro Rodriguez", url:"https://themoviedb.org/person/1557921"}}, {tmdbId:"1116973", properties:{bornIn:"Houston, Texas, USA", imdbId:"1794849", born:date('1986-08-21'), name:"Carlos Pratts", url:"https://themoviedb.org/person/1116973"}}, {tmdbId:"1354957", properties:{imdbId:"2216161", name:"Johnny Ortiz", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1Y7bTanYyHIw91EWjhAeZoBP4fl.jpg", url:"https://themoviedb.org/person/1354957"}}, {tmdbId:"78030", properties:{bornIn:"Long Beach, California, USA", imdbId:"1667364", born:date('1989-12-18'), name:"Ashley Benson", bio:"Ashley Victoria Benson was born on December 18, 1989.  She has been dancing competitively since she was 2 with hip hop, jazz, ballet, tap and lyrical.  She has been singing since she was about 5 and she hopes to pursue that along with her acting.  Ashley started modeling at the age of 5 for dance catalogs.  Ashley was then pursued by The Ford Modeling Agency at the age of 8.  She worked steadily in print and is still with the Agency.  At the age of 10, she wanted to pursue acting...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8EeEDClttH50DRv4dl74Edi4In7.jpg", url:"https://themoviedb.org/person/78030"}}, {tmdbId:"928453", properties:{imdbId:"2015221", name:"Calvin Reeder", url:"https://themoviedb.org/person/928453"}}, {tmdbId:"98632", properties:{imdbId:"2721366", name:"Lane Hughes", bio:"​From Wikipedia, the free encyclopedia.   \n\nLane Hughes is an American actor and musician. \n\nDescription above from the Wikipedia article Lane Hughes,  licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pfWAcOKgjNLp3bCriBZUPWDR2kT.jpg", url:"https://themoviedb.org/person/98632"}}, {tmdbId:"107766", properties:{imdbId:"2310589", name:"Kentucker Audley", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n0YkDTZmwVfYJVuoAVsIonPOBjz.jpg", url:"https://themoviedb.org/person/107766"}}, {tmdbId:"1112385", properties:{bornIn:"Gentofte, Sjælland, Denmark", imdbId:"5038871", name:"Annika Wedderkopp", url:"https://themoviedb.org/person/1112385"}}, {tmdbId:"1188827", properties:{imdbId:"5039026", name:"Lasse Fogelstrøm", url:"https://themoviedb.org/person/1188827"}}, {tmdbId:"50347", properties:{bornIn:"Augusta - Maine - USA", imdbId:"0629697", born:date('1980-01-08'), name:"Rachel Nichols", bio:"Rachel Emily Nichols (born January 8, 1980 height 5' 10\" (1,78 m) ) is an American actress and model.  Nichols began modeling while attending Columbia University in New York City in the late 1990s.  She transitioned into television and film acting in the early 2000s; she had a bit part in the romantic drama film Autumn in New York (2000) and a one-episode role in the fourth season of the hit show Sex and the City (2002)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4q8IfdNgylaznnUCSof0m3qxZaj.jpg", url:"https://themoviedb.org/person/50347"}}, {tmdbId:"10580", properties:{bornIn:"Baltimore, Maryland, USA", imdbId:"1139632", born:date('1975-08-19'), name:"Tracie Thoms", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/y5rB0iqFDCMFfqABCgDEw2IojuG.jpg", url:"https://themoviedb.org/person/10580"}}, {tmdbId:"79497", properties:{imdbId:"0858573", born:date('1961-05-17'), name:"Bruce Thomas", bio:"Bruce Thomas is an American actor known for portraying the character of Batman in a series of commercials for General Motors' OnStar service that aired from 2000 to 2002...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7DHdTA4ZInJ8qeQhGbwALeOXucA.jpg", url:"https://themoviedb.org/person/79497"}}, {tmdbId:"1072882", properties:{bornIn:"Fall River, Massachusetts, USA", imdbId:"4535518", born:date('1980-02-14'), name:"Mindy Robinson", bio:"A Los Angeles based actress, model, comedian and reality star, she has appeared in numerous comedies, horror films, music videos, and as a TV personality in a dozen or so major network reality shows, most notably as the outspoken blonde on FOX's 2012 season of Take Me Out with George Lopez...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eJxKGNdPtwYmFUYf6YcF1F0zH4h.jpg", url:"https://themoviedb.org/person/1072882"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"52760", properties:{bornIn:"Dunedin, Otago, New Zealand", imdbId:"0197638", born:date('1947-05-06'), name:"Alan Dale", bio:"Alan Hugh Dale is a New Zealand actor.  As a child, Dale developed a love of theatre and also became a rugby player.  After retiring from the sport he took on a number of professions to support his family, before deciding to become a professional actor at the age of 27.  With work limited in New Zealand, Dale moved to Australia, where he played Dr.  John Forrest in The Young Doctors from 1979 to 1982.  He later appeared as Jim Robinson in Neighbours, a part he played for eight years...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3BcpSoKBOwHX0wxaPZpOJ5buO89.jpg", url:"https://themoviedb.org/person/52760"}}, {tmdbId:"1219029", properties:{bornIn:"Philadelphia - Pennsylvania - USA", imdbId:"0006670", born:date('1968-09-12'), name:"Paul F. Tompkins", bio:"From Wikipedia, the free encyclopedia. \n\nPaul Francis Tompkins (born September 12, 1968), best known as Paul F.  Tompkins, is an American actor and comedian. \n\nDescription above from the Wikipedia article Paul F.  Tompkins, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nWAfT0mY4uTzQpZnPcMxRHnICCy.jpg", url:"https://themoviedb.org/person/1219029"}}, {tmdbId:"74699", properties:{bornIn:"Katrineholm, Södermanlands län, Sweden", imdbId:"0349052", born:date('1964-12-20'), name:"Robert Gustafsson", bio:"Swedish comedian, actor, and member of Killinggänget.  He has sometimes been called \"the funniest man in Sweden\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uiNOp6QjVjaQTDJjbAtpNgZQXQr.jpg", url:"https://themoviedb.org/person/74699"}}, {tmdbId:"135692", properties:{bornIn:"Kristinehamn, Värmlands län, Sweden", imdbId:"3230026", born:date('1976-10-04'), name:"Mia Skäringer", bio:"Maria Elisabeth \"Mia\" Skäringer (born October 4, 1976) is a Swedish actress and comedian who has won the Kristallen Award two times.  Her first television job was at the Sanning och konsekvens show on ZTV, where she met Klara Zimmergren.  Skäringer and Zimmergren after that hosted the radio show Roll on together.  The duo has also had their own sketch comedy show on SVT in Sweden called Mia och Klara.  The show was awarded a Kristallen award for best comedy show on television in both 2008 and 2009...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/382hw1VL4x7cTl8kxnRRsavCoXB.jpg", url:"https://themoviedb.org/person/135692"}}, {tmdbId:"282449", properties:{bornIn:"Örgryte, Sweden", imdbId:"0928002", born:date('1939-05-30'), name:"Iwar Wiklander", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/s0EjghuTpefXlof3AvRDNZOkuzA.jpg", url:"https://themoviedb.org/person/282449"}}, {tmdbId:"1314260", properties:{bornIn:"Lund, Sweden", imdbId:"2433382", born:date('1973-08-19'), name:"David Wiberg", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hcob7OvvtwG107j2suu5Z0GYAqt.jpg", url:"https://themoviedb.org/person/1314260"}}, {tmdbId:"61546", properties:{bornIn:"Calgary, Alberta, Canada", imdbId:"0733218", born:date('1965-07-22'), name:"Ian Robison", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nf6VPd5do9xUFEVe77suicQRVdW.jpg", url:"https://themoviedb.org/person/61546"}}, {tmdbId:"1145892", properties:{imdbId:"0462292", name:"Ed Koch", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xiYbexdeDIUJnhCmh8gFKo6tAVF.jpg", url:"https://themoviedb.org/person/1145892"}}, {tmdbId:"1055235", properties:{bornIn:"Houma, Louisiana, USA", imdbId:"4832920", born:date('2003-08-28'), name:"Quvenzhané Wallis", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ikN66KpLzt1BpahrLxLpXH13fql.jpg", url:"https://themoviedb.org/person/1055235"}}, {tmdbId:"1073500", properties:{imdbId:"3017611", name:"Levy Easterly", url:"https://themoviedb.org/person/1073500"}}, {tmdbId:"1118577", properties:{imdbId:"3017935", name:"Lowell Landes", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yNMckrR3saM3A67WGVBiSllztjw.jpg", url:"https://themoviedb.org/person/1118577"}}, {tmdbId:"1133583", properties:{name:"Stephen 'Sugar' Segerman", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5a5kK7I3Mo0LbWAGjHxTPRHHp58.jpg", url:"https://themoviedb.org/person/1133583"}}, {tmdbId:"1132085", properties:{imdbId:"0168977", name:"Dennis Coffey", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hctibAY3O9FXpHA1CGT09BDb4Do.jpg", url:"https://themoviedb.org/person/1132085"}}, {tmdbId:"1181323", properties:{imdbId:"0857488", name:"Mike Theodore", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6iYDIOC5G3qommM1CmkwE0M9RlN.jpg", url:"https://themoviedb.org/person/1181323"}}, {tmdbId:"1842370", properties:{name:"Mark W. Bennett", url:"https://themoviedb.org/person/1842370"}}, {tmdbId:"1508927", properties:{bornIn:"Scranton, Pennsylvania, USA", imdbId:"0081182", born:date('1942-11-20'), name:"Joe Biden", bio:"Joseph Robinette Biden Jr.  is an American politician who served as the 47th vice president of the United States from 2009 to 2017.  Biden also represented Delaware in the U. S.  Senate from 1973 to 2009...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3mMla9gDkbjTnMqc26R4UIKnmtk.jpg", url:"https://themoviedb.org/person/1508927"}}, {tmdbId:"1374086", properties:{bornIn:"New York, New York, U.S.", imdbId:"1745063", born:date('1934-07-27'), name:"Michael Baden", bio:"From Wikipedia, the free encyclopedia  Michael M.  Baden (born July 27, 1934) is an American physician and board-certified forensic pathologist known for his work investigating high-profile deaths and as the host of HBO's Autopsy.  He is the Forensic Science Contributor for FOX News Channel and was a frequent guest on Fox News's late-night satire program Red Eye w/ Greg Gutfeld where he was known as the Death Correspondent...", url:"https://themoviedb.org/person/1374086"}}, {tmdbId:"81448", properties:{imdbId:"0049929", name:"Jason Baldwin", url:"https://themoviedb.org/person/81448"}}, {tmdbId:"1053170", properties:{bornIn:"Chicago - Illinois - USA", imdbId:"4583512", born:date('1995-05-03'), name:"Katie Chang", bio:"Katherine \"Katie\" Chang (born May 3, 1995) is an American actress, best known for her roles in The Bling Ring (2013) and A Birder's Guide to Everything (2013)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nh8R2GNqWNoowPlAd7743IL9VjP.jpg", url:"https://themoviedb.org/person/1053170"}}, {tmdbId:"969140", properties:{bornIn:"Gulfport, Mississippi, USA", imdbId:"3441152", born:date('1994-08-22'), name:"Israel Broussard", bio:"Isaiah Israel Broussard (born August 22, 1994) is an American actor.  He made his film debut in the comedy-drama Flipped, and is known for his roles in the crime film The Bling Ring (2013), the drama Perfect High (2015), the thriller H8RZ (2015), the comedy Good Kids (2016), and the slasher film Happy Death Day (2017)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cSmPXUMjUgodorabkAHJ4IMWFz7.jpg", url:"https://themoviedb.org/person/969140"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"1172491", properties:{imdbId:"4903197", born:date('1995-01-11'), name:"Claire Julien", bio:"Claire Julien is an an American actress.  She is the daughter of Oscar wining cinematographer, Wally Pfister.  Her first major film role was in 2013's 'Bling Ring'...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4l1fXSz0U0wmeaezRl7TB7E5oNx.jpg", url:"https://themoviedb.org/person/1172491"}}, {tmdbId:"1054260", properties:{bornIn:"Osaka, Japan", imdbId:"4429739", born:date('1990-03-14'), name:"Haru Kuroki", bio:"Haru Kuroki (黒木 華, Kuroki Haru, born 14 March 1990) is a Japanese actress.  She gained international recognition by winning Silver Bear (Best Actress Award) at Berlin International Film Festival in 2014, for her performance in Yoji Yamada's film The Little House...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rTxASkiwbxohT0UVHORLmECo53Y.jpg", url:"https://themoviedb.org/person/1054260"}}, {tmdbId:"1278755", properties:{imdbId:"4003520", name:"Annie Rose Buckley", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iU9WeHtd90NUcTazNWy1numSXlv.jpg", url:"https://themoviedb.org/person/1278755"}}, {tmdbId:"484359", properties:{bornIn:"Shaker Heights, Ohio, USA", imdbId:"3264596", born:date('1984-01-30'), name:"Scott Mescudi", bio:"Scott Ramon Seguro Mescudi (born January 30, 1984),better known by his stage name Kid Cudi (/ˈkʌdi/ often stylized KiD CuDi), is an American singer, rapper, songwriter, record producer and actor from Cleveland, Ohio. \n\nAs of 2018, Cudi has released six studio albums as a solo artist and has sold over 5. 2 million digital singles and has worked with numerous prominent artists in the music industry, including Jay Z, Mary J...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qa4RwK9mP81EHc7kQnG54tXkpVo.jpg", url:"https://themoviedb.org/person/484359"}}, {tmdbId:"989411", properties:{bornIn:"Devon, United Kingdom", imdbId:"4457775", born:date('1989-04-29'), name:"Ella Hunt", bio:"Ella Hunt is an English actress, known for Intruders, Les Misérables, Robot Overlords, and Anna and the Apocalypse.  From 2016 until 2018, she played the role of Ellie Marsden in the ITV comedy series Cold Feet.  In 2017, she appeared as Emma Carr in the ITV drama series Endeavour...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j5SOv91oPkeJuyyunEFeO6hMrWa.jpg", url:"https://themoviedb.org/person/989411"}}, {tmdbId:"172254", properties:{imdbId:"0122511", name:"Mark Burnham", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7MXSK9i4rU96zHeUZTVPqEsciv.jpg", url:"https://themoviedb.org/person/172254"}}, {tmdbId:"9315", properties:{bornIn:"Canton, Ohio, USA", imdbId:"0001504", born:date('1969-01-05'), name:"Marilyn Manson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7LtxWnlvhOwNuiCgckh1ppNhmub.jpg", url:"https://themoviedb.org/person/9315"}}, {tmdbId:"2136", properties:{bornIn:"Cedar Rapids, Iowa, USA", imdbId:"0256237", born:date('1954-09-07'), name:"Michael Emerson", bio:"Michael Emerson (born September 7, 1954) is an American actor best known for his role as Benjamin Linus on Lost as well as fictional serial killer William Hinks in The Practice...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xOpr90SF1RCtjFNTu32nZQ90buY.jpg", url:"https://themoviedb.org/person/2136"}}, {tmdbId:"105173", properties:{bornIn:"Cincinnati - Ohio - USA", imdbId:"0119003", born:date('1973-06-26'), name:"Rebecca Budig", bio:"From Wikipedia, the free encyclopedia\n\nRebecca Jo Budig (/ˈbʌdɪɡ/; born June 26, 1973) is an American actress and television presenter, best known for her role as Greenlee Smythe Lavery on the ABCsoap operaAll My Children. Rebecca Budig was born in Cincinnati, Ohio, the daughter of Mary Jo, a homemaker, and George Budig, a businessman. She was raised in Fort Mitchell, Kentucky...", url:"https://themoviedb.org/person/105173"}}, {tmdbId:"935701", properties:{bornIn:"New York City - New York - USA", imdbId:"4585500", born:date('2004-01-01'), name:"Rohan Chand", bio:"Rohan Chand was born in New York City. \n\nAt the age of 6, while playing little league baseball, he caught the eye of a prominent New York-based casting director that cast him in the role of Adam Sandler's adopted son in Jack and Jill (2011).  Rohan embraced every aspect of his new career, and his enthusiasm for his work led him next to his memorable role of Issa in the critically acclaimed Showtime Series, Homeland (2011)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sE42K7kvQ9tRKEy7vvqQeb1JCAr.jpg", url:"https://themoviedb.org/person/935701"}}, {tmdbId:"1108117", properties:{bornIn:"Delhi, India", imdbId:"3289096", born:date('1985-01-16'), name:"Sidharth Malhotra", bio:"Sidharth Malhotra is an Indian actor and former model who appears in Hindi films.  Malhotra began a career as a model at the age of 18.  Dissatisfied by the profession, he went on to work as an assistant director to Karan Johar in the 2010 film My Name Is Khan.  He made his acting debut with a leading role in Johar's comedy-drama Student of the Year (2012), for which he received a Filmfare Award for Best Male Debut nomination...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ms0za8rU7SwBOboUc0G9jRLC1VW.jpg", url:"https://themoviedb.org/person/1108117"}}, {tmdbId:"1108120", properties:{bornIn:"Mumbai, Maharashtra, India", imdbId:"1017633", born:date('1993-03-15'), name:"Alia Bhatt", bio:"Alia Bhatt is an Indian actress who appears in Bollywood films. ​\n\nSAMBHAV\n\nAlia is the daughter of director, producer, and screenwriter Mahesh Bhatt and Soni Razdan, a film actress and director.  She has one sister Shaheen Bhatt, a half sister Pooja Bhatt, and a half brother Rahul Bhatt.  Actor Emraan Hashmi and director Mohit Suri are her cousins and producer Mukesh Bhatt is her uncle.  Alia has completed high-school from Jamnabai Narsee School IB in May 2011...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/npt9kg6VzAxYwFifsXhrjaqnuja.jpg", url:"https://themoviedb.org/person/1108120"}}, {tmdbId:"1108119", properties:{bornIn:"Mumbai, Maharashtra, India", imdbId:"3315894", born:date('1987-04-24'), name:"Varun Dhawan", bio:"Varun Dhawan is an Indian actor working in Bollywood films.  The son of film director David Dhawan, he studied Business Management in England, after which he worked as an assistant director to Karan Johar on the 2010 drama My Name Is Khan.  Dhawan made his acting debut with Johar's 2012 romantic comedy Student of the Year, a box office success, for which he received a Filmfare nomination for Best Male Debut...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gTMAwhk1ApWIyiATALzvlC0MbHN.jpg", url:"https://themoviedb.org/person/1108119"}}, {tmdbId:"35791", properties:{bornIn:"Bombay, Maharashtra, India", imdbId:"0438501", born:date('1952-09-04'), name:"Rishi Kapoor", bio:"​From Wikipedia, the free encyclopedia\n\nRishi Kapoor (born 4 September 1952) is a popular Indian Bollywood actor, film producer and director. \n\nDescription above from the Wikipedia article Rishi Kapoor, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2020-04-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yQOKkmQaksa3hOi72MbPnrqz77k.jpg", url:"https://themoviedb.org/person/35791"}}, {tmdbId:"1366725", properties:{bornIn:"Vancouver, Canada", imdbId:"3909032", born:date('2000-05-23'), name:"Evan Bird", bio:"Evan Bird is an actor, known for Maps to the Stars (2014), Fringe (2008) and Chained (2012)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yvYuNTAFt2d0BoQIWLXsYyrUlfn.jpg", url:"https://themoviedb.org/person/1366725"}}, {tmdbId:"6074", properties:{bornIn:"Edmonton, Alberta, Canada", imdbId:"0920564", born:date('1942-03-30'), name:"Kenneth Welsh", bio:"Kenneth Welsh, CM (born March 30, 1942) is a Canadian film and television actor (sometimes credited as Ken Welsh).  He is known to Twin Peaks fans as the multi-faceted villain Windom Earle, and has more recently played the father of Katharine Hepburn (Cate Blanchett) in Martin Scorsese's The Aviator. \n\nIn 1984 he was nominated for a Genie Award as Best Actor for his portrayal of Reno Colt in the film \"Reno and the Doc\", written and directed by Charles Dennis...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AvYhww5a8TPmMEHqFsvZpyztV5Y.jpg", url:"https://themoviedb.org/person/6074"}}, {tmdbId:"1073845", properties:{imdbId:"4877987", name:"Cosimo Rega", url:"https://themoviedb.org/person/1073845"}}, {tmdbId:"72781", properties:{imdbId:"3013374", name:"Salvatore Striano", url:"https://themoviedb.org/person/72781"}}, {tmdbId:"1073846", properties:{imdbId:"4878024", name:"Giovanni Arcuri", url:"https://themoviedb.org/person/1073846"}}, {tmdbId:"1073847", properties:{imdbId:"4877996", name:"Antonio Frasca", url:"https://themoviedb.org/person/1073847"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"1125643", properties:{imdbId:"1328491", name:"Boonsri Yindee", url:"https://themoviedb.org/person/1125643"}}, {tmdbId:"1150762", properties:{imdbId:"3611053", name:"Alice Keohavong", url:"https://themoviedb.org/person/1150762"}}, {tmdbId:"1150757", properties:{imdbId:"5524365", name:"Sitthiphon Disamoe", url:"https://themoviedb.org/person/1150757"}}, {tmdbId:"85034", properties:{bornIn:" Mumbai, Maharashtra, India", imdbId:"1633541", born:date('1982-09-28'), name:"Ranbir Kapoor", bio:"Ranbir Kapoor is an Indian actor who appears in Bollywood movies.  He first appeared in the 2007 film Saawariya for which he won a Filmfare Best Male Debut Award. \n\nBorn to actors Rishi Kapoor and Neetu Singh, Kapoor is the great grandson of Prithviraj Kapoor and the grandson of actor and filmmaker Raj Kapoor.  He is the brother of Riddhima Kapoor and his uncles are Randhir Kapoor and Rajiv Kapoor.  Other notable family members include his cousins Karisma Kapoor, Kareena Kapoor and Nikhil Nanda...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/orrLTmmUfHMm7Kwv66MUllhncMU.jpg", url:"https://themoviedb.org/person/85034"}}, {tmdbId:"53975", properties:{bornIn:"Copenhagen, Denmark", imdbId:"2138653", born:date('1986-01-05'), name:"Deepika Padukone", bio:"Deepika Padukone is an Indian film actress.  She is one of the highest-paid actresses in the world and is cited in the media as one of the nation's most popular and attractive personalities.  Padukone has established a career in Hindi films, and is the recipient of several awards, including three Filmfare Awards.  Padukone, the daughter of the badminton player Prakash Padukone, was born in Copenhagen and raised in Bangalore...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kBGmOExBHwbVZDmGegGx3qZWw89.jpg", url:"https://themoviedb.org/person/53975"}}, {tmdbId:"142626", properties:{bornIn:"Mumbai, India", imdbId:"3169069", born:date('1985-11-16'), name:"Aditya Roy Kapoor", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/f2gV6D1EOL1gfVsPmr18736TXD.jpg", url:"https://themoviedb.org/person/142626"}}, {tmdbId:"146957", properties:{bornIn:"Pondicherry, India", imdbId:"3202701", born:date('1983-01-09'), name:"Kalki Koechlin", bio:"Kalki Koechlin is an Indian actress and screenwriter of French ethnicity, who predominantly works in Bollywood.  Apart from acting in films, she is also a regular presence in theatre productions in India.  Koechlin is the recipient of a National Film Award, a Filmfare Award and two Screen Awards.  Drawn to theatre at a young age, Koechlin studied drama and theatre at University of London, and worked simultaneously with a local theatre company...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4m81jxAeWJ1h1T6265pGBZoCC10.jpg", url:"https://themoviedb.org/person/146957"}}, {tmdbId:"1108907", properties:{bornIn:"Seattle, Washington, USA", imdbId:"3538718", born:date('1995-03-22'), name:"Nick Robinson", bio:"Nicholas John \"Nick\" Robinson (born March 22, 1995) is an American actor.  As a child, he appeared in stage productions of A Christmas Carol and Mame (both in 2008), following which he starred in the television sitcom Melissa & Joey (2010–2015).  He went on play a supporting role in the highly successful science fiction film Jurassic World (2015) and took on lead roles in several teen dramas, including The Kings of Summer (2013), The 5th Wave (2016), and Everything, Everything (2017)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mzYszYVPvTdirjkUueziWUHvye7.jpg", url:"https://themoviedb.org/person/1108907"}}, {tmdbId:"222122", properties:{bornIn:"St. Louis, Missouri, USA", imdbId:"2773059", born:date('1994-12-11'), name:"Gabriel Basso", bio:"Gabriel Basso was born in St.  Louis, Missouri, USA.  He is an actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qehEpxAtYkOskgAs6GJiuYiAZMj.jpg", url:"https://themoviedb.org/person/222122"}}, {tmdbId:"1530518", properties:{imdbId:"6518675", name:"Cole Konis", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rZT7Lymev4ysRu3GiAbcUwCBldH.jpg", url:"https://themoviedb.org/person/1530518"}}, {tmdbId:"163139", properties:{bornIn:"Bixby - Oklahoma - USA", imdbId:"0715314", born:date('1965-01-05'), name:"Ben Reed", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/viPTKv7ETKzgxwR0GiY1Vv8vHD3.jpg", url:"https://themoviedb.org/person/163139"}}, {tmdbId:"1133684", properties:{bornIn:"Havering, Essex, England, UK", imdbId:"4948519", born:date('1999-09-17'), name:"Daniel Huttlestone", bio:"Daniel Richard Huttlestone was born in Havering, Essex, England, to Linda and Mark Huttlestone, a company managing director.  He started his stage career from the age of 9 landing the role of 'Nipper' in the 2009 production of Oliver! at the Theatre Royal Drury Lane, performing on the opening night with Rowan Atkinson, and continuing until it closed in 2011...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fyVGhzrEXORPck2wHomaRq0YRD2.jpg", url:"https://themoviedb.org/person/1133684"}}, {tmdbId:"1257387", properties:{bornIn:"Windsor - Ontario - Canada", imdbId:"3818748", born:date('1990-08-28'), name:"Katie Findlay", bio:"Katie Findlay (born August 28, 1990) is a Canadian actress.  She is best known for her role as Rosie Larsen in the American crime drama television series The Killing.  From 2013 to 2014, Findlay portrayed Maggie Landers in The CW's teen drama The Carrie Diaries.  From 2014 to 2015, Findlay starred as Rebecca Sutter in the first season of the ABC series How to Get Away with Murder...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kuAEMiHePenfLjCLsqfvJVeDuUz.jpg", url:"https://themoviedb.org/person/1257387"}}, {tmdbId:"965770", properties:{imdbId:"2584304", born:date('1990-10-29'), name:"Carlson Young", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bOSYNvEGbBuBhhZpGLdt4mHkdS.jpg", url:"https://themoviedb.org/person/965770"}}, {tmdbId:"2229376", properties:{name:"Ana Rita Gurgel", url:"https://themoviedb.