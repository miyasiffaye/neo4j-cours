UNWIND [{tmdbId:"43138", properties:{bornIn:"Belfast, Northern Ireland", imdbId:"0568400", born:date('1948-01-01'), name:"Ian McElhinney", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xkKicrls0SEYP3kAaKhyWnd395S.jpg", url:"https://themoviedb.org/person/43138"}}, {tmdbId:"45051", properties:{bornIn:"Exeter, Devon, England, UK", imdbId:"2016685", born:date('1984-09-10'), name:"Harry Treadaway", bio:"From Wikipedia, the free encyclopedia. \n\nHarry John N.  Treadaway (born 10 September 1984) is an English actor. \n\nDescription above from the Wikipedia article Harry Treadaway, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/miinW3n8c2hZW9uy5FBfxO86f2H.jpg", url:"https://themoviedb.org/person/45051"}}, {tmdbId:"213368", properties:{imdbId:"0013841", name:"Pegah Ahangarani", url:"https://themoviedb.org/person/213368"}}, {tmdbId:"213370", properties:{imdbId:"1223307", name:"Leonid Alexeenko", url:"https://themoviedb.org/person/213370"}}, {tmdbId:"539", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0502073", born:date('1970-08-09'), name:"Thomas Lennon", bio:"From Wikipedia, the free encyclopedia\n\nThomas Patrick Lennon (born August 9, 1970) is an American actor, comedian, writer, director and producer best known as a cast member on MTV's The State and for his role as Lieutenant Jim Dangle on the Comedy Central series Reno 911!. \n\nDescription above from the Wikipedia article Thomas Lennon (actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/s8pw7BfuMxN7P0p5XJ9POfod7zW.jpg", url:"https://themoviedb.org/person/539"}}, {tmdbId:"49018", properties:{bornIn:"Munich, Germany", imdbId:"0354198", born:date('1969-02-18'), name:"Jeanette Hain", bio:"​Jeanette Hain was born in Munich.  While studying at the School of Television and Film in Munich, the by chance meeting with director Sherry Hormann made her childhood dream come true by resulting in her first leading part in \"Die Cellistin - Liebe und Verhängnis\".  Since then she has been not only playing in German and international films, but also on stage to highly critical acclaim.  \n\n  She has two children, Jonas (17) and Malou (2) and a dog with a tale but no tail...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/A6Augzike0ZZaEleJj5hZLJ34BK.jpg", url:"https://themoviedb.org/person/49018"}}, {tmdbId:"5847", properties:{bornIn:"Bargteheide, Schleswig-Holstein, Germany", imdbId:"1269088", born:date('1990-07-04'), name:"David Kross", bio:"David Kross was born on July 4, 1990 in Bargteheide, Schleswig-Holstein, Germany.  He is an actor, known for The Reader (2008), War Horse (2011) and Krabat and the Legend of the Satanic Mill (2008)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wFz6KZqgsrbKQsLw7gyklixPQjU.jpg", url:"https://themoviedb.org/person/5847"}}, {tmdbId:"84029", properties:{bornIn:"Osaka, Japan", imdbId:"0297858", born:date('1979-12-07'), name:"Ayako Fujitani", bio:"From Wikipedia, the free encyclopedia. \n\nAyako Fujitani (born December 7, 1979) is a writer and actress.  She is fluent in English and Japanese. \n\nDescription above from the Wikipedia article Ayako Fujitani, licensed under CC-BY-SA, full list of contributors on Wikipedia. \n\nDaughter of Steven Seagal...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2Vb1HMkxWFeaHfjcFu5c27xUF91.jpg", url:"https://themoviedb.org/person/84029"}}, {tmdbId:"2015106", properties:{name:"German Alexander", url:"https://themoviedb.org/person/2015106"}}, {tmdbId:"1198451", properties:{imdbId:"1383128", name:"Bob Avian", url:"https://themoviedb.org/person/1198451"}}, {tmdbId:"19246", properties:{imdbId:"1378431", name:"Michael Bennett", url:"https://themoviedb.org/person/19246"}}, {tmdbId:"2362304", properties:{name:"Sonya Davison", url:"https://themoviedb.org/person/2362304"}}, {tmdbId:"86884", properties:{bornIn:"Mumbai, Maharahstra, India", imdbId:"2945270", born:date('1983-05-29'), name:"Anand Tiwari", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jkMnh7wv43V48fGrTRmnOH7u8oC.jpg", url:"https://themoviedb.org/person/86884"}}, {tmdbId:"64136", properties:{bornIn:"Kalispell, Montana", imdbId:"1130728", born:date('1982-07-06'), name:"Misty Upham", bio:"​From Wikipedia, the free encyclopedia\n\nMisty Anne Upham (July 6, 1982 – October 5, 2014) was a Native American actress best known for her role in the 2008 film Frozen River, for which she was nominated for an Independent Spirit Award for Best Supporting Female.  She also appeared in Jimmy P: Psychotherapy of a Plains Indian and August: Osage County. \n\nDescription above from the Wikipedia article Misty Upham, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2014-10-05'), url:"https://themoviedb.org/person/64136"}}, {tmdbId:"64135", properties:{bornIn:"West Chester, Pennsylvania, United States", imdbId:"1668208", born:date('1990-04-06'), name:"Charlie McDermott", bio:"​From Wikipedia, the free encyclopedia\n\nCharlie McDermott (born April 6, 1990) is an American television and film actor.  Since 2004, he has worked on a wide range of television series, including The Office, Private Practice and The Middle (as a series regular).  He moved to Los Angeles at the age of 16. \n\nHis biggest movie parts to date are Wild Bill in Disappearances and Troy J.  'T. J. ' Eddy in Frozen River...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7kQgcZkQ88cZOQBpjFzzqheoGT9.jpg", url:"https://themoviedb.org/person/64135"}}, {tmdbId:"22", properties:{bornIn:"Camberwell, Melbourne, Australia", imdbId:"0402032", born:date('1934-02-17'), name:"Barry Humphries", bio:"John Barry Humphries, AO, CBE (born 17 February 1934) is an Australian comedian, satirist, dadaist, artist, author and character actor, perhaps best known for his on-stage and television alter egos Dame Edna Everage, a Melbourne housewife and \"gigastar\", and Sir Les Patterson, Australia's foul-mouthed cultural attaché to the Court of St.  James's. \n\nHe is a film producer and script writer, a star of London's West End musical theatre, an award-winning writer and an accomplished landscape painter...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7WClJFIZ7QDkTMgFi8Rl1XQp6wV.jpg", url:"https://themoviedb.org/person/22"}}, {tmdbId:"93491", properties:{bornIn:"Hammersmith, London, England, UK", imdbId:"2401020", born:date('1993-11-28'), name:"Will Poulter", bio:"English actor William Jack Poulter is most notable for his role as Lee Carter in Son of Rambow, and as Eustace Scrubb in The Chronicles of Narnia: The Voyage of the Dawn Treader...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c2OLzJOjLX8ER3t3GQ1iTt3defa.jpg", url:"https://themoviedb.org/person/93491"}}, {tmdbId:"21660", properties:{imdbId:"1969169", born:date('1989-06-24'), name:"Rafi Gavron", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/avCWoO9fLwEhbT6cvu0TJcSj49g.jpg", url:"https://themoviedb.org/person/21660"}}, {tmdbId:"79006", properties:{bornIn:"Tokyo, Japan", imdbId:"0594647", born:date('1975-01-13'), name:"Kenji Mizuhashi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2ydE4b4j3gFmx7kPPrGOuVyM4DX.jpg", url:"https://themoviedb.org/person/79006"}}, {tmdbId:"122180", properties:{bornIn:"日本, 埼玉県", imdbId:"2710673", born:date('1988-05-09'), name:"Yoshimi Kondou", url:"https://themoviedb.org/person/122180"}}] AS row
