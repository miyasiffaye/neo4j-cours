UNWIND [{tmdbId:"18286", properties:{bornIn:"Washington, District of Columbia, USA", imdbId:"0310850", born:date('1974-09-04'), name:"Nona Gaye", bio:"Nona Marvisa Gaye (born September 4, 1974) is an American singer, former fashion model, and screen actress.  The daughter of soul music legend Marvin Gaye and granddaughter of jazz great Slim Gaillard, she began her career as a vocalist in the early 1990s.  As an actress, she is best known for her portrayal of Zee in the science fiction films The Matrix Reloaded and The Matrix Revolutions...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2g6BDp6dUB6ql5xKEhY07IhxGkc.jpg", url:"https://themoviedb.org/person/18286"}}, {tmdbId:"19127", properties:{bornIn:"USA", imdbId:"0793390", born:date('1982-10-03'), name:"Wen Yann Shih", url:"https://themoviedb.org/person/19127"}}, {tmdbId:"1281", properties:{bornIn:"Camden Town, London, England, UK ", imdbId:"0383603", born:date('1992-02-14'), name:"Freddie Highmore", bio:"Alfred Thomas Highmore is an English  actor best known for his roles in the films \"Finding Neverland\"; \"Charlie and the Chocolate Factory\"; \"Arthur and the Invisibles\"; \"August Rush\"; \"The Golden Compass\" and \"The Spiderwick Chronicles\".  He starred as Norman Bates in \"Bates Motel\" A&E's contemporary prequel series of the film \"Psycho\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/berpjuXALltPnJSkISZfQEDGnYQ.jpg", url:"https://themoviedb.org/person/1281"}}, {tmdbId:"20527", properties:{imdbId:"0629127", name:"Oanh Nguyen", url:"https://themoviedb.org/person/20527"}}, {tmdbId:"2712745", properties:{name:"Anthony Chau-Sang Wong", url:"https://themoviedb.org/person/2712745"}}, {tmdbId:"31082", properties:{bornIn:"Kobe, Hyōgo Prefecture, Japan", imdbId:"0535327", born:date('1975-04-19'), name:"Ai Maeda", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vaPxGBUcKTjm6GHcgDkFQ41Rw6Q.jpg", url:"https://themoviedb.org/person/31082"}}, {tmdbId:"96473", properties:{bornIn:"Chiba, Japan", imdbId:"1099171", born:date('1981-03-05'), name:"Shûgo Oshinari", bio:"Shūgo Oshinari (忍成 修吾 Oshinari Shūgo?, born 5 March 1981 in Chiba, Chiba) is a Japanese actor best known for his roles in the controversial Battle Royale II: Requiem (2003) and Shunji Iwai's film, All About Lily Chou-Chou (2001). \n\nOshinari also appeared in four music videos by Japanese singer Kumi Koda during the period in which she released twelve singles in twelve weeks.  The videos in which he appeared were \"You\", \"Lies\", \"Feel\" and \"Someday\"...", url:"https://themoviedb.org/person/96473"}}, {tmdbId:"1078665", properties:{imdbId:"1119539", name:"Ayana Sakai", url:"https://themoviedb.org/person/1078665"}}, {tmdbId:"29795", properties:{bornIn:"Worthington - Ohio - USA", imdbId:"0687443", born:date('1968-10-30'), name:"Jack Plotnick", bio:"From Wikipedia, the free encyclopedia. \n\nJack Stuart Plotnick (born October 30, 1968) is an American film and television actor. \n\nBorn in Worthington, Ohio, Plotnick is based in Hollywood.  Plotnick is an openly gay actor, best known for performances on Ellen, Buffy the Vampire Slayer, as the voice of Xandir on Drawn Together, and his drag persona, \"Evie Harris\" in Girls Will Be Girls...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1BeShuLhc2HXZieyGEOVgDssAuR.jpg", url:"https://themoviedb.org/person/29795"}}, {tmdbId:"60235", properties:{imdbId:"0505029", born:date('1965-01-01'), name:"Clinton Leupp", bio:"Miss Coco Peru, aka Clinton Leupp, is a gay male American actor and drag performer, perhaps best known for his role in the 1999 independent film Trick.  Peru also starred in Richard Day's Girls Will Be Girls (2003), was one of six performers featured in the Logo original stand-up comedy series Wisecrack (2005), and had a cameo appearance in the 1995 comedy film To Wong Foo, Thanks for Everything! Julie Newmar...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sDhG3dJ1IKF3jzOv3tsSBqY8QzB.jpg", url:"https://themoviedb.org/person/60235"}}, {tmdbId:"87040", properties:{imdbId:"0581066", name:"Jeffery Roberson", url:"https://themoviedb.org/person/87040"}}, {tmdbId:"87042", properties:{imdbId:"1273781", name:"Ron Mathews", url:"https://themoviedb.org/person/87042"}}, {tmdbId:"57014", properties:{bornIn:" Stockholm,  Sweden", imdbId:"0706548", born:date('1957-11-07'), name:"Göran Ragnerstam", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aY6gCtmqILWDs9R10z92n2FE35E.jpg", url:"https://themoviedb.org/person/57014"}}, {tmdbId:"57015", properties:{bornIn:"Örgryte, Göteborg och Bohus län, Sweden", imdbId:"0477404", born:date('1957-03-17'), name:"Sissela Kyle", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/F07lZ9cuwrSiHjLYofOBtbHKHU.jpg", url:"https://themoviedb.org/person/57015"}}, {tmdbId:"70456", properties:{bornIn:"Melbourne, Victoria, Australia", imdbId:"0115161", born:date('1988-12-07'), name:"Emily Browning", bio:"Emily Jane Browning (born 7 December 1988) is an Australian actress and singer. \n\nBrowning made her film debut in the Australian television film The Echo of Thunder; subsequently, she played recurring roles in the Australian television shows Blue Heelers and Something in the Air.  Her breakthrough role was in the 2002 horror film Ghost Ship, which introduced her to a wider audience...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fa1Kyj02wxwcdS6EHb2i27TNXvU.jpg", url:"https://themoviedb.org/person/70456"}}, {tmdbId:"146449", properties:{imdbId:"1495616", born:date('2002-08-02'), name:"Kara Hoffman", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bOL1B5i1SwwhUTZ6E5Qgg9xoNV2.jpg", url:"https://themoviedb.org/person/146449"}}, {tmdbId:"26257", properties:{bornIn:"Atherston, Warwickshire, England, UK", imdbId:"0493271", born:date('1945-07-21'), name:"Leigh Lawson", bio:"Allan Leigh Lawson (born 21 July 1945) is an English film and stage actor, director and writer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iI3csD4KZoA6nXx6K1c902YNxgK.jpg", url:"https://themoviedb.org/person/26257"}}, {tmdbId:"63311", properties:{bornIn:" Liverpool, Merseyside, England, UK", imdbId:"1140345", born:date('1980-03-06'), name:"Shaun Evans", bio:"​From Wikipedia, the free encyclopedia.   \n\nShaun Evans (born 6 March 1980 in Liverpool) is an English actor. \n\nEvans completed a course with the National Youth Theatre before relocating to London at the age of eighteen  to study at the Guildhall School of Music and Drama.  His first major role was that of gay French teacher John Paul Keating in the Channel 4 comedy-drama Teachers during its second series in 2002...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tB6pnTyN8zOxCKneCERNVLnbSTs.jpg", url:"https://themoviedb.org/person/63311"}}, {tmdbId:"6860", properties:{bornIn:"Seal Beach, California, USA", imdbId:"1497548", born:date('1996-02-09'), name:"Jimmy Bennett", bio:"James Michael \"Jimmy\" Bennett (born February 9, 1996) is an American actor.  He is known for his roles as a child actor in Daddy Day Care, Hostage, Poseidon, and more recently in Orphan and as young James T.  Kirk in Star Trek.  He also starred in No Ordinary Family as JJ Powell, a teenager gifted with vast intelligence after a plane crash...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8ktMwTxDqgyiYKdIB5dWEuX2zG1.jpg", url:"https://themoviedb.org/person/6860"}}, {tmdbId:"20847", properties:{bornIn:"Pasadena - California - USA", imdbId:"0394889", born:date('1987-02-28'), name:"Michelle Horn", bio:"Michelle Horn (born February 28, 1987) is an American actress known for her work in the TV shows Strong Medicine and Family Law.  Horn is also known for her voiceover work in Disney's Lion King 2: Simba's Pride as the lion cub Kiara.  Her voice can be heard in Lion King-related merchandise such as software, plushes, toys and video games.  Horn also costarred with Bruce Willis in the 2005 feature Hostage, Loving Annabelle and Eliza Pinchley on Family Guy...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vSqV6aBtjzB5FElrMufYNBdBkB.jpg", url:"https://themoviedb.org/person/20847"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"22970", properties:{bornIn:"Morristown, New Jersey, USA", imdbId:"0227759", born:date('1969-06-11'), name:"Peter Dinklage", bio:"Peter Dinklage is an American actor.  Since his breakout role in The Station Agent (2003), he has appeared in numerous films and theatre plays.  Since 2011, Dinklage has portrayed Tyrion Lannister in the HBO series Game of Thrones.  For this he won an Emmy for Outstanding Supporting Actor in a Drama Series and a Golden Globe Award for Best Supporting Actor - Series, Miniseries or Television Film in 2011...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lRsRgnksAhBRXwAB68MFjmTtLrk.jpg", url:"https://themoviedb.org/person/22970"}}, {tmdbId:"15534", properties:{bornIn:"Pelion, South Carolina, USA", imdbId:"0071345", name:"Paul Benjamin", bio:"Paul Benjamin (born 1938) is an American actor. \n\nBenjamin was born in Pelion, South Carolina.  He made his film debut in 1969 as a bartender in Midnight Cowboy.  After a small role in Sidney Lumet's The Anderson Tapes, he did extensive television work in the 1970s. \n\nA few notable exceptions were a major role in Barry Shear's Across 110th Street, and smaller parts in Gordon Parks' biopic Leadbelly, Arthur Marks' Friday Foster, and Don Siegel's prison film Escape from Alcatraz...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kL7yRboRApbIHU3XIL903wTtGTI.jpg", url:"https://themoviedb.org/person/15534"}}, {tmdbId:"21123", properties:{bornIn:"Suffern, New York, USA", imdbId:"0087580", born:date('1987-04-16'), name:"Jase Blankfort", url:"https://themoviedb.org/person/21123"}}, {tmdbId:"21124", properties:{bornIn:"Medellin, Antioquia, Colombia", imdbId:"0305519", born:date('1974-03-20'), name:"Paula Garcés", bio:"Paula Garcés (born March 20, 1974) is a Colombian American film and television actress, known for her appearance in films such as Clockstoppers and Harold and Kumar Go to White Castle, and on TV shows such as CSI: Miami, The Shield, Law and Order: Special Victims Unit, The Sopranos , Oz and Warehouse 13. \n\nDescription above from the Wikipedia article Paula Garcés, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/u2tcoWXcD8Wu9wadN7p4ihnkLV9.jpg", url:"https://themoviedb.org/person/21124"}}, {tmdbId:"6906", properties:{bornIn:"Ivoryton, Connecticut, USA", imdbId:"0855564", born:date('1965-07-08'), name:"Lee Tergesen", bio:"Tergesen was born in Boston, Massachusetts and graduated from Valley Regional High School in nearby Deep River.  He moved to New York to try to become an actor.  He graduated from the American Musical and Dramatic Academy (AMDA)'s two-year program in Manhattan, where, from 1986 to 1989, he worked at the Empire Diner...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qAldK2CeBVzeRZ9sqTd3zU9SiU1.jpg", url:"https://themoviedb.org/person/6906"}}, {tmdbId:"1224937", properties:{bornIn:"Manhattan, New York, USA", imdbId:"1477533", born:date('1981-10-30'), name:"Ivanka Trump", bio:"From Wikipedia, the free encyclopedia. \n\nIvanka Marie Trump (born October 30, 1981) is an American businesswoman, socialite, heiress, and fashion model.  The daughter of Ivana and Donald Trump, she is Executive Vice President of Development & Acquisitions at The Trump Organization.  She is one of the boardroom judges on her father's reality show The Apprentice. \n\nDescription above from the Wikipedia article Ivanka Trump, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aheevnGIuGsOyWh5SI8168fqnpI.jpg", url:"https://themoviedb.org/person/1224937"}}, {tmdbId:"1106733", properties:{bornIn:"Manhattan, New York City, New York, USA", imdbId:"1291228", born:date('1983-01-20'), name:"Georgina Bloomberg", url:"https://themoviedb.org/person/1106733"}}, {tmdbId:"1106737", properties:{imdbId:"2373038", name:"Si Newhouse IV", url:"https://themoviedb.org/person/1106737"}}, {tmdbId:"1106739", properties:{imdbId:"1179400", name:"Luke Weil", url:"https://themoviedb.org/person/1106739"}}, {tmdbId:"67562", properties:{bornIn:"Andernach, Alemania", imdbId:"0001977", born:date('1920-08-16'), name:"Charles Bukowski", bio:"Henry Charles Bukowski was a German-American poet, novelist, and short-story writer.  His writing was influenced by the social, cultural, and economic ambiance of his home city of Los Angeles...", died:date('1994-03-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AohcGXDUlA9zvynTWu3smFoD8iv.jpg", url:"https://themoviedb.org/person/67562"}}, {tmdbId:"80375", properties:{bornIn:"Northfield, Ohio, United States", imdbId:"1307515", name:"Daniel Letterle", bio:"​From Wikipedia, the free encyclopedia\n\nDaniel Letterle (born May 1979) is an American actor who portrayed the lead roles in The Mostly Unfabulous Social Life of Ethan Green and Camp. \n\nDescription above from the Wikipedia article Daniel Letterle, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nkorTYczks9LLfb3Esz9lOnYVNt.jpg", url:"https://themoviedb.org/person/80375"}}, {tmdbId:"110504", properties:{imdbId:"1291597", born:date('1985-10-31'), name:"Joanna Chilcoat", url:"https://themoviedb.org/person/110504"}}, {tmdbId:"110505", properties:{bornIn:"Norwalk, Connecticut, USA", imdbId:"1296587", born:date('1984-08-21'), name:"Robin de Jesus", bio:"Robin de Jesús is an American film and theater actor of Puerto Rican descent.  He is perhaps best known for playing the role of Sonny in the 2008 Broadway musical IN THE HEIGHTS, for which he received a Tony Award nomination for Best Featured Actor in a Musical.  From 2010 to 2011, he was part of the revival cast of La Cage aux Folles...", url:"https://themoviedb.org/person/110505"}}, {tmdbId:"23290", properties:{imdbId:"1362535", born:date('1937-04-12'), name:"Arnold Friedman", died:date('1995-02-14'), url:"https://themoviedb.org/person/23290"}}, {tmdbId:"23291", properties:{imdbId:"1363479", name:"Elaine Friedman", url:"https://themoviedb.org/person/23291"}}, {tmdbId:"23293", properties:{imdbId:"1362536", name:"David Friedman", url:"https://themoviedb.org/person/23293"}}, {tmdbId:"23294", properties:{imdbId:"1385069", name:"Seth Friedman", url:"https://themoviedb.org/person/23294"}}, {tmdbId:"115863", properties:{bornIn:"Birán, Cuba", imdbId:"0004242", born:date('1926-08-13'), name:"Fidel Castro", bio:"From Wikipedia, the free encyclopedia.    \n\nFidel Alejandro Castro Ruz (  born August 13, 1926) is a Cuban politician, socialist revolutionary, and former political leader of the country.   As the primary leader of the Cuban Revolution, Castro served as the Prime Minister of Cuba from February 1959 to December 1976, and then as the President of the Council of State of Cuba and the President of the Council of Ministers of Cuba until his resignation from the office in February 2008...", died:date('2016-11-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dX5ZWCkwCzA9YfNALghFNPlRefp.jpg", url:"https://themoviedb.org/person/115863"}}, {tmdbId:"110132", properties:{imdbId:"1808158", name:"Juanita Vera", url:"https://themoviedb.org/person/110132"}}, {tmdbId:"62105", properties:{bornIn:"Tipperary, Ireland", imdbId:"0174403", born:date('1983-01-04'), name:"Kerry Condon", bio:"Kerry Condon is an Irish television and film actress.  Best known for her role as Octavia of the Julii in the HBO/BBC series Rome, she also appeared in HBO's short-run series Luck...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9UinfSwMqlgNrpoeppRtQqI6yZG.jpg", url:"https://themoviedb.org/person/62105"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"110082", properties:{bornIn:"Fairfax, Virginia, USA", imdbId:"0005158", born:date('1970-11-20'), name:"Sabrina Lloyd", bio:"​From Wikipedia, the free encyclopedia\n\nSabrina Lloyd (born November 20, 1970 in Fairfax, Virginia) is an American film and television actress. \n\nShe has played the roles of Wade Welles in the science fiction series Sliders, and Natalie Hurley in the ABC sitcom Sports Night. \n\nDescription above from the Wikipedia article Sabrina Lloyd, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/110082"}}, {tmdbId:"66252", properties:{bornIn:"Rio de Janeiro - Brazil", imdbId:"0004797", born:date('1973-12-03'), name:"Bruno Campos", bio:"​From Wikipedia, the free encyclopedia\n\nBruno Campos (born December 3, 1973) is a Brazilian-born United States-based actor, best known for his role as Dr.  Quentin Costa on the Golden Globe Award-winning television show Nip/Tuck...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sj3XipPqDfSgMsxRsmj30ExlJKi.jpg", url:"https://themoviedb.org/person/66252"}}, {tmdbId:"175588", properties:{imdbId:"0344578", name:"Rueben Grundy", url:"https://themoviedb.org/person/175588"}}, {tmdbId:"18997", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0397171", born:date('1981-03-02'), name:"Bryce Dallas Howard", bio:"Actress and daughter of Ron Howard who landed her first major film role in the 2004 M.  Night Shyamalan feature The Village.  She received a Golden Globe Award nomination for her performance in the TV movie As You Like It.  She also stars as Claire Dearing in the 2015 blockbuster Jurassic World...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qQX1rhQaJ1G8eMG2RknFKiXfNRc.jpg", url:"https://themoviedb.org/person/18997"}}, {tmdbId:"1247242", properties:{name:"Evan White", url:"https://themoviedb.org/person/1247242"}}, {tmdbId:"16859", properties:{bornIn:"Bayonne, New Jersey, USA", imdbId:"0087109", born:date('1976-12-14'), name:"Tammy Blanchard", bio:"Tammy Blanchard (born December 14, 1976) is an American actress.  She has worked primarily in films and television, making her professional start in the soap opera Guiding Light. \n\nFor her first stage appearance, she played the role of Louise/Gypsy in the 2003 Broadway revival of the musical Gypsy: A Musical Fable, for which she earned both a Tony Award nomination and a Theatre World Award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2KVwLmqkKapSCsZjhMt87ns2VUn.jpg", url:"https://themoviedb.org/person/16859"}}, {tmdbId:"21088", properties:{bornIn:"El Paso - Texas - USA", imdbId:"0876138", born:date('1971-03-16'), name:"Alan Tudyk", bio:"Alan Wray Tudyk (born March 16, 1971) is an American actor known for his roles as Simon in the British comedy Death at a Funeral, as Steve the Pirate in DodgeBall: A True Underdog Story, as Sonny in the science fiction drama I, Robot, and as Hoban \"Wash\" Washburne in the science fiction and western television series Firefly and movie Serenity. \n\nDescription above from the Wikipedia article Alan Tudyk, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w56mp2ky1t7ORDsoGQP00OHlyic.jpg", url:"https://themoviedb.org/person/21088"}}, {tmdbId:"16790", properties:{bornIn:"Boulogne-Billancourt, Paris, France", imdbId:"0880484", born:date('1984-11-25'), name:"Gaspard Ulliel", bio:"Gaspard Ulliel (born 25 November 1984) is a French film actor.  He began appearing in made-for-television films during the late 1990s and early 2000s, and then began to be known as a film actor in France, as well as starring in the title role in the thriller Hannibal Rising...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/u0zpbsRUPBK78PUMfh7oMTJh3Xl.jpg", url:"https://themoviedb.org/person/16790"}}, {tmdbId:"17901", properties:{imdbId:"0627262", born:date('1948-12-11'), name:"Chantal Neuwirth", bio:"​From Wikipedia, the free encyclopedia.   \n\nChantal Heuwirth is a French actress, who also played on theatre. \n\nDescription above from the Wikipedia article Chantal Neuwirth, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/17901"}}, {tmdbId:"61605", properties:{imdbId:"0186949", born:date('1945-10-11'), name:"Ron Crawford", bio:"From Wikipedia, the free encyclopedia. \n\nRon Crawford ( October 11, 1945) (age 60) is an actor and artist. \n\nDescription above from the Wikipedia article Ron Crawford, licensed under CC-BY-SA, full list of contributors on Wikipedia ...", url:"https://themoviedb.org/person/61605"}}, {tmdbId:"9192", properties:{bornIn:"Tokyo, Japan", imdbId:"0407033", born:date('1946-09-26'), name:"Togo Igawa", bio:"Togo Igawa, born in Tokyo on 26 September 1946, is a Japanese actor who works primarily in British films and television. \n\nIn recent years he has had roles in major motion pictures such as Revolver, Memoirs of a Geisha, The Last Samurai, and Sunshine.  He has also appeared in the Israeli movie A Matter of Size and the Thomas and Friends movies Hero of the Rails and Misty Island Rescue in 2009 and 2010...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ceEgj3Ezbf07xWvb8CWh0MEhpTg.jpg", url:"https://themoviedb.org/person/9192"}}, {tmdbId:"26197", properties:{bornIn:"England, UK", imdbId:"1029263", born:date('1975-02-06'), name:"Nabil Elouahabi", bio:"​From Wikipedia, the free encyclopedia.   \n\nNabil Elouahabi (born 6 February 1975), sometimes credited as Nabil Elouhabi, is a British Moroccan actor, arguably best known for his role as Tariq Larousi in EastEnders from 2003 to 2005, or as his role as \"Gary\", the 'kidnapped' son of a French millionaire, in Only Fools and Horses in 2002. \n\nDescription above from the Wikipedia article Nabil Elouahabi, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/26197"}}, {tmdbId:"1284856", properties:{name:"Sinitta Boonyasak", url:"https://themoviedb.org/person/1284856"}}, {tmdbId:"69990", properties:{bornIn:"Bangkok, Thailand", imdbId:"1428198", born:date('1982-09-15'), name:"Laila Boonyasak", bio:"Chermarn Boonyasak (Thai: เฌอมาลย์ บุญยศักดิ์, born September 15, 1982 in Bangkok, Thailand) is a Thai film and television actress and model.  Her film roles have included the title ghost character in director Yuthlert Sippapak's horror-comedies Buppah Rahtree and Buppah Rahtree Phase 2: Rahtree Returns.  She was also featured in Pen-Ek Ratanaruang's Last Life in the Universe, in which she portrayed the younger sister of the character played by her real-life older sister, Sinitta Boonyasak...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i5dSdEDoyuh2T3crG1WBo4ZJg5x.jpg", url:"https://themoviedb.org/person/69990"}}, {tmdbId:"27782", properties:{bornIn:" Fukuoka, Fukuoka Prefecture, Japan", imdbId:"0559647", born:date('1963-01-19'), name:"Yutaka Matsushige", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fsMHdOFlrkrPEUWDtXftYnBXMqN.jpg", url:"https://themoviedb.org/person/27782"}}, {tmdbId:"28634", properties:{bornIn:" New York, USA", imdbId:"1302182", born:date('1980-06-23'), name:"Steve Sandvoss", bio:"​From Wikipedia, the free encyclopedia. \n\nSteve Sandvoss  (born June 23, 1980 in New York City) is an American actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/urkwNdkGCEZldtegbhzCZOV7iI1.jpg", url:"https://themoviedb.org/person/28634"}}, {tmdbId:"78595", properties:{bornIn:"Louisville - Kentucky - USA", imdbId:"0709095", born:date('1977-10-06'), name:"Wes Ramsey", bio:"​From Wikipedia, the free encyclopedia. \n\nWesley A.  Ramsey (born October 6, 1977) is an American actor.  He is perhaps best known for his performance in the romantic drama Latter Days and for his multiple appearances in Charmed as Wyatt Halliwell...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/77kRUwFr0cWndNlVKy1xQrMYSYS.jpg", url:"https://themoviedb.org/person/78595"}}, {tmdbId:"78596", properties:{bornIn:"Ohio, USA", imdbId:"0426041", born:date('1976-09-03'), name:"Rebekah Johnson", bio:"​From Wikipedia, the free encyclopedia. \n\nRebekah Johnson, also credited as Rebekah Jordan or Rebekah, is an American singer-songwriter and actress from Ohio.  She wrote the song \"Beautiful Disaster\" for Kelly Clarkson who loved the song so much she put it on both her first two albums.  In 1998, she released \"Remember to Breathe\" on Elektra Records, the radio singles were \"Sin So Well\" and \"Hey Genius\".  Rebekah sought and was eventually granted a release from the label due to creative differences...", url:"https://themoviedb.org/person/78596"}}, {tmdbId:"35468", properties:{bornIn:"Birmingham - Alabama - USA", imdbId:"0072435", born:date('1977-01-08'), name:"Amber Benson", bio:"​From Wikipedia, the free encyclopedia. \n\nAmber Nicole Benson  (born January 8, 1977) is an American actress, writer, film director, and film producer.  She is best known for her role as Tara Maclay on the TV series Buffy the Vampire Slayer, but has also directed, produced and starred in her own films Chance (2002) and Lovers, Liars &amp; Lunatics (2006). She is also co-director with Adam Busch of Drones (2010)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kjTTZsimC54A4F4pQnimqy1DdOr.jpg", url:"https://themoviedb.org/person/35468"}}, {tmdbId:"78798", properties:{bornIn:"Syracuse, New York, USA", imdbId:"0444786", born:date('1962-07-13'), name:"Tom Kenny", bio:"Thomas James \"Tom\" Kenny (born July 13, 1962) is an American actor, voice actor and comedian, noted for his long-running-role as SpongeBob SquarePants in the television series of the same name, as well as the live-action character Patchy the Pirate, Gary the Snail and the French narrator based on Jacques Cousteau.  He is also the narrator of Cartoon Network's The Powerpuff Girls...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kftXtExrcoTTjyeYmSXJ0Ogr3R7.jpg", url:"https://themoviedb.org/person/78798"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"70615", properties:{bornIn:"Little Rock, Arkansas, USA", imdbId:"0120309", born:date('1951-11-20'), name:"Rodger Bumpass", bio:"Rodger Albert Bumpass (born November 20, 1951) is an American character actor and voice actor Noted as his long-running-role as Squidward Tentacles on the hit series SpongeBob SquarePants.  He also voiced Professor Membrane on Invader Zim, created by Jhonen Vasquez.  Bumpass had many other credits in animated films, animated television series, and video games.  Bumpass' voice acting credits go back as far as a 1962 episode of The Jetsons.  He has repeatedly denied that his name is, in fact, a joke...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9TEh5QJAHnXuM3fE1Uu40QzXJQC.jpg", url:"https://themoviedb.org/person/70615"}}, {tmdbId:"34398", properties:{bornIn:"Fontana, California, USA", imdbId:"0265067", born:date('1957-10-04'), name:"Bill Fagerbakke", bio:"Bill Fagerbakke was born on October 4, 1957 in Fontana, California, USA as William Mark Fagerbakke.  He is an actor, known for The SpongeBob Movie: Sponge Out of Water (2015), SpongeBob SquarePants (1999) and The SpongeBob SquarePants Movie (2004).  He has been married to Catherine McClenahan since 1989.  They have two children...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wOZl6yPLhDyqGf8T6WJO4Vc1FYt.jpg", url:"https://themoviedb.org/person/34398"}}, {tmdbId:"146685", properties:{bornIn:"Houston, Texas", imdbId:"0048195", born:date('1930-04-28'), name:"James Baker III", bio:"From Wikipedia, the free encyclopedia. \n\nJames Addison Baker, III (born April 28, 1930) is an American attorney, politician and political advisor. \n\nBaker served as the Chief of Staff in President Ronald Reagan's first administration and in the final year of the administration of President George H.  W.  Bush.  Baker also served as Secretary of the Treasury from 1985-1988 in the second Reagan administration, and Secretary of State in the George H.  W.  Bush administration...", url:"https://themoviedb.org/person/146685"}}, {tmdbId:"939084", properties:{imdbId:"1732375", name:"Corrine Brown", url:"https://themoviedb.org/person/939084"}}, {tmdbId:"107521", properties:{imdbId:"0960230", born:date('1955-01-01'), name:"Muzaffer Özdemir", url:"https://themoviedb.org/person/107521"}}, {tmdbId:"107522", properties:{bornIn:"Çanakkale, Türkiye", imdbId:"0867780", born:date('1974-09-11'), name:"Emin Toprak", died:date('2002-12-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7SXN3BfVv5aVQxp9gvdShIDPCvo.jpg", url:"https://themoviedb.org/person/107522"}}, {tmdbId:"150267", properties:{imdbId:"0312648", name:"Zuhal Gencer", url:"https://themoviedb.org/person/150267"}}, {tmdbId:"1381257", properties:{bornIn:"Manisa, Turkey", imdbId:"0456400", born:date('1969-03-28'), name:"Nazan Kesal", bio:"Nazan Kesal (née Kırılmış; born 28 March 1969) is a Turkish stage and screen actress. [2] In 2004, she worked as a director and actor in Diyarbakır State Theater.  The artist who was appointed to Bursa State Theater in early 2004, also worked in private groups such as Ankara Sanatevi Theater, Theater Mirror, Theater Istanbul, Diyarbakir Art Center...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/u5bL6Cpgjun4PSuniYv2q3wDF1.jpg", url:"https://themoviedb.org/person/1381257"}}, {tmdbId:"34491", properties:{bornIn:"Palermo, Italy", imdbId:"0516222", born:date('1967-10-20'), name:"Luigi Lo Cascio", bio:"From Wikipedia, the free encyclopedia. \n\nLuigi Lo Cascio is an Italian actor born 20 October 1967 in Palermo. \n\nHe won David di Donatello for Best actor for his starring role in I cento passi. \n\nDescription above from the Wikipedia article Luigi Lo Cascio, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yp7Kf2TVSwuDye5F8G9VthK1xyS.jpg", url:"https://themoviedb.org/person/34491"}}, {tmdbId:"44646", properties:{bornIn:"Sarnico, Bergamo", imdbId:"0094526", born:date('1966-07-04'), name:"Alessio Boni", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wmvo4ZfGEnOMwlg1aQCPbhcsLAQ.jpg", url:"https://themoviedb.org/person/44646"}}, {tmdbId:"70234", properties:{bornIn:"Milano, Italy", imdbId:"0073950", born:date('1966-01-16'), name:"Sonia Bergamasco", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4hjv31J1BFx8NcDtKQmeNjvRXbz.jpg", url:"https://themoviedb.org/person/70234"}}, {tmdbId:"54230", properties:{bornIn:"Rome, Italy", imdbId:"0763022", born:date('1975-09-25'), name:"Maya Sansa", bio:"Maya Sansa (born 25 September 1975) is an Italian actress. \n\nMaya Sansa was born in Rome the daughter of an Iranian father and an Italian mother.  When she was 14, she started to study acting at her high school in Rome the \"Virgilio\".  She then moved to London to study at the Guildhall School of Music and Drama.  There she graduated in acting and was soon picked by Marco Bellocchio to take part in his new film: La balia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aSCX5kskBVe5yCqKzeA9yFv1CWO.jpg", url:"https://themoviedb.org/person/54230"}}, {tmdbId:"146140", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"1525717", born:date('1962-09-25'), name:"David Bedella", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jY9djn5uSZ2hLRhL41ZXlMHRRD.jpg", url:"https://themoviedb.org/person/146140"}}, {tmdbId:"20278", properties:{imdbId:"1752523", name:"Jessie Kamm", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l4FsthV8CuWm2nWvnRGvk9HqjDg.jpg", url:"https://themoviedb.org/person/20278"}}, {tmdbId:"1394937", properties:{imdbId:"3670979", name:"Anthony Snitzer", url:"https://themoviedb.org/person/1394937"}}, {tmdbId:"5117", properties:{bornIn:"Silifke, Mersin, Turkey", imdbId:"0960379", born:date('1961-08-18'), name:"Birol Ünel", bio:"From Wikipedia, the free encyclopedia. \n\nBirol Ünel (born 18 August 1961) is a German actor of Turkish descent.  He has acted in a number of German and Turkish films, TV series and theatrical productions.  His name, \"Birol\", means \"unique\" in Turkish. \n\nÜnel was born in Mersin in southern Turkey.  In 1968, his family moved to Brinkum near Bremen in Germany.  He studied acting at Hanover Conservatory...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bHmJBtqQ2nqGhkt0u0EQuIzljUt.jpg", url:"https://themoviedb.org/person/5117"}}, {tmdbId:"45906", properties:{imdbId:"1597241", born:date('1981-04-09'), name:"Zarah Jane McKenzie", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hMuXAdX2Avyw1BkEEiJJn74bHEp.jpg", url:"https://themoviedb.org/person/45906"}}, {tmdbId:"5122", properties:{imdbId:"0311348", born:date('1964-01-01'), name:"Stefan Gebelhoff", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yp9ylVx8jWNCOa2qkkCm4Ah4B5W.jpg", url:"https://themoviedb.org/person/5122"}}, {tmdbId:"533325", properties:{bornIn:"Tokyo, Japan", imdbId:"0047962", born:date('1941-06-29'), name:"Chieko Baishô", bio:"Chieko Baisho (倍賞 千恵子, Baishō Chieko, born June 29, 1941) is a Japanese actress and singer. \n\nIn Japan, she is well known for her performance as Sakura in the \"Otoko wa Tsurai yo\" series from 1969 until 1995.  In addition, she has acted in many films directed by Yōji Yamada since the 1960s.  She won the award for best actress at the 5th Hochi Film Award for \"A Distant Cry from Spring\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h4RXDxmSOhjlJsb1BY20RXZ9bSR.jpg", url:"https://themoviedb.org/person/533325"}}, {tmdbId:"20338", properties:{bornIn:"Nagasaki, Nagasaki Prefecture, Japan", imdbId:"0594271", born:date('1935-05-15'), name:"Akihiro Miwa", bio:"Akihiro Maruyama (born May 15, 1935), better known by his stage name Akihiro Miwa, is a Japanese singer, actor, author and drag queen...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pCfBeLJigKnUWOAy7hsdBR7K0UV.jpg", url:"https://themoviedb.org/person/20338"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"19592", properties:{bornIn:"Tokyo, Japan", imdbId:"0309107", born:date('1950-12-10'), name:"Tatsuya Gashûin", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jJufP3XhzvQxVrzBiBrJjRFN7Ib.jpg", url:"https://themoviedb.org/person/19592"}}, {tmdbId:"12199", properties:{bornIn:"Tokyo Prefecture, Japan", imdbId:"0645634", born:date('1928-01-02'), name:"Tamio Ôki", bio:"Tamio Ohki is a Japanese voice actor and narrator from Tokyo...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ixEU7F1vWpcm0MGqc04xXNGLpHz.jpg", url:"https://themoviedb.org/person/12199"}}, {tmdbId:"69311", properties:{bornIn:"San Nicolás de los Arroyos, Buenos Aires, Argentina", imdbId:"0078452", born:date('1969-11-30'), name:"Valeria Bertuccelli", bio:"​From Wikipedia, the free encyclopedia\n\nValeria Bertuccelli (born in 1970) in is an Argentine film and television actress. \n\nBorn in San Nicolás de los Arroyos, Buenos Aires Province, she began her career in experimental theatre, and later worked in the San Martín and Cervantes theatres.  She was first cast in the cinema of Argentina by director Mariano Galperin, and received a Silver Condor Award for her role in Daniel Barone's Alma mía (2000)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pKO7P2BQ7gwLBfa0cKzjygeFIBs.jpg", url:"https://themoviedb.org/person/69311"}}, {tmdbId:"118651", properties:{bornIn:"Higashioosaka, Osaka Prefecture, Japan", imdbId:"0407514", born:date('1981-11-21'), name:"Chizuru Ikewaki", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sCy1c56n87eOgoBCO2GrLh33YSk.jpg", url:"https://themoviedb.org/person/118651"}}, {tmdbId:"96569", properties:{imdbId:"0354560", name:"Yoshihiko Hakamada", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9MiHicynL06fy26alvLnGt4ORkn.jpg", url:"https://themoviedb.org/person/96569"}}, {tmdbId:"74377", properties:{bornIn:"Naha, Okinawa Prefecture, Japan", imdbId:"1303233", born:date('1983-10-20'), name:"Takayuki Yamada", bio:"Takayuki Yamada (山田 孝之 Yamada Takayuki, born October 20, 1983) is a Japanese actor and singer.  He has two elder sisters and one son.  At age 15, he was discovered by talent agency Stardust and made his debut in his acting career in the TV drama Psychometrer Eiji 2 in 1999. \n\nOne of his first big roles was starring as Matsumoto Sakutaro in Sekai no Chuushin de, Ai wo Sakebu in the 2004 TBS series.  In 2005, he made his name known with the movie Densha Otoko...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lOWmszA6rkk1IAGQj28zfdi4MOi.jpg", url:"https://themoviedb.org/person/74377"}}, {tmdbId:"70120", properties:{bornIn:"Naha, Okinawa", imdbId:"0875364", born:date('1944-02-26'), name:"Masane Tsukayama", bio:"From Wikipedia, the free encyclopedia. \n\nMasane Tsukayama ( born February 26, 1944) is a Japanese actor, voice actor, and narrator from Naha, Okinawa. \n\nDescription above from the Wikipedia article Masane Tsukayama, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/70120"}}, {tmdbId:"70122", properties:{bornIn:"Satsumasendai, Japan", imdbId:"0973370", born:date('1978-10-27'), name:"Manami Konishi", bio:"Manami Konishi ( born October 27, 1978) is a Japanese actress and singer from Satsumasendai, Kagoshima, Japan.  She is a part of Sony Music Japan. \n\nDescription above from the Wikipedia article Manami Konishi, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pbijASgRy0dZUdf7cWGbGIvOsXd.jpg", url:"https://themoviedb.org/person/70122"}}, {tmdbId:"17271", properties:{bornIn:"Des Moines, Iowa, USA", imdbId:"0746125", born:date('1979-10-09'), name:"Brandon Routh", bio:"Brandon James Routh (born October 9, 1979) is an American actor and former fashion model.  He grew up in Iowa before moving to Los Angeles to pursue an acting career, and subsequently appeared on multiple television series throughout the early 2000s.  In 2006, he gained greater recognition for his role as the titular superhero of the 2006 film Superman Returns.  He also had a recurring role in the TV series Chuck, as Daniel Shaw...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iPonANuyk3eOHjADqd4h9sBwvX1.jpg", url:"https://themoviedb.org/person/17271"}}, {tmdbId:"28638", properties:{bornIn:"Tipton, Missouri, USA", imdbId:"0462712", born:date('1962-08-24'), name:"David Koechner", bio:"David Michael Koechner is an American character actor (film, television and stage), comedian and musician. \n\nKoechner began studying improvisational comedy in Chicago at the ImprovOlympic, under the teachings of Del Close, before joining the Second City Northwest.  After one-year stints of doing sketch comedy on Saturday Night Live and Late Night with Conan O'Brien, he began taking small parts in films such as Man on the Moon and Wag the Dog...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fpTTe1ow3EdfRJ8PZgBJmpeghMS.jpg", url:"https://themoviedb.org/person/28638"}}, {tmdbId:"11824", properties:{bornIn:"New York City, New York, United States", imdbId:"0919991", born:date('1977-04-26'), name:"Tom Welling", bio:"Tom Welling is an American actor, director, producer, and former model, best known for his portrayal of Clark Kent in the CW series Smallville...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tkwREdAuj33kNTG7O8niRQMxepy.jpg", url:"https://themoviedb.org/person/11824"}}, {tmdbId:"6857", properties:{bornIn:"Brisbane, Australia", imdbId:"0057150", born:date('1972-08-02'), name:"Jacinda Barrett", bio:"Jacinda Barrett (born 2 August 1972) is an Australian American model turned actress.  She first became known to audiences as a cast member on The Real World: London before appearing in films such as Ladder 49, The Namesake, The Human Stain, and Bridget Jones: The Edge of Reason. \n\nDescription above from the Wikipedia article Jacinda Barrett, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vTtd7nyMiOXzYr2gkQduRFVBwYT.jpg", url:"https://themoviedb.org/person/6857"}}, {tmdbId:"17646", properties:{bornIn:"Windsor, Ontario, Canada", imdbId:"0564921", born:date('1935-09-24'), name:"Sean McCann", bio:"From Wikipedia, the free encyclopedia. \n\nSean McCann (born September 24, 1935) is one of Canada's most successful character actors and has been in the business for over 40 years.  Winner of the prestigious Earle Grey Award for his lifetime achievement in television, Sean McCann has appeared in over 150 movies, television shows and plays...", died:date('2019-06-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sVT3HB2rIkfgZ87mCiGmYS2OrzF.jpg", url:"https://themoviedb.org/person/17646"}}, {tmdbId:"2129794", properties:{name:"Ed Kross", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a1oYof1mFXIED2R5gIzKGE19lqs.jpg", url:"https://themoviedb.org/person/2129794"}}, {tmdbId:"38405", properties:{bornIn:"Wheeling, West Virginia, USA", imdbId:"0179173", born:date('1961-05-09'), name:"John Corbett", bio:"​From Wikipedia, the free encyclopedia.   \n\nJohn Joseph Corbett, Jr.  (born May 9, 1961) is an American actor and country music singer.  He is best-known for playing Chris Stevens on Northern Exposure from 1990 to 1995 and Aidan, Carrie Bradshaw's boyfriend, on Sex and the City.  He also played the leading male role opposite Nia Vardalos in Vardalos's hit film, My Big Fat Greek Wedding (2002)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z9iWdUGfubvLDCKmJKZfvedkdbt.jpg", url:"https://themoviedb.org/person/38405"}}, {tmdbId:"58924", properties:{bornIn:"Washington, D.C., USA", imdbId:"0694066", born:date('1956-03-16'), name:"Clifton Powell", bio:"​From Wikipedia, the free encyclopedia. \n\nClifton Powell (born March 16, 1956) is an American actor and comedian...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/izC5jQtlWL58JJMAFu7A4kqBynj.jpg", url:"https://themoviedb.org/person/58924"}}, {tmdbId:"72494", properties:{bornIn:"Tokyo, Japan", imdbId:"0594533", born:date('1973-04-06'), name:"Rie Miyazawa", bio:"From Wikipedia, the free encyclopedia. \n\nRie Miyazawa (born on April 6, 1973) is a Japanese actress and former model. \n\nDescription above from the Wikipedia article Rie Miyazawa, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pmp92W2VNtnE1kvEwDIMTBMb9rO.jpg", url:"https://themoviedb.org/person/72494"}}, {tmdbId:"72495", properties:{bornIn:"Katsuragi, Wakayama, Japan", imdbId:"0462042", born:date('1943-02-07'), name:"Nenji Kobayashi", bio:"From Wikipedia, the free encyclopedia\n\nNenji Kobayashi (小林 稔侍, Kobayashi Nenji, born February 7, 1943) is a Japanese actor.  He won the award for best supporting actor at the 23rd Japan Academy Prize for Poppoya. \n\nDescription above from the Wikipedia article Nenji Kobayashi, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/avGQywkuDkjAblVK5sERakQ06vN.jpg", url:"https://themoviedb.org/person/72495"}}, {tmdbId:"2449", properties:{bornIn:"Bristol, England, UK", imdbId:"0573618", born:date('1956-04-27'), name:"Kevin McNally", bio:"Kevin McNally was born on April 27, 1956, in Bristol, England.  He grew up in Birmingham where he attended Redhill and Mapledene Junior schools and Central Grammar School for Boys.  At the age of 16, he got his first job at Birmingham Repertory Theatre.  A year later he received a scholarship to the Royal Academy of Dramatic Art.  In 1975 he won the Best Actor Bancroft Gold Medal for his stage performance...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fIJF3TZn8ckHkcl44oX77GvPv9e.jpg", url:"https://themoviedb.org/person/2449"}}, {tmdbId:"164", properties:{bornIn:"Ramat Gan, Israel", imdbId:"0038988", born:date('1968-12-28'), name:"Lior Ashkenazi", bio:"Lior Ashkenazi (born in Ramat Gan, 1969), is an award-winning Israeli screen and stage actor. \n\nDescription above from the Wikipedia article Lior Ashkenazi, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c2IJJuYiqZNHoZVikp6HgCgbGkK.jpg", url:"https://themoviedb.org/person/164"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"165", properties:{bornIn:"Gelsenkirchen, Germany", imdbId:"0074257", born:date('1975-01-01'), name:"Knut Berger", bio:"From Wikipedia, the free encyclopedia.   Knut Berger is a German actor.  He was born in 1975 in Gelsenkirchen, North Rhine-Westphalia.  He played Axel Himmelman in the 2004 Israeli film Walk on Water. \n\nDescription above from the Wikipedia article Knut Berger, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lZ5iFEGkz7dG07X0vpl2qLXxe0W.jpg", url:"https://themoviedb.org/person/165"}}, {tmdbId:"166", properties:{bornIn:"Mainz, Germany", imdbId:"0676358", born:date('1971-09-07'), name:"Caroline Peters", bio:"From Wikipedia, the free encyclopedia.  Caroline Peters (born 1971, Mainz, Germany) is a German actress.  She played Pia Himmelman in the 2004 Israeli film Walk on Water. \n\nDescription above from the Wikipedia article Caroline Peters, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jR81BtLq93XAtjB6ftyzH4YbY0P.jpg", url:"https://themoviedb.org/person/166"}}, {tmdbId:"167", properties:{imdbId:"0791435", name:"Gideon Shemer", url:"https://themoviedb.org/person/167"}}, {tmdbId:"1080904", properties:{born:date('1942-03-10'), name:"Jae-ho Song", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gLKek8JICZXq4YdJpOd3jECaLCA.jpg", url:"https://themoviedb.org/person/1080904"}}, {tmdbId:"5077", properties:{bornIn:"Torino, Piemonte, Italia", imdbId:"0116254", born:date('1964-11-16'), name:"Valeria Bruni Tedeschi", bio:"Valeria Bruni Tedeschi, also spelled Bruni-Tedeschi, is an Italian-French actress, screenwriter and film director.  Her 2013 film, A Castle in Italy, was nominated for the Palme d'Or at the 2013 Cannes Film Festival...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lOkXoEKbUPxsm8VkIMrxsgaoNCP.jpg", url:"https://themoviedb.org/person/5077"}}, {tmdbId:"40305", properties:{bornIn:"Paris, France", imdbId:"0293889", born:date('1960-11-27'), name:"Stéphane Freiss", bio:"Stéphane Freiss (born 22 November 1960) is a French film, television, and stage actor.  He won a César Award for his performance in the 1988 film Chouans!. \n\nSource: Article \"Stéphane Freiss\" from Wikipedia in english, licensed under CC-BY-SA 3. 0...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8Fc7grw4FGgrijipjaqY2ZlogJb.jpg", url:"https://themoviedb.org/person/40305"}}, {tmdbId:"72362", properties:{bornIn:" Denmark", imdbId:"0632890", born:date('1938-07-28'), name:"Claus Nissen", died:date('2008-04-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9yMWbJDrBIDnmSTYBC0si8d5MBv.jpg", url:"https://themoviedb.org/person/72362"}}, {tmdbId:"72363", properties:{imdbId:"0630919", name:"Majken Algren Nielsen", url:"https://themoviedb.org/person/72363"}}, {tmdbId:"72365", properties:{imdbId:"1339080", name:"Daniel Hernandez Rodriguez", url:"https://themoviedb.org/person/72365"}}, {tmdbId:"72366", properties:{imdbId:"0034267", name:"Jacqueline Arenal", url:"https://themoviedb.org/person/72366"}}, {tmdbId:"1286965", properties:{imdbId:"1996295", name:"Petr Ratimec", url:"https://themoviedb.org/person/1286965"}}, {tmdbId:"37296", properties:{bornIn:"Prague, Czechoslovakia", imdbId:"0525656", born:date('1969-01-21'), name:"Barbora Lukesová", bio:"Barbara Lukešová graduated from the State Conservatory in Prague.  After that she acted at the F.  X.  Šalda Theatre in Liberec and later with the Rokoko Theatre in Prague (1994-2001).  At the same time, she was performing at the Theatre in Celetna.  She also starred in various productions of the Rubín Theatre, National Theatre, Prague Municipal Theatres, Divadlo Komedie and the Theatre in Řeznická. \n\nShe starred in Brucio nel vento (It. ) which gained 5 wins and 16 nominations...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bjwSxzsB2VQe09t09otThYqHBOH.jpg", url:"https://themoviedb.org/person/37296"}}, {tmdbId:"1286966", properties:{bornIn:"London, England, UK", imdbId:"1391444", born:date('1995-05-03'), name:"Anna Rust", bio:"Anna Rust is an English actress, best known for her roles in Legends, Carnival Row, Ophelia and The Brothers Grimm...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gIOEv2tjYMFaZHtNPw9epru9Rwr.jpg", url:"https://themoviedb.org/person/1286966"}}, {tmdbId:"1286967", properties:{imdbId:"1984672", name:"Jeremy Robson", url:"https://themoviedb.org/person/1286967"}}, {tmdbId:"19197", properties:{bornIn:"Portland, Oregon, USA", imdbId:"1440281", born:date('1985-10-25'), name:"John Robinson", bio:"​From Wikipedia, the free encyclopedia.   \n\nJohn Robinson (born October 25, 1985) is an American actor.  He portrayed John McFarland in Gus Van Sant's Elephant and Stacy Peralta in the skateboarding film Lords of Dogtown. \n\nRobinson enjoys snowboarding and played lacrosse in high school.  He has also done some modeling.  He is a 2005 graduate of the Oregon Episcopal School. \n\nDescription above from the Wikipedia article John Robinson, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qoNT5AaBO3JRMzySItJB8AVGSkj.jpg", url:"https://themoviedb.org/person/19197"}}, {tmdbId:"15338", properties:{bornIn:"Louisville, Kentucky, USA", imdbId:"0544611", born:date('1965-04-17'), name:"William Mapother", bio:"From Wikipedia, the free encyclopedia. \n\nWilliam Reibert Mapother, Jr.  ( born April 17, 1965) is an American actor and former teacher, known for his role as Ethan Rom on the television series Lost...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pjBLAJUQFctPaYjCV7WQAnKKEec.jpg", url:"https://themoviedb.org/person/15338"}}, {tmdbId:"41464", properties:{bornIn:"New York City, New York, USA", imdbId:"1310709", born:date('1981-01-17'), name:"Scott Mechlowicz", bio:"From Wikipedia, the free encyclopedia\n\nScott David Mechlowicz (born January 17, 1981) is an American actor.  He began his professional acting career at age 20, working in commercials and television, and is best known for his lead roles in the films EuroTrip, Mean Creek, Peaceful Warrior, Gone, Waiting for Forever, Undocumented, and Cat Run. \n\nDescription above from the Wikipedia article Scott Mechlowicz, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sB4n9cmACxuFs5YFuLWVtp5uqEw.jpg", url:"https://themoviedb.org/person/41464"}}, {tmdbId:"54414", properties:{bornIn:"Weston - Connecticut - USA", imdbId:"0686009", born:date('1979-11-20'), name:"Jacob Pitts", bio:"Jacob Pitts (born November 20, 1979) is an actor.  His most notable performance was in the film EuroTrip as Cooper Harris.  He appeared in the play Where Do We Live at the Vineyard Theatre in May 2004.  Pitts has also appeared in popular TV shows such as Law & Order in 2000 where he played John Telford, Sex & The City (2000) where he played Sam Jones, and Ed where he played Johnny Malone.  Currently, Pitts has a reoccurring role on the FX television drama Justified as Tim Gutterson...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hSgGV6HNDk9GHObRkOGyFue0WUu.jpg", url:"https://themoviedb.org/person/54414"}}, {tmdbId:"55751", properties:{bornIn:"Vancouver, British Columbia, Canada", imdbId:"0471036", born:date('1982-12-30'), name:"Kristin Kreuk", bio:"Kristin Kreuk ( born December 30, 1982) is a Canadian actress known for role on Smallville.  She was also a regular cast member  of Edgemont, and has starred in movies such as Eurotrip and Street Fighter: The Legend of Chun-Li...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jQVGylAfotE7osIGwGivh6LpCdl.jpg", url:"https://themoviedb.org/person/55751"}}, {tmdbId:"57402", properties:{imdbId:"1537925", name:"Cathy Meils", url:"https://themoviedb.org/person/57402"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"62747", properties:{bornIn:" Buffalo, New York, USA", imdbId:"0614877", born:date('1981-08-24'), name:"Chad Michael Murray", bio:"Chad Michael Murray is an American actor.  Murray is well-known for portraying Lucas Scott on One Tree Hill, in addition to A Cinderella Story, Freaky Friday and House of Wax...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jIkzUQUVLkgn3HFMFRJBDAD0OLj.jpg", url:"https://themoviedb.org/person/62747"}}, {tmdbId:"59283", properties:{bornIn:"Marietta, Georgia, USA", imdbId:"0126004", born:date('1985-11-20'), name:"Dan Byrd", bio:"​From Wikipedia, the free encyclopedia.     Daniel \"Dan\" Byrd (born November 20, 1985) is an American actor.  His most prominent roles include the 2006 remake of The Hills Have Eyes, the CW original comedy series Aliens in America, A Cinderella Story alongside Hillary Duff, ABC's Cougar Town, and the 2010 movie Easy A.   Description above from the Wikipedia article Dan Byrd, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kUna0GNGKOjzIG7QhTYhvmAF57P.jpg", url:"https://themoviedb.org/person/59283"}}, {tmdbId:"63982", properties:{imdbId:"1468254", name:"Christopher Kovaleski", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/60aFL9dr7SSwHZkb73EsfPG1IBm.jpg", url:"https://themoviedb.org/person/63982"}}, {tmdbId:"53714", properties:{bornIn:"London, Ontario, Canada", imdbId:"1046097", born:date('1978-11-17'), name:"Rachel McAdams", bio:"Canadian actress Rachel McAdams was born on November 17, 1978 in London, Ontario.  Rachel’s parents Lance and Sandra encouraged her talent in performing arts at an early age when she started figure skating at 4, and later acting at 12.   Throughout her education Rachel starred in numerous student productions before ultimately earning her BFA in Theater at York University in 2001...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/TjuaAVJfcDCKVTeIHLbeCi7aIt.jpg", url:"https://themoviedb.org/person/53714"}}, {tmdbId:"11702", properties:{bornIn:"San Diego, California, USA", imdbId:"0111013", born:date('1979-12-15'), name:"Adam Brody", bio:"Adam Jared Brody (born December 15, 1979) is an American film and television actor, writer, producer, and musician, best known for his leading role as Seth Cohen on the television series \"The O. C. \", and many other supporting and leading roles in features films such as \"Mr.  & Mrs.  Smith\", \"Jennifer's Body\", \"Life Partners \", and \"Sleeping with Other People\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jeMhuu9Q81XJLIef1OU7NlcxRW0.jpg", url:"https://themoviedb.org/person/11702"}}, {tmdbId:"60715", properties:{bornIn:"Vancouver, Canada", imdbId:"0698977", born:date('1990-09-28'), name:"Kirsten Prout", bio:"Kirsten Zien née Prout was born in Vancouver, Canada.  Meeting with success at an early age, she worked locally in Vancouver, guest-starring on shows such as First Wave (1998), Stargate SG-1 (1997), Cold Squad (1998) and The Dead Zone (2002).  Her first sizable break in film came in 2005, when she landed the part of \"Abby Miller\", a young martial arts prodigy, alongside Jennifer Garner, in Elektra (2005)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eQZtLsjTxfQx8ikPCLXeWDzPUFd.jpg", url:"https://themoviedb.org/person/60715"}}, {tmdbId:"10884", properties:{bornIn:"Arlington County, Virginia, USA", imdbId:"0498449", born:date('1971-03-22'), name:"Will Yun Lee", bio:"From Wikipedia, the free encyclopedia\n\nWill Yun Lee (born March 22, 1971) is an Korean American actor. \n\nHe is best known for his roles on TNT's supernatural drama series Witchblade as Danny Woo and as Jae Kim on NBC's science fiction television drama Bionic Woman.  He also famously played villain Colonel Tan-Sun Moon as the main antagonist in the James Bond film Die Another Day...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uFEQ7JW5GFvRinOMPaVBn4epcar.jpg", url:"https://themoviedb.org/person/10884"}}, {tmdbId:"25933", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0221043", born:date('1976-10-11'), name:"Emily Deschanel", bio:"Emily Erin Deschanel (born October 11, 1976) is an American actress, director and producer.  She is best known for starring in the Fox crime procedural comedy-drama series Bones[2] as Dr.  Temperance Brennan from 2005 to 2017. \n\nDescription above from the Wikipedia article Emily Deschanel licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bS4F39NlQAURKtO5r1CD3ivSf62.jpg", url:"https://themoviedb.org/person/25933"}}, {tmdbId:"56436", properties:{imdbId:"0961436", born:date('1978-06-26'), name:"Tory Mussett", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iHpKABZhIZccTgb6QmBk0L0aEvG.jpg", url:"https://themoviedb.org/person/56436"}}, {tmdbId:"129193", properties:{bornIn:"San Fernando, California, USA", imdbId:"0000716", born:date('1962-06-19'), name:"Paula Abdul", bio:"From Wikipedia, the free encyclopedia\n\nPaula Abdul (born June 19, 1962) is an American singer, songwriter, dancer, choreographer, actress, and television personality.  She began her career as a cheerleader for the Los Angeles Lakers at the age of 18 and later became the head choreographer for the Laker Girls, where she was discovered by The Jacksons...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xSfAup9itIFIGx8ZfZrfmnrGeAy.jpg", url:"https://themoviedb.org/person/129193"}}, {tmdbId:"148111", properties:{imdbId:"0088520", born:date('1916-03-31'), name:"Lucille Bliss", died:date('2012-11-08'), url:"https://themoviedb.org/person/148111"}}, {tmdbId:"51330", properties:{bornIn:" Shreveport, Louisiana, USA", imdbId:"0103537", born:date('1948-09-02'), name:"Terry Bradshaw", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7NwCxth0lhyE9XCilpbPkdGmjva.jpg", url:"https://themoviedb.org/person/51330"}}, {tmdbId:"4494", properties:{bornIn:"Silver Spring, Maryland, USA", imdbId:"0910076", born:date('1963-08-03'), name:"Lisa Ann Walter", bio:"Lisa Ann Walter (born August 3, 1963) is an American actress, comedienne, writer and film producer.  She has appeared in such films as the 1998 version of The Parent Trap, Bruce Almighty, Shall We Dance, and War of the Worlds as Cheryl.  Walter also created and starred in the short-lived 1996-1997 sitcom, Life's Work.  She was a judge on ABC's reality television series The Next Best Thing: Who Is the Greatest Celebrity Impersonator?...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p3wxUblbPwRVzTp7jW1lXISKIob.jpg", url:"https://themoviedb.org/person/4494"}}, {tmdbId:"417", properties:{bornIn:"Memphis, Tennessee, USA", imdbId:"0329481", born:date('1978-05-22'), name:"Ginnifer Goodwin", bio:"Ginnifer Goodwin (born Jennifer Michelle Goodwin; May 22, 1978, height 5' 6\" (1,68 m)) is an American television and film actress, best known for her role as Margene Heffman on the HBO series Big Love and starring in the movies Mona Lisa Smile and He's Just Not That into You.  She stars as Mary Margaret Blanchard/Snow White in the ABC series Once Upon a Time. \n\nGoodwin was born in Memphis, Tennessee...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4MtHJTdCYiUyq6O9QZxgxrm0Uvf.jpg", url:"https://themoviedb.org/person/417"}}, {tmdbId:"1224676", properties:{imdbId:"1494947", name:"Andrew Chalmers", url:"https://themoviedb.org/person/1224676"}}, {tmdbId:"4442", properties:{bornIn:"Houston, Texas", imdbId:"0233079", born:date('1980-09-20'), name:"Ryan Donowho", bio:"From Wikipedia, the free encyclopedia. \n\nRyan Wayne Donowho (born September 20, 1980) is an American actor and musician. \n\nDescription above from the Wikipedia article Ryan Donowho, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bgOSrLTkszycQCVAbRbjr9BmWNs.jpg", url:"https://themoviedb.org/person/4442"}}, {tmdbId:"1233025", properties:{bornIn:"Toronto, Ontario,  Canada", imdbId:"0896621", born:date('1982-05-18'), name:"Asia Vieira", bio:"Asia Vieira was born on May 18, 1982 in Toronto, Ontario, Canada as Asia Molly Vieira.  She is an actress, known for A Home at the End of the World (2004), Are You Afraid of the Dark? (1990) and Omen IV: The Awakening (1991)...", url:"https://themoviedb.org/person/1233025"}}, {tmdbId:"184388", properties:{imdbId:"0358109", name:"Quancetia Hamilton", url:"https://themoviedb.org/person/184388"}}, {tmdbId:"41091", properties:{bornIn:"Canandaigua, New York, USA", imdbId:"1325419", born:date('1973-08-22'), name:"Kristen Wiig", bio:"Kristen Carroll Wiig (born August 22, 1973) is an American film and television actress.  She is best known for her work as a cast member on Saturday Night Live from 2005 to 2012.  Wiig is a member of improvisational comedy troupe The Groundlings, and has appeared in several films and television series, including MacGruber, Flight of the Conchords, Adventureland, Walk Hard: The Dewey Cox Story and Paul...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nwj7ibxkzYOYgcyGHCKV2qNwgxX.jpg", url:"https://themoviedb.org/person/41091"}}, {tmdbId:"1406450", properties:{bornIn:"Pittsburgh, Pennsylvania, USA", imdbId:"1789985", name:"Jon Daly", bio:"Jon Daly is an American actor and comedian...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v8lq3HUmdQk1t50DAP1vt3LcJJM.jpg", url:"https://themoviedb.org/person/1406450"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"1468059", properties:{imdbId:"1564915", name:"Jeremie Campbell", url:"https://themoviedb.org/person/1468059"}}, {tmdbId:"79416", properties:{imdbId:"0519486", name:"Robert Longstreet", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AbqhrHAPl0pwsVclcjZDC6GVwEG.jpg", url:"https://themoviedb.org/person/79416"}}, {tmdbId:"74587", properties:{imdbId:"0521761", name:"Terry Loughlin", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aFffejoARU5bkk6FbW5NXPlN6wQ.jpg", url:"https://themoviedb.org/person/74587"}}, {tmdbId:"230176", properties:{bornIn:"Philadelphia, Pennsylvania, USA ", imdbId:"1073992", born:date('1978-11-10'), name:"Eve", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4QvdUlsM4qchXMIwsbuc1GEnnVZ.jpg", url:"https://themoviedb.org/person/230176"}}, {tmdbId:"23119", properties:{bornIn:"Alexandria, Minnesota, USA", imdbId:"0470244", born:date('1965-08-12'), name:"Peter Krause", bio:"Peter William Krause (  born August 12, 1965) is an American film and television actor and film producer.  He is perhaps best known for his lead roles as Nate Fisher on Six Feet Under, Adam Braverman on Parenthood, and Casey McCall on Sports Night. \n\nDescription above from the Wikipedia article Peter Krause, licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4p42emuJrU8fFxbBuOhYFFdzmN6.jpg", url:"https://themoviedb.org/person/23119"}}, {tmdbId:"87773", properties:{bornIn:"Mangalore, Karnataka, India", imdbId:"0706787", born:date('1973-11-01'), name:"Aishwarya Rai Bachchan", bio:"Aishwarya Rai Bachchan is an Indian actress and former Miss World.  Before starting her acting career, she worked as a model and ultimately won the Miss World title in 1994.  Rai has acted in over 40 movies in Hindi, English, Tamil and Bengali, which include few international productions.  Often cited by the media as the most beautiful woman in the world, Rai made her movie debut in Mani Ratnam's Tamil film Iruvar (1997) and had her first commercial success in the Tamil movie Jeans (1998)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cfZ05qqCNoSUYmBwsb4cVzKM0YB.jpg", url:"https://themoviedb.org/person/87773"}}, {tmdbId:"72745", properties:{imdbId:"1318321", name:"Nadira Babbar", url:"https://themoviedb.org/person/72745"}}, {tmdbId:"18746", properties:{bornIn:"Saginaw, Michigan, USA", imdbId:"0005567", born:date('1950-05-13'), name:"Stevie Wonder", bio:"Stevland Hardaway Morris (previously Judkins; born May 13, 1950), better known by his stage name Stevie Wonder, is an American singer-songwriter, multi-instrumentalist, record producer and activist.  Blind since shortly after birth, Wonder signed with Motown Records' Tamla label at the age of eleven, and continues to perform and record for Motown to this day. \n\nAmong Wonder's best known works are singles such as \"Superstition\", \"Sir Duke\", \"I Wish\" and \"I Just Called to Say I Love You\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jC4NXYZYgiUfj3EH3iKWcIH5eZ5.jpg", url:"https://themoviedb.org/person/18746"}}, {tmdbId:"19011", properties:{bornIn:"New Haven, Connecticut, USA", imdbId:"0124133", born:date('1946-07-06'), name:"George W. Bush", bio:"George Walker Bush (born July 6, 1946) is an American politician who served as the 43rd President of the United States from 2001 to 2009.  Before that he was the 46th Governor of Texas, serving from 1995 to 2000.  Bush is the eldest son of President George H.  W.  Bush, who served as the 41st President, and Barbara Bush, making him one of only two American presidents to be the son of a preceding president, after John Quincy Adams.  He is also the brother of Jeb Bush, former Governor of Florida...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6u9fUB5p0ugbMrPoQ5GF7baERiA.jpg", url:"https://themoviedb.org/person/19011"}}, {tmdbId:"72451", properties:{bornIn:"Fukui Prefecture, Japan", imdbId:"1091312", born:date('1969-09-04'), name:"Yûta Sone", bio:"Actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ocOq3KEQEd1QfC2Ngov0HzR7mKg.jpg", url:"https://themoviedb.org/person/72451"}}, {tmdbId:"72452", properties:{bornIn:"Nagoya, Japan", imdbId:"0949052", born:date('1975-09-05'), name:"Kimika Yoshino", bio:"​From Wikipedia, the free encyclopedia\n\nKimika Yoshino  (born on September 5, 1975 in Nagoya, Japan) is a Japanese actress and gravure idol.  She won the award for Best Newcomer at the 5th Japanese Professional Movie Awards for Eko Eko Azarak: Wizard of Darkness. \n\nDescription above from the Wikipedia article Kimika Yoshino, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tMdoBgubOEDBeHXwZJKsdAHJVvw.jpg", url:"https://themoviedb.org/person/72452"}}, {tmdbId:"72453", properties:{imdbId:"0385846", name:"Shôhei Hino", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pPvR0AqMffrBHmYiKicZcCBKRIK.jpg", url:"https://themoviedb.org/person/72453"}}, {tmdbId:"21127", properties:{bornIn:"Union City, New Jersey, USA", imdbId:"0134072", born:date('1970-05-03'), name:"Bobby Cannavale", bio:"Robert M.  \"Bobby\" Cannavale (born May 3, 1970) is an American actor noted for his leading role as Bobby Caffey in the first two seasons of the critically acclaimed television series Third Watch.  He also had a popular recurring role as Officer Vince D'Angelo on the comedy series Will & Grace...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cRFl6UwshRgEzx04aOqETL5eVrh.jpg", url:"https://themoviedb.org/person/21127"}}, {tmdbId:"78730", properties:{bornIn:"Ottershaw, Surrey, England, UK", imdbId:"1268888", born:date('1980-06-01'), name:"Oliver James", bio:"From Wikipedia, the free encyclopedia.   Oliver James (born 1953) is a clinical psychologist, journalist, bestselling book author, and television documentary producer.  and presenter He also frequently broadcasts on radio and acts as a pundit on television.  He was an adviser to Jack Straw during his time at the Home Office and was part of the Tory Well-Being Commission. \n\nDescription above from the Wikipedia article Oliver James, licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yqfKdEexodXGzZZAPMw2CSpVMXq.jpg", url:"https://themoviedb.org/person/78730"}}, {tmdbId:"39556", properties:{imdbId:"1048128", born:date('1984-10-04'), name:"Dana Davis", bio:"From Wikipedia, the free encyclopedia.  Dana Davis (born October 4, 1984) is an American actress, most notable for playing Felicia Jones on the ABC TV series The Nine and Lisa Hines in 2008's Prom Night and Chastity Church on the ABC Family television series 10 Things I Hate About You. \n\nDescription above from the Wikipedia article Dana Davis, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jsMOVi4z2E2kvLS0j3Paxd0NJsk.jpg", url:"https://themoviedb.org/person/39556"}}, {tmdbId:"19119", properties:{bornIn:"Paris, France", imdbId:"0491259", born:date('1983-02-21'), name:"Mélanie Laurent", bio:"A French actress, singer, pianist, screenwriter, and director, perhaps best known to international audiences for her role in Inglourious Basterds (2009).  Laurent was born in Paris, the daughter of Annick, a ballerina, and Pierre Laurent, a voiceover actor.  Laurent is Jewish, and has both Ashkenazi and Tunisian Sephardic ancestry.  Her grandfather survived deportation by the Nazis.  Laurent had a long relationship with fellow French actor Julien Boisselier...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i99ogEo4gQyanCmHWYYoS6hsUqL.jpg", url:"https://themoviedb.org/person/19119"}}, {tmdbId:"27319", properties:{bornIn:"Vienna, Austria", imdbId:"0910607", born:date('1956-10-04'), name:"Christoph Waltz", bio:"Christoph Waltz (born 4 October 1956) is an Austrian actor who also holds German citizenship.  He received international acclaim for his portrayal of SS Colonel Hans Landa in the 2009 film Inglourious Basterds, for which he won the Best Actor Award at the Cannes Film Festival and the BAFTA, Golden Globe and Screen Actors Guild Award for Best Supporting Actor in 2009 and the Academy Award for Best Supporting Actor in 2010...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2Hhztd4mUEV9Y25rfkXDwzL9QI9.jpg", url:"https://themoviedb.org/person/27319"}}, {tmdbId:"36900", properties:{imdbId:"0788767", name:"John Sharian", bio:"From Wikipedia, the free encyclopedia\n\nJohn Sharian is an American actor whose film credits include The Machinist and Saving Private Ryan and whose television credits include CSI: Miami and Spooks...", url:"https://themoviedb.org/person/36900"}}, {tmdbId:"80541", properties:{bornIn:"USA", imdbId:"0264506", born:date('1972-05-12'), name:"Matthew Faber", died:date('2020-03-28'), url:"https://themoviedb.org/person/80541"}}, {tmdbId:"80542", properties:{imdbId:"0682922", born:date('1969-09-28'), name:"Angela Pietropinto", bio:"Angela Pietropinto is an actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1gUgveREGrACTsuvRdJreH68b8Y.jpg", url:"https://themoviedb.org/person/80542"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"76764", properties:{bornIn:"Taipai - Taiwan", imdbId:"0119144", born:date('1952-09-21'), name:"Bill Buell", url:"https://themoviedb.org/person/76764"}}, {tmdbId:"80543", properties:{imdbId:"1896997", name:"Emani Sledge", url:"https://themoviedb.org/person/80543"}}, {tmdbId:"111830", properties:{bornIn:"New York, USA", imdbId:"0088502", born:date('1975-10-23'), name:"Boti Bliss", bio:"Boti Ann Bliss (born October 23, 1975) is an American film and television actress.  Notable roles include her semi-recurring role as Maxine Valera in the television crime drama CSI: Miami.  Her other roles include the 2002 film Ted Bundy and 2003 film National Lampoon Presents Dorm Daze. \n\nBorn in Aspen, Colorado, she had an unusual childhood growing up, along with her brother and three sisters, in a teepee outside of Aspen with her stepfather and her mother, who knitted and sold custom sweaters...", url:"https://themoviedb.org/person/111830"}}, {tmdbId:"63463", properties:{imdbId:"1382330", born:date('1979-11-29'), name:"Gable Carr", url:"https://themoviedb.org/person/63463"}}, {tmdbId:"63464", properties:{imdbId:"0146941", name:"Patrick Cavanaugh", bio:"​From Wikipedia, the free encyclopedia.   \n\nPatrick Cavanaugh is an American television actor. \n\nDescription above from the Wikipedia article Patrick Cavanaugh, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5SCHkIGBfmc2aeFE1kKtWZ6mxBx.jpg", url:"https://themoviedb.org/person/63464"}}, {tmdbId:"69303", properties:{bornIn:"New York", imdbId:"0070541", born:date('1970-03-04'), name:"Andrea Bendewald", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hhfJSPYR0rimiSjYGG8VBKGpMA7.jpg", url:"https://themoviedb.org/person/69303"}}, {tmdbId:"8796", properties:{bornIn:"Berlin, Germany", imdbId:"0559890", born:date('1959-05-09'), name:"Ulrich Matthes", bio:"Ulrich Matthes was born in Berlin.  He studied acting in the early 1980's in Berlin under Else Bongers.  Ulrich Matthes studied German and English, because he really wanted to become a teacher, so he also took private acting lessons during his studies.  His first engagement brought him to the Vereinigte Bühnen in Krefeld, where he played the title role in \"Prinz Friedrich von Homburg\"...", url:"https://themoviedb.org/person/8796"}}, {tmdbId:"28637", properties:{bornIn:"Grand Rapids, Michigan, USA ", imdbId:"0725200", born:date('1966-10-28'), name:"Andy Richter", bio:"Andy Richter  (born October 28, 1966) is an American actor, writer, comedian, and late night talk show announcer.  He is best known for his appearances on Late Night with Conan O'Brien, The Tonight Show with Conan O'Brien, and Conan.  He is also known for his work in the Madagascar films and for starring on Quintuplets, Andy Richter Controls the Universe, and Andy Barker, PI...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qazhLkyKOsPmdOQSaUWWbbUjs9q.jpg", url:"https://themoviedb.org/person/28637"}}, {tmdbId:"141677", properties:{bornIn:"Sabaneta, Venezuela", born:date('1954-07-28'), name:"Hugo Chávez", bio:"Hugo Rafael Chávez Frías (born July 28, 1954) was the 56th President of Venezuela, having held that position since 1999 until the time of his dead in 2013...", died:date('2013-03-05'), url:"https://themoviedb.org/person/141677"}}, {tmdbId:"2578850", properties:{name:"Pedro Carmona", url:"https://themoviedb.org/person/2578850"}}, {tmdbId:"110380", properties:{bornIn:"New York City, New York, USA", imdbId:"0694068", born:date('1937-04-05'), name:"Colin Powell", url:"https://themoviedb.org/person/110380"}}, {tmdbId:"19062", properties:{bornIn:"Valenciennes, Hauts-de-France, France", imdbId:"0239816", born:date('1938-11-29'), name:"Michel Duchaussoy", bio:"Michel René Jacques Duchaussoy (29 November 1938 – 13 March 2012) was a French film actor, who appeared in more than 130 films between 1962 and 2012.  At first a theater actor, he worked for many years in the Comédie Française, where he started his career in 1964. \n\nDuchaussoy performed in many French classic plays including those by Molière, Marivaux, Corneille and Ionesco.  He received the prestigious Molière award for best supporting actor in 2003...", died:date('2012-03-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5HuD9Y3hYUKgfomk93DMRS4G4pT.jpg", url:"https://themoviedb.org/person/19062"}}, {tmdbId:"19195", properties:{bornIn:"Portland, Oregon, USA", imdbId:"1372713", born:date('1987-02-17'), name:"Alex Frost", bio:"​From Wikipedia, the free encyclopedia. \n\nAlex 'Frosty' Frost  (born February 17, 1987) is an American actor. \n\nFrost was born in Portland, Oregon.  His parents are Debbie and Jack, and he has an older brother named Chris.  Frost is currently living in London. \n\nFrost had a starring role in Gus Van Sant's Columbine-based film Elephant, which was awarded the Palme d'Or prize in 2003.  Since Elephant, Alex has worked on a number of films, including The Queen of Cactus Cove, The Lost and The Standard...", url:"https://themoviedb.org/person/19195"}}, {tmdbId:"19196", properties:{bornIn:"Vancouver, Washington, USA", imdbId:"1370494", born:date('1986-07-17'), name:"Eric Deulen", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/RTQxsBDOMbCxLth6va6mZPifVn.jpg", url:"https://themoviedb.org/person/19196"}}, {tmdbId:"19198", properties:{bornIn:" Portland, Oregon, USA", imdbId:"1371432", name:"Elias McConnell", bio:"From Wikipedia, the free encyclopedia. \n\nElias Comfort McConnell (born 1985) is an American actor from Portland, Oregon.  He has performed on Gus Van Sant's Columbine-based film Elephant, which was awarded the Palme d'Or prize in 2003.  Since Elephant, Elias has worked on Paris, je t'aime (2006) as Elie (segment \"Le Marais\") directed by Gus Van Sant, and in House of Boys as Hippie Boy, by Jean-Claude Schlim. \n\nElias enjoys photography, writing, and singing/song writing...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mhNjZYrsOg9mXlm8267Gnt5m0rh.jpg", url:"https://themoviedb.org/person/19198"}}, {tmdbId:"5526", properties:{bornIn:"Ilkley, West Yorkshire, England, UK", imdbId:"1670137", born:date('1995-07-09'), name:"Georgie Henley", bio:"Georgina Helen \"Georgie\" Henley (born 9 July 1995) is an English teen actress.  She is known for her portrayal of Lucy Pevensie in The Chronicles of Narnia film series, for which she won the Phoenix Film Critics Society Award for Best Performance by a Youth Female in a Lead or Supporting Role in The Lion, the Witch and the Wardrobe in 2005. \n\nDescription above from the Wikipedia article Georgie Henley, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dW7ZQfrm2A4rVtZrIPbWOUXNvsJ.jpg", url:"https://themoviedb.org/person/5526"}}, {tmdbId:"5527", properties:{bornIn:"Camden, London, England, UK", imdbId:"1342727", born:date('1991-09-05'), name:"Skandar Keynes", bio:"From Wikipedia, the free encyclopedia.  Skandar Keynes (born Alexander Amin Casper Keynes; 5 September 1991) is a British actor.  He is best known for starring as Edmund Pevensie in The Chronicles of Narnia film series.  He has appeared in all three installments, The Lion, the Witch and the Wardrobe, Prince Caspian and The Voyage of the Dawn Treader, which was released on December 10, 2010...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l4Vv4UnOI4WWckFm39nLCXB3p5w.jpg", url:"https://themoviedb.org/person/5527"}}, {tmdbId:"5528", properties:{bornIn:"Sheepscombe - Gloucestershire - England - UK", imdbId:"0608440", born:date('1987-04-27'), name:"William Moseley", bio:"William Peter Moseley was born on April 27, 1987, in Gloucester, England, to Peter Moseley and Julie Fleming.  He is the eldest of three children with a younger sister named Daisy and and younger brother named Ben.  His father's name is also William's middle name...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wPahfIdOR6ohIgmgVrCb3RPApAU.jpg", url:"https://themoviedb.org/person/5528"}}, {tmdbId:"5529", properties:{bornIn:"London,  England", imdbId:"0691600", born:date('1988-12-16'), name:"Anna Popplewell", bio:"Anna Katherine Popplewell (born 16 December 1988) is an English film, television and theater actress.  She is known for her role as Susan Pevensie in The Chronicles of Narnia film series since 2005, as Chyler Silva in Halo 4: Forward Unto Dawn since 2012 and Lady Lola in Reign since 2013...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7GXEPxNCbc6EtnulCEPWnEvKJIN.jpg", url:"https://themoviedb.org/person/5529"}}, {tmdbId:"67318", properties:{bornIn:"Hiroshima, Hiroshima Prefecture, Japan", imdbId:"0645648", born:date('1979-08-06'), name:"Megumi Okina", bio:"​From Wikipedia, the free encyclopedia. \n\nMegumi Okina  (born 6 August 1979) is a Japanese actress, and J-Pop singer in the 1990s.  Born in Hiroshima and raised in Tokyo, she made her J-Pop debut on 19 August 1995.  She starred in the Japanese original of The Grudge.  She married Susumu Fujita in January 2004, however they divorced on 22 July 2005.  Megumi's latest movie was a remake of a 2004 Thai film, \"Shutter\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/epZqncu57Zdq2RwVyrttQvy6ptN.jpg", url:"https://themoviedb.org/person/67318"}}] AS row
