UNWIND [{tmdbId:"17225", properties:{bornIn:"Anchorage, Alaska, USA", imdbId:"0001400", born:date('1965-09-09'), name:"Michelle Johnson", bio:"Michelle Johnson (born September 9, 1965) is an American actress, probably best known for her role in Blame It on Rio. \n\nDescription above from the Wikipedia Michelle Johnson (actress), licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/17225"}}, {tmdbId:"20211", properties:{bornIn:"Davenport, Iowa, U.S.", imdbId:"0315288", born:date('1946-10-15'), name:"John Getz", bio:"​John Getz is a stage-trained American actor.  Getz dropped out of college to attend the American Conservatory Theater in San Francisco.  While working in a winery, he helped found the Theater Company in Napa County, California.  His location in the grape-growing Napa Valley led to Getz's television debut in a made-for-television horror film Killer Bees.  Killer Bees starred Gloria Swanson, Craig Stevens, Kate Jackson, and Edward Albert...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9Ikx6ZzScbmDi2SNyaa0db4MMqL.jpg", url:"https://themoviedb.org/person/20211"}}, {tmdbId:"3910", properties:{bornIn:"Chicago, Illinois, USA ", imdbId:"0000531", born:date('1957-06-23'), name:"Frances McDormand", bio:"An American film, stage and television actress.  McDormand began her career on stage and made her screen debut in the 1984 film Blood Simple, having since appeared in several theatrical and television roles...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AskZbUslI8HkkbdmwyAXHjmQqPg.jpg", url:"https://themoviedb.org/person/3910"}}, {tmdbId:"6486", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0000445", born:date('1940-07-24'), name:"Dan Hedaya", bio:"An American character actor.  He often plays sleazy villains or uptight, wisecracking individuals; two of his best-known roles are as a cuckolded husband in the Coen brothers' crime thriller Blood Simple, and the scheming Nick Tortelli on the sitcom Cheers...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/evL3mV8hNIjZOb1XG3qtgmiTgS5.jpg", url:"https://themoviedb.org/person/6486"}}, {tmdbId:"588", properties:{bornIn:"Ogdensburg, New York, USA", imdbId:"0001826", born:date('1935-03-22'), name:"M. Emmet Walsh", bio:"M.  Emmet Walsh (born March 22, 1935) is an American actor who has appeared in over 100 film and television productions...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cirz2AGsQgh34yMoMaEmttAq0qS.jpg", url:"https://themoviedb.org/person/588"}}, {tmdbId:"62893", properties:{bornIn:"Eugene, Oregon, USA", imdbId:"0913738", born:date('1954-03-15'), name:"Craig Wasson", bio:"From Wikipedia, the free encyclopedia. \n\nCraig Wasson (born March 15, 1954) is an American actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h1ZOrefSzceANV4jGTjvN9V0CFj.jpg", url:"https://themoviedb.org/person/62893"}}, {tmdbId:"29369", properties:{bornIn:"Manhattan, New York City, New York, USA", imdbId:"0000429", born:date('1957-08-09'), name:"Melanie Griffith", bio:"Melanie Richards Griffith (born August 9, 1957) is an American actress.  She began her career in the 1970s, appearing in several independent thriller films before achieving mainstream success in the mid-1980s. \n\nBorn in New York City to actress Tippi Hedren and advertising executive Peter Griffith, she was raised mainly in Los Angeles, where she graduated from the Hollywood Professional School at age 16...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yffPcqlZMsXTCAZ84a1tLmdcIS6.jpg", url:"https://themoviedb.org/person/29369"}}, {tmdbId:"2518", properties:{bornIn:"Lakewood, Colorado, USA", imdbId:"0001344", born:date('1952-05-06'), name:"Gregg Henry", bio:"From Wikipedia, the free encyclopedia. \n\nGregg Lee Henry (born May 6, 1952) is an American theatre, film and television character actor and rock, blues and country musician...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e7hJgLDoNk6I2Xb4OQzJ4ohnI5e.jpg", url:"https://themoviedb.org/person/2518"}}, {tmdbId:"39574", properties:{bornIn:"Norfolk, Virginia, USA", imdbId:"0001730", born:date('1948-11-21'), name:"Deborah Shelton", bio:"From Wikipedia, the free encyclopedia. \n\nDeborah 'Debbie' Shelton (born November 21, 1948) is an American beauty queen and actress who held the Miss USA title and appeared on Dallas for three seasons...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8Dhd2Yrl1DsRyYKpSeYIN5p1xCF.jpg", url:"https://themoviedb.org/person/39574"}}, {tmdbId:"81895", properties:{bornIn:"Hutchinson, Kansas, USA", imdbId:"0225466", born:date('1960-08-14'), name:"Lucinda Dickey", bio:"Lucinda Dickey is an American dancer and actress who is best known for her role as Kelly in the 1984 cult film Breakin' and the sequel, Breakin' 2: Electric Boogaloo, which was released the same year. \n\nDescription above from the Wikipedia article Lucinda Dickey, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hZGNDZfmie8PGwS4yu3KfEiNgt9.jpg", url:"https://themoviedb.org/person/81895"}}, {tmdbId:"81896", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0704044", born:date('1955-05-11'), name:"Adolfo Quinones", bio:"From Wikipedia, the free encyclopedia.  Shabba Doo is the stage name of Adolfo Quiñones (born May 11, 1955), an American actor, dancer, choreographer, and director.  He became one of the founders of the dance style commonly known as locking as a member of The Original Lockers with Toni Basil, Don \"Campbellock\" Campbell and Fred \"Rerun\" Berry.  Quiñones' most well known role was the role of Ozone in the 1984 hit cult film, Breakin' and its sequel, Breakin' 2: Electric Boogaloo...", url:"https://themoviedb.org/person/81896"}}, {tmdbId:"57392", properties:{bornIn:"Long Beach, California", imdbId:"0150401", born:date('1967-11-13'), name:"Michael Chambers", bio:"Michael \"Boogaloo Shrimp\" Chambers (born November 13, 1967) is an American dancer and actor known for his role as \"Turbo\" in the 1984 cult classic film Breakin' and the 1984 hit sequel Breakin' 2: Electric Boogaloo.  In both movies he is credited as Boogaloo Shrimp, a name that remains inextricably linked to the Hollywood phase of popping, boogaloo and robot dancingalso the freestyle art of b-boying...", url:"https://themoviedb.org/person/57392"}}, {tmdbId:"128128", properties:{imdbId:"0518091", name:"Ben Lokey", bio:"Ben Lokey is known for his work on Breakin' (1984), Staying Alive (1983) and Captain EO(1986)...", url:"https://themoviedb.org/person/128128"}}, {tmdbId:"81897", properties:{bornIn:"Sussex, England, UK", imdbId:"0168736", born:date('1953-12-07'), name:"Susie Coelho", bio:"Susie Coelho was born on December 7, 1953 in Sussex, England as Susan Coelho.  She is known for her work on Breakin' 2: Electric Boogaloo (1984), Theodore Rex (1995) and The Norseman (1978).  She is married to Bobby.  They have two children.  She was previously married to Sonny Bono...", url:"https://themoviedb.org/person/81897"}}, {tmdbId:"73591", properties:{imdbId:"0287173", born:date('1938-06-14'), name:"Nick Apollo Forte", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vIW1xluYIy5eCL7Px9x95Ziw7lf.jpg", url:"https://themoviedb.org/person/73591"}}, {tmdbId:"3977", properties:{bornIn:"New York City, New York, USA", imdbId:"0608012", born:date('1947-10-18'), name:"Joe Morton", bio:"Joe Morton is an American stage, television, and film actor.  He is best known for his Emmy awarded role as Eli Pope in the television series Scandal, and for playing Reverend Arthur Finer on God Friended Me.  Morton studied Drama at Hofstra University, Hempstead, New York...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w7rGWWSGKWWukojLbZOQJ5yh9jv.jpg", url:"https://themoviedb.org/person/3977"}}, {tmdbId:"96536", properties:{bornIn:"Rolle Town, Bahamas", imdbId:"0141915", born:date('1918-09-29'), name:"Rosanna Carter", bio:"From Wikipedia, the free encyclopedia. \n\nRosanna Carter was an American television, stage and film actress, of Bahamian extraction, and the sister of Esther Rolle and Estelle Evans.  She was born in Florida.  During the Harlem Renaissance, she acted at New Lafayette Theater as one of the Lafayette Players.  She acted in The Brother from Another Planet, a well-reviewed 1984 film described as a science fiction fairy tale with a slavery plot...", died:date('2016-12-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mSXWBImcbZ4DwtZ0kUSVJ2KePoT.jpg", url:"https://themoviedb.org/person/96536"}}, {tmdbId:"74839", properties:{bornIn:"New York City, New York, USA", imdbId:"0708363", born:date('1939-02-01'), name:"Ray Ramirez", url:"https://themoviedb.org/person/74839"}}, {tmdbId:"96537", properties:{imdbId:"0719422", name:"Yves Rene", url:"https://themoviedb.org/person/96537"}}, {tmdbId:"90519", properties:{bornIn:"Grand Rapids - Michigan - USA", imdbId:"0193061", born:date('1948-10-22'), name:"Christopher Curry", bio:"Christopher Curry is an actor and writer...", url:"https://themoviedb.org/person/90519"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"387", properties:{bornIn:"Stamford, Connecticut, U.S.", imdbId:"0002114", born:date('1958-05-12'), name:"Kim Greist", bio:"Kimberley Greist (born May 12, 1958) is an American actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zYMORBHyCcXbbchiKGhhrnJyoix.jpg", url:"https://themoviedb.org/person/387"}}, {tmdbId:"55432", properties:{bornIn:"Toledo, Ohio, USA", imdbId:"0268026", born:date('1934-07-01'), name:"Jamie Farr", bio:"From Wikipedia, the free encyclopedia. \n\nJamie Farr (born July 1, 1934) is an American television, film, and theater actor.  He is best known for having played the role of cross-dressing Corporal (later Sergeant) Maxwell Q.  Klinger in the television sitcom M*A*S*H. \n\nDescription above from the Wikipedia article Jamie Farr, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xSPRPFrlz8VQ9n8HVaJWOsTK7pH.jpg", url:"https://themoviedb.org/person/55432"}}, {tmdbId:"87152", properties:{imdbId:"0159081", born:date('1948-02-01'), name:"Shelby Chong", bio:"From Wikipedia, the free encyclopedia. \n\nShelby Chong, née Fiddis, (born 1 February 1948), is a comedian, American motion picture producer and actress.  She was the executive producer of 2003's Best Buds and associate producer of Cheech & Chong's The Corsican Brothers (1984), Still Smokin' (1983), Things Are Tough All Over (1982), and Nice Dreams (1981).  Her notable acting roles include \"Nancy Reynolds\" in 1993's Sandman. \n\nChong is the wife of actor and comedian Tommy Chong...", url:"https://themoviedb.org/person/87152"}}, {tmdbId:"2713", properties:{bornIn:"Salisbury, Maryland, USA", imdbId:"0000157", born:date('1956-09-26'), name:"Linda Hamilton", bio:"An American actress best known for role as Sarah Connor in The Terminator and Terminator 2: Judgment Day; and for her television work as Catherine Chandler in the television series Beauty and the Beast, for which she was nominated for two Golden Globes and an Emmy.  She also had a recurring role in the comedy television series Weeds and Chuck...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zRQSWGCmVkYC7s0WxSJla5R4dPX.jpg", url:"https://themoviedb.org/person/2713"}}, {tmdbId:"66986", properties:{bornIn:"Blue Island, Illinois, USA", imdbId:"0291463", born:date('1959-06-16'), name:"John Franklin", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d6XCwhIliatNtamJC6Ja37xDvPr.jpg", url:"https://themoviedb.org/person/66986"}}, {tmdbId:"5274", properties:{bornIn:"Brussels - Belgium", imdbId:"0000872", born:date('1938-12-06'), name:"Patrick Bauchau", bio:"From Wikipedia, the free encyclopedia. \n\nPatrick Nicolas Jean Sixte Ghislain Bauchau (born 6 December 1938) is a Belgian actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/y2wLdxJi0TCoQeFtSyi2CXr0K7U.jpg", url:"https://themoviedb.org/person/5274"}}, {tmdbId:"104795", properties:{bornIn:" Glasgow, Scotland, UK", imdbId:"0665473", born:date('1945-06-03'), name:"Bill Paterson", bio:"From Wikipedia, the free encyclopedia\n\nBill Paterson (born 3 June 1945) is a Scottish stage, film and television actor. \n\nDescription above from the Wikipedia article Bill Paterson (actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2DNKMccHsWKUjle0yOLmbQKWIQH.jpg", url:"https://themoviedb.org/person/104795"}}, {tmdbId:"2451", properties:{bornIn:"Glasgow, Scotland, UK", imdbId:"0636156", born:date('1950-01-27'), name:"Alex Norton", bio:"Alex Norton is a Scottish television, film and voice actor.  He is perhaps best known for his roles as DCI Matt Burke in the STV detective drama series Taggart, and Eric Baird in BBC Two sitcom Two Doors Down.  He played eleven roles in Bill Douglas' 1986 film Comrades and has starred in the key films of Bill Forsyth (Gregory's Girl, Local Hero and Comfort and Joy) as well as big Hollywood productions like Braveheart,  White Hunter Black Heart and Patriot Games...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fnP1fFkqoIhOohylSrkfnFyMOuC.jpg", url:"https://themoviedb.org/person/2451"}}, {tmdbId:"10661", properties:{bornIn:"Spanish Town, Jamaica", imdbId:"0005063", born:date('1948-05-19'), name:"Grace Jones", bio:"​Grace Jones was born in Spanish Town, Jamaica, the daughter of Marjorie and Robert W.  Jones, who was a politician and Apostolic clergyman.  Her parents took Grace and her brother Chris and relocated to Syracuse, New York, in 1965.  Before becoming a successful model in New York City and Paris, Jones studied theatre at Onondaga Community College...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cnBOMcKiFRtZWQDojNUmmzn750D.jpg", url:"https://themoviedb.org/person/10661"}}, {tmdbId:"58181", properties:{bornIn:"Philadelphia, Pennsylvania, USA ", imdbId:"0150219", born:date('1936-08-21'), name:"Wilt Chamberlain", bio:"Wilton Norman Chamberlain  was an American basketball player who played as a center and is considered one of the greatest players in history...", died:date('1999-10-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7rbSh29n6TC5Hor7zomO5V8xPnl.jpg", url:"https://themoviedb.org/person/58181"}}, {tmdbId:"66804", properties:{bornIn:"New York City, New York, USA", imdbId:"0002138", born:date('1946-02-14'), name:"Gregory Hines", bio:"Gregory Hines (1946–2003) was an American actor, singer, dancer and choreographer...", died:date('2003-08-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kzjnrKpefPSMw5LYwDJtS6kLKFV.jpg", url:"https://themoviedb.org/person/66804"}}, {tmdbId:"62127", properties:{bornIn:"Detroit, Michigan", imdbId:"0571188", born:date('1954-07-22'), name:"Lonette McKee", bio:"From Wikipedia, the free encyclopedia\n\nLonette McKee (born July 22, 1954) is an American film and television actress, music composer/producer/songwriter, screenwriter and director. \n\nDescription above from the Wikipedia article Lonette McKee, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/62127"}}, {tmdbId:"2454", properties:{bornIn:"Washington, D.C.,  United States", imdbId:"0164273", born:date('1936-11-25'), name:"Matt Clark", bio:"​From Wikipedia, the free encyclopedia\n\nMatt Clark (born November 25, 1936) is an American actor and director with credits in both film and television.  Clark has played diverse character roles in Westerns, comedies, and dramas. \n\nClark was born in Washington D. C. , the son of Theresa (née Castello), a teacher, and Frederick William Clark, a carpenter.  Clark grew up in Conyers, Georgia.  After serving in the military, he attended college at George Washington University, but later dropped out...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n5TJz5CaTqRXLpAOl0wHJXrPQOk.jpg", url:"https://themoviedb.org/person/2454"}}, {tmdbId:"52374", properties:{bornIn:"Philadelphia, Pennsylvania, USA ", imdbId:"0001117", born:date('1946-06-28'), name:"Bruce Davison", bio:"​From Wikipedia, the free encyclopedia.   \n\nBruce Davison (born June 28, 1946) is an American actor and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uPHdmfGT2madX9nxIXoMCGoVJC.jpg", url:"https://themoviedb.org/person/52374"}}, {tmdbId:"165233", properties:{bornIn:"Sherman Oaks, California, USA", imdbId:"0402460", born:date('1929-04-26'), name:"Gordon Hunt", url:"https://themoviedb.org/person/165233"}}, {tmdbId:"59220", properties:{bornIn:"Red Bank, New Jersey, USA", imdbId:"0314767", born:date('1953-12-21'), name:"Dan Gerrity", died:date('2013-11-20'), url:"https://themoviedb.org/person/59220"}}, {tmdbId:"158360", properties:{imdbId:"0953051", born:date('1959-11-22'), name:"Lenore Zann", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oTOXQIyPqj0TgdTGalixnn5gsu7.jpg", url:"https://themoviedb.org/person/158360"}}, {tmdbId:"7868", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0001999", born:date('1949-07-27'), name:"Maury Chaykin", bio:"Was an American-born Canadian actor.  Best known for his portrayal of detective Nero Wolfe, he was also known for his work as a character actor in many films and on television programs. \n\nDescription above from the Wikipedia article Maury Chaykin, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2010-07-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/izV5zv2jTRBfGjvDWTniWPrma1t.jpg", url:"https://themoviedb.org/person/7868"}}, {tmdbId:"194370", properties:{imdbId:"0454957", name:"Kevin King", url:"https://themoviedb.org/person/194370"}}, {tmdbId:"1102280", properties:{imdbId:"0156801", name:"Kim Chew", url:"https://themoviedb.org/person/1102280"}}] AS row
