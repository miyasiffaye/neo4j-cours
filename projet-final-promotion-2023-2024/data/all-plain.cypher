UNWIND [{tmdbId:"32392", properties:{imdbId:"0409481", born:date('1947-01-03'), name:"Steve Inwood", url:"https://themoviedb.org/person/32392"}}, {tmdbId:"2248", properties:{bornIn:"New York City, New York, United States", imdbId:"0942646", born:date('1956-04-30'), name:"Michael Wright", bio:"Michael Wright (born April 6, 1956) is an American film and television actor, who is best known for his role as Eddie Kane, Jr.  in the 1991 Robert Townsend film The Five Heartbeats.  Wright's body of work in television includes the 1983 NBC science fiction miniseries V, the 1984 sequel \"V: The Final Battle\" and on \"V: The Series\" as Elias Taylor, TV series \"Miami Vice\" 1987 episode \"The Savage\", and on the 1997 HBO series Oz as Omar White from 2001-2003...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zWatoTgF4je4BWfIMPhjInSRAp.jpg", url:"https://themoviedb.org/person/2248"}}, {tmdbId:"58563", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"0004979", born:date('1955-06-30'), name:"David Alan Grier", bio:"David Alan Grier is an American comedian and film and television actor, best known for his work on the sketch comedy television show \"In Living Color\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2xs9NuHWIm8ML8SF5o2W6UAMoZd.jpg", url:"https://themoviedb.org/person/58563"}}, {tmdbId:"1067", properties:{bornIn:"San Mateo, California, U.S.", imdbId:"0566013", born:date('1957-03-31'), name:"Marc McClure", bio:"​From Wikipedia, the free encyclopedia.   \n\nMarc A.  McClure (born March 31, 1957) is an American actor.  McClure was born in San Mateo, California. \n\nDescription above from the Wikipedia article Marc McClure, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c8DFehNqNEDLBALTdAWZzUEN2tD.jpg", url:"https://themoviedb.org/person/1067"}}, {tmdbId:"93800", properties:{bornIn:"Danville, Illinois, USA", imdbId:"0906535", born:date('1938-03-05'), name:"James Wainwright", died:date('1999-12-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wnNqUlURXiMu4MLZ1CDUSZIdJqq.jpg", url:"https://themoviedb.org/person/93800"}}, {tmdbId:"52462", properties:{bornIn:"Big Spring, Texas, U.S.", imdbId:"0000990", born:date('1947-07-03'), name:"Betty Buckley", bio:"An American theater, film and television actress and singer. \n\nDescription above from the Wikipedia article Betty Buckley, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vgEah6IHjirZGXjuGhTA1Wp9aQT.jpg", url:"https://themoviedb.org/person/52462"}}, {tmdbId:"112693", properties:{bornIn:"Malibu, California, USA", imdbId:"0952365", born:date('1969-11-08'), name:"Roxana Zal", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vO1ZAdwQ5ihzTEAwbLzMQd3cCGE.jpg", url:"https://themoviedb.org/person/112693"}}, {tmdbId:"2496513", properties:{name:"Maurice Woods", url:"https://themoviedb.org/person/2496513"}}, {tmdbId:"2496514", properties:{name:"Richard D. Fisher Jr.", url:"https://themoviedb.org/person/2496514"}}, {tmdbId:"62033", properties:{imdbId:"0569789", born:date('1935-04-13'), name:"Doug McGrath", url:"https://themoviedb.org/person/62033"}}, {tmdbId:"61144", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0114487", born:date('1948-04-29'), name:"Reb Brown", bio:"​From Wikipedia, the free encyclopedia.   \n\nReb Brown (born Robert Brown; April 29, 1948) is an American actor. \n\nDescription above from the Wikipedia article Reb Brown, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qffYtpWE8PmbTpLlEuhh2YUG7Gl.jpg", url:"https://themoviedb.org/person/61144"}}, {tmdbId:"2963", properties:{bornIn:"Long Beach, California, USA", imdbId:"0000115", born:date('1964-01-07'), name:"Nicolas Cage", bio:"An American actor, producer and director.  He has performed in leading roles in a variety of films, ranging from romantic comedies and dramas to science fiction and action movies.  Cage is known for his prolificacy, appearing in at least one film per year, nearly every year since 1980 (with the exception of 1985 and 1991)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ar33qcWbEgREn07ZpXv5Pbj8hbM.jpg", url:"https://themoviedb.org/person/2963"}}, {tmdbId:"79741", properties:{bornIn:"Montebello, California, USA", imdbId:"0286033", born:date('1962-10-12'), name:"Deborah Foreman", bio:"Deborah Lynn Foreman (born October 12, 1962) is an American actress.  She is perhaps best known for her starring role in the 1983 movie Valley Girl, as \"Julie Richman\" acting opposite Nicolas Cage as \"Randy\". \n\nDescription above from the Wikipedia Deborah Foreman, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ue2dsTI4XAoT3dSNgpamYgi7Jeh.jpg", url:"https://themoviedb.org/person/79741"}}, {tmdbId:"15274", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0197354", born:date('1961-09-11'), name:"Elizabeth Daily", bio:"From Wikipedia, the free encyclopedia. \n\nElizabeth Ann Guttman (born September 11, 1961),  better known by her stage names of Elizabeth Daily and E. G.  Daily, is an American voice actress, actress, singer, songwriter, and musician.  She voices Tommy Pickles in Rugrats and its spinoff All Grown Up!, Buttercup in The Powerpuff Girls, Steve from Curious George and Waffle from Catscratch in the second season...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/17L0z3uzqfH2qIRq3dXHS2TDeQU.jpg", url:"https://themoviedb.org/person/15274"}}, {tmdbId:"2234", properties:{bornIn:"Houston - Texas - USA", imdbId:"0100889", born:date('1953-06-21'), name:"Michael Bowen", bio:"Michael Bowen (born June 21, 1953) is an American actor.  Films he has appeared in include Jackie Brown, Magnolia, and Less Than Zero.  Bowen also had a recurring role as Danny Pickett on the ABC television series, Lost. \n\nBowen (also credited as Michael Bowen Jr. ) was born to actress Sonia Sorel (1921–2004) and Beat painter Michael Bowen.  He is half-brother to Robert and Keith Carradine.  His nieces are actresses Martha Plimpton and Ever Carradine...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vRksdXlhcjOMFRD3szytf74am1f.jpg", url:"https://themoviedb.org/person/2234"}}, {tmdbId:"12482", properties:{bornIn:"Ottawa Valley, Ontario, Canada", imdbId:"0810500", born:date('1958-09-08'), name:"Sonja Smits", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ryv2Bx75BnqetyCdPB2G9UATJy.jpg", url:"https://themoviedb.org/person/12482"}}, {tmdbId:"102", properties:{bornIn:"Miami, Florida, USA", imdbId:"0001323", born:date('1945-07-01'), name:"Debbie Harry", bio:"An American singer, songwriter, and actress, known as the lead singer of the new wave band Blondie...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w496cQvkU7KvUcSVV8DMDDowVYv.jpg", url:"https://themoviedb.org/person/102"}}, {tmdbId:"12483", properties:{imdbId:"0245356", name:"Peter Dvorsky", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6qpegWk7mi5CxnnHpkvBunwhdNj.jpg", url:"https://themoviedb.org/person/12483"}}, {tmdbId:"8937", properties:{bornIn:"Derbyshire, England, UK", imdbId:"0939795", born:date('1930-07-05'), name:"John Wood", died:date('2011-08-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6raTQciey2xpcVV5c8HRV4XzFCk.jpg", url:"https://themoviedb.org/person/8937"}}, {tmdbId:"12851", properties:{bornIn:"New York City, New York, USA", imdbId:"0000639", born:date('1962-06-13'), name:"Ally Sheedy", bio:"From Wikipedia, the free encyclopedia\n\nAlexandra Elizabeth \"Ally\" Sheedy (born June 13, 1962) is an American film and stage actress, as well as the author of two books.  She is best known for her roles in the Brat Pack films The Breakfast Club and St.  Elmo's Fire. \n\nDescription the Wikipedia article Ally Sheedy, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dV6eGZm2HNEN2sfa4abTa2QtwOH.jpg", url:"https://themoviedb.org/person/12851"}}] AS row
