UNWIND [{tmdbId:"288434", properties:{imdbId:"0275484", name:"Stéphane Fey", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3c3MoU1ycJs6ZBgsO4yCpH2YwFx.jpg", url:"https://themoviedb.org/person/288434"}}, {tmdbId:"137997", properties:{imdbId:"0558446", name:"George E. Mather", url:"https://themoviedb.org/person/137997"}}, {tmdbId:"1634650", properties:{name:"Austin Green", url:"https://themoviedb.org/person/1634650"}}, {tmdbId:"1051907", properties:{imdbId:"0299109", name:"Esther Furst", url:"https://themoviedb.org/person/1051907"}}, {tmdbId:"217773", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0647322", born:date('1935-09-07'), name:"Norman Ollestad", died:date('1979-02-19'), url:"https://themoviedb.org/person/217773"}}, {tmdbId:"70324", properties:{bornIn:"Gunma, Japan", imdbId:"0462013", born:date('1923-11-23'), name:"Keiju Kobayashi", bio:"From Wikipedia, the free encyclopedia. \n\nKeiju Kobayashi (23 November 1923–16 September 2010) was a Japanese actor.  Born in Gunma Prefecture, he began acting at the Nikkatsu studio after dropping out of Nihon University and made his film debut in 1942.  In a career that spanned 65 years, he appeared in over 250 films, most famously in the \"Company President\" (Shachō) comedy films made at Toho, where he worked alongside Hisaya Morishige, Daisuke Kato, Norihei Miki, and others...", died:date('2010-09-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mFXxwc74dTavei0IfPf6bNswmUc.jpg", url:"https://themoviedb.org/person/70324"}}, {tmdbId:"33764", properties:{bornIn:"Yokohama, Kanagawa Prefecture, Japan", imdbId:"0443232", born:date('1937-04-11'), name:"Yûzô Kayama", bio:"From Wikipedia, the free encyclopedia. \n\nYūzō Kayama (加山 雄三 Kayama Yūzō) is a Japanese popular musician and film star, born on 11 April 1937.  His father, Ken Uehara, was a film star during the 1930s.  Yuzo Kayama became a big star in the 1960s in the Wakadaishō (Young Guy) film series. \n\nHe showed his ability for drama when Akira Kurosawa cast him for his 1965 film, Red Beard, starring Toshirō Mifune...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wkBZ1dcVxZv6GzZUFaBMtN11uEI.jpg", url:"https://themoviedb.org/person/33764"}}, {tmdbId:"41283", properties:{bornIn:"Kirksville, Missouri, USA", imdbId:"0656183", born:date('1924-11-22'), name:"Geraldine Page", bio:"​From Wikipedia, the free encyclopedia\n\nGeraldine Sue Page (November 22, 1924 – June 13, 1987) was an American actress.  Although she starred in at least two dozen feature films, she is primarily known for her celebrated work in the American theater.  She won the Academy Award for Best Actress for her performance as Carrie Watts in The Trip to Bountiful in March 1986, just over a year before she died...", died:date('1987-06-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yhfK6lg8Wgsx8SBk7vhQkKF7trR.jpg", url:"https://themoviedb.org/person/41283"}}, {tmdbId:"28778", properties:{bornIn:"Goessel, Kansas, USA", imdbId:"0004309", born:date('1936-07-05'), name:"Shirley Knight", bio:"Shirley Enola Knight was an American stage, screen, and television actress.  She has been nominated twice for the Academy Award for Best Supporting Actress, in 1960 for The Dark at the Top of the Stairs and in 1962 for Sweet Bird of Youth...", died:date('2020-04-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6sc3Hg3ZXyRECKxrHU58Y1rbZWp.jpg", url:"https://themoviedb.org/person/28778"}}, {tmdbId:"73942", properties:{imdbId:"0575031", born:date('1922-02-08'), name:"Audrey Meadows", died:date('1996-02-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tj4c3wOae7V0EwfBvZxoZnNLfdF.jpg", url:"https://themoviedb.org/person/73942"}}, {tmdbId:"8490", properties:{bornIn:"Queens, New York, USA", imdbId:"0576345", born:date('1952-11-09'), name:"John Megna", died:date('1995-09-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kReLwlEfN7c5Aer1TSdaL6Y4qG1.jpg", url:"https://themoviedb.org/person/8490"}}, {tmdbId:"6838", properties:{imdbId:"0653942", born:date('1918-03-12'), name:"Frank Overton", died:date('1967-04-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jfo6pBjtVvwYKRKIFdjPJDu4N3z.jpg", url:"https://themoviedb.org/person/6838"}}, {tmdbId:"8492", properties:{bornIn:" Munich, Bavaria, Germany", imdbId:"0614677", born:date('1925-01-13'), name:"Rosemary Murphy", died:date('2014-07-05'), url:"https://themoviedb.org/person/8492"}}, {tmdbId:"50090", properties:{bornIn:"Wien, Austria", imdbId:"0546502", born:date('1916-06-10'), name:"Harald Maresch", died:date('1986-12-07'), url:"https://themoviedb.org/person/50090"}}, {tmdbId:"50939", properties:{bornIn:"Lübeck, Germany", imdbId:"0290431", born:date('1933-01-01'), name:"Helga Franck", died:date('1963-01-01'), url:"https://themoviedb.org/person/50939"}}, {tmdbId:"49251", properties:{bornIn:"Munich, Germany", imdbId:"0627183", born:date('1940-06-10'), name:"Helga Neuner", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rORR6u0oUgN4wrPL6r69bqbHBlj.jpg", url:"https://themoviedb.org/person/49251"}}, {tmdbId:"148665", properties:{imdbId:"0161393", name:"Sandra Church", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jQzwmpodbpRCLjlORuFAv7RBkcF.jpg", url:"https://themoviedb.org/person/148665"}}, {tmdbId:"18197", properties:{bornIn:"Solbjerg, Denmark", imdbId:"0439344", born:date('1940-09-22'), name:"Anna Karina", bio:"Anna Karina  (22 September 1940 - 14 December 2019) was a Danish film actress, director, and screenwriter who spent most of her working life in France.  Karina was known as a muse of the director Jean-Luc Godard, one of the pioneers of the French New Wave.  Her notable collaborations with Godard include The Little Soldier (1960), A Woman Is a Woman (1961) and Vivre sa vie (1962).  With A Woman Is a Woman, Karina won the Best Actress award at the Berlin Film Festival...", died:date('2019-12-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wcMGNRYp9BeGYG7tcAFQqSc5WPa.jpg", url:"https://themoviedb.org/person/18197"}}, {tmdbId:"18198", properties:{imdbId:"0714236", name:"Sady Rebbot", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hVs6YjJfw1HIQCGMN5gnubHBVx8.jpg", url:"https://themoviedb.org/person/18198"}}, {tmdbId:"18199", properties:{bornIn:"Oloron-Sainte-Marie, France", imdbId:"0479351", born:date('1931-12-18'), name:"André S. Labarthe", bio:"André S.  Labarthe (18 December 1931 – 5 March 2018) was a French actor, film producer and director.  He starred alongside Anna Karina in the 1962 film Vivre sa vie.  He was the director of many television documentaries that profile specific individuals, beginning with Cinéastes de notre temps. \n\nSource: Article \"André S.  Labarthe\" from Wikipedia in english, licensed under CC-BY-SA 3. 0...", died:date('2018-03-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qSGjIBxHu6Kg0RU9Do11zdOVZo5.jpg", url:"https://themoviedb.org/person/18199"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"18200", properties:{imdbId:"0772480", name:"Guylaine Schlumberger", url:"https://themoviedb.org/person/18200"}}, {tmdbId:"24811", properties:{bornIn:"San Diego, California, United States", imdbId:"0120658", born:date('1938-02-03'), name:"Victor Buono", bio:"​From Wikipedia, the free encyclopedia\n\nCharles Victor Buono (February 3, 1938 – January 1, 1982) was an American actor and comic. \n\nDescription above from the Wikipedia article Victor Buono, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1982-01-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hDdP7PPTprwmN3iQrDUmwuNhtnm.jpg", url:"https://themoviedb.org/person/24811"}}, {tmdbId:"66712", properties:{bornIn:"Omaha, Nebraska, U.S.", imdbId:"0011741", born:date('1913-08-04'), name:"Wesley Addy", bio:"​From Wikipedia, the free encyclopedia\n\nWesley Addy (August 4, 1913 – December 31, 1996) was an American actor. \n\nHe played many roles on the Broadway stage, including several Shakespearean ones, usually opposite actor Maurice Evans.  After playing two roles in one of Evans's productions of Hamlet, he played Horatio opposite Evans's Hamlet in a 1953 Hallmark Hall of Fame television production of the work, the most prestigious American production of the play seen on TV up to that time...", died:date('1996-12-31'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j0DmXhowoVNXR21jQy9QhTD8BOz.jpg", url:"https://themoviedb.org/person/66712"}}, {tmdbId:"175980", properties:{bornIn:"Valencia, Spain", imdbId:"0708048", born:date('1924-05-08'), name:"Enrique Rambal", bio:"​From Wikipedia, the free encyclopedia\n\nEnrique Rambal (8 May 1924 – 15 December 1971) was a Mexican film actor.  He appeared in 68 films between 1952 and 1971. \n\nDescription above from the Wikipedia article Enrique Rambal, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1971-12-15'), url:"https://themoviedb.org/person/175980"}}, {tmdbId:"39008", properties:{bornIn:"Mexico City, Distrito Federal, Mexico", imdbId:"0111610", born:date('1927-08-28'), name:"Claudio Brook", bio:"​From Wikipedia, the free encyclopedia\n\nClaudio Brook (28 August 1927 — 18 October 1995) was a Mexican actor.  Born in Mexico City, Brook had a prolific career, making around 100 film and television appearances in his 38 years.  He won two Ariel Awards.  He died from stomach cancer in 1995. \n\nFor his work in motion pictures, Brook was inducted into the Paseo de las Luminarias. \n\nDescription above from the Wikipedia Claudio Brook, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1995-10-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/98kYXDKks1VD5wxlzq8U9p1IsLf.jpg", url:"https://themoviedb.org/person/39008"}}, {tmdbId:"176011", properties:{bornIn:"Valencia, Spain", imdbId:"0062593", born:date('1906-08-17'), name:"José Baviera", bio:"José Baviera was born on August 17, 1906 in Valencia, Spain as José Luis Baviera Navarro.  He was immigrated to Mexico in 1940.  He was an actor and director, known for El ángel exterminador (1962), La barraca (1945) and La otra (1946).  He died on August 13, 1981 in Mexico, D. F. , Mexico...", died:date('1981-08-13'), url:"https://themoviedb.org/person/176011"}}, {tmdbId:"131329", properties:{bornIn:"Roma, Italy", imdbId:"0109265", born:date('1913-08-23'), name:"Lilla Brignone", died:date('1984-03-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8maogMQvcq6r97u9opKjPIQAJxi.jpg", url:"https://themoviedb.org/person/131329"}}, {tmdbId:"4959", properties:{bornIn:" Tunis, French Protectorate Tunisia [now Tunisia]", imdbId:"0001012", born:date('1938-04-15'), name:"Claudia Cardinale", bio:"​From Wikipedia, the free encyclopedia.   \n\nClaudia Cardinale (born 15 April 1938) is an Italian actress, and has appeared in some of the best European films of the 1960s and 1970s.  The majority of Cardinale's films have been either Italian or French.  She was also an iconic sex symbol of the 1960s...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eSNCcnxtBJf0AIAB4k7jpFJNwcD.jpg", url:"https://themoviedb.org/person/4959"}}, {tmdbId:"5683", properties:{bornIn:" Tunis, French Protectorate Tunisia [now Tunisia]", imdbId:"0590452", born:date('1935-03-11'), name:"Sandra Milo", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4lfL8jbBzO8mvx6d9zdLZjcVT3w.jpg", url:"https://themoviedb.org/person/5683"}}, {tmdbId:"55820", properties:{bornIn:"Greece", imdbId:"0316071", born:date('1941-01-21'), name:"Stathis Giallelis", bio:"From Wikipedia, the free encyclopedia. \n\nStathis Giallelis (born 21 January 1941) is a Greek actor who, in the early 1960s, won brief international renown as the star of Elia Kazan's Academy Award-nominated epic America, America, a role which brought him the Golden Globe Award for New Star of the Year – Actor, as well as a nomination for Golden Globe Award for Best Actor – Motion Picture Drama...", url:"https://themoviedb.org/person/55820"}}, {tmdbId:"4968", properties:{bornIn:"San Francisco, California.", imdbId:"0938231", born:date('1928-05-11'), name:"Frank Wolff", bio:"From Wikipedia, the free encyclopedia\n\nWalter Frank Hermann Wolff (May 11, 1928 —December 12, 1971) was a versatile American actor whose prolific movie career began with roles in five 1958-61 Roger Corman productions and ended a decade later in Rome, after scores of appearances in European-made films, most of which were lensed in Italy. \n\nDescription above from the Wikipedia article Frank Wolff (actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1971-12-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xRbJq4GwVl5w3pRmWzQP9SehKE1.jpg", url:"https://themoviedb.org/person/4968"}}, {tmdbId:"19787", properties:{imdbId:"0204687", born:date('1907-12-11'), name:"Harry Davis", died:date('1993-08-04'), url:"https://themoviedb.org/person/19787"}}, {tmdbId:"151133", properties:{imdbId:"0438833", born:date('1909-02-27'), name:"Elena Karam", died:date('2001-03-30'), url:"https://themoviedb.org/person/151133"}}, {tmdbId:"14011", properties:{bornIn:"Kingston-Upon-Hull, East Riding of Yorkshire, England, UK", imdbId:"0183822", born:date('1937-02-25'), name:"Tom Courtenay", bio:"An English actor who came to prominence in the early 1960s with a succession of films including The Loneliness of the Long Distance Runner (1962), Billy Liar (1963), and Dr.  Zhivago (1965).  Since the mid-1960s he has been known primarily for his work in the theatre.  Courtenay received a knighthood in February 2001 for forty years' service to cinema and theatre.  Courtenay is the President of Hull City A. F. C. 's Official Supporters Club...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uFgUpoXqFRlwdk7WbYmWVOtcaq4.jpg", url:"https://themoviedb.org/person/14011"}}, {tmdbId:"95630", properties:{imdbId:"0681955", born:date('1904-10-13'), name:"Wilfred Pickles", died:date('1978-03-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AviOt8os7XzSELDwXG5OCoOfr82.jpg", url:"https://themoviedb.org/person/95630"}}, {tmdbId:"89895", properties:{bornIn:"Solihull, Warwickshire, England, UK", imdbId:"0913332", born:date('1903-11-27'), name:"Mona Washbourne", bio:"From Wikipedia, the free encyclopedia\n\nMona Lee Washbourne (27 November 1903 – 15 November 1988) was an English actress of stage, film, and television.  Her most critically acclaimed role was in the film Stevie (1978), late in her career, for which she was nominated for a Golden Globe Award and a BAFTA Award. \n\nMona Washbourne was born in Solihull, Warwickshire and began her entertaining career training as a concert pianist...", died:date('1988-11-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3verXd1ywWcpiOIPxqApEV3TvTT.jpg", url:"https://themoviedb.org/person/89895"}}, {tmdbId:"8232", properties:{imdbId:"0341100", born:date('1878-04-26'), name:"Ethel Griffies", died:date('1975-09-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z7tWijSWBdH78JMGocKICGW9ze5.jpg", url:"https://themoviedb.org/person/8232"}}, {tmdbId:"6929", properties:{bornIn:"New Ulm, Minnesota, USA", imdbId:"0001335", born:date('1930-01-19'), name:"Tippi Hedren", bio:"From Wikipedia, the free encyclopedia\n\nNathalie Kay \"Tippi\" Hedren (born January 19, 1930) is an American actress and former fashion model with a career spanning six decades.  She is primarily known for her roles in two Alfred Hitchcock films, The Birds and Marnie, and her extensive efforts in animal rescue at Shambala Preserve, an 80-acre (320,000 m2) wildlife habitat which she founded in 1983...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/34fdccVaeMkcqDX8rxEDkz2LhWp.jpg", url:"https://themoviedb.org/person/6929"}}, {tmdbId:"8231", properties:{bornIn:"New York City, New York, USA", imdbId:"0687189", born:date('1937-01-31'), name:"Suzanne Pleshette", bio:"Suzanne Pleshette (January 31, 1937 – January 19, 2008) was an American actress, on stage, screen and television. \n\nAfter beginning her career in theatre, she began appearing in films in the early 1960s, such as Rome Adventure (1962) and Alfred Hitchcock's The Birds (1963).  She later appeared in various television productions, often in guest roles, and played the role of Emily Hartley on The Bob Newhart Show from 1972 until 1978, receiving Emmy Award nominations for her work...", died:date('2008-01-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vSuO3CnNkoCefZVTpCARNfJPYhr.jpg", url:"https://themoviedb.org/person/8231"}}, {tmdbId:"5698", properties:{bornIn:"London, England", imdbId:"0001788", born:date('1909-06-07'), name:"Jessica Tandy", bio:"From Wikipedia, the free encyclopedia. \n\nJessie Alice \"Jessica\" Tandy (June 7 1909 – September 11 1994) was an English - American stage and film actress. \n\nShe first appeared on the London stage in 1926 at the age of 16, playing, among others, Katherine opposite Laurence Olivier's Henry V, and Cordelia opposite John Gielgud's King Lear.  She also worked in British films.  Following the end of her marriage to Jack Hawkins, she moved to New York, where she met Canadian actor Hume Cronyn...", died:date('1994-09-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ztftVWoUTYHgJ5kzDK6a8aXxUoR.jpg", url:"https://themoviedb.org/person/5698"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"99947", properties:{bornIn:"San Diego, California, USA", imdbId:"0450138", born:date('1927-04-17'), name:"William Kerwin", died:date('1989-10-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7kPCIpSaxjQS87ePtDeNX3FyKnU.jpg", url:"https://themoviedb.org/person/99947"}}, {tmdbId:"99948", properties:{imdbId:"0036546", name:"Mal Arnold", url:"https://themoviedb.org/person/99948"}}, {tmdbId:"99949", properties:{imdbId:"0556654", born:date('1937-08-24'), name:"Connie Mason", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/icUrW3u0EdGa526urqVGdiE8hi1.jpg", url:"https://themoviedb.org/person/99949"}}, {tmdbId:"99950", properties:{imdbId:"0093421", name:"Lyn Bolton", url:"https://themoviedb.org/person/99950"}}, {tmdbId:"61303", properties:{bornIn:"West Plains, Missouri, U.S.", imdbId:"0001813", born:date('1925-12-13'), name:"Dick Van Dyke", bio:"Richard Wayne \"Dick\" Van Dyke (born December 13, 1925) is an American actor, comedian, writer, and producer with a career spanning six decades.  He is the older brother of Jerry Van Dyke, and father of Barry Van Dyke.  Van Dyke starred in the films Bye Bye Birdie, Mary Poppins, and Chitty Chitty Bang Bang, and the television series The Dick Van Dyke Show, and Diagnosis: Murder .  Van Dyke has a star on the Hollywood Walk of Fame at 7021 Hollywood Blvd...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zSd2C032XaQvUg1g88W4KWOIpsz.jpg", url:"https://themoviedb.org/person/61303"}}, {tmdbId:"13567", properties:{bornIn:"Valsjöbyn, Jämtlands län, Sweden", imdbId:"0000268", born:date('1941-04-28'), name:"Ann-Margret", bio:"Ann-Margret Olsson (born April 28, 1941) is a Swedish-American actress, singer and dancer whose professional name is Ann-Margret.  She is best known for her roles in Bye Bye Birdie (1963), Viva Las Vegas (1964), The Cincinnati Kid (1965), Carnal Knowledge (1971), and Tommy (1975).  She has won five Golden Globe Awards and been nominated for two Academy Awards, two Grammy Awards, a Screen Actors Guild Award, and six Emmy Awards...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7cq76gMW4Mal5cctMLCK8wilJ6.jpg", url:"https://themoviedb.org/person/13567"}}, {tmdbId:"21151", properties:{bornIn:"Troy, New York, United States", imdbId:"0822972", born:date('1925-06-20'), name:"Maureen Stapleton", bio:"Lois Maureen Stapleton (June 21, 1925 – March 13, 2006) was an American actress.  She was the recipient of an Academy Award, a BAFTA Award, a Golden Globe Award, two Tony Awards, and a Primetime Emmy Award, and is one of the few performers to achieve the Triple Crown of Acting...", died:date('2006-03-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rXwg71O6oU6x3sB5c4erlAu7mhy.jpg", url:"https://themoviedb.org/person/21151"}}, {tmdbId:"5563", properties:{bornIn:"Laurel, Nebraska, USA", imdbId:"0000336", born:date('1928-08-31'), name:"James Coburn", bio:"​From Wikipedia, the free encyclopedia.   \n\nJames Harrison Coburn III (August 31, 1928 – November 18, 2002) was an American film and television actor.  Coburn appeared in nearly 70 films and made over 100 television appearances during his 45-year career, and played a wide range of roles and won an Academy Award for his supporting role as Glen Whitehouse in Affliction. \n\nDescription above from the Wikipedia article James Coburn, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2002-11-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mrmLtSEFdOpUANc2wfXMV8iHLwu.jpg", url:"https://themoviedb.org/person/5563"}}, {tmdbId:"58339", properties:{bornIn:"Ipswich, Suffolk, England, UK", imdbId:"0376915", born:date('1931-01-13'), name:"Ian Hendry", bio:"From Wikipedia, the free encyclopedia. \n\nIan Hendry (13 January 1931 – 24 December 1984) was an English film and television actor.  He is best known for his work on several British TV series of the early 1960s such as The Avengers, and for his roles in 1970s films such as Get Carter (1971). \n\nDescription above from the Wikipedia article Ian Hendry, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1984-12-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dl0HL5adsOSJ5y2l9KXuSClGQMM.jpg", url:"https://themoviedb.org/person/58339"}}, {tmdbId:"39065", properties:{bornIn:"Rusholme, Manchester, England", imdbId:"0045996", born:date('1923-09-11'), name:"Alan Badel", bio:"From Wikipedia, the free encyclopedia. \n\nAlan Fernand Badel (11 September 1923 – 19 March 1982) was a distinguished English stage actor who also appeared frequently in the cinema, radio and television and was noted for his richly textured voice which was once described as \"the sound of tears\". \n\nDescription above from the Wikipedia article Alan Badel, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1982-03-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3cRgBUd9ktS8kB6IIdNkU29FgJM.jpg", url:"https://themoviedb.org/person/39065"}}, {tmdbId:"87420", properties:{bornIn:"London, England, UK", imdbId:"0274865", born:date('1942-07-27'), name:"Barbara Ferris", bio:"From Wikipedia, the free encyclopedia. \n\nBarbara Gillian Ferris (born in London on 27 July 1942) is an English actress and former fashion model. \n\nShe appeared in a number of films and productions for television and is possibly best remembered as Dinah, the young woman who eloped with Dave Clark in the 1965 film Catch Us If You Can...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1P40Ew25aHIh2P7CQipqJ4IvJUd.jpg", url:"https://themoviedb.org/person/87420"}}, {tmdbId:"105823", properties:{bornIn:"Peckham, London, England, UK", imdbId:"0121588", born:date('1918-02-28'), name:"Alfred Burke", bio:"From Wikipedia, the free encyclopedia. \n\nAlfred Burke (28 February 1918 – 16 February 2011) was a British actor, best known for his portrayal of Frank Marker in the drama series Public Eye, which ran on television for ten years. \n\nDescription above from the Wikipedia article Alfred Burke, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2011-02-16'), url:"https://themoviedb.org/person/105823"}}, {tmdbId:"53818", properties:{bornIn:"London, England, UK", imdbId:"0114386", born:date('1917-07-08'), name:"Pamela Brown", died:date('1975-09-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2O9XotDDcid1HE7W4sRWaKuOX7a.jpg", url:"https://themoviedb.org/person/53818"}}, {tmdbId:"7631", properties:{bornIn:"Yazoo City, Mississippi, USA", imdbId:"0001771", born:date('1936-10-01'), name:"Stella Stevens", bio:"From Wikipedia, the free encyclopedia\n\nStella Stevens (born October 1, 1936 as Estelle Caro Eggleston) is an American film, television and stage actress, who began her acting career in 1959.  She is a film producer, director and pin-up girl. \n\nDescription above from the Wikipedia article Stella Stevens, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/f2R5ZukKKN3kaBsLf4PmSfC0QFX.jpg", url:"https://themoviedb.org/person/7631"}}, {tmdbId:"78896", properties:{imdbId:"0020490", born:date('1929-01-25'), name:"Elizabeth Allen", bio:"​From Wikipedia, the free encyclopedia.   \n\nElizabeth Allen (January 25, 1929 – September 19, 2006) was an American actress. \n\nDescription above from the Wikipedia article Elizabeth Allen (actress), licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2006-09-19'), url:"https://themoviedb.org/person/78896"}}, {tmdbId:"70118", properties:{bornIn:"Astoria, Queens, New York City, New York, USA", imdbId:"0356983", born:date('1947-04-04'), name:"Luke Halpin", bio:"​From Wikipedia, the free encyclopedia\n\nLuke Halpin (born April 4, 1947) is an American film and former TV child actor. \n\nDescription above from the Wikipedia article Luke Halpin, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ssB7IeIbCMWHALtpgayohTsk3DS.jpg", url:"https://themoviedb.org/person/70118"}}, {tmdbId:"111166", properties:{imdbId:"0778987", name:"Connie Scott", url:"https://themoviedb.org/person/111166"}}, {tmdbId:"111167", properties:{bornIn:"Seattle, Washington, USA", imdbId:"0741455", born:date('1913-02-07'), name:"Jane Rose", bio:"Jane Rose was born on February 7, 1913 in Seattle, Washington, USA.  She was an actress known for Summertime (1955), Mi amigo Flipper (1963) and Phyllis (1975).  She died on June 29, 1979 in Los Angeles, California, USA...", died:date('1979-06-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uti7Bfb8YLFNeOMoHFeBHDWf7ry.jpg", url:"https://themoviedb.org/person/111167"}}, {tmdbId:"9896", properties:{bornIn:"Rome, Lazio, Italy", imdbId:"0000938", born:date('1942-01-31'), name:"Daniela Bianchi", bio:"From Wikipedia, the free encyclopedia\n\nDaniela Bianchi (born 31 January 1942) is an Italian actress, whose best known part was Tatiana Romanova in the 1963 James Bond movie From Russia with Love. \n\nBorn in Rome, she was the 1st runner-up in the 1960 Miss Universe contest, where she was also voted Miss Photogenic by the press.  Her film career began in 1958.  In From Russia with Love her voice was dubbed by Barbara Jefford...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/myO3G7wl44a51RQA8rpAL9zhIF0.jpg", url:"https://themoviedb.org/person/9896"}}, {tmdbId:"96973", properties:{bornIn:"Mexico City, Distrito Federal, Mexico", imdbId:"0000784", born:date('1912-05-09'), name:"Pedro Armendáriz", bio:"Born in Churubusco, a suburb of Mexico City, and raised in Texas, he studied at California Polytechnic State University where he graduated with an engineering degree.  He began his acting career at the stage in Mexico City, entering films there in 1935.  During the next years he made 42 Spanish-language films, among them \"Maria Candelaria\" (1943) and \"La Perla\" (1947), becoming one of Mexico`s top film stars.  His first American film was \"The Fugitive\" for RKO in 1947...", died:date('1963-06-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ozdLztum8l8jlseX6YVfaeazXZP.jpg", url:"https://themoviedb.org/person/96973"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"9898", properties:{bornIn:"Vienna-Penzing, Austria-Hungary [now Austria]", imdbId:"0502322", born:date('1898-10-18'), name:"Lotte Lenya", bio:"From Wikipedia, the free encyclopedia. \n\nLotte Lenya (18 October 1898 – 27 November 1981) was an Austrian singer and actress.  In the German-speaking and classical music world she is best remembered for her performances of the songs of her husband, Kurt Weill.  In English-language film she is remembered for her Academy Award-nominated role in The Roman Spring of Mrs.  Stone (1961) and as the sadistic Rosa Klebb in the James Bond movie From Russia with Love (1963)...", died:date('1981-11-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xtyX5K5FouniqzM4sflOwaXmRnD.jpg", url:"https://themoviedb.org/person/9898"}}, {tmdbId:"4962", properties:{bornIn:"Rome, Italy", imdbId:"0832375", born:date('1906-06-06'), name:"Paolo Stoppa", bio:"From Wikipedia, the free encyclopedia\n\nPaolo Stoppa (6 June 1906 – 1 May 1988) was an Italian actor and dubber. \n\nBorn in Rome, he began as a stage actor in 1927 in the theater in Rome and began acting in films in 1932...", died:date('1988-05-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dBobmd9tG5s3LEJZus8wLokDlOQ.jpg", url:"https://themoviedb.org/person/4962"}}, {tmdbId:"128621", properties:{bornIn:"Lawrence, Massachusetts, U.S.", imdbId:"0332587", born:date('1933-11-26'), name:"Robert Goulet", bio:"From Wikipedia, the free encyclopedia\n\nRobert Gerard Goulet (November 26, 1933 – October 30, 2007) was a Canadian American entertainer.  He rose to international stardom in 1960 as Lancelot in Lerner and Loewe's hit Broadway musical Camelot.  His long career as a singer and actor encompassed theatre, radio, television and film. \n\nDescription above from the Wikipedia article Robert Goulet, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2007-10-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3HklZAxtOM5qoXaQrf4hglUvr6l.jpg", url:"https://themoviedb.org/person/128621"}}, {tmdbId:"16417", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0293659", born:date('1920-06-22'), name:"Paul Frees", bio:"From Wikipedia, the free encyclopedia\n\nSolomon Hersh Frees (June 22, 1920 – November 2, 1986), better known as Paul Frees, was an American actor, voice actor, impressionist and screenwriter known for his work on MGM, Walter Lantz, and Walt Disney theatrical cartoons during the Golden Age of Animation and for providing the voice of Boris Badenov in The Rocky and Bullwinkle Show.  Along with his contemporary Mel Blanc, he became known as \"The Man of a Thousand Voices\"...", died:date('1986-11-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pACT0LYkEyff7PGt88iqr5u9T7u.jpg", url:"https://themoviedb.org/person/16417"}}, {tmdbId:"12250", properties:{bornIn:"Aberdeen, Aberdeenshire, Scotland, UK", imdbId:"0232019", born:date('1917-05-18'), name:"James Donald", bio:"​From Wikipedia, the free encyclopedia\n\nJames Donald (18 May 1917 - 3 August 1993) was a Scottish actor.  Tall and gaunt, he specialised in playing authority figures; military officers, doctors or scientists.  Donald was born in Aberdeen, and made his first professional stage appearance sometime in the late-1930s, having been educated at Rossall School on Lancashire's Fylde coast...", died:date('1993-08-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d7hqBIAaRxfuxMBbynlTta2ODgZ.jpg", url:"https://themoviedb.org/person/12250"}}, {tmdbId:"20510", properties:{bornIn:"Upminster, Essex, England, UK", imdbId:"0426062", born:date('1927-07-30'), name:"Richard Johnson", bio:"Richard Johnson (1927-2015) was an English actor, writer and producer, who starred in several British films of the 1960s, many TV productions and also had a distinguished stage career...", died:date('2015-06-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x4NJs1T9BryS0v7AqLF2D7Ivs8s.jpg", url:"https://themoviedb.org/person/20510"}}, {tmdbId:"178884", properties:{imdbId:"0312783", born:date('1921-07-27'), name:"Émile Genest", died:date('2003-03-19'), url:"https://themoviedb.org/person/178884"}}, {tmdbId:"1236153", properties:{imdbId:"0236835", name:"John Drainie", url:"https://themoviedb.org/person/1236153"}}, {tmdbId:"1350859", properties:{imdbId:"0878526", name:"Tommy Tweed", url:"https://themoviedb.org/person/1350859"}}, {tmdbId:"1533602", properties:{imdbId:"0779771", name:"Sandra Scott", url:"https://themoviedb.org/person/1533602"}}, {tmdbId:"23708", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"0414279", born:date('1913-12-28'), name:"Lou Jacobi", bio:"Lou Jacobi (born Louis Harold Jacobovitch; December 28, 1913 – October 23, 2009) was a Canadian actor...", died:date('2009-10-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4E4ZPw6chqIGuhZ3ZOu3qXCjsTg.jpg", url:"https://themoviedb.org/person/23708"}}, {tmdbId:"27034", properties:{imdbId:"0946484", born:date('1935-12-28'), name:"Bruce Yarnell", died:date('1973-11-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Aa6vOxmG7bQXvM6fEYU9x8BuyBt.jpg", url:"https://themoviedb.org/person/27034"}}, {tmdbId:"69951", properties:{bornIn:"New York City, New York, USA", imdbId:"0000926", born:date('1908-07-12'), name:"Milton Berle", bio:"Milton Berle was an Emmy-winning American  comedian  and actor.  As the manic host of NBC's Texaco Star Theater (1948–55), in 1948 he was the first major star of US television and as such became known as Uncle Miltie and Mr.  Television  to millions during TV's golden age...", died:date('2002-03-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cMAbJZk8dOJ8iyrB1CoglGUWUY.jpg", url:"https://themoviedb.org/person/69951"}}, {tmdbId:"8902", properties:{bornIn:"Yonkers, New York, USA", imdbId:"0128377", born:date('1922-09-08'), name:"Sid Caesar", bio:"Sid Caesar (1922—2014) was an American comic actor and writer known as the leading man on the 1950s television series Your Show of Shows and as Coach Calhoun in Grease and Grease 2...", died:date('2014-02-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9NzIvUspXK4FiCZYjDrMrm6LBhr.jpg", url:"https://themoviedb.org/person/8902"}}, {tmdbId:"40241", properties:{bornIn:"St. Louis, Missouri, USA", imdbId:"0035925", born:date('1937-07-25'), name:"Todd Armstrong", died:date('1992-11-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mnXxstxGlgvUdRKkEpLMMd845EA.jpg", url:"https://themoviedb.org/person/40241"}}, {tmdbId:"69763", properties:{bornIn:"Flint, Michigan, USA ", imdbId:"0468222", born:date('1935-03-11'), name:"Nancy Kovack", bio:"A native of Flint, Michigan, Nancy Kovack was a student at the University of Michigan at 15, a radio deejay at 16, a college graduate at 19 and the holder of eight beauty titles by 20.  Her professional acting career began on television in New York, first as one of Jackie Gleason's \"Glea Girls\" and then, more prominently, on The Dave Garroway Show (1953), Today (1952) and Beat the Clock (1950).  A stage role opened Hollywood doors for Kovack, who signed with Columbia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1LJPgIntjUO6b2rMNi5cPYSqYiC.jpg", url:"https://themoviedb.org/person/69763"}}, {tmdbId:"24819", properties:{bornIn:"Brixton, London, England, UK", imdbId:"0713267", born:date('1935-04-20'), name:"Gary Raymond", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lg2VxWPiXV5JqpNHEAncbK3UBQD.jpg", url:"https://themoviedb.org/person/24819"}}, {tmdbId:"69764", properties:{bornIn:"Thames Ditton, Surrey, England, UK", imdbId:"0619802", born:date('1908-12-14'), name:"Laurence Naismith", bio:"Laurence Naismith (14 December 1908 – 5 June 1992) was an English actor. \n\nNaismith appeared in films such as Diamonds Are Forever (1971), Richard III (1955), Jason and the Argonauts (1963), Sink the Bismarck! (1960), Carrington VC (1954) and as Captain Edward Smith of the RMS Titanic in A Night to Remember (1958).  He appeared on Broadway in the musical Here's Love in 1963 and played the non-singing role of Merlin in the 1967 film version of the musical Camelot...", died:date('1992-06-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gU4CejZaVHNgQrL4tF16d0C7et3.jpg", url:"https://themoviedb.org/person/69764"}}, {tmdbId:"31114", properties:{bornIn:"Vienna, Austria", imdbId:"0803785", born:date('1896-11-28'), name:"Lilia Skala", bio:"From Wikipedia, the free encyclopedia\n\nLilia Skala (November 28, 1896 – December 18, 1994) was an Austrian-American actress. \n\nDescription above from the Wikipedia article Lilia Skala, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1994-12-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/veiuZGexvC0tnyp8KmU5fWeVE9f.jpg", url:"https://themoviedb.org/person/31114"}}, {tmdbId:"133575", properties:{imdbId:"0542858", name:"Lisa Mann", url:"https://themoviedb.org/person/133575"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"133576", properties:{imdbId:"0187886", name:"Isa Crino", url:"https://themoviedb.org/person/133576"}}, {tmdbId:"60990", properties:{bornIn:"Klagenfurt, Carinthia, Austria", imdbId:"0041405", born:date('1947-08-28'), name:"James Aubrey", bio:"James Aubrey was born on August 28, 1947 in Klagenfurt, Carinthia, Austria as James Aubrey Tregidgo.  He was an actor and casting director, known for Lord of the Flies (1963), Spy Game (2001) and The Rift (1990).  He was married to Agnes Kristin Hallander.  He died on April 6, 2010 in Cranwell, Lincolnshire, England...", died:date('2010-04-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aSqiHuGnkWXF67kS4JsNs2tlFBv.jpg", url:"https://themoviedb.org/person/60990"}}, {tmdbId:"584137", properties:{imdbId:"0152204", name:"Tom Chapin", url:"https://themoviedb.org/person/584137"}}, {tmdbId:"584138", properties:{imdbId:"0250046", name:"Hugh Edwards", url:"https://themoviedb.org/person/584138"}}, {tmdbId:"584139", properties:{imdbId:"0255900", name:"Roger Elwin", url:"https://themoviedb.org/person/584139"}}, {tmdbId:"30564", properties:{bornIn:"Niigata, Japan", imdbId:"0594682", born:date('1937-01-01'), name:"Kumi Mizuno", bio:"Kumi Mizuno (水野久美 Mizuno Kumi), born Maya Igarashi (五十嵐麻耶 Igarashi Maya), is a Japanese actress.  Despite the large number of films she appeared in early on in her career, Mizuno is best known for her roles in Toho's 1960's kaiju films Matango, Frankenstein vs.  Baragon, Invasion of Astro-Monster, Ebirah, Horror of the Deep, and The War of the Gargantuas.  Her most iconic role is undoubtedly that of the Xilien agent Namikawa in Invasion of Astro-Monster...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5x3fd43VtpDjUxhMYIgLmEbNENN.jpg", url:"https://themoviedb.org/person/30564"}}, {tmdbId:"3786", properties:{bornIn:"Prata di Pordenone - Friuli-Venezia Giulia - Italy", imdbId:"0596968", born:date('1938-01-14'), name:"Giorgia Moll", bio:"From Wikipedia, the free encyclopedia. \n\nGiorgia Moll, born (January 14, 1938) in Prata di Pordenone, Province of Pordenone, is an Italian actress. \n\nDescription above from the Wikipedia article Giorgia Moll, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4og3ryBwb8xqKkBd77jDDjIP4ug.jpg", url:"https://themoviedb.org/person/3786"}}, {tmdbId:"113951", properties:{bornIn:"Pensacola, Florida, USA", imdbId:"0601111", born:date('1916-05-14'), name:"Del Moore", died:date('1970-08-30'), url:"https://themoviedb.org/person/113951"}}, {tmdbId:"7210", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0293466", born:date('1919-02-17'), name:"Kathleen Freeman", bio:"Kathleen Freeman (February 17, 1919 – August 23, 2001) was an American film, television, voice actress, and stage actress.  In a career that spanned more than fifty years, she portrayed acerbic maids, secretaries, teachers, busybodies, nurses, and battle-axe neighbors and relatives, almost invariably to comic effect...", died:date('2001-08-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fUSPZD3VRF3eojx0pvEf1DVet1R.jpg", url:"https://themoviedb.org/person/7210"}}, {tmdbId:"14262", properties:{bornIn:"Saint-Raphaël, Var, France", imdbId:"0001010", born:date('1928-01-06'), name:"Capucine", bio:"​From Wikipedia, the free encyclopedia\n\nCapucine (Born Germaine Hélène Irène Lefebvre, 6 January 1933 – 17 March 1990) was a French actress and fashion model best known for her comedic roles in The Pink Panther (1963) and What's New Pussycat? (1965).  She appeared in 36 films and 17 television productions between 1948 and 1990.  Her death was a result of suicide. \n\nDescription above from the Wikipedia article Capucine, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1990-03-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wO1NpSYFFPxFM4tnA1h6MAmdpPx.jpg", url:"https://themoviedb.org/person/14262"}}, {tmdbId:"84250", properties:{bornIn:"Ferrara, Italy", imdbId:"0289450", born:date('1916-01-24'), name:"Arnoldo Foà", died:date('2014-11-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lIkpfQ5AIpQe0E7aGzPa2MWAOEJ.jpg", url:"https://themoviedb.org/person/84250"}}, {tmdbId:"33723", properties:{bornIn:"Terre Haute, Indiana, USA", imdbId:"0353916", born:date('1921-10-29'), name:"Jess Hahn", bio:"Jess Hahn's career is a bit of an oddity, being one of very few American actors to establish himself in French cinema in the early 1960's.  He acted exclusively in French productions for the duration of his career with the exception of the Marlon Brando vehicle \"The Night of the Following Day\" in 1968, which was filmed in France...", died:date('1998-06-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ukMKswmb0wFQ9o7uzRAmmz5k5pi.jpg", url:"https://themoviedb.org/person/33723"}}, {tmdbId:"35958", properties:{bornIn:"Seattle - Washington - USA", imdbId:"0443985", born:date('1923-02-17'), name:"Billy Kearns", bio:"Billy Kearns was born on February 17, 1923 in Seattle, Washington, USA as William R.  Kearns.  He was an actor, known for Plein soleil (1960), Marathon Man (1976) andPlaytime (1967).  He died on November 28, 1992 in Château d'Oex, Switzerland...", died:date('1992-11-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/HqfwETWDVLVd8nTxS7PSaTgonE.jpg", url:"https://themoviedb.org/person/35958"}}, {tmdbId:"15197", properties:{bornIn:"Ingatestone, Essex, England, UK", imdbId:"0587234", born:date('1941-12-31'), name:"Sarah Miles", bio:"​From Wikipedia, the free encyclopedia.   \n\nSarah Miles (born 31 December 1941) is an English theatre and film actress. \n\nDescription above from the Wikipedia article Sarah Miles, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yU7kufp8OroVl25Nc4ei0iQwH4u.jpg", url:"https://themoviedb.org/person/15197"}}, {tmdbId:"132877", properties:{bornIn:"Sacriston, County Durham, England", imdbId:"0186048", born:date('1934-06-20'), name:"Wendy Craig", bio:"​From Wikipedia, the free encyclopedia.   \n\nWendy Craig (born 20 June 1934) is a BAFTA Award winning English actress who is best known for her appearances in the sitcoms Butterflies, . . . And Mother Makes Three and . . . And Mother Makes Five.  She currently plays the recurring role of Matron in popular TV series The Royal. \n\nDescription above from the Wikipedia article Wendy Craig,  licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jpgU4LRx1uoGN5m6VyDeJijZj44.jpg", url:"https://themoviedb.org/person/132877"}}, {tmdbId:"1292", properties:{bornIn:"London, England, UK", imdbId:"0289038", born:date('1939-05-19'), name:"James Fox", bio:"Fox first appeared on film in The Miniver Story in 1950.  His other early film appearances were made under his birth name, William Fox (the main character in The Magnet in 1950)\n\nIn 1962, Fox was working in a bank when Tony Richardson offered him a minor role in the film The Loneliness of the Long Distance Runner...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/usTO4NoD08rV0woh7vXLX8gxzHO.jpg", url:"https://themoviedb.org/person/1292"}}, {tmdbId:"35189", properties:{imdbId:"0106539", born:date('1929-03-13'), name:"Peter Breck", died:date('2012-02-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v5AX3WOOzbufez92VfNt3plnFhv.jpg", url:"https://themoviedb.org/person/35189"}}, {tmdbId:"20276", properties:{bornIn:"Whitefish, Montana, USA", imdbId:"0869927", born:date('1933-05-20'), name:"Constance Towers", bio:"​From Wikipedia, the free encyclopedia\n\nConstance Mary Towers (born May 20, 1933) is an American actress and singer. \n\nDescription above from the Wikipedia article Constance Towers, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fU4PccGG4scjldHZ5cr7Mg1Qte4.jpg", url:"https://themoviedb.org/person/20276"}}, {tmdbId:"89582", properties:{bornIn:"Holbrook, Arizona, USA", imdbId:"0262775", born:date('1922-07-11'), name:"Gene Evans", bio:"​From Wikipedia, the free encyclopedia.   \n\nGene Evans (July 11, 1922 - April 1, 1998) was an American actor. \n\nHe was born in Holbrook, Arizona, but reared in Colton, California.  His acting career began while he was serving in World War II.  He performed with a theatrical troupe of GIs in Europe.  Evans made his film debut in 1947 and appeared in dozens of movies and television programs.  He specialized in playing tough guys like cowboys, sheriffs, convicts and sergeants...", died:date('1998-04-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h8G0iqraU7LHwU8DzlBp2ZcgkyY.jpg", url:"https://themoviedb.org/person/89582"}}, {tmdbId:"12158", properties:{imdbId:"0842425", born:date('1908-07-23'), name:"Karl Swenson", died:date('1978-10-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5VZ6exiXp5PY7EhgyPEeUHfB7wJ.jpg", url:"https://themoviedb.org/person/12158"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"159552", properties:{bornIn:"Los Angeles, California, USA", born:date('1946-08-26'), name:"Rickie Sorensen", died:date('1994-08-24'), url:"https://themoviedb.org/person/159552"}}, {tmdbId:"57313", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0560076", born:date('1890-06-12'), name:"Junius Matthews", died:date('1978-01-18'), url:"https://themoviedb.org/person/57313"}}, {tmdbId:"13251", properties:{bornIn:"Tokyo, Japan", imdbId:"0586227", born:date('1923-11-02'), name:"Tatsuya Mihashi", bio:"Tatsuya Mihashi  (三橋 達也 Mihashi Tatsuya, November 2, 1923 - May 15, 2004)  was an actor, known for Tora! Tora! Tora! (1970), Dolls (2002) and High and Low (1963).  He was married to Kyôko Anzai.  He died on May 15, 2004 in Tokyo...", died:date('2004-05-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/s33XOrwOEEVoWeScWMK2Afs7Njl.jpg", url:"https://themoviedb.org/person/13251"}}, {tmdbId:"102826", properties:{bornIn:"Philadelphia, Pennsylvania, USA", imdbId:"0461070", born:date('1940-01-01'), name:"Sandra Knight", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zIRWjJq1dHkouKLLgsLSnWmewTk.jpg", url:"https://themoviedb.org/person/102826"}}, {tmdbId:"2463", properties:{bornIn:"New York City, New York, USA", imdbId:"0001526", born:date('1928-03-19'), name:"Patrick McGoohan", bio:"From Wikipedia, the free encyclopedia\n\nPatrick Joseph McGoohan (March 19, 1928 – January 13, 2009) was an American-born actor, raised in Ireland and England, with an extensive stage and film career, most notably in the 1960s television series Danger Man (renamed Secret Agent when exported to the US), and The Prisoner.  McGoohan wrote and directed several episodes of The Prisoner himself, occasionally using the pseudonyms Joseph Serf and Paddy Fitz...", died:date('2009-01-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lotRTcsjw2fofH1mnMkIdEAiAfH.jpg", url:"https://themoviedb.org/person/2463"}}, {tmdbId:"29703", properties:{bornIn:"Kensington, London, England, UK", imdbId:"0358925", born:date('1937-05-12'), name:"Susan Hampshire", bio:"​From Wikipedia, the free encyclopedia.   \n\nSusan Hampshire, Lady Kulukundis, OBE (born 12 May 1937) is an English actress best known for her many television and film roles.  Her appeal has always been that of an \"English rose\". \n\nDescription above from the Wikipedia article Susan Hampshire  licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/29703"}}, {tmdbId:"39028", properties:{bornIn:"Eastbourne, Sussex, England", imdbId:"0026876", born:date('1907-12-12'), name:"Jean Anderson", bio:"From Wikipedia, the free encyclopedia. \n\nJean Anderson (12 December 1907 – 1 April 2001) was an English actress born in Eastbourne, Sussex.  She is best remembered for her television roles as hard-faced matriarch Mary Hammond in the 1970s BBC drama The Brothers and as rebellious aristocrat Lady Jocelyn \"Joss\" Holbrook in the 1980s Second World War series Tenko . \n\nShe is also notable for playing the role of the Mother in The Railway Children in two separate BBC adaptations in 1951 and 1957...", died:date('2001-04-01'), url:"https://themoviedb.org/person/39028"}}, {tmdbId:"45468", properties:{imdbId:"0222627", name:"George Devine", url:"https://themoviedb.org/person/45468"}}, {tmdbId:"10653", properties:{imdbId:"0447499", born:date('1910-05-28'), name:"Rachel Kempson", died:date('2003-05-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h207OnJ61osIiPUisvLqmn0zsck.jpg", url:"https://themoviedb.org/person/10653"}}, {tmdbId:"140108", properties:{imdbId:"0045967", born:date('1904-07-04'), name:"Angela Baddeley", died:date('1976-02-22'), url:"https://themoviedb.org/person/140108"}}, {tmdbId:"37441", properties:{imdbId:"0715010", born:date('1915-12-09'), name:"Joyce Redman", died:date('2012-05-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hP3jo67BxeO6X1Lw1jwN8s4ocEW.jpg", url:"https://themoviedb.org/person/37441"}}, {tmdbId:"9240", properties:{bornIn:"Parma, Emilia-Romagna, Italy", imdbId:"0019145", born:date('1928-04-28'), name:"Lidia Alfonsi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iR5CcEPuHaEeWSxVCHuf48IEw9C.jpg", url:"https://themoviedb.org/person/9240"}}, {tmdbId:"109408", properties:{bornIn:"Toronto, Ontario,  Canada", imdbId:"0886469", born:date('1935-06-09'), name:"Diana Van der Vlis", died:date('2001-10-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cPJZknKTt9rCL9bsWm57rg885b1.jpg", url:"https://themoviedb.org/person/109408"}}, {tmdbId:"14508", properties:{bornIn:"Bronxville, New York, USA", imdbId:"0398466", born:date('1905-10-05'), name:"John Hoyt", bio:"John Hoyt was an American film, theatre, and television actor...", died:date('1991-09-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hQ7U4UcAEtlWMMmj3dJ9lrOIdUS.jpg", url:"https://themoviedb.org/person/14508"}}, {tmdbId:"228532", properties:{bornIn:"Osaka Prefecture, Japan", imdbId:"0794425", born:date('1933-12-06'), name:"Jô Shishido", bio:"Beloved Japanese actor most recognizable for his intense, eccentric yakuza film roles and his artificially enlarged cheekbones.  He has appeared in some 300 films but is best known in the West for his performance in the cult film Branded to Kill (1967).  In Japan, he is also known by the nickname \"Joe the Ace\" (エースのジョー Ēsu no Jō) for his popular role in the Western Fast-Draw Guy (1961)...", died:date('2020-01-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3ScqByWgflF202OskqSQkDB0lnP.jpg", url:"https://themoviedb.org/person/228532"}}, {tmdbId:"111235", properties:{bornIn:"Tokyo, Tokyo Prefecture, Japan", imdbId:"0913843", born:date('1932-10-23'), name:"Misako Watanabe", bio:"Misako Watanabe (渡辺美佐子) (b.  23 October 1932) is a Japanese actress.  She is a graduate of the Haiyuza Theatre Company.  In 1997 she received a Medal of Honor with Purple Ribbon and in 2004 the Order of the Rising Sun...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3jLsF5Qs5FYyweHxhEqkWwR6aiQ.jpg", url:"https://themoviedb.org/person/111235"}}, {tmdbId:"21499", properties:{imdbId:"0442709", born:date('1938-07-21'), name:"Tamio Kawachi", died:date('2018-02-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/r7Thij7PZW5vvnAiwvLzT3APJaE.jpg", url:"https://themoviedb.org/person/21499"}}, {tmdbId:"1520864", properties:{imdbId:"0469027", name:"Minako Katsuki", url:"https://themoviedb.org/person/1520864"}}, {tmdbId:"80704", properties:{bornIn:"Fukagawa, Tokyo, Japan", imdbId:"0441526", born:date('1931-11-29'), name:"Shintarô Katsu", bio:"From Wikipedia, the free encyclopedia\n\nShintarō Katsu (勝 新太郎 Katsu Shintarō?), born Toshio Okumura (奥村 利夫 Okumura Toshio, November 29, 1931—June 21, 1997; nicknamed Katsu-shin) was a Japanese actor, singer, producer, and director...", died:date('1997-06-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ziw06aCqJi0UG4S6xiAadAkljor.jpg", url:"https://themoviedb.org/person/80704"}}, {tmdbId:"128024", properties:{bornIn:"Kawasaki, Kanagawa Prefecture, Japan", imdbId:"0297788", born:date('1939-01-03'), name:"Shiho Fujimura", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q0qDilJLua9wvXjvaFh7MFenR5m.jpg", url:"https://themoviedb.org/person/128024"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"80706", properties:{imdbId:"0793567", born:date('1931-03-21'), name:"Ryûzô Shimada", bio:"Ryûzô Shimada was a Japanese film actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AqyalbABg5zwnmufaF74JiCkCzF.jpg", url:"https://themoviedb.org/person/80706"}}, {tmdbId:"150247", properties:{bornIn:"Kobe, Hyōgo Prefecture, Japan", imdbId:"0297881", born:date('1932-11-01'), name:"Reiko Fujiwara", died:date('2002-09-17'), url:"https://themoviedb.org/person/150247"}}, {tmdbId:"27554", properties:{bornIn:"Allestree, Derbyshire, England", imdbId:"0000869", born:date('1934-02-17'), name:"Alan Bates", bio:"Sir Alan Arthur Bates CBE (17 February 1934 – 27 December 2003) was an English actor, who came to prominence in the 1960s, a time of high creativity in British cinema, when he demonstrated his versatility in films ranging from the popular children’s story Whistle Down the Wind to the \"kitchen sink\" drama A Kind of Loving...", died:date('2003-12-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aqorhHCrgICHKP4nAJK9IB4xGGa.jpg", url:"https://themoviedb.org/person/27554"}}, {tmdbId:"18847", properties:{bornIn:"Chiliomodi, Corinth, Greece", imdbId:"0660327", born:date('1926-09-03'), name:"Irene Papas", bio:"Irene Papas (born September 3, 1926) is a Greek actress and occasional singer, who has starred in over seventy films in a career spanning more than fifty years...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fJJcQiaOaiCRHqBfzu4369kQA6S.jpg", url:"https://themoviedb.org/person/18847"}}, {tmdbId:"45523", properties:{bornIn:"Petrograd, Russia (now St. Petersburg, Russia)", imdbId:"0444321", born:date('1918-10-08'), name:"Lila Kedrova", bio:"Lila Kedrova (October 9, 1918 – February 16, 2000) was a Russian-born French actress.  She won the Academy Award for Best Supporting Actress for Zorba the Greek (1964), and the Tony Award for Best Performance by a Featured Actress in a Musical for the same role in the musical version of the film. \n\nDescription above from the Wikipedia article Lila Kedrova, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2000-02-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/s2H1tyR4z1OKKWBAty43MtaUd5X.jpg", url:"https://themoviedb.org/person/45523"}}, {tmdbId:"5823", properties:{bornIn:"Walton-on-Thames, Surrey, England, UK", imdbId:"0000267", born:date('1935-10-01'), name:"Julie Andrews", bio:"Dame Julia Elizabeth Andrews, DBE is a British film and stage actress, singer, and author.  She is the recipient of Golden Globe, Emmy, Grammy, BAFTA, People's Choice Award, Theatre World Award, Screen Actors Guild and Academy Award honours...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kTXM2KfsXh2vSav0s9vaDKfs4lR.jpg", url:"https://themoviedb.org/person/5823"}}, {tmdbId:"37191", properties:{bornIn:" Bologna, Emilia-Romagna, Italy", imdbId:"0148974", born:date('1901-05-03'), name:"Gino Cervi", bio:"From Wikipedia, the free encyclopedia. \n\nGino Cervi (3 May 1901 - 3 January 1974) was an Italian actor of international fame. \n\nCervi was born in Bologna.  His father was the theatre critic Antonio Cervi.  In 1928, he married Nini Gordini (one of his partners) and they had a son, Tonino Cervi.  Gino Cervi later became the grandfather of actress Valentina Cervi and producer Antonio Levesi Cervi...", died:date('1974-01-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dnArJe5KJvtHrEIc6Mtwgmic4tE.jpg", url:"https://themoviedb.org/person/37191"}}, {tmdbId:"7167", properties:{bornIn:"Queens, New York, U.S.", imdbId:"0725543", born:date('1926-05-08'), name:"Don Rickles", bio:"Don Rickles, nicknamed \"Mr.  Warmth\", was an American stand-up comedian and actor.  He acted in comedic and dramatic roles, but is best known as an insult comic.  He enjoyed a sustained career as such, thanks to his distinctive humor, wit, and impeccable timing.  Rickles frequently appeared as a guest on The Tonight Show Starring Johnny Carson...", died:date('2017-04-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iJLQV4dcbTUgxlWJakjDldzlMXS.jpg", url:"https://themoviedb.org/person/7167"}}, {tmdbId:"230266", properties:{bornIn:"Ilhéus, Bahia, Brazil", imdbId:"0215805", born:date('1930-10-29'), name:"Geraldo Del Rey", died:date('1993-04-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nYR9aTQwKC3ZqXXSHGgISbszLeS.jpg", url:"https://themoviedb.org/person/230266"}}, {tmdbId:"931719", properties:{bornIn:"Rio de Janeiro, Rio de Janeiro, Brazil", imdbId:"0535676", born:date('1935-08-07'), name:"Yoná Magalhães", died:date('2015-10-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bFkFnfkqfJ32V0zUjmN71hDOmJ3.jpg", url:"https://themoviedb.org/person/931719"}}, {tmdbId:"10061", properties:{bornIn:"Tucano, Bahia, Brazil", imdbId:"0060584", born:date('1933-05-23'), name:"Othon Bastos", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/86uykdZHCr1Stzg0fmUeQwIlsnc.jpg", url:"https://themoviedb.org/person/10061"}}, {tmdbId:"936090", properties:{imdbId:"0229489", born:date('1928-03-01'), name:"Maurício do Valle", died:date('1994-10-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rhE8wqTCs3SxTNAwn2NXrwDYu7R.jpg", url:"https://themoviedb.org/person/936090"}}, {tmdbId:"6836", properties:{bornIn:"Wexford, Ireland", imdbId:"0641397", born:date('1919-05-02'), name:"Dan O'Herlihy", bio:"Daniel Peter O'Herlihy (May 1, 1919 – February 17, 2005) was an Irish film actor, known for such roles as Brigadier General Warren A.  \"Blackie\" Black in Fail Safe, Marshal Ney in Waterloo, Conal Cochran in Halloween III: Season of the Witch, \"The Old Man\" in RoboCop, and Andrew Packard in Twin Peaks.  He was nominated for the Academy Award for Best Actor for the 1954 film Adventures of Robinson Crusoe...", died:date('2005-02-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vhZodGF9IiHdpbU78ShpyCgBr3X.jpg", url:"https://themoviedb.org/person/6836"}}, {tmdbId:"2651", properties:{bornIn:"Philadelphia, PA, USA", imdbId:"0083081", born:date('1916-09-12'), name:"Edward Binns", bio:"From Wikipedia, the free encyclopedia.   Edward Binns (September 12, 1916 – December 4, 1990) was an American stage, film, and television actor.  He had a wide-spanning career in film and television, often portraying competent, hard working, and purposeful characters in his various roles.   Binns was born in Philadelphia, Pennsylvania.  One of the first members of the newly formed Actors Studio, Binns began studying with Elia Kazanin the fall of 1947...", died:date('1990-12-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pxtrhwbCLpvLaZbA0X4E8XgUGj4.jpg", url:"https://themoviedb.org/person/2651"}}, {tmdbId:"105998", properties:{bornIn:"Greenford, Middlesex, England, UK", imdbId:"0328690", born:date('1931-08-07'), name:"Jack Good", died:date('2017-09-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ykCS15tFGO9dZB6kYVTfuPF2fKi.jpg", url:"https://themoviedb.org/person/105998"}}, {tmdbId:"9908", properties:{bornIn:"Zwickau, Germany", imdbId:"0002085", born:date('1913-02-25'), name:"Gert Fröbe", bio:"Karl Gerhart Fröbe, better known as Gert Fröbe (25 February 1913 – 5 September 1988) was a German actor who starred in many films, including the James Bond film Goldfinger as Auric Goldfinger, The Threepenny Opera as Peachum, Chitty Chitty Bang Bang as Baron Bomburst, and in Der Räuber Hotzenplotz as Hotzenplotz. \n\nDescription above from the Wikipedia article Gert Fröbe, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1988-09-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ApnMHQBCBFLt20eql5uWlBOWm9L.jpg", url:"https://themoviedb.org/person/9908"}}, {tmdbId:"9909", properties:{bornIn:"Edgeware, Middlesex, England, UK", imdbId:"0247881", born:date('1937-01-12'), name:"Shirley Eaton", bio:"Shirley Eaton (born 12 January 1937) is an English actress. \n\nEaton appeared regularly in British films throughout the 1950s and 1960s, and achieved notability for her performance as Bond Girl Jill Masterson in the 1964 James Bond film Goldfinger.  Preferring to devote herself to raising a family, Eaton retired from acting in 1969. \n\nDescription above from the Wikipedia article Shirley Eaton, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8MNJRRFl8qjOOwBIQvaX1rSUl4W.jpg", url:"https://themoviedb.org/person/9909"}}, {tmdbId:"940155", properties:{bornIn:"New York City, New York, USA", imdbId:"0236848", born:date('1914-10-07'), name:"Alfred Drake", bio:"Alfred Drake (October 7, 1914 - July 25, 1992) was an American actor and singer. \n\nBorn as Alfred Capurro in New York City, the son of parents emigrated from Recco, Genoa, Drake began his Broadway career while still a student at Brooklyn College...", died:date('1992-07-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wiGBEXtPExZpkHgrg9b2mTf7y8I.jpg", url:"https://themoviedb.org/person/940155"}}, {tmdbId:"232127", properties:{bornIn:"Glasgow, Scotland, UK", imdbId:"0379047", born:date('1918-03-08'), name:"Eileen Herlie", died:date('2008-10-08'), url:"https://themoviedb.org/person/232127"}}, {tmdbId:"27726", properties:{bornIn:"Morgantown, West Virgina, USA", imdbId:"0461455", born:date('1924-07-21'), name:"Don Knotts", bio:"Don Knotts (July 21, 1924 – February 24, 2006) was an American comedic actor best known for his portrayal of Barney Fife on The Andy Griffith Show and Ralph Furley on Three's Company...", died:date('2006-02-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cr1eyblxpQe4LBafMMuQ6BuOGzR.jpg", url:"https://themoviedb.org/person/27726"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"41730", properties:{bornIn:"Abilene, Texas, USA", imdbId:"0176946", born:date('1924-01-14'), name:"Carole Cook", bio:"​From Wikipedia, the free encyclopedia\n\nCarole Cook (b.  1928, Abilene, Texas) is an American actress.  She has appeared in many theatrical productions, in films and on television. \n\nBorn as Mildred Frances Cook, she was a protege of Lucille Ball.  Ball gave her the stage name of \"Carole\", after her friend Carole Lombard because, Ball reportedly told Cook, \"you have the same healthy disrespect for everything in general\".  Cook appeared regularly on two of her shows, The Lucy Show and Here's Lucy...", url:"https://themoviedb.org/person/41730"}}, {tmdbId:"726", properties:{bornIn:"Cleveland, Ohio", imdbId:"0922967", born:date('1924-08-21'), name:"Jack Weston", bio:"From Wikipedia, the free encyclopedia. \n\nJack Weston (born Jack Weinstein; August 21, 1924 – May 3, 1996) was an American film, stage, and television actor. \n\nWeston usually played comic roles in films such as Cactus Flower and Please Don't Eat the Daisies, but also occasionally essayed heavier parts, such as the scheming crook and stalker who, along with Alan Arkin and Richard Crenna, attempts to terrorize and rob a blind Audrey Hepburn in the 1967 film Wait Until Dark...", died:date('1996-05-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/huxN66E1BVXEvyICtOlcRfEekLU.jpg", url:"https://themoviedb.org/person/726"}}, {tmdbId:"86368", properties:{bornIn:"Franklin, Indiana, U.S.", imdbId:"0240887", born:date('1923-12-28'), name:"Andrew Duggan", bio:"​From Wikipedia, the free encyclopedia\n\nAndrew Duggan (December 28, 1923 – May 15, 1988) was a character actor. \n\nDescription above from the Wikipedia article Andrew Duggan, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1988-05-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gtgK1glZ1XJB6xwXUB8XUNqnd84.jpg", url:"https://themoviedb.org/person/86368"}}, {tmdbId:"19632", properties:{bornIn:"Lyon, France", imdbId:"0350196", born:date('1924-10-18'), name:"Georges Géret", died:date('1996-04-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/b8cIQk0sxwnF4snfMuG1S8lnH7V.jpg", url:"https://themoviedb.org/person/19632"}}, {tmdbId:"31819", properties:{bornIn:"Marseille, France", imdbId:"0525193", born:date('1914-08-10'), name:"Françoise Lugagne", bio:"Françoise Lugagne was born on August 10, 1914 in Marseille, France as Françoise Pauline Marguerite Marie Lugagne.  She was an actress...", died:date('1991-05-05'), url:"https://themoviedb.org/person/31819"}}, {tmdbId:"62019", properties:{bornIn:"Holdenville, Oklahoma, USA", imdbId:"0347656", born:date('1928-11-16'), name:"Clu Gulager", bio:"​From Wikipedia, the free encyclopedia. \n\nClu Gulager  (born November 16, 1928) is an American television and film actor.  He is particularly noted for his co-starring role as William H.  Bonney (Billy The Kid) in the 1960–62 NBC TV series The Tall Man and for his role in the later NBC series The Virginian.  He also appeared in the racing film Winning (1969), with Paul Newman and Joanne Woodward, and was the protagonist Burt in the horror movie The Return of the Living Dead (1985)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qlNfzKclL6jFUPdIaXTMPtgXg51.jpg", url:"https://themoviedb.org/person/62019"}}, {tmdbId:"72539", properties:{bornIn:"Hiroshima, Hiroshima Prefecture, Japan", imdbId:"0411146", born:date('1903-10-09'), name:"Kenjirô Ishiyama", bio:"Kenjiro Ishiyama (石山 健二郎) was a Japanese actor...", died:date('1976-05-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6Qc64jqkcRY1rQ7e8yRwhIFF0nB.jpg", url:"https://themoviedb.org/person/72539"}}, {tmdbId:"8949", properties:{bornIn:"New York City, New York, USA", imdbId:"0001228", born:date('1940-02-23'), name:"Peter Fonda", bio:"Peter Henry Fonda (February 23, 1940 – August 16, 2019) was an American actor.  He was the son of Henry Fonda, younger brother of Jane Fonda, and father of Bridget and Justin Fonda.  Fonda was a part of the counterculture of the 1960s. \n\nHe was nominated for the Academy Award for Best Original Screenplay for Easy Rider (1969), and the Academy Award for Best Actor for Ulee's Gold (1997).  For the latter, he won the Golden Globe Award for Best Actor – Motion Picture Drama...", died:date('2019-08-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dgorN06SQ9ZNL2NY3I7BNxg93lc.jpg", url:"https://themoviedb.org/person/8949"}}, {tmdbId:"33644", properties:{bornIn:"San Antonio, Texas, USA", imdbId:"0696038", born:date('1938-03-04'), name:"Paula Prentiss", bio:"Paula Prentiss (born March 4, 1938) is an American actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h7xNNLdKuEQYBy3UXXGnqd3VsxP.jpg", url:"https://themoviedb.org/person/33644"}}, {tmdbId:"32152", properties:{bornIn:"Eisenstadt, Burgenland, Austria", imdbId:"0675413", born:date('1938-09-23'), name:"Maria Perschy", bio:"From Wikipedia, the free encyclopedia. \n\nMaria Perschy (September 23, 1938 – December 3, 2004) was an Austrian actress. \n\nPerschy was born in Eisenstadt, Burgenland, Austria and moved to Vienna at the age of 17 to study acting.  After completing her education, she moved to Germany for more training, leading to a movie career.  Her first major success came with Nasser Asphalt where she played together with Horst Buchholz...", died:date('2004-12-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dGTfS6yM7UV6Zv76leRFFnwelIJ.jpg", url:"https://themoviedb.org/person/32152"}}, {tmdbId:"6932", properties:{bornIn:"Hamilton, Texas, USA", imdbId:"0490103", born:date('1922-09-23'), name:"Louise Latham", bio:"Was an American actress, perhaps best known for her portrayal of Bernice Edgar in Alfred Hitchcock's film Marnie (1964).  Most of her work has been on television, including appearances on The Alfred Hitchcock Hour, Perry Mason, Bonanza, Gunsmoke, Hawaii Five-O, Murder, She Wrote, Designing Women (as Perky, the mother of Julia and Suzanne Sugarbaker), and The X-Files...", died:date('2018-02-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oFKmPQLx5XPjTb81MWv60ERRwf9.jpg", url:"https://themoviedb.org/person/6932"}}, {tmdbId:"5825", properties:{bornIn:"Henley-on-Thames, Oxfordshire, England", imdbId:"0866835", born:date('1917-05-07'), name:"David Tomlinson", bio:"From Wikipedia, the free encyclopedia. \n\nDavid Cecil MacAlister Tomlinson (7 May 1917 – 24 June 2000) was an English film actor.  He is primarily remembered for his roles as authority figure George Banks in Mary Poppins, fraudulent magician Professor Emelius Browne in Bedknobs and Broomsticks and as hapless antagonist Peter Thorndyke in The Love Bug...", died:date('2000-06-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8T7Fg6nrZawCSic2hCGWmowh4fM.jpg", url:"https://themoviedb.org/person/5825"}}, {tmdbId:"22969", properties:{bornIn:"Willesden, London, England", imdbId:"0038870", born:date('1946-04-05'), name:"Jane Asher", bio:"From Wikipedia, the free encyclopedia. \n\nJane Asher (born 5 April 1946) is an English actress.  She has also developed a second career as a cake decorator and cake shop proprietor. \n\nDescription above from the Wikipedia article Jane Asher, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kXjhd6rsyo3qsL2nMdumTY9atKt.jpg", url:"https://themoviedb.org/person/22969"}}, {tmdbId:"101504", properties:{bornIn:" London, United Kingdom", born:date('1937-08-28'), name:"David Weston", bio:"From Wikipedia, the free encyclopedia. \n\nDavid Weston (born 28 July 1938, London) is an English actor, director and author.  Since graduating from RADA in 1961 (having won the Silver Medal for that year) he has acted in numerous film, television and stage productions, including twenty-seven plays in Shakespeare's canon.  With Michael Croft he was a founder member of the National Youth Theatre...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fmflOS4alxtFpm7RocZod5riI71.jpg", url:"https://themoviedb.org/person/101504"}}, {tmdbId:"67023", properties:{bornIn:"Tokyo, Japan", imdbId:"0395953", born:date('1943-12-06'), name:"Yuriko Hoshi", bio:"Yuriko Hoshi (星由里子 Hoshi Yuriko) was a Japanese actress.  As one of Toho's young stars in the 1960's, she played reporters in the Godzilla films Godzilla vs.  Mothra and Ghidorah, the Three-Headed Monster, as well as Yuichi Tanuma's girlfriend in the Young Guy series.  Hoshi passed away from lung cancer on May 16, 2018, at the age of 74...", died:date('2018-05-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oL5WSBLrvedSi45rWzLjfEZrBIo.jpg", url:"https://themoviedb.org/person/67023"}}, {tmdbId:"33728", properties:{bornIn:"Tottori, Japan", imdbId:"0652961", born:date('1925-10-01'), name:"Nobuko Otowa", bio:"From Wikipedia, the free encyclopedia. \n\nNobuko Otowa (1 October 1925 – 22 December 1994) was a Japanese film actress.  She appeared in 134 films between 1950 and 1994.  She was married to film director Kaneto Shindō.  She posthumously won the award for best supporting actress at the 19th Japan Academy Prize for A Last Note, having been diagnosed with terminal liver cancer during its production...", died:date('1994-12-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6vcByiFlOE9JiLGWNKRtN8k0uil.jpg", url:"https://themoviedb.org/person/33728"}}, {tmdbId:"33729", properties:{bornIn:"Tokyo, Japan", imdbId:"0949030", born:date('1943-04-18'), name:"Jitsuko Yoshimura", bio:"Jitsuko Yoshimura (吉村実子 Yoshimura Jitsuko, born 18 April 1943) is a Japanese actress.  She was discovered by Shohei Imamura as a newcomer and cast in the film Pigs and Battleships.  She went on to appear in The Insect Woman and Onibaba.  She retired from acting in 1970, but returned in 1980 and continues to work to this day...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wlH7kdIzQuTwOJDLmM9Qw43uf5z.jpg", url:"https://themoviedb.org/person/33729"}}, {tmdbId:"33730", properties:{bornIn:"Aizuwakamatsu, Fukushima Prefecture, Japan", imdbId:"0766225", born:date('1928-12-21'), name:"Kei Satô", died:date('2010-05-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xVTrBHHVWrGBQ3ubhTa8z8upb1R.jpg", url:"https://themoviedb.org/person/33730"}}, {tmdbId:"33731", properties:{bornIn:"Fukui Prefecture, Japan", imdbId:"0881303", born:date('1914-09-27'), name:"Jûkichi Uno", died:date('1988-01-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tZMckWALxqQbBfhFg0ETZifLbeO.jpg", url:"https://themoviedb.org/person/33731"}}, {tmdbId:"9109", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0501183", born:date('1923-04-15'), name:"Harvey Lembeck", bio:"​From Wikipedia, the free encyclopedia.   \n\nHarvey Lembeck (April 15, 1923 – January 5, 1982) was an American comedic actor best remembered for his role as Cpl.  Rocco Barbella on The Phil Silvers Show (a. k. a.  Sgt.  Bilko) in the late 1950s, and as the stumbling, overconfident outlaw biker Eric Von Zipper in the beach party movie series during the 1960s.  He also turned in noteworthy performances in both the stage and screen versions of Stalag 17...", died:date('1982-01-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fg0gT5Xe7tMftUmurzUthaiTFm0.jpg", url:"https://themoviedb.org/person/9109"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"50", properties:{bornIn:"Paris, France", imdbId:"0000366", born:date('1943-10-22'), name:"Catherine Deneuve", bio:"Catherine Deneuve (born 22 October 1943) is a French actress.  She gained recognition for her portrayal of aloof and mysterious beauties in films such as Repulsion (1965) and Belle de jour (1967).  Deneuve was nominated for an Academy Award for Best Actress in 1993 for her performance in Indochine; she also won César Awards for that film and The Last Metro (1980)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8gLHnVZ0dUFQrFbSrUALsdJiHYj.jpg", url:"https://themoviedb.org/person/50"}}, {tmdbId:"5476", properties:{bornIn:"Lecco, Lombardy, Italy", imdbId:"0144875", born:date('1936-10-28'), name:"Nino Castelnuovo", bio:"Francesco \"Nino\" Castelnuovo (born 28 October 1936) is an Italian actor of film, stage and television.  Castelnuovo appeared as Guy Foucher in the French-language musical film The Umbrellas of Cherbourg (1964) and as D'Agostino in the romantic-drama The English Patient (1996).  His other films include the drama Rocco and His Brothers (1960), the sexploitation Camille 2000 (1969), the black-comedy L'emmerdeur (A Pain in the . . ...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/njCBoU4eCfu2fF1F7p0HwWNXCgJ.jpg", url:"https://themoviedb.org/person/5476"}}, {tmdbId:"28608", properties:{bornIn:"Saint-Denis, Francia", imdbId:"0894636", born:date('1924-01-07'), name:"Anne Vernon", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/72IMYb2sHmhkfW2dnxUi9NoSCt6.jpg", url:"https://themoviedb.org/person/28608"}}, {tmdbId:"46936", properties:{imdbId:"0584879", name:"Marc Michel", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/b7QbG4DDom3uPv6FMaVgV9HlAAc.jpg", url:"https://themoviedb.org/person/46936"}}, {tmdbId:"16309", properties:{bornIn:"Munich, Germany", imdbId:"0462367", born:date('1931-08-19'), name:"Marianne Koch", bio:"From Wikipedia, the free encyclopedia. \n\nMarianne Koch (born August 19, 1931 in Munich) is a retired German actress of the 1950s and 1960s, best known for her appearances in spaghetti westerns and adventure films of the 1960s.  She later worked as a television host and as a physician. \n\nBetween 1950 and 1971, Koch appeared in more than 65 films.  In the haunting 1954 espionage thriller Night People she starred alongside Gregory Peck...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dx6TP6ncz83lIm5t0iDVmVFcevq.jpg", url:"https://themoviedb.org/person/16309"}}, {tmdbId:"14276", properties:{bornIn:"Milan, Italy", imdbId:"0002231", born:date('1933-04-09'), name:"Gian Maria Volontè", bio:"From Wikipedia, the free encyclopedia. \n\nGian Maria Volonté (9 April 1933 – 6 December 1994) was an Italian actor.  He is perhaps most famous outside of Italy for his roles as the main villain in Sergio Leone's A Fistful of Dollars (credited in the USA as \"Johnny Wels\") and For a Few Dollars More...", died:date('1994-12-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3Lu6rYNIzMZEaX2LHwzAiwvKKPe.jpg", url:"https://themoviedb.org/person/14276"}}, {tmdbId:"16310", properties:{bornIn:"Berlin, Germany", imdbId:"0525742", born:date('1905-10-19'), name:"Wolfgang Lukschy", bio:"From Wikipedia, the free encyclopedia. \n\nWolfgang Lukschy (born 19 October 1905 - 10 July 1983 in Berlin) was a German actor and dubber.  He performed in theater, film and television. \n\nHe made over 75 film and TV appearances between 1940 and 1979.  Possibly his most noted performances worldwide were his roles as Alfred Jodl in the 1962 American war film The Longest Day and as John Baxter in Sergio Leone's 1964 production A Fistful of Dollars alongside Clint Eastwood and Gian Maria Volonté...", died:date('1983-07-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v5phdporZ0xCC3vzFJ3nMtfJQM4.jpg", url:"https://themoviedb.org/person/16310"}}, {tmdbId:"105638", properties:{bornIn:"\tToronto, Ontario, Canada", imdbId:"0723982", born:date('1921-11-21'), name:"Billie Mae Richards", bio:"From Wikipedia;\n\n​Born as Billy Mae Dinsmore in Toronto, she was best known for voicing the role of Rudolph the Red-Nosed Reindeer in 1964's television special (credited as \"Billy Richards\" to mask the fact that she was a woman[1]). [2] She also voiced Tenderheart Bear in the first two Care Bears movies, as well as the DIC-produced television series (credited as \"Billie Mae Richard\"), and Brightheart Raccoon in the Nelvana-produced Care Bears television series...", died:date('2010-09-10'), url:"https://themoviedb.org/person/105638"}}, {tmdbId:"1215283", properties:{bornIn:"Toronto - Ontario - Canada", imdbId:"0813015", born:date('1930-08-11'), name:"Paul Soles", bio:"From Wikipedia, the free encyclopedia\n\nPaul Robert Soles (born 11 August 1930 at Toronto, Ontario)\n\nis a Canadian actor and television personality.  He is also one of the last three surviving cast members from Spider-Man (1967 TV series), the other two being Chris Wiggins and Carl Banas.   He is best known as the original voice of Hermey the misfit elf in Rankin/Bass' Rudolph the Red-Nosed Reindeer in 1964. \n\nSoles voiced the Bruce Banner character in the 1966 Incredible Hulk cartoon series...", url:"https://themoviedb.org/person/1215283"}}, {tmdbId:"144604", properties:{imdbId:"0542847", born:date('1922-12-22'), name:"Larry D. Mann", died:date('2014-01-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gFf4Pki8cPhSXGWe4Y0yDMMFg9r.jpg", url:"https://themoviedb.org/person/144604"}}, {tmdbId:"2383690", properties:{name:"Ernie Allo", url:"https://themoviedb.org/person/2383690"}}, {tmdbId:"2383691", properties:{name:"Bruce Byron", url:"https://themoviedb.org/person/2383691"}}, {tmdbId:"2383692", properties:{name:"Frank Carifi", url:"https://themoviedb.org/person/2383692"}}, {tmdbId:"2383693", properties:{name:"Steve Crandell", url:"https://themoviedb.org/person/2383693"}}, {tmdbId:"99503", properties:{bornIn:"Stuttgart, Germany", imdbId:"0707030", born:date('1926-10-29'), name:"Thomas Reiner", url:"https://themoviedb.org/person/99503"}}, {tmdbId:"99505", properties:{imdbId:"0330965", name:"Ariana Gorini", url:"https://themoviedb.org/person/99505"}}, {tmdbId:"40209", properties:{bornIn:"Mount Vernon, Ohio, USA", imdbId:"0001489", born:date('1926-06-13'), name:"Paul Lynde", bio:"Paul Lynde was born in 1926 in Mount Vernon, Ohio (one of six children and the middle of four boys).  His father was a local police officer and the sheriff of the Mount Vernon Jail for two years.  Lynde got his inspiration to become an actor at the age of four or five after his mother took him to see the original silent film Ben-Hur: A Tale of the Christ (1925)...", died:date('1982-01-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/buLQiKpBLc9uY2ijU0Pm1lbBibD.jpg", url:"https://themoviedb.org/person/40209"}}, {tmdbId:"2337098", properties:{name:"Douglas Keay", url:"https://themoviedb.org/person/2337098"}}, {tmdbId:"556915", properties:{imdbId:"0049694", name:"Bruce Balden", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/t0GzUO0MdGP789OdFT9Nxg2lg2t.jpg", url:"https://themoviedb.org/person/556915"}}, {tmdbId:"556916", properties:{imdbId:"0060212", name:"Jacqueline Bassett", bio:"Jacqueline Bassett is one of the participants in the iconic 7 Up series...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oTvI2zkbL514yEfZ7WDBQn2FVv7.jpg", url:"https://themoviedb.org/person/556916"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"556917", properties:{imdbId:"0060420", name:"Symon Basterfield", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4vaiPKd0WQxfSE1CS9ROD5wDNAq.jpg", url:"https://themoviedb.org/person/556917"}}, {tmdbId:"17844", properties:{bornIn:"Berlin, Germany", imdbId:"0813961", born:date('1940-11-05'), name:"Elke Sommer", bio:"Elke Sommer, born Elke  von Schletz, is a German-born actress, entertainer and artist, who has starred in many Hollywood films.   She was spotted by film director Vittorio De Sica while on holiday in Italy, and began appearing in films there in 1958.   Also that year, she changed her surname from Schletz to Sommer, which was easier to pronounce for a non-German audience.   She quickly became a noted sex symbol and moved to Hollywood in the early 1960s...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4EjmIcSXc6qyI181FYl2y1hLabL.jpg", url:"https://themoviedb.org/person/17844"}}, {tmdbId:"108773", properties:{bornIn:"Havana, Cuba", imdbId:"0180959", born:date('1939-03-02'), name:"Sergio Corrieri", died:date('2008-02-29'), url:"https://themoviedb.org/person/108773"}}, {tmdbId:"1349308", properties:{bornIn:"Santiago de Cuba, Cuba", imdbId:"0939991", born:date('1928-11-24'), name:"Salvador Wood", bio:"Nació el 24 de noviembre de 1928, en Santiago de Cuba, donde mismo nació su compañera de la vida, Yolanda.  Sus padres eran santiagueros y por la estirpe paterna de los Wood, fue el único que tuvo el coraje de ser actor de teatro, de radio, de televisión y de cine.  \n\nLlegó a La Habana en 1946, en busca de un espacio que tuviera una mayor resonancia nacional, aunque estaba convencido de que el municipio es el universo, pero a veces es bueno salir del municipio...", url:"https://themoviedb.org/person/1349308"}}, {tmdbId:"1293291", properties:{imdbId:"0302615", name:"José Gallardo", url:"https://themoviedb.org/person/1293291"}}, {tmdbId:"1060325", properties:{imdbId:"0306456", name:"Raúl García", url:"https://themoviedb.org/person/1060325"}}, {tmdbId:"91371", properties:{bornIn:"Woodstock, Illinois, USA", imdbId:"0714793", born:date('1936-05-02'), name:"Quinn K. Redeker", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3oVdl0QPKxqCTmrGNffNk66gK0s.jpg", url:"https://themoviedb.org/person/91371"}}, {tmdbId:"15983", properties:{bornIn:"Los Angeles, California, USA ", imdbId:"0913340", born:date('1943-11-25'), name:"Beverly Washburn", bio:"Beverly Washburn was born on November 25, 1943 in Los Angeles, California, USA.  She is an actress, known for Old Yeller (1957), Spider Baby or, The Maddest Story Ever Told(1967) and Here Comes the Groom (1951)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8xBBWKROla25rgmCzKcbcGB8TqY.jpg", url:"https://themoviedb.org/person/15983"}}, {tmdbId:"94188", properties:{bornIn:"Suginami, Tokyo, Japan", imdbId:"0457219", born:date('1930-04-29'), name:"Kyôko Kishida", bio:"From Wikipedia, the free encyclopedia\n\nKyōko Kishida (April 29, 1930 – December 17, 2006) was a Japanese actress, voice actress, and writer of children's books. \n\nHer father was Kunio Kishida, a playwright and the founder of the Bungaku-za.  She became an actress in 1950, and starred in a Yukio Mishima production of Salome (1960).  Her film and television drama credits number in the hundreds...", died:date('2006-12-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eWBKOdjAJF0Z0K1DGH2vum400c5.jpg", url:"https://themoviedb.org/person/94188"}}, {tmdbId:"555339", properties:{bornIn:"Eifuku, Tokyo, Japan", imdbId:"0411694", born:date('1937-07-15'), name:"Hiroko Itô", url:"https://themoviedb.org/person/555339"}}, {tmdbId:"96804", properties:{bornIn:"Yokohama, Japan", imdbId:"0594062", born:date('1910-03-06'), name:"Kôji Mitsui", died:date('1979-07-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nahTXDNpFHNfKMraAHNDYiLXBM.jpg", url:"https://themoviedb.org/person/96804"}}, {tmdbId:"96209", properties:{bornIn:"Чортория, Чернівецької області", imdbId:"0586645", born:date('1941-06-15'), name:"Ivan Mykolaichuk", bio:"Ivan Vasylyovych Mykolaichuk (Ukrainian: Іван Васильович Миколайчук) was a Ukrainian soviet actor, producer, and screen writer from Ukraine. \n\nHe is best known for playing the Hutsul Ivan in \"Shadows of Forgotten Ancestors\" (Тіні забутих предків) (1964), based on Mykhailo Kotsyubynsky's book of the same name.  He received the Komsomol prize of Ukraine in 1967, and the title of Meritorious Artist of the Ukrainian SSR in 1968.  He posthumously received the Taras Shevchenko prize...", died:date('1987-08-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pac3Mi3RFqYxMf3VSPrAKLyuYAa.jpg", url:"https://themoviedb.org/person/96209"}}, {tmdbId:"96210", properties:{imdbId:"0434389", born:date('1937-08-30'), name:"Larisa Kadochnikova", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/imuP0KfLLP6FKoILGXqbpvBOEkX.jpg", url:"https://themoviedb.org/person/96210"}}, {tmdbId:"96211", properties:{imdbId:"0079015", name:"Tatyana Bestayeva", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sbXl6ZqyIMhJmGk5H6GNnEz8QBO.jpg", url:"https://themoviedb.org/person/96211"}}, {tmdbId:"96212", properties:{bornIn:"Tiflis, Russian Empire [now Tbilisi, Republic of Georgia]", imdbId:"0046528", born:date('1914-08-07'), name:"Spartak Bagashvili", died:date('1977-02-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xpgHhKcxcEuUQScyFQ2VAkCDLTk.jpg", url:"https://themoviedb.org/person/96212"}}, {tmdbId:"99966", properties:{imdbId:"0020639", name:"Jeffrey Allen", url:"https://themoviedb.org/person/99966"}}, {tmdbId:"99973", properties:{imdbId:"0515300", name:"Shelby Livingston", url:"https://themoviedb.org/person/99973"}}, {tmdbId:"3907", properties:{bornIn:"Modesto, California, USA", imdbId:"0696193", born:date('1933-09-14'), name:"Harve Presnell", bio:"Harve Presnell (September 14, 1933 – June 30, 2009) was an American actor and singer.  He began his career in the mid 1950s as a classical baritone, singing with orchestras and opera companies throughout the United States.  His career reoriented away from classical music to musical theatre in 1960 after Meredith Willson cast him in the lead role of his new Broadway musical The Unsinkable Molly Brown...", died:date('2009-06-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6BgiGFxDqbnb4Hjak1A60Ypx3xQ.jpg", url:"https://themoviedb.org/person/3907"}}, {tmdbId:"4094", properties:{bornIn:"Winnipeg, Manitoba, Canada", imdbId:"0472816", born:date('1922-03-20'), name:"Jack Kruschen", bio:"​From Wikipedia, the free encyclopedia\n\nJacob Kruschen (March 20, 1922 – April 2, 2002) was a Jewish character actor who worked primarily in American film, television and radio.  Kruschen was nominated for the Academy Award for Best Supporting Actor for his role as Dr.  Dreyfuss in the 1960 comedy-drama The Apartment. \n\nDescription above from the Wikipedia article Jack Kruschen, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2002-04-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3QOPlFyLfFR8cLe0pseRjrm3lra.jpg", url:"https://themoviedb.org/person/4094"}}, {tmdbId:"95239", properties:{bornIn:"Barcelona, Spain", imdbId:"0409820", born:date('1944-07-05'), name:"Enrique Irazoqui", url:"https://themoviedb.org/person/95239"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"95240", properties:{imdbId:"0142318", name:"Margherita Caruso", url:"https://themoviedb.org/person/95240"}}, {tmdbId:"95242", properties:{imdbId:"0664666", name:"Susanna Pasolini", url:"https://themoviedb.org/person/95242"}}, {tmdbId:"95243", properties:{imdbId:"0603091", name:"Marcello Morante", url:"https://themoviedb.org/person/95243"}}, {tmdbId:"15857", properties:{bornIn:"Croydon, Surrey, England", imdbId:"0095718", born:date('1927-12-19'), name:"James Booth", bio:"From Wikipedia, the free encyclopedia\n\nJames Booth (born David Geeves; 19 December 1927 - 11 August 2005) was an English film, stage and television actor and screenwriter.  Though handsome enough to play leading roles, and versatile enough to play a wide variety of character parts, Booth naturally projected a shifty, wolfish, or unpredictable quality that led inevitably to villainous roles and comedy, usually with a cockney flavour...", died:date('2005-08-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lar15H1w85zWXQGg41PNdwWOc0o.jpg", url:"https://themoviedb.org/person/15857"}}, {tmdbId:"45467", properties:{bornIn:"Mooloolaba, Queensland, Australia", imdbId:"0162284", born:date('1933-10-05'), name:"Diane Cilento", bio:"Diane Cilento (born 5 October 1933 in Mooloolaba, Queensland, Australia) is an Australian theatre and film actress and author.   Cilento's parents, Sir Raphael Cilento  and Lady (Phyllis) Cilento,  were both distinguished medical practitioners.   At a young age she decided to follow a career as an actress, and after a period living with her father in New York, won a scholarship to RADA and moved to England in the early 1950s...", died:date('2011-10-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l1tWBdmuETjhMbrvdA4sngrkrUb.jpg", url:"https://themoviedb.org/person/45467"}}, {tmdbId:"19463", properties:{bornIn:"Tonbridge, Kent, England, UK", imdbId:"0028674", born:date('1911-11-10'), name:"Harry Andrews", bio:"​From Wikipedia, the free encyclopedia.   \n\nHarry Fleetwood Andrews, CBE (10 November 1911 – 6 March 1989) was an English film actor known for his frequent portrayals of tough military officers.  His performance as Sergeant Major Wilson in The Hill alongside Sean Connery earned Andrews the 1965 National Board of Review Award for Best Supporting Actor and a nomination for the 1966 BAFTA Award for Best British Actor.  He made his film debut in The Red Beret in 1953...", died:date('1989-03-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vbW1W5NK5UK4rC1g33yWXzLlyZR.jpg", url:"https://themoviedb.org/person/19463"}}, {tmdbId:"70626", properties:{bornIn:"Matsudo, Chiba Prefecture, Japan", imdbId:"0945734", born:date('1936-12-02'), name:"Tsutomu Yamazaki", bio:"​From Wikipedia, the free encyclopedia.   \n\nTsutomu Yamazaki (山崎 努 Yamazaki Tsutomu) (born December 2, 1936 in Matsudo, Chiba Prefecture, Japan) is a Japanese actor. \n\nHe has been nominated for seven Japanese Academy Awards, winning Best Actor awards for the Juzo Itami comedies The Funeral and A Taxing Woman, and the Best Supporting Actor awards for Go and Departures.  He also won the Blue Ribbon Award for Best Actor in 1984 for The Funeral and Farewell to the Ark...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/A4M3eER4ChkV5VebYSpLUEUyrez.jpg", url:"https://themoviedb.org/person/70626"}}, {tmdbId:"131203", properties:{bornIn:"Kyoto City, Kyoto, Japan", imdbId:"0199029", born:date('1935-03-26'), name:"Reiko Dan", bio:"Reiko Dan (団 令子 Dan Reiko, 26 March 1935  – 24 November 2003), real name Reiko Hamada (浜田 令子 Hamada Reiko), was a Japanese actress.  She appeared in multiple films between 1957 and 1974, such as Sanjuro and Red Beard.  She retired in 1974, coming back briefly from the late 1980s to 1990 to support her son, Yuta Dan (1967–2006), who was also an actor...", died:date('2003-11-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vWf9CjjIjzOSTmD5W7RqejWabK7.jpg", url:"https://themoviedb.org/person/131203"}}, {tmdbId:"19794", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0176061", born:date('1917-10-29'), name:"Eddie Constantine", bio:"​From Wikipedia, the free encyclopedia. \n\nEddie Constantine  (born Edward Constantinowsky; October 29, 1917, Los Angeles, California – February 25, 1993, Wiesbaden, Germany) was an American-born French actor and singer who spent his career working in Europe. \n\nHe became well-known for a series of French B movies in which he played secret agent Lemmy Caution and is now best remembered for his role in Jean-Luc Godard's philosophical science fiction film Alphaville...", died:date('1993-02-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rhxMbjrygEvvxOKJIGiSeXntTN5.jpg", url:"https://themoviedb.org/person/19794"}}, {tmdbId:"39953", properties:{bornIn:"Paris, France", imdbId:"0552483", born:date('1922-03-06'), name:"Jean Martin", bio:"​From Wikipedia, the free encyclopedia.   \n\nJean Martin (March 6, 1922 – February 2, 2009) was a French actor of stage and screen.  Martin served in the French Resistance during World War II and later fought with the French paratroopers in Indochina.  Theatrically, he is perhaps best-known for originating two roles in Samuel Beckett's most famous plays: Lucky in Waiting for Godot, and Clov in Endgame...", died:date('2009-02-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/f7J7ItHt6AHz8z2PQuWpdH0lCHz.jpg", url:"https://themoviedb.org/person/39953"}}, {tmdbId:"557864", properties:{bornIn:"Algiers, Algeria", imdbId:"0754272", born:date('1928-01-20'), name:"Yacef Saadi", bio:"From Wikipedia, the free encyclopedia. \n\nSaadi Yacef (born January 20, 1928) was one of the leaders of Algeria's National Liberation Front during his country's war of independence.  He is currently a Senator in Algeria's Council of the Nation. \n\nYacef was born in Algiers.  He started his working life as an apprentice baker...", url:"https://themoviedb.org/person/557864"}}, {tmdbId:"140996", properties:{bornIn:"Alger, Algeria", imdbId:"0352835", born:date('1934-02-01'), name:"Brahim Hadjadj", died:date('1996-03-08'), url:"https://themoviedb.org/person/140996"}}, {tmdbId:"1077247", properties:{imdbId:"0449198", name:"Samia Kerbash", url:"https://themoviedb.org/person/1077247"}}, {tmdbId:"148603", properties:{bornIn:"Bridgeport, Connecticut, U.S.A.", imdbId:"0909117", born:date('1941-08-12'), name:"Deborah Walley", bio:"From Wikipedia, the free encyclopedia.  Deborah Walley (12 August 1941-10 May 2001) was an American actress. \n\nDescription above from the Wikipedia article Deborah Walley, licensed under CC-BY-SA,full list of contributors on Wikipedia...", died:date('2001-05-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yTJ3jxQO9HTHWTIiSsB9q9dC0ot.jpg", url:"https://themoviedb.org/person/148603"}}, {tmdbId:"7504", properties:{bornIn:"New York City, New York, USA", imdbId:"0528595", born:date('1942-02-13'), name:"Carol Lynley", bio:"From Wikipedia, the free encyclopedia\n\nCarol Lynley (born Carole Ann Jones; February 13, 1942 – September 3, 2019) was an American actress and child model. \n\nLynley began her career as a child model under the name Carolyn Lee.  She started acting after appearing on the April 22, 1957, cover of LIFE at 15...", died:date('2019-09-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9dxF0lP9OOKXZjSaidxIXXvKT4p.jpg", url:"https://themoviedb.org/person/7504"}}, {tmdbId:"20127", properties:{bornIn:"Buenos Aires, Argentina", imdbId:"0402558", born:date('1900-01-30'), name:"Martita Hunt", bio:"From Wikipedia, the free encyclopedia\n\nMartita Edith Hunt (30 January 1900 – 13 June 1969) was an Argentine-born British theatre and film actress.  She had a dominant stage presence and played a wide range of powerful characters.  She is best remembered for her performance as Miss Havisham in David Lean's Great Expectations...", died:date('1969-06-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/krc7QPLzjrEHmyZbFpj0wU24hLJ.jpg", url:"https://themoviedb.org/person/20127"}}, {tmdbId:"6352", properties:{bornIn:"New York City, New York, USA", imdbId:"0000404", born:date('1937-12-21'), name:"Jane Fonda", bio:"Jane Seymour Fonda (born December 21, 1937) is an American actress, political activist, and former fashion model.  She is the recipient of various accolades including two Academy Awards, two BAFTA Awards, seven Golden Globe Awards, a Primetime Emmy Award, the AFI Life Achievement Award, and the Honorary Golden Lion...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uF48Qq1frslzSQuQsV75Uq1v0ou.jpg", url:"https://themoviedb.org/person/6352"}}, {tmdbId:"70260", properties:{bornIn:" Los Angeles, California, USA", imdbId:"0382722", born:date('1934-05-18'), name:"Dwayne Hickman", bio:"​From Wikipedia, the free encyclopedia.     Dwayne Bernard Hickman (born May 18, 1934) is a former American actor and television executive at CBS. \n\nHe is known primarily for his \"teenage\" actor roles on television sitcoms.  The naturally brown-headed Hickman is best known for playing Chuck MacDonald, Bob Collins's (played by Bob Cummings) crazy teenaged nephew, on the popular 1950s series, The Bob Cummings Show (a. k. a...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xGm8taEKsukQABdCTkIviG1cRMu.jpg", url:"https://themoviedb.org/person/70260"}}, {tmdbId:"124654", properties:{imdbId:"0022817", name:"Ann Altieri", url:"https://themoviedb.org/person/124654"}}, {tmdbId:"148104", properties:{imdbId:"0233358", name:"Chris Doran", url:"https://themoviedb.org/person/148104"}}] AS row
