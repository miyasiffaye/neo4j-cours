UNWIND [{tmdbId:"1147927", properties:{imdbId:"4629658", name:"Gary Slutkin", url:"https://themoviedb.org/person/1147927"}}, {tmdbId:"52564", properties:{bornIn:"Fort Davis, Texas, USA", imdbId:"2827673", name:"Dillon Freasier", bio:"From Wikipedia, the free encyclopedia\n\nDillon Freasier (born 1996) is an American actor known for his role as H. W.  Plainview alongside Daniel Day-Lewis in the 2007 film There Will Be Blood. \n\nDescription above from the Wikipedia article Dillon Freasier, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/52564"}}, {tmdbId:"86392", properties:{bornIn:"Seattle, Washington, U.S.", imdbId:"0001342", born:date('1942-11-27'), name:"Jimi Hendrix", bio:"James Marshall \"Jimi\" Hendrix (born Johnny Allen Hendrix, November 27, 1942 – September 18, 1970) was an American guitarist and singer-songwriter.  He is widely considered to be the greatest electric guitarist in musical history, and one of the most influential musicians of his era across a range of genres. \n\nDescription above from the Wikipedia article Jimi Hendrix, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1970-09-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/piEhkTfjxS8qLiMhgZmtcgvS33Y.jpg", url:"https://themoviedb.org/person/86392"}}, {tmdbId:"54881", properties:{bornIn:"San Antonio, Texas, USA", imdbId:"1132359", born:date('1981-07-24'), name:"Summer Glau", bio:"Summer Lyn Glau  (born July 24, 1981, height 5' 6\" (1,68 m)) is an American actress, known for playing River Tam in the science fiction series Firefly and follow-up movie Serenity and for playing Cameron in the series Terminator: The Sarah Connor Chronicles...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/17eWfqG9SZeRNx8AQctajX06Ik5.jpg", url:"https://themoviedb.org/person/54881"}}, {tmdbId:"52969", properties:{bornIn:"\tToronto, Ontario, Canada", imdbId:"0712908", born:date('1972-04-04'), name:"Lisa Ray", bio:"Lisa Rani Ray is a Canadian actress, model, television host, philanthropist and social activist.  In 2005 she appeared in the Canadian film Water, which premièred at the Toronto International Film Festival.  In 2008 she starred alongside Sheetal Sheth in the romance films I Can't Think Straight and The World Unseen. \n\nRay made her Indian cinematic debut in 1994 with the Tamil film Nethaji, alongside Sarath Kumar, in which she appeared in a brief role...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/38TeusBORjoJodJjwRjEIt8Zgx8.jpg", url:"https://themoviedb.org/person/52969"}}, {tmdbId:"52970", properties:{imdbId:"1084553", name:"Sarala", url:"https://themoviedb.org/person/52970"}}, {tmdbId:"52898", properties:{bornIn:"Shanghai, China", imdbId:"2111748", born:date('1982-09-26'), name:"Sun Li", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vb1m4ST57ryWEcm6MKBKVsg3auw.jpg", url:"https://themoviedb.org/person/52898"}}, {tmdbId:"52899", properties:{bornIn:"Hangzhou, Zhejiang, China", imdbId:"1275406", born:date('1968-12-15'), name:"Dong Yong", url:"https://themoviedb.org/person/52899"}}, {tmdbId:"1098082", properties:{imdbId:"0637163", name:"Julietta Novis", url:"https://themoviedb.org/person/1098082"}}, {tmdbId:"1210414", properties:{name:"Yu Hai", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2IRXLdd3MuE3KPNo0AdH9wc8BGr.jpg", url:"https://themoviedb.org/person/1210414"}}, {tmdbId:"539215", properties:{name:"Burt Williams", url:"https://themoviedb.org/person/539215"}}, {tmdbId:"56696", properties:{imdbId:"0594617", born:date('1961-10-14'), name:"Isaac Mizrahi", bio:"From Wikipedia, the free encyclopedia.   Isaac Mizrahi (Born October 14, 1961) is an American TV presenter, fashion designer, and was the creative director of Liz Claiborne.  He is best known for his eponymous fashion lines.   Description above from the Wikipedia article Isaac Mizrahi, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/56696"}}, {tmdbId:"11644", properties:{imdbId:"0216378", name:"Henri Delannoy", url:"https://themoviedb.org/person/11644"}}, {tmdbId:"53243", properties:{imdbId:"2187857", name:"Afran Usman", url:"https://themoviedb.org/person/53243"}}, {tmdbId:"53396", properties:{bornIn:"Hillingdon, Middlesex, England", imdbId:"0939976", born:date('1947-06-01'), name:"Ron Wood", bio:"Ronald David \"Ronnie\" Wood (born 1 June 1947) is an English rock guitarist and bassist best known as a former member of The Jeff Beck Group, Faces, and current member of The Rolling Stones.  He is known for his characteristic slide guitar style, and also plays lap and pedal steel guitar.  Wood began his career in 1964, when he joined The Birds on guitar.  He then joined the mod group The Creation, but only remained with the group for a short time, and appeared on a small number of singles...", url:"https://themoviedb.org/person/53396"}}, {tmdbId:"590876", properties:{imdbId:"0310511", name:"Francisca Gavilán", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/s8k9fX4nH5AgHd9r7DpfZb7yLoR.jpg", url:"https://themoviedb.org/person/590876"}}, {tmdbId:"13696", properties:{bornIn:"Baden, Switzerland", imdbId:"0894677", born:date('1914-07-15'), name:"Howard Vernon", bio:"​From Wikipedia, the free encyclopedia. \n\nHoward Vernon (15 July 1914, Baden, Switzerland — 25 July 1996, Paris, France) was a Swiss actor. \n\nVernon was born Mario Lippert to a Swiss father and an American mother and was fluent in German, English, and French.  Originally a stage and radio actor, he worked primarily in France and became a well-known supporting actor after 1945 by playing villainous Nazi officers in French films...", died:date('1996-07-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wi74uKxjeih5oAXyCTntc00RYF0.jpg", url:"https://themoviedb.org/person/13696"}}, {tmdbId:"12190", properties:{imdbId:"0297740", name:"Yoshikatsu Fujiki", url:"https://themoviedb.org/person/12190"}}, {tmdbId:"48883", properties:{bornIn:"Potsdam, Brandenburg, Germany", imdbId:"0061088", born:date('1977-03-02'), name:"Neelesha BaVora", bio:"Neelesha Barthel was born on March 2, 1977 in Potsdam, Brandenburg, Germany.  She is an actress and director, known for Marry Me! (2015), Pandorum (2009) and Samsara (2001)...", url:"https://themoviedb.org/person/48883"}}, {tmdbId:"54620", properties:{bornIn:"Sarajevo, Bosnia and Herzegovina, Yugoslavia (now Sarajevo, Bosnia and Herzegovina)", imdbId:"0229301", born:date('1962-05-28'), name:"Branko Đurić", bio:"​From Wikipedia, the free encyclopedia\n\nBranko \"Đuro\" Đurić (born May 28, 1962) is a Bosnian actor, director and musician from Bosnia and Herzegovina.  Born to a Serb father and Bosniak mother in Sarajevo, Đurić rose to prominence throughout the former Yugoslavia with the hit comedy series Top Lista Nadrealista during the 1980s.  Đuro became something of an epitome for the Bosnian people, primarily due to his accent and slang...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7AauDZUo39COLQmFxHJoAoUoX4O.jpg", url:"https://themoviedb.org/person/54620"}}] AS row
