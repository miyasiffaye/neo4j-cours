UNWIND [{tmdbId:"2252509", properties:{bornIn:"Galway, Ireland", born:date('1956-05-05'), name:"Mary Coughlan", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5pDsF9CGWpFfD5RYN9zL9whTTzK.jpg", url:"https://themoviedb.org/person/2252509"}}, {tmdbId:"7320", properties:{bornIn:"Scunthorpe, Lincolnshire, England, UK", imdbId:"0809131", born:date('1921-12-11'), name:"Liz Smith", bio:"British character actress (NOT the gossip columnist) best known for TV's THE ROYLE FAMILY (1998-2006).  She also had recurring roles on such series as EMMERDALE (1975), I DIDN'T KNOW YOU CARED (1975-79), THE ALL ELECTRIC AMUSEMENT ARCADE (1983), NOW AND THEN (1983), ONE BY ONE (1984), MANN'S BEST FRIENDS (1985), VALENTINE PARK (1987-88), CLUEDOC (1993), THE VICAR OF DIBLEY (1994-96), 2POINT4 CHILDREN (1991-99), THE QUEEN'S NOSE (1996-99), and LARK RISE TO CANDLEFORD (2008)...", died:date('2016-12-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rzLKdR5XGD8J0241xIwWz3yfZhd.jpg", url:"https://themoviedb.org/person/7320"}}, {tmdbId:"72413", properties:{bornIn:"Japan", imdbId:"0851302", born:date('1972-01-01'), name:"Tsutomu Tatsumi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pmOjSeSAnkdFB9T5ns0gNMf3F0C.jpg", url:"https://themoviedb.org/person/72413"}}, {tmdbId:"72414", properties:{bornIn:"Japan", imdbId:"0794186", born:date('1982-01-01'), name:"Ayano Shiraishi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yq981A4jzvSx5z1xfMoDadcDOhn.jpg", url:"https://themoviedb.org/person/72414"}}, {tmdbId:"72415", properties:{bornIn:"Osaka Prefecture, Japan", imdbId:"0794002", born:date('1948-09-10'), name:"Yoshiko Shinohara", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w8hehpMlqENEfph7Huys6KpdIbr.jpg", url:"https://themoviedb.org/person/72415"}}, {tmdbId:"2527192", properties:{bornIn:"Osaka Prefecture, Japan", born:date('1946-11-23'), name:"Akemi Yamaguchi", url:"https://themoviedb.org/person/2527192"}}, {tmdbId:"96082", properties:{bornIn:"Tokyo, Japan", imdbId:"0648780", born:date('1933-02-18'), name:"Yoko Ono", bio:"Yoko Ono is a Japanese artist, musician, author and peace activist, known for her work in avant-garde art, music and filmmaking as well as her marriage to John Lennon.  Ono brought feminism to the forefront through her music which prefigured New Wave music (whether she was a direct influence is still debated).   She is a supporter of gay rights  and is known for her philanthropic contributions to the arts, peace and AIDS outreach programs...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j254dQthJu2rR1DRXqRkvo1oUqN.jpg", url:"https://themoviedb.org/person/96082"}}, {tmdbId:"71033", properties:{bornIn:"Vancouver, British Columbia, Canada", imdbId:"0401936", born:date('1960-12-27'), name:"Mark Humphrey", bio:"​From Wikipedia, the free encyclopedia.   \n\nMark Adrian Humphrey (born December 27, 1960 in Vancouver, British Columbia) is a Canadian actor best known for the role of Jake Antonelli in the Canadian television series E. N. G.  In 1988 he made his feature film debut in the film Iron Eagle II as Captain Matt Cooper, Doug Masters' (Jason Gedrick) surviving best friend.  Humphrey has been featured in other films and in several television movies...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eNp7wabaGv2dv5tZEeEuAnMuC7q.jpg", url:"https://themoviedb.org/person/71033"}}, {tmdbId:"41406", properties:{bornIn:"Davenport, Iowa, USA", imdbId:"0546765", born:date('1940-01-31'), name:"Stuart Margolin", bio:"​From Wikipedia, the free encyclopedia.   \n\nStuart Margolin (born January 31, 1940) is an American film and television actor and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/feqebzlB6BT9i7pMJansJPyWbMW.jpg", url:"https://themoviedb.org/person/41406"}}, {tmdbId:"26075", properties:{bornIn:"London, England, United Kingdom", imdbId:"0769154", born:date('1946-06-08'), name:"Alan Scarfe", bio:"​From Wikipedia, the free encyclopedia.   \n\nAlan John Scarfe (born June 8, 1946) is a British-born Genie Award winning Canadian actor.  He is a former Associate Director of the Stratford Festival and the Everyman Theatre in Liverpool.  He won the 1985 Genie Award for Best Performance by an Actor in a Supporting Role for his role in The Bay Boy and earned two other Genie best actor nominations as well as a Gemini Award nomination...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hWgEcBVVBDse6ZZ9N96Xupsa2xI.jpg", url:"https://themoviedb.org/person/26075"}}, {tmdbId:"139", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0000235", born:date('1970-04-29'), name:"Uma Thurman", bio:"Uma Karuna Thurman (born April 29, 1970) is an American actress and model.  She has performed in leading roles in a variety of films, ranging from romantic comedies and dramas to science fiction and action movies.  Following early roles in films such as Dangerous Liaisons (1988), she rose to international prominence in 1994 following her role in Quentin Tarantino's Pulp Fiction for which she was nominated for an Academy Award, a BAFTA Award and a Golden Globe Award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pGyACejvvLI6tB0gFQ2rCjwqKvd.jpg", url:"https://themoviedb.org/person/139"}}, {tmdbId:"25834", properties:{bornIn:"Halifax - Nova Scotia - Canada", imdbId:"0394012", born:date('1965-05-06'), name:"Leslie Hope", bio:"​From Wikipedia, the free encyclopedia\n\nLeslie Ann Hope (born May 6, 1965, height 5' 7½\" (1,71 m)) is a Canadian actress and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pLvZqTqyAh0YmC7egk460I5py42.jpg", url:"https://themoviedb.org/person/25834"}}, {tmdbId:"159056", properties:{imdbId:"0870257", born:date('1950-05-24'), name:"Alan Toy", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/okj4wDau7kfMmDViuPs58BxkiN2.jpg", url:"https://themoviedb.org/person/159056"}}, {tmdbId:"66459", properties:{bornIn:"Ostrowiec Świetokrzyski, Świetokrzyskie, Poland", imdbId:"0048121", born:date('1953-12-15'), name:"Miroslaw Baka", bio:"From Wikipedia, the free encyclopedia. \n\nMirosław Baka (born December 15, 1953 in Ostrowiec Świętokrzyski) is a Polish actor.  He appeared in the comedy television series Bao-Bab, czyli zielono mi in 2003. \n\nDescription above from the Wikipedia article Mirosław Baka, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/BV3u45dwZlaB82t4cfh6REK7cR.jpg", url:"https://themoviedb.org/person/66459"}}, {tmdbId:"66460", properties:{bornIn:" Siemianowice Slaskie, Slaskie, Poland", imdbId:"0322937", born:date('1957-01-16'), name:"Krzysztof Globisz", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fhg3OT06C2GJcjj1YhG9aDmVZP5.jpg", url:"https://themoviedb.org/person/66460"}}, {tmdbId:"66462", properties:{imdbId:"0856227", born:date('1935-08-04'), name:"Jan Tesarz", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kWsAyzK0dEHzById0WeRErLkV1t.jpg", url:"https://themoviedb.org/person/66462"}}, {tmdbId:"1405", properties:{imdbId:"0953168", born:date('1934-09-13'), name:"Zbigniew Zapasiewicz", died:date('2009-07-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4AuSdfnmOLTYGpRoLfUvRmBZvWG.jpg", url:"https://themoviedb.org/person/1405"}}, {tmdbId:"18191", properties:{bornIn:"London, England, UK", imdbId:"0000372", born:date('1962-06-29'), name:"Amanda Donohoe", bio:"From Wikipedia, the free encyclopedia\n\nAmanda Donohoe (born 29 June 1962) is an English film and television actress best known for her 1980s relationship with popstar Adam Ant and her later work on television — including L. A.  Law and Emmerdale — and her roles in successful movies including Liar, Liar. \n\n \n\nDescription above from the Wikipedia article Amanda Donohoe, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/f7s1GhnJMfGJEReVtMRQC6Tju5V.jpg", url:"https://themoviedb.org/person/18191"}}, {tmdbId:"69098", properties:{bornIn:"New York City, New York, USA ", imdbId:"0005289", born:date('1961-09-22'), name:"Catherine Oxenberg", bio:"From Wikipedia, the free encyclopedia.  Catherine Oxenberg (Serbian: Катарина Оксенберг, Katarina Oksenberg; born September 22, 1961, New York City) is an American actress known for her performance as Amanda Carrington on the 1980s American prime time soap opera Dynasty.  The daughter of HRH Princess Elizabeth of Yugoslavia, Oxenberg is a descendant of the Serbian Karađorđević dynasty and a distant heir to the British throne; according to the Wikipedia entry she is currently 1,654th  ...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4CBxtwp2KNswSTdmjfvBwKMP4tp.jpg", url:"https://themoviedb.org/person/69098"}}, {tmdbId:"12982", properties:{bornIn:"Glasgow, Scotland, UK", imdbId:"0134922", born:date('1958-04-14'), name:"Peter Capaldi", bio:"Peter Dougan Capaldi (born 14 April 1958) is a Scottish actor, writer and director.  He portrayed the twelfth incarnation of the Doctor in Doctor Who and Malcolm Tucker the spin doctor in The Thick of It, for which he has received four British Academy Television Award nominations, winning Best Male Comedy Performance in 2010.  When he reprised the role in In the Loop, Capaldi was honoured with several film critic award nominations for Best Supporting Actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wcsd1tMVFjgplfZlTUfb7fiD2zP.jpg", url:"https://themoviedb.org/person/12982"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"16216", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0058279", born:date('1978-06-06'), name:"Judith Barsi", bio:"Judith Barsi (1978–1988) was an American child actress...", died:date('1988-07-25'), url:"https://themoviedb.org/person/16216"}}, {tmdbId:"44055", properties:{bornIn:"Reno, Nevada", imdbId:"0198925", born:date('1976-04-23'), name:"Gabriel Damon", bio:"From Wikipedia, the free encyclopedia. \n\nHe was exposed to the performing arts as early as 3 years old, when his parents and family moved to Los Angeles, California.  After doing more than 100 commercials, his first role was in the 1984 TV series Call to Glory.  He voiced Littlefoot the Apatosaurus in the first The Land Before Time movie, and Little Nemo in Little Nemo: Adventures in Slumberland.  He also appeared as Hob in RoboCop 2...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3egsFiVNyHSVlMsgbwgDEinACTT.jpg", url:"https://themoviedb.org/person/44055"}}, {tmdbId:"67937", properties:{bornIn:"Newark, New Jersey, USA ", imdbId:"0337504", born:date('1955-10-21'), name:"Paul Greco", died:date('2008-12-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rS4JXVcoAlrRjRtWYPPb183HyXC.jpg", url:"https://themoviedb.org/person/67937"}}, {tmdbId:"80747", properties:{bornIn:"Windsor, Berkshire, England, UK", imdbId:"0793455", name:"Steve Shill", bio:"Steve Shill is a British television and film director, actor, screenwriter, and television producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ceq5fV79ky8AqSyMbd2p4wA6pwe.jpg", url:"https://themoviedb.org/person/80747"}}, {tmdbId:"32688", properties:{bornIn:"Carcassonne, Francia", imdbId:"0260433", born:date('1956-11-30'), name:"Pierre-Marie Escourrou", url:"https://themoviedb.org/person/32688"}}, {tmdbId:"53769", properties:{imdbId:"0156684", name:"Catherine Chevallier", url:"https://themoviedb.org/person/53769"}}, {tmdbId:"7277", properties:{bornIn:"Champigny-sur-Marne, Val-de-Marne, France", imdbId:"0933447", born:date('1921-10-16'), name:"Georges Wilson", bio:"Born in Champigny sur Marne (Val-de-Marne 94) and died in Rambouillet (Yvelines 78).  He is buried in Clairefontaine (Yvelines 78)...", died:date('2010-02-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5N31WRQYsDpEu0FEXDENAjfnehV.jpg", url:"https://themoviedb.org/person/7277"}}, {tmdbId:"28633", properties:{bornIn:"DeKalb, Illinois, USA", imdbId:"0420955", born:date('1947-05-04'), name:"Richard Jenkins", bio:"Richard Dale Jenkins (born May 4, 1947) is an American actor.  Jenkins began his acting career in theater at the Trinity Repertory Company and later made his film debut in 1974.  He has worked steadily in film and television since the 1980s, mostly in supporting roles.  His first major role did not come until the early 2000s, when he portrayed the deceased patriarch Nathaniel Fisher on the HBO funeral drama series Six Feet Under (2001–2005)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/muT3RZG9hiKaKojD751RcQ5tGEy.jpg", url:"https://themoviedb.org/person/28633"}}, {tmdbId:"26466", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0442512", born:date('1949-09-25'), name:"Caroline Kava", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eORoASDF7YvmmKUQ883gYjyzmPU.jpg", url:"https://themoviedb.org/person/26466"}}, {tmdbId:"40092", properties:{bornIn:"London, England, UK", imdbId:"0493341", born:date('1949-09-19'), name:"Twiggy", bio:"Lesley Lawson is an English model, actress, and singer widely known by the nickname Twiggy.  She was a British cultural icon and a prominent teenage model in swinging sixties London...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/A3T7ZkaA89HuSnJn2nrfzOiwW5i.jpg", url:"https://themoviedb.org/person/40092"}}, {tmdbId:"85672", properties:{bornIn:"New Delhi, India", imdbId:"0000818", born:date('1950-09-18'), name:"Shabana Azmi", bio:"Shabana Azmi is an Indian actress of film, television and theatre.  She's an alumna of the Film and Television Institute of India of Pune.  After her film debut in 1974 she soon became one of the leading actresses of parallel cinema, an Indian New Wave movement known for its serious content and neo-realism...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vAoYSYP4DFUMv7fZk9u8Bps9by.jpg", url:"https://themoviedb.org/person/85672"}}, {tmdbId:"76465", properties:{bornIn:"\tToronto, Ontario, Canada", imdbId:"0484929", born:date('1957-03-17'), name:"Laurene Landon", bio:"From Wikipedia, the free encyclopedia. \n\nLaurene Landon (born March 17, 1957 as Laurene Landon Coughlin) is a film and television actress.  Laurene first began appearing in movies in the late 1970s.  She is best known for playing the role of Molly in . . . All the Marbles.  She's half Irish and half Polish and describes herself as being \"Bi-Polish\". \n\nDescription above from the Wikipedia article Laurene Landon, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/659P7Lph2zRVkDAn21sPtbmDFLI.jpg", url:"https://themoviedb.org/person/76465"}}, {tmdbId:"138988", properties:{imdbId:"0493684", name:"Paul Lazar", url:"https://themoviedb.org/person/138988"}}, {tmdbId:"104442", properties:{bornIn:"Bronx, New York City, New York, USA", imdbId:"0353614", born:date('1931-12-03'), name:"Captain Haggerty", died:date('2006-07-03'), url:"https://themoviedb.org/person/104442"}}, {tmdbId:"98374", properties:{imdbId:"0929578", born:date('1948-05-17'), name:"Marlene Willoughby", bio:"Willoughby chose the surname \"Willoughby\" for her professional work after someone called her willowy.  She followed her older sister, Jacqueline Carol, in pursuing a career in show business.  In 1969, she appeared in the controversial Lennox Raphael Off-Off-Broadway play Che! Other theater roles followed including the Obie Award winning Dracula Sabbat, Fuck Mother and Keepers of the Hippo Horn...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nXK4m7DqzJtDZpJqmzYdBZkiH6g.jpg", url:"https://themoviedb.org/person/98374"}}, {tmdbId:"37203", properties:{bornIn:"New York City, New York, USA", imdbId:"0000892", born:date('1960-03-12'), name:"Jason Beghe", bio:"From Wikipedia, the free encyclopedia. \n\nJason Beghe (born March 12, 1960) is an American film and television actor and critic of Scientology.  As a young man he attended the Collegiate School in New York City, where he became best friends with John F.  Kennedy, Jr.  and David Duchovny.  Beghe is married and lives in Los Angeles, California.  Beghe starred in the 1988 George A.  Romero film Monkey Shines: An Experiment In Fear, playing a quadriplegic in a performance that was positively received...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hrTwOPWek7nkPJgFhh6inFu7vSS.jpg", url:"https://themoviedb.org/person/37203"}}, {tmdbId:"104873", properties:{bornIn:" Philadelphia, Pennsylvania, USA", imdbId:"0573896", born:date('1959-08-17'), name:"Kate McNeil", bio:"​From Wikipedia, the free encyclopedia\n\nKate McNeil (born 1959) is an American television actress.  She began her acting career on the soap opera As the World Turns in 1981.  In 1982, she appeared in the low-budget comedy Beach House, billed as Kathy McNeil.  The following year, she starred in the slasher film The House on Sorority Row where she was billed as Kathryn McNeil...", url:"https://themoviedb.org/person/104873"}}, {tmdbId:"13593", properties:{bornIn:" Dayton, Ohio, USA", imdbId:"0005565", born:date('1925-11-11'), name:"Jonathan Winters", bio:"Jonathan Winters, 87, was an American comedian and actor.  Winters got his start as a local radio DJ in Ohio, but he soon moved to New York City to make it as a comedian.  He soon struck success by starring in a number of comedy shorts, and even had the distinction of starring in the first color television show.  He had starred in over 30 TV shows and films and over 20 comedy albums during his career...", died:date('2013-04-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c2pp7XSUBTbUyptlDjaEhoyz9QX.jpg", url:"https://themoviedb.org/person/13593"}}, {tmdbId:"25257", properties:{bornIn:"Barcellona, Spagna", imdbId:"0785565", born:date('1933-01-21'), name:"Julieta Serrano", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3eVHZ5gieSxNYUJRXaYLDaljDQO.jpg", url:"https://themoviedb.org/person/25257"}}, {tmdbId:"25025", properties:{bornIn:"Málaga, Andalucía, Spain ", imdbId:"0056686", born:date('1961-06-11'), name:"María Barranco", bio:"María Barranco, born María de los Remedios Barranco García, is a Spanish actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/47iVJl6a8oOenab7LeYEnBO40xe.jpg", url:"https://themoviedb.org/person/25025"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"21595", properties:{bornIn:"Washington, District of Columbia, USA", imdbId:"0004989", born:date('1974-03-24'), name:"Alyson Hannigan", bio:"Alyson Lee Hannigan (born March 24, 1974) is an American actress.  She is best known for her roles as Willow Rosenberg in the television series Buffy the Vampire Slayer (1997–2003), Lily Aldrin on the CBS sitcom How I Met Your Mother (2005–2014) and Michelle Flaherty in the American Pie film series (1999–present). \n\nHannigan was born in Washington, D. C. , the only child of Emilie (Posner) Haas, a real estate agent, and Al Hannigan, a truck driver...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/22Alhzemb4z7p3YLIXAoDtg6Whf.jpg", url:"https://themoviedb.org/person/21595"}}, {tmdbId:"1204", properties:{bornIn:"Smyrna, Georgia, USA", imdbId:"0000210", born:date('1967-10-28'), name:"Julia Roberts", bio:"Julia Fiona Roberts (born October 28, 1967) is an American actress and producer.  She became a Hollywood star after headlining the romantic comedy Pretty Woman (1990), which grossed $464 million worldwide.  She has won three Golden Globe Awards (out of eight nominations) and has been nominated for four Academy Awards for her film acting, winning the Academy Award for Best Actress for her performance in Erin Brockovich (2000). \n\nHer films have collectively brought box office receipts of over US$2...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pahtuRDpaopvO6rH1RYS2omrO8L.jpg", url:"https://themoviedb.org/person/1204"}}, {tmdbId:"3127", properties:{bornIn:"Glencoe, Illinois, USA", imdbId:"0000666", born:date('1967-02-20'), name:"Lili Taylor", bio:"Lili Taylor is an American film and television actress, best known for her roles in such award-winning indie films as Mystic Pizza, Short Cuts and I Shot Andy Warhol...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mDhsbC9kjJnwJGHbpquKs8D1IUo.jpg", url:"https://themoviedb.org/person/3127"}}, {tmdbId:"12949", properties:{bornIn:"Brooklyn, New York City, New York, USA", imdbId:"0001636", born:date('1945-05-24'), name:"Priscilla Presley", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aAv7s1I9Y2qnPIfgvWwoBz9JO4b.jpg", url:"https://themoviedb.org/person/12949"}}, {tmdbId:"555927", properties:{imdbId:"0529025", name:"Bruce Lyons", url:"https://themoviedb.org/person/555927"}}, {tmdbId:"555928", properties:{imdbId:"0568809", name:"Hamish McFarlane", url:"https://themoviedb.org/person/555928"}}, {tmdbId:"227099", properties:{bornIn:" New Zealand", imdbId:"0621031", born:date('1951-10-22'), name:"Marshall Napier", bio:"From Wikipedia, the free encyclopedia. \n\nMarshall James Napier is a New Zealand actor.  He is the father of actress Jessica Napier and the uncle of actor James Napier. \n\nBefore becoming an actor, Napier worked variously as an art student, factory worker and truck driver.  In 1988, he moved with his wife and two children, Reuben and Jessica, to Australia, to pursue a career in acting, and has worked in theatre, film, and television productions.  In his 40's, he began writing plays...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1NwqDIMV1IXZ3Z0j9LOcET5X6dn.jpg", url:"https://themoviedb.org/person/227099"}}, {tmdbId:"83876", properties:{imdbId:"0463463", name:"Kristýna Kohoutová", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7NEeTj8AfyhyR34WGhfPJwl3WC8.jpg", url:"https://themoviedb.org/person/83876"}}, {tmdbId:"553743", properties:{imdbId:"0065806", born:date('1950-09-08'), name:"John Beckman", url:"https://themoviedb.org/person/553743"}}, {tmdbId:"553746", properties:{imdbId:"0102779", name:"Kisha Brackel", url:"https://themoviedb.org/person/553746"}}, {tmdbId:"72157", properties:{bornIn:"New York City, New York, USA", imdbId:"0120401", born:date('1944-08-08'), name:"Brooke Bundy", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aB8esob106MNspsUFeUCe3fIvM7.jpg", url:"https://themoviedb.org/person/72157"}}, {tmdbId:"553745", properties:{imdbId:"0123340", name:"Wanda Bursey", url:"https://themoviedb.org/person/553745"}}, {tmdbId:"70083", properties:{bornIn:"Roma, Lazio, Italy", imdbId:"0041066", born:date('1963-04-03'), name:"Antonella Attili", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7LkcUazq3D0F3oS7lVCRf10thMg.jpg", url:"https://themoviedb.org/person/70083"}}, {tmdbId:"52657", properties:{bornIn:"Castellammare di Stabia, Campania, Italy", imdbId:"0134073", born:date('1928-04-05'), name:"Enzo Cannavale", died:date('2011-03-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/t2KI1Aw4itau113e37YmlQcKJXm.jpg", url:"https://themoviedb.org/person/52657"}}, {tmdbId:"119992", properties:{bornIn:"Catania, Sicily, Italy", imdbId:"0347842", born:date('1946-01-09'), name:"Leo Gullotta", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wn9LQjKRZxrXm6a5zyfrLs71ChM.jpg", url:"https://themoviedb.org/person/119992"}}, {tmdbId:"26666", properties:{bornIn:"London, England, UK", imdbId:"0005301", born:date('1959-06-06'), name:"Amanda Pays", bio:"​From Wikipedia, the free encyclopedia.   \n\nAmanda Pays (born 6 June 1959) is an English actress. \n\nDescription above from the Wikipedia article Amanda Pays, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ryDAKAA5bR8dqB7rDp7pDvTqT7z.jpg", url:"https://themoviedb.org/person/26666"}}, {tmdbId:"71791", properties:{bornIn:"New York City, New York, USA", imdbId:"0005055", born:date('1949-05-09'), name:"Billy Joel", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wXlIKgFnXK2Af6cetw9oF0kGcRc.jpg", url:"https://themoviedb.org/person/71791"}}, {tmdbId:"2658100", properties:{bornIn:"Baltimore, Maryland, USA", born:date('1977-01-19'), name:"Bart the Bear", bio:"Bart was an Alaskan brown bear...", died:date('2000-05-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p3x3n2E6YkhPW9MmMG1fwdDW5hH.jpg", url:"https://themoviedb.org/person/2658100"}}, {tmdbId:"10698", properties:{bornIn:"Istanbul, Turkey", imdbId:"0001409", born:date('1953-10-04'), name:"Tchéky Karyo", bio:"Tchéky Karyo (born October 4, 1953) is a Turkish-born French actor. \n\nDescription above from the Wikipedia article Tchéky Karyo, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bQbUza0qqA2F5SmwO40Q115j4wh.jpg", url:"https://themoviedb.org/person/10698"}}, {tmdbId:"24435", properties:{bornIn:"Pekin, Illinois, USA", imdbId:"0908685", born:date('1933-08-10'), name:"Jack Wallace", bio:"Jack Wallace (August 10, 1933 – April 16, 2020) was an American actor...", died:date('2020-04-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mg23nIdVa4MzUOHuEAdUB0kyZUV.jpg", url:"https://themoviedb.org/person/24435"}}] AS row
