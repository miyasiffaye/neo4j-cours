UNWIND [{tmdbId:"1498041", properties:{imdbId:"4837284", name:"Tenae Downing", url:"https://themoviedb.org/person/1498041"}}, {tmdbId:"1699474", properties:{imdbId:"7062441", name:"R.J. Hermes", url:"https://themoviedb.org/person/1699474"}}, {tmdbId:"1699478", properties:{imdbId:"1747551", name:"Kyle Field", url:"https://themoviedb.org/person/1699478"}}, {tmdbId:"1521445", properties:{imdbId:"5473880", name:"Rakim Mayers", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gL0NFnIrqLosSbdxAHExOHAMkFH.jpg", url:"https://themoviedb.org/person/1521445"}}, {tmdbId:"156532", properties:{imdbId:"0064193", name:"Bruce Beatty", bio:"Bruce Beatty is an actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yN8sxg5nPPXrfcim3mNkAoPEdUs.jpg", url:"https://themoviedb.org/person/156532"}}, {tmdbId:"78749", properties:{bornIn:"Mumbai, Maharashtra, India", imdbId:"0004335", born:date('1974-01-10'), name:"Hrithik Roshan", bio:"Hrithik Roshan is an Indian actor who appears in Bollywood films.   After having appeared in films as a child actor in the 1980s, Roshan made his film debut in a leading role in Kaho Naa. . .  Pyaar Hai (2000) for which Roshan earned his Filmfare Awards for Best Actor and Best Male Debut.  In 2001, he went on to appear in the melodrama Kabhi Khushi Kabhie Gham. . . , which became India's highest-grossing film in the overseas market and his biggest commercial success to date...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d7XGTvyYgmrsA05XOn1YtxYcuY1.jpg", url:"https://themoviedb.org/person/78749"}}, {tmdbId:"10510", properties:{bornIn:"Lahore, Punjab, British India", imdbId:"0001934", born:date('1946-01-16'), name:"Kabir Bedi", bio:"Kabir Bedi was a major star in India who successfully broke out into European film in the late 1970's in the TV series \"Sandokhan the Great\" which led to being cast as the hero in the British \"Thief of Baghdad\" TV movie and briefly into semi-stardom in the United States.  The high point of his career was as a villain in the James Bond action thriller OCTOPUSSY...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/69kagqAmZuKE9vwuUwBER9TNbpv.jpg", url:"https://themoviedb.org/person/10510"}}, {tmdbId:"130589", properties:{imdbId:"3349461", name:"Arunoday Singh", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xGCbiq3SvMP3VkNQQZlKhY47yMI.jpg", url:"https://themoviedb.org/person/130589"}}, {tmdbId:"587753", properties:{bornIn:" Mumbai, Maharashtra, India", imdbId:"5249562", born:date('1990-10-13'), name:"Pooja Hegde", bio:"Pooja Hegde is an Indian model and  actress.  A former beauty pageant contestant, she was crowned as the  second runner-up at the Miss Universe India 2010 competition, before  going on to make her acting debut in Mysskin's Tamil superhero film Mugamoodi (2012).  She then featured in the Telugu films Oka Laila Kosam and Mukunda (2014), while signing on to feature as the lead actress in Ashutosh Gowariker's Mohenjo Daro (2016)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2ZxrR6DVIWtDDtmIhJ6i64wwWSU.jpg", url:"https://themoviedb.org/person/587753"}}, {tmdbId:"29051", properties:{bornIn:"Chicago - Illinois - USA", imdbId:"0129749", born:date('1950-04-17'), name:"L. Scott Caldwell", bio:"Laverne Scott Caldwell (born April 17, 1950) is an American actress known for her role as Rose on Lost. \n\nCaldwell, who earned a degree in Theater Arts and Communications from Loyola University Chicago, has an extensive background in feature films, television and theater.  Her film credits include Mystery Alaska, Waiting to Exhale, The Net, The Fugitive, Dutch and Without a Trace...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8Iux9eUO9cBclLSFDO4DRbafLSy.jpg", url:"https://themoviedb.org/person/29051"}}, {tmdbId:"1029403", properties:{imdbId:"3609439", name:"James Russell", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uKxLpK7xxGnQh3spyiN24PgQ6eN.jpg", url:"https://themoviedb.org/person/1029403"}}, {tmdbId:"239019", properties:{bornIn:"Worcester, Worcestershire, England, UK", imdbId:"3229685", born:date('1986-12-26'), name:"Kit Harington", bio:"Christopher Catesby \"Kit\" Harington (born 26 December 1986) is an English actor who rose to fame playing the role of Jon Snow, one of the main characters in the series Game of Thrones.  He starred as Albert Narracott in the original West End production of War Horse.  Harington also played the lead role of Milo in the 2014 film Pompeii and 'Eret' in How to Train Your Dragon 2...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4MqUjb1SYrzHmFSyGiXnlZWLvBs.jpg", url:"https://themoviedb.org/person/239019"}}, {tmdbId:"61110", properties:{bornIn:"Hattiesburg, Mississippi, U.S.", imdbId:"0035488", born:date('1966-12-04'), name:"Fred Armisen", bio:"Alfredo \"Fred\" Armisen (born December 4, 1966) is an American actor, comedian and musician best known for his work as a cast member on Saturday Night Live, and portraying off-color foreigners in various comedy films such as EuroTrip, Cop Out or Anchorman: The Legend of Ron Burgundy.  With Carrie Brownstein, he is the co-creator and co-star of the IFC sketch series Portlandia. \n\nHe also recently voices Speedy Gonzales in The Looney Tunes Show on Cartoon Network...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nLMCRlt0MV2uu4KPbDPDNsPWfBG.jpg", url:"https://themoviedb.org/person/61110"}}, {tmdbId:"189761", properties:{bornIn:"Metuchen, New Jersey, USA", imdbId:"0004518", born:date('1956-09-16'), name:"David Copperfield", bio:"David Seth Kotkin, known professionally as David Copperfield, is an American magician, described by Forbes as the most commercially successful magician in history. \n\nCopperfield's television specials have won 21 Emmy Awards and 38 nominations...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9qECAXWe3vlHI5FKKceD9a1emek.jpg", url:"https://themoviedb.org/person/189761"}}, {tmdbId:"76110", properties:{bornIn:" Toronto, Ontario, Canada ", imdbId:"1854386", born:date('1981-05-08'), name:"Stephen Amell", bio:"Stephen Amell (born May 8, 1981) is a Canadian actor known for his role on the television series Rent-a-Goalie, as well as his work co-starring opposite Shirley MacLaine and Mischa Barton in the feature length motion picture Closing the Ring.  He is best known for his role as Oliver Queen in The CW's Arrow...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h7KpOs3NlcquoJnZBFMOad81XEZ.jpg", url:"https://themoviedb.org/person/76110"}}, {tmdbId:"1003843", properties:{imdbId:"2782402", name:"Stephanie Allynne", url:"https://themoviedb.org/person/1003843"}}, {tmdbId:"58014", properties:{bornIn:"Vancouver, British Columbia, Canada", imdbId:"1160472", born:date('1978-09-25'), name:"Rossif Sutherland", bio:"From Wikipedia, the free encyclopedia. \n\nRossif Sutherland (born September 25, 1978) is a Canadian actor. \n\nSutherland was born in Vancouver, British Columbia, the son of Canadian actors Donald Sutherland and Francine Racette, brother of actor Angus Sutherland, and half-brother of actor Kiefer Sutherland.  He has appeared in films such as Timeline (as Francois Dontelle), and Red Doors (as Alex).  He had a recurring role on the television show ER during its tenth season...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3ZBXM6CqZutyWWR6vbGvLcm8HDk.jpg", url:"https://themoviedb.org/person/58014"}}, {tmdbId:"76103", properties:{imdbId:"0369935", born:date('1977-07-28'), name:"Allan Hawco", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qvZoHjkmbjdA0W6C0evynt26DJ8.jpg", url:"https://themoviedb.org/person/76103"}}, {tmdbId:"1386089", properties:{bornIn:"Elizabeth City, North Carolina, USA", imdbId:"5722984", born:date('1983-06-21'), name:"Edward Snowden", bio:"Edward Snowden is an American computer professional, former Central Intelligence Agency (CIA) employee and former contractor for the United States government who copied and leaked classified information from the National Security Agency (NSA) in 2013 without prior authorization.  His disclosures revealed numerous global surveillance programs, many run by the NSA and the Five Eyes Intelligence Alliance with the cooperation of telecommunication companies and European governments...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q2n2J4HVxty15I9vPJ4j8yX6gdu.jpg", url:"https://themoviedb.org/person/1386089"}}, {tmdbId:"1326448", properties:{bornIn:"New York, New York, USA", imdbId:"3390925", born:date('1967-03-06'), name:"Glenn Greenwald", url:"https://themoviedb.org/person/1326448"}}] AS row
