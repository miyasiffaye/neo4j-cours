UNWIND [{tmdbId:"81735", properties:{bornIn:"Deadwood, South Dakota, USA", imdbId:"0861200", born:date('1917-01-19'), name:"Kelly Thordsen", bio:"Kelly Thordsen was an actor who had a successful Hollywood career.  Thordsen's early acting career consisted of roles in various films, such as the horror feature \"Invasion of the Saucer Men\" (1957) with Steve Terrell, the Dana Andrews dramatic adaptation \"The Fearmakers\" (1958) and the crime picture \"City of Fear\" (1959) with Vince Edwards...", died:date('1978-01-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/UUohqdFVQTHV9wywQ0uJHhecCu.jpg", url:"https://themoviedb.org/person/81735"}}, {tmdbId:"70179", properties:{imdbId:"0056435", born:date('1934-02-19'), name:"Pierre Barouh", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aTWFrf4papNqmKD61cCd0cWfBTR.jpg", url:"https://themoviedb.org/person/70179"}}, {tmdbId:"39199", properties:{bornIn:"Paris, France", imdbId:"0481412", born:date('1942-02-25'), name:"Valérie Lagrange", bio:"Valérie Lagrange, nom de scène de Danielle Charaudeau, née à Paris le 25 février 1942, est une auteur-compositrice-interprète, actrice et écrivaine française...", url:"https://themoviedb.org/person/39199"}}, {tmdbId:"79912", properties:{bornIn:"Wellesley, Massachusetts, USA", imdbId:"0125518", born:date('1930-02-13'), name:"Frank Buxton", died:date('2018-01-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/HXMcNDaAj4kJZK85hid9NEPE98.jpg", url:"https://themoviedb.org/person/79912"}}, {tmdbId:"1219447", properties:{imdbId:"0561752", name:"Len Maxwell", url:"https://themoviedb.org/person/1219447"}}, {tmdbId:"9565", properties:{bornIn:"New York City", imdbId:"0489837", born:date('1939-04-11'), name:"Louise Lasser", bio:"From Wikipedia, the free encyclopedia.   Louise Lasser (born April 11, 1939) is an American actress.  She is known for her portrayal of the title character on the soap opera parody Mary Hartman, Mary Hartman.  She was married to Woody Allen and appeared in several of his films. \n\n \n\nDescription above from the Wikipedia article Louise Lasser, licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/smrLNcvGJgR60iAwHnov1a7EwYa.jpg", url:"https://themoviedb.org/person/9565"}}, {tmdbId:"18365", properties:{bornIn:"Hastings, Nebraska, USA", imdbId:"0006800", born:date('1937-04-27'), name:"Sandy Dennis", bio:"Sandra Dale \"Sandy\" Dennis (April 27, 1937 – March 2, 1992) was an American actress.  She made her film debut in the drama Splendor in the Grass (1961).  For her performance in the comedy-drama film Who's Afraid of Virginia Woolf? (1966), she received the Academy Award for Best Supporting Actress...", died:date('1992-03-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hy3QacaLrl2GtSPKmZtgSIQJfJG.jpg", url:"https://themoviedb.org/person/18365"}}, {tmdbId:"83463", properties:{bornIn:"Jersey City, New Jersey, USA", imdbId:"0005434", born:date('1940-06-08'), name:"Nancy Sinatra", bio:"​From Wikipedia, the free encyclopedia. \n\nNancy Sandra Sinatra (born June 8, 1940) is an American singer and actress.  She is the daughter of singer/actor Frank Sinatra, and remains best known for her 1966 signature hit \"These Boots Are Made for Walkin'\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e2ZNYy8lLh242LjQFtnEb67Uunh.jpg", url:"https://themoviedb.org/person/83463"}}, {tmdbId:"6905", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0001136", born:date('1936-06-04'), name:"Bruce Dern", bio:"Bruce MacLeish Dern (born June 4, 1936) is an American actor.  He was nominated for the Academy Award for Best Supporting Actor for Coming Home (1978) and the Academy Award for Best Actor for Nebraska (2013).  His other major film appearances include Silent Running (1972), The King of Marvin Gardens (1972), The Cowboys (1972), Posse (1975), Family Plot (1976), Black Sunday (1977), Tattoo (1981), Monster (2003), The Hateful Eight (2015), and Once Upon a Time in Hollywood (2019)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xh9e0AeDHsaiQWOhs3t7uPuSvb0.jpg", url:"https://themoviedb.org/person/6905"}}, {tmdbId:"6587", properties:{bornIn:"Meridian, Mississippi, U.S.A.", imdbId:"0002663", born:date('1932-11-29'), name:"Diane Ladd", bio:"From Wikipedia, the free encyclopedia\n\nDiane Ladd (born November 29, 1935) is an American actress, film director, producer and published author.  She has appeared in over 120 roles, on television, and in miniseries and feature films, including Alice Doesn't Live Here Anymore (1974), Wild at Heart (1990), Rambling Rose (1991), Ghosts of Mississippi, Primary Colors, 28 Days (2000), and American Cowslip (2008)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2fmurzpgqZFYc8JzS64PHt0amon.jpg", url:"https://themoviedb.org/person/6587"}}, {tmdbId:"250", properties:{bornIn:"Essex, England", imdbId:"0879239", born:date('1931-09-09'), name:"Margaret Tyzack", died:date('2011-06-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n7S4qtgp0DA9gtkzEXB7r5tt6jH.jpg", url:"https://themoviedb.org/person/250"}}, {tmdbId:"138166", properties:{bornIn:"Napier, New Zealand", imdbId:"0692239", born:date('1936-01-22'), name:"Nyree Dawn Porter", died:date('2001-04-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6VUg3WnssxVNeoUu066eNbjVJQI.jpg", url:"https://themoviedb.org/person/138166"}}, {tmdbId:"34676", properties:{bornIn:"Paris, France", imdbId:"0136789", born:date('1927-08-14'), name:"Roger Carel", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hEcbRZd9Utcrav9oCBtnsXzg1NL.jpg", url:"https://themoviedb.org/person/34676"}}, {tmdbId:"57540", properties:{bornIn:"Paris, France", imdbId:"0603600", born:date('1922-05-29'), name:"Jacques Morel", died:date('2008-04-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tXmF78bTeOC4SNFoTsusQxzSuYr.jpg", url:"https://themoviedb.org/person/57540"}}, {tmdbId:"589521", properties:{bornIn:"Bort-les-Orgues, Corrèze, France", imdbId:"0868139", born:date('1930-01-21'), name:"Pierre Tornade", bio:"Pierre Tornade (21 January 1930 – 7 March 2012) was a French actor.  He appeared in 128 films and television shows between 1956 and 1998. \n\nHe was born Pierre Tournadre on 21 January 1930 in Bort-les-Orgues in the department of Corrèze.  He began his theatrical career at 25 in Elle est folle, Carole at the théâtre du Palais-Royal...", died:date('2012-03-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mOHqoHM3QdoH9xq6UXeQs6SG4TE.jpg", url:"https://themoviedb.org/person/589521"}}, {tmdbId:"70142", properties:{bornIn:"Angers, Maine-et-Loire, France", imdbId:"0431025", born:date('1926-10-03'), name:"Jacques Jouanneau", died:date('2011-07-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6U6jS7QVGOBABSQIhjqGQ1RCoOs.jpg", url:"https://themoviedb.org/person/70142"}}, {tmdbId:"18266", properties:{bornIn:"Torquay, Devon, England, UK", imdbId:"0177228", born:date('1937-11-17'), name:"Peter Cook", bio:"From Wikipedia, the free encyclopedia\n\nPeter Edward Cook (17 November 1937 – 9 January 1995) was an English satirist, writer and comedian.  An extremely influential figure in modern British comedy, he is regarded as the leading light of the British satire boom of the 1960s.  He has been described by Stephen Fry as \"the funniest man who ever drew breath\" although Cook's work was also controversial...", died:date('1995-01-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dF7sTCuXwcBLDBlJNjvyKnOx651.jpg", url:"https://themoviedb.org/person/18266"}}, {tmdbId:"56819", properties:{bornIn:"Dagenham, Essex, England, UK", imdbId:"0001545", born:date('1935-04-19'), name:"Dudley Moore", bio:"Dudley Stuart John Moore, CBE was an English actor, comedian, composer and musician. \n\nMoore first came to prominence as one of the four writer-performers in the ground-breaking comedy revue Beyond the Fringe in the early 1960s, and then became famous as half of the highly popular television double-act he formed with Peter Cook...", died:date('2002-03-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8xLueKMu5tpBmLNzZ73eWBNHycW.jpg", url:"https://themoviedb.org/person/56819"}}, {tmdbId:"9762", properties:{bornIn:"Marseille, Bouches-du-Rhône, France", imdbId:"0814799", born:date('1934-09-25'), name:"Jean Sorel", bio:"From Wikipedia, the free encyclopedia\n\nJean Sorel (born 25 September 1934) is a French actor. \n\nHe also worked in Italian cinema, and Spanish cinema with directors such as Luis Buñuel or Luchino Visconti.  However since 1980 he has worked mostly in television.  He is married to Italian actress Anna-Maria Ferrero. \n\nDescription above from the Wikipedia article Jean Sorel, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fP0u5mPqTbBuJW1Uex0Wfv5rjbG.jpg", url:"https://themoviedb.org/person/9762"}}, {tmdbId:"9763", properties:{bornIn:"Paris, France", imdbId:"0656180", born:date('1927-12-13'), name:"Geneviève Page", bio:"​From Wikipedia, the free encyclopedia. \n\nGeneviève Page  (born Geneviève Bonjean, December 13, 1927, in Paris) is a leading French actress with a film career spanning fifty years.  She is the daughter of Jacques Paul Bonjean (1899–1990), a well known french art-collector...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iCbS9LW8IU1Z4Ik4lF85iSX53Hl.jpg", url:"https://themoviedb.org/person/9763"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"45369", properties:{bornIn:"New York City, New York, USA", imdbId:"0362249", born:date('1930-01-01'), name:"Ty Hardin", bio:"From Wikipedia, the free encyclopedia. \n\nTy Hardin, born Orison Whipple Hungerford, Jr. , (born January 1, 1930) is a former American actor best known as the star of the 1950s ABC western television series Bronco...", died:date('2017-08-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/f7X1PohBLN9ZgXcVpI9R15wqHPk.jpg", url:"https://themoviedb.org/person/45369"}}, {tmdbId:"94156", properties:{bornIn:"Swindon, Wiltshire, England, UK", imdbId:"0002047", born:date('1931-10-23'), name:"Diana Dors", bio:"Diana Dors was an English actress, born Diana Mary Fluck on October 23 1931 in Swindon, Wiltshire (England).   Physically and socially mature for her age, Dors became a pin-up girl at age 13.  She lied to the photographers and later directors, claiming that she was 17.  Her first fling at the camera was in The Shop at Sly Corner (1947).  In 1948 she appeared in six films, her best known role from this period was the character Charlotte in Oliver Twist...", died:date('1984-05-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jqn5glFet4dl1zKpC4prnqQORXX.jpg", url:"https://themoviedb.org/person/94156"}}, {tmdbId:"39741", properties:{bornIn:"Berkhamsted, Hertfordshire, England, UK", imdbId:"0394588", born:date('1911-10-03'), name:"Michael Hordern", bio:"Sir Michael Murray Hordern (3 October 1911 – 2 May 1995) was an English actor, knighted in 1983 for his services to the theatre, which stretched back to before the Second World War...", died:date('1995-05-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bdnxQrWH4hM7jo8fzGpcqSQeCSq.jpg", url:"https://themoviedb.org/person/39741"}}, {tmdbId:"6450", properties:{bornIn:"Bascom, Florida, USA", imdbId:"0001159", born:date('1941-01-14'), name:"Faye Dunaway", bio:"Dorothy Faye Dunaway (born January 14, 1941) is an American actress.  She is the recipient of such accolades as an Academy Award, three Golden Globes, and a British Academy Film Award. \n\nHer career began in the early 1960s on Broadway.  She made her screen debut in the 1967 film The Happening, and rose to fame that same year with her portrayal of outlaw Bonnie Parker in Arthur Penn's Bonnie and Clyde, for which she received her first Academy Award nomination...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pJosGn38UGzAcTMvhvCanbe9cB5.jpg", url:"https://themoviedb.org/person/6450"}}, {tmdbId:"6451", properties:{bornIn:"Passaic, New Jersey, USA", imdbId:"0689488", born:date('1939-05-30'), name:"Michael J. Pollard", bio:"From Wikipedia, the free encyclopedia\n\nMichael John Pollard (born Michael John Pollack Jr. ; May 30, 1939 – November 21, 2019) was an American character actor, best known for playing C. W.  Moss in the 1967 film Bonnie and Clyde, which earned him an Academy Award for Best Supporting Actor nomination...", died:date('2019-11-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tKoA5p1EkdLzkj4DB8PCkxFxbg0.jpg", url:"https://themoviedb.org/person/6451"}}, {tmdbId:"193", properties:{bornIn:"San Bernardino, California, USA", imdbId:"0000432", born:date('1930-01-30'), name:"Gene Hackman", bio:"Eugene Allen \"Gene\" Hackman (born January 30, 1930) is a retired American actor and novelist. \n\nNominated for five Academy Awards, winning two, Hackman has also won three Golden Globes and two BAFTAs in a career that spanned four decades.  He first came to fame in 1967 with his performance as Buck Barrow in Bonnie and Clyde...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xPmETCv0APDoIK5CvIIJwbTcjPA.jpg", url:"https://themoviedb.org/person/193"}}, {tmdbId:"22383", properties:{bornIn:"San Prospero Parmense, Emilia-Romagna, Italy", imdbId:"0626259", born:date('1941-11-23'), name:"Franco Nero", bio:"Franco Nero (born 23 November 1941) is an Italian actor.   He is best known for his roles of the title character in Sergio Corbucci's Django (1966), Sir Lancelot in Joshua Logan's Camelot (1967), Horacio in Luis Buñuel's Tristana (1970), the title character in Enzo G...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lwXfTQrFqAw4zcVjrhgq3THfWCg.jpg", url:"https://themoviedb.org/person/22383"}}, {tmdbId:"18228", properties:{bornIn:"Grenoble, Isère, Rhône-Alpes, France", imdbId:"0078155", born:date('1947-01-16'), name:"Juliet Berto", bio:"From Wikipedia\n\nJuliet Berto (16 January 1947 – 10 January 1990) was a French actress, director and screenwriter. \n\nA member of the same loose group of student radicals as Anne Wiazemsky, she first appeared in Jean-Luc Godard's Two or Three Things I Know About Her, and would go on to appear in many of Godard's subsequent films, including La Chinoise, Week End, Le Gai Savoir, and Vladimir et Rosa...", died:date('1990-01-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8V15SItRZvoTRDdivqAHS8YIrVu.jpg", url:"https://themoviedb.org/person/18228"}}, {tmdbId:"18229", properties:{imdbId:"0783767", name:"Michel Semeniako", url:"https://themoviedb.org/person/18229"}}, {tmdbId:"34660", properties:{bornIn:" Los Angeles, California, USA", imdbId:"0404298", born:date('1930-05-05'), name:"Will Hutchins", bio:"Will Hutchins (born Marshall Lowell Hutchason), is an American actor most noted for playing the lead role of the young lawyer from the Oklahoma Territory, Tom Brewster, in sixty-nine episodes of the Warner Bros.  Western television series Sugarfoot, which aired on ABC from 1957 to 1961.   Hutchins was discovered by a talent scout for Warner Bros. , who changed his name from Marshall Lowell Hutchason to Will Hutchins...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/py2zVDwdgkgx8Zm4luigZ7NkkDj.jpg", url:"https://themoviedb.org/person/34660"}}, {tmdbId:"19138", properties:{bornIn:"San Francisco, California, USA", imdbId:"0084642", born:date('1934-01-22'), name:"Bill Bixby", bio:"​From Wikipedia, the free encyclopedia. \n\nBill Bixby (January 22, 1934–November 21, 1993) was an American film and television actor, director, and frequent game show panelist.  His career spanned over three decades; he appeared on stage, in motion pictures and TV series.  He is best known for his roles as Tim O'Hara on the CBS sitcom My Favorite Martian, Tom Corbett on the ABC comedy-drama series The Courtship of Eddie's Father, and Dr.  David Banner on the CBS drama series The Incredible Hulk...", died:date('1993-11-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eKcpqTutiVxQeAPbwupjSV5DXE.jpg", url:"https://themoviedb.org/person/19138"}}, {tmdbId:"12950", properties:{bornIn:"New York City, New York, USA", imdbId:"0001421", born:date('1925-02-18'), name:"George Kennedy", bio:"Sandy-haired, tall and burly George Harris Kennedy, Jr.  was born in New York City, to Helen A.  (Kieselbach), a ballet dancer, and George Harris Kennedy, an orchestra leader and musician.  He had German, Irish, and English ancestry.  A World War II veteran, Kennedy at one stage in his career cornered the market at playing tough, no-nonsense characters who were either quite crooked or possessed hearts of gold...", died:date('2016-02-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fT8UklgKbgK7ggZvqWwsai6Bh0g.jpg", url:"https://themoviedb.org/person/12950"}}, {tmdbId:"19106", properties:{imdbId:"0134201", born:date('1922-04-24'), name:"J.D. Cannon", died:date('2005-05-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/FSuc86MaMwFns82hIFnerTDUl3.jpg", url:"https://themoviedb.org/person/19106"}}, {tmdbId:"13871", properties:{imdbId:"0031398", born:date('1934-01-23'), name:"Lou Antonio", bio:"From Wikipedia, the free encyclopedia.   Lou Antonio (born January 23, 1934) is an American actor and TV director best known for performing in the films Cool Hand Luke and America, America.  He also starred in two short-lived TV series, Dog and Cat, and Makin' It...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/haFl4RA0SBghwq7uf9qpF3jbqRj.jpg", url:"https://themoviedb.org/person/13871"}}, {tmdbId:"7502", properties:{bornIn:"Hamden, Connecticut, USA", imdbId:"0000308", born:date('1917-01-24'), name:"Ernest Borgnine", bio:"Was an American actor.  His parents were Charles who had emigrated from Ottiglio (AL), Italy and Anna who had emigrated from Carpi (MO), Italy.  As an only child, Ernest enjoyed most sports, especially boxing, but took no real interest in acting.  At age 18, after graduating from high school in New Haven, and undecided about his future career, he joined the United States Navy, where he stayed for ten years until leaving in 1945...", died:date('2012-07-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9NplAYSm1kTYgO8ByNLzKctqa05.jpg", url:"https://themoviedb.org/person/7502"}}, {tmdbId:"46780", properties:{bornIn:"Hampstead, London, England, UK", imdbId:"0002058", born:date('1939-03-05'), name:"Samantha Eggar", bio:"From Wikipedia, the free encyclopedia. \n\nSamantha Eggar (born 5 March 1939) is an English film, television and voice actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/omQVadu6RfmWCVnaZR5t36lTAmw.jpg", url:"https://themoviedb.org/person/46780"}}, {tmdbId:"81409", properties:{bornIn:"Hackney, London, England, UK", imdbId:"0627969", born:date('1931-09-24'), name:"Anthony Newley", bio:"Anthony Newley was born in Hackney, London, England, to Frances Grace Newley and George Kirby, a shipping clerk.  He was attracted to acting, after seeing an ad for a child actor in a Fleet Street window.  He attended the Italia Conti Stage School from the age of 14 and, two years later, played the Artful Dodger in David Lean's film, Oliver Twist (1948)...", died:date('1999-04-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aPKqp2ICDkgCMIgbeUj7CI53FY1.jpg", url:"https://themoviedb.org/person/81409"}}, {tmdbId:"1487", properties:{bornIn:"Duluth, Minnesota, USA", imdbId:"0001168", born:date('1941-05-24'), name:"Bob Dylan", bio:"From Wikipedia, the free encyclopedia. \n\nBob Dylan (born Robert Allen Zimmerman; May 24, 1941) is an American singer-songwriter, poet, and painter.  He has been a major figure in music for five decades.  Much of his most celebrated work dates from the 1960s when he was an informal chronicler, and an apparently reluctant figurehead, of social unrest...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ubCLNwXh9Nv3EHkOkdeVbXMZa5P.jpg", url:"https://themoviedb.org/person/1487"}}, {tmdbId:"1488", properties:{imdbId:"0343606", name:"Albert Grossman", url:"https://themoviedb.org/person/1488"}}, {tmdbId:"1489", properties:{bornIn:"Akron, Ohio, USA", imdbId:"0627260", born:date('1939-06-20'), name:"Bob Neuwirth", url:"https://themoviedb.org/person/1489"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"1490", properties:{bornIn:"Staten Island, New York City, New York United States", imdbId:"0001926", born:date('1941-01-09'), name:"Joan Baez", bio:"From Wikipedia, the free encyclopedia. \n\nJoan Chandos Baez (born January 9, 1941) is an American folk singer, songwriter and activist. \n\nBaez has a distinctive vocal style, with a strong vibrato.  Her recordings include many topical songs and material dealing with social issues. \n\nBaez began her career performing in coffeehouses in Boston and Cambridge, and rose to fame as an unbilled performer at the 1959 Newport Folk Festival.  She began her recording career in 1960, and achieved immediate success...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/blirnm784OsM2csUEZUBunrqXkt.jpg", url:"https://themoviedb.org/person/1490"}}, {tmdbId:"84285", properties:{imdbId:"0738635", born:date('1938-02-17'), name:"Yvonne Romain", bio:"From Wikipedia, the free encyclopedia. \n\nYvonne Romain (born Yvonne Warren, 17 February 1938, London) is a British film and television actress of the late 1950s and 1960s...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oQg4t3m1nFjQpbbq17JGcm1uPKA.jpg", url:"https://themoviedb.org/person/84285"}}, {tmdbId:"3085", properties:{bornIn:"The Bronx, New York, USA", imdbId:"0001001", born:date('1940-03-26'), name:"James Caan", bio:"James Caan  (born March 26, 1940) is an American actor.  He is best-known for his starring roles in The Godfather, Thief, Misery, A Bridge Too Far, Brian's Song, Rollerball, Kiss Me Goodbye, Elf, and El Dorado.  He also starred as \"Big Ed\" Deline in the television series Las Vegas...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bGyOCCOIgcIyKjOGLoXoyp0XWHf.jpg", url:"https://themoviedb.org/person/3085"}}, {tmdbId:"50970", properties:{bornIn:"Snyder, Texas, USA", imdbId:"0392392", born:date('1928-04-28'), name:"Charlene Holt", died:date('1996-04-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pd94EpOmrlbB0bIrvlRfR30DoZR.jpg", url:"https://themoviedb.org/person/50970"}}, {tmdbId:"589842", properties:{bornIn:"Buenos Aires, Argentina", imdbId:"0459073", born:date('1936-03-23'), name:"Sergio Kleiner", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6fv9g8NnGQhNJ77Ehqm3CXoPP4U.jpg", url:"https://themoviedb.org/person/589842"}}, {tmdbId:"1168522", properties:{bornIn:"Mexico, D.F., Mexico", imdbId:"0548073", born:date('1949-06-25'), name:"Diana Mariscal", bio:"Diana Mariscal born Graciela Guillermina Mariscal Romero was a Mexican stage and screen actress, singer and artist...", died:date('2013-07-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5VFPfFvvthiMJMzt9rrmc2DdeKx.jpg", url:"https://themoviedb.org/person/1168522"}}, {tmdbId:"1188007", properties:{imdbId:"0729095", born:date('1918-05-06'), name:"María Teresa Rivas", died:date('2010-07-23'), url:"https://themoviedb.org/person/1188007"}}, {tmdbId:"544597", properties:{bornIn:"Tbilisi, Georgia", imdbId:"0307447", born:date('1901-10-15'), name:"Tamara Garina", died:date('1979-10-19'), url:"https://themoviedb.org/person/544597"}}, {tmdbId:"28641", properties:{bornIn:"Stepney, London, England, UK", imdbId:"0000654", born:date('1938-07-22'), name:"Terence Stamp", bio:"Terence Henry Stamp (born 22 July 1938) is an English actor.  After training at the Webber Douglas Academy of Dramatic Art in London he started his acting career in 1962.  He has been referred to as the “master of the brooding silence” by The Guardian.  His performance in the title role of Billy Budd, his film debut, earned him an Academy Award nomination for Best Supporting Actor and a BAFTA nomination for Best Newcomer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v0htmOknJWTMWmt4DIhZlc0VC7.jpg", url:"https://themoviedb.org/person/28641"}}, {tmdbId:"112454", properties:{imdbId:"0732305", born:date('1905-06-05'), name:"Jessie Robins", died:date('1991-08-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/b6l1dFcRXfhsrC9tIckxcxeLE2b.jpg", url:"https://themoviedb.org/person/112454"}}, {tmdbId:"29490", properties:{bornIn:"Dallas, Texas, U.S.", imdbId:"0001790", born:date('1943-01-24'), name:"Sharon Tate", bio:"Sharon Marie Tate (January 24, 1943 – August 9, 1969) was an American actress.  During the 1960s she played small television roles before appearing in several films.  After receiving positive reviews for her comedic performances, she was hailed as one of Hollywood's promising newcomers and was nominated for a Golden Globe Award for her performance in Valley of the Dolls (1967).  She also appeared regularly in fashion magazines as a model and cover girl...", died:date('1969-08-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/28n4VDqKbpmjBG2SyVMc6ogg2BA.jpg", url:"https://themoviedb.org/person/29490"}}, {tmdbId:"5830", properties:{bornIn:"Stepney, London, England, UK", imdbId:"0304955", born:date('1956-03-25'), name:"Matthew Garber", bio:"Matthew Adam Garber was a British child actor born March 25, 1956 in Stepney, London, England, UK.  Both of his parents were theatrical actors, but neither was particularly famous. \n\nIn 1963, Garbet came to the attention of actor Roy Dotrice (father of Karen Dotrice) who was seeking potential child actors...", died:date('1977-06-13'), url:"https://themoviedb.org/person/5830"}}, {tmdbId:"5829", properties:{bornIn:"Guernsey, Channel Islands, UK", imdbId:"0234538", born:date('1955-11-09'), name:"Karen Dotrice", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ukdX328FUC5TNZqCK4jzm2bw73d.jpg", url:"https://themoviedb.org/person/5829"}}, {tmdbId:"80206", properties:{bornIn:" Philadelphia, Pennsylvania, USA", imdbId:"0212586", born:date('1921-05-14'), name:"Richard Deacon", died:date('1984-08-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xjTLz6QAyFq0za1o7WloCY4syo4.jpg", url:"https://themoviedb.org/person/80206"}}, {tmdbId:"9594", properties:{bornIn:"Hollywood, California, USA", imdbId:"0001684", born:date('1940-01-29'), name:"Katharine Ross", bio:"From Wikipedia, the free encyclopedia. \n\nKatharine Juliet Ross (born January 29, 1940) is an American film and stage actress.  Trained at the San Francisco Workshop, she is perhaps best known for her role as Elaine Robinson in the 1967 film The Graduate, opposite Dustin Hoffman, which won her an Academy Award nomination for Best Supporting Actress, and her role as Etta Place in 1969's Butch Cassidy and the Sundance Kid, opposite Paul Newman and Robert Redford...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ladMYHRcwfduqUiQhVrRTjzwalE.jpg", url:"https://themoviedb.org/person/9594"}}, {tmdbId:"10775", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0200122", born:date('1927-03-31'), name:"William Daniels", bio:"​From Wikipedia, the free encyclopedia\n\nWilliam David Daniels (born March 31, 1927) is an American actor and former president of the Screen Actors Guild (1999 to 2001).  He is known for his performance as Dustin Hoffman's father in The Graduate (1967), as John Adams in 1776, as Carter Nash in Captain Nice, as Mr.  George Feeny in ABC's Boy Meets World, as the voice of KITT in Knight Rider, and as Dr.  Mark Craig in St.  Elsewhere, for which he won two Emmy Awards...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1SCR6im2maiASfTD5h7r0g9dU78.jpg", url:"https://themoviedb.org/person/10775"}}, {tmdbId:"19729", properties:{bornIn:"Hartford, Connecticut, U.S.A", imdbId:"0396455", born:date('1945-03-10'), name:"Katharine Houghton", bio:"From Wikipedia, the free encyclopedia. \n\nKatharine Houghton (born Katharine Houghton Grant; March 10, 1945) is an American actress.  She is best known for her role as Joanna \"Joey\" Drayton, a Caucasian woman who brings home an African-American fiancé to meet her parents, in the 1967 film Guess Who's Coming to Dinner.  Katharine Hepburn, who played the mother of Houghton's character in the film, was in real life Houghton's aunt...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bzZ9kpc6sjhQf0NcQi3jo1YAW7A.jpg", url:"https://themoviedb.org/person/19729"}}, {tmdbId:"40056", properties:{bornIn:"Stockholm, Sweden", imdbId:"0828447", born:date('1934-10-18'), name:"Inger Stevens", bio:"From Wikipedia, the free encyclopedia\n\nInger Stevens (October 18, 1934 – April 30, 1970) was a Swedish-American movie and TV actress. \n\nDescription above from the Wikipedia article Inger Stevens, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1970-04-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fT9TukKOVSkbRZPINWi3KRp878C.jpg", url:"https://themoviedb.org/person/40056"}}, {tmdbId:"39770", properties:{bornIn:"Brooklyn, New York", imdbId:"0730126", born:date('1937-08-08'), name:"Adam Roarke", bio:"From Wikipedia, the free encyclopedia\n\nRoarke was born Richard Jordan Gerler in Brooklyn, New York, where he was a street gang member during his youth.  His father was a vaudeville comedian and his mother was a chorine, showgirl. \n\nRichie, as he was affectionately called by friends, began his acting career under the name Jordan Grant; however, when he signed on with Universal Studios in 1957, he was told that he needed to change the name, because the studios already had one Mr...", died:date('1996-04-27'), url:"https://themoviedb.org/person/39770"}}, {tmdbId:"131285", properties:{imdbId:"0770124", born:date('1943-10-17'), name:"Sabrina Scharf", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z55pDOrvQc8lo1RUKzxjsBp1PRi.jpg", url:"https://themoviedb.org/person/131285"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"151604", properties:{imdbId:"0852529", name:"Jana Taylor", url:"https://themoviedb.org/person/151604"}}, {tmdbId:"1019845", properties:{bornIn:"Cantwell, Missouri, USA", imdbId:"0403910", born:date('1925-12-03'), name:"Ferlin Husky", bio:"Ferlin Eugene Husky (December 3, 1925 – March 17, 2011) was an early American country music singer who was equally adept at the genres of traditional honky-tonk, ballads, spoken recitations, and rockabilly pop tunes.  He had two dozen top-20 hits in the Billboard country charts between 1953 and 1975; his versatility and matinee-idol looks propelled a seven-decade entertainment career...", died:date('2011-03-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tfavOXiUh4VZE0LjVCAuPCBtR5O.jpg", url:"https://themoviedb.org/person/1019845"}}, {tmdbId:"55997", properties:{bornIn:"Salt Lake City, Utah, USA", imdbId:"0487103", born:date('1929-04-06'), name:"Joi Lansing", bio:"​From Wikipedia, the free encyclopedia.   \n\nJoi Lansing (April 6, 1929 - August 7, 1972) was a model, film and television actress, and nightclub singer. \n\nDescription above from the Wikipedia article Joi Lansing,  licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1972-08-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cnOiwUrWu80ALQHf81BfG030MIV.jpg", url:"https://themoviedb.org/person/55997"}}, {tmdbId:"1019846", properties:{bornIn:"Lubbock, Texas, USA", imdbId:"0101309", born:date('1937-08-26'), name:"Don Bowman", bio:"Don Bowman was an American country music singer, songwriter, comedian and radio host.  He recorded for RCA Victor between 1964 and 1970, charting in the Top 40 with the novelty hit single \"Chit Akins, Make Me a Star\".  Bowman worked at several radio stations, including KRZK in Branson, Missouri. \n\nDescription above from the Wikipedia article Don Bowman, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2013-06-05'), url:"https://themoviedb.org/person/1019846"}}, {tmdbId:"120481", properties:{bornIn:"Příluka, Rakousko - Uhersko", imdbId:"0903762", born:date('1903-12-03'), name:"Jan Vostrcil", bio:"Jan Vostrcil was born on December 3, 1903.  He was an actor, known for The Firemen's Ball (1967), Black Peter (1964) and The Loves of a Blonde (1965).  He died in 1985...", died:date('1985-01-25'), url:"https://themoviedb.org/person/120481"}}, {tmdbId:"585186", properties:{bornIn:"Podskalí u Písku, Čechy, Rakousko-Uhersko", imdbId:"0780918", born:date('1915-07-22'), name:"Josef Sebánek", died:date('1977-03-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gog7UqFDsUGw5GpZ9DwpeQANj26.jpg", url:"https://themoviedb.org/person/585186"}}, {tmdbId:"1152401", properties:{imdbId:"0885304", name:"Josef Valnoha", url:"https://themoviedb.org/person/1152401"}}, {tmdbId:"1152403", properties:{imdbId:"0213371", name:"Frantisek Debelka", url:"https://themoviedb.org/person/1152403"}}, {tmdbId:"40173", properties:{bornIn:"Newton, Massachusetts, U.S.", imdbId:"0607666", born:date('1931-05-18'), name:"Robert Morse", bio:"​From Wikipedia, the free encyclopedia.   \n\nRobert Morse (born May 18, 1931) is an American actor and singer.  Morse is best known for his appearances in musicals and plays on Broadway.  He has also acted in movies and television shows. His best known role is that of J.  Pierpont Finch in the Broadway musical, and subsequent film How to Succeed in Business Without Really Trying .  He is currently known for his recurring role as Bertram Cooper on the show Mad Men...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/23LtcAskyppohk1nGM9L97vrUjP.jpg", url:"https://themoviedb.org/person/40173"}}, {tmdbId:"46944", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0497891", born:date('1942-06-24'), name:"Michele Lee", bio:"From Wikipedia, the free encyclopedia. \n\nMichele Lee (born June 24, 1942) is an American singer, dancer, actress, producer, director and frequent game show panelist of the 1970s.  She is best-known for her role as Karen Cooper Fairgate MacKenzie on the 1980s prime-time soap opera, Knots Landing.  She also co-starred with Dean Jones in the 1968 Disney film, The Love Bug. \n\nDescription above from the Wikipedia article Michele Lee, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yWZ8VJaR6PvZSs77TzfLwyy3awC.jpg", url:"https://themoviedb.org/person/46944"}}, {tmdbId:"2194005", properties:{name:"Anthony 'Scooter' Teague", url:"https://themoviedb.org/person/2194005"}}, {tmdbId:"9287", properties:{bornIn:"Nutley, New Jersey, USA", imdbId:"0086706", born:date('1933-09-18'), name:"Robert Blake", bio:"From Wikipedia, the free encyclopedia\n\nRobert Blake (born September 18, 1933) is an American actor who starred in the film In Cold Blood and the U. S.  television series Baretta. \n\nIn 2005 he was tried and acquitted for the 2001 murder of his wife, but on November 18, 2005 he was found liable in a California civil court for her wrongful death...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6QhnUZroJWSlCUAPs6neI5lE2vb.jpg", url:"https://themoviedb.org/person/9287"}}, {tmdbId:"6914", properties:{bornIn:"Atlanta, Georgia, USA", imdbId:"0934113", born:date('1942-03-29'), name:"Scott Wilson", bio:"Scott Wilson (March 29, 1942-October 6, 2018) was an American film and television actor. \n\nWilson has more than 50 film credits from the 1960s to the 2010s, including In the Heat of the Night, In Cold Blood, The Great Gatsby, Dead Man Walking, Pearl Harbor, and Junebug. In 1980, Wilson received a Golden Globe nomination for Best Supporting Actor – Motion Picture for his role in The Ninth Configuration...", died:date('2018-10-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ynH2YOLn0A7iIlmMiiWAGtC76Hx.jpg", url:"https://themoviedb.org/person/6914"}}, {tmdbId:"8255", properties:{bornIn:"Depoy, Kentucky, USA", imdbId:"0643105", born:date('1928-07-05'), name:"Warren Oates", bio:"Warren Mercer Oates (July 5, 1928 – April 3, 1982) was an American actor best known for his performances in several films directed by Sam Peckinpah including The Wild Bunch (1969) and Bring Me the Head of Alfredo Garcia (1974).  He starred in numerous films during the early 1970s which have since achieved cult status including The Hired Hand (1971), Two-Lane Blacktop (1971) and Race with the Devil (1975).  Oates also portrayed Sergeant Hulka in the box office hit Stripes (1981)...", died:date('1982-04-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nwBandbfSoaafAYI9S1qGMCBfl4.jpg", url:"https://themoviedb.org/person/8255"}}, {tmdbId:"30123", properties:{bornIn:"New York City, New York, USA", imdbId:"0335519", born:date('1925-10-31'), name:"Lee Grant", bio:"From Wikipedia, the free encyclopedia\n\nLee Grant (born October 31, 1925) is an American theater, film and television actress, and film director who was blacklisted by the Hollywood movie studio bosses in the 1950s.  Grant won the Academy Award for Best Supporting Actress for her performance as Felicia Carp in the film Shampoo (1975). \n\nDescription above from the Wikipedia article Lee Grant, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2WesW19wpxYve32Zp3oq1pwzoen.jpg", url:"https://themoviedb.org/person/30123"}}, {tmdbId:"3854", properties:{bornIn:"Stockholm, Sweden", imdbId:"0638784", born:date('1944-05-23'), name:"Lena Nyman", bio:"From Wikipedia, the free encyclopedia\n\nAnna Lena Elisabet Nyman (23 May 1944 – 4 February 2011) was a Swedish film and stage actress. \n\nHaving had her first film roles in 1955, Nyman had a role in Vilgot Sjöman's 491 (1964) and got her breakthrough in his I Am Curious (Yellow) (1967), where she, in pseudo-documentary fashion, played a character of the same name as herself, and its sequel I Am Curious (Blue) (1968)...", died:date('2011-02-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5zwWbmVaZfL8LleBPRokGVJWTDW.jpg", url:"https://themoviedb.org/person/3854"}}, {tmdbId:"3853", properties:{imdbId:"0014062", born:date('1939-02-21'), name:"Börje Ahlstedt", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vTSfBV4IY1DozY70l3M3oy5K6sH.jpg", url:"https://themoviedb.org/person/3853"}}, {tmdbId:"133472", properties:{bornIn:"Lidingö, Stockholms län, Sweden", imdbId:"0511856", born:date('1915-12-13'), name:"Peter Lindgren", died:date('1981-05-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dBgYR3GJCtS0I7W8LkBKiF9YgcS.jpg", url:"https://themoviedb.org/person/133472"}}, {tmdbId:"57329", properties:{bornIn:"Linton, Indiana, USA", imdbId:"0365201", born:date('1904-06-24'), name:"Phil Harris", bio:"Wonga Phillip \"Phil\" Harris (June 24, 1904 – August 11, 1995) was an American singer, songwriter, jazz musician, actor, and comedian.  Though successful as an orchestra leader, Harris is remembered today for his recordings as a vocalist, his voice work in animation (probably most famous later in his career for his roles as bears, one being Baloo in Disney's The Jungle Book, and as Little John in Disney's Robin Hood)...", died:date('1995-08-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1dTD7P9eM7XR2KU0EhOAxjYgsvW.jpg", url:"https://themoviedb.org/person/57329"}}, {tmdbId:"57331", properties:{bornIn:"Burbank, California, USA", imdbId:"0718624", born:date('1955-09-15'), name:"Bruce Reitherman", bio:"Bruce Reitherman (born September 15, 1955) is an American filmmaker and former child actor...", url:"https://themoviedb.org/person/57331"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"112446", properties:{imdbId:"0141252", name:"Jan Carson", url:"https://themoviedb.org/person/112446"}}, {tmdbId:"100299", properties:{imdbId:"0165615", name:"George Claydon", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bJqm1887GMCVbUVd4NNaMdIj84h.jpg", url:"https://themoviedb.org/person/100299"}}, {tmdbId:"112448", properties:{imdbId:"0193922", name:"Ivor Cutler", url:"https://themoviedb.org/person/112448"}}, {tmdbId:"1662369", properties:{name:"Margaretta Ramsey", url:"https://themoviedb.org/person/1662369"}}, {tmdbId:"1662370", properties:{name:"Dale Davis", url:"https://themoviedb.org/person/1662370"}}, {tmdbId:"1336769", properties:{imdbId:"0152719", name:"Theodore Charach", url:"https://themoviedb.org/person/1336769"}}, {tmdbId:"582649", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0022404", born:date('1931-04-06'), name:"Ram Dass", bio:"From Wikipedia, the free encyclopedia\n\nRam Dass (born Richard Alpert; April 6, 1931 – December 22, 2019), also known as Baba Ram Dass, was an American spiritual teacher, academic and clinical psychologist, and author.  His books include the 1971 Be Here Now.  He founded the charitable organizations Seva Foundation and Hanuman Foundation...", died:date('2019-12-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9emwUEIY5qNIK3aXx6xJ9TfYZwd.jpg", url:"https://themoviedb.org/person/582649"}}, {tmdbId:"67960", properties:{imdbId:"0219332", name:"Barbara Dennek", url:"https://themoviedb.org/person/67960"}}, {tmdbId:"18242", properties:{imdbId:"0537392", name:"Rita Maiden", bio:"Rita Maiden is a French stage and screen actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z21gHqDxwCgBxdzySbmZVYHNARQ.jpg", url:"https://themoviedb.org/person/18242"}}, {tmdbId:"39145", properties:{bornIn:"Boulogne-Billancourt, France", imdbId:"0750114", born:date('1939-05-01'), name:"France Rumilly", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/znA3akSmA5bVt29RD52rGokZl7T.jpg", url:"https://themoviedb.org/person/39145"}}, {tmdbId:"26512", properties:{bornIn:"Manhattan, New York, United States", imdbId:"0005279", born:date('1924-08-02'), name:"Carroll O'Connor", bio:"From Wikipedia, the free encyclopedia.  John Carroll O'Connor (August 2, 1924 – June 21, 2001) best known as Carroll O'Connor, was an American actor, producer and director whose television career spanned four decades...", died:date('2001-06-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/28NNmJGHFzdEK0GJLhL4NnGpmF7.jpg", url:"https://themoviedb.org/person/26512"}}, {tmdbId:"53815", properties:{bornIn:"Shotts, Lanarkshire, Scotland, UK", imdbId:"0445139", born:date('1926-04-03'), name:"Andrew Keir", died:date('1997-10-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4FeHARcXJTu2TpUxy1eAoPR3Eim.jpg", url:"https://themoviedb.org/person/53815"}}, {tmdbId:"740", properties:{bornIn:"London, England ", imdbId:"0002103", born:date('1935-03-27'), name:"Julian Glover", bio:"Primarily a classical stage actor, Julian Glover trained at the National Youth Theatre, performed with the Royal Shakespeare Company and became a familiar face to British television viewers by appearing in many popular series during the 1960s and 1970s.  His talent for accents and cold expression made him an ideal choice for playing refined villains...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yqFGLoY6CRy9jGp3NI328VlsaIG.jpg", url:"https://themoviedb.org/person/740"}}, {tmdbId:"43814", properties:{bornIn:"Oujda, Morocco.", imdbId:"0217677", born:date('1941-08-01'), name:"Nathalie Delon", bio:"Nathalie Delon was born on August 1, 1941 in Oujda, French Protectorate Morocco as Francine Canovas.  She is an actress, known for Le Samouraï (1967), They Call It an Accident (1982) and When Eight Bells Toll (1971).  She was previously married to Alain Delon and Guy Barthelemy...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fi4yWaHUDaLRZ468dfyHnU8rxlJ.jpg", url:"https://themoviedb.org/person/43814"}}, {tmdbId:"43815", properties:{bornIn:"Fort-de-France, Martinique.", imdbId:"0742975", born:date('1945-01-02'), name:"Cathy Rosier", bio:"Cathy Rosier (January 2, 1945 in Fort-de-France – May 17, 2004) was a model and actress, who was born in Martinique, French West Indies, and died in Marrakech, Morocco, from a ruptured aorta. \n\nShe is perhaps best known for her role as the pianist Valerie in Jean-Pierre Melville's Le Samouraï (1967)...", died:date('2004-05-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rIRANkrxCNFrRFu61ranyBOO3pR.jpg", url:"https://themoviedb.org/person/43815"}}, {tmdbId:"545810", properties:{bornIn:"Rio de Janeiro , Brasil", imdbId:"0276910", born:date('1927-07-24'), name:"Jardel Filho", bio:"A arte de representar - em todas as suas facetas esteve presente na vida de Jardel Jercolis Filho todos os dias, do primeiro ao último.  Nascido em família tradicional de artistas, seu pai foi o empresário teatral Jardel Jercolis e sua mãe a atriz Lídia Bôscoli, tendo seu parto acontecido em São Paulo durante uma temporada artística da companhia paterna naquela cidade...", died:date('1983-02-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/alfrR5rh0zQbNP8GakLOfBJvVlO.jpg", url:"https://themoviedb.org/person/545810"}}, {tmdbId:"213618", properties:{bornIn:"Rio de Janeiro, Rio de Janeiro, Brazil", imdbId:"0042623", born:date('1922-09-07'), name:"Paulo Autran", bio:"Paulo Paquet Autran was a Brazilian film and theater actor.  His accomplishments during his life earned him the nickname, \"Lord of the Stage\"...", died:date('2007-10-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4jeN0UzXFBVNvldg7PvB95C6Zro.jpg", url:"https://themoviedb.org/person/213618"}}, {tmdbId:"57379", properties:{bornIn:"Veranópolis, Rio Grande do Sul, Brazil", imdbId:"0506784", born:date('1920-11-16'), name:"José Lewgoy", died:date('2003-02-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lYFqWEKINFU2TelnTItyIxUhZTw.jpg", url:"https://themoviedb.org/person/57379"}}, {tmdbId:"545811", properties:{imdbId:"0733791", born:date('1933-08-16'), name:"Glauce Rocha", died:date('1971-08-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/55TVjbWveAQni1YDSO24bGn0jBL.jpg", url:"https://themoviedb.org/person/545811"}}, {tmdbId:"21277", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0001546", born:date('1936-12-29'), name:"Mary Tyler Moore", bio:"Mary Tyler Moore was an American actress, primarily known for her roles in television sitcoms.   Moore is best known for The Mary Tyler Moore Show (1970–77), in which she starred as Mary Richards, a 30-something single woman who worked as a local news producer in Minneapolis, and for her earlier role as Laura Petrie (Dick Van Dyke's wife) on The Dick Van Dyke Show (1961–66)...", died:date('2017-01-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lk7nlossLm8jZwbNerXyjosoYVK.jpg", url:"https://themoviedb.org/person/21277"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"97832", properties:{bornIn:" Seattle, Washington, USA", imdbId:"0151919", born:date('1921-01-31'), name:"Carol Channing", bio:"From Wikipedia, the free encyclopedia\n\nCarol Elaine Channing (January 31, 1921 – January 15, 2019) was an American actress, singer, dancer and comedian.  Known for starring in Broadway and film musicals, her characters typically radiated a fervent expressiveness and an easily identifiable voice, whether singing or for comedic effect.  Channing also studied acting at the Neighborhood Playhouse School of the Theatre in New York City...", died:date('2019-01-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jWOr0XWdtOdAuVcSdERWJdRV6dR.jpg", url:"https://themoviedb.org/person/97832"}}, {tmdbId:"134234", properties:{bornIn:"Southmoor, Berkshire, England, UK", imdbId:"0730938", born:date('1944-03-17'), name:"Christian Roberts", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dfbpbqXQOrwHWFWucxathp2JdpV.jpg", url:"https://themoviedb.org/person/134234"}}, {tmdbId:"41234", properties:{bornIn:"Arundel, Sussex, England, United Kingdom", imdbId:"0002096", born:date('1948-09-10'), name:"Judy Geeson", bio:"Judith Amanda \"Judy\" Geeson (born 10 September 1948) is a British actor. Her first major film appearance was as wayward teenager Pamela Dare in To Sir, with Love in 1967 alongside Sidney Poitier and popular singer Lulu.  In the same year, she appeared in Berserk!.  She became well-known as a result of a regular role in the BBC early-evening soap opera, The Newcomers.  She also had a major role in the popular 1970s costume drama Poldark as Caroline Penvenen Enys...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6HXwztsdjeK4QbgKd1sHlheDfx3.jpg", url:"https://themoviedb.org/person/41234"}}, {tmdbId:"93476", properties:{bornIn:"Belper, Derbyshire, England, UK", imdbId:"0447648", born:date('1937-01-01'), name:"Suzy Kendall", bio:"​From Wikipedia, the free encyclopedia.   \n\nSuzy Kendall (born Frieda Harrison 1 January 1944) is a British actress best known for her film roles in the late 1960s and early 1970s.  Her blonde attractive looks got her leading roles in some fairly prestigious productions.  She later appeared in increasingly lower-profile films, including several giallo thrillers made in Italy and several TV series in the 1970s before retiring to spend more time with her family...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x2KEWyZEsK0ePRVK9hgn95piT3i.jpg", url:"https://themoviedb.org/person/93476"}}, {tmdbId:"153112", properties:{name:"Patrick Bedford", url:"https://themoviedb.org/person/153112"}}, {tmdbId:"8493", properties:{bornIn:"Perth Amboy - New Jersey - USA", imdbId:"0925418", born:date('1914-04-24'), name:"Ruth White", bio:"Ruth White was born on April 24, 1914 in Perth Amboy, New Jersey, USA as Ruth Patricia White.  She was an actress, known for Du silence et des ombres. . .  (1962),Macadam cowboy (1969) and Pendez-les haut et court (1968).  She died on December 3, 1969 in Perth Amboy. \n\nHer death, from cancer, was sudden and unexpected. \n\nShe spent the final decade of her life as one of New York's most highly praised character actresses...", died:date('1969-12-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bsAHZQuh9XtWQoBalne2yTia7gt.jpg", url:"https://themoviedb.org/person/8493"}}, {tmdbId:"30121", properties:{bornIn:"Vancouver, British Columbia, Canada", imdbId:"0662808", born:date('1942-05-22'), name:"Barbara Parkins", bio:"From Wikipedia, the free encyclopedia.   Barbara Parkins (born May 22, 1942) is a Canadian television and film actress. \n\nDescription above from the Wikipedia article Barbara Parkins , licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zElW9r2g4ii2g9XAFoWTFqizUav.jpg", url:"https://themoviedb.org/person/30121"}}, {tmdbId:"27446", properties:{bornIn:"Elmhurst, Queens, New York, United States", imdbId:"0001157", born:date('1946-12-14'), name:"Patty Duke", bio:"Patty Duke was born Anna Marie Duke on December 14, 1946 in Elmhurst, New York, to Frances Margaret (McMahon), a cashier, and John Patrick Duke, a cab driver and handyman.  She is of Irish, and one eighth German, descent.  Her acting career began when she was introduced to her brother Ray Duke's managers, John and Ethel Ross.  Soon after, Anna Marie became Patty, the actress.  Patty started off in commercials, a few movies and some bit parts...", died:date('2016-03-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aQLjPeXawYEGa6OT8Hhn16GJWG2.jpg", url:"https://themoviedb.org/person/27446"}}, {tmdbId:"13946", properties:{bornIn:"New Orleans - Louisiana - USA", imdbId:"0121826", born:date('1926-07-21'), name:"Paul Burke", bio:"From Wikipedia, the free encyclopedia\n\nPaul Burke (July 21, 1926 – September 13, 2009) was an American actor best known for his lead roles in two 1960s ABC television series, Naked City and Twelve O'Clock High.  He was twice nominated for an Emmy Award for his portrayal of New York Police Department detective Adam Flint in Naked City. \n\nDescription above from the Wikipedia article Paul Burke (actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2009-09-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nrlWptUxvfMlyGLXPnm5RZTxIQ9.jpg", url:"https://themoviedb.org/person/13946"}}, {tmdbId:"34981", properties:{bornIn:"New York City, New York, USA", imdbId:"0956544", born:date('1918-11-30'), name:"Efrem Zimbalist Jr.", bio:"​From Wikipedia, the free encyclopedia\n\nEfrem Zimbalist Jr.  (November 30, 1918 – May 2, 2014) was an American actor known for his starring roles in the television series 77 Sunset Strip and The F. B. I.  He is also known as recurring character \"Dandy Jim Buckley\" in the series Maverick and as the voice behind the character Alfred Pennyworth in Batman: The Animated Series and associated spin-offs...", died:date('2014-05-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nMfmluUYjgQODrLwwUDHh7QQtww.jpg", url:"https://themoviedb.org/person/34981"}}, {tmdbId:"10068", properties:{bornIn:"Ōta, Tokyo, Japon", imdbId:"0906686", born:date('1941-08-26'), name:"Akiko Wakabayashi", bio:"​From Wikipedia, the free encyclopedia. \n\nAkiko Wakabayashi (born December 13, 1939 in Ōta, Tokyo) is a Japanese actress, best known in English-speaking countries for her role as Bond girl, Aki in the 1967 James Bond movie You Only Live Twice.  Prior to this, she made many movies in her native Japan, especially Toho Studio's monster movies such as Dagora, the Space Monster and Ghidorah, the Three-Headed Monster (both of which were also released under various other titles)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yyooKuVECPdc3IlPFVlGvoMEmBd.jpg", url:"https://themoviedb.org/person/10068"}}, {tmdbId:"10070", properties:{bornIn:"Tokyo, Japan", imdbId:"0357240", born:date('1943-11-20'), name:"Mie Hama", bio:"Mie Hama (born 20 November 1943, Tokyo, Japan) is a Japanese actress, best-known outside Japan for her role as Kissy Suzuki in the 1967 James Bond film You Only Live Twice. \n\nDescription above from the Wikipedia articleMie Hama, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9fKiEOkLDn6nnBnKiU2Uh8UOo6n.jpg", url:"https://themoviedb.org/person/10070"}}, {tmdbId:"246", properties:{bornIn:"Van Nuys, California, USA", imdbId:"0516972", born:date('1937-02-21'), name:"Gary Lockwood", bio:"Gary Lockwood (born February 21, 1937) is an American actor perhaps best known for his iconic 1968 role as the astronaut Dr.  Frank Poole in 2001: A Space Odyssey.  He is father of the actress Samantha Lockwood.  Both currently live in Los Angeles...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lQBqZKpMxGslopZRvFanIWL4pSl.jpg", url:"https://themoviedb.org/person/246"}}, {tmdbId:"247", properties:{bornIn:"Oakland, California, USA", imdbId:"0843213", born:date('1922-01-31'), name:"William Sylvester", bio:"William Sylvester (January 31, 1922 – January 25, 1995) was an American TV and film actor.  His most famous film credit was Dr.  Heywood Floyd in Stanley Kubrick's 2001 A Space Odyssey (1968).  Born in Oakland, California and married at one time to the British actress Veronica Hurst, he moved to England after the Second World War and became a staple of British B films at a time when American and Canadian actors were much in demand in order to give indigenous films some appeal in the US...", died:date('1995-01-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uTBTJscyXqvDWpv17QyT4VVDAJn.jpg", url:"https://themoviedb.org/person/247"}}, {tmdbId:"248", properties:{imdbId:"0725220", name:"Daniel Richter", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cq8Fprv33RgYPwu39cGx6fxk5Qp.jpg", url:"https://themoviedb.org/person/248"}}, {tmdbId:"3507", properties:{bornIn:"Dijon, France", imdbId:"0415283", born:date('1948-10-08'), name:"Claude Jade", bio:"​From Wikipedia, the free encyclopedia.   \n\nClaude Marcelle Jorré, better known as Claude Jade (8 October 1948 – 1 December 2006), was a French actress, known for starring as Christine in François Truffaut's three films Stolen Kisses (1968), Bed and Board (1970) and Love on the Run (1979).  Jade acted in theatre, film and television.  Her film work outside of France included the Soviet Union, the United States, Italy and Japan...", died:date('2006-12-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8FdnAVouotoEuvTSqTP3f7ykH8P.jpg", url:"https://themoviedb.org/person/3507"}}, {tmdbId:"2369", properties:{bornIn:"Paris, France", imdbId:"0003909", born:date('1931-05-24'), name:"Michael Lonsdale", bio:"​From Wikipedia, the free encyclopedia.   \n\nMichael Lonsdale (born May 24, 1931), sometimes billed as Michel Lonsdale, is a French actor who has appeared in over 180 films and television shows. \n\nLonsdale was raised by an Irish mother and an English father, initially in London and on Jersey, and later during the Second World War in Casablanca, Morocco.  He moved to Paris to study painting in 1947 but was drawn in to the world of acting instead, first appearing on stage at the age of 24...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lQZktsBj1CFbIEIpXOZp55kCiB5.jpg", url:"https://themoviedb.org/person/2369"}}, {tmdbId:"29426", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0492342", born:date('1937-09-07'), name:"John Phillip Law", bio:"​From Wikipedia, the free encyclopedia\n\nJohn Phillip Law (September 7, 1937 – May 13, 2008) was an American film actor with over one hundred movie roles to his credit.  He was born in Los Angeles, California, the son of actress Phyllis Sallee and the brother of actor Thomas Augustus Law (also known as Tom Law)...", died:date('2008-05-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rOeYyCDvdY8jBq3DGBUcrjf8Ppu.jpg", url:"https://themoviedb.org/person/29426"}}, {tmdbId:"53768", properties:{bornIn:"Rome, Italy", imdbId:"0657848", born:date('1944-01-25'), name:"Anita Pallenberg", bio:"​From Wikipedia, the free encyclopedia\n\nAnita Pallenberg (born 25 January 1944, Rome, Italy) was an Italian-born actress, model, and fashion designer.  She was the romantic partner of Rolling Stones multi-instrumentalist and guitarist Brian Jones and later the partner of the guitarist of the same band Keith Richards, from 1967 to 1979, by whom she has two surviving children. \n\nDescription above from the Wikipedia Anita Pallenberg, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2017-06-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aqkEA95ks1RdqzUkjJBVplXNKPv.jpg", url:"https://themoviedb.org/person/53768"}}, {tmdbId:"47137", properties:{imdbId:"0642675", born:date('1926-06-02'), name:"Milo O'Shea", died:date('2013-04-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wLcWVAw2REUJMT9JjbQbVXLqQkZ.jpg", url:"https://themoviedb.org/person/47137"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"14060", properties:{bornIn:"New York City, New York, USA", imdbId:"0001816", born:date('1932-11-22'), name:"Robert Vaughn", bio:"Robert Francis Vaughn, Ph. D.  (November 22, 1932 – November 11, 2016) is an American actor noted for stage, film and television work.  He is perhaps best known as suave spy Napoleon Solo in the 1960s television series The Man from U. N. C. L. E.  and as Albert Stroller in the BBC One series Hustle...", died:date('2016-11-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pr3rSNexNO1VRhT7p202GiprVmj.jpg", url:"https://themoviedb.org/person/14060"}}, {tmdbId:"14061", properties:{bornIn:"Weybridge, Surrey, England, UK", imdbId:"0000302", born:date('1944-09-13'), name:"Jacqueline Bisset", bio:"Jacqueline Bisset (born 13 September 1944) is an English actress.  She has been nominated for four Golden Globe Awards and an Emmy Award.  She is known for her roles in the films Bullitt (1968), Airport (1970), The Deep (1977), Class (1983), and the TV series Nip/Tuck in 2006.  She has also appeared in several French productions and was nominated for a César Award for La cérémonie (1995).  She was awarded the Légion d'Honneur in 2010...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zJbUXcz16VleT9lx33TaUlMn9CJ.jpg", url:"https://themoviedb.org/person/14061"}}, {tmdbId:"14062", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0330150", born:date('1926-11-13'), name:"Don Gordon", bio:"Don Gordon was an American film and television actor, best known for playing in feature films alongside his friend Steve McQueen, such as \"Bullitt\", \"Papillon\" and \"The Towering Inferno\", as well as the western series \"Wanted: Dead or Alive\"...", died:date('2017-04-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n9gIyolDCmQyvK2TarsJ6rcsQ5m.jpg", url:"https://themoviedb.org/person/14062"}}, {tmdbId:"43237", properties:{bornIn:"Landskrona, Sweden", imdbId:"0042046", born:date('1950-02-13'), name:"Ewa Aulin", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hlwBufco9oKfj88GQUK1mRHrUZG.jpg", url:"https://themoviedb.org/person/43237"}}, {tmdbId:"96055", properties:{imdbId:"0417824", born:date('1917-04-01'), name:"Leon Janney", died:date('1980-10-28'), url:"https://themoviedb.org/person/96055"}}, {tmdbId:"70307", properties:{bornIn:"St John's Wood, London, England, UK", imdbId:"0398141", born:date('1930-07-20'), name:"Sally Ann Howes", bio:"From Wikipedia, the free encyclopedia\n\nSally Ann Howes (born 20 July 1930) is a British actress and singer, who currently holds dual British-American citizenship.  Her career on stage, screen and television has spanned over six decades.  She is best remembered for the role of Truly Scrumptious in the 1968 musical film, Chitty Chitty Bang Bang. \n\nDescription above from the Wikipedia article Sally Ann Howes, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sBV6vbWxrqvP2JiueYEwCDmzDjd.jpg", url:"https://themoviedb.org/person/70307"}}, {tmdbId:"40168", properties:{bornIn:"Sarnia, Ontario, Canada", imdbId:"0164540", born:date('1940-03-08'), name:"Susan Clark", bio:"From Wikipedia, the free encyclopedia. \n\nSusan Clark (born March 8, 1940) is a Canadian actress, possibly best-known for her role as Katherine on the American television sitcom Webster, on which she appeared with her husband, Alex Karras. \n\nDescription above from the Wikipedia article Susan Clark, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d2nKGmTLi0wXw57xhzBZrcUSukE.jpg", url:"https://themoviedb.org/person/40168"}}, {tmdbId:"94774", properties:{bornIn:"Los Angeles, California, U.S.", imdbId:"0827594", born:date('1944-12-10'), name:"Tisha Sterling", bio:"​From Wikipedia, the free encyclopedia.   \n\nTisha Sterling (born December 10, 1944) is an American television and film actress.  She is the daughter of actor Robert Sterling and actress/singer Ann Sothern. \n\nDescription above from the Wikipedia article Tisha Sterling, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/94774"}}, {tmdbId:"10074", properties:{bornIn:"Bournemouth, Dorset, England, UK", imdbId:"0336509", born:date('1928-08-29'), name:"Charles Gray", bio:"Charles Gray (29 August 1928 - 7 March 2000) was an English actor who was well-known for roles including the arch-villain Blofeld in the James Bond film Diamonds Are Forever, Sherlock Holmes' brother Mycroft Holmes in the Granada television series, and as the narrator of the cult classic The Rocky Horror Picture Show in 1975...", died:date('2000-03-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qwNOQuXoRQXL2jT2uEbrB7zImC4.jpg", url:"https://themoviedb.org/person/10074"}}, {tmdbId:"18768", properties:{bornIn:"Nice, Alpes-Maritimes, France", imdbId:"0037316", born:date('1947-03-09'), name:"Nike Arrighi", bio:"Niké Arrighi is a French visual artist and former actress, known for roles in several European horror and art house films in the 1960s and '70s in addition to work in television.  She retired from film and television after marrying Prince Paolo di Borghese, since when she has been a visual artist specializing in copperplate etching...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yH1miAd3AMu3SLWnZ3voqmvD6FY.jpg", url:"https://themoviedb.org/person/18768"}}, {tmdbId:"113700", properties:{bornIn:"West Ham, London, England, UK", imdbId:"0338839", born:date('1931-01-01'), name:"Leon Greene", url:"https://themoviedb.org/person/113700"}}, {tmdbId:"3142", properties:{bornIn:"New York City, New York, USA", imdbId:"0549134", born:date('1907-10-17'), name:"John Marley", bio:"From Wikipedia, the free encyclopedia\n\nJohn Marley (October 17, 1907 – May 22, 1984) was an American actor who was known for his role as Phil Cavalleri in Love Story and as Jack Woltz— the defiant movie mogul who awakens to find the severed head of his prized horse in his bed—in The Godfather (1972).  He starred in John Cassavetes' breakthrough feature Faces (1968) and appeared in The Glitter Dome (1984)...", died:date('1984-05-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/17yS4z3BXZmOL1ocoINXDDGic8b.jpg", url:"https://themoviedb.org/person/3142"}}, {tmdbId:"11140", properties:{bornIn:"Los Angeles, U.S.A", imdbId:"0137524", born:date('1938-01-31'), name:"Lynn Carlin", bio:"From Wikipedia, the free encyclopedia\n\n​Lynn Carlin (born Lynn Reynolds on January 31, 1938 in Los Angeles, California) is an American actress.  She was nominated for Best Supporting Actress Oscar for her role in the movie Faces.  Her father, Larry Reynolds, was a Hollywood business manager in the 1930s.  She made her stage debut in Clare Booth Luce's The Women at the Laguna Beach Playhouse...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gTcLzPKegcJgl7TkUfchCSVSWzL.jpg", url:"https://themoviedb.org/person/11140"}}, {tmdbId:"11141", properties:{bornIn:"Chester, Pennsylvania, USA", imdbId:"0237134", born:date('1925-09-02'), name:"Fred Draper", bio:"Frederick P.  \"Fred\" Draper (b.  September 2, 1925, Chester, Pennsylvania — d.  December 28, 1999, Rancho Cucamonga, San Bernardino County, California) was an American film and television actor.  He appeared on numerous television programs and films. \n\nPaul (Fred) Draper attended the American Academy of Dramatic Arts in New York graduating in 1947.  He attended with such luminaries as Ann Bancroft, Grace Kelley, and John Cassevetted.  While there he roomed with Cassevettes and Harry Masters...", died:date('1999-12-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ti3kVdLCdevTQFSo7D5ydA4PbnG.jpg", url:"https://themoviedb.org/person/11141"}}, {tmdbId:"89841", properties:{bornIn:"New York City, New York, USA", imdbId:"0575552", born:date('1919-09-14'), name:"Kay Medford", died:date('1980-04-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lKZ8tZwfHoJc7Qld9Ncvr71MEc8.jpg", url:"https://themoviedb.org/person/89841"}}, {tmdbId:"51377", properties:{bornIn:"Naponee, Nebraska, USA", imdbId:"0418148", born:date('1931-03-27'), name:"David Janssen", bio:"David Janssen (1931–1980) was an American film and television actor who is best known for his starring role on The Fugitive and Harry O...", died:date('1980-02-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cByEjF4mOkReK0sBeBDer0iPe8o.jpg", url:"https://themoviedb.org/person/51377"}}, {tmdbId:"88450", properties:{bornIn:" Brooklyn, New York, USA", imdbId:"0564841", born:date('1934-09-02'), name:"Chuck McCann", bio:"A third generation performer, Chuck McCann was already a show business veteran by age 11.  By age 19, he had performed in nightclubs, made guest TV appearances, and was a semi-regular on The Steve Allen Show.  Chuck's extensive career includes The Chuck McCann Show, Let's Have Fun Show, Little Orphan Annie, The World of Hans Christian Anderson, Herbie Rides Again, Men in Tights, Storyville...", died:date('2018-04-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/s3qNTQbRHRfbLd2rdtEl0Lmh2va.jpg", url:"https://themoviedb.org/person/88450"}}, {tmdbId:"88455", properties:{bornIn:"Somerville, Massachusetts, USA", imdbId:"0540992", born:date('1918-12-14'), name:"Peter Mamakos", died:date('2008-04-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9AcNSPm1AddOSBBwNPiWpDtHXp4.jpg", url:"https://themoviedb.org/person/88455"}}, {tmdbId:"53552", properties:{bornIn:"Newton, Massachusetts, USA", imdbId:"0641599", born:date('1926-05-05'), name:"John O'Leary", died:date('2019-06-05'), url:"https://themoviedb.org/person/53552"}}, {tmdbId:"30470", properties:{bornIn:"Aomori, Aomori Prefecture, Japan", born:date('1913-08-28'), name:"Jun Tazaki", bio:"Jun Tazaki (田崎 潤 Tazaki Jun, 28 August 1913 – 18 October 1985) (real name Minoru Tanaka) was a Japanese actor best known for his various roles from Kaiju films produced by Toho, often cast in the roles of scientists or military personnel...", died:date('1985-10-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xCaRyiMo8sleDYjLKGl8xUXsIHQ.jpg", url:"https://themoviedb.org/person/30470"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"30471", properties:{bornIn:"Tokyo - Japan", imdbId:"0462085", born:date('1946-10-06'), name:"Yukiko Kobayashi", bio:"Yukiko Kobayashi (小林夕岐子 Kobayashi Yukiko) is a former Japanese actress.  She made her acting debut in Ishiro Honda's Oyome ni Oide in 1966, and went on to appear in two of the director's tokusatsu films for Toho, Destroy All Monsters in 1968 and Space Amoeba in 1970.  Kobayashi also played the title role in The Vampire Doll, the first entry in director Michio Yamamoto's Bloodthirsty Trilogy...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sWiVN7tj7lEXl9v4M3nwliGqKLL.jpg", url:"https://themoviedb.org/person/30471"}}, {tmdbId:"17540", properties:{bornIn:"Koshu, Yamanashi Prefecture, Japan", imdbId:"0875237", born:date('1927-05-18'), name:"Yoshio Tsuchiya", bio:"Yoshio Tsuchiya (土屋 嘉男 Tsuchiya Yoshio, May 18, 1927 – February 8, 2017) was a Japanese actor who appeared in such films as Akira Kurosawa's SEVEN SAMURAI (1953), and GODZILLA RAIDS AGAIN (1955)...", died:date('2017-02-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mU0dJP8dZxSucRTung1mZmL2TDh.jpg", url:"https://themoviedb.org/person/17540"}}, {tmdbId:"548337", properties:{bornIn:"Basel", imdbId:"0111188", born:date('1933-06-22'), name:"Peter Brogle", died:date('2006-03-27'), url:"https://themoviedb.org/person/548337"}}, {tmdbId:"26411", properties:{imdbId:"0717130", born:date('1932-01-07'), name:"Wolfgang Reichmann", died:date('1991-05-07'), url:"https://themoviedb.org/person/26411"}}, {tmdbId:"548336", properties:{imdbId:"0951613", name:"Athina Zacharopoulou", url:"https://themoviedb.org/person/548336"}}, {tmdbId:"1463981", properties:{imdbId:"0903154", name:"Wolfgang von Ungern-Sternberg", url:"https://themoviedb.org/person/1463981"}}, {tmdbId:"4173", properties:{bornIn:"Margam, Port Talbot, Glamorgan, Wales, UK", imdbId:"0000164", born:date('1937-12-31'), name:"Anthony Hopkins", bio:"Anthony Hopkins was born on 31 December 1937, in Margam, Glamorgan, Wales.  Influenced by Richard Burton, he decided to study at College of Music and Drama in Cardiff and graduated in 1957.  In 1965, he moved to London and joined the National Theatre, invited by Laurence Olivier, who could see the talent in Hopkins.  In 1967, he made his first film for television, A Flea in Her Ear (1967) (TV). \n\nFrom this moment on, he enjoyed a successful career in cinema and television...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9ukJS2QWTJ22HcwR1ktMmoJ6RSL.jpg", url:"https://themoviedb.org/person/4173"}}, {tmdbId:"51755", properties:{bornIn:"Woking, Surrey, England, UK", imdbId:"0644707", born:date('1943-09-30'), name:"Ian Ogilvy", bio:"From Wikipedia, the free encyclopedia\n\nIan Raymond Ogilvy (born 30 September 1943) is an English film and television actor. \n\nDescription above from the Wikipedia article Ian Ogilvy, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jacGFR5zXAPINkVyuuhHxu53YL7.jpg", url:"https://themoviedb.org/person/51755"}}, {tmdbId:"74689", properties:{bornIn:"Liverpool, England, UK", imdbId:"0203959", born:date('1916-05-22'), name:"Rupert Davies", bio:"From Wikipedia, the free encyclopedia\n\nRupert Davies (22 May 1916 – 22 November 1976) was a British actor.  He remains best known for playing the title role in the BBC's 1960s television adaptation of Maigret, based on the Maigret novels written by Georges Simenon. \n\nDavies was born in Liverpool.  After a service in the British Merchant Navy, during the Second World War he was a Sub-Lieutenant Observer with the Fleet Air Arm...", died:date('1976-11-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/t6eAo7kE4D3O0NufFl1vCPcYltY.jpg", url:"https://themoviedb.org/person/74689"}}, {tmdbId:"108641", properties:{bornIn:"Liverpool, Lancashire, England, UK", imdbId:"0245495", born:date('1945-05-06'), name:"Hilary Heath", died:date('2020-04-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/prHLfAH7UNATZmJ93Cb5qm4Pb2W.jpg", url:"https://themoviedb.org/person/108641"}}, {tmdbId:"97912", properties:{bornIn:"New York City, New York USA", imdbId:"0427977", born:date('1936-02-02'), name:"Duane Jones", bio:"Duane L.  Jones (February 2, 1936 – July 22, 1988) was an American actor, best known for his role as Ben in the 1968 horror film Night of the Living Dead.  He was director of the Maguire Theater at the State University of New York at Old Westbury.  He was the artistic director of the Richard Allen Center for Culture and Art in Manhattan. \n\nDescription above from the Wikipedia article Duane Jones, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1988-07-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tJDNT02fyX0CE1Yv7ZbeFkSzwMd.jpg", url:"https://themoviedb.org/person/97912"}}, {tmdbId:"97913", properties:{bornIn:"Pittsburgh, Pennsylvania, USA", imdbId:"0640621", born:date('1945-04-20'), name:"Judith O'Dea", bio:"From Wikipedia, the free encyclopedia. \n\nJudith O'Dea (born April 20, 1945) is an American actress known for her role as Barbra in the George A.  Romero film Night of the Living Dead (1968). \n\nDescription above from the Wikipedia article Judith O'Dea, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nihfq3xdU22xnxHKmqA0Mv9rUvv.jpg", url:"https://themoviedb.org/person/97913"}}, {tmdbId:"97914", properties:{bornIn:"Pittsburgh, Pennsylvania, USA", imdbId:"0362457", born:date('1927-03-22'), name:"Karl Hardman", bio:"From Wikipedia, the free encyclopedia. \n\nKarl Hardman (March 22, 1927 – September 22, 2007) was an American horror film producer and actor.  He produced George A.  Romero's Night of the Living Dead (1968) and also co-starred as Harry Cooper.  He also appeared in Santa Claws (1996) as Bruce Brunswick.  He was born Karl Hardman Schon in Pittsburgh, Pennsylvania. \n\nDescription above from the Wikipedia article Karl Hardman, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2007-09-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vs5xLO71stUS3Cn1UD1EWeGAa7b.jpg", url:"https://themoviedb.org/person/97914"}}, {tmdbId:"97915", properties:{bornIn:"Iowa, USA", imdbId:"0247659", born:date('1933-12-17'), name:"Marilyn Eastman", bio:"From Wikipedia, the free encyclopedia. \n\nMarilyn Eastman (born 1927) is an American actress known for her role as Helen Cooper in the film Night of the Living Dead (1968).  She also appeared in the films Houseguest (1995) and Santa Claws (1996). \n\nContrary to popular belief, Eastman was not married to her co-star from Night of the Living Dead, Karl Hardman, who played her husband in the film.  She was married to writer and broadcaster John F.  Eastman...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qQqJ6tUNHHJWTrUJNR3D5xYFf28.jpg", url:"https://themoviedb.org/person/97915"}}, {tmdbId:"14832", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0248983", born:date('1933-11-05'), name:"Herb Edelman", bio:"From Wikipedia, the free encyclopedia. \n\nHerbert \"Herb\" Edelman (November 5, 1933 – July 21, 1996) was an American actor of stage, film and television.  He was twice nominated for an Emmy Award for his television work.  One of his best remembered roles was as Stanley Zbornak, the ex-husband of Dorothy Zbornak (played by Beatrice Arthur) on the long-running situation comedy, The Golden Girls.  He also had a recurring role on the 1980s medical drama St.  Elsewhere...", died:date('1996-07-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6JEFak01Mykrsa654CDkx9Elm4D.jpg", url:"https://themoviedb.org/person/14832"}}, {tmdbId:"41236", properties:{bornIn:"London, England, UK", imdbId:"0600531", born:date('1924-01-08'), name:"Ron Moody", bio:"From Wikipedia, the free encyclopedia\n\nRon Moody (born Ronald Moodnick; 8 January 1924) is an English actor. \n\nDescription above from the Wikipedia article Ron Moody, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2015-06-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xCEPHWkeFrJd7sXpKLJiFA5ibJP.jpg", url:"https://themoviedb.org/person/41236"}}, {tmdbId:"129437", properties:{bornIn:"Tottenham, London, England, UK", imdbId:"0908861", born:date('1933-04-14'), name:"Shani Wallis", bio:"From Wikipedia, the free encyclopedia\n\nShani Wallis (born 14 April 1933) is an English actress and singer, who released several records in the 1950s. \n\nWallis was born in Tottenham, London.  Making her first stage appearance at the age of four, she later studied at the Royal Academy of Dramatic Art (RADA) on a scholarship...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jKtibUuRMT044OmNV6DBXSVSPP8.jpg", url:"https://themoviedb.org/person/129437"}}, {tmdbId:"936", properties:{bornIn:"Wimbledon, London, England, UK", imdbId:"0001657", born:date('1938-02-13'), name:"Oliver Reed", bio:"Robert Oliver Reed (13 February 1938 – 2 May 1999) was an English actor known for his upper-middle class, macho image and \"hellraiser\" lifestyle.  Notable films include The Trap (1966), Oliver! (1968), Women in Love (1969), Hannibal Brooks (1969), The Devils (1971), portraying Athos in The Three Musketeers (1973), Tommy (1975), Lion of the Desert (1981), Castaway (1986), The Adventures of Baron Munchausen (1988), Funny Bones (1995) and Gladiator (2000)...", died:date('1999-05-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pTNQuVjfSmlN5Ns3NFr5Zck8iyx.jpg", url:"https://themoviedb.org/person/936"}}, {tmdbId:"125459", properties:{bornIn:"Swansea, Wales, UK", imdbId:"0781183", born:date('1921-09-08'), name:"Harry Secombe", bio:"From Wikipedia\n\nSir Harry Donald Secombe, CBE (8 September 1921 – 11 April 2001) was a Welsh comedian and singer.  He played Neddie Seagoon, a central character in the BBC radio comedy series The Goon Show (1951–60).  He also appeared in musicals and films and, in his later years, was a presenter of television shows incorporating hymns and other devotional songs. \n\nWith the success of The Goon Show, Secombe developed a dual career as both a comedy actor and a singer...", died:date('2001-04-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fs5AB7yXSAIx94BMWb9hTy9IztS.jpg", url:"https://themoviedb.org/person/125459"}}, {tmdbId:"21818", properties:{bornIn:"New York City, New York, USA", imdbId:"0000690", born:date('1946-08-16'), name:"Lesley Ann Warren", bio:"Lesley Ann Warren (born August 16, 1946) is an American actress and singer who has appeared in more than sixty films, including The Happiest Millionaire, Victor Victoria, Clue, Burglar, Cop, Color of Night and Secretary.  She has also had roles in popular TV shows such as Mission: Impossible, Desperate Housewives, Crossing Jordan, Will & Grace, and In Plain Sight...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lNzHL38hPCAC4ZqI0mVFVgXrLsM.jpg", url:"https://themoviedb.org/person/21818"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"1915", properties:{imdbId:"0203384", born:date('1941-12-13'), name:"John Davidson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mc31UVu7kZWz2iYuRZqt3nSBwhL.jpg", url:"https://themoviedb.org/person/1915"}}, {tmdbId:"66834", properties:{imdbId:"0519296", born:date('1942-01-29'), name:"Claudine Longet", url:"https://themoviedb.org/person/66834"}}, {tmdbId:"66835", properties:{imdbId:"0096859", name:"Natalia Borisova", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uzIZS1c1Y0pj7LIVcHGJiWjtzsX.jpg", url:"https://themoviedb.org/person/66835"}}, {tmdbId:"66836", properties:{imdbId:"0141255", born:date('1923-02-28'), name:"Jean Carson", died:date('2005-11-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xCWbrXaw1Xiyov182Rdq4uJ4POg.jpg", url:"https://themoviedb.org/person/66836"}}, {tmdbId:"12023", properties:{bornIn:"Dorchester, Dorset, England, UK", imdbId:"0263052", born:date('1901-06-03'), name:"Maurice Evans", bio:"From Wikipedia, the free encyclopedia\n\nMaurice Herbert Evans (June 3, 1901 – March 12, 1989) was an English-born British-American actor of Welsh descent, noted for his interpretations of Shakespearean characters.  His best-known screen roles are Dr.  Zaius in the 1968 film Planet of the Apes and as Samantha Stephens's father, Maurice in TV series Bewitched...", died:date('1989-03-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aeZ1h0y2j1yz1RMlYaBQGAvosoq.jpg", url:"https://themoviedb.org/person/12023"}}, {tmdbId:"19178", properties:{bornIn:"Buffalo, New York, USA", imdbId:"0790071", born:date('1923-12-01'), name:"Dick Shawn", bio:"One-of-a-kind nightclub comedian/singer Dick Shawn (ne Richard  Schulefand) was as off-the-wall as they came and, as such, proved to be  rather an acquired taste.  Way ahead of his time most say, it was  extremely difficult indeed to know how to properly tap into this man's  eclectic talents.  Shawn began inching toward the forefront during the  be-bop 50s and early 60s with his odd penchant for playing cool  cats...", died:date('1987-04-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5TgGjU61nbQn50X1fd3CUYiwAia.jpg", url:"https://themoviedb.org/person/19178"}}, {tmdbId:"9601", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0550318", born:date('1935-04-14'), name:"Kenneth Mars", bio:"From Wikipedia, the free encyclopedia. \n\nKenneth Mars (April 4, 1935 – February 12, 2011) was an American television, movie, and voice actor.  He may be best-remembered for his roles in several Mel Brooks films: the insane Nazi playwright Franz Liebkind in 1968's The Producers, and the relentless Police Inspector Hans Wilhelm Fredrich Kemp in 1974's Young Frankenstein. \n\nDescription above from the Wikipedia article Kenneth Mars, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2011-02-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dhvJ6DlH5n85Q1fN16rJsRJ0KiH.jpg", url:"https://themoviedb.org/person/9601"}}, {tmdbId:"65508", properties:{bornIn:"Evanston, Illinois, U.S.", imdbId:"0647921", born:date('1930-10-08'), name:"James Olson", bio:"​From Wikipedia, the free encyclopedia.   \n\nJames Olson (born October 8, 1930) is an American actor. \n\nDescription above from the Wikipedia article James Olson (actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/poeGcRZH9GXvNCfqQn66STpMqhz.jpg", url:"https://themoviedb.org/person/65508"}}, {tmdbId:"13934", properties:{bornIn:"Boise, Idaho", imdbId:"0364299", born:date('1902-12-08'), name:"Kate Harrington", bio:"From Wikipedia, the free encyclopedia\n\nKate Harrington was an American television and movie actress, born on the 8th of December 1902, in Boise, Idaho who died on the 23rd of November 1978 in New York City, New York from complications of a stroke. \n\nHarrington was the first actress to play Katherin 'Kate' Martin on All My Children briefly when it debuted in 1970.  Then Harrington moved on to the role of Marion Conway #2 on Guiding Light from 1971 to 1972...", died:date('1978-11-23'), url:"https://themoviedb.org/person/13934"}}, {tmdbId:"6461", properties:{bornIn:"Lynn, Massachusetts, USA", imdbId:"0663820", born:date('1927-11-20'), name:"Estelle Parsons", bio:"From Wikipedia, the free encyclopedia. \n\nEstelle Margaret Parsons (born November 20, 1927) is an American theatre, film and television actress and occasional theatrical director. \n\nAfter studying law, Parsons became a singer before deciding to pursue a career in acting.  She worked for the television program Today and made her stage debut in 1961.  During the 1960s, Parsons established her career on Broadway before progressing to film...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8ZuqJyuxyphfMNnVqpqHsir9WxQ.jpg", url:"https://themoviedb.org/person/6461"}}, {tmdbId:"30426", properties:{bornIn:"London, England, U.K.", imdbId:"0926013", born:date('1950-06-30'), name:"Leonard Whiting", bio:"​From Wikipedia, the free encyclopedia\n\nLeonard Whiting (born June 30, 1950) is a British actor who starred as Romeo in the 1968 Zeffirelli film version of Romeo and Juliet opposite Olivia Hussey's Juliet, a role which earned him the Golden Globe Award for New Star Of The Year - Actor.  He is also notorious for looking similar to Zac Efron. \n\nDescription above from the Wikipedia article Leonard Whiting, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6n15BZONeae3dodMPB7dgIVEXeC.jpg", url:"https://themoviedb.org/person/30426"}}, {tmdbId:"24695", properties:{bornIn:"Buenos Aires, Argentina", imdbId:"0001377", born:date('1951-04-17'), name:"Olivia Hussey", bio:"Olivia Hussey (born 17 April 1951) is an Argentine-British actress best known for her roles as Juliet in Romeo and Juliet, Jess Bradford in Black Christmas, Norma Bates in Psycho IV: The Beginning and Audra in Stephen King's It...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n5j2kzrktNoTzyn3TiHvrHgW0g3.jpg", url:"https://themoviedb.org/person/24695"}}, {tmdbId:"24498", properties:{bornIn:"Birmingham, England", imdbId:"0568491", born:date('1943-11-01'), name:"John McEnery", bio:"​From Wikipedia, the free encyclopedia\n\nJohn McEnery (born 1 November 1943; Birmingham, England) is a British actor and writer. \n\nAt age 20 he found his first stage work, spending three seasons with the Everyman Theatre in Liverpool.  He joined the British National Theatre Company in 1966.  He trained at the Bristol Old Vic Theatre School...", died:date('2019-04-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vzVsCjZlsejxLx65fsHczRfsBJe.jpg", url:"https://themoviedb.org/person/24498"}}, {tmdbId:"12021", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0001201", born:date('1945-02-09'), name:"Mia Farrow", bio:"From Wikipedia, the free encyclopedia. \n\nMia Farrow (born Maria de Lourdes Villiers Farrow; February 9, 1945) is an American actress, humanitarian, singer, and former fashion model.  Farrow has appeared in more than forty-five films and won numerous awards, including a Golden Globe award (and seven additional Golden Globe nominations), five BAFTA Film Award nominations, and a win for best actress at the San Sebastian International Film Festival...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vwxfB8Xv2EZoC0BbyOcy7MkUkpx.jpg", url:"https://themoviedb.org/person/12021"}}, {tmdbId:"4970", properties:{bornIn:"Quincy, Massachusetts, USA", imdbId:"0002106", born:date('1896-10-30'), name:"Ruth Gordon", bio:"Ruth Gordon Jones (October 30, 1896 – August 28, 1985) was an American actress,  screenwriter and playwright.  Gordon began her career performing on Broadway at age nineteen.  Known for her nasal voice and distinctive personality, she gained international recognition and critical acclaim for film roles that continued into her seventies and eighties...", died:date('1985-08-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pkdm26bbDy1iJPsjbseJogMl1mQ.jpg", url:"https://themoviedb.org/person/4970"}}, {tmdbId:"12022", properties:{bornIn:"Salisbury, North Carolina, USA", imdbId:"0085782", born:date('1895-07-13'), name:"Sidney Blackmer", bio:"From Wikipedia, the free encyclopedia. \n\nSidney Alderman Blackmer (13 July 1895 – 6 October 1973) was an American actor. \n\nBlackmer was born and raised in Salisbury, North Carolina.  He started off in an insurance and financial business but gave up on it.  While working as a builder's laborer on a new building, he saw a Pearl White serial being filmed and immediately decided to go into acting.  Blackmer went to New York hoping to act on the stage...", died:date('1973-10-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6LY3TS7KBQUuG6sWxBRcNLFVwwD.jpg", url:"https://themoviedb.org/person/12022"}}, {tmdbId:"77225", properties:{bornIn:"Poughkeepsie, New York", imdbId:"0722315", born:date('1947-03-23'), name:"Barbara Rhoades", bio:"From Wikipedia, the free encyclopedia. \n\nBarbara Rhoades (born March 23, 1947) is an American actress, known primarily for her comedy and mystery roles, especially as lady bandit Penelope \"Bad Penny\" Cushings in The Shakiest Gun in the West (1968).  She had a memorable role as Jodie Dallas's future wife, Maggie Chandler, in the TV series Soap. \n\nDescription above from the Wikipedia article Barbara Rhoades, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/g3QRscUs0Xrr85pmkX3JlVL229w.jpg", url:"https://themoviedb.org/person/77225"}}, {tmdbId:"103789", properties:{bornIn:"Houston, Texas, USA", imdbId:"0057983", born:date('1912-01-11'), name:"Don 'Red' Barry", bio:"Donald Barry went from the stage to the screen.  After four years of playing villains and henchmen at various studios, Barry got the role that changed his image: Red Ryder in the Republic Pictures serial Adventures of Red Ryder (1940).  Although he had appeared in westerns for two years or so, this was the one that kept him there.  He acquired the nickname \"Red\" from his association with the Red Ryder character.  After the success of \"Red Ryder\" Barry starred in a string of westerns for Republic...", died:date('1980-07-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iiLp1InLRncynCdRo5SOKOWRckb.jpg", url:"https://themoviedb.org/person/103789"}}, {tmdbId:"145693", properties:{bornIn:"Stockholm, Stockholms län, Sweden", imdbId:"0299827", born:date('1905-11-03'), name:"Sigge Fürst", bio:"Karl Sigurd Tore \"Sigge\" Fürst was a Swedish stage and screen actor, entertainer and presenter.  He graduated from the the Police Academy in 1927, and worked as a Police Constable for 3 years.  In the early 30's he was offered stage and film parts, sometimes as a policeman.  His film debut was in Victor Sjöström's \"Markurells i Wadköping\" (1931).  From 1946 he hosted \"The Breakfast Club\" a popular radio-show that was broadcasted till 1978...", died:date('1984-06-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tJhH6GsEkXV9oyo1O8ppb6jvH3v.jpg", url:"https://themoviedb.org/person/145693"}}, {tmdbId:"18340", properties:{bornIn:"Mogliano, Macerata", imdbId:"0320988", born:date('1918-05-18'), name:"Massimo Girotti", died:date('2003-01-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bz4jZxPSe00wKze4vF6aGpIcKn6.jpg", url:"https://themoviedb.org/person/18340"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"179215", properties:{bornIn:"New York City, New York, USA", born:date('1945-02-17'), name:"Zina Bethune", died:date('2012-02-12'), url:"https://themoviedb.org/person/179215"}}, {tmdbId:"1037", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0000172", born:date('1939-05-13'), name:"Harvey Keitel", bio:"An American actor.  Some of his more notable starring roles were in Martin Scorsese's Mean Streets and Taxi Driver, Ridley Scott's The Duellists and Thelma and Louise, Quentin Tarantino's Reservoir Dogs and Pulp Fiction, Jane Campion's The Piano, Abel Ferrara's Bad Lieutenant, James Mangold's Cop Land, Nicolas Roeg's Bad Timing, and Theo Angelopoulos's Ulysses' Gaze.  His latest work was as Detective Lieutenant Gene Hunt on the American adaptation of Life on Mars...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c1KlwOAlnFhBWfcPIvA6hmrElb6.jpg", url:"https://themoviedb.org/person/1037"}}, {tmdbId:"584567", properties:{bornIn:"Saint-Denis, La Réunion", imdbId:"0171801", born:date('1937-03-10'), name:"Anne Collette", bio:"Anne Colette, Anne Marie Collette, est une actrice française née le 10 mars 1937 à Saint-Denis de La Réunion...", url:"https://themoviedb.org/person/584567"}}, {tmdbId:"1183041", properties:{imdbId:"0475580", name:"Lennard Kuras", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4XXDP9ny1SBcYY65x2oRuolK1YL.jpg", url:"https://themoviedb.org/person/1183041"}}, {tmdbId:"1225463", properties:{imdbId:"0909455", born:date('1956-02-06'), name:"Jon Walmsley", url:"https://themoviedb.org/person/1225463"}}, {tmdbId:"27652", properties:{imdbId:"0029618", name:"Paul Angelis", url:"https://themoviedb.org/person/27652"}}, {tmdbId:"117548", properties:{imdbId:"0166979", born:date('1933-01-06'), name:"John Clive", died:date('2012-10-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/byi1kf7LWeo5BtTCRonQOTzKjsQ.jpg", url:"https://themoviedb.org/person/117548"}}, {tmdbId:"96179", properties:{imdbId:"0256289", born:date('1915-02-19'), name:"Dick Emery", died:date('1983-01-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hMaL7T9zmiWiCxdHqwRbwDw4p7R.jpg", url:"https://themoviedb.org/person/96179"}}, {tmdbId:"153582", properties:{imdbId:"0873899", born:date('1933-11-09'), name:"Louise Troy", bio:"From Wikipedia\n\nLouise Troy (November 9, 1933 — May 5, 1994) was an American actress of stage and screen.  She is best known for her performances in Tovarich (1963) and Walking Happy (1966), both of which she was nominated for a Tony Award.  Her signature stage role was that of the lead in High Spirits (1964). \n\nShe studied at the American Academy of Dramatic Arts and made her Broadway debut in the musical Pipe Dream...", died:date('1994-05-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yjL1ahrCYm5KMrhUVFv0yKTzoZz.jpg", url:"https://themoviedb.org/person/153582"}}, {tmdbId:"56890", properties:{bornIn:"Horsforth, Yorkshire, England, UK", imdbId:"0000532", born:date('1943-06-13'), name:"Malcolm McDowell", bio:"​From Wikipedia, the free encyclopedia. \n\nMalcolm McDowell (born 13 June 1943) is an English actor with a career spanning over forty years.  McDowell is principally known for his roles in the controversial films Caligula, If. . . . , O Lucky Man! and A Clockwork Orange...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hL8ep4Hqj6izX7IlzE7Bbcfq62w.jpg", url:"https://themoviedb.org/person/56890"}}, {tmdbId:"1234484", properties:{bornIn:"Sutton, Surrey, England, UK", imdbId:"0939642", born:date('1944-02-21'), name:"David Wood", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e4KJldlXqdgry6JJp6FAOXwXiHn.jpg", url:"https://themoviedb.org/person/1234484"}}, {tmdbId:"138563", properties:{bornIn:"Meopham, Kent, England, UK", imdbId:"0913264", born:date('1945-04-29'), name:"Richard Warwick", bio:"Richard Warwick (born Richard Carey Winter) was an English actor, on screen, stage and television. \n\nHe made his film debut in Franco Zeffirelli's 1968 adaptation of \"Romeo and Juliet\" and went on to star in such films as Lindsay Anderson's \"If. . . \"; \"Nicholas and Alexandra\" and \"Sebastiane\".  On television, he played prominent roles in the sitcom \"Please Sir!\" and \"A Fine Romance\", opposite Dame Judi Dench...", died:date('1997-12-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1Q1bKTFWIXkG5M1A5efYoaj9tHz.jpg", url:"https://themoviedb.org/person/138563"}}, {tmdbId:"1040441", properties:{bornIn:"London, England, UK", imdbId:"0634708", born:date('1945-03-08'), name:"Christine Noonan", died:date('2003-08-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7pVYFKKUvPN2KtRwrX1dkI71HxM.jpg", url:"https://themoviedb.org/person/1040441"}}, {tmdbId:"29282", properties:{bornIn:"Buenos Aires, Argentina", imdbId:"0482881", born:date('1915-01-09'), name:"Fernando Lamas", bio:"From Wikipedia, the free encyclopedia. \n\nFernando Álvaro Lamas (January 9, 1915 – October 8, 1982) was an Argentine-born actor and director, and the father of actor Lorenzo Lamas. \n\nDescription above from the Wikipedia article Fernando Lamas, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1982-10-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lR441lsj73tOXQKNaVYMhgI82ej.jpg", url:"https://themoviedb.org/person/29282"}}, {tmdbId:"44547", properties:{bornIn:" Coney Island, New York, U.S.", imdbId:"0349241", born:date('1947-07-10'), name:"Arlo Guthrie", bio:"​From Wikipedia, the free encyclopedia.   \n\nArlo Davy Guthrie (born July 10, 1947) is an American folk singer.  Like his father, Woody Guthrie, Arlo often sings songs of protest against social injustice.  One of Guthrie's better-known works is \"Alice's Restaurant Massacree\", a satirical talking blues song of about 18 minutes in length. \n\nDescription above from the Wikipedia article  Arlo Davy Guthrie, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/879meIcbs3zVjfVRrM866Hm0h3p.jpg", url:"https://themoviedb.org/person/44547"}}, {tmdbId:"14542", properties:{bornIn:"Charlestown, New Hampshire", imdbId:"0110814", born:date('1927-03-07'), name:"James Broderick", bio:"​From Wikipedia, the free encyclopedia.   \n\nJames Joseph Broderick III (March 7, 1927 – November 1, 1982) was an American actor. \n\nDescription above from the Wikipedia article  James Joseph Broderick , licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1982-11-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6beK2bqPlOBLqszQkGOTslcuhkh.jpg", url:"https://themoviedb.org/person/14542"}}, {tmdbId:"44549", properties:{imdbId:"0781517", born:date('1919-05-03'), name:"Pete Seeger", died:date('2014-01-27'), url:"https://themoviedb.org/person/44549"}}, {tmdbId:"15397", properties:{bornIn:"Parma, Emilia-Romagna, Italy", imdbId:"0893341", born:date('1919-07-14'), name:"Lino Ventura", bio:"From Wikipedia, the free encyclopedia. \n\nLino Ventura (14 July 1919 – 22 October 1987), was an Italian actor who starred in French movies. \n\nDescription above from the Wikipedia article Lino Ventura, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1987-10-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j8D4ox5jSavrB7G8KrlxEIxivEq.jpg", url:"https://themoviedb.org/person/15397"}}, {tmdbId:"19162", properties:{bornIn:"Paris, France", imdbId:"0144045", born:date('1932-10-27'), name:"Jean-Pierre Cassel", bio:"From Wikipedia, the free encyclopedia. \n\nJean-Pierre Cassel (October 27, 1932 – April 19, 2007) was a French actor. \n\nDescription above from the Wikipedia article Jean-Pierre Cassel, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2007-04-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iCZ9CFw55lwdERGuIEFrkpOdaBi.jpg", url:"https://themoviedb.org/person/19162"}}, {tmdbId:"73022", properties:{bornIn:"Oakland, California, USA", imdbId:"0191685", born:date('1930-08-16'), name:"Robert Culp", bio:"From Wikipedia, the free encyclopedia\n\nRobert Martin Culp (August 16, 1930 – March 24, 2010) was an American actor, scriptwriter, voice actor and director, widely known for his work in television.  Culp earned an international reputation for his role as Kelly Robinson on I Spy (1965–1968), the espionage series in which he and co-star Bill Cosby played a pair of secret agents.  He also had a recurring role as Warren Whelan on Everybody Loves Raymond...", died:date('2010-03-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oKSP6KgD6GuCnI5bYrproZQMXGy.jpg", url:"https://themoviedb.org/person/73022"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"827", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0001285", born:date('1938-08-29'), name:"Elliott Gould", bio:"Elliott Gould (born Elliot Goldstein; August 29, 1938) is an American actor.  He began acting in Hollywood films during the 1960s, and has remained prolific ever since.  Some of his most notable films include M*A*S*H and Bob & Carol & Ted & Alice, for which he received an Oscar nomination.  In recent years, he has starred as Reuben Tishkoff in Ocean's Eleven, Ocean's Twelve, and Ocean's Thirteen...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ismZMvs8QxRR33OAVp9AKr3TokP.jpg", url:"https://themoviedb.org/person/827"}}, {tmdbId:"40403", properties:{bornIn:"Tacoma, Washington, USA", imdbId:"0001007", born:date('1937-01-04'), name:"Dyan Cannon", bio:"From Wikipedia, the free encyclopedia. \n\nDyan Cannon (born Samille Diane Friesen on January 4, 1937) is an American film and television actress, director, screenwriter, editor, and producer. \n\nDescription above from the Wikipedia article Dyan Cannon, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5EvkhcZylZuSziQOWkntBhXiW3z.jpg", url:"https://themoviedb.org/person/40403"}}, {tmdbId:"8260", properties:{bornIn:"Kokomo, Indiana, USA", imdbId:"0001510", born:date('1919-03-26'), name:"Strother Martin", bio:"From Wikipedia, the free encyclopedia. \n\nStrother Martin (March 26, 1919 – August 1, 1980) was an American actor in numerous films and television programs.  Martin is perhaps best known as the prison \"captain\" in the 1967 film Cool Hand Luke, where he uttered the line, \"What we've got here is. . . failure to communicate...", died:date('1980-08-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mHJudNvMY5eoFpDZmr3Xa2rqU93.jpg", url:"https://themoviedb.org/person/8260"}}, {tmdbId:"18892", properties:{bornIn:"Washington, District of Columbia, USA", imdbId:"0000443", born:date('1945-11-21'), name:"Goldie Hawn", bio:"Goldie Jeanne Hawn (born November 21, 1945) is an American actress, film director, producer, and occasional singer.  Goldie Hawn has been a Hollywood comedy star since her big hit in 1980, Private Benjamin.  She started as a dancer, first in New York and then in Los Angeles.  On the cast of TV's Laugh-In, the mod comedy show of the late 1960s, she flubbed jokes in a bikini and became one of the show's most popular co-stars...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/u2g5VUylAJoXGWhoxFTLUmaX6O7.jpg", url:"https://themoviedb.org/person/18892"}}, {tmdbId:"936091", properties:{bornIn:"São Paulo, São Paulo, Brazil", imdbId:"0487947", born:date('1929-04-17'), name:"Odete Lara", died:date('2015-02-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pEXOeu5WnMEmD4wjMUcTxhNbTT.jpg", url:"https://themoviedb.org/person/936091"}}, {tmdbId:"112112", properties:{bornIn:"Rio de Janeiro, Rio de Janeiro, Brazil", imdbId:"0142517", born:date('1937-06-04'), name:"Hugo Carvana", bio:"Hugo Carvana (4 June 1937 – 4 October 2014) was a Brazilian actor and filmmaker.  Initially associated with scoundrel-type characters during his early career, he played parts in many Brazilian New Wave (Cinema Novo) films. \n\nHe later moved on to starring and directing comedies, such as his directorial debut, the self-starred \"Vai Trabalhar Vagabundo!\" (1973) and his last film \"A Casa da Mãe Joana 2\" (2013).  During his later career, he was also a recurring actor in Brazilian soap operas...", died:date('2014-10-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/89GkB5yguRKh6uOujJ9DDvvvZVv.jpg", url:"https://themoviedb.org/person/112112"}}, {tmdbId:"8960", properties:{imdbId:"0579234", name:"Antonio Mendoza", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2TK6WOByez8sfmiyOUWJMXQtqNg.jpg", url:"https://themoviedb.org/person/8960"}}, {tmdbId:"8961", properties:{bornIn:"The Bronx, New York City, New York, USA", imdbId:"0817489", born:date('1939-12-26'), name:"Phil Spector", bio:"From Wikipedia, the free encyclopedia\n\nHarvey Philip Spector (born December 26, 1939) is an American record producer and songwriter.  The originator of the \"Wall of Sound\" production technique, Spector was a pioneer of the 1960s girl group sound and produced over 25 Top 40 hits between 1960 and 1965 alone.  After this initial success, Spector later worked with artists including Ike and Tina Turner, John Lennon, George Harrison, and the Ramones with similar acclaim...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xGSTTiFztDKxKxbVVKoMvKZ2TBy.jpg", url:"https://themoviedb.org/person/8961"}}, {tmdbId:"18206", properties:{imdbId:"0137105", name:"Jean-Pierre Cargol", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l5Zsy4QSHyEmlDW0fTWDKugO9Tk.jpg", url:"https://themoviedb.org/person/18206"}}, {tmdbId:"18207", properties:{imdbId:"0782563", born:date('1928-04-07'), name:"Françoise Seigner", died:date('2008-10-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gv9d4HK3cKYXrPm29yqCy88YH0t.jpg", url:"https://themoviedb.org/person/18207"}}, {tmdbId:"46597", properties:{bornIn:"Pound Ridge, New York", imdbId:"0532298", born:date('1939-04-01'), name:"Ali MacGraw", bio:"Elizabeth Alice \"Ali\" MacGraw (born April 1, 1939)  is an American actress.  She is best known for her role in Love Story, for which she won a Golden Globe and received an Academy Award nomination. \n\nDescription above from the Wikipedia article Ali MacGraw, licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vp8tITsN4tthn2EKxzJKlx7RwEd.jpg", url:"https://themoviedb.org/person/46597"}}, {tmdbId:"87039", properties:{bornIn:"Decatur, Illinois, USA", imdbId:"0552832", born:date('1927-07-15'), name:"Nan Martin", bio:"From Wikipedia, the free encyclopedia\n\nNan Martin (July 15, 1927 – March 4, 2010) was an American actress who starred in movies and on television. \n\nBorn in Decatur, Illinois and raised in Santa Monica, California, her first film role was The Man in the Gray Flannel Suit (1956)...", died:date('2010-03-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tL473ekZJS8FW7F6D03PLx3MVpr.jpg", url:"https://themoviedb.org/person/87039"}}, {tmdbId:"45290", properties:{bornIn:"Cleveland, Ohio, USA", imdbId:"0564059", born:date('1942-11-11'), name:"Marianne McAndrew", bio:"​From Wikipedia, the free encyclopedia...", url:"https://themoviedb.org/person/45290"}}, {tmdbId:"12718", properties:{bornIn:"Teddington, Middlesex, England, UK", imdbId:"0002021", born:date('1899-12-16'), name:"Noël Coward", bio:"From Wikipedia, the free encyclopedia\n\nSir Noël Peirce Coward (16 December 1899 – 26 March 1973) was an English playwright, composer, director, actor and singer, known for his wit, flamboyance, and what Time magazine called \"a sense of personal style, a combination of cheek and chic, pose and poise\". \n\nBorn in Teddington, a suburb of London, Coward attended a dance academy in London as a child, making his professional stage début at the age of eleven...", died:date('1973-03-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/20dd32wR8putmUni8BK7ABx5ThM.jpg", url:"https://themoviedb.org/person/12718"}}, {tmdbId:"55879", properties:{bornIn:"Southampton, Hampshire, England, UK ", imdbId:"0001350", born:date('1924-01-21'), name:"Benny Hill", bio:"From Wikipedia, the free encyclopedia.  Benny Hill (21 January 1924 – 20 April 1992) was an English comedian and actor, notable for his long-running television programme The Benny Hill Show.  Description above from the Wikipedia article Benny Hill, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1992-04-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fLS2HnwCPdbRZiW86IlKWW2i44m.jpg", url:"https://themoviedb.org/person/55879"}}, {tmdbId:"3268", properties:{bornIn:"Tropea, Calabria, Italy", imdbId:"0885203", born:date('1916-02-17'), name:"Raf Vallone", bio:"​From Wikipedia, the free encyclopedia\n\nRaffaele \"Raf\" Vallone (17 February 1916 – 31 October 2002) was an Italian actor and an international film star. \n\nBorn in Tropea, Calabria, the son of a lawyer, Vallone attended Liceo classico Cavour in Turin, and studied Law and Philosophy at the University of Turin and entered his father's law firm.  He played professional Football at a young age, playing in Serie A for Torino.  He won an Italian Cup with his team in season 1935-1936...", died:date('2002-10-31'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7k7oiWobUCZ1TK1yLmz6jWhBuHk.jpg", url:"https://themoviedb.org/person/3268"}}, {tmdbId:"10620", properties:{bornIn:"Zielenzig, Brandenburg, Germany [now Sulecin, Lubuskie, Poland]", imdbId:"0518579", born:date('1944-12-21'), name:"Ulli Lommel", bio:"Ulli Lommel (December 21, 1944 – December 2, 2017), was a German actor and director, noted for his many horror films, and for his career as an actor on Rainer Werner Fassbinder's films. \n\nDescription above from the Wikipedia article Ulli Lommel, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2017-12-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pXGdTFJFUYUKK7WBGBf4YNBotuv.jpg", url:"https://themoviedb.org/person/10620"}}, {tmdbId:"3734", properties:{bornIn:"Chorzów, Polska", imdbId:"0778016", born:date('1943-12-25'), name:"Hanna Schygulla", bio:" \n\nHanna Schygulla (born 25 December 1943) is a German actress and chanson singer.  She is generally considered the most prominent German actress of the New German Cinema. \n\nSchygulla was born in Königshütte, Upper Silesia, to German parents Antonie (née Mzyk) and Joseph Schygulla.  Her father, a timber merchant by profession, was then drafted as an infantryman in the German Army and was captured by American forces in Italy, subsequently being held as a prisoner of war until 1948...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xi6QwN1CjTHfNOhcnsENMhAatxu.jpg", url:"https://themoviedb.org/person/3734"}}, {tmdbId:"26330", properties:{bornIn:"Hamburg - Germany", imdbId:"0769440", born:date('1931-11-13'), name:"Katrin Schaake", bio:"Schaake begann ihre Karriere 1959 mit einer Rolle in Aus dem Tagebuch eines Frauenarztes mit Rudolf Prack in der Hauptrolle.  Zwei Jahre später drehte sie mit Götz George und Johanna von Koczian Unser Haus in Kamerun.  Nach einigen Fernsehauftritten hatte sie eine Nebenrolle im Oscar-prämierten Spielfilm Was gibt’s Neues, Pussy? mit Peter Sellers, Romy Schneider und Woody Allen...", url:"https://themoviedb.org/person/26330"}}, {tmdbId:"72435", properties:{imdbId:"0812101", name:"Liz Söllner", url:"https://themoviedb.org/person/72435"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"14732", properties:{bornIn:"Bronx, New York, USA", imdbId:"0339834", born:date('1911-12-23'), name:"James Gregory", bio:"One of the most beloved actors of all, James Gregory was born December  23, 1911, in the Bronx and grew up in New Rochelle, N. Y.  In high school,  he was elected president of the Drama Club.  He went to work on Wall  Street as a runner shortly after the 1929 crash.  James Gregory performed  in drama groups and achieved pro status as a summer stock player in  1935.  He performed in plays throughout New York, New Jersey and  Maryland...", died:date('2002-09-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sefUDHUyEA9odf5Jzz4jqeCfr7R.jpg", url:"https://themoviedb.org/person/14732"}}, {tmdbId:"9765", properties:{bornIn:"Alger, Algeria", imdbId:"0264554", born:date('1933-05-10'), name:"Françoise Fabian", bio:"Michèle Cortes de Leone y Fabianera, better known as her stage name Françoise Fabian (born 10 May 1933), is a French film actress.  She has appeared in more than 80 films since 1956.  In 1971, Fabian signed the Manifesto of the 343, publicly declaring having had an abortion. \n\nSource: Article \"Françoise Fabian\" from Wikipedia in english, licensed under CC-BY-SA 3. 0...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jfyNu84D9RK7HHvxOWzch5p0pUo.jpg", url:"https://themoviedb.org/person/9765"}}, {tmdbId:"24393", properties:{bornIn:" Paris, France", imdbId:"0056763", born:date('1944-03-21'), name:"Marie-Christine Barrault", bio:"​From Wikipedia, the free encyclopedia.     Marie-Christine Barrault, née à Paris le 21 mars 1944, est une actrice française.  En 1975, elle fut sélectionnée pour l'Oscar de la meilleure actrice pour son rôle dans Cousin, Cousine.   Elle est la nièce de Madeleine Renaud et Jean-Louis Barrault qui n'ont pas encouragé sa carrière.  Elle fut mariée deux fois, à Daniel Toscan du Plantier avec qui elle a eu un garçon et une fille, et à Roger Vadim de 1990 jusqu'à la mort de ce dernier en 2000...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eYCZ2LRItdgix6wdXaLSMMzzagF.jpg", url:"https://themoviedb.org/person/24393"}}, {tmdbId:"39440", properties:{bornIn:" Paris, France", imdbId:"0900004", born:date('1930-12-20'), name:"Antoine Vitez", bio:"​From Wikipedia, the free encyclopedia.   \n\nAntoine Vitez (December 20, 1930–April 30, 1990) was a French actor, director, and poet. \n\nHe was born in Paris, France and became an actor at the age of 19.  He was director of the Théâtre national de Chaillot for seven years before being named to head the Comedie Francaise, a French theater company. \n\nDescription above from the Wikipedia article Antoine Vitez, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1990-04-30'), url:"https://themoviedb.org/person/39440"}}, {tmdbId:"10169", properties:{bornIn:"Garden City, Long Island, New York, USA", imdbId:"0001699", born:date('1922-01-21'), name:"Telly Savalas", bio:"​From Wikipedia, the free encyclopedia.   \n\nAristotelis \"Telly\" Savalas (Greek: Αριστοτέλης \"Τέλι\" Σαββάλας; January 21, 1922 – January 22, 1994) was an American film and television actor and singer, whose career spanned four decades. \n\nBest known for playing the title role in the 1970s crime drama Kojak, Savalas was nominated for an Academy Award for Best Supporting Actor for his performance in Birdman of Alcatraz (1962)...", died:date('1994-01-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rWJ07MlK7rCjCVMogHoHFrlGj9t.jpg", url:"https://themoviedb.org/person/10169"}}, {tmdbId:"70424", properties:{bornIn:"Stockholm, Sweden", imdbId:"0817122", born:date('1943-06-03'), name:"Camilla Sparv", bio:"From Wikipedia, the free encyclopedia. \n\nCamilla Sparv (born 3 June 1943, Stockholm, Sweden) is a Swedish actress.  She was briefly married to American film producer Robert Evans in 1965. \n\nShe was awarded a Golden Globe as Most Promising Newcomer (female) in 1967 for her role opposite James Coburn in Dead Heat on a Merry-Go-Round (1966)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1gP5E6QguFv59BBSOp5kLoi0t1Z.jpg", url:"https://themoviedb.org/person/70424"}}, {tmdbId:"5694", properties:{bornIn:"Rochester, New York, USA", imdbId:"0001233", born:date('1941-07-13'), name:"Robert Forster", bio:"Robert Forster was an American actor, best known for his roles as John Cassellis in Haskell Wexler's Medium Cool, and as Max Cherry in Quentin Tarantino's Jackie Brown, the latter of which gaining him an Academy Award nomination for Best Supporting Actor. \n\nDescription above from the Wikipedia article Robert Forster, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2019-10-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vGDifxN2PnO69rnpg6FoWkocFCD.jpg", url:"https://themoviedb.org/person/5694"}}, {tmdbId:"55192", properties:{bornIn:"Lynn, Massachusetts, USA", imdbId:"0089244", born:date('1938-08-07'), name:"Verna Bloom", bio:"From Wikipedia, the free encyclopedia\n\nVerna Bloom (August 7, 1938 - January 9, 2019) was an American actress.  She co-starred in the 1973 film High Plains Drifter with Clint Eastwood and the 1974 made for TV movie Where Have All The People Gone? with Peter Graves and Kathleen Quinlan.  She has had roles in more than 30 films and television episodes since the 1960s, including playing Mary, mother of Jesus, in The Last Temptation of Christ in 1988 and Marion Wormer in Animal House in 1978...", died:date('2019-01-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lqqooPaNnhlFrAYuoRyEnSmzZf7.jpg", url:"https://themoviedb.org/person/55192"}}, {tmdbId:"15659", properties:{bornIn:"Santa Barbara de Nexe, Portugal", imdbId:"0384494", born:date('1941-02-09'), name:"Marianna Hill", bio:"Marianna Hill, born Marianna Schwarzkopf, is an American stage and screen actress mostly working in American television.  Her initial acting experience came when she was an apprentice at the Laguna Playhouse and later as an actress at the La Jolla Playhouse.  She is a life member of The Actors Studio. \n\nShe has appeared in more than 70 feature films and television episodes...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2Exz1SqtPkbM0EkkAKOk6I5OTg6.jpg", url:"https://themoviedb.org/person/15659"}}, {tmdbId:"10127", properties:{bornIn:"Yonkers, New York, USA", imdbId:"0000685", born:date('1938-12-29'), name:"Jon Voight", bio:"Jonathan Vincent \"Jon\" Voight is an American actor.  He has received an Academy Award, out of four nominations, and three Golden Globe Awards, out of nine nominations. \n\nVoight came to prominence in the late 1960s with his performance as a would-be gigolo in Midnight Cowboy (1969)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h5jKQHLRQqqgvsfCXgxxtywx7UQ.jpg", url:"https://themoviedb.org/person/10127"}}, {tmdbId:"19335", properties:{bornIn:"New York City, New York, USA", imdbId:"0587249", born:date('1932-09-09'), name:"Sylvia Miles", bio:"Sylvia Miles (September 9, 1924 – June 12, 2019) was an American actress.  She was twice nominated for the Academy Award for Best Supporting Actress for her performances in Midnight Cowboy (1969) and Farewell, My Lovely (1975). \n\nDescription above from the Wikipedia article Sylvia Miles, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2019-06-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5WTFPcOpV3cAqSffkylMn0A3mtM.jpg", url:"https://themoviedb.org/person/19335"}}, {tmdbId:"1120049", properties:{imdbId:"0571609", born:date('1939-01-10'), name:"Scott McKenzie", bio:"Scott McKenzie was an American singer and songwriter...", died:date('2012-08-18'), url:"https://themoviedb.org/person/1120049"}}, {tmdbId:"35344", properties:{imdbId:"0230559", born:date('1940-11-29'), name:"Denny Doherty", died:date('2007-01-19'), url:"https://themoviedb.org/person/35344"}}, {tmdbId:"1238882", properties:{bornIn:"Baltimore, Maryland, USA", imdbId:"0254177", born:date('1941-09-19'), name:"Cass Elliot", bio:"Cass Elliot (born Ellen Naomi Cohen; September 19, 1941 - July 29, 1974), also known as Mama Cass, was an American singer, member of The Mamas & the Papas and actress.  After the group broke up, she released five solo albums.  In 1998, Elliot, John Phillips, Denny Doherty, and Michelle Phillips were inducted into the Rock and Roll Hall of Fame for their work as The Mamas & the Papas...", died:date('1974-07-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pb31tRqi6dzRYgqg43drlELD2y3.jpg", url:"https://themoviedb.org/person/1238882"}}, {tmdbId:"14898", properties:{imdbId:"0680512", name:"John Phillips", url:"https://themoviedb.org/person/14898"}}, {tmdbId:"1216598", properties:{imdbId:"0248334", born:date('1955-06-09'), name:"Ted Eccles", url:"https://themoviedb.org/person/1216598"}}, {tmdbId:"1232929", properties:{imdbId:"0927810", name:"Tudi Wiggins", url:"https://themoviedb.org/person/1232929"}}, {tmdbId:"1244470", properties:{bornIn:"Thetford Mines, Québec, Canada", imdbId:"0405695", born:date('1924-05-28'), name:"Paul Hébert", bio:"Paul Hébert, OC, CQ (born May 28, 1924 in Thetford Mines, Quebec, Canada) is a French Canadian actor.  He was awarded the Officer of the Order of Canada on June 29, 1987 for his services to French Canadian entertainment and was made a Knight of the National Order of Quebec in 1994.  He has appeared on numerous Quebec television series including 14, rue de Galais as the Delisle family patriarch...", died:date('2017-04-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/95b03IFOpas0LvxtOTFdTGfzfcY.jpg", url:"https://themoviedb.org/person/1244470"}}, {tmdbId:"10167", properties:{bornIn:" Goulburn, New South Wales, Australia", imdbId:"0493872", born:date('1939-09-05'), name:"George Lazenby", bio:"George Lazenby was born on September 5th, 1939, in Australia.  He moved to London, England in 1964, after serving in the Australian Army.  Before becoming an actor, he worked as an auto mechanic, used car salesman, prestige car salesman, and as a male model, in London, England.  In 1968, Lazenby was cast as \"James Bond\", despite his only previous acting experience being in commercials, and his only film appearance being a bit-part in a 1965 Italian-made Bond spoof...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7ahmXdQHHxSjNz1NJvCsIU2W7ve.jpg", url:"https://themoviedb.org/person/10167"}}, {tmdbId:"10168", properties:{bornIn:"Doncaster, Yorkshire, England, UK", imdbId:"0001671", born:date('1938-07-20'), name:"Diana Rigg", bio:"Dame Enid Diana Elizabeth Rigg, DBE (born 20 July 1938) is an English actress.  She played Emma Peel in the TV series The Avengers (1965–68) and Olenna Tyrell in Game of Thrones (2013–17).  She has also had a career in theatre, including playing the title role in Medea, both in London and New York, for which she won the 1994 Tony Award for Best Actress in a Play.  She was made a CBE in 1988 and a Dame in 1994 for services to drama...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tFZei9BMHqau7XN2PeQ0M24RT7G.jpg", url:"https://themoviedb.org/person/10168"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"35686", properties:{bornIn:"Los Angeles, California, U.S.", imdbId:"0665822", born:date('1953-08-02'), name:"Butch Patrick", bio:"​From Wikipedia, the free encyclopedia.   \n\nButch Patrick (born Patrick Alan Caples on August 2, 1953 in Los Angeles, California) is a former American child actor.  He is widely known for his role on the TV show The Munsters (1964–1966) where he played Eddie Munster, the son of Herman (Fred Gwynne) and Lily Munster (Yvonne De Carlo).  He also appeared as Eddie in the 1966 movie Munster, Go Home...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wm2urgDBp4mWUocnME07zp9PIBe.jpg", url:"https://themoviedb.org/person/35686"}}, {tmdbId:"109969", properties:{bornIn:"Toledo, Ohio, USA", imdbId:"0124889", born:date('1916-11-16'), name:"Daws Butler", bio:"Charles Dawson \"Daws\" Butler was a voice actor originally from Toledo, Ohio.  He worked mostly for Hanna-Barbera and originated the voices of many famous animated cartoon characters, including Yogi Bear, Quick Draw McGraw, Snagglepuss, and Huckleberry Hound...", died:date('1988-05-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qxaOMbICdts0qpUmkYj3OMhDGt8.jpg", url:"https://themoviedb.org/person/109969"}}, {tmdbId:"61676", properties:{imdbId:"0133752", born:date('1913-12-25'), name:"Candy Candido", died:date('1999-05-19'), url:"https://themoviedb.org/person/61676"}}, {tmdbId:"10978", properties:{bornIn:"Ilford Borough, Essex, United Kingdom", imdbId:"0001749", born:date('1934-12-27'), name:"Maggie Smith", bio:"Dame Margaret Natalie \"Maggie\" Smith CH DBE (born 28 December 1934) is an English actress.  She has had an extensive career on stage, film, and television which began in the mid-1950s.  Smith has appeared in more than 60 films and over 70 plays, and is one of Britain's most recognisable actresses.  She was made a Dame by Queen Elizabeth II in 1990 for contributions to the performing arts, and a Companion of Honour in 2014 for services to drama...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8e9l82x4oZvhq2FqyDcDWd51N8v.jpg", url:"https://themoviedb.org/person/10978"}}, {tmdbId:"25635", properties:{bornIn:"Yokohama, Japan", imdbId:"0291512", born:date('1950-02-03'), name:"Pamela Franklin", bio:"From Wikipedia, the free encyclopedia.   Pamela Franklin (born 3 February 1950) is a British actress who appeared in films from 1961 until 1976. \n\nFranklin was born in Yokohama, Japan, and grew up in the Far East, where her father was a trader.  She was sent to the Elmhurst School of Ballet in England.  She made her film debut at the age of 11 in The Innocents (1961), and her television debut in the Wonderful World of Disney's, The Horse Without a Head...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hBDgqlE6FJ2stGoomFhlHGj0lWz.jpg", url:"https://themoviedb.org/person/25635"}}, {tmdbId:"41998", properties:{bornIn:"Glasgow, Scotland", imdbId:"0413561", born:date('1923-12-19'), name:"Gordon Jackson", bio:"From Wikipedia, the free encyclopedia. \n\nGordon Cameron Jackson, OBE (19 December 1923 – 15 January 1990) was a Scottish Emmy Award-winning actor best remembered for his roles as the butler Angus Hudson in Upstairs, Downstairs and George Cowley, the head of CI5, in The Professionals. \n\nDescription above from the Wikipedia article Gordon Jackson (actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1990-01-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q7EKIZ8rsZiFI0ufrIBHvmuJVjw.jpg", url:"https://themoviedb.org/person/41998"}}, {tmdbId:"82549", properties:{bornIn:"Bristol, England, UK", imdbId:"0420312", born:date('1929-04-18'), name:"Peter Jeffrey", died:date('1999-12-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/33uH83kpts6dOZybETH3n2oFLHk.jpg", url:"https://themoviedb.org/person/82549"}}, {tmdbId:"229362", properties:{bornIn:"Kilbirnie, North Ayrshire, Scotland, UK", imdbId:"0164050", name:"Jameson Clark", died:date('1984-01-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z8DNTzMabf9XXvWQn3lbtfFQJId.jpg", url:"https://themoviedb.org/person/229362"}}, {tmdbId:"178617", properties:{imdbId:"4078109", name:"Paul Brennan", url:"https://themoviedb.org/person/178617"}}, {tmdbId:"1972025", properties:{name:"Charles McDevitt", url:"https://themoviedb.org/person/1972025"}}, {tmdbId:"1457930", properties:{imdbId:"0048543", name:"James Baker", url:"https://themoviedb.org/person/1457930"}}, {tmdbId:"1972027", properties:{name:"Raymond Martos", url:"https://themoviedb.org/person/1972027"}}, {tmdbId:"26690", properties:{bornIn:"Nottingham, Nottinghamshire, England, UK", imdbId:"0693318", born:date('1944-10-04'), name:"Martin Potter", bio:"​From Wikipedia, the free encyclopedia.   \n\nMartin Potter (born 4 October 1944) is a British actor.  After the National Youth Theatre and repertory theatre in Guildford and Hampstead, Potter received his first role in British television at the age of 24 in the television drama The Bonegrinder (1968) written by Dennis Potter.  In the same year he had another small part alongside Brian Cox in the futuristic drama The Year of the Sex Olympics...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eaj0pZBkKkNAAoYHiqouVojXyqt.jpg", url:"https://themoviedb.org/person/26690"}}, {tmdbId:"18241", properties:{bornIn:"Moody Field, Georgia, USA", imdbId:"0445657", born:date('1944-05-03'), name:"Hiram Keller", bio:"From Wikipedia, the free encyclopedia. \n\nHiram Keller (May 3, 1944 – January 20, 1997), was an American actor who starred in European films.  He is best known for his role as Ascyltus in Federico Fellini's Satyricon (1969)...", died:date('1997-01-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gvQUxuulzYCQWLztH5FrpWpvJ76.jpg", url:"https://themoviedb.org/person/18241"}}, {tmdbId:"68405", properties:{imdbId:"0097034", born:date('1951-05-12'), name:"Max Born", url:"https://themoviedb.org/person/68405"}}, {tmdbId:"68406", properties:{bornIn:"Siracusa, Italy", imdbId:"0709951", born:date('1906-09-25'), name:"Salvo Randone", bio:"​From Wikipedia, the free encyclopedia.   \n\nSalvo Randone (25 September 1906 – 6 March 1991) was an Italian film actor.  He appeared in 45 films between 1943 and 1977. \n\nDescription above from the Wikipedia article Salvo Randone, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1991-03-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jjCd9gFzvpZOrbQLgsnnRhDT6fh.jpg", url:"https://themoviedb.org/person/68406"}}, {tmdbId:"66776", properties:{bornIn:"Hollywood, California, USA", imdbId:"0591485", born:date('1946-03-12'), name:"Liza Minnelli", bio:"From Wikipedia, the free encyclopedia. \n\nLiza May Minnelli (born March 12, 1946) is an American actress and singer.  She is the daughter of singer and actress Judy Garland and film director Vincente Minnelli. \n\nShe starred in Liza's Back, in 2002.  She had guest appearances in the sitcom Arrested Development and had a small role in the movie The OH in Ohio, while continuing to tour internationally.  In 2008/09 she performed the Broadway show Liza's at The Palace. . ...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fG7Xa97RT2p8AT4CYHMfMQuxXg6.jpg", url:"https://themoviedb.org/person/66776"}}, {tmdbId:"150780", properties:{bornIn:"San Antonio, Texas, USA", imdbId:"0123765", born:date('1947-07-21'), name:"Wendell Burton", died:date('2017-05-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/g0a8GJShXCj5qHH3rGXGaZs2CM7.jpg", url:"https://themoviedb.org/person/150780"}}, {tmdbId:"39998", properties:{bornIn:"Los Angeles County, California, USA", imdbId:"0570625", born:date('1944-07-19'), name:"Tim McIntire", died:date('1986-04-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/by3ZgApPcmHVuNur19K5Vw8Z33a.jpg", url:"https://themoviedb.org/person/39998"}}, {tmdbId:"13728", properties:{bornIn:"Warsaw, Indiana, USA", imdbId:"0533979", born:date('1929-11-18'), name:"John McMartin", bio:"From Wikipedia, the free encyclopedia\n\nJohn McMartin is an American actor of stage, film and television. \n\nDescription above from the Wikipedia article John McMartin, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d1leXuDt0hm6IUDfW6bhtdKV1WN.jpg", url:"https://themoviedb.org/person/13728"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"50835", properties:{bornIn:"Cologne, North-Rhine-Westphalia, Germany", imdbId:"0384787", born:date('1908-04-23'), name:"Marcel Hillaire", died:date('1988-01-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uwucIItRARcNhyclZsvfMHVt4jG.jpg", url:"https://themoviedb.org/person/50835"}}, {tmdbId:"69570", properties:{imdbId:"0404985", born:date('1931-03-19'), name:"Jacquelyn Hyde", died:date('1992-02-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dbc2a2hFeCVDJeAi0Gc1bNgmHfV.jpg", url:"https://themoviedb.org/person/69570"}}, {tmdbId:"30428", properties:{bornIn:"Quebec City Quebec, Canada", imdbId:"0765546", born:date('1940-05-22'), name:"Michael Sarrazin", bio:"From Wikipedia, the free encyclopedia. \n\nMichael Sarrazin (May 22, 1940 – April 17, 2011) was a Canadian film and television actor who found fame opposite Jane Fonda in the drama film They Shoot Horses, Don't They? (1969). \n\nDescription above from the Wikipedia article Michael Sarrazin, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2011-04-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7R6duWnd07DE39B3WApfwM1SUQp.jpg", url:"https://themoviedb.org/person/30428"}}, {tmdbId:"13326", properties:{bornIn:"Chelsea, London, England, UK", imdbId:"0948772", born:date('1939-01-09'), name:"Susannah York", bio:"Susannah York (9 January 1939 – 15 January 2011) was a British film, stage and television actress.  She was awarded a BAFTA as Best Supporting Actress for They Shoot Horses, Don't They? (1969) and was nominated for an Oscar and Golden Globe for the same film.  She won best actress for Images at the 1972 Cannes Film Festival.  In 1991 she was appointed an Officier de l'Ordre des Arts et des Lettres...", died:date('2011-01-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w3gt7qr4npe9NMQJnvzQoK3t3iA.jpg", url:"https://themoviedb.org/person/13326"}}, {tmdbId:"86110", properties:{bornIn:"Delight, Arkansas, USA", imdbId:"0004794", born:date('1936-04-22'), name:"Glen Campbell", bio:"Glen Travis Campbell (born April 22, 1936) is a Grammy- and Dove Award-winning, Golden Globe-nominated American country pop singer, guitarist, television host and occasional actor.  He is best known for a series of hits in the 1960s and 1970s, as well as for hosting a variety show called The Glen Campbell Goodtime Hour on CBS television. \n\nDuring his 50 years in show business, Campbell has released more than 70 albums...", died:date('2017-08-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eULfmRtHlnHmhWaNOYMy65TlcpA.jpg", url:"https://themoviedb.org/person/86110"}}, {tmdbId:"15655", properties:{bornIn:"Los Angeles - California - USA", imdbId:"0200981", born:date('1947-07-08'), name:"Kim Darby", bio:"​From Wikipedia, the free encyclopedia.   \n\nKim Darby (born July 8, 1947) is an American actress perhaps best known for co-starring with John Wayne and country singer/actor Glen Campbell in the 1969 western True Grit...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w1dwAymNXsi16SAuZZsl2JTEWFd.jpg", url:"https://themoviedb.org/person/15655"}}, {tmdbId:"78690", properties:{bornIn:"Atlantic City, New Jersey, USA", imdbId:"0805177", born:date('1926-02-17'), name:"Jeremy Slate", bio:"From Wikipedia, the free encyclopedia.   Jeremy Slate (born Robert Perham; February 17, 1926 - November 19, 2006) was an American film and television actor. \n\nDescription above from the Wikipedia article Jeremy Slate , licensed under CC-BY-SA,full list of contributors on Wikipedia...", died:date('2006-11-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bMTnh0gP33MAbfD7NcZIF70cBjR.jpg", url:"https://themoviedb.org/person/78690"}}, {tmdbId:"989373", properties:{bornIn:"Vigo, Spain", imdbId:"0299578", born:date('1921-07-15'), name:"Manolo Fábregas", bio:"Manolo Fábregas, Manuel Sánchez Navarro, fue un actor mexicano de origen español, nieto de Virginia Fábregas.  Se le recuerda también como actor, director y productor teatral y se le reconoce como un artista que se empeñó en montar en México los mejores musicales de Broadway y Londres...", died:date('1996-02-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kx2sfOooNNDPSjj9d8JdLEHeyka.jpg", url:"https://themoviedb.org/person/989373"}}, {tmdbId:"70939", properties:{bornIn:"San Juan, Puerto Rico", imdbId:"0605494", born:date('1902-12-26'), name:"Alberto Morin", bio:"Alberto Morin was born on December 26, 1902 in San Juan, Puerto Rico as Salvador R.  López.  He is known for his work on Sierra torride (1970), Rio Grande (1950) andMilagro (1988).  He died on April 7, 1989 in Burbank, California, USA. \n\nWas an OSS officer during World War II, and spoke seven languages fluently.  He met director John Ford during that period--Ford was a naval officer who also worked with the OSS--and after the war, Ford put Morin in many of his films...", died:date('1989-04-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nZAko1Mrm5IZxkjpdi7gOnEmPwe.jpg", url:"https://themoviedb.org/person/70939"}}, {tmdbId:"67916", properties:{bornIn:"Glasgow, Scotland, UK", imdbId:"0881829", born:date('1933-02-18'), name:"Mary Ure", bio:"From Wikipedia, the free encyclopedia. \n\nEileen Mary Ure (born 18 February 1933, Glasgow, Scotland - died 3 April 1975, London) was a Scottish actress of stage and film. \n\nDescription above from the Wikipedia article Mary Ure, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1975-04-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n1vISCUBulqnUkMXkomJb8up2W8.jpg", url:"https://themoviedb.org/person/67916"}}, {tmdbId:"67917", properties:{bornIn:"Lincolnshire, England", imdbId:"0943859", born:date('1926-07-11'), name:"Patrick Wymark", bio:"​Born Patrick Carl Cheeseman in Cleethorpes, Lincolnshire, England.  He was brought up in neighbouring Grimsby and frequently re-visited the area during the height of his career.   He attended University College, London, before training at the Old Vic Theatre School and making his first stage appearance in a walk-on part in Othello in 1951.  He toured South Africa the following year and then directed plays for the drama department at Stanford University, California...", died:date('1970-10-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qAObkVULZr2JhbWsdwfoH0d67ht.jpg", url:"https://themoviedb.org/person/67917"}}, {tmdbId:"44714", properties:{bornIn:"Budapest, Austria-Hungary (now Hungary)", imdbId:"0001247", born:date('1919-02-11'), name:"Eva Gabor", bio:"Eva Gabor (February 11, 1919 – July 4, 1995) was a Hungarian-born American actress and socialite.  She is widely known for her role on Green Acres as Lisa Douglas.  She voiced Duchess in The Aristocats as well as Miss Bianca in The Rescuers and The Rescuers Down Under...", died:date('1995-07-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2yI8TJ6GuCcvnNgDCGbDQRABTsi.jpg", url:"https://themoviedb.org/person/44714"}}, {tmdbId:"7077", properties:{bornIn:"Terre Haute, Indiana, USA", imdbId:"0001079", born:date('1910-05-23'), name:"Scatman Crothers", bio:"​From Wikipedia, the free encyclopedia\n\nBenjamin Sherman \"Scatman\" Crothers (May 23, 1910 – November 22, 1986) was an American actor, singer, dancer and musician known for his work as Louie the Garbage Man on the TV show Chico and the Man, and as Dick Hallorann in The Shining in 1980...", died:date('1986-11-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jf2ooubjE5tjBJwDI9Nla0M57m2.jpg", url:"https://themoviedb.org/person/7077"}}, {tmdbId:"70870", properties:{imdbId:"0246888", name:"Helmut Döring", bio:"Helmut Döring was an actor with dwarfism, known for his work mainly in Werner Herzog’s Even Dwarfs Started Small.  He is also quite badass, with little information surrounding his mysterious name...", url:"https://themoviedb.org/person/70870"}}, {tmdbId:"70871", properties:{imdbId:"0322168", name:"Paul Glauer", url:"https://themoviedb.org/person/70871"}}, {tmdbId:"70872", properties:{imdbId:"0381073", name:"Gisela Hertwig", url:"https://themoviedb.org/person/70872"}}, {tmdbId:"70873", properties:{imdbId:"0591447", name:"Hertel Minkner", url:"https://themoviedb.org/person/70873"}}, {tmdbId:"18643", properties:{bornIn:"Clayton, Missouri, USA", imdbId:"0002082", born:date('1934-01-31'), name:"James Franciscus", bio:"James Grover Franciscus (January 31, 1934 – July 8, 1991) was an American actor, known for his roles in feature films and in four television series: Mr.  Novak, The Naked City, The Investigators, and Longstreet. \n\nDescription above from the Wikipedia article James Franciscus, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1991-07-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wvu1kkLNnvWTz6G0JoxSFCf1BxR.jpg", url:"https://themoviedb.org/person/18643"}}, {tmdbId:"13260", properties:{imdbId:"0365709", born:date('1945-07-24'), name:"Linda Harrison", bio:"Linda is best remembered portraying Nova along side co-star Charlton Heston in Planet of the Apes and Beneath the Planet of the Apes.  She would go on to appear in many films and then make a cameo in 2001's Planet of the Apes film directed by Tim Burton.  She would retire from acting for family reasons until returning to co-star in 2018's Midnight Massacre which is a modern day version of Shakespeare's Julius Caesar directed by Travis Bowen...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xNrzbQjzZ7APFwBKGGNzxhKxHxX.jpg", url:"https://themoviedb.org/person/13260"}}, {tmdbId:"45110", properties:{bornIn:"Bristol, Avon, England, UK", imdbId:"0713820", born:date('1944-09-13'), name:"Dolly Read", bio:"From Wikipedia, the free encyclopedia\n\nDolly Martin (born Dolly Read on 13 September 1944 in Bristol, England) is an English pinup model and actress.  She is best remembered for her appearance in Playboy magazine and as the lead character in Beyond the Valley of the Dolls.  She is sometimes credited as Margaret Read, Dolly Read Martin, or Dolly Martin. \n\nDescription above from the Wikipedia article Dolly Martin, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/45110"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"45111", properties:{bornIn:"Toledo, Ohio, USA", imdbId:"0616675", born:date('1950-09-12'), name:"Cynthia Myers", bio:"From Wikipedia, the free encyclopedia\n\nCynthia Myers (born September 12, 1950, in Toledo, Ohio) is an American model and actress, and Playboy magazine's Playmate of the Month for the December 1968 issue. \n\nDescription above from the Wikipedia article Cynthia Myers, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2011-11-04'), url:"https://themoviedb.org/person/45111"}}, {tmdbId:"45112", properties:{bornIn:"New York City, New York, USA", imdbId:"0564394", born:date('1947-08-06'), name:"Marcia McBroom", url:"https://themoviedb.org/person/45112"}}, {tmdbId:"45113", properties:{bornIn:"San Francisco, California, USA", imdbId:"0493677", born:date('1946-05-22'), name:"John Lazar", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bnzNSA0t92US3F6IP4FygnxvGlZ.jpg", url:"https://themoviedb.org/person/45113"}}, {tmdbId:"69494", properties:{bornIn:"Honolulu, Hawaii, USA", imdbId:"0835144", born:date('1943-09-01'), name:"Don Stroud", bio:"​From Wikipedia, the free encyclopedia.   \n\nDonald Lee Stroud (born 1 September 1943) is an American actor and surfer who appeared in many films in the 1960s, 1970s and 1980s, and has starred in over 100 movies and 175 television shows to date. \n\nDescription above from the Wikipedia article Don Stroud, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vHUcVL9KLtjDv8iYsGBNPefDK8e.jpg", url:"https://themoviedb.org/person/69494"}}, {tmdbId:"1646", properties:{bornIn:"Cologne, Germany", imdbId:"0001424", born:date('1944-10-14'), name:"Udo Kier", bio:"Udo Kier is a German actor, known primarily for his work in horror and exploitation movies...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lIOGDMvrVHMgPXdhicLI41tY1zf.jpg", url:"https://themoviedb.org/person/1646"}}, {tmdbId:"1047688", properties:{name:"Olivera Katarina", bio:"From Wikipedia, the free encyclopedia Olivera Vučo, née Vukotić, also known as Olivera Katarina and Olivera Petrović (born March 5, 1940 Belgrade, Kingdom of Yugoslavia, now Serbia) is a Serbian actress and singer.  She reached the peak of her popularity in the 1960s and 1970s.  She studied at the academy for theatre, film, radio and television in Belgrade.  Started her career as a student with a major role as Koštana in a same name play in a National Theatre in Belgrade...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1bvjL3XKW4IgmranqyTqDP9Z6ek.jpg", url:"https://themoviedb.org/person/1047688"}}, {tmdbId:"15972", properties:{bornIn:"Vienna, Austria", imdbId:"0620513", born:date('1907-09-04'), name:"Reggie Nalder", bio:"Reggie Nalder may be far from a household name, and he may have appeared in many films of questionable artistic merit.  But he has provided film buffs with indelible cinematic images and characterizations for which he was singularly well-equipped...", died:date('1991-11-19'), url:"https://themoviedb.org/person/15972"}}, {tmdbId:"64928", properties:{bornIn:"Forest Hills, New York", imdbId:"0307316", born:date('1941-11-05'), name:"Art Garfunkel", bio:"Arthur Ira Garfunkel (born November 5, 1941) is an American singer, poet, and actor.  He is best known for his partnership with Paul Simon in the folk rock duo Simon & Garfunkel. \n\nDescription above from the Wikipedia article Art Garfunkel, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sNssWMf5FyPmr0Wt9ZYmMemAqsF.jpg", url:"https://themoviedb.org/person/64928"}}, {tmdbId:"37131", properties:{bornIn:"Prétot-Vicquemare, Seine-Inférieure [now Seine-Maritime], France", imdbId:"0100186", born:date('1917-07-27'), name:"Bourvil", bio:"From Wikipedia, the free encyclopedia. \n\nBourvil, born André Robert Raimbourg (27 July 1917, Prétot-Vicquemare, France – 23 September 1970, Paris) was a French actor and singer best known for his roles in comedy, most notably in his collaboration with Louis de Funès in La Grande Vadrouille (1966). \n\nDescription above from the Wikipedia article Bourvil, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1970-09-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h9eYqmgnBhRoccnTFKo0Y05dI8b.jpg", url:"https://themoviedb.org/person/37131"}}, {tmdbId:"29312", properties:{bornIn:"Royal Oak, Michigan", imdbId:"0313387", born:date('1931-02-25'), name:"Christopher George", bio:"​From Wikipedia, the free encyclopedia.   \n\nChristopher John George (February 25, 1931 - November 28, 1983) was an American television and film actor who was perhaps best known for his starring role in the 1966-1968 TV series The Rat Patrol.  He was nominated for a Golden Globe in 1967 as Best TV Star for his performance in the series.  He was also the recipient of a New York Film Festival award as the Best Actor in a Television Commercial.  George was married to actress Lynda Day George...", died:date('1983-11-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x9aUBtmY8bCSIYCAiNJRVffPn1F.jpg", url:"https://themoviedb.org/person/29312"}}, {tmdbId:"6856", properties:{bornIn:"Springfield, Massachusetts, USA", imdbId:"0000621", born:date('1951-03-17'), name:"Kurt Russell", bio:"An American television and film actor.  His first acting roles were as a child in television series, including a lead role in the Western series The Travels of Jaimie McPheeters (1963–1964).  In the 1970s, he signed a ten-year contract with the Walt Disney Company, where he became, according to Robert Osborne, the \"studio's top star of the '70s\".  In 1979, Russell was nominated for an Emmy Award for the made-for-television film Elvis...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5zfkykCkaIznXWR6sRqVDAMe4Iv.jpg", url:"https://themoviedb.org/person/6856"}}, {tmdbId:"23586", properties:{bornIn:"Youngstown, Ohio, USA", imdbId:"0283499", born:date('1924-11-08'), name:"Joe Flynn", bio:"Joe Flynn was an American film and television actor, best known for his co-starring roles in Disney movies in the 1960's and 1970's...", died:date('1974-07-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/km1TY2ieAp51uKLDBNUEANvUmaq.jpg", url:"https://themoviedb.org/person/23586"}}, {tmdbId:"15992", properties:{bornIn:"Los Angeles, California, U.S.", imdbId:"0769974", born:date('1922-07-06'), name:"William Schallert", bio:"From Wikipedia, the free encyclopedia. \n\nWilliam Joseph Schallert (born July 6, 1922) is an American actor who has appeared in many films and in such television series as The Smurfs, The Rat Patrol, Gunsmoke, The Patty Duke Show, The Many Loves of Dobie Gillis, The Waltons, Bonanza, Leave It to Beaver, The Dick Van Dyke Show, Love, American Style, Get Smart and Lawman. \n\nDescription above from the Wikipedia article William Schallert, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2016-05-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/862YCXRbmhADXVC0RaxfwNT9g4E.jpg", url:"https://themoviedb.org/person/15992"}}, {tmdbId:"34027", properties:{bornIn:"Viareggio, Toscana, Italy", imdbId:"0762248", born:date('1946-06-05'), name:"Stefania Sandrelli", bio:"Stefania Sandrelli (born 5 June 1946 in Viareggio, Province of Lucca) is an Italian actress, famous for her many roles in the commedia all'Italiana, starting from 1960s. \n\nShe was 15 years old when she starred in Divorce, Italian Style, as Marcello Mastroianni's cousin, Angela. \n\nShe was born in Viareggio, Tuscany.  She had a long relationship with Italian singer-songwriter Gino Paoli.  Their daughter Amanda Sandrelli, born in 1964, is also an actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2wpRnvlqHOGuHQ1AY6S8tWac1O2.jpg", url:"https://themoviedb.org/person/34027"}}, {tmdbId:"3281", properties:{bornIn:"San Giovanni Lupatoto", imdbId:"0608311", born:date('1929-06-08'), name:"Gastone Moschin", bio:"Italian stage, television and film actor perhaps best known for playing Don Fanucci in THE GODFATHER: PART II (1974).  From 1970 until his death, he was married to actress Marzia Ubaldi...", died:date('2017-09-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dU58seqJs1NDkNodjwCbGZg3nqT.jpg", url:"https://themoviedb.org/person/3281"}}, {tmdbId:"55757", properties:{bornIn:"Turin - Piedmont - Italy", imdbId:"0850254", born:date('1919-03-19'), name:"Enzo Tarascio", bio:"Enzo Tarascio was born on March 19, 1919, died October, 2006 (age 87) He was an actor...", died:date('2006-01-01'), url:"https://themoviedb.org/person/55757"}}, {tmdbId:"23367", properties:{bornIn:"San Pietro a Maida, Italy", imdbId:"0205793", born:date('1948-10-11'), name:"Ninetto Davoli", bio:"​From Wikipedia, the free encyclopedia.   \n\nNinetto Davoli (born 11 October 1948 as Giovanni Davoli) is an Italian actor who became known through his roles in several of Pier Paolo Pasolini's films. \n\nDescription above from the Wikipedia article  Ninetto Davoli, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bOs054IC9yaP2DDKdXdH2OEznES.jpg", url:"https://themoviedb.org/person/23367"}}, {tmdbId:"550633", properties:{bornIn:"Belgrade, Yugoslavia", imdbId:"0431270", born:date('1940-05-31'), name:"Jovan Jovanovic", url:"https://themoviedb.org/person/550633"}}, {tmdbId:"20588", properties:{bornIn:"Palermo - Sicily - Italy", imdbId:"0024188", born:date('1966-03-30'), name:"Vincenzo Amato", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8NT74kychqUuEEhfS5Nw8SKS489.jpg", url:"https://themoviedb.org/person/20588"}}, {tmdbId:"3572", properties:{bornIn:"Tokyo, Japan", imdbId:"0074575", born:date('1936-01-01'), name:"Hiroko Berghauer", died:date('2003-06-21'), url:"https://themoviedb.org/person/3572"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"3575", properties:{bornIn:"Menthon-Saint-Bernard, Haute Savoie, France", imdbId:"0479209", born:date('1920-07-30'), name:"Barbara Laage", died:date('1988-05-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ingz242K95Qv42QlLtUipEp2Wkk.jpg", url:"https://themoviedb.org/person/3575"}}, {tmdbId:"82275", properties:{bornIn:"Dubberly, Louisiane, Etats-Unis", imdbId:"0123604", born:date('1939-08-21'), name:"James Burton", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sQjA76GfRloD7uN3mpAUxUsIv87.jpg", url:"https://themoviedb.org/person/82275"}}, {tmdbId:"82276", properties:{imdbId:"0362219", name:"Glen D. Hardin", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oSA5fqJHR3OeOUYHDUOiyrYQ41K.jpg", url:"https://themoviedb.org/person/82276"}}, {tmdbId:"1351940", properties:{imdbId:"0388049", name:"Charlie Hodge", url:"https://themoviedb.org/person/1351940"}}, {tmdbId:"8963", properties:{bornIn:"Park Ridge, Illinois, USA", imdbId:"0000947", born:date('1939-07-01'), name:"Karen Black", bio:"Karen Black (July 1, 1939 – August 8, 2013) was an American actress, screenwriter, singer and songwriter.  She is noted for appearing in such films as Easy Rider, Five Easy Pieces, The Great Gatsby, The Day of the Locust, Nashville, Airport 1975, and Alfred Hitchcock's final film, Family Plot.  Over the course of her career, she won two Golden Globe Awards (out of three nominations), and an Academy Award nomination in 1970 for Best Supporting Actress, among numerous other honors...", died:date('2013-08-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2FUHvpCZ8A3we7yaEvIK8r06fCL.jpg", url:"https://themoviedb.org/person/8963"}}, {tmdbId:"35090", properties:{imdbId:"0124100", born:date('1935-01-01'), name:"Billy Green Bush", bio:"William Warren Bush (born 1935) is an American actor, sometimes credited as “Billy Greenbush”.  Notable movie appearances include Five Easy Pieces (1970), The Culpepper Cattle Company (1972), Electra Glide in Blue (1973), Alice Doesn't Live Here Anymore (1974), The River (1984), The Hitcher (1986), Critters (1986) and Jason Goes to Hell: The Final Friday (1993)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7nSctktDFQ3lrTzFHgLrH6JIW1X.jpg", url:"https://themoviedb.org/person/35090"}}, {tmdbId:"18251", properties:{imdbId:"0280840", born:date('1944-09-21'), name:"Fannie Flagg", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pMxuqJ0gR2Jx3WYEw6sJhP5iDjs.jpg", url:"https://themoviedb.org/person/18251"}}, {tmdbId:"39467", properties:{bornIn:"Merano, Bolzano", imdbId:"0135320", born:date('1943-08-21'), name:"Lino Capolicchio", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/s4o4XvtiU0t13RzU8Mag4VBwU8C.jpg", url:"https://themoviedb.org/person/39467"}}, {tmdbId:"24590", properties:{bornIn:"Paris, France", imdbId:"0761212", born:date('1948-03-11'), name:"Dominique Sanda", bio:"Dominique Sanda (born 11 March 1948) is a French actress and former fashion model. \n\nSanda was born as Dominique Marie-Françoise Renée Varaigne in Paris to Lucienne (née Pinchon) and Gérard Sanda.  She appeared in such noted European films of the 1970s as Vittorio de Sica's Il Giardino dei Finzi-Contini, Bernardo Bertolucci's The Conformist and Novecento, and Liliana Cavani's Beyond Good and Evil.  She also appeared in The Mackintosh Man (with Paul Newman) and Steppenwolf (with Max von Sydow)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7pgdyP7WDMLIzrlffs8fK5370IX.jpg", url:"https://themoviedb.org/person/24590"}}, {tmdbId:"21181", properties:{bornIn:"Peschiera del Garda, Italy", imdbId:"0601377", born:date('1941-08-02'), name:"Fabio Testi", bio:"Fabio Testi (born 2 August 1941) is an Italian film actor, notable as the star of, among many other films, First Action Hero.   Born in Peschiera del Garda, Italy, the 1. 84m tall actor started his film career as a stuntman in his college years.  His most famous job as a stuntman was in Sergio Leone's Once Upon a Time in the West, where he fell from a rooftop and hit the ground on his shoulder.   Testi married only once, in 1979, to Lola Navarro, with whom he fathered three children...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rSPYBXxsF1xvm5dGd3RKZixy4Jp.jpg", url:"https://themoviedb.org/person/21181"}}, {tmdbId:"5567", properties:{bornIn:"Roma, Lazio, Italy", imdbId:"0885123", born:date('1925-02-07'), name:"Romolo Valli", died:date('1980-02-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gvh6WBYQImUno8JeKezMk3j7PpT.jpg", url:"https://themoviedb.org/person/5567"}}, {tmdbId:"1428", properties:{bornIn:"Dartford, Kent, England, UK", imdbId:"0001396", born:date('1943-07-26'), name:"Mick Jagger", bio:"​From Wikipedia, the free encyclopedia.   \n\nSir Michael Philip \"Mick\" Jagger (born 26 July 1943) is an English musician, singer-songwriter, actor, and producer, best known as the lead vocalist of rock band, The Rolling Stones.  Jagger has also acted in and produced several films.  The Rolling Stones started in the early 1960s as a rhythm and blues cover band with Jagger as frontman...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lnW255mXyX6K8agSNwhj8H06CoC.jpg", url:"https://themoviedb.org/person/1428"}}, {tmdbId:"1429", properties:{bornIn:"London, England", imdbId:"0915115", born:date('1941-06-02'), name:"Charlie Watts", bio:"Charles Robert \"Charlie\" Watts (born 2 June 1941) is an English drummer, best known as a member of The Rolling Stones.  He is also the leader of a jazz band, as well as a record producer, commercial artist, and horse breeder. \n\nDescription above from the Wikipedia article Charlie Watts, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/1429"}}, {tmdbId:"1430", properties:{bornIn:"Dartford, Kent, England, United Kingdom", imdbId:"0724189", born:date('1943-12-18'), name:"Keith Richards", bio:"Keith Richards (born 18 December 1943) is an English musician, songwriter, and founding member of the rock band the Rolling Stones ranked by Rolling Stone magazine as the \"10th greatest guitarist of all time. \" Fourteen songs Richards wrote with songwriting partner and the Rolling Stones' vocalist Mick Jagger were listed on Rolling Stone's \"500 Greatest Songs of All Time\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/t1oa5UsJMmrhNqCIks4jQnAYSQT.jpg", url:"https://themoviedb.org/person/1430"}}, {tmdbId:"1100", properties:{bornIn:"Thal, Styria, Austria", imdbId:"0000216", born:date('1947-07-30'), name:"Arnold Schwarzenegger", bio:"An Austrian-American former professional bodybuilder, actor, model, businessman and politician who served as the 38th Governor of California (2003–2011). \n\nSchwarzenegger began weight training at 15.  He was awarded the title of Mr.  Universe at age 20 and went on to win the Mr.  Olympia contest a total of seven times.  Schwarzenegger has remained a prominent presence in the sport of bodybuilding and has written several books and numerous articles on the sport...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cWqmTdnpBN7J7XnVih5UqRQxJ8T.jpg", url:"https://themoviedb.org/person/1100"}}, {tmdbId:"42108", properties:{imdbId:"0519678", name:"Deborah Loomis", bio:"Deborah Loomis is an actress, known for Hercules in New York (1970), Foreplay (1975) and Blood Bath (1976). \n\nIn 1969, she appeared in three episodes of the ABC Gothic soap opera Dark Shadows where she played a character named Tessie Kincaid.  She appeared in episodes 808, 809 and 830. \n\nIn 1975, Deborah played a receptionist in \"The Chasers\" episode of the NBC crime drama series Police Woman...", url:"https://themoviedb.org/person/42108"}}, {tmdbId:"14852", properties:{bornIn:"Wilkes Barre, Pennsylvania, USA", imdbId:"0439170", born:date('1923-11-28'), name:"James Karen", bio:"​From Wikipedia, the free encyclopedia. \n\nJames Karen (November 28, 1923 - October 23, 2018) was an American character actor of Broadway, film and television...", died:date('2018-10-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1yTckoqgi0LZdveni5u6k0AmaXN.jpg", url:"https://themoviedb.org/person/14852"}}, {tmdbId:"2481", properties:{bornIn:"Airdrie, Lanarkshire, Scotland, UK", imdbId:"0000846", born:date('1928-06-29'), name:"Ian Bannen", bio:"​From Wikipedia, the free encyclopedia.   \n\nIan Bannen (29 June 1928 – 3 November 1999) was a Scottish character actor and occasional leading man. \n\nDescription above from the Wikipedia article Ian Bannen, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1999-11-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oJgSAb0Bi5ONjZmDTbiggvqIsst.jpg", url:"https://themoviedb.org/person/2481"}}, {tmdbId:"589207", properties:{bornIn:" Stockholm,  Sweden", imdbId:"0477417", born:date('1955-11-14'), name:"Ann-Sofie Kylin", bio:"Birgitta Ann-Sofie Kylin is a Swedish stage and screen actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d04puYBOJKjbRzpMk3V7OAYjj8L.jpg", url:"https://themoviedb.org/person/589207"}}, {tmdbId:"589208", properties:{imdbId:"0812274", name:"Rolf Sohlman", url:"https://themoviedb.org/person/589208"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"475670", properties:{bornIn:"Hille, Gävle, Sweden", imdbId:"0511450", born:date('1937-12-14'), name:"Anita Lindblom", bio:"Anita Lindblom is a Swedish singer, dancer, stage and screen actress.  Her single \"Sånt är livet\" (a cover of Roy Hamilton's \"You Can Have Her\") was a massive hit in Scandinavia 1962...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2MXCOGaVSYE46rZ7G62xPWsv5VS.jpg", url:"https://themoviedb.org/person/475670"}}, {tmdbId:"116509", properties:{bornIn:"Sala, Västmanlands län, Sweden", imdbId:"0635959", born:date('1923-09-09'), name:"Bertil Norström", died:date('2012-09-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xW6LH00nlT4caCfG7DghzBXqM4G.jpg", url:"https://themoviedb.org/person/116509"}}, {tmdbId:"2222", properties:{bornIn:"Hollywood, California, USA", imdbId:"0000977", born:date('1941-12-09'), name:"Beau Bridges", bio:"Beau Bridges (born December 9, 1941) is an American actor and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4Z5E1ei0wfJa5kq2P7LV6lUwwpy.jpg", url:"https://themoviedb.org/person/2222"}}, {tmdbId:"66670", properties:{bornIn:"British Columbia, Canada", imdbId:"0313381", born:date('1899-07-24'), name:"Chief Dan George", bio:"Chief Dan George OC (July 24, 1899 – September 23, 1981) was a chief of the Tsleil-Waututh Nation, a Coast Salish band whose Indian reserve is located on Burrard Inlet in the southeast area of the District of North Vancouver, British Columbia, Canada.  He was also an actor, musician, poet and author; his best-known written work was \"My Heart Soars\"...", died:date('1981-09-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/k3sNxQ0Mflr0KhCQSciKOuhuCGR.jpg", url:"https://themoviedb.org/person/66670"}}, {tmdbId:"31070", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0641939", born:date('1941-04-20'), name:"Ryan O'Neal", bio:"Charles Patrick Ryan O'Neal (born April 20, 1941) is an American actor and former boxer.  O'Neal trained as an amateur boxer before beginning his career in acting in 1960.  In 1964, he landed the role of Rodney Harrington on the ABC nighttime soap opera Peyton Place.  The series was an instant hit and boosted O'Neal's career...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gi7ZyoaX9FuJk4FA2nB0ey5It5x.jpg", url:"https://themoviedb.org/person/31070"}}, {tmdbId:"55636", properties:{bornIn:"Saint John, New Brunswick, Canada", imdbId:"0000661", born:date('1935-07-17'), name:"Donald Sutherland", bio:"A Canadian character actor with a film career spanning nearly 50 years.  Some of Sutherland's more notable movie roles included offbeat warriors in such war movies as \"The Dirty Dozen\" in 1967, and \"MASH\" and \"Kelly's Heroes\" in 1970, as well as in such popular films as \"Klute\", \"Invasion of the Body Snatchers\", and \"Ordinary People\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pvk7fjJNg9kZQTeuG6ZlfJ8t2Ze.jpg", url:"https://themoviedb.org/person/55636"}}, {tmdbId:"4139", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"0000643", born:date('1933-08-25'), name:"Tom Skerritt", bio:"​From Wikipedia, the free encyclopedia\n\nThomas Roy \"Tom\" Skerritt (born August 25, 1933) is an American actor who has appeared in over 40 films and more than 200 television episodes since 1962. \n\nDescription above from the Wikipedia article Tom Skerritt, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/f9vEX1cqrG5aW8DmJ1FKSj4Zjvt.jpg", url:"https://themoviedb.org/person/4139"}}, {tmdbId:"9805", properties:{bornIn:"Long Beach, California, USA", imdbId:"0001419", born:date('1937-06-02'), name:"Sally Kellerman", bio:"From Wikipedia, the free encyclopedia\n\nSally Kellerman (born June 2, 1937) is an American actress and singer known for her role as Major Margaret \"Hot Lips\" Houlihan in the film MASH (1970), for which she was nominated for an Oscar for Best Actress in a Supporting Role. \n\nDescription above from the Wikipedia article Sally Kellerman, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zSY5ljAQ8hZnEOoUM5CvNBio2HR.jpg", url:"https://themoviedb.org/person/9805"}}, {tmdbId:"68898", properties:{bornIn:"Brooklyn, New York", imdbId:"0056310", born:date('1937-05-05'), name:"Sandy Baron", bio:"From Wikipedia, the free encyclopedia.   Sandy Baron (May 5, 1937 – January 21, 2001) was an American comedian who performed on stage, in films, and on television. \n\n \n\nDescription and picture above from the Wikipedia article Sandy Baron, licensed under CC-BY-SA,full list of contributors on Wikipedia...", died:date('2001-01-21'), url:"https://themoviedb.org/person/68898"}}, {tmdbId:"32394", properties:{bornIn:"Brooklyn, New York City, New York, USA", imdbId:"0575198", born:date('1929-09-20'), name:"Anne Meara", bio:"From Wikipedia, the free encyclopedia. \n\nAnne Meara (September 20, 1929 – May 23, 2015) was an American actress and comedian.  She and Jerry Stiller were a prominent 1960s comedy team, appearing as Stiller and Meara, and are the parents of actor/comedian Ben and actress Amy Stiller. \n\nDescription above from the Wikipedia article Anne Meara, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2015-05-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8c8n15LYkn3KRl5D7ynTX4oBenD.jpg", url:"https://themoviedb.org/person/32394"}}, {tmdbId:"26715", properties:{bornIn:"New York City, New York, USA", imdbId:"0458951", born:date('1942-02-08'), name:"Robert Klein", bio:"From Wikipedia, the free encyclopedia\n\nRobert Klein (born February 8, 1942) is an American stand-up comedian, singer and actor. \n\nDescription above from the Wikipedia article Robert Klein, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qKi9wzRbViNKynIRG6VhWn6JKUy.jpg", url:"https://themoviedb.org/person/26715"}}, {tmdbId:"922", properties:{bornIn:"Newark, New Jersey, USA", imdbId:"0307255", born:date('1939-11-22'), name:"Allen Garfield", bio:"From Wikipedia, the free encyclopedia\n\nAllen Garfield, born and sometimes credited as Allen Goorwitz (born November 22, 1939), is an American film and television actor. \n\nGarfield was born in Newark, New Jersey, the son of Alice (née Lavroff) and Philip Goorwitz. A graduate of Weequahic High School, he was a sports reporter and Golden Gloves boxer before becoming an actor...", died:date('2020-04-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tCFFRhy7JzuemUphdpSOt9bpt39.jpg", url:"https://themoviedb.org/person/922"}}, {tmdbId:"40551", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"0950079", born:date('1939-05-19'), name:"Stephen Young", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/746zWUFF4vIGIc0bdYpo1GyUynE.jpg", url:"https://themoviedb.org/person/40551"}}, {tmdbId:"15650", properties:{bornIn:"Manhattan, New York City, New York, USA", imdbId:"0835021", born:date('1918-02-08'), name:"Michael Strong", bio:"​From Wikipedia, the free encyclopedia. \n\nMichael Strong  (February 8, 1918- September 17, 1980) was an American stage, film and television actor...", died:date('1980-09-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a4KsknSh0kFoCWmdbnLlaMiQi0E.jpg", url:"https://themoviedb.org/person/15650"}}, {tmdbId:"128928", properties:{imdbId:"0107894", name:"Michèle Breton", url:"https://themoviedb.org/person/128928"}}, {tmdbId:"118239", properties:{imdbId:"0792163", born:date('1920-09-17'), name:"Dinah Sheridan", died:date('2012-11-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9DBEFocvJYMIsOxgDnPPHp0QYZO.jpg", url:"https://themoviedb.org/person/118239"}}, {tmdbId:"40943", properties:{bornIn:"Oldham, Lancashire, England", imdbId:"0187754", born:date('1928-12-29'), name:"Bernard Cribbins", bio:"​From Wikipedia, the free encyclopedia.   \n\nBernard Cribbins (born 29 December 1928) is an English character actor, voice-over artist and musical comedian with a career spanning over half a century who came to prominence in films in the 1960s, has been in work consistently since his professional debut in the mid 1950s, and as of 2010 is still an active performer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yBSGVUC8d37kXVkjNPuQ4vPslrI.jpg", url:"https://themoviedb.org/person/40943"}}, {tmdbId:"47391", properties:{bornIn:"Nairobi, Kenya", imdbId:"0581674", born:date('1912-01-03'), name:"William Mervyn", bio:"​From Wikipedia, the free encyclopedia.   \n\nWilliam Mervyn (3 January 1912 – 6 August 1976) was an English actor best known for his portrayal of the Bishop in the clerical comedy All Gas and Gaiters. \n\nDescription above from the Wikipedia article  William Mervyn, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1976-08-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h1YXoTkwbaScl3eQJdwIPSKckNO.jpg", url:"https://themoviedb.org/person/47391"}}, {tmdbId:"63911", properties:{imdbId:"0193868", born:date('1930-01-04'), name:"Iain Cuthbertson", died:date('2009-09-04'), url:"https://themoviedb.org/person/63911"}}, {tmdbId:"122632", properties:{bornIn:"Jackson, Tennessee, USA", imdbId:"0427756", born:date('1941-08-18'), name:"Christopher Jones", bio:"William \"Billy\" Frank Jones, better known as Christopher Jones, was an American character actor, born August 18, 1941 in Jackson, Tennessee.  With looks and a manner strikingly reminiscent of the late James Dean, Jones came from a similar background to Dean's, but his interest in the arts began with drawing, which earned him an Art school scholarship in his teens...", died:date('2014-01-31'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9CEaGmL1hNiAxT5JdmCdAZ5OR0q.jpg", url:"https://themoviedb.org/person/122632"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"556918", properties:{imdbId:"0102830", name:"Andrew Brackfield", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xC5PtLsPMjiBi3KRNtuyXJqrWLq.jpg", url:"https://themoviedb.org/person/556918"}}, {tmdbId:"44409", properties:{bornIn:"Sevilla, Spain", imdbId:"0002817", born:date('1943-07-09'), name:"Soledad Miranda", bio:"Soledad Rendón Bueno (9 July 1943 – 18 August 1970), better known by her stage names Soledad Miranda or Susann Korda (or sometimes Susan Korday), was an actress who was born in Seville, Spain to Portuguese parents of Roma ancestry.  She frequently starred in the films of Jess Franco, such as Count Dracula and Vampyros Lesbos.  She died in a car accident on a Lisbon highway...", died:date('1970-08-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lPFIk58YBqqeqxJPagMjOG1yXqL.jpg", url:"https://themoviedb.org/person/44409"}}, {tmdbId:"44423", properties:{imdbId:"0835527", born:date('1940-01-13'), name:"Ewa Strömberg", bio:"From Wikipedia, the free encyclopedia. \n\nEwa Strömberg (born Eva Louise Hägglund) is a Swedish actress.  She appeared in a number of Swedish films before her international career.  Nowadays, she is best known for her appearance in a number of films by Spanish director Jesus Franco, most notably Vampyros Lesbos (1971).  She retired from the film industry shortly afterwards...", died:date('2013-01-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uzBLsiKjWHSbmnThGKER14hdxyU.jpg", url:"https://themoviedb.org/person/44423"}}, {tmdbId:"9222", properties:{bornIn:"Klamath Falls, Oregon, USA", imdbId:"0171824", born:date('1938-08-30'), name:"Don Pedro Colley", bio:"From Wikipedia, the free encyclopedia\n\nDon Pedro Colley (born 30 August 1938) is an American actor. \n\nColley was born in Klamath Falls, Oregon to Muriel and Pete Colley.  He attended Klamath Union High School and actively played American football and athletics, which led to an unsuccessful try-out for the 1960 Summer Olympics.  He later attended the University of Oregon and studied architecture...", died:date('2017-10-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mNkseUBCrAESDKVTDdwWSEw6oUq.jpg", url:"https://themoviedb.org/person/9222"}}, {tmdbId:"9223", properties:{imdbId:"0574114", name:"Maggie McOmie", bio:"From Wikipedia, the free encyclopedia\n\nMaggie McOmie is an American stage and film actress, best known for co-starring with Robert Duvall in the 1971 film THX 1138.  For the film, she was required to shave her head, an event that was featured in a tongue-in-cheek behind-the-scenes featurette titled Bald.  McOmie was one of the few actresses approached for the part of THX's lover, LUH, to agree to cut her hair for the role...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/k2UczQbdgUbRpcONs3CTfqy9Ka1.jpg", url:"https://themoviedb.org/person/9223"}}, {tmdbId:"68411", properties:{bornIn:"Tenri, Japan", imdbId:"0945522", born:date('1910-02-24'), name:"Sô Yamamura", bio:"Sō Yamamura (山村聰, Yamamura Sō, 24 February 1910 – 26 May 2000) was a Japanese actor and film director.  He appeared in more than 110 films between 1947 and 1991, and directed four films.  He was also known by the name Satoshi Yamamura, while his actual birth name is Koga Hirosada.  In the US, he is well known for his portrayals of Japanese Admiral Isoroku Yamamoto of the Combined Fleet, in Tora! Tora! Tora!, and of Mr.  Sakamoto, the CEO of Assan Motors in Gung Ho...", died:date('2000-05-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jS0MhMUxuze4SotuQ1kiVyCCFPX.jpg", url:"https://themoviedb.org/person/68411"}}, {tmdbId:"37510", properties:{bornIn:"València, València, Comunitat Valenciana, Spain", imdbId:"0304747", born:date('1921-12-02'), name:"Lola Gaos", bio:"Nel 1939, durante la guerra civile spagnola, si trasferì in Sud America con la sua famiglia.  Qui iniziò la sua carriera di attrice di teatro, che proseguì in Spagna nelle compagnie di Mercedes Prendes, Mary Carrillo e Guillermo Marín.   Il suo debutto cinematografico risale al 1949, quello televisivo al 1957, mentre sul palcoscenico si cimentò in classici del teatro moderno comeGli spettri di Ibsen e Woyzeck di Büchner, giungendo a formare una propria compagnia...", died:date('1993-07-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/crl7qEiXkzuaqOQpAEEkXt4bm61.jpg", url:"https://themoviedb.org/person/37510"}}, {tmdbId:"8924", properties:{bornIn:"Bayonne, New Jersey, USA", imdbId:"0001449", born:date('1938-01-01'), name:"Frank Langella", bio:"Frank A.  Langella, Jr.  (born January 1, 1938) is an American stage and film actor. \n\nDescription above from the Wikipedia article Frank Langella, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/SZkKwqadQi7lCGNwscuLM1N9cw.jpg", url:"https://themoviedb.org/person/8924"}}, {tmdbId:"6844", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0001123", born:date('1933-08-01'), name:"Dom DeLuise", bio:"From Wikipedia, the free encyclopedia. \n\nDominick \"Dom\" DeLuise (August 1, 1933 – May 4, 2009) was an American actor, comedian, film director, television producer, chef, and author.  He was the husband of actress Carol Arthur from 1965 until his death, and the father of actor, writer, pianist, director Peter DeLuise, actor David DeLuise, and actor Michael DeLuise.  He starred in various Don Bluth films, such as All Dogs Go to Heaven, The Secret of NIMH and An American Tail...", died:date('2009-05-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3k45LlomavX4f2f3FnjtKhjojuf.jpg", url:"https://themoviedb.org/person/6844"}}, {tmdbId:"2172", properties:{bornIn:"Khartoum, Sudan", imdbId:"0903867", born:date('1932-08-22'), name:"Andréas Voutsinas", bio:"Andreas Voutsinas (22 August 1930 – 8 June 2010) was a Greek actor and theater director.  In the English-speaking world, he was best known for his roles in three Mel Brooks films, The Producers (1968), The Twelve Chairs (1970) and History of the World, Part I (1981). \n\nVoutsinas was born on 22 August 1932 in Khartoum, since there was a sizeable community of Greek settlers in Sudan at the time.  His parents hailed from the Ionian Island of Kefalonia...", died:date('2010-06-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oIPi22XvpHVKF577UaCs3dL31fJ.jpg", url:"https://themoviedb.org/person/2172"}}, {tmdbId:"115573", properties:{bornIn:"Birkenhead, Wirral, England", imdbId:"0413559", born:date('1936-05-09'), name:"Glenda Jackson", bio:"Glenda May Jackson (born 9 May 1936) is an English actress and politician.  A professional actress from the late 1950s onwards, Jackson spent four years as a member of the Royal Shakespeare Company from 1964, and was particularly associated with the work of director Peter Brook.  She has won two Academy Awards for Best Actress: for Women in Love (1970) and A Touch of Class (1973)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5yHkQfo8BTojmwzhuCrd0Cme8do.jpg", url:"https://themoviedb.org/person/115573"}}, {tmdbId:"95692", properties:{bornIn:"Worthing, Sussex, England, UK", imdbId:"0511614", born:date('1939-12-08'), name:"Jennie Linden", bio:"Jennie Linden (born 8 December 1939) is an English actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5KAogzkBXypKHg35SvieepoqtsE.jpg", url:"https://themoviedb.org/person/95692"}}, {tmdbId:"86385", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0369784", born:date('1941-01-21'), name:"Richie Havens", bio:"Richard Pierce Havens was an American singer-songwriter and guitarist.   His music encompassed elements of folk, soul, and rhythm and blues.  He had an intense and rhythmic guitar style (often in open tunings), and played soulful covers of pop and folk songs.  He was the opening act at Woodstock...", died:date('2013-04-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/34y8xJ5L9pfy8oYiWnsKvPWNTJy.jpg", url:"https://themoviedb.org/person/86385"}}, {tmdbId:"1932240", properties:{name:"Sha-Na-Na", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tX8SRfgkCvnT317u85EYvCVyBjp.jpg", url:"https://themoviedb.org/person/1932240"}}, {tmdbId:"88947", properties:{imdbId:"0242098", born:date('1946-02-20'), name:"Sandy Duncan", url:"https://themoviedb.org/person/88947"}}, {tmdbId:"10555", properties:{bornIn:"New York City, New York, USA", imdbId:"0731634", born:date('1939-10-22'), name:"Tony Roberts", bio:"From Wikipedia, the free encyclopedia. \n\nDavid Anthony \"Tony\" Roberts (born October 22, 1939) is an American actor.  He is best known for his roles in several Woody Allen movies, usually cast as Allen's best friend...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jWFr0V9zwg4DF2Ya9AmUQARottN.jpg", url:"https://themoviedb.org/person/10555"}}, {tmdbId:"98549", properties:{imdbId:"0901638", name:"Mark Volman", url:"https://themoviedb.org/person/98549"}}, {tmdbId:"98550", properties:{imdbId:"0443433", name:"Howard Kaylan", url:"https://themoviedb.org/person/98550"}}, {tmdbId:"2019906", properties:{name:"Ian Underwood", url:"https://themoviedb.org/person/2019906"}}, {tmdbId:"1226125", properties:{imdbId:"0241818", name:"Aynsley Dunbar", url:"https://themoviedb.org/person/1226125"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"10722", properties:{bornIn:"Leicester, Leicestershire, England", imdbId:"0001037", born:date('1941-01-08'), name:"Graham Chapman", bio:"Graham Arthur Chapman (8 January 1941 – 4 October 1989) was an English comedian, physician, writer, and actor and one of the six members of the Monty Python comedy troupe.  He was also the lead actor in their two narrative films, playing King Arthur in Monty Python and the Holy Grail and Brian in Monty Python's Life of Brian.  He co-authored and starred in the film Yellowbeard. \n\nChapman was born in Leicester but was raised in nearby Melton Mowbray...", died:date('1989-10-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qmTXDGNxuuwQ4IGNHwxmCdjuTGk.jpg", url:"https://themoviedb.org/person/10722"}}, {tmdbId:"10713", properties:{bornIn:"South Shields, County Durham, England, UK", imdbId:"0001385", born:date('1943-03-29'), name:"Eric Idle", bio:"From Wikipedia, the free encyclopedia.  Eric Idle (born 29 March 1943) is an English comedian, actor, author, singer, writer, and comedic composer who wrote and performed as a member of the popular British comedy group Monty Python. \n\nDescription above from the Wikipedia article Eric Idle, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fXPCAvoXW3gbpqWhzjePXSZ4VPi.jpg", url:"https://themoviedb.org/person/10713"}}, {tmdbId:"39709", properties:{bornIn:"London, England, UK", imdbId:"0003679", born:date('1930-11-04'), name:"Kate Reid", bio:"From Wikipedia, the free encyclopedia\n\nDaphne Kate Reid, OC (November 4, 1930 – March 27, 1993) was a Canadian stage, film and television actress. \n\nDescription above from the Wikipedia article Kate Reid, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1993-03-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bZIfU7gmqhN4S4hFitCvtjRsrlD.jpg", url:"https://themoviedb.org/person/39709"}}, {tmdbId:"68934", properties:{bornIn:"Mexico City, Distrito Federal", imdbId:"0598823", born:date('1903-06-05'), name:"Carlos Montalbán", bio:"From Wikipedia, the free encyclopedia.   Carlos Montalbán (June 5, 1903 – March 28, 1991) was a Mexican character actor. \n\nMontalbán was born in Mexico City, Distrito Federal, the son of Spanish immigrants Ricarda (née Merino) and Jenaro Montalbán, a store manager.   He was the older brother of actor Ricardo Montalbán...", died:date('1991-03-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ydTvdSVpAP2y9wjJEgSdU9rgmrM.jpg", url:"https://themoviedb.org/person/68934"}}, {tmdbId:"68935", properties:{bornIn:"Seville, Spain", imdbId:"0007707", born:date('1943-04-02'), name:"Nati Abascal", bio:"From Wikipedia, the free encyclopedia.   Natividad Abascal y Romero-Toro (formerly, The Duchess of Feria; born 2 April 1943, in Seville, Spain), more commonly known as Nati Abascal, is a Spanish socialite and a former fashion model.  She is also a member of the International Best Dressed List since 1984.  \n\n \n\nDescription above from the Wikipedia article Nati Abascal, licensed under CC-BY-SA,full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/68935"}}, {tmdbId:"100019", properties:{imdbId:"0185281", born:date('1924-12-06'), name:"Wally Cox", died:date('1973-02-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Fb8vRK2qkIwLHuHwDzhN6SwjO1.jpg", url:"https://themoviedb.org/person/100019"}}, {tmdbId:"129485", properties:{bornIn:"Winner, South Dakota, U.S.", imdbId:"0852255", born:date('1939-09-27'), name:"Delores Taylor", bio:"From Wikipedia, the free encyclopedia. \n\nDelores Taylor (born September 27, 1939) is an American film actress, writer and producer, known for her roles in the Billy Jack films of the 1970s. \n\nDescription above from the Wikipedia article Delores Taylor, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/129485"}}, {tmdbId:"117027", properties:{bornIn:"Calaveras County, California, USA", imdbId:"0397739", born:date('1918-01-22'), name:"Clark Howat", bio:"Clark Howat was born on January 22, 1918 in Calaveras County, California, USA as John Clark Howat.  He is known for his work on Billy Jack (1971), Je dois tuer (1954) and Airport (1970).  He was married to Muriel Mansell.  He died on October 30, 2009 in Arroyo Grande, California...", died:date('2009-10-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vCml23MUfvS0rz09Rd9DmUeBBJh.jpg", url:"https://themoviedb.org/person/117027"}}, {tmdbId:"59302", properties:{bornIn:"Watertown, New York, USA", imdbId:"0412731", born:date('1923-12-23'), name:"Victor Izay", died:date('2014-01-20'), url:"https://themoviedb.org/person/59302"}}, {tmdbId:"25638", properties:{bornIn:"Cleveland, Ohio, USA", imdbId:"0504492", born:date('1958-07-11'), name:"Mark Lester", bio:"Mark attended stage school in London, England as a young child and made his film debut in The Counterfeit Constable (1964) at the age of six.  He made countless TV appearances and became very well known in England.  Worldwide fame developed as a result of his portrayal of a stuttering child in Our Mother's House (1967).  Producers ofOliver! (1968) auditioned 250 child actors for the title role and finally chose him.  Many roles for TV, film and stage followed...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5Cyn92XDNg1tpepHZdUmttPafOR.jpg", url:"https://themoviedb.org/person/25638"}}, {tmdbId:"228490", properties:{imdbId:"0492972", born:date('1944-02-21'), name:"Peter Lee Lawrence", died:date('1974-04-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ojnrdEajbreXBmSlCkfSHGmArdD.jpg", url:"https://themoviedb.org/person/228490"}}, {tmdbId:"33709", properties:{bornIn:"Landau an der Isar, Bavaria, Germany", imdbId:"0321779", born:date('1944-03-02'), name:"Uschi Glas", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pLtYUsfQk1HjIpCYud1Ohylz8tE.jpg", url:"https://themoviedb.org/person/33709"}}, {tmdbId:"96177", properties:{bornIn:"Stanmore, Middlesex, England, UK", imdbId:"0370769", born:date('1953-01-19'), name:"Linda Hayden", bio:"From Wikipedia, the free encyclopedia\n\nLinda Hayden (born 19 January 1953 in Stanmore, Middlesex) is an English film and television actress, best known for her roles in 1970s British horror films and sex comedies. \n\nDescription above from the Wikipedia article Linda Hayden, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/18wsslIyJIZiiRRK9e4M2ithqSx.jpg", url:"https://themoviedb.org/person/96177"}}, {tmdbId:"96187", properties:{bornIn:"UK", imdbId:"0028568", name:"Barry Andrews", url:"https://themoviedb.org/person/96187"}}, {tmdbId:"96188", properties:{bornIn:"Cleethorpes, Lincolnshire, England", imdbId:"0234540", born:date('1948-09-27'), name:"Michele Dotrice", bio:"From Wikipedia, the free encyclopedia. \n\nMichele Dotrice (born 27 September 1948) is an English actress best known for her portrayal of Betty, the long-suffering wife of Frank Spencer, played by Michael Crawford, in the BBC sitcom Some Mothers Do ’Ave ’Em, which ran from 1973 to 1978. \n\nHer father Roy Dotrice is an actor, as was her mother Kay Dotrice.  She has two sisters, Karen Dotrice and Yvette Dotrice, who also followed their parents’ footsteps into acting...", url:"https://themoviedb.org/person/96188"}}, {tmdbId:"145819", properties:{imdbId:"0081122", name:"Georges Bidault", url:"https://themoviedb.org/person/145819"}}, {tmdbId:"145820", properties:{imdbId:"0088175", name:"Matthäus Bleibinger", url:"https://themoviedb.org/person/145820"}}, {tmdbId:"2264", properties:{bornIn:"Armagh, Northern Ireland, UK", imdbId:"0535861", born:date('1922-03-31'), name:"Patrick Magee", bio:"​From Wikipedia, the free encyclopedia\n\nPatrick Magee (31 March 1922 – 14 August 1982) was a Northern Irish actor best known for his collaborations with Samuel Beckett and Harold Pinter, as well as his appearances in horror films and in Stanley Kubrick's films A Clockwork Orange and Barry Lyndon. \n\nDescription above from the Wikipedia article Patrick Magee (actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1982-08-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/32ReETRLWtjg4eQO1SRhJsn8aSE.jpg", url:"https://themoviedb.org/person/2264"}}, {tmdbId:"2267", properties:{bornIn:"Jhansi, British India (now Jhansi, Uttar Pradesh, India)", imdbId:"0060988", born:date('1920-12-04'), name:"Michael Bates", bio:"​From Wikipedia, the free encyclopedia\n\nMichael Hammond Bates was an Indian-born English actor.  He was educated at Uppingham School in Rutland and St Catharine's College, Cambridge.  \n\nBates served as a Major serving with the Brigade of Gurkhas in Burma before his discharge at the end of World War II.  In 1953, while an ensemble member with the Stratford Festival in Stratford, Ontario, he appeared in Richard III and All's Well That End's Well...", died:date('1978-01-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/53ciikCHIcr1thlDFvQtzNNbFAd.jpg", url:"https://themoviedb.org/person/2267"}}, {tmdbId:"2268", properties:{bornIn:"Oldham, Lancashire, England, UK", imdbId:"0165049", born:date('1947-04-26'), name:"Warren Clarke", bio:"Warren Clarke was an English actor.  He was known for his appearances in many films, including a significant early role as Dim in Stanley Kubrick's A Clockwork Orange, and for numerous television appearances, including lead roles in the TV series Dalziel and Pascoe (as Detective Superintendent Andy Dalziel), The Manageress and Sleepers...", died:date('2014-11-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ecBiugofrkuSk5tRu6IUpQDNGio.jpg", url:"https://themoviedb.org/person/2268"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"132476", properties:{imdbId:"0082419", born:date('1906-04-22'), name:"Riccardo Billi", died:date('1982-04-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/y3gUGClMqyJMNoYh48Po8X1jLmZ.jpg", url:"https://themoviedb.org/person/132476"}}, {tmdbId:"106346", properties:{bornIn:"Napoli, Campania, Italy", imdbId:"0714805", born:date('1928-03-25'), name:"Gigi Reder", died:date('1998-10-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8HPNYzMcLgIBaf2BYlovYjnBcOp.jpg", url:"https://themoviedb.org/person/106346"}}, {tmdbId:"532144", properties:{bornIn:"Milan, Italy", imdbId:"0780002", born:date('1905-11-16'), name:"Tino Scotti", died:date('1984-10-16'), url:"https://themoviedb.org/person/532144"}}, {tmdbId:"27393", properties:{bornIn:"Kingston, Surrey, England", imdbId:"0840303", born:date('1933-04-06'), name:"Dudley Sutton", bio:"Dudley Sutton was a British actor famous for his work with directors such as Sidney J.  Furie, Ken Russell, Derek Jarman and Sally Potter and for playing Tinker Dill in the long running BBC drama series Lovejoy...", died:date('2018-09-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mphzHO3IyNRBXn34XWVYD23pVmo.jpg", url:"https://themoviedb.org/person/27393"}}, {tmdbId:"77312", properties:{imdbId:"0012451", born:date('1902-11-01'), name:"Max Adrian", died:date('1973-01-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nQM59zRnoc0JH97tCzrXkZf5Zln.jpg", url:"https://themoviedb.org/person/77312"}}, {tmdbId:"10190", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0001762", born:date('1940-08-19'), name:"Jill St. John", bio:"From Wikipedia, the free encyclopedia. \n\nJill St.  John (born August 19, 1940) is an American actress.  She is best known for her role as Tiffany Case, the lead Bond girl in Diamonds Are Forever. \n\nDescription above from the Wikipedia article Jill St.  John, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o0LKSONTaFmjuf9ntKa4oVbOLKq.jpg", url:"https://themoviedb.org/person/10190"}}, {tmdbId:"10191", properties:{bornIn:"Santa Monica, California, USA", imdbId:"0939836", born:date('1946-03-01'), name:"Lana Wood", bio:"From Wikipedia\n\nLana Wood (born Svetlana Gurdin; March 1, 1946) is an American actress and film producer.  She is best known for her role as Plenty O'Toole in the James Bond film Diamonds Are Forever (1971).  Her elder sister was film star Natalie Wood...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tZfzwaF43i5o4bNtXt5Q1J4Z9Cv.jpg", url:"https://themoviedb.org/person/10191"}}, {tmdbId:"14784", properties:{bornIn:"New York City, New York, USA", imdbId:"0763858", born:date('1939-04-21'), name:"Reni Santoni", bio:"Reni Santoni (April 21, 1939 – August 1, 2020) was an American film, television and voice actor. \n\nSantoni was born in New York City of French and Spanish descent. \n\nHe began his career in off-Broadway theatre.  His first significant film role was an uncredited appearance in the 1964 film The Pawnbroker, starring Rod Steiger, in which he played a junkie trying to sell a radio to the title character, using anti-Semitic slurs that have absolutely no effect...", died:date('2020-08-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hanPruCs3M8OAZE6mKB5NxLMm47.jpg", url:"https://themoviedb.org/person/14784"}}, {tmdbId:"17580", properties:{bornIn:"Zehner, Saskatchewan, Canada", imdbId:"0006893", born:date('1932-02-24'), name:"John Vernon", bio:"From Wikipedia, the free encyclopedia.   John Keith Vernon (February 24, 1932 – February 1, 2005) was a Canadian actor.  He made a career in Hollywood after achieving initial television stardom in Canada...", died:date('2005-02-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gcDiT7lbejFskdFMEx5syWSRfnj.jpg", url:"https://themoviedb.org/person/17580"}}, {tmdbId:"40186", properties:{bornIn:"Missouri, Stati Uniti", imdbId:"0779261", born:date('1932-01-01'), name:"