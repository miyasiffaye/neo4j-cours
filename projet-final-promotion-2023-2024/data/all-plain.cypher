UNWIND [{tmdbId:"81061", properties:{imdbId:"0341447", name:"Bob Griffith", url:"https://themoviedb.org/person/81061"}}, {tmdbId:"140896", properties:{imdbId:"0041825", name:"Roxanna Augesen", url:"https://themoviedb.org/person/140896"}}, {tmdbId:"96149", properties:{bornIn:"Washington, District of Columbia, USA", imdbId:"0161202", born:date('1946-05-20'), name:"Connie Chung", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5YeSQMUVvYtO1LlgSdZ2HVimDoL.jpg", url:"https://themoviedb.org/person/96149"}}, {tmdbId:"2099871", properties:{name:"Luke", url:"https://themoviedb.org/person/2099871"}}, {tmdbId:"1293100", properties:{name:"Karma Tensing Nyima Lama", url:"https://themoviedb.org/person/1293100"}}, {tmdbId:"27915", properties:{bornIn:"Cardiff, Wales, UK", imdbId:"0637040", born:date('1893-01-15'), name:"Ivor Novello", bio:"Ivor Novello (born David Ivor Davies) was a Welsh composer and actor who became one of the most popular British entertainers of the first half of the 20th century, on both screen and stage. \n\nHe was born into a musical Cardiff family and his mother, Clara Novello Davies, was an internationally known singing teacher and choral conductor.   As a child, Novello was a successful singer in various eisteddfodau throughout the country...", died:date('1951-03-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zUJMQeUpxXN5vSKJXMqiWMglQJF.jpg", url:"https://themoviedb.org/person/27915"}}, {tmdbId:"20420", properties:{bornIn:"Buitenzorg, Buitenzorg, Dutch East Indies [now Bogor, West Java, Indonesia]", imdbId:"0761525", born:date('1933-12-24'), name:"Dirk Sanders", died:date('2002-07-26'), url:"https://themoviedb.org/person/20420"}}, {tmdbId:"100183", properties:{bornIn:"Birmingham, England, UK", imdbId:"0528855", born:date('1947-12-30'), name:"Jeff Lynne", url:"https://themoviedb.org/person/100183"}}, {tmdbId:"1080542", properties:{bornIn:"Blackpool, Lancashire, England, UK", imdbId:"1982510", born:date('1986-04-27'), name:"Jenna Coleman", bio:"Jenna-Louise Coleman (born 27 April 1986), known as Jenna Coleman, is an English actress.  Her notable roles are Clara Oswald in the British television series Doctor Who, Jasmine Thomas in the British soap opera Emmerdale, and Queen Victoria in the ITV drama series Victoria...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gkbDdTR8zmoacaokfV9oCswlvIv.jpg", url:"https://themoviedb.org/person/1080542"}}, {tmdbId:"27765", properties:{bornIn:"Yorba Linda, California, USA", imdbId:"0633271", born:date('1913-01-09'), name:"Richard Nixon", died:date('1994-04-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uCJeC6LXnv3KVA1YUNTpBh8uAhC.jpg", url:"https://themoviedb.org/person/27765"}}, {tmdbId:"548681", properties:{imdbId:"0109604", name:"David Brinkley", bio:"David McClure Brinkley (July 10, 1920 – June 11, 2003) was an American newscaster for NBC and ABC in a career lasting from 1943 to 1997. \n\nFrom 1956 through 1970, he co-anchored NBC's top rated nightly news program, The Huntley–Brinkley Report, with Chet Huntley and thereafter appeared as co-anchor or commentator on its successor, NBC Nightly News, through the 1970s...", url:"https://themoviedb.org/person/548681"}}, {tmdbId:"1921972", properties:{name:"Stephen Bull", url:"https://themoviedb.org/person/1921972"}}, {tmdbId:"1750162", properties:{bornIn:"Phoenix, Arizona, United States", born:date('1986-12-08'), name:"Ashley Campbell", bio:"Ashley Campbell is an American country music singer and songwriter.  She is the daughter of Glen Campbell...", url:"https://themoviedb.org/person/1750162"}}, {tmdbId:"123664", properties:{bornIn:"Seoul, South Korea", imdbId:"1195119", born:date('1982-03-01'), name:"Kim Min-hee", bio:"Kim Min-hee (김민희, born 1 March 1982) is a South Korean actress and former fashion model.  In 2017, She won the Silver Bear for Best Actress at the Berlin International Film Festival for her performance in Hong Sang-soo's film On the Beach at Night Alone (2017).  and She is known as one of muses director Hong Sang-soo and gained international recognition in her leading role in auteur Park Chan-wook's film The Handmaiden (2016)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3MNC2vPOIjYzhATMslPV1dypOJs.jpg", url:"https://themoviedb.org/person/123664"}}, {tmdbId:"1537768", properties:{bornIn:"Seoul, South Korea", imdbId:"3892241", born:date('1990-04-24'), name:"Kim Tae-ri", bio:"Tae-ri Kim is a South Korean actress.  Kim started her career appearing in theater productions and modelling in TV adverts.  She made her feature film debut in Park Chan-wook's film The Handmaiden (2016) where she was chosen from among 1,500 candidates who auditioned for the role.  Park's first impression of Kim reminded him strongly of his first meeting with actress Kang Hye-jung, who had her career breakthrough in Park's film Oldboy (2003)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gFofVUeVlIvBJMUv7maHQwWdfsk.jpg", url:"https://themoviedb.org/person/1537768"}}, {tmdbId:"138336", properties:{bornIn:"Busan, South Korea", imdbId:"2437361", born:date('1976-03-03'), name:"Cho Jin-woong", bio:"Cho Jin-woong (born Jo Won-joon on April 2, 1976) is a South Korean actor.  He is best known for his roles as Sejong's loyal bodyguard in Deep Rooted Tree (2011), a mobster in Nameless Gangster: Rules of the Time (2012), and a mysterious villain in A Hard Day (2014).  He also gained recognition and praise for his performance as a detective in the television series Signal (2016)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x4jLNlIM1j1m2p7AoieiDiFOluE.jpg", url:"https://themoviedb.org/person/138336"}}, {tmdbId:"181934", properties:{bornIn:"New York City, New York, USA", imdbId:"0789314", born:date('1954-10-03'), name:"Al Sharpton", bio:"Alfred Charles Sharpton Jr.  (born October 3, 1954) is an American civil rights activist, Baptist minister, television/radio talk show host and a former White House adviser for President Barack Obama.  In 2004, he was a candidate for the Democratic nomination for the U. S.  presidential election.  He hosts his own radio talk show, Keepin' It Real, and he makes regular guest appearances cable news television.  In 2011, he was named the host of MSNBC's PoliticsNation, a nightly talk show...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iRLQcSrqwiPk46cgrM7Nher18Ue.jpg", url:"https://themoviedb.org/person/181934"}}, {tmdbId:"4324", properties:{bornIn:"San Francisco, California, USA", imdbId:"0358007", born:date('1964-03-02'), name:"Laird Hamilton", bio:"From Wikipedia, the free encyclopedia. \n\nLaird Hamilton (born 1964) is an American big-wave surfer, co-inventor of tow-in surfing, and an occasional fashion and action-sports model.  He is married to Gabrielle Reece, a professional volleyball player, television personality, and model.  Hamilton and his family split their time between residences in Maui, Hawaii, and Malibu, California...", url:"https://themoviedb.org/person/4324"}}, {tmdbId:"4325", properties:{imdbId:"1307480", name:"Dave Kalama", bio:"From Wikipedia, the free encyclopedia. \n\nDave Kalama is a big wave surfer, windsurfer, and celebrity watersports enthusiast.  Kalama and his family live in Hawaii. \n\nKalama is credited with the co-development of tow-in surfing, along with Laird Hamilton, Darrick Doerner, and Buzzy Kerbox...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bSUPKSHyoXjLivb5MW1qd4fOvTz.jpg", url:"https://themoviedb.org/person/4325"}}, {tmdbId:"74615", properties:{bornIn:"Baltimore, Maryland, USA", imdbId:"0662519", born:date('1970-10-07'), name:"Nicole Ari Parker", bio:"Nicole Ari Parker Kodjoe (born October 7, 1970 in Baltimore, Maryland, height 5' 8\" (1,73 m)).  She graduated from New YorkUniversity’s TischSchool of the Arts in 1993. \n\nEarly in her career she appeared in several critically-acclaimed independent films including The Incredibly True Adventure of Two Girls in Love (1995), Boogie Nights (1997), 200 Cigarettes (1999), and the 1999 Sundance Film Festival winner The Adventures of Sebastian Cole...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uy630vFQOKWpuEDFF2DuCQ1Oiez.jpg", url:"https://themoviedb.org/person/74615"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"5874", properties:{imdbId:"0652162", born:date('1947-03-07'), name:"Jaime Osorio Gómez", died:date('2006-09-03'), url:"https://themoviedb.org/person/5874"}}, {tmdbId:"1299287", properties:{bornIn:"Seoul, South Korea", imdbId:"1918588", born:date('1980-07-20'), name:"Jin Goo", bio:"Jin Goo (born July 20, 1980) is a South Korean actor.  He won Best Supporting Actor at the Grand Bell Awards and Blue Dragon Film Awards for his role in Bong Joon-ho's 2009 noir thriller Mother.  He is also best known for his role in the critically and commercially successful series Descendants of the Sun...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pdM4uuZ1o9rWTMNuDLyumSD0cDI.jpg", url:"https://themoviedb.org/person/1299287"}}, {tmdbId:"1702766", properties:{name:"Michael Anderson", url:"https://themoviedb.org/person/1702766"}}, {tmdbId:"68557", properties:{bornIn:"Taipai, Taiwan", imdbId:"0939153", born:date('1967-01-31'), name:"Joey Wong", bio:"Joey Wong Cho-Yin (AKA Joey Wang, Wang Tsu Hsien, or Joey Ong Jyo Han/Hen) (Chinese: 王祖賢; pinyin: Wáng Zǔxián, born January 31, 1967) is a Hong Kong based Taiwanese-born actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/czi7jy9VnrEmrJTE9oVUJRgDsY.jpg", url:"https://themoviedb.org/person/68557"}}, {tmdbId:"134704", properties:{bornIn:"Tianjin, China", imdbId:"0943138", born:date('1942-09-22'), name:"Wu Ma", bio:"From Wikipedia, the free encyclopedia. \n\nWu Ma (Chinese: 午馬, 22 September 1942 – 4 February 2014) is a Chinese actor, director, producer and writer.  Wu Ma made his screen debut in 1963, and with over 180 appearances to his name (plus 38 directorial credits within a twenty-five year period), Wu Ma is one of the most familiar faces in the history of Hong Kong Cinema.  He is best known as the Taoist ghosthunter in A Chinese Ghost Story...", died:date('2014-02-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pz9PSCdxoDFsHC2K6Tq74Vf83Im.jpg", url:"https://themoviedb.org/person/134704"}}, {tmdbId:"56804", properties:{bornIn:"Hongkong, China", imdbId:"0490618", born:date('1931-10-13'), name:"Lau Siu-Ming", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/984HjUtvKQYgVfRf3gPC7E25vZE.jpg", url:"https://themoviedb.org/person/56804"}}, {tmdbId:"1404403", properties:{imdbId:"0053443", name:"Nigel Barber", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x28iFuA9LUBMxpWatTdUFPEXSIC.jpg", url:"https://themoviedb.org/person/1404403"}}, {tmdbId:"1483293", properties:{imdbId:"1551040", name:"Mickey O'Hagen", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ctpb7yR2wPb37mfrwAFGmYR6JtN.jpg", url:"https://themoviedb.org/person/1483293"}}, {tmdbId:"31534", properties:{bornIn:"New Haven - Connecticut - USA", imdbId:"0316078", born:date('1961-10-03'), name:"Marcus Giamatti", bio:"From Wikipedia, the free encyclopedia\n\nMarcus Giamatti (born October 3, 1961 in New Haven, Connecticut) is an American actor, best known for being a regular member of the cast of the CBS drama series Judging Amy...", url:"https://themoviedb.org/person/31534"}}, {tmdbId:"403987", properties:{name:"Arrin Skelley", url:"https://themoviedb.org/person/403987"}}, {tmdbId:"82809", properties:{bornIn:"Oxford, Oxfordshire, England, UK", imdbId:"1834115", born:date('1984-09-05'), name:"Annabelle Wallis", bio:"Annabelle Frances Wallis (born 5 September 1984) is an English actress best known for her roles as Jane Seymour in Showtime's period drama The Tudors, Bridget Pierce in ABC's drama Pan Am, Mia Form in the 2014 supernatural horror film Annabelle, Grace Burgess in the BBC drama Peaky Blinders, and Jenny Halsey in the 2017 action film The Mummy. \n\nDescription above from the Wikipedia article Annabelle Wallis, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/JNxO1Dl1ofiAa95EygRHi479TL.jpg", url:"https://themoviedb.org/person/82809"}}, {tmdbId:"76913", properties:{bornIn:"Beijing, China", imdbId:"0311212"