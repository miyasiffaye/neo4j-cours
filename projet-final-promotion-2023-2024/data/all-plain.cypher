UNWIND [{tmdbId:"67811", properties:{imdbId:"0439557", born:date('1948-11-19'), name:"Hanna María Karlsdóttir", bio:"Hanna María Karlsdóttir is an actress...", url:"https://themoviedb.org/person/67811"}}, {tmdbId:"67812", properties:{imdbId:"0897518", name:"Þrúður Vilhjálmsdóttir", url:"https://themoviedb.org/person/67812"}}, {tmdbId:"10862", properties:{bornIn:"Wallasey, Merseyside, England, UK", imdbId:"0700712", born:date('1970-02-17'), name:"Dominic Purcell", bio:"From Wikipedia, the free encyclopedia. \n\nDominic Haakon Myrtvedt Purcell (born 17 February 1970) is a British-born Australian actor best known for his role as Lincoln Burrows in Prison Break, the title character in John Doe, and Dracula in Blade: Trinity...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/30giDZ53c8f72pPbXCLK9xMSAnw.jpg", url:"https://themoviedb.org/person/10862"}}, {tmdbId:"43454", properties:{bornIn:"Köln, Germany", imdbId:"0434968", born:date('1972-06-19'), name:"Christian Kahrmann", url:"https://themoviedb.org/person/43454"}}, {tmdbId:"56778", properties:{bornIn:"Howth, County Dublin, Ireland", imdbId:"0870204", born:date('1972-12-15'), name:"Stuart Townsend", bio:"Stuart Townsend (born on 15 December 1972) is an Irish actor and director.  His most notable portrayals are of the characters Lestat de Lioncourt in the 2002 film adaptation of Anne Rice's Queen of the Damned, and Dorian Gray in the 2003 film adaptation of Alan Moore's The League of Extraordinary Gentlemen. \n\nDescription above from the Wikipedia article Stuart Townsend, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8jc2nlrAkinMjyVPvYxa9goL5QZ.jpg", url:"https://themoviedb.org/person/56778"}}, {tmdbId:"22223", properties:{bornIn:"Hemet, California, USA", imdbId:"0603413", born:date('1977-04-25'), name:"Marguerite Moreau", bio:"From Wikipedia, the free encyclopedia. \n\nMarguerite Moreau (born April 25, 1977) is an American actress.  She is perhaps best known for her roles on the television series Blossom, her role as Katie in the comedy cult film Wet Hot American Summer, and her role in The Mighty Ducks series of films.  She has also made appearances on the popular television series Smallville, Lost, Cupid and The O. C...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e0joYMTL9HzL2fnGKCrZJvcRZCp.jpg", url:"https://themoviedb.org/person/22223"}}, {tmdbId:"65797", properties:{bornIn:"Baton Rouge - Louisiana - USA", imdbId:"0219748", born:date('1965-04-14'), name:"Catherine Dent", bio:"Catherine Dent (born April 14, 1965) is an American actress who has starred in film and in television.  Her first feature film was the 1994 movie Nobody's Fool.  Dent was born in Baton Rouge, Louisiana, the daughter of Eleanor Brown and Fred C.  Dent, a politician.  She attended the North Carolina School of the Arts and graduated in 1993. \n\nHer big breakthrough role came in 2002 as L. A. P. D.  Officer Danielle \"Danny\" Sofer on the FX hit drama The Shield...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vMcwYNhd1c2w1tIzRHHoulCo6Il.jpg", url:"https://themoviedb.org/person/65797"}}, {tmdbId:"65798", properties:{imdbId:"1041090", name:"Brandon James Olson", url:"https://themoviedb.org/person/65798"}}, {tmdbId:"46593", properties:{bornIn:"Topanga Canyon, California, USA", imdbId:"0386472", born:date('1985-03-13'), name:"Emile Hirsch", bio:"Emile Davenport Hirsch (born March 13, 1985) is an American television and film actor.  He began performing in the late 1990s, appearing in several television films and series, and became known as a film actor after roles in Lords of Dogtown, The Emperor's Club, The Girl Next Door, Alpha Dog, and Into the Wild.  In 2008, Hirsch starred in Speed Racer and Milk...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Ah8BYOB7P8tX9jnQVrnAbL2kxYJ.jpg", url:"https://themoviedb.org/person/46593"}}, {tmdbId:"68180", properties:{bornIn:"Amory, Mississippi, USA", imdbId:"0344196", born:date('1949-11-14'), name:"Gary Grubbs", url:"https://themoviedb.org/person/68180"}}, {tmdbId:"67817", properties:{imdbId:"0689627", name:"Alexander Pollock", bio:"​From Wikipedia, the free encyclopedia. \n\nAlexander Pollock is a Canadian film and TV actor. \n\nOne of his most significant roles was that of the character Scotty Brody in the feature film Cats &amp; Dogs (2001).  Other notable appearances include The Santa Clause 2, the 2002 TV series Taken, and the 2005 film School of Life...", url:"https://themoviedb.org/person/67817"}}, {tmdbId:"81449", properties:{imdbId:"0248469", born:date('1974-12-11'), name:"Damien Wayne Echols", url:"https://themoviedb.org/person/81449"}}, {tmdbId:"81455", properties:{imdbId:"0125832", name:"Melissa Byers", url:"https://themoviedb.org/person/81455"}}, {tmdbId:"2956", properties:{bornIn:"New York City, New York, USA", imdbId:"0001605", born:date('1972-01-11'), name:"Amanda Peet", bio:"Amanda Peet (born January 11, 1972, height 5' 6½\" (1,69 m)) is an American actress who has appeared in film, stage and television.  After studying with Uta Hagen at Columbia University, Peet began her career in television commercials, and progressed to small roles on television, before making her film debut in 1995.  Featured roles in films such as the 2000 comedy film The Whole Nine Yards brought her wider recognition...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5TfyCj0X9ftKO11FN057P05s78C.jpg", url:"https://themoviedb.org/person/2956"}}, {tmdbId:"61604", properties:{imdbId:"0050165", name:"Penny Balfour", bio:"From Wikipedia, the free encyclopedia. \n\nPenny Balfour is a film and television actress. \n\nDescription above from the Wikipedia article Penny Balfour, licensed under CC-BY-SA, full list of contributors on Wikipedia ...", url:"https://themoviedb.org/person/61604"}}, {tmdbId:"83722", properties:{imdbId:"0132732", name:"Michael Leydon Campbell", url:"https://themoviedb.org/person/83722"}}, {tmdbId:"2073129", properties:{name:"Buddhi Wickrama", url:"https://themoviedb.org/person/2073129"}}, {tmdbId:"1402266", properties:{bornIn:"Ruwanwella Divisional Secretariat - Sri Lanka", imdbId:"0784854", born:date('1927-06-21'), name:"Iranganie Serasinghe", bio:"Kala Keerthi Iranganie Roxanna Serasinghe is a Sri Lankan actress.  Since her debut in Rekava, Serasinghe has become recognized for playing motherly figures in various films and television serials...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kPNQEANlrsE81O64hnK0HZaYkVG.jpg", url:"https://themoviedb.org/person/1402266"}}, {tmdbId:"1244701", properties:{name:"Rabbe Smedlund", url:"https://themoviedb.org/person/1244701"}}, {tmdbId:"223076", properties:{bornIn:"Tampere, Finland", imdbId:"0468295", born:date('1954-01-02'), name:"Jyrki Kovaleff", died:date('2009-11-03'), url:"https://themoviedb.org/person/223076"}}] AS row
