UNWIND [{tmdbId:"1347739", properties:{imdbId:"4776745", name:"Edison Cájas", url:"https://themoviedb.org/person/1347739"}}, {tmdbId:"967767", properties:{imdbId:"0823133", name:"Austin Stark", url:"https://themoviedb.org/person/967767"}}, {tmdbId:"966400", properties:{imdbId:"2085654", name:"Adam Alleca", url:"https://themoviedb.org/person/966400"}}, {tmdbId:"1422673", properties:{imdbId:"3950520", name:"Jason Lei Howden", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1AQgzuhn2Lcolb8Hpupv7a2ix5q.jpg", url:"https://themoviedb.org/person/1422673"}}, {tmdbId:"1167896", properties:{bornIn:"New York, New York, U.S.A.", imdbId:"0072600", born:date('1977-04-03'), name:"Ned Benson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hXrwsqDs216BGskPQATOj0wEN7y.jpg", url:"https://themoviedb.org/person/1167896"}}, {tmdbId:"1283526", properties:{imdbId:"1793586", name:" Robert Olsen", url:"https://themoviedb.org/person/1283526"}}, {tmdbId:"42804", properties:{bornIn:"Mumbai, Maharashtra, India", imdbId:"0080220", born:date('1963-02-24'), name:"Sanjay Leela Bhansali", bio:"Sanjay Leela Bhansali is an Indian film director, producer, screenwriter, and music director.  One of the most critically acclaimed filmmakers in Indian cinema, Bhansali is the recipient of several awards, including four National Film Awards and ten Filmfare Awards.  In 2015, the Government of India honoured him with the Padma Shri, the fourth highest civilian award. \n\nHe made his directorial debut with Khamoshi: The Musical (1996) for which he received Filmfare Critics Award for Best Film...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/535kLIsPdfW0exe5bfrIAvCNPHJ.jpg", url:"https://themoviedb.org/person/42804"}}, {tmdbId:"77723", properties:{bornIn:"Kilmore, Victoria, Australia", imdbId:"1110111", born:date('1967-01-01'), name:"Tony McNamara", bio:"Tony McNamara is an Australian stage, film and television writer and director.  He holds a BA in Film and Television Writing from the Australian Film, Television and Radio School, Sydney, Australia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/apmwAh1QajlmDOqwJNYsl5ErEjl.jpg", url:"https://themoviedb.org/person/77723"}}, {tmdbId:"20204", properties:{imdbId:"0888743", name:"James Vanderbilt", url:"https://themoviedb.org/person/20204"}}, {tmdbId:"78751", properties:{bornIn:"Kolhapur, Maharashtra, India", imdbId:"0332950", born:date('1964-02-15'), name:"Ashutosh Gowariker", bio:"Ashutosh Gowariker  (born 15 February 1964) is an Indian film director, actor, writer and producer.  He is known for directing the films Lagaan (2001), Swades (2004), Jodhaa Akbar (2008), What's Your Raashee (2009) and Khelein Hum Jee Jaan Sey (2010).  He was nominated for an Academy Award and European Film Award, and has won a number of other awards, including a National Film Award, five Filmfare Awards, and seven international film festival awards...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8gsOvAezza1nVV8vSTj8Yovdi9K.jpg", url:"https://themoviedb.org/person/78751"}}, {tmdbId:"104025", properties:{bornIn:"New York City, New York, USA", imdbId:"1270033", born:date('1969-03-23'), name:"David M. Rosenthal", bio:"David Mitchell Rosenthal (born March 23, 1969) American writer, director and producer.  He is best known for the films Falling Up and See This Movie, as well as writing and directing the forthcoming Janie Jones. \n\nDescription above from the Wikipedia article David M.  Rosenthal (director), licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/104025"}}, {tmdbId:"1074445", properties:{name:"Peter W. Kunhardt", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1HpLCuEZPhuLGZ5A3XAwtBTzycl.jpg", url:"https://themoviedb.org/person/1074445"}}, {tmdbId:"1418960", properties:{name:"Kristina Goolsby", url:"https://themoviedb.org/person/1418960"}}, {tmdbId:"1418963", properties:{name:" Ashley York", url:"https://themoviedb.org/person/1418963"}}, {tmdbId:"220691", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0688636", born:date('1964-02-02'), name:"Laura Poitras", bio:"Laura Poitras is an Academy Award-winning American documentary film director and producer residing in Berlin.   Poitras has received numerous awards for her work, including the 2014 Academy Award for Best Documentary Feature for Citizenfour, about Edward Snowden.  while My Country, My Country received a nomination in the same category in 2007.  She won the 2013 George Polk Award for \"national security reporting\" related to the NSA disclosures...", url:"https://themoviedb.org/person/220691"}}, {tmdbId:"989456", properties:{imdbId:"2041022", name:"Andreas Dalsgaard", url:"https://themoviedb.org/person/989456"}}, {tmdbId:"1955326", properties:{name:" Viviana Gómez Echeverry", url:"https://themoviedb.org/person/1955326"}}, {tmdbId:"52413", properties:{imdbId:"1475479", name:"James C. Strouse", bio:"James C.  Strouse is an American screenwriter and film director.  He wrote the film Lonesome Jim (2005), directed by Steve Buscemi.  He wrote and made his directorial debut with Grace Is Gone (2007) starring John Cusack.  Strouse won an Audience Award for most popular dramatic feature and the Waldo Salt Screenwriting Award at the 2007 Sundance Film Festival for the film.  He next wrote and directed the film The Winning Season, starring Sam Rockwell and Emma Roberts...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9cfqSrUrMe4I5mNU3XbkLfxe9hX.jpg", url:"https://themoviedb.org/person/52413"}}, {tmdbId:"136153", properties:{bornIn:"Ft. Collins, Colorado, USA", imdbId:"1534595", born:date('1983-03-15'), name:"Peter Atencio", url:"https://themoviedb.org/person/136153"}}, {tmdbId:"1452406", properties:{bornIn:"Istanbul, Turkey", imdbId:"4342198", born:date('1985-09-12'), name:"Burak Aksak", bio:"Burak Aksak (born September 12, 1985 in Istanbul, Turkey) is a Turkish screenwriter, director and actor.  He is best known for writing Leyla ile Mecnun...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wmiFhEqAgWRxwqU8Yrp86kO9zHg.jpg", url:"https://themoviedb.org/person/1452406"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"1479447", properties:{imdbId:"1141362", name:"Josh Forbes", url:"https://themoviedb.org/person/1479447"}}, {tmdbId:"80752", properties:{bornIn:"Tokyo Prefecture, Japan", imdbId:"0383688", born:date('1965-09-22'), name:" Shinji Higuchi", bio:"Shinji Higuchi is a movie director, storyboard artist and SFX specialist.  He is one of the top special effects wizards in Japan, often working in animation.  Higuchi is one of the original founders of Gainax, along with Hideaki Anno, Yoshiyuki Sadamoto and Takami Akai.  Higuchi gain recognition for his special effects work in Shusuke Kaneko's Gamera trilogy and is a frequent collaborator with Hideaki Anno on both anime and tokusatsu projects...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9Z9iuUGTVL331Uf6zIxgtXhQR7p.jpg", url:"https://themoviedb.org/person/80752"}}, {tmdbId:"138781", properties:{bornIn:"Lee, New Hampshire, USA", imdbId:"3211470", born:date('1983-07-07'), name:"Robert Eggers", bio:"Robert Eggers (born August 3, 1983 in Lee, New Hampshire) is an American film director and writer, best known for his directorial debut, the horror film The Witch (2015), and The Lighthouse (2019).  Eggers began his career as a designer and director of theatre productions in New York before transitioning to working in film...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v9ukVIUGT1vQ3KuPVLSua7FfS9s.jpg", url:"https://themoviedb.org/person/138781"}}, {tmdbId:"1643796", properties:{name:"Steffi Kammerer", url:"https://themoviedb.org/person/1643796"}}, {tmdbId:"110876", properties:{imdbId:"2079484", name:"Rachel Goldenberg", bio:"Rachel Lee Goldenberg is an American film director who lives in Los Angeles and is from Massachusetts.  She has directed a number of feature films and television episodes.  Her 80s musical Valley Girl was released in May 2020.  Her next film, Unpregnant, is coming fall of 2020...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mlje0mJnxkNBdLtk8INVHg6QBTM.jpg", url:"https://themoviedb.org/person/110876"}}, {tmdbId:"1603696", properties:{name:"Tinu Suresh Desai", url:"https://themoviedb.org/person/1603696"}}, {tmdbId:"1318704", properties:{bornIn:"Tashkent - USSR", imdbId:"0002399", born:date('1959-05-17'), name:"Alik Sakharov", bio:"Alik Sakharov was born on May 17, 1959.  He is a cinematographer and director...", url:"https://themoviedb.org/person/1318704"}}, {tmdbId:"1313223", properties:{imdbId:"1930956", name:" Robert Cannan", url:"https://themoviedb.org/person/1313223"}}, {tmdbId:"8027", properties:{imdbId:"0193484", name:"Ricardo Curtis", url:"https://themoviedb.org/person/8027"}}, {tmdbId:"17016", properties:{bornIn:"Sligo, Ireland", imdbId:"0001403", born:date('1950-02-25'), name:"Neil Jordan", bio:"​From Wikipedia, the free encyclopedia\n\nNeil Patrick Jordan (born 25 February 1950) is an Irish filmmaker and novelist.  He won an Academy Award (Best Original Screenplay) for The Crying Game. \n\nDescription above from the Wikipedia article Neil Jordan, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uZ7CvCLTKb9qxjU4VsTNeyMRucd.jpg", url:"https://themoviedb.org/person/17016"}}, {tmdbId:"1023127", properties:{imdbId:"0456509", name:"Lee Kirk", url:"https://themoviedb.org/person/1023127"}}, {tmdbId:"61949", properties:{imdbId:"1074107", name:"Robert Walker", url:"https://themoviedb.org/person/61949"}}, {tmdbId:"62043", properties:{imdbId:"0331998", born:date('1945-04-12'), name:"Michael Gottlieb", died:date('2014-05-23'), url:"https://themoviedb.org/person/62043"}}, {tmdbId:"18281", properties:{bornIn:"New York City, New York, USA", imdbId:"0677953", born:date('1954-04-02'), name:"Donald Petrie", bio:"From Wikipedia, the free encyclopedia.   Donald Mark Petrie (born April 2, 1954)  is an American film director. \n\nPetrie was born in New York City, New York, the son of Dorothea (née Grundy), a television producer, actor, and novelist, and Daniel Petrie, a director.   Petrie has acted and guest-starred on television programs.  His first directorial job was on the set of The Equalizer, a private detective TV series, in 1985...", url:"https://themoviedb.org/person/18281"}}, {tmdbId:"24949", properties:{bornIn:"Rockville, Maryland, USA", imdbId:"0205157", born:date('1961-08-01'), name:"Michael Davis", bio:"Michael Davis (born 1 August 1961) is an American film director and screenwriter born in Rockville, Maryland. \n\nHis films include the campy horror film Monster Man and the big-budget action film Shoot 'Em Up starring Clive Owen, Paul Giamatti, and Monica Bellucci...", url:"https://themoviedb.org/person/24949"}}, {tmdbId:"19271", properties:{bornIn:"Cleveland, Ohio, USA", imdbId:"0751577", born:date('1970-02-03'), name:"Anthony Russo", bio:"Anthony and Joe Russo, known together professionally as the Russo brothers, are Emmy Award-winning American film and television directors.  The brothers direct most of their work jointly, and they also occasionally work as producers, actors, and editors.  The Russos are from Cleveland, Ohio, and were born a year apart.  They are alumni of Case Western Reserve University...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fIa5wXK7MHAquhefTr3TcnZiYy8.jpg", url:"https://themoviedb.org/person/19271"}}, {tmdbId:"35453", properties:{bornIn:"France", imdbId:"0603628", born:date('1964-05-12'), name:"Pierre Morel", bio:"From Wikipedia, the free encyclopedia.    Pierre Morel (born 12 May 1964) is a French cinematographer and film director. \n\nDescription above from the Wikipedia article Pierre Morel, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/35453"}}, {tmdbId:"12786", properties:{bornIn:"Letchworth, Hertfordshire, England, UK", imdbId:"0922346", born:date('1961-07-17'), name:"Simon West", bio:"Simon West (born 1961) is an English-born film director.  West started as a film editor with the BBC, then directed documentaries and commercials including many for Budweiser.  His film directing career started when he directed Con Air in 1997...", url:"https://themoviedb.org/person/12786"}}, {tmdbId:"2294", properties:{bornIn:"San Antonio, Texas, USA", imdbId:"0001675", born:date('1968-06-20'), name:"Robert Rodriguez", bio:"Robert Anthony Rodríguez (born June 20, 1968) is an American film director, screenwriter, producer, cinematographer, editor and musician.  He shoots and produces many of his films in his native Texas and Mexico.  He has directed such films as Desperado (1995), From Dusk till Dawn (1996), The Faculty (1998), Spy Kids (2001), Sin City (2005), Planet Terror (2007), and Machete (2010).  He also produced the latest installment in the Predator series, Predators (2010)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bPqRdLWWwpOT8sBdj9PWOzNgwou.jpg", url:"https://themoviedb.org/person/2294"}}, {tmdbId:"62721", properties:{bornIn:"Southend, Essex, England, UK", imdbId:"1497918", born:date('1952-08-10'), name:"Andrew Douglas", bio:"British director Andrew Douglas began his career in Lord Snowdon's photographic studio.  \n\nHe was a magazine photographer for Esquire and The Face and then a director of music videos and commercials.  His 2003 documentary, Searching for the Wrong-Eyed Jesus, won a Royal Television Society award.  \n\nHe made his movie debut with The Amityville Horror (2005), the terrifying remake of the 1970s horror classic...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v20rSTsJuRdQIM10ckHNO8ULsex.jpg", url:"https://themoviedb.org/person/62721"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"7270", properties:{bornIn:"Peterborough, Cambridgeshire, England, UK", imdbId:"0001490", born:date('1941-03-04'), name:"Adrian Lyne", bio:"Adrian Lyne (born in Peterborough, England and raised in London) is an English filmmaker and producer.  He is best known for directing films that focus on sexually charged characters and often uses natural light, a fog machine and other effects to create eroticized atmospheres.  He was educated at Highgate School. \n\nHe began working in film after a number of television commercials...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gFhz9sb3mQZGyVDXA1BF5IdmK4g.jpg", url:"https://themoviedb.org/person/7270"}}, {tmdbId:"26713", properties:{bornIn:"Park Ridge, Illinois, U.S.", imdbId:"0751080", born:date('1958-05-09'), name:"Chuck Russell", bio:"​From Wikipedia, the free encyclopedia.   \n\nCharles \"Chuck\" Russell (born August 6, 1952) is an American film director, film producer and actor. \n\nDescription above from the Wikipedia article Chuck Russell, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/26713"}}, {tmdbId:"62942", properties:{imdbId:"0640193", name:"Andrew O'Connor", url:"https://themoviedb.org/person/62942"}}, {tmdbId:"56828", properties:{bornIn:"Sioux Falls, South Dakota, USA", imdbId:"0128883", born:date('1943-10-29'), name:"Christopher Cain", bio:"Christopher Cain (born Bruce Doggett) is an American screenwriter, actor, director, and singer.  He married Sharon Thomas in 1969 and adopted her two children, Dean Cain and Roger Cain.  The couple later had Krisinda Cain together...", url:"https://themoviedb.org/person/56828"}}, {tmdbId:"55075", properties:{bornIn:"Arlington, Virginia, USA", imdbId:"0905592", born:date('1976-03-02'), name:"Jeff Wadlow", bio:"Jeffrey Clark Wadlow (born March 2, 1976) is an American film director, screenwriter, and producer, better known for his work in action and horror films.  His most notable films include Cry Wolf (2005), Never Back Down (2008), Kick-Ass 2 (2013), Truth or Dare (2018) and Fantasy Island (2020), most of which have been critically panned...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8MquRXIWZ7t4YeOMvl68AX5Fb4b.jpg", url:"https://themoviedb.org/person/55075"}}, {tmdbId:"63477", properties:{bornIn:"Vancouver, British Columbia", imdbId:"0514662", born:date('1971-03-28'), name:"Ryan Little", bio:"Ryan Little is an American movie director, cinematographer and producer.  He was born in Vancouver, British Columbia, Canada, and attended Brigham Young University in Provo, Utah.  He is a member of The Church of Jesus Christ of Latter-day Saints...", url:"https://themoviedb.org/person/63477"}}, {tmdbId:"57314", properties:{bornIn:"Munich, Germany", imdbId:"0718627", born:date('1909-06-26'), name:"Wolfgang Reitherman", bio:"Reitherman began working for Disney in 1934, along with future Disney legends Ward Kimball and Milt Kahl.  The three worked together on a number of classic Disney shorts, including The Band Concert, Music Land, and Elmer Elephant and in all, Reitherman worked on various Disney feature films produced from 1937 to 1981, including Snow White and the Seven Dwarfs (Slave in the Magic Mirror) to The Fox and the Hound (co-producer)...", died:date('1985-05-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2voY3J7cOVXLEnRJhIbZUsNGmP4.jpg", url:"https://themoviedb.org/person/57314"}}, {tmdbId:"8876", properties:{bornIn:" Philadelphia, Pennsylvania, United States", imdbId:"0459170", born:date('1946-07-20'), name:"Randal Kleiser", bio:"John Randal Kleiser is an American film director and producer, perhaps best known for directing the 1978 musical film Grease...", url:"https://themoviedb.org/person/8876"}}, {tmdbId:"28889", properties:{bornIn:"Wassenaar, Zuid-Holland, Netherlands", imdbId:"0324660", born:date('1957-07-23'), name:"Theo van Gogh", died:date('2004-11-02'), url:"https://themoviedb.org/person/28889"}}, {tmdbId:"43513", properties:{imdbId:"0048491", name:"Graham Baker", bio:"​From Wikipedia, the free encyclopedia\n\nGraham Baker is an American film director.  He directed numerous films from 1981 to 1999. \n\nDescription above from the Wikipedia article Graham Baker, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/43513"}}, {tmdbId:"10943", properties:{bornIn:" Vienna, Austria", imdbId:"1349376", born:date('1970-03-26'), name:"Francis Lawrence", bio:"Francis Lawrence (born March 26, 1970) is an American music video director and film director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pyGWo5mAwZ2Koe6leB2RjKd7vmc.jpg", url:"https://themoviedb.org/person/10943"}}, {tmdbId:"63943", properties:{bornIn:"Pittsburgh, Pennsylvania, USA", imdbId:"0380705", name:"Rowdy Herrington", bio:"​From Wikipedia, the free encyclopedia.   \n\nRowdy L.  Herrington (born 1951 in Pittsburgh, Pennsylvania) is a Hollywood director and writer currently residing in Malibu, California.  He is married and has no children. \n\nDescription above from the Wikipedia article Rowdy Herrington, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/63943"}}, {tmdbId:"52629", properties:{bornIn:"Briarcliff, New York, USA", imdbId:"0747849", born:date('1950-05-10'), name:"Joseph Ruben", bio:"From Wikipedia, the free encyclopedia. \n\nJoseph Paul Ruben (born May 10, 1950 in Briarcliff Manor, New York) is an American film director, screenwriter, and producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ic4WkiH78PdkmxEE6i50DV8V49T.jpg", url:"https://themoviedb.org/person/52629"}}, {tmdbId:"39819", properties:{bornIn:"Hong Kong, China", imdbId:"0911061", born:date('1949-01-12'), name:"Wayne Wang", bio:"From Wikipedia, the free encyclopedia. \n\nWayne Wang (born January 12, 1949) is a Chinese American film director. \n\nDescription above from the Wikipedia article Wayne Wang, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wtw5Cg8dWy9N7Fvn9SWvboibWek.jpg", url:"https://themoviedb.org/person/39819"}}, {tmdbId:"46391", properties:{bornIn:"Newark, NJ, United States", imdbId:"0000808", born:date('1947-02-03'), name:"Paul Auster", bio:"From Wikipedia, the free encyclopedia\n\nPaul Benjamin Auster (born February 3, 1947) is an American author known for works blending absurdism, existentialism, crime fiction and the search for identity and personal meaning in works such as The New York Trilogy (1987), Moon Palace (1989), The Music of Chance (1990), The Book of Illusions (2002) and The Brooklyn Follies (2005). \n\nDescription above from the Wikipedia article Paul Auster, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/46391"}}, {tmdbId:"16410", properties:{bornIn:"Philadelphia, Pennsylvania", imdbId:"0060072", born:date('1935-09-16'), name:"Jules Bass", bio:"From Wikipedia, the free encyclopedia. \n\nJules Bass (born September 16, 1935 in Philadelphia, Pennsylvania) is an American director, producer, composer, and author. \n\nDescription above from the Wikipedia article Jules Bass, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6QU9zlGh3BA4DN4h4bNv5ZfLo6e.jpg", url:"https://themoviedb.org/person/16410"}}, {tmdbId:"58868", properties:{imdbId:"0003474", name:"Troy Miller", bio:"From Wikipedia, the free encyclopedia. \n\nTroy Miller is an American film producer, director and screenwriter.   Miller is best known for his work in directing...", url:"https://themoviedb.org/person/58868"}}, {tmdbId:"4037", properties:{bornIn:"Whittier, California, USA", imdbId:"0005421", born:date('1945-09-15'), name:"Ron Shelton", bio:"​From Wikipedia, the free encyclopedia\n\nRon Shelton (September 15, 1945 in Whittier, California) is a U. S.  film director and screenwriter, most notable for making movies about sports. \n\nShelton is an alumnus of Santa Barbara High School and of the University of Arizona and Westmont College.  He is the oldest of four brothers, and grew up in Montecito, California. \n\nBefore beginning his movie career, Shelton was a minor league baseball player in the Baltimore Orioles' organization from 1967 to 1971...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kOdDvXw6ToU474bPVujobioN5Cy.jpg", url:"https://themoviedb.org/person/4037"}}, {tmdbId:"2042", properties:{bornIn:"Jamaica", imdbId:"0394280", born:date('1958-01-01'), name:"Stephen Hopkins", bio:"Stephen Hopkins is a Jamaican-born film director and producer.  He is best-known for his continuation of the Nightmare on Elm Street franchise with A Nightmare on Elm Street 5: The Dream Child and the Predator franchise with Predator 2.  His highest grossing film however was the 1998 film adaption of the TV series Lost in Space.  He was born in Jamaica and was raised in Australia and England.  He was educated at Sutton Valence School...", url:"https://themoviedb.org/person/2042"}}, {tmdbId:"64045", properties:{bornIn:"Bristol, England, UK", imdbId:"0428600", born:date('1963-11-30'), name:"Kirk Jones", bio:"Kirk Jones (b.  Nov 31, 1964 in Bristol, England) is an English film director and screenwriter. \n\nKirk Jones grew up in Long Ashton, Bristol and attended Newport Film School from 1985–87, specializing in directing drama and television commercials.  He graduated in 1987 after winning a National Student Film award and started to work for a London based production company as a production runner and later as assistant film editor...", url:"https://themoviedb.org/person/64045"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"57090", properties:{bornIn:"Toledo, Ohio, USA", imdbId:"0502577", born:date('1959-05-14'), name:"Brett Leonard", bio:"From Wikipedia, the free encyclopedia\n\nBrett Leonard (born May 14, 1959 in Toledo, Ohio, U. S. A. ) is an American film director, producer and music video director specializing in the science-fiction and horror genres.  A few of his films such as The Lawnmower Man and Virtuosity (1995) feature groundbreaking computer animation and visual effects...", url:"https://themoviedb.org/person/57090"}}, {tmdbId:"56998", properties:{bornIn:"Cleveland - Ohio - USA", imdbId:"0514546", born:date('1956-01-13'), name:"Dwight H. Little", bio:"​From Wikipedia, the free encyclopedia.   \n\nDwight Hubbard Little (born January 13, 1956 in Cleveland, Ohio) is an American film director, known for directing the films Halloween 4: The Return of Michael Myers, The Phantom of the Opera, Marked for Death, Rapid Fire and Murder at 1600.  He has also directed episodes of various TV series including 24, Prison Break, Bones, Dollhouse and Castle...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ezXjUoBIeb1LrDTi4Pp3G8lhAok.jpg", url:"https://themoviedb.org/person/56998"}}, {tmdbId:"64073", properties:{imdbId:"0961404", name:"Mark Aldo Miceli", url:"https://themoviedb.org/person/64073"}}, {tmdbId:"64131", properties:{bornIn:"Memphis, Tennessee, USA", imdbId:"2581581", name:"Courtney Hunt", bio:"​From Wikipedia, the free encyclopedia\n\nCourtney Hunt (born 1964 in Memphis, Tennessee) is an American screenwriter and film director.  She has received much critical acclaim for her debut film, Frozen River, for which she has gained an Oscar nomination, two Independent Spirit nominations, and a Satellite Award nod for the film.  Frozen River won a Grand Jury Prize for Dramatic Filmmaking at the 2008 Sundance Film Festival, which Hunt accepted...", url:"https://themoviedb.org/person/64131"}}, {tmdbId:"49903", properties:{bornIn:"United States", imdbId:"0384722", name:"Tim Hill", bio:"​From Wikipedia, the free encyclopedia.   \n\nTim Hill is an American film director and television writer. \n\nHe began his career in 1993 as a writer and storyboard artist for Rocko's Modern Life, he also created the Kablam! skit Action League Now!.  He has been active as an episode writer for SpongeBob SquarePants since 1999...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jJ4UQBlQ71aJzU75ZxnO5gdTbnj.jpg", url:"https://themoviedb.org/person/49903"}}, {tmdbId:"52405", properties:{bornIn:"Honolulu, Hawaii, USA", imdbId:"0001355", born:date('1956-11-30'), name:"Michael Hoffman", bio:"Michael Lynn Hoffman is an American movie director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vi8H1gOWrpT1EtqPOnJ8QeEsSLU.jpg", url:"https://themoviedb.org/person/52405"}}, {tmdbId:"33433", properties:{bornIn:"Uganda", imdbId:"0382956", born:date('1953-03-04'), name:"Scott Hicks", bio:"From Wikipedia, the free encyclopedia. \n\nRobert Scott Hicks (born 4 March 1953) is a film director from Australia.  He is best known as the screenwriter and director of Shine, the Oscar-winning biopic of pianist David Helfgott.  Hicks's work has been nominated for an Academy Award as well as winning an Emmy Award...", url:"https://themoviedb.org/person/33433"}}, {tmdbId:"21053", properties:{bornIn:"Billings, Montana, USA", imdbId:"0001093", born:date('1956-01-01'), name:"John Dahl", bio:"​From Wikipedia, the free encyclopedia\n\nJohn Dahl (born 1956) is an American film director and screenwriter, best known for his work in the neo-noir genre...", url:"https://themoviedb.org/person/21053"}}, {tmdbId:"22012", properties:{imdbId:"0941671", name:"David Worth", url:"https://themoviedb.org/person/22012"}}, {tmdbId:"63550", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0572951", born:date('1950-07-19'), name:"Tom McLoughlin", bio:"An American screenwriter and film and television director whose credits include numerous television movies, such as Murder in Greenwich, the feature film Friday the 13th Part VI: Jason Lives and the 2009 Lifetime Movie Network film The Wronged Man.  In 1977 McLoughlin was nominated for the Emmy Award for Outstanding Writing for a Variety, Music or Comedy Program for his contributions to Van Dyke and Company, a special starring Dick Van Dyke...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p9H02MZsKos8I9RREyeMty89oGN.jpg", url:"https://themoviedb.org/person/63550"}}, {tmdbId:"65429", properties:{bornIn:"Tokyo, Japan", imdbId:"0951197", born:date('1952-10-15'), name:"Kunihiko Yuyama", bio:"From Wikipedia, the free encyclopedia. \n\nKunihiko Yuyama ( Yuyama Kunihiko , born October 15, 1952) is a Japanese director of anime films, television, and video series.  His best known work is Pokémon.  Other anime he has directed include Kimagure Orange Road: Summer's Beginning, Plawres Sanshiro, Wedding Peach, and the adult-oriented Weather Report Girl. \n\nDescription above from the Wikipedia article Kunihiko Yuyama, licensed under CC-BY-SA, full list of contributors on Wikipedia ...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ns3Swpbs7Z2uajmWZuzEeTXPyyO.jpg", url:"https://themoviedb.org/person/65429"}}, {tmdbId:"87742", properties:{bornIn:"Bloomington, Indiana, USA", imdbId:"1989536", born:date('1974-08-31'), name:"Marc Webb", bio:"Marc Preston Webb is an American music video, short film, and film director.  He made his feature film directorial debut with the 2009 romantic comedy-drama (500) Days of Summer and went on to direct the 2012 Spider-Man reboot The Amazing Spider-Man and its sequel The Amazing Spider-Man 2 in 2014...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bWN7EexCL0H52bOuyVWvxRUu1H5.jpg", url:"https://themoviedb.org/person/87742"}}, {tmdbId:"18392", properties:{bornIn:"Cranston, Rhode Island, USA", imdbId:"0000736", born:date('1918-08-09'), name:"Robert Aldrich", bio:"Robert Aldrich was an American film director, writer and producer, notable for such films as Kiss Me Deadly (1955), The Big Knife (1955), What Ever Happened to Baby Jane? (1962), The Dirty Dozen (1967). \n\nBorn in Cranston, Rhode Island, the son of Lora Lawson and newspaper publisher Edward Burgess Aldrich.  He was a grandson of U. S.  Senator Nelson W.  Aldrich and a cousin of Nelson Rockefeller.  He studied economics at the University of Virginia...", died:date('1983-12-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uUa8zcoQAvz7cFd0PPY3NL6y2cE.jpg", url:"https://themoviedb.org/person/18392"}}, {tmdbId:"4945", properties:{bornIn:"Fort Worth, Texas, USA", imdbId:"0002653", born:date('1950-05-13'), name:"Joe Johnston", bio:"Joseph Eggleston \"Joe\" Johnston II  is an American film director and former effects artist best known for such hit movies as Honey I Shrunk the Kids, Jumanji, The Rocketeer,  Jurassic Park III, Hidalgo, The Wolfman, October Sky,  and the upcoming Captain America: The First Avenger...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fbGZo6CG9Z9zKFh8D5wHunyu7gJ.jpg", url:"https://themoviedb.org/person/4945"}}, {tmdbId:"1032536", properties:{bornIn:"USA", imdbId:"0834902", name:"Robert Stromberg", url:"https://themoviedb.org/person/1032536"}}, {tmdbId:"64796", properties:{bornIn:"Poughkeepsie, New York, USA", imdbId:"0276169", born:date('1943-07-11'), name:"Tom Holland", bio:"Tom Holland (born July 11, 1943) is an American film director. \n\nDescription above from the Wikipedia article Tom Holland (director), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sc5RBZhFUUCDD3qnI3TDqL0F6cX.jpg", url:"https://themoviedb.org/person/64796"}}, {tmdbId:"64743", properties:{bornIn:"Westport, Connecticut, USA", imdbId:"0546057", born:date('1968-01-01'), name:"Adam Marcus", bio:"​From Wikipedia, the free encyclopedia\n\nAdam Marcus (born 1968) is an American film director, writer and actor. \n\nMarcus was born in Westport, Connecticut in the U. S. .  He is the brother of Young Artist Award-nominated actor Kipp Marcus.  Marcus attended NYU's Tisch School of the Arts. \n\nHe notably directed the 9th entry in the Friday the 13th series Jason Goes to Hell: The Final Friday...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kAln69Zz4iloQrqkEIAQz9XFUKm.jpg", url:"https://themoviedb.org/person/64743"}}, {tmdbId:"64754", properties:{bornIn:"Inghilterra, Regno Unito", imdbId:"0192933", born:date('1973-01-01'), name:"Andrew Currie", bio:"​From Wikipedia, the free encyclopedia\n\nAndrew Currie is a Canadian film director and screenwriter. \n\nBorn in England, Currie grew up in Victoria, British Columbia and studied arts before turning his interests towards film.  In 1997, Currie moved to Toronto, Ontario to study at Norman Jewison's Canadian Film Centre. \n\nDescription above from the Wikipedia article Andrew Currie, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/64754"}}, {tmdbId:"3110", properties:{bornIn:"Ashland, Kentucky, U.S", imdbId:"0025978", born:date('1954-11-16'), name:"Allison Anders", bio:"From Wikipedia, the free encyclopedia\n\nAllison Anders (born November 16, 1954) is an American film and television director.  Anders has directed many independent films, on which she frequently collaborates with fellow UCLA film school graduate Kurt Voss. \n\nDescription above from the Wikipedia article Allison Anders, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/3110"}}, {tmdbId:"41530", properties:{bornIn:"London, UK", imdbId:"0522393", born:date('1969-12-24'), name:"Nick Love", bio:"Nick Love is a British film director and writer.  Love came to public attention in the UK after making the films The Football Factory, The Business and The Firm.  He has two 'Millwall' tattoos, including one on the inside of his bottom lip...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5vIAfrhQPywnnbIOtKu6z5LBtzF.jpg", url:"https://themoviedb.org/person/41530"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"31511", properties:{bornIn:"Pittsburgh, Pennsylvania, USA", imdbId:"0381416", born:date('1963-05-15'), name:"Grant Heslov", bio:"From Wikipedia, the free encyclopedia  Grant Heslov (born May 15, 1963) is an American actor, film producer, screenwriter and director.  His acting credits include films like True Lies, Dante's Peak, Enemy of the State, The Scorpion King and Good Night, and Good Luck.  and several credits in TV series (Family Ties, L. A.  Law, Catch Me If You Can, the 1989 directorial debut by Stephen Sommers, Matlock, Sleeper Cell)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gBgab7aS13bRRESHa0Cpwy6115h.jpg", url:"https://themoviedb.org/person/31511"}}, {tmdbId:"64823", properties:{bornIn:"London, England", imdbId:"0204471", born:date('1926-05-24'), name:"Desmond Davis", bio:"Desmond Davis (born 24 May 1926) is a British film and television director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eR4RqmckRfeYsBOrCGAPhHvojoh.jpg", url:"https://themoviedb.org/person/64823"}}, {tmdbId:"664", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0550881", born:date('1946-09-13'), name:"Frank Marshall", bio:"​From Wikipedia, the free encyclopedia.     Frank Wilton Marshall (born September 13, 1946) is an American film producer and director, often working in collaboration with his wife, Kathleen Kennedy.  With Kennedy and Steven Spielberg, he was one of the founders of Amblin Entertainment...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lt2aBdnfDRJI4hvBu4733ZPGaCa.jpg", url:"https://themoviedb.org/person/664"}}, {tmdbId:"54050", properties:{bornIn:"Wyandotte, Michigan, USA", imdbId:"0914134", born:date('1964-06-30'), name:"Mark Waters", bio:"From Wikipedia, the free encyclopedia. \n\nMark Stephen Waters (born June 30, 1964) is an American film director and producer.  Waters is perhaps best known for directing Just Like Heaven, Freaky Friday, and Mean Girls, and producing 500 Days of Summer. \n\nHe is the brother of screenwriter Daniel Waters and has been married to actress Dina Spybey since 2000.  He is a graduate of the American Film Institute and as of September 2006 has a development deal with Paramount pictures...", url:"https://themoviedb.org/person/54050"}}, {tmdbId:"11429", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0527217", born:date('1903-10-16'), name:"Hamilton Luske", bio:"From Wikipedia, the free encyclopedia. \n\nHamilton Luske (October 16, 1903 - February 19, 1968) was an American film director.  He directed many Disney films and shorts from 1936 until his death in 1968.  He won an Academy Award in 1965. \n\nBorn in Chicago, Illinois on October 16, 1903 and died in Bel Air, California on February 19, 1968 at age 64. \n\nDescription above from the Wikipedia article Hamilton Luske, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1968-02-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6knSP5RbxIZ5IUxP78AckOZyD2D.jpg", url:"https://themoviedb.org/person/11429"}}, {tmdbId:"11434", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0414144", born:date('1906-06-24'), name:"Wilfred Jackson", bio:"“I was born in Chicago but moved before I could join Al Capone.  Did the next best thing by settling in Glendale.  Always had a yen for cartooning and after leaving Otis joined up with Mickey Mouse and have been making a living ever since...", died:date('1988-08-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cl0MxNFdcYSpHyr5Qh1ujnuMJJ1.jpg", url:"https://themoviedb.org/person/11434"}}, {tmdbId:"26458", properties:{bornIn:"New Bern, North Carolina", imdbId:"0932078", born:date('1965-03-14'), name:"Kevin Williamson", bio:"Kevin Meade Williamson (born March 14, 1965) is an American screenwriter, filmmaker, and actor, best known as the creator of the TV series Dawson's Creek (1998–2003), The Vampire Diaries (2009–present), The Following (2013–2015) and Stalker (2014–2015).  He is also widely known for developing and writing the screenplay for the slasher film Scream, as well as its sequels Scream 2 and Scream 4.  He also wrote the screenplay for the films I Know What You Did Last Summer, The Faculty, Teaching Mrs...", url:"https://themoviedb.org/person/26458"}}, {tmdbId:"20305", properties:{bornIn:"Redwood City, California, USA ", imdbId:"0730932", born:date('1968-05-27'), name:"Christopher Roberts", url:"https://themoviedb.org/person/20305"}}, {tmdbId:"8843", properties:{bornIn:"Aveley, Essex, England, UK", imdbId:"0413875", born:date('1943-10-04'), name:"Mick Jackson", bio:"Mick Jackson is a British television and film director, television producer and author.  He won an Emmy for Outstanding Directing for Temple Grandin (film)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pLQJApQAJKR3L6eYqLczxA4QjpY.jpg", url:"https://themoviedb.org/person/8843"}}, {tmdbId:"72757", properties:{bornIn:"London, England, UK", imdbId:"2588606", born:date('1969-10-09'), name:"Steve McQueen", bio:"Steve McQueen was born on October 9, 1969 in London, England as Steve Rodney McQueen.  He is a director and writer, known for 12 Years a Slave (2013), Shame (2011) and Hunger (2008)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/toU1yd6PFn88utmDpWTZ69h5Pkr.jpg", url:"https://themoviedb.org/person/72757"}}, {tmdbId:"20561", properties:{bornIn:"New York, U.S.A.", imdbId:"0336695", born:date('1969-04-14'), name:"James Gray", bio:"James Gray (born 1969) is an American film director and screenwriter...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6oRlizIlhI2exF3OEGvtB6M7KmZ.jpg", url:"https://themoviedb.org/person/20561"}}, {tmdbId:"71872", properties:{bornIn:"Little Rock, Arkansas, USA", imdbId:"2158772", born:date('1978-12-07'), name:"Jeff Nichols", bio:"Jeff Nichols was born on December 7, 1978 in Little Rock, Arkansas, USA.  He is a writer and director, known for Mud (2012), Take Shelter (2011) and Midnight Special (2016)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gwwM9wiHnLmqV1yvlWQaxZk3RRI.jpg", url:"https://themoviedb.org/person/71872"}}, {tmdbId:"21217", properties:{bornIn:"Bath, Somerset, England, UK [now Bath and North East Somerset, England, UK]", imdbId:"0528718", born:date('1943-04-03'), name:"Jonathan Lynn", bio:"From Wikipedia, the free encyclopedia. \n\nJonathan Lynn (born 3 April 1943, Bath, England) is an actor, comedy writer, and director.  He is best known for being the co-writer of Yes Minister. \n\nDescription above from the Wikipedia article Jonathan Lynn, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nk5XnrehDowm5Q5Wr8hsObiD6C1.jpg", url:"https://themoviedb.org/person/21217"}}, {tmdbId:"21879", properties:{bornIn:"Cambridge, England", imdbId:"0920425", born:date('1961-01-01'), name:"Simon Wells", bio:"​From Wikipedia, the free encyclopedia.   \n\nSimon Wells (born 1961 in Cambridge, England) is a British director and one of the employees who worked for Amblimation.  He is the great grandson of H.  G.  Wells. \n\nWells started his career at Richard Williams Animation, he worked as supervising animator for Robert Zemeckis's Who Framed Roger Rabbit.  He later contributed with Zemeckis on Back to the Future Part II, and Back to the Future Part III...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1p3DWHCJ8XzfvYRgxlhPnLDAeDy.jpg", url:"https://themoviedb.org/person/21879"}}, {tmdbId:"65317", properties:{bornIn:"Regno Unito", imdbId:"0779265", born:date('1965-01-01'), name:"Jake Scott", bio:"From Wikipedia, the free encyclopedia.   Jake Scott (born 1965) is a British film director who works primarily in the field of music videos.  Most of his works were produced under the Ridley Scott Associates banner or RSA's music video subdivision Black Dog Films.  He has made videos for Soundgarden, The Smashing Pumpkins, Bush, Live, Blind Melon, Tori Amos, Radiohead, Lily Allen, Oasis, The Supernaturals, The Strokes, The Verve, R. E. M. , U2, and George Michael...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ybdOncA1RDukjkuuPPHJZjvBf5a.jpg", url:"https://themoviedb.org/person/65317"}}, {tmdbId:"1723", properties:{bornIn:"Long Beach, California, USA", imdbId:"0001353", born:date('1942-01-10'), name:"Walter Hill", bio:"From Wikipedia, the free encyclopedia\n\nWalter Hill (born January 10, 1942) is an American film director, screenwriter, and producer.  Hill is known for male-dominated action films and revival of the Western...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eKJx8RBzMBQrtf98B9CxrikdOKN.jpg", url:"https://themoviedb.org/person/1723"}}, {tmdbId:"11057", properties:{bornIn:"San Pedro, Los Angeles, California, USA", imdbId:"0001801", born:date('1934-11-23'), name:"Robert Towne", bio:"Robert Towne (born Robert Bertram Schwartz; November 23, 1934) is an American screenwriter, producer, director and actor.  He was part of the New Hollywood wave of filmmaking.  He is best known for his Academy Award-winning original screenplay for Roman Polanski's Chinatown (1974), which is widely considered one of the greatest screenplays ever written...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pc1bpO4nljMqvz0P8A9nC6fZa1.jpg", url:"https://themoviedb.org/person/11057"}}, {tmdbId:"5696", properties:{bornIn:"Sydney, New South Wales, Australia", imdbId:"0000915", born:date('1940-08-16'), name:"Bruce Beresford", bio:"From Wikipedia, the free encyclopedia. \n\nBruce Beresford (born 16 August 1940) is an Australian film director who has made more than 30 feature films over a 40-year career. \n\nDescription above from the Wikipedia article Bruce Beresford, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/5696"}}, {tmdbId:"55439", properties:{bornIn:"Kingston, Ontario, Canada", imdbId:"0005390", born:date('1958-08-20'), name:"Patricia Rozema", bio:"From Wikipedia, the free encyclopedia\n\nPatricia Rozema (born 20 August 1958) is a Canadian film director and screenwriter. \n\nDescription above from the Wikipedia article Patricia Rozema, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/55439"}}, {tmdbId:"15127", properties:{bornIn:"Milan, Lombardy, Italy", imdbId:"0899581", born:date('1906-11-02'), name:"Luchino Visconti", bio:"Luchino Visconti di Modrone, Count of Lonate Pozzolo (2 November 1906 - 17 March 1976) was an Italian theatre, opera and cinema director, as well as a screenwriter.  He is best known for his films The Leopard (1963) and Death in Venice (1971)...", died:date('1976-03-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wC6D1mDI0KExdllqt6jrbK6Ihbm.jpg", url:"https://themoviedb.org/person/15127"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"56911", properties:{bornIn:"Albuquerque, New Mexico, USA", imdbId:"0562645", born:date('1959-11-30'), name:"Les Mayfield", bio:"From Wikipedia, the free encyclopedia. \n\nLes Mayfield is an American film director.  He has directed the films Encino Man, Miracle on 34th Street, Flubber, Blue Streak, American Outlaws, The Man and Code Name: The Cleaner...", url:"https://themoviedb.org/person/56911"}}, {tmdbId:"65026", properties:{bornIn:"Melbourne, Victoria, Australia", imdbId:"0942408", born:date('1959-01-31'), name:"Geoffrey Wright", bio:"From Wikipedia, the free encyclopedia.   Geoffrey Wright is an Australian film director, born in Melbourne in 1959. \n\nHe gained cult success with the 1992 film Romper Stomper, which starred Russell Crowe.  In 1994, he directed the gritty suburban thriller film Metal Skin, starring Ben Mendelsohn, and later directed the teen horror film Cherry Falls, starring Brittany Murphy.  In 2006, he adapted Shakespeare's Macbeth for film, starring Sam Worthington and Lachy Hulme...", url:"https://themoviedb.org/person/65026"}}, {tmdbId:"52038", properties:{bornIn:"Austin, Texas, USA", imdbId:"0141961", born:date('1953-07-17'), name:"Thomas Carter", bio:"Thomas Carter (born July 17, 1953) is an American film and television director known for Swing Kids, Save the Last Dance with Julia Stiles, and Coach Carter with Samuel L.  Jackson. \n\nAs an actor, Carter is probably best known for his work on the television series The White Shadow, playing James \"Hollywood\" Hayward, a high school basketball star with a high IQ for justice...", url:"https://themoviedb.org/person/52038"}}, {tmdbId:"2690", properties:{bornIn:"Sydney, New South Wales, Australia", imdbId:"0001837", born:date('1944-08-21'), name:"Peter Weir", bio:"Peter Lindsay Weir, AM is an Australian film director.  After playing a leading role in the Australian New Wave cinema with his films such as Picnic at Hanging Rock, The Last Wave and Gallipoli, Weir directed a diverse group of American and international films—many of them major box office hits—including the Academy Award nominees Witness, Dead Poets Society, Green Card, The Truman Show and Master and Commander...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4GxIZX5gtbMpW4ZgHwvGmLSIHOE.jpg", url:"https://themoviedb.org/person/2690"}}, {tmdbId:"56435", properties:{bornIn:"New Zealand", imdbId:"0443181", born:date('1963-01-01'), name:"Stephen T. Kay", bio:"Stephen T.  Kay is an American actor, director and writer of film and television. \n\nDescription above from the Wikipedia article Stephen T.  Kay, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/56435"}}, {tmdbId:"16853", properties:{bornIn:"USA", imdbId:"0625458", name:"Jessie Nelson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/u63xiwuHHpp0gcwMAOfSg9Jwr7G.jpg", url:"https://themoviedb.org/person/16853"}}, {tmdbId:"52112", properties:{imdbId:"0139867", name:"Steve Carr", bio:"Steve Carr is an American film director and producer of several movies, mostly of the comedy and family genre...", url:"https://themoviedb.org/person/52112"}}, {tmdbId:"58689", properties:{bornIn:"Detroit - Michigan - USA", imdbId:"0001438", born:date('1963-03-19'), name:"Neil LaBute", bio:"LaBute is of French Canadian, English and Irish ancestry, and was raised in Spokane, Washington.  He studied theater at Brigham Young University (BYU), where he joined The Church of Jesus Christ of Latter-day Saints.  At BYU he also met actor Aaron Eckhart, who would later play leading roles in several of his films.  He produced a number of plays that pushed the envelope of what was acceptable at the conservative religious university, some of which were shut down after their premieres...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vc1Cm2RcSdk8F2L427Fp2aQ0P3K.jpg", url:"https://themoviedb.org/person/58689"}}, {tmdbId:"66219", properties:{bornIn:"Pennsylvania, USA", imdbId:"0505662", born:date('1957-09-21'), name:"Mark Levin", bio:"From Wikipedia, the free encyclopedia. \n\nMark Reed Levin (born September 21, 1957) was appointed to the Reagan administration and is a lawyer, author and the host of American syndicated radio show The Mark Levin Show.  He is president of the Landmark Legal Foundation, has authored bestselling books and contributes commentary to various media outlets such as National Review Online where he is a currently credited author...", url:"https://themoviedb.org/person/66219"}}, {tmdbId:"65420", properties:{imdbId:"0007128", name:"Louis Morneau", url:"https://themoviedb.org/person/65420"}}, {tmdbId:"15156", properties:{imdbId:"0955434", born:date('1967-01-01'), name:"Zhang Yang", bio:"​From Wikipedia, the free encyclopedia\n\nZhang Yang (Chinese: 张杨, born 1967) is a Chinese film director, screenwriter, and occasional actor.  He is the son of Zhang Huaxun, who is also a Chinese film director.  Zhang grew up in Beijing, studied until 1988 at Sun Yat-sen University in Guangdong, from which he graduated with a degree in Chinese literature, and then went to the Central Academy of Drama, graduating in 1992...", url:"https://themoviedb.org/person/15156"}}, {tmdbId:"2036264", properties:{name:"Don Paul", url:"https://themoviedb.org/person/2036264"}}, {tmdbId:"65452", properties:{bornIn:"Salford, Greater Manchester, England, UK", imdbId:"0005139", born:date('1943-02-20'), name:"Mike Leigh", bio:"Michael \"Mike\" Leigh, OBE (born 20 February 1943) is a British writer and director of film and theatre.  He studied theatre at the Royal Academy of Dramatic Art, and studied further at the Camberwell School of Art and the Central School of Art and Design.  He began as a theatre director and playwright in the mid 1960s.  In the 1970s and 1980s his career moved between work for the theatre and making films for BBC Television, many of which were characterized by a gritty \"kitchen sink realism\" style...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eQAc3gIjhAFTgHVQ3kfpbkUe97M.jpg", url:"https://themoviedb.org/person/65452"}}, {tmdbId:"1744", properties:{bornIn:"Winchester, Indiana, USA", imdbId:"0936404", born:date('1914-09-10'), name:"Robert Wise", bio:"From Wikipedia, the free encyclopedia\n\nRobert Earl Wise (September 10, 1914 – September 14, 2005) was an American sound effects editor, film editor, film producer and director.  He won Academy Awards as Best Director for The Sound of Music (1965) and West Side Story (1961) as well as nominations as Best Film Editing for Citizen Kane (1941) and Best Picture for The Sand Pebbles (1966)...", died:date('2005-09-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pRnAp3MY6SiupwRHLHXjsW6FhuA.jpg", url:"https://themoviedb.org/person/1744"}}, {tmdbId:"65531", properties:{bornIn:"Levittown, Pennsylvania", imdbId:"0325196", born:date('1955-05-01'), name:"Eric Goldberg", bio:"American animator, film director and voice actor.  He is known for his work at both Walt Disney Animation Studios and Warner Bros.  Animation...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pqulcFpHW4dBLNUeflN5BY21yTA.jpg", url:"https://themoviedb.org/person/65531"}}, {tmdbId:"37710", properties:{bornIn:"New York City, New York, U.S.", imdbId:"0001382", born:date('1943-07-26'), name:"Peter Hyams", bio:"From Wikipedia, the free encyclopedia. \n\nPeter Hyams (born July 26, 1943) is an American screenwriter, director and cinematographer, probably best known for directing the 1984 science fiction adventure 2010 (the sequel to Stanley Kubrick's 2001: A Space Odyssey), Capricorn One, the comic book adaptation Timecop and the Arnold Schwarzenegger horror/action film End of Days. \n\nDescription above from the Wikipedia article Peter Hyams, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yRjdyOSjxVcymLoEl0ZHuNFTgVl.jpg", url:"https://themoviedb.org/person/37710"}}, {tmdbId:"65602", properties:{imdbId:"0691194", name:"Tim Pope", url:"https://themoviedb.org/person/65602"}}, {tmdbId:"65608", properties:{bornIn:"Jersey City, New Jersey, USA", imdbId:"0309382", name:"Leon Gast", bio:"​From Wikipedia, the free encyclopedia.   \n\nLeon Gast is an American documentary film director, producer, cinematographer, and editor.  His documentary When We Were Kings depicting the iconic heavyweight boxing match termed The Rumble in the Jungle between Muhammad Ali and George Foreman won the 1996 Academy Award for Documentary Feature and the Independent Spirit Award.  Gast co-directed the 1977 documentary The Grateful Dead Movie with guitarist Jerry Garcia...", url:"https://themoviedb.org/person/65608"}}, {tmdbId:"9915", properties:{bornIn:"Paris, Ile-de-France, France", imdbId:"0357891", born:date('1922-09-16'), name:"Guy Hamilton", bio:"​From Wikipedia, the free encyclopedia.    Guy Hamilton (born 16 September 1922) was an English film director.  Hamilton was born in Paris, France where his English parents were living.  Remaining in France during the Nazi occupation, he was active in the French Resistance.  After the end of the war, he worked as an assistant to Carol Reed on films including The Fallen Idol (1948) and The Third Man (1949), before turning to directing with his first film The Ringer in 1952...", died:date('2016-04-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9Zw8DLze3tVJBBqcRUMjAioNFbE.jpg", url:"https://themoviedb.org/person/9915"}}, {tmdbId:"55476", properties:{bornIn:"Manchester, England, UK", imdbId:"0405336", born:date('1956-05-07'), name:"Nicholas Hytner", bio:"From Wikipedia, the free encyclopedia. \n\nSir Nicholas Robert Hytner (born 7 May 1956) is an English film and theatre producer and director.  He has been the artistic director of London's National Theatre since 2003...", url:"https://themoviedb.org/person/55476"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"34481", properties:{bornIn:"Evansville, Indiana, USA", imdbId:"0931285", name:"Matt Williams", bio:"From Wikipedia, the free encyclopedia\n\nMatt Williams is a television writer, creator and producer.  He is the producer of the TV shows Roseanne and Home Improvement and movies such as What Women Want, and has written for The Cosby Show and A Different World as well as writing the screenplay for Wild Hearts Can't Be Broken.  Additionally he has written the play \"Between Daylight and Boonville\", and directed and co-produced the feature film Where the Heart Is starring Natalie Portman...", url:"https://themoviedb.org/person/34481"}}, {tmdbId:"29471", properties:{bornIn:"Marylebone, London, England", imdbId:"0002207", born:date('1948-07-15'), name:"Richard Franklin", bio:"​From Wikipedia, the free encyclopedia.   \n\nRichard Franklin (15 July 1948 – 11 July 2007) was an Australian-born film director. \n\nDescription above from the Wikipedia article Richard Franklin (director), licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2007-07-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6uwR8pty3q88uFgRpRFUDEewN88.jpg", url:"https://themoviedb.org/person/29471"}}, {tmdbId:"15206", properties:{bornIn:"New York City, New York, USA", imdbId:"0564319", born:date('1941-09-16'), name:"Jim McBride", bio:"Jim McBride is an American television and film director, film producer and screenwriter. \n\nRichard Brody, writing for The New Yorker, named McBride as one of the twelve greatest living narrative filmmakers, citing David Holzman's Diary as a \"time capsule of sights and sounds, ideas and moods, politics and history\", and \"one of the greatest first films...", url:"https://themoviedb.org/person/15206"}}, {tmdbId:"11091", properties:{bornIn:"Miami Beach, Florida, USA", imdbId:"0711840", born:date('1969-03-28'), name:"Brett Ratner", bio:"Brett Ratner (born March 28, 1969 in Miami Beach) is an American filmmaker. \n\nHe directed several music videos and the action comedy Money Talks (1997), before reaching commercial success with the action-comedy Rush Hour (1998), starring Jackie Chan and Chris Tucker, both of whom reunited with Ratner for two sequels...", url:"https://themoviedb.org/person/11091"}}, {tmdbId:"2460", properties:{bornIn:"Jackson, Tennessee, USA", imdbId:"0908824", born:date('1949-07-28'), name:"Randall Wallace", bio:"Randall Wallace is an American screenwriter, director, producer, and songwriter, who came to prominence by writing the screenplay for the 1995 film Braveheart.  His work on the film earned him an Oscar nomination for Best Original Screenplay and a Writers Guild of America award for Best Screenplay Adapted Directly for the Screen.  His other films include The Man in the Iron Mask, Pearl Harbor, We Were Soldiers, and Secretariat...", url:"https://themoviedb.org/person/2460"}}, {tmdbId:"65734", properties:{bornIn:"Manhassett, New York, USA", imdbId:"0339004", born:date('1972-02-05'), name:"Luke Greenfield", bio:"From Wikipedia, the free encyclopedia. \n\nLuke Greenfield (born February 5, 1972) is an American film director.  Greenfield was born in Manhasset, New York and was raised in Westport, Connecticut.  He is best known for directing The Animal and The Girl Next Door.  In July 2007, he appeared as a guest judge on the filmmaking reality show On the Lot.  Greenfield directed the critically acclaimed television pilot, Aliens in America, and produced the film, Role Models...", url:"https://themoviedb.org/person/65734"}}, {tmdbId:"1090", properties:{bornIn:"Albany, New York, USA", imdbId:"0001532", born:date('1951-01-08'), name:"John McTiernan", bio:"John Campbell McTiernan, Jr.  is an American film director and producer, best known for his action films and most identifiable with the three films he directed back-to-back: Predator, Die Hard, and The Hunt for Red October, along with later movies such as Last Action Hero, Die Hard With A Vengeance, and The Thomas Crown Affair.  More recently, McTiernan was in the news for his criminal conviction in the Anthony Pellicano wiretapping scandal...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yVfDkVbgQHD1A7JSV8Z47EjB1mU.jpg", url:"https://themoviedb.org/person/1090"}}, {tmdbId:"54967", properties:{bornIn:"Binghamton, New York, USA", imdbId:"0918873", name:"Sam Weisman", bio:"From Wikipedia, the free encyclopedia.   Sam Weisman is an American film director.  He has directed the films D2: The Mighty Ducks, Bye Bye Love, George of the Jungle, The Out-of-Towners, What's the Worst That Could Happen?, and Dickie Roberts: Former Child Star. \n\nHis brother is the producer David Weisman. \n\nSam Weisman is married to former Knots Landing actress Constance McCashin, with whom he has two children: Marguerite and Daniel Weisman, manager of Mike Posner...", url:"https://themoviedb.org/person/54967"}}, {tmdbId:"20400", properties:{bornIn:"Los Angeles, California, USA", imdbId:"1103162", born:date('1970-03-13'), name:"Tim Story", bio:"​From Wikipedia, the free encyclopedia.   \n\nTimothy Kevin Story (born March 13, 1970) is an African-American film director.  Born in Los Angeles, California, he attended Westchester High School in Los Angeles with jazz pianist Eric Reed and actresses Regina King and Nia Long.  He was senior class president at Westchester High.  He graduated from the University of Southern California School of Cinematic Arts in 1991.  His twin sister, Tamryn, was a basketball star at USC...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d1VJwZmNnsZlDq9aAjJf95tehKh.jpg", url:"https://themoviedb.org/person/20400"}}, {tmdbId:"65859", properties:{imdbId:"0003355", name:"Christopher Monger", url:"https://themoviedb.org/person/65859"}}, {tmdbId:"3388", properties:{bornIn:"North Bergen, New Jersey, USA", imdbId:"0000985", born:date('1940-05-09'), name:"James L. Brooks", bio:"James Lawrence Brooks is an American director, producer and screenwriter.  Growing up in North Bergen, New Jersey, Brooks endured a fractured family life and passed the time by reading and writing.  After dropping out of New York University, he got a job as an usher at CBS, going on to write for the CBS News broadcasts.  He moved to Los Angeles in 1965 to work on David L.  Wolper's documentaries...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vGiq4Fny4uRu3y5zOUMnklfw8n6.jpg", url:"https://themoviedb.org/person/3388"}}, {tmdbId:"23213", properties:{bornIn:"New York City, New York, USA", imdbId:"0000887", born:date('1950-01-01'), name:"Harold Becker", bio:"From Wikipedia, the free encyclopedia.   \n\nHarold Becker (born September 25, 1928) is American film director and producer from New York. \n\nDescription above from the Wikipedia article Harold Becker, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/85vazdTmXssntKCJG5iMi6L9Kaq.jpg", url:"https://themoviedb.org/person/23213"}}, {tmdbId:"48980", properties:{bornIn:"London, England, UK", imdbId:"0573589", name:"David McNally", bio:"David McNally (born 1960) is a British-Canadian director of film and television.  He is best known for directing Coyote Ugly and Kangaroo Jack...", url:"https://themoviedb.org/person/48980"}}, {tmdbId:"41549", properties:{bornIn:"USA", imdbId:"0281598", born:date('1965-12-30'), name:"Andrew Fleming", bio:"​From Wikipedia, the free encyclopedia. \n\nAndrew Fleming  (born March 14, 1963) is an American film and television director and screenwriter.  He directed and wrote or co-wrote the films Bad Dreams, Threesome, The Craft, Dick, Nancy Drew and Hamlet 2.  He also directed, without writing, the 2003 film The In-Laws.  He has also directed episodes of the television series Arrested Development and Grosse Pointe, among others. \n\nHe studied filmmaking at New York University film school...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fgqJC8aCiH00Y1g3cfzYpBUBCD3.jpg", url:"https://themoviedb.org/person/41549"}}, {tmdbId:"66088", properties:{bornIn:"Clifton, New Jersey, United States", imdbId:"0561813", born:date('1949-01-05'), name:"Ronald F. Maxwell", bio:"​From Wikipedia, the free encyclopedia\n\nRonald F.  Maxwell (born January 5, 1949) is an independent film director and writer from Clifton, New Jersey.  He is most famous for writing and directing the American Civil War epics Gettysburg, 1993 and Gods and Generals, 2003. \n\nIn 2007, Maxwell optioned the film rights to novelist Speer Morgan's 1979 book Belle Starr.  Starr was a legendary female outlaw of the Old West. \n\nA New Jersey native, Maxwell attended Clifton High School...", url:"https://themoviedb.org/person/66088"}}, {tmdbId:"66074", properties:{bornIn:"Crowley, Texas", imdbId:"1052162", born:date('1977-10-17'), name:"Bryan Bertino", bio:"Bryan Michael Bertino (born 17 October 1977) is an American film director and screenwriter...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8vGpQ5cQZMJEttCxOWiPjYENNpc.jpg", url:"https://themoviedb.org/person/66074"}}, {tmdbId:"15630", properties:{bornIn:" Los Angeles, California, USA", imdbId:"0326360", born:date('1931-06-08'), name:"James Goldstone", bio:"From Wikipedia, the free encyclopedia\n\nJames Goldstone (June 8, 1931 in Los Angeles, California – November 5, 1999 in Shaftsbury, Vermont) was an American director of both television and theatrical films during the 1960s, 1970s and early 1980s. \n\nGoldstone was noted for the momentum and \"fifteen-minute cliffhangers\" that he brought to TV pilots such as Star Trek, Ironside, and The Senator...", died:date('1999-11-05'), url:"https://themoviedb.org/person/15630"}}, {tmdbId:"66191", properties:{bornIn:"Nashville, Tennessee, USA", imdbId:"0176905", name:"Barry Cook", url:"https://themoviedb.org/person/66191"}}, {tmdbId:"43468", properties:{bornIn:"Beverly - Massachusetts - USA", imdbId:"0272704", born:date('1966-02-18'), name:"Guy Ferland", bio:"From Wikipedia, the free encyclopedia. \n\nGuy Ferland (born 18 February 1966) is an American film and television director...", url:"https://themoviedb.org/person/43468"}}, {tmdbId:"27146", properties:{bornIn:" Buffalo, New York, USA", imdbId:"0509409", born:date('1947-07-16'), name:"Rob Lieberman", bio:"Rob Lieberman is a Canadian film and television director and executive producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lPaofAC7evfyLsS1lgbW2DlVwmD.jpg", url:"https://themoviedb.org/person/27146"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"179616", properties:{imdbId:"0817811", name:"Richard Spence", url:"https://themoviedb.org/person/179616"}}, {tmdbId:"66601", properties:{imdbId:"0620294", name:"Hiroyuki Nakano", url:"https://themoviedb.org/person/66601"}}, {tmdbId:"3224", properties:{bornIn:"Leicester, England, UK", imdbId:"0001241", born:date('1941-06-20'), name:"Stephen Frears", bio:"Stephen Arthur Frears (born 20 June 1941) is an English director and producer.  He has directed numerous acclaimed films since the early 1980s, including My Beautiful Laundrette (1985), Dangerous Liaisons (1988), The Grifters (1990), High Fidelity (2000), The Queen (2006), Philomena (2013), Florence Foster Jenkins (2016), and Victoria & Abdul (2017).  He has received two nominations for the Academy Award for Best Director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mnKF03LVnXPpm4VliNkf6zMmAM.jpg", url:"https://themoviedb.org/person/3224"}}, {tmdbId:"66960", properties:{bornIn:"Brooklyn Center, Minnesota, USA", imdbId:"0330140", name:"Dennie Gordon", bio:"​From Wikipedia, the free encyclopedia. \n\nDennie Gordon is an American film and television director.  Her directorial television credits include, Chicago Hope, Picket Fences, Dawson's Creek, Sports Night, Ally McBeal, The Practice, 30 Rock, Grounded for Life and among other series.  She has also directed the feature films Joe Dirt, New York Minute and What a Girl Wants...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fOPyFjdwIGGIuXkWsUF0FTrEEuo.jpg", url:"https://themoviedb.org/person/66960"}}, {tmdbId:"19000", properties:{bornIn:"Johannesburg-Kew, South Africa", imdbId:"0469694", name:"Wayne Kramer", bio:"From Wikipedia, the free encyclopedia. \n\nWayne Kramer (born 1965) is a South African screenwriter, film producer, storyboard artist and film director. \n\nKramer has written and directed films such as The Cooler, Crossing Over, Blazeland and Running Scared.  He also wrote the screenplay for the film Mindhunters, but the final script was heavily rewritten by others and bore little resemblance to Kramer's original work...", url:"https://themoviedb.org/person/19000"}}, {tmdbId:"15254", properties:{bornIn:"Sarajevo, Bosnia and Herzegovina", imdbId:"0001437", born:date('1954-11-24'), name:"Emir Kusturica", bio:"Emir Nemanja Kusturica is a Serbian filmmaker, actor and musician, recognized for several internationally acclaimed feature films. \n\nHe is a two-time winner of the Palme d'Or at Cannes (for When Father Was Away on Business and Underground), as well as being a Commander of the French Ordre des Arts et des Lettres.   Since the mid-2000s, Kusturica's primary residence is Drvengrad, a village in the Mokra Gora region of Serbia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4TVOxbLhi8DXD89B7oY1Ji0XPnu.jpg", url:"https://themoviedb.org/person/15254"}}, {tmdbId:"1126", properties:{bornIn:"Warsaw, Mazowieckie, Poland.", imdbId:"0001425", born:date('1941-06-27'), name:"Krzysztof Kieślowski", bio:"Krzysztof Kieślowski was an influential Polish art-house film director and screenwriter known internationally for The Decalogue (1989), The Double Life of Véronique (1991), and The Three Colors Trilogy (1993–1994)...", died:date('1996-03-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9KOrCsaDTYqJvRLHEROy7ueRlMd.jpg", url:"https://themoviedb.org/person/1126"}}, {tmdbId:"66548", properties:{bornIn:"England, UK", imdbId:"0917992", born:date('1953-07-11'), name:"Paul Weiland", bio:"From Wikipedia, the free encyclopedia. \n\nPaul Weiland (born 11 July 1953 in England) is an English motion picture and television director, writer and producer.  Weiland is one of Britain's most successful directors and producers of television commercials having made over 500 commercials, including a popular and long-running series for Walkers crisps.  He has also directed several British television series, including Alas Smith and Jones (1989–1992) and Mr.  Bean (1991–1994)...", url:"https://themoviedb.org/person/66548"}}, {tmdbId:"12995", properties:{bornIn:"Illertissen, Germany", imdbId:"0286975", born:date('1969-11-30'), name:"Marc Forster", bio:"Marc Forster (Illertissen, November 30, 1969) is a German-Swiss filmmaker and screenwriter, known for films such as Monster's Ball, Finding Neverland, Stranger than Fiction, The Kite Runner, and the James Bond film Quantum of Solace. \n\nDescription above from the Wikipedia article Marc Forster, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/m3WEGG6czBjgFULVyVQy6EJvUsZ.jpg", url:"https://themoviedb.org/person/12995"}}, {tmdbId:"34611", properties:{bornIn:"Chicago, Illinois USA", imdbId:"0956052", born:date('1927-10-21'), name:"Howard Zieff", bio:"​From Wikipedia, the free encyclopedia\n\nHoward Zieff (21 October 1927 – 22 February 2009), was an American director, television commercial director, and advertising photographer. \n\nDescription above from the Wikipedia article Howard Zieff, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2009-02-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/msqlpdksChlqHRDXNM61SbRm4uP.jpg", url:"https://themoviedb.org/person/34611"}}, {tmdbId:"66654", properties:{imdbId:"1019493", name:"Kevin Donovan", url:"https://themoviedb.org/person/66654"}}, {tmdbId:"65994", properties:{bornIn:"Hong Kong", imdbId:"0490487", born:date('1960-04-04'), name:"Andrew Lau", bio:"From Wikipedia, the free encyclopedia.  Andrew Lau Wai-Keung (born 4 April 1960) is a Hong Kong cinematographer and filmmaker.  Lau began his career in the 1980s and 1990s, serving as a cinematographer to filmmakers such as Ringo Lam, Wong Jing and Wong Kar-wai.  In the 1990s, Lau decided to have more creative freedom as a cinematographer by becoming a film director and producer.  Apart from making films in his native Hong Kong, Lau has also made films in China, Korea and the United States...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jeOcDd8zWKc4nYk9MvRS3FKzuc2.jpg", url:"https://themoviedb.org/person/65994"}}, {tmdbId:"66718", properties:{bornIn:"Hong Kong, China", imdbId:"0538320", born:date('1965-01-01'), name:"Alan Mak", bio:"From Wikipedia, the free encyclopedia.   Alan Mak Siu-Fai (  pinyin: Mài Zhàohuī), born on 1 January 1965 in Hong Kong, is a writer, director, actor and producer.   Description above from the Wikipedia article Alan Mak, licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9iSljOXim6qWYEbX47NKtoVQ19r.jpg", url:"https://themoviedb.org/person/66718"}}, {tmdbId:"1223", properties:{bornIn:"Minneapolis, Minnesota, U.S.A.", imdbId:"0001054", born:date('1954-11-29'), name:"Joel Coen", bio:"American filmmaker Joel David Coen is known for writing, directing and producing films jointly with his brother Ethan Jesse Coen; professionally they are known as the Coen brothers.  In 1984, the brothers wrote and directed Blood Simple, their first film together.  The film was well received and won awards for Joel's direction at both the Sundance and Independent Spirit awards. \n\nThe brothers were recognized for their talents having been nominated for a number of awards and achievements...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/urPzYe1AOYt9QW7rUj05riJJOAJ.jpg", url:"https://themoviedb.org/person/1223"}}, {tmdbId:"9248", properties:{bornIn:"New York City, New York, USA", imdbId:"0001188", born:date('1941-05-19'), name:"Nora Ephron", bio:"​From Wikipedia, the free encyclopedia\n\nNora Ephron (born May 19, 1941-June 26, 2012) was an American film director, producer, screenwriter, novelist, journalist, author, and blogger. \n\nShe was best known for her romantic comedies and was a triple nominee for the Academy Award for Writing Original Screenplay; for Silkwood, When Harry Met Sally. . .  and Sleepless in Seattle.  She sometimes wrote with her sister Delia Ephron.  Her final film was Julie & Julia...", died:date('2012-06-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2DO8ef3VVkcmMX2m0Qfz01IkMl4.jpg", url:"https://themoviedb.org/person/9248"}}, {tmdbId:"13973", properties:{imdbId:"0638528", born:date('1913-09-01'), name:"Christian Nyby", died:date('1993-09-17'), url:"https://themoviedb.org/person/13973"}}, {tmdbId:"2917", properties:{bornIn:"Dudley, Worcestershire, England, UK", imdbId:"0001843", born:date('1889-07-22'), name:"James Whale", bio:"From Wikipedia, the free encyclopedia. \n\nJames Whale (22 July 1889 – 29 May 1957) was an English film director, theatre director and actor.  He is best remembered for his work in the horror film genre, having directed Frankenstein (1931), The Old Dark House (1932), The Invisible Man (1933) and Bride of Frankenstein (1935), all recognized as classics of the genre...", died:date('1957-05-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cJcOH8Nt16n4ucp7j7u22I3Uxa3.jpg", url:"https://themoviedb.org/person/2917"}}, {tmdbId:"57134", properties:{bornIn:"Hong Kong, China", imdbId:"0939128", born:date('1959-04-20'), name:"James Wong", bio:"​From Wikipedia, the free encyclopedia\n\nJames 'Jim' Wong (born April 20, 1959) is a Hongkongese-American television producer, writer, and film director notable for his screen works of The X-Files, Space: Above and Beyond, Millennium, Final Destination, The One, and the remakes of Willard and Black Christmas along with writing partner Glen Morgan. \n\nDescription above from the Wikipedia James Wong (producer), licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2018-05-01'), url:"https://themoviedb.org/person/57134"}}, {tmdbId:"129422", properties:{bornIn:"New York City, New York, U.S.", imdbId:"0191899", born:date('1888-10-09'), name:"Irving Cummings", died:date('1959-04-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dJUdPjAvwk4AHpMsTPVkZFwXTNa.jpg", url:"https://themoviedb.org/person/129422"}}, {tmdbId:"10491", properties:{bornIn:"Amsterdam, Noord-Holland, Netherlands", imdbId:"0000682", born:date('1938-07-18'), name:"Paul Verhoeven", bio:"Paul Verhoeven (born July 18, 1938) is a Dutch film director, screenwriter, and producer who has made movies in both the Netherlands and the United States.  Explicitly violent and/or sexual content and social satire are trademarks of both his drama and science fiction films.  He is best known for directing the American feature films RoboCop (1987), Total Recall (1990), Basic Instinct (1992), Starship Troopers (1997), and Hollow Man (2000)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nGxhfCv52JDFeQIZBiB7hhQKJJu.jpg", url:"https://themoviedb.org/person/10491"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"20412", properties:{bornIn:"Hillingdon, Middlesex, England, UK", imdbId:"0027183", born:date('1920-01-30'), name:"Michael Anderson", bio:"From Wikipedia, the free encyclopedia\n\nMichael Joseph Anderson, Sr.  (30 January 1920 – 25 April 2018) was an English film director, best known for directing Around the World in 80 Days (1956) and Logan's Run (1976). \n\n \n\nDescription above from the Wikipedia article Michael Anderson (director), licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2018-04-25'), url:"https://themoviedb.org/person/20412"}}, {tmdbId:"12920", properties:{bornIn:"Providence, Rhode Island, USA", imdbId:"0911486", born:date('1945-10-25'), name:"David S. Ward", bio:"​From Wikipedia, the free encyclopedia\n\nDavid Schad Ward (born 25 October 1945) is an American film director and screen writer. \n\nDescription above from the Wikipedia article David S.  Ward, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/12920"}}, {tmdbId:"140244", properties:{imdbId:"0735416", name:"Manny Rodriguez", url:"https://themoviedb.org/person/140244"}}, {tmdbId:"15557", properties:{bornIn:"New York City, New York, USA", imdbId:"0174374", born:date('1955-10-22'), name:"Bill Condon", bio:"William \"Bill\" Condon (born October 22, 1955) is an American screenwriter and director.  Condon is best known for directing and writing the critically acclaimed films Gods and Monsters, Chicago, Kinsey, and Dreamgirls.  In 1998, Condon debuted as a screenwriter in Gods and Monsters, which won him his first Academy Award.  He was also nominated for Chicago and Kinsey.  In 2006, Condon won a Golden Globe for his film Dreamgirls, which he wrote and directed...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wYS9OCX85SJQWdjQokWVgmX7PQX.jpg", url:"https://themoviedb.org/person/15557"}}, {tmdbId:"26475", properties:{imdbId:"0534681", name:"Brent Maddock", bio:"​From Wikipedia, the free encyclopedia.   \n\nBrent Maddock is a writer/director who has worked on several high profile projects like Short Circuit, Tremors, and Wild Wild West.  Maddock's writing partner is S. S.  Wilson. \n\nDescription above from the Wikipedia article Brent Maddock, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/26475"}}, {tmdbId:"30309", properties:{bornIn:"Newport, Gwent, Wales, UK", imdbId:"0000425", born:date('1942-04-05'), name:"Peter Greenaway", bio:"Peter Greenaway, CBE (born 5 April 1942) is a British film director. \n\nDescription above from the Wikipedia article Peter Greenaway, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xw8UM4GStDbmNy21Hi1tI1UprgW.jpg", url:"https://themoviedb.org/person/30309"}}, {tmdbId:"56735", properties:{bornIn:"Boulogne Billancourt, France", imdbId:"1219963", born:date('1976-07-14'), name:"David Moreau", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9LXJXsmpC042WrIIFbeUK8lTGZe.jpg", url:"https://themoviedb.org/person/56735"}}, {tmdbId:"548474", properties:{bornIn:"Hong Kong, British Crown Colony [now China]", imdbId:"0939147", born:date('1955-05-03'), name:"Wong Jing", bio:"Wong Jing is one of Hong Kong's most prolific, talented and controversial filmmakers.  His directorial style, at best, manages to combine commercial appeal and artistic aspects.  Most of his films were among the biggest box office hits, partly due to possessing an amazing sense of what would play well.  Some of his films have achieved groundbreaking success, artistically as well as financially...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gMmaDRst3OwnY1wClKt541AmslD.jpg", url:"https://themoviedb.org/person/548474"}}, {tmdbId:"18378", properties:{bornIn:"Brooklyn, New York City, New York, USA", imdbId:"0006889", born:date('1927-05-13'), name:"Herbert Ross", bio:"Herbert David Ross was an American actor, choreographer, director and producer who worked predominantly in the stage and film. \n\nRoss was born on May 13, 1927 in Brooklyn, New York, the son of Martha Grundfast and Louis Chester Ross, a postal clerk.  At the age of 9, his mother died and his father moved the family to Miami and opened a luncheonette. \n\nIn 1942, Ross' stage debut came as \"Third Witch\" in a touring company of Macbeth...", died:date('2001-10-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zeeqJjMyWhYHDUyjqkwHAJtOMgn.jpg", url:"https://themoviedb.org/person/18378"}}, {tmdbId:"42171", properties:{bornIn:" Paris, France", imdbId:"0438279", born:date('1947-11-25'), name:"Jonathan Kaplan", bio:"From Wikipedia, the free encyclopedia. \n\nJonathan Kaplan (born November 25, 1947) is an American film producer and director. \n\nKaplan was born in Paris, France.  He is the son of film composer Sol Kaplan and actress Frances Heflin; the nephew of actor Van Heflin.  He is the brother of actresses Nora Heflin and Mady Kaplan.  His film The Accused (1988), earned actress Jodie Foster her first Oscar for Best Actress and was nominated for the Golden Bear at the 39th Berlin International Film Festival...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eJ2YceVqeCSuwHAVhnA1FZRV1xc.jpg", url:"https://themoviedb.org/person/42171"}}, {tmdbId:"5834", properties:{bornIn:"Buxton, Derbyshire, England, UK", imdbId:"0829038", born:date('1905-03-31'), name:"Robert Stevenson", bio:"From Wikipedia, the free encyclopedia. \n\nRobert Stevenson (31 March 1905, Buxton, Derbyshire – 30 April 1986) was an English film writer and director.  He was educated at Cambridge University where he became the president of both the Liberal Club and the Cambridge Union Society. \n\nHe moved to California in the 1940s and ended up directing 19 films for The Walt Disney Company in the 1960s and 1970s...", died:date('1986-04-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ogiArg0tpEZkcO8nAlAvZS7mvAX.jpg", url:"https://themoviedb.org/person/5834"}}, {tmdbId:"7671", properties:{imdbId:"0835732", born:date('1956-01-21'), name:"Jeb Stuart", bio:"From Wikipedia, the free encyclopedia\n\nJeb Stuart (born 1956) is an American film director, film producer and screenwriter.  Among his scripts are Die Hard (1988), The Fugitive (1993), and an early draft of Indiana Jones and the Kingdom of the Crystal Skull, entitled Indiana Jones and the Saucer Men from Mars, in 1995. \n\nDescription above from the Wikipedia article Jeb Stuart (writer), licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/7671"}}, {tmdbId:"56106", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0796124", born:date('1941-10-11'), name:"Charles Shyer", bio:"From Wikipedia, the free encyclopedia. \n\nCharles Richard Shyer (born October 11, 1941) is an American film director, writer and producer.  Shyer's films are predominantly comedies, often with a romantic-comedy overtone...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/stcwg4mJKGQo0UBfWcXVQy6fOdP.jpg", url:"https://themoviedb.org/person/56106"}}, {tmdbId:"11426", properties:{bornIn:"Tacoma, Washington, USA", imdbId:"0789313", born:date('1895-11-04'), name:"Ben Sharpsteen", bio:"“Born in Tacoma, Wash.  Graduated from agricultural college but gave up agrarian pursuits to help out Uncle Sam’s Marines during the war.  Marine life made me so lazy I couldn’t bear the thought of hard work again so I became an animator, joining the old International Film Company in New York.  Work as an animator on old Mutt and Jeff cartoons and on Fleischer’s “Out-of-the-Inkwell. ” Twice deserted the ranks of animation for newspaper and commercial art...", died:date('1980-12-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kyIoCqPeryGQspO6R3enHmFoM8L.jpg", url:"https://themoviedb.org/person/11426"}}, {tmdbId:"58448", properties:{bornIn:"New Orleans, Louisiana, United States", imdbId:"0790715", born:date('1945-12-02'), name:"Penelope Spheeris", bio:"Penelope Spheeris (born December 2, 1945) is an American director, producer and screenwriter.  She is best known as a documentary film director whose works include the trilogy titled The Decline of Western Civilization.   She has also directed feature films, including Wayne's World, her highest grossing film...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7juDUTAEyAKKfDmkOD9q24kjrei.jpg", url:"https://themoviedb.org/person/58448"}}, {tmdbId:"56263", properties:{bornIn:"Helena, Arkansas", imdbId:"0005116", born:date('1951-10-13'), name:"Mary Lambert", bio:"​Mary Lambert (born October 13, 1951) is an American film director.  She has directed music videos, television episodes, and feature films, mainly in the horror genre. \n\nDescription above from the Wikipedia article Mary Lambert, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q8Fir0mq5t0iBbwjaERCvYPofzI.jpg", url:"https://themoviedb.org/person/56263"}}, {tmdbId:"18669", properties:{bornIn:"Bristol, England, UK", imdbId:"0496746", born:date('1914-08-01'), name:"J. Lee Thompson", bio:"​From Wikipedia, the free encyclopedia. \n\nJohn Lee Thompson  (1 August 1914 – 30 August 2002), better known as J.  Lee Thompson, was an English film director, active in England and Hollywood. \n\nDescription above from the Wikipedia article J...", died:date('2002-08-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cVHgJwHOh4j7q1tn3vQEcopblrJ.jpg", url:"https://themoviedb.org/person/18669"}}, {tmdbId:"31900", properties:{imdbId:"0892144", born:date('1943-06-25'), name:"Michael Vejar", url:"https://themoviedb.org/person/31900"}}, {tmdbId:"6729", properties:{bornIn:"Waxahachie, Texas, USA", imdbId:"0000914", born:date('1932-09-29'), name:"Robert Benton", bio:"From Wikipedia, the free encyclopedia. \n\nRobert Douglas Benton (born September 29, 1932) is an American screenwriter and film director. \n\nBenton was born in Waxahachie, Texas, the son of Dorothy (née Spaulding) and Ellery Douglass Benton, a telephone company employee.  He attended the University of Texas and Columbia University. [1] Benton has enjoyed a highly successful career in film, winning numerous prestigious awards for both writing and directing...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/309zHbAHOXv1PffWz4C9SEEgEGa.jpg", url:"https://themoviedb.org/person/6729"}}, {tmdbId:"81186", properties:{imdbId:"0813583", born:date('1947-12-13'), name:"Andrew Solt", bio:"From Wikipedia, the free encyclopedia. \n\nAndrew Solt (born December 13, 1947) is a producer, director, writer and documentary filmmaker.   He has done numerous television specials and series for both broadcast and cable television and also movies.   Solt owns the rights to the The Ed Sullivan Show library and has produced over 100 hours of new programming from the archive.   A frequent focus of his documentaries is rock and roll music, its history and star performers...", url:"https://themoviedb.org/person/81186"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"67604", properties:{bornIn:"East Los Angeles, California, USA", imdbId:"0075859", born:date('1919-12-17'), name:"Ted Berman", bio:"Joining Disney in the 1940s, Berman started off as an animator, but focused on writing and directing in his later years.  Berman was also a fine-arts painter.  He served on the Disney staff for nearly 5 years.  Berman worked on a number of successful theatrical releases by the Mouse House along with his work with The Wonderful World of Color and The Mickey Mouse Club.  In the 1980s, he helped direct The Fox and the Hound and The Black Cauldron before he retired from Disney...", died:date('2001-07-15'), url:"https://themoviedb.org/person/67604"}}, {tmdbId:"67607", properties:{bornIn:"Roy, Montana, USA", imdbId:"0828245", born:date('1915-05-01'), name:"Art Stevens", bio:"Art Stevens was an animator at Walt Disney Productions during the Golden Age of American Animation.  Stevens began as an In-Betweener on the 1940 film Fantasia.  After doing in-between work on several films, he received his first screen credit as a character animator was on Peter Pan  in 1953...", died:date('2007-05-22'), url:"https://themoviedb.org/person/67607"}}, {tmdbId:"107274", properties:{imdbId:"0723704", name:"Richard Rich", bio:"Richard Rich is an American filmmaker and current president of Crest Animation Productions.  He is well known for his work in the animation field. \n\nHe is one of the few animation directors to have never worked as animator...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ygeJUnHFiYjecmBLBPBie81JMLm.jpg", url:"https://themoviedb.org/person/107274"}}, {tmdbId:"2163", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0481418", born:date('1959-10-30'), name:"Richard LaGravenese", bio:"Richard LaGravenese (born October 30, 1959) is an American screenwriter and occasional film director.  He is best known as the writer of The Fisher King. \n\nDescription above from the Wikipedia article Richard LaGravenese, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/2163"}}, {tmdbId:"67794", properties:{imdbId:"0179216", name:"Gérard Corbiau", url:"https://themoviedb.org/person/67794"}}, {tmdbId:"229702", properties:{imdbId:"0635895", name:"Rufus Norris", url:"https://themoviedb.org/person/229702"}}, {tmdbId:"54441", properties:{bornIn:"Berkeley, California, USA", imdbId:"0412465", born:date('1928-06-07'), name:"James Ivory", bio:"​From Wikipedia, the free encyclopedia.   \n\nJames Francis Ivory (born June 7, 1928) is an American film director, best known for the results of his long collaboration with Merchant Ivory Productions, which included both Indian-born film producer Ismail Merchant, and screenwriter Ruth Prawer Jhabvala.  Their films won six Academy Awards...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4w9QeQuT2UK1v3IDy6pa8cGodW.jpg", url:"https://themoviedb.org/person/54441"}}, {tmdbId:"67657", properties:{bornIn:"Bethesda, Maryland, USA", imdbId:"1795664", born:date('1976-11-21'), name:"Scott Glosserman", url:"https://themoviedb.org/person/67657"}}, {tmdbId:"113799", properties:{bornIn:"New York City", imdbId:"0675068", born:date('1930-08-21'), name:"Frank Perry", bio:"Frank Joseph Perry, Jr.  (August 21, 1930 – August 29, 1995) was an American director...", died:date('1995-08-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q0BwayBCQzk6CIQ3HAcXOfyj50A.jpg", url:"https://themoviedb.org/person/113799"}}, {tmdbId:"37948", properties:{bornIn:"Madison, Connecticut, USA", imdbId:"0026442", born:date('1964-01-01'), name:"Brad Anderson", bio:"Brad Anderson is an American film director.  A prolific director of thriller and horror films and television projects, he is best known for having directed The Machinist (2004), starring Christian Bale...", url:"https://themoviedb.org/person/37948"}}, {tmdbId:"33883", properties:{bornIn:"New Haven, Connecticut, USA", imdbId:"0000791", born:date('1916-10-14'), name:"Jack Arnold", bio:"From Wikipedia, the free encyclopedia. \n\nJack Arnold (October 14, 1912 – March 17, 1992) was an American television and film director, best known as one of the leading filmmakers of 1950's science fiction films. \n\nDescription above from the Wikipedia article Jack Arnold (director), licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1992-03-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a9uDTgdsxBenzariCObIkZu1rh8.jpg", url:"https://themoviedb.org/person/33883"}}, {tmdbId:"57022", properties:{bornIn:"Beirut, Lebanon", imdbId:"0267244", born:date('1977-09-19'), name:"Josef Fares", bio:"Josef\n\nFares (born 19 September 1977) is a Crystal-Simorgh winning Swedish film\n\ndirector of Lebanese Aramean origin.  His brother is the actor Fares Fares, who\n\nhas appeared in many of his films.  Josef Fares moved to Sweden when he was 10\n\nyears old and lives in Örebro, Örebro län.  Variety declared him one of ten\n\nupcoming directors to watch in 2006.  The same year he won the Nordic Council\n\nFilm Prize for his film Zozo...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pA2b8D0IxscNfQ6DB55Kx2xGeqy.jpg", url:"https://themoviedb.org/person/57022"}}, {tmdbId:"61371", properties:{imdbId:"0250410", born:date('1971-09-17'), name:"Todd Edwards", url:"https://themoviedb.org/person/61371"}}, {tmdbId:"59958", properties:{imdbId:"0087595", name:"Jamie Blanks", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8LVDBzdovUys2Cn87EQvQMG5btB.jpg", url:"https://themoviedb.org/person/59958"}}, {tmdbId:"7397", properties:{bornIn:"West Orange, New Jersey, USA", imdbId:"0214036", born:date('1959-05-19'), name:"Ed Decter", bio:"Edward Decter (born 1959) is a film writer, director, and producer. \n\nHis credits include, among other work, There's Something About Mary, The Santa Clause 3, The Santa Clause 2, The New Guy, The Lizzie McGuire Movie, and Boy Meets World. \n\nHe frequently collaborates with fellow producer and writer John J.  Strauss. \n\nDecter graduated from Wesleyan University in 1979. \n\nDescription above from the Wikipedia article Ed Decter, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/7397"}}, {tmdbId:"55116", properties:{imdbId:"0152640", name:"Joe Chappelle", bio:"Joe Chappelle is an American film and television director and producer.  He was a co-executive producer and regular director for the HBO crime drama \"The Wire\" and a producer and frequent director for \"CSI: Miami\"...", url:"https://themoviedb.org/person/55116"}}, {tmdbId:"34682", properties:{bornIn:"Montreal, Quebec, Canada", imdbId:"0154819", born:date('1955-01-01'), name:"Jeremiah S. Chechik", bio:"​From Wikipedia, the free encyclopedia.   \n\nJeremiah S.  Chechik (born 1955 in Montreal, Quebec, Canada) is the director of such films as National Lampoon's Christmas Vacation, Benny &amp; Joon, Diabolique and The Avengers. \n\nChechik was nominated for Worst Director at the 1998 Golden Raspberry Awards for The Avengers but lost to Gus Van Sant for his remake of Psycho. \n\nIn 2007, Chechik directed all eight episodes of The Bronx is Burning...", url:"https://themoviedb.org/person/34682"}}, {tmdbId:"7256", properties:{bornIn:"Wellington, New Zealand", imdbId:"0848414", born:date('1950-06-17'), name:"Lee Tamahori", bio:"Lee Tamahori, is a New Zealand filmmaker best-known for directing the 1994 film Once Were Warriors and the 2002 James Bond film Die Another Day...", url:"https://themoviedb.org/person/7256"}}, {tmdbId:"64191", properties:{imdbId:"0349183", name:"Lawrence Guterman", bio:"​From Wikipedia, the free encyclopedia. \n\nLawrence \"Larry\" Guterman is a Canadian film director known for his work in companies like DreamWorks, Warner Bros.  and Universal.  He directed Cats & Dogs, Son of the Mask, and Toontown.  He also directed some of the episodes of Out of Jimmy's Head from 2007 to 2008...", url:"https://themoviedb.org/person/64191"}}, {tmdbId:"67781", properties:{bornIn:"London, England, UK", imdbId:"0467225", born:date('1956-04-21'), name:"Peter Kosminsky", bio:"​From Wikipedia, the free encyclopedia\n\nPeter Kosminsky (born 1956, London) is a British writer, director and producer.  He has directed Hollywood movies such as White Oleander and television films like Warriors, The Government Inspector and The Promise. \n\nDescription above from the Wikipedia article Peter Kosminsky, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/67781"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"2352", properties:{bornIn:"Draveil, Essonne, Île-de-France, France", imdbId:"0000269", born:date('1943-10-01'), name:"Jean-Jacques Annaud", bio:"Annaud was born in Juvisy-sur-Orge, Essonne.  He was educated at the technical school in Vaugirard and in 1964 graduated from the prestigious film school Institut des Hautes Études Cinématographiques (IDHEC) in Paris. \n\nHe began his career by directing television advertisements in the late 1960s to early 1970s.  In his first feature film, Black and White in Color from 1976, he used personal experience obtained during his own military service in Cameroon...", url:"https://themoviedb.org/person/2352"}}, {tmdbId:"67753", properties:{bornIn:"Cleveland, Ohio, USA", imdbId:"0504495", born:date('1946-11-26'), name:"Mark L. Lester", bio:"Mark L.  Lester is an American writer, producer, and director of action films.  Following his first film, Twilight of the Mayas, Lester worked on films such as Stunts, Steel Arena, and Bobby Jo and the Outlaw.  His next film Roller Boogie with Linda Blair was a modest success, which he built on with reasonably received exploitation thriller Class of 1984, and Stephen King's Firestarter...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/m2nUVEEDYiLb5TQKhDgNqeyiapm.jpg", url:"https://themoviedb.org/person/67753"}}, {tmdbId:"58220", properties:{bornIn:"London, England, UK", imdbId:"0399853", born:date('1936-08-25'), name:"Hugh Hudson", bio:"Hugh Hudson is an English film director.  His best-known international success is the 1981 multiple Academy Award-winning film, Chariots of Fire...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/u6kLIQ0BCeYZgXD9TMH0x9fbPBq.jpg", url:"https://themoviedb.org/person/58220"}}, {tmdbId:"323", properties:{bornIn:"Reno, Nevada, USA", imdbId:"0000436", born:date('1945-03-24'), name:"Curtis Hanson", bio:"Curtis Lee Hanson (March 24, 1945 – September 20, 2016) was an American filmmaker.  Hanson was born in Reno, Nevada and grew up in Los Angeles, the son of Beverly June, a real estate agent, and Wilbur Hale \"Bill\" Hanson, a teacher. Hanson dropped out of high school, finding work as a freelance photographer and editor for Cinema magazine. \n\nDescription above from the Wikipedia article Curtis Hanson , licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2016-09-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1ht0tJ0Icxc134W3ZpcGtwMtNLA.jpg", url:"https://themoviedb.org/person/323"}}, {tmdbId:"67767", properties:{bornIn:"Memphis, Tennessee, USA", imdbId:"0624102", born:date('1931-03-06'), name:"Hal Needham", bio:"From Wikipedia, the free encyclopedia. \n\nHal Needham (born March 6, 1931) is an American stuntman and film director...", died:date('2013-10-25'), url:"https://themoviedb.org/person/67767"}}, {tmdbId:"14692", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0145309", born:date('1947-09-21'), name:"Nick Castle", bio:"​From Wikipedia, the free encyclopedia.   \n\nNick Castle (born September 21, 1947) is an American actor, screenwriter and film director, best known for his role as Michael Myers in Halloween.  He also co-wrote Escape from New York with his friend, John Carpenter. \n\nDescription above from the Wikipedia article Nick Castle, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bKJuXeKR8GZLyiutiDSCwwCzZ7n.jpg", url:"https://themoviedb.org/person/14692"}}, {tmdbId:"28898", properties:{bornIn:"New Delhi, India", imdbId:"0705535", born:date('1946-02-24'), name:"Michael Radford", bio:"From Wikipedia, the free encyclopedia  Michael Radford (b.  24 February 1946) is an English film director and screenwriter.   Description above from the Wikipedia article Michael Radford, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mmsyhrFCiR2H71cpXsKtQ8BE2iJ.jpg", url:"https://themoviedb.org/person/28898"}}, {tmdbId:"15389", properties:{bornIn:"Thumeries, Nord, France", imdbId:"0001501", born:date('1932-10-30'), name:"Louis Malle", bio:"Louis Marie Malle was a French film director, screenwriter, and producer.  His film Le Monde du silence won the Palme d'Or in 1956 and the Academy Award for Best Documentary in 1957, although he was not credited at the ceremony with the award instead being presented to the film's co-director Jacques Cousteau.  Later in his career he was nominated multiple times for Academy Awards.  Malle is also one of the few directors to have won the Golden Lion multiple times...", died:date('1995-11-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8BKM2iXcr4b8pvx1OOcNsO9wADn.jpg", url:"https://themoviedb.org/person/15389"}}, {tmdbId:"67795", properties:{bornIn:"USA", imdbId:"0787601", born:date('1963-02-05'), name:"Steven Shainberg", bio:"Steven Shainberg (born 5 February 1963) is an American film director and producer. \n\nHe is the nephew of author Lawrence Shainberg.  Both are part of the Shainberg family of Memphis, Tennessee, founder of the Shainberg's chain of stores, which is now part of Dollar General. \n\nShainberg received his BA from Yale University in English Literature and East Asian studies...", url:"https://themoviedb.org/person/67795"}}, {tmdbId:"57691", properties:{bornIn:"California, USA", imdbId:"0205542", born:date('1962-01-22'), name:"Tamra Davis", bio:"From Wikipedia, the free encyclopedia\n\nTamra Davis (born January 22, 1962) is an American film, television and music video director. \n\nDescription above from the Wikipedia article Tamra Davis, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mo2IRqEOj7sfqJR9Ev75WLhnFXC.jpg", url:"https://themoviedb.org/person/57691"}}, {tmdbId:"19850", properties:{bornIn:"Cameron, Texas, USA", imdbId:"0362566", born:date('1955-10-21'), name:"Catherine Hardwicke", bio:"​From Wikipedia, the free encyclopedia.   \n\nCatherine Hardwicke (born Helen Catherine Hardwicke; October 21, 1955) is an American production designer and film director.  Her works include the independent film Thirteen, which she co-wrote with Nikki Reed, the film's co-star, the Biblically-themed The Nativity Story, the vampire film Twilight, and the werewolf film Red Riding Hood.  The opening weekend of Twilight was the biggest opening ever for a female director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o1kLqFvtohRK8MD4avnB02a3NKM.jpg", url:"https://themoviedb.org/person/19850"}}, {tmdbId:"1215", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0331532", born:date('1958-12-09'), name:"Raja Gosnell", bio:"From Wikipedia, the free encyclopedia. \n\nRaja Raymond Gosnell (born December 9, 1958) is an American film director and editor.  He was born in Los Angeles, California. \n\nDescription above from the Wikipedia article Raja Gosnell, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dIovlHUjOfBEhqrUENBaRmGIAc0.jpg", url:"https://themoviedb.org/person/1215"}}, {tmdbId:"19450", properties:{bornIn:"New York City, New York, USA", imdbId:"0706182", born:date('1933-02-21'), name:"Bob Rafelson", bio:"​From Wikipedia, the free encyclopedia\n\nRobert \"Bob\" Rafelson (born February 21, 1933) is an American film director, writer and producer.  He is most famous for directing and co-writing the film Five Easy Pieces, starring Jack Nicholson, as well as being one of the creators of the pop group and TV series, The Monkees (with Raybert/BBS Productions partner Bert Schneider). \n\nRafelson was born in New York City, the son of a hat manufacturer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6YJpKfdlyYUz2jOxYaZ5yvqueeC.jpg", url:"https://themoviedb.org/person/19450"}}, {tmdbId:"25630", properties:{bornIn:"Brighton, East Sussex, England, UK", imdbId:"0002338", born:date('1921-03-01'), name:"Jack Clayton", bio:"​From Wikipedia, the free encyclopedia.   \n\nJack Clayton (1 March 1921 – 26 February 1995) was a British film director who specialised in bringing literary works to the screen. \n\nDescription above from the Wikipedia article Jack Clayton, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1995-02-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/762N2ew75dql9RtdswTovHgRpC7.jpg", url:"https://themoviedb.org/person/25630"}}, {tmdbId:"110828", properties:{imdbId:"0447863", name:"Christopher Kenneally", url:"https://themoviedb.org/person/110828"}}, {tmdbId:"64508", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"0002089", born:date('1933-02-28'), name:"Sidney J. Furie", bio:"Sidney J.  Furie is a Canadian film director.  Furie is perhaps best known for directing American Soldiers, The IPCRESS File, The Entity, Superman IV: The Quest for Peace, Lady Sings the Blues, The Boys, Gable and Lombard, Sheila Levine Is Dead and Living in New York and the Iron Eagle films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gLKYHQ0R7mFzd90tgvUvv3CQO0D.jpg", url:"https://themoviedb.org/person/64508"}}, {tmdbId:"67897", properties:{bornIn:"New York City, New York, USA", imdbId:"0437596", born:date('1944-12-16'), name:"Jeff Kanew", bio:"​From Wikipedia, the free encyclopedia.   \n\nJeffrey Roger Kanew (born December 16, 1944) is an American film director, writer and editor who early in his career made trailers for many films of the '70s and is probably best known for directing the film Revenge of the Nerds (1984). \n\nKanew directed Tough Guys (1986), the final film pairing actors Kirk Douglas and Burt Lancaster...", url:"https://themoviedb.org/person/67897"}}, {tmdbId:"6448", properties:{bornIn:"Philadelphia, Pennsylvania, United States", imdbId:"0671957", born:date('1922-09-27'), name:"Arthur Penn", bio:"Arthur Hiller Penn (September 27, 1922 – September 28, 2010) was an American director and producer, who is closely associated with the American New Wave.  He has won a Tony Award, and has been nominated for three Academy Awards, a Golden Globe Award, a BAFTA Award and two Primetime Emmy Awards...", died:date('2010-09-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/imHQBWO3DZXfcJM1CcPHsL28PyK.jpg", url:"https://themoviedb.org/person/6448"}}, {tmdbId:"21684", properties:{bornIn:"Daegu, South Korea", imdbId:"0094435", born:date('1969-09-14'), name:"Bong Joon-ho", bio:"Bong Joon-ho (Korean: 봉준호; born September 14, 1969) is a South Korean filmmaker of international prominence.  His films feature social themes, genre-mixing, black humor, and sudden mood shifts.  In 2017, Metacritic ranked Bong 13th on its list of the 25 best film directors of the 21st century...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tKLJBqbdH6HFj2QxLA5o8Zk7IVs.jpg", url:"https://themoviedb.org/person/21684"}}, {tmdbId:"96676", properties:{bornIn:"Newry, Northern Ireland", imdbId:"1119079", born:date('1977-01-07'), name:"Tomm Moore", bio:"From Wikipedia, the free encyclopedia. \n\nTomm Moore (born January 7, 1977) is an Irish illustrator, comics artist and filmmaker.  He is co-founder of Cartoon Saloon, an animation studio and production company, based in Kilkenny, Ireland. \n\nHis first feature film, The Secret of Kells, was nominated for an Academy Award for Best Animated Feature Film on February 2, 2010. \n\nDescription above from the Wikipedia article Tomm Moore, licensed under CC-BY-SA, full list of contributors on Wikipedia ...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n9RkD9jHgnJiLuGQa5HDqj08Xqd.jpg", url:"https://themoviedb.org/person/96676"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"81718", properties:{bornIn:"Nakaniikawa District, Toyama, Japan", imdbId:"0396074", born:date('1967-09-19'), name:"Mamoru Hosoda", bio:"Mamoru Hosoda (細田 守 Hosoda Mamoru, born September 19, 1967) is a Japanese film director and animator.  He started out working for Toei Animation, before moving to Madhouse in 2005.  He worked for Madhouse until 2011 when he decided to leave in order to establish Studio Chizu along with cofounder Yuichiro Saito...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/g4Bw177elSQ5BD3WFUK0BlP2qJo.jpg", url:"https://themoviedb.org/person/81718"}}, {tmdbId:"95901", properties:{bornIn:"Bailleul, France", imdbId:"0241622", born:date('1958-03-14'), name:"Bruno Dumont", bio:"From Wikipedia, the free encyclopedia. \n\nBruno Dumont (born 1958, Bailleul, France) is a French film director.  To date, he has directed ten feature films, all of which border somewhere between realistic drama and the avant-garde.  His films have won several awards at the Cannes Film Festival.  Two of Dumont's films have won the Grand Prix award: both L'Humanité (1999) and Flandres (2006)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/875Wtc5xf2R4cu3zKC8d5i7Xzto.jpg", url:"https://themoviedb.org/person/95901"}}, {tmdbId:"54451", properties:{bornIn:"New York City, New York, U.S.", imdbId:"0404606", born:date('1935-01-01'), name:"Brian G. Hutton", bio:"From Wikipedia, the free encyclopedia.  Brian G.  Hutton (born January 1, 1935 in New York City, New York)  was an American motion picture actor and director.  He gave up direction in the 1980s. \n\n Description above from the Wikipedia article Brian G.  Hutton, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2014-08-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/g4EfrSY84AejXDxQlXRqwVZrfz2.jpg", url:"https://themoviedb.org/person/54451"}}, {tmdbId:"14860", properties:{bornIn:"Birmingham, England, UK", imdbId:"0767701", born:date('1895-09-25'), name:"Victor Saville", bio:"From Wikipedia, the free encyclopedia. \n\nVictor Saville (25 September 1895, Birmingham, England – 8 May 1979, London) was an English film director, producer and screenwriter.  He directed 39 films between 1927 and 1954.  He also produced 36 films between 1923 and 1962. \n\nHe produced his first film, Woman to Woman, with Michael Balcon in 1923, and on the back of its success produced pictures for the veteran director Maurice Elvey, including the classic British silent Hindle Wakes (1927)...", died:date('1979-05-08'), url:"https://themoviedb.org/person/14860"}}, {tmdbId:"67919", properties:{bornIn:"Merksem, Belgique", imdbId:"0329679", born:date('1926-08-14'), name:"Ray Goossens", died:date('1998-12-10'), url:"https://themoviedb.org/person/67919"}}, {tmdbId:"67925", properties:{imdbId:"1387613", name:"Kazuhisa Takenôchi", url:"https://themoviedb.org/person/67925"}}, {tmdbId:"78014", properties:{bornIn:"Kurume, Fukuoka, Kyushu, Japan", imdbId:"0559535", born:date('1938-01-25'), name:"Leiji Matsumoto", url:"https://themoviedb.org/person/78014"}}, {tmdbId:"122186", properties:{bornIn:"Hiroshima Prefecture, Japan", imdbId:"0632788", born:date('1959-04-01'), name:"Daisuke Nishio", url:"https://themoviedb.org/person/122186"}}, {tmdbId:"2079911", properties:{name:"Hirotoshi Rissen", url:"https://themoviedb.org/person/2079911"}}, {tmdbId:"67941", properties:{imdbId:"1022334", name:"Hatsuki Tsuji", url:"https://themoviedb.org/person/67941"}}, {tmdbId:"6361", properties:{bornIn:"Belfast, Northern Ireland, UK", imdbId:"0358327", born:date('1957-12-10'), name:"Nick Hamm", url:"https://themoviedb.org/person/6361"}}, {tmdbId:"23799", properties:{bornIn:"Wermelskirchen, North Rhine-Westphalia, Germany", imdbId:"0093051", born:date('1965-06-22'), name:"Uwe Boll", bio:"Uwe Boll (German: [ˈuːvə ˈbɔl]; born June 22, 1965) is a German restaurateur and a former filmmaker.  He financed his own films through his production companies Boll KG and Event Film Productions.  Many of his films were produced on low budgets and Boll himself had backed his projects financially or made use of crowdfunding platforms...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6Rf29Z2LaYctdUZeyzyXf41p6Ih.jpg", url:"https://themoviedb.org/person/23799"}}, {tmdbId:"30038", properties:{bornIn:"San Antonio, Texas", imdbId:"0429958", born:date('1936-04-05'), name:"Glenn Jordan", bio:"From Wikipedia, the free encyclopedia. \n\nGlenn Jordan (born April 5, 1936) is an award-winning American television director and producer. \n\nBorn in San Antonio, Texas, Jordan directed multiple episodes of Family and has helmed numerous television movies, several based on real persons as diverse as Benjamin Franklin, George Armstrong Custer, Lucille Ball, Christa McAuliffe, and Karen Ann Quinlan...", url:"https://themoviedb.org/person/30038"}}, {tmdbId:"26479", properties:{imdbId:"0934093", name:"S. S. Wilson", bio:"​From Wikipedia, the free encyclopedia. \n\nS. S.  Wilson is a writer of cult and mainstream science fiction, and is probably best known for writing (and occasionally directing), with writing partner Brent Maddock, the Tremors film and television series. \n\nDescription above from the Wikipedia article S. S...", url:"https://themoviedb.org/person/26479"}}, {tmdbId:"51677", properties:{bornIn:"New York City, New York, USA", imdbId:"0235066", born:date('1907-12-15'), name:"Gordon Douglas", bio:"​From Wikipedia, the free encyclopedia\n\nGordon Douglas (December 15, 1907 – September 29, 1993) was an American film director, who directed many different genres of films over the course of a five-decade career in motion pictures.  He was a native of New York City. \n\nDescription above from the Wikipedia article Gordon Douglas (director), licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1993-09-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i1H3zri4XyFNK7i2dTTr2PiQXkK.jpg", url:"https://themoviedb.org/person/51677"}}, {tmdbId:"17282", properties:{bornIn:"Yao, Japan", imdbId:"0586281", born:date('1960-08-24'), name:"Takashi Miike", bio:"Takashi Miike  (三池 崇史 Miike Takashi, born August 24, 1960) is a highly prolific and controversial Japanese filmmaker.  He has directed over seventy theatrical, video, and television productions since his debut in 1991.  In the years 2001 and 2002 alone, Miike is credited with directing fifteen productions.  His films range from violent and bizarre to dramatic and family-friendly...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2teAPqDO4ZsITT5pnbdHKnqENuE.jpg", url:"https://themoviedb.org/person/17282"}}, {tmdbId:"68212", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0050597", born:date('1937-10-14'), name:"Carroll Ballard", bio:"​From Wikipedia, the free encyclopedia\n\nCarroll Ballard (born October 14, 1937, in Los Angeles) is an American film director. \n\nHe started out making documentaries for the U. S.  information agency, Beyond This Winter's Wheat (1965) and Harvest (1967); the latter was nominated for an Academy Award.  He also made the documentaries The Perils of Priscilla (1969), and Rodeo (1970). \n\nHe was second unit director on George Lucas' Star Wars for which he handled many of the outdoor desert scenes...", url:"https://themoviedb.org/person/68212"}}, {tmdbId:"40256", properties:{bornIn:"Norwalk, Connecticut, USA", imdbId:"0142286", born:date('1965-01-17'), name:"D.J. Caruso", bio:"Daniel John \"D. J. \" Caruso (born January 17, 1965) is an American director and producer.  Caruso has directed the films Disturbia, Two for the Money, Taking Lives, The Salton Sea, and Eagle Eye.  He has also directed television episodes for shows such as The Shield, Over There, Smallville, and Dark Angel.  He directed his first music video in 2007 for the song \"Don't Make Me Wait\" by This World Fair.  He was also a guest judge on the FOX reality show On the Lot for the episode of May 28/29...", url:"https://themoviedb.org/person/40256"}}, {tmdbId:"68085", properties:{bornIn:"Budapest, Hungary", imdbId:"0776209", born:date('1939-09-19'), name:"Carl Schultz", bio:"​From Wikipedia, the free encyclopedia.   \n\nCarl Schultz (b.  September 19, 1939) is a Hungarian film director. \n\nDescription above from the Wikipedia article Carl Schultz, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/68085"}}, {tmdbId:"4027", properties:{bornIn:"Montbéliard, Doubs, France", imdbId:"0001104", born:date('1959-01-28'), name:"Frank Darabont", bio:"Frank Darabont (born January 28, 1959) is a Hungarian-American film director, screenwriter and producer who has been nominated for three Academy Awards and a Golden Globe.  He was born in France by Hungarian parents who fled Budapest during the 1956 uprising, but the family moved to Los Angeles while he was still an infant.  He has directed the films The Shawshank Redemption, The Green Mile, and The Mist, all based on stories by Stephen King...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6U1eHg30snkOhSM9WJT2asAesR9.jpg", url:"https://themoviedb.org/person/4027"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"1255", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0000519", born:date('1947-11-30'), name:"David Mamet", bio:"​From Wikipedia, the free encyclopedia.   \n\nDavid Alan Mamet (born November 30, 1947) is an American playwright, essayist, screenwriter and film director.  Best known as a playwright, Mamet has won a Pulitzer Prize, and Tony nominations for Glengarry Glen Ross (1984) and Speed-the-Plow (1988).  As a screenwriter, he received Oscar nominations for The Verdict (1982) and Wag the Dog (1997)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3Hfebpi4fRSY0lciWUc355ylP6j.jpg", url:"https://themoviedb.org/person/1255"}}, {tmdbId:"6349", properties:{bornIn:"New York City, New York, USA", imdbId:"0001587", born:date('1928-04-07'), name:"Alan J. Pakula", bio:"Alan Jay Pakula was an American film director, writer and producer.  He was nominated for three Academy Awards: Best Picture for To Kill a Mockingbird (1962), Best Director for All the President's Men (1976) and Best Adapted Screenplay for Sophie's Choice (1982). \n\nPakula was also notable for directing his \"paranoia trilogy\": All the President's Men, Klute (1971), and The Parallax View (1974). \n\nPakula started his Hollywood career as an assistant in the cartoon department at Warner Brothers...", died:date('1998-11-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aXyDkJW8xfzrySAegmSXlL1fTFX.jpg", url:"https://themoviedb.org/person/6349"}}, {tmdbId:"78118", properties:{bornIn:"Kiev, Ukrainian SSR, USSR [now Ukraine]", imdbId:"1166926", name:"Vadim Perelman", bio:"From Wikipedia, the free encyclopedia\n\nVadim Perelman (born 1963) is a Ukrainian-American film director.  Perelman made his feature film directorial debut in 2003 with House of Sand and Fog, following a successful career as a commercial director.  The film, nominated for three Academy Awards, also marks his first screenplay credit.  Perelman was drawn to the story, having been shaped by his own immigrant experience...", url:"https://themoviedb.org/person/78118"}}, {tmdbId:"122583", properties:{imdbId:"0330057", name:"Bryan Gordon", bio:"From Wikipedia, the free encyclopedia.   Bryan Gordon is a television and film director and writer.  He has been nominated three times for the Directors Guild of America Award and in 2002 received the Directors Guild award for comedy directing.  He’s been nominated for an Emmy twice – both for his work on the HBO series Curb Your Enthusiasm, which he continues to direct now in its eighth season...", url:"https://themoviedb.org/person/122583"}}, {tmdbId:"14614", properties:{bornIn:"München, Germany", imdbId:"0005917", born:date('1939-01-24'), name:"Joseph Vilsmaier", died:date('2020-02-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wODSEku2wnqYiDfMKiANzX5bE2K.jpg", url:"https://themoviedb.org/person/14614"}}, {tmdbId:"54590", properties:{imdbId:"0711114", name:"Steve Rash", bio:"​From Wikipedia, the free encyclopedia.   \n\nSteve Rash is an American film director and producer best known for directing such films as The Buddy Holly Story, Can't Buy Me Love, and Queens Logic. \n\nDescription above from the Wikipedia article Steve Rash, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/t7sZbMXWCHp80p5tPFTnsPY037h.jpg", url:"https://themoviedb.org/person/54590"}}, {tmdbId:"25558", properties:{bornIn:"Hastings, Sussex, England", imdbId:"0149548", born:date('1917-08-05'), name:"Don Chaffey", died:date('1990-11-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q9Ge3VgjSZJy7Fxsz5P0se8gA8v.jpg", url:"https://themoviedb.org/person/25558"}}, {tmdbId:"19457", properties:{bornIn:"Montréal, Québec, Canada", imdbId:"0733476", born:date('1913-12-04'), name:"Mark Robson", bio:"​From Wikipedia, the free encyclopedia. \n\nMark Robson (4 December 1913 – 20 June 1978) was a Canadian-born film editor, film director and producer in Hollywood...", died:date('1978-06-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hBBoVee817gsFCocoUz0Zolz7zF.jpg", url:"https://themoviedb.org/person/19457"}}, {tmdbId:"7722", properties:{imdbId:"0627159", born:date('1957-08-24'), name:"Edward Neumeier", bio:"From Wikipedia, the free encyclopedia\n\nEdward Neumeier (often credited as just Ed Neumeier) (born 1957) is a screenwriter best known for his work on the science fiction movies RoboCop and Starship Troopers.  He wrote the latter's sequel, and most recently wrote and directed Starship Troopers 3: Marauder. \n\nNeumeier studied journalism at the University of California at Santa Cruz then attended the School of Motion Picture and Television at University of California at Los Angeles (UCLA)...", url:"https://themoviedb.org/person/7722"}}, {tmdbId:"46297", properties:{bornIn:"North Little Rock, Arkansas, USA", imdbId:"0751221", born:date('1960-01-10'), name:"Jay Russell", bio:"From Wikipedia, the free encyclopedia.   Jay Russell (born January 10, 1960 in North Little Rock, Arkansas), is a film director and also executive producer and director of the film My Dog Skip. \n\nHis other directing credits include Tuck Everlasting, Ladder 49 and The Water Horse.  He has also written and directed End of the Line. \n\nRussell graduated from Columbia University in 1984 with a MFA in screenwriting and directing, having studied with producer Michael Hausman and director Milos Forman...", url:"https://themoviedb.org/person/46297"}}, {tmdbId:"58628", properties:{bornIn:"Rhyl, Flintshire, Wales, UK", imdbId:"0837406", born:date('1962-10-13'), name:"Sara Sugarman", bio:"Sara Sugarman is a Welsh film actress, director and writer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/verrUEG4Ij3SOpUrQn5CpoKNF9z.jpg", url:"https://themoviedb.org/person/58628"}}, {tmdbId:"18069", properties:{bornIn:"London, England, UK", imdbId:"0001270", born:date('1944-09-22'), name:"Brian Gibson", bio:"From Wikipedia, the free encyclopedia. \n\nBrian Gibson (22 September 1944 — 4 January 2004) was an English film director. \n\nBorn in Reading, Berkshire, he studied Natural Sciences at St.  Catharine's College, Cambridge graduating with an upper-second, and then History of Science at Darwin College, Cambridge.  He intended to become a doctor, but became interested in journalism and edited Granta, the Cambridge University magazine...", died:date('2004-01-04'), url:"https://themoviedb.org/person/18069"}}, {tmdbId:"44916", properties:{bornIn:"Hong Kong", imdbId:"0867262", born:date('1960-04-07'), name:"Stanley Tong", bio:"​From Wikipedia, the free encyclopedia. \n\nStanley Tong (born April 7, 1960 in Hong Kong) is a film director from Hong Kong. \n\nAccording to IMDb , he customarily attempts stunts himself before asking actors to risk themselves.  For example, Jackie Chan's leap from a parking garage roof to a fire escape in Rumble in the Bronx and the finale of Stone Age Warriors...", url:"https://themoviedb.org/person/44916"}}, {tmdbId:"63713", properties:{bornIn:"New Haven, Connecticut, USA", imdbId:"0004838", born:date('1946-08-17'), name:"Martha Coolidge", bio:"​From Wikipedia, the free encyclopedia.   \n\nMartha Coolidge (born August 17, 1946) is an American film director and former President of the Directors Guild of America. \n\nDescription above from the Wikipedia article Martha Coolidge, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tJyj0LOfbsmKJRdHTJXW6kYX9nn.jpg", url:"https://themoviedb.org/person/63713"}}, {tmdbId:"18899", properties:{bornIn:"Guangzhou, China", imdbId:"0950759", born:date('1945-01-01'), name:"Yuen Woo-ping", bio:"Yuen Woo-ping is a Chinese martial arts choreographer and film director, renowned as one of the most successful and influential figures in the world of Hong Kong action cinema.  He is one of the inductees on the Avenue of Stars in Hong Kong.  Yuen is also a son of Yuen Siu-tien, a renowned martial arts film actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ddqWe3MHafVmUHIhclSSGsvbtPp.jpg", url:"https://themoviedb.org/person/18899"}}, {tmdbId:"69309", properties:{bornIn:"Buenos Aires, Argentina", imdbId:"0699932", born:date('1976-11-28'), name:"Lucía Puenzo", bio:"Lucía Puenzo (born 28 November 1973) in Buenos Aires) is an Argentinian author and film director.  She is the daughter of Luis Puenzo.  She studied literature at the University of Buenos Aires followed by the National Film Institute (INCAA).  In 2007 Puenzo directed her first film XXY.  The film won several awards including three awards at the 2008 Argentine Film Critics Association Awards and the 2008 Goya award for best for Best Spanish Language Foreign Film...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7QFPCMOCTf9ujWeP0oM8cWGwLh0.jpg", url:"https://themoviedb.org/person/69309"}}, {tmdbId:"68352", properties:{imdbId:"2127650", born:date('1971-09-06'), name:"Carter Smith", bio:"Maine-native Carter Smith began his career in the world of fashion photography.  His breakthrough story included a series of gritty, documentary-style portraits of teen life in the Midwest, which appeared in the British magazine ID.  His fashion work and celebrity portraits have since been featured in The New York Times Magazine, Vogue, GQ, and W, all photographed in the cinematic style that has become Carter's signature...", url:"https://themoviedb.org/person/68352"}}, {tmdbId:"53861", properties:{bornIn:"Philadelphia", imdbId:"0782384", born:date('1952-12-11'), name:"Susan Seidelman", bio:"​From Wikipedia, the free encyclopedia\n\nSusan Seidelman (born December 11, 1952, Philadelphia) is an American director, producer, writer, and actress. \n\nDescription above from the Wikipedia article Susan Seidelman, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zIAhyxmBaAhHVXWbl9YuAfr0JV7.jpg", url:"https://themoviedb.org/person/53861"}}, {tmdbId:"15488", properties:{bornIn:"Nuneaton, Warwickshire, England, UK", imdbId:"0516360", born:date('1936-06-17'), name:"Ken Loach", bio:"Kenneth \"Ken\" Loach is an English film and television director. \n\nHe is known for his naturalistic, social realist directing style and for his socialist beliefs, which are evident in his film treatment of social issues such as homelessness (Cathy Come Home) and labour rights (Riff-Raff)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vGtkrPgNeK3xkbbKTQ4vWD1VsEm.jpg", url:"https://themoviedb.org/person/15488"}}, {tmdbId:"2087", properties:{bornIn:"Brooklyn, New York City, New York, USA", imdbId:"0281507", born:date('1916-12-08'), name:"Richard Fleischer", bio:"From Wikipedia, the free encyclopedia. \n\nRichard O.  Fleischer (December 8, 1916 – March 25, 2006) was an American film director. \n\nFleischer was born in Brooklyn, the son of Essie (née Goldstein) and animator/producer Max Fleischer.  After graduating from Brown University, he went to Yale School of Drama, where he met his future wife, Mary Dickson. \n\nHis film career began in 1942 at the RKO studio, directing shorts, documentaries, and compilations of forgotten silent features...", died:date('2006-03-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4vGOm5YKFEY5kSDUFV6e9VRq40g.jpg", url:"https://themoviedb.org/person/2087"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"68412", properties:{bornIn:"Kobe, Hyōgo, Japan", imdbId:"0557927", born:date('1927-10-05'), name:"Toshio Masuda", bio:"Toshio Masuda (born October 5, 1927 in Kobe, Hyōgo, Japan) is a Japanese film director.  He developed a reputation as a consistent box office hit-maker.  Over the course of five decades, 16 of his films made the yearly top ten lists at the Japanese box office—a second place record in the industry.  Between 1958 and 1968 he directed 52 films for the Nikkatsu Company...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pUEXPvKBl6BFIKAcDpknXlJn2Xn.jpg", url:"https://themoviedb.org/person/68412"}}, {tmdbId:"19224", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0000777", born:date('1959-12-17'), name:"Gregg Araki", bio:"Gregg Araki (born December 17, 1959) is an American film director of independent and gay films.  He is also part of the New Queer Cinema...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zwsni7JgMLOSZRZs5LwpDkortdx.jpg", url:"https://themoviedb.org/person/19224"}}, {tmdbId:"18323", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0492909", born:date('1959-10-22'), name:"Marc Lawrence", bio:"From Wikipedia, the free encyclopedia. \n\nMarc Lawrence (born 22 October 1959) is a Jewish American screenwriter, film producer and film director.  In 1981, he graduated from Binghamton University with a degree in English and later served as a staff writer, and then supervising producer, on NBC's Family Ties.  Lawrence has written films such as The Out-of-Towners (1999), Miss Congeniality (2000), and Miss Congeniality 2: Armed and Fabulous (2005)...", url:"https://themoviedb.org/person/18323"}}, {tmdbId:"19684", properties:{bornIn:"Brede, Denmark", imdbId:"0000806", born:date('1948-11-09'), name:"Bille August", bio:"​From Wikipedia, the free encyclopedia. \n\nBille August  (born November 9, 1948) is a Danish Academy Award winning film and television director.  His film Pelle the Conqueror from 1987 won the Palme D'or, Academy Award and Golden Globe.  He is one of the very few directors to win the Palme D'or twice, winning the prestigious award again in 1991 for The Best Intentions, based on the autobiographical script by Ingmar Bergman.  He was married to Swedish actress Pernilla August from 1991 to 1997...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cBau5curUxUfgj0H8o35OxOOS4F.jpg", url:"https://themoviedb.org/person/19684"}}, {tmdbId:"39012", properties:{bornIn:"Kingston, New York, USA", imdbId:"0000953", born:date('1939-07-30'), name:"Peter Bogdanovich", bio:"From Wikipedia, the free encyclopedia\n\nPeter Bogdanovich (born July 30, 1939) is an American director, writer, actor, producer, critic and film historian.  He is part of the wave of \"New Hollywood\" directors, and his most critically acclaimed and well-known film is the drama The Last Picture Show (1971).  Bogdanovich also directed Targets (1968), What's Up, Doc? (1972), Paper Moon (1973), They All Laughed (1981), Mask (1985), The Cat's Meow (2001), and She's Funny That Way (2014)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/m3aMMYzzEbqKEwGOyEPq7Rt1gAj.jpg", url:"https://themoviedb.org/person/39012"}}, {tmdbId:"63429", properties:{bornIn:"Suwon, Gyeonggi, South Korea", imdbId:"1030706", born:date('1959-05-22'), name:"Kwak Jae-yong", bio:"Kwak Jae-yong is a South Korean film director and screenwriter.  He studied physics at Kyung Hee University.  He achieved success with his debut film Watercolor Painting in a Rainy Day in 1989, but the failure of his next two movies led to eight years of unemployment before a comeback with the smash-hit film My Sassy Girl in 2001.  He is known for his limitless fondness of love stories set in a mix of different genres...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8hJHvwdhKvOfzW6Vo5S2W6Qy8mE.jpg", url:"https://themoviedb.org/person/63429"}}, {tmdbId:"133259", properties:{bornIn:"Edmonton, Alberta, Canada", imdbId:"0002137", born:date('1923-11-22'), name:"Arthur Hiller", bio:"From Wikipedia, the free encyclopedia.   \n\nArthur Hiller, OC,  was a Canadian-American television and film director, having directed over 33 films during his 50-year career.  He began his career directing television in Canada and later in the U. S.  By the late 1950s he began directing films, most often comedies.  He also directed dramas and romantic subjects, such as Love Story (1970), which was nominated for seven Oscars...", died:date('2016-08-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eqFlaHk5yZbDqJENHj0lIfC7Toh.jpg", url:"https://themoviedb.org/person/133259"}}, {tmdbId:"65678", properties:{bornIn:"USA", imdbId:"0480843", born:date('1957-04-02'), name:"John Lafia", bio:"From Wikipedia, the free encyclopedia.    \n\nJohn Lafia (April 2, 1957 - April 29, 2020) was an American film and television writer, director, and producer.  He attended UCLA, where he received his Bachelors in Film.  Lafia's first film was The Blue Iguana, which he wrote and directed.  It was also screened out of competition at the 1988 Cannes Film Festival...", died:date('2020-04-29'), url:"https://themoviedb.org/person/65678"}}, {tmdbId:"28976", properties:{bornIn:"U.S.A", imdbId:"0070474", born:date('1949-09-25'), name:"Jack Bender", bio:"​From Wikipedia, the free encyclopedia. \n\nJack Bender is an American television and film director, actor, television producer and also a screenwriter.  Bender was an executive producer and lead director on the ABC television series, Lost.  He directed the series finale of Lost.  Bender has also directed on other popular shows such as The Sopranos, Carnivàle, Alias and Boston Public.  He has recently signed to direct Syfy's new pilot Alphas...", url:"https://themoviedb.org/person/28976"}}, {tmdbId:"68519", properties:{bornIn:"Novosibirsk, Russia", imdbId:"1168657", born:date('1964-02-06'), name:"Andrey Zvyagintsev", bio:"Andrey Petrovich Zvyagintsev (born 6 February 1964) is a Russian film director and screenwriter.  His film The Return (2003) won him a Golden Lion at the Venice Film Festival.  Following The Return, Zvyagintsev directed The Banishment and Elena (2011).  His film Leviathan (2014) was nominated for the Academy Award for Best Foreign Film in 2014 and won the Best Film award at the Asia Pacific Screen Awards...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gpPbV0ExY474xSW0dY9fHWw7PhQ.jpg", url:"https://themoviedb.org/person/68519"}}, {tmdbId:"17350", properties:{bornIn:"Glasgow, Scotland, UK", imdbId:"0531817", born:date('1967-10-28'), name:"Kevin Macdonald", bio:"​From Wikipedia, the free encyclopedia.   \n\nKevin Macdonald (born October 28, 1967) is a Scottish director, best known for his films One Day in September, State of Play, The Last King of Scotland and Touching the Void. \n\nDescription above from the Wikipedia article Kevin Macdonald (director), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/40P6puNsdMx2ov6bQnZUZ867O3j.jpg", url:"https://themoviedb.org/person/17350"}}, {tmdbId:"29605", properties:{bornIn:"Lund, Skåne län, Sweden", imdbId:"0405632", born:date('1960-07-01'), name:"Mikael Håfström", bio:"Jan Mikael Håfstrom, born 1 July 1960 in Lund, is a\n\nSwedish director and screenwriter.  Håfstrom studied film in Stockholm and New\n\nYork.  After graduation, he worked as an assistant director on the Swedish\n\nchannel, SVT 1 and as a screenwriter.  He was awarded a Guldbaggegatan 2002\n\nscreenplay \"Leva Livet\".   Description above from the Wikipedia article Mikael\n\nHåfström, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7zOeNtAlm2aSz1ku5fcsuBFG46j.jpg", url:"https://themoviedb.org/person/29605"}}, {tmdbId:"68573", properties:{bornIn:"Hollywood, California, US", imdbId:"0065608", born:date('1968-09-16'), name:"Walt Becker", bio:"From Wikipedia, the free encyclopedia.   Walter William Becker (born September 16, 1968) is an American director, writer and actor best known for directing the films Van Wilder and Wild Hogs. \n\nBecker graduated from USC School of Cinema-Television in 1995.  He also wrote the novel Link in 1999.  He has a son and a daughter with his wife, Lindsay...", url:"https://themoviedb.org/person/68573"}}, {tmdbId:"1176", properties:{bornIn:"Copenhagen, Denmark", imdbId:"0771054", born:date('1959-05-02'), name:"Lone Scherfig", bio:"From Wikipedia, the free encyclopedia. \n\nLone Scherfig (born May 2, 1959) is a Danish film director.  She graduated Danish Film School in 1984, and began her career as a director with Kaj's fødselsdag \"A Birthday Trip\".  She made her mark with the Dogme95-film, Italian for Beginners (Italiensk for begyndere, 2000), a romantic comedy which among its many international awards won the Silver Berlin Bear (Jury Prize) at the 2001 Berlin International Film Festival...", url:"https://themoviedb.org/person/1176"}}, {tmdbId:"13265", properties:{bornIn:"Tokyo, Japan", imdbId:"0769874", born:date('1920-05-30'), name:"Franklin J. Schaffner", bio:"Franklin James Schaffner (May 30, 1920 – July 2, 1989) was an American director.  He won the Academy Award for Best Director for Patton (1970), and is also known for the films Planet of the Apes (1968), Nicholas and Alexandra (1971), Papillon (1973), and The Boys from Brazil (1978).  He served as President of the Directors Guild of America between 1987 and 1989...", died:date('1989-07-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/m04NRi0fxmE3xBZMwnIkpkjItBe.jpg", url:"https://themoviedb.org/person/13265"}}, {tmdbId:"9855", properties:{bornIn:"Shanghai, China", imdbId:"0950109", born:date('1915-06-20'), name:"Terence Young", bio:"From Wikipedia, the free encyclopedia\n\nStewart Terence Herbert Young (20 June 1915 – 7 September 1994) was a British film director best known for directing three films in the James Bond series, Dr.  No (1962), From Russia with Love (1963), and Thunderball (1965). \n\nBorn in Shanghai, China, he was public-school educated.  Like the fictional James Bond, he read oriental history at St Catharine's College in the University of Cambridge...", died:date('1994-09-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cg7bWAN25ggEWlISzu51U6jSvBi.jpg", url:"https://themoviedb.org/person/9855"}}, {tmdbId:"2291", properties:{bornIn:"Bellshill, Scotland, UK", imdbId:"0006476", born:date('1963-09-19'), name:"Paul McGuigan", bio:"Paul McGuigan (born 19 September 1963) is a Scottish film and television director...", url:"https://themoviedb.org/person/2291"}}, {tmdbId:"56059", properties:{bornIn:"Wadsworth, Illinois, USA", imdbId:"0425957", born:date('1962-05-07'), name:"Patrick Read Johnson", bio:"​Patrick Read Johnson is an American film director, producer, and writer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oOapCW2aZTGnyJCezk6dlpBAf66.jpg", url:"https://themoviedb.org/person/56059"}}, {tmdbId:"55117", properties:{imdbId:"0109165", born:date('1982-06-08'), name:"Matthew Bright", bio:"From Wikipedia, the free encyclopedia\n\nMatthew Bright (born June 8, 1952) is an American film director, writer and actor. \n\nHis first noted credits were as writer and actor in the 1982 film Forbidden Zone, portraying the twins Squeezit and René Henderson.  The film includes his two masochistic characters living in a garbage can, spit on, raped and tortured in an alternate dimension's kingdom and decapitated by Satan (played by Danny Elfman).  Bright was credited as Toshiro Boloney...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/81daFZEddMlwHTctHEi2BNNI73s.jpg", url:"https://themoviedb.org/person/55117"}}, {tmdbId:"366", properties:{bornIn:"New York City, New York, USA", imdbId:"0003506", born:date('1963-12-16'), name:"James Mangold", bio:"James Mangold (born 16 December 1963) is an American film director and screenwriter.  He is perhaps best known for Walk the Line (2005) which he co-wrote and directed...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pk0GDjn99crNwR4qgCCEokDYd71.jpg", url:"https://themoviedb.org/person/366"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"8686", properties:{bornIn:"London - England - UK", imdbId:"0315065", born:date('1966-01-01'), name:"Sacha Gervasi", bio:"From Wikipedia, the free encyclopedia. \n\nSacha Gervasi (b.  1966) is a British journalist, screenwriter and award-winning director of films...", url:"https://themoviedb.org/person/8686"}}, {tmdbId:"68682", properties:{bornIn:"Yekaterinoslav, Ukrainian SSR, Soviet Union", imdbId:"0755963", born:date('1917-10-18'), name:"Boris Sagal", bio:"From Wikipedia, the free encyclopedia.   Boris Sagal (October 18, 1923 - May 22, 1981) was a Russian-born American television and film director. \n\n \n\nDescription above from the Wikipedia article Boris Sagal, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1981-05-22'), url:"https://themoviedb.org/person/68682"}}, {tmdbId:"68687", properties:{bornIn:"Glasgow, Scotland", imdbId:"0287025", born:date('1946-07-29'), name:"Bill Forsyth", bio:"​From Wikipedia, the free encyclopedia\n\nBill Forsyth (born 29 July 1946, Glasgow) is a Scottish film director and writer, noted for his commitment to national film-making.  Forsyth first came to attention with a low-budget film, That Sinking Feeling, made with youth theatre actors and featuring a cameo appearance by the Edinburgh gallery owner Richard Demarco.  The relative success of the film was carried to a far higher level by his next film Gregory's Girl in 1981...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5rzQOU4qQ4kMiemsvF2FZf6KKQ2.jpg", url:"https://themoviedb.org/person/68687"}}, {tmdbId:"1128", properties:{bornIn:"Warsaw, Mazowieckie, Poland", imdbId:"0002140", born:date('1948-11-28'), name:"Agnieszka Holland", bio:"From Wikipedia, the free encyclopedia\n\nAgnieszka Holland (born November 28, 1948) is a Polish film and TV director and screenwriter.  Best recognized for her highly political contributions to Polish cinema, Holland is one of Poland's most prominent filmmakers. \n\nDescription above from the Wikipedia article Agnieszka Holland, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/t7OOYOMIre88LLiWYepg8XnF9FD.jpg", url:"https://themoviedb.org/person/1128"}}, {tmdbId:"56852", properties:{imdbId:"0832309", born:date('1952-05-28'), name:"Tad Stones", bio:"​From Wikipedia, the free encyclopedia.   \n\nTad Stones (born c. 1952 in Burbank, California) is an American animator, screenwriter, producer and director best known for his work for The Walt Disney Company, where he worked from 1974 to 2003.  His most notable credits for Disney include creating, writing and producing the animated series Darkwing Duck and producing Chip 'n Dale Rescue Rangers, Disney's Adventures of the Gummi Bears, Aladdin and Buzz Lightyear of Star Command...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mMIS8tPnAmNXoyDzFw3p6P7gpbE.jpg", url:"https://themoviedb.org/person/56852"}}, {tmdbId:"68707", properties:{bornIn:" Tokyo, Japan", imdbId:"0839397", born:date('1956-10-29'), name:"Masayuki Suo", bio:"Japanese film director and writer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4A2CECBoHNdo1hbJzsjLLIE4cWM.jpg", url:"https://themoviedb.org/person/68707"}}, {tmdbId:"525", properties:{bornIn:"Westminster, London, England, UK", imdbId:"0634240", born:date('1970-07-30'), name:"Christopher Nolan", bio:"Christopher Edward Nolan, CBE (born 30 July 1970) is a British-American film director, screenwriter, and producer.  He was born in Westminster, London, England and holds both British and American citizenship due to his American mother.  He is known for writing and directing critically acclaimed films such as Memento (2000), The Prestige (2006), The Dark Knight Trilogy (2005-12), Inception (2010), Interstellar (2014) and Dunkirk (2017).  Nolan is the founder of the production company Syncopy Films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iG0Gs0i5yd6SG4tSFjlXi5ZnSX6.jpg", url:"https://themoviedb.org/person/525"}}, {tmdbId:"68732", properties:{imdbId:"0783676", name:"Arna Selznick", bio:"​From Wikipedia, the free encyclopedia.   \n\nArna Selznick is a Canadian Director and Artist, known for directing Nelvana's 1985 animated film The Care Bears Movie.  She is one of only four women to have directed a full length animated feature.  She owns and operates a studio called dancingmonkeys with her partner John van Bruggen. \n\nDescription above from the Wikipedia article Arna Selznick, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/68732"}}, {tmdbId:"68770", properties:{imdbId:"0743093", name:"Mark Rosman", bio:"​From Wikipedia, the free encyclopedia.   \n\nMark Rosman (born 1959) is an American film director. \n\nDescription above from the Wikipedia article Mark Rosman, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/68770"}}, {tmdbId:"30149", properties:{bornIn:"Copenhagen, Denmark", imdbId:"0004121", born:date('1945-02-24'), name:"Mikael Salomon", bio:"From Wikipedia, the free encyclopedia.   Mikael Salomon (born February 24, 1945 in Copenhagen, Denmark) is a Danish filmmaker, cinematographer of The Abyss (1989) and Backdraft (1991), and director of Band of Brothers (2001). \n\nAfter a long cinematography career in Danish cinema, he went to Hollywood in the late 1980s and has remained highly prolific there, first as cinematographer, later as television director.  He has been Oscar nominated twice...", url:"https://themoviedb.org/person/30149"}}, {tmdbId:"53177", properties:{bornIn:"Brooklyn, New York, U.S.", imdbId:"0005367", born:date('1963-11-22'), name:"Brian Robbins", bio:"​From Wikipedia, the free encyclopedia.   \n\nBrian Robbins (born November 22, 1963) is an American actor and producer, director and screenwriter.  He often collaborates with Mike Tollin. \n\nDescription above from the Wikipedia article Brian Robbins, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/53177"}}, {tmdbId:"56591", properties:{imdbId:"0500444", name:"Danny Leiner", bio:"From Wikipedia, the free encyclopedia. \n\nDanny Leiner is a film director whose credits include The Great New Wonderful, Harold &amp; Kumar Go to White Castle, Dude, Where's My Car?, Layin' Low, and Time Expired.  He has also directed a wide range of television including Arrested Development, Everwood, Gilmore Girls, Freaks and Geeks, Sports Night, Felicity, Action, The Tick, MTV's Austin Stories and HBO's Mind of the Married Man, The Sopranos and How to Make It in America...", url:"https://themoviedb.org/person/56591"}}, {tmdbId:"56891", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0003080", born:date('1958-08-16'), name:"Rachel Talalay", bio:"From Wikipedia, the free encyclopedia.  Rachel Talalay is a film and television screenwriter, director and producer. \n\nDescription above from the Wikipedia article Rachel Talalay, licensed under CC-BY-SA,full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/56891"}}, {tmdbId:"40549", properties:{bornIn:"Glace Bay, Canada", imdbId:"0677951", born:date('1920-11-26'), name:"Daniel Petrie", bio:"From Wikipedia, the free encyclopedia.   Daniel Mannix Petrie  (November 26, 1920 - August 22, 2004) was a Canadian television and movie director. \n\nPetrie was born in Glace Bay, Nova Scotia, Canada, the son of Mary Anne (née Campbell) and William Mark Petrie, a soft-drink manufacturer.   He moved to the United States in 1945.   One of his most famous credits was 1961's A Raisin in the Sun, which was nominated for the Golden Palm award at the Cannes Film Festival...", died:date('2004-08-22'), url:"https://themoviedb.org/person/40549"}}, {tmdbId:"5306", properties:{bornIn:"Stockholm, Sweden", imdbId:"0002120", born:date('1946-06-02'), name:"Lasse Hallström", bio:"Lars Sven \"Lasse\" Hallström is a Swedish film director.  He was nominated for an Academy Award for Best Director for My Life as a Dog (Mitt liv som hund) (1985) and later for The Cider House Rules (1999).  Hallström learned his craft making music videos, in particular for the group ABBA.  Since the international success of My Life as a Dog (1985), for which he was nominated for Academy Awards for writing and directing, Hallström has worked in American movies...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zEz9LphkDBcGAAYGdjIU5QzjB9C.jpg", url:"https://themoviedb.org/person/5306"}}, {tmdbId:"56342", properties:{bornIn:"Kyoto, Kyoto Prefecture, Japan", imdbId:"0913860", born:date('1965-05-24'), name:"Shinichiro Watanabe", bio:"Shinichirō Watanabe (渡辺 信一郎 Watanabe Shin'ichirō, born May 24, 1965) is a Japanese anime television and film director.  He is best known for directing the critically acclaimed and commercially successful anime series Cowboy Bebop, Samurai Champloo, and Space Dandy. \n\nWatanabe is known for incorporating multiple genres into his anime creations...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5S0Wt96OfG2nH3DGBdMIMAQpWhP.jpg", url:"https://themoviedb.org/person/56342"}}, {tmdbId:"16294", properties:{bornIn:"Baldwin, Long Island, New York, USA", imdbId:"0001129", born:date('1944-02-22'), name:"Jonathan Demme", bio:"Robert Jonathan Demme (February 22, 1944 – April 26, 2017) was an American filmmaker, producer and screenwriter.  He was best known for directing The Silence of the Lambs, which won him the Academy Award for Best Director.  He later directed the acclaimed films Philadelphia (1993) and Rachel Getting Married (2008). \n\nOn April 26, 2017, Demme died at the age of 73 in Manhattan due to complications from esophageal cancer and heart disease...", died:date('2017-04-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hm4wkbBOKaeLwMIk51hZ06OUkW3.jpg", url:"https://themoviedb.org/person/16294"}}, {tmdbId:"4429", properties:{bornIn:"Akron, Ohio, USA", imdbId:"0000464", born:date('1953-01-22'), name:"Jim Jarmusch", bio:"James R.  \"Jim\" Jarmusch is an American independent film director, screenwriter, actor, producer, editor and composer.  Jarmusch has been a major proponent of independent cinema, particularly during the 1980s and 1990s...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bKtWli68IA7mFygxaobAAQcu5Z9.jpg", url:"https://themoviedb.org/person/4429"}}, {tmdbId:"9577", properties:{bornIn:"New York City, New York, USA", imdbId:"0001351", born:date('1921-12-20'), name:"George Roy Hill", bio:"​From Wikipedia, the free encyclopedia. \n\nGeorge Roy Hill (December 20, 1921 – December 27, 2002) was an American film director.  He is most noted for directing such films as Butch Cassidy and the Sundance Kid and The Sting, which both starred the acting duo Paul Newman and Robert Redford...", died:date('2002-12-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4DMJLc6Y2eVgoFyjmNDFygQBXCV.jpg", url:"https://themoviedb.org/person/9577"}}, {tmdbId:"32765", properties:{bornIn:"Shipley, Yorkshire, England, UK", imdbId:"0724798", born:date('1928-06-05'), name:"Tony Richardson", bio:"Cecil Antonio \"Tony\" Richardson (5 June 1928 – 14 November 1991) was an English filmmaker.  He won two Academy Awards for directing and producing comedy film Tom Jones (1963). \n\nDescription above from the Wikipedia article Tony Richardson, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1991-11-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3skJ0HApYH6AgVPqMtexMbTCZMr.jpg", url:"https://themoviedb.org/person/32765"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"1038645", properties:{imdbId:"0615767", name:"Susan Muska", url:"https://themoviedb.org/person/1038645"}}, {tmdbId:"1038646", properties:{imdbId:"0645880", name:"Gréta Olafsdóttir", url:"https://themoviedb.org/person/1038646"}}, {tmdbId:"68993", properties:{bornIn:"New Orleans, Louisiana, U.S.", imdbId:"0716585", born:date('1940-03-29'), name:"Godfrey Reggio", bio:"From Wikipedia, the free encyclopedia.   Godfrey Reggio (born March 29, 1940) is an American director of experimental documentary films. \n\n \n\nDescription above from the Wikipedia article Godfrey Reggio, licensed under CC-BY-SA,full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/68993"}}, {tmdbId:"69003", properties:{bornIn:"Cincinnati, Ohio, USA", imdbId:"0522028", born:date('1911-03-09'), name:"John Lounsbery", bio:"From Wikipedia. \n\nJohn Lounsbery was born in Cincinnati, Ohio and raised in Colorado.  He attended East Denver High School and the Art Institute of Denver.  While attending the Art Center School of Design in Los Angeles, an instructor sent him to interview with Walt Disney.  Lounsbery was hired by Disney on July 2, 1935, beginning as an assistant animator on Snow White and the Seven Dwarfs...", died:date('1976-02-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iYmuwojzOqRMBswKoBmxXdm0iGU.jpg", url:"https://themoviedb.org/person/69003"}}, {tmdbId:"20646", properties:{bornIn:"Rome, Italy", imdbId:"0610831", born:date('1967-05-20'), name:"Gabriele Muccino", bio:"Gabriele Muccino is an Italian film director.  He is the elder brother of actor Silvio Muccino, who often appears in his brother's films. \n\nBorn in Rome, Gabriele Muccino gained success with films such as L'ultimo bacio (One Last Kiss) and Remember Me, My Love (Ricordati di me) with Monica Bellucci...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4kj5yc9pDLnvsen3tdTFdFkqKtc.jpg", url:"https://themoviedb.org/person/20646"}}, {tmdbId:"638", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0000520", born:date('1943-02-05'), name:"Michael Mann", bio:"Michael Kenneth Mann (born February 5, 1943) is an American film director, screenwriter, and producer.  For his work, he has received nominations from international organizations and juries, including those at the British Academy of Film and Television Arts, Cannes and the Academy of Motion Picture Arts and Sciences.  He has produced the Academy Awards ceremony twice, first in 1999 with the 72nd annual Academy Awards and second in 2004 with the 77th annual ceremony...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zaiiWgIyO1mbftNF1yQxHDLsZFE.jpg", url:"https://themoviedb.org/person/638"}}, {tmdbId:"96439", properties:{bornIn:"Buffalo, NY", imdbId:"0123379", born:date('1970-05-23'), name:"Nanette Burstein", bio:"From Wikipedia, the free encyclopedia. \n\nNanette Burstein (born May 23, 1970) is an American film and television director.  Burstein has produced, directed, and co-directed many documentaries which have won her many awards and nominations, including an Academy Award nomination for Best Documentary and the Sundance Special Jury Prize for Documentary. \n\nDescription above from the Wikipedia article Nanette Burstein, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/96439"}}, {tmdbId:"102109", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0605137", born:date('1968-10-11'), name:"Brett Morgen", url:"https://themoviedb.org/person/102109"}}, {tmdbId:"1081129", properties:{imdbId:"0814384", name:"Barbara Sonneborn", url:"https://themoviedb.org/person/1081129"}}, {tmdbId:"5501", properties:{bornIn:"Norfolk, Virginia, USA", imdbId:"0001219", born:date('1965-12-19'), name:"Gary Fleder", bio:"Gary Fleder (born December 19, 1965) is an American film director, screenwriter, and producer.  His most recently completed film, The Express, is based on the true story of football player Ernie Davis, and was released by Universal Pictures in October 2008. \n\nDescription above from the Wikipedia article Gary Fleder, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/5501"}}, {tmdbId:"14520", properties:{bornIn:"Oak Park, Illinois, USA", imdbId:"0836328", born:date('1910-01-03'), name:"John Sturges", bio:"John Eliot Sturges was an American film director.  His movies include Bad Day at Black Rock (1955), Gunfight at the O. K.  Corral (1957), The Magnificent Seven (1960), The Great Escape (1963) and Ice Station Zebra (1968)...", died:date('1992-08-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/22Tg0PeUfexgVL4dpdkLyViZh5O.jpg", url:"https://themoviedb.org/person/14520"}}, {tmdbId:"67924", properties:{bornIn:"Rome, Lazio, Italy", imdbId:"0826642", born:date('1915-01-19'), name:"Steno", died:date('1988-03-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/osXoJ0ARTKcpGiQ8WuZ0jm0STPA.jpg", url:"https://themoviedb.org/person/67924"}}, {tmdbId:"56349", properties:{bornIn:"Martinez, California, United States", imdbId:"0759207", born:date('1958-03-29'), name:"Victor Salva", bio:"From Wikipedia, the free encyclopedia. \n\nVictor Ronald Salva (born March 29, 1958) is an American film director, mostly of horror movies.  His body of work includes the films Powder and Jeepers Creepers. \n\nDescription above from the Wikipedia article Victor Salva, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7baSkBrUNH3I6BAQybc8YjHtuFx.jpg", url:"https://themoviedb.org/person/56349"}}, {tmdbId:"34453", properties:{imdbId:"0106230", name:"Kevin Bray", bio:"From Wikipedia, the free encyclopedia.  Kevin Gerald Bray is an American film, television, commercial and music video director and producer.  Bray attended the University of Michigan and the Sorbonne before completing his studies at New York University Film School.  Bray also goes by his initials, KGB. \n\nDescription above from the Wikipedia article Kevin Bray, licensed under CC-BY-SA,full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/34453"}}, {tmdbId:"32813", properties:{bornIn:"Le Locle, Switzerland", imdbId:"0652860", born:date('1958-02-13'), name:"Dominique Othenin-Girard", url:"https://themoviedb.org/person/32813"}}, {tmdbId:"8300", properties:{bornIn:"San Antonio, Texas, USA", imdbId:"0721817", born:date('1952-01-17'), name:"Kevin Reynolds", bio:"An American film director and screenwriter.   Raised as an Air Force brat, Kevin Reynolds' love for cinema inspired him to forsake his law school degree and move to Los Angeles to enroll in the University of Southern California's legendary film school...", url:"https://themoviedb.org/person/8300"}}, {tmdbId:"58080", properties:{bornIn:"England, UK", imdbId:"0317981", name:"Brian Gilbert", bio:"​From Wikipedia, the free encyclopedia.   \n\nBrian Gilbert is a film director.  Born in England, he spent much of his childhood in Australia, where he was a child actor of film, television and radio.  Returning to England at the age of fourteen, he completed his education at Oxford University. \n\nHe continued working as a professional actor until 1979, when he joined the National Film and Television School as a directing student...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3Jc2jNngHuBXPprl7dJqnyojv1b.jpg", url:"https://themoviedb.org/person/58080"}}, {tmdbId:"69290", properties:{bornIn:"Ucraina", imdbId:"0383692", born:date('1969-02-27'), name:"Higuchinsky", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6ekINNBaCs3pILyWApSMChVAy5u.jpg", url:"https://themoviedb.org/person/69290"}}, {tmdbId:"8429", properties:{bornIn:"Mazomanie, Wisconsin, USA", imdbId:"0668227", born:date('1918-12-16'), name:"Clark L. Paylow", died:date('1985-09-25'), url:"https://themoviedb.org/person/8429"}}, {tmdbId:"57898", properties:{bornIn:"Lansing, Michigan, USA", imdbId:"0540532", name:"William Malone", bio:"From Wikipedia, the free encyclopedia.   William Malone is an American horror filmmaker who directed such films as the 1999 remake of House on Haunted Hill, Scared to Death and FeardotCom. \n\nMalone is also a successful writer, having written \"Universal Soldier: The Return\", starring Jean-Claude Van Damme, \"The Aberdeen Project\", as well as many TV episodics. \n\nDescription above from the Wikipedia article William Malone, licensed under CC-BY-SA,full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/57898"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"18179", properties:{bornIn:" New Britain, Connecticut, USA", imdbId:"0725379", born:date('1945-12-07'), name:"W.D. Richter", bio:"​From Wikipedia, the free encyclopedia.   \n\nW.  D.  Richter (born 7 December 1945, New Britain, Connecticut) is a screenwriter and has occasionally directed and produced.  He is best known for adapting Invasion of the Body Snatchers (1978), directing The Adventures of Buckaroo Banzai Across the 8th Dimension, and helping write Big Trouble in Little China. \n\nDescription above from the Wikipedia articleW.  D.  Richter,  licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/18179"}}, {tmdbId:"13426", properties:{bornIn:"New York, New York, USA", imdbId:"0781842", born:date('1962-04-20'), name:"Peter Segal", bio:"Peter Segal (born 1962) is an American film director, with credits in producing, writing, and acting.  He has had general success in the comedy film genre...", url:"https://themoviedb.org/person/13426"}}, {tmdbId:"52779", properties:{bornIn:"Indianapolis, Indiana, USA", imdbId:"0614682", born:date('1965-11-30'), name:"Ryan Murphy", bio:"Ryan Patrick Murphy (born November 30, 1965) is an American writer, film and television director and producer, best known for creating the television shows Nip/Tuck, Glee, American Horror Story and American Crime Story...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uZN1NEUfYSAq4KuU1Dr5rMX6Aj4.jpg", url:"https://themoviedb.org/person/52779"}}, {tmdbId:"168330", properties:{imdbId:"0506802", born:date('1946-08-06'), name:"Ben Lewin", bio:"Ben Lewin is a director and writer born in Poland and raised in Melbourne, Australia.  Lewin moved to Los Angeles, California in 1994 to pursue a film and television career...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yUcFotxiIBNpbAl5zo7galsogdK.jpg", url:"https://themoviedb.org/person/168330"}}, {tmdbId:"57604", properties:{imdbId:"0302778", name:"Joel Gallen", bio:"From Wikipedia, the free encyclopedia.   Joel Gallen is an American film director, producer, and screenwriter.  He has produced the MTV Movie Awards between 1995 and 2006,  as well as many of the Comedy Central Roasts.  Gallen directed the film Not Another Teen Movie.  He received a Prime Time Emmy and a Peabody for his work on America: A Tribute to Heroes.   He has his own production company called Tenth Planet Productions...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a1w10NA5Rm28ITpfY8PzzsKZ4Kf.jpg", url:"https://themoviedb.org/person/57604"}}, {tmdbId:"25735", properties:{bornIn:"Outremont, Québec, Canada", imdbId:"0240995", born:date('1957-01-01'), name:"Christian Duguay", bio:"From Wikipedia, the free encyclopedia.   Christian Duguay (born 1957 in Outremont, Quebec) is a Canadian director.  He directed the Emmy nominated miniseries Hitler: The Rise of Evil, which aired on the CBC in May 2003.  He is best known for directing the action films Screamers (1995) starring Peter Weller and Roy Dupuis and The Art of War (2000) starring Wesley Snipes and Michael Biehn.  In 2009 he directed a television mini-series about Saint Augustine of Hippo...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2v1gj3tJC6btabF8xp0N4p0nlSz.jpg", url:"https://themoviedb.org/person/25735"}}, {tmdbId:"168667", properties:{bornIn:"Fayetteville, Arkansas, USA", imdbId:"0601337", born:date('1970-10-22'), name:"Jason Moore", url:"https://themoviedb.org/person/168667"}}, {tmdbId:"69392", properties:{bornIn:"Brooklyn, New York City, New York, USA", imdbId:"0910199", born:date('1911-11-17'), name:"Charles Walters", bio:"From Wikipedia, the free encyclopedia.   Charles Walters (November 11, 1911 – August 13, 1982) was a Hollywood director and choreographer most noted for his work in MGM musicals and comedies in from the 1940s to the 1960s. \n\nHe was born in Pasadena, California, and educated at the University of Southern California, Los Angeles...", died:date('1982-08-13'), url:"https://themoviedb.org/person/69392"}}, {tmdbId:"4065", properties:{bornIn:"Rzeszów, Galicia, Austria-Hungary [now Poland]", imdbId:"0003593", born:date('1907-04-29'), name:"Fred Zinnemann", bio:"From Wikipedia, the free encyclopedia\n\nAlfred \"Fred\" Zinnemann (April 29, 1907 – March 14, 1997), born in the former Austro-Hungarian Empire, was an American film director.  He won four Academy Awards for directing films in various genres, including thrillers, westerns, film noir and play adaptations.  He made 25 feature films during his 50-year career...", died:date('1997-03-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vCdL6xfN6ey7Zb8SRb6ROiuFV8n.jpg", url:"https://themoviedb.org/person/4065"}}, {tmdbId:"11447", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"0400436", born:date('1972-04-01'), name:"Albert Hughes", bio:"From Wikipedia, the free encyclopedia. \n\nAlbert Hughes and Allen Hughes (born April 1, 1972), known together professionally as the Hughes brothers, are American film directors, producers and screenwriters.  The pair, who are twins, are known for co-directing such visceral, and often violent, movies as Menace II Society, From Hell and The Book of Eli...", url:"https://themoviedb.org/person/11447"}}, {tmdbId:"7312", properties:{bornIn:"San Francisco, California, USA", imdbId:"1286340", born:date('1971-02-14'), name:"Angela Robinson", bio:"Angela Robinson is an American film and television director, screenwriter and producer.  Robinson is a graduate of Brown University and New York University...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j6ymx8zGC9OGQ8CUeIoJ3D0RpMU.jpg", url:"https://themoviedb.org/person/7312"}}, {tmdbId:"109402", properties:{bornIn:"New Jersey, United States", imdbId:"0258531", born:date('1955-04-06'), name:"Rob Epstein", bio:"Rob Epstein, also credited as Robert P.  Epstein is a gay non-fiction filmmaker, director, producer, writer and editor.  Epstein has won two Academy Awards for Best Documentary Feature for the films The Times of Harvey Milk and Common Threads: Stories from the Quilt.  He has also won four national Emmy Awards, three Peabody Awards, two DuPont Columbia Journalism awards, a Guggenheim Fellowship and numerous other awards for his documentary films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2Dt2pa7G45FOedK281eCplnLNOS.jpg", url:"https://themoviedb.org/person/109402"}}, {tmdbId:"109403", properties:{bornIn:"Los Angeles, California", imdbId:"0295243", born:date('1951-08-24'), name:"Jeffrey Friedman", bio:"Jeffrey Friedman is a non-fiction filmmaker, director, producer, writer and editor.  Friedman has won an Academy Award for Best Documentary Feature for the film Common Threads: Stories from the Quilt...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qv9iaUggDYIEZqDigUw2H2gWkdj.jpg", url:"https://themoviedb.org/person/109403"}}, {tmdbId:"11472", properties:{bornIn:"New York City, New York, United States", imdbId:"0005563", born:date('1931-05-28'), name:"Irwin Winkler", bio:"​From Wikipedia, the free encyclopedia.   \n\nIrwin Winkler (born May 25, 1931) is an American film producer and director.  He is the producer or director of 50 major motion pictures, dating back to 1967's Double Trouble, starring Elvis Presley.  The fourth film he produced, They Shoot Horses, Don't They? (1969), starring Jane Fonda, was nominated for nine Academy Awards.  In 1976, he won an Oscar for Best Picture for Rocky...", url:"https://themoviedb.org/person/11472"}}, {tmdbId:"18311", properties:{bornIn:"New York City, New York, USA", imdbId:"0005387", born:date('1948-06-13'), name:"Joe Roth", bio:"​From Wikipedia, the free encyclopedia. \n\nJoe Roth  (born July 13, 1948) is an American film executive, producer and film director.  He co-founded Morgan Creek Productions in 1987 and was chairman of 20th Century Fox (1989–1993), Caravan Pictures (1993–1994), and Walt Disney Studios (1994–2000) before founding Revolution Studios in 2000...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lUtmB3mtMPrA5hhoEwZBeX1U5uL.jpg", url:"https://themoviedb.org/person/18311"}}, {tmdbId:"69579", properties:{bornIn:"San Francisco, California, USA", imdbId:"0410494", born:date('1960-06-05'), name:"James Isaac", bio:"James Isaac is an American film director.  He is best known for directing Jason X...", died:date('2012-05-06'), url:"https://themoviedb.org/person/69579"}}, {tmdbId:"941809", properties:{imdbId:"0351945", name:"George Haas", url:"https://themoviedb.org/person/941809"}}, {tmdbId:"12881", properties:{bornIn:"Oakland, California", imdbId:"0325776", born:date('1944-11-17'), name:"Gary Goldman", bio:"Gary Wayne Goldman (born November 17, 1944 in Oakland, California) is an American Film Producer, Director, Animator, Writer and voice actor, he is well known for working on films with Don Bluth like An American Tail and The Land Before Time.  He was an animator at Disney before working at Sullivan Bluth Studios with Bluth. \n\nDescription above from the Wikipedia article Gary Goldman, licensed under CC-BY-SA, full list of contributors on Wikipedia ...", url:"https://themoviedb.org/person/12881"}}, {tmdbId:"30870", properties:{imdbId:"0668292", name:"Dave Payne", url:"https://themoviedb.org/person/30870"}}, {tmdbId:"69667", properties:{bornIn:"Brooklyn, New York, U.S.", imdbId:"0517514", born:date('1941-09-29'), name:"Bob Logan", bio:"From Wikipedia, the free encyclopedia. \n\nBob Logan, AKA Bobby Logan, is an American film and television producer, writer &amp; director.  His productions include Repossessed, Meatballs 4 Up Your Alley and Yard Sale. \n\nPrior to working in feature films and television, Logan wrote comedy material for comics including: Joan RiversCitation Needed, Garry ShandlingCitation Needed, Rodney Dangerfield Citation Needed, Sam Kinison Citation Needed and Arsenio Hall Citation Needed...", url:"https://themoviedb.org/person/69667"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"69719", properties:{bornIn:"Rio de Janeiro, Brazil", imdbId:"0000853", born:date('1955-03-16'), name:"Bruno Barreto", bio:"Bruno Barreto (born March 16, 1955) is a Brazilian film director born in Rio de Janeiro.  He has been making feature-length films ever since he was seventeen years old and remains one of Brazil’s most accomplished and popular directors to this day.  The type of films he makes vary widely from light comedies like Dona Flor and Her Two Husbands (1976) and Bossa Nova (2000) to tense political thrillers like Four Days in September (1997)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1MTtFGZhfYQosbhJ8B0ZRVMvXdv.jpg", url:"https://themoviedb.org/person/69719"}}, {tmdbId:"69741", properties:{bornIn:"Wilkes Barre, Pennsylvania", imdbId:"0262693", born:date('1962-10-20'), name:"David M. Evans", bio:"​From Wikipedia, the free encyclopedia.   \n\nDavid Mickey Evans (born October 20, 1962) is a screenwriter and film director.  His films tend to be based around children and focus on the challenges of childhood.  Evans is also a huge baseball fan and co-wrote The Sandlot. \n\nDescription above from the Wikipedia article David M.  Evans , licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/69741"}}, {tmdbId:"17167", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0855035", born:date('1955-06-15'), name:"Andy Tennant", bio:"​From Wikipedia, the free encyclopedia\n\nAndy Tennant (born 1955) is an American screenwriter, film and television director, and dancer. \n\nDescription above from the Wikipedia article Andy Tennant, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/17167"}}, {tmdbId:"12677", properties:{bornIn:"New York City, New York, USA", imdbId:"0730422", born:date('1945-07-15'), name:"Matthew Robbins", bio:"Matthew Robbins is an American screenwriter, film producer and director.  He is good friends with Steven Spielberg, George Lucas, Guillermo Del Toro and Walter Murch and has had cameo appearances in THX 1138 and Close Encounters of the Third Kind.  Robbins frequently worked with Hal Barwood.  He recently wrote the screenplay for the Bollywood thriller 7 Khoon Maaf, along with Vishal Bhardwaj...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/abxZZtYWLhnliR572pJvhfyksnD.jpg", url:"https://themoviedb.org/person/12677"}}, {tmdbId:"21712", properties:{bornIn:"Richmond, California, USA", imdbId:"0002083", born:date('1949-04-11'), name:"Carl Franklin", bio:"Carl Franklin  (born April 11, 1949) is an American actor, screenwriter and film and television director.  Franklin is a graduate of University of California, Berkeley and continued his education at the AFI Conservatory, where he graduated with an M. F. A.  degree in directing in 1986.  Franklin is most noted for Devil in a Blue Dress, which was based on the book by Walter Mosley and starred Denzel Washington and Don Cheadle...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hj13MdaufdUvpoWt6WZd4Xdr7cO.jpg", url:"https://themoviedb.org/person/21712"}}, {tmdbId:"508", properties:{bornIn:"Pewaukee, Wisconsin, USA", imdbId:"0462895", born:date('1963-06-09'), name:"David Koepp", bio:"David Koepp  (born June 9, 1963) is an American screenwriter and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/srPSV5EyQomUn65ZLD45h2b0AA5.jpg", url:"https://themoviedb.org/person/508"}}, {tmdbId:"8500", properties:{bornIn:"Cape Elizabeth, Maine, USA", imdbId:"0000406", born:date('1894-02-01'), name:"John Ford", bio:"From Wikipedia, the free encyclopedia.   \n\nJohn Ford (February 1, 1894 – August 31, 1973) was an American film director.  He was famous for both his westerns such as Stagecoach, The Searchers, and The Man Who Shot Liberty Valance, and adaptations of such classic 20th-century American novels as The Grapes of Wrath.  His four Academy Awards for Best Director (1935, 1940, 1941, 1952) is a record, and one of those films, How Green Was My Valley, also won Best Picture...", died:date('1973-08-31'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/k6snUYnqgSpUamrxylAeIpSmSHv.jpg", url:"https://themoviedb.org/person/8500"}}, {tmdbId:"33183", properties:{bornIn:"Cheshire, England, UK", imdbId:"0101047", name:"David Bowers", bio:"From Wikipedia, the free encyclopedia\n\nDavid Bowers is an animator and film director originally from Stockport, Greater Manchester in the UK. \n\nDescription above from the Wikipedia article David Bowers (director), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/icS8UDrmWF2jfb3udMxcMgRkHeH.jpg", url:"https://themoviedb.org/person/33183"}}, {tmdbId:"70109", properties:{bornIn:"Hong Kong", imdbId:"0150802", born:date('1961-10-07'), name:"Benny Chan", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/prdfsWgxCjLCHzFJj2L6Os3qS6m.jpg", url:"https://themoviedb.org/person/70109"}}, {tmdbId:"893", properties:{bornIn:"North Shields, Northumberland, England, UK", imdbId:"0001716", born:date('1944-06-21'), name:"Tony Scott", bio:"Tony Scott was an English director and producer of films such as \"Top Gun\", \"Beverly Hills Cop II\", \"The Last Boy Scout\", \"True Romance\", \"Crimson Tide\", \"Enemy of the State\", \"Spy Game\", \"Man on Fire\", \"Déjà Vu\", \"The Taking of Pelham 1 2 3\", and \"Unstoppable\".  He was the younger brother of fellow film director Ridley Scott...", died:date('2012-08-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2Cj0IqkQcWRydXyr5moaNu5yqTH.jpg", url:"https://themoviedb.org/person/893"}}, {tmdbId:"70308", properties:{bornIn:"Liverpool, England", imdbId:"0400731", born:date('1922-01-19'), name:"Ken Hughes", bio:"From Wikipedia, the free encyclopedia\n\nKen Hughes (19 January 1922, Liverpool – 28 April 2001, Los Angeles) was a British film director, writer, and producer. \n\nDescription above from the Wikipedia article Ken Hughes, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2001-04-28'), url:"https://themoviedb.org/person/70308"}}, {tmdbId:"70334", properties:{imdbId:"0516344", born:date('1918-12-12'), name:"Lo Wei", bio:"Lo Wei (Chinese: 羅維, sometimes spelled Lo Wai, 12 December 1918 – 20 January 1996) was a Hong Kong film director and film actor best known for launching the martial arts film careers of both Bruce Lee, in The Big Boss and Fist of Fury, and Jackie Chan, in New Fist of Fury...", died:date('1996-01-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yLjqO5LmNLIAkcVUXQVCieHnix9.jpg", url:"https://themoviedb.org/person/70334"}}, {tmdbId:"12114", properties:{bornIn:"New York City, New York, USA", imdbId:"0001047", born:date('1939-02-03'), name:"Michael Cimino", bio:"Michael Cimino (February 3, 1939 – July 2, 2016) was an American film director, screenwriter, and producer.  He is best known for writing and directing The Deer Hunter, which won 5 Academy Awards including Best Director, and the controversial followup, Heaven's Gate.  His films are characterized by their striking visual style and controversial subject matter...", died:date('2016-07-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pJZY5Ls2l7NihaMkMjHn4Wt1soE.jpg", url:"https://themoviedb.org/person/12114"}}, {tmdbId:"137467", properties:{bornIn:"Billericay, Essex, England, UK", imdbId:"1296554", born:date('1972-11-30'), name:"Ben Wheatley", bio:"Ben Wheatley (born 1972) Animator, Director of internet viral ads, TV idents, TV adverts TV comedy shows and feature films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1AXTZ4f4LqXJXv2Yk1aLn9IxYvP.jpg", url:"https://themoviedb.org/person/137467"}}, {tmdbId:"70520", properties:{bornIn:"Uttoxeter, Staffordshire, England, UK", imdbId:"0276349", born:date('1972-12-26'), name:"Shane Meadows", bio:"Shane Meadows (born 26 December 1972) is an English film director, screenwriter and actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qB2l223Yv4636G3xo588asPW99k.jpg", url:"https://themoviedb.org/person/70520"}}, {tmdbId:"510", properties:{bornIn:"Burbank, California, USA", imdbId:"0000318", born:date('1958-08-25'), name:"Tim Burton", bio:"Timothy Walter Burton (born August 25, 1958) is an American filmmaker, artist, writer, and animator.  He is known for his dark, gothic, and eccentric horror and fantasy films such as Beetlejuice (1988), Edward Scissorhands (1990), Ed Wood (1994), Sleepy Hollow (1999), Corpse Bride (2005), Sweeney Todd: The Demon Barber of Fleet Street (2007), Dark Shadows (2012), and Frankenweenie (2012)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yHEHAHQpN9PfSEQx1UxZPczhcAi.jpg", url:"https://themoviedb.org/person/510"}}, {tmdbId:"71267", properties:{imdbId:"0210320", name:"Kirk DeMicco", url:"https://themoviedb.org/person/71267"}}, {tmdbId:"70558", properties:{bornIn:"Los Angeles, California, Stati Uniti", imdbId:"0428751", born:date('1953-01-17'), name:"Mark Jones", url:"https://themoviedb.org/person/70558"}}, {tmdbId:"70565", properties:{bornIn:"Nuremberg, Bavaria, Germany", imdbId:"0627087", born:date('1908-04-05'), name:"Kurt Neumann", bio:"From Wikipedia, the free encyclopedia. \n\nKurt Neumann (5 April 1908, Nuremberg, Germany - 21 August 1958, Los Angeles) was a german Hollywood film director who specialized in science fiction movies in his later career.  Neumann came to the US in the early talkie era, hired to direct German language versions of Hollywood films...", died:date('1958-08-21'), url:"https://themoviedb.org/person/70565"}}, {tmdbId:"70573", properties:{imdbId:"0402995", name:"Paul Hunter", bio:"From Wikipedia, the free encyclopedia\n\nPaul Hunter is a music video director known for his high-budget, visually distinctive videos for popular music singles.  He has directed over 100 music videos, many television advertisements and was nominated for an Emmy for Nike's Freestyle commercial\n\nA native Californian, Hunter majored in Radio, TV, and Film at Cal State Northridge.  His career began working on sets and shooting spec commercials...", url:"https://themoviedb.org/person/70573"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"66728", properties:{bornIn:"London, England, UK", imdbId:"0322242", born:date('1965-03-26'), name:"Jonathan Glazer", bio:"From Wikipedia, the free encyclopedia. \n\nJonathan Glazer (born 1965 in London) is an English director of films, commercials and music videos. \n\nDescription above from the Wikipedia article Jonathan Glazer, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ebCGu4AcQhrnmKYe49eyx9nrHPd.jpg", url:"https://themoviedb.org/person/66728"}}, {tmdbId:"70636", properties:{bornIn:"Aarhus, Denmark", imdbId:"0002196", born:date('1918-04-18'), name:"Gabriel Axel", bio:"Axel Gabriel Erik Mørch, betterr known as Gabriel Axel was Danish director, actor and writer.  He spent most of his childhood and youth in Paris.  In 1942 Axel was admitted to the acting school at the Royal Danish Theatre in Copenhagen.  After a short period of theatre in Paris, he returned to Denmark and began in 1951 to direct television drama...", died:date('2014-02-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ttXrSiFHT9bg7uE2Riby451PMXw.jpg", url:"https://themoviedb.org/person/70636"}}, {tmdbId:"2127", properties:{bornIn:"Kuching, Sarawak, Malaysia", imdbId:"1490123", born:date('1977-02-27'), name:"James Wan", bio:"James Wan is a Malaysian-born Australian producer, screenwriter, and film director of Chinese heritage.  He is widely known for directing the horror film Saw and creating Billy the puppet.  He also directed Dead Silence, Death Sentence and Insidious...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hZeFnl5vg7lPusYstuFtuY9Lpx5.jpg", url:"https://themoviedb.org/person/2127"}}, {tmdbId:"70663", properties:{imdbId:"0742034", name:"Martin Rosen", bio:"From Wikipedia, the free encyclopedia. \n\nMartin Rosen is an American film writer, director and producer known for his work both in live-action and in animation. \n\nDescription above from the Wikipedia article Martin Rosen, licensed under CC-BY-SA, full list of contributors on Wikipedia ...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/A3UilTtC7B2T4W1HYzWXEtJ6mq8.jpg", url:"https://themoviedb.org/person/70663"}}, {tmdbId:"50567", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0291035", born:date('1913-08-13'), name:"Melvin Frank", bio:"​From Wikipedia, the free encyclopedia\n\nMelvin Frank (13 August 1913 in Chicago, Illinois – 13 October 1988 in Los Angeles, California) was an American screenwriter, film producer and film director.  He is known for his work on films such as Mr.  Blandings Builds His Dream House (1948), The Court Jester (1956), and A Touch of Class (1973). \n\nBorn to a Jewish family, Frank graduated from the University of Chicago, where he met his future collaborator Norman Panama...", died:date('1988-10-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kXYyKTEJh4p1eHFQnBKigwaKi2S.jpg", url:"https://themoviedb.org/person/50567"}}, {tmdbId:"66512", properties:{imdbId:"0103744", name:"Tom Brady", bio:"From Wikipedia, the free encyclopedia. \n\nTom Brady is a director, writer and producer.  His movies include The Comebacks and the Rob Schneider vehicles The Hot Chick and The Animal.  His television writing credits include work for The Critic, Sports Night, The Simpsons and Home Improvement.  He is an alumnus of Harvard and the University of Hawaii at Manoa. \n\nDescription above from the Wikipedia article Tom Brady, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/66512"}}, {tmdbId:"70850", properties:{imdbId:"0802617", name:"Andrew Sipes", url:"https://themoviedb.org/person/70850"}}, {tmdbId:"12028", properties:{bornIn:"Dundalk, Ireland", imdbId:"0601382", born:date('1970-01-01'), name:"John Moore", bio:"From Wikipedia, the free encyclopedia.   \n\nJohn Moore (born 1970) is an Irish director, producer, and writer. \n\nDescription above from the Wikipedia article John Moore (director) , licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/12028"}}, {tmdbId:"70792", properties:{imdbId:"0389514", name:"David Hogan", url:"https://themoviedb.org/person/70792"}}, {tmdbId:"36693", properties:{bornIn:" Barnstaple, Devon, England", imdbId:"0264236", born:date('1943-03-28'), name:"Richard Eyre", bio:"​From Wikipedia, the free encyclopedia.   \n\nSir Richard Charles Hastings Eyre CBE (born 28 March 1943) is an English director of film, theatre, television, and opera. \n\nDescription above from the Wikipedia article  Richard Eyre, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/36693"}}, {tmdbId:"19093", properties:{bornIn:"Chicago, Illinois, USA ", imdbId:"0550892", born:date('1891-12-29'), name:"George Marshall", bio:"From Wikipedia, the free encyclopedia. \n\nGeorge E.  Marshall (December 29, 1891 – February 17, 1975) was a prolific American actor, screenwriter, producer, film and television director, active through the first six decades of movie history. \n\nRelatively few of Marshall's films are well-known today, with Destry Rides Again, The Sheepman, and How the West Was Won being the biggest exceptions...", died:date('1975-02-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ihXnt1YasrOSQl1izS0NFk4forc.jpg", url:"https://themoviedb.org/person/19093"}}, {tmdbId:"70862", properties:{bornIn:"Hutchinson, Kansas, USA", imdbId:"0861703", born:date('1896-02-24'), name:"Richard Thorpe", bio:"From Wikipedia, the free encyclopedia. \n\nRichard Thorpe (February 24, 1896 - May 1, 1991) was an American film director.     Born Rollo Smolt Thorpe in Hutchinson, Kansas, he began his entertainment career performing in vaudeville and onstage.  In 1921 he began in motion pictures as an actor and directed his first silent film in 1923.  He went on to direct more than one hundred and eighty films.  The first full length motion picture he directed for MGM was Last of the Pagans (1935) starring Ray Mala...", died:date('1991-05-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/szbaqa5qggPXjaLbNGb2JMgsoi3.jpg", url:"https://themoviedb.org/person/70862"}}, {tmdbId:"70864", properties:{bornIn:"Kidderminster, Worcestershire, England, UK", imdbId:"0357607", born:date('1911-03-31'), name:"Robert Hamer", bio:"From Wikipedia, the free encyclopedia. \n\nRobert James Hamer (31 March 1911, Kidderminster, Worcestershire – 4 December 1963, London) was a British film director and screenwriter.  He was the son of the actor Gerald Hamer (1886-1972)...", died:date('1963-12-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uyfGB5eUmDMXvRZJkQwqqModX3D.jpg", url:"https://themoviedb.org/person/70864"}}, {tmdbId:"17268", properties:{bornIn:"Hong Kong, China", imdbId:"0950553", born:date('1950-07-01'), name:"Ronny Yu", bio:"Ronny Yu Yan-Tai (born 1950) is a Hong Kong director, producer, and movie writer.  Yu was born in Hong Kong and graduated from Ohio University.  He has worked on both Hong Kong and American films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pFfRQ3dCtXpj1DQ5W2NlbiAYKWG.jpg", url:"https://themoviedb.org/person/17268"}}, {tmdbId:"10790", properties:{bornIn:"Philadelphia, Pennsylvania, USA", imdbId:"0939992", born:date('1883-07-10'), name:"Sam Wood", bio:"Samuel Grosvenor (Sam) Wood (July 10, 1883 – September 22, 1949) was an American film director, and producer, who was best known for directing such Hollywood hits as A Night at the Opera, A Day at the Races, Goodbye, Mr.  Chips, and The Pride of the Yankees.  He was also involved in a few acting and writing projects. \n\nDescription above from the Wikipedia article Sam Wood, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1949-09-22'), url:"https://themoviedb.org/person/10790"}}, {tmdbId:"15239", properties:{imdbId:"0400958", name:"Terry Hughes", bio:"Terry Hughes is a British Emmy Award-winning television director. \n\nHughes has directed or written for The Two Ronnies, The Golden Girls, 3rd Rock from the Sun, Friends, and series such as Ripping Yarns amongst other shows. \n\nIn 1972 he was producer for the 1972 Eurovision Song Contest. \n\nOther than television Hughes has also directed films such as Monty Python Live at the Hollywood Bowl (which he co-directed with Ian MacNaughton) and The Butcher's Wife. \n\nHughes now lives in Texas...", url:"https://themoviedb.org/person/15239"}}, {tmdbId:"19142", properties:{bornIn:"Pine Bluff, Arkansas, USA", imdbId:"0425540", born:date('1942-10-26'), name:"Kenneth Johnson", bio:"From Wikipedia, the free encyclopedia. \n\nKenneth Johnson (born 26 October 1942) is an American screenwriter, producer and director best known as the creator of the V science fiction franchise and The Incredible Hulk TV series.  His creative efforts are almost entirely concentrated in the area of television science fiction. \n\nA native of Pine Bluff, Arkansas, Johnson is a graduate of the Carnegie Institute of Technology...", url:"https://themoviedb.org/person/19142"}}, {tmdbId:"71329", properties:{bornIn:"Bromma, Stockholm, Stockholms län, Sweden", imdbId:"0959774", born:date('1965-11-10'), name:"Jonas Åkerlund", bio:"Jonas Åkerlund (born November 10, 1965) is a Swedish film and music video director, and drummer.  He is best known for his stylish music videos, which are often mock forms of movie trailers and short films.  His video for Madonna's song \"Ray of Light\" won a Grammy for Best Music Video, Short Form, and a record seven awards at 1998 MTV Video Music Awards, including the Video of the Year.  He more recently directed the video for Britney Spears' 2011 single \"Hold It Against Me\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bGnXImWTXDPvvwD4kcS7NdlMGW8.jpg", url:"https://themoviedb.org/person/71329"}}, {tmdbId:"27991", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0002340", born:date('1947-08-11'), name:"Stuart Gordon", bio:"​From Wikipedia, the free encyclopedia\n\nStuart Gordon (August 11, 1947 - March 24, 2020) was a director, writer and producer of films and plays.  Most of Gordon's film work is in the horror genre, though he has also ventured into science fiction.  Like his friend and fellow filmmaker Brian Yuzna, Gordon is a big fan of H.  P.  Lovecraft and has adapted several Lovecraft stories for the screen...", died:date('2020-03-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bWR50xOqP4q059DqEvaYYklADNC.jpg", url:"https://themoviedb.org/person/27991"}}, {tmdbId:"71253", properties:{imdbId:"0242945", name:"George Dunning", url:"https://themoviedb.org/person/71253"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"12989", properties:{bornIn:"Chicago, Illinois, U.S.", imdbId:"0001112", born:date('1946-11-21'), name:"Andrew Davis", bio:"Andrew Davis (born November 21, 1946) is an American film director, producer and cinematographer, noted for the action films Code of Silence, The Fugitive, Chain Reaction, Collateral Damage, Above the Law and Under Siege.   Born on the south side of Chicago, Illinois, Davis has directed several films using Chicago as a backdrop...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wZIDAQwxXs1bkbQ4lUOPWdu4R8m.jpg", url:"https://themoviedb.org/person/12989"}}, {tmdbId:"15657", properties:{imdbId:"0568546", born:date('1929-08-10'), name:"Vincent McEveety", bio:"​From Wikipedia, the free encyclopedia.   \n\nVincent Michael McEveety (born August 10, 1929) is an American film and television director. \n\nDescription above from the Wikipedia article Vincent McEveety, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rATCysXXiKfPUA1UYvvzJY4v8Rb.jpg", url:"https://themoviedb.org/person/15657"}}, {tmdbId:"2239", properties:{bornIn:"Ryde, Isle of Wight, England, UK", imdbId:"0005237", born:date('1954-01-06'), name:"Anthony Minghella", bio:"From Wikipedia, the free encyclopedia\n\nAnthony Minghella, CBE (6 January 1954 – 18 March 2008) was an English film director, playwright and screenwriter.  He was Chairman of the Board of Governors at the British Film Institute between 2003 and 2007. \n\nHe won the Academy Award for Best Director for The English Patient (1996), which also won the BAFTA Award for Best Film and Golden Globe Award for Best Director...", died:date('2008-03-18'), url:"https://themoviedb.org/person/2239"}}, {tmdbId:"127716", properties:{bornIn:"Cheltenham, Gloucestershire, England, UK", imdbId:"0950000", born:date('1933-03-16'), name:"Robert Young", bio:"From Wikipedia, the free encyclopedia. \n\nRobert William Young (born 16 March 1933) is a British television and film director. \n\nYoung was born in Cheltenham, and in the 1980s and early 1990s, established himself as a leading director of British TV drama.  In the 1970s, he directed Vampire Circus (1972) and Hammer House of Horror.  He directed several episodes of Minder and Bergerac in the early 1980s, and the acclaimed TV serial The Mad Death which centred around a rabies outbreak...", url:"https://themoviedb.org/person/127716"}}, {tmdbId:"9198", properties:{bornIn:"Greytown, New Zealand", imdbId:"0911910", born:date('1956-02-16'), name:"Vincent Ward", bio:"From Wikipedia, the free encyclopedia. \n\nVincent Ward, ONZM (born 16 February 1956) is a film director and screenwriter. \n\nDescription above from the Wikipedia article Vincent Ward, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9OgvrWlVqSo70dL0YWMlstESf2e.jpg", url:"https://themoviedb.org/person/9198"}}, {tmdbId:"8514", properties:{bornIn:"Columbus, Georgia, USA", imdbId:"0663577", born:date('1916-01-04'), name:"Robert Parrish", bio:"Robert R.  Parrish (born 4 January 1916, Columbus, Georgia – 4 December 1995, Southampton, New York) was an American actor, film editor, film director, and writer.  He received an Academy Award for Film Editing for the 1947 film, Body and Soul. \n\nParrish was the son of factory cashier Gordon R.  Parrish and Laura R.  Parrish.  In the mid-1920s, the family moved from Georgia to Los Angeles and Parrish and his sisters Beverly and Helen began obtaining work as actors soon thereafter...", died:date('1995-12-04'), url:"https://themoviedb.org/person/8514"}}, {tmdbId:"47792", properties:{bornIn:"Glasgow, Scotland, UK", imdbId:"0569825", name:"Joseph McGrath", bio:"​From Wikipedia, the free encyclopedia.   \n\nJoseph 'Apocalypse' McGrath (born 1930, Glasgow), sometimes referred to as \"'Apocalypse'\" Joe McGrath or Croisette Meubles, is a Scottish film director and screenwriter best remembered for his two films, Casino Royale (1967) and The Magic Christian (1969).  McGrath frequently collaborated with Spike Milligan and Peter Sellers...", url:"https://themoviedb.org/person/47792"}}, {tmdbId:"9039", properties:{imdbId:"0653211", born:date('1964-07-06'), name:"John Ottman", url:"https://themoviedb.org/person/9039"}}, {tmdbId:"32250", properties:{bornIn:"Brighton, Regno Unito", imdbId:"1193346", born:date('1970-01-01'), name:"Sean Ellis", url:"https://themoviedb.org/person/32250"}}, {tmdbId:"167407", properties:{name:"John Alan Schwartz", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lRa1zETDZwLN0EHu5BMKIhMMFgu.jpg", url:"https://themoviedb.org/person/167407"}}, {tmdbId:"130938", properties:{bornIn:"Khabarovsk, Russian SFSR, USSR", imdbId:"0091076", born:date('1948-06-28'), name:"Sergei Bodrov", bio:"​From Wikipedia, the free encyclopedia\n\nSergei Vladimirovich Bodrov (born June 28, 1948) is a two-time Academy Award-nominated Russian film director, screenwriter, and producer. \n\nBodrov was born in Khabarovsk, Russian SFSR, USSR (now Russia).  His son, actor Sergei Bodrov, Jr.  was killed in an avalanche in the mountains of the North Caucasus on September 20, 2002 while shooting his film which was tentatively titled The Messenger...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9f4SPMNwQDA64lkSRgNhvrb1etf.jpg", url:"https://themoviedb.org/person/130938"}}, {tmdbId:"158634", properties:{born:date('1951-05-10'), name:"Suri Krishnamma", url:"https://themoviedb.org/person/158634"}}, {tmdbId:"7018", properties:{bornIn:"Wellington, New Zealand", imdbId:"0193485", born:date('1956-11-08'), name:"Richard Curtis", bio:"From Wikipedia, the free encyclopedia\n\nRichard Whalley Anthony Curtis, CBE (born 8 November 1956) is New Zealand-born British screenwriter, music producer, actor and film director, known primarily for romantic comedy films such as Four Weddings and a Funeral, Bridget Jones's Diary, Notting Hill, and Love Actually, as well as the hit sitcoms Blackadder, Mr.  Bean and The Vicar of Dibley.  He is also the founder of the British charity Comic Relief...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dLhFfcHJvOLzzykO3LYkinXJUA1.jpg", url:"https://themoviedb.org/person/7018"}}, {tmdbId:"17784", properties:{bornIn:"Newcastle-upon-Tyne, England, UK", imdbId:"0410139", born:date('1940-05-07'), name:"John Irvin", bio:"From Wikipedia, the free encyclopedia\n\nJohn Irvin (born May 7, 1940) is an English film director.  Born in Newcastle upon Tyne, he began his career by directing a number of documentaries and television works, including the BBC adaptation of John le Carré's Tinker, Tailor, Soldier, Spy.  Also, he made several action films in the 1980s including The Dogs of War (1980), Raw Deal (1986), Hamburger Hill (1987) and Next of Kin (1989)...", url:"https://themoviedb.org/person/17784"}}, {tmdbId:"10586", properties:{bornIn:"Philadelphia, Pennsylvania, U.S.", imdbId:"0504513", born:date('1932-01-19'), name:"Richard Lester", bio:"Richard Lester (born 19 January 1932)  is an American-born British-based film director notable for his work with The Beatles in the 1960s and his work on the Superman film series in the 1980s...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8RH3tst4t4cBtnIWCwWsZQKkMPh.jpg", url:"https://themoviedb.org/person/10586"}}, {tmdbId:"72061", properties:{bornIn:"Glasgow, Scotland, UK", imdbId:"0515979", born:date('1886-02-02'), name:"Frank Lloyd", bio:"Frank Lloyd was a film director, scriptwriter and producer.  Lloyd was among the founders of the Academy of Motion Picture Arts and Sciences, and its president from 1934 to 1935. \n\nFrank Lloyd was Scotland's first Academy Award winner and is unique in film history having received three Oscar nominations in 1929 for his work on a silent film (The Divine Lady), a part-talkie (Weary River) and a full talkie (Drag).  He won for The Divine Lady...", died:date('1960-08-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4TgAcAqe7jgVYqfjYkC89WrQUyb.jpg", url:"https://themoviedb.org/person/72061"}}, {tmdbId:"1012097", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0430927", born:date('1943-05-16'), name:"Jon Jost", bio:"Jon Stephen Jost (born 16 May 1943 in Chicago) is an American independent filmmaker. \n\nBorn in Chicago to a military family, he grew up in Georgia, Kansas, Japan, Italy, Germany and Virginia.  He began making films in January 1963 after being expelled from college.  In 1965 he was imprisoned by US authorities for 2 years 3 months for refusal to cooperate with the Selective Service system...", url:"https://themoviedb.org/person/1012097"}}, {tmdbId:"2034", properties:{bornIn:"Manchester, England, UK", imdbId:"0000965", born:date('1956-10-20'), name:"Danny Boyle", bio:"Daniel \"Danny\" Boyle is an English filmmaker and producer.  He is best known for his work on films such as Slumdog Millionaire, 127 Hours, 28 Days Later, Sunshine and Trainspotting.  For Slumdog Millionaire, Boyle won numerous awards in 2008, including the Academy Award for Best Director.  Boyle was presented with the Extraordinary Contribution to Filmmaking Award at the 2008 Austin Film Festival, where he also introduced that year's AFF Audience Award Winner Slumdog Millionaire...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/b5qQpFHmgNyvV1t81ou17Jt2fRj.jpg", url:"https://themoviedb.org/person/2034"}}, {tmdbId:"152456", properties:{imdbId:"5023740", name:"Sarah Burns", url:"https://themoviedb.org/person/152456"}}, {tmdbId:"204484", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0122741", born:date('1953-07-29'), name:"Ken Burns", bio:"Celebrated American documentarian who gradually amassed a considerable reputation and a devoted audience with a series of reassuringly traditional meditations on Americana.  Burns' works are treasure troves of archival materials; he skillfully utilizes period music and footage, photographs, periodicals and ordinary people's correspondence, the latter often movingly read by seasoned professional actors in a deliberate attempt to get away from a \"Great Man\" approach to history...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v0Gzc6XkvnjYUwCAluxvJ3u5O3D.jpg", url:"https://themoviedb.org/person/204484"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"1251448", properties:{imdbId:"2047334", name:"David McMahon", url:"https://themoviedb.org/person/1251448"}}, {tmdbId:"11343", properties:{bornIn:"St. Helens, Merseyside, England, UK", imdbId:"0946734", born:date('1963-11-30'), name:"David Yates", bio:"David Yates (born 30 November 1963) is an English director of film and television, best known for directing the final four films in the Harry Potter franchise. \n\nHis first two Potter films (Order of the Phoenix and Half-Blood Prince) became the highest-grossing entries in the series after the first instalment, which was later surpassed by Yates' Deathly Hallows, making him the most commercially successful British director in recent years...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hAHOxR0NK4cZDumqNIpDoEdGVAh.jpg", url:"https://themoviedb.org/person/11343"}}, {tmdbId:"72005", properties:{bornIn:"Parigi, Francia", imdbId:"0898603", born:date('1955-11-05'), name:"Christian Vincent", url:"https://themoviedb.org/person/72005"}}, {tmdbId:"17867", properties:{bornIn:"New Jersey, USA", imdbId:"0565336", born:date('1966-01-30'), name:"Tom McCarthy", bio:"Thomas Joseph McCarthy (born 1966) is an American actor, writer, and film director who has appeared in several movies, including Meet the Parents and Good Night, and Good Luck, and television shows such as The Wire, Boston Public, Law & Order, and the Hallmark Hall of Fame presentation of Saint Maybe.  McCarthy has received critical acclaim for his writing/direction work for the independent films The Station Agent, The Visitor, and Win Win.  He currently resides in Manhattan...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vqw9Ar2s2oYSkoApL1TlXtNlrEr.jpg", url:"https://themoviedb.org/person/17867"}}, {tmdbId:"89814", properties:{imdbId:"0191712", name:"R. J. Cutler", bio:"From Wikipedia, the free encyclopedia. \n\nR.  J.  Cutler is a television- and filmmaker.  He specializes in film documentaries and \"serious reality TV\".  He was educated at Harvard University and graduated in 1983; he also attended the University of Southern California School of Cinematic Arts. \n\nThe War Room is a documentary which showed the 1992 presidential campaign of Bill Clinton.  American High is a documentary about the lives of students in Highland Park, Illinois...", url:"https://themoviedb.org/person/89814"}}, {tmdbId:"16834", properties:{bornIn:"College Station - Texas - USA", imdbId:"0002339", born:date('1969-03-21'), name:"Allen Coulter", bio:"From Wikipedia, the free encyclopedia\n\nAllen Coulter is an American television and film director, credited with a number of successful television programs.  He has directed two feature films, Hollywoodland, a film regarding the questionable death of George Reeves starring Adrien Brody, Diane Lane, and Ben Affleck, and is responsible for the 2010 film Remember Me. \n\nCoulter was born in College Station, Texas...", url:"https://themoviedb.org/person/16834"}}, {tmdbId:"129894", properties:{bornIn:"Nuneaton, United Kingdom", imdbId:"2284484", born:date('1975-06-01'), name:"Gareth Edwards", bio:"​British film director Gareth Edwards is best known for directing the 2010 indie motion picture Monsters and the first Star Wars story, Rogue One. \n\nAlthough, Monsters was Gareth’s first feature film, it was not his first time working in the film industry.  Gareth began his career in special effects, creating digital effects for prestigious shows such as Attila the Hun for which he won international recognition...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ljojZagZdLqyEzMryzowTAw6uGT.jpg", url:"https://themoviedb.org/person/129894"}}, {tmdbId:"72496", properties:{bornIn:"Osaka, Japan", imdbId:"0945282", born:date('1931-09-13'), name:"Yoji Yamada", bio:"From Wikipedia, the free encyclopedia\n\nYoji Yamada (born September 13, 1931 in Toyonaka City, Osaka, Japan) is a Japanese film director best known for his Otoko wa Tsurai yo series of films. \n\nHe was born in Osaka.  But because of the work of his father, who was an engineer for the South Manchuria Railway, from the age of 2 he was brought up in Manchuria.  Following the end of World War II, he came back to Japan and subsequently he lived in Yamagata Prefecture...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wqdQOCGmOFRPhOUrWZsBieaEB9p.jpg", url:"https://themoviedb.org/person/72496"}}, {tmdbId:"8403", properties:{bornIn:"St Leonards-on-Sea, Regno Unito", imdbId:"0002376", born:date('1947-06-05'), name:"David Hare", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vZPhSQUUF6pGAN3ghat6gtwyIpr.jpg", url:"https://themoviedb.org/person/8403"}}, {tmdbId:"1080890", properties:{imdbId:"0054960", name:"Nicholas Barker", url:"https://themoviedb.org/person/1080890"}}, {tmdbId:"134156", properties:{bornIn:"Saxmundham - Suffolk - England", imdbId:"0589284", born:date('1962-09-28'), name:"Sam Miller", bio:"Sam Miller is an actor and director...", url:"https://themoviedb.org/person/134156"}}, {tmdbId:"72624", properties:{bornIn:"Hampshire, England, UK", imdbId:"0241090", born:date('1949-06-19'), name:"John Duigan", bio:"​From Wikipedia, the free encyclopedia\n\nJohn Duigan, (born 19 June 1949 in Hampshire, England, UK) is an Australian film director. \n\nDuigan emigrated to Australia in 1961, having been born to an Australian father.  He is related to many Australian performers, being the brother of Virginia Duigan (wife of director Bruce Beresford) and uncle of Trilby Beresford. \n\nDuigan has directed 23 films, including Romero, Lawn Dogs, The Parole Officer, Sirens, and Head in the Clouds...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dbVV1hkAJNADWr3VVhArA648skU.jpg", url:"https://themoviedb.org/person/72624"}}, {tmdbId:"72647", properties:{imdbId:"0846119", name:"Juan Carlos Tabío", url:"https://themoviedb.org/person/72647"}}, {tmdbId:"85242", properties:{imdbId:"2032557", name:"Kevin Jordan", url:"https://themoviedb.org/person/85242"}}, {tmdbId:"7145", properties:{bornIn:"San Francisco, California, USA", imdbId:"0499724", born:date('1957-03-30'), name:"Michael Lehmann", bio:"Michael Stephen Lehmann (born March 30, 1957; San Francisco, California) is an American film and television director. \n\nLehmann attended Columbia University.  His first job in the film industry was answering phones at Francis Ford Coppola's American Zoetrope film company.  Later he supervised cameras on films that included 1983's The Outsiders.  Lehmann attended film school at USC and graduated in 1985...", url:"https://themoviedb.org/person/7145"}}, {tmdbId:"203953", properties:{imdbId:"0800787", born:date('1960-06-27'), name:"Eric Simonson", url:"https://themoviedb.org/person/203953"}}, {tmdbId:"939275", properties:{imdbId:"0185187", born:date('1940-04-16'), name:"Paul Cox", url:"https://themoviedb.org/person/939275"}}, {tmdbId:"1224", properties:{bornIn:"Minneapolis, Minnesota, USA", imdbId:"0001053", born:date('1957-09-21'), name:"Ethan Coen", bio:"American filmmaker Ethan Jesse Coen is known for writing, directing and producing films jointly with his brother Joel David Coen, professionally they are known as the Coen brothers.  In 1984, the brothers wrote and directed Blood Simple, their first film together.  The film received was well received and won awards for Joel's direction at both the Sundance and Independent Spirit awards.  \n\nThe brothers were recognized for their talents having been nominated for a number of awards, and achievements...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ccvoiEe3gEMAth1Oy8SJxVeMcAk.jpg", url:"https://themoviedb.org/person/1224"}}, {tmdbId:"72952", properties:{bornIn:"Thompson, Manitoba, Canada", imdbId:"0367538", born:date('1966-02-05'), name:"Grant Harvey", bio:"Grant Harvey is a Canadian film and television writer, producer and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ePkfyXCqzgUGXDj2mXhZsPow18H.jpg", url:"https://themoviedb.org/person/72952"}}, {tmdbId:"60237", properties:{bornIn:"Las Vegas, Nevada, USA", imdbId:"0204884", born:date('1963-07-04'), name:"John A. Davis", bio:"From Wikipedia, the free encyclopedia\n\nJohn A.  Davis (born John Alexander Davis) is an American film director, writer, animator, voice actor and composer known for his work both in stop-motion animation as well as computer animation.  He is the creator of Jimmy Neutron. \n\nDescription above from the Wikipedia article John A.  Davis, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/60237"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"66563", properties:{bornIn:"New York City, New York, USA", imdbId:"0937748", born:date('1964-11-07'), name:"Fred Wolf", bio:"Fred began work as a stand-up comedian in the early days of the \"comic boom\" in Los Angeles and started submitting jokes to Johnny Carson, Joan Rivers, and many others, which propelled him from performing into writing.  After a series of TV writing assignments, Fred's big break came when he was asked to be a staff writer for SNL in the 90s...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/64Klcur18Q3eTZ4tTPiOnWrufU5.jpg", url:"https://themoviedb.org/person/66563"}}, {tmdbId:"12804", properties:{bornIn:"Aldershot, Hampshire, England, UK", imdbId:"0946811", born:date('1929-07-24'), name:"Peter Yates", bio:"From Wikipedia, the free encyclopedia\n\nPeter James Yates (24 July 1929 – 9 January 2011) was an English film director and producer.  He was born in Aldershot, Hampshire. \n\nThe son of an army officer, he attended Charterhouse School as a boy, graduated from the Royal Academy of Dramatic Art and worked for some years as an actor, director and stage manager.  In the 1950s he started in the movie industry as a dubbing assistant and later an assistant director for Tony Richardson...", died:date('2011-01-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sHcC917Y0F7UoaVAnF2yKMvUnSn.jpg", url:"https://themoviedb.org/person/12804"}}, {tmdbId:"28487", properties:{bornIn:"London - England - UK", imdbId:"0933002", born:date('1958-05-01'), name:"Andy Wilson", url:"https://themoviedb.org/person/28487"}}, {tmdbId:"1870", properties:{bornIn:"Dresden, Germany", imdbId:"0005846", born:date('1939-04-09'), name:"Gernot Roll", url:"https://themoviedb.org/person/1870"}}, {tmdbId:"58251", properties:{bornIn:"Philadelphia, Pennsylvania, United States", imdbId:"0561938", born:date('1932-04-21'), name:"Elaine May", bio:"Elaine May (born April 21, 1932) is an American film director, screenwriter and actress.  She achieved her greatest fame in the 1950s from her improvisational comedy routines in partnership with Mike Nichols.  She is a two time Academy Award-nominated screenwriter and also the mother of Oscar nominee Jeannie Berlin...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wiUcS4Phd2wRI8PVR7HpzPcHRb.jpg", url:"https://themoviedb.org/person/58251"}}, {tmdbId:"17281", properties:{bornIn:" Bristol, England United Kingdom", imdbId:"0388198", born:date('1932-07-29'), name:"Mike Hodges", bio:"Mike Hodges is an English screenwriter and film director.  His films as director include Get Carter (1971), Pulp (1972), the 1980 version of Flash Gordon and Croupier (1998)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/35mcdpwimATfaeEGpLhR0iVJ2Ep.jpg", url:"https://themoviedb.org/person/17281"}}, {tmdbId:"51917", properties:{bornIn:"Tulsa, Oklahoma, USA", imdbId:"0164187", born:date('1943-01-19'), name:"Larry Clark", bio:"Lawrence Donald \"Larry\" Clark (born January 19, 1943) is an American film director, photographer, writer and film producer who is best known for the movie Kids and his photography book Tulsa.  His most common subject is youth who casually engage in illegal drug use, underage sex and violence, and who are part of a specific subculture, such as surfing, punk rock or skateboarding...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jFzm8E5Wgtnbtodh45GCW3cDv6c.jpg", url:"https://themoviedb.org/person/51917"}}, {tmdbId:"19969", properties:{bornIn:"Ardmore, Ireland", imdbId:"0640466", name:"Pat O'Connor", bio:"From Wikipedia, the free encyclopedia. \n\nPat O'Connor, born in Ardmore, County Waterford, is an Irish film director. \n\nIn 1982, O'Connor won a Jacob's Award for his direction of the RTÉ TV adaptation of William Trevor's short story, Ballroom of Romance starring Cyril Cusack and Brenda Fricker.  It was shot near the village of Ballycroy, County Mayo.  He also directed Trevor's One of Ourselves for BBC TV, again starring Cyril Cusack, and filmed in Cappoquin and Lismore, Co.  Waterford...", url:"https://themoviedb.org/person/19969"}}, {tmdbId:"101446", properties:{imdbId:"0796915", name:"David Siegel", url:"https://themoviedb.org/person/101446"}}, {tmdbId:"73496", properties:{bornIn:"San Diego, California, United States", imdbId:"0669004", born:date('1943-01-25'), name:"Richard Pearce", bio:"From Wikipedia, the free encyclopedia. \n\nRichard Pearce (born January 25, 1943 in San Diego, California) is an American film director and producer. \n\nHe prepped at St.  Paul's School and then earned a B. A. , English from Yale University in the Class of 1965.  While in college, he was a guitarist for, and a leader of, the Augmented Seven, a singing group that featured three guitarists.  It was the only singing group at Yale at that time that was not strictly a cappella...", url:"https://themoviedb.org/person/73496"}}, {tmdbId:"4956", properties:{bornIn:"Parma, Emilia-Romagna, Italia", imdbId:"0000934", born:date('1940-03-16'), name:"Bernardo Bertolucci", bio:"From Wikipedia, the free encyclopedia. \n\nBernardo Bertolucci (born March 16, 1940 – 26 November 2018) was an Italian film director and screenwriter, whose films include The Conformist, Last Tango in Paris, The Last Emperor, Stealing Beauty and The Dreamers.  In recognition of his work, he will be presented with the inaugural Honorary Palme d'Or Award at the opening ceremony of the 2011 Cannes Film Festival...", died:date('2018-11-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ivRWPij5GqHmwuGsd0FpbkQaFYU.jpg", url:"https://themoviedb.org/person/4956"}}, {tmdbId:"74058", properties:{bornIn:"San Francisco, California, USA", imdbId:"2480587", born:date('1955-03-24'), name:"Charles Ferguson", bio:"From Wikipedia, the free encyclopedia. \n\nCharles Henry Ferguson (born March 24, 1955) is founder and president of Representational Pictures, Inc. , director and producer of No End In Sight: The American Occupation of Iraq (2007) and Inside Job (2010), which won the Academy Award for Best Documentary.  Ferguson is also a successful software entrepreneur, writer and authority in technology policy. \n\nDescription above from the Wikipedia article Charles H...", url:"https://themoviedb.org/person/74058"}}, {tmdbId:"1214381", properties:{imdbId:"0939869", name:"Martin Wood", bio:"Martin Wood is a Canadian television and film director and producer, best known for his work on the science fiction series \"Stargate SG-1\" and the spin-off \"Stargate Atlantis\", as well as the mystery show \"Sanctuary\".  He has also directed for many other television movies and series', including \"Killjoys\", \"When Calls the Heart\", and the \"Aurora Teagarden Mystery\" franchise...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qQP6R8DbFNtzPkCNkABMJN9LraP.jpg", url:"https://themoviedb.org/person/1214381"}}, {tmdbId:"74257", properties:{bornIn:"Winston-Salem, North Carolina, USA", imdbId:"2879822", born:date('1979-02-04'), name:"Peter Joseph", bio:"http://en. wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7lUStw0xX1BXPie4fZqh8gUeN8x.jpg", url:"https://themoviedb.org/person/74257"}}, {tmdbId:"30368", properties:{bornIn:"Los Angeles, California, USA ", imdbId:"0440459", born:date('1979-09-30'), name:"Jonathan Kasdan", bio:"From Wikipedia, the free encyclopedia\n\nJonathan \"Jon\" Kasdan is an American writer and director. \n\nKasdan is the son of Meg (née Goldman), a writer, and film director Lawrence Kasdan.  He is the brother of director and actor Jake Kasdan.  His directorial debut, In the Land of Women, was released in the United States in 2007.  Kasdan also wrote the film, which premiered at the Cannes Film Festival in 2006...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nfQVySjVuLdqqL8jLSdfqzRG6Z2.jpg", url:"https://themoviedb.org/person/30368"}}, {tmdbId:"441784", properties:{imdbId:"0414814", name:"Clayton Jacobson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iUcGd9Z30R64C7QTAxdRjXgTczc.jpg", url:"https://themoviedb.org/person/441784"}}, {tmdbId:"131792", properties:{imdbId:"0414312", name:"Alan Jacobs", url:"https://themoviedb.org/person/131792"}}, {tmdbId:"82939", properties:{bornIn:"Maldon, Essex", imdbId:"0929317", born:date('1972-05-27'), name:"Toby Wilkins", bio:"From Wikipedia, the free encyclopedia. \n\nToby Wilkins is the British-born director of two feature films, Splinter and The Grudge 3, and several award-winning short films. \n\nDescription above from the Wikipedia article Toby Wilkins, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/82939"}}, {tmdbId:"20019", properties:{bornIn:"Philadelphia, Pennsylvania, USA", imdbId:"0200005", born:date('1959-12-24'), name:"Lee Daniels", bio:"From Wikipedia, the free encyclopedia. \n\nLee Louis Daniels (born December 24, 1959) is an American actor, film producer, and director.  He produced Monster's Ball and directed the film Precious, which received six Academy Award nominations, including Best Director; the film won two of the awards. \n\nDescription above from the Wikipedia article Lee Daniels, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/20019"}}, {tmdbId:"77964", properties:{bornIn:"England, UK", imdbId:"0054954", born:date('1965-11-29'), name:"Mike Barker", bio:"From Wikipedia, the free encyclopedia\n\nMike Barker (born November 29, 1965) is a British film director. \n\nDescription above from the Wikipedia article Mike Barker (film director), licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/77964"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"125690", properties:{bornIn:"Tokyo, Japan", imdbId:"0621540", born:date('1905-08-20'), name:"Mikio Naruse", bio:"From Wikipedia, the free encyclopedia. \n\nMikio Naruse (August 20, 1905 – July 2, 1969) was a Japanese filmmaker, screenwriter, and producer who directed some 89 films spanning the period 1930 (towards the end of the silent period in Japan) to 1967. \n\nNaruse is known for imbuing his films with a bleak and pessimistic outlook.  He made primarily shomin-geki (working-class drama) films with female protagonists, portrayed by actresses such as Hideko Takamine, Kinuyo Tanaka, and Setsuko Hara...", died:date('1969-07-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tejlhhxi24UQRCoDcMP9nTXNCiq.jpg", url:"https://themoviedb.org/person/125690"}}, {tmdbId:"58189", properties:{bornIn:"Taipei, Taiwan", imdbId:"0510912", born:date('1971-10-01'), name:"Justin Lin", bio:"From Wikipedia, the free encyclopedia\n\nJustin Lin (born 1971) is an Taiwanese American film director, best known for his work on The Fast and the Furious franchise and the television show, Community. \n\nDescription above from the Wikipedia article Justin Lin, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3soVfPa5809qmtQNbzECTGaXpgW.jpg", url:"https://themoviedb.org/person/58189"}}, {tmdbId:"11834", properties:{bornIn:"Highland Park, Illinois, USA", imdbId:"0783544", born:date('1940-02-12'), name:"David Seltzer", bio:"From Wikipedia, the free encyclopedia. \n\nDavid Seltzer (born 1940) is an American screenwriter, producer and director, perhaps best known for writing The Omen (1976), and Bird on a Wire (1990), starring Mel Gibson and Goldie Hawn.  As writer/director, Seltzer's credits include the 1986 teen tragi-comedy Lucas starring Corey Haim, Charlie Sheen and Winona Ryder, the 1988 comedy Punchline starring Sally Field and Tom Hanks, and 1992's Shining Through starring Melanie Griffith and Michael Douglas...", url:"https://themoviedb.org/person/11834"}}, {tmdbId:"74060", properties:{bornIn:"Los Angeles, California, USA", imdbId:"1332844", born:date('1970-10-13'), name:"Amy J. Berg", bio:"Amy J.  Berg is an American filmmaker.  Her 2006 documentary Deliver Us from Evil, about sex abuse cases in the Roman Catholic Church, was nominated for an Academy Award and won Berg the Writers Guild of America Award for Best Documentary Screenplay...", url:"https://themoviedb.org/person/74060"}}, {tmdbId:"96318", properties:{imdbId:"0721279", name:"Franc. Reyes", bio:"From Wikipedia, the free encyclopedia. \n\nFranc.  Reyes is a film director of Puerto Rican descent.  In 2002 he won the ALMA Award for Emerging Filmmaker.  Films he has directed include Empire, which opened the New York International Latino Film Festival, and Illegal Tender. \n\nDescription above from the Wikipedia article Franc.  Reyes, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/96318"}}, {tmdbId:"122965", properties:{imdbId:"0413452", name:"Dianne Jackson", url:"https://themoviedb.org/person/122965"}}, {tmdbId:"51023", properties:{imdbId:"1729303", born:date('1975-09-19'), name:"Marcus Dunstan", bio:"From Wikipedia, the free encyclopedia. \n\nMarcus Dunstan (born September 19, 1975) is an American screenplay writer and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rGJBPAG8lpkmr0COUNNSK6nnk.jpg", url:"https://themoviedb.org/person/51023"}}, {tmdbId:"74565", properties:{imdbId:"0455741", name:"Jack Kinney", bio:"From Wikipedia, the free encyclopedia. \n\nJack Ryan Kinney (March 29, 1909 – February 9, 1992) was an American animator, director and producer of animated shorts. \n\nJack Kinney attended John Muir Junior High School in Los Angeles, California (1925), and attended John C.  Fremont High School (1926 - 1928) there with Roy Williams.  Both Fremont football players, they would later be hired by Walt Disney in 1930 to work at the Walt Disney Studio on Hyperion Avenue...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dgPpgyYQ4nYY8eFb6QLTzz3YTK7.jpg", url:"https://themoviedb.org/person/74565"}}, {tmdbId:"74589", properties:{imdbId:"2071216", name:"Chris Paine", bio:"From Wikipedia, the free encyclopedia. \n\nChris Paine is an American filmmaker.  His most notable works to date as director are the documentaries Who Killed the Electric Car? and Revenge of the Electric Car?\n\nDescription above from the Wikipedia article Chris Paine, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/74589"}}, {tmdbId:"63306", properties:{bornIn:"UK", imdbId:"1220140", born:date('1973-05-20'), name:"James Watkins", url:"https://themoviedb.org/person/63306"}}, {tmdbId:"74619", properties:{bornIn:"DeForest, Wisconsin, USA", imdbId:"1890845", born:date('1969-01-01'), name:"Sean Anders", bio:"Sean Anders is an American film director, actor, screenwriter, and producer.  He most recently directed the comedy film Sex Drive starring Clark Duke and Josh Zuckerman. \n\nHe is the brother of actress Andrea Anders...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vWO1FiGZPOL4FdhbxeykOXRfcXJ.jpg", url:"https://themoviedb.org/person/74619"}}, {tmdbId:"21807", properties:{bornIn:"Tennessee, Stati Uniti", imdbId:"0712753", born:date('1971-09-21'), name:"Billy Ray", bio:"From Wikipedia, the free encyclopedia. \n\nWilliam (Billy) Ray is an American screenwriter and director.  He began writing for television and movies in 1994 with Color of Night.  He has written numerous movies including Volcano and Hart's War.  He was one of the creators and writers of the science fiction show Earth 2. \n\nBilly Ray in 2007 (+/-)\n\nStarting in 2003 he began to direct as well as write; his first film was Shattered Glass, the story of a reporter who invented his stories...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l5wSvlFkc7tjV6ETxJwOEwj8gHi.jpg", url:"https://themoviedb.org/person/21807"}}, {tmdbId:"29648", properties:{bornIn:"Bridgeport, Connecticut, USA", imdbId:"0193303", born:date('1927-08-12'), name:"Dan Curtis", bio:"​From Wikipedia, the free encyclopedia. \n\nDan Curtis  (August 12, 1927 – March 27, 2006) was an American director and producer of television and film, probably best known for his miniseries The Winds of War and War and Remembrance and for his afternoon TV series Dark Shadows.  Dark Shadows originally aired from 1966 to 1971 and has aired in syndication for nearly 40 years.  Curtis was responsible for the 1991 remake of Dark Shadows, which was canceled due to low ratings...", died:date('2006-03-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sZhCvP3WCdaRHcuW1xj1bxsVNjn.jpg", url:"https://themoviedb.org/person/29648"}}, {tmdbId:"91295", properties:{imdbId:"0558567", name:"Michael Matheson", url:"https://themoviedb.org/person/91295"}}, {tmdbId:"1105693", properties:{imdbId:"0492825", name:"Jesse Lawrence", url:"https://themoviedb.org/person/1105693"}}, {tmdbId:"116370", properties:{bornIn:"Manhattan, New York, USA", imdbId:"0224683", born:date('1951-11-26'), name:"Matthew Diamond", bio:"Matthew Diamond is an American film and television director, producer and choreographer.  He was nominated for an Academy Award in 1999 for directing the documentary film The Dancemaker.  As well as being nominated for several Primetime Emmy Awards, Daytime Emmy Awards, DGA Awards, and won at the San Francisco International Film Festival...", url:"https://themoviedb.org/person/116370"}}, {tmdbId:"122944", properties:{bornIn:"Chester, Pennsylvania, USA", imdbId:"0330619", name:"Steve Gordon", died:date('1982-11-27'), url:"https://themoviedb.org/person/122944"}}, {tmdbId:"16589", properties:{bornIn:"London, England, UK", imdbId:"0003423", born:date('1939-01-01'), name:"Peter MacDonald", bio:"From Wikipedia, the free encyclopedia.   Peter MacDonald is a film director, cinematographer, and producer from London, England. \n\nHe is most noted as the director of the films Rambo III, The NeverEnding Story III, and the television mini-series The Monkey King (also known as The Lost Empire). \n\nHe served as a co-producer of the film version of Harry Potter and the Goblet of Fire and was the Director of Photography for Hamburger Hill...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sulOWgN2WZKDOlg8JMpTv8TUSHh.jpg", url:"https://themoviedb.org/person/16589"}}, {tmdbId:"70287", properties:{imdbId:"0278181", name:"Will Finn", bio:"Will Finn is an American animator, voice actor, and director.  His work in animation includes characters from Disney and Don Bluth films such as The Secret of NIMH, Oliver and Company, and Pocahontas.  His characters include Laverne (The Hunchback of Notre Dame), Iago (Aladdin), and Cogsworth (Beauty and the Beast)...", url:"https://themoviedb.org/person/70287"}}, {tmdbId:"80671", properties:{imdbId:"0998551", born:date('1904-05-31'), name:"John Sanford", bio:"​From Wikipedia, the free encyclopedia. \n\nJohn Sanford or John B.  Sanford, born Julian Lawrence Shapiro (May 31, 1904 - March 5, 2003), was an American screenwriter and author who wrote 24 books.  The Cambridge Companion to Jewish American Literature describes him as \"Perhaps the most outstanding neglected novelist\"...", died:date('2003-03-05'), url:"https://themoviedb.org/person/80671"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"1106992", properties:{imdbId:"1900414", name:"Camilo Tavares", url:"https://themoviedb.org/person/1106992"}}, {tmdbId:"158050", properties:{imdbId:"2325735", name:"Chris Fiore", url:"https://themoviedb.org/person/158050"}}, {tmdbId:"56343", properties:{bornIn:"Los Angeles, California, U.S.", imdbId:"0034712", born:date('1968-02-02'), name:"Michael Arias", bio:"​From Wikipedia, the free encyclopedia. \n\nMichael Arias  (born 1968) is an American-born filmmaker active primarily in Japan...", url:"https://themoviedb.org/person/56343"}}, {tmdbId:"1107980", properties:{imdbId:"3795588", name:"Ben Nott", bio:"Ben Nott is an Australian director and the founder of World Wide Mind.  Drift is his first feature film...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jGXE8fASkWF4XZO0XNiJaaObu9j.jpg", url:"https://themoviedb.org/person/1107980"}}, {tmdbId:"143059", properties:{imdbId:"1449018", name:"Patrick Hughes", url:"https://themoviedb.org/person/143059"}}, {tmdbId:"21085", properties:{bornIn:"Alexandria, Egypt", imdbId:"0001639", born:date('1963-09-23'), name:"Alex Proyas", bio:"Alexander \"Alex\" Proyas is an Greek Australian film director, screenwriter, and producer.  He is best known for directing the science fiction films The Crow, Dark City, I, Robot and Knowing.  He employs a dark and stylized way of filming, usually in a post-apocalyptic setting.  Throughout his career, his films have acquired a cult following...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sauDcvpta6UpDMIaI7F9UdSliaC.jpg", url:"https://themoviedb.org/person/21085"}}, {tmdbId:"35736", properties:{bornIn:" Mumbai, Maharashtra, India", imdbId:"0424103", born:date('1972-05-25'), name:"Karan Johar", bio:"Karan Johar often informally referred to as KJo,  is an Indian film director, producer, screenwriter, costume designer,  actor and television personality who is primarily known for his work in  Hindi films.  He is the son of Hiroo Johar and the acclaimed producer Yash Johar. \n\nJohar made his directorial debut with the blockbuster romance Kuch Kuch Hota Hai (1998), which earned him the Filmfare Awards for Best Director and Best Screenplay...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8YoKiARl7GQI3jJnp0h1tjD76jJ.jpg", url:"https://themoviedb.org/person/35736"}}, {tmdbId:"1044", properties:{bornIn:"New York City, New York, USA", imdbId:"0152469", born:date('1935-11-21'), name:"Michael Chapman", bio:"​From Wikipedia, the free encyclopedia.   \n\nMichael Chapman, A. S. C.  (born November 21, 1935) is an American cinematographer whose prominence owes most to his innovative work of the 1970s and 1980s.  He began his career as a camera operator, distinguishing himself on Steven Spielberg's Jaws.  As a cinematographer, he became famous for his two collaborations with Martin Scorsese, Taxi Driver and Raging Bull.  Chapman was also cinematographer for the 1978 remake of Invasion of the Body Snatchers...", url:"https://themoviedb.org/person/1044"}}, {tmdbId:"75915", properties:{bornIn:"Seoul, South Korea", imdbId:"2947553", born:date('1974-01-01'), name:"Na Hong-jin", bio:"​From Wikipedia, the free encyclopedia. \n\nNa Hong-jin  (born 1974) is a South Korean film director and screenwriter.  For his debut film The Chaser (2008), Na won Best Director at the 45th Grand Bell Awards in 2008.  The film also won the award for Best Film.  His follow up film, The Yellow Sea, was released in South Korea on December 15, 2010.  It is scheduled to be screened in the Un Certain Regard section at the 2011 Cannes Film Festival...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jeNtJQNfdcpwwNiwmCvTuCDXQAu.jpg", url:"https://themoviedb.org/person/75915"}}, {tmdbId:"77300", properties:{bornIn:"Milwaukee, Wisconsin, USA", imdbId:"0776317", born:date('1938-11-10'), name:"Michael Schultz", bio:"Schultz was born in Milwaukee, Wisconsin, the son of Katherine Frances (née Leslie), a factory worker, and German American Leo Schultz, an insurance salesman. \n\nAfter his undergraduate work at the University of Wisconsin–Madison and Marquette University, he attended Princeton University, where in 1966 he directed his first play, a production of Waiting for Godot.  He joined the Negro Ensemble Company in 1968, which brought him to Broadway in 1969...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ubDK1oZPTG1ygGldz3Lp5AMLHAE.jpg", url:"https://themoviedb.org/person/77300"}}, {tmdbId:"8452", properties:{bornIn:"Zavrazhye, USSR", imdbId:"0001789", born:date('1932-04-04'), name:"Andrei Tarkovsky", bio:"Andrei Arsenyevich Tarkovsky was a Russian filmmaker, writer, film editor, film theorist and opera director, widely regarded as one of the finest filmmakers of the 20th century.  Tarkovsky's films include Andrei Rublev, Solaris, Mirror and Stalker.  He directed the first five of his seven feature films in the Soviet Union; his last two films were produced in Italy and Sweden, respectively...", died:date('1986-12-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j0toVLrgLNuyGnUxGPnSfnPiSf5.jpg", url:"https://themoviedb.org/person/8452"}}, {tmdbId:"77867", properties:{imdbId:"0522844", name:"Stephen Low", url:"https://themoviedb.org/person/77867"}}, {tmdbId:"77162", properties:{bornIn:"Bogotá, DC, Colombia", imdbId:"0006554", born:date('1959-08-24'), name:"Rodrigo García", bio:"​From Wikipedia, the free encyclopedia.   \n\nRodrigo García Barcha (born August 24, 1959) is a Colombian-born television and film director. \n\nDescription above from the Wikipedia article Rodrigo García Barcha, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/77162"}}, {tmdbId:"84737", properties:{imdbId:"0792120", name:"Adrian Shergold", bio:"Adrian Shergold is a British director and former actor.   He won the BAFTA Award for Best Drama Serial for Holding On in 1998.   He is represented by United Agents...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yRkoTOocCdTyTyetxLAS0dCg7UR.jpg", url:"https://themoviedb.org/person/84737"}}, {tmdbId:"9556", properties:{bornIn:"Bishop, California, USA", imdbId:"0057106", name:"David Barrett", bio:"David Barrett is Stunts, director and producer...", url:"https://themoviedb.org/person/9556"}}, {tmdbId:"58137", properties:{bornIn:"Sydney, Australia", imdbId:"0003088", born:date('1952-11-14'), name:"Chris Noonan", bio:"​From Wikipedia, the free encyclopedia. \n\nChris Noonan (born 14 November 1952) is a Sydney-based Australian filmmaker and actor best known for the pioneering live-action / CG film Babe, for which he received Academy Award nominations as both director and writer...", url:"https://themoviedb.org/person/58137"}}, {tmdbId:"3310", properties:{imdbId:"0601680", name:"Nick Moore", url:"https://themoviedb.org/person/3310"}}, {tmdbId:"56661", properties:{bornIn:"New York City, USA", imdbId:"1349522", born:date('1976-06-18'), name:"Jonathan Levine", bio:"Jonathan A.  Levine is an American film director and screenwriter...", url:"https://themoviedb.org/person/56661"}}, {tmdbId:"50460", properties:{bornIn:"Washington, District of Columbia, USA", imdbId:"1555287", born:date('1960-06-27'), name:"Michael Mayer", bio:"Michael Mayer (born June 27, 1960) is an American stage and film director.  He won the Tony Award for Best Direction of a Musical in 2007 for directing Spring Awakening. \n\nDescription above from the Wikipedia article Michael Mayer (director), licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/50460"}}, {tmdbId:"129952", properties:{bornIn:"Burbank, California, USA", imdbId:"0573732", born:date('1962-05-09'), name:"Sean McNamara", bio:"Sean Patrick Michael McNamara is an American film director, film producer, actor, and screenwriter. \n\nMcNamara was born in Burbank, California.  He is best known for his feature film Soul Surfer (film) and in the preteen film market, having worked with Jessica Alba, Hilary Duff, Shia LaBeouf, Christy Carlson Romano, and Raven-Symoné.  McNamara and David Brookwell are the founders of the Brookwell McNamara Entertainment production company...", url:"https://themoviedb.org/person/129952"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"76998", properties:{bornIn:"Truro, Cornwall, England, UK", imdbId:"1016428", born:date('1963-04-30'), name:"James Marsh", bio:"James Marsh (born April 30, 1963 Truro, Cornwall) is a film director known for directing the cult film Wisconsin Death Trip starring Marcus Monroe and Sir Ian Holm.  He won 2008 Academy Award for Best Documentary Feature for directing Man on Wire. \n\nMarsh lives in Copenhagen, Denmark, with his wife and two children.  As an undergraduate, he studied at St.  Catherine's College, Oxford...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5GLeZgnbPqZ1LRpSAL4fmHvZEA0.jpg", url:"https://themoviedb.org/person/76998"}}, {tmdbId:"6737", properties:{bornIn:"Albuquerque, New Mexico, USA", imdbId:"0005366", born:date('1957-06-14'), name:"Jay Roach", bio:"Matthew Jay Roach (born June 14, 1957) is an American film director and producer, best known for directing the Austin Powers films and Meet the Parents...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lDErnan1vpTFa7ctHac0cMEbDt5.jpg", url:"https://themoviedb.org/person/6737"}}, {tmdbId:"1577", properties:{bornIn:"Newport News, Virginia, USA", imdbId:"0446819", born:date('1975-03-28'), name:"Richard Kelly", bio:"James Richard Kelly better known as Richard Kelly, is an American film director and writer, known for writing and directing the cult classic Donnie Darko in 2001. \n\nKelly was born James Richard Kelly in Newport News, Virginia, the son of Lane and Ennis Kelly.  He won a scholarship to the University of Southern California to study at the USC School of Cinema-Television.  He made two short films at USC, The Goodbye Place and Visceral Matter, before graduating in 1997...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2Fq08Oc1uCK7u5NqINLCkYfBaZS.jpg", url:"https://themoviedb.org/person/1577"}}, {tmdbId:"130140", properties:{imdbId:"0338316", name:"Sam Green", bio:"Sam Green is a San Francisco-based documentary filmmaker.  His film, The Weather Underground, was nominated for an Academy Award in 2004, broadcast nationally on PBS, and included in the Whitney Biennial.   Description above from the Wikipedia article Sam Green, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/130140"}}, {tmdbId:"1035", properties:{bornIn:"Grand Rapids, Michigan, USA", imdbId:"0001707", born:date('1946-07-22'), name:"Paul Schrader", bio:"Paul Joseph Schrader is an American screenwriter and film director.  Despite his credentials as a director, Schrader has received more recognition for his screenplays for others, especially Martin Scorsese’s Taxi Driver and Raging Bull...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ctRxgCUSRFudwFaPG2AanL71Y3V.jpg", url:"https://themoviedb.org/person/1035"}}, {tmdbId:"76381", properties:{bornIn:"San Francisco, California, USA", imdbId:"0124877", born:date('1894-12-17'), name:"David Butler", bio:"From Wikipedia, the free encyclopedia\n\nDavid Butler (December 17, 1894 – June 14, 1979) was an American actor, film director, film producer, screenwriter, and television director. \n\nButler was born in San Francisco, California.  His mother was an actress and his father was a theater stage manager.  His first acting roles were playing extras in stage plays.  He later appeared in two D.  W.  Griffith films, The Girl Who Stayed Home and The Greatest Thing in Life...", died:date('1979-06-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iiFKQAir5Y81Vepwmd58lzCb07Y.jpg", url:"https://themoviedb.org/person/76381"}}, {tmdbId:"80691", properties:{bornIn:"Manchester, England", imdbId:"1369705", name:"Gary Chapman", bio:"From Wikipedia, the free encyclopedia.   Gary Chapman (born 1961) is a British Sculptor, Film director, Animator and Storyboard artist, he made his directorial debut with Valiant.  A native of Manchester, England, he created displays for many major British museums. \n\nDescription above from the Wikipedia article  Gary Chapman, licensed under CC-BY-SA,full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/80691"}}, {tmdbId:"116804", properties:{imdbId:"0770643", name:"John Scheinfeld", url:"https://themoviedb.org/person/116804"}}, {tmdbId:"96166", properties:{bornIn:"Utica, New York,USA", imdbId:"0192845", born:date('1960-09-11'), name:"John Curran", bio:"John Curran (born September 11, 1960) is an American film director and screenwriter. \n\nBorn in Utica, New York, Curran studied illustration and design at Syracuse University, then worked as an illustrator, graphic designer, and production designer in Manhattan before moving to Sydney, Australia in 1986.  There he worked on television commercials before writing and directing the short film Down Rusty Down...", url:"https://themoviedb.org/person/96166"}}, {tmdbId:"83642", properties:{bornIn:"Matsumoto, Nagano, Japan", imdbId:"0299175", born:date('1934-08-19'), name:"Yasuo Furuhata", died:date('2019-05-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3wMRWXUMVAWmgLFA4y1C60ldsTc.jpg", url:"https://themoviedb.org/person/83642"}}, {tmdbId:"31654", properties:{bornIn:"Rahway, New Jersey, USA", imdbId:"0807687", born:date('1970-01-01'), name:"Chris Smith", bio:"Chris Smith (born in 1970) is an American film director, cameraman, producer, writer, and editor.  He is best known for directing American Movie, which was awarded the Grand Jury Prize for Documentary at the 1999 Sundance Film Festival. \n\nSmith completed his first film, American Job, while attending the University of Wisconsin–Milwaukee's Graduate Film Program...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kM0jh8l0iByCeccUuWr6ygnjKXz.jpg", url:"https://themoviedb.org/person/31654"}}, {tmdbId:"89112", properties:{bornIn:"New York City, New York, USA", imdbId:"1902232", born:date('1972-03-24'), name:"Tony Leondis", bio:"Anthony «Tony» Leondis is an american director, screenwriter and voice actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ri6nyNxNmCVO6ZYiv29qKgzVYsA.jpg", url:"https://themoviedb.org/person/89112"}}, {tmdbId:"56339", properties:{bornIn:"Yokohama, Kanagawa Prefecture, Japan", imdbId:"0442791", born:date('1950-11-18'), name:"Yoshiaki Kawajiri", bio:"Yoshiaki Kawajiri is a Japanese director, animator and writer...", url:"https://themoviedb.org/person/56339"}}, {tmdbId:"78012", properties:{bornIn:"St-Felicien, Quebec, Canada", imdbId:"0320660", born:date('1963-01-12'), name:"François Girard", bio:"From Wikipedia, the free encyclopedia. \n\nFrançois Girard (born January 12, 1963) is a French-Canadian director and screenwriter particularly noted for his innovative film Thirty Two Short Films About Glenn Gould.  Born in Quebec, Girard's career began on the Montreal art video circuit...", url:"https://themoviedb.org/person/78012"}}, {tmdbId:"81727", properties:{bornIn:"Bronx, New York, USA", imdbId:"0552140", born:date('1964-01-07'), name:"Darnell Martin", bio:"From Wikipedia, the free encyclopedia. \n\nDarnell Martin (born January 7, 1964) is a television and film director, screenwriter, and film producer...", url:"https://themoviedb.org/person/81727"}}, {tmdbId:"76559", properties:{imdbId:"1215448", born:date('1954-08-12'), name:"Sam Jones", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c0dVnYnCe98qL9RD8N9xMWXzghQ.jpg", url:"https://themoviedb.org/person/76559"}}, {tmdbId:"78485", properties:{imdbId:"0569814", name:"Jeff McGrath", url:"https://themoviedb.org/person/78485"}}, {tmdbId:"14838", properties:{bornIn:"Paris, Arkansas, U.S.", imdbId:"0108745", born:date('1936-02-03'), name:"James Bridges", bio:"James Bridges (February 3, 1936 — June 6, 1993) was an American screenwriter, film director, producer and actor. \n\nDescription above from the Wikipedia article James Bridges, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1993-06-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/htWdKQtvjj5kfdqp867vbSXNcWh.jpg", url:"https://themoviedb.org/person/14838"}}, {tmdbId:"52870", properties:{imdbId:"0426333", name:"Tim Johnson", url:"https://themoviedb.org/person/52870"}}, {tmdbId:"1205756", properties:{imdbId:"1369708", name:"Patrick Gilmore", url:"https://themoviedb.org/person/1205756"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"79656", properties:{imdbId:"0776271", name:"John Schultz", bio:"From Wikipedia, the free encyclopedia. \n\nJohn Schultz is an American film director, screenwriter and producer. \n\nSchultz has directed such films as Bandwagon, Drive Me Crazy, Like Mike, When Zachary Beaver Came to Town, The Honeymooners Aliens in the Attic and Judy Moody and the Not Bummer Summer. \n\nDescription above from the Wikipedia article John Schultz, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/79656"}}, {tmdbId:"17246", properties:{bornIn:"Winston-Salem, North Carolina, USA", imdbId:"0607275", born:date('1968-01-01'), name:"Phil Morrison", bio:"Phil Morrison is an American film director best known for his first feature-length film Junebug...", url:"https://themoviedb.org/person/17246"}}, {tmdbId:"7314", properties:{bornIn:"Preston, Lancashire, England", imdbId:"0661910", born:date('1958-12-06'), name:"Nick Park", bio:"Nicholas Wulstan \"Nick\" Park, CBE is an English filmmaker of stop motion animation best known as the creator of Wallace and Gromit and Shaun the Sheep. \n\nPark has been nominated for an Academy Award a total of six times, and won four with; Creature Comforts (1989), The Wrong Trousers (1993), A Close Shave (1995), and Wallace & Gromit: The Curse of the Were-Rabbit (2005)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/f7MzwTzd2Wu2JjL74R8t7ixVBLN.jpg", url:"https://themoviedb.org/person/7314"}}, {tmdbId:"87191", properties:{imdbId:"0448670", name:"Billy Kent", url:"https://themoviedb.org/person/87191"}}, {tmdbId:"87081", properties:{bornIn:"Maidenhead, England, UK", imdbId:"0571098", born:date('1963-12-29'), name:"Dave McKean", bio:"From Wikipedia, the free encyclopedia\n\nDavid McKean (born 29 December 1963 in Maidenhead, Berkshire) is an English illustrator, photographer, comic book artist, graphic designer, filmmaker and musician. \n\nHis work incorporates drawing, painting, photography, collage, found objects, digital art and sculpture. \n\nDescription above from the Wikipedia article Dave McKean, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/87081"}}, {tmdbId:"134656", properties:{bornIn:"Hampshire, England", imdbId:"0994585", born:date('1967-02-08'), name:"Suzie Templeton", url:"https://themoviedb.org/person/134656"}}, {tmdbId:"1901", properties:{bornIn:" Washington, D.C", imdbId:"0003031", born:date('1956-04-23'), name:"Caroline Thompson", bio:"From Wikipedia, the free encyclopedia. \n\nCaroline Thompson (born April 23, 1956) is an American novelist, screenwriter, film director, and producer.  She wrote the screenplays for Tim Burton's films Edward Scissorhands, The Nightmare Before Christmas, and Corpse Bride.  She co-wrote the story for Edward Scissorhands and recently co-adapted a new stage version of the film with director and choreographer Matthew Bourne...", url:"https://themoviedb.org/person/1901"}}, {tmdbId:"26205", properties:{imdbId:"0090386", name:"James Bobin", bio:"James Bobin is a British film director, writer, and producer.  He has worked as a director and writer on The 11 O'Clock Show and Da Ali G Show, and helped create the characters of Ali G, Borat, and Bruno.   In 2003 and 2004, he directed and co-wrote all of the 12 episodes of Ali G in da USAiii for HBO. \n\nWith Bret McKenzie and Jemaine Clement, he co-created Flight of the Conchords, also for HBO.  Bobin had previously seen Clement and McKenzie perform and signed on to co-create the show...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AjJMspp3memKTprOdzwN3HvR7.jpg", url:"https://themoviedb.org/person/26205"}}, {tmdbId:"40199", properties:{bornIn:"San Diego, California, United States", imdbId:"0542649", born:date('1906-06-30'), name:"Anthony Mann", bio:"From Wikipedia, the free encyclopedia. \n\nAnthony Mann (June 30, 1906 – April 29, 1967) was an American actor and film director. \n\nBorn Emil Anton Bundsmann in the Point Loma area of San Diego, Mann was the son of Jewish-Austrian immigrants Emile Theodore Bundsmann, and his wife Bertha Waxelbaum (original Jewish surname: Weichselbaum) of Macon, Georgia. \n\nMann started out as an actor, appearing in plays off-Broadway in New York City...", died:date('1967-04-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dmAzxUydumigctJSoxnQHFrTH0N.jpg", url:"https://themoviedb.org/person/40199"}}, {tmdbId:"55299", properties:{bornIn:"Bridlington, East Riding of Yorkshire, England", imdbId:"0379179", born:date('1954-01-01'), name:"Mark Herman", bio:"From Wikipedia, the free encyclopedia\n\nMark Herman (born 1954 in Bridlington, East Riding of Yorkshire, England) is an English film director and screenwriter notable for writing &amp; directing the 2008 film The Boy in the Striped Pyjamas. \n\nMark Herman was educated at Woodleigh School, North Yorkshire.  He was late entering the film industry...", url:"https://themoviedb.org/person/55299"}}, {tmdbId:"74429", properties:{bornIn:"Raeford, North Carolina, USA", imdbId:"0665322", born:date('1970-01-15'), name:"Josh Pate", url:"https://themoviedb.org/person/74429"}}, {tmdbId:"47498", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"0601800", born:date('1927-08-07'), name:"Robert Moore", bio:"​From Wikipedia, the free encyclopedia. \n\nRobert Moore (February 1, 1927 – May 10, 1984) was an American stage, film and television director...", died:date('1984-05-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pEGjAHA82IKwT5BSFnf9wP5NQAg.jpg", url:"https://themoviedb.org/person/47498"}}, {tmdbId:"1375201", properties:{bornIn:"Québec - Canada", imdbId:"0779433", born:date('1970-01-01'), name:"Ken Scott", url:"https://themoviedb.org/person/1375201"}}, {tmdbId:"144277", properties:{bornIn:"Caracas, Venezuela", imdbId:"0868643", born:date('1951-10-09'), name:"Fina Torres", bio:"Fina Torres is a film director.  She became known by winning la Caméra d'Or award at the 1985 Cannes Film Festival with her directorial debut film, Oriana.  \n\nShe studied design, photography and journalism in Venezuela and later on film at the Institut des hautes études cinématographiques in Paris.  She now lives in Mexico and the United States.   She continues to work with film projects related to Latin America as well as giving workshops in direction and script writing in Venezuela...", url:"https://themoviedb.org/person/144277"}}, {tmdbId:"27771", properties:{bornIn:"Norfolk, Virginia, United States", imdbId:"0005347", born:date('1944-12-19'), name:"Tim Reid", bio:"Timothy L.  \"Tim\" Reid (born December 19, 1944) is an American actor, comedian and film director best known for his roles in prime time American television programs, such as Venus Flytrap on WKRP in Cincinnati (1978-82), Marcel \"Downtown\" Brown on Simon &amp; Simon (1983-87), Ray Campbell on Sister, Sister (1994-99) and William Barnett on That 70's Show (2004-2006)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zUqFVuSPBK09YVvCIxKkAOtoM8m.jpg", url:"https://themoviedb.org/person/27771"}}, {tmdbId:"84568", properties:{imdbId:"2092872", name:"Rob Williams", url:"https://themoviedb.org/person/84568"}}, {tmdbId:"1180949", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0853074", born:date('1944-01-01'), name:"Robert Taylor", died:date('2014-12-11'), url:"https://themoviedb.org/person/1180949"}}, {tmdbId:"43786", properties:{imdbId:"0541677", name:"Robert Mandel", bio:"From Wikipedia, the free encyclopedia\n\nRobert Mandel is a film producer and director and television director from Oakland, California.  He is best known for his film School Ties, which launched the careers of Brendan Fraser, Matt Damon, Ben Affleck, Cole Hauser and Chris O'Donnell. \n\nDescription above from the Wikipedia article Robert Mandel, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/43786"}}, {tmdbId:"77177", properties:{bornIn:" Fukuoka, Fukuoka Prefecture, Japan", imdbId:"2328122", born:date('1969-03-10'), name:"Fuminori Kizaki", url:"https://themoviedb.org/person/77177"}}, {tmdbId:"77269", properties:{imdbId:"1259871", name:"John Crowley", bio:"From Wikipedia, the free encyclopedia\n\nJohn Crowley (born 1969) is an Irish award-winning television director, theatre and film director.  He is perhaps best known for his feature film debut Intermission (2003). \n\nDescription above from the Wikipedia article John Crowley (director), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2s24bopQ131ZTF3lrBLRFKMHPQG.jpg", url:"https://themoviedb.org/person/77269"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"141475", properties:{imdbId:"0179117", name:"Billy Corben", bio:"William Cohen (born 1978), better known by the stage name Billy Corben, is an American documentary film director.  As a co-founder of the Miami-based studio Rakontur, along with producing partner Alfred Spellman, he has created films such as Cocaine Cowboys, Dawg Fight, and ESPN's 30 for 30 The U and The U Part 2...", url:"https://themoviedb.org/person/141475"}}, {tmdbId:"255283", properties:{name:"Frank Cvitanovich", url:"https://themoviedb.org/person/255283"}}, {tmdbId:"77305", properties:{bornIn:"Shanxi, China", imdbId:"0372092", name:"He Ping", bio:"​From Wikipedia, the free encyclopedia\n\nHe Ping (Hé Píng) (born 1957 in Shanxi, China) is a Chinese film director, whose main filmography consists of a hybrid genre of Western-wuxia movies.  He made three movies along this genre - Swordsmen in Double Flag Town (1991), Sun Valley (1995) and Warriors of Heaven and Earth (2004). \n\nHe is an ethnic Manchu whose ancestors were members of the Blue Banners.  His mother was the female lead in Communist China's first feature film Bridge (1949)...", url:"https://themoviedb.org/person/77305"}}, {tmdbId:"40007", properties:{bornIn:"Edinburgh, Scotland, UK", imdbId:"0533334", born:date('1932-08-16'), name:"John Mackenzie", bio:"John Mackenzie was a British film director perhaps best known for the 1980 gangster film The Long Good Friday.  Born in Edinburgh, Mackenzie worked in British film from the late 1960s, first as an assistant director to Ken Loach on productions such as Up the Junction and Cathy Come Home, before becoming an independent director himself, going on to work in both the UK and the US...", died:date('2011-06-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8sQAnh8Q2zNjAFiCNHddMWNUt0h.jpg", url:"https://themoviedb.org/person/40007"}}, {tmdbId:"19032", properties:{bornIn:"London, England, UK", imdbId:"0396421", born:date('1941-11-21'), name:"John Hough", bio:"​From Wikipedia, the free encyclopedia. \n\nJohn Hough  (born 21 November 1941 in London, England) is a British film and television director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fBV6a7aSVxQQMLQOA1rO19M4iU5.jpg", url:"https://themoviedb.org/person/19032"}}, {tmdbId:"110684", properties:{bornIn:"Yamanashi Prefecture, Japan", imdbId:"0620236", born:date('1955-09-12'), name:"Takashi Nakamura", url:"https://themoviedb.org/person/110684"}}, {tmdbId:"11427", properties:{bornIn:"Kentucky, USA", imdbId:"0730860", born:date('1899-08-02'), name:"William Roberts", bio:"Worked as a magazine illustrator in New York, before joining the Disney Organization in 1932/3...", died:date('1974-03-18'), url:"https://themoviedb.org/person/11427"}}, {tmdbId:"67632", properties:{bornIn:"Danville, Pennsylvania, USA", imdbId:"0548533", born:date('1952-09-24'), name:"Peter Markle", bio:"From Wikipedia, the free encyclopedia. \n\nPeter Markle is an American TV and film director.  He has worked on Everwood, CSI: Crime Scene Investigation, and The X-Files as well as many other programs.  He was director of the successful \"Flight 93\" in 2006 and he also directed the poorly-received comedy western film Wagons East!.  Markle married actress Melinda Culea in 1996...", url:"https://themoviedb.org/person/67632"}}, {tmdbId:"77651", properties:{imdbId:"2911073", name:"Matt Aselton", url:"https://themoviedb.org/person/77651"}}, {tmdbId:"4759", properties:{imdbId:"0446109", born:date('1952-01-01'), name:"David Kellogg", bio:"From Wikipedia, the free encyclopedia. \n\nDavid Kellogg (born 1952) is an American film, commercial, and music video director. \n\nKellogg has gained prominence for dozens of television spots that he has created for clients such as Pepsi, Fuji, AT&T, Sprite, Coke, Nike, Apple, IBM, MCI, United Airlines, and Mercedes Benz.  He is part of Anonymous Content, a commercials and music video production company in Los Angeles, California. \n\nHe married model, actress and former Playboy Playmate Denise Michele...", url:"https://themoviedb.org/person/4759"}}, {tmdbId:"18308", properties:{bornIn:"Dublin, Ireland", imdbId:"0006625", born:date('1956-05-04'), name:"Steve Barron", bio:"From Wikipedia, the free encyclopedia\n\nSteven \"Steve\" Barron (born 4 May 1956) is a director and producer, best known for directing the films Coneheads (1993), Teenage Mutant Ninja Turtles (1990) and the innovative music videos for a-ha's \"Take on Me\" and Michael Jackson's \"Billie Jean\". \n\nHe was born in Dublin, Ireland, the son of filmmaker Zelda Barron.  He attended St Marylebone Grammar School.  He appeared in the film if. . . .  very briefly...", url:"https://themoviedb.org/person/18308"}}, {tmdbId:"77709", properties:{bornIn:"Solna, Stockholms län, Sweden", imdbId:"0895804", born:date('1943-03-29'), name:"Bo Arne Vibenius", bio:"​From Wikipedia, the free encyclopedia\n\nBo Arne Vibenius (born 29 March 1943 in Solna, Stockholms län, Sweden) is a Swedish film director, most famous for his exploitation classics Breaking Point and Thriller – A Cruel Picture (Swedish: Thriller – en grym film).  The latter served as a huge influence on Quentin Tarantino when making his Kill Bill movies and the director has called it \"the roughest revenge movie ever made\" ...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/22u0eK1UAFGUDDufYlDstVAX7yT.jpg", url:"https://themoviedb.org/person/77709"}}, {tmdbId:"13614", properties:{bornIn:"Abington, Pennsylvania, USA", imdbId:"0438226", born:date('1970-11-11'), name:"Deborah Kaplan", bio:"Raised in Abington, Pennsylvania, Deborah Kaplan met her creative partner Harry Elfont while they were both enrolled at the Tisch School of the Arts of New York University (NYU).  They have since written several films together, and directed two: Can't Hardly Wait and Josie and the Pussycats...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pP1MNYEN0H7T2rGWpERNQCRtzxV.jpg", url:"https://themoviedb.org/person/13614"}}, {tmdbId:"69081", properties:{bornIn:"Seoul, South Korea", imdbId:"0453518", born:date('1964-07-06'), name:"Kim Jee-woon", bio:"Kim Jee-Woon is a South Korean film and television writer and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d1waPoYNkCkOnu9z3PRWY6whrJK.jpg", url:"https://themoviedb.org/person/69081"}}, {tmdbId:"20192", properties:{bornIn:"Coventry, Warwickshire, England, UK", imdbId:"0962729", name:"Brian Taylor", bio:"Brian Taylor is an American film director, cinematographer, camera operator, producer, and screenwriter.  He is best known for frequently collaborating with Mark Neveldine as Neveldine/Taylor. \n\nTaylor attended the Los Angeles Film School in Hollywood, California and began his career as a cinematographer, working on a series on independent films and low-budget shorts...", url:"https://themoviedb.org/person/20192"}}, {tmdbId:"102329", properties:{bornIn:"Barcelona, Barcelona, Catalonia, Spain", imdbId:"0728048", name:"María Ripoll", bio:"María Ripoll is a Spanish film director from Barcelona, with an international background and eight feature films to her credit.  The success of her film It's Now or Never has placed her as the highest-grossing female film director in Spanish history...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zcCx5OkSmymYL6y9QUoeV99Auxf.jpg", url:"https://themoviedb.org/person/102329"}}, {tmdbId:"43980", properties:{imdbId:"0396884", name:"Robert Houston", url:"https://themoviedb.org/person/43980"}}, {tmdbId:"77926", properties:{bornIn:"Japan", imdbId:"0556094", born:date('1961-01-03'), name:"Masayuki", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zpFLVbLIGTZ7RnfOVYxRSsOhRYn.jpg", url:"https://themoviedb.org/person/77926"}}, {tmdbId:"1680227", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0338572", name:"Richard Greenberg", died:date('2018-06-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rRNUgp0V9RvXNCuYvmFKaHuh1FE.jpg", url:"https://themoviedb.org/person/1680227"}}, {tmdbId:"78023", properties:{bornIn:"USA", imdbId:"0381230", name:"Michael Herz", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gcP8A1GaTjNFYz9d015qOE5HcBu.jpg", url:"https://themoviedb.org/person/78023"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"82234", properties:{imdbId:"0332985", name:"Bruce Gowers", bio:"​From Wikipedia, the free encyclopedia\n\nBruce Gowers is an English television director and producer, best known for work on large scale live music and event productions.  He started his career in his native England where his landmark music video for Queen's \"Bohemian Rhapsody\" brought him international recognition leading to his relocation to the U. S.  in the late 1970s...", url:"https://themoviedb.org/person/82234"}}, {tmdbId:"78059", properties:{imdbId:"1374747", name:"Yung Chang", bio:"From Wikipedia, the free encyclopedia. \n\nYung Chang (born 1977) is a Chinese Canadian film director. \n\nDescription above from the Wikipedia article Yung Chang, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/78059"}}, {tmdbId:"90425", properties:{bornIn:"Dana Point, California, USA", imdbId:"1440144", born:date('1959-12-11'), name:"Dana Brown", url:"https://themoviedb.org/person/90425"}}, {tmdbId:"20629", properties:{bornIn:"Chinchilla, Queensland, Australia", imdbId:"0004306", born:date('1945-03-03'), name:"George Miller", bio:"George Miller (born 3 March 1945) is an Australian film director, screenwriter, producer, and former medical doctor.  He is probably most well known for his work on the Mad Max movies, but has been involved in a wide range of projects, including the Oscar-winning Happy Feet. \n\nMiller is the older brother of producer Bill Miller. \n\nHe is a also co-founder of the Production House Dr. D Studios and Kennedy-Miller Mitchell Films formerly known as Kennedy-Miller Productions...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4FyQESSzuu1VkPup9CmMjdnUyhv.jpg", url:"https://themoviedb.org/person/20629"}}, {tmdbId:"15452", properties:{bornIn:"Winnipeg, Manitoba, Canada", imdbId:"0825731", born:date('1942-08-09'), name:"David Steinberg", bio:"From Wikipedia, the free encyclopedia. \n\nDavid Steinberg (born August 9, 1942) is a Canadian comedian, actor, writer, director, and author.  At the height of his popularity, during the late 1960s and early 1970s, he was one of the best-known stand-up comics in the United States.  He appeared on Johnny Carson's Tonight Show more than 130 times (second only to Bob Hope in number of appearances) and served as guest host 12 times, the youngest person ever to guest-host...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zQ6hCCSmrzBTNYuaSE3TULljJyq.jpg", url:"https://themoviedb.org/person/15452"}}, {tmdbId:"126462", properties:{bornIn:"Eldwick, Yorks, England, UK", imdbId:"0384342", born:date('1919-07-09'), name:"James Hill", bio:"From Wikipedia, the free encyclopedia\n\nJames (\"Jimmy\") Hill (1 August 1919 - 7 October 1994) was a British film and television director, screenwriter and producer whose career spanned 52 years between 1937–1989, best remembered for his documentaries and short subjects such as Giuseppina and The Home Made Car, and as director of the internationally acclaimed Born Free...", died:date('1994-10-07'), url:"https://themoviedb.org/person/126462"}}, {tmdbId:"74863", properties:{imdbId:"2304017", name:"Lauren Montgomery", bio:"From Wikipedia, the free encyclopedia. \n\nLauren Montgomery is a film animation director and storyboard artist.  She is noted for her \n\nstoryboard work for animated television and DVD movie features.  She has directed the Wonder Woman animated film of the same name, Green Lantern: First Flight, Justice League: Crisis on Two Earths (with Sam Liu) and Superman/Batman: Apocalypse...", url:"https://themoviedb.org/person/74863"}}, {tmdbId:"1788", properties:{bornIn:"New York City, New York, USA", imdbId:"0583292", born:date('1945-12-24'), name:"Nicholas Meyer", bio:"From Wikipedia, the free encyclopedia.   Nicholas Meyer (born December 24, 1945 in New York City, New York) is an American screenwriter, producer, director and novelist, known best for his best-selling novel The Seven-Per-Cent Solution, and for directing the films Time After Time, two of the Star Trek feature film series, and the 1983 television movie The Day After.   Meyer graduated from the University of Iowa with a degree in theater and filmmaking...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aBYeEwRGlQHKJr2iyvGaxyg4wst.jpg", url:"https://themoviedb.org/person/1788"}}, {tmdbId:"90492", properties:{bornIn:"Oberlin, Ohio, USA", imdbId:"1119645", born:date('1965-08-27'), name:"Lynn Shelton", bio:"Lynn Shelton (August 27, 1965 - May 15, 2020) was an American director best known for writing, directing, and producing the 2009 film Humpday...", died:date('2020-05-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yDKuEeGPIYdPaYTvsrnIp7ORce8.jpg", url:"https://themoviedb.org/person/90492"}}, {tmdbId:"58059", properties:{bornIn:"Tasmania, Australia", imdbId:"0462277", born:date('1932-07-16'), name:"Chris Koch", bio:"Chris Koch is an American director of film and television.  Koch is the co-owner of the production company KONK, which he co-created with film producer David Kerwin. \n\nDescription above from the Wikipedia article Chris Koch, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vALNrvfLdegBRy8aME1Ge8LLeeY.jpg", url:"https://themoviedb.org/person/58059"}}, {tmdbId:"37362", properties:{bornIn:"Christiansburg, Virginia, United States", imdbId:"0454771", born:date('1886-01-24'), name:"Henry King", bio:"From Wikipedia, the free encyclopedia. \n\nHenry King (January 24, 1886 – June 29, 1982) was an American film director. \n\nBefore coming to film, King worked as an actor in various repertoire theatres, and first started to take small film roles in 1912.  He directed for the first time in 1915, and grew to become one of the most commercially successful Hollywood directors of the 1920s and 1930s.  He was twice unsuccessfully nominated for the Best Director Oscar...", died:date('1982-06-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/twNUzxToiKhM3ZQLEftyECN60Rf.jpg", url:"https://themoviedb.org/person/37362"}}, {tmdbId:"10076", properties:{bornIn:"London, England, UK", imdbId:"0318150", born:date('1920-03-06'), name:"Lewis Gilbert", bio:"​From Wikipedia, the free encyclopedia.   \n\nLewis Gilbert CBE (born 6 March 1920 in London) was an English film director, producer and screenwriter. \n\nDescription above from the Wikipedia article Lewis Gilbert,  licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2018-02-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e3uN45oGDEf1LaZiVqy4nbqt9RE.jpg", url:"https://themoviedb.org/person/10076"}}, {tmdbId:"147702", properties:{imdbId:"0565119", name:"Douglas McCarthy", url:"https://themoviedb.org/person/147702"}}, {tmdbId:"178486", properties:{name:"Jeffrey Bloom", url:"https://themoviedb.org/person/178486"}}, {tmdbId:"4967", properties:{bornIn:"Nouméa, New Caledonia, France", imdbId:"0383359", born:date('1941-07-28'), name:"Colin Higgins", bio:"Colin Higgins (July 28, 1941 – August 5, 1988) was an American screenwriter, actor, director, and producer.  He was best known for writing the screenplay for the 1971 film Harold and Maude...", died:date('1988-08-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gL19DuEboHBxoq9dlrpY2PSFsme.jpg", url:"https://themoviedb.org/person/4967"}}, {tmdbId:"1056121", properties:{bornIn:"Oakland, California, USA", imdbId:"3363032", born:date('1986-05-23'), name:"Ryan Coogler", bio:"Ryan Kyle Coogler is an African-American screenwriter-director born on May 23, 1986, in Oakland, California.  In his earlier years, he played football -- a vocation that stayed with him into his college career.  While he was at Saint Mary's College of California, his English professor, Rosemary Graham, suggested that Coogler consider a screenwriting career...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oc2jLwyc1rJjrqEK61YPewVwn4n.jpg", url:"https://themoviedb.org/person/1056121"}}, {tmdbId:"17633", properties:{bornIn:"Madison, Wisconsin, USA", imdbId:"0551128", born:date('1960-10-17'), name:"Rob Marshall", bio:"Rob Marshall (born October 17, 1960) is an American theater director, film director and choreographer.  He is a six-time Tony Award nominee, Academy Award nominee, Golden Globe nominee and four-time Emmy winner whose most noted work is the 2002 Academy Award Best Picture winner Chicago. \n\nMarshall was born in Madison, Wisconsin and raised in Pittsburgh, Pennsylvania.  He debuted in the film industry with the Emmy Award-wining TV adaptation of the musical Annie by Charles Strouse and Martin Charnin...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4cTHkbMpsHHNI23HP3RHNLFoPRz.jpg", url:"https://themoviedb.org/person/17633"}}, {tmdbId:"81078", properties:{bornIn:"Budapest, Hungary", imdbId:"0701650", born:date('1974-04-11'), name:"György Pálfi", bio:"György Pálfi born 11 April 1974 in Budapest, Hungary is a Hungarian filmmaker.  His film Taxidermia was screened in the Un Certain Regard section at the 2006 Cannes Film Festival. \n\nPálfi's films have received numerous awards and nominations.  At the 2002 European Film Awards, he won the European Discovery/Fassbinder Award for his début film Hukkle...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iZUOKp6V7u6G2NRTEOf3Rw0kMwU.jpg", url:"https://themoviedb.org/person/81078"}}, {tmdbId:"17649", properties:{bornIn:"Santiago, Chile", imdbId:"0936838", name:"Alexander Witt", bio:"Alexander B.  Witt (born 1952) is a Chilean Hollywood filmmaker who has worked mostly as a camera operator and second unit director.  His feature directorial debut came in 2004 with Resident Evil: Apocalypse, based on the popular Capcom video game series.  Witt also became the 2nd unit director on the James Bond movie Casino Royale in 2006. \n\nFrom a 2004 interview on IGN, he says this about his history: \"I was born in Chile, the third generation of Germans there...", url:"https://themoviedb.org/person/17649"}}, {tmdbId:"1843", properties:{bornIn:"Hückelhoven, North Rhine-Westphalia, Germany", imdbId:"0415714", born:date('1965-07-09'), name:"Thomas Jahn", bio:"From Wikipedia, the free encyclopedia. \n\nThomas Jahn is a German Actor and Director.  He was born in 1965.  Credits include Knockin' on heaven's door ( 1997 Won Gran Angular Award Best Film Sitges - Catalonian International Film Festival , 1998 Won Audience Award and Grand Prize Valenciennes International Festival of Action and Adventure Films, Tatort, Der Dicke, Balko and Sperling...", url:"https://themoviedb.org/person/1843"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"126774", properties:{bornIn:"Skive, Denmark", imdbId:"0283377", born:date('1960-01-14'), name:"Per Fly", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9JNKo8kz8b1pTIud0Dwsye0r8U.jpg", url:"https://themoviedb.org/person/126774"}}, {tmdbId:"2662", properties:{bornIn:"Bisacquino, Sicilia, Italia", imdbId:"0001008", born:date('1897-05-18'), name:"Frank Capra", bio:"Frank Russell Capra (May 18, 1897 – September 3, 1991) was a Sicilian-born American film director and a creative force behind a number of films of the 1930s and 1940s, including It Happened One Night (1934), Mr.  Deeds Goes to Town (1936), Lost Horizon (1937), You Can't Take It With You (1938), Mr.  Smith Goes to Washington (1939), Meet John Doe (1941), Arsenic and Old Lace (1944) and It's a Wonderful Life (1946)...", died:date('1991-09-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1OTZ7CEdEawDgA4qiBidpWTKE2x.jpg", url:"https://themoviedb.org/person/2662"}}, {tmdbId:"133398", properties:{bornIn:"Paris, France", imdbId:"1189197", born:date('1974-04-14'), name:"Quentin Dupieux", bio:"From Wikipedia, the free encyclopedia\n\nMr.  Oizo, a pseudonym of French record producer and film director Quentin Dupieux, is a successful French techno musician, mostly known for his 1999 track, \"Flat Beat\".  His pseudonym is a corruption of the French oiseau, meaning \"bird\".  He is currently signed to French electro record label, Ed Banger Records. \n\nDupieux created a number of music videos and feature films, starting with the 1997 music video \"Kirk\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8MnVaDqB7IoWRYDmz18FHxto54C.jpg", url:"https://themoviedb.org/person/133398"}}, {tmdbId:"228643", properties:{bornIn:"Los Angeles, California, USA", imdbId:"1365879", born:date('1967-10-10'), name:"Morgan Neville", bio:"Morgan Neville is an Academy Award-winning documentary filmmaker.  For over twenty years he has been making films about music and cultural subjects including Troubadours, Search and Destroy and three Grammy-nominated films: Respect Yourself: The Stax Records Story, Muddy Waters Can’t Be Satisfied, and Johnny Cash’s America.  His non-music films include The Cool School, Steinbeck and Shotgun Freeway: Drives Thru Lost L. A. ...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gi8kgpBsyEh7AFboSoL1AI5dOhE.jpg", url:"https://themoviedb.org/person/228643"}}, {tmdbId:"34480", properties:{imdbId:"0953649", born:date('1927-04-05'), name:"Alan Zaslove", url:"https://themoviedb.org/person/34480"}}, {tmdbId:"139851", properties:{name:"Toby Shelton", url:"https://themoviedb.org/person/139851"}}, {tmdbId:"185438", properties:{bornIn:"Mosca, Russia", imdbId:"0850733", born:date('1970-01-17'), name:"Genndy Tartakovsky", bio:"Genndy Tartakovsky is a Russian-American animator, director, producer, screenwriter, storyboard artist, comic book writer and artist.  He is the creator of the animated television series Dexter's Laboratory, Samurai Jack, Star Wars: Clone Wars, and Primal on Cartoon Network's Adult Swim. \n\nHe is also known for co-creating Sym-Bionic Titan and directing the animated Hotel Transylvania film trilogy...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/19hgthbSR0mcp524yUFxcTpOtmk.jpg", url:"https://themoviedb.org/person/185438"}}, {tmdbId:"17883", properties:{bornIn:"New York City, New York, USA", imdbId:"0751102", born:date('1958-08-20'), name:"David O. Russell", bio:"American film director and screenwriter David Owen Russell has been praised for the loose, comic energy that characterizes his work, and is notorious for his explosive confrontations with cast members.  He has won 2 Independent Spirit Awards for writing and directing as well as the Audience Award at Sundance, and a Writers Guild of America Award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/59rXnJS4g5dUr1Hz8QNLo5epD2a.jpg", url:"https://themoviedb.org/person/17883"}}, {tmdbId:"57895", properties:{bornIn:"White Plains, New York, USA", imdbId:"0363553", born:date('1953-01-01'), name:"Robert Harmon", bio:"From Wikipedia, the free encyclopedia. \n\nRobert Harmon is an American film and television director.  He is best known for the 1986 horror classic The Hitcher, starring Rutger Hauer, as well as for films like They and Nowhere to Run. \n\nHis television work is distinguished by the series of made-for-TV movies featuring fictional Paradise (Mass...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i4Yz5DdC0BU00EBYfnZvCOQwuty.jpg", url:"https://themoviedb.org/person/57895"}}, {tmdbId:"141824", properties:{bornIn:"Harlem, New York", imdbId:"0413547", born:date('1958-01-06'), name:"George Jackson", bio:"​From Wikipedia, the free encyclopedia.   \n\nGeorge Jackson (January 6, 1958—February 10, 2000) was a film director and producer.  Jackson was born and raised in Harlem, New York and graduated from Fordham Prep in Bronx, NY and Harvard College in Cambridge, MA.  He worked with Doug McHenry as co-producer on such projects as Krush Groove, Jason's Lyric, New Jack City, and Body Count (1998) in which he made a cameo appearance as a ticket clerk...", died:date('2000-02-10'), url:"https://themoviedb.org/person/141824"}}, {tmdbId:"77733", properties:{imdbId:"0583754", name:"Eric Meza", url:"https://themoviedb.org/person/77733"}}, {tmdbId:"18030", properties:{imdbId:"0262678", name:"David Evans", url:"https://themoviedb.org/person/18030"}}, {tmdbId:"22301", properties:{bornIn:"Petersburg, Virginia, Stati Uniti", imdbId:"0528381", born:date('1970-09-05'), name:"Liam Lynch", url:"https://themoviedb.org/person/22301"}}, {tmdbId:"51866", properties:{imdbId:"0266622", born:date('1973-06-18'), name:"Rick Famuyiwa", bio:"​From Wikipedia, the free encyclopedia.   \n\nRick Famuyiwa, born on June 18, 1973, is an emerging Nigerian American Hollywood writer and director of films such as The Wood (1999), Talk To Me (2007), and Brown Sugar (2002).  His most recent film is the comedy Our Family Wedding (2010), starring Forest Whitaker and America Ferrera.  Famuyiwa’s films mainly explore themes of racial diversity and acceptance of oneself and others, especially within communities of color...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vYbwGX91wqJDcELzZGfHUP90IRx.jpg", url:"https://themoviedb.org/person/51866"}}, {tmdbId:"113876", properties:{imdbId:"0366867", name:"Mark Hartley", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lPqu3Ja7R46TZ5TDaNXYu5ZjwSh.jpg", url:"https://themoviedb.org/person/113876"}}, {tmdbId:"871110", properties:{imdbId:"0847615", name:"Tetsuro Takeuchi", url:"https://themoviedb.org/person/871110"}}, {tmdbId:"80202", properties:{imdbId:"0677409", name:"Steve Peterson", url:"https://themoviedb.org/person/80202"}}, {tmdbId:"30249", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0002545", born:date('1898-08-29'), name:"Preston Sturges", bio:"From Wikipedia, the free encyclopedia. \n\nPreston Sturges (29 August 1898 – 6 August 1959), originally Edmund Preston Biden, was a celebrated playwright, screenwriter and film director born in Chicago, Illinois.  In 1941 he won the Academy Award for Best Original Screenplay for the film The Great McGinty...", died:date('1959-08-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bnJQaN0KONTCmSGvCNuI2HGtmxm.jpg", url:"https://themoviedb.org/person/30249"}}, {tmdbId:"1040117", properties:{imdbId:"0872153", name:"John Trent", died:date('1983-06-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lGwNbrbEfqmd1QU2YhSqFGCxFY5.jpg", url:"https://themoviedb.org/person/1040117"}}, {tmdbId:"4910", properties:{imdbId:"0163376", name:"Michael Clancy", bio:"From Wikipedia, the free encyclopedia.   Michael Clancy (c.  1949 – 2010) was Chief Secretary from 1997 to 2000, and later Governor and Commander-in-Chief of Saint Helena and its Dependencies (Ascension Island and Tristan da Cunha) from 2004 to 2007.   He was married to Claire Clancy who, as of 2009, is the Chief Executive of the National Assembly of Wales.   Michael Clancy died from cancer at the age of 60; his death was announced on February 25, 2010...", url:"https://themoviedb.org/person/4910"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"93975", properties:{bornIn:"Oakengates, Shropshire, England, UK", imdbId:"0020765", born:date('1905-12-25'), name:"Lewis Allen", bio:"​From Wikipedia, the free encyclopedia\n\nLewis Allen (25 December 1905 – 3 May 2000) was an English film and television director.  Allen worked mainly in the United States, directing 18 feature films between 1944 and 1959.  From the mid-1950s he moved increasingly into television and worked on a number of the most popular shows of the time in the U. S. \n\nDescription above from the Wikipedia Lewis Allen (director), licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2000-05-03'), url:"https://themoviedb.org/person/93975"}}, {tmdbId:"324", properties:{bornIn:"Worcester, Massachusetts, USA", imdbId:"0798788", born:date('1964-11-30'), name:"Scott Silver", bio:"Scott Silver is a screenwriter and director...", url:"https://themoviedb.org/person/324"}}, {tmdbId:"56710", properties:{bornIn:"London, England, UK", imdbId:"0662529", born:date('1960-09-06'), name:"Oliver Parker", bio:"From Wikipedia, the free encyclopedia. \n\nOliver Parker (born 6 September 1960) is an English film director. \n\nParker was born in London, the son of Lady Gillian, a writer and GP, and Sir Peter Parker, a railway executive.  His brother is actor Nathaniel Parker. \n\nDescription above from the Wikipedia article Oliver Parker, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/56710"}}, {tmdbId:"2538868", properties:{name:"Mike Smith", url:"https://themoviedb.org/person/2538868"}}, {tmdbId:"65167", properties:{bornIn:"Abingdon, Virginia U.S.", imdbId:"0178376", born:date('1970-01-01'), name:"Scott Cooper", bio:"Scott Cooper is an American actor, writer, director, and producer.  He is known for writing, directing and producing the 2009 film Crazy Heart starring Jeff Bridges.  The film, released by Fox Searchlight Pictures, has received a number of accolades, including awards presented by the Chicago Film Critics Association, the Independent Spirit Awards and by the Writers Guild of America...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zuT4LxFrGq2fCHYD8R6441OmRym.jpg", url:"https://themoviedb.org/person/65167"}}, {tmdbId:"42081", properties:{bornIn:"London, England, UK", imdbId:"1000159", name:"George Butler", bio:"From Wikipedia, the free encyclopedia. \n\nGeorge Butler (born 1944 in London) is an English photographer and documentary filmmaker. \n\nAfter meeting John Kerry in 1964 he worked with him on the book The New Soldier published in 1971. \n\nOn a photo assignment to cover the IFBB Mr.  Universe contest in Baghdad in 1972, Butler met Arnold Schwarzenegger...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/y5rFqD8xdcMUjE4NRDopDMTlKyo.jpg", url:"https://themoviedb.org/person/42081"}}, {tmdbId:"261271", properties:{name:"Maurice Joyce", url:"https://themoviedb.org/person/261271"}}, {tmdbId:"80570", properties:{bornIn:"Memphis, Tennessee, USA", imdbId:"0485943", born:date('1896-08-10'), name:"Walter Lang", bio:"Walter Lang was an American film director...", died:date('1972-02-07'), url:"https://themoviedb.org/person/80570"}}, {tmdbId:"30252", properties:{bornIn:"Brooklyn, New York", imdbId:"0506797", born:date('1894-09-23'), name:"Albert Lewin", bio:"From Wikipedia, the free encyclopedia. \n\nAlbert Lewin (1894–1968) was an American film director, producer, and screenwriter. \n\nHe was born in Brooklyn, New York on September 23, 1894 and raised in Newark, New Jersey.  He earned a Master's degree at Harvard and taught English at the University of Missouri.  During World War I, he served in the military and was afterwards appointed assistant national director of the American Jewish Relief Committee...", died:date('1968-05-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sj4EQdm5Fz1ebgGSUM27fr2nZBU.jpg", url:"https://themoviedb.org/person/30252"}}, {tmdbId:"82219", properties:{bornIn:"Delano, California", imdbId:"0883609", born:date('1940-06-26'), name:"Luis Valdez", bio:"From Wikipedia, the free encyclopedia. \n\nLuis Valdez (born June 26, 1940) is an American playwright, writer and film director. \n\nHe is regarded as the father of Chicano theater in the United States. \n\nDescription above from the Wikipedia article Luis Valdez, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/82219"}}, {tmdbId:"11092", properties:{bornIn:"London, England, UK", imdbId:"1334526", born:date('1973-08-02'), name:"Simon Kinberg", bio:"Simon David Kinberg (born August 2, 1973) is a British-born American screenwriter and film producer.  He is best known for his work on the X-Men film franchise, and has also written such films as Mr.  & Mrs.  Smith and Sherlock Holmes.  He has served as a producer on others including Cinderella, and The Martian, for which he was nominated for an Academy Award for Best Picture...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3xvTvkIaKfU276cpajiAoGjvaaO.jpg", url:"https://themoviedb.org/person/11092"}}, {tmdbId:"2694134", properties:{name:"Steven E. Rivkin", url:"https://themoviedb.org/person/2694134"}}, {tmdbId:"18524", properties:{imdbId:"0824414", name:"Eric Steel", bio:"From Wikipedia, the free encyclopedia\n\nEric Steel is a filmmaker and producer, best known for his controversial documentary The Bridge.  He graduated from Yale University in 1985. \n\nDescription above from the Wikipedia article Eric Steel, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/18524"}}, {tmdbId:"143558", properties:{name:"Ted Wilde", url:"https://themoviedb.org/person/143558"}}, {tmdbId:"2775", properties:{imdbId:"0001904", born:date('1934-06-29'), name:"Corey Allen", died:date('2010-06-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tdZjPHg5DJsX3BJzWDQXwN4qWKv.jpg", url:"https://themoviedb.org/person/2775"}}, {tmdbId:"1027737", properties:{imdbId:"0118928", name:"Robin Budd", url:"https://themoviedb.org/person/1027737"}}, {tmdbId:"1027738", properties:{name:"Donovan Cook", url:"https://themoviedb.org/person/1027738"}}, {tmdbId:"80727", properties:{bornIn:"New York City, New York, USA", imdbId:"0878338", born:date('1892-08-06'), name:"Frank Tuttle", died:date('1963-01-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nHq1loTuTtQs416Koylh91hspNk.jpg", url:"https://themoviedb.org/person/80727"}}, {tmdbId:"2570346", properties:{name:"John Dullaghan", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cF7KGn9JH8K7RphYZLkFVxdUl3f.jpg", url:"https://themoviedb.org/person/2570346"}}, {tmdbId:"139107", properties:{bornIn:"Jerusalem, Palestine (now Israel)", imdbId:"0938630", born:date('1941-10-28'), name:"Dan Wolman", bio:"From Wikipedia, the free encyclopedia\n\nDan Wolman (born October 28, 1941) is an Israeli film director.  Films include \"Tied Hands\", \"Ben's Biography\", and \"Foreign Sister\". \n\nDescription above from the Wikipedia article Dan Wolman, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/139107"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"42518", properties:{imdbId:"0136775", name:"Peter Care", url:"https://themoviedb.org/person/42518"}}, {tmdbId:"117052", properties:{bornIn:"Caracas, Venezuela", imdbId:"3360961", born:date('1945-03-21'), name:"Jorge Blanco", url:"https://themoviedb.org/person/117052"}}, {tmdbId:"81020", properties:{imdbId:"0743239", name:"Benjamin Ross", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aPQ5aiJXVvyseXGNAeq31F1e5Iu.jpg", url:"https://themoviedb.org/person/81020"}}, {tmdbId:"54710", properties:{bornIn:"North Carolina, USA", imdbId:"2095817", born:date('1976-10-15'), name:"Jody Hill", bio:"Jody Hill (born October 15, 1976) is an American film director and screenwriter from Concord, North Carolina.  In 2006 he directed, co-wrote, co-produced, and co-starred in his first film The Foot Fist Way, which he based on his experience as a Taekwondo black belt and instructor.  His follow-up film, Observe and Report, stars Seth Rogen and was released on April 10, 2009.  Hill is also co-creator and executive producer of the HBO series Eastbound & Down...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ch0paHlLOeUz1jfhzyOtohyjEpg.jpg", url:"https://themoviedb.org/person/54710"}}, {tmdbId:"96369", properties:{bornIn:"Huesca, Spain", imdbId:"0767022", born:date('1932-01-04'), name:"Carlos Saura", bio:"From Wikipedia, the free encyclopedia. \n\nCarlos Saura Atarés (born 4 January 1932, Huesca) is a Spanish film director and photographer. \n\nDescription above from the Wikipedia article Carlos Saura, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/96369"}}, {tmdbId:"110695", properties:{bornIn:"Tehran, Iran", imdbId:"0006498", born:date('1959-04-17'), name:"Majid Majidi", bio:"From Wikipedia, the free encyclopedia. \n\nMajid Majidi (born 17 April 1959 in Tehran) is an internationally and critically acclaimed Iranian film director, film producer, and screenwriter.  Majidi's films have touched on many themes and genres and he has won many international awards. \n\nDescription above from the Wikipedia article Majid Majidi, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/634Yt2DhSMirO8lT33twitp6CtZ.jpg", url:"https://themoviedb.org/person/110695"}}, {tmdbId:"1154545", properties:{imdbId:"2471534", name:"Andy Mingo", url:"https://themoviedb.org/person/1154545"}}, {tmdbId:"77121", properties:{imdbId:"0589168", name:"Randall Miller", bio:"From Wikipedia, the free encyclopedia.   Randall Miller is an American film director.  He has directed numerous films from 1992 to 2008.  His 2008 film Bottle Shock was self-distributed.   Description above from the Wikipedia article Randall Miller, licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kxJBhMyTLkSQtIqBGeSJSEIOSnK.jpg", url:"https://themoviedb.org/person/77121"}}, {tmdbId:"18844", properties:{bornIn:"Portsmouth, Hampshire, England, UK", imdbId:"0006960", born:date('1949-04-08'), name:"John Madden", bio:"From Wikipedia, the free encyclopedia\n\nJohn Philip Madden (born 8 April 1949) is an English director of theatre, film, television, and radio.  He was educated at Clifton College.  He was in the same house as friend and fellow director Roger Michell.  He began his career in British independent films.  He graduated from the University of Cambridge (Sidney Sussex) in 1970 with a B. A.  in English Literature...", url:"https://themoviedb.org/person/18844"}}, {tmdbId:"18868", properties:{bornIn:"New York City, New York, USA", imdbId:"0730385", born:date('1918-10-11'), name:"Jerome Robbins", bio:"From Wikipedia, the free encyclopedia\n\nJerome Robbins (October 11, 1918 – July 29, 1998) was an American theater producer, director, and choreographer known primarily for Broadway Theater and Ballet/Dance, but who also occasionally directed films and directed/produced for television.  His work has included everything from classical ballet to contemporary musical theater...", died:date('1998-07-29'), url:"https://themoviedb.org/person/18868"}}, {tmdbId:"36588", properties:{bornIn:"London, England, UK", imdbId:"0942504", born:date('1972-08-25'), name:"Joe Wright", bio:"Joe Wright (born 1972) is an English film director best known for 2005's Pride and Prejudice and 2007's Atonement...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1qA8HudSIwIr7ZdxwfQAgubsDO.jpg", url:"https://themoviedb.org/person/36588"}}, {tmdbId:"209970", properties:{imdbId:"0583287", name:"Muffie Meyer", url:"https://themoviedb.org/person/209970"}}, {tmdbId:"86051", properties:{bornIn:"Texarkana, Texas, U.S.", imdbId:"0517597", born:date('1908-10-05'), name:"Joshua Logan", bio:"From Wikipedia, the free encyclopedia. \n\nJoshua Lockwood Logan III (October 5, 1908 – July 12, 1988) was an American stage and film director and writer. \n\nDescription above from the Wikipedia article Joshua Logan, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1988-07-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/r1vfrVc1LxtZipn4JvMaiMXA2LF.jpg", url:"https://themoviedb.org/person/86051"}}, {tmdbId:"81850", properties:{bornIn:"Beckenham, London, England, United Kingdom", imdbId:"1512910", born:date('1971-05-30'), name:"Duncan Jones", bio:"Duncan Zowie Jones (born 30 May 1971), also known as Zowie Bowie or Joey Bowie, is an English film director, best known for directing the science fiction films Moon (2009) and Source Code (2011).  He is the son of rock star David Bowie...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1YD0ODUMoibJTNbgWwN0l0d1sT0.jpg", url:"https://themoviedb.org/person/81850"}}, {tmdbId:"154521", properties:{imdbId:"0957197", name:"Craig Zisk", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1WTt2jjxDwT0ngzrpO02VZYZDYV.jpg", url:"https://themoviedb.org/person/154521"}}, {tmdbId:"252806", properties:{imdbId:"2259353", born:date('1964-07-06'), name:"Christopher Ashley", url:"https://themoviedb.org/person/252806"}}, {tmdbId:"81913", properties:{bornIn:"China", imdbId:"0482670", name:"Lam Nai-Choi", bio:"Born 1953...", url:"https://themoviedb.org/person/81913"}}, {tmdbId:"209972", properties:{bornIn:"England, UK", imdbId:"0832134", born:date('1958-01-01'), name:"Robert Stone", bio:"Robert Stone is a documentary producer, director, writer, editor and cameraman born in England.  He grew up in grew up in both Europe and the United States.  Stone moved to New York City in 1983 to pursue a career in filmmaking...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e1nqgNLyPbHOIk0F5fq9ACXWGNh.jpg", url:"https://themoviedb.org/person/209972"}}, {tmdbId:"84697", properties:{imdbId:"1414810", born:date('1981-01-07'), name:"E.L. Katz", url:"https://themoviedb.org/person/84697"}}, {tmdbId:"135534", properties:{bornIn:"Geneva, Switzerland", imdbId:"0690794", born:date('1950-09-08'), name:"Léa Pool", bio:"Born in Switzerland in 1950, Léa Pool emigrated to Canada in 1975 and taught film-making from 1978 to 1983.  Named “Chevalier de l'Ordre des Arts et Lettres de France” in 1994.  Lives in Montreal...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fHnvRHq5JuPwn3MtrTnCvoMVnJ5.jpg", url:"https://themoviedb.org/person/135534"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"25882", properties:{imdbId:"0877427", name:"Brad Turner", bio:"Brad Turner is an award winning Canadian film and television director who has worked on several popular series.  Born in Bayfield, Ontario, Canada, on June 22.  He graduated with honors from the Television Arts Program at H.  B.  Beal Secondary School in London, Ontario.  In all he has directed thirteen movies, and over two hundred episodes of television.  He has been nominated 6 times for Gemini Awards for Directing, and in 2004 he won one for his work in the CBC mini series Human Cargo...", url:"https://themoviedb.org/person/25882"}}, {tmdbId:"84034", properties:{bornIn:"Clinton, Massachusetts, USA", imdbId:"0113284", born:date('1890-05-10'), name:"Clarence Brown", bio:"Clarence Brown was an American film director...", died:date('1987-08-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eOIOo2fM3VSXPXGzOXMDlDCpNtK.jpg", url:"https://themoviedb.org/person/84034"}}, {tmdbId:"82171", properties:{bornIn:"New York City, New York, USA", imdbId:"0821472", born:date('1886-01-21'), name:"John M. Stahl", bio:"John Malcolm Stahl (January 21, 1886 – January 12, 1950) was an American film director and producer. \n\nBorn in New York City, New York, he began working in the city's growing motion picture industry at a young age and directed his first silent film short in 1914.  In the early 1920s Stahl signed on with Louis B.  Mayer Pictures in Hollywood and in 1924 was part of the Mayer team that became MGM Studios...", died:date('1950-01-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jP2csaGsZJ39CKp11cQgSaznZEt.jpg", url:"https://themoviedb.org/person/82171"}}, {tmdbId:"134306", properties:{imdbId:"0838195", name:"Kevin Sullivan", url:"https://themoviedb.org/person/134306"}}, {tmdbId:"8558", properties:{bornIn:"San Leandro, California, USA", imdbId:"0023469", born:date('1936-05-21'), name:"Joe Alves", bio:"Joe Alves (born 21 May 1936, San Leandro, California) is an American film production designer, perhaps best known for his work on three of the Jaws films.  He directed Jaws 3-D. \n\nAlves has designed three features for Steven Spielberg, firstly for The Sugarland Express.  He designed the three mechanical sharks for the movie Jaws (1975) with mechanical effects man Bob Mattey supervising their physical construction in Sun Valley CA...", url:"https://themoviedb.org/person/8558"}}, {tmdbId:"82337", properties:{bornIn:" Leeds, England, United Kingdom", imdbId:"0922903", born:date('1966-03-04'), name:"Wash Westmoreland", bio:"Wash Westmoreland is a British director who has worked in television, documentaries, and independent films.  He frequently collaborated with his husband, writer-director Richard Glatzer.  Together, they wrote and directed the 2014 film Still Alice, based on Lisa Genova's NYT best-selling book.  The film won many awards, including the Academy Award for Best Actress for Julianne Moore and Humanitas Prize for feature film for the duo...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3Dw7e5lCKZdMaK1JeQbUzWvj8K9.jpg", url:"https://themoviedb.org/person/82337"}}, {tmdbId:"1224425", properties:{bornIn:"Sunnyside - Washington - USA", imdbId:"0859432", born:date('1965-08-15'), name:"Rob Thomas", bio:"Rob Thomas (born August 15, 1965 in Sunnyside, Washington) is an American author, producer, and screenwriter, best known as the author of the 1996 novel Rats Saw God, creator of the critically acclaimed television series Veronica Mars and co-creator of 90210 and Party Down...", url:"https://themoviedb.org/person/1224425"}}, {tmdbId:"227439", properties:{bornIn:"Glenwood, Iowa, USA", imdbId:"2320658", born:date('1969-01-01'), name:"Don Hall", url:"https://themoviedb.org/person/227439"}}, {tmdbId:"545229", properties:{imdbId:"0915838", name:"David Weaver", url:"https://themoviedb.org/person/545229"}}, {tmdbId:"92936", properties:{imdbId:"0387890", name:"Jonathan Hock", url:"https://themoviedb.org/person/92936"}}, {tmdbId:"21506", properties:{bornIn:"Long Island City, New York, USA", imdbId:"0796645", born:date('1916-10-04'), name:"George Sidney", bio:"From Wikipedia, the free encyclopedia\n\nGeorge Sidney (October 4, 1916 – May 5, 2002) was an American film director and film producer who worked primarily at Metro-Goldwyn-Mayer. \n\nSidney was assigned to direct the Our Gang comedies in 1938.  After a year of working on these shorts, he moved on to the Crime Does Not Pay series and popular Pete Smith specialties.  He graduated to directing features in 1941...", died:date('2002-05-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/r0KCg520yJrOOmxhzrL9bFluemy.jpg", url:"https://themoviedb.org/person/21506"}}, {tmdbId:"82482", properties:{imdbId:"0698119", name:"Greg Pritikin", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5YsmEizlJ9waiSj0XzG187t35Du.jpg", url:"https://themoviedb.org/person/82482"}}, {tmdbId:"974699", properties:{imdbId:"0200978", name:"Jonathan Darby", url:"https://themoviedb.org/person/974699"}}, {tmdbId:"60865", properties:{imdbId:"0589158", name:"R. Paul Miller", url:"https://themoviedb.org/person/60865"}}, {tmdbId:"90037", properties:{imdbId:"0487567", name:"James Lapine", url:"https://themoviedb.org/person/90037"}}, {tmdbId:"21792", properties:{bornIn:"Port Chester, New York, USA", imdbId:"0303032", name:"George Gallo", bio:"​From Wikipedia, the free encyclopedia.   \n\nGeorge Gallo Jr (born 1956) is an American painter, musician, filmmaker, and producer.  He is best known for writing Midnight Run and 29th Street, and is an accomplished painter in the style of the Pennsylvania Impressionists.  In 1990, he won the coveted Arts for the Parks award, and has had three one-man exhibitions in New York City. \n\nHe currently lives in Los Angeles...", url:"https://themoviedb.org/person/21792"}}, {tmdbId:"84982", properties:{imdbId:"0818237", name:"Rob Spera", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xsnckyQt6VhWGBBxm5jbzvaCJnw.jpg", url:"https://themoviedb.org/person/84982"}}, {tmdbId:"142013", properties:{bornIn:"Hirwaun, Cynon Valley, Wales", imdbId:"2153088", name:"Gareth Evans", bio:"Welsh born writer/director, in 2003 directed a short film \"Samurai Monogatari\" telling the tale of a Samurai waiting to be executed.  The short was in Japanese language and starred students from Tokyo who were studying at Cardiff University at the time.  In 2003 he also graduated with an MA in Scriptwriting for Film and Television at the University of Glamorgan but it was not until 2006 that he would see his first major production with the self-penned feature \"Footsteps\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2skpocnewERTPODPNvwgL5czLzG.jpg", url:"https://themoviedb.org/person/142013"}}, {tmdbId:"173607", properties:{bornIn:"Brooklyn, New York, USA", born:date('1943-11-26'), name:"Bruce Paltrow", bio:"From Wikipedia, the free encyclopedia\n\nBruce Weigert Paltrow (November 26, 1943 – October 3, 2002) was an American television and film director and producer.  He was the husband of actress Blythe Danner, and was the father of actress Gwyneth Paltrow and director Jake Paltrow. \n\nDescription above from the Wikipedia article Bruce Paltrow, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2002-10-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gVerAC2z5wbInyNfndIW1vxNnZ5.jpg", url:"https://themoviedb.org/person/173607"}}, {tmdbId:"120930", properties:{imdbId:"0428448", born:date('1967-03-05'), name:"Jon Jones", bio:"Jon Jones is a British television director and screenwriter whose works include the ITV drama series Cold Feet, the Channel 4 drama A Very Social Secretary, the BBC thriller The Debt, and the 2007 ITV adaptation of Northanger Abbey...", url:"https://themoviedb.org/person/120930"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"1032506", properties:{imdbId:"0440391", name:"Osamu Kasai", url:"https://themoviedb.org/person/1032506"}}, {tmdbId:"19228", properties:{bornIn:"Albion, New York, U.S.", imdbId:"0266302", born:date('1962-12-13'), name:"Jim Fall", bio:"From Wikipedia, the free encyclopedia.   Jim Fall is an American film and television director and film producer. \n\nHe is best known for directing the films Trick (1999), his directorial debut and The Lizzie McGuire Movie (2003).  He also directed the independent films He Touched Me and Love is Deaf, Dumb and Blind.   His television credits include Grosse Pointe, So NoTORIous and the film Wedding Wars (2006) starring John Stamos and Eric Dane...", url:"https://themoviedb.org/person/19228"}}, {tmdbId:"97773", properties:{bornIn:"Edmonton, Alberta, Canada", imdbId:"0923768", born:date('1946-09-23'), name:"Anne Wheeler", bio:"Anne Wheeler, OC (born September 23, 1946 in Edmonton, Alberta) is a Canadian film and television writer, producer and director.  Graduating in Mathematics from the University of Alberta she was a computer programmer before traveling abroad.  Her years of travels inspired her to become a storyteller and when she returned she joined a group of old friends to form a film collective...", url:"https://themoviedb.org/person/97773"}}, {tmdbId:"14800", properties:{bornIn:"Philadelphia, Pennsylvania, USA", imdbId:"0528337", born:date('1968-04-07'), name:"Jennifer Chambers Lynch", bio:"Jennifer Chambers Lynch (born April 7, 1968) is an American film director and screenwriter.  She is the daughter of David Lynch.  She is also known as the author of the book The Secret Diary of Laura Palmer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gdrZU7gTBo8dvWV9wxXqJ305QNW.jpg", url:"https://themoviedb.org/person/14800"}}, {tmdbId:"19333", properties:{bornIn:"New York City, New York, USA", imdbId:"0724059", name:"Dick Richards", bio:"From Wikipedia, the free encyclopedia\n\nDick Richards (born 1936) is an American film director, producer and writer. \n\nAfter working as a photographer, Richards went on to direct commercials.  His career in film began by writing and directing a western, The Culpepper Cattle Co.  (1972), and continued with such films as Farewell, My Lovely (1975), March or Die (1977), and Man, Woman and Child (1983)...", url:"https://themoviedb.org/person/19333"}}, {tmdbId:"87378", properties:{imdbId:"2209781", name:"Ayan Mukherjee", bio:"From Wikipedia, the free encyclopedia. \n\nAyan Mukherjee is an Indian film director who made his directorial debut at the age of 26 with Karan Johar's Wake Up Sid, a 2009 Bollywood film which opened to strong reviews and box office returns.  He is the son of Bengali film actor Deb Mukherjee.  He is also the nephew of Joy Mukherjee and the first cousin of Kajol and Tanisha Mukherjee and second cousin of Rani Mukherjee...", url:"https://themoviedb.org/person/87378"}}, {tmdbId:"19509", properties:{bornIn:" New York City, New York", imdbId:"0950506", born:date('1966-02-14'), name:"Jessica Yu", bio:"From Wikipedia, the free encyclopedia. \n\nJessica Lingmin Yu (born 1966 in New York City) is an American film director, writer, producer, and editor.  She has directed documentary films, dramatic films, and television shows.  Yu won an Academy Award for Best Documentary Short Subject for Breathing Lessons: The Life and Work of Mark O'Brien (imdb) (1997).  Yu's latest film \"Last Call at the Oasis\" (2012), based upon Alex Prud'homme's \"The Ripple Effect\"...", url:"https://themoviedb.org/person/19509"}}, {tmdbId:"1168126", properties:{imdbId:"1231174", name:"Daniel A. Miller", url:"https://themoviedb.org/person/1168126"}}, {tmdbId:"31497", properties:{bornIn:"Toledo, Ohio, USA", imdbId:"0188669", born:date('1886-12-23'), name:"John Cromwell", bio:"Elwood Dager Cromwell, known as John Cromwell, was an American film and stage director and actor.  His films spanned the early days of sound to 1950s film noir, when his directing career was cut short by the Hollywood blacklist...", died:date('1979-09-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jfDhKNzIu9T6pgL3LtqCOxMH1cn.jpg", url:"https://themoviedb.org/person/31497"}}, {tmdbId:"27889", properties:{bornIn:"Sydney, New South Wales, Australia", imdbId:"0254632", born:date('1964-08-27'), name:"Stephan Elliott", bio:"From Wikipedia, the free encyclopedia.   Stephan Elliott (born 27 August 1964) is an Australian film director and screenwriter. \n\nDescription above from the Wikipedia article Stephan Elliott, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/27889"}}, {tmdbId:"58036", properties:{bornIn:"Hong Kong", imdbId:"0939202", born:date('1949-03-28'), name:"Kirk Wong", bio:"Kirk Wong Chi Keung (born 1949) is a Hong Kong based film director and actor.  He is probably most famous for directing the John Woo produced action comedy The Big Hit. \n\nDescription above from the Wikipedia article Kirk Wong, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uEvE6gpgJmTJXAbYNbOdVoHrcuE.jpg", url:"https://themoviedb.org/person/58036"}}, {tmdbId:"239418", properties:{imdbId:"0825434", born:date('1971-12-24'), name:"Darren Stein", bio:"Darren Stein (born December 24, 1971) is an American film director, screenwriter, and film producer who grew up in the San Fernando Valley.  Among his works include the documentary Put the Camera on Me,  the upcoming summer 2010 horror comedy All About Evil,  and the satirical major motion picture Jawbreaker - which has been deemed a \"cult classic\" by the New York Post,  and is still referenced today in mainstream sources...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z3qJCwbTCK44ZdzlDmld68L9vxr.jpg", url:"https://themoviedb.org/person/239418"}}, {tmdbId:"3632", properties:{bornIn:"Philadelphia, Pennsylvania, U.S.", imdbId:"0112218", born:date('1912-05-18'), name:"Richard Brooks", bio:"From Wikipedia, the free encyclopedia.  \n\nRichard Brooks (May 18, 1912 – March 11, 1992) was an American screenwriter, director, novelist and occasional producer.  His outstanding works as director are Blackboard Jungle (1955); Cat on a Hot Tin Roof (1958); Elmer Gantry (1960) – for which he won an Academy Award for Best Writing (Adapted Screenplay); In Cold Blood (1967); and Looking for Mr.  Goodbar (1977)...", died:date('1992-03-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/r3zFUrYDn5tDDpIONAFLPhEkfBt.jpg", url:"https://themoviedb.org/person/3632"}}, {tmdbId:"30508", properties:{imdbId:"0792042", born:date('1913-03-16'), name:"Jack Sher", died:date('1988-08-23'), url:"https://themoviedb.org/person/30508"}}, {tmdbId:"105802", properties:{bornIn:"Denver, Colorado, USA", imdbId:"0695629", name:"Doug Pray", bio:"​From Wikipedia, the free encyclopedia.   \n\nDoug Pray is an American documentary film director, cinematographer, and editor who often explores unique subcultures in his films...", url:"https://themoviedb.org/person/105802"}}, {tmdbId:"84047", properties:{imdbId:"0832573", born:date('1939-12-11'), name:"Howard Storm", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/GiKbpF0lGqSNsD8y567S3BlrDW.jpg", url:"https://themoviedb.org/person/84047"}}, {tmdbId:"73256", properties:{bornIn:"Paterson, New Jersey, USA", imdbId:"0588183", born:date('1909-11-28'), name:"David Miller", bio:"From Wikipedia, the free encyclopedia\n\nDavid Miller (November 28, 1909 – April 14, 1992) was an American film director who directed such varied films as Billy the Kid (1941) with Robert Taylor and Brian Donlevy, Flying Tigers (1943) with John Wayne, and Love Happy (1949) with the Marx Brothers...", died:date('1992-04-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/k43xGVyc8hkfDycwRGUeR6QbbLI.jpg", url:"https://themoviedb.org/person/73256"}}, {tmdbId:"2380", properties:{imdbId:"0141222", name:"David Carson", bio:"​From Wikipedia, the free encyclopedia.     David Carson is a British television director.  He has directed episodes of many TV series, including The Adventures of Sherlock Holmes, Star Trek: The Next Generation, Star Trek: Deep Space Nine, Smallville, Doogie Howser, M. D. , and L. A.  Law.  He also directed the feature film Star Trek Generations (1994).  He is married to actress Kim Braden, with two children...", url:"https://themoviedb.org/person/2380"}}, {tmdbId:"84448", properties:{imdbId:"1038127", born:date('1971-04-04'), name:"Tatia Rosenthal", url:"https://themoviedb.org/person/84448"}}, {tmdbId:"33156", properties:{bornIn:"Long Branch, New Jersey, Stati Uniti", imdbId:"0580669", born:date('1969-01-11'), name:"James Merendino", bio:"James Merendino is an American movie director and scriptwriter.  He was born in New Jersey, and moved with his family to Salt Lake City, Utah when he was six years old.  After pursuing post-secondary education in Rome and Los Angeles, California, studying Western philosophy and theology, Merendino settled in Hollywood, California when he was 19 years old, and began a tenure with Hollywood mogul Dan Melnick.  In 1991, Merendino was hired for his first motion picture, Witchcraft IV...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/anKSgFaTv45TMe7JtWBeTZVaG9V.jpg", url:"https://themoviedb.org/person/33156"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"7130", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0018735", born:date('1963-06-16'), name:"Scott Alexander", bio:"Scott Alexander is a writer and producer, best known for 1408 (2007), Man on the Moon (1999) and Ed Wood (1994).  He attended the University of Southern California, and instructed screenwriting seminars at USC film school in the late 1980s...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2Zcnbxg4dLC0yRcv7NqcUrpZeCj.jpg", url:"https://themoviedb.org/person/7130"}}, {tmdbId:"1029961", properties:{imdbId:"2666268", name:"Adam Rodgers", url:"https://themoviedb.org/person/1029961"}}, {tmdbId:"58075", properties:{imdbId:"0636165", name:"Bill L. Norton", url:"https://themoviedb.org/person/58075"}}, {tmdbId:"49361", properties:{imdbId:"0071611", name:"Bill Bennett", url:"https://themoviedb.org/person/49361"}}, {tmdbId:"568911", properties:{bornIn:"London, England, U.K.", imdbId:"0058045", name:"John Barry", died:date('1979-06-01'), url:"https://themoviedb.org/person/568911"}}, {tmdbId:"1066114", properties:{imdbId:"0805935", name:"Brian Sloan", url:"https://themoviedb.org/person/1066114"}}, {tmdbId:"50767", properties:{bornIn:"Sydney, New South Wales, Australia", imdbId:"0318916", born:date('1967-09-01'), name:"Craig Gillespie", bio:"​Craig Gillespie is an Australian film director best known for directing the 2007 film Lars and the Real Girl the Golden Globe winning film I, Tonya...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pVHspL9QWsXCm3t3VXEaCJ9y8Zz.jpg", url:"https://themoviedb.org/person/50767"}}, {tmdbId:"45117", properties:{bornIn:"Dublin, Ireland", imdbId:"0138809", born:date('1972-01-01'), name:"John Carney", bio:"John Carney is an Irish film and TV writer/director who specialises in low-budget indie films.  He is best known for his award-winning 2007 movie Once.  He is also a co-creator of the Irish TV drama series Bachelors Walk...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a85YTkbKqmF0ht2gr5XF652eQIe.jpg", url:"https://themoviedb.org/person/45117"}}, {tmdbId:"75510", properties:{imdbId:"0597516", name:"Craig Monahan", url:"https://themoviedb.org/person/75510"}}, {tmdbId:"1179066", properties:{bornIn:"USA", imdbId:"1226871", born:date('1980-10-28'), name:"Wes Ball", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zVPXrhuAxYAWlwDEWCaqeUPycFx.jpg", url:"https://themoviedb.org/person/1179066"}}, {tmdbId:"38250", properties:{bornIn:"Stillwater, Minnesota, USA", imdbId:"0164044", born:date('1908-05-14'), name:"James B. Clark", died:date('2000-07-19'), url:"https://themoviedb.org/person/38250"}}, {tmdbId:"1179590", properties:{bornIn:"Distretto di Auckland, Nuova Zelanda", imdbId:"1960428", born:date('1971-05-10'), name:"Scott Walker", url:"https://themoviedb.org/person/1179590"}}, {tmdbId:"85357", properties:{imdbId:"1226523", name:"Christian Charles", url:"https://themoviedb.org/person/85357"}}, {tmdbId:"50300", properties:{bornIn:"Sydney, New South Wales, Australia", imdbId:"0268513", born:date('1904-02-10'), name:"John Farrow", bio:"​From Wikipedia, the free encyclopedia\n\nJohn Villiers Farrow, CBE (10 February 1904 – 27 January 1963) was an Australian, later American, film director, producer and screenwriter.  In 1957 he won the Academy Award for Best Writing / Best Screenplay for Around the World in Eighty Days and in 1942 he was nominated as Best Director for Wake Island. \n\nDescription above from the Wikipedia article John Farrow, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1963-01-28'), url:"https://themoviedb.org/person/50300"}}, {tmdbId:"75570", properties:{imdbId:"0909548", name:"Baillie Walsh", bio:"​From Wikipedia, the free encyclopedia.   \n\nBaillie Walsh is a music video and film director.  He is best known for writing and directing the film Flashbacks of a Fool (2008) starring Daniel Craig, Eve, Harry Eden, and Felicity Jones. \n\nDescription above from the Wikipedia article Baillie Walsh,  licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/75570"}}, {tmdbId:"101767", properties:{bornIn:"Los Angeles, California, USA ", imdbId:"0125111", born:date('1927-11-17'), name:"Robert Butler", url:"https://themoviedb.org/person/101767"}}, {tmdbId:"20773", properties:{bornIn:"Germany", imdbId:"0003201", born:date('1958-02-21'), name:"Tim Sullivan", bio:"Tim Sullivan is a German born British film and television writer and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wYd0HKhwM8SiT5Idjli8f0NUn3g.jpg", url:"https://themoviedb.org/person/20773"}}, {tmdbId:"1184250", properties:{imdbId:"0506071", name:"Mark Levinson", url:"https://themoviedb.org/person/1184250"}}, {tmdbId:"90641", properties:{imdbId:"0609070", name:"Robb Moss", bio:"​From Wikipedia, the free encyclopedia.   \n\nRobb Moss is an independent documentary filmmaker and professor at Harvard University.  Notable work includes such films as The Same River Twice, Secrecy (film), and The Tourist.  His films are often about the passage of time and its effect on characters, stories, and memories...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wNIfIUDxHZKEwPUP0XGR3MhJyku.jpg", url:"https://themoviedb.org/person/90641"}}, {tmdbId:"1058", properties:{bornIn:"University City, Missouri, USA", imdbId:"0301826", born:date('1951-05-25'), name:"Bob Gale", bio:"From Wikipedia, the free encyclopedia. \n\nMichael Robert \"Bob\" Gale (born May 21, 1951) is an American screenwriter who co-wrote the science fiction film Back to the Future with writing partner Robert Zemeckis, and the screenplays for the film's two sequels.  Gale also co-produced all three films. \n\nDescription above from the Wikipedia article Bob Gale, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wZLj3qLrieFQzt49i981lMVijPm.jpg", url:"https://themoviedb.org/person/1058"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"85716", properties:{imdbId:"0708371", name:"Robert C. Ramirez", url:"https://themoviedb.org/person/85716"}}, {tmdbId:"10179", properties:{bornIn:"Sunbury-on-Thames, London, England, UK", imdbId:"0322515", born:date('1932-05-15'), name:"John Glen", bio:"John Glen (born 15 May 1932) is a British film director.  He was born in Sunbury-on-Thames, England.   He is best known for his work as a film editor, and director of five James Bond movies, he also worked as film editor and second unit director on three previous Bond movies: On Her Majesty's Secret Service (1969), The Spy Who Loved Me (1977), Moonraker (1979).   Glen's other films as second unit director include Superman and The Wild Geese, both in 1978...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z2yCmGUHosRuKoVkgtrIplJAFXN.jpg", url:"https://themoviedb.org/person/10179"}}, {tmdbId:"147323", properties:{name:"Bud Smith ", url:"https://themoviedb.org/person/147323"}}, {tmdbId:"59438", properties:{imdbId:"0423623", name:"Mark Joffe", url:"https://themoviedb.org/person/59438"}}, {tmdbId:"127027", properties:{imdbId:"0002224", name:"James Moll", bio:"James Moll is a film director and producer. \n\nHis company, Allentown Productions, has been based at Universal Studios since 1994, primarily producing film and television projects focused on stories of non-fiction. \n\nMoll graduated from the USC School of Cinematic Arts in 1987...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8E0C2frUUhkPCRm3K5yAq2vDGLI.jpg", url:"https://themoviedb.org/person/127027"}}, {tmdbId:"1189506", properties:{imdbId:"2871592", name:"Peter Glanz", bio:"He has directed fashion commercials for numerous industry icons: from Marc Jacobs to Neiman Marcus to Bergdorf Goodman Studied film at Art Center College of Design.  He did so on a full Presidential Scholarship.  His short film, \"A Relationship In Four Days\", had its last screening at the Hamptons Film Festival in 2008. \n\nHis short film, \"A Relationship In Four Days\", had its Domestic Premiere at the Sundance Film Festival in 2008...", url:"https://themoviedb.org/person/1189506"}}, {tmdbId:"554394", properties:{name:"Danny Goldberg", url:"https://themoviedb.org/person/554394"}}, {tmdbId:"1189511", properties:{imdbId:"0693063", name:"Anthony Potenza", url:"https://themoviedb.org/person/1189511"}}, {tmdbId:"933276", properties:{imdbId:"5887182", name:"Emma Cooper", url:"https://themoviedb.org/person/933276"}}, {tmdbId:"13367", properties:{imdbId:"0365666", born:date('1948-01-01'), name:"John Harrison", url:"https://themoviedb.org/person/13367"}}, {tmdbId:"91252", properties:{bornIn:"New York, New York, U.S.A.", imdbId:"1642796", born:date('1973-01-01'), name:"Alex Rivera", url:"https://themoviedb.org/person/91252"}}, {tmdbId:"59466", properties:{bornIn:"Shaker Heights, Ohio, USA", imdbId:"0044803", born:date('1970-11-16'), name:"Jamie Babbit", bio:"Jamie Babbit (born November 16, 1970) is an American film director, producer and screenwriter.  She directed the films But I'm a Cheerleader, The Quiet and Itty Bitty Titty Committee.  She has also directed episodes of television programs including Gilmore Girls, Malcolm in the Middle, Nip/Tuck and The L Word.  She is involved with film production company POWER UP. \n\nDescription above from the Wikipedia article Jamie Babbit, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zySwCaK5XLylqpiJ4l2VhdO6Dw5.jpg", url:"https://themoviedb.org/person/59466"}}, {tmdbId:"67910", properties:{bornIn:"Newton, Massachusetts, USA", imdbId:"0040575", name:"David Atkins", url:"https://themoviedb.org/person/67910"}}, {tmdbId:"4695", properties:{bornIn:"Kansas City, Missouri, USA", imdbId:"0103756", born:date('1937-09-01'), name:"Don Edmonds", died:date('2009-05-30'), url:"https://themoviedb.org/person/4695"}}, {tmdbId:"1232592", properties:{bornIn:"Portland - Oregon - USA", imdbId:"0264220", born:date('1968-01-01'), name:"Chris Eyre", bio:"Chris Eyre is a director and producer, known for Smoke Signals (1998), Skins (2002) and Edge of America (2003).  As of 2012 is chairman of the film department at the Santa Fe University of Art and Design and he is an enrolled member of the Cheyenne and Arapaho Tribes...", url:"https://themoviedb.org/person/1232592"}}, {tmdbId:"2322719", properties:{bornIn:"Ramon, USSR", born:date('1927-10-26'), name:"Aleksandr Sery", died:date('1987-10-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/llev9pVEgp94Ci1oyu5VaZJ7SJ5.jpg", url:"https://themoviedb.org/person/2322719"}}, {tmdbId:"75960", properties:{bornIn:" Australia", imdbId:"1234242", name:"Matthew Saville", bio:"From Wikipedia, the free encyclopedia. \n\nMatthew Saville is an Australian television and film director, who began his career working as a titles designer for many Australian television series.  Several of his short films, including Franz and Kafka have received awards and screened widely at film festivals. \n\nMatthew Saville came to wider prominence as a writer/director with his one hour film Roy Hollsdotter Live, a bittersweet comedy about a stand-up comedian experiencing a personal breakdown...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AcWYi8OXwjjJpxlNjet0Vcyw0ba.jpg", url:"https://themoviedb.org/person/75960"}}, {tmdbId:"3055", properties:{bornIn:"Scotland, UK", imdbId:"0533284", born:date('1966-05-10'), name:"David Mackenzie", bio:"David Mackenzie (born 10 May 1966) is a Scottish film director and co-founder of the Glasgow-based production company Sigma Films.  He has made ten feature films including Young Adam (2003), Hallam Foe (2007), Perfect Sense (2011), and Starred Up (2013).  In 2016, Mackenzie's film Hell or High Water premiered at Cannes and was theatrically released in the United States in August.  In October 2016, Mackenzie boarded Damnation - a TV pilot for Universal & USA Network...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ik6YTYOWdgmou40xRyPlCP4tyGC.jpg", url:"https://themoviedb.org/person/3055"}}, {tmdbId:"209879", properties:{imdbId:"2309735", name:"Tze Chun", url:"https://themoviedb.org/person/209879"}}, {tmdbId:"87033", properties:{imdbId:"0006874", born:date('1969-01-01'), name:"Julie Davis", url:"https://themoviedb.org/person/87033"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"1213124", properties:{imdbId:"0206556", name:"Richard Day", bio:"Richard Day is an American writer, producer, director and occasional actor.  He has worked as a writer/producer for several television programs including Arrested Development, Spin City, Ellen, Roseanne, Mad About You and Aliens in America. \n\nIn addition to his work in television, he has also written and directed his own independent films Girls Will Be Girls and Straight-Jacket based on his own off-Broadway play...", url:"https://themoviedb.org/person/1213124"}}, {tmdbId:"92733", properties:{bornIn:"Berwick, Victoria, Australia", imdbId:"0254178", born:date('1972-01-02'), name:"Adam Elliot", bio:"​From Wikipedia, the free encyclopedia\n\nAdam Elliot (born 2 January 1972 in Berwick, Victoria, Australia) is an independent stop-motion animation writer and director based in Melbourne, Australia.  His five films have collectively participated in over six-hundred film festivals and have received over one hundred awards, including an Oscar for Harvie Krumpet[2] and the Annecy Cristal for Mary and Max.  Elliot calls himself an auteur filmmaker and each of his films have a bittersweet nature to them...", url:"https://themoviedb.org/person/92733"}}, {tmdbId:"195619", properties:{imdbId:"0963216", name:"Sally George", url:"https://themoviedb.org/person/195619"}}, {tmdbId:"608580", properties:{imdbId:"0908223", name:"Stephen Walker", url:"https://themoviedb.org/person/608580"}}, {tmdbId:"21806", properties:{bornIn:"New York City, New York, USA", imdbId:"0750701", born:date('1929-04-15'), name:"Richard Rush", bio:"​From Wikipedia, the free encyclopedia. \n\nRichard Rush (born April 15, 1929, in New York City) is an American movie director, scriptwriter, and producer.  He is best known for the Oscar-nominated The Stunt Man.  His other works, however, have been less celebrated.  The next best-known of his movies is Color of Night — also nominated, but in this case for the Golden Raspberry Award.  Rush also directed Freebie and The Bean, an over-the-top police buddy comedy/drama starring Alan Arkin and James Caan...", url:"https://themoviedb.org/person/21806"}}, {tmdbId:"1197213", properties:{imdbId:"0073690", name:"Allison Berg", url:"https://themoviedb.org/person/1197213"}}, {tmdbId:"1197214", properties:{name:"François Keraudren", url:"https://themoviedb.org/person/1197214"}}, {tmdbId:"94787", properties:{bornIn:"Saint Louis, Missouri, USA", imdbId:"0131995", born:date('1939-04-20'), name:"Joe Camp", bio:"From Wikipedia, the free encyclopedia. \n\nJoe Camp (born April 20, 1939 in St.  Louis, Missouri) is a motion picture director and writer.  He is best known as the creator and director of the Benji films.  He currently resides in Bell Buckle, Tennessee with his wife Kathleen.  They also own property in Valley Center, California. \n\nCamp is also known for his work with horses.  He owns, and has trained, five horses who live with him at his Valley Center Ranch...", url:"https://themoviedb.org/person/94787"}}, {tmdbId:"15858", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0006853", born:date('1947-06-15'), name:"Tim Hunter", bio:"From Wikipedia, the free encyclopedia.  Tim Hunter (June 15, 1947 in Los Angeles, California) is an American television and film director.  Since the late 1980s he has mostly worked on television, directing episodes for dozens of televisions series including Breaking Bad, Carnivàle, Chicago Hope, Crossing Jordan, Deadwood, Falcon Crest, Homicide: Life on the Street, House M. D. , Law &amp; Order, Lie to Me, Mad Men, and Twin Peaks...", url:"https://themoviedb.org/person/15858"}}, {tmdbId:"21869", properties:{bornIn:"Cegléd, Austria-Hungary [now Hungary]", imdbId:"0657162", born:date('1908-02-01'), name:"George Pal", bio:"Hungarian born George Pal (born Gyorgy Pal Marczincsak) was an animator, film director and producer.  He is best known for his classic Puppetoon replacement animation short films, as well as his association with the Fantasy and Science Fiction genres.  Pal was nominated for Academy Awards (in the category Best Short Subject, Cartoons) in seven consecutive years (1942–1948).  He received an honorary Oscar, for the development of novel animation methods and techniques, in 1944...", died:date('1980-05-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ptRanXi80Q0o9CJ74zP7pGribk2.jpg", url:"https://themoviedb.org/person/21869"}}, {tmdbId:"1174031", properties:{bornIn:"Scozia, Regno Unito", imdbId:"0004305", born:date('1943-01-01'), name:"George T. Miller", url:"https://themoviedb.org/person/1174031"}}, {tmdbId:"7046", properties:{bornIn:" Los Angeles, California, USA", imdbId:"0669637", born:date('1958-05-01'), name:"Cecilia Peck", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kFroqrLbmVATUFMIoY4KnLKKTo7.jpg", url:"https://themoviedb.org/person/7046"}}, {tmdbId:"7506", properties:{bornIn:"New York, New York, U.S.", imdbId:"0000740", born:date('1916-06-12'), name:"Irwin Allen", bio:"From Wikipedia, the free encyclopedia.   Irwin Allen (June 12, 1916 – November 2, 1991) was a television and film director and producer nicknamed \"The Master of Disaster\" for his work in the disaster film genre.  He was also notable for creating a number of television series.   Description above from the Wikipedia article Irwin Allen,licensed under CC-BY-SA,full list of contributors on Wikipedia...", died:date('1991-11-02'), url:"https://themoviedb.org/person/7506"}}, {tmdbId:"22100", properties:{imdbId:"0425244", name:"Hugh Johnson", url:"https://themoviedb.org/person/22100"}}, {tmdbId:"70500", properties:{bornIn:"London, England, UK", imdbId:"0393799", born:date('1972-10-05'), name:"Tom Hooper", bio:"Thomas George \"Tom\" Hooper (born 1972) is a British film and television director of English and Australian background.  Hooper began making short films at the age of 13, and had his first professional short, Painted Faces, broadcast on Channel 4 in 1992.  At Oxford University Hooper directed plays and television commercials.  After graduating, he directed episodes of Quayside, Byker Grove, EastEnders and Cold Feet...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wRuokdzGiSh2MHd9cYQQ9KGVFFj.jpg", url:"https://themoviedb.org/person/70500"}}, {tmdbId:"87767", properties:{imdbId:"0552954", born:date('1917-12-12'), name:"Richard Martin", bio:"From Wikipedia, the free encyclopedia.   Richard Martin (born April 12, 1956), is an award-winning Canadian television director, film director and film editor.  He was born in Vancouver and is the son of comedian Dick Martin (Rowan &amp; Martin's Laugh-In).  He and his wife, Kim Steer, have one child. \n\nDescription above from the Wikipedia article Richard Martin , licensed under CC-BY-SA,full list of contributors on Wikipedia...", died:date('1994-09-04'), url:"https://themoviedb.org/person/87767"}}, {tmdbId:"89373", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0203429", born:date('1939-11-07'), name:"Martin Davidson", bio:"Martin Davidson (born November 7, 1939) is an American film director, screenwriter, producer and actor.  After attending the American Academy of Dramatic Arts, he spent five years as an actor in Off Broadway shows and regional theater.  His directorial debut was The Lords of Flatbush starring Sylvester Stallone and Henry Winkler.  He won an ACE award for his film Long Gone, an HBO movie starring William Petersen and Virginia Madsen...", url:"https://themoviedb.org/person/89373"}}, {tmdbId:"90223", properties:{imdbId:"0532263", name:"Greg MacGillivray", url:"https://themoviedb.org/person/90223"}}, {tmdbId:"90225", properties:{imdbId:"0431971", name:"Stephen Judson", url:"https://themoviedb.org/person/90225"}}, {tmdbId:"67367", properties:{bornIn:"Silver Spring, Maryland, USA", imdbId:"0426059", born:date('1973-12-17'), name:"Rian Johnson", bio:"Rian Craig Johnson (born December 17, 1973) is an American filmmaker...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j7ACBDkCgMqf6sSz2XeCmfqGNd3.jpg", url:"https://themoviedb.org/person/67367"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"2716941", properties:{name:"Liam Lynch", url:"https://themoviedb.org/person/2716941"}}, {tmdbId:"641437", properties:{imdbId:"0807243", name:"Alex Smith", url:"https://themoviedb.org/person/641437"}}, {tmdbId:"1027145", properties:{imdbId:"0807312", name:"Andrew J. Smith", url:"https://themoviedb.org/person/1027145"}}, {tmdbId:"57138", properties:{bornIn:"San Diego, California, USA", imdbId:"0082300", born:date('1940-08-23'), name:"Tony Bill", bio:"From Wikipedia, the free encyclopedia.   Gerard Anthony \"Tony\" Bill (born 23 August 1940) is an American actor, producer, and director.  He produced the 1973 movie The Sting, for which he shared the Academy Award for Best Picture with Michael Phillips and Julia Phillips.  The Sting became one of the highest grossing films in history. \n\nHe majored in English and art at the University of Notre Dame in South Bend, Indiana, from which he graduated in 1962...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ocgZsr4uQouEwLbYtnnupRnupmq.jpg", url:"https://themoviedb.org/person/57138"}}, {tmdbId:"79464", properties:{imdbId:"0493615", name:"Joe Layton", url:"https://themoviedb.org/person/79464"}}, {tmdbId:"11454", properties:{bornIn:"Bronx, New York, USA", imdbId:"0101055", born:date('1944-04-20'), name:"George Bowers", bio:"George Bowers (born April 20, 1944) is an American film director, editor and producer. \n\nBowers was born in the Bronx, New York.  As an editor, he has an extensive list of credits dating from 1968 to his latest film in 2008.  As a director, he directed films such as Private Resort with Johnny Depp and My Tutor with Crispin Glover, the latter which is being remade...", url:"https://themoviedb.org/person/11454"}}, {tmdbId:"100516", properties:{bornIn:"USA", imdbId:"0562470", name:"Max Mayer", url:"https://themoviedb.org/person/100516"}}, {tmdbId:"72913", properties:{imdbId:"0036272", born:date('1945-08-02'), name:"Morten Arnfred", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mXzmp2kf9zRN5rh3u7Kzk7Zx5n0.jpg", url:"https://themoviedb.org/person/72913"}}, {tmdbId:"3227", properties:{bornIn:"USA", imdbId:"0684336", born:date('1966-02-03'), name:"Steve Pink", bio:"From Wikipedia, the free encyclopedia.   \n\nSteve Pink (born February 3, 1966) is an American actor, screenwriter and director.  He is the director of the comedy films Accepted and Hot Tub Time Machine, and the co-writer of the films Grosse Pointe Blank and High Fidelity. \n\nDescription above from the Wikipedia article Steve Pink, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/3227"}}, {tmdbId:"1053420", properties:{bornIn:"Virginia Beach, Virginia, USA", imdbId:"1837748", born:date('1979-04-05'), name:"Josh Boone", bio:"Josh Boone (born April 5, 1979) is an American screenwriter and film director.  His first film was Stuck in Love and he has since helmed The Fault in Our Stars, based on John Green's novel...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4Y8QGYaYUuLmge9vmrr1oune6D8.jpg", url:"https://themoviedb.org/person/1053420"}}, {tmdbId:"71192", properties:{bornIn:"Sydney, New South Wales, Australia", imdbId:"0178505", born:date('1942-10-05'), name:"Greg Coote", died:date('2014-06-27'), url:"https://themoviedb.org/person/71192"}}, {tmdbId:"940800", properties:{name:"David Hinton", url:"https://themoviedb.org/person/940800"}}, {tmdbId:"143561", properties:{imdbId:"0853130", born:date('1895-08-13'), name:"Sam Taylor", died:date('1958-03-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pY9U3YTrPTZY68YF75nszT9WX7G.jpg", url:"https://themoviedb.org/person/143561"}}, {tmdbId:"23287", properties:{imdbId:"1285613", name:"Andrew Jarecki", bio:"From Wikipedia, the free encyclopedia\n\nAndrew Jarecki is an American filmmaker best known for Capturing the Friedmans, which won the Grand Jury Prize at the Sundance Film Festival and was nominated for an Academy Award. \n\nThe co-founder/CEO of Moviefone, which provides film schedules over the telephone and was sold to AOL in 1999, Jarecki was encouraged to shoot Capturing the Friedmans by Albert Maysles.  He is the brother of filmmaker Eugene Jarecki and half-brother of Nicholas Jarecki...", url:"https://themoviedb.org/person/23287"}}, {tmdbId:"220152", properties:{bornIn:"New York City - New York - USA", imdbId:"0931435", born:date('1943-01-01'), name:"Paul Williams", bio:"Paul Williams was born in 1943 in is an actor and director...", url:"https://themoviedb.org/person/220152"}}, {tmdbId:"1357", properties:{bornIn:"Sydney, New South Wales, Australia", imdbId:"0236313", born:date('1952-05-02'), name:"Christopher Doyle", bio:"Christopher Doyle is an Australian-Hong Kong cinematographer who often works on Chinese language films.  He has won awards at the Cannes Film Festival and Venice Film Festival, as well as AFI Award for cinematography, the Golden Horse awards (four times), and Hong Kong Film Award (six times).  Doyle is an affiliate of the Hong Kong Society of Cinematographers.   Doyle was born in Sydney, Australia in 1952...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dm2g37ak1EzIu1YViAwvZAvytlx.jpg", url:"https://themoviedb.org/person/1357"}}, {tmdbId:"21771", properties:{bornIn:"Rio de Janeiro, Rio de Janeiro, Brazil", imdbId:"0858680", born:date('1959-01-01'), name:"Daniela Thomas", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zmDt303VELqG3apeJclG15uPOlo.jpg", url:"https://themoviedb.org/person/21771"}}, {tmdbId:"61440", properties:{bornIn:"Sacramento, California, USA", imdbId:"0051972", born:date('1972-09-08'), name:"Lance Bangs", bio:"Lance Bangs (born September 8, 1972) is an American filmmaker, documentarian, and music video director who has created videos for Sonic Youth, Nirvana, Green Day, the Arcade Fire, the Shins, The Thermals, Belle & Sebastian, Menomena, Yeah Yeah Yeahs, R. E. M. , Mike Watt, Death Cab for Cutie, The Black Keys, Kanye West, and Pavement.  He directed the David Cross film Let America Laugh...", url:"https://themoviedb.org/person/61440"}}, {tmdbId:"13663", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"0790144", born:date('1939-03-03'), name:"Robert Shaye", bio:"​From Wikipedia, the free encyclopedia. \n\nRobert Kenneth Shaye  (born March 3, 1939), often referred to as Bob Shaye, is an American businessman, film producer, director and actor...", url:"https://themoviedb.org/person/13663"}}, {tmdbId:"54248", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0484907", born:date('1975-02-27'), name:"Christopher Landon", bio:"Christopher Beau Landon (born 27 February 1975 in Los Angeles) is an American screenwriter best known as the director of Happy Death Day (2017) and Happy Death Day 2U (2019)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7AqltL9w9EpLdyzALE6iN49KyuS.jpg", url:"https://themoviedb.org/person/54248"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"1099862", properties:{bornIn:"Johannesburg, South Africa", imdbId:"2410311", born:date('1984-09-20'), name:"Dean Israelite", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ejnQgx8jXDG2GQgtTk7n78rjtJS.jpg", url:"https://themoviedb.org/person/1099862"}}, {tmdbId:"2891", properties:{bornIn:" Vienna, Austria", imdbId:"0903049", born:date('1894-05-29'), name:"Josef von Sternberg", bio:"Josef von Sternberg, born Jonas Sternberg, 29 May 1894 – 22 December 1969, was an Austrian-American film director.  He is considered one of the earliest 'auteur' filmmakers, having filled many other roles on his films including those of cinematographer, screenwriter, and editor.  Sternberg's style influenced later directors, particularly those of the film noir period...", died:date('1969-11-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tyO2afjDm8CrkPXYanrtiprEcIj.jpg", url:"https://themoviedb.org/person/2891"}}, {tmdbId:"216116", properties:{name:"Jeff Stilson", url:"https://themoviedb.org/person/216116"}}, {tmdbId:"53925", properties:{bornIn:"Preston, Idaho, U.S.", imdbId:"0381478", born:date('1979-07-18'), name:"Jared Hess", bio:"Jared Lawrence Hess (born July 18, 1979) is an American filmmaker known for his work Napoleon Dynamite (2004) and Nacho Libre (2006), which he co-wrote and directed with his wife, Jerusha Hess.  (Nacho Libre was co-written with Mike White).  He also produced the video for The Postal Service's third single, \"We Will Become Silhouettes\" and The Killers' Christmas single, \"Boots\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AlZGAfdgo6PL0ZOooHf0kxk1wHG.jpg", url:"https://themoviedb.org/person/53925"}}, {tmdbId:"23539", properties:{imdbId:"1590998", born:date('1975-01-21'), name:"Zach Helm", url:"https://themoviedb.org/person/23539"}}, {tmdbId:"116357", properties:{imdbId:"0829820", name:"Scott Stewart", bio:"From Wikipedia, the free encyclopedia. \n\nScott Charles Stewart is an American film director, writer, producer and visual effects developer...", url:"https://themoviedb.org/person/116357"}}, {tmdbId:"64618", properties:{bornIn:"Montréal, Québec, Canada", imdbId:"0531595", born:date('1977-05-16'), name:"Adam MacDonald", url:"https://themoviedb.org/person/64618"}}, {tmdbId:"1028796", properties:{imdbId:"0074009", name:"Richard Berge", url:"https://themoviedb.org/person/1028796"}}, {tmdbId:"97026", properties:{imdbId:"0525141", name:"John Luessenhop", bio:"From Wikipedia, the free encyclopedia. \n\nJohn Luessenhop is the director of Takers, starring Matt Dillon, Paul Walker, Idris Elba, Jay Hernandez, Michael Ealy, T. I. , Chris Brown, and Hayden Christensen. \n\nAlso directed Lockdown\n\nWrote \"TICK. . . TICK. . . TICK. . ...", url:"https://themoviedb.org/person/97026"}}, {tmdbId:"560320", properties:{imdbId:"0679853", name:"William Phelps", url:"https://themoviedb.org/person/560320"}}, {tmdbId:"193910", properties:{name:"Jeff Margolis", url:"https://themoviedb.org/person/193910"}}, {tmdbId:"101709", properties:{bornIn:"Balta, Ukraine, Podolia", imdbId:"0524995", born:date('1898-10-07'), name:"Edward Ludwig", bio:"​From Wikipedia, the free encyclopedia\n\nEdward Irving Ludwig (7 October 1899 – 20 August 1982) was a Russian-born American film director and writer.  He directed nearly 100 films between 1921 and 1963. \n\nLudwig was also one of the directors of John Payne's NBC western television series The Restless Gun (1957-1959). \n\nHe was born in Russia, entered the US from Canada, March 6, 1911, became a naturalized citizen December 23, 1932, and died in Santa Monica, California...", died:date('1982-08-20'), url:"https://themoviedb.org/person/101709"}}, {tmdbId:"1551346", properties:{imdbId:"2816668", name:"Matthew Robinson", url:"https://themoviedb.org/person/1551346"}}, {tmdbId:"102601", properties:{imdbId:"0907779", born:date('1896-03-20'), name:"Hal Walker", died:date('1972-07-03'), url:"https://themoviedb.org/person/102601"}}, {tmdbId:"2991", properties:{bornIn:"Breslau, Silesia, Germany [now Wroclaw, Dolnoslaskie, Poland]", imdbId:"0927468", born:date('1873-04-27'), name:"Robert Wiene", died:date('1938-07-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e3Abf50qDwnDox7Ro38Y7e0qUuQ.jpg", url:"https://themoviedb.org/person/2991"}}, {tmdbId:"1208675", properties:{imdbId:"2348970", name:"Greg Osborne", url:"https://themoviedb.org/person/1208675"}}, {tmdbId:"49555", properties:{bornIn:"Bærum, Norvegia", imdbId:"0639033", born:date('1960-03-14'), name:"Petter Næss", bio:"Just Bea is Petter Næss third feature film.  His first was the comedy Absolute Hangover which won Amanda Awards for Best Male and Female lead in 1999.  Petter Næss is also director behind Elling which was Oscar nominated in 2000.  Otherwise he has primarily busied himself in the world of plays and revues, both as scriptwriter, director and actor...", url:"https://themoviedb.org/person/49555"}}, {tmdbId:"118873", properties:{name:"C. B. Harding", bio:"​From Wikipedia, the free encyclopedia.   \n\nC.  B.  Harding (sometimes credited as CB Harding) is an American film director, screenwriter, producer and cinematographer. \n\nDescription above from the Wikipedia article C.  B.  Harding licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/118873"}}, {tmdbId:"90522", properties:{bornIn:"New York City, New York", imdbId:"0542702", born:date('1912-08-08'), name:"Daniel Mann", bio:"​From Wikipedia, the free encyclopedia\n\nDaniel Mann, also known as Daniel Chugerman (August 8, 1912 – November 21, 1991), was an American film and television director. \n\nDaniel Mann was born in Brooklyn, New York.  He was a stage actor since childhood, and attended Erasmus Hall High School, New York's Professional Children's School and the Neighborhood Playhouse.  He entered films in 1952 as a director, evincing very little flair for visual dynamics but an excellent ear for dialogue...", died:date('1991-11-21'), url:"https://themoviedb.org/person/90522"}}, {tmdbId:"136911", properties:{bornIn:"Paterson, New Jersey, USA", imdbId:"0812874", born:date('1943-07-02'), name:"Alfred Sole", url:"https://themoviedb.org/person/136911"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"115174", properties:{bornIn:"São Paulo, São Paulo, Brazil", imdbId:"2406154", born:date('1982-05-20'), name:"Daniel Ribeiro", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5fvlC1nei8Qk4GKU5fSuFz4ttsd.jpg", url:"https://themoviedb.org/person/115174"}}, {tmdbId:"57538", properties:{imdbId:"0035905", born:date('1970-09-22'), name:"Scot Armstrong", url:"https://themoviedb.org/person/57538"}}, {tmdbId:"27571", properties:{bornIn:"UK", imdbId:"1720541", born:date('1969-09-26'), name:"David Slade", bio:"David A.  Slade (born 26 September 1969) is a British film director who began his career making music videos.  His work includes videos for artists such as Aphex Twin, Rob Dougan, System of a Down, Stone Temple Pilots, Tori Amos, and Muse...", url:"https://themoviedb.org/person/27571"}}, {tmdbId:"89824", properties:{bornIn:"Belfast, United Kingdom", imdbId:"1229323", born:date('1971-03-02'), name:"Jon Wright", url:"https://themoviedb.org/person/89824"}}, {tmdbId:"1586276", properties:{name:"Ted Braun", url:"https://themoviedb.org/person/1586276"}}, {tmdbId:"84740", properties:{imdbId:"0606597", name:"Iain Morris", url:"https://themoviedb.org/person/84740"}}, {tmdbId:"164554", properties:{bornIn:"Sydney - Australia", imdbId:"0448768", born:date('1971-01-01'), name:"Jennifer Kent", bio:"Jennifer Kent is an actress and director best known for The Babadook (2014), Babe: Pig in the City (1998) and Murder Call (1997). \n\nShe was born in Brisbane, Australia\n\nJennifer Kent graduated in 1991 from the National Institute of Dramatic Art in Australia with a degree in Performing Arts...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3xkTQoW219vJZX38wfAlqzUfrXc.jpg", url:"https://themoviedb.org/person/164554"}}, {tmdbId:"84962", properties:{imdbId:"0925482", name:"Stiles White", url:"https://themoviedb.org/person/84962"}}, {tmdbId:"57113", properties:{bornIn:"Santa Monica, California, USA", imdbId:"0319659", born:date('1959-06-24'), name:"Dan Gilroy", bio:"Dan Gilroy was born in Santa Monica, California, the son of Pulitzer Prize winning playwright Frank D.  Gilroy, and sculptor and writer Ruth Dorothy.  His brother Tony Gilroy is a screenwriter and director; and his fraternal twin brother, John Gilroy, is a film editor.  Through his father, he is of Italian, Irish and German descent.  Gilroy wrote the script for 2005 gambling drama Two for the Money (2005), starring Al Pacino and Gilroy's wife Rene Russo...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xgx75pBTZqNBdUWD90QAgEMS6nS.jpg", url:"https://themoviedb.org/person/57113"}}, {tmdbId:"91604", properties:{bornIn:"Samsun, Turkey", imdbId:"0051166", born:date('1977-01-01'), name:"Ali Taner Baltaci", url:"https://themoviedb.org/person/91604"}}, {tmdbId:"45459", properties:{bornIn:"New Haven, Connecticut, Stati Uniti", imdbId:"2648685", born:date('1979-07-05'), name:"Mike Cahill", url:"https://themoviedb.org/person/45459"}}, {tmdbId:"53708", properties:{bornIn:"Memphis, Tennessee, U.S.", imdbId:"0755158", born:date('1965-11-21'), name:"Ira Sachs", bio:"From Wikipedia, the free encyclopedia.   Ira Sachs (b.  November 21, 1965 in Memphis, Tennessee) is an American filmmaker.  His first film was the acclaimed short Lady (1993). \n\nHe directed Sundance Film Festival selection The Delta (1997) and directed Sundance Film Festival Grand Prize winning Forty Shades of Blue (2005).  His latest film is Married Life, starring Chris Cooper and Pierce Brosnan...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lImOdp1b1zDYNCrs8rq2cHl8PMd.jpg", url:"https://themoviedb.org/person/53708"}}, {tmdbId:"32767", properties:{bornIn:"Winnetka, Illinois, USA", imdbId:"0126440", born:date('1947-03-14'), name:"John Byrum", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/r2NoRtAuBWFtM0RDi6MuhMJNn4l.jpg", url:"https://themoviedb.org/person/32767"}}, {tmdbId:"71082", properties:{bornIn:"Dartford, Kent, England", imdbId:"0036349", born:date('1961-04-05'), name:"Andrea Arnold", bio:"From Wikipedia, the free encyclopedia\n\nAndrea Arnold OBE (born 5 April 1961) is a filmmaker and former actress from England, who made her feature length directorial debut in 2006 with Red Road. \n\nDescription above from the Wikipedia article Andrea Arnold, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tdOz2FOhMyQaLOyEQYK1GEk8PA8.jpg", url:"https://themoviedb.org/person/71082"}}, {tmdbId:"303056", properties:{bornIn:"Bellingham, Washington, USA", imdbId:"2574897", born:date('1961-01-16'), name:"Craig Johnson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uOcNkwBZCsjYS9JRW8Cv0y8237I.jpg", url:"https://themoviedb.org/person/303056"}}, {tmdbId:"173686", properties:{name:"Anthony Drazan", url:"https://themoviedb.org/person/173686"}}, {tmdbId:"56506", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"0213100", born:date('1944-11-30'), name:"William Dear", bio:"William Dear is a Canadian born American film and television director, producer and writer.  He holds a degree in Art and Theater from Central Michigan University, Mount Pleasant, USA...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zd7BF2zZTarjru9K4Rwgw6CMFZW.jpg", url:"https://themoviedb.org/person/56506"}}, {tmdbId:"92657", properties:{bornIn:"Elizabeth City, North Carolina,SUA", imdbId:"0761715", born:date('1968-06-10'), name:"Scott Sanders", bio:"From Wikipedia, the free encyclopedia\n\nScott Sanders is an African American screenwriter and film director.  He is best known for his work with the films \"Black Dynamite\" and \"Thick as Thieves\". \n\nDescription above from the Wikipedia article Scott Sanders (director), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7mDva3djOvmzyDahsCrshPWYL76.jpg", url:"https://themoviedb.org/person/92657"}}, {tmdbId:"62556", properties:{imdbId:"0910510", name:"Fred Walton", bio:"​From Wikipedia, the free encyclopedia.   \n\nFred Walton is an American film director.  Among his films are When a Stranger Calls, April Fool's Day, and The Rosary Murders. \n\nDescription above from the Wikipedia article Fred Walton, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wiNFmDgOWMZ4et0cMBiTnZ5YgsI.jpg", url:"https://themoviedb.org/person/62556"}}, {tmdbId:"68662", properties:{bornIn:"Castel Gandolfo, Roma", imdbId:"0080580", born:date('1925-03-31'), name:"Andrea Bianchi", died:date('2013-11-14'), url:"https://themoviedb.org/person/68662"}}] AS row
