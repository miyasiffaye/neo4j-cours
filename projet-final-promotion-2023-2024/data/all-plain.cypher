UNWIND [{tmdbId:"8856", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0633228", name:"DeVaughn Nixon", bio:"​From Wikipedia, the free encyclopedia \n\n  DeVaughn Nixon is an American actor who became best known for his role in the romantic movie The Bodyguard.  He starred in films like The Bodyguard and Sugar Hill, and then starred in numerous television series among which include: Disney series \"Lizzie McGuire and \"Mackenzie Falls\".   \n\n  Description above from the Wikipedia article DeVaughn Nixon, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/grqGei5XcuKNPjOTAZpepOcmmsW.jpg", url:"https://themoviedb.org/person/8856"}}, {tmdbId:"9572", properties:{imdbId:"0019569", born:date('1941-12-03'), name:"Mary Alice", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jniFVDRjYyIxx5EFTR2kzpFAB02.jpg", url:"https://themoviedb.org/person/9572"}}, {tmdbId:"1212644", properties:{imdbId:"0455176", born:date('1975-04-11'), name:"Reina King", url:"https://themoviedb.org/person/1212644"}}, {tmdbId:"10768", properties:{bornIn:"Bronx, New York, USA", imdbId:"0001797", born:date('1958-11-01'), name:"Rachel Ticotin", bio:"From Wikipedia, the free encyclopedia. \n\nRachel Ticotin (born November 1, 1958) is an American film and television actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ihLzHGkgQcpUX26K5AtfG8VuYGB.jpg", url:"https://themoviedb.org/person/10768"}}, {tmdbId:"67015", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0343447", born:date('1947-06-21'), name:"Michael Gross", bio:"From Wikipedia, the free encyclopedia.   Michael Gross (born June 21, 1947) is an American television, movie, and stage actor who plays both comedic and dramatic roles.  His most notable roles are father Steven Keaton from Family Ties and the Graboid hunter Burt Gummer from the Tremors franchise.    Description above from the Wikipedia article Michael Gross, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qznUukUDTLDjRqbP3GdcMYqYSiI.jpg", url:"https://themoviedb.org/person/67015"}}, {tmdbId:"31512", properties:{bornIn:"New York City, New York, USA", imdbId:"0121559", born:date('1960-09-12'), name:"Robert John Burke", bio:"A born-and-bred New Yorker, Robert John Burke made his film debut while in his early 20s with a small part in the drama \"The Chosen\" (1981), based on the Chaim Potok story.  He went on to study acting at SUNY Purchase where he met aspiring filmmaker Hal Hartley, who cast him as one of the leads in his debut feature \"The Unbelievable Truth,\" an offbeat indie tale where he played a man trying to escape his troubled past...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9z4goY4Qlzmtkt7sG1JwIQ4XwrN.jpg", url:"https://themoviedb.org/person/31512"}}, {tmdbId:"120672", properties:{imdbId:"0573819", name:"Julia McNeal", url:"https://themoviedb.org/person/120672"}}, {tmdbId:"80365", properties:{bornIn:"Neath, Glamorgan, Wales, UK", imdbId:"0722631", born:date('1963-12-19'), name:"Paul Rhys", bio:"Paul Rhys (born 19 Docember 1963) is a Welsh television, film and theatre actor.  Rhys studied at RADA in London, leaving with the Bancroft Gold Medal in 1987.  While there, he obtained his first major screen role, in \"Absolute Beginners\" (1986).  Since then he has seldom been off the stage and screen.  His first US exposure was when legendary American film director Robert Altman cast Rhys, who was then still a student, as Theo van Gogh in \"Vincent and Theo\" opposite Tim Roth as Vincent...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l7uc38oZGMQbbq7WqE8rKn9xZJr.jpg", url:"https://themoviedb.org/person/80365"}}, {tmdbId:"211121", properties:{imdbId:"0109485", name:"Adrian Brine", url:"https://themoviedb.org/person/211121"}}, {tmdbId:"13694", properties:{imdbId:"0674695", name:"Jean-François Perrier", url:"https://themoviedb.org/person/13694"}}, {tmdbId:"57711", properties:{imdbId:"0127255", born:date('1948-03-26'), name:"Klaus Büchner", url:"https://themoviedb.org/person/57711"}}, {tmdbId:"57800", properties:{bornIn:"Travemünde, Germany", imdbId:"0271143", born:date('1950-03-17'), name:"Rötger Feldmann", url:"https://themoviedb.org/person/57800"}}, {tmdbId:"57714", properties:{bornIn:"Flensburg, Germany", imdbId:"0271136", born:date('1957-01-01'), name:"Andi Feldmann", url:"https://themoviedb.org/person/57714"}}, {tmdbId:"57715", properties:{imdbId:"0923044", name:"Kulle Westphal", url:"https://themoviedb.org/person/57715"}}, {tmdbId:"42122", properties:{bornIn:"San Francisco, California, USA", imdbId:"0652895", born:date('1968-09-28'), name:"Carré Otis", bio:"​From Wikipedia, the free encyclopedia\n\nCarré Otis (born September 28, 1968) is an American model and actress. \n\nDescription above from the Wikipedia article Carré Otis, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/42122"}}, {tmdbId:"5169", properties:{bornIn:"Brooklyn - New York - USA", imdbId:"0293422", born:date('1946-02-02'), name:"J.E. Freeman", bio:"J. E.  Freeman (born February 2, 1946) is an American actor, often cast in tough guy roles.  His first movie appearance was in the early 80's actionner An Eye for an Eye in which he plays a tow truck driver who minces words with Chuck Norris. \n\nHe is especially known for his menacing characters roles : the evil gangster Marcelles Santos in David Lynch's Wild at Heart, the terrifying Eddie Dane, ferocious gay hitman from Miller's Crossing, and the infamous scientist Mason Wren in Alien Resurrection...", died:date('2014-08-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xM7LHMQwtq6LaJXSXbIzGBeueyM.jpg", url:"https://themoviedb.org/person/5169"}}, {tmdbId:"55156", properties:{bornIn:"Västerås, Västmanlands län, Sweden", imdbId:"0955195", born:date('1925-05-24'), name:"Mai Zetterling", bio:"Mai Elisabeth Zetterling ( May 24, 1925 – March 17, 1994) was a Swedish actress and film director. \n\nShe began directing in the early 1960s, starting with political documentaries and a short film called The War Game (1962), which was nominated for a BAFTA award, and won a Silver Lion at Venice.  Her first feature film Älskande par (1964, \"Loving Couples\"), based on the novels of Agnes von Krusenstjerna, was banned at the Cannes Film Festival for its sexual explicitness and nudity...", died:date('1994-03-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/57lejrVD0UHyhuTi2a9dUx4ZGTb.jpg", url:"https://themoviedb.org/person/55156"}}, {tmdbId:"55157", properties:{bornIn:"Chicago, U.S.", imdbId:"0279557", name:"Jasen Fisher", bio:"​From Wikipedia, the free encyclopedia\n\nJasen Fisher (born 1980) is an American former child actor, born in Chicago.  He made his first movie appearance in the 1989 film Parenthood as Kevin Buckman, receiving a nomination for a Young Artist Award as a supporting actor.  He played the main character of Luke in The Witches in 1990, for which he was nominated for a Saturn Award for Best Performance by a Younger Actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/524EXfK3US4JvdsbEPr5Qd2o1Yt.jpg", url:"https://themoviedb.org/person/55157"}}, {tmdbId:"102880", properties:{bornIn:"Hong Kong", imdbId:"0161193", born:date('1960-02-16'), name:"Cherie Chung", bio:"Cherie Chung Cho-Hung (Chinese: 鍾楚紅; pinyin: Zhōng Chǔhóng; born 16 February 1960) was arguably the queen of Hong Hong cinema in the 80's. \n\nAfter appearing in the Miss Hong Kong beauty pageant in 1979 she was scouted by legendary producer/director Johnnie To and cast in his film THE ENIGMATIC CASE.  From there she could sometimes star in six or more films per year...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hseAAXEacOqwnGvst2Wtlo4lBE7.jpg", url:"https://themoviedb.org/person/102880"}}, {tmdbId:"25256", properties:{bornIn:"  Madrid, Spain", imdbId:"0000721", born:date('1959-07-04'), name:"Victoria Abril", bio:"Victoria Abril (born Victoria Mérida Rojas; 4 July 1959) is a Spanish film actress and singer.  She is best known to international audiences for her performance in the movie ¡Átame! (Tie Me Up! Tie Me Down!). \n\nBorn in Madrid, Abril became widely known in Spain in 1976 when she appeared for two years in the show Un, dos, tres. . .  responda otra vez.  Besides working in Spain, she also made films in France, where she resides, Italy, and Iceland...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6YSJp84sfxdOaSHWBPIjtyUerX1.jpg", url:"https://themoviedb.org/person/25256"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"6536", properties:{bornIn:"Barcelona, España", imdbId:"0508249", born:date('1950-08-01'), name:"Loles León", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vI4x3s9s7hqf1mUnCHa1ieJwnc3.jpg", url:"https://themoviedb.org/person/6536"}}, {tmdbId:"2977", properties:{bornIn:"Pasadena, California, U.S.", imdbId:"0792177", born:date('1951-07-12'), name:"Jamey Sheridan", bio:"Jamey Sheridan (born July 12, 1951) is an American actor. \n\nHe has had a prolific acting career in theater, television, and feature film productions.  He earned a Tony nomination in 1987 for his performance in the revival of Arthur Miller's All My Sons.  After several TV movie appearances, Sheridan landed a starring role on Shannon's Deal.  His later television roles include Chicago Hope, Law & Order: Criminal Intent, and Stephen King's The Stand...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9NYC3VL2D58NfPoqpMy6e0Y9XpQ.jpg", url:"https://themoviedb.org/person/2977"}}, {tmdbId:"58019", properties:{bornIn:"Huntington Beach, California, USA", imdbId:"0256121", born:date('1978-06-13'), name:"Ethan Embry", bio:"Ethan Embry (real name Ethan Philan Randall) is an American film and television actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bL8evASbFbqhuWJsYJdMRlCaipx.jpg", url:"https://themoviedb.org/person/58019"}}, {tmdbId:"58478", properties:{bornIn:"St. Louis, Missouri, U.S.", imdbId:"0005265", born:date('1953-11-18'), name:"Kevin Nealon", bio:"Kevin Nealon is an American actor and comedian, best known as a cast member on Saturday Night Live from 1986 to 1995, acting in several of the Happy Madison films, for playing Doug Wilson on the Showtime series Weeds, and providing the voice of the title character, Glenn Martin on Glenn Martin, DDS...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/u012sM7SP5RfgYA2AeQDsOGlYiv.jpg", url:"https://themoviedb.org/person/58478"}}, {tmdbId:"21817", properties:{bornIn:"Edgware, London, England, UK", imdbId:"0001506", born:date('1973-03-20'), name:"Jane March", bio:"March was born Jane March Horwood in Edgware, London.  Her father, Bernard Horwood, is a secondary school teacher of English and Spanish ancestry.  Her mother, Jean, is Vietnamese and Chinese.  March has one brother. \n\nAt age 14, March won a local \"Become a Model\" contest.  She signed with Storm Model Management and began working as a print model using her middle name March, which was also her birth month...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3zwumEbCnatjAnAJH1bJGANSSoQ.jpg", url:"https://themoviedb.org/person/21817"}}, {tmdbId:"40582", properties:{imdbId:"0576928", name:"Frédérique Meininger", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ctBzHQZq0LcFkArrwaegvQkzDB1.jpg", url:"https://themoviedb.org/person/40582"}}, {tmdbId:"67780", properties:{bornIn:"Amiens, France", imdbId:"0320481", born:date('1967-07-03'), name:"Arnaud Giovaninetti", bio:"Extrait de Wikipedia, l'Encyclopedie libre. \n\nArnaud Giovaninetti est un acteur français, né le 3 juillet 1967 à Amiens.   Fils de Reynald Giovaninetti, chef d'orchestre très renommé en France et à l'étranger, surtout dans les théâtres d'opéra.  Élève au conservatoire de Marseille puis au Conservatoire national supérieur d'art dramatique de Paris, il obtient le Prix Louis Jouvet en 1988, puis débute au cinéma en 1990 dans un film de Philomène Esposito, Mima...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jX2pdbJIUIlXaiJobzIH3R7fSL8.jpg", url:"https://themoviedb.org/person/67780"}}, {tmdbId:"27978", properties:{bornIn:"Neuilly-sur-Seine, Hauts-de-Seine, France", imdbId:"0491777", born:date('1961-06-17'), name:"Denis Lavant", bio:"Denis Lavant (born 17 June 1961) is a French film actor known for his distinctive face and the physically demanding aspects of the roles he plays, which often involve slapstick, acrobatics or dance, as well as for his long-standing association with director Leos Carax.  Lavant has played the lead role in all but one of Carax's films. \n\nLavant is also known for his starring roles in Claire Denis' Beau Travail and Harmony Korine's Mister Lonely, which features Carax in a supporting role...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/WgGsHm3IC6ocjmjslREvKKNnX3.jpg", url:"https://themoviedb.org/person/27978"}}, {tmdbId:"27982", properties:{imdbId:"0117762", name:"Daniel Buain", url:"https://themoviedb.org/person/27982"}}, {tmdbId:"27979", properties:{imdbId:"0345046", born:date('1941-06-04'), name:"Klaus-Michael Grüber", died:date('2008-06-22'), url:"https://themoviedb.org/person/27979"}}, {tmdbId:"64948", properties:{bornIn:"Long Beach, California, USA", imdbId:"0146681", born:date('1961-04-21'), name:"Cathy Cavadini", url:"https://themoviedb.org/person/64948"}}, {tmdbId:"56152", properties:{bornIn:"Brookfield, Connecticut, USA", imdbId:"0001863", born:date('1967-04-28'), name:"Kari Wuhrer", bio:"Kari Samantha Wührer (born April 28, 1967) is an American actress and singer, mostly credited as Kari Wuhrer, sometimes as Kari Salin. \n\nDescription above from the Wikipedia article Kari Wuhrer, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sTWVUK4WBcSpuIotCjlU7sRaEH7.jpg", url:"https://themoviedb.org/person/56152"}}, {tmdbId:"61153", properties:{bornIn:"Hollywood, California, USA", imdbId:"0369567", born:date('1947-12-12'), name:"Wings Hauser", bio:"From Wikipedia, the free encyclopedia\n\nWings Hauser (born December 12, 1947) is an American actor, director, film writer, and god. \n\nDescription above from the Wikipedia article Wings Hauser, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vU2PYlJ0UGIfi4Yj7Tbp6oR3haz.jpg", url:"https://themoviedb.org/person/61153"}}, {tmdbId:"75599", properties:{imdbId:"0181425", name:"Jesse Corti", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oI6zfkWgkMP3UFT5KCi5B6etzCa.jpg", url:"https://themoviedb.org/person/75599"}}, {tmdbId:"170970", properties:{bornIn:"Watseka, Illinois, U.S.A", imdbId:"0263591", born:date('1920-06-13'), name:"Rex Everhart", died:date('2000-03-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4LMXQuKnLQitW73oIfAkAcKjGMz.jpg", url:"https://themoviedb.org/person/170970"}}, {tmdbId:"6573", properties:{bornIn:"Buffalo, New York, USA", imdbId:"0006669", born:date('1950-04-13'), name:"William Sadler", bio:"​From Wikipedia, the free encyclopedia.   \n\nWilliam Thomas Sadler (born April 13, 1950) is an American actor who works in film and television...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rWeb2kjYCA7V9MC9kRwRpm57YoY.jpg", url:"https://themoviedb.org/person/6573"}}, {tmdbId:"11628", properties:{bornIn:"Las Vegas, Nevada, USA", imdbId:"0000363", born:date('1969-07-31'), name:"Loren Dean", bio:"​From Wikipedia, the free encyclopedia\n\nLoren Dean (born July 31, 1969) is an American actor.  He has appeared onstage and in feature films. \n\nDescription above from the Wikipedia article Loren Dean, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zCYDwYJjrY4lpeueZYSzAXKLD5h.jpg", url:"https://themoviedb.org/person/11628"}}, {tmdbId:"2421212", properties:{name:"Pietro Falcone", url:"https://themoviedb.org/person/2421212"}}, {tmdbId:"13693", properties:{bornIn:"Nancy, France", imdbId:"0650849", born:date('1961-03-10'), name:"Chick Ortega", url:"https://themoviedb.org/person/13693"}}, {tmdbId:"144081", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"0949237", born:date('1972-01-01'), name:"Aden Young", bio:"Aden Young (born 1972 in Toronto, Canada) is an Australian actor.  In recent years he has also turned his hand to film making, directing and writing short films The Rose of Ba Ziz (2007) and The Order (1998). \n\nDescription above from the Wikipedia article Aden Young, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/144081"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"65345", properties:{bornIn:"London, England, UK", imdbId:"0002142", born:date('1972-11-19'), name:"Sandrine Holt", bio:"Sandrine Holt is a British-born Eurasian Canadian model turned actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iiB6r5Ja19phs5TMlIF3EgjycGe.jpg", url:"https://themoviedb.org/person/65345"}}, {tmdbId:"18260", properties:{bornIn:"Montreal, Quebec, Canada", imdbId:"0770763", born:date('1936-07-25'), name:"August Schellenberg", bio:"August Schellenberg (born July 25, 1936) is a Canadian actor.  His ethnicity is Mohawk and Swiss-German.  He was trained at the National Theatre School of Canada.  His first film was Rip-Off in 1971.  In 1981, he did voices for the animated film Heavy Metal.  During the late 90's he had major roles in Black Robe (Chomina), Free Willy and its sequels (Randolph Johnson), Iron Will (Ned Dodd), and TV film Crazy Horse (Sitting Bull)...", died:date('2013-08-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fSNg3WDMxgD7JlHs8QVhVf4dx2A.jpg", url:"https://themoviedb.org/person/18260"}}, {tmdbId:"21216", properties:{bornIn:"Philadelphia, Pennsylvania, USA", imdbId:"0001126", born:date('1958-11-29'), name:"Kim Delaney", bio:"Kim Delaney (born November 29, 1961) is an American actress, perhaps best known for her role as Detective Diane Russell on the ABC drama N. Y. P. D.  Blue.  Early in her career, she endeared herself to daytime television viewers as Jenny Gardner, a hugely popular character on the ABC daytime drama All My Children, and the role which first brought her fame...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3ZFuBZFljUkmeXftNAIG3a7WS7Q.jpg", url:"https://themoviedb.org/person/21216"}}, {tmdbId:"54426", properties:{imdbId:"0042998", born:date('1969-06-21'), name:"Lloyd Avery II", died:date('2005-09-04'), url:"https://themoviedb.org/person/54426"}}, {tmdbId:"9780", properties:{bornIn:"New York City, New York, USA", imdbId:"0000291", born:date('1958-08-16'), name:"Angela Bassett", bio:"Angela Evelyn Bassett (born August 16, 1958) is an American actress and activist.  She is best known for her biographical film roles, most notably her performance as Tina Turner in the biopic What's Love Got to Do with It (1993), for which she was nominated for the Academy Award for Best Actress and won a corresponding Golden Globe Award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7Oz53NKdglRzAzI2MKjM3eQXwn.jpg", url:"https://themoviedb.org/person/9780"}}, {tmdbId:"11805", properties:{bornIn:"Syracuse, New York, USA", imdbId:"0001844", born:date('1963-07-20'), name:"Frank Whaley", bio:"​From Wikipedia, the free encyclopedia\n\nFrank Joseph Whalley (born July 20, 1963) is an American film and television actor known for his roles in independent films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ugs5aGtFvqVBgT8rcKEi1LyFur4.jpg", url:"https://themoviedb.org/person/11805"}}, {tmdbId:"20212", properties:{bornIn:"Alexandria, Virginia, USA", imdbId:"0000551", born:date('1963-10-31'), name:"Dermot Mulroney", bio:"Dermot Mulroney (born October 31, 1963) is an American actor, musician, and voice actor.  He is best known for his roles in romantic comedy, western, and drama films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5gJszOF45KMPB5tmAbKdK0qgQBx.jpg", url:"https://themoviedb.org/person/20212"}}, {tmdbId:"53806", properties:{bornIn:"Alexandria, Virginia, US", imdbId:"0612487", born:date('1965-09-24'), name:"Kieran Mulroney", bio:"From Wikipedia, the free encyclopedia.   Kieran Mulroney (born September 24, 1965) is an American actor known for his numerous television appearances.  He is also a musician and screenwriter, along with his wife, Michele.  He was born in Alexandria, Virginia, where he graduated from T.  C.  Williams High School.  His brother is actor Dermot Mulroney. \n\nDescription above from the Wikipedia article Kieran Mulroney, licensed under CC-BY-SA,full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/53806"}}, {tmdbId:"33487", properties:{bornIn:"Cincinnati, Ohio, U.S.", imdbId:"0923210", born:date('1951-12-04'), name:"Patricia Wettig", bio:"​From Wikipedia, the free encyclopedia.   \n\nPatricia Wettig (born December 4, 1951) is an American actress and playwright.  She is best known for her roles in the television series Thirtysomething, Prison Break and Brothers &amp; Sisters.  In film, she is known for her role in City Slickers. \n\nDescription above from the Wikipedia article Patricia Wettig   licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e90WEPSvdrCqBJrpH4LAsR1UBp4.jpg", url:"https://themoviedb.org/person/33487"}}, {tmdbId:"19023", properties:{bornIn:"New Haven, Connecticut, USA", imdbId:"0579116", born:date('1942-10-09'), name:"Stephen Mendillo", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5clnMMMj9AAkbzWUpYJDgZHwiLZ.jpg", url:"https://themoviedb.org/person/19023"}}, {tmdbId:"70147", properties:{imdbId:"0035087", name:"Robert Arkins", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iHltmVHrWhaxs30dM94OEwl6nOD.jpg", url:"https://themoviedb.org/person/70147"}}, {tmdbId:"70148", properties:{imdbId:"0013932", name:"Michael Aherne", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/grRRCr2GzHJdDS47Pfp8D8zDXaG.jpg", url:"https://themoviedb.org/person/70148"}}, {tmdbId:"63358", properties:{bornIn:"Dublin, Ireland", imdbId:"0050337", born:date('1969-01-01'), name:"Angeline Ball", bio:"She was born on June 28, 1969, in Dublin's Rotunda Hospital. \n\nfrom: Wikipedia, the free encyclopedia. \n\nAngeline Ball is an Irish actress who currently resides in London, England.  She is a trained dancer in ballet, tap and modern dance.  Her breakthrough role came in 1991 when she starred as backing singer Imelda Quirke in Alan Parker's The Commitments.  Since then she has appeared in various films and television series both in Ireland and in America...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cnz8cEAj2KUSjt2DVbZktboux3X.jpg", url:"https://themoviedb.org/person/63358"}}, {tmdbId:"33394", properties:{bornIn:"Clontarf, Dublin, Ireland", imdbId:"0448204", born:date('1964-09-25'), name:"Maria Doyle Kennedy", bio:"Maria Doyle Kennedy is an Irish film and television actress, singer and songwriter, best known for her roles as Queen Katherine of Aragon in the television series \"The Tudors\", the title character's wife Frances in \"The General\", and as Siobhan \"Mrs.  S\" Sadler in the television series \"Orphan Black\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nK8DmGEgzGXIbyv3VyK6j7M0Gvw.jpg", url:"https://themoviedb.org/person/33394"}}, {tmdbId:"56367", properties:{bornIn:"Streatham, London, England, UK", imdbId:"0001984", born:date('1970-05-22'), name:"Naomi Campbell", bio:"Naomi Campbell (born 22 May 1970) is a British model.  Scouted at the age of 15, she established herself among the top three most recognisable and in-demand models of the late 1980s and early 1990s, and she was one of six models of her generation declared \"supermodels\" by the fashion world.  As the most famous black model of her time, Campbell has been outspoken throughout her career against the racial bias that exists in the fashion industry...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/szSm9TgGVS8clzNQFGyWDfaq6OG.jpg", url:"https://themoviedb.org/person/56367"}}, {tmdbId:"17338", properties:{bornIn:"Dallas, Texas, U.S.", imdbId:"0406678", born:date('1967-10-31'), name:"Vanilla Ice", bio:"From Wikipedia, the free encyclopedia. \n\nRobert Matthew Van Winkle (born October 31, 1967), best known by his stage name Vanilla Ice, is an American rapper and home improvement television personality.  Born in Dallas, Texas, and raised in Texas and South Florida, Van Winkle released his debut album, Hooked, in 1989 through Ichiban Records, before signing a contract with SBK Records, which released a reformatted version of the album under the title To the Extreme...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uSZjjsRFskxQcu4ZAtXJvYEAPgV.jpg", url:"https://themoviedb.org/person/17338"}}, {tmdbId:"541733", properties:{bornIn:"Los Angeles, California,", imdbId:"0195970", born:date('1965-01-01'), name:"Deezer D", bio:"Deezer D (born Dearon Thompson 1965), is an American actor, rapper and motivational speaker.  He is best known for his role as Nurse Malik McGrath on the TV series ER, and for his roles in the films CB4 and Fear of a Black Hat.  Deezer D's most recent album, Delayed, But Not Denied, was available on iTunes and from his website August 8, 2008.  Previously, Thompson released Unpredictable (2002) and Living Up in a Down World (1999)...", url:"https://themoviedb.org/person/541733"}}, {tmdbId:"101804", properties:{imdbId:"0382895", name:"Kevin Hicks", url:"https://themoviedb.org/person/101804"}}, {tmdbId:"64987", properties:{bornIn:"Zhoushan, Zhejiang, China", imdbId:"0372078", born:date('1963-04-11'), name:"Saifei He", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vprkfA1ZIUP0pRRc8FdooW9G6Iv.jpg", url:"https://themoviedb.org/person/64987"}}, {tmdbId:"64988", properties:{bornIn:"Shanghai, China", imdbId:"0134862", born:date('1944-04-06'), name:"Cuifen Cao", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/A1byhYhSlGgtirkg8c1d9hHarKF.jpg", url:"https://themoviedb.org/person/64988"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"4201", properties:{bornIn:"New York City, New York, USA", imdbId:"0001431", born:date('1955-08-07'), name:"Wayne Knight", bio:"Wayne Knight is an American comedian and film, television and voice actor, best known for playing Newman in the television sitcom \"Seinfeld\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xlGqbZjn48xAUa7eqTybZP360w0.jpg", url:"https://themoviedb.org/person/4201"}}, {tmdbId:"20628", properties:{imdbId:"0244359", born:date('1943-10-06'), name:"Michael Durrell", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rHgq2yRUZwQVA9PuvxgBxEdCBG6.jpg", url:"https://themoviedb.org/person/20628"}}, {tmdbId:"19151", properties:{imdbId:"0248698", born:date('1955-02-14'), name:"James Eckhouse", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iGG7iSZ5sBrmgkT9IHg1ipZCzgq.jpg", url:"https://themoviedb.org/person/19151"}}, {tmdbId:"13690", properties:{imdbId:"0070991", name:"Pascal Benezech", url:"https://themoviedb.org/person/13690"}}, {tmdbId:"2413", properties:{bornIn:"Saumur, Maine-et-Loire, France", imdbId:"0684500", born:date('1955-03-04'), name:"Dominique Pinon", bio:"After studying at the Faculty of Arts of Poitiers, Dominique Pinon moved to Paris where he enrolled at the Cours Simon acting school.  His introducing appearance in cinema took place in 1981 in the movie Diva by Jean-Jacques Beineix. \n\nPinon is considered to be a theatre actor in first place, with constant on-stage acting since 1985.  Until today, he has appeared in the plays of Gildas Bourdet, Jorge Lavelli, Valère Novarina and numerous others...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rIPUhNwGSglgKLgMQWz0JNCqIzf.jpg", url:"https://themoviedb.org/person/2413"}}, {tmdbId:"13686", properties:{imdbId:"0235342", name:"Marie-Laure Dougnac", bio:"​From Wikipedia, the free encyclopedia.   \n\nMarie-Laure Dougnac is a French actress specializing in the dubbing of English films and TV shows into French. \n\nDescription above from the Wikipedia article Marie-Laure Dougnac   licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/13686"}}, {tmdbId:"13687", properties:{bornIn:"Paris, France", imdbId:"0237835", born:date('1946-02-18'), name:"Jean-Claude Dreyfus", bio:"​From Wikipedia, the free encyclopedia.   \n\nJean-Claude Dreyfus (born February 18, 1946, Paris) is a French actor.  He began his career in film acting in 1973 in the film Comment réussir quand on est con et pleurnichard.  Dreyfus is notable for his portrayal of a butcher in the black comedy Delicatessen by Marc Caro and Jean-Pierre Jeunet.  He collaborated again with Jeunet and actor Dominique Pinon in the films The City of Lost Children and A Very Long Engagement...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/s38aGneCsrxBj0YrBZBqv0uD9qU.jpg", url:"https://themoviedb.org/person/13687"}}, {tmdbId:"47901", properties:{bornIn:"London, England, UK", imdbId:"0759924", born:date('1960-08-28'), name:"Emma Samms", bio:"From Wikipedia, the free encyclopedia.   Emma Samms (born Emma E.  W.  Samuelson; 28 August 1960) is a British television actress best known for her role as Holly Sutton on the American daytime soap opera General Hospital and for replacing Pamela Sue Martin as Fallon Carrington Colby on the primetime soap opera Dynasty. \n\nDescription above from the Wikipedia article Emma Samms , licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ufn5NR2DbIIpwIDV6YlV0pKCTnf.jpg", url:"https://themoviedb.org/person/47901"}}, {tmdbId:"63681", properties:{bornIn:"Manhattan, New York, USA", imdbId:"0000689", born:date('1965-02-09'), name:"Julie Warner", bio:"From Wikipedia, the free encyclopedia\n\nJuliet Mia \"Julie\" Warner (born February 9, 1965) is an American actress. \n\nDescription above from the Wikipedia article Julie Warner, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eLZMWjmC8avQzC2PQyOvwnO9cgh.jpg", url:"https://themoviedb.org/person/63681"}}, {tmdbId:"57755", properties:{bornIn:"Midland, Texas, USA", imdbId:"0000437", born:date('1961-07-23'), name:"Woody Harrelson", bio:"Academy Award-nominated and Emmy Award-winning actor Woodrow Tracy Harrelson was born on July 23, 1961 in Midland, Texas, to Diane Lou (Oswald) and Charles Harrelson.  He grew up in Lebanon, Ohio, where his mother was from.  After receiving degrees in theater arts and English from Hanover College, he had a brief stint in New York theater...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gaibtvUFIlwHzRvNKV5UfrR4GCM.jpg", url:"https://themoviedb.org/person/57755"}}, {tmdbId:"176976", properties:{imdbId:"0659325", born:date('1971-01-01'), name:"Richard Panebianco", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hOqTDTx1L8D4aohSFol1mk6AnXO.jpg", url:"https://themoviedb.org/person/176976"}}, {tmdbId:"170773", properties:{bornIn:"Lynchburg, Virginia, USA", imdbId:"0163659", born:date('1964-04-04'), name:"Anthony Clark", url:"https://themoviedb.org/person/170773"}}, {tmdbId:"18979", properties:{bornIn:"Hollywood, California, USA", imdbId:"0000775", born:date('1971-11-25'), name:"Christina Applegate", bio:"Christina Applegate (born November 25, 1971) is an American actress and dancer.  As a child actress, she started playing the role of Kelly Bundy on the Fox sitcom Married. . . with Children (1987–1997).  In her adult years, Applegate established a film and television career, winning an Emmy Award (for her guest role in the sitcom Friends) and earning Tony and Golden Globe nominations...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dNLVRcmXAqFje98Wc2X8CNFGvKh.jpg", url:"https://themoviedb.org/person/18979"}}, {tmdbId:"106836", properties:{bornIn:"USA", imdbId:"0789585", born:date('1964-11-07'), name:"Alonna Shaw", bio:"Alonna is a writer and editor living in Northern California.  She utilizes her background in theatre, film, television, and appreciation of nature in her work.  Storytelling interests include adventures, travel, biography, and social science fiction. Her hobbies are painting, photography, hiking in nature, reading, and always learning something new.  She loves horses, cats, and birds of prey (but not songbirds).  Alonna is married.  Her past careers were as a model, then an actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mgKOOY18bTKQ0N0DL9vLPbkGKiN.jpg", url:"https://themoviedb.org/person/106836"}}, {tmdbId:"1350", properties:{bornIn:"Suresnes, France", imdbId:"0001393", born:date('1966-07-15'), name:"Irène Jacob", bio:"Irène Marie Jacob (born 15 July 1966) is a French-born Swiss actress considered one of the preeminent French actresses of her generation.  Jacob gained international recognition and acclaim through her work with Polish film director Krzysztof Kieslowski, who cast her in the lead role of The Double Life of Véronique and Three Colors: Red.  She came to represent an image of European sophistication, through her \"classic beauty and thoughtful, almost melancholic style of acting...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mYHyYOGBrGLDae1RX9Nkxo6RzwD.jpg", url:"https://themoviedb.org/person/1350"}}, {tmdbId:"17888", properties:{bornIn:"Kharkov, Russian Empire [now Kharkiv, Ukraine]", imdbId:"0344798", born:date('1917-06-13'), name:"Halina Gryglaszewska", bio:"Halina Gryglaszewska was born on June 13, 1917 in Kharkov, Ukraine, Russian Empire.  She was an actress, known for La doble vida de Verónica (1991), Wahadelko (1981) and Nic (1998).  She died on June 18, 2010 in Kraków, Malopolskie, Poland...", died:date('2010-06-18'), url:"https://themoviedb.org/person/17888"}}, {tmdbId:"7109", properties:{bornIn:"Częstochowa, Poland", imdbId:"0420065", born:date('1931-02-05'), name:"Kalina Jedrusik", died:date('1991-08-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mPDLEVfvJkbYbpbn52aiD9al0xd.jpg", url:"https://themoviedb.org/person/7109"}}, {tmdbId:"1149", properties:{bornIn:"Lódz, Poland, Russian Empire [now Lódz, Lódzkie, Poland]", imdbId:"0054270", born:date('1913-11-17'), name:"Aleksander Bardini", died:date('1995-07-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v816A7dBF8OFMyuofAYvBo9maZr.jpg", url:"https://themoviedb.org/person/1149"}}, {tmdbId:"14469", properties:{bornIn:"Harlow, Essex, England", imdbId:"0562201", born:date('1958-03-07'), name:"Rik Mayall", bio:"Richard Michael \"Rik\" Mayall (7 March 1958 – 9 June 2014) was an English comedian, writer and actor.  He was known for his comedy partnership with Adrian Edmondson, his over-the-top, energetic portrayal of characters, and as a pioneer of alternative comedy in the early 1980s...", died:date('2014-06-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aaKeDPbG40TrPV8OCN44vE9gtoa.jpg", url:"https://themoviedb.org/person/14469"}}, {tmdbId:"18977", properties:{bornIn:"Youngstown, Ohio, USA", imdbId:"0642145", born:date('1946-04-12'), name:"Ed O'Neill", bio:"Ed O'Neill (born April 12, 1946) is an American actor.  He is best known for his roles on Married. . .  with Children and Modern Family...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uNXhu2ci4R1OwcMUTK9dluYzdQl.jpg", url:"https://themoviedb.org/person/18977"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"4443", properties:{bornIn:"New York City, New York, USA", imdbId:"0001520", born:date('1955-02-15'), name:"Christopher McDonald", bio:"Christopher McDonald (born February 15, 1955) is an American actor.  He is known for his roles in Happy Gilmore, Requiem for a Dream, and 61...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bOKl8EPOKe0oWD15HxUKH1ugesg.jpg", url:"https://themoviedb.org/person/4443"}}, {tmdbId:"27764", properties:{bornIn:"Leeds, West Yorkshire, England, UK ", imdbId:"0905357", born:date('1967-12-30'), name:"Steven Waddington", bio:"Steven Waddington is an English film and television actor.  He studied at the East 15 Acting School in Loughton, Essex and subsequently joined the Royal Shakespeare Company, first at Stratford and then at the Barbican, London...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qyoYwUI220KtUSMEwNGCTokWDsO.jpg", url:"https://themoviedb.org/person/27764"}}, {tmdbId:"568106", properties:{imdbId:"0172456", name:"Kevin Collins", bio:"An actor known for his work with Derek Jarman.  Not to be confused with the American or Scottish actor of the same name...", url:"https://themoviedb.org/person/568106"}}, {tmdbId:"17290", properties:{bornIn:"Ladywood, Birmingham,  England, UK", imdbId:"0862907", born:date('1965-11-30'), name:"Andrew Tiernan", bio:"Andrew James Tiernan is an English film and television actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/co8FxSWaRuYW3bhsJBTXO3GNkdg.jpg", url:"https://themoviedb.org/person/17290"}}, {tmdbId:"28743", properties:{bornIn:"Corrinshego - Newry - Northern Ireland - UK", imdbId:"0001487", born:date('1961-12-26'), name:"John Lynch", bio:"From Wikipedia, the free encyclopedia\n\nJohn Lynch (born 26 December 1961) is an Irish actor from Northern Ireland...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4TG8HYZ5SEFh1Yk5CCG4fXD55j9.jpg", url:"https://themoviedb.org/person/28743"}}, {tmdbId:"157758", properties:{imdbId:"0492856", born:date('1959-06-06'), name:"Josie Lawrence", bio:"Josie Lawrence is a British film and television actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nJCPwGpzaJlet1tzXAujjDYCMdK.jpg", url:"https://themoviedb.org/person/157758"}}, {tmdbId:"49968", properties:{bornIn:"South Africa", imdbId:"0680670", born:date('1924-07-15'), name:"Neville Phillips", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/t3vIAKqdcMkt8MN0UdYxnD95H04.jpg", url:"https://themoviedb.org/person/49968"}}, {tmdbId:"1666844", properties:{name:"Austin Nagler", url:"https://themoviedb.org/person/1666844"}}, {tmdbId:"146564", properties:{imdbId:"0039958", born:date('1981-09-29'), name:"Shay Astar", bio:"Shay Astar  (born 29 September 1981) is an American actress, singer, and songwriter, perhaps best known for her work in the late 1990s, portraying August Leffler, a semi-recurring character on the sitcom 3rd Rock from the Sun.  Astar portrayed an imaginary friend named Isabella in the Star Trek: The Next Generation episode \"Imaginary Friend\" in 1992...", url:"https://themoviedb.org/person/146564"}}, {tmdbId:"23378", properties:{bornIn:"Bremen, Germany", imdbId:"0837784", born:date('1950-02-02'), name:"Barbara Sukowa", bio:"From Wikipedia, the free encyclopedia. \n\nBarbara Sukowa (born 2 February 1950, Bremen, Germany) is a German theatre and film actress. \n\nDescription above from the Wikipedia article Barbara Sukowa, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/elcQuL0CufvhHSSzPHr9YWTBJmH.jpg", url:"https://themoviedb.org/person/23378"}}, {tmdbId:"56882", properties:{bornIn:"Ystad, Kristianstad län, Sweden", imdbId:"0433495", born:date('1928-12-12'), name:"Ernst-Hugo Järegård", bio:"Ernst-Hugo Alfred Järegård, (born 12 December 1928 in Ystad, died 6 September 1998 in Lidingö, Stockholm County) was a Swedish actor. \n\nDescription above from the Wikipedia article Ernst-Hugo Järegård, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1998-09-06'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tsFtdlXF1koqqSf1TH2NcaaL6uF.jpg", url:"https://themoviedb.org/person/56882"}}, {tmdbId:"20747", properties:{bornIn:"Toronto, Ontario,  Canada", imdbId:"0322306", born:date('1950-06-02'), name:"Joanna Gleason", bio:"Joanna Gleason is a Canadian stage and screen actress and singer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vBufIrlapxpuRlzeSIMXtuFO5XK.jpg", url:"https://themoviedb.org/person/20747"}}, {tmdbId:"70696", properties:{bornIn:"Rye - New York - USA", imdbId:"0931090", born:date('1971-09-14'), name:"Kimberly Williams-Paisley", bio:"From Wikipedia, the free encyclopedia. \n\nKimberly Williams-Paisley (born September 14, 1971, height 5' 5\" (1,65 m)) is an American actress and director, who is perhaps best known for her co-starring role on the ABC sitcom, According to Jim, as well as her breakthrough performance in the popular comedy film, Father of the Bride, for which she was nominated for several awards (along with its sequel, Father of the Bride Part II)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qJ4kWr4mDeKWenPeMOff8VtuAIq.jpg", url:"https://themoviedb.org/person/70696"}}, {tmdbId:"18793", properties:{bornIn:"New York City, New York, USA", imdbId:"0001085", born:date('1982-09-30'), name:"Kieran Culkin", bio:"Kieran Kyle Culkin was born September 30, 1982, and started working in 1990.  He worked with his brother, Mac several times.  His debut was playing Mac's cousin, Fuller, in Home Alone (1990).  He went on to do lots of films on his own.  He starred in Father of the Bride (1991) playing Steve Martin's young son.  Then a few years later they offered him a special role in The Mighty (1998)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xVJ2YLyOAKKUMM04V53zyolEyjc.jpg", url:"https://themoviedb.org/person/18793"}}, {tmdbId:"981542", properties:{imdbId:"0117035", name:"Adam Bryant", url:"https://themoviedb.org/person/981542"}}, {tmdbId:"11075", properties:{imdbId:"3051240", name:"Paul Lombardi", url:"https://themoviedb.org/person/11075"}}, {tmdbId:"11076", properties:{bornIn:"Saratoga Springs, New York, USA", imdbId:"0001383", born:date('1959-04-03'), name:"David Hyde Pierce", bio:"David Hyde Pierce is an American actor and director.  He is best known for playing psychiatrist Dr.  Niles Crane on the NBC sitcom Frasier, for which he received 11 Primetime Emmy Awards nominations for Outstanding Supporting Actor in a Comedy Series and 4 wins during the show's run...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zMK62Gtvmuz8I4DFIOUPDcaKCVu.jpg", url:"https://themoviedb.org/person/11076"}}, {tmdbId:"9030", properties:{bornIn:"London, England, UK", imdbId:"0628601", born:date('1972-11-06'), name:"Thandie Newton", bio:"Thandiwe Nashita \"Thandie\" Newton (born 6 November 1972) is an English actress.  She has appeared in a number of British and American films.  Newton was born in London, the daughter of Nyasha, a Zimbabwean health-care worker and Nick Newton, a Cornish laboratory technician and artist.  The name \"Thandiwe\" means \"beloved\".  Raised in London and Penzance, Kernow/Cornwall, she went on to study social anthropology at Downing College, Cambridge, from 1992 to 1995...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hZQLvxj7nV7pBrRyWTvWVz1CDi8.jpg", url:"https://themoviedb.org/person/9030"}}, {tmdbId:"1347351", properties:{imdbId:"0741261", name:"Bartholomew Rose", url:"https://themoviedb.org/person/1347351"}}, {tmdbId:"68849", properties:{bornIn:"\tRockland County, New York", imdbId:"0338625", born:date('1967-05-13'), name:"Shon Greenblatt", bio:"From Wikipedia, the free encyclopedia.  His first feature movie was the 1989 film Chopper Chicks in Zombietown, his best known role was in the 1991 movie, Freddy's Dead: The Final Nightmare and for the cult Disney musical \"newsies\" starring Christian Bale.  He appeared on television in the TV movie, Just Perfect (1989) and on the series Hardball. \n\nDescription above from the Wikipedia article Shon Greenblatt, licensed under CC-BY-SA,full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/68849"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"68850", properties:{bornIn:"Corsicana, Texas", imdbId:"0213034", born:date('1964-06-01'), name:"Lezlie Deane", bio:"From Wikipedia, the free encyclopedia.   Lezlie Deane (born June 1, 1964) is an American singer, musician, rollerderby athlete, and actress who has starred in film and made some television appearances.  She is best known for her roles in horror films including 976-EVIL, Girlfriend from Hell (1990), and the hit horror movie Freddy's Dead: The Final Nightmare (1991) in the role of Tracy. \n\nDeane was born Leslie Denise Lonon in Corsicana, Texas...", url:"https://themoviedb.org/person/68850"}}, {tmdbId:"27008", properties:{bornIn:"Glendale, California, USA", imdbId:"0001210", born:date('1957-05-27'), name:"Chelsea Field", bio:"Chelsea Field (born May 27, 1957) is an American actress.  She played Teela in Masters of the Universe...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qGpq2QDoxWHLSm7NciNX2JyaHBw.jpg", url:"https://themoviedb.org/person/27008"}}, {tmdbId:"24516", properties:{bornIn:"Massapequa, Long Island, New York, USA", imdbId:"0000838", born:date('1960-10-05'), name:"Daniel Baldwin", bio:"​From Wikipedia, the free encyclopedia\n\nDaniel Leroy Baldwin (born October 5, 1960) is an American actor, producer and director.  He is the second oldest of the four Baldwin brothers, all of whom are actors.  Daniel Baldwin is known for his role as Detective Beau Felton in the popular NBC TV series Homicide: Life on the Street...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8Np9SvinmGt5ZpbAgJYdguBsKtu.jpg", url:"https://themoviedb.org/person/24516"}}, {tmdbId:"3905", properties:{bornIn:"Miami, Florida, USA", imdbId:"0000513", born:date('1950-03-13'), name:"William H. Macy", bio:"An American actor and writer.  He was nominated for an Academy Award for his role as Jerry Lundegaard in Fargo.  He is also a teacher and director in theater, film and television.  His film career has been built mostly on his appearances in small, independent films, though he has appeared in summer action films as well.  Macy has described his screen persona as \"sort of a Middle American, WASPy, Lutheran kind of guy. . .  Everyman\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7fkXWN1xQfQwxuHv6uhpgBWX0Dg.jpg", url:"https://themoviedb.org/person/3905"}}, {tmdbId:"97068", properties:{bornIn:"Jersey City, New Jersey, USA", imdbId:"0345466", born:date('1950-04-06'), name:"Vincent Guastaferro", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3i6qQWbkDfqEdNENokjvBQo4PQi.jpg", url:"https://themoviedb.org/person/97068"}}, {tmdbId:"2348346", properties:{name:"Bowlegged Lou", url:"https://themoviedb.org/person/2348346"}}, {tmdbId:"1903206", properties:{name:"Anthony Ramirez", url:"https://themoviedb.org/person/1903206"}}, {tmdbId:"12136", properties:{imdbId:"0503266", name:"Ray LePere", url:"https://themoviedb.org/person/12136"}}, {tmdbId:"50008", properties:{imdbId:"0901763", name:"Franco Volpi", url:"https://themoviedb.org/person/50008"}}, {tmdbId:"31005", properties:{bornIn:" Mineola, Texas, USA", imdbId:"0932244", born:date('1931-08-31'), name:"Noble Willingham", bio:"​From Wikipedia, the free encyclopedia. \n\nNoble Henry Willingham, Jr.   (August 31, 1931 — January 17, 2004) was an American television and film actor...", died:date('2004-01-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/70HEA9aOmmPmTeCvxXqJC6KGHaZ.jpg", url:"https://themoviedb.org/person/31005"}}, {tmdbId:"130598", properties:{bornIn:"中国香港", imdbId:"0266658", born:date('1973-06-19'), name:"Siu-Wong Fan", bio:"Fan Siu-Wong (born June 19, 1973) is a Hong Kong actor and martial artist.  He is best known for his role as Ricky Ho in Riki-Oh: The Story of Ricky (1991) and as Jin Shanzhao in Ip Man (2008) and Ip Man 2 (2010)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jBuu1y50Qeq27tJyikx6KHGcyJE.jpg", url:"https://themoviedb.org/person/130598"}}, {tmdbId:"81670", properties:{bornIn:"Fukuoka, Japan", imdbId:"0960013", born:date('1963-12-31'), name:"Yukari Ôshima", bio:"The female martial artist and action actor better known to Western audiences as Yukari Oshima has so far appeared in over 60 Taiwanese, Hong Kong, Philippino and Chinese films released between 1986 and 1999.   Despite being a Japanese national, Yukari has acted in only one Japanese movie, cast as a radio reporter in a special guest appearance.   After living and working in the Philippines for a number of years, Yukari returned to Japan and began working in tourism...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/76B1cA3EgXbEHBsFJD13Pv4LLrg.jpg", url:"https://themoviedb.org/person/81670"}}, {tmdbId:"4175", properties:{bornIn:"San Francisco, California, USA", imdbId:"0001787", born:date('1944-07-08'), name:"Jeffrey Tambor", bio:"From Wikipedia, the free encyclopedia. \n\nJeffrey Michael Tambor (born July 8, 1944) is an American actor, perhaps best known for his roles as George Bluth Sr.  and Oscar Bluth on Arrested Development and Hank Kingsley on The Larry Sanders Show. \n\nDescription above from the Wikipedia article Jeffrey Tambor, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e4IkxsEo5O4oUWrIpXlEhWa6lqB.jpg", url:"https://themoviedb.org/person/4175"}}, {tmdbId:"52043", properties:{bornIn:"Philadelphia, Pennsylvania, USA ", imdbId:"0659573", born:date('1946-04-08'), name:"Stuart Pankin", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9Zjv5YDfjrBKwCCEslb4Rkrx87V.jpg", url:"https://themoviedb.org/person/52043"}}, {tmdbId:"65002", properties:{bornIn:"New York City - New York - USA", imdbId:"0001127", born:date('1956-03-13'), name:"Dana Delany", bio:"Dana Welles Delany (born March 13, 1956) is a multi-award winning American film, stage, and television actress.  She is known for her role as Colleen McMurphy on the ABC television show China Beach (1988–1991), Katherine Mayfair on Desperate Housewives (2007–2010),[3] Megan Hunt on Body of Proof (2011–present) and, as a voice-actress, Lois Lane in the DC Animated Universe as well as the television series The Batman.  In an interview, she said she loves to play \"complicated characters\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eDe2cjgxQV0G111I8iXCrt4w4u6.jpg", url:"https://themoviedb.org/person/65002"}}, {tmdbId:"46530", properties:{bornIn:"New York City, New York", imdbId:"0002123", born:date('1982-02-23'), name:"Adam Hann-Byrd", bio:"From Wikipedia, the free encyclopedia. \n\nAdam Hann-Byrd (born February 23, 1982) is an American actor most recognized for his role as young Alan in the 1995 film Jumanji...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mHP2KJTaABqMiY6OErVw1fP2d32.jpg", url:"https://themoviedb.org/person/46530"}}, {tmdbId:"18688", properties:{bornIn:"New Orleans, Louisiana, USA", imdbId:"0001065", born:date('1967-09-11'), name:"Harry Connick Jr.", bio:"From Wikipedia, the free encyclopedia. \n\nJoseph Harry Fowler Connick, Jr.  (born September 11, 1967) is an American singer, actor, composer and pianist.  Connick has sold over 25 million albums worldwide.  He is ranked among the top 60 best-selling male artists in the United States by the Recording Industry Association of America, with 16 million certified albums.  He has seven top-20 U. S.  albums, and ten number-one U. S...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/il1t0cshowbZ6mMtH1930baQx9n.jpg", url:"https://themoviedb.org/person/18688"}}, {tmdbId:"18277", properties:{bornIn:"Arlington County, Virginia, USA", imdbId:"0000113", born:date('1964-07-26'), name:"Sandra Bullock", bio:"Sandra Annette Bullock (born July 26, 1964) is an American actress and producer.  She rose to fame in the 1990s with roles in films such as Demolition Man (1993), Speed (1994), The Net (1995), While You Were Sleeping (1995), A Time to Kill (1996), and Hope Floats (1998).  In the new millennium, Bullock starred in Miss Congeniality (2000), Two Weeks Notice (2002), The Lake House (2006), and the critically acclaimed Crash (2004)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5pyso6iXs4nGz55tCOU6AfmPspZ.jpg", url:"https://themoviedb.org/person/18277"}}, {tmdbId:"96554", properties:{bornIn:"Syracuse, New York, USA", imdbId:"0544721", born:date('1960-09-21'), name:"Mary Mara", url:"https://themoviedb.org/person/96554"}}, {tmdbId:"116152", properties:{bornIn:"Calabasas, California, USA", imdbId:"0217752", born:date('1964-09-10'), name:"Donna DeLory", bio:"Donna De Lory (born September 10, 1964) is an American singer, dancer and songwriter.  Part of a musical family, De Lory has been performing since a young age.  Her voice can be heard on albums by Carly Simon, Ray Parker, Jr. , Kim Carnes, Santana, Martika, Laura Branigan, Belinda Carlisle, Selena, Bette Midler, Barry Manilow, Mylène Farmer, Alisha and Madonna...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/emMs1q0MpswEb75UMxaosBecvd1.jpg", url:"https://themoviedb.org/person/116152"}}] AS row
