UNWIND [{tmdbId:"10963", properties:{bornIn:"Honduras", imdbId:"0959242", born:date('1965-01-01'), name:"José Zúñiga", bio:"From Wikipedia, the free encyclopedia. \n\nZúñiga was born in Honduras.  He is best known for his roles in films such as Alive, Ransom, Con Air, Fresh, Crooklyn, Next Stop Wonderland and Twilight.  He has appeared in several television shows including 24, Prison Break, Law &amp; Order, The O. C. , NCIS, CSI: Crime Scene Investigation, Bones, Lie to meDexter and Medium,The Event and Scandal...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yiK8ai8cKtWbP9OSOReA3gEX38v.jpg", url:"https://themoviedb.org/person/10963"}}, {tmdbId:"46395", properties:{bornIn:"New York City, New York, USA", imdbId:"0315342", born:date('1966-03-30'), name:"Stephen Gevedon", bio:"Stephen Gevedon was born on March 30, 1966 in New York City, New York, USA as Stephen Howard Gevedon.  He is known for his work on Session 9 (2001), Klodenes kamp (2005) and Smoke (1995)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6VM3pEpwebjUKJvIlxzRu4LnBoP.jpg", url:"https://themoviedb.org/person/46395"}}, {tmdbId:"143017", properties:{bornIn:"New Orleans - Louisiana - USA", imdbId:"0919867", born:date('1966-01-01'), name:"Frederick Weller", bio:"​From Wikipedia, the free encyclopedia. \n\nFrederick Weller  (born 1966) is an American actor and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l9TVDLipRNHblQFegE0L0RiYDaA.jpg", url:"https://themoviedb.org/person/143017"}}, {tmdbId:"1186916", properties:{imdbId:"0179076", name:"Brendan Corbalis", url:"https://themoviedb.org/person/1186916"}}, {tmdbId:"138252", properties:{imdbId:"0100384", name:"Duane Boutte", url:"https://themoviedb.org/person/138252"}}, {tmdbId:"65348", properties:{bornIn:"Manhattan, New York, USA", imdbId:"0291253", born:date('1951-05-21'), name:"Al Franken", bio:"Alan Stuart Franken is an American comedian, politician, media personality, and author who served as a United States senator from Minnesota from 2009 to 2018.  He became well known in the 1970s and 1980s as a staff writer and performer on the television comedy show Saturday Night Live...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yQj4vgh6PHyupMe3mFeDaCNHfCq.jpg", url:"https://themoviedb.org/person/65348"}}, {tmdbId:"41820", properties:{bornIn:"Austin, Texas, USA", imdbId:"0000405", born:date('1965-01-08'), name:"Michelle Forbes", bio:"Michelle Forbes is an American film and television actress, best known for many recurring appearances on genre and drama television shows such as \"Star Trek: The Next Generation\", \"Battlestar Galactica\", \"24\", \"Prison Break\", and \"True Blood\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6xjsXKZs23a1Vzdw4uSUiV64BFS.jpg", url:"https://themoviedb.org/person/41820"}}, {tmdbId:"1121", properties:{bornIn:"San Germán, Puerto Rico", imdbId:"0001125", born:date('1967-02-19'), name:"Benicio Del Toro", bio:"Benicio Monserrate Rafael del Toro Sánchez (born February 19, 1967) is a Puerto Rican actor and film producer.  His awards include the Academy Award, Golden Globe, Screen Actors Guild (SAG) Award and British Academy of Film and Television Arts (BAFTA) Award.  He is known for his roles as Fred Fenster in The Usual Suspects, Javier Rodríguez in Traffic (his Oscar-winning role), Jack 'Jackie Boy' Rafferty in Sin City, Dr...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cVh4UgCMu6aAkZ2BqymTLV86FzZ.jpg", url:"https://themoviedb.org/person/1121"}}, {tmdbId:"31365", properties:{bornIn:"Baltimore, Maryland, USA", imdbId:"0440885", born:date('1957-10-24'), name:"John Kassir", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/byj6Px0tLcqRFWIJYUxstg25Qd2.jpg", url:"https://themoviedb.org/person/31365"}}, {tmdbId:"15864", properties:{bornIn:"New York City, New York, USA", imdbId:"0929934", born:date('1939-08-21'), name:"Clarence Williams III", bio:"Clarence Williams III (born August 21, 1939) is an American actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7L0EVcSzBt214BqIYnSS2PfkrBU.jpg", url:"https://themoviedb.org/person/15864"}}, {tmdbId:"54423", properties:{bornIn:"St. Louis, Missouri, USA", imdbId:"0868957", born:date('1965-09-28'), name:"Joe Torry", bio:"From Wikipedia, the free encyclopedia\n\nJoe Torry (born Joseph Pierre Torry on September 28, 1965 in St.  Louis, Missouri) is an American actor and comedian. \n\nDescription above from the Wikipedia article Joe Torry, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jBsJxaPivE5U4kfdnTIlP5a6HOO.jpg", url:"https://themoviedb.org/person/54423"}}, {tmdbId:"93538", properties:{imdbId:"0094170", born:date('1976-03-19'), name:"De'aundre Bonds", url:"https://themoviedb.org/person/93538"}}, {tmdbId:"1424350", properties:{imdbId:"0598454", name:"Samuel Monroe Jr.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1lrbUeVhix0WAuUFZ7tuBuCVVdF.jpg", url:"https://themoviedb.org/person/1424350"}}, {tmdbId:"3489", properties:{bornIn:"Shoreham, Kent, England, UK", imdbId:"0915208", born:date('1968-09-28'), name:"Naomi Watts", bio:"Naomi had already been a working actress for over a decade when she earned notice as a promising newcomer in David Lynch's Cannes Film Festival prizewinner Mulholland Drive (2001).  Born September 28th, 1968, Watts began acting in her teens, landing her first film role in For Love Alone (1986).  Watts subsequently appeared with future Hollywood headliners Nicole Kidman and Thandie Newton in John Duigan's disarming teen romance Flirting (1991)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5s6UE6VjYx5TBDvyFk4vfOdS9GR.jpg", url:"https://themoviedb.org/person/3489"}}, {tmdbId:"4520", properties:{bornIn:"Bedford-Stuyvesant, Brooklyn, New York, USA", imdbId:"0001235", born:date('1955-06-07'), name:"William Forsythe", bio:"An American actor, known for playing \"tough guy\" roles...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/g0vIRDw0FemQlX0HGW94b4Kx8nz.jpg", url:"https://themoviedb.org/person/4520"}}, {tmdbId:"1542806", properties:{name:"Seth Mumy", url:"https://themoviedb.org/person/1542806"}}, {tmdbId:"125486", properties:{bornIn:"Alboraya, València, Comunitat Valenciana, Spain", imdbId:"0665082", born:date('1960-08-07'), name:"Rosana Pastor", bio:"​From Wikipedia, the free encyclopedia\n\nRosana Pastor (born 7 August 1960 in Alboraya) is a Spanish actress, best known for her role as Blanca in Land and Freedom.  She was nominated for Best Supporting Actress at the 2002 Goya Awards for her role in Juana la Loca. \n\nDescription above from the Wikipedia article Rosana Pastor, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mSFud1jV0Ge8opa4isA0qDfDM8H.jpg", url:"https://themoviedb.org/person/125486"}}, {tmdbId:"16973", properties:{bornIn:"Madrid, Madrid, Spain", imdbId:"0093081", born:date('1967-06-12'), name:"Icíar Bollaín", bio:"​From Wikipedia, the free encyclopedia.   \n\nIcíar Bollaín Pérez-Mínguez (Madrid, June 12, 1967) is a Spanish actress, director and writer. \n\nHer father was an aeronautical engineer and her mother was a music teacher.  She made her début when she was 15 years old.  She is a member of the Academia Española de Cinematografía.  She began her work in cinema at the age of fourteen as part of the cast in Victor Erice's film El Sur (1983).  Since then she has acted in fourteen films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ghZw8ecICa4fBRR8ZeQ1wyVVLuc.jpg", url:"https://themoviedb.org/person/16973"}}, {tmdbId:"73421", properties:{bornIn:"San Juan, Puerto Rico", imdbId:"0001618", born:date('1974-10-28'), name:"Joaquin Phoenix", bio:"Joaquin Rafael Phoenix (born October 28, 1974) is an American actor and producer.  He has received numerous awards and nominations, including an Academy Award, a Grammy Award, and two Golden Globe Awards. \n\nAs a child, Phoenix started acting in television with his brother River and sister Summer.  His first major film role was in SpaceCamp (1986).  During this period, he was credited as Leaf Phoenix, a name he gave himself...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zixTWuMZ1D8EopgOhLVZ6Js2ux3.jpg", url:"https://themoviedb.org/person/73421"}}, {tmdbId:"60950", properties:{bornIn:"Birmingham, Michigan, USA", imdbId:"0005450", born:date('1964-07-22'), name:"David Spade", bio:"David Wayne Spade (born July 22, 1964) is an American actor, comedian and television personality who first became famous in the 1990s as a cast member on Saturday Night Live, and from 1997 until 2003 starred as Dennis Finch on Just Shoot Me!.  He also starred as C. J.  Barnes, along with Katey Sagal, James Garner and Kaley Cuoco on 8 Simple Rules. He currently stars as Russell Dunbar on the CBS sitcom Rules of Engagement.  He is also working with TBS on an animated series based on his film Joe Dirt...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8tv638lAMLmYh8bSLICqPzbW3tv.jpg", url:"https://themoviedb.org/person/60950"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"19068", properties:{bornIn:"Lyon, Rhône, France", imdbId:"0086924", born:date('1956-04-25'), name:"Dominique Blanc", bio:"From Wikipedia, the free encyclopedia\n\nDominique Blanc (born 25 April 1956) is a French actress. \n\nShe was trained at the French Drama school, Cours Florent.  In 1980, at the suggestion of Pierre Romans in whose class she was, Patrice Chéreau went to see her and engaged her for a performance of Henrik Ibsen's Peer Gynt.  She remains one of Chéreau's preferred actresses. \n\nOne of the most critically acclaimed French actresses, Blanc has won four César Awards...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qKsLOWtZ8rxBBPxjmZzKxIC43MQ.jpg", url:"https://themoviedb.org/person/19068"}}, {tmdbId:"68108", properties:{bornIn:"New York City, New York, USA ", imdbId:"0308651", born:date('1968-01-12'), name:"Chris Gartin", bio:"Christopher Gartin is an American actor.  He was previously married to Joanne Gartin, an event planner in Los Angeles who has organized weddings for Hollywood stars such as Elizabeth Berkley and Greg Lauren, Molly Shannon, Taye Diggs, Kate Walsh and Tori Spelling...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6Oy9QRX9BjMc7rHFC0ttaI778i0.jpg", url:"https://themoviedb.org/person/68108"}}, {tmdbId:"98652", properties:{imdbId:"0421496", name:"Jane Jensen", url:"https://themoviedb.org/person/98652"}}, {tmdbId:"98310", properties:{bornIn:"Filadelfia, Pennsylvania, Stati Uniti", imdbId:"0444687", born:date('1974-09-14'), name:"Will Keenan", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ikt71Z6WxuyELbHWsuLi7xTYwbV.jpg", url:"https://themoviedb.org/person/98310"}}, {tmdbId:"98653", properties:{bornIn:"Red Bank, New Jersey, USA", imdbId:"0585741", born:date('1970-10-13'), name:"Valentine Miele", bio:"Valentine Miele is an actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j9T8wniJkCkkTQWlreKADA21Ndt.jpg", url:"https://themoviedb.org/person/98653"}}, {tmdbId:"98654", properties:{imdbId:"0065894", name:"William Beckwith", bio:"William Beckwith is an actor, known for Scent of a Woman 1992, Tromeo and Juliet 1996 and Thrilled to Death 1988...", url:"https://themoviedb.org/person/98654"}}, {tmdbId:"975569", properties:{imdbId:"0577828", name:"Joseph Melito", url:"https://themoviedb.org/person/975569"}}, {tmdbId:"288", properties:{bornIn:"Manhattan - New York City - New York - USA", imdbId:"0781218", born:date('1970-10-14'), name:"Jon Seda", bio:"Jonathan Seda (born October 14, 1970) is an American actor of Puerto Rican descent, possibly best known for his role as Detective Paul Falsone on NBC's: Homicide: Life on the Street.  Seda was an amateur boxer who in 1992, auditioned for and was given a role in the film Gladiator.  He became interested in acting and appeared in various films.  He portrayed Chris Pérez alongside Jennifer Lopez in Selena and became widely known to both the Hispanic and non-Hispanic communities...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hGDXJKzXGPulVmxWBxyzrTY4RT4.jpg", url:"https://themoviedb.org/person/288"}}, {tmdbId:"1077231", properties:{imdbId:"0151232", name:"Michael Chance", url:"https://themoviedb.org/person/1077231"}}, {tmdbId:"25541", properties:{bornIn:"Washington, D.C., USA", imdbId:"0001337", born:date('1978-11-24'), name:"Katherine Heigl", bio:"Katherine Marie Heigl, born on November 24, 1978, is an American actress.  She is best known for her role as Dr.  Izzie Stevens on Grey's Anatomy and her starring role in the movies Knocked Up, Zyzzyx Road, 27 Dresses, The Ugly Truth, Killers and Life As We Know It. \n\nHeigl started her career as a child model with Wilhelmina Models before she turned her attention to acting.  She made her debut in the coming-of-age film, That Night...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/t0a2ULdphs7TbnRPxjTszLvXL9V.jpg", url:"https://themoviedb.org/person/25541"}}, {tmdbId:"70874", properties:{bornIn:"Ravno Selo near Vrbas - Serbia - Yugoslavia", imdbId:"0728476", born:date('1952-10-26'), name:"Lazar Ristovski", bio:"Lazar Ristovski is a famous Serbian actor, director, producer and writer.  He has appeared on stage about 4000 times, and starred in over 40 films, TV series and TV dramas, mostly in lead roles...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/meDZXviItbPnj1RAsuIAvkCXFea.jpg", url:"https://themoviedb.org/person/70874"}}, {tmdbId:"70875", properties:{bornIn:"Belgrade, Serbia", imdbId:"0427066", born:date('1967-11-24'), name:"Mirjana Jokovic", bio:"Mirjana Joković (born November 24, 1967) is a Serbian film and stage actress, best known for her role as Natalija Zovkov in Underground, the film of Emir Kusturica (1995).  She currently is Director of Performance for Acting and an acting teacher in the Theater Faculty of the California Institute of the Arts near Los Angeles...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x7FJaCev5abs2kq1XgS01Ei6mX2.jpg", url:"https://themoviedb.org/person/70875"}}, {tmdbId:"70876", properties:{bornIn:"Konjsko brdo, Perušić, Croatia", imdbId:"0830371", born:date('1960-10-15'), name:"Slavko Stimac", bio:"Slavko Štimac is a Serbian actor. \n\nHe graduated from The Faculty of Dramatic Arts in Belgrade, Serbia. Slavko Štimac made his screen debut in the 1972 film Vuk samotnjak.  What followed was a career during which Štimac appeared in many popular and important 1970s and 1980s Yugoslav films where he played child and adolescent characters (including the role of young Russian soldier in Sam Peckinpah's Cross of Iron)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mQMeX8rdkTVsKLNW17y1BrCgbqr.jpg", url:"https://themoviedb.org/person/70876"}}, {tmdbId:"15675", properties:{bornIn:"San Francisco, California, USA", imdbId:"0254362", born:date('1970-05-19'), name:"Alison Elliott", bio:"Alison A.  Elliott (born 19 May 1970) is an American actress.  Elliott was born in San Francisco, CA, the daughter of Barbara, a teacher of nursing, and Bob Elliott, a computer executive. [1] She moved with her family to Tokyo, Japan when she was 4 years old, and then moved back to San Francisco when she was 8, where she later attended an arts high school.  At 14, her modeling career began, and in 1989, she moved to Los Angeles to star as a teen-aged model on the TV sitcom Living Dolls (1989)...", url:"https://themoviedb.org/person/15675"}}, {tmdbId:"886", properties:{bornIn:"Mitchell Field Air Force Base, East Meadow, Long Island, New York, USA", imdbId:"0001209", born:date('1956-11-27'), name:"William Fichtner", bio:"William Edward Fichtner (born November 27, 1956) is an American actor.  He has appeared in a number of notable film and TV series.  He is known for his roles as Sheriff Tom Underlay in the cult favorite television series Invasion, Alexander Mahone on Prison Break and Butch Cavendish in The Lone Ranger. \n\nDescription above from the Wikipedia article William Fichtner, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vBzu65yIaQpLPZ7qJRADJRAvTpL.jpg", url:"https://themoviedb.org/person/886"}}, {tmdbId:"27858", properties:{imdbId:"0872242", born:date('1969-01-04'), name:"Adam Trese", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kNCjIozZRvbntkRsuRq1xJSppYI.jpg", url:"https://themoviedb.org/person/27858"}}, {tmdbId:"1799764", properties:{name:"Natane Boudreau", url:"https://themoviedb.org/person/1799764"}}, {tmdbId:"2166", properties:{bornIn:"Roma, Lazio, Italia", imdbId:"0144812", born:date('1953-08-18'), name:"Sergio Castellitto", bio:"Sergio Castellitto (born 18 August 1953) is an Italian actor, film director, and screenwriter. \n\nSergio Castellitto was born in Rome in 1953, to parents from Molise, Southern Italy.  After graduating from the Silvio D'Amico National Academy of Dramatic Art in 1978, he began his theatrical career in Italian public theater with Shakespeare's Measure for Measure at the Teatro di Roma and with roles in other plays such as La Madre by Brecht, Merchant of Venice, and Candelaio by Giordano Bruno...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uq5xz7kinzgdclGOcechgfPBgYC.jpg", url:"https://themoviedb.org/person/2166"}}, {tmdbId:"258039", properties:{bornIn:"Catania", imdbId:"0517046", born:date('1976-11-10'), name:"Tiziana Lodato", url:"https://themoviedb.org/person/258039"}}, {tmdbId:"592480", properties:{imdbId:"0768769", name:"Franco Scaldati", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ArxYxm4T5eRoO9ojWv5UubPRhvk.jpg", url:"https://themoviedb.org/person/592480"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"66554", properties:{bornIn:"Bedford-Stuyvesant, New York City, New York, USA", imdbId:"0362429", born:date('1965-07-24'), name:"Kadeem Hardison", bio:"Kadeem Hardison (born July 24, 1965) is an American actor and director.  He is best known for his role Dwayne Wayne on A Different World, a spin-off of the long-running NBC sitcom The Cosby Show.  He also starred in the Disney Channel series K. C.  Undercover as Craig Cooper, the title character's father. \n\n​From Wikipedia, the free encyclopedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gVtfvi3fRIGt5txKSBIZFQxSk4k.jpg", url:"https://themoviedb.org/person/66554"}}, {tmdbId:"57093", properties:{bornIn:"Naples, Italy", imdbId:"0818880", born:date('1956-10-11'), name:"Stephen Spinella", bio:"From Wikipedia, the free encyclopedia\n\nStephen Nicholas Spinella (born 11 October 1956) is an American stage, television, and film actor. \n\nSpinella was born in Naples, Italy to a father who was an American naval airplane mechanic.  He grew up in Glendale, Arizona and graduated from the University of Arizona drama department...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lJahZcmWjggljySaqnPyGIuOeXs.jpg", url:"https://themoviedb.org/person/57093"}}, {tmdbId:"18284", properties:{bornIn:"Houston, Texas, USA", imdbId:"0222643", born:date('1949-08-21'), name:"Loretta Devine", bio:"Loretta Devine was born on August 21, 1949 in Houston, Texas.  She graduated from the University of Houston in 1971 with a Bachelor of Arts in Speech and Drama and BrandeisUniversity in 1976 with a MFA in Theater.  Devine is a member of The Epsilon Lambda Chapter of the Alpha Kappa Alpha Sorority.  She began her career on Broadway starring in Dreamgirls.  Minor roles for Devine followed in films such as Little Nikita (1988) and Stanley &amp; Iris (1990)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/29h4c21HpwHJk4q0kj7ymSflDnB.jpg", url:"https://themoviedb.org/person/18284"}}, {tmdbId:"51359", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0005375", born:date('1964-04-17'), name:"Lela Rochon", bio:"Lela Rochon (born Lela Rochon Staples; April 17, 1964) is an American actress who is best known for her role as Robin Stokes in the movie Waiting to Exhale. \n\nIn 1996, Lela was chosen by People (USA) magazine as one of the \"50 most beautiful people in the world\". \n\nDescription above from the Wikipedia article Lela Rochon, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9DBu3r5O4fBosSS4FnSzFCVpm0O.jpg", url:"https://themoviedb.org/person/51359"}}, {tmdbId:"37946", properties:{bornIn:"Rome, Lazio, Italy", imdbId:"0845209", born:date('1968-11-05'), name:"Aitana Sánchez-Gijón", bio:"From Wikipedia, the free encyclopedia\n\nAitana Sánchez-Gijón (born 5 November 1968 in Rome, Italy) is a Spanish-Italian film actress. \n\nBest known for playing dramatic roles in Spain, Sánchez-Gijón is known in the United States for her portrayal of Victoria Aragon, a pregnant and abandoned Mexican-American winegrower's daughter who is helped by travelling salesman Paul Sutton (Keanu Reeves) in A Walk in the Clouds (1995)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wh3P0RqrbWVRxTT3k1Sg4jXhC0Y.jpg", url:"https://themoviedb.org/person/37946"}}, {tmdbId:"95797", properties:{imdbId:"0842314", name:"Vonte Sweet", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v5sJKJVztgNEjz4yOCQYoAAz1pB.jpg", url:"https://themoviedb.org/person/95797"}}, {tmdbId:"59350", properties:{imdbId:"0320581", name:"Chaim Jeraffi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/odxOLYdm8mOihxpkWzNI1FMdU1I.jpg", url:"https://themoviedb.org/person/59350"}}, {tmdbId:"3432", properties:{bornIn:"New York City, New York, USA", imdbId:"0043173", born:date('1952-10-14'), name:"Rick Aviles", bio:"From Wikipedia, the free encyclopedia. \n\nRick Aviles (October 14, 1952 – March 17, 1995) was an American stand-up comedian and actor who is best remembered for the role of Willie Lopez in the movie Ghost. \n\nDescription above from the Wikipedia article Rick Aviles, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1995-03-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qskc5Iw2jsTLabdo81EfoJcciYy.jpg", url:"https://themoviedb.org/person/3432"}}, {tmdbId:"49832", properties:{bornIn:"Ogden - Utah - USA", imdbId:"0130107", name:"R.D. Call", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c1lpGYJgYwXLkmEFeRAJWNDuo5H.jpg", url:"https://themoviedb.org/person/49832"}}, {tmdbId:"33656", properties:{bornIn:"Oyster Bay, New York, USA", imdbId:"0000525", born:date('1982-11-10'), name:"Heather Matarazzo", bio:"From Wikipedia, the free encyclopedia\n\nHeather Amy Matarazzo (born November 10, 1982) is an American actress.  Her breakthrough role was as a geeky girl in the film Welcome to the Dollhouse (1995).  She played Lilly in The Princess Diaries (2001) and The Princess Diaries 2: Royal Engagement (2004).  Her other movies include The Devil's Advocate, Scream 3 (2000), Sorority Boys (2002), Saved! (2004), and Hostel: Part 2 (2007)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jCWbf8KtQb9SjXuq49VyEuyYMrU.jpg", url:"https://themoviedb.org/person/33656"}}, {tmdbId:"69482", properties:{imdbId:"1592211", name:"Victoria Davis", url:"https://themoviedb.org/person/69482"}}, {tmdbId:"69483", properties:{imdbId:"0115402", name:"Christina Brucato", bio:"Christina Brucato is an actress and producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5yNLxKg9o3791d72j8XhalawFyE.jpg", url:"https://themoviedb.org/person/69483"}}, {tmdbId:"54818", properties:{imdbId:"0124481", born:date('1968-06-27'), name:"Pascale Bussières", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vbfCShcj8n0eUOoKRCAGNh1auFY.jpg", url:"https://themoviedb.org/person/54818"}}, {tmdbId:"54819", properties:{bornIn:"\tToronto, Ontario, Canada", imdbId:"0006692", born:date('1969-01-01'), name:"Rachael Crawford", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vtZg6kT3EhbNH30dMcfedGaCn3I.jpg", url:"https://themoviedb.org/person/54819"}}, {tmdbId:"4569", properties:{bornIn:"Swastika, Ontario, Canada", imdbId:"0288944", born:date('1941-01-01'), name:"David Fox", bio:"David Fox (born 1941 in Swastika, Ontario) is a Canadian actor.  He is best known for his role as schoolteacher Clive Pettibone in Road to Avonlea, and for a variety of roles on television.  He also was the voice of Captain Haddock in The Adventures of Tintin. \n\nIn 1996 he was nominated for a Genie Award for the film When Night is Falling, and in 2008 he was nominated for a Gemini Award for the television miniseries Across the River to Motor City...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kgdBv3Pk68oolH0DA39rpmUai47.jpg", url:"https://themoviedb.org/person/4569"}}, {tmdbId:"121570", properties:{imdbId:"0520276", name:"Lopsang", url:"https://themoviedb.org/person/121570"}}, {tmdbId:"130262", properties:{imdbId:"0702639", name:"Zheng Qian", url:"https://themoviedb.org/person/130262"}}, {tmdbId:"130263", properties:{imdbId:"0304711", name:"Jie Gao", url:"https://themoviedb.org/person/130263"}}, {tmdbId:"150151", properties:{imdbId:"0944507", name:"Wang Xiaoxiao", url:"https://themoviedb.org/person/150151"}}, {tmdbId:"143358", properties:{bornIn:"Heze, Shandong, China", imdbId:"0508554", born:date('1954-07-07'), name:"Xuejian Li", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p756d1m8Dcek4OA83RVqiJOosTF.jpg", url:"https://themoviedb.org/person/143358"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"81023", properties:{imdbId:"0036653", name:"Tobias Arnold", url:"https://themoviedb.org/person/81023"}}, {tmdbId:"81024", properties:{bornIn:"Islington, London, England, UK", imdbId:"0516181", born:date('1944-02-08'), name:"Roger Lloyd Pack", bio:"Roger Lloyd-Pack was an English stage screen and television actor .  He attended Bedales School in Hampshire and went on to study at the Royal Academy of Dramatic Art (RADA) in London. \n\nHe is best known for his role as Colin \"Trigger\" Ball in the BBC Television sitcom \"Only Fools and Horses\" and later as Owen Newitt in \"The Vicar of Dibley\".  He later gained international fame through his role as Bartemius \"Barty\" Crouch Sr.  in \"Harry Potter and the Goblet of Fire\" in 2005...", died:date('2014-01-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iF9b0wRykPT5nFOImS1A5w8HJ3c.jpg", url:"https://themoviedb.org/person/81024"}}, {tmdbId:"52646", properties:{bornIn:"Minneapolis, Minnesota, USA", imdbId:"0440229", born:date('1979-05-05'), name:"Vincent Kartheiser", bio:"Vincent Paul Kartheiser (born May 5, 1979) is an American actor known for playing Connor on Angel and Pete Campbell on Mad Men...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n1kHTSY6cnM4mQXkWQV0jQQXglP.jpg", url:"https://themoviedb.org/person/52646"}}, {tmdbId:"58264", properties:{bornIn:"Helena, Montana, USA", imdbId:"0070767", born:date('1945-03-01'), name:"Dirk Benedict", bio:"From Wikipedia, the free encyclopedia\n\nDirk Benedict  (born Dirk Niewoehner; March 1, 1945) is an American movie, television and stage actor, perhaps best known for playing the characters Lieutenant Templeton \"Faceman\" Peck in The A-Team television series and Lieutenant Starbuck in the original Battlestar Galactica film and television series...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lQG0YpiHdhQgs5DKS0185JA60mr.jpg", url:"https://themoviedb.org/person/58264"}}, {tmdbId:"97881", properties:{bornIn:"Hamilton, Ontario, Canada", imdbId:"0028299", born:date('1964-01-01'), name:"Starr Andreeff", bio:"From Wikipedia, the free encyclopedia\n\nStarr Andreeff is a music manager and vice president of Maple Jam Music Group.  She was a film actress in the 80s and 90s.  Andreeff was born in Hamilton, Ontario to a police officer mother. \n\nDescription above from the Wikipedia article Starr Andreeff, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/142MfcecC07DtnfGVGSgWpCtjJV.jpg", url:"https://themoviedb.org/person/97881"}}, {tmdbId:"154492", properties:{bornIn:"Whittier, California, USA", imdbId:"0193896", name:"Allen Cutler", url:"https://themoviedb.org/person/154492"}}, {tmdbId:"114028", properties:{bornIn:"Travis County, Texas, USA", imdbId:"0242068", born:date('1985-04-07'), name:"Rachel Duncan", url:"https://themoviedb.org/person/114028"}}, {tmdbId:"31028", properties:{bornIn:"Bethesda, Maryland, USA", imdbId:"0771493", born:date('1955-05-27'), name:"Richard Schiff", bio:"Richard Schiff (born May 27, 1955) is an American actor.  He is best known for playing Toby Ziegler on the NBC television drama The West Wing, a role for which he received an Emmy Award.  Schiff made his directorial debut with The West Wing, directing an episode entitled \"Talking Points. \"\n\nDescription above from the Wikipedia article Richard Schiff, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cHYHhPvyznOJrw0yEqndhYK2GnQ.jpg", url:"https://themoviedb.org/person/31028"}}, {tmdbId:"65603", properties:{imdbId:"0788018", name:"Shane", url:"https://themoviedb.org/person/65603"}}, {tmdbId:"58406", properties:{bornIn:"\tToronto, Ontario, Canada", imdbId:"0688285", born:date('1934-07-26'), name:"Ken Pogue", died:date('2015-12-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gxDVKODaGCzt3wRebo6aMBTwdyk.jpg", url:"https://themoviedb.org/person/58406"}}, {tmdbId:"154608", properties:{imdbId:"0008894", name:"Amir Aboulela", url:"https://themoviedb.org/person/154608"}}, {tmdbId:"104645", properties:{bornIn:"U.S.A", imdbId:"0029025", born:date('1964-03-16'), name:"David Andriole", url:"https://themoviedb.org/person/104645"}}, {tmdbId:"2954", properties:{bornIn:"Washington, D.C., USA", imdbId:"0942482", born:date('1965-12-07'), name:"Jeffrey Wright", bio:"Jeffrey Wright (born December 7, 1965 in Washington, D. C. ) is an American actor.  He is best known for his Emmy and Golden Globe-winning role in the HBO miniseries Angels in America and his Tony Award winning role in the Broadway production of the same name.  He starred in The French Dispatch (2020), The Batman (2021), the James Bond films Casino Royale, Quantum of Solace and No Time to Die, and The Hunger Games films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/npJjOiFiAP4wiRDNjKsO8ho03Mg.jpg", url:"https://themoviedb.org/person/2954"}}, {tmdbId:"11059", properties:{bornIn:"Klein - Texas - USA", imdbId:"0005164", born:date('1957-11-01'), name:"Lyle Lovett", bio:"​From Wikipedia, the free encyclopedia\n\nLyle Pearce Lovett (born November 1, 1957) is an American singer-songwriter and actor.  Active since 1980, he has recorded thirteen albums and released 21 singles to date, including his highest entry, the #10 chart hit on the U. S.  Billboard Hot Country Songs chart, \"Cowboy Man\".  Lovett has won four Grammy Awards, including Best Male Country Vocal Performance and Best Country Album...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ppjDBst7wl05E08OfKen24XJSXd.jpg", url:"https://themoviedb.org/person/11059"}}, {tmdbId:"11315", properties:{bornIn:"New York City - New York - USA", imdbId:"0001187", born:date('1965-02-27'), name:"Noah Emmerich", bio:"From Wikipedia, the free encyclopedia. \n\nNoah Nicholas Emmerich (height 6' 3\" (1,91 m) born February 27, 1965) is an American film actor who first broke out in the film Beautiful Girls.  He was later seen in movies like The Truman Show, Cop Land, Frequency, Love &amp; Sex, Windtalkers, Miracle, and Little Children...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uhMuM8QhLqWoQVZBgUBM9QSitcK.jpg", url:"https://themoviedb.org/person/11315"}}, {tmdbId:"6975", properties:{bornIn:"Wolverhampton, Staffordshire, England, UK", imdbId:"0842934", born:date('1961-06-27'), name:"Meera Syal", bio:"From Wikipedia, the free encyclopedia. \n\nMeera Syal MBE (born Feeroza Syal on 27 June 1961) is a British comedienne, writer, playwright, singer, journalist, producer and actress.  She rose to prominence as one of the team that created Goodness Gracious Me and became one of the UK's best-known Indian personalities portraying Sanjeev's grandmother, Ummi, in The Kumars at No.  42...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xjndtTD7lIvuCSMtAYBQtTVwMGV.jpg", url:"https://themoviedb.org/person/6975"}}, {tmdbId:"1462325", properties:{name:"Martin Walsh", url:"https://themoviedb.org/person/1462325"}}, {tmdbId:"214356", properties:{imdbId:"0292069", name:"Andrew Fraser", url:"https://themoviedb.org/person/214356"}}, {tmdbId:"21063", properties:{bornIn:"New York City, New York, USA", imdbId:"0781899", born:date('1966-07-09'), name:"Pamela Adlon", bio:"Pamela Adlon (née Segall; born July 9, 1966) is an American actress, screenwriter, producer, and director.  She voiced Bobby Hill on the animated comedy series King of the Hill (1997–2010), for which she won a Primetime Emmy Award, Ashley Spinelli on the animated comedy series Recess (1997–2003), and the title character from the Pajama Sam video game series...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7PsF3jhObVSgNrWUWYNiOAFCoDX.jpg", url:"https://themoviedb.org/person/21063"}}, {tmdbId:"121955", properties:{imdbId:"0919733", name:"Julia Weldon", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iOyedb7HyupKxCTfZP4lSA18HDq.jpg", url:"https://themoviedb.org/person/121955"}}] AS row
