UNWIND [{tmdbId:"1895804", properties:{bornIn:"USA", born:date('1930-02-26'), name:"Wilda Taylor", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vwmIvQ6cGWAPRNicZHlgH5ox8T4.jpg", url:"https://themoviedb.org/person/1895804"}}, {tmdbId:"217924", properties:{bornIn:"Musashino, Tokyo Prefecture, Japan", imdbId:"0465631", born:date('1962-11-14'), name:"Satomi Kourogi", bio:"Satomi Kourogi is a Japanese voice actress affiliated with Production Baobab.  She uses the aliases Jun Asano, Rie Nakagi, Madoka Misono and Haruka Kawai for her work on adult content...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9pj1lKo1cBbJtt5VO1mLfMnL28J.jpg", url:"https://themoviedb.org/person/217924"}}, {tmdbId:"140173", properties:{bornIn:"Philadelphia, Pennsylvania, USA ", imdbId:"0121868", born:date('1940-03-21'), name:"Solomon Burke", bio:"Solomon Burke (March 21, 1940 – October 10, 2010) was an American recording artist and vocalist, who shaped the sound of rhythm and blues as one of the founding fathers of soul music in the 1960s and a \"key transitional figure in the development of soul music from rhythm and blues\" (Irwin Stambler 1974).  He had a string of hits including \"Cry to Me\", \"If You Need Me\", \"Got to Get You Off My Mind\", \"Down in the Valley\" and \"Everybody Needs Somebody to Love\"...", died:date('2010-10-10'), url:"https://themoviedb.org/person/140173"}}, {tmdbId:"73987", properties:{bornIn:"Phoenix, Arizona, USA", imdbId:"0326400", born:date('1909-01-02'), name:"Barry Goldwater", died:date('1998-05-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fqQGk4cAleWf53wqntZuZOEq5vn.jpg", url:"https://themoviedb.org/person/73987"}}, {tmdbId:"130517", properties:{imdbId:"0874696", name:"Angie Tsang Sze-Man", url:"https://themoviedb.org/person/130517"}}, {tmdbId:"16283", properties:{bornIn:"Seoul, South Korea", imdbId:"1165901", born:date('1968-08-18'), name:"Lee Seung-yeon", bio:"Lee Seung-yeon (이승연) is a South Korean actress and talk show host...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rbiGr6YyzKFfqTQxvzZYNFTUkl.jpg", url:"https://themoviedb.org/person/16283"}}, {tmdbId:"16286", properties:{imdbId:"1873389", name:"Choi Jeong-ho", url:"https://themoviedb.org/person/16286"}}, {tmdbId:"1088954", properties:{imdbId:"0842641", name:"Jack Swikert", url:"https://themoviedb.org/person/1088954"}}, {tmdbId:"939011", properties:{imdbId:"1933035", name:"John Beard", url:"https://themoviedb.org/person/939011"}}, {tmdbId:"939012", properties:{imdbId:"1928459", born:date('1957-12-24'), name:"Jim Chanos", url:"https://themoviedb.org/person/939012"}}, {tmdbId:"1485966", properties:{imdbId:"0901970", name:"Eve von Bibra", url:"https://themoviedb.org/person/1485966"}}, {tmdbId:"1485967", properties:{imdbId:"2304304", name:"Ronald Jacobson", url:"https://themoviedb.org/person/1485967"}}, {tmdbId:"58769", properties:{bornIn:"Washington, D.C., United States", imdbId:"0170306", born:date('1964-05-13'), name:"Stephen Colbert", bio:"From Wikipedia, the free encyclopedia. \n\nStephen Tyrone Colbert (born May 13, 1964) is an American political satirist, writer, comedian, television host, and actor.  He is the host of Comedy Central's The Colbert Report, a satirical news show in which Colbert portrays a caricatured version of conservative political pundits...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zQ6pvfqIqYiV4TB7lDoaJL52H93.jpg", url:"https://themoviedb.org/person/58769"}}, {tmdbId:"1431", properties:{bornIn:"Lewisham, London, England United Kingdom", imdbId:"0943827", born:date('1936-10-24'), name:"Bill Wyman", bio:"​From Wikipedia, the free encyclopedia.   \n\nBill Wyman (born William George Perks; 24 October 1936) is an English musician best known as the bass guitarist for the English rock and roll band The Rolling Stones from 1962 until 1992.  Since 1997, he has recorded and toured with his own band, Bill Wyman's Rhythm Kings.  He has worked producing both records and film, and has scored music for film in movies and television. \n\nWyman has kept a journal since he was a child after World War II...", url:"https://themoviedb.org/person/1431"}}, {tmdbId:"1194968", properties:{imdbId:"1834025", name:"Stacy Rock", bio:"Stacy is a singer/songwriter and actress often compared to Parker Posey, Tom Waits, Feist, Regina Spektor, Aimee Mann, Stevie Nicks and even Queen.  Simply put, she has a sound and style of her own.  A few of her theatrical acting credits include shows at Barrington Stage Company, North Shore Music Theater, The Voice of America Theater with Bill Pullman and Boston Playwrights Theater.  She studied acting at Boston University and the Royal Academy...", url:"https://themoviedb.org/person/1194968"}}, {tmdbId:"1315940", properties:{imdbId:"1957272", name:"Skei Saulnier", url:"https://themoviedb.org/person/1315940"}}, {tmdbId:"90778", properties:{bornIn:"Adelaide, South Australia, Australia", imdbId:"3100811", born:date('1985-01-22'), name:"Orianthi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4MGPiMfoTOwJlKzx4nG5n1Vul11.jpg", url:"https://themoviedb.org/person/90778"}}, {tmdbId:"1449376", properties:{imdbId:"1330594", name:"Dorian Holley", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kEEuW78PSqiUd3lK7pfsHBkJzsC.jpg", url:"https://themoviedb.org/person/1449376"}}, {tmdbId:"939135", properties:{imdbId:"1955957", born:date('1982-10-08'), name:"Park Hyo-ju", bio:"Park Hyo-joo (born October 8, 1982) is a South Korean actress.  She is best known for her leading role in the period police procedural Chosun Police Season 1 (also known as Byeolsungeom), as well as her supporting roles in the hit film Punch, and the television series Air City, Girl K, and The Chaser. \n\nTaken from Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8U7ISksUNkq5ovamagcVF7YeXBk.jpg", url:"https://themoviedb.org/person/939135"}}, {tmdbId:"1373446", properties:{name:"Avijit", url:"https://themoviedb.org/person/1373446"}}] AS row
