UNWIND [{tmdbId:"139862", properties:{bornIn:"Geneva, Switzerland", imdbId:"0605174", born:date('1965-12-10'), name:"Stephanie Morgenstern", bio:"Actress / Performer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gIwrOa9WshgcyV7nFKg5UfRKtlt.jpg", url:"https://themoviedb.org/person/139862"}}, {tmdbId:"224816", properties:{bornIn:"Montréal, Québec, Canada", imdbId:"0495501", born:date('1954-07-22'), name:"Pierre Lebeau", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8XikqPP6igd7UqOcz17B4edeTvh.jpg", url:"https://themoviedb.org/person/224816"}}, {tmdbId:"1412535", properties:{imdbId:"3069997", name:"Malice McMunn", url:"https://themoviedb.org/person/1412535"}}, {tmdbId:"8783", properties:{bornIn:"Melbourne, Australia", imdbId:"0051509", born:date('1968-08-09'), name:"Eric Bana", bio:"Eric Bana is an Australian film and television actor.  He began his career as a comedian in the sketch comedy series Full Frontal before gaining critical recognition in the biopic Chopper (2000)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j8tbvkg0kyCZihbwrUNRxwhqXXe.jpg", url:"https://themoviedb.org/person/8783"}}, {tmdbId:"57795", properties:{bornIn:" Australia", imdbId:"0275913", name:"David Field", bio:"From Wikipedia, the free encyclopedia. \n\nDavid Field is an Australian actor who has appeared on television and in films.  Some of the films he appeared in include Chopper, Two Hands and Gettin' Square.  His most notable roles are as Keithy in Chopper and as Acko in Two Hands.  In 2009, Field made his directorial debut with The Combination. \n\nDescription above from the Wikipedia article David Field, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aYtVOMnak4JmlLGw63lJObLf1J.jpg", url:"https://themoviedb.org/person/57795"}}, {tmdbId:"3062", properties:{bornIn:"Sydney, Australia.", imdbId:"0943814", born:date('1970-01-01'), name:"Dan Wyllie", url:"https://themoviedb.org/person/3062"}}, {tmdbId:"68987", properties:{bornIn:"Saiki, Ōita Prefecture, Japan", imdbId:"0847607", born:date('1964-01-04'), name:"Riki Takeuchi", bio:"Riki Takeuchi ((Japanese: 竹内 力 Hepburn: Takeuchi Riki, born January 4, 1964 in Saiki, Ōita Prefecture) is a Japanese actor and singer. \n\nTakeuchi has starred in many yakuza films and action films, such as Dead or Alive by Takashi Miike.  Takeuchi also starred in Battle Royale II: Requiem, where he played Riki Takeuchi...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3UQLs0K7eUxqYItgzxxYRnuryzX.jpg", url:"https://themoviedb.org/person/68987"}}, {tmdbId:"68988", properties:{bornIn:"Kagoshima, Japan", imdbId:"0014558", born:date('1961-05-24'), name:"Shô Aikawa", bio:"Show Aikawa (哀川 翔 Aikawa Shō, born 24 May 1961) is a Japanese actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yej2gv1vWNLxI23LnpgBL9kMozU.jpg", url:"https://themoviedb.org/person/68988"}}, {tmdbId:"63706", properties:{bornIn:"Shinagawa, Tokyo, Japan", born:date('1941-08-09'), name:"Renji Ishibashi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n3mXTldssi3Dm0H9cfYvrKpfE86.jpg", url:"https://themoviedb.org/person/63706"}}, {tmdbId:"68989", properties:{bornIn:"Tokyo - Japan", imdbId:"0654714", born:date('1962-06-19'), name:"Hitoshi Ozawa", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qWasfFsKvvnQUKO3j0C3QioZX6k.jpg", url:"https://themoviedb.org/person/68989"}}, {tmdbId:"1123230", properties:{imdbId:"1035186", name:"Martin Carney", url:"https://themoviedb.org/person/1123230"}}, {tmdbId:"536915", properties:{imdbId:"0382657", name:"Paul Hickey", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/79qDw915QIPjNoUoOBelO2X543y.jpg", url:"https://themoviedb.org/person/536915"}}, {tmdbId:"1123231", properties:{imdbId:"1036757", born:date('1974-12-30'), name:"Camille O'Sullivan", url:"https://themoviedb.org/person/1123231"}}, {tmdbId:"2037", properties:{bornIn:"Douglas, Cork, Ireland", imdbId:"0614165", born:date('1976-05-25'), name:"Cillian Murphy", bio:"Cillian Murphy is an Irish film and theatre actor.  He is often noted by critics for his chameleonic performances in diverse roles and distinctive blue eyes. \n\nA native of Cork, Murphy began his performing career as a rock musician.  After turning down a record deal, he made his professional acting debut in the play Disco Pigs in 1996...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iskfBLuf2nWvzqEFySrhGUAhGIG.jpg", url:"https://themoviedb.org/person/2037"}}, {tmdbId:"1169260", properties:{imdbId:"1028439", name:"Raffaella Bánsági", url:"https://themoviedb.org/person/1169260"}}, {tmdbId:"88961", properties:{bornIn:"Bellingham, Washington", imdbId:"0916491", born:date('1972-05-14'), name:"Ben Weber", bio:"Ben Weber (born May 14, 1972, in Bellingham, Washington) is an American film and television actor.  He has appeared in TV series including Sex and the City and in films such as Kissing Jessica Stein and Coach Carter.  Weber also played David on the ABC Family television series The Secret Life of the American Teenager along with Molly Ringwald.  In addition to film and television work, Weber was one of the original cavemen in the GEICO Cavemen advertising campaign...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mYfkIy5IJyoMDZ7R4UaeVYSZCIn.jpg", url:"https://themoviedb.org/person/88961"}}, {tmdbId:"18082", properties:{bornIn:"Honolulu, Hawaii, USA", imdbId:"0648249", born:date('1968-05-20'), name:"Timothy Olyphant", bio:"Timothy David Olyphant (born May 20, 1968) is an American actor whose notable roles in television drama series include Deadwood as Seth Bullock, Justified as Raylan Givens, and Damages as Wes Krulik.  He has also starred in the films Scream 2, Gone in 60 Seconds, Dreamcatcher, Live Free or Die Hard, A Perfect Getaway, The Crazies, and Hitman. \n\nDescription above from the Wikipedia article Timothy Olyphant, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sLdzLd3dREHS06a44do7vLorL4N.jpg", url:"https://themoviedb.org/person/18082"}}, {tmdbId:"2844", properties:{bornIn:"New York, New York", imdbId:"0569847", born:date('1969-06-11'), name:"Matt McGrath", bio:"From Wikipedia, the free encyclopedia. \n\nMatt McGrath (born June 11, 1969) is an American actor. \n\nMcGrath's film appearances include roles in The Notorious Bettie Page, Boys Don't Cry, The Broken Hearts Club: A Romantic Comedy, and The Impostors.  On television, McGrath has appeared in episodes of Law &amp; Order: Criminal Intent, Now and Again, and New York Undercover.  On Broadway, as a child, McGrath performed in Peter Pan and the original musical Working...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lYdLQvcAYb7PFu37RrjdLZjn49Y.jpg", url:"https://themoviedb.org/person/2844"}}, {tmdbId:"4988", properties:{bornIn:"Akasaka, Tokyo, Japan", imdbId:"0538580", born:date('1972-10-03'), name:"Claude Maki", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6maIeILZPP69khXWZgCpHOzPgzW.jpg", url:"https://themoviedb.org/person/4988"}}, {tmdbId:"4989", properties:{bornIn:"Nara, Japan", imdbId:"0441377", born:date('1963-04-27'), name:"Masaya Katô", bio:"From Wikipedia, the free encyclopedia\n\nMasaya Kato (born April 27, 1963) is a Japanese actor and seiyū from Nara in the Kansai region. \n\nDescription above from the Wikipedia article Masaya Kato,licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v6sPPPzB6rA35trGKltpmhOygqc.jpg", url:"https://themoviedb.org/person/4989"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"17121", properties:{bornIn:"Daegu, South Korea", imdbId:"0014227", born:date('1952-01-01'), name:"Sung-kee Ahn", bio:"Ahn Sung-ki (Hangul: 안성기; born January 1, 1952) is a South Korean actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1X0dJJd0yvR2YJfaIbPq1PDpQBJ.jpg", url:"https://themoviedb.org/person/17121"}}, {tmdbId:"16962", properties:{bornIn:"Yongsangu Seoul, Korea", imdbId:"0417520", born:date('1972-03-07'), name:"Dong-gun Jang", bio:"Jang Dong-gun (born March 7, 1972) is a South Korean actor and musician. \n\nDescription above from the Wikipedia article Jang Dong-gun, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kBh44FnsDzoqwgV8f8XBbQTgATr.jpg", url:"https://themoviedb.org/person/16962"}}, {tmdbId:"62333", properties:{bornIn:"Paju, Gyeonggi, South Korea", imdbId:"0158830", born:date('1975-06-11'), name:"Ji-Woo Choi", bio:"Choi Ji-woo (최지우), born Choi MI-hyang (최미향), is a South Korean actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ysPp0U285rWrCBlo0AfKFbpwoOH.jpg", url:"https://themoviedb.org/person/62333"}}, {tmdbId:"113391", properties:{bornIn:"Hải Phòng, Vietnam", imdbId:"0628930", born:date('1967-04-30'), name:"Quang Hai Ngo", url:"https://themoviedb.org/person/113391"}}, {tmdbId:"999736", properties:{imdbId:"0049099", name:"Bianca Hunter", url:"https://themoviedb.org/person/999736"}}, {tmdbId:"18472", properties:{bornIn:"The Bronx, New York, USA", imdbId:"0180984", born:date('1969-03-27'), name:"Kevin Corrigan", bio:"Kevin Fitzgerald Corrigan is an American actor.  He has appeared mostly in independent films and television since the 1990s, including the role of Uncle Eddie on the sitcom Grounded for Life.  His film appearances have included a supporting role in The Departed and co-starring roles in Big Fan and Results...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5IuVh4IYhnJmAX5jP3M00FinElG.jpg", url:"https://themoviedb.org/person/18472"}}, {tmdbId:"85484", properties:{bornIn:"Mount Kisco - New York - USA", imdbId:"0215682", born:date('1972-08-02'), name:"Matthew Del Negro", bio:"From Wikipedia, the free encyclopedia  Matthew Del Negro (born August 2, 1972) is an American actor. \n\nHe was born in Mount Kisco, New York as the youngest of three children.  He is a graduate of Boston College, where he played Division I lacrosse. \n\nAfter graduating, Del Negro began to study acting, and after  appearing in several minor commercials and independent films, he was  cast as Brian Cammarata on The Sopranos...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/h3wcgMRunRmeFhFo16BJpKsqQQC.jpg", url:"https://themoviedb.org/person/85484"}}, {tmdbId:"57674", properties:{bornIn:"Miami, Florida, USA", imdbId:"0891786", born:date('1988-08-27'), name:"Alexa PenaVega", bio:"Alexa Ellesse Pena-Vega (born August 27, 1988) is an American actress, singer and pianist.  She is best known for playing Carmen Cortez in Spy Kids film series and Shilo Wallace in the movie Repo! the Genetic Opera.  In 2009, she starred as the title character Ruby Gallagher in the ABC Family series Ruby & The Rockits. \n\nEarly life\n\nAlexa Vega was born in Miami, Florida.  Her father is Colombian and her mother, Gina Rue, is an American former model...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/11m8ff0YwS64Z04DJhupNQpwmCZ.jpg", url:"https://themoviedb.org/person/57674"}}, {tmdbId:"57675", properties:{bornIn:"Torrance, California, USA", imdbId:"0754512", born:date('1992-06-14'), name:"Daryl Sabara", bio:"Daryl Sabara (born June 14, 1992) is an American film and television actor, best known for playing Juni Cortez in the Spy Kids trilogy, as well as for a variety of television and film appearances, including Wizards of Waverly Place, Father of the Pride, The Polar Express, Keeping Up with the Steins, Halloween, and the reality show America's Most Talented Kids, on which he was a judge.  He is currently the lead actor in Cartoon Network's Generator Rex...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oiueNCmzxJXJdcKfjcZHY0tVMqe.jpg", url:"https://themoviedb.org/person/57675"}}, {tmdbId:"29697", properties:{imdbId:"0926205", name:"Nigel Whitmey", url:"https://themoviedb.org/person/29697"}}, {tmdbId:"1230749", properties:{imdbId:"0422514", name:"Robert Jezek", url:"https://themoviedb.org/person/1230749"}}, {tmdbId:"20667", properties:{bornIn:"Grenoble, France", imdbId:"0098793", born:date('1966-05-12'), name:"Sami Bouajila", bio:"Sami Bouajila (born in Grenoble, France on 12 May 1966) is a French award-winning actor of Tunisian origin.  Bouajila's grandfather was a Berber born in Tripoli, Libya and immigrated to Tunisia.  Bouajila's father decided to immigrate to France in 1956.  Sami was born and grew up in Échirolles, a suburb south of Grenoble.  He studied theater...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xq8TMMCA4RI2omGxbPtLVsBMWX8.jpg", url:"https://themoviedb.org/person/20667"}}, {tmdbId:"218502", properties:{imdbId:"0665213", born:date('1918-06-10'), name:"Patachou", died:date('2015-04-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4kQGlfuWviMcUTY2iPfMheH5xc5.jpg", url:"https://themoviedb.org/person/218502"}}, {tmdbId:"72590", properties:{bornIn:"Marseilles, France", imdbId:"0038449", born:date('1954-10-10'), name:"Ariane Ascaride", bio:"Ariane Ascaride (born 10 October 1954, Marseille is a French actress and screenwriter.  She has appeared in such films as Marius et Jeannette (Marius and Jeannette), Ma vraie vie à Rouen (The True Story of My Life in Rouen; USA, My Life on Ice) and À la place du coeur (Where the Heart Is).  She also starred in and co-wrote the screenplay for Le Voyage en Arménie (Armenia)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tBwt69J3EeSHUNYYtxbI0r40KoT.jpg", url:"https://themoviedb.org/person/72590"}}, {tmdbId:"21578", properties:{bornIn:"Ambert, Puy-de-Dôme, France", imdbId:"0707466", born:date('1958-02-09'), name:"Pierre-Loup Rajot", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bdPzeiMZGKfTCpDc2KtAvsyTxwa.jpg", url:"https://themoviedb.org/person/21578"}}, {tmdbId:"29382", properties:{bornIn:"Minneapolis, Minnesota, USA", imdbId:"0525855", born:date('1951-08-14'), name:"Carl Lumbly", bio:"Carl Lumbly is a Jamaican American theatre, television and film actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kJ6OPPGrWHZALsQcT8JZMQSiEbg.jpg", url:"https://themoviedb.org/person/29382"}}, {tmdbId:"59154", properties:{bornIn:"Pasadena - California - USA", imdbId:"0005067", born:date('1974-11-12'), name:"Tamala Jones", bio:"From Wikipedia, the free encyclopedia. \n\nTamala R.  Jones (born November 12, 1974, height 5' 5\" (1,65 m)) is an American actress.  She is best known for her roles in the movies Booty Call, The Wood, Kingdom Come, The Brothers, and Two Can Play That Game.  She currently stars on the ABC television show Castle as medical examiner Lanie Parish...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ygJISciCMS9apZBpIk44QR7JkrG.jpg", url:"https://themoviedb.org/person/59154"}}, {tmdbId:"83951", properties:{bornIn:"Prague, Czechoslovakia [now Czech Republic]", imdbId:"0956479", born:date('1961-10-16'), name:"Veronika Zilková", bio:"​From Wikipedia, the free encyclopedia.   \n\nVeronika Žilková (born 16 October 1961, Czech Republic), is a Czech actress.  She played the part of Božena Horáková in the 2000 Czech film, Little Otik also known as Otesánek.  In 1997 she received the Czech Lion Award as the best supporting actress for her role in Zapomenuté světlo (Forgotten Light). \n\nDescription above from the Wikipedia article Veronika Žilková, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bbKRV63vuoiRQJ7uDbQHSdBTG5b.jpg", url:"https://themoviedb.org/person/83951"}}, {tmdbId:"83952", properties:{bornIn:"Prague, Czechoslovakia (now Czech Republic)", imdbId:"0366779", born:date('1952-09-12'), name:"Jan Hartl", bio:"​From Wikipedia, the free encyclopedia.   \n\nJan Hartl (born 12 September 1952) is a Czech actor who played Karel Horák in the 2000 Czech film Little Otik also known as Otesánek.  He was born in Prague, Czech Republic.  Hartl is a member of the National Theatre in Prague. \n\nDescription above from the Wikipedia article Jan Hartl, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/83952"}}, {tmdbId:"83953", properties:{bornIn:"Prague, Czechoslovakia", imdbId:"0470999", born:date('1955-09-01'), name:"Jaroslava Kretschmerová", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1CWUBhEbDhubfksWSyBgNnCUrR8.jpg", url:"https://themoviedb.org/person/83953"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"83880", properties:{bornIn:"Plzen, Czechoslovakia [now Czech Republic]", imdbId:"0637288", born:date('1948-09-05'), name:"Pavel Nový", bio:"Pavel Nový was born on September 5, 1948 in Plzen, Czechoslovakia.  He is an actor and producer, known for Amadeus (1984), Greedy Guts (2000) and I Served the King of England (2006)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/it1n1QcNaiq1qNQyyjTt3lcxE34.jpg", url:"https://themoviedb.org/person/83880"}}, {tmdbId:"34627", properties:{bornIn:"Marrakech, Morocco", imdbId:"0268626", born:date('1968-12-20'), name:"Nadia Farès", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ldudiRbTPNmm3OJEOsBnL6McdvF.jpg", url:"https://themoviedb.org/person/34627"}}, {tmdbId:"151361", properties:{bornIn:"New Jersey, USA", imdbId:"0517064", born:date('1945-05-05'), name:"Kurt Loder", url:"https://themoviedb.org/person/151361"}}, {tmdbId:"943010", properties:{bornIn:"Pittsburgh, Pennsylvania, USA", imdbId:"0769086", born:date('1943-11-04'), name:"Chuck Scarborough", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fFgsWh5Eyq8FHUd3IGpvywU4U9i.jpg", url:"https://themoviedb.org/person/943010"}}, {tmdbId:"60205", properties:{bornIn:"Baltimore, Maryland, USA", imdbId:"0745232", born:date('1949-06-03'), name:"John Rothman", bio:"John Rothman is an actor and writer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/k7Vdn2eArkvYCJllIOGPIjK9umK.jpg", url:"https://themoviedb.org/person/60205"}}, {tmdbId:"89470", properties:{imdbId:"0094471", name:"Frank Bongiorno", url:"https://themoviedb.org/person/89470"}}, {tmdbId:"1187539", properties:{imdbId:"0818283", name:"Lexie Sperduto", url:"https://themoviedb.org/person/1187539"}}, {tmdbId:"18273", properties:{bornIn:"Minneapolis, Minnesota, USA", imdbId:"0794896", born:date('1971-07-25'), name:"Miriam Shor", bio:"From Wikipedia, the free encyclopedia\n\nMiriam Shor (born July 25, 1971) is an American film and television actress. \n\nDescription above from the Wikipedia article Miriam Shor, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tlljCmzRrb7nG60TThw0U8ItvbR.jpg", url:"https://themoviedb.org/person/18273"}}, {tmdbId:"111722", properties:{imdbId:"0819166", name:"Ankie Spitzer", url:"https://themoviedb.org/person/111722"}}, {tmdbId:"111723", properties:{imdbId:"0309101", name:"Jamal Al Gashey", url:"https://themoviedb.org/person/111723"}}, {tmdbId:"111724", properties:{imdbId:"0786821", name:"Gerald Seymour", url:"https://themoviedb.org/person/111724"}}, {tmdbId:"20051", properties:{bornIn:"Surrey, England, UK", imdbId:"0542635", born:date('1990-08-01'), name:"Alakina Mann", bio:"From Wikipedia, the free encyclopedia. \n\nAlakina Mann (born 1 August 1990) is an English actress.  She has had a few roles, such as playing Anne in The Others and also appeared in the 2003 movie Girl with a Pearl Earring as Cornelia Vermeer.  She also appeared in the television interpretation of Fungus the Bogeyman. \n\nDescription above from the Wikipedia article Alakina Mann, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zmbFBYQSzHUPfNTwzszpTeVhL7N.jpg", url:"https://themoviedb.org/person/20051"}}, {tmdbId:"19974", properties:{bornIn:"Houston, Texas, USA", imdbId:"0314524", born:date('1958-02-26'), name:"Greg Germann", bio:"From Wikipedia, the free encyclopedia\n\nGregory Andrew \"Greg\" Germann (born February 26, 1958) is an American actor.  He played the roles of Richard Fish in the television series Ally McBeal, businessman Mattson from Child's Play 2 and the vet Laurence from Quarantine.  He has also appeared in the Nickelodeon musical film Spectacular! and the Disney film Bolt...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cRLbrKwasOiBj68pORvrZTPHRfB.jpg", url:"https://themoviedb.org/person/19974"}}, {tmdbId:"57167", properties:{bornIn:"Cambridge - Massachusetts - USA", imdbId:"0122716", born:date('1954-10-15'), name:"Jere Burns", bio:"Jerald Eugene \"Jere\" Burns II  (born October 15, 1954) is an American actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ok265IAb5lNPmI3Ulb4KRC5nwjK.jpg", url:"https://themoviedb.org/person/57167"}}, {tmdbId:"32089", properties:{bornIn:"Paris, France, EU", imdbId:"0244850", born:date('1943-04-28'), name:"Jacques Dutronc", bio:"Jacques Dutronc (born 28 April 1943) is a French singer, songwriter, guitarist, composer, and actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AaiZPtmsdgbDkmyv3f2BCwT4eNg.jpg", url:"https://themoviedb.org/person/32089"}}, {tmdbId:"54327", properties:{bornIn:"Nantes, Loire-Atlantique, France", imdbId:"0609662", born:date('1978-04-26'), name:"Anna Mouglalis", bio:"Anna Mouglalis (born April 26, 1978) is a French actress. \n\nDescription above from the Wikipedia article Anna Mouglalis, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3bqjOld5Alyh3JFd6L53ZRLFVFj.jpg", url:"https://themoviedb.org/person/54327"}}, {tmdbId:"654", properties:{bornIn:"Clamart, Hauts-de-Seine, Île-de-France, France", imdbId:"0667416", born:date('1979-12-06'), name:"Rodolphe Pauly", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lJLx3MO5Zv2yI3ahETrIXNDFb8c.jpg", url:"https://themoviedb.org/person/654"}}, {tmdbId:"7248", properties:{bornIn:"Rotorua, Île du Nord, Nouvelle-Zélande", imdbId:"0193295", born:date('1968-07-27'), name:"Cliff Curtis", bio:"​From Wikipedia, the free encyclopedia. \n\nClifford Vivian Devon \"Cliff\" Curtis  (born 27 July 1968) is a New Zealand actor who has had major roles in film, including The Piano, Whale Rider, and Blow, and most recently has appeared in NBC's television series Trauma.  He is also co-owner of independent film production company Whenua Films.  Curtis, ethnically Māori, has on film portrayed a range of ethnicities, including Latin American and Arab characters...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x5RjyVJ4uGE7tVTWqcq8giIFtg1.jpg", url:"https://themoviedb.org/person/7248"}}, {tmdbId:"78589", properties:{bornIn:"San Diego, California, USA", imdbId:"0750412", born:date('1960-11-17'), name:"RuPaul", bio:"RuPaul (born as Andre Charles, November 17, 1960) is an American actor, drag queen, model, musician, author, television personality, and LGBTQ+ Icon...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c30bvYjCcBwggtrOrZaudXhVudt.jpg", url:"https://themoviedb.org/person/78589"}}, {tmdbId:"141291", properties:{bornIn:"International Falls, Minnesota, USA", imdbId:"0049176", born:date('1942-03-07'), name:"Tammy Faye Bakker", bio:"Tamara Faye \"Tammy\" Messner (née LaValley; March 7, 1942 – July 20, 2007), formerly Tammy Faye Bakker, was an American Christian singer, evangelist, entrepreneur, author, talk show host, and television personality. \n\nShe initially gained notice for her work with The PTL Club, a televangelist program she co-founded with her husband Jim Bakker in 1974...", died:date('2007-07-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eeYIdTCZfjgzssqbTjDPHfh18E6.jpg", url:"https://themoviedb.org/person/141291"}}] AS row
