UNWIND [{tmdbId:"19537", properties:{bornIn:"Rockwood, Tennessee, USA", imdbId:"1083271", born:date('1986-05-16'), name:"Megan Fox", bio:"Megan Denise Fox  (born May 16, 1986) is an American actress and model.  She began her acting career in 2001, with several minor television and film roles, and played a regular role on the Hope &amp; Faith television show.  In 2004, she made her film debut with a role in Confessions of a Teenage Drama Queen.  In 2007, she co-starred as Mikaela Banes, the love interest of Shia LaBeouf's character, in the blockbuster film, Transformers, which became her breakout role...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q9x5rq9rCO241EaKSbA19xPXcIG.jpg", url:"https://themoviedb.org/person/19537"}}, {tmdbId:"15086", properties:{bornIn:"Copenhagen, Denmark", imdbId:"0110334", born:date('1972-03-16'), name:"Nicolas Bro", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wZuHVrAh1Z4fbODAofnBoIWB2Tg.jpg", url:"https://themoviedb.org/person/15086"}}, {tmdbId:"21179", properties:{bornIn:"Plano, Texas, USA", imdbId:"0382632", born:date('1963-06-25'), name:"John Benjamin Hickey", bio:"John Benjamin Hickey is an American stage and screen actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qMoGF174ullGgmKTqqyrozpHJtu.jpg", url:"https://themoviedb.org/person/21179"}}, {tmdbId:"46092", properties:{bornIn:"The Bronx, New York, USA", imdbId:"0198790", born:date('1928-08-04'), name:"Gerard Damiano", bio:"Gerard Damiano was born on August 4, 1928 in The Bronx, New York City, New York, USA, died on October 25, 2008 (age 80) in Fort Myers, Florida, USA.  He was a actor, director and writer...", died:date('2008-10-25'), url:"https://themoviedb.org/person/46092"}}, {tmdbId:"92565", properties:{bornIn:"Lakeville, Kentucky, USA", imdbId:"0283658", born:date('1942-11-01'), name:"Larry Flynt", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mu37UCKMmUHtk1TJCST0NRaw92H.jpg", url:"https://themoviedb.org/person/92565"}}, {tmdbId:"132", properties:{imdbId:"0531924", name:"Scott MacDonald", bio:"From Wikipedia, the free encyclopedia.   Scott MacDonald (born 1959) is an American actor.  He is best known for his recurring roles as Captain Manning on short-lived series Threshold, Burley from HBO series Carnivàle, and as Commander Dolim from Star Trek: Enterprise, and as the title character from 1996 horror film Jack Frost. \n\nHe grew up in Libby, Montana and graduated from Washington State University and received an MFA in acting/theatre from the California Institute of the Arts...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pBXNUejSwDHfWCD9GgmvRbIPBdb.jpg", url:"https://themoviedb.org/person/132"}}, {tmdbId:"1862193", properties:{name:"David Kuhn", url:"https://themoviedb.org/person/1862193"}}, {tmdbId:"139137", properties:{imdbId:"0885900", born:date('1982-08-30'), name:"Alicia Van Couvering", url:"https://themoviedb.org/person/139137"}}, {tmdbId:"36634", properties:{imdbId:"0147814", born:date('1970-01-01'), name:"Julio Cedillo", bio:"Julio Cedillo is an actor and writer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aKyBRL6rbRJiKOyltw7IMwBBXQq.jpg", url:"https://themoviedb.org/person/36634"}}, {tmdbId:"20284", properties:{bornIn:"St. Helens, Merseyside, England, UK", imdbId:"0834282", born:date('1968-11-04'), name:"Gary Stretch", bio:"Gary Stretch (born in St.  Helens, Lancashire) is a British boxer, male model, and actor.  In 2004 Stretch was cast as psychotic gangster \"Sonny\" in Shane Meadows' gritty cult thriller Dead Man's Shoes (2004), for which Stretch received a BIFA nomination alongside fellow British actor Paddy Considine.  He went on to appear in the Oliver Stone film Alexander (2004).  Stretch also starred in the UK film Freebird in 2008, directed by Jon Ivay...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4J4nE44FVP6DMOKcDkWid5kWhO8.jpg", url:"https://themoviedb.org/person/20284"}}, {tmdbId:"20286", properties:{bornIn:"Pontefract, Yorkshire, England, UK", imdbId:"1527905", born:date('1982-07-09'), name:"Toby Kebbell", bio:"Tobias Alistair P.  \"Toby\" Kebbell (born 9 July 1982) is an English actor. \n\nDescription above from the Wikipedia Toby Kebbell, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mlYytYJvoEHmhDH2enLtES1098Q.jpg", url:"https://themoviedb.org/person/20286"}}, {tmdbId:"122995", properties:{imdbId:"0938176", born:date('1970-02-07'), name:"Stuart Wolfenden", url:"https://themoviedb.org/person/122995"}}, {tmdbId:"1372", properties:{bornIn:"Wellington, New Zealand", imdbId:"0881631", born:date('1972-06-07'), name:"Karl Urban", bio:"He is known for playing Éomer in the second and third installments of Peter Jackson's The Lord of the Rings trilogy, Dr.  Leonard \"Bones\" McCoy in the 2009 film Star Trek and Julius Caesar on Xena: Warrior Princess.  He played Vaako in The Chronicles of Riddick, the Russian assassin Kirill in The Bourne Supremacy, and Ghost in Pathfinder and won acclaim for his performances in New Zealand films The Price of Milk and Out of the Blue...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bsAnEFgVm5kn8DbBZKfnlLNll89.jpg", url:"https://themoviedb.org/person/1372"}}, {tmdbId:"58758", properties:{imdbId:"0649046", born:date('1971-01-01'), name:"Deobia Oparei", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kcw8vNMlYgK8peuN80zhX6TqeNk.jpg", url:"https://themoviedb.org/person/58758"}}, {tmdbId:"12801", properties:{bornIn:"London, England", imdbId:"0012398", born:date('1973-06-27'), name:"Razaaq Adoti", bio:"​From Wikipedia, the free encyclopedia.   \n\nRazaaq Adoti (born 27 June 1973) is a British actor, producer and screenwriter. \n\nDescription above from the Wikipedia article Razaaq Adoti, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bgN6Q0sMzAVLXvsU0CWFN8R42dG.jpg", url:"https://themoviedb.org/person/12801"}}, {tmdbId:"1052900", properties:{bornIn:"Winnipeg, Manitoba, Canada", born:date('1975-01-21'), name:"Paul Anthony", bio:"Paul Anthony is the inaugural recipient of the BC Entertainment Hall of Fame for most promising newcomer and has been lauded by both the Vancouver Sun and the Georgia Straight as the up-and-comer to watch.  His acting career finds its roots in theatre, having performed all over the country with such respected companies as The Vancouver Playhouse, The Arts Club, Prairie Theatre Exchange, The Belfry Theatre and MTYP...", url:"https://themoviedb.org/person/1052900"}}, {tmdbId:"59311", properties:{bornIn:"Vancouver, British Columbia, Canada", imdbId:"0383926", born:date('1978-01-24'), name:"Mark Hildreth", bio:"Mark Hildreth is a Canadian stage, film and television actor and musician.  He's a graduate of The National Theater School of Canada, Montreal, Quebec...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pHkXbCjIPbUSeOZLV3z6dnj8WVB.jpg", url:"https://themoviedb.org/person/59311"}}, {tmdbId:"86434", properties:{bornIn:"Troy, New York, U.S.", imdbId:"0016085", born:date('1952-04-17'), name:"Joe Alaskey", bio:"From Wikipedia, the free encyclopedia. \n\nJoseph Francis Alaskey III (April 17, 1952 – February 3, 2016) was an American stand-up comedian, actor, voice artist, and impressionist. \n\nDescription above from the Wikipedia article Joe Alaskey, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2016-02-03'), url:"https://themoviedb.org/person/86434"}}, {tmdbId:"170364", properties:{imdbId:"1166844", born:date('1968-11-10'), name:"Tom Papa", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fMIsoDKnpPJg7auaVYbGVZwdJD9.jpg", url:"https://themoviedb.org/person/170364"}}, {tmdbId:"60741", properties:{bornIn:"New York City, New York, USA", imdbId:"0934589", born:date('1960-01-04'), name:"April Winchell", bio:"April Terri Winchell (born January 4, 1960) is an American actress, voice actress, writer, talk radio host and commentator.  She is best known as the official voice of Clarabelle Cow in the Disney franchise since 1996...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aRIUYseEeOSfI7a4EqPbKIyPR1o.jpg", url:"https://themoviedb.org/person/60741"}}] AS row
