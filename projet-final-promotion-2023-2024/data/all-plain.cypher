UNWIND [{movieId:"44004", properties:{languages:["English"], year:2006, imdbId:"0427229", runtime:97, imdbRating:5.6, countries:["USA"], imdbVotes:56488, title:"Failure to Launch", url:"https://themoviedb.org/movie/6877", revenue:128406887, tmdbId:"6877", plot:"A thirtysomething slacker suspects his parents of setting him up with his dream girl so he'll finally vacate their home.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wQrNTe7VDytVDet9Jus6RDKEPYZ.jpg", released:"2006-03-10", budget:50000000}}, {movieId:"44022", properties:{languages:["English"], year:2006, imdbId:"0438097", runtime:91, imdbRating:6.9, countries:["USA"], imdbVotes:185382, title:"Ice Age 2: The Meltdown", url:"https://themoviedb.org/movie/950", revenue:660998756, tmdbId:"950", plot:"Manny, Sid, and Diego discover that the ice age is coming to an end, and join everybody for a journey to higher ground. On the trip, they discover that Manny, in fact, is not the last of the woolly mammoths.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eYff7CWPMCKhIGTos2SzTd3VFbA.jpg", released:"2006-03-31", budget:80000000}}, {movieId:"44073", properties:{languages:["Italian", " English", " Spanish", " German", " French"], year:1950, imdbId:"0041931", runtime:81, imdbRating:7.3, countries:["Italy", " USA"], imdbVotes:3724, title:"Stromboli", url:"https://themoviedb.org/movie/4173", tmdbId:"4173", plot:"Karen, a young woman from the Baltic countries, marries fisherman Antonio to escape from a prisoners camp. But the life in Antonio's village, Stromboli, threatened by the volcano, is a tough one and Karen cannot get used to it.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qG1rqngu5E2ytnbT8X2oMeyBCq3.jpg", released:"1950-02-15"}}, {movieId:"44191", properties:{languages:["English"], year:2005, imdbId:"0434409", runtime:132, imdbRating:8.2, countries:["USA", " UK", " Germany"], imdbVotes:760039, title:"V for Vendetta", url:"https://themoviedb.org/movie/752", revenue:132511035, tmdbId:"752", plot:"In a future British tyranny, a shadowy freedom fighter, known only by the alias of V, plots to overthrow it with the help of a young woman.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2ySXWBckQboalTZjhaLWRqc3gCN.jpg", released:"2006-03-17", budget:54000000}}, {movieId:"44193", properties:{languages:["English"], year:2006, imdbId:"0454945", runtime:105, imdbRating:6.4, countries:["USA", " Canada"], imdbVotes:111722, title:"She's the Man", url:"https://themoviedb.org/movie/9655", revenue:33889159, tmdbId:"9655", plot:"When her brother decides to ditch for a couple weeks in London, Viola heads over to his elite boarding school, disguises herself as him, and proceeds to fall for one of her soccer teammates. Little does she realize she's not the only one with romantic troubles, as she, as he, gets in the middle of a series of intermingled love affairs.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6NIvKonJblEaR6jD1BA6bsY0fXV.jpg", released:"2006-03-17", budget:20000000}}, {movieId:"44195", properties:{languages:["English"], year:2005, imdbId:"0427944", runtime:92, imdbRating:7.6, countries:["USA"], imdbVotes:189458, title:"Thank You for Smoking", url:"https://themoviedb.org/movie/9388", revenue:24793509, tmdbId:"9388", plot:"Satirical comedy follows the machinations of Big Tobacco's chief spokesman, Nick Naylor, who spins on behalf of cigarettes while trying to remain a role model for his twelve-year-old son.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xIlQYkRjpGBMXDkZoS3IRcckScA.jpg", released:"2006-04-14", budget:6500000}}, {movieId:"44197", properties:{languages:["English"], year:2006, imdbId:"0419749", runtime:125, imdbRating:7.1, countries:["Germany", " USA"], imdbVotes:27416, title:"Find Me Guilty", url:"https://themoviedb.org/movie/9950", revenue:2636637, tmdbId:"9950", plot:"Based on the true story of Jack DiNorscio, a mobster who defended himself in court for what would be the longest mafia trial in U.S. history.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8M0dkX7jOor7exKor1txoUl9Ynu.jpg", released:"2006-03-17", budget:13000000}}, {movieId:"44199", properties:{languages:["English", " Albanian", " Spanish"], year:2006, imdbId:"0454848", runtime:129, imdbRating:7.6, countries:["USA"], imdbVotes:265506, title:"Inside Man", url:"https://themoviedb.org/movie/388", revenue:186003591, tmdbId:"388", plot:"A police detective, a bank robber, and a high-power broker enter high-stakes negotiations after the criminal's brilliant heist spirals into a hostage situation.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mf4i9zZVXMmqWsEb9D0OAY7k3t.jpg", released:"2006-03-24", budget:45000000}}, {movieId:"44204", properties:{languages:["Zulu", " Xhosa", " Afrikaans", " English"], year:2005, imdbId:"0468565", runtime:94, imdbRating:7.3, countries:["UK", " South Africa"], imdbVotes:24656, title:"Tsotsi", url:"https://themoviedb.org/movie/868", revenue:9879971, tmdbId:"868", plot:"Six days in the violent life of a young Johannesburg gang leader.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fvPGF7NYuZJACYVRAAF3FXicVf0.jpg", released:"2006-03-31", budget:3000000}}, {movieId:"44225", properties:{languages:["English"], year:2006, imdbId:"0429591", runtime:104, imdbRating:5.3, countries:["USA", " Australia"], imdbVotes:29167, title:"Aquamarine", url:"https://themoviedb.org/movie/14191", revenue:23006849, tmdbId:"14191", plot:"Two teenage girls discover a mermaid in their beach club's swimming pool.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qHm6bptr0jD7RN1gCdRuZCT6Zz7.jpg", released:"2006-03-03", budget:12000000}}, {movieId:"44245", properties:{languages:["English"], year:2000, imdbId:"0209095", runtime:90, imdbRating:3.6, countries:["USA"], imdbVotes:4331, title:"Leprechaun in the Hood", url:"https://themoviedb.org/movie/18011", tmdbId:"18011", plot:"When three rappers want to get even with a pimp, they accidentally unleash a leprechaun who goes on a killing rampage in the 'hood.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lCRwtuxnJWkZ04gwtfYF9h1GUkl.jpg", released:"2000-03-28"}}, {movieId:"44301", properties:{languages:["Finnish", " Russian"], year:2006, imdbId:"0458242", runtime:78, imdbRating:6.9, countries:["Finland", " Germany", " France"], imdbVotes:4875, title:"Lights in the Dusk (Laitakaupungin valot)", url:"https://themoviedb.org/movie/1379", revenue:1615018, tmdbId:"1379", plot:"In Helsinki, a lonely night watchman is caught up in a series of misadventures with a femme fatale and a crooked businessman.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qLs0LoxaQIfwIGsA3ZRZYSzfYkA.jpg", released:"2006-02-03", budget:1380000}}, {movieId:"44317", properties:{languages:["Finnish", " German", " Swedish"], year:1995, imdbId:"0113580", runtime:90, imdbRating:7.1, countries:["Finland"], imdbVotes:1754, title:"Kummeli Stories", url:"https://themoviedb.org/movie/62719", tmdbId:"62719", plot:"The war between Luxembourg and Finland sets the outline to a set of comedic stories about a rally team, gay couple's fishing trip, two hoodlums' last school days in the spring and a haunted hotel among others.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hvz7tL9PTRI082nE5TWfIZr4NC5.jpg", released:"1995-10-20"}}, {movieId:"44397", properties:{languages:["English"], year:2006, imdbId:"0454841", runtime:107, imdbRating:6.4, countries:["USA", " France"], imdbVotes:126256, title:"Hills Have Eyes, The", url:"https://themoviedb.org/movie/9792", revenue:69623713, tmdbId:"9792", plot:"A suburban American family is being stalked by a group of psychotic people who live in the desert, far away from civilization.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qj4C2c96T1n3YnYxFG5l5bSTKbM.jpg", released:"2006-03-10", budget:15000000}}, {movieId:"44421", properties:{languages:["English"], year:1995, imdbId:"0112120", runtime:225, imdbRating:8.6, countries:["USA", " UK", " France"], imdbVotes:3663, title:"Personal Journey with Martin Scorsese Through American Movies, A", url:"https://themoviedb.org/movie/55676", tmdbId:"55676", plot:"Martin Scorsese describes his initial and growing obsession with films from the 1940s and 50s as the art form developed and grew with clips from classics and cult classics.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8yLgV0zrd7u4c4dGqHvRP9MqvSL.jpg", released:"1995-05-21"}}, {movieId:"44511", properties:{languages:["English"], year:2005, imdbId:"0436864", runtime:88, imdbRating:6.6, countries:["USA", " UK"], imdbVotes:966, title:"Unknown White Male", url:"https://themoviedb.org/movie/35555", tmdbId:"35555", plot:"The true story of Doug Bruce who woke up on Coney Island with total amnesia. This documentary follows him as he rediscovers himself and the world around him.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hsFJ2DACY37jwb2huAvyQ9BFVj4.jpg", released:"2005-01-01"}}, {movieId:"44555", properties:{languages:["German"], year:2006, imdbId:"0405094", runtime:137, imdbRating:8.5, countries:["Germany"], imdbVotes:249352, title:"Lives of Others, The (Das leben der Anderen)", url:"https://themoviedb.org/movie/582", revenue:70000000, tmdbId:"582", plot:"In 1984 East Berlin, an agent of the secret police, conducting surveillance on a writer and his lover, finds himself becoming increasingly absorbed by their lives.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5BCyeLJHPcRwhu0YaRqUzw00JJ4.jpg", released:"2007-03-30", budget:2000000}}, {movieId:"44587", properties:{year:1922, imdbId:"0013427", runtime:79, imdbRating:7.8, countries:["USA", " France"], imdbVotes:7349, title:"Nanook of the North", url:"https://themoviedb.org/movie/669", tmdbId:"669", plot:"In this silent predecessor to the modern documentary, film-maker Robert J. Flaherty spends one year following the lives of Nanook and his family, Inuit living in the Arctic Circle.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9WAboi1QbKu41WkyGxQVNpXwwxx.jpg", released:"1922-06-11", budget:53000}}, {movieId:"44597", properties:{languages:["Japanese"], year:1963, imdbId:"0057697", runtime:92, imdbRating:7.6, countries:["Japan"], imdbVotes:2003, title:"Youth of the Beast (Yaju no seishun)", url:"https://themoviedb.org/movie/37939", tmdbId:"37939", plot:"A violent thug plays opposing yakuza bosses against each other.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dWHa0JT3Syj6WbiwpXBbZMHoKEv.jpg", released:"1963-04-21"}}, {movieId:"44613", properties:{languages:["English"], year:2006, imdbId:"0446046", runtime:118, imdbRating:6.7, countries:["USA"], imdbVotes:21257, title:"Take the Lead", url:"https://themoviedb.org/movie/12763", revenue:65742992, tmdbId:"12763", plot:"The real story of a dance teacher who believed in the talent of a group of problem kids.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vkGSs0eeOOISEe9jddBZnRSkn46.jpg", released:"2006-04-07", budget:30000000}}] AS row
