ties:{languages:["English", " Aboriginal", " Chinese", " Japanese"], year:2008, imdbId:"0455824", runtime:165, imdbRating:6.6, countries:["Australia", " USA", " UK"], imdbVotes:100090, title:"Australia", url:"https://themoviedb.org/movie/6972", revenue:49554002, tmdbId:"6972", plot:"Set in northern Australia before World War II, an English aristocrat who inherits a sprawling ranch reluctantly pacts with a stock-man in order to protect her new property from a takeover plot. As the pair drive 2,000 head of cattle over unforgiving landscape, they experience the bombing of Darwin, Australia, by Japanese forces firsthand.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/45X7LFsgYvdEgFCkXSZCQOZMuJX.jpg", released:"2008-11-26", budget:130000000}}, {movieId:"63859", properties:{languages:["English"], year:2008, imdbId:"0397892", runtime:96, imdbRating:6.9, countries:["USA"], imdbVotes:141288, title:"Bolt", url:"https://themoviedb.org/movie/13053", revenue:309979994, tmdbId:"13053", plot:"The canine star of a fictional sci-fi/action show that believes his powers are real embarks on a cross country trek to save his co-star from a threat he believes is just as real.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z9VHoUcZ1GiH3f3qYz7Me7Zc1Fd.jpg", released:"2008-11-21", budget:150000000}}, {movieId:"63876", properties:{languages:["English"], year:2008, imdbId:"1013753", runtime:128, imdbRating:7.6, countries:["USA"], imdbVotes:133340, title:"Milk", url:"https://themoviedb.org/movie/10139", revenue:54586584, tmdbId:"10139", plot:"The story of Harvey Milk, and his struggles as an American gay activist who fought for gay rights and became California's first openly gay elected official.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cZ0jH8vlJwipPcAh30siwhMKUAX.jpg", released:"2009-01-30", budget:20000000}}, {movieId:"63992", properties:{languages:["English"], year:2008, imdbId:"1099212", runtime:122, imdbRating:5.2, countries:["USA"], imdbVotes:339646, title