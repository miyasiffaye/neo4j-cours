p/w440_and_h660_face/8GC3u2R3yVMH2WYm5z8CpL4hHOc.jpg", url:"https://themoviedb.org/person/123758"}}, {tmdbId:"21530", properties:{bornIn:"Indianapolis, Indiana, USA", imdbId:"0123733", born:date('1970-06-28'), name:"Steve Burton", bio:"​From Wikipedia, the free encyclopedia. \n\nJack Stephen \"Steve\" Burton (born June 28, 1970) is an American actor who played Jason Morgan on General Hospital from 1991 to 2000 and subsequently from 2002 to present.  He also voiced the character of Cloud Strife in a wide range of Square Enix products, including Final Fantasy VII: Advent Children and the Kingdom Hearts series...", url:"https://themoviedb.org/person/21530"}}, {tmdbId:"1169047", properties:{imdbId:"0175185", name:"Tim Conner", url:"https://themoviedb.org/person/1169047"}}, {tmdbId:"1274814", properties:{imdbId:"1275216", name:"Johnny Counterfit", url:"https://themoviedb.org/person/1274814"}}, {tmdbId:"261500", properties:{imdbId:"0500542", name:"Dan Leis", url:"https://themoviedb.org/person/261500"}}, {tmdbId:"67843", properties:{imdbId:"0011154", name:"Lloyd Adams", url:"https://themoviedb.org/person/67843"}}, {tmdbId:"177063", properties:{name:"Jason Andrews", url:"https://themoviedb.org/person/177063"}}, {tmdbId:"79025", properties:{bornIn:"San Diego - California - USA", imdbId:"0573134", born:date('1959-11-08'), name:"Don McManus", bio:"Don McManus is an actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ilHsejG5ZbqCJRonmgZGzacx5LS.jpg", url:"https://themoviedb.org/person/79025"}}, {tmdbId:"33655", properties:{bornIn:"Winslow, Arizona, USA", imdbId:"0004697", born:date('1969-11-19'), name:"Erika Alexander", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mJ69h29gpzkNjXPcjNtPxTI5iJy.jpg", url:"https://themoviedb.org/person/33655"}}, {tmdbId:"75696", properties:{bornIn:"New York City, New York, USA", imdbId:"0211726", born:date('1967-09-25'), name:"Melissa De Sousa", bio:"Melissa De Sousa is an actress and executive...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/soXz99fylvXejruaOEmqyLGqaud.jpg", url:"https://themoviedb.org/person/75696"}}, {tmdbId:"56903", properties:{bornIn:"The Bronx, New York City, New York, USA", imdbId:"0605079", born:date('1968-11-10'), name:"Tracy Morgan", bio:"​American actor, comedian and author Tracy Jamal Morgan is best known for his eight seasons as a cast member on Saturday Night Live and currently known for playing the role of Tracy Jordan on the NBC series 30 Rock. \n\nMorgan began his career on Martin, where he played Hustle Man.  In the 2003 Chris Rock film Head of State, Morgan appeared as a man watching television, often questioning why they are not watching Martin...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v7l37yzapiVav6dAUxnYseu9tZq.jpg", url:"https://themoviedb.org/person/56903"}}, {tmdbId:"94476", properties:{bornIn:"St. Louis, Missouri, USA", imdbId:"0011758", born:date('1975-02-26'), name:"Tunde Adebimpe", bio:"​From Wikipedia, the free encyclopedia.   \n\nBabatunde \"Tunde\" Adebimpe (born 1975) is an American musician, actor, and director best known as the lead singer of the Brooklyn-based band TV on the Radio.  His vocal method often involves improvisation, the use of effects and repeating sampled loops. \n\nDescription above from the Wikipedia article Tunde Adebimpe, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/94476"}}, {tmdbId:"12110", properties:{bornIn:"Endicott, New York, États-Unis", imdbId:"0781238", born:date('1961-03-29'), name:"Amy Sedaris", bio:"Amy Louise Sedaris is an American actress, author, and comedian.  She is known for playing the character Jerri Blank in the Comedy Central television series Strangers with Candy.  Sedaris regularly collaborates with her older brother, humorist and author David Sedaris...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AjVjRYI1PaC11i4FqGSK1TkwOmq.jpg", url:"https://themoviedb.org/person/12110"}}, {tmdbId:"62760", properties:{bornIn:"Brooklyn, New York City, New York, USA", imdbId:"0340720", born:date('1988-11-15'), name:"Zena Grey", bio:"From Wikipedia, the free encyclopedia\n\nZena Lotus Grey (born November 15, 1988) is an American actress.  She is known for her roles in the Hollywood films Snow Day, Max Keeble's Big Move, and The Shaggy Dog. \n\nGrey was born in New York, the daughter of artists Allyson (born Rymland) and Alex Grey.  Her first role was in the Broadway play The Herbal Bed.  In 1999, she had a role in The Bone Collector, before starring in Snow Day (2000) and Max Keeble's Big Move (2001)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/SBW956hHZzP401zqD2sum4RDpe.jpg", url:"https://themoviedb.org/person/62760"}}, {tmdbId:"3492", properties:{bornIn:"Sacramento, California, USA", imdbId:"0004988", born:date('1977-11-24'), name:"Colin Hanks", bio:"Colin Lewes Hanks (born November 24, 1977) is an American actor who is best known for his work as Jack Bailey in the series The Good Guys and as Alex Whitman in Roswell. \n\nDescription above from the Wikipedia article Colin Hanks, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xe44rLf5CbEY0ovNaOD0RIy5VCJ.jpg", url:"https://themoviedb.org/person/3492"}}, {tmdbId:"68178", properties:{bornIn:"Portland, Oregon, U.S.", imdbId:"0365501", born:date('1982-04-06'), name:"Bret Harrison", bio:"Bret Michael Harrison (born April 6, 1982) is an American actor and singer known predominantly for his work on comedy-dramas such as Reaper and The Loop.  He also was a co-star in the show Grounded for Life, that ran for five years.  He also played Dr.  Sidney Miller on ABC's V and Cameron Price on Fox's Breaking In. \n\nDescription above from the Wikipedia article Bret Harrison, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eRowiFEfgZZjDDeAQZk4SxQceM2.jpg", url:"https://themoviedb.org/person/68178"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"19117", properties:{bornIn:"Puteaux, Seine [now Hauts-de-Seine], France", imdbId:"0222922", born:date('1964-05-10'), name:"Emmanuelle Devos", bio:"From Wikipedia, the free encyclopedia\n\nEmmanuelle Devos (born May 10, 1964) is a French actress.  Devos was born to daughter of actress Marie Henriau in Paris.  She appeared in 50 films between 1986 and 2009.  She won the César Award for Best Actress in 2002 for her performance in Sur mes lèvres, directed by Jacques Audiard.  Also she has been nominated further three times...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bX1l2sTxoXVMRBky7rfD3lVEHud.jpg", url:"https://themoviedb.org/person/19117"}}, {tmdbId:"48405", properties:{imdbId:"0674702", born:date('1940-09-15'), name:"Olivier Perrier", url:"https://themoviedb.org/person/48405"}}, {tmdbId:"47931", properties:{bornIn:"Beira, Mozambique", imdbId:"0212046", born:date('1966-08-15'), name:"Tasha de Vasconcelos", bio:"​From Wikipedia, the free encyclopedia.   \n\nTasha de Vasconcelos (born 1966 in Beira) is a Mozambiquan - Canadian model, occasional actress and humanitarian.  Her father is of Portuguese descent and her mother of British origin.  She is a noted humanitarian, working for the Nelson Mandela Children's Fund in South Africa, as a Goodwill Volunteer for UNICEF in Bolivia and Algeria and with UNAIDS in Mozambique as Special Campaigner for Children...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z8ciRWUSnzWdeV6zglkMuXd0IQl.jpg", url:"https://themoviedb.org/person/47931"}}, {tmdbId:"18025", properties:{bornIn:"London, England, UK", imdbId:"0587950", born:date('1966-02-24'), name:"Ben Miller", bio:"​From Wikipedia, the free encyclopedia\n\nBennet Evan \"Ben\" Miller (born 24 February 1966) is an English comedian, director and actor. \n\nDescription above from the Wikipedia article Ben Miller, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qbhIwy1K5xRDpLG779kAnLLfH9C.jpg", url:"https://themoviedb.org/person/18025"}}, {tmdbId:"16700", properties:{bornIn:"Newcastle upon Tyne, England, UK", imdbId:"0936353", born:date('1966-05-15'), name:"Greg Wise", bio:"​From Wikipedia, the free encyclopedia.   \n\nGreg Wise (born 15 May 1966) is an English actor.  He has appeared in many British television works, as well as several feature films (notably the role of John Willoughby in Sense and Sensibility). \n\nDescription above from the Wikipedia article Greg Wise, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2Cs0wVg2TAhyKJyz835UsFwMLFU.jpg", url:"https://themoviedb.org/person/16700"}}, {tmdbId:"7321", properties:{bornIn:"Salford, Lancashire, England", imdbId:"0861027", born:date('1969-04-02'), name:"John Thomson", bio:"From Wikipedia, the free encyclopedia. \n\nJohn Patrick Thomson (born Patrick Francis McAleer on 2 April 1969) is an English comedian and actor, known for his roles in The Fast Show and Cold Feet. \n\nDescription above from the Wikipedia article John Thomson (comedian), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p7oShR4yImaPszUh3ywnJEu5a5.jpg", url:"https://themoviedb.org/person/7321"}}, {tmdbId:"311811", properties:{imdbId:"0691586", name:"Paul Popplewell", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2rhOBTlnbG9gJVqq0EJnz2hHfCQ.jpg", url:"https://themoviedb.org/person/311811"}}, {tmdbId:"231273", properties:{imdbId:"0734421", born:date('1974-05-15'), name:"Jay Rodan", url:"https://themoviedb.org/person/231273"}}, {tmdbId:"111946", properties:{bornIn:"McComb, Mississippi, United States", imdbId:"0005453", born:date('1981-12-02'), name:"Britney Spears", bio:"From Wikipedia, the free encyclopedia\n\nBritney Jean Spears (born December 2, 1981) is an American singer, songwriter, dancer, and actress.  Spears is regarded as a pop icon and is credited with influencing the revival of teen pop during the late 1990s and early 2000s, for which she is referred to as the \"Princess of Pop\". \n\nBorn in McComb, Mississippi and raised in Kentwood, Louisiana, she appeared in stage productions and television series, before signing with Jive Records in 1997...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/A7ein9URdmD0D6RSZF3gEkP6qfR.jpg", url:"https://themoviedb.org/person/111946"}}, {tmdbId:"56675", properties:{bornIn:"Mount Prospect, Illinois, USA", imdbId:"0609845", born:date('1973-02-25'), name:"Anson Mount", bio:"Anson Adams Mount IV (born February 25, 1973) is an American actor who has appeared in both movies and television shows.  Mount has also played Jim Steele on the short-lived NBC series Conviction and appeared in the independent movie Tully with Julianne Nicholson, as the title character Tully Coates, a playboy whose ways are changed when he meets Ella Smalley (Nicholson), a friend of his brother. \n\nMount is from the small town of White Bluff, Tennessee...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/psNMgfS7ejXnzkjdHyXcGPow9Wu.jpg", url:"https://themoviedb.org/person/56675"}}, {tmdbId:"8691", properties:{bornIn:"Passaic, New Jersey, USA", imdbId:"0757855", born:date('1978-06-19'), name:"Zoe Saldana", bio:"Zoë Yadira Saldana was born June 19, 1978 in Passaic NJ to a Puerto Rican mother and Dominican father.  Her family relocated to the Dominican Republic when she was ten years old.  There she practiced ballet at one of the most prestigious dance schools in the country.  Saldana returned to New York at age 17, where she began involving herself in theatre groups such as Faces and the New York Youth Theatre...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j17FWG5SIOvOdvfdr7MQ0sAz9wV.jpg", url:"https://themoviedb.org/person/8691"}}, {tmdbId:"343", properties:{bornIn:" Tucson, Arizona, USA", imdbId:"0543383", born:date('1978-11-06'), name:"Taryn Manning", bio:"Taryn Manning (born November 6, 1978) is an American actress, fashion designer, and singer-songwriter.  She is the vocalist for electronic duo Boomkat and co-owner of the clothing brand Born Uniqorn.  Manning gained her first major role as an actress in 2001 when she played the role of Maddy in Crazy/Beautiful.  She is well-known for her film portrayals in Crossroads, 8 Mile, A Lot Like Love, Hustle &amp; Flow, Weirdsville and Jack and Jill vs.  the World...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/obE0w8SVx7Hq773KY2DCxK1j2GF.jpg", url:"https://themoviedb.org/person/343"}}, {tmdbId:"17122", properties:{bornIn:"Seoul, South Korea", imdbId:"0431701", born:date('1974-08-11'), name:"Jin-mo Ju", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pA1aLYdhZymLzkgV4C2mM3QAnzW.jpg", url:"https://themoviedb.org/person/17122"}}, {tmdbId:"16146", properties:{imdbId:"0620217", name:"Saemi Nakamura", bio:"From Wikipedia, the free encyclopedia. \n\nSaemi Nakamura is a Japanese American actress.  She is best known for playing Kimiko Nakamura in the NBC science fiction television drama series Heroes.  She also appeared in a minor part in the 1995 film Jury Duty. \n\nDescription above from the Wikipedia article Saemi Nakamura, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/16146"}}, {tmdbId:"16147", properties:{bornIn:"California, USA", imdbId:"0739606", born:date('1956-07-27'), name:"Joe Romersa", bio:"From Wikipedia, the free encyclopedia. \n\nJoseph M.  Romersa (born July 27, 1956 in California) is an American song writer, drummer, multi-instrumentalist, producer, sound engineer and vocalist. \n\nWhile many know him from his singing and lyric writing on the \"Silent Hill\" game series, many people also know him from his former group \"Soy Cowboy\", which can only half-accurately be described as a \"Thai-Western\" band...", url:"https://themoviedb.org/person/16147"}}, {tmdbId:"16148", properties:{bornIn:"Denver - Colorado - USA", imdbId:"0286925", born:date('1953-12-16'), name:"Rebecca Forstadt", bio:"From Wikipedia, the free encyclopedia. \n\nRebecca Lynn Olkowski (born December 16, 1953 in Denver, Colorado), better known by her maiden name, Rebecca Forstadt, is an American voice actor who is best known for playing anime girls with sweet voices.  She is also known as Reba West and Becky Olkowski. \n\nAfter studying theater at Orange Coast College, in Costa Mesa, California, Ms...", url:"https://themoviedb.org/person/16148"}}, {tmdbId:"68917", properties:{bornIn:"Tokyo - Japan", imdbId:"0846248", born:date('1981-07-03'), name:"Aoi Tada", bio:"Aoi Tada (多田葵 Tada Aoi?, born 3 July 1981 in Tokyo) is a Japanese singer and former voice actress.  She formerly belonged to Gekidan Himawari.  She also performed an insert song to the series, \"Wo Qui Non Coin\". \n\nIn March 2005, she signed on to Moon-Bunny Entertainment and began her singer-songwriting career.  She has performed the theme songs for Gunslinger Girl: Il Teatrino and Angel Beats!.  She is also affiliated with the group Veil. [1] She is credited for her Veil-related songs as Veil ∞ Aoi...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/elAFSgbXEAs8mI6OG1x4eGOgw6R.jpg", url:"https://themoviedb.org/person/68917"}}, {tmdbId:"29900", properties:{bornIn:"Santa Monica, California, USA", imdbId:"1121508", born:date('1961-02-03'), name:"Jay Adams", bio:"​From Wikipedia, the free encyclopedia.   \n\nJay Adams (born February 3, 1961) (Age: 50) is one of the original Z-Boys and is considered one of the most influential skateboarders of all time. \n\nDescription above from the Wikipedia article Jay Adams, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2014-08-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xWOsNOm0jFVTMg8XSQuh4Ap9fSM.jpg", url:"https://themoviedb.org/person/29900"}}, {tmdbId:"401433", properties:{imdbId:"0023112", name:"Tony Alva", url:"https://themoviedb.org/person/401433"}}, {tmdbId:"1604", properties:{bornIn:"Barcelona, Barcelona, Catalunya, Spain", imdbId:"0392913", born:date('1957-04-20'), name:"Lluís Homar", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ctu3mzA9cSmzK85dNVqmaUjSaZS.jpg", url:"https://themoviedb.org/person/1604"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"69128", properties:{bornIn:"St. Louis, Missouri, United States", imdbId:"0625099", born:date('1974-11-02'), name:"Nelly", bio:"​From Wikipedia, the free encyclopedia\n\nCornell Haynes, Jr.  (born November 2, 1974), better known by his stage name Nelly, is an American rapper and singer. \n\nHe has performed with the rap group St.  Lunatics since 1993 and signed to Universal Records in 1999.  Under Universal, Nelly began his solo career in 2000 with his debut album Country Grammar, the title track of which was a top ten hit.  The album debuted at #3 on the Billboard 200 and went on to peak at #1...", url:"https://themoviedb.org/person/69128"}}, {tmdbId:"68763", properties:{bornIn:"New York City, New York, USA", imdbId:"0935921", born:date('1964-07-20'), name:"Dean Winters", bio:"From Wikipedia, the free encyclopedia. \n\nDean Winters (born July 20, 1964) is an American actor, who has portrayed Ryan O'Reily on HBO's Oz, Johnny Gavin on FX Network's Rescue Me, and Dennis Duffy on NBC's 30 Rock.  He also currently portrays \"Mayhem\" in Allstate commercials. \n\nDescription above from the Wikipedia article Dean Winters, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zxgOZAYGxa2qmiZkJKGRIhwbGhG.jpg", url:"https://themoviedb.org/person/68763"}}, {tmdbId:"3872", properties:{bornIn:"Barcelona, Catalonia, Spain", imdbId:"0117709", born:date('1978-06-16'), name:"Daniel Brühl", bio:"Daniel César Martín Brühl González Domingo (born 16 June 1978) is a German actor, producer and director.  He is best known for Good Bye Lenin! (2003), Inglourious Basterds (2009), Rush (2013) and Captain America: Civil War (2016).  Daniel speaks German, Spanish, English, French, Portuguese and Català...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yaSULfePwytkw845KKiz4bbLK48.jpg", url:"https://themoviedb.org/person/3872"}}, {tmdbId:"1961458", properties:{born:date('1972-01-01'), name:"Anabelle Lachatte", url:"https://themoviedb.org/person/1961458"}}, {tmdbId:"3874", properties:{bornIn:"Bochum, Germany", imdbId:"0430952", born:date('1975-08-12'), name:"Patrick Joswig", url:"https://themoviedb.org/person/3874"}}, {tmdbId:"3292", properties:{bornIn:"Wokingham, England, UK", imdbId:"0396558", born:date('1989-12-07'), name:"Nicholas Hoult", bio:"Nicholas Caradoc Hoult (born 7 December 1989) is an English actor, best known for the role as Marcus Brewer in the 2002 film About a Boy and as Tony Stonem in the E4 BAFTA winning television series, Skins. \n\nDescription above from the Wikipedia article Nicholas Hoult, licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rbyi6sOw0dGV3wJzKXDopm2h0NO.jpg", url:"https://themoviedb.org/person/3292"}}, {tmdbId:"3294", properties:{bornIn:"Drumchapel, Glasgow, Scotland, UK", imdbId:"0806527", born:date('1967-01-01'), name:"Sharon Small", bio:"From Wikipedia, the free encyclopedia\n\nSharon Small is a Scottish actress acclaimed for her dramatic work in film, radio, theatre, and television.  She is perhaps best known for her portrayal of Detective Sergeant Barbara Havers in the BBC television adaptation of The Inspector Lynley Mysteries by Elizabeth George.  She is also recognised for her lead roles in Law & Order: UK (as Inspector Elisabeth Flynn) and Trust Me (playing Dr.  Brigitte Rayne)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yRlVnUrp7yDJet6UGsugQ7EblhD.jpg", url:"https://themoviedb.org/person/3294"}}, {tmdbId:"3295", properties:{imdbId:"1168866", name:"Madison Cook", url:"https://themoviedb.org/person/3295"}}, {tmdbId:"21089", properties:{bornIn:"Noranda, Québec, Canada", imdbId:"0339304", born:date('1956-08-12'), name:"Bruce Greenwood", bio:"Bruce Greenwood (born August 12, 1956) is a Canadian actor.  He is generally known for his roles as John F.  Kennedy in Thirteen Days and National Treasure: Book of Secrets and for his role as Captain Christopher Pike in the 2009 Star Trek film...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tAQFbZX3fFSBOCzSC9zSRChkNqx.jpg", url:"https://themoviedb.org/person/21089"}}, {tmdbId:"7497", properties:{bornIn:"New York City - New York - USA", imdbId:"0564697", born:date('1964-09-03'), name:"Holt McCallany", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8NvOcP35qv5UHWEdpqAvQrKnQQz.jpg", url:"https://themoviedb.org/person/7497"}}, {tmdbId:"501", properties:{bornIn:"Conyers, Georgia, USA", imdbId:"0266824", born:date('1994-02-23'), name:"Dakota Fanning", bio:"Hannah Dakota Fanning (born February 23, 1994), better known as Dakota Fanning, is an American actress.  Fanning's breakthrough performance was in I Am Sam in 2001.  As a child actress, she appeared in high-profile films such as Man on Fire, War of the Worlds, and Charlotte's Web.  Fanning began the transition to more adult roles with Hounddog and The Secret Life of Bees.  Recent films have included The Twilight Saga and The Runaways...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6bNiiHnZZfA7YYIxO5FszvNFBlI.jpg", url:"https://themoviedb.org/person/501"}}, {tmdbId:"18918", properties:{bornIn:"Hayward, California, USA", imdbId:"0425005", born:date('1972-05-02'), name:"Dwayne Johnson", bio:"An American and Canadian actor, producer and semi-retired professional wrestler, signed with WWE.   Johnson is half-Black and half-Samoan.  His father, Rocky Johnson, is a Black Canadian, from Nova Scotia, and part of the first Black tag team champions in WWE history back when it was known as the WWF along with Tony Atlas.  His mother is Samoan and the daughter of Peter Maivia, who was also a pro wrestler...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cgoy7t5Ve075naBPcewZrc08qGw.jpg", url:"https://themoviedb.org/person/18918"}}, {tmdbId:"57340", properties:{bornIn:"Dundee, Scotland, UK", imdbId:"0104526", born:date('1969-06-26'), name:"Steven Brand", bio:"​From Wikipedia, the free encyclopedia. \n\nSteven Brand (born 26 June 1969) is a Scottish actor.   He made his American screen debut in Universal's The Scorpion King as Memnon, evil warlord and arch nemesis of Mathayus, played by The Rock...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oWkitw5jzILwb775CVGjsqMSrqz.jpg", url:"https://themoviedb.org/person/57340"}}, {tmdbId:"11024", properties:{bornIn:"Honolulu, Hawaii, USA", imdbId:"0005026", born:date('1968-02-13'), name:"Kelly Hu", bio:"From Wikipedia, the free encyclopedia\n\nKelly Ann Hu (born February 13, 1968, height 5' 4½\" (1,64 m)) is an American actress and former fashion model.  She was Miss Teen USA 1985 and Miss Hawaii USA 1993...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aE8K43akwifeAPpDFKiEJ678Bvn.jpg", url:"https://themoviedb.org/person/11024"}}, {tmdbId:"69210", properties:{bornIn:"Charlotte, North Carolina, USA", imdbId:"0500200", born:date('1982-04-10'), name:"Chyler Leigh", bio:"Chyler Leigh is an American actress, best known for her portrayal of Dr.  Lexie Grey on Grey's Anatomy and Alex Danvers on Supergirl. \n\nBorn in Charlotte, North Carolina and raised in Virginia Beach and Miami Beach, Chyler began her career in front of the camera at age 12 modeling for magazines and catalogues.  Her success in print later led to national commercials for Coca Cola and Wendy's, among others...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wuNMNPmV802aIZQeP8XNfsnNfYH.jpg", url:"https://themoviedb.org/person/69210"}}, {tmdbId:"29020", properties:{bornIn:"Eugene, Oregon, USA", imdbId:"0647638", born:date('1977-05-31'), name:"Eric Christian Olsen", bio:"Eric Christian Olsen (born May 31, 1977) is an American actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v6r77LimgA49VxsRjKVFUYeVVRi.jpg", url:"https://themoviedb.org/person/29020"}}, {tmdbId:"114", properties:{bornIn:"Canterbury, Kent, England, UK", imdbId:"0089217", born:date('1977-01-13'), name:"Orlando Bloom", bio:"Orlando Jonathan Blanchard Bloom is an English actor.  He had his break-through roles in 2001 as the elf-prince Legolas in The Lord of the Rings and starting in 2003 as blacksmith Will Turner in the Pirates of the Caribbean trilogy of films, and subsequently established himself as a lead in Hollywood films, including Elizabethtown and Kingdom of Heaven.  He appeared in the ensemble film New York, I Love You, and will have roles in Sympathy for Delicious and Main Street...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kboHD4zumfJt3vkjORd8ETJyJfX.jpg", url:"https://themoviedb.org/person/114"}}, {tmdbId:"76093", properties:{bornIn:"London, England, UK", imdbId:"0152231", born:date('1977-07-27'), name:"Carmen Chaplin", bio:"​From Wikipedia, the free encyclopedia. \n\nCarmen Chaplin is an actress, who belongs to the family of Charlie Chaplin...", url:"https://themoviedb.org/person/76093"}}, {tmdbId:"20216", properties:{bornIn:"Manhattan Beach, California, U.S.", imdbId:"0021100", born:date('1996-08-07'), name:"Tessa Allen", bio:"From Wikipedia, the free encyclopedia. \n\nTessa Allen (born August 7, 1996) is an American teen actress who made her motion picture debut in Enough starring as Gracie, the young daughter of Jennifer Lopez's character.  Before Enough, Allen appeared in many commercials, the first of which when she was only 4 months old in a Maytag commercial...", url:"https://themoviedb.org/person/20216"}}, {tmdbId:"1075149", properties:{imdbId:"1182861", name:"Oliver 'Ole' Zemen", url:"https://themoviedb.org/person/1075149"}}] AS row
