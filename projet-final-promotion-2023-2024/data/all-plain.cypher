https://image.tmdb.org/t/p/w440_and_h660_face/wsuLRToXghO8qv1nYMnEeppkwdR.jpg", url:"https://themoviedb.org/person/1385063"}}, {tmdbId:"1198286", properties:{bornIn:"Melbourne, Australia ", imdbId:"4590837", born:date('2001-06-01'), name:"Ed Oxenbould", bio:"Ed Oxenbould (born 1 June 2001) is an Australian actor.  In 2014 acted as the title character in Alexander and the Terrible, Horrible, No Good, Very Bad Day, Dylan in Paper Planes, and as Tyler in the film The Visit...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kn9qLcNWDc1FLSvcUUDAmzKz7uO.jpg", url:"https://themoviedb.org/person/1198286"}}, {tmdbId:"204271", properties:{bornIn:"Monahans, Texas, USA", imdbId:"0241759", born:date('1940-05-25'), name:"Deanna Dunagan", url:"https://themoviedb.org/person/204271"}}, {tmdbId:"19489", properties:{bornIn:"Hawick, Borders, Scotland, UK", imdbId:"0574513", born:date('1943-01-31'), name:"Peter McRobbie", bio:"Peter McRobbie is an actor...", url:"https://themoviedb.org/person/19489"}}, {tmdbId:"1336143", properties:{bornIn:"Walthamstow, Regno Unito", imdbId:"5980553", born:date('1991-01-09'), name:"Joshua Hill", bio:"Joshua Hill is a film and television actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uuVzrUh2VoeJqrkf7ewgJtQxsCK.jpg", url:"https://themoviedb.org/person/1336143"}}, {tmdbId:"82704", properties:{bornIn:"Bridgewater, Nova Scotia", imdbId:"0243082", born:date('1946-04-12'), name:"John Dunsworth", bio:"​From Wikipedia, the free encyclopedia.   \n\nJohn Dunsworth (born April 12, 1946) is a Canadian actor known for playing the frequently drunk trailer park supervisor Jim Lahey on the hit TV show Trailer Park Boys.  He has also appeared in Shattered City: The Halifax Explosion, a CBC film about the 1917 Halifax explosion.  Dunsworth also has extensive experience in regional theatre...", died:date('2017-10-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lOFaPWFbtr733afDTcWeJlPODDn.jpg", url:"https://themoviedb.org/person/82704"}}, {tmdbId:"1347729", properties:{imdbId:"6373135", name:"Darío Díaz", url:"https://themoviedb.org/person/1347729"}}, {tmdbId:"1090650", properties:{imdbId:"0592164", name:"José Miguel Miranda", url:"https://themoviedb.org/person/1090650"}}, {tmdbId:"578081", properties:{imdbId:"2720118", born:date('1985-07-13'), name:"Stanley Weber", bio:"Stanley Weber, es un actor francés mejor conocido por haber interpretado a Juan Borgia en la serie Borgia.  Es hijo del actor Jacques Weber y de Christine Weber, tiene dos hermanos Kim y Tommy Weber  En el 2011 se unió al elenco principal de la serie francesa Borgia donde interpretó a Juan Borgia, el hijo del Papa Alejandro VI (John Doman) hasta el 2013, luego de que su personaje fuera asesinado. \n\nEn el 2013 se unió al elenco de la película Not Another Happy Ending donde dio vida a Tom Duval...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/seRPDc8ifxicZUi6cF4G4NaXKm.jpg", url:"https://themoviedb.org/person/578081"}}, {tmdbId:"1050631", properties:{imdbId:"3329371", name:"Edward Akrout", url:"https://themoviedb.org/person/1050631"}}, {tmdbId:"1402671", properties:{imdbId:"3457856", name:"Peter J. Chaffey", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pzqPUjC3Z64Y4KBDNorpNJpeBTQ.jpg", url:"https://themoviedb.org/person/1402671"}}, {tmdbId:"148992", properties:{bornIn:"Sarasota, Florida, USA", imdbId:"3641002", born:date('1996-09-02'), name:"Austin Abrams", bio:"Austin Abrams was born on September 2, 1996 in the USA.  He is an actor, known for Gangster Squad (2013), The Kings of Summer (2013) and Ticking Clock (2011)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ge7orRcJKPdHSxPIPrl3xa62reu.jpg", url:"https://themoviedb.org/person/148992"}}, {tmdbId:"1029934", properties:{bornIn:"Los Angeles, California, USA", imdbId:"6819854", born:date('1995-08-09'), name:"Justice Smith", bio:"Justice Elio Smith (born August 9, 1995) is an American film and television actor, best known for playing Radar in the film Paper Towns, and Ezekiel in the Netflix series The Get Down...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3UoUT44XYWoWNsZaqHzN3w48gZL.jpg", url:"https://themoviedb.org/person/1029934"}}, {tmdbId:"146572", properties:{bornIn:"South Wentworthville, New South Wales, Australia", imdbId:"0819782", born:date('1949-08-23'), name:"Rick Springfield", bio:"Richard Lewis Springthorpe is an Australian singer-songwriter, musician, and actor.  As a musician, he is known for the 1981 No. 1 single \"Jessie's Girl\", which became a blockbuster of 1980s pop rock music and helped establish the emerging music video age.  As an actor, Springfield is known for playing Dr.  Noah Drake on the daytime drama General Hospital.  He originated the character from 1981–1983 and then returned to play him again from 2005–2008...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rQeUcfwR1M8n51mRROeYLHHY7Gc.jpg", url:"https://themoviedb.org/person/146572"}}, {tmdbId:"1716710", properties:{bornIn:"Los Angeles, California, USA", imdbId:"2182471", born:date('1949-09-10'), name:"Rick Rosas", died:date('2014-11-06'), url:"https://themoviedb.org/person/1716710"}}, {tmdbId:"116614", properties:{imdbId:"1090326", name:"Johannes Kuhnke", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q9xNsXwP1LBnOR8m251O86Uvl36.jpg", url:"https://themoviedb.org/person/116614"}}] AS row
