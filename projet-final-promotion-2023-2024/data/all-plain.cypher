UNWIND [{tmdbId:"1014586", properties:{imdbId:"1555145", name:"Christopher Sommers", bio:"Christopher Sommers is an actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e86eKSvV5gr1qihDfG8Lpya04OC.jpg", url:"https://themoviedb.org/person/1014586"}}, {tmdbId:"10439", properties:{bornIn:"Rio de Janeiro, Brazil", imdbId:"0108613", born:date('1941-08-25'), name:"Marshall Brickman", bio:"​From Wikipedia, the free encyclopedia.   \n\nMarshall Brickman (born August 25, 1941 in Rio de Janeiro, Brazil) is a screenwriter, best known for his collaborations with Woody Allen.  He is also known for playing the banjo with Eric Weissberg in the 1960s, and for a series of comical parodies published in The New Yorker. \n\nDescription above from the Wikipedia article Marshall Brickman, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/10439"}}, {tmdbId:"140114", properties:{bornIn:"Thunder Bay, Ontario, Canada", imdbId:"2955595", born:date('1986-06-17'), name:"Marie Avgeropoulos", bio:"Marie Avgeropoulos (/ævdʒɛrɔːˈpuːlɔːs/; born June 17, 1986) is a Canadian actress and model with Greek ancestry.  Her break-out role was as Valli Wooley in the 2009 film I Love You, Beth Cooper directed by Chris Columbus.  Since then, she has appeared in more film and TV roles: as Kirstie in Cult, as Kim Rhodes in Hunt to Kill, and the sci-fi series The 100 as Octavia Blake. \n\nCareer\n\nAfter studying broadcast journalism for two years in her hometown, Avgeropoulos moved to Europe...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/m5vWJx7LCiJ1ZBoAYJBqKrK4khL.jpg", url:"https://themoviedb.org/person/140114"}}, {tmdbId:"144292", properties:{bornIn:"Shrewsbury, England, UK", imdbId:"1501374", born:date('1977-01-01'), name:"Adam Rayner", bio:"Adam Rayner, born on 28 August 1977 in Shrewsbury, is an English actor, who has appeared on television in Mistresses, At Home with the Braithwaites and Making Waves.  He has also appeared on stage in The Rivals (Bristol Old Vic, 2004), Romeo and Juliet (Royal Shakespeare Theatre, 2006) and Much Ado About Nothing (Novello, 2006)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3BPfA65U7R0gKSEpLv69oNVb1Q8.jpg", url:"https://themoviedb.org/person/144292"}}, {tmdbId:"1549688", properties:{imdbId:"2934306", name:"Mark Simpson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cOu2wC6RXkos0vO5hkXgP9XMRuT.jpg", url:"https://themoviedb.org/person/1549688"}}, {tmdbId:"1549689", properties:{imdbId:"0128374", name:"Paul Caesar", url:"https://themoviedb.org/person/1549689"}}, {tmdbId:"496470", properties:{bornIn:"Greenfield, Massachusetts, United States", imdbId:"3821405", born:date('1985-02-14'), name:"Jake Lacy", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qU6n9EaesBGqhNLlj5BecUrb5LW.jpg", url:"https://themoviedb.org/person/496470"}}, {tmdbId:"1376817", properties:{imdbId:"5339238", name:"Lauren Julien-Box", url:"https://themoviedb.org/person/1376817"}}, {tmdbId:"86441", properties:{imdbId:"0571326", name:"Alan McKenna", bio:"Alan McKenna is a British actor who played the recurring character Tony Andrews in the BBC soap opera EastEnders.  He is best known for his role of Patrick McGuire in the BBC soap Doctors, which he had a minor recurring role from 2001, 2003 and he returned in September 2010. \n\nHis great aunt was Odette Marie Celine Sansom, GC, MBE, Chevalier de la légion d'honneur, (April 28, 1912 - March 13, 1995) who an Allied heroine of World War II...", url:"https://themoviedb.org/person/86441"}}, {tmdbId:"49706", properties:{bornIn:"Yonkers, New York, USA", imdbId:"0735226", born:date('1975-04-02'), name:"Adam Rodriguez", bio:"Adam Rodríguez is an American actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bItjbs27qfBslaZ5mUkIKKQvacj.jpg", url:"https://themoviedb.org/person/49706"}}, {tmdbId:"122888", properties:{bornIn:"Westchester County, New York, USA", imdbId:"0930053", born:date('1978-11-12'), name:"Ashley Williams", bio:"Williams was born in Westchester County, New York.  Her father, Gurney Williams, is a freelance medical journalist and her mother, Linda, is a fundraiser for The Michael J.  Fox Foundation for Parkinson's Research.  She is the younger sister of Kimberly Williams-Paisley, who is also an actress, and sister-in-law to country music star Brad Paisley.  Williams attended Rye High School in Rye, New York...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3lHQrfDQVgZnegVA7scdz2JZcQ6.jpg", url:"https://themoviedb.org/person/122888"}}, {tmdbId:"1056523", properties:{imdbId:"2649720", born:date('1995-07-08'), name:"John D'Leo", bio:"John D'Leo was born and raised in New Jersey.  He has two older brothers.   When John is not in front of the camera, he is behind it.  He has acquired a love for filmmaking and all aspects of \"behind-the scenes\" work.  John also enjoys photography and writing scripts.  He is a unique talent with a flair for comedy, natural on-camera demeanor and all-around passion for entertaining...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/do0YtjRWmQyVvQf8S5oAMEGw0Bn.jpg", url:"https://themoviedb.org/person/1056523"}}, {tmdbId:"1104854", properties:{bornIn:"Tehran, Iran", imdbId:"0608214", born:date('1966-12-01'), name:"Ali Mosaffa", bio:"Ali Mosaffa (علی مصفا) was born in Tehran, Iran.  His father, Mozaher Mosaffa is a renowned Persian poet and professor of Persian literature at the University of Tehran (UT).  Mosaffa mother, Amir Banoo Karimi is also a leading scholar and professor of Persian literature at the University of Tehran (UT) and the eldest daughter of the legendary Persian poet, Amiri Firuzkuhi.  As a child, Ali Mosaffa discovered his interest in story writing and english, contributing to his fluency in the language...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mMJ8W8dLWTBbNcHc9YXA4LzXng3.jpg", url:"https://themoviedb.org/person/1104854"}}, {tmdbId:"1128970", properties:{bornIn:"Mons, Belgium", imdbId:"2519287", born:date('1996-04-09'), name:"Pauline Burlet", bio:"Pauline Burlet (born 9 April 1996) is a Belgian actress, who starred as 'Lili Franchet' in the French TV series Résistance. \n\nHer first major role was in the 2007 film, La Vie en rose, as a young Edith Piaf.  Burlet won a Magritte Award in 2014 for \"most promising actress\" for her performance in The Past (Le Passé). \n\nSource: Article \"Pauline Burlet\" from Wikipedia in english, licensed under CC-BY-SA 3. 0...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wAXOz5ZVKyrahNpPBfYcX2ePVTE.jpg", url:"https://themoviedb.org/person/1128970"}}, {tmdbId:"1131843", properties:{name:"Eric Dean", url:"https://themoviedb.org/person/1131843"}}, {tmdbId:"1131846", properties:{imdbId:"1995105", name:"Heidi Rhodes", url:"https://themoviedb.org/person/1131846"}}, {tmdbId:"166682", properties:{imdbId:"1197173", born:date('1978-03-01'), name:"Mark Cirillo", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1y7QQtrSikGLLt6mDCxi2zrQPfA.jpg", url:"https://themoviedb.org/person/166682"}}, {tmdbId:"1131850", properties:{name:"Trevor Knight", url:"https://themoviedb.org/person/1131850"}}, {tmdbId:"112901", properties:{bornIn:"Madrid, Spain", imdbId:"1281229", born:date('1977-05-10'), name:"Hugo Silva", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vD5q2gkKACW2GfasbLFUixbJbZb.jpg", url:"https://themoviedb.org/person/112901"}}, {tmdbId:"1393836", properties:{name:"Bhagavan Angulo", url:"https://themoviedb.org/person/1393836"}}] AS row
