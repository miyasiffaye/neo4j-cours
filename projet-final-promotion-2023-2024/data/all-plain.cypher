UNWIND [{movieId:"1978", properties:{languages:["English"], year:1985, imdbId:"0089173", runtime:92, imdbRating:4.7, countries:["USA"], imdbVotes:21604, title:"Friday the 13th Part V: A New Beginning", url:"https://themoviedb.org/movie/9731", revenue:21930418, tmdbId:"9731", plot:"Still haunted by his past, Tommy Jarvis - who, as a child, killed Jason Voorhees - wonders if the serial killer is connected to a series of brutal murders occurring in and around the secluded halfway house where he now lives.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iKOWTkGqZtucGEJuo9Cr60PMROC.jpg", released:"1985-03-22", budget:2200000}}, {movieId:"1979", properties:{languages:["English"], year:1986, imdbId:"0091080", runtime:86, imdbRating:5.9, countries:["USA"], imdbVotes:24235, title:"Friday the 13th Part VI: Jason Lives", url:"https://themoviedb.org/movie/10225", revenue:19472057, tmdbId:"10225", plot:"Tommy Jarvis goes to the graveyard to get rid of Jason Voorhees' body once and for all, but inadvertently brings him back to life instead. The newly revived killer once again seeks revenge, and Tommy may be the only one who can defeat him.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/527lL7kLmvxLXnMoaMrKashaC58.jpg", released:"1986-08-01", budget:3000000}}, {movieId:"1980", properties:{languages:["English"], year:1988, imdbId:"0095179", runtime:88, imdbRating:5.3, countries:["USA"], imdbVotes:20398, title:"Friday the 13th Part VII: The New Blood", url:"https://themoviedb.org/movie/10281", revenue:19170001, tmdbId:"10281", plot:"Years after Tommy Jarvis chained him underwater at Camp Crystal Lake, Jason Voorhees returns to the camp grounds when he is accidentally released from his prison by a teenager with psychic powers.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2Tyr422N8ivi9TfA9BAP896Z6Q.jpg", released:"1988-05-13", budget:2800000}}, {movieId:"1981", properties:{languages:["English"], year:1989, imdbId:"0097388", runtime:100, imdbRating:4.5, countries:["USA", " Canada"], imdbVotes:22166, title:"Friday the 13th Part VIII: Jason Takes Manhattan", url:"https://themoviedb.org/movie/10283", revenue:14000000, tmdbId:"10283", plot:"A passing boat bound for New York pulls Jason Voorhees along for the ride. Look out New York, here comes hell in a hockey mask.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/s5U5JgPpgfTnbGxQF2bOlfqqz5b.jpg", released:"1989-07-28", budget:5000000}}, {movieId:"1982", properties:{languages:["English"], year:1978, imdbId:"0077651", runtime:91, imdbRating:7.9, countries:["USA"], imdbVotes:152627, title:"Halloween", url:"https://themoviedb.org/movie/948", tmdbId:"948", plot:"On Halloween night of 1963, 6-year old Michael Myers stabbed his sister to death. After sitting in a mental hospital for 15 years, Myers escapes and returns to Haddonfield to kill.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yzVhqSi3XkEQOovR4yy2lVTZiQO.jpg", released:"1978-10-25", budget:325000}}, {movieId:"1983", properties:{languages:["English"], year:1981, imdbId:"0082495", runtime:92, imdbRating:6.5, countries:["USA"], imdbVotes:49097, title:"Halloween II", url:"https://themoviedb.org/movie/11281", tmdbId:"11281", plot:"While Sheriff Brackett and Dr. Loomis hunt for Michael Myers, a traumatized Laurie is rushed to hospital, and the serial killer is not far behind her.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/A8hxlFY54QJPDKktBvePR7QhJWE.jpg", released:"1981-10-30", budget:2500000}}, {movieId:"1984", properties:{languages:["English"], year:1982, imdbId:"0085636", runtime:98, imdbRating:4.5, countries:["USA"], imdbVotes:27655, title:"Halloween III: Season of the Witch", url:"https://themoviedb.org/movie/10676", revenue:14400000, tmdbId:"10676", plot:"Kids all over America want Silver Shamrock masks for Halloween. Doctor Daniel Challis seeks to uncover a plot by Silver Shamrock owner Conal Cochran.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5Lzr0iKsaEJmuD8VgwOyKPRgf9d.jpg", released:"1982-10-22", budget:2500000}}, {movieId:"1985", properties:{languages:["English"], year:1988, imdbId:"0095271", runtime:88, imdbRating:5.9, countries:["USA"], imdbVotes:28589, title:"Halloween 4: The Return of Michael Myers", url:"https://themoviedb.org/movie/11357", revenue:17768757, tmdbId:"11357", plot:"Ten years after his original massacre, the invalid Michael Myers awakens and returns to Haddonfield to kill his seven-year-old niece on Halloween. Can Dr. Loomis stop him?", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sNrObotenLs8A7qocyiCOtuvF66.jpg", released:"1988-10-21", budget:5000000}}, {movieId:"1986", properties:{languages:["English"], year:1989, imdbId:"0097474", runtime:96, imdbRating:5.2, countries:["USA"], imdbVotes:22112, title:"Halloween 5: The Revenge of Michael Myers", url:"https://themoviedb.org/movie/11361", revenue:11642254, tmdbId:"11361", plot:"Set one year after the events of Halloween 4, Michael Myers returns to Haddonsfield once again to try and kill his niece.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sfBjw1TPwoN7p7bdRO9sgUQpt1q.jpg", released:"1989-10-13", budget:5000000}}, {movieId:"1987", properties:{languages:["English"], year:1980, imdbId:"0081383", runtime:92, imdbRating:5.4, countries:["Canada"], imdbVotes:10007, title:"Prom Night", url:"https://themoviedb.org/movie/36599", revenue:14796236, tmdbId:"36599", plot:"A masked killer stalks four teenagers, responsible for the accidental death of a little girl six years earlier, at their high school's senior prom.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/r2Ew7wUP96PsePEZseK6JqcPWY9.jpg", released:"1980-07-18", budget:1500000}}, {movieId:"1988", properties:{languages:["English"], year:1987, imdbId:"0093176", runtime:97, imdbRating:5.5, countries:["Canada"], imdbVotes:3010, title:"Prom Night II", url:"https://themoviedb.org/movie/39929", revenue:2683519, tmdbId:"39929", plot:"Thirty years after her accidental death at the 1957 senior prom, the tortured spirit of prom queen, Mary Lou Maloney, returns and she is out for revenge.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vhk8OSJs14dZiM8XtqyaRqn1QCJ.jpg", released:"1987-11-13"}}, {movieId:"1989", properties:{languages:["English"], year:1990, imdbId:"0098136", runtime:97, imdbRating:4.4, countries:["Canada"], imdbVotes:1200, title:"Prom Night III: The Last Kiss", url:"https://themoviedb.org/movie/41828", tmdbId:"41828", plot:"A murdered high school girl returns from the grave and hypnotizes a student into helping her commit revenge murders.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bJOpzoUXeYhruTAc3PBbvKAeLpd.jpg", released:"1990-06-28"}}, {movieId:"1990", properties:{languages:["English"], year:1992, imdbId:"0105179", runtime:92, imdbRating:4.1, countries:["Canada"], imdbVotes:922, title:"Prom Night IV: Deliver Us From Evil", url:"https://themoviedb.org/movie/41769", tmdbId:"41769", plot:"A religious fanatic stalks four teens he feels have transgressed the law of God.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tjq1iWClSBCfi3SjpVJblOU6q4F.jpg", released:"1992-02-14"}}, {movieId:"1991", properties:{languages:["English"], year:1988, imdbId:"0094862", runtime:87, imdbRating:6.5, countries:["USA"], imdbVotes:59770, title:"Child's Play", url:"https://themoviedb.org/movie/10585", revenue:44196684, tmdbId:"10585", plot:"A single mother gives her son a much sought after doll for his birthday, only to discover that it is possessed by the soul of a serial killer.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wvpgvcWNkF2HLuTEMIM7K83MvZ.jpg", released:"1988-11-09", budget:9000000}}, {movieId:"1992", properties:{languages:["English"], year:1990, imdbId:"0099253", runtime:84, imdbRating:5.7, countries:["USA"], imdbVotes:30222, title:"Child's Play 2", url:"https://themoviedb.org/movie/11186", revenue:35763605, tmdbId:"11186", plot:"While Andy's mother is admitted to a psychiatric hospital, the young boy is placed in foste