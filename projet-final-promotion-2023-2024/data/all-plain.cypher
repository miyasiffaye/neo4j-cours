UNWIND [{tmdbId:"128648", properties:{imdbId:"0568682", born:date('1975-10-09'), name:"Joseph McFadden", url:"https://themoviedb.org/person/128648"}}, {tmdbId:"75977", properties:{imdbId:"0571137", name:"Alan McKee", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nnvNj9BkOHFNhgdPRoZI7jHYUzs.jpg", url:"https://themoviedb.org/person/75977"}}, {tmdbId:"222275", properties:{name:"Richard Tillman", url:"https://themoviedb.org/person/222275"}}, {tmdbId:"1904487", properties:{bornIn:"Lima, Peru", imdbId:"2953979", name:"Ricky Catter", bio:"Raised in Houston, TX.  He has been a professional actor for over 23 years.  He has starred in over 100 commercials and also has performed in theaters across the country from New York to Hawaii.  His Network TV/Film credits include Starring and Costarring roles in Rich Kids, Macgyver, NCIS: New Orleans, Murder comes to town, Freedom on Trial, American Crime, The Night Shift, Queen of the South, Prison Break and many more...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bJAAx704I01IiUKCiJFOUyVSjmC.jpg", url:"https://themoviedb.org/person/1904487"}}, {tmdbId:"77589", properties:{bornIn:"Cleveland, Ohio, USA", imdbId:"0505226", born:date('1954-09-30'), name:"Calvin Levels", url:"https://themoviedb.org/person/77589"}}, {tmdbId:"59017", properties:{bornIn:"New York City, New York, USA", imdbId:"0810619", born:date('1986-10-01'), name:"Jurnee Smollett", bio:"Jurnee Diana Smollett was born on October 1, 1986 in New York City.  She co-starred in the ABC television comedy On Our Own (1994–1995) and guest appeared in numerous television shows: Hangin' with Mr.  Cooper, Full House, Martin, Wanda At Large, House, Grey's Anatomy, etc.  She also co-starred in the last two seasons of Friday Night Lights.  Smollett is best known for her role in the independent film Eve's Bayou (1997), for which she received critical acclaim as ten-year-old Eve...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jzpxcydjOM1QlOvQD0AdfWdXJDb.jpg", url:"https://themoviedb.org/person/59017"}}, {tmdbId:"133001", properties:{bornIn:"England, UK", imdbId:"0206341", born:date('1947-11-04'), name:"Anette Day", url:"https://themoviedb.org/person/133001"}}, {tmdbId:"37940", properties:{bornIn:"Seoul, South Korea", imdbId:"1280145", born:date('1979-07-11'), name:"Im Soo-jung", bio:"Im Soo-jung (Hangul: 임수정; born on July 11, 1979) is a South Korean actress.  After modeling for teen magazines, Im made her acting breakthrough in Kim Jee-woon's horror film A Tale of Two Sisters (2003), followed by the popular television drama I'm Sorry, I Love You (2004)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4a94wVVVh4t4PiFX2RKVlfNWeY6.jpg", url:"https://themoviedb.org/person/37940"}}, {tmdbId:"37941", properties:{bornIn:"Gwangju, South Korea", imdbId:"1371529", born:date('1987-05-06'), name:"Moon Geun-young", bio:"Moon Geun-young (born May 6, 1987, in Gwangju, South Korea) is a South Korean award-winning actress, commercial film (CF) star, and model.  Affectionately called \"Korean nation's little sister,\" Moon started modeling at the age of 12 and appeared in the documentary film On the Way (1999) the following year.  She came into the spotlight through her role as the young Eun-suh in the hugely popular television drama series Autumn Tale (2000)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1GaNvUU1uq8QjVQCYuyaVik2tIR.jpg", url:"https://themoviedb.org/person/37941"}}, {tmdbId:"77257", properties:{bornIn:"Calgary, Alberta, Canada", imdbId:"0095745", born:date('1961-10-02'), name:"Kevin Booth", bio:"From Wikipedia, the free encyclopedia\n\nKevin Booth is an American film and video director, producer, and musician.  He is best known for his work with comedian Bill Hicks, who was the subject of his book Agent of Evolution, published by Harper Collins UK.  Bill and Kevin knew each other since their time together at Stratford High School.  Booth founded Sacred Cow Productions in 1986, and has since explored such controversial subjects as the Waco Siege and the New World Order...", url:"https://themoviedb.org/person/77257"}}, {tmdbId:"134858", properties:{imdbId:"2914385", name:"John Farneti", url:"https://themoviedb.org/person/134858"}}, {tmdbId:"225119", properties:{bornIn:"Gwangju, South Korea", imdbId:"0950902", born:date('1944-07-30'), name:"Yoon Jeong-hee", bio:"From Wikipedia, the free encyclopedia. \n\nYoon Jeong-hee ( born on July 30, 1944 in Gwangju, South Korea) is a South Korean actress active since 1967.  Yoon debuted as an actress in 1967 as starring in Cheongchun geukjang directed by Gang Dae-jin after elected in a recruit held by Hapdong Film.  Yoon was commonly referred to as one of the \"Troika\" along with her rival actresses, Moon Hee and Nam Jeong-im of the 1960s.  Yoon married a noted pianist Kun-Woo Paik in 1974...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q8ipBodovEXPriWoKmyO9UXgYfU.jpg", url:"https://themoviedb.org/person/225119"}}, {tmdbId:"1118783", properties:{bornIn:"Chifeng, Inner Mongolia, China", imdbId:"0802700", born:date('1950-01-20'), name:"Siqin Gaowa", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/deySFxiJzkZ02zUV1eStX5dBaFw.jpg", url:"https://themoviedb.org/person/1118783"}}, {tmdbId:"1396646", properties:{imdbId:"0917683", born:date('1956-02-25'), name:"Wei Zi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jw2pw0l2AK6jwobXyLm4fQOkEr5.jpg", url:"https://themoviedb.org/person/1396646"}}, {tmdbId:"1530936", properties:{born:date('1936-08-26'), name:"Kam Kong", url:"https://themoviedb.org/person/1530936"}}, {tmdbId:"20264", properties:{bornIn:"Corea del Sud", imdbId:"1926499", born:date('1957-07-21'), name:"Jeon Kuk-hwan", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nCRJk3wJzDJuDCcCZd0hhT06rLD.jpg", url:"https://themoviedb.org/person/20264"}}, {tmdbId:"87090", properties:{bornIn:"Busan, South Korea", imdbId:"1141657", born:date('1960-09-05'), name:"Cheon Ho-jin", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hOZaT2Ngj3gaY4z0zWfOphW2tx9.jpg", url:"https://themoviedb.org/person/87090"}}, {tmdbId:"111837", properties:{imdbId:"0943614", name:"Don Wycherley", url:"https://themoviedb.org/person/111837"}}, {tmdbId:"40535", properties:{bornIn:"Paris, France", imdbId:"0025523", born:date('1923-02-13'), name:"Philippe de Chérisey (Amédée )", died:date('1985-07-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4Wwirz8Yap0JnBK9EZoMxWX5WT2.jpg", url:"https://themoviedb.org/person/40535"}}, {tmdbId:"6819", properties:{bornIn:"Long Island, New York, USA", imdbId:"1765842", born:date('1957-04-29'), name:"Timothy Treadwell", died:date('2003-10-06'), url:"https://themoviedb.org/person/6819"}}] AS row
