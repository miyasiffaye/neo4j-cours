UNWIND [{movieId:"45668", properties:{languages:["English"], year:2006, imdbId:"0410297", runtime:99, imdbRating:6.8, countries:["USA", " Australia"], imdbVotes:111859, title:"Lake House, The", url:"https://themoviedb.org/movie/2044", revenue:114830111, tmdbId:"2044", plot:"A lonely doctor who once occupied an unusual lakeside home begins exchanging love letters with its former resident, a frustrated architect. They must try to unravel the mystery behind their extraordinary romance before it's too late.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tHpc1118dYWLnHZleGhwZxRbpae.jpg", released:"2006-06-16", budget:40000000}}, {movieId:"45672", properties:{languages:["English", " Portuguese", " Japanese"], year:2006, imdbId:"0389860", runtime:107, imdbRating:6.4, countries:["USA"], imdbVotes:238805, title:"Click", url:"https://themoviedb.org/movie/9339", revenue:240685326, tmdbId:"9339", plot:"A workaholic architect finds a universal remote that allows him to fast-forward and rewind to different parts of his life. Complications arise when the remote starts to overrule his choices.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x7rM5dwQefvpXqHKQs4TrpoRyz3.jpg", released:"2006-06-23", budget:82500000}}, {movieId:"45679", properties:{languages:["English", " Italian", " Latin", " French"], year:1943, imdbId:"0036341", runtime:71, imdbRating:6.9, countries:["USA"], imdbVotes:3612, title:"Seventh Victim, The", url:"https://themoviedb.org/movie/20945", tmdbId:"20945", plot:"A woman in search of her missing sister uncovers a Satanic cult in New York's Greenwich Village, and finds that they may have something to do with her sibling's random disappearance.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cvck16EWDqWK6x4p78N8KyJyJNJ.jpg", released:"1943-08-21"}}, {movieId:"45720", properties:{languages:["English", " French"], year:2006, imdbId:"0458352", runtime:109, imdbRating:6.8, countries:["USA", " France"], imdbVotes:275709, title:"Devil Wears Prada, The", url:"https://themoviedb.org/movie/350", revenue:326551094, tmdbId:"350", plot:"A smart but sensible new graduate lands a job as an assistant to Miranda Priestly, the demanding editor-in-chief of a high fashion magazine.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/u6QBDGUCOEMRekna95ip2MxplbQ.jpg", released:"2006-06-30", budget:35000000}}, {movieId:"45722", properties:{languages:["English", " Turkish", " Greek", " Mandarin", " French"], year:2006, imdbId:"0383574", runtime:151, imdbRating:7.3, countries:["USA"], imdbVotes:503870, title:"Pirates of the Caribbean: Dead Man's Chest", url:"https://themoviedb.org/movie/58", revenue:1065659812, tmdbId:"58", plot:"Jack Sparrow races to recover the heart of Davy Jones to avoid enslaving his soul to Jones' service, as other friends and foes seek the heart for their own agenda as well.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AdRQGfT05z6L9gIpUpkh4McMmpm.jpg", released:"2006-07-07", budget:200000000}}, {movieId:"45726", properties:{languages:["English"], year:2006, imdbId:"0463034", runtime:110, imdbRating:5.6, countries:["USA"], imdbVotes:67128, title:"You, Me and Dupree", url:"https://themoviedb.org/movie/1819", revenue:130431368, tmdbId:"1819", plot:"A best man (Wilson) stays on as a houseguest with the newlyweds, much to the couple's annoyance.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rtqbg1CKR4dFdmHxmsiM3u9n71I.jpg", released:"2006-07-14", budget:54000000}}, {movieId:"45728", properties:{languages:["English"], year:2006, imdbId:"0424345", runtime:97, imdbRating:7.4, countries:["USA"], imdbVotes:112485, title:"Clerks II", url:"https://themoviedb.org/movie/2295", revenue:26888376, tmdbId:"2295", plot:"A calamity at Dante and Randal's shops sends them looking for new horizons - but they ultimately settle at the fast food empire Mooby's.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qyI644vFgnITKgHouRQGvHe7e6i.jpg", released:"2006-07-21", budget:5000000}}, {movieId:"457