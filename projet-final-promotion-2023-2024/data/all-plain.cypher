UNWIND [{tmdbId:"12977", properties:{bornIn:"New York City, New York, USA", imdbId:"0948272", born:date('1967-09-17'), name:"Malik Yoba", bio:"Malik Yoba (born September 17, 1967) is an American actor and occasional singer. \n\nDescription above from the Wikipedia article Malik Yoba,licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/u3lvFmLNa0Nty4LkdwpbgfBFJiM.jpg", url:"https://themoviedb.org/person/12977"}}, {tmdbId:"5588", properties:{bornIn:"San Francisco, California, USA", imdbId:"0000224", born:date('1976-10-04'), name:"Alicia Silverstone", bio:"Alicia Silverstone ( born October 4, 1976) is an American actress, author, and former fashion model.  She first came to widespread attention in music videos for Aerosmith, and is perhaps best known for her roles in Hollywood films such as Clueless (1995) and her portrayal of Batgirl in Batman & Robin (1997)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pyxqkP4i0ubVdoRe5hoiiiwkHkb.jpg", url:"https://themoviedb.org/person/5588"}}, {tmdbId:"56978", properties:{bornIn:"Phoenix, Arizona, U.S.", imdbId:"0748075", born:date('1962-04-03'), name:"Jennifer Rubin", bio:"From Wikipedia, the free encyclopedia. \n\nJennifer Collene Rubin (born April 3, 1962) is an American actress and model.  Rubin has starred in film and on television. \n\nRubin was discovered by the Ford Modeling Agency.  In 1984 she was the Ford International Model of the Year.  She was the original model for Calvin Klein Obsession ads.  Jennifer was a competitive swimmer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/enQ5KyzGfUih9CNHjHQR5YulncP.jpg", url:"https://themoviedb.org/person/56978"}}, {tmdbId:"1379575", properties:{imdbId:"0273997", name:"Nancy Ferrara", url:"https://themoviedb.org/person/1379575"}}, {tmdbId:"14721", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0242656", born:date('1956-06-24'), name:"Kevin Dunn", bio:"Kevin Dunn (born August 24, 1956) is an American actor who has appeared in supporting roles in a number of films and television series since the 1980s...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5V5WZRoeCLMTTppfhsng1XFI9iR.jpg", url:"https://themoviedb.org/person/14721"}}, {tmdbId:"52474", properties:{bornIn:"San Diego, California, USA", imdbId:"0518715", born:date('1972-11-07'), name:"Jason London", bio:"Jason London is an American actor born on November 7, 1972 in San Diego, California.  He is the twin brother of actor Jeremy London...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bFkC2ZRcurTQzbjBuuMljFCKfEv.jpg", url:"https://themoviedb.org/person/52474"}}, {tmdbId:"16484", properties:{bornIn:"Little Rock, Arkansas, USA", imdbId:"0000725", born:date('1968-01-09'), name:"Joey Lauren Adams", bio:"Joey Lauren Adams (born January 9, 1968) is an American actress who has appeared in more than thirty films.  She is known for her distinctive, raspy voice and for her roles in View Askewniverse films, particularly Mallrats and Chasing Amy. \n\nDescription above from the Wikipedia article Joey Lauren Adams, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/deSGf1gAfmMX9ASmBd9z7rHeIGC.jpg", url:"https://themoviedb.org/person/16484"}}, {tmdbId:"586101", properties:{imdbId:"0028846", name:"Shawn Andrews", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hCraUjLKcMxNPqBZ7VxARdWatpZ.jpg", url:"https://themoviedb.org/person/586101"}}, {tmdbId:"15252", properties:{bornIn:"Chicago, Illinois, United States", imdbId:"0001253", born:date('1986-01-16'), name:"Mason Gamble", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AfsGExPF6QSS6TTaqys0vLs22eJ.jpg", url:"https://themoviedb.org/person/15252"}}, {tmdbId:"69924", properties:{bornIn:"Virginia Beach, Virginia, USA", imdbId:"0094581", born:date('1985-08-19'), name:"J. Evan Bonifant", bio:"​From Wikipedia, the free encyclopedia\n\nJ.  Evan Bonifant (born August 19, 1985) is an American actor. \n\nDescription above from the Wikipedia J.  Evan Bonifant, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/69924"}}, {tmdbId:"12932", properties:{bornIn:"New York City, New York, USA", imdbId:"0308241", born:date('1965-12-03'), name:"Barbara Garrick", url:"https://themoviedb.org/person/12932"}}, {tmdbId:"57552", properties:{bornIn:"Suffolk County, New York, USA", imdbId:"0357084", born:date('1954-12-07'), name:"Julie Halston", url:"https://themoviedb.org/person/57552"}}, {tmdbId:"1425154", properties:{imdbId:"0657747", name:"Robert Pall", url:"https://themoviedb.org/person/1425154"}}, {tmdbId:"58319", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0001462", born:date('1966-11-19'), name:"Jason Scott Lee", bio:"​From Wikipedia, the free encyclopedia.   \n\nJason Scott Lee (born November 19, 1966) is an American actor and martial artist. \n\nDescription above from the Wikipedia article Jason Scott Lee, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7jObZCM3diuPV0WlKkzOd4uE2CJ.jpg", url:"https://themoviedb.org/person/58319"}}, {tmdbId:"65101", properties:{bornIn:"Washington, D.C., USA", imdbId:"0495229", born:date('1939-04-09'), name:"Michael Learned", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wh36JKYO9vmyUNSqr7CZoyHcvXl.jpg", url:"https://themoviedb.org/person/65101"}}, {tmdbId:"135665", properties:{bornIn:"Nancy, Meurthe-et-Moselle, France", imdbId:"0053903", born:date('1961-05-06'), name:"Marc Barbé", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wx6mwxsSrAZj3PAg8PkUSAQlTbo.jpg", url:"https://themoviedb.org/person/135665"}}, {tmdbId:"262075", properties:{bornIn:"Boulogne-Billancourt, Hauts-de-Seine, France", imdbId:"0433564", born:date('1964-03-26'), name:"Julie Jézéquel", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gT8xNBN2xhP2JqN44qklXqUshHK.jpg", url:"https://themoviedb.org/person/262075"}}, {tmdbId:"1118225", properties:{imdbId:"0419951", name:"Valérie Jeannet", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n3PurPWHLFKAHBHxkcBheedfkCg.jpg", url:"https://themoviedb.org/person/1118225"}}, {tmdbId:"1432110", properties:{imdbId:"0092551", name:"Sarel Bok", url:"https://themoviedb.org/person/1432110"}}, {tmdbId:"33501", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0492924", born:date('1964-05-22'), name:"Mark Christopher Lawrence", bio:"​From Wikipedia, the free encyclopedia\n\nMark Christopher Lawrence (born May 22, 1964) is an American character actor, stand-up comedian and voice-over artist.  He is perhaps best known for his role as esoteric D. J. , Tone Deaf, in the 1994 satirical rap mockumentary, Fear of a Black Hat.  He has co-starred in popular films such as Terminator 2: Judgment Day, Planet of the Apes, Lost Treasure and The Pursuit of Happyness...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uQgXQbaDS0hoPyqUhs5Z97KIZPA.jpg", url:"https://themoviedb.org/person/33501"}}] AS row
