}}, {tmdbId:"58593", properties:{bornIn:"Toshima, Tokyo Prefecture, Japan", imdbId:"0793069", born:date('1981-08-15'), name:"Kou Shibasaki", bio:"​Kou Shibasaki  born Yukie Yamamura, on August 5, 1981 in Toshima, Tokyo, Japan, is a Japanese singer and actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5gwjKr7ixBqRKU79yiv2vPy4a9l.jpg", url:"https://themoviedb.org/person/58593"}}, {tmdbId:"50097", properties:{bornIn:"San Diego, California, USA", imdbId:"0123160", born:date('1974-10-21'), name:"Nakia Burrise", bio:"Nakia Burrise (born October 21, 1974 in San Diego, CA) is an American voice actress, singer and actress...", url:"https://themoviedb.org/person/50097"}}, {tmdbId:"2449175", properties:{name:"Betty Arthur", url:"https://themoviedb.org/person/2449175"}}, {tmdbId:"544746", properties:{imdbId:"4211514", name:"Moica", url:"https://themoviedb.org/person/544746"}}, {tmdbId:"762", properties:{bornIn:"Nazareth, Israel", imdbId:"1846124", born:date('1977-10-10'), name:"Ali Suliman", bio:"From Wikipedia, the free encyclopedia. \n\nAli Suliman (born 1977) is an Israeli Palestinian actor from Nazareth...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/r3ttMoDhWFrKzQ5QJzfHCUPg1pW.jpg", url:"https://themoviedb.org/person/762"}}, {tmdbId:"10112", properties:{bornIn:"Seoul, South Korea", imdbId:"0949167", born:date('1976-04-13'), name:"Yoo Ji-tae", bio:"Yoo Ji-tae (유지태) is a South Korean actor, film director, screenplay writer, and former fashion model.    He is married to actress Kim Hyo-jin...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3XsWi0daiIzeDwAndY6fu4OQe3F.jpg", url:"https://themoviedb.org/person/10112"}}, {tmdbId:"1299317", properties:{bornIn:"Incheon, South Korea", imdbId:"1367246", born:date('1982-01-04'), name:"Kang Hye-jung", bio:"Kang Hye-jung (강혜정) is a South Korean actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1MYnPxhU9GnhkitxVoWuR9kNiqu.jpg", url:"https://themoviedb.org/person/1299317"}}, {tmdbId:"77182", properties:{bornIn:"South Korea", imdbId:"1366028", born:date('1960-10-11'), name:"Kim Byung-ok", bio:"Kim Byung-ok (김병옥) is a South Korean actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jYSCldwyZ7LINk8ZUr1oPM2Nrq4.jpg", url:"https://themoviedb.org/person/77182"}}, {tmdbId:"1002044", properties:{imdbId:"0821519", name:"Antonin Stahly-Vishwanadan", url:"https://themoviedb.org/person/1002044"}}, {tmdbId:"163137", properties:{imdbId:"0060794", name:"Dennis Bateman", bio:"Dennis Bateman is an American voice actor best known for his performances in video games.  His most notable roles are the Spy and the Pyro in Team Fortress 2 and Invoker in Dota 2...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oF6coY0gelb42tDZ1zjCCgW2zgh.jpg", url:"https://themoviedb.org/person/163137"}}, {tmdbId:"237569", properties:{bornIn:"Hermosillo, Sonora, Mexico", imdbId:"0024227", born:date('1977-02-28'), name:"Rafael Amaya", bio:"From Wikipedia, the free encyclopedia. \n\nRafael Amaya (José Rafael Amaya Núñez, born February 28, 1977), is a Mexican model, singer, and actor. \n\nDescription above from the Wikipedia article Rafael Amaya, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5Nv2eZsMYkdZKqUU3alruMWa49v.jpg", url:"https://themoviedb.org/person/237569"}}, {tmdbId:"563568", properties:{imdbId:"2546830", name:"Jose Masegosa", url:"https://themoviedb.org/person/563568"}}, {tmdbId:"81852", properties:{bornIn:"Asahikawa, Hokkaido Prefecture, Japan", imdbId:"0031844", born:date('1936-06-19'), name:"Takeshi Aono", bio:"Aono Takeshi was a Japanese voice actor and actor affiliated with Aoni Production.  He is also known to gamers as the voice of the diabolical Dr.  Wily in the PlayStation-era Mega Man games...", died:date('2012-04-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e3IaulH39g31sTIZuiUsXXc5iZj.jpg", url:"https://themoviedb.org/person/81852"}}] AS row
