UNWIND [{tmdbId:"113641", properties:{imdbId:"0630083", name:"Dewey Nicks", url:"https://themoviedb.org/person/113641"}}, {tmdbId:"1039158", properties:{imdbId:"0036977", name:"Josh Aronson", url:"https://themoviedb.org/person/1039158"}}, {tmdbId:"933161", properties:{bornIn:"Rio de Janeiro, Rio de Janeiro, Brazil", imdbId:"0142461", born:date('1960-07-28'), name:"Luiz Fernando Carvalho", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ppxHaN61RAGxYbspmlnjUNyO842.jpg", url:"https://themoviedb.org/person/933161"}}, {tmdbId:"84931", properties:{bornIn:"New York City - New York - USA", imdbId:"0191147", born:date('1963-07-08'), name:"Michael Cuesta", bio:"Michael Cuesta is an American film and television director.  He received a BFA in photography from the School of Visual Arts in 1985...", url:"https://themoviedb.org/person/84931"}}, {tmdbId:"586015", properties:{imdbId:"0278705", name:"Laurent Firode", url:"https://themoviedb.org/person/586015"}}, {tmdbId:"21475", properties:{bornIn:"Chamberburg, Pennsylvania, USA", imdbId:"0003289", born:date('1961-07-27'), name:"John Putch", bio:"​From Wikipedia, the free encyclopedia.   \n\nJohn Putch (born July 27, 1961) is an American actor, director and screenwriter.  He is best known for his recurring role as Bob Morton on the 1980s sitcom One Day at a Time and as Sean Brody in the film Jaws 3-D. \n\nDescription above from the Wikipedia article John Putch, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jpOkJGMk07jkrQWZ6ep4uy4wQLs.jpg", url:"https://themoviedb.org/person/21475"}}, {tmdbId:"133635", properties:{imdbId:"0192289", born:date('1971-02-24'), name:"David L. Cunningham", bio:"From Wikipedia, the free encyclopedia. \n\nBorn in Switzerland (February 24, 1971) and raised in Kailua-Kona, Hawai'i, David Loren Cunningham is an international filmmaker.  Besides his documentary credits in more than 40 countries, Cunningham has also directed several feature films including To End All Wars (2001) and the TV miniseries The Path to 9/11 (2006).  Cunningham is represented by the United Talent Agency...", url:"https://themoviedb.org/person/133635"}}, {tmdbId:"22214", properties:{bornIn:"Shaker Heights, Ohio, USA", imdbId:"0906476", born:date('1969-08-01'), name:"David Wain", bio:"David Benjamin Wain (born August 1, 1969) is an American comedian, writer, actor and director.  He is most widely known for the feature films Role Models and Wet Hot American Summer, the 1990s' sketch comedy series The State and for directing the Adult Swim series Childrens Hospital.  Wain was a founding member of Stella, along with Michael Showalter and Michael Ian Black...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kdgFfZq8virxDE8FB9l54yoWptr.jpg", url:"https://themoviedb.org/person/22214"}}, {tmdbId:"119493", properties:{imdbId:"0031888", born:date('1964-07-13'), name:"Shinji Aoyama", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tQ4TtCpKAYfbv3InbdW66PTI6Hr.jpg", url:"https://themoviedb.org/person/119493"}}, {tmdbId:"143035", properties:{bornIn:" Shanghai, China", imdbId:"0945981", born:date('1947-11-06'), name:"Edward Yang", bio:"Edward Yang (Chinese: 楊德昌; pinyin: Yáng Déchāng; November 6, 1947 – June 29, 2007) was a Taiwanese filmmaker.  Yang, along with fellow auteurs Hou Hsiao-hsien and Tsai Ming-liang, was one of the leading film-makers of the Taiwanese New Wave and Taiwanese Cinema...", died:date('2007-06-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ziiIOHdtINX32KeVDHXnrGh0Nx4.jpg", url:"https://themoviedb.org/person/143035"}}, {tmdbId:"82335", properties:{imdbId:"0322144", name:"Richard Glatzer", url:"https://themoviedb.org/person/82335"}}, {tmdbId:"92935", properties:{imdbId:"0447437", name:"Don Kempf", url:"https://themoviedb.org/person/92935"}}, {tmdbId:"52159", properties:{imdbId:"0827726", name:" James D. Stern", bio:"​From Wikipedia, the free encyclopedia.   \n\nJames D.  Stern is an American film director and producer, and Broadway producer, and a member of the Producers Guild of America.  He won a 2003 Tony Award for \"Hairspray,\" has been nominated for many Tony awards, and was a Drama Desk Award Winner for \"Stomp. \"\n\nDescription above from the Wikipedia article James D.  Stern , licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/52159"}}, {tmdbId:"1573677", properties:{name:"Eric Hannah", url:"https://themoviedb.org/person/1573677"}}, {tmdbId:"117350", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0720411", born:date('1968-08-28'), name:"Dale Resteghini", bio:"From Wikipedia, the free encyclopedia. \n\nDale Anthony Resteghini (born Boston, Massachusetts on 28 August 1968) better known as Rage is a renowned music video director.  He is also a film director and music producer.  Rage has helmed hundreds of videos for well-known acts from the global superstars to the emerging acts to the niche branded and as alover of music he embraces all of them and sees each venture as a challenge and an experience...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dEaxVnJpQ4sEOBDFCRUMfeAe6AJ.jpg", url:"https://themoviedb.org/person/117350"}}, {tmdbId:"74881", properties:{bornIn:"United States", imdbId:"0881759", name:"Rocco Urbisci", bio:"From Wikipedia, the free encyclopedia\n\nRocco Urbisci is an American director, producer and film and television writer. \n\nUrbisci is best known for writing such films and television shows as Richard Pryor's Jo Jo Dancer, Your Life Is Calling, The Richard Pryor Show and the made for television sequel to The Jerk entitled The Jerk, Too with Mark Blankfield replacing Steve Martin in the lead...", url:"https://themoviedb.org/person/74881"}}, {tmdbId:"40312", properties:{bornIn:"Port-Au-Prince, Haiti", imdbId:"0669704", born:date('1953-09-09'), name:"Raoul Peck", bio:"Raoul Peck (born 1953) is a Haitian filmmaker, of both documentary and feature films, and a political activist.  From March 1996 to September 1997, he was Haiti's Minister of Culture...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6i2uGJwj2oNXLEj2FUOmg8sw1ME.jpg", url:"https://themoviedb.org/person/40312"}}, {tmdbId:"18903", properties:{bornIn:"Hamburg, Germany", imdbId:"0626686", born:date('1966-04-04'), name:"Sandra Nettelbeck", url:"https://themoviedb.org/person/18903"}}, {tmdbId:"50942", properties:{bornIn:"Kula, Hawaii, USA", imdbId:"0201304", born:date('1961-05-19'), name:"Gregory Poirier", bio:"From Wikipedia, the free encyclopedia\n\nGregory Stephen Poirier (born 19 May 1961) is an American screenwriter, director, and producer. \n\nPoirier was born in Kula, Maui, Hawaii.  He attended the Maui Academy of Performing Arts.  Poirier wrote the screenplay for the John Singleton film Rosewood (1997), for which he won the Writers Guild of America's Paul Selvin Award.  He also wrote the screenplay for the comedy See Spot Run, and wrote and directed the comedy Tomcats (2001)...", url:"https://themoviedb.org/person/50942"}}, {tmdbId:"30458", properties:{bornIn:"Philadelphia, Pennsylvania, USA", imdbId:"0063785", born:date('1945-08-03'), name:"Henry Bean", bio:"From Wikipedia, the free encyclopedia. \n\nHenry Bean (born 1945, Philadelphia, United States) is an American screenwriter, film director, producer, novelist, and actor. \n\nMost famous as a screenwriter, Bean wrote the screenplays for Internal Affairs, Deep Cover, Venus Rising, The Believer (which was awarded the dramatic Grand Jury Prize at the 2001 Sundance Festival), Basic Instinct 2 and Noise. \n\nBean acted in The Believer, and was a producer on Deep Cover and Noise...", url:"https://themoviedb.org/person/30458"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"114646", properties:{imdbId:"0891054", name:"Jesse Vaughan", url:"https://themoviedb.org/person/114646"}}, {tmdbId:"74907", properties:{bornIn:"Buenos Aires, Argentina", imdbId:"0081433", born:date('1959-02-03'), name:"Fabián Bielinsky", bio:"​From Wikipedia, the free encyclopedia. \n\nFabián Bielinsky (3 February 1959 – 29 June 2006) was an Argentine film director born in Buenos Aires...", died:date('2006-06-28'), url:"https://themoviedb.org/person/74907"}}, {tmdbId:"1036428", properties:{imdbId:"0365057", name:"Mark Jonathan Harris", url:"https://themoviedb.org/person/1036428"}}, {tmdbId:"30716", properties:{bornIn:"Nancy, France", imdbId:"0221591", born:date('1969-06-13'), name:"Virginie Despentes", bio:"Virginie Despentes is a French writer, novelist, and filmmaker.  Her work is an inventory of youth marginalization; it participates to the sexual revolution lived by Generation X and to the acclimation of pornography in public spaces through new communication techniques.  With a transgressive exploration of obscenity's limits, as a novelist or a film-maker she proposes social critique and an antidote to the new moral order...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9zb69HLOlFXHGzUtQ1W3ry8lBnv.jpg", url:"https://themoviedb.org/person/30716"}}, {tmdbId:"468", properties:{bornIn:"Dorset, England", imdbId:"0197636", born:date('1961-05-02'), name:"Stephen Daldry", bio:"From Wikipedia, the free encyclopedia\n\nStephen David Daldry, CBE (born 2 May 1961) is an English theatre and film director and producer, as well as a three-time Academy Award nominated and Tony Award winning director. \n\nDescription above from the Wikipedia article Stephen Daldry, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3nxFXIgMXhqU1aCOp7TOOEnhKCq.jpg", url:"https://themoviedb.org/person/468"}}, {tmdbId:"146811", properties:{imdbId:"0841504", name:"Miles Swain", url:"https://themoviedb.org/person/146811"}}, {tmdbId:"7832", properties:{bornIn:"Hamburg, Germany", imdbId:"0386570", born:date('1957-12-29'), name:"Oliver Hirschbiegel", bio:"Oliver Hirschbiegel (born 26 March 1957) is a German film director.  His works include Das Experiment and the Oscar nominated Der Untergang...", url:"https://themoviedb.org/person/7832"}}, {tmdbId:"36797", properties:{bornIn:"Sydney, New South Wales, Australia", imdbId:"0525659", born:date('1973-11-01'), name:"Robert Luketic", bio:"Robert Luketic is an Australian film and television director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dwescz6qnJ1zWeRLKQIL5X9zT9s.jpg", url:"https://themoviedb.org/person/36797"}}, {tmdbId:"61175", properties:{imdbId:"0925870", name:"John Whitesell", bio:"John Whitesell is an American film and television director...", url:"https://themoviedb.org/person/61175"}}, {tmdbId:"88743", properties:{bornIn:"Danbury, Connecticut, USA", imdbId:"0590889", born:date('1962-11-30'), name:"Daniel Minahan", bio:"Daniel Minahan is an American director and writer for film and television.  He has an BA in Film and Video from the School of Visual Arts in Manhattan, New York City...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zBRWTVYdZ77HT1zWpZtLXZ8AW1F.jpg", url:"https://themoviedb.org/person/88743"}}, {tmdbId:"33036", properties:{bornIn:"Marburg, Germany", imdbId:"0725345", born:date('1961-01-07'), name:"Roland Suso Richter", url:"https://themoviedb.org/person/33036"}}, {tmdbId:"16848", properties:{bornIn:" Haverhill, Massachusetts, United States", imdbId:"0957772", born:date('1965-01-12'), name:"Rob Zombie", bio:"From Wikipedia, the free encyclopedia. \n\nRob Zombie (born Robert Bartleh Cummings; January 12, 1965) is a musician, film director, screenwriter and film producer.  He founded the heavy metal band White Zombie and has been nominated three times as a solo artist for the Grammy Award for Best Metal Performance...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2LGOgBVEAqC2rStyY7ys0wHNbEs.jpg", url:"https://themoviedb.org/person/16848"}}, {tmdbId:"120685", properties:{imdbId:"0171122", name:"Lionel Coleman", url:"https://themoviedb.org/person/120685"}}, {tmdbId:"77883", properties:{imdbId:"0577332", name:"Jordan Melamed", url:"https://themoviedb.org/person/77883"}}, {tmdbId:"222506", properties:{imdbId:"0213529", name:"Lieven Debrauwer", url:"https://themoviedb.org/person/222506"}}, {tmdbId:"115892", properties:{bornIn:"Washington, DC, US", imdbId:"0636675", born:date('1974-05-17'), name:" Jehane Noujaim", bio:"From Wikipedia, the free encyclopedia. \n\nJehane Noujaim is an Egyptian American documentary film director best-known for her films Control Room, Startup. com and Pangea Day...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tzuPRUermMYuUUfcdNrvGC2Eq70.jpg", url:"https://themoviedb.org/person/115892"}}, {tmdbId:"58518", properties:{imdbId:"0370912", name:"Blair Hayes", url:"https://themoviedb.org/person/58518"}}, {tmdbId:"17700", properties:{bornIn:"Würzburg, Germany", imdbId:"0959255", born:date('1973-08-27'), name:"Christian Zübert", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3E3TvkH67WMde0PUBJf5Pt8xxaP.jpg", url:"https://themoviedb.org/person/17700"}}, {tmdbId:"1122422", properties:{imdbId:"0256340", name:"Robert J. Emery", url:"https://themoviedb.org/person/1122422"}}, {tmdbId:"54644", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0959034", born:date('1942-01-11'), name:"Joel Zwick", bio:"From Wikipedia, the free encyclopedia\n\nJoel Zwick (born January 11, 1942) is an American film, television and theatre director.  He is best known for his work on Perfect Strangers, Full House, Family Matters and well as directing the films My Big Fat Greek Wedding and Fat Albert. \n\nBorn in Brooklyn, New York, he was educated at Brooklyn College.  He directed twenty-one pilots, all of which went on to have successful runs as weekly series...", url:"https://themoviedb.org/person/54644"}}] AS row
