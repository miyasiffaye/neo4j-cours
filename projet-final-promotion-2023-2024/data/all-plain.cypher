UNWIND [{tmdbId:"94600", properties:{imdbId:"1018068", name:"Pia Glenn", url:"https://themoviedb.org/person/94600"}}, {tmdbId:"17193", properties:{imdbId:"1364079", name:"Adam Mucci", bio:"Adam Mucci is actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mrIKObgW4nqnnormeKYtNIijyX6.jpg", url:"https://themoviedb.org/person/17193"}}, {tmdbId:"147445", properties:{bornIn:"New Jersey", born:date('1974-06-26'), name:"Derek Jeter", bio:"From Wikipedia, the free encyclopedia. \n\nDerek Sanderson Jeter (born June 26, 1974) is a Major League Baseball (MLB) shortstop who has played his entire career for the New York Yankees.  He has served as the Yankees' team captain since 2003.  Jeter's presence in the Yankees' lineup, highlighted by his hitting prowess, played an instrumental role in the team's late 1990s dynasty...", url:"https://themoviedb.org/person/147445"}}, {tmdbId:"109434", properties:{bornIn:"Qingdao, Shandong Province, China", imdbId:"2119781", born:date('1977-11-13'), name:"Xiaoming Huang", bio:"A Chinese actor, singer, and model.  He graduated from the Performance Institute of the Beijing Film Academy in 2000.  Huang first rose to prominence in 2001 for playing Emperor Wu of Han in the television series The Prince of Han Dynasty.  In 2007, Huang signed a contract with Huayi Brothers and began focusing on his film career, appearing in films like The Sniper (2009), The Message (2010), and Sacrifice (2010)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eIC3tenhlbFtaGnFXhta7e25avQ.jpg", url:"https://themoviedb.org/person/109434"}}, {tmdbId:"117760", properties:{bornIn:"Nanjing, Jiangsu, China", imdbId:"3237713", born:date('1981-10-10'), name:"Lynn Hung", bio:"Lynn Hung (Chinese: 熊黛林, Mandarin Pinyin: Xióng Dàilín; Jyutping: Hung4 Doi6-lam4; born 10 October 1980), sometimes credited as her birth name Xiong Dailin, is a Chinese model and actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jSLg8PqxdwDWfCChU2RG0B6HmCX.jpg", url:"https://themoviedb.org/person/117760"}}, {tmdbId:"234398", properties:{imdbId:"4198233", name:"Mark Hogancamp", url:"https://themoviedb.org/person/234398"}}, {tmdbId:"2277352", properties:{name:"Emmanuel Nneji", url:"https://themoviedb.org/person/2277352"}}, {tmdbId:"2277353", properties:{name:"Edda Hogancamp", url:"https://themoviedb.org/person/2277353"}}, {tmdbId:"2277354", properties:{name:"Tom Neubauer", url:"https://themoviedb.org/person/2277354"}}, {tmdbId:"530025", properties:{bornIn:"Albuquerque, New Mexico, USA", imdbId:"3094377", born:date('2000-06-01'), name:"Willow Shields", bio:"Willow Shields (born June 1, 2000 in Albuquerque, New Mexico) is an American film and television actress.  Her first television role was a guest appearance in the USA series In Plain Sight (2008), which was filmed in her hometown of Albuquerque, but she is best known for her role of Primrose Everdeen in The Hunger Games and the sequel The Hunger Games: Catching Fire...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c9Zna579entVQBdx7kTtKJjl9CB.jpg", url:"https://themoviedb.org/person/530025"}}, {tmdbId:"82639", properties:{bornIn:"London, England, UK", imdbId:"1166041", born:date('1986-02-19'), name:"Ophelia Lovibond", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/teFj3YHrHMANYVSg5t1ep8xUZI4.jpg", url:"https://themoviedb.org/person/82639"}}, {tmdbId:"65225", properties:{bornIn:"Garden Grove, California, USA", imdbId:"2014390", born:date('1981-05-29'), name:"Justin Chon", bio:"Justin Jitae Chon (born May 29, 1981) is an American actor, director, and YouTube personality.  He has directed two films Gook (2017) and Ms.  Purple (2019).  He is also known for portraying Eric Yorkie in The Twilight Saga film series.  He is a member of the K-pop parody group Boys Generally Asian...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ymFUjGfD62YonoRANZx6qvBkb9t.jpg", url:"https://themoviedb.org/person/65225"}}, {tmdbId:"502608", properties:{imdbId:"3661913", name:"Kevin Wu", url:"https://themoviedb.org/person/502608"}}, {tmdbId:"232499", properties:{bornIn:"Puerto Limón, Costa Rica", imdbId:"1484270", born:date('1982-04-28'), name:"Harry Shum Jr.", bio:"Harry Shum Jr.  was born on April 28, 1982 in Puerto Limón, Costa Rica.  He is an actor, known for Glee (2009), Street Dance (2008) and Crouching Tiger, Hidden Dragon: Sword of Destiny (2016).  He has been married to Shelby Rabara since November 22, 2015.  Height 5' 11\" (1,8 m).  He speaks English, Spanish and Chinese.  Has two older sisters, Susana and Cristina.  He was born in Puerto Limón, Costa Rica, to Chinese parents.  His father is from Guangzhou and his mother is from Hong Kong...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8n9Q0SUALJUFTVW57Kp9LqDPGOK.jpg", url:"https://themoviedb.org/person/232499"}}, {tmdbId:"113948", properties:{imdbId:"1067699", name:"Eugenia Yuan", bio:"From Wikipedia, the free encyclopedia. \n\nEugenia Yuan (born Eugenia Yuen Lai-Kei) is an actress. \n\nDescription above from the Wikipedia article Eugenia Yuan, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/113948"}}, {tmdbId:"142194", properties:{bornIn:"Minnesota, USA", imdbId:"2818689", born:date('1929-12-17'), name:"Jack Rebney", url:"https://themoviedb.org/person/142194"}}, {tmdbId:"115252", properties:{imdbId:"1264904", name:"Nick Prueher", url:"https://themoviedb.org/person/115252"}}, {tmdbId:"1371398", properties:{bornIn:"Compton, California, USA", imdbId:"6578009", born:date('1991-02-24'), name:"O'Shea Jackson Jr.", bio:"O'Shea Jackson, Jr.  (born February 24, 1991), also known as OMG, is an American rapper and actor.  Jackson is the son of rapper and actor Ice Cube, and he portrayed his father in the 2015 biopic Straight Outta Compton. \n\nJackson was born in Compton, California, to O'Shea Jackson, better known as Ice Cube, and Kimberly Woodruff.  He has two brothers, Darryl and Sharif, and a sister Kareema...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zov23iUpL3QFHqzjdtzrBGOQYaF.jpg", url:"https://themoviedb.org/person/1371398"}}, {tmdbId:"1154054", properties:{bornIn:"Arlington, Texas, USA", imdbId:"3659660", born:date('1988-10-22'), name:"Corey Hawkins", bio:"Corey Hawkins (born October 22, 1988) is an American actor.  He is perhaps best known for playing Dr.  Dre in the 2015 biopic film, Straight Outta Compton. \n\nHawkins was born in Washington, D. C.  where he attended the Duke Ellington School of the Arts.  He graduated from the Juilliard School in New York City, a member of the Drama Division's Group 40.  While studying at Juilliard, Hawkins received the prestigious John Houseman Award for excellence in classical theatre...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wG67YtOmB4PkjgK6OKKbzy48pdk.jpg", url:"https://themoviedb.org/person/1154054"}}, {tmdbId:"1115984", properties:{bornIn:"New Orleans, Louisiana, USA", imdbId:"4207146", born:date('1987-01-01'), name:"Jason Mitchell", bio:"Jason Mitchell is an American actor.  He is best known for portraying Eazy-E in the 2015 biopic Straight Outta Compton. \n\nMitchell had roles in the films Contraband and Broken City, both of which starred Mark Wahlberg.  In 2015, Mitchell played Compton rapper Eazy-E in the biopic Straight Outta Compton, with his performance being met with general praise by critics. \n\nDescription above from the Wikipedia article Jason Mitchell, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/A8tLaFFkPoiDdYL9GcZ9KZyUB9P.jpg", url:"https://themoviedb.org/person/1115984"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"55091", properties:{bornIn:"Orlando, Florida, USA", imdbId:"0112932", born:date('1980-06-19'), name:"Neil Brown Jr.", bio:"Cornelius C.  \"Neil\" Brown, Jr.  (born June 19, 1980) is an American actor.  His most recognizable role may be in the television series The Walking Dead as Guillermo, leader of the Vatos and as Felix on the short-lived South Beach on the former UPN.  He also played DJ Yella in the 2015 biopic, Straight Outta Compton. \n\nBrown was born in Orlando, Florida, to Cornelius Brown, a US Marine, and Carrie Brown, an insurance underwriter...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z5oYLrCNGh48EoRQYqyIklYiCs9.jpg", url:"https://themoviedb.org/person/55091"}}, {tmdbId:"236048", properties:{bornIn:"Plymouth, Devon, England, UK", imdbId:"2492819", born:date('1987-04-18'), name:"Rosie Huntington-Whiteley", bio:"Rosie Alice Huntington-Whiteley was born 18 April 1987 in Plymouth, Devon, England (Freedom Fields Hospital), and grew up on her parents' country farm.  She attended Tavistock College and has been modeling since 2003 for a variety of clothiers: Abercrombie &amp; Fitch, Burberry, Bloomingdale's, Ralph Lauren, DKNY.  She started modeling for Victoria's Secret in 2006 and was officially named one of the lingerie company's \"Angels\" in November 2009, at the age of 22...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uVL2iW7wjkc0hklI5ANosBINOfh.jpg", url:"https://themoviedb.org/person/236048"}}, {tmdbId:"1163717", properties:{imdbId:"3493212", name:"Isaiah Stone", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xoOFTn5wpqxKv6cnPtAv4Xs36G7.jpg", url:"https://themoviedb.org/person/1163717"}}, {tmdbId:"1163718", properties:{imdbId:"2988909", name:"Ashlee Thompson", url:"https://themoviedb.org/person/1163718"}}, {tmdbId:"1163719", properties:{imdbId:"3518149", name:"Valerie Richards", url:"https://themoviedb.org/person/1163719"}}, {tmdbId:"124870", properties:{imdbId:"2762369", name:"Onni Tommila", url:"https://themoviedb.org/person/124870"}}, {tmdbId:"148012", properties:{imdbId:"0866918", born:date('1959-01-01'), name:"Jorma Tommila", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7LZucNIQv61JtDoPl5UEwEHuCl1.jpg", url:"https://themoviedb.org/person/148012"}}, {tmdbId:"93004", properties:{bornIn:"Helsinki, Finland", imdbId:"0466636", born:date('1968-08-23'), name:"Tommi Korpela", bio:"Tommi Korpela is a Finnish actor and screenwriter.  Best known for his roles in Man's Job (2007),  Rare Exports: A Christmas Tale (2010), Distractions (2015) and Eternal Road (2017).  He has won Jussi Award (Finnish equivalent of the Oscars) for Best Actor three times in 2008, 2009 and 2015. \n\nKorpela graduated from Helsinki Theatre Academy in 1995...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iGJ7vZCvYOBqmU2lXioSNj7jA9m.jpg", url:"https://themoviedb.org/person/93004"}}, {tmdbId:"148383", properties:{imdbId:"0433340", name:"Rauno Juvonen", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oBxJNqd4PQYcipXoVjjquknigyK.jpg", url:"https://themoviedb.org/person/148383"}}, {tmdbId:"202949", properties:{name:"Devin Brochu", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/26B90vvYOu3NG8FGpTvU0Y6uz8O.jpg", url:"https://themoviedb.org/person/202949"}}, {tmdbId:"130640", properties:{bornIn:"Tarzana, Los Angeles, California, USA", imdbId:"2794962", born:date('1996-12-11'), name:"Hailee Steinfeld", bio:"Hailee Steinfeld (born December 11, 1996) is an American actress.  She rose to fame for her portrayal of Mattie Ross in the 2010 film True Grit, for which she was nominated for an Academy Award for Best Supporting Actress and a BAFTA Award for Best Actress in a Leading Role.  Steinfeld was born in Tarzana, Los Angeles, the daughter of Cheri (née Domasin), an interior designer, and Peter Steinfeld, a personal fitness trainer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2kmc19zJpo87sGC4PXObdllMqCS.jpg", url:"https://themoviedb.org/person/130640"}}, {tmdbId:"1539168", properties:{imdbId:"2765716", name:"Moisés Acevedo", url:"https://themoviedb.org/person/1539168"}}, {tmdbId:"2191245", properties:{name:"Kevin P. McCarthy", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lA1BLiEhA3lbdxaVpa3GlgxuLNO.jpg", url:"https://themoviedb.org/person/2191245"}}, {tmdbId:"94769", properties:{bornIn:" St. Paul, Minnesota, USA", imdbId:"2431639", born:date('1986-09-04'), name:"Kevin M. Horton", bio:"Actor / Performer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gHwYh8NbxKZBtLPoCtFxTjppuiP.jpg", url:"https://themoviedb.org/person/94769"}}, {tmdbId:"94906", properties:{imdbId:"2799927", born:date('1987-04-13'), name:"Brandon Hardesty", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iXIvwwjIwv2RHcGlszvT3B6qGkZ.jpg", url:"https://themoviedb.org/person/94906"}}, {tmdbId:"25544", properties:{bornIn:"Cleveland, Ohio, USA", imdbId:"0681782", born:date('1954-10-26'), name:"James Pickens Jr.", bio:"James Pickens, Jr.  (born October 26, 1954) is an American actor.  He is best known for his starring role as Dr.  Richard Webber on the ABC drama television series Grey's Anatomy, and for his supporting role as Deputy Director Alvin Kersh on later seasons of the Fox Network science fiction series The X-Files. \n\nDescription above from the Wikipedia article James Pickens, Jr. , licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iddDcaysDQ6IVMUjJ97Bv3lTBCu.jpg", url:"https://themoviedb.org/person/25544"}}, {tmdbId:"78429", properties:{bornIn:"Hong Kong", imdbId:"0387319", born:date('1974-12-26'), name:"Josie Ho", bio:"Josephine \"Josie\" Ho Chiu-yi (Chinese: 何超儀)) is a singer and actress from Hong Kong...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v835PjfpHAId1suZ1LNRj2Cr5fJ.jpg", url:"https://themoviedb.org/person/78429"}}, {tmdbId:"142646", properties:{bornIn:"Hong Kong", imdbId:"1474034", born:date('1984-03-18'), name:"Juno Mak", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kd0wBTsKDtFRNRMSmXGGTHEwkaG.jpg", url:"https://themoviedb.org/person/142646"}}, {tmdbId:"87621", properties:{bornIn:"Hong Kong", imdbId:"0150873", born:date('1974-07-27'), name:"Eason Chan", bio:"Eason Chan Yik-shun is a prominent male singer in Hong Kong's music industry.  Undoubtedly one of the most dominant male singers in the post-1997 era of Hong Kong music industry.  Eason Chan has been praised by Time magazine as a front runner in the next generation of Cantopop. He is considered by some to be Hong Kong's third \"god of song\" after Samuel Hui and Jacky Cheung. \n\nHis Cantonese album U87 was nominated by Time Magazine as \"Five Asian Albums Worth Buying\" in 2005...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5YsJineA7klOboJPd2QKrL3Fzmd.jpg", url:"https://themoviedb.org/person/87621"}}, {tmdbId:"144212", properties:{imdbId:"3199366", name:"Manuel Vignau", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qwfQQlUfBXWPmqallGLdXStIFEk.jpg", url:"https://themoviedb.org/person/144212"}}] AS row
