UNWIND [{tmdbId:"76337", properties:{imdbId:"1132005", name:"Magnus Börjeson", url:"https://themoviedb.org/person/76337"}}, {tmdbId:"1038989", properties:{name:"Marcus Boij", url:"https://themoviedb.org/person/1038989"}}, {tmdbId:"110927", properties:{bornIn:"Baltimore, Maryland, USA", imdbId:"0046112", born:date('1986-11-01'), name:"Penn Badgley", bio:"​From Wikipedia, the free encyclopedia\n\nPenn Dayton Badgley (born November 1, 1986) is an American actor.  He is best known for his role as Dan Humphrey on the CW television series Gossip Girl.  He has also starred in the movies John Tucker Must Die, The Stepfather, and Easy A. \n\nDescription above from the Wikipedia article Penn Badgley, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cWvqsJyD8wLZ9GXs2DqqepBIfdD.jpg", url:"https://themoviedb.org/person/110927"}}, {tmdbId:"66446", properties:{bornIn:"London - England - UK", imdbId:"0700577", born:date('1977-12-30'), name:"Lucy Punch", bio:"From Wikipedia, the free encyclopedia. \n\nLucy Punch (born 30 December 1977, height 5' 8\" (1,73 m)) is an English actress, best known for her roles in both the television show Doc Martin on ITV as receptionist Elaine Denham and for her starring role in the American programme The Class as Holly Ellenbogen, on CBS, and also in the film Hot Fuzz as Eve Draper...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pKtknCumEFIT4v3BxNT1I7xx2ub.jpg", url:"https://themoviedb.org/person/66446"}}, {tmdbId:"135851", properties:{bornIn:"Ann Arbor, Michigan, USA", imdbId:"3728884", born:date('1976-03-18'), name:"Bryan Barter", bio:"Bryan Barter was born on March 18, 1976 in Ann Arbor, Michigan, USA.  He is an actor, known for The Social Network (2010), Arn: The Knight Templar (2007) and Duke (2013)...", url:"https://themoviedb.org/person/135851"}}, {tmdbId:"115406", properties:{bornIn:"Sterling, Colorado, USA", imdbId:"2951481", born:date('1986-12-16'), name:"Dustin Fitzsimons", bio:"From wikipedia. org Dustin Began his career in 2008 after making several appearances in Little Caesars commercials that began airing across the country.  His unique acting style and sense of humor coupled with an all American look quickly opened doors for him in the film and television world.  Once Dustin began Landing roles in Independent features such as Street Racer (film) and House of the Wolf Man Hollywood's mainstream entertainment executives began to take notice...", url:"https://themoviedb.org/person/115406"}}, {tmdbId:"77865", properties:{bornIn:"Brockville, Ontario, Canada", imdbId:"2618951", born:date('1984-09-07'), name:"Benjamin Hollingsworth", bio:"From Wikipedia, the free encyclopedia. \n\nBen Hollingsworth (born September 7, 1984) is a Canadian actor. \n\nHe was born in Brockville, Ontario and attended St.  Peter's Secondary School in Peterborough.  After graduating from high school he enrolled at the National Theatre School of Canada. \n\nDescription above from the Wikipedia article Ben Hollingsworth(actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dMdirwBs4sabtidUHRS1dLZ6l8P.jpg", url:"https://themoviedb.org/person/77865"}}, {tmdbId:"74442", properties:{bornIn:"Camden, London, England", imdbId:"1785575", born:date('1985-05-06'), name:"Jaime Winstone", bio:"British actress, daughter of actor Ray Winstone...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/66YHmcXmxjFABJfoWKwg0iEMcwS.jpg", url:"https://themoviedb.org/person/74442"}}, {tmdbId:"66981", properties:{imdbId:"1735332", born:date('1976-08-13'), name:"Özge Özberk", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/k1OOHHJEWlDGrtpFmB3Fx3YKxbB.jpg", url:"https://themoviedb.org/person/66981"}}, {tmdbId:"106786", properties:{bornIn:"Kars, Turkey", imdbId:"0019338", born:date('1961-08-30'), name:"Zafer Algöz", bio:"(d.  1961 - Kars) Türk tiyatro, sinema ve dizi oyuncusu.   1975 sezonunda Bursa Devlet Tiyatrosu'nda açılan \"Gençlik Kursları\" ile tiyatro eğitimi alan sanatçı, 1980 yılında Ankara Devlet Konservatuvarı Tiyatro Bölümünü kazandı.  1985 yılında mezun olup, aynı yıl Bursa Devlet Tiyatrosu'nda sanat yaşamına başladı.   1989 yılında İstanbul Devlet Tiyatroları'na tayin olan Algöz, birçok oyunda rol aldı, dizi ve sinema filmleri çevirdi.  İstanbul Devlet Tiyatroları'nda oyuncu olarak çalışmaktadır...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jjik4a0WLr2MRxWyGOs5sVgrU2p.jpg", url:"https://themoviedb.org/person/106786"}}, {tmdbId:"83456", properties:{bornIn:"San Mateo - California - USA", imdbId:"0873998", born:date('1970-06-22'), name:"Michael Trucco", bio:"​From Wikipedia, the free encyclopedia.   \n\nEdward Michael Trucco (born June 22, 1970) is an American actor with Italian roots.  He is best known for his role as Samuel T.  Anders on the reimagined Battlestar Galactica and currently appears as a series regular on the USA Network television series Fairly Legal. ...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mMWC3Qz5Ju18OQ5kYnJ4Jjshncc.jpg", url:"https://themoviedb.org/person/83456"}}, {tmdbId:"77209", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0661825", born:date('1974-03-14'), name:"Grace Park", bio:"Grace Park (born March 14, 1974) is an American-born Canadian actress.  She originally gained recognition as Sharon Valerii on Battlestar Galactica, as well as Shannon Ng in the Canadian television series teen soap Edgemont.  Park plays detective Kona \"Kono\" Kalakaua in CBS' remake of Hawaii Five-0, which debuted September 20, 2010 on CBS. \n\nDescription above from the Wikipedia article Grace Park (actress), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ojVQCgxZc2PeDchwsi3Vfq9m7fo.jpg", url:"https://themoviedb.org/person/77209"}}, {tmdbId:"54758", properties:{bornIn:"New York City", imdbId:"1906802", born:date('1959-08-17'), name:"Eric Schlosser", bio:"From Wikipedia, the free encyclopedia. \n\nEric Schlosser (born August 17, 1959) is an American journalist and author known for investigative journalism, such as in his books Fast Food Nation, Reefer Madness and Chew On This. \n\nDescription above from the Wikipedia article Eric Schlosser, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/54758"}}, {tmdbId:"1532950", properties:{imdbId:"3921128", name:"Richard Lobb", url:"https://themoviedb.org/person/1532950"}}, {tmdbId:"1532954", properties:{imdbId:"3920970", name:"Carole Morison", url:"https://themoviedb.org/person/1532954"}}, {tmdbId:"1254308", properties:{imdbId:"3186552", name:"Eamon Pirruccello", url:"https://themoviedb.org/person/1254308"}}, {tmdbId:"2405431", properties:{name:"Jeong-hie Yun", url:"https://themoviedb.org/person/2405431"}}, {tmdbId:"557133", properties:{bornIn:"Incheon - South Korea", imdbId:"3752295", born:date('1994-03-03'), name:"Da-wit Lee", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rVthkQ4WekEpD3DUEf8eJLjpSVw.jpg", url:"https://themoviedb.org/person/557133"}}, {tmdbId:"557132", properties:{bornIn:"Seoul, South Korea", imdbId:"0453472", born:date('1947-03-23'), name:"Hira Kim", bio:"Kim Hee-ra is a South Korean stage, film and television actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1Ejw1rAY1Kx3zl2rpjV3K15Zk9a.jpg", url:"https://themoviedb.org/person/557132"}}, {tmdbId:"1240487", properties:{bornIn:"Sea Cliff, New York, USA", imdbId:"0571952", born:date('1984-01-06'), name:"Kate McKinnon", bio:"Kathryn McKinnon Berthold (born January 6, 1984), known professionally as Kate McKinnon, is an American actress, voice actress, and comedian.  She is best known for her sketch comedy work as a cast member on Saturday Night Live and The Big Gay Sketch Show.  She played Jillian Holtzmann in the reboot of Ghostbusters (2016). \n\nMcKinnon is known for her strong character work and celebrity impressions...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/e4HLCYn0Hnl272TUjyTJLlJp6EV.jpg", url:"https://themoviedb.org/person/1240487"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"55536", properties:{bornIn:"Plainfield, Illinois, USA", imdbId:"0565250", born:date('1970-08-26'), name:"Melissa McCarthy", bio:"Melissa McCarthy (born August 26, 1970) is an American actress known most for her portrayal of chef Sookie St.  James, Lorelai Gilmore's best friend, on the television series Gilmore Girls, and currently as the title character Molly Flynn on the CBS sitcom Mike &amp; Molly. \n\nDescription above from the Wikipedia article Melissa McCarthy, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nRNMJlqR33j84cGdB0RxstV3NYm.jpg", url:"https://themoviedb.org/person/55536"}}, {tmdbId:"64295", properties:{bornIn:"Grand Forks, North Dakota, USA", imdbId:"2024927", born:date('1982-11-28'), name:"Alan Ritchson", bio:"Alan Michael Ritchson is an American actor, model, and singer.  He is known for his modeling career as well as his portrayals of the superhero Aquaman on The CW's Smallville and Thad Castle on Spike TV's Blue Mountain State. \n\nRitchson also starred as Gloss in 2013's The Hunger Games: Catching Fire and Raphael in 2014's Teenage Mutant Ninja Turtles reboot...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hY8UFnFb4j5ghpYvDdMOVSJ4tOD.jpg", url:"https://themoviedb.org/person/64295"}}, {tmdbId:"83724", properties:{imdbId:"0958420", name:"Eric Zuckerman", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gFmJnYDhTAGPatMgZioxPr9vbOo.jpg", url:"https://themoviedb.org/person/83724"}}, {tmdbId:"221581", properties:{bornIn:"Sydney, New South Wales, Australia", imdbId:"2313103", born:date('1980-03-02'), name:"Rebel Wilson", bio:"Rebel Melanie Elizabeth Wilson (born March 2, 1980) is an Australian actress, comedian, writer, and producer.  After graduating from the Australian Theatre for Young People in 2003, she began appearing as Toula in the Special Broadcasting Service (SBS) comedy series Pizza (2003–2007; 2019), and subsequently appeared in the sketch comedy series The Wedge (2006–2007).  Wilson wrote, produced and starred in the musical comedy series Bogan Pride (2008)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yuyRg1WaY616Uux3vP9ONsUjQTS.jpg", url:"https://themoviedb.org/person/221581"}}, {tmdbId:"96066", properties:{bornIn:"Melbourne, Victoria, Australia", imdbId:"2955013", born:date('1990-01-13'), name:"Liam Hemsworth", bio:"Liam Hemsworth (born 13 January 1990)  is an Australian actor.  He took the role of Josh Taylor in the soap opera Neighbours and as \"Marcus\" on the children's television series The Elephant Princess and appeared in the American film The Last Song, released on 31 March 2010.  Hemsworth's elder brothers, Luke and Chris, are also actors and provided a path for Hemsworth to emulate...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/k0bOCnDojVCHSD3gkAVbeByjLGp.jpg", url:"https://themoviedb.org/person/96066"}}, {tmdbId:"60272", properties:{imdbId:"0164682", born:date('1957-11-06'), name:"Cam Clarke", url:"https://themoviedb.org/person/60272"}}, {tmdbId:"154684", properties:{imdbId:"0283627", name:"Siobhan Flynn", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zNUfrjVBeHt1P4km53AzxSZRWIJ.jpg", url:"https://themoviedb.org/person/154684"}}, {tmdbId:"49735", properties:{bornIn:"Dublin, Ireland", imdbId:"0318821", born:date('1968-04-24'), name:"Aidan Gillen", bio:"Aidan Gillen (born Aidan Murphy on 24 April 1968) is an Irish stage and screen actor, best known in the UK for his role as Stuart Jones in the ground-breaking Channel 4 television series Queer as Folk.  He is perhaps best known to US audiences for his role in HBO's television series The Wire in which he plays Tommy Carcetti and for his role as Petyr Baelish in the HBO series Game of Thrones...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ju5ho6nnwOQ2QLGLnDP9yOZhGpb.jpg", url:"https://themoviedb.org/person/49735"}}, {tmdbId:"229696", properties:{imdbId:"3141070", name:"Ella Connolly", url:"https://themoviedb.org/person/229696"}}, {tmdbId:"82452", properties:{imdbId:"2156892", name:"Driss Ramdi", url:"https://themoviedb.org/person/82452"}}, {tmdbId:"87588", properties:{bornIn:"San Pedro Sula, Honduras", imdbId:"0578788", born:date('1967-10-22'), name:"Carlos Mencia", bio:"Ned Arnel Mencia (born October 22, 1967), known professionally as Carlos Mencia is a Honduran-born American comedian, writer, and actor.  His style of comedy is often political and involves issues of race, culture,  criminal justice, and social class.  He is best known as the host of the Comedy Central show Mind of Mencia which produced four seasons before being cancelled in 2008...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fPxfQcGw6iu31UYk0qLtczQ3H9i.jpg", url:"https://themoviedb.org/person/87588"}}, {tmdbId:"78197", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"0363699", born:date('1979-05-26'), name:"Elisabeth Harnois", bio:"Elisabeth Harnois (born May 26, 1979) is an American television and film actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yq9H8T5urAGhzvEBxbw4gBjvDN2.jpg", url:"https://themoviedb.org/person/78197"}}, {tmdbId:"94605", properties:{imdbId:"1603403", name:"Keith Jordan", bio:"From Wikipedia, the free encyclopedia\n\nKeith Jordan is an American actor who has starred in such films as Suburban Girl, The Adventures of Young Van Helsing: The Quest for the Lost Scepter, and Make the Yuletide Gay. \n\nJordan has also appeared in a sketch on Late Night with Conan O'Brien. \n\nHe is producing and starring in a web series entitled \"Walking in LA\"\n\nDescription above from the Wikipedia article Keith Jordan, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/94605"}}, {tmdbId:"124843", properties:{imdbId:"2476978", name:"Wyatt Fenner", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/y7fdpU5JT2noNIiDgd21vklsXNE.jpg", url:"https://themoviedb.org/person/124843"}}, {tmdbId:"84173", properties:{bornIn:"Livonia, Michigan, USA", imdbId:"1206539", born:date('1967-08-08'), name:"Steve Callahan", url:"https://themoviedb.org/person/84173"}}, {tmdbId:"94604", properties:{bornIn:"Mississauga, Ontario, Canada", imdbId:"1258362", born:date('1986-06-09'), name:"Adamo Ruggiero", bio:"From Wikipedia, the free encyclopedia\n\nAdamo Angelo Ruggiero (born June 9, 1986) is an Italian-Canadian actor best known for his role of Marco Del Rossi in Degrassi: The Next Generation. \n\nDescription above from the Wikipedia article Adamo Ruggiero, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/94604"}}, {tmdbId:"968350", properties:{bornIn:"Buenos Aires, Argentina", imdbId:"3587952", born:date('1988-04-23'), name:"Carla Quevedo", bio:"Carla Quevedo (born April 23, 1988) is an Argentine actress and designer.  She is most known for her role on the film The Secret in Their Eyes, in which she played Liliana Coloto. \n\n Her acting debut was in the year 2009 in Argentina film directed by Juan José Campanella, The Secret in Their Eyes, winner of the Academy Award for Best Foreign Language Film.  It also stars Ricardo Darín, Soledad Villamil, Pablo Rago, and Guillermo Francella...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wnuYt4wGwnDxSbSfxLmyxMkpmB3.jpg", url:"https://themoviedb.org/person/968350"}}, {tmdbId:"93648", properties:{bornIn:"Buenos Aires, Argentina", imdbId:"0706567", born:date('1972-09-24'), name:"Pablo Rago", bio:"From Wikipedia, the free encyclopedia. \n\nPablo Rago (Buenos Aires, September 24, 1972) is an Argentine actor.  He has acted in the movies The Official Story and The Secret in Their Eyes, two Argentine movies that have both won Oscar awards, as well as many other local movies and productions. \n\nDescription above from the Wikipedia article Pablo Rago, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cHzWuAHTi9di6s0BF5x6gOhxJ1g.jpg", url:"https://themoviedb.org/person/93648"}}, {tmdbId:"1139648", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"3039519", born:date('1975-08-16'), name:"Brad Morris", bio:"Brad Morris is an American actor, writer and producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/m4Hp7SzAel4eOQUQDILlxHMzSeZ.jpg", url:"https://themoviedb.org/person/1139648"}}, {tmdbId:"1230173", properties:{bornIn:"Cohasset - Massachusetts - USA", imdbId:"0909391", born:date('1966-07-19'), name:"Nancy Carell", bio:"From Wikipedia, the free encyclopedia. \n\nNancy Ellen Carell (née Walls) is an American actress best known for her comedic work on Saturday Night Live, The Daily Show, and The Office...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uKVHd9dhyBtJtRYMkpRTeeh55oh.jpg", url:"https://themoviedb.org/person/1230173"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"11889", properties:{bornIn:"New York City, New York, USA", imdbId:"0608601", born:date('1958-02-24'), name:"Mark Moses", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/c4C6xZoBx3ATQ8yzdiWX8p6LdKq.jpg", url:"https://themoviedb.org/person/11889"}}, {tmdbId:"111465", properties:{imdbId:"0063872", name:"Adrien Beard", url:"https://themoviedb.org/person/111465"}}, {tmdbId:"61697", properties:{bornIn:"Gainesville, Georgia, USA", imdbId:"0437646", born:date('1972-04-08'), name:"Sung Kang", bio:"Kang was born in Gainesville, Georgia, to South Korean immigrant parents and spent his adolescence in California.  He attended the University of California, Riverside.  While in college he chose acting over law school, a decision which was met with disappointment from his parents due to their concerns over the lack of Asians on American television and lack of job prospects...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8VPuy9lOwqklo080Vm8vHUGADrR.jpg", url:"https://themoviedb.org/person/61697"}}, {tmdbId:"96047", properties:{imdbId:"3101175", name:"Chase Wright Vanek", bio:"​From Wikipedia, the free encyclopedia\n\nChase Wright Vanek is an American child actor perhaps best known for his portrayal of young Michael Myers in Rob Zombie's Halloween II. \n\nDescription above from the Wikipedia article Chase Wright Vanek, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/96047"}}, {tmdbId:"21318", properties:{bornIn:"Long Beach, California, USA", imdbId:"0174021", born:date('1989-02-21'), name:"Scout Taylor-Compton", bio:"American actress and singer Scout Taylor-Compton began her acting career in 1998, with an appearance in the film A. W. O. L.  with David Morse, and later in the short film Thursday Afternoon.  She has appeared in numerous small television roles and in feature films that range from dramas to those in the horror genre.  She went on to have small roles in both television and film including Ally McBeal, ER, Frasier, The Guardian and The Division...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fwmmyHUdSRvUTodybp1BoXvY0rC.jpg", url:"https://themoviedb.org/person/21318"}}, {tmdbId:"968863", properties:{bornIn:"\tMelbourne, Australia", imdbId:"3306943", born:date('1999-04-14'), name:"James Frecheville", bio:"James Aitken Frecheville is an Australian actor known for his lead role in the Australian film Animal Kingdom as Joshua \"J\" Cody, a confused teenager and youngest member of a criminal family in Melbourne's underworld...", url:"https://themoviedb.org/person/968863"}}, {tmdbId:"110920", properties:{imdbId:"0639337", name:"Richard O'Barry", bio:"From Wikipedia, the free encyclopedia.   Richard (Ric) O'Barry (born c.  1939 ) was first recognized in the 1960s for capturing and training the five dolphins that were used in the well-known TV series Flipper.  O'Barry made a radical transition from training dolphins in captivity to assertively combating the captivity industry soon after Kathy, one of the Flipper dolphins, died, committing suicide in his arms, according to O'Barry ...", url:"https://themoviedb.org/person/110920"}}, {tmdbId:"1245544", properties:{imdbId:"0428194", name:"Hardy Jones", url:"https://themoviedb.org/person/1245544"}}, {tmdbId:"114310", properties:{imdbId:"3190974", name:"Natalia Klimas", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lnLaOOyj1KnfeoYrA1PikeUVzs.jpg", url:"https://themoviedb.org/person/114310"}}, {tmdbId:"130253", properties:{bornIn:"Charleston, South Carolina, USA", imdbId:"1334869", born:date('1976-11-01'), name:"Logan Marshall-Green", bio:"Logan Marshall-Green (born November 1, 1976) is an American actor.  He is known for his roles in the television series 24, The O. C. , Traveler, Dark Blue and Quarry, as well as his roles in the films Prometheus, Spider-Man: Homecoming and Upgrade. \n\nDescription above from the Wikipedia article Logan Marshall-Green, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vOV76X3Dd8LsBxrTLdHybFLU8w8.jpg", url:"https://themoviedb.org/person/130253"}}, {tmdbId:"4734", properties:{bornIn:"Sonora, California, USA", imdbId:"0641266", born:date('1942-02-23'), name:"Jenny O'Hara", bio:"Jenny O'Hara is an American actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cNEu7MMpO2dAtZazIbxjo45oH3j.jpg", url:"https://themoviedb.org/person/4734"}}, {tmdbId:"109438", properties:{bornIn:"Hamilton, Victoria, Australia", imdbId:"1882152", born:date('1983-12-10'), name:"Xavier Samuel", bio:"Samuel was born in Hamilton, Victoria, the son of Maree and Clifford Samuel.  He grew up in Adelaide, South Australia and graduated from Rostrevor College in 2001.  He has a younger brother, Benedict, a writer, producer and actor, as well as an older sister, Bridget, a stage manager...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wcovxNDO2aHB3hJCDB6HwvQr8tW.jpg", url:"https://themoviedb.org/person/109438"}}, {tmdbId:"136348", properties:{bornIn:"Sydney, New South Wales, Australia", imdbId:"2029984", born:date('1981-06-19'), name:"Robin McLeavy", bio:"From Wikipedia, the free encyclopedia\n\nRobin McLeavy (born 19 June 1981) is an Australian actress.  McLeavy is from Sydney, Australia.  She graduated from NIDA in 2004.   McLeavy starred as Lola Stone in the critically acclaimed Australian horror film, The Loved Ones.  The film was screened at Toronto International Film Festival in 2009 and won the Audience Choice Award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cbkLmb7AvsllS3In9CTRYVwz6Q5.jpg", url:"https://themoviedb.org/person/136348"}}, {tmdbId:"63313", properties:{bornIn:" Australia", imdbId:"1443841", born:date('1984-01-07'), name:"Victoria Thaine", bio:"Victoria Thaine (born 7 January 1984) is an Australian television and film actress[1][2] and former playwright...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a8TnAs5LxMKyDTG7tae1tyg2q6c.jpg", url:"https://themoviedb.org/person/63313"}}, {tmdbId:"136347", properties:{bornIn:" Sydney, Australia", imdbId:"2537621", born:date('1986-02-21'), name:"Jessica McNamee", bio:"McNamee secured a role in the Australian soap opera Home and Away playing the role of Lisa Duffy and later went on to star as Sammy Rafter in the television series Packed to the Rafters.  In 2009, McNamee was a contestant on the ninth series of Dancing with the Stars.  She was partnered with dancer Stefano Olivieri and they were eliminated before the final.  The role of Sammy left McNamee keen to lose the \"good girl\" image the role created...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6DrWLKjebkr3SwHMqDrMogzlUmX.jpg", url:"https://themoviedb.org/person/136347"}}, {tmdbId:"58395", properties:{bornIn:"Baltimore - Maryland - USA", imdbId:"0465269", name:"Karin Konoval", bio:"Karin Konoval has appeared in guest starring roles in numerous TV series and supporting lead roles in many feature films.  Her extensive screen credits include \"Maurice the Orangutan\" in Rise Of The Planet Of The Apes and Dawn Of The Planet Of The Apes, \"Mrs.  Peacock\" in the infamous X-Files episode Home, and the lead role of \"Mary Leonard\" in the feature Cable Beach, for which she received a Philip Borsos award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5e8YyNQjWre2UbExYBlJ7zva934.jpg", url:"https://themoviedb.org/person/58395"}}, {tmdbId:"236696", properties:{bornIn:"San Rafael, California, USA", imdbId:"1024953", born:date('1968-08-14'), name:"Terry Notary", bio:"Terry Notary is an American actor, stunt coordinator/double and movement coach.  Born in San Rafael, California, Notary was in gymnastics class in school and won many State Championships.  Later in his 20's, he was a performer at Cirque du Soleil, shortly after he joined, he met his wfe Rhonda in New York.  Notary mainly portrays creatures and animals for the film and television industry...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/65ejJ9UI032VBb6t1qXuPjdkCbq.jpg", url:"https://themoviedb.org/person/236696"}}, {tmdbId:"6645", properties:{bornIn:"Henley-on-Thames, England, UK", imdbId:"0725956", born:date('1958-09-19'), name:"Richard Ridings", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3Zhrt9krmRt91WhrzMkLQDZZtpH.jpg", url:"https://themoviedb.org/person/6645"}}, {tmdbId:"95770", properties:{bornIn:"Riverton, New Zealand", imdbId:"0036250", born:date('1934-11-13'), name:"Peter Arnett", url:"https://themoviedb.org/person/95770"}}, {tmdbId:"1475905", properties:{imdbId:"1384043", name:"Ann Beeson", url:"https://themoviedb.org/person/1475905"}}] AS row
