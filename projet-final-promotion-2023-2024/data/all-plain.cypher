UNWIND [{tmdbId:"568279", properties:{bornIn:"Barcellona, Spagna", imdbId:"2038223", born:date('1978-08-03'), name:"Daniel Benmayor", url:"https://themoviedb.org/person/568279"}}, {tmdbId:"1193597", properties:{bornIn:"Lambeth, London, England, UK", imdbId:"1392994", born:date('1969-09-13'), name:"Amma Asante", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vsKtPMA9LJphiswPczSAlVk7r0P.jpg", url:"https://themoviedb.org/person/1193597"}}, {tmdbId:"1157087", properties:{imdbId:"1487468", born:date('1976-12-23'), name:"Luke Matheny", url:"https://themoviedb.org/person/1157087"}}, {tmdbId:"1393833", properties:{bornIn:"San Francisco, California, USA", imdbId:"1145920", born:date('1980-08-01'), name:"Crystal Moselle", bio:"Sierra Ditson \"Crystal\" Moselle (born August 1, 1980) is an American filmmaker.  Her debut film was The Wolfpack (2015), a documentary on the Angulo brothers.  She has also made That One Day (2016) and Skate Kitchen (2018).  Moselle used many of the same actors she filmed for That One Day in her film Skate Kitchen.  The film premiered at the Sundance Film Festival.  In 2020, Moselle served as writer, director, and executive producer of Betty, an HBO series based upon Skate Kitchen...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a7ia6V4OKtkad1lu4q2f1J7W9ao.jpg", url:"https://themoviedb.org/person/1393833"}}, {tmdbId:"1299642", properties:{bornIn:"Pemberton, Australia", imdbId:"1170339", name:"Julius Avery", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nK9ITHGuAWABC0q3fQUD4JQ9yQ1.jpg", url:"https://themoviedb.org/person/1299642"}}, {tmdbId:"171410", properties:{imdbId:"4295913", name:"Timothy Wheeler", url:"https://themoviedb.org/person/171410"}}, {tmdbId:"1289919", properties:{imdbId:"2414670", name:"Ádám Császi", url:"https://themoviedb.org/person/1289919"}}, {tmdbId:"1140584", properties:{imdbId:"2310282", name:"Greg 'Freddy' Camalier", url:"https://themoviedb.org/person/1140584"}}, {tmdbId:"70212", properties:{imdbId:"1589546", born:date('1968-04-20'), name:"Kazuaki Kiriya", url:"https://themoviedb.org/person/70212"}}, {tmdbId:"1018106", properties:{bornIn:"Miami, Florida, USA", imdbId:"0951975", born:date('1973-01-23'), name:"S. Craig Zahler", bio:"S.  Craig Zahler was born in 1973 in Miami, Florida, USA.  He is a writer, director and cinematographer, known for The Incident (2011), Bone Tomahawk (2015)  and Brawl in Cell Block 99 (2017)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vomw5TlCtMtKFSsgOtwkit464nd.jpg", url:"https://themoviedb.org/person/1018106"}}, {tmdbId:"1310498", properties:{imdbId:"2830839", name:"Ivan Kavanagh", url:"https://themoviedb.org/person/1310498"}}, {tmdbId:"928146", properties:{bornIn:"Gelsenkirchen, Germany", imdbId:"1177494", born:date('1977-01-01'), name:"David Wnendt", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bl7uxQnaK0IwDLXvnmOY0phxJfl.jpg", url:"https://themoviedb.org/person/928146"}}, {tmdbId:"105313", properties:{bornIn:"Providence, Rhode Island, USA", imdbId:"0609522", born:date('1969-08-01'), name:"James Mottern", url:"https://themoviedb.org/person/105313"}}, {tmdbId:"1045176", properties:{imdbId:"1363250", name:"Gabriela Cowperthwaite", url:"https://themoviedb.org/person/1045176"}}, {tmdbId:"63052", properties:{bornIn:"Regno Unito", imdbId:"1402202", born:date('1979-05-01'), name:"Julian Gilbey", bio:"From Wikipedia, the free encyclopedia\n\nJulian Gilbey is a British film director, editor, screenwriter, actor, cinematographer, Make-Up artist and Costume designer. \n\nDescription above from the Wikipedia article Julian Gilbey, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/63052"}}, {tmdbId:"1073157", properties:{imdbId:"0393234", name:"Hong Khaou", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v607gf85n12UaYKRhUlnMhF53xR.jpg", url:"https://themoviedb.org/person/1073157"}}, {tmdbId:"52803", properties:{bornIn:"Jerusalem, Israel", imdbId:"1000113", born:date('1974-01-01'), name:"Etan Cohen", bio:"Etan Cohen is an Israeli-American screenwriter and film director, best known for writing the scripts to Tropic Thunder, Madagascar: Escape 2 Africa and Men in Black 3...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4D6E6weuH21M81QNhAv5FYW7gQX.jpg", url:"https://themoviedb.org/person/52803"}}, {tmdbId:"1224031", properties:{bornIn:"Laredo, Texas, Stati Uniti", imdbId:"0004234", born:date('1972-11-06'), name:"Alfonso Gomez-Rejon", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1Eb850hSz3RGDC1VoAtmiOBjrva.jpg", url:"https://themoviedb.org/person/1224031"}}, {tmdbId:"136495", properties:{bornIn:"Providence, Rhode Island, USA", imdbId:"3227090", born:date('1985-01-19'), name:"Damien Chazelle", bio:"Damien Chazelle (born January 19, 1985) is an American film director, producer and screenwriter from Providence, Rhode Island, USA.  He is known for Whiplash (2014) and La La Land (2016).  The latter earned him the Academy Award for Best Director, making him the youngest director in history to receive the award.  Both films received critical acclaim and earned an Academy Award nomination for Best Picture...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/14kRZ3XxNMyBv717YQSXr3wCucy.jpg", url:"https://themoviedb.org/person/136495"}}, {tmdbId:"1139058", properties:{imdbId:"5205122", born:date('1975-09-03'), name:"Simon Klose", bio:"Simon Klose was born in Sweden in 1975.  He holds a law degree from Stockholm University and has\n\nstudied and lived extensively in Japan and South Africa.  Klose has produced and directed a number\n\nof music videos and music documentaries.  In 2006 he released the documentary short ’Sweet\n\nMemories Garden Centre’ about car thieves in South Africa opening up a garden centre in a\n\ntownship...", url:"https://themoviedb.org/person/1139058"}}] AS row
