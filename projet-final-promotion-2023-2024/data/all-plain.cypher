UNWIND [{tmdbId:"14633", properties:{bornIn:"Bremen, Germany", imdbId:"0065353", born:date('1964-12-19'), name:"Ben Becker", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iSQifJQyugD1XBTJdMXG17qbR2W.jpg", url:"https://themoviedb.org/person/14633"}}, {tmdbId:"1086", properties:{bornIn:"Bremerhaven, Bremen, Germany", imdbId:"0272224", born:date('1963-08-18'), name:"Heino Ferch", url:"https://themoviedb.org/person/1086"}}, {tmdbId:"8799", properties:{bornIn:"Munich, Germany", imdbId:"0633947", born:date('1959-11-18'), name:"Ulrich Noethen", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pczYF2SjDhuCWec6Yo4NUBKOGd7.jpg", url:"https://themoviedb.org/person/8799"}}, {tmdbId:"3742", properties:{bornIn:"Essen, Germany", imdbId:"0003492", born:date('1957-03-02'), name:"Heinrich Schafmeister", url:"https://themoviedb.org/person/3742"}}, {tmdbId:"1392770", properties:{imdbId:"0162032", name:"Paul Cicero", url:"https://themoviedb.org/person/1392770"}}, {tmdbId:"17881", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0005403", born:date('1980-06-26'), name:"Jason Schwartzman", bio:"​Jason Francesco Schwartzman (born June 26, 1980) is an American actor and musician.  He is perhaps best known for his roles in the Hollywood films Rushmore, Spun, I Heart Huckabees, Shopgirl, Marie Antoinette, The Darjeeling Limited, and Scott Pilgrim vs.  the World.  He is currently in the band Coconut Records; formerly, he was the drummer of the rock band Phantom Planet...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gCjMdmW1DiPAClHVl4zHEIffIsE.jpg", url:"https://themoviedb.org/person/17881"}}, {tmdbId:"33285", properties:{bornIn:"McComb, Mississippi, USA", imdbId:"0005275", born:date('1979-02-11'), name:"Brandy Norwood", bio:"Brandy Norwood, better known as Brandy, is an American recording artist and entertainer...", url:"https://themoviedb.org/person/33285"}}, {tmdbId:"26719", properties:{bornIn:"Norfolk - Virginia - USA", imdbId:"0185274", born:date('1963-01-19'), name:"Veanne Cox", bio:"Veanne Cox (born January 19, 1963) is an American actress and former ballet dancer.  She studied ballet at Washington School of Ballet and acting at the Studio Theatre in Washington, D. C...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nKO4vwztjH353FvGR2fg002UJx7.jpg", url:"https://themoviedb.org/person/26719"}}, {tmdbId:"12835", properties:{bornIn:"Alameda County, California, USA", imdbId:"0004874", born:date('1967-07-18'), name:"Vin Diesel", bio:"Vin Diesel is an American actor, producer, director, and screenwriter.  He came to prominence in the late 1990s, and first became known for appearing in Steven Spielberg's Saving Private Ryan in 1998.  He is most known for his portrayals of Riddick in The Chronicles of Riddick trilogy (2001–2013), and of Dominic Toretto in The Fast and the Furious film series (2001–present), two franchises in which he also acted as producer.  He also starred in xXx (2002) and Sidney Lumet's Find Me Guilty (2006)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7rwSXluNWZAluYMOEWBxkPmckES.jpg", url:"https://themoviedb.org/person/12835"}}, {tmdbId:"95604", properties:{bornIn:"Pittsburgh, Pennsylvania, USA", imdbId:"0518687", born:date('1973-01-01'), name:"Daniel London", bio:"Daniel London (born 1973) is an American stage and screen actor, perhaps known best in film for his lead role in Old Joy (2006)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/feRkUWfs2LpVzULMdkpBHN5JYdM.jpg", url:"https://themoviedb.org/person/95604"}}, {tmdbId:"22686", properties:{bornIn:"Hannover, Germany", imdbId:"0775056", born:date('1965-09-27'), name:"Maria Schrader", bio:"​From Wikipedia, the free encyclopedia\n\nMaria Schrader (born September 27, 1965) is a German actress. \n\nDescription above from the Wikipedia article Maria Schrader, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sZuIcKq5D75GNKlYecK08O3X0hG.jpg", url:"https://themoviedb.org/person/22686"}}, {tmdbId:"8797", properties:{bornIn:"Göttingen, Germany", imdbId:"0477810", born:date('1965-08-06'), name:"Juliane Köhler", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xEdf9OS5v5pvbbl8lZFlKpHQCjo.jpg", url:"https://themoviedb.org/person/8797"}}, {tmdbId:"22687", properties:{bornIn:"Freiburg im Breisgau, Baden-Württemberg, Germany", imdbId:"0937557", born:date('1975-03-03'), name:"Johanna Wokalek", bio:"Johanna Wokalek (born March 3, 1975) is a German stage and film actress.  A student of Klaus Maria Brandauer, she received critical recognition and three newcomer awards for her performance in the play Rose Bernd.  Wokalek is best known for her award-winning appearances in the German films Hierankl, Barfuss, and The Baader Meinhof Complex.  She received the Bambi award for her portrayal of the Red Army Faction member Gudrun Ensslin in 2008.  She played the lead role in the film Pope Joan in 2009...", url:"https://themoviedb.org/person/22687"}}, {tmdbId:"7059", properties:{bornIn:"Düsseldorf, Germany", imdbId:"0538443", born:date('1971-08-13'), name:"Heike Makatsch", bio:"Makatsch was born in Düsseldorf, Germany, the daughter of former German national ice hockey team goaltender Rainer Makatsch.  She spent several months in New Mexico in 1988 in an effort to improve her English, and later studied politics and sociology at the University of Düsseldorf for four semesters, which was followed by an apprenticeship as a dressmaker until 1994...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kNmhFfsOLmrbFvNz1IZepIduHMG.jpg", url:"https://themoviedb.org/person/7059"}}, {tmdbId:"679", properties:{bornIn:"Münster, Germany", imdbId:"0004376", born:date('1974-07-22'), name:"Franka Potente", bio:"Franka Potente is a German film actress and singer.  She was born on July 22, 1974 in Münster North Rhine-Westphalia and raised in nearby Dülmen.  She first appeared in the comedy After Five in the Forest Primeval (1995) and gained critical recognition in the action thriller Lola rennt (released in English as Run Lola Run) (1998).  Potente received Germany's highest film and television awards for her performances in Run Lola Run and Opernball...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1SxIr4G6fRPR4RsX4AiOf92Fbix.jpg", url:"https://themoviedb.org/person/679"}}, {tmdbId:"1081", properties:{bornIn:"Sonthofen, Germany", imdbId:"0460578", born:date('1956-03-23'), name:"Herbert Knaup", bio:"Herbert Knaup is a German film and television actor.  He is perhaps best-known to international audiences for his supporting roles in Run Lola Run and The Lives of Others.  Longtime companion of actress Natalia Wörner until 2001.  Supports the SOS Children's Villages. \n\nStarted a career as musician with his two nephews in their band \"Neffen und Knaup\" (Nephews and Knaup) (2007).  Founding member of the German Screen Actors Guild...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1QmgD5ce0cUEZ4Jk3HqdoxvlGrZ.jpg", url:"https://themoviedb.org/person/1081"}}, {tmdbId:"1082", properties:{bornIn:"Hamburg-Germany", imdbId:"0677899", born:date('1963-07-16'), name:"Nina Petri", bio:"Nina Petri was born on July 16, 1963 in Hamburg, Germany.  She is an actress, known for Run Lola Run (1998), Die tödliche Maria (1993) and Am I Beautiful? (1998).  She was previously married to Marcos Romão.  Her twin daughters Papoula Sofie Abayomi and Moema Claire Salomé were born July 24th 1994.  Studied acting at the Schauspielschule in Bochum from 1983 to 1987.   Is directly related to classical composer Johann Sebastian Bach...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lTB8jEhmEpJsC7beABSOjeocyjZ.jpg", url:"https://themoviedb.org/person/1082"}}, {tmdbId:"2005287", properties:{imdbId:"2520444", name:"Rosemarie Castoro", url:"https://themoviedb.org/person/2005287"}}, {tmdbId:"2005288", properties:{imdbId:"2521504", name:"Marcia Steinbrecher", url:"https://themoviedb.org/person/2005288"}}, {tmdbId:"1248681", properties:{imdbId:"0857087", name:"Twyla Tharp", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mzhOAgmlNFEBwF1PYz6fEhLIpwQ.jpg", url:"https://themoviedb.org/person/1248681"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"11870", properties:{bornIn:"Buffalo, New York, USA", imdbId:"0004724", born:date('1952-05-02'), name:"Christine Baranski", bio:"Christine Baranski is an American stage and screen actress, best known for her portrayals of Maryann Thorpe on the television series \"Cybill\" and of lawyer Diane Lockhart in the CBS legal drama \"The Good Wife\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fqDRKSrJx7v337MWsY5gklvSFGB.jpg", url:"https://themoviedb.org/person/11870"}}, {tmdbId:"65164", properties:{bornIn:" New Orleans, Louisiana, USA", imdbId:"0005290", born:date('1967-04-29'), name:"Master P", bio:"​From Wikipedia, the free encyclopedia.   \n\nPercy Robert Miller (born April 29, 1967), better known by his stage name Master P or his business name P.  Miller, is an American rapper entertainer and entrepreneur.  He is the founder of the popular label No Limit Records, which was relaunched as New No Limit Records through Koch Records after the label went bankrupt.  He also founded two other labels: Guttar Music Entertainment &amp; Take A Stand Records...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j5afkg0YxnlaL4hS7ugjZOqSwUI.jpg", url:"https://themoviedb.org/person/65164"}}, {tmdbId:"83101", properties:{imdbId:"0424513", name:"Anthony Johnson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j2GJiF5TjmPsJNax3o0vvbYvDPd.jpg", url:"https://themoviedb.org/person/83101"}}, {tmdbId:"119884", properties:{imdbId:"0658252", born:date('1961-12-16'), name:"Gretchen Palmer", url:"https://themoviedb.org/person/119884"}}, {tmdbId:"116536", properties:{imdbId:"0877555", name:"Frantz Turner", bio:"Frantz Turner is an actor...", url:"https://themoviedb.org/person/116536"}}, {tmdbId:"15555", properties:{bornIn:" Dallas, Texas, USA", imdbId:"0005305", born:date('1976-10-31'), name:"Piper Perabo", bio:"Piper Lisa Perabo (born October 31, 1976) is a Golden Globe Award nominated American stage, film and television actress.  Since her breakthrough role in Coyote Ugly (2000), she has appeared in films such as Lost and Delirious (2001), Cheaper by the Dozen (2003), Cheaper by the Dozen 2 (2005), The Prestige (2006), Beverly Hills Chihuahua (2008), and Looper (2012)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aP9QqLm4JZxLwp2CiUbEh5zrpVI.jpg", url:"https://themoviedb.org/person/15555"}}, {tmdbId:"34518", properties:{bornIn:"Houston, Texas, USA", imdbId:"0001778", born:date('1971-05-26'), name:"Matt Stone", bio:"From Wikipedia, the free encyclopedia\n\nMatthew Richard \"Matt\" Stone (born May 26, 1971) is an American screenwriter, producer, voice artist, musician and actor, best known for being the co-creator of South Park along with creative partner and best friend, Trey Parker. \n\nStone started his film career in 1992, making a holiday short titled Jesus vs.  Frosty.  His first success came from Cannibal! The Musical.  From there he made another short title Jesus vs...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ActhebxBVSeRtwwVPSPGTmLSUuP.jpg", url:"https://themoviedb.org/person/34518"}}, {tmdbId:"76244", properties:{bornIn:"New York City, New York, USA", imdbId:"0000109", born:date('1968-06-14'), name:"Yasmine Bleeth", bio:"From Wikipedia, the free encyclopedia\n\nYasmine Amanda Bleeth (born June 14, 1968) is an American actress.  Her television roles include Caroline Holden in the long-running series Baywatch. \n\nDescription above from the Wikipedia article Yasmine Bleeth, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7qcpTVpA7KkyJ4iVxuwtdbbIToy.jpg", url:"https://themoviedb.org/person/76244"}}, {tmdbId:"65561", properties:{bornIn:"Atlanta, Georgia, United States", imdbId:"0661164", born:date('1975-09-23'), name:"Kip Pardue", bio:"Kevin Ian \"Kip\" Pardue (born September 23, 1975) is an American actor and model best known for his roles in the films Remember the Titans, Driven, The Rules of Attraction, and Thirteen.  Born in Atlanta, Georgia, he attended Dunwoody High School in Atlanta.  He qualified for the Honor Roll with a 3. 6 GPA in junior high and was treasurer of the French Club during his freshman year of high school.  The name \"Kip\" comes from the initials of his full name...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zWLkC7AodrsZ2jooVMwwBWkAQsB.jpg", url:"https://themoviedb.org/person/65561"}}, {tmdbId:"1048436", properties:{imdbId:"0669660", name:"George Peck", url:"https://themoviedb.org/person/1048436"}}, {tmdbId:"75311", properties:{imdbId:"0365575", born:date('1977-06-13'), name:"Emily Harrison", url:"https://themoviedb.org/person/75311"}}, {tmdbId:"168020", properties:{imdbId:"0338022", name:"Josh Green", url:"https://themoviedb.org/person/168020"}}, {tmdbId:"1014964", properties:{imdbId:"0345937", name:"Michael Guerin", url:"https://themoviedb.org/person/1014964"}}, {tmdbId:"131", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0350453", born:date('1980-12-19'), name:"Jake Gyllenhaal", bio:"Jacob Benjamin \"Jake\" Gyllenhaal (born December 19, 1980) is a Swedish-American actor.  A member of the Gyllenhaal family and the son of director Stephen Gyllenhaal and screenwriter Naomi Foner, Gyllenhaal began acting as a child with a screen debut in City Slickers (1991), followed by roles in A Dangerous Woman (1993) and Homegrown (1998)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rJdYHYNhlcOBwbPvDZVvt1xw7bi.jpg", url:"https://themoviedb.org/person/131"}}, {tmdbId:"26999", properties:{bornIn:"Michigan, USA", imdbId:"0654104", born:date('1980-09-25'), name:"Chris Owen", bio:"Chris Owen (born September 25, 1980) is an American actor.  He is best known for his role in the American Pie movies as the inimitable Chuck Sherman (self-styled as \"The Sherminator\").  He reprised this role in American Pie 2 and American Pie: Band Camp.  Aside from Eugene Levy, he is the only other actor from the theatrical trilogy to appear in any of the spin-off films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4bHjOiZUW0QkMnwJkAbfPTWoiQ7.jpg", url:"https://themoviedb.org/person/26999"}}, {tmdbId:"11867", properties:{bornIn:"Harrisburg, Pennsylvania, USA", imdbId:"0531095", born:date('1971-04-22'), name:"Eric Mabius", bio:"Eric Mabius (born April 21, 1971) is an American actor known for his work as Daniel Meade on Ugly Betty.  He also had roles on The L Word as well as in Resident Evil and Cruel Intentions...", url:"https://themoviedb.org/person/11867"}}, {tmdbId:"58006", properties:{bornIn:"Cliffwood Beach, New Jersey, USA", imdbId:"0005281", born:date('1978-10-10'), name:"Jodi Lyn O'Keefe", bio:"Jodi Lyn O'Keefe (born October 10, 1978) is an American actress and model, who portrayed Cassidy Bridges on Nash Bridges.  She is also known for her role on Prison Break...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5F9ESeRIlPrUbUcSYRvmNv6uPFU.jpg", url:"https://themoviedb.org/person/58006"}}, {tmdbId:"3897", properties:{bornIn:"Toledo, Ohio, USA", imdbId:"0005017", born:date('1978-12-18'), name:"Katie Holmes", bio:"Kate Noelle \"Katie\" Holmes (born December 18, 1978) is an American actress and director.  Born in Toledo, Ohio, teen modelling led to a supporting role in Ang Lee's The Ice Storm, before she found international fame as Joey Potter on the teen drama Dawson's Creek from 1998 to 2003.  She transitioned to film in her hiatuses between seasons, appearing in movies including Doug Liman's Go, Curtis Hanson's Wonder Boys, and Joel Schumacher's Phone Booth...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dSvQMmznCsoXQBSOtU5IBA399R4.jpg", url:"https://themoviedb.org/person/3897"}}, {tmdbId:"47368", properties:{bornIn:"Traverse City, Michigan, USA", imdbId:"0005538", born:date('1974-04-23'), name:"Barry Watson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zWvbyrKaQdLEpFh9nPKDbh6NcI6.jpg", url:"https://themoviedb.org/person/47368"}}, {tmdbId:"530", properties:{bornIn:"Vancouver, British Columbia, Canada", imdbId:"0005251", born:date('1967-08-21'), name:"Carrie-Anne Moss", bio:"Carrie-Anne Moss is a Canadian film and television actress, best known for playing character Trinity in the feature film trilogy \"The Matrix\".  She's a graduate of the American Academy of Dramatic Arts, Los Angeles, California, USA...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9zya72vRZYBQILfetACsnmCBgdj.jpg", url:"https://themoviedb.org/person/530"}}] AS row
