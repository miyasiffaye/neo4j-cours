UNWIND [{tmdbId:"56953", properties:{imdbId:"0704164", born:date('1946-01-01'), name:"Gene Quintano", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yepKCXkTORUwZQD124wvZx7cF0H.jpg", url:"https://themoviedb.org/person/56953"}}, {tmdbId:"66076", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0381699", born:date('1955-02-12'), name:"Fraser Clarke Heston", bio:"From Wikipedia, the free encyclopedia. \n\nFraser Clarke Heston (born February 12, 1955 in Los Angeles, California) is an American film director, film producer, screenwriter and actor.  The son of actors Charlton Heston and Lydia Clarke, Fraser Clarke Heston was born in Los Angeles, California. \n\nFraser Heston's filmography includes Alaska and the 1990 version of Treasure Island which cast his father as Long John Silver...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pFuI7Wwj0eBx5Vhjfu6zP8DwKC8.jpg", url:"https://themoviedb.org/person/66076"}}, {tmdbId:"57646", properties:{bornIn:"Glen Ridge, New Jersey, USA", imdbId:"0783139", born:date('1952-11-30'), name:"Henry Selick", bio:"From Wikipedia, the free encyclopedia\n\nHenry Selick (born November 30, 1952) is an American stop motion director, producer and writer who is best known for directing The Nightmare Before Christmas, James and the Giant Peach and Coraline.  He studied at the Program in Experimental Animation at California Institute of the Arts, under the guidance of Jules Engel. \n\nDescription above from the Wikipedia article Henry Selick, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6JkYvs9ce3vMvCqWXzGPUzpCKkJ.jpg", url:"https://themoviedb.org/person/57646"}}, {tmdbId:"90864", properties:{imdbId:"0343799", born:date('1952-06-02'), name:"Charles Grosvenor", bio:"From Wikipedia, the free encyclopedia. \n\nCharles Grosvenor (born June 2, 1952) is an American film director. \n\nDescription above from the Wikipedia article Charles Grosvenor, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qzF5HIFVZSt8YUhXVVEKY7KGvqq.jpg", url:"https://themoviedb.org/person/90864"}}, {tmdbId:"1212571", properties:{bornIn:"Toronto, Ontario,  Canada", imdbId:"0162013", born:date('1956-08-05'), name:"Jerry Ciccoritti", bio:"Jerry Ciccoritti is a Canadian filmmaker born and raised in Toronto, Ontario.  He is the co-founder of the theatre company Buddies In Bad Times...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6CiqMQ3MmMnnZz9WtFk2SlCRt53.jpg", url:"https://themoviedb.org/person/1212571"}}, {tmdbId:"9032", properties:{bornIn:"New York City, New York, USA", imdbId:"0001741", born:date('1965-09-17'), name:"Bryan Singer", bio:"Bryan Singer (born September 17, 1965) is an American film director and producer.  Singer won critical acclaim for his work on The Usual Suspects, and is especially well-known among fans of the science fiction and comic book genres for his work on the first two X-Men films and Superman Returns. \n\nDescription above from the Wikipedia article Bryan Singer, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ts06thbCv9Ug2mNpcbcrmLGRL4Q.jpg", url:"https://themoviedb.org/person/9032"}}, {tmdbId:"2260", properties:{bornIn:"Fresno, California, USA", imdbId:"0001873", born:date('1953-01-30'), name:"Steven Zaillian", bio:"Steven Zaillian (born January 30, 1953) is an Armenian-American screenwriter, film director, film editor, producer, and founder of Film Rites, a film production company.  He won an Academy Award for his screenplay for Schindler's List and he has been nominated two times for Awakenings and Gangs of New York.  The Times called him \"the most artful and subtle screenwriter Hollywood has had since Robert Towne. \"\n\nZaillian was born in Fresno, California, the son of Jim Zaillian, a radio news reporter...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3V8X2EnjzqdrUagdnjTgKi213AJ.jpg", url:"https://themoviedb.org/person/2260"}}, {tmdbId:"80537", properties:{bornIn:"Bristol, England, UK", imdbId:"0097529", born:date('1947-07-26'), name:"Dave Borthwick", died:date('2012-10-27'), url:"https://themoviedb.org/person/80537"}}, {tmdbId:"26648", properties:{bornIn:"Lima, Peru", imdbId:"0515891", name:"Luis Llosa", bio:"​From Wikipedia, the free encyclopedia.   \n\nLuis Llosa is a Peruvian film director.  He is the cousin of the Peruvian novelist Mario Vargas Llosa. \n\nDescription above from the Wikipedia article Luis Llosa, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/26648"}}, {tmdbId:"15148", properties:{bornIn:"London, England, UK", imdbId:"0000750", born:date('1948-05-20'), name:"Jon Amiel", bio:"Jon Amiel is an English film director who has since the early 1980s worked in film and television in both the UK and the US...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tZf4VLvFobxizCzDQ6xQdygGT9.jpg", url:"https://themoviedb.org/person/15148"}}, {tmdbId:"101444", properties:{imdbId:"0569166", name:"Scott McGehee", bio:"​From Wikipedia, the free encyclopedia\n\nScott McGehee is an American film director and screenwriter.  He is a Columbia University graduate, born in California, but currently residing in New York City. \n\nHe is half of a long-standing writing-directing partnership with filmmaker David Siegel. \n\nHe was a member of the US Dramatic Jury at the 2009 Sundance Film Festival. \n\nDescription above from the Wikipedia article Scott McGehee, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/101444"}}, {tmdbId:"76418", properties:{bornIn:"Coronation, Alberta, Canada", imdbId:"0318795", born:date('1950-04-28'), name:"Stuart Gillard", bio:"​Stuart Gillard is a Canadian film and television director, writer and actor, best known for directing the feature length film \"RocketMan\"...", url:"https://themoviedb.org/person/76418"}}, {tmdbId:"42002", properties:{bornIn:"Poznan, Wielkopolskie, Poland", imdbId:"0091515", name:"Yurek Bogayevicz", bio:"​From Wikipedia, the free encyclopedia.   \n\nYurek Bogajevicz (born Jerzy Bogajewicz) is a Polish film director, known for directing Anna (1987), Three of Hearts (1993) and Exit in Red (1996). \n\nDescription above from the Wikipedia article  Yurek Bogajevicz, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/42002"}}, {tmdbId:"64909", properties:{bornIn:"Paris, France", imdbId:"0688585", born:date('1945-07-10'), name:"Jean-Marie Poiré", url:"https://themoviedb.org/person/64909"}}, {tmdbId:"115891", properties:{bornIn:"USA", imdbId:"0373698", born:date('1952-04-22'), name:"Chris Hegedus", url:"https://themoviedb.org/person/115891"}}, {tmdbId:"56155", properties:{imdbId:"0839660", born:date('1960-01-01'), name:"Stephen Surjik", bio:"​From Wikipedia, the free encyclopedia. \n\nStephen Surjik is a Canadian film and television director mostly working in television.  Surjik was nominated three times for Gemini Awards for best direction, for Little Criminals, Tripping the Wire: A Stephen Tree Mystery, Intelligence, and received four Emmy Award nominations for Weapons of Mass Distraction...", url:"https://themoviedb.org/person/56155"}}, {tmdbId:"1109913", properties:{imdbId:"0957797", name:" Dick Zondag", url:"https://themoviedb.org/person/1109913"}}, {tmdbId:"65855", properties:{imdbId:"0957798", name:" Ralph Zondag", url:"https://themoviedb.org/person/65855"}}, {tmdbId:"55273", properties:{imdbId:"0458228", name:"Robert Klane", url:"https://themoviedb.org/person/55273"}}, {tmdbId:"36147", properties:{imdbId:"0437659", name:"Charles T. Kanganis", url:"https://themoviedb.org/person/36147"}}] AS row
