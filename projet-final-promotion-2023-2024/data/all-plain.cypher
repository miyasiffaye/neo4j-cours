4, imdbId:"0090190", runtime:82, imdbRating:6.2, countries:["USA"], imdbVotes:18601, title:"Toxic Avenger, The", url:"https://themoviedb.org/movie/15239", tmdbId:"15239", plot:"Tromaville has a monstrous new hero. The Toxic Avenger is born when mop boy Melvin Junko falls into a vat of toxic waste. Now evildoers will have a lot to lose.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qRbAr8yilTnXssmk52po7RyqZSH.jpg", released:"1986-04-11"}}, {movieId:"3694", properties:{languages:["English", " Japanese", " Russian"], year:1989, imdbId:"0098503", runtime:102, imdbRating:5.1, countries:["USA"], imdbVotes:4492, title:"Toxic Avenger, Part II, The", url:"https://themoviedb.org/movie/28165", tmdbId:"28165", plot:"The Toxic Avenger travels to Tokyo to search for his father and leaves his home Tromaville open to complete domination by an evil corporation.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uJ5pZZJW2bHo5tKFARTMpo7js3i.jpg", released:"1989-02-24", budget:2300000}}, {movieId:"3695", properties:{languages:["English"], year:1989, imdbId:"0098502", runtime:102, imdbRating:4.3, countries:["USA"], imdbVotes:3149, title:"Toxic Avenger Part III: The Last Temptation of Toxie, The", url:"https://themoviedb.org/movie/28169", tmdbId:"28169", plot:"Toxie finds he has nothing to do as a superhero, as he has ridden his city of evil. So he decides to go to work for a major corporation, which he discovers may be the evilest of all his adversaries.", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6RjZYi2814CA8452woTodTDK7ZN.jpg", released:"1989-11-24"}}, {movieId:"3696", properties:{languages:["English"], year:1986, imdbId:"0091630", runtime:88, imdbRating:6.8, countries:["USA"], imdbVotes:13933, title:"Night of the Creeps", url:"https://themoviedb.org/movie/15762", tmdbId:"15762", plot:"Alien brain parasites, entering humans through the mouth, turn their host into a killing zombie. Some teenagers start to fight against them.", poster:"https://image.tmdb.org/