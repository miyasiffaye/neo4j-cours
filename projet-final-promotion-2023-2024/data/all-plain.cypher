UNWIND [{tmdbId:"94642", properties:{imdbId:"1092027", name:"Daniel Farber", url:"https://themoviedb.org/person/94642"}}, {tmdbId:"80417", properties:{bornIn:"Bradford, West Yorkshire, England, UK ", imdbId:"0005322", born:date('1976-08-30'), name:"Sarah-Jane Potts", bio:"Sarah-Jane Potts (born 30 August 1976) is an English actress, who is best known for her roles as Saint (Sarah) in Sugar Rush, as Ellie, Abs' on/off girlfriend on Casualty, as Staff Nurse Eddie McKee in sister show Holby City, and as Jo Lipsett in Waterloo Road.  Sarah-Jane Potts is also the sister of actor Andrew-Lee Potts...", url:"https://themoviedb.org/person/80417"}}, {tmdbId:"147967", properties:{imdbId:"1091328", name:"Paul Spence", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1KpovKaRZ8KKchA95eszChO1W2Y.jpg", url:"https://themoviedb.org/person/147967"}}, {tmdbId:"164866", properties:{imdbId:"1088527", name:"David Lawrence", url:"https://themoviedb.org/person/164866"}}, {tmdbId:"148434", properties:{imdbId:"1091286", name:"Gordon Skilling", url:"https://themoviedb.org/person/148434"}}, {tmdbId:"1384202", properties:{imdbId:"1091325", name:"Andrew Sparacino", url:"https://themoviedb.org/person/1384202"}}, {tmdbId:"1772", properties:{bornIn:"Baltimore, Maryland, USA", imdbId:"0267506", born:date('1976-11-29'), name:"Anna Faris", bio:"Anna Kay Faris (born November 29, 1976 height 5' 4\" (1,63 m)) is an American actress and singer.  She is known for her comedic roles in the Scary Movie film series, Lost in Translation, The House Bunny, Brokeback Mountain, My Super Ex-Girlfriend, Cloudy with a Chance of Meatballs, Yogi Bear, What's Your Number?, The Dictator, and I Give It a Year. \n\nEarly Life:\n\nFaris was born in Baltimore, Maryland...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/y3YKNr4qPPJZ9w4lR2a3yySKotd.jpg", url:"https://themoviedb.org/person/1772"}}, {tmdbId:"12288", properties:{bornIn:"New York City, New York, USA", imdbId:"0263172", born:date('1930-06-29'), name:"Robert Evans", bio:"From Wikipedia, the free encyclopedia\n\nRobert Evans (born Robert J.  Shapera; June 29, 1930 – October 26, 2019) was an American film producer and studio executive, best known for his work on Rosemary's Baby, Love Story, The Godfather, and Chinatown...", died:date('2019-10-26'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rCiTT2VrBKeHWdnHAyfGtMXs9go.jpg", url:"https://themoviedb.org/person/12288"}}, {tmdbId:"32799", properties:{bornIn:"Austin, Texas, USA", imdbId:"0079374", born:date('1973-01-09'), name:"Angela Bettis", bio:"From Wikipedia, the free encyclopedia. \n\nAngela Marie Bettis (born January 9, 1973) is an American actress, film producer and director best known for her lead roles in the 2002 TV remake of the Stephen King film Carrie, the title character in May (2002), and in Girl, Interrupted as the anorexic girl Janet Webber. \n\nDescription above from the Wikipedia article Angela Bettis, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4EntT31XmvVCKDI1XfWDEKlYgiq.jpg", url:"https://themoviedb.org/person/32799"}}, {tmdbId:"69807", properties:{bornIn:"San Francisco - California - USA", imdbId:"0835045", born:date('1979-12-11'), name:"Rider Strong", bio:"​From Wikipedia, the free encyclopedia\n\nRider King Strong (born December 11, 1979) is an American actor, director, producer and screenwriter.  He is best known for his role as Shawn Hunter on the 1990s sitcom Boy Meets World...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eg1DgVFXkwPElFanGnBhtAoH1M2.jpg", url:"https://themoviedb.org/person/69807"}}, {tmdbId:"52365", properties:{bornIn:"Las Vegas, Nevada, USA", imdbId:"0898597", born:date('1979-02-07'), name:"Cerina Vincent", bio:"From Wikipedia, the free encyclopedia.   Cerina Vincent (born February 7, 1979) is an American film actress, and model best known for playing the Yellow Ranger Maya in the television series Power Rangers: Lost Galaxy, a naked foreign exchange student in Not Another Teen Movie, and Marcy in Cabin Fever.  She is considered a scream queen.   Description above from the Wikipedia article Cerina Vincent , licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yvlDGryapdkWgzw0krFrZDBgNOw.jpg", url:"https://themoviedb.org/person/52365"}}, {tmdbId:"36811", properties:{bornIn:"San Diego, California, USA", imdbId:"0134244", born:date('1980-10-08'), name:"Nick Cannon", bio:"Nicholas Scott \"Nick\" Cannon (born October 8, 1980) is an American actor, comedian, rapper, record producer, radio and television personality.  On television, Cannon began as a teenage sketch comedian on All That before going on to host The Nick Cannon Show, Wild 'N Out, and America's Got Talent.  He acted in the films Drumline, Love Don't Cost a Thing, and Roll Bounce.  As a rapper, he released his debut self-titled album in 2003 with the hit single \"Gigolo\", a collaboration with singer R.  Kelly...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w0475CrtBvSva3p1qsIePoBXQ5g.jpg", url:"https://themoviedb.org/person/36811"}}, {tmdbId:"83859", properties:{bornIn:"St. Louis, Missouri, USA", imdbId:"0731346", born:date('1972-11-17'), name:"Leonard Roberts", bio:"From Wikipedia, the free encyclopedia. \n\nLeonard Roberts is an American actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4rfue5GhCI77xc7YLMIR8rXzOMY.jpg", url:"https://themoviedb.org/person/83859"}}, {tmdbId:"56900", properties:{bornIn:"Lincoln, Massachusetts, USA", imdbId:"0281241", born:date('1960-05-06'), name:"John Flansburgh", url:"https://themoviedb.org/person/56900"}}, {tmdbId:"93463", properties:{imdbId:"0513057", name:"John Linnell", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aSYwbV3yX6EWYUrRL7pa3CU4RU9.jpg", url:"https://themoviedb.org/person/93463"}}, {tmdbId:"1779154", properties:{name:"Gina Arnold", url:"https://themoviedb.org/person/1779154"}}, {tmdbId:"1844964", properties:{name:"Michael Azerrad", url:"https://themoviedb.org/person/1844964"}}, {tmdbId:"4618", properties:{bornIn:"Berlin, Germany", imdbId:"0478165", born:date('1963-02-19'), name:"Steffi Kühnert", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6hW85ehTO43ypWbRxrpoy6WCfZ1.jpg", url:"https://themoviedb.org/person/4618"}}, {tmdbId:"4619", properties:{bornIn:"Bautzen, Germany", imdbId:"0772609", born:date('1965-07-10'), name:"Gabriela Maria Schmeide", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aeaViwEpw3XXi3UtigjoYFfereS.jpg", url:"https://themoviedb.org/person/4619"}}, {tmdbId:"4620", properties:{imdbId:"0581536", born:date('1963-01-01'), name:"Thorsten Merten", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/b6gp2QkdJBW2U3GwYtzK6nMpcLy.jpg", url:"https://themoviedb.org/person/4620"}}] AS row
