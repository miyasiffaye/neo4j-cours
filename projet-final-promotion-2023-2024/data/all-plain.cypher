UNWIND [{tmdbId:"651", properties:{imdbId:"1594387", name:"Louise Lemoine Torrès", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lUU4XcNDTHy7iuOYOiNq6nu1mhQ.jpg", url:"https://themoviedb.org/person/651"}}, {tmdbId:"33235", properties:{bornIn:"Beverly Hills, California, USA", imdbId:"0503567", born:date('1992-01-19'), name:"Logan Lerman", bio:"Born and raised in Beverly Hills, Logan Lerman wanted to become an actor at an early age.  So he told his mother of his desire to be an actor when he was 2 1/2 years old.  At the age of 4, Logan had an agent and was booked for two commercials.  His first appearance on the big screen was as William, the youngest son of Mel Gibson's character in The Patriot (2000)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qWbN2toEEQgW9DFjgy3gT2VoVlQ.jpg", url:"https://themoviedb.org/person/33235"}}, {tmdbId:"424", properties:{bornIn:"Houston - Texas - USA", imdbId:"1316767", born:date('1970-05-10'), name:"Dallas Roberts", bio:"Dallas Mark Roberts (born May 10, 1970) is an American stage and screen actor.  Roberts was born in Houston, Texas.  He is a graduate of Juilliard School.  He is primarily based in New York City, where he regularly appears in theatrical productions...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/irqfTXfK1rWeF6SNLzB37b6yxAN.jpg", url:"https://themoviedb.org/person/424"}}, {tmdbId:"15831", properties:{bornIn:"Denver, Colorado, USA", imdbId:"0919798", born:date('1946-03-12'), name:"Frank Welker", bio:"Franklin Wendell \"Frank\" Welker (born March 12, 1946) is an American actor who specializes in voice acting and has contributed character voices and other vocal effects to American television and motion pictures.  As of September 2010, Welker had voiced or appeared in 93 films with a combined gross revenue of $5. 7 billion making him the top grossing actor by this standard (and over $800 million ahead of the next highest grossing actor, Samuel L.  Jackson)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/b3gImArbw13mMKJIe9leFc9YYb7.jpg", url:"https://themoviedb.org/person/15831"}}, {tmdbId:"52868", properties:{bornIn:"Long Beach, California, United States", imdbId:"1372583", born:date('1997-02-12'), name:"Shane Baumel", bio:"From Wikipedia, the free encyclopedia\n\nShane Baumel (born February 12, 1997) is an American teen actor.  The first movie he appeared in was Daddy Day Care, with the role of Crispin.  His latest appearance was in Wild Hogs, starring Tim Allen.  He has also appeared on TV a few times, in shows such as Andy Barker, PI and the Emperor's New School, as the voice of Tipo.  And he appeared in the 2004 TV movie \"A Boyfriend for Christmas\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AqQxm6vwF8b6OUrtwbvuLHoEVb7.jpg", url:"https://themoviedb.org/person/52868"}}, {tmdbId:"61301", properties:{imdbId:"1440835", name:"Timyra-Joi Beatty", url:"https://themoviedb.org/person/61301"}}, {tmdbId:"37983", properties:{bornIn:"London, England, UK", imdbId:"1461267", born:date('1980-08-15'), name:"Natalie Press", bio:"From Wikipedia, the free encyclopedia. \n\nNatalie Press (born 15 August 1980) is an English actress, perhaps best known for her award-winning performance in the 2004 film My Summer of Love and a number of short and feature length independent films, including Wasp, which won the 2005 Academy Award for Live Action Short Film...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/827GDGIDh1Tr9vuuUlGGo5mSrqU.jpg", url:"https://themoviedb.org/person/37983"}}, {tmdbId:"58693", properties:{bornIn:"Rotherham, Yorkshire, UK", imdbId:"1080214", born:date('1963-08-06'), name:"Dean Andrews", bio:"From Wikipedia, the free encyclopedia. \n\nDean Andrews (born 1963 in Rotherham) is a British actor. \n\nHe is most famous for his role as DS Ray Carling in the BBC Television drama Life on Mars.  He continued the role in the show's 2008 spin-off series, Ashes to Ashes, until 2010...", url:"https://themoviedb.org/person/58693"}}, {tmdbId:"6285", properties:{bornIn:"Stockholm, Stockholms län, Sweden", imdbId:"0356516", born:date('1974-12-16'), name:"Frida Hallgren", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aIHebEbbBPlsuRNe1hqBznTvUAA.jpg", url:"https://themoviedb.org/person/6285"}}, {tmdbId:"6286", properties:{imdbId:"0803649", born:date('1970-07-10'), name:"Helen Sjöholm", bio:"Marie Helen Sjöholm is a Swedish singer, actress and musical theatre performer who lives in Gamla Enskede in Stockholm...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5t5km94atZiDzsxez23S0SoJ7mb.jpg", url:"https://themoviedb.org/person/6286"}}, {tmdbId:"6287", properties:{bornIn:"Piteå, Norrbottens län, Sweden", imdbId:"0433479", born:date('1956-09-27'), name:"Lennart Jähkel", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/heM3lOkyEIanHgdbYPOghvRY59u.jpg", url:"https://themoviedb.org/person/6287"}}, {tmdbId:"7370", properties:{bornIn:"Jiquilpan, Michoacan, Mexico", imdbId:"0017343", born:date('1953-01-08'), name:"Damián Alcázar", bio:"Damián Alcázar was born on January 8, 1953 in Jiquilpan, Michoacan, Mexico.  He is an actor, known for La ley de Herodes (1999), Las crónicas de Narnia: El príncipe Caspian (2008) and El infierno (2010)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vzitB2xSqHHHjhiL37Z1gVb2Xzp.jpg", url:"https://themoviedb.org/person/7370"}}, {tmdbId:"1624003", properties:{name:"Peki Andino", url:"https://themoviedb.org/person/1624003"}}, {tmdbId:"1080379", properties:{bornIn:"Kuala Lumpur - Malaysia", imdbId:"0436371", born:date('1934-11-13'), name:"Kamahl", bio:"Kamahl is a Malaysian born Sri Lankan Australian international recording artist, musician, singer, and film and televison actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vjdBSFNS4BUspYHo8j7TVZk4fgP.jpg", url:"https://themoviedb.org/person/1080379"}}, {tmdbId:"77562", properties:{bornIn:"Maroubra, Sydney, New South Wales, Australia", imdbId:"0281313", born:date('1934-01-01'), name:"John Flaus", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sK3PPWNkDr0QN5rFDielflUNkhX.jpg", url:"https://themoviedb.org/person/77562"}}, {tmdbId:"218254", properties:{name:"Julie Forsyth", url:"https://themoviedb.org/person/218254"}}, {tmdbId:"10872", properties:{bornIn:"Portsmouth, Virginia, USA", imdbId:"0652663", born:date('1969-01-27'), name:"Patton Oswalt", bio:"American stand-up comedian, writer and actor Patton Oswalt first began performing standup comedy in the late 1980s to early 1990s.  After spending two seasons writing for MADtv, and starring in his own 1996 comedy special for HBO, he began performing in films and television shows. In January 2011, Oswalt released his first book, Zombie Spaceship Wasteland.  Oswalt married writer Michelle Eileen McNamara on September 24, 2005.  Their daughter, Alice Rigney Oswalt, was born on April 15, 2009...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/skGzommLR2zE6uk1YQRFK71dOJ8.jpg", url:"https://themoviedb.org/person/10872"}}, {tmdbId:"7962", properties:{bornIn:"San Diego, California", imdbId:"0738918", born:date('1972-04-15'), name:"Lou Romano", bio:"Lou Romano (born April 15, 1974) is an animation production design artist and voice actor.  He did design work on Monsters, Inc.  and The Incredibles, and he provided the voices of Bernie Kropp in The Incredibles, Snotrod in Cars and Linguini in Ratatouille. \n\nRomano was born and raised in San Diego, California.  He took an interest in drawing and painting at an early age and studied theater arts, performing in plays throughout junior high and high school...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1qOuqRzlp5BghzTkYSN3MsaEXgF.jpg", url:"https://themoviedb.org/person/7962"}}, {tmdbId:"39125", properties:{bornIn:"Ladner, British Columbia, Canada", imdbId:"0766005", born:date('1975-05-24'), name:"Will Sasso", bio:"William \"Will\" Sasso (born May 24, 1975) is a Canadian comedian and actor.  He is most notable for his membership in the recurring cast of comedians on the American sketch comedy series MADtv, spending five seasons on the show. \n\nDescription above from the Wikipedia article Will Sasso, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4F8p9Dg32WJl12ras7CzQzLFy2i.jpg", url:"https://themoviedb.org/person/39125"}}, {tmdbId:"1217648", properties:{bornIn:"Toronto, Ontario,  Canada", imdbId:"0224565", born:date('1975-05-09'), name:"Chris Diamantopoulos", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/t1jxWnGMkCTJ8kpvxdHlxNhlBt5.jpg", url:"https://themoviedb.org/person/1217648"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"17180", properties:{imdbId:"2006469", name:"Sadie Goldstein", url:"https://themoviedb.org/person/17180"}}, {tmdbId:"60649", properties:{bornIn:"Vancouver, British Columbia, Canada", imdbId:"0761835", born:date('1980-05-26'), name:"Will Sanderson", bio:"From Wikipedia, the free encyclopedia. \n\nWill Sanderson (born May 26, 1980) is a Canadian television and film actor. \n\nHe is known for having a long working relationship with director Uwe Boll, having appeared in most of his video-game based movies such as House of the Dead, Alone in the Dark, BloodRayne and In the Name of the King. \n\nIn 2007 he played the leading role in Uwe Boll's horror movie Seed, alongside Michael Paré and Ralf Möller...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/83BaK4g9sAkXzB3CI9pfLu9llLd.jpg", url:"https://themoviedb.org/person/60649"}}, {tmdbId:"60970", properties:{bornIn:"Halifax, Nova Scotia  Canada", imdbId:"0208164", born:date('1970-09-05'), name:"Lucy Decoutere", bio:"From Wikipedia, the free encyclopedia. \n\nLucy Decoutere is a Canadian actress known for her role as the character Lucy in the hit television series Trailer Park Boys. \n\nShe grew up as the youngest sibling of four from British and Czech parents.   She attended grad school in Montreal and has held various jobs, including as a kindergarten teacher in South Korea and attended teachers college at Griffith University in Australia.  She has also appeared in The Vagina Monologues...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xbR1KVKNm8HGrhxqMJ8xIROUCcG.jpg", url:"https://themoviedb.org/person/60970"}}, {tmdbId:"60972", properties:{imdbId:"1036547", name:"Jeanna Harrison", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oZtU5HeIuMlXvZKx14sP6WDA57h.jpg", url:"https://themoviedb.org/person/60972"}}, {tmdbId:"1665", properties:{bornIn:"Stepney, East London, England", imdbId:"0550371", born:date('1968-06-23'), name:"Eddie Marsan", bio:"Edward Maurice C.  \"Eddie\" Marsan(born 1968) is an English actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/uOBYS7vXORH6dRFR4bvF35cSu6B.jpg", url:"https://themoviedb.org/person/1665"}}, {tmdbId:"68046", properties:{imdbId:"0444208", name:"Anna Keaveney", url:"https://themoviedb.org/person/68046"}}, {tmdbId:"145290", properties:{bornIn:"İstanbul, Türkiye", imdbId:"0654863", born:date('1959-01-14'), name:"Rasim Öztekin", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jY1cR1AbieDFOSEiHe41H0xvBXc.jpg", url:"https://themoviedb.org/person/145290"}}, {tmdbId:"106787", properties:{bornIn:"Istanbul , Turkey", imdbId:"0880126", born:date('1953-10-17'), name:"Özkan Ugur", bio:"Özkan Uğur (d.  17 Ekim 1953) MFÖ grubunun bir üyesi müzisyen ve sinema, TV dizisi oyuncusu.  Özkan Uğur'un babası Hurşit Uğur Şehirhatları'nda çarkçıbaşı olarak çalışmaktaydı.  [1] Ailenin beşinci çocuğu olan Uğur, Reşat Nuri Güntekin İlkokulu'nda okurken mandolin ile tanışır.  Fenerbahçe Lisesi'nde okurken müzik sevdası ağır basar.  İlk olarak \"Atomikler\" adında amatör bir grup kurup, dönemin popüler şarkılarını yorumladılar...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zEhhOvyQn3pKeFa4fVPziEWHyvG.jpg", url:"https://themoviedb.org/person/106787"}}, {tmdbId:"1042719", properties:{imdbId:"1202635", name:"Idil Firat", url:"https://themoviedb.org/person/1042719"}}, {tmdbId:"47628", properties:{bornIn:"England, UK", imdbId:"0606690", born:date('1983-01-13'), name:"Julian Morris", bio:"Julian Morris (born 13 January 1983) is a British actor known for his roles in the films Cry Wolf and Sorority Row.  He also played a recurring character in the TV show ER as Dr.  Andrew Wade.  He also plays Wren Kim in the TV show Pretty Little Liars...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oCYcgooUJ8ruEEZjf9iqJ1D6sr2.jpg", url:"https://themoviedb.org/person/47628"}}, {tmdbId:"51936", properties:{bornIn:"Oakville, Ontario, Canada", imdbId:"0095751", born:date('1979-04-02'), name:"Lindy Booth", bio:"Lindy Booth (born April 2, 1979) is a Canadian actress who currently resides in Los Angeles, California.  She's best known for playing Riley Grant on the Disney Channel series The Famous Jett Jackson (and Agent Hawk in the show-within-a-show Silverstone) and Claudia on Relic Hunter.  She also portrayed A. J.  Butterfield on the NBC series The Philanthropist...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5vT2mIIGTM7XQx4utAyRjW1aRPW.jpg", url:"https://themoviedb.org/person/51936"}}, {tmdbId:"49623", properties:{bornIn:"San Antonio, Texas, USA", imdbId:"0655585", born:date('1982-07-19'), name:"Jared Padalecki", bio:"Jared Padalecki (born July 19, 1982) is an American actor, best known for his roles on Gilmore Girls and Supernatural...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/q2YR6o6MKqO2szOhmmSSAnjs2aC.jpg", url:"https://themoviedb.org/person/49623"}}, {tmdbId:"38773", properties:{bornIn:"Berlin, Germany", imdbId:"0726262", born:date('1984-01-07'), name:"Max Riemelt", bio:"Max Riemelt (born in East Berlin, East Germany on 7 January 1984) is a German actor.  Internationally, he is best known for playing Wolfgang Bogdanow in the television series Sense8.  He is also well-known for acting in movies such as Before the Fall (2004), The Wave (2008) and Free Fall (2013).  At the 2004 Karlovy Vary International Film Festival, he won the best actor award for ‘Napola’ and in the 2006 Bavarian Film Awards, he won the best young actor award for ‘Der Rote Kakadu’...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ocv67YrgSDo6uZepXtORJuv8oTx.jpg", url:"https://themoviedb.org/person/38773"}}, {tmdbId:"684", properties:{bornIn:"Berlin, Germany", imdbId:"0771713", born:date('1982-02-10'), name:"Tom Schilling", bio:"Schilling wuchs in Berlin-Mitte als Sohn zweier Kartografen auf.  Als Sechsjähriger wurde er von seiner Mutter zu einem ersten Vorsprechen gebracht, er trat daraufhin in einem DDR-Film auf.  Später besuchte er das John-Lennon-Gymnasium.  Der Regisseur Thomas Heise suchte in Schillings Schule Kinder, die im Theaterstück Im Schlagschatten des Mondes auftreten sollten, der damals Zwölfjährige absolvierte ein Casting und wurde daraufhin für das Stück engagiert...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7Hz9jdNS0M5fjn8XEZ8cy6WKAXK.jpg", url:"https://themoviedb.org/person/684"}}, {tmdbId:"57586", properties:{imdbId:"1079813", born:date('1983-01-01'), name:"Jonas Jägermeyr", url:"https://themoviedb.org/person/57586"}}, {tmdbId:"57587", properties:{imdbId:"0450017", name:"Leon A. Kersten", url:"https://themoviedb.org/person/57587"}}, {tmdbId:"108534", properties:{bornIn:"Cambridge, Ontario, Canada", imdbId:"0124666", born:date('1988-10-20'), name:"Adam Butcher", bio:"Adam Butcher is a Canadian actor born and raised in Cambridge, Ontario...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gqQBmOIZ0ddv0H9P26OWiSchbnA.jpg", url:"https://themoviedb.org/person/108534"}}, {tmdbId:"106712", properties:{imdbId:"0437584", name:"Michael Kanev", url:"https://themoviedb.org/person/106712"}}, {tmdbId:"13950", properties:{bornIn:"Grand Falls, Newfoundland and Labrador, Canada", imdbId:"0684521", born:date('1930-07-12'), name:"Gordon Pinsent", bio:"Gordon Edward Pinsent, CC, FRSC (born July 12, 1930) is a Canadian television, theatre and film actor. \n\nDescription above from the Wikipedia article Gordon Pinsent, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rSIB6bLPrwDMaeJWoEbaoAcdGDT.jpg", url:"https://themoviedb.org/person/13950"}}, {tmdbId:"36810", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"0394045", born:date('1984-11-02'), name:"Tamara Hope", bio:"Tamara Hope (born November 2, 1984) is a Canadian actress.  Her starring roles include Guinevere Jones and The Nickel Children, a film about teenage prostitution. \n\nTamara had a recurring role on CTV's now defunct Whistler as Leah McLure. \n\nHope has recently been featured in the Modernista! ad campaign promoting the Palm Pre phone...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9hHzaUAXsWTKltj8FF4oZMNSj2C.jpg", url:"https://themoviedb.org/person/36810"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"8332", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0390229", born:date('1969-12-17'), name:"Laurie Holden", bio:"An American-Canadian actress and human rights activist.  She is perhaps best known for her roles as Marita Covarrubias on The X-Files, Adele Stanton on The Majestic, Cybil Bennett on Silent Hill, Amanda Dumfries on The Mist, Olivia Murray on The Shield, and Andrea on The Walking Dead. \n\nDescription above from the Wikipedia article Laurie Holden , licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rRhtmJsZ5IiE0lYrLDmYOCiPK1P.jpg", url:"https://themoviedb.org/person/8332"}}, {tmdbId:"61399", properties:{imdbId:"0228491", born:date('1939-10-18'), name:"Mike Ditka", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nfrzSV9oiIVx5FUS1vcdW2SNCdp.jpg", url:"https://themoviedb.org/person/61399"}}, {tmdbId:"61114", properties:{bornIn:"San Jose, California, USA", imdbId:"0005532", born:date('1967-10-13'), name:"Kate Walsh", bio:"Kathleen Erin \"Kate\" Walsh (born October 13, 1967) is an American film and television actress, currently known for her role as Dr.  Addison Montgomery on the ABC dramas Grey's Anatomy and Private Practice...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/z2o4tml3ClbrcJ2ZYtqdtYJcsEY.jpg", url:"https://themoviedb.org/person/61114"}}, {tmdbId:"51609", properties:{bornIn:"Redlands, California, USA", imdbId:"0478810", born:date('1992-06-28'), name:"Gemmenne de la Peña", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/smmfBGNOBuYQZPVbthefTViDyQ2.jpg", url:"https://themoviedb.org/person/51609"}}, {tmdbId:"21007", properties:{bornIn:"Los Angeles, California, USA", imdbId:"1706767", born:date('1983-12-20'), name:"Jonah Hill", bio:"An American actor, producer, screenwriter, and comedian.  Hill is known for his comedic roles in films such as Accepted (2006), Grandma's Boy (2006), Superbad (2007), Knocked Up (2007), Forgetting Sarah Marshall (2008), Get Him to the Greek (2010), 21 Jump Street (2012), This Is the End (2013), 22 Jump Street (2014), and War Dogs (2016), as well as his performances in Moneyball (2011) and The Wolf of Wall Street (2013), for which he received Academy Award nominations for Best Supporting Actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cymlWttB83MsAGR2EkTgANtjeRH.jpg", url:"https://themoviedb.org/person/21007"}}, {tmdbId:"59256", properties:{imdbId:"2012635", name:"Adam Herschman", bio:"From Wikipedia, the free encyclopedia. \n\nAdam Herschman is an actor known for his role as Glen in the 2006 film, Accepted.  Adam also stars as Archie in Harold &amp; Kumar Escape from Guantanamo Bay (2008), Phillip in Soul Men and as Mr.  Pickle's employee in I Now Pronounce You Chuck and Larry...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qyGGwLJ3EZ20eQ0pADwOc8RY5uy.jpg", url:"https://themoviedb.org/person/59256"}}, {tmdbId:"10135", properties:{bornIn:"Palm Springs, California, USA", imdbId:"0416596", born:date('1989-09-14'), name:"Jesse James", bio:"​From Wikipedia, the free encyclopedia.     Jesse James (born September 14, 1989) is an American actor.   Description above from the Wikipedia article Jesse James, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o8YSLAAQfW5QmOGyzeZEdOEUhTt.jpg", url:"https://themoviedb.org/person/10135"}}, {tmdbId:"70903", properties:{bornIn:"Northampton, Northamptonshire, England, UK", imdbId:"0912938", born:date('1967-03-20'), name:"Marc Warren", bio:"Marc Warren (born 20 March 1967) is an English actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sIsnids6kyarj8QjMrlA1j9p08n.jpg", url:"https://themoviedb.org/person/70903"}}, {tmdbId:"57912", properties:{imdbId:"1288603", born:date('1961-08-25'), name:"Dandan Song", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/putZpAEnWHMboOWqVGz1K2EnfcY.jpg", url:"https://themoviedb.org/person/57912"}}, {tmdbId:"3248", properties:{bornIn:"Pittsburgh, Pennsylvania, USA", imdbId:"0006388", born:date('1902-05-10'), name:"David O. Selznick", bio:"From Wikipedia, the free encyclopedia\n\nDavid O.  Selznick (May 10, 1902 – June 22, 1965) was an American film producer, screenwriter and film studio executive. [2] He is best known for producing Gone with the Wind (1939) and Rebecca (1940), both earning him an Academy Award for Best Picture. \n\nIn 1926, Selznick moved to Hollywood, and with the help of his father's connections, he got a job as an assistant story editor at Metro-Goldwyn-Mayer...", died:date('1965-06-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7BAijrUZxGv9vF5jXh0yUxbDHMP.jpg", url:"https://themoviedb.org/person/3248"}}, {tmdbId:"12798", properties:{bornIn:"Miami, Florida, USA", imdbId:"0006663", born:date('1973-07-09'), name:"Enrique Murciano", bio:"Enrique Murciano (born July 9, 1973) is an American actor.  He is best known for his starring role on Without a Trace...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/r1KGKFRzPyAGqqPI8adzlZfNO20.jpg", url:"https://themoviedb.org/person/12798"}}, {tmdbId:"24357", properties:{bornIn:"Highland, Illinois, USA", imdbId:"0097504", born:date('1971-02-15'), name:"Alex Borstein", bio:"Alexandrea \"Alex\" Borstein (born February 15, 1973) is an American actress, singer, voice actress, writer and comedian.  She is best known for her long-running role as Lois Griffin on the animated television series Family Guy, and as a cast member on the sketch comedy series MADtv. \n\nA native of Highland Park, Illinois, Borstein is a graduate of San Francisco State University, where she studied rhetoric...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/evbCnRe5Yfuy0B41PONLTIcvbem.jpg", url:"https://themoviedb.org/person/24357"}}, {tmdbId:"18973", properties:{bornIn:"Chernovtsy, Ukrainian SSR, USSR [now Chernivtsi, Ukraine]", imdbId:"0005109", born:date('1983-08-14'), name:"Mila Kunis", bio:"Milena \"Mila\" Kunis (born August 14, 1983) is an American actress.  Her television work includes the role of Jackie Burkhart on That '70s Show and the voice of Meg Griffin on the animated series Family Guy.  She has also played roles in film, such as Rachel Jansen in Forgetting Sarah Marshall, Mona Sax in Max Payne and Solara in The Book of Eli...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6Lp9qPkMO740Hcp8NBYZZLWWvJF.jpg", url:"https://themoviedb.org/person/18973"}}, {tmdbId:"9705", properties:{bornIn:"Okazaki, Aichi Prefecture, Japan", imdbId:"0757327", born:date('1974-06-13'), name:"Takahiro Sakurai", bio:"a Japanese voice actor who was born in Aichi.  He was a member of 81 Produce and since July 20 of 2014 is attached with INTENTION, the management company established by Kenichi Suzumura, one of his good friends...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mncynaPX98jOM2iYw6OBQVFQByX.jpg", url:"https://themoviedb.org/person/9705"}}, {tmdbId:"9707", properties:{bornIn:"Tokyo, Japan", imdbId:"0411683", born:date('1980-04-14'), name:"Ayumi Itô", bio:"Ayumi Ito (伊藤 歩 Itō Ayumi, born April 14, 1980 in Tokyo) is a Japanese actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5Lon3bBtHjiFCyNLpiDNI2oVinj.jpg", url:"https://themoviedb.org/person/9707"}}, {tmdbId:"9714", properties:{bornIn:"Hachioji, Tokyo Prefecture, Japan", imdbId:"0605453", born:date('1974-02-25'), name:"Shotaro Morikubo", bio:"is a Japanese actor, voice actor and singer who has voiced characters in anime, drama CDs, and video games.  He was formerly affiliated with I'm Enterprise and VIMS.  His most notable roles were Shikamaru Nara from Naruto, X in the Mega Man X series and Yosuke Hanamura from Persona 4...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3OsBYIbC5XBDIUVnZiDBD1dewHP.jpg", url:"https://themoviedb.org/person/9714"}}, {tmdbId:"41042", properties:{bornIn:"Canning Town, London, England, UK", imdbId:"0245705", born:date('1977-07-24'), name:"Danny Dyer", bio:"Danny Dyer (born 24 July 1977) is an English actor, avid West Ham United fan, media personality and chairman of Greenwich Borough, a non-League football team. \n\nDyer was discovered at a local school by an agent who auditioned him for the part of Martin Fletcher in the Granada Televisionseries Prime Suspect 3 (1993), beginning his acting career at 16. \n\nDescription above from the Wikipedia article Danny Dyer, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cExOARWnQbCXa8aHp45CtILKVwc.jpg", url:"https://themoviedb.org/person/41042"}}, {tmdbId:"990", properties:{bornIn:"London, England, UK", imdbId:"0363857", born:date('1962-01-01'), name:"Frank Harper", bio:"From Wikipedia, the free encyclopedia. \n\nFrank Harper (born 1962) is a British actor and film producer.  He is best known for his \"Hard Man\" roles, such as Billy Bright in The Football Factory (2004), Dog in Lock, Stock and Two Smoking Barrels (1998).  He appears as a white nationalist in South West 9, and as the bank robber in Harry Enfield's film Kevin &amp; Perry Go Large...", url:"https://themoviedb.org/person/990"}}, {tmdbId:"39660", properties:{bornIn:"London, England, UK", imdbId:"1268748", born:date('1968-03-18'), name:"Tamer Hassan", bio:"Tamer Hassan (born 18 March 1968) is a British actor of Turkish Cypriot descent.   Description above from the Wikipedia article Tamer Hassan, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5xDdmxKqRsiPVf2KQ16AK7Fmock.jpg", url:"https://themoviedb.org/person/39660"}}, {tmdbId:"24240", properties:{bornIn:"Bermondsey, London, England, UK", imdbId:"0543598", born:date('1979-01-01'), name:"Roland Manookian", bio:"​From Wikipedia, the free encyclopedia.   \n\nRoland Manookian (Born 1979) is an English actor of Armenian descent, who is most notable for his role as Zebedee, in the 2004 film The Football Factory, and as Craig Rolfe in Rise of the Footsoldier in 2007.  He has also appeared in Guy Richie's Rocknrolla and Nick Love's Goodbye Charlie Bright and The Business.  Roland comes from London England.  Manookian has also appeared in episodes of The Bill in 1999 as Ben Glover...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ijNW1al21QnwuNlcezOtz1Qs5HF.jpg", url:"https://themoviedb.org/person/24240"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"6069", properties:{bornIn:"Ann Arbor, Michigan, USA", imdbId:"0629538", born:date('1980-04-24'), name:"Austin Nichols", bio:"​From Wikipedia, the free encyclopedia.   \n\nAustin Nichols (born April 24, 1980) is an American film, television actor and director who is perhaps best known for his role as Julian Baker in The CW drama series One Tree Hill.  He is also known for his roles in films such as The Day After Tomorrow and Wimbledon.  He starred in the HBO series John from Cincinnati...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d0Aa2Vwh7OX2CG2MN9CzcsVvtOw.jpg", url:"https://themoviedb.org/person/6069"}}, {tmdbId:"45589", properties:{bornIn:"Chelsea, London, England, UK", imdbId:"2301950", born:date('1994-04-11'), name:"Dakota Blue Richards", bio:"​Dakota Blue Richards (born 11 April 1994) is an English actress.  Ten thousand girls turned up for open auditions in Cambridge, Oxford, Exeter and Kendal for the role of Lyra Belacqua in the adaptation of 'His Dark Materials: Northern Lights' to the film 'The Golden Compass (2007)'.  In June 2006, twelve-year-old Dakota, a Londoner schoolgirl, was awarded the part after the casting directors' took a shine to her in the Cambridge auditions.  Her mother is an American anthropologist...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qi8YwJb9IdApRiRJFNavwnGgfBU.jpg", url:"https://themoviedb.org/person/45589"}}, {tmdbId:"45585", properties:{bornIn:"Essex, England, UK", imdbId:"2036501", born:date('1993-01-01'), name:"Ben Walker", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/u4eEdilSy1HMTFseGMY44kYAuRO.jpg", url:"https://themoviedb.org/person/45585"}}, {tmdbId:"51583", properties:{bornIn:" Garland, Texas, USA", imdbId:"1102053", born:date('1991-07-09'), name:"Mitchel Musso", bio:"​From Wikipedia, the free encyclopedia. \n\nMitchel Tate Musso (born July 9, 1991) is an American actor, singer and musician.  Musso is best known for his three Disney Channel roles as Oliver Oken in the Disney Channel sitcom, Hannah Montana, Jeremy Johnson in the Disney Channel animated series Phineas and Ferb and his role as Brady in the Disney XD series Pair of Kings...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iglls9NuwYq3QEzqs3KS7HxSdqO.jpg", url:"https://themoviedb.org/person/51583"}}, {tmdbId:"558925", properties:{bornIn:"Palm Harbor, Florida, USA", imdbId:"3235380", born:date('2000-02-25'), name:"Tucker Albrizzi", bio:"Tucker Albrizzi is an American actor.  He is best known for his roles as Tyler Duncan on Big Time Rush, Jake on Good Luck Charlie, Randall Snyder on American Vandal and Colin McConnell on A. P.  Bio...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oDZ5u49acsidJB7WRKjIsBkKQf3.jpg", url:"https://themoviedb.org/person/558925"}}, {tmdbId:"226411", properties:{bornIn:"Marylebone, London, England, UK", imdbId:"1125277", born:date('1925-04-03'), name:"Tony Benn", bio:"Anthony Neil Wedgwood Benn was a British politician, writer, and diarist.  He was a Member of Parliament for 47 years between the 1950 and 2001 general elections and a Cabinet minister in the Labour governments of Harold Wilson and James Callaghan in the 1960s and 1970s...", died:date('2014-03-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qqrFivDwt2KyAXhzSmHbg2EzNA4.jpg", url:"https://themoviedb.org/person/226411"}}, {tmdbId:"80576", properties:{bornIn:"Portland, Oregon", imdbId:"2504006", born:date('1997-06-18'), name:"Max Records", bio:"Maxwell Records (born June 18, 1997) is an American actor.  He is most notable for his roles as Max in the film Where the Wild Things Are, for which he won the 2009 Young Artist Award for Best Leading Young Actor in a Feature Film, and as Slater Pedulla in The Sitter.  He starred in the lead role of John Wayne Cleaver in the 2016 film titled I Am Not A Serial Killer based on the Dan Wells' 2009 novel of the same name which received positive reviews and ratings...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7MoEVlo0I5xHKV5dTzQ86QBFo2j.jpg", url:"https://themoviedb.org/person/80576"}}, {tmdbId:"113495", properties:{imdbId:"2589551", name:"Pepita Emmerichs", url:"https://themoviedb.org/person/113495"}}, {tmdbId:"1575431", properties:{name:"Max Pfeifer", url:"https://themoviedb.org/person/1575431"}}, {tmdbId:"187406", properties:{imdbId:"1909410", name:"Madeleine Greaves", url:"https://themoviedb.org/person/187406"}}, {tmdbId:"18467", properties:{imdbId:"1642653", name:"Alberto Reyes", url:"https://themoviedb.org/person/18467"}}, {tmdbId:"17413", properties:{bornIn:"Florida, USA", imdbId:"0575339", born:date('1955-05-31'), name:"Julio Oscar Mechoso", bio:"From Wikipedia, the free encyclopedia\n\nJulio Oscar Mechoso (born May 31, 1955) is an American actor.  He is occasionally credited as Julio Mechoso. \n\nMechoso is a character actor in both television and film.  He has appeared in several high-profile films, such as Grindhouse, Bad Boys and the controversial Ken Park.  His television credits include Miami Vice, Seinfeld and Greetings from Tucson.  He has appeared in two Martin Lawrence films, Bad Boys and Blue Streak...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2m1vtlRlSxozMOoHeobCY2pbrPi.jpg", url:"https://themoviedb.org/person/17413"}}, {tmdbId:"18468", properties:{bornIn:"Mexico City - Mexico", imdbId:"0844761", born:date('1966-11-08'), name:"Gustavo Sánchez Parra", bio:"Gustavo Sánchez Parra is known for his work on El fuego de la venganza (2004), La leyenda del Zorro (2005) and Amores perros (2000)...", url:"https://themoviedb.org/person/18468"}}, {tmdbId:"32895", properties:{bornIn:"Stony Brook - New York - USA", imdbId:"0416673", born:date('1965-04-26'), name:"Kevin James", bio:"Kevin James (born April 26, 1965) is an American playwright, actor, writer, and producer.  He is widely known for playing Doug Heffernan on the CBS sitcom The King of Queens.  He is also known for his lead roles in the comedy films I Now Pronounce You Chuck and Larry, Paul Blart: Mall Cop, Grown Ups, The Dilemma, and Zookeeper.  He hosted the Nickelodeon Kids' Choice Awards on March 27, 2010...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dqyUARUWykoMT3eRDgy7vmQY5PG.jpg", url:"https://themoviedb.org/person/32895"}}, {tmdbId:"38425", properties:{bornIn:"Phoenix, Arizona, USA", imdbId:"0005520", born:date('1974-02-09'), name:"Amber Valletta", bio:"Amber Evangeline Valletta is an American actress and model.  She began her career as a model for fashion agencies, and appeared on cover pages of internationally recognized magazines.  She made her film debut in Drop Back Ten (2000).  She then starred in the hit film Hitch (2005).  She has since appeared in films such as Man About Town (2006), Dead Silence (2007), Gamer (2009), and The Spy Next Door (2010)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wX2NbxT3rR54dUdHO4isXg8dy55.jpg", url:"https://themoviedb.org/person/38425"}}, {tmdbId:"743", properties:{bornIn:"Diyarbakır - Turkey", imdbId:"0539616", born:date('1943-06-02'), name:"Kevork Malikyan", bio:"Kevork Malikyan (born 2 June 1943) is a British-Armenian actor and teacher.  He played Kazim in Indiana Jones and the Last Crusade and Max in Mind Your Language. \n\nDuring his career, he has worked with renowned directors and actors including Steven Spielberg, Roger Moore, Alan Parker, Sigourney Weaver, Michael Caine and Anthony Hopkins...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mTSFwcx9JVQ1Utb0j8mAoBJcc4E.jpg", url:"https://themoviedb.org/person/743"}}, {tmdbId:"57637", properties:{bornIn:"Downey, California, USA", imdbId:"0381723", born:date('1963-08-03'), name:"James Hetfield", bio:"James Alan Hetfield is an American musician and songwriter best known for being the co-founder, lead vocalist/rhythm guitarist and main songwriter for the American heavy metal band Metallica.  Hetfield is mainly known for his intricate rhythm playing, but occasionally performs lead guitar duties and solos, both live and in the studio.  Hetfield co-founded Metallica in October 1981 after answering an advertisement by drummer Lars Ulrich in the Los Angeles newspaper The Recycler...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1DBDpjWorXCwvMQLZeDIGfDQ5sJ.jpg", url:"https://themoviedb.org/person/57637"}}, {tmdbId:"69230", properties:{bornIn:"Gentofte, Denmark", imdbId:"0005515", born:date('1963-12-26'), name:"Lars Ulrich", bio:"Lars Ulrich, R (Order of the Dannebrog) is a Danish musician, songwriter, record producer, and podcaster.  He is best known as the drummer and co-founder of American heavy metal band Metallica.  The son of tennis player Torben Ulrich and grandson of tennis player Einer Ulrich, he also played tennis in his youth and moved to Los Angeles at age 16 to train professionally.  However, rather than playing tennis, Ulrich began playing drums...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/siJAlqUVndLOMTJuMcNg7QWdtsZ.jpg", url:"https://themoviedb.org/person/69230"}}, {tmdbId:"69231", properties:{bornIn:"San Francisco, California, USA", imdbId:"0004987", born:date('1962-11-18'), name:"Kirk Hammett", bio:"Kirk Lee Hammett is an American musician who has been the lead guitarist and a contributing songwriter for heavy metal band Metallica since 1983.  Before joining Metallica he formed and named the band Exodus.  In 2003, Hammett was ranked 11th on Rolling Stone's list of The 100 Greatest Guitarists of All Time...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wQct90fwJtvx6LoFgHLq2wWZGea.jpg", url:"https://themoviedb.org/person/69231"}}, {tmdbId:"69233", properties:{bornIn:"Santa Monica, California, USA", imdbId:"0874235", born:date('1964-10-23'), name:"Robert Trujillo", bio:"Roberto Agustin Trujillo (Spanish pronunciation: [roˈβerto tɾuˈxiʎo]; born October 23, 1964), better known as Robert Trujillo, is an American musician known for his role as the current bassist of heavy metal band Metallica.  He also was a member of crossover thrash metal band Suicidal Tendencies, funk metal supergroup Infectious Grooves, heavy metal band Black Label Society, and he has worked with Jerry Cantrell from the grunge band Alice in Chains, and Black Sabbath vocalist Ozzy Osbourne...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aDy6CSER3EcKrP2YPijW7Z9kJ8H.jpg", url:"https://themoviedb.org/person/69233"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"2128", properties:{bornIn:"Melbourne, Australia", imdbId:"1191481", born:date('1977-01-17'), name:"Leigh Whannell", bio:"Leigh Whannell is an Australian screenwriter, producer, and actor, best known for his work on the Saw franchise...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aMYJ69b5lU9XaZ7hhDQVPaCWzfl.jpg", url:"https://themoviedb.org/person/2128"}}, {tmdbId:"52792", properties:{bornIn:"Gainesville, Florida, USA", imdbId:"0748973", born:date('1972-07-27'), name:"Maya Rudolph", bio:"Maya Rudolph is an actress and comedienne known for her comedic roles as a cast member on Saturday Night Live from 2000–2007 and for appearing in films such as Away We Go, Bridesmaids, Grown Ups and MacGruber.  She is the daughter of the late R&B and soul singer Minnie Riperton...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/V7GqtRwWCkLjOnkve4R4DBnKz5.jpg", url:"https://themoviedb.org/person/52792"}}, {tmdbId:"51298", properties:{bornIn:"Milford, Michigan, USA", imdbId:"1009277", born:date('1975-01-02'), name:"Dax Shepard", bio:"Dax Randall Shepard (born January 2, 1975) is an American actor. Shepard was an actor on Punk'd with Ashton Kutcher.  In 2006, Shepard appeared opposite Dane Cook and Jessica Simpson in the comedy Employee of the Month as well as the Mike Judge film Idiocracy.  During the same time, Shepard began appearing in more films and landed his first main character role in Let's Go to Prison, alongside Will Arnett.  He also had a major role in Baby Mama...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/28lPuIJDTjOOpJCowYllbiDXi7F.jpg", url:"https://themoviedb.org/person/51298"}}, {tmdbId:"2417", properties:{bornIn:"Tlemcen, Algeria", imdbId:"0126870", born:date('1943-01-23'), name:"Maurice Bénichou", bio:"Maurice Bénichou (23 January 1943 in Tlemcen, French Algeria – 14 June 2019) was a French actor.  His best known roles include three collaborations with director Michael Haneke (Code inconnu, Le Temps du Loup, and Caché), and a part in Jean-Pierre Jeunet's Amélie.  He has also played in Peter Brook's 1989 film version of The Mahabharata. \n\nSource: Article \"Maurice Bénichou\" from Wikipedia in english, licensed under CC-BY-SA 3. 0...", died:date('2019-06-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qAE6S18DpcODCuYm5Q5YyHvJAKs.jpg", url:"https://themoviedb.org/person/2417"}}, {tmdbId:"145059", properties:{imdbId:"1685235", name:"Carlos Padilla", url:"https://themoviedb.org/person/145059"}}, {tmdbId:"1660431", properties:{imdbId:"3169819", name:"Gustavo Muñoz", url:"https://themoviedb.org/person/1660431"}}, {tmdbId:"72128", properties:{bornIn:"Ciudad de México, México", imdbId:"0946962", born:date('1970-11-30'), name:"José María Yazpik", bio:"José María Yazpik (born November 13, 1970) is a Mexican film and television actor. \n\nYazpik was born in Mexico City in the bosom of a wealthy family, the son of a successful gynecologist, Dr.  Jose Maria Meza, and Cristina Yazpik. \n\nHis first acting job came from a friend of his father, who produced the TV movie The brute with the angel of death.  He moved to Mexico City to study at CEA of Televisa.  At the CEA he studied with future celebrities like Arath de la Torre, Fabián Corres and Eduardo Rill...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9yXF3NklBlbM1WCzJVEAjhMGv9k.jpg", url:"https://themoviedb.org/person/72128"}}, {tmdbId:"59295", properties:{bornIn:"Columbia, South Carolina, USA", imdbId:"0949810", born:date('1984-02-01'), name:"Lee Thompson Young", bio:"Lee Thompson Young's star quality has graced the stage, the small screen and the big screen from a very early age.  Portraying 'Dr.  Martin Luther King Jr. ' in the production of \"A Night Of Stars And Dreams\" in his hometown of Columbia, South Carolina at the mere age of 10 inspired him to pursue a career as an actor.  Young's professional career took off with his leading role on the Disney Channel television series, \"The Famous Jett Jackson\" (1998)...", died:date('2013-08-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i89CftWAIFXBeg8Vq2wjSJeor2M.jpg", url:"https://themoviedb.org/person/59295"}}, {tmdbId:"54498", properties:{imdbId:"0420181", born:date('1986-06-03'), name:"Brenden Jefferson", url:"https://themoviedb.org/person/54498"}}, {tmdbId:"36928", properties:{bornIn:"Benowo, Poland", imdbId:"0470212", born:date('1941-12-18'), name:"Horst Krause", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3zT3jkPNWaf0QnlE4LUrE2Dnkd0.jpg", url:"https://themoviedb.org/person/36928"}}, {tmdbId:"15381", properties:{bornIn:"Berlin, Germany", imdbId:"0912329", born:date('1933-06-12'), name:"Harald Warmbrunn", url:"https://themoviedb.org/person/15381"}}, {tmdbId:"19231", properties:{bornIn:"Baruth, Germany", imdbId:"0618218", born:date('1958-04-14'), name:"Karl-Fred Müller", died:date('2018-10-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/huZiCpWf8YEAeYPolpHQarBgAMh.jpg", url:"https://themoviedb.org/person/19231"}}, {tmdbId:"57656", properties:{imdbId:"0775866", name:"Ursula Schucht", url:"https://themoviedb.org/person/57656"}}, {tmdbId:"40330", properties:{bornIn:"Tokyo Prefecture, Japan", imdbId:"0256609", born:date('1944-01-25'), name:"Tôru Emori", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Qdzjq7UANUZfko03sCsebTniVL.jpg", url:"https://themoviedb.org/person/40330"}}, {tmdbId:"117626", properties:{imdbId:"0645464", born:date('1982-12-09'), name:"Aya Okamoto", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ltpBSUZWYEhdHHQuE4dB8X3j436.jpg", url:"https://themoviedb.org/person/117626"}}, {tmdbId:"117629", properties:{imdbId:"0880851", born:date('1959-07-11'), name:"Yoshiaki Umegaki", url:"https://themoviedb.org/person/117629"}}, {tmdbId:"57346", properties:{bornIn:" Salem, Oregon, USA", imdbId:"1690331", born:date('1982-04-29'), name:"Kate Nauta", bio:"From Wikipedia, the free encyclopedia. \n\nKate or Katie Nauta (born April 29, 1982) is an American fashion model, actress and singer.  She uses the name 'Katie' in her modeling work, and the name 'Kate' in her film work...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4J89UrOIyPgLLX0cwZO5t8Zu0N6.jpg", url:"https://themoviedb.org/person/57346"}}, {tmdbId:"2088136", properties:{name:"Caitlin Atwater", url:"https://themoviedb.org/person/2088136"}}, {tmdbId:"1170278", properties:{imdbId:"0086819", name:"Margaret Blakemore", url:"https://themoviedb.org/person/1170278"}}, {tmdbId:"1543039", properties:{name:"Ron Guerette", url:"https://themoviedb.org/person/1543039"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"1373448", properties:{imdbId:"2100653", name:"Kochi", url:"https://themoviedb.org/person/1373448"}}, {tmdbId:"1815", properties:{imdbId:"0686502", name:"Valerie Planche", url:"https://themoviedb.org/person/1815"}}, {tmdbId:"1747162", properties:{name:"Anton Newcombe", url:"https://themoviedb.org/person/1747162"}}, {tmdbId:"1759241", properties:{born:date('1967-07-20'), name:"Courtney Taylor-Taylor", bio:"In 1994, Courtney Taylor-Taylor formed \"The Dandy Warhols\" in Portland, Oregon.  After one independent record, the band was signed to Capitol Records.  They quickly became media and film-music darlings finding favor in the U. S.  indie scene as well as major pop success abroad. \n\nIn 2000, Taylor-Taylor directed and appeared in his short film \"The End Of The Old As We Knew It\" which had its debut at the 2001 Sundance Film Festival.  The film features Ione Skye, Donovan, Kirsty Hume and Scott Weiland...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ixh95FR89Bs8NxFrfR7ccgRcrx7.jpg", url:"https://themoviedb.org/person/1759241"}}, {tmdbId:"1759246", properties:{name:"Joel Gion", url:"https://themoviedb.org/person/1759246"}}, {tmdbId:"1759247", properties:{name:"Matt Hollywood", url:"https://themoviedb.org/person/1759247"}}, {tmdbId:"1231768", properties:{bornIn:"Ojai, California, USA", imdbId:"1412815", born:date('1994-02-23'), name:"James Paxton", bio:"Son of Bill Paxton. \n\nGrandson of John Paxton. \n\nJames Paxton was born and raised in Ojai, California.  He studied British Film in London before studying at the Vincent Chase Workshop in Los Angeles, California.  He starred in the USA Network drama series, Eyewitness, directed by Catherine Hardwicke and executive produced by Adi Hasak.  He portrayed the character, Lukas Waldenbeck, alongside Julianne Nicholson and Tyler Young...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9JwXXU33W5d4uWa7k9ksIDi6VsT.jpg", url:"https://themoviedb.org/person/1231768"}}, {tmdbId:"1580659", properties:{name:"Peter Hurley", url:"https://themoviedb.org/person/1580659"}}, {tmdbId:"4322", properties:{bornIn:"Redwood City, California", imdbId:"1677648", born:date('1957-03-26'), name:"Jeff Clark", bio:"From Wikipedia, the free encyclopedia. \n\nJeff Clark (born March 26, 1957, Redwood City, California) is one of the most noteworthy and respected big-wave surfers, famous for surfing Mavericks alone for 15 years before it was widely discovered by the big-wave surfing community. \n\nBorn in Redwood City, Clark moved with his family to Miramar Beach in Half Moon Bay when he was a young boy.  He soon began surfing and seeking out bigger, stronger waves along the rugged Northern California coast...", url:"https://themoviedb.org/person/4322"}}, {tmdbId:"4323", properties:{imdbId:"0230427", name:"Darrick Doerner", bio:"From Wikipedia, the free encyclopedia. \n\nDarrick Doerner is a big wave pioneer in the sport of towsurfing.  His initials: 'D. D. ' not only stand for his name, but for 'Designated Driver'.  Darrick uses a personal water craft to travel to large surf breaks offshore.  He is also known as simply 'Double D'.  Darrick is known as a big wave surfer.  Primarily for creating the actual sport of tow in surfing...", url:"https://themoviedb.org/person/4323"}}, {tmdbId:"1317227", properties:{imdbId:"1071308", name:"Greg Kirsch", url:"https://themoviedb.org/person/1317227"}}, {tmdbId:"28238", properties:{bornIn:"Baltimore, Maryland, USA", imdbId:"0001327", born:date('1952-07-17'), name:"David Hasselhoff", bio:"David Michael Hasselhoff  (born July 17, 1952), nicknamed \"The Hoff,\" is an American actor, singer, producer and businessman.  He is best-known for his lead roles as Michael Knight in the popular 1980s US series Knight Rider and as L. A.  County Lifeguard Mitch Buchannon in the series Baywatch.  Hasselhoff also produced Baywatch for a number of seasons in the 1990s up until 2001, when the series ended with Baywatch Hawaii...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oLmqFoIED15ZQKeuaQ4WS03voR3.jpg", url:"https://themoviedb.org/person/28238"}}, {tmdbId:"9828", properties:{bornIn:"Roseau, Minnesota, USA ", imdbId:"1330560", born:date('1984-09-03'), name:"Garrett Hedlund", bio:"Born in Roseau, Minnesota, Garrett spent his early years growing up on a farm in a small town.  When he was in the ninth grade his family moved to Scottsdale Arizona, where he began taking private acting lessons.  After graduating high school, he immediately moved to Los Angeles to pursue an acting career.  One month later, he'd landed the role of Achilles' cousin Patroclus in the major motion picture Troy (2004) opposite Brad Pitt...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qe7hflOB1B9xA8s9truiYQAz8xw.jpg", url:"https://themoviedb.org/person/9828"}}, {tmdbId:"19512", properties:{imdbId:"1952016", name:"Frier McCollister", url:"https://themoviedb.org/person/19512"}}, {tmdbId:"19513", properties:{imdbId:"0935042", born:date('1961-05-06'), name:"Wally Wingert", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5B9STa1OwelvyUs37SWUIFzhIhB.jpg", url:"https://themoviedb.org/person/19513"}}, {tmdbId:"5890", properties:{imdbId:"1671035", name:"Virgina Ariza", url:"https://themoviedb.org/person/5890"}}, {tmdbId:"5891", properties:{imdbId:"1503450", name:"Yenny Paola Vega", url:"https://themoviedb.org/person/5891"}}, {tmdbId:"5893", properties:{imdbId:"1675515", name:"Rodrigo Sánchez Borhorquez", url:"https://themoviedb.org/person/5893"}}, {tmdbId:"82857", properties:{bornIn:"Helsinki, Finland", imdbId:"0701747", born:date('1980-07-15'), name:"Jasper Pääkkönen", bio:"Jasper Pääkkönen is a Finnish actor and entrepreneur.  Pääkkönen became famous in Finland playing Saku Salin in the Finnish television soap opera Salatut elämät (1999–2002) and have since then starred in many #1 Finnish box office hits, including Bad Boys (2003), Matti: Hell Is for Heroes (2006) and Lapland Odyssey (2010). \n\nHe made his  international breakthrough role in historical drama television series Vikings (2015-) as Halfdan the Black...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aZZy9NQEZdhlXWS2i8N00gxW6LU.jpg", url:"https://themoviedb.org/person/82857"}}, {tmdbId:"148364", properties:{imdbId:"1864901", name:"Elina Hietala", url:"https://themoviedb.org/person/148364"}}] AS row
