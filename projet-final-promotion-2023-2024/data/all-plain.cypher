UNWIND [{tmdbId:"88060", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0689385", born:date('1959-11-15'), name:"Jeff Pollack", died:date('2013-12-23'), url:"https://themoviedb.org/person/88060"}}, {tmdbId:"4499", properties:{bornIn:"Falls Church, Virginia, USA", imdbId:"0001723", born:date('1958-12-11'), name:"Tom Shadyac", bio:"Thomas Peter \"Tom\" Shadyac is an American comedian, director, screenwriter, and producer.  Although Shadyac had been the youngest joke-writer ever for comedian Bob Hope,[1] he is widely known for writing and directing the films Ace Ventura: Pet Detective, The Nutty Professor, Liar Liar, Bruce Almighty, and I Am.  He is an adjunct professor of communication and teaches screenwriting at Pepperdine University's Seaver College...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kuliB1DrKSbdn2jxESncPbWxGrD.jpg", url:"https://themoviedb.org/person/4499"}}, {tmdbId:"75589", properties:{imdbId:"0143426", name:"George Casey", url:"https://themoviedb.org/person/75589"}}, {tmdbId:"37630", properties:{bornIn:"Lahore, Punjab, British India", imdbId:"0001408", born:date('1945-12-06'), name:"Shekhar Kapur", bio:"From Wikipedia, the free encyclopedia. \n\nShekhar Kapur (born 6 December 1945) is an Indian film director and producer.  He is a critically acclaimed director, rose to popularity with the movie, Bandit Queen.  His historical biopics of Queen Elizabeth I (Elizabeth and its sequel Elizabeth: The Golden Age) garnered several Academy Award nominations, including two Best Actress nods for Cate Blanchett...", url:"https://themoviedb.org/person/37630"}}, {tmdbId:"11809", properties:{bornIn:"Cotswolds, Regno Unito", imdbId:"0906548", born:date('1961-11-30'), name:"Rupert Wainwright", bio:"​From Wikipedia, the free encyclopedia.   \n\nRupert Wainwright (born 30 November 1963) is an English film and television director, writer, and actor. \n\nWainwright was born in Cotswolds, UK and started his film career in the 1980s as an actor.  While in his twenties, gained some notoriety for a short film called Open Window. \n\nDescription above from the Wikipedia article Rupert Wainwright  licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/11809"}}, {tmdbId:"57107", properties:{bornIn:"Harrisburg, Pennsylvania,United States", imdbId:"0720304", name:"Adam Resnick", bio:"From Wikipedia, the free encyclopedia.   Adam Resnick is an American comedy writer from Harrisburg, Pennsylvania.  He is best known for his work writing for Late Night with David Letterman.   Additionally, Resnick co-created and wrote for Get A Life with David Mirkin and Chris Elliott.  Resnick also wrote and was co-executive producer of a season of The Larry Sanders Show for HBO.  Two years later, in 1994, Resnick would team up with Elliott again for the motion picture Cabin Boy...", url:"https://themoviedb.org/person/57107"}}, {tmdbId:"1090082", properties:{bornIn:"Rio de Janeiro, Rio de Janeiro, Brazil", imdbId:"0812773", born:date('1938-06-17'), name:"Helena Solberg", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jgPAyhF1qbldHHbyxiwZbXNmNrN.jpg", url:"https://themoviedb.org/person/1090082"}}, {tmdbId:"68762", properties:{bornIn:"Kensington, London, England, UK", imdbId:"0382783", born:date('1965-01-01'), name:"James D.R. Hickox", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iGlGk8meol0l84iOPINOC4HU12r.jpg", url:"https://themoviedb.org/person/68762"}}, {tmdbId:"1080036", properties:{imdbId:"0086820", name:"Michael Blakemore", url:"https://themoviedb.org/person/1080036"}}, {tmdbId:"27236", properties:{imdbId:"0150707", name:"Gregg Champion", url:"https://themoviedb.org/person/27236"}}, {tmdbId:"17447", properties:{bornIn:"Appleton, Wisconsin, USA", imdbId:"0959062", born:date('1949-05-18'), name:"Terry Zwigoff", bio:"From Wikipedia, the free encyclopedia\n\nTerry Zwigoff (born May 18, 1949 in Appleton, Wisconsin) is an American filmmaker best known for two popular small budget films, both arising out of the world of underground or alternative comics: the documentary Crumb (1994), about underground comics figure Robert Crumb, and the feature Ghost World (2001), adapted from the Dan Clowes comic book of the same name...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wUeonvhWu9JqGNT4leIwdJU0PEp.jpg", url:"https://themoviedb.org/person/17447"}}, {tmdbId:"83996", properties:{bornIn:"Los Angeles, California, Stati Uniti", imdbId:"0561879", born:date('1951-08-03'), name:"Bradford May", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p7pC1Ih1sSPyN8qBXZl1dYeNDKT.jpg", url:"https://themoviedb.org/person/83996"}}, {tmdbId:"52325", properties:{imdbId:"0326161", name:"Allan A. Goldstein", url:"https://themoviedb.org/person/52325"}}, {tmdbId:"87680", properties:{bornIn:"Milan, Lombardy, Italy", imdbId:"0811714", born:date('1957-07-03'), name:"Michele Soavi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AhvV1PgfEwIkwfL5uWRD9xO2bDd.jpg", url:"https://themoviedb.org/person/87680"}}, {tmdbId:"1230367", properties:{bornIn:"Hong Kong", imdbId:"0795803", born:date('1966-01-01'), name:"Mina Shum", bio:"Mina Shum (born 1966) is an independent Canadian filmmaker.  She is a writer and director of award-winning feature films, numerous shorts and has created site-specific installations and theatre.  Her features, Double Happiness, and Long Life, Happiness & Prosperity both premiered in the US at the Sundance Film Festival and Double Happiness won the Wolfgang Staudte Prize for Best First Feature at the Berlin Film Festival and the Audience Award at Torino...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5ScY0qUFwkTosreWTddNt64ccj.jpg", url:"https://themoviedb.org/person/1230367"}}, {tmdbId:"19069", properties:{bornIn:"Paris, Ile-de-France, France", imdbId:"0001031", born:date('1930-06-24'), name:"Claude Chabrol", bio:"From Wikipedia, the free encyclopedia.   Claude Chabrol (24 June 1930 – 12 September 2010) was a French film director, a member of the French New Wave (nouvelle vague) group of filmmakers who first came to prominence at the end of the 1950s.  Like his colleagues and contemporaries Godard, Truffaut, Rohmer and Rivette, Chabrol was a critic for the influential film magazine Cahiers du cinéma before beginning his career as a film maker...", died:date('2010-09-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tsG0YNUREk7fGVaDKpwvuFBi59O.jpg", url:"https://themoviedb.org/person/19069"}}, {tmdbId:"52358", properties:{bornIn:"New York City", imdbId:"0945026", born:date('1966-06-20'), name:"Boaz Yakin", bio:"From Wikipedia, the free encyclopedia.   Boaz Yakin (born June 20, 1966 ) is an American screenwriter and film director based in New York City.  Yakin studied filmmaking at New York City College and New York University. \n\nHe is currently writing the screenplay for Conan the Barbarian.   Description above from the Wikipedia article Boaz Yakin, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/52358"}}, {tmdbId:"172993", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0873266", born:date('1964-01-01'), name:"Rose Troche", url:"https://themoviedb.org/person/172993"}}, {tmdbId:"32593", properties:{bornIn:"Utica, New York, USA", imdbId:"0109359", born:date('1962-05-27'), name:"Steven Brill", bio:"From Wikipedia, the free encyclopedia. \n\nSteven Brill (born May 27, 1962) is an American actor, film producer, director, and screenwriter.  He directed and co-wrote Little Nicky and directed Mr.  Deeds, Without A Paddle, Heavyweights and Drillbit Taylor.  He has had cameo roles in all three Mighty Ducks movies, and appeared in The Wedding Singer, Mr.  Deeds and Knocked Up, although his role in the latter has been miscredited to Judd Apatow.  He also appeared as the Barfly in Sex, Lies, and Videotape...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bhWId1JKFtFECSJPCYo9DbXeOaS.jpg", url:"https://themoviedb.org/person/32593"}}, {tmdbId:"53599", properties:{imdbId:"0602452", name:"Andrew Morahan", url:"https://themoviedb.org/person/53599"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"230059", properties:{imdbId:"0723685", born:date('1971-11-06'), name:"Matty Rich", url:"https://themoviedb.org/person/230059"}}, {tmdbId:"73668", properties:{imdbId:"0577849", name:"James Melkonian", bio:"From Wikipedia, the free encyclopedia. \n\nJames Melkonian is an American screenwriter and film director.  He wrote and directed the films The Stoned Age and Jerky Boys: The Movie. \n\nDescription above from the Wikipedia article James Melkonian, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/73668"}}, {tmdbId:"64901", properties:{bornIn:"Hong Kong, China", imdbId:"0150906", born:date('1959-11-30'), name:"Gordon Chan", bio:"Gordon Chan Kar-Seung is an a Hong Kong film director, writer and producer.  His most notable works include Beast Cops, Fist of Legend, Painted Skin and 2000 AD...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/u5ZyeRfHyQGraQClzz9XO8Jjeav.jpg", url:"https://themoviedb.org/person/64901"}}, {tmdbId:"56201", properties:{bornIn:"Bad König, Germany", imdbId:"0782266", born:date('1951-06-10'), name:"Peter Sehr", died:date('2013-05-09'), url:"https://themoviedb.org/person/56201"}}, {tmdbId:"85547", properties:{imdbId:"0540468", name:"Mark Malone", url:"https://themoviedb.org/person/85547"}}, {tmdbId:"8297", properties:{bornIn:"Flin Flon, Manitoba, Canada", imdbId:"0000812", born:date('1965-08-23'), name:"Roger Avary", bio:"From Wikipedia, the free encyclopedia. \n\nRoger Avary (born Roger d'Avary on August 23, 1965) is a Canadian film and television producer, screenwriter and director in the American mass media industry.  He was behind the screenplays of the films Silent Hill and Beowulf.  Before that, he had worked on Reservoir Dogs and Pulp Fiction, the latter of which earned both him and Quentin Tarantino an Oscar for Best Original Screenplay at the 67th Academy Awards...", url:"https://themoviedb.org/person/8297"}}, {tmdbId:"128107", properties:{bornIn:"Magisano, Catanzaro, Italia", imdbId:"0002167", born:date('1945-01-20'), name:"Gianni Amelio", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9aaSLs17R5m7bwoWqaQgKXsNu8Q.jpg", url:"https://themoviedb.org/person/128107"}}, {tmdbId:"15812", properties:{bornIn:"Rye, New York, USA", imdbId:"0021249", born:date('1949-06-29'), name:"Roger Allers", bio:"From Wikipedia, the free encyclopedia. \n\nRoger Allers (born c.  1949 in Rye, New York) is an American Film director and Screenwriter, storyboard artist and animator.  He is well known for directing The Lion King for Disney. \n\nDescription above from the Wikipedia article Roger Allers, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sdFyM5FNcJuMv7knrz6swaIHXIJ.jpg", url:"https://themoviedb.org/person/15812"}}, {tmdbId:"3030", properties:{imdbId:"0770650", name:"Andrew Scheinman", bio:"From Wikipedia, the free encyclopedia. \n\nAndrew Scheinman is a film and television producer, as well as a film director and screenwriter.  Before he got his start in entertainment, he worked as a tennis pro, as well as earning a JD from the University of Virginia School of Law in 1973.  He is one of the heads of Castle Rock Entertainment. \n\nHe won an Emmy Award for producing Seinfeld and was nominated for an Academy Award for producing A Few Good Men...", url:"https://themoviedb.org/person/3030"}}, {tmdbId:"75474", properties:{bornIn:"Wellington, New Zealand", imdbId:"0133044", name:"Anna Campion", url:"https://themoviedb.org/person/75474"}}, {tmdbId:"78258", properties:{imdbId:"0848092", name:"C.M. Talkington", url:"https://themoviedb.org/person/78258"}}, {tmdbId:"5005", properties:{bornIn:"Tartas, Francia", imdbId:"0243191", born:date('1950-08-14'), name:"François Dupeyron", url:"https://themoviedb.org/person/5005"}}, {tmdbId:"223825", properties:{imdbId:"0595131", name:"Freida Lee Mock", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bRmhl0U3YeNKgoXjCq5t4RcgZ6t.jpg", url:"https://themoviedb.org/person/223825"}}, {tmdbId:"124783", properties:{imdbId:"0485878", born:date('1959-12-24'), name:"Perry Lang", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7VZa2pdnhqxz18UVzTdvSHr1jgr.jpg", url:"https://themoviedb.org/person/124783"}}, {tmdbId:"933201", properties:{imdbId:"0240987", born:date('1958-08-08'), name:"Martine Dugowson", url:"https://themoviedb.org/person/933201"}}, {tmdbId:"3045", properties:{bornIn:"Brisbane, Queensland, Australia", imdbId:"0389591", born:date('1962-11-30'), name:"P.J. Hogan", bio:"From Wikipedia, the free encyclopedia.  Paul John \"P.  J. \" Hogan (born 30 November 1962 ) is an Australian film director. \n\nHogan was born in Brisbane, Queensland.  As a teenager, Hogan lived on the North Coast of New South Wales and attended Mt St Patrick's College and was said to have had a difficult time in high school as he was a victim of bullying. \n\nHis first big hit was the 1994 Australian film Muriel's Wedding, which helped launch the careers of actors Toni Collette and Rachel Griffiths...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/a9nTCDzLrnrEgD81WiRvZ4zN1VX.jpg", url:"https://themoviedb.org/person/3045"}}, {tmdbId:"58384", properties:{bornIn:"Lebanon", imdbId:"0909026", born:date('1959-10-24'), name:"Anthony Waller", bio:"From Wikipedia, the free encyclopedia. \n\nAnthony Waller (born October 24, 1959) is a film director\n\nDescription above from the Wikipedia article Anthony Waller, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/58384"}}, {tmdbId:"54469", properties:{bornIn:"Overland Park, Kansas, USA", imdbId:"0021899", born:date('1959-04-07'), name:"Michael Almereyda", bio:"From Wikipedia, the free encyclopedia. \n\nMichael Almereyda (born 1960) is an American film director, screenwriter, and film producer.  His most well known work is Hamlet (2000), starring Ethan Hawke. \n\nDescription above from the Wikipedia article Michael Almereyda, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oiMAcT7GwLXBKTYWLl9FDBqrwHX.jpg", url:"https://themoviedb.org/person/54469"}}, {tmdbId:"130424", properties:{imdbId:"0956205", name:"Rafal Zielinski", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5jl2PKKd1fdrrx64nd5WoAqxrcO.jpg", url:"https://themoviedb.org/person/130424"}}, {tmdbId:"232119", properties:{imdbId:"0615536", name:"Izidore K. Musallam", url:"https://themoviedb.org/person/232119"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"74299", properties:{imdbId:"0402563", name:"Pixote Hunt", url:"https://themoviedb.org/person/74299"}}, {tmdbId:"1364800", properties:{bornIn:"Skopje, Macedonia", imdbId:"0541391", born:date('1959-08-18'), name:"Milcho Manchevski", bio:"Milcho Manchevski wrote and directed the feature films Before the Rain (1994), Dust (2001), Shadows (2007) and Mothers (2011), over 50 short forms, including Thursday (2013), the experimental film 1. 73 (1984) and the music video Tennessee (1991) for Arrested Development.  He has also been a director on HBO's The Wire (2002)...", url:"https://themoviedb.org/person/1364800"}}, {tmdbId:"42617", properties:{bornIn:"London, England, UK", imdbId:"0000944", born:date('1951-05-05'), name:"Antonia Bird", died:date('2013-10-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kDAJuRpVmVK4hCpmrXLfzufIFId.jpg", url:"https://themoviedb.org/person/42617"}}, {tmdbId:"141450", properties:{bornIn:"Chiswick, London, England, UK", imdbId:"0809321", born:date('1952-12-03'), name:"Mel Smith", bio:"From Wikipedia, the free encyclopedia. \n\nMelvin Kenneth \"Mel\" Smith  (1952 -2013 ) was an English comedian, writer, film director, producer, and actor.  He is most famous for his work on the sketch comedy shows Not the Nine O'Clock News and Alas Smith and Jones along with his comedy partner Griff Rhys Jones. \n\nDescription above from the Wikipedia article Mel Smith, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2013-07-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vynnJ4jWZvGRClXTN4kFQqTEIdn.jpg", url:"https://themoviedb.org/person/141450"}}, {tmdbId:"27797", properties:{bornIn:"Virginia, USA", imdbId:"0377066", born:date('1946-01-19'), name:"Kim Henkel", url:"https://themoviedb.org/person/27797"}}, {tmdbId:"29482", properties:{imdbId:"0650233", name:"Stuart Orme", url:"https://themoviedb.org/person/29482"}}, {tmdbId:"83588", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0010012", born:date('1944-06-30'), name:"Robert Allan Ackerman", bio:"From Wikipedia, the free encyclopedia. \n\nRobert Allan Ackerman is an American film director.  He has directed numerous films since 1992. \n\nDescription above from the Wikipedia article Robert Allan Ackerman, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ilZJBtlkfdf2CZtXPyufuGgeQJ5.jpg", url:"https://themoviedb.org/person/83588"}}, {tmdbId:"58072", properties:{bornIn:"Houston, Texas", imdbId:"0664756", born:date('1944-11-30'), name:"John Pasquin", bio:"From Wikipedia, the free encyclopedia\n\nJohn Pasquin (born November 30, 1944) is a director of film, television, and theatre. \n\nPasquin began directing Broadway theatre plays in the early 1980s.  He also directed TV shows such as Family Ties and Growing Pains.  His producing debut came in 1991 with the hit show Home Improvement.  He has directed three Tim Allen movies as well, The Santa Clause 1994, Jungle 2 Jungle 1997, and Joe Somebody 2001.  Also, he directed the sequel to Miss Congeniality...", url:"https://themoviedb.org/person/58072"}}, {tmdbId:"33405", properties:{bornIn:"Glasgow, Scotland, UK", imdbId:"0533564", born:date('1948-01-08'), name:"Gillies MacKinnon", bio:"​From Wikipedia, the free encyclopedia\n\nGillies MacKinnon (born 8 January 1948, Glasgow) is a Scottish film director and writer. \n\nHis film credits include Hideous Kinky, Small Faces and Regeneration. \n\nDescription above from the Wikipedia article Gillies MacKinnon, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/33405"}}, {tmdbId:"2209", properties:{bornIn:"Eindhoven, Noord-Brabant, Netherlands", imdbId:"0000957", born:date('1943-10-22'), name:"Jan de Bont", bio:"Jan de Bont is a Dutch cinematographer, producer, and film director...", url:"https://themoviedb.org/person/2209"}}, {tmdbId:"65874", properties:{bornIn:"Ibach, Switzerland", imdbId:"0002699", born:date('1944-06-17'), name:"Xavier Koller", bio:"​From Wikipedia, the free encyclopedia.   \n\nXavier Koller (born 1944, Schwyz, Switzerland) is a Swiss film director and screenwriter.  His film Journey of Hope won the Academy Award for Best Foreign Language Film in 1990. \n\nAfter graduating from High School, Koller first went through a four-year apprenticeship as a precision toolmaker and then, after three years of training at the Academy of Drama in Zurich, Switzerland, graduated as an actor/director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jDpThZNrm6vMOE6MHu8UDq5FrSw.jpg", url:"https://themoviedb.org/person/65874"}}, {tmdbId:"1726", properties:{bornIn:"Philadelphia, Pennsylvania", imdbId:"0211823", born:date('1947-11-17'), name:"Steven E. de Souza", bio:"From Wikipedia, the free encyclopedia. \n\nSteven E.  de Souza (born 17 November 1947) is an American producer, director and screenwriter.  He is among a handful of screenwriters whose films have earned over two billion dollars at the worldwide box office. \n\nDescription above from the Wikipedia article Steven E...", url:"https://themoviedb.org/person/1726"}}, {tmdbId:"72629", properties:{imdbId:"0123587", name:"Geoff Burton", url:"https://themoviedb.org/person/72629"}}, {tmdbId:"91499", properties:{bornIn:"Australia", imdbId:"0235852", name:" Kevin Dowling", bio:"​From Wikipedia, the free encyclopedia\n\nKevin Dowling is an Australian film, television director and producer.  He made directorial debut co-directing the film The Sum of Us starring Jack Thompson and Russell Crowe.  In 1996, he directed the film Mojave Moon starring Danny Aiello, Anne Archer and Angelina Jolie...", url:"https://themoviedb.org/person/91499"}}, {tmdbId:"2219290", properties:{name:"Aaron Speiser", url:"https://themoviedb.org/person/2219290"}}, {tmdbId:"139433", properties:{bornIn:"Honolulu, Hawaii, U.S", imdbId:"0605748", born:date('1965-02-15'), name:"Jon Moritsugu", bio:"Jon Moritsugu is an American underground filmmaker.  Jon Moritsugu started filmmaking in 1985 when he went to school at Brown University.  Moritsugu's films are known for their lo-fi aesthetic...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cPqpWZ1S3SNx1fqCVvO3YFIdRH3.jpg", url:"https://themoviedb.org/person/139433"}}, {tmdbId:"45645", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0764776", born:date('1968-01-17'), name:"Deran Sarafian", bio:"From Wikipedia, the free encyclopedia.  Deran Sarafian (born January 17, 1968) is an Armenian-American actor, film and television director. \n\nSarafian has directed several episodes of the FOX series House and was made a co-executive producer of the show for the 2007/08 season...", url:"https://themoviedb.org/person/45645"}}, {tmdbId:"252878", properties:{imdbId:"0295044", name:"Bud Friedgen", url:"https://themoviedb.org/person/252878"}}, {tmdbId:"385451", properties:{imdbId:"0792227", name:" Michael J. Sheridan", url:"https://themoviedb.org/person/385451"}}, {tmdbId:"39298", properties:{bornIn:"Berlin, Germany", imdbId:"0903137", born:date('1942-02-21'), name:"Margarethe von Trotta", bio:"​From Wikipedia, the free encyclopedia\n\nMargarethe von Trotta (born 21 February 1942, Berlin) is a German film director and a member of the New German Cinema movement.  The child of Elisabeth von Trotta and painter Alfred Roloff, she relocated to Paris in the 1960s, where she worked for film collectives, collaborating on scripts and co-directing short films.  In her early career, von Trotta was an actress, appearing in notable films of directors Fassbinder and Volker Schlöndorff...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rxFG8ZBtXRt0iRzMKiFOq579GD.jpg", url:"https://themoviedb.org/person/39298"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"119294", properties:{bornIn:"Tehran, Iran", imdbId:"0452102", born:date('1940-06-22'), name:"Abbas Kiarostami", bio:"Abbas Kiarostami was a director and scriptwriter who was born in 1940 in Tehran, Iran.  He was a famous director and scriptwriter in Iran.  His first movies were “The Bread and Alley”, “Breaktime” and “The Traveler”.  He was also interested in photography, music, and painting.  He has won a lot of awards such as Golden Palm for “Taste of Cherry” from Cannes Film Festival, the Crystal Simorgh of Jury for “Close-Up”...", died:date('2016-07-04'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rTlz5ciu41FxyVuXA82a3tSYVZ8.jpg", url:"https://themoviedb.org/person/119294"}}, {tmdbId:"259506", properties:{imdbId:"0933866", name:" Michael Henry Wilson", url:"https://themoviedb.org/person/259506"}}, {tmdbId:"148103", properties:{bornIn:"Chongjin, Korea", imdbId:"0645661", born:date('1926-10-18'), name:"Sang-ok Shin", bio:"Shin Sang-ok (October 18, 1926 – April 11, 2006) was a prolific South Korean film producer and director, with more than 100 producer and 70 director credits.  He is most famous for his being kidnapped by then current North Korean leader Kim Jong-il, for the purpose of producing critically acclaimed films. \n\nDescription above from the Wikipedia article Shin Sang-ok, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2006-04-11'), url:"https://themoviedb.org/person/148103"}}, {tmdbId:"28741", properties:{imdbId:"0753382", name:"Michael Rymer", bio:"​From Wikipedia, the free encyclopedia.   \n\nMichael Rymer (born 1963 in Australia) is a television and film director, best known for his work on the re-imagined Battlestar Galactica TV series, for which he directed the pilot miniseries and several episodes of the series, and for the 2002 feature film, Queen of the Damned. \n\nDescription above from the Wikipedia article Michael Rymer   licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/28741"}}, {tmdbId:"13496", properties:{bornIn:"Roermond, Limburg, Netherlands", imdbId:"0331296", born:date('1948-12-09'), name:"Marleen Gorris", bio:"From Wikipedia, the free encyclopedia. \n\nMarleen Gorris (born 9 December 1948, Roermond) is a writer-director from the Netherlands.  Gorris is known as an outspoken feminist and supporter of gay and lesbian issues which is reflected in much of her work. \n\nShe wrote and directed the films A Question of Silence (1982), Broken Mirrors (1984), The Last Island (1991), and Antonia's Line (1995 - Oscar winner for Best Foreign Language Film), Mrs...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sSVUF5IE4nF4CCLzkwCfRmQz1Ws.jpg", url:"https://themoviedb.org/person/13496"}}, {tmdbId:"865", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0000881", born:date('1965-02-17'), name:"Michael Bay", bio:"Michael Benjamin Bay is an American film director and producer.  He is best known for directing high-budget action films characterized by fast edits, polished visuals and substantial use of practical effects.  His films, which include The Rock, Armageddon, Pearl Harbor and the Bad Boys and Transformers series, have grossed over three billion dollars world-wide.  He is co-founder of commercial production house The Institute , a. k. a.  The Institute for the Development of Enhanced Perceptual Awareness...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rkC7lei20x5xlFH4SivAXXBh6uR.jpg", url:"https://themoviedb.org/person/865"}}, {tmdbId:"42301", properties:{bornIn:"England, UK", imdbId:"0364578", born:date('1958-08-02'), name:"Damian Harris", bio:"From Wikipedia, the free encyclopedia\n\nDamian David Harris (born 2 August 1958) is an English film director and screenwriter. \n\nDescription above from the Wikipedia article Damian Harris, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/42301"}}, {tmdbId:"120229", properties:{bornIn:"Mianeh, Iran", imdbId:"0070159", born:date('1960-07-11'), name:"Jafar Panahi", bio:"Jafar Panahi is a representative of Iranian “New Wave. ” He is one of the leaders of contemporary Iranian cinema.  Panahi’s work, from his first attempts to discuss social issues to his later and braver discussions of taboo topics in Iran are a creative reflection on the nature of cinema and human society, and are imbued with humanity.  In 2010, the court in Iran sentenced Jafar Panahi to six years in prison...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/viZZkkfcuWze68bvUiMZmYZe8Qg.jpg", url:"https://themoviedb.org/person/120229"}}, {tmdbId:"65390", properties:{bornIn:"New York, New York, U.S.A.", imdbId:"0436284", born:date('1964-08-15'), name:"Scott Kalvert", died:date('2014-03-05'), url:"https://themoviedb.org/person/65390"}}, {tmdbId:"71338", properties:{imdbId:"0805965", born:date('1958-01-01'), name:"Holly Goldberg Sloan", url:"https://themoviedb.org/person/71338"}}, {tmdbId:"115983", properties:{imdbId:"0576509", name:"Alan Mehrez", url:"https://themoviedb.org/person/115983"}}, {tmdbId:"131878", properties:{imdbId:"0910905", name:" Harvey Wang", url:"https://themoviedb.org/person/131878"}}, {tmdbId:"133183", properties:{imdbId:"0455214", name:"Robert Lee King", url:"https://themoviedb.org/person/133183"}}, {tmdbId:"1087439", properties:{imdbId:"0640157", name:" Raoul O'Connell", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/JQoOAGzKDGTYgY60CiOvWyQjGX.jpg", url:"https://themoviedb.org/person/1087439"}}, {tmdbId:"172", properties:{bornIn:"Blackburn, Lancashire, England, UK", imdbId:"0935863", born:date('1961-03-29'), name:"Michael Winterbottom", bio:"Michael Winterbottom is a prolific English filmmaker who has directed seventeen feature films in the past fifteen years.  He began his career working in British television before moving into features.  Three of his films — Welcome to Sarajevo, Wonderland and 24 Hour Party People — have been nominated for the Palme d'Or at the Cannes Film Festival...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/r4cpuukDMG3xLS8tEaTV7X2IxnO.jpg", url:"https://themoviedb.org/person/172"}}, {tmdbId:"139593", properties:{bornIn:"Tuxpan, Veracruz, Mexico", imdbId:"0284639", born:date('1939-04-23'), name:"Jorge Fons", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lkordlnzzBlsf1O0yosSqlDNnZE.jpg", url:"https://themoviedb.org/person/139593"}}, {tmdbId:"11887", properties:{bornIn:"Washington, D.C., USA", imdbId:"0797869", born:date('1963-09-08'), name:"Brad Silberling", bio:"Brad Silberling is an American television and film director...", url:"https://themoviedb.org/person/11887"}}, {tmdbId:"18246", properties:{imdbId:"0314665", name:"Chris Gerolmo", url:"https://themoviedb.org/person/18246"}}, {tmdbId:"107730", properties:{bornIn:"Đà Nẵng, Central Vietnam", imdbId:"0870843", born:date('1962-12-23'), name:"Tran Anh Hung", bio:"​From Wikipedia, the free encyclopedia.   \n\nTrần Anh Hùng (born December 23, 1962) is a French film director of Vietnamese ancestry.  He was born in Đà Nẵng, Central Vietnam, and emigrated to France when he was 12 following the fall of Saigon at the end of the Vietnam War in 1975.  Trần has long been considered as having been in the forefront of the wave of acclaimed overseas Vietnamese cinema in the past two decades...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4P3WKhdEzLbxvbx313Vr6uhjCs2.jpg", url:"https://themoviedb.org/person/107730"}}, {tmdbId:"974388", properties:{imdbId:"0759410", name:"Hal Salwen", url:"https://themoviedb.org/person/974388"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"58154", properties:{imdbId:"0052944", name:"Jack Baran", url:"https://themoviedb.org/person/58154"}}, {tmdbId:"25210", properties:{bornIn:"South Bend, Indiana, USA", imdbId:"0505230", name:"Jeremy Leven", bio:"Jeremy Leven (born 1941) is an American screenwriter, director, producer, and novelist.  Born in South Bend, Indiana, Leven lives in Woodbridge, Connecticut, Nantucket, and Paris. \n\nLeven was educated at St.  John's College in Annapolis, Maryland, Harvard University, the University of Connecticut and Yale University Medical School.  While at Harvard he founded a satirical revue called The Proposition that ran for ten years in Cambridge, Massachusetts and off-Broadway...", url:"https://themoviedb.org/person/25210"}}, {tmdbId:"57865", properties:{bornIn:"Bilbao, Spain", imdbId:"0407067", born:date('1965-12-04'), name:"Álex de la Iglesia", bio:"​From Wikipedia, the free encyclopedia.   \n\nAlejandro \"Álex\" de la Iglesia Mendoza (born December 4, 1965) is a Spanish film director. \n\nMost of De La Iglesia's films reached cult status thanks to their weird sense of humour. \n\nDescription above from the Wikipedia article Álex de la Iglesia Mendoza  licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vyZFSSNtY2jL06v4nJHLIT5fWa2.jpg", url:"https://themoviedb.org/person/57865"}}, {tmdbId:"222216", properties:{imdbId:"0557501", born:date('1966-06-18'), name:"Laetitia Masson", url:"https://themoviedb.org/person/222216"}}, {tmdbId:"68774", properties:{imdbId:"0578757", name:"Christopher Menaul", url:"https://themoviedb.org/person/68774"}}, {tmdbId:"87695", properties:{bornIn:"Lamezia Terme, Calabria, Italy", imdbId:"0137363", born:date('1960-04-16'), name:"Carlo Carlei", bio:"Carlo Carlei was born on April 16, 1960 in Lamezia Terme, Calabria, Italy.  \n\nHe is a director and writer, known for The Flight of the Innocent (1992), The Last Legion (2007) and Padre Pio (2000)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AnGWfGNQDq3guQX6fGZWCWDHmop.jpg", url:"https://themoviedb.org/person/87695"}}, {tmdbId:"3111", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0734319", born:date('1956-08-18'), name:" Alexandre Rockwell", bio:"Alexandre Rockwell was born in Boston in 1956.  His first film, LENZ, premiered at the Berlin Film Festival in 1982.  After his road movie HERO (1983), he directed the legendary SAM FULLER IN SONS (1989).  In 1992 he won the Grand Jury Prize at the Sundance Film Festival for his film IN THE SOUP, which made his reputation as one of the most interesting filmmakers on America’s independent film scene.  SOMEBODY TO LOVE (1994) competed at the Venice flim Festival...", url:"https://themoviedb.org/person/3111"}}, {tmdbId:"37932", properties:{bornIn:"New York City, New York, USA", imdbId:"0336620", born:date('1969-07-17'), name:"F. Gary Gray", bio:"Felix Gary Gray (born July 17, 1969) is an American filmmaker, music video director, and actor.  Gray directed Friday, Set It Off, The Negotiator, and Straight Outta Compton, as well as the remake of The Italian Job. \n\nGray was born in New York.  He began his career in 1989 when he appeared uncredited in the satire comedy film Major League.  Three years later, he directed the music video for Ice Cube's \"It Was a Good Day. \" The video is a literal adaptation of the lyrics...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lVbwLnxtdiQaS8oGWFZMkhATLc5.jpg", url:"https://themoviedb.org/person/37932"}}, {tmdbId:"114468", properties:{bornIn:" Australia", imdbId:"0229914", born:date('1952-01-01'), name:"Kevin James Dobson", url:"https://themoviedb.org/person/114468"}}, {tmdbId:"15775", properties:{imdbId:"0510674", name:"Kevin Lima", bio:"From Wikipedia, the free encyclopedia. \n\nKevin Lima (born c.  1962) is an American film director who has directed a number of Disney films including his debut film A Goofy Movie in 1995, Tarzan, 102 Dalmatians, Eloise at the Plaza, Eloise at Christmastime and Enchanted.  Before directing, he worked as an animator and character designer on films such as The Little Mermaid and The Great Mouse Detective and a story editor for Aladdin and Oliver &amp; Company...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kNqnN6z8S6DcfSTBDQ4G8pYXb3S.jpg", url:"https://themoviedb.org/person/15775"}}, {tmdbId:"122728", properties:{imdbId:"0559879", born:date('1962-12-10'), name:"Charles Matthau", bio:"From Wikipedia, the free encyclopedia. \n\nCharles Matthau (b.  1962, New York City), is a film and television director and actor and the son of actor Walter Matthau.  He appeared as a child actor alongside his father in such films as Charley Varrick (1973), The Bad News Bears (1976) and House Calls (1978). \n\nAmong his directorial projects have been The Grass Harp, from a novella by Truman Capote, and the made-for-TV movie The Marriage Fool, both of which starred his father...", url:"https://themoviedb.org/person/122728"}}, {tmdbId:"940684", properties:{imdbId:"0859920", name:"Brett Thompson", url:"https://themoviedb.org/person/940684"}}, {tmdbId:"1016352", properties:{imdbId:"0691078", name:"Angela Pope", url:"https://themoviedb.org/person/1016352"}}, {tmdbId:"1265390", properties:{name:"J.F. Lawton", url:"https://themoviedb.org/person/1265390"}}, {tmdbId:"86035", properties:{imdbId:"0535940", name:"Maria Maggenti", bio:"Maria Maggenti (born 1962) is a film director and screenwriter for film and television. \n\nShe has been the script editor and has written many episodes of the American television series, Without a Trace (2003), but is perhaps best known for her feature film, The Incredibly True Adventure of Two Girls in Love (1995).  Her film Puccini for Beginners was in competition at the Sundance Film Festival in January 2006.  She was also an activist with ACT UP for many years...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3xTFdlQ4a7iblxtl8fAls0elnCM.jpg", url:"https://themoviedb.org/person/86035"}}, {tmdbId:"33279", properties:{bornIn:"Luton - England - UK", imdbId:"0134176", born:date('1968-01-01'), name:"Danny Cannon", bio:"From Wikipedia, the free encyclopedia. \n\nDanny Cannon (born 1968, in Luton, England) is a film and television screenwriter, director and producer. \n\nCannon began making films at the age of 16 in 1984, and started a youth experimental theatre group at 33 Arts Centre.  Using the centre's facilities, he was a very prolific director of video dramas and collaborated with a number of other directors in different roles including cameraman...", url:"https://themoviedb.org/person/33279"}}, {tmdbId:"58316", properties:{bornIn:"Jackson - Mississippi - USA", imdbId:"0287198", name:"John Fortenberry", url:"https://themoviedb.org/person/58316"}}, {tmdbId:"5656", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0000876", born:date('1969-09-03'), name:"Noah Baumbach", bio:"Noah Baumbach is an American filmmaker.  He has written and directed the films The Squid and the Whale and Marriage Story, for both of which he was nominated for the Academy Award for Best Original Screenplay...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pNCt2m8jfiX3YOiCdnJT3OPxNvm.jpg", url:"https://themoviedb.org/person/5656"}}, {tmdbId:"88912", properties:{bornIn:"Vesilahti, Finland", imdbId:"0344955", born:date('1957-12-03'), name:"Matti Grönberg", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vobfVtEHoEbonltlNaLDEOgMK9E.jpg", url:"https://themoviedb.org/person/88912"}}, {tmdbId:"24346", properties:{imdbId:"0809823", born:date('1954-12-12'), name:"Roy Allen Smith", url:"https://themoviedb.org/person/24346"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"117075", properties:{bornIn:"London, England", imdbId:"0415617", born:date('1938-01-26'), name:"Henry Jaglom", bio:"From Wikipedia, the free encyclopedia. \n\nHenry Jaglom is a London-born American film director and playwright. \n\nJaglom was born to a Jewish family in London, England, the son of Marie (née Stadthagen) and Simon M.  Jaglom, who worked in the import-export business.  His father was from a wealthy family from Russia and his mother was from Germany.  They left for England because of the Nazi regime.  Through his mother, he is a descendant of philosopher Moses Mendelssohn...", url:"https://themoviedb.org/person/117075"}}, {tmdbId:"72619", properties:{imdbId:"0864468", name:"Stacy Title", url:"https://themoviedb.org/person/72619"}}, {tmdbId:"11218", properties:{bornIn:"Mexico City, Mexico", imdbId:"0190859", born:date('1961-11-28'), name:"Alfonso Cuarón", bio:"Alfonso Cuarón Orozco is an Academy Award-winning Mexican film director, screenwriter and film producer, best known for Gravity, Children of Men, Y Tu Mamá También, Harry Potter and the Prisoner of Azkaban, and A Little Princess. \n\nCuarón was born in México City.  He is the son of Alfredo Cuarón, a nuclear physicist who worked for the United Nations' International Atomic Energy Agency for many years...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eoCHiXaQzGgx9RiwXnt3k239FLc.jpg", url:"https://themoviedb.org/person/11218"}}, {tmdbId:"94996", properties:{imdbId:"0492087", name:"Julianna Lavin", url:"https://themoviedb.org/person/94996"}}, {tmdbId:"15912", properties:{bornIn:"Cleveland, Ohio, USA", imdbId:"0350455", born:date('1949-10-04'), name:"Stephen Gyllenhaal", bio:"​From Wikipedia, the free encyclopedia.   \n\nStephen Roark Gyllenhaal (born October 4, 1949) is an American film director and poet...", url:"https://themoviedb.org/person/15912"}}, {tmdbId:"25645", properties:{bornIn:"Tokyo, Japan", imdbId:"0466153", born:date('1962-06-06'), name:"Hirokazu Koreeda", bio:"Hirokazu Koreeda (born 6 June 1962) graduated from Waseda University in 1987.  He is the winner of many awards at international film festivals.  In 1995, his directorial debut, Maborosi, won the 52nd Venice International Film Festival’s Golden Osella.   In 2011, I Wish won the Best Screenplay Award at the 59th San Sebastian International Film Festival.  In 2015, Our Little Sister received four awards at the Cannes Film Festival...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kGiVtlfQkpxmyR2uzgARVDmwQmS.jpg", url:"https://themoviedb.org/person/25645"}}, {tmdbId:"123827", properties:{bornIn:"Paris, France", imdbId:"0594158", born:date('1947-08-21'), name:"Frédéric Mitterrand", bio:"Frédéric Mitterrand (born 21 August 1947) is a French politician who served as Minister of Culture and Communication of France from 2009 to 2012 under President Nicolas Sarkozy.  Throughout his career, he has been an actor, screenwriter, television presenter, writer, producer and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fWKLZgrkI6QGNimrssOJmiykZw9.jpg", url:"https://themoviedb.org/person/123827"}}, {tmdbId:"45382", properties:{imdbId:"0787257", born:date('1962-11-07'), name:"Dirk Shafer", died:date('2015-01-01'), url:"https://themoviedb.org/person/45382"}}, {tmdbId:"187", properties:{bornIn:"Fukushima Prefecture, Japan", imdbId:"0645515", born:date('1961-12-13'), name:" Tensai Okamura", url:"https://themoviedb.org/person/187"}}, {tmdbId:"5065", properties:{bornIn:"New York City, New York, USA", imdbId:"0291205", born:date('1959-04-02'), name:"David Frankel", bio:"David Frankel is an American film and television director, screenwriter and executive producer.  He is the son of Max Frankel, a former executive editor of The New York Times.   Frankel lives in Miami, Florida with his wife, Jennifer Beber, and their two children...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xhiIfSUwQmELt4iSDdfAnC2QLBe.jpg", url:"https://themoviedb.org/person/5065"}}, {tmdbId:"42111", properties:{bornIn:" Los Angeles, California, USA", imdbId:"0818465", name:"Bryan Spicer", bio:"From Wikipedia, the free encyclopedia\n\nBryan Spicer is a director on numerous television series including Castle and 24.  He has also directed episodes of Day Break, Bones, House, Heroes, Killer Instinct, Vanished, Prison Break, Invasion, CSI: Crime Scene Investigation, The X-Files, The Lone Gunmen, In Plain Sight and V. \n\nSpicer also directed feature films For Richer or Poorer, McHale's Navy and Mighty Morphin Power Rangers: The Movie...", url:"https://themoviedb.org/person/42111"}}, {tmdbId:"555254", properties:{bornIn:"Gosen, Niigata Prefecture, Japan", imdbId:"0464911", born:date('1950-03-31'), name:"Yoshifumi Kondô", bio:"Yoshifumi Kondou was a Japanese animator.  He worked for Studio Ghibli in his last years, and was expected to become one of the top directors at Studio Ghibli, along with Hayao Miyazaki and Isao Takahata...", died:date('1998-01-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w9kQc580KK0uDS1NsiReHVS0DXR.jpg", url:"https://themoviedb.org/person/555254"}}, {tmdbId:"64030", properties:{imdbId:"0538614", name:"Kelly Makin", bio:"​From Wikipedia, the free encyclopedia\n\nKelly Makin is a Canadian television and movie director.  He directed some episodes of The Kids in the Hall comedy television series and also directed several episodes of Queer as Folk including that series' last episode.  More recently, Makin has directed episodes of Flashpoint, Less Than Kind and Death Comes to Town. \n\nHis film work includes Tiger Claws, National Lampoon's Senior Trip, Brain Candy and Mickey Blue Eyes...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cQqQJtSi5FEOVH6zri1Sldw54qE.jpg", url:"https://themoviedb.org/person/64030"}}, {tmdbId:"1080309", properties:{bornIn:"Bonn, Germany", imdbId:"0644467", born:date('1961-01-01'), name:"Susanne Ofteringer", url:"https://themoviedb.org/person/1080309"}}, {tmdbId:"15798", properties:{imdbId:"0322128", born:date('1953-01-01'), name:"Lesli Linka Glatter", bio:"Lesli Linka Glatter is an American film and television director and producer.  She began her directing career through American Film Institute's Directing Workshop for Women; her first (short) film \"Tales of Meeting and Parting\" was nominated for an Academy Award in 1984...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8F13UPsRnXWTDcp8iA3ZXMtfJa3.jpg", url:"https://themoviedb.org/person/15798"}}, {tmdbId:"56714", properties:{bornIn:"New York City, New York, USA", imdbId:"0902939", born:date('1966-09-14'), name:"Daisy von Scherler Mayer", bio:"From Wikipedia, the free encyclopedia. \n\nDaisy von Scherler Mayer (b.  September 14, 1966, New York City, New York) is an American film director. \n\nDescription above from the Wikipedia article Daisy von Scherler Mayer, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ebJciI29YXLqblVayOIHqOAh4pD.jpg", url:"https://themoviedb.org/person/56714"}}, {tmdbId:"583926", properties:{imdbId:"0772082", name:"Frieder Schlaich", url:"https://themoviedb.org/person/583926"}}, {tmdbId:"583912", properties:{bornIn:"Stuttgart, Germany", imdbId:"0901861", born:date('1963-01-30'), name:" Irene von Alberti", url:"https://themoviedb.org/person/583912"}}, {tmdbId:"7017", properties:{bornIn:"South Africa", imdbId:"0585011", born:date('1956-06-05'), name:"Roger Michell", bio:"Roger Michell (born 5 June 1956) is an English theatre, television and film director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9gYGbwU9R1gpONfZONCVXyQn7t9.jpg", url:"https://themoviedb.org/person/7017"}}, {tmdbId:"994323", properties:{bornIn:"Honolulu, Hawaii, USA", imdbId:"0368981", born:date('1958-03-18'), name:"Kayo Hatta", died:date('2005-07-20'), url:"https://themoviedb.org/person/994323"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"65530", properties:{bornIn:"Long Beach, California, USA", imdbId:"0300265", born:date('1954-11-05'), name:"Mike Gabriel", url:"https://themoviedb.org/person/65530"}}, {tmdbId:"2873", properties:{imdbId:"0258424", born:date('1943-12-01'), name:"Anne Goursaud", bio:"French filmmaker known for her work editing Francis Ford Coppola films like Bram Stoker's Dracula and The Outsiders.  She has also directed Poison Ivy II and Embrace of the Vampire...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/p00sjw0puqjfL9QeNRZSVRzQYvl.jpg", url:"https://themoviedb.org/person/2873"}}, {tmdbId:"28902", properties:{imdbId:"0927074", name:"Gregory Widen", bio:"​From Wikipedia, the free encyclopedia.   \n\nGregory Widen is an American screenwriter and film director. \n\nA student in UCLA's screenwriting program, he sold his script for Highlander while still an undergraduate.  Before entering the UCLA program, Widen attended Saddleback College in Mission Viejo, California. \n\nWiden worked as a firefighter for three years.  He witnessed a person killed by an explosive backdraft, which became the basis for the screenplay for the movie Backdraft...", url:"https://themoviedb.org/person/28902"}}, {tmdbId:"23757", properties:{bornIn:"Queens - New York City - New York - USA", imdbId:"0104481", born:date('1950-11-29'), name:"Joshua Brand", bio:"Joshua Brand was born on November 29, 1950 in Queens, New York, USA.  He is a writer and producer...", url:"https://themoviedb.org/person/23757"}}, {tmdbId:"33315", properties:{bornIn:"Cheltenham, England", imdbId:"0518644", born:date('1946-10-20'), name:"Richard Loncraine", bio:"From Wikipedia, the free encyclopedia. \n\nRichard Loncraine is a British film and television director. \n\nLoncraine received early training in the features department of the BBC, including a season directing items for Tomorrow's World.  Before his career in film, he was a sculptor and the first to create a chrome Newton's cradle. \n\nDescription above from the Wikipedia article Richard Loncraine, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/33315"}}, {tmdbId:"133420", properties:{imdbId:"0672543", name:"Clare Peploe", url:"https://themoviedb.org/person/133420"}}, {tmdbId:"57028", properties:{imdbId:"0398986", name:"George Huang", bio:"From Wikipedia, the free encyclopedia. \n\nGeorge Huang is a Taiwanese-American film-maker.  In addition to working on his own films, he also frequently contributes work to other independent film-makers, especially Robert Rodríguez...", url:"https://themoviedb.org/person/57028"}}, {tmdbId:"17880", properties:{imdbId:"0834338", born:date('1954-02-11'), name:"Wesley Strick", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/t4ggAaMWTYRtWyB1nz1BPJilujC.jpg", url:"https://themoviedb.org/person/17880"}}, {tmdbId:"20237", properties:{bornIn:"North London, England, UK", imdbId:"0452319", name:"Beeban Kidron", bio:"From Wikipedia, the free encyclopedia. \n\nBeeban Kidron is an English Film Director known for her much-lauded adaptation of Jeanette Winterson's autobiographical novel Oranges Are Not the Only Fruit and for directing Bridget Jones: The Edge of Reason.  In 2008 with Lindsey Mackie she founded the charity Filmclub, which has since grown to be one of the largest and most influential after-school clubs in the UK, attracting over 160,000 children and young people each week...", url:"https://themoviedb.org/person/20237"}}, {tmdbId:"78021", properties:{bornIn:"New York City, New York, USA", imdbId:"0442207", born:date('1945-12-30'), name:"Lloyd Kaufman", bio:"An American film director, producer, screenwriter and occasional actor.  With producer Michael Herz, he is the co-founder of Troma Entertainment film studio, and the director of many of their feature films, including The Toxic Avenger and Tromeo and Juliet.  Kaufman also serves as chairman of the Independent Film & Television Alliance...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4jNIqeZBK2YbpPupBhl4l1moQn5.jpg", url:"https://themoviedb.org/person/78021"}}, {tmdbId:"1046169", properties:{imdbId:"0893895", name:"Pat Verducci", url:"https://themoviedb.org/person/1046169"}}, {tmdbId:"76705", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"0926211", born:date('1962-06-26'), name:"Preston A. Whitmore II", bio:"From Wikipedia, the free encyclopedia\n\nPreston Alexander Whitmore II (born June 26, 1962) is an US screenwriter, producer, and director.  Preston is best known for his 2007 comedy-drama This Christmas.  The film garnered Preston an NAACP Image Award nomination for Outstanding Directing in 2008. \n\nDescription above from the Wikipedia article Preston A.  Whitmore II, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/76705"}}, {tmdbId:"66605", properties:{bornIn:"Newark, New Jersey, USA", imdbId:"0001754", born:date('1959-03-15'), name:"Todd Solondz", bio:"​From Wikipedia, the free encyclopedia.   \n\nTodd Solondz (born October 15, 1959) is an American independent film screenwriter and director known for his style of dark, thought-provoking, socially conscious satire.  Solondz has been critically acclaimed for his examination of the \"dark underbelly of middle class American suburbia\", a reflection of his own background in New Jersey.  His work includes the cult hit Welcome to the Dollhouse, the award-winning Happiness, Storytelling, and Palindromes...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ke4e4ayQNr7nu3MywfdPQ9p65ff.jpg", url:"https://themoviedb.org/person/66605"}}, {tmdbId:"73494", properties:{imdbId:"0620290", name:"Desmond Nakano", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hpImuDSIGezDYUrT1GjOcEDNK7y.jpg", url:"https://themoviedb.org/person/73494"}}, {tmdbId:"952327", properties:{imdbId:"0500858", name:"Larry Leker", url:"https://themoviedb.org/person/952327"}}, {tmdbId:"71852", properties:{imdbId:"0754678", name:" Paul Sabella", url:"https://themoviedb.org/person/71852"}}, {tmdbId:"77076", properties:{bornIn:"Pawtucket, Rhode Island, USA", imdbId:"0180912", born:date('1959-04-06'), name:"Michael Corrente", bio:"From Wikipedia, the free encyclopedia. \n\nMichael Corrente is an American film director and producer from Pawtucket, Rhode Island.  His films include A Shot at Glory, American Buffalo, Outside Providence, Brooklyn Rules and Federal Hill. \n\nDescription above from the Wikipedia article Michael Corrente, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tHnxacF2J3RbYB23uSYKqgkhlNE.jpg", url:"https://themoviedb.org/person/77076"}}, {tmdbId:"28239", properties:{bornIn:"Los Angeles County, California, USA", imdbId:"0878638", born:date('1955-10-18'), name:"David Twohy", bio:"An American film director and screenwriter...", url:"https://themoviedb.org/person/28239"}}, {tmdbId:"7482", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0773603", born:date('1951-10-26'), name:"Julian Schnabel", bio:"Julian Schnabel is an American artist and filmmaker.  In the 1980s Schnabel received international media attention for his \"plate paintings\"—large-scale paintings set on broken ceramic plates. \n\nSchnabel directed Before Night Falls, which became Javier Bardem's breakthrough Academy Award nominated role and the four-time Academy Award nominated The Diving Bell and the Butterfly...", url:"https://themoviedb.org/person/7482"}}, {tmdbId:"67570", properties:{bornIn:"England", imdbId:"0531751", name:"Hettie Macdonald", bio:"Hettie MacDonald is an English film, theatre and television director who won a Grand Prix award, an International Jury Award - Honorable Mention and a People's Choice Award for her work on the film Beautiful Thing. \n\nMacDonald is known as the director of \"Blink\", the Hugo Award-winning 2007 episode of the Doctor Who series.  The episode is widely regarded as the best episode of the series since its 2005 revival...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ryO5yz8GOodefNXLMWa8ECahNPm.jpg", url:"https://themoviedb.org/person/67570"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"31093", properties:{imdbId:"0438394", name:" Yvette Kaplan", url:"https://themoviedb.org/person/31093"}}, {tmdbId:"10296", properties:{imdbId:"0325533", name:"Michael Goldenberg", url:"https://themoviedb.org/person/10296"}}, {tmdbId:"552613", properties:{bornIn:"Contea di Sanyuan, Xianyang, Cina", imdbId:"0943177", born:date('1939-12-05'), name:"Tian-Ming Wu", died:date('2014-03-04'), url:"https://themoviedb.org/person/552613"}}, {tmdbId:"1038016", properties:{bornIn:"California, USA", imdbId:"0579690", born:date('1965-10-12'), name:"Nina Menkes", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5d0yCaOTzYe9SPfMesHv85E6LQV.jpg", url:"https://themoviedb.org/person/1038016"}}, {tmdbId:"5655", properties:{bornIn:"Houston, Texas, USA", imdbId:"0027572", born:date('1969-05-01'), name:"Wes Anderson", bio:"Wesley Wales Anderson (born May 1, 1969) is an American film director, screenwriter, actor, and producer of features, short films and commercials. \n\nHe was nominated for a 2001 Academy Award for Best Original Screenplay for The Royal Tenenbaums.  Anderson has been called an auteur, as he is involved in every aspect of his films' production.  His films employ a similar aesthetic, employing a deliberate, methodical cinematography, with mostly primary colors...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/b1LH059EGnU01rsZwcqYzNjY7w9.jpg", url:"https://themoviedb.org/person/5655"}}, {tmdbId:"9340", properties:{bornIn:"Chicago, Illinois, USA ", imdbId:"0905154", born:date('1965-06-21'), name:"Lana Wachowski", bio:"Lana Wachowski (born June 21, 1965) and Lilly Wachowski (born December 29, 1967), siblings collectively known as The Wachowskis, are American film directors, writers and producers, most famous for creating The Matrix series and the Netflix show Sense8...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ppGicszb7PxGDAI2F6qBTXrn1t0.jpg", url:"https://themoviedb.org/person/9340"}}, {tmdbId:"9339", properties:{bornIn:"Chicago, Illinois, United States", imdbId:"0905152", born:date('1967-12-29'), name:" Lilly Wachowski", bio:"Lana Wachowski (born June 21, 1965) and Lilly Wachowski (born December 29, 1967), siblings collectively known as The Wachowskis, are American film directors, writers and producers, most famous for creating The Matrix series and the Netflix show Sense8...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9sxE10LUA7TGlS1pHw2RM6mckHp.jpg", url:"https://themoviedb.org/person/9339"}}, {tmdbId:"129708", properties:{imdbId:"0168214", name:"Stacy Cochran", url:"https://themoviedb.org/person/129708"}}, {tmdbId:"102688", properties:{imdbId:"0934912", name:"Jonathan Winfrey", url:"https://themoviedb.org/person/102688"}}, {tmdbId:"1175207", properties:{imdbId:"0213726", name:"Tom DeCerchio", url:"https://themoviedb.org/person/1175207"}}, {tmdbId:"17520", properties:{bornIn:"Neuilly-sur-Seine, Hauts-de-Seine, France", imdbId:"0458251", born:date('1961-09-04'), name:"Cédric Klapisch", bio:"Cédric Klapisch (born September 4, 1961), is a French film director.  Klapisch was born at Neuilly-sur-Seine, Hauts-de-Seine.  He is from a Jewish family; his maternal grandparents were deported to Auschwitz.  He studied cinema at the University of Paris III: Sorbonne Nouvelle as well as at the University of Paris VIII.  He was rejected on two occasions by the prestigious French film school IDHEC (Institut des hautes études cinématographiques), now known as La fémis...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rKyrzbJcOQKMU1TqzUvkt7tghcG.jpg", url:"https://themoviedb.org/person/17520"}}, {tmdbId:"13235", properties:{bornIn:"Omaha, Nebraska, USA", imdbId:"0668247", born:date('1961-02-10'), name:"Alexander Payne", bio:"Constantine Alexander Payne (born February 10, 1961) is an American film director and screenwriter.  His films are noted for their dark humor and satirical depictions of contemporary American society...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4QMK5x7gUVswx6gvmlSvs5GREPR.jpg", url:"https://themoviedb.org/person/13235"}}, {tmdbId:"45649", properties:{bornIn:"Chicago Heights, Illinois, USA", imdbId:"0054077", born:date('1956-06-30'), name:"Paris Barclay", bio:"Paris Barclay is an American producer, writer and director for film and television.  He is also the current President of the Directors Guild of America since 2013...", url:"https://themoviedb.org/person/45649"}}, {tmdbId:"1031288", properties:{imdbId:"0213329", name:"Tiffanie DeBartolo", url:"https://themoviedb.org/person/1031288"}}, {tmdbId:"32983", properties:{bornIn:"New York, New York, U.S.A.", imdbId:"0569790", born:date('1958-02-12'), name:"Douglas McGrath", bio:"Douglas Geoffrey McGrath (born February 12, 1958) is an American screenwriter, film director, and actor...", url:"https://themoviedb.org/person/32983"}}, {tmdbId:"68319", properties:{imdbId:"0363326", name:"Robert Harling", url:"https://themoviedb.org/person/68319"}}, {tmdbId:"2523", properties:{bornIn:"England, U.K.", imdbId:"0000829", born:date('1947-01-14'), name:"Stuart Baird", bio:"From Wikipedia, the free encyclopedia\n\nStuart Baird (born 30 November 1947) is an English film editor, producer, and director who is mainly associated with action films.  He has edited over twenty major motion pictures. \n\nDescription above from the Wikipedia article Stuart Baird, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/2523"}}, {tmdbId:"73838", properties:{imdbId:"0047076", name:"Steven Baigelman", url:"https://themoviedb.org/person/73838"}}, {tmdbId:"135163", properties:{imdbId:"0834201", name:"Susan Streitfeld", url:"https://themoviedb.org/person/135163"}}, {tmdbId:"4760", properties:{bornIn:"Amritsar, India", imdbId:"0576548", born:date('1950-01-01'), name:"Deepa Mehta", bio:"From Wikipedia, the free encyclopedia. \n\nDeepa Mehta, LLD (born 1 January 1950 in Amritsar, Punjab, India) is a Genie Award-winning and Academy Award-nominated Indian-born Canadian film director and screenwriter, most known for her Elements Trilogy, Fire (1996), Earth (1998), and Water (2005), which was nominated for Academy Award for Best Foreign Language Film.  She also co-founded Hamilton-Mehta Productions, with her husband, producer David Hamilton in 1996...", url:"https://themoviedb.org/person/4760"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Director;
UNWIND [{tmdbId:"119310", properties:{imdbId:"0371852", name:"Annette Haywood-Carter", url:"https://themoviedb.org/person/119310"}}, {tmdbId:"120226", properties:{bornIn:"Tehran, Iran", imdbId:"0538532", born:date('1957-05-29'), name:"Mohsen Makhmalbaf", bio:"From Wikipedia, the free encyclopedia. \n\nMohsen Makhmalbaf (Mohsen Mäxmälbaf, born May 29, 1957) is an Iranian film director, writer, editor, and producer.  During 2007 he was the president of Asian Film Academy. \n\nMakhmalbaf's films have been widely presented in international film festivals in the past ten years.  The multi-award-winning director, belongs to the new wave movement of Iranian cinema.  Time magazine selected Makhmalbaf's 2001 film, Kandahar, as one of top 100 films of all time...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nM9GbPg5CyrtA9FkP2PcVyb71sv.jpg", url:"https://themoviedb.org/person/120226"}}, {tmdbId:"75882", properties:{imdbId:"0082835", born:date('1970-02-14'), name:"S.R. Bindler", url:"https://themoviedb.org/person/75882"}}, {tmdbId:"18320", properties:{imdbId:"0400486", name:"Bronwen Hughes", bio:"From Wikipedia, the free encyclopedia. \n\nBronwen Hughes is a Canadian film director.  She was born in Toronto. \n\nDescription above from the Wikipedia article Bronwen Hughes, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/18320"}}, {tmdbId:"88970", properties:{bornIn:"Johannesburg, South Africa", imdbId:"0956537", name:"Ralph Ziman", url:"https://themoviedb.org/person/88970"}}, {tmdbId:"176246", properties:{bornIn:"Illinois - USA", born:date('1962-06-23'), name:"Kevin Yagher", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vdmAyU1mghOKUEpg5W6KSqu3FZ7.jpg", url:"https://themoviedb.org/person/176246"}}, {tmdbId:"4755", properties:{bornIn:"Santa Monica, California, USA", imdbId:"0254786", born:date('1952-09-08'), name:"David R. Ellis", bio:"From Wikipedia, the free encyclopedia  David Richard Ellis is an American film director and former stuntman...", died:date('2013-01-07'), url:"https://themoviedb.org/person/4755"}}, {tmdbId:"58922", properties:{bornIn:"Australia", imdbId:"0742194", name:"Craig Rosenberg", url:"https://themoviedb.org/person/58922"}}, {tmdbId:"1388631", properties:{bornIn:"Los Angeles, CA", imdbId:"0145684", born:date('1958-07-20'), name:"Rick Castro", bio:"Rick Castro is an American photographer, motion picture director, stylist, curator and blogger whose work focuses on bondage and sadomasochistic sex...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dmAMSGyHGIQvwQWfsClcZG6tC03.jpg", url:"https://themoviedb.org/person/1388631"}}, {tmdbId:"1115333", properties:{bornIn:"Tiverton, Ontario, Canada", imdbId:"0478418", born:date('1964-01-03'), name:" Bruce La Bruce", bio:"Bruce LaBruce is an internationally acclaimed Canadian filmmaker, photographer, writer, and artist based in Toronto.  Along with a number of short films, he has written and directed nine feature films, including Gerontophilia, which won the Grand Prix at the Festival du Nouveau Cinema in Montreal in 2013, and Pierrot Lunaire, which won the Teddy Award Special Jury Prize at the Berlinale in 2014...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vtVlBQw9OaletV3EfYWwzMDFFQM.jpg", url:"https://themoviedb.org/person/1115333"}}, {tmdbId:"16378", properties:{bornIn:"Ontario, Canada", imdbId:"0366004", born:date('1953-01-12'), name:"Mary Harron", bio:"From Wikipedia, the free encyclopedia. \n\nMary Harron (born January 12, 1953) is a Canadian filmmaker and screenwriter best known for her films I Shot Andy Warhol, American Psycho and The Notorious Bettie Page. \n\nDescription above from the Wikipedia article Mary Harron, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4Pwu7Vm6lmo3T2p8AcwCd3mG6nX.jpg", url:"https://themoviedb.org/person/16378"}}, {tmdbId:"144256", properties:{imdbId:"0306949", name:"Herb Gardner", url:"https://themoviedb.org/person/144256"}}, {tmdbId:"1112916", properties:{imdbId:"0575361", name:"Nancy Meckler", url:"https://themoviedb.org/person/1112916"}}, {tmdbId:"42175", properties:{bornIn:"Fish Hoek, South Africa", imdbId:"0822582", born:date('1966-11-22'), name:" Richard Stanley", bio:"Richard Stanley (born 22 November 1966) is a South African film director and screenwriter.  Stanley works and lives in Montségur, France...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vI3tIvvqUdjC1v8uVtIaDnEDWX4.jpg", url:"https://themoviedb.org/person/42175"}}, {tmdbId:"71110", properties:{imdbId:"0668500", name:"John Payson", url:"https://themoviedb.org/person/71110"}}, {tmdbId:"51575", properties:{imdbId:"0340037", name:"Leslie Greif", url:"https://themoviedb.org/person/51575"}}, {tmdbId:"7395", properties:{bornIn:"Cumberland, Rhode Island, USA", imdbId:"0268370", born:date('1958-06-17'), name:"Bobby Farrelly", bio:"From Wikipedia, the free encyclopedia. \n\nRobert Leo \"Bobby\" Farrelly, Jr.  (born June 17, 1958) is an American film director, screenwriter and producer. \n\nDescription above from the Wikipedia article Bobby Farrelly, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/i5mt42m2MjMpFVrVYlYmp5ylLDy.jpg", url:"https://themoviedb.org/person/7395"}}, {tmdbId:"7396", properties:{bornIn:"Phoenixville, Pennsylvania, USA", imdbId:"0268380", born:date('1956-12-17'), name:" Peter Farrelly", bio:"From Wikipedia, the free encyclopedia. \n\nPeter John Farrelly (born December 17, 1956) is an American film director, screenwriter, producer and novelist.  The Farrelly Brothers are mostly famous for directing and producing gross-out humor romantic comedy films such as, Dumb and Dumber, Me, Myself and Irene, There's Something About Mary and The Heartbreak Kid. \n\nDescription above from the Wikipedia article Peter Farrelly, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8vLjukhhj4dKQSbtZ8qFr2Ybf5T.jpg", url:"https://themoviedb.org/person/7396"}}, {tmdbId:"1215282", properties:{imdbId:"0832369", name:"Lynne Stopkewich", url:"https://themoviedb.org/person/1215282"}}, {tmdbId:"11688", properties:{imdbId:"0841232", born:date('1965-02-06'), name:"Jan Sverák", bio:"Režisér Jan Svěrák je držitelem dvou Oscarů: prvního už za studentský film Ropáci a druhého za nejlepší cizojazyčný film Kolja...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8U998Mpjg36WHZxaLKEx34oUBvp.jpg", url:"https://themoviedb.org/person/11688"}}] AS row
