UNWIND [{tmdbId:"84519", properties:{imdbId:"0235242", name:"Santiago Douglas", url:"https://themoviedb.org/person/84519"}}, {tmdbId:"65426", properties:{bornIn:"Tokyo, Japan", imdbId:"0407372", born:date('1977-01-03'), name:"Mayumi Iizuka", bio:"Mayumi Iizuka is a Japanese voice actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n6wcdcgg79ywGpkKgeV52em54v7.jpg", url:"https://themoviedb.org/person/65426"}}, {tmdbId:"90567", properties:{bornIn:" Tokyo, Japan", imdbId:"0782840", born:date('1972-09-08'), name:"Tomokazu Seki", bio:"Seki Tomokazu (born September 8, 1972) is a popular and very famous seiyuu in Japan.  He formerly worked for Haikyou, now he is the head of Atomic Monkey...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tw46noc1nTjJ2PU3SzVxKTXKmiO.jpg", url:"https://themoviedb.org/person/90567"}}, {tmdbId:"49148", properties:{bornIn:"Freeport, Illinois, USA", imdbId:"0001222", born:date('1964-11-11'), name:"Calista Flockhart", bio:"Calista Flockhart (born November 11, 1964) is an American actress who is primarily recognized for her work in television.  She is best known for playing the title character in Ally McBeal, and her role as Cat Grant in Supergirl. \n\nDuring her career, she has received a Golden Globe Award, a Screen Actors Guild Award and three Emmy Award nominations...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l5mSlK7fgG4UXKKL9N7dXpl105a.jpg", url:"https://themoviedb.org/person/49148"}}, {tmdbId:"189636", properties:{bornIn:"Kentville, Nova Scotia, Canada", imdbId:"0232195", born:date('1941-06-01'), name:"Richard Donat", url:"https://themoviedb.org/person/189636"}}, {tmdbId:"549355", properties:{imdbId:"0325528", name:"Jeffrey Golden", url:"https://themoviedb.org/person/549355"}}, {tmdbId:"1243178", properties:{imdbId:"0598528", name:"Marcus Monroe", url:"https://themoviedb.org/person/1243178"}}, {tmdbId:"65871", properties:{bornIn:"Honolulu - Hawaii - USA", imdbId:"0776040", born:date('1978-08-26'), name:"Amanda Schull", bio:"Amanda Schull was born on August 26, 1978 in Honolulu, Hawaii, USA.  She is an actress, known for 12 Monkeys (2015), Suits (2011) and Pretty Little Liars (2010).  She has been married to George Wilson since May 28, 2011...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nakdxAUxYobF7TgPa6uzMXtiycs.jpg", url:"https://themoviedb.org/person/65871"}}, {tmdbId:"1943901", properties:{name:"Christine Dunham", url:"https://themoviedb.org/person/1943901"}}, {tmdbId:"171472", properties:{bornIn:"Lowell - Massachusetts - USA", imdbId:"0687694", born:date('1953-01-01'), name:"Maryann Plunkett", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/317RSmgO74AhbqcfnYbAkVKWCXh.jpg", url:"https://themoviedb.org/person/171472"}}, {tmdbId:"110129", properties:{bornIn:"  Madrid, Spain", imdbId:"0180580", born:date('1957-08-14'), name:"José Coronado", bio:"José Coronado García (born 14 August 1957 in Madrid) is a Spanish film and television actor.   He won several awards for his performance as the lead actor in the 2011 film No habrá paz para los malvados, including a Goya, a Sant Jordi Award, and a Fotogramas de Plata award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3Bh99mRONes1xP7DyLLiLqgO7p7.jpg", url:"https://themoviedb.org/person/110129"}}, {tmdbId:"110116", properties:{bornIn:"Madrid, Spain", imdbId:"0273451", born:date('1985-01-31'), name:"Dafne Fernández", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/od6f5S8uGIe6laSSMjmAOr8G2iZ.jpg", url:"https://themoviedb.org/person/110116"}}, {tmdbId:"102550", properties:{bornIn:"Barcelona, Catalonia, Spain, EU", imdbId:"0482378", born:date('1959-11-21'), name:"Eulàlia Ramon", bio:"Eulalia Ramón is a Spanish film and television actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/erpJMOmTYaVQwfVwZM4yu6RPv9g.jpg", url:"https://themoviedb.org/person/102550"}}, {tmdbId:"992796", properties:{imdbId:"0508303", name:"Thilen Lhondup", url:"https://themoviedb.org/person/992796"}}, {tmdbId:"992797", properties:{imdbId:"0477312", name:"Gurgon Kyap", url:"https://themoviedb.org/person/992797"}}, {tmdbId:"14594", properties:{imdbId:"0874661", born:date('1972-01-01'), name:"Lhakpa Tsamchoe", url:"https://themoviedb.org/person/14594"}}, {tmdbId:"69310", properties:{bornIn:"Buenos Aires, Argentina", imdbId:"0201857", born:date('1957-01-16'), name:"Ricardo Darín", bio:"Ricardo Darín (born January 16, 1957) is an Argentine actor. \n\nDarín is one of the biggest movie stars in Argentina.  He played a number of parts in TV series for several years where he became popular as a young leading actor.  His most prominent roles as a film actor include Nine Queens (2000), El Hijo de la Novia (2001), Luna de Avellaneda (2004), El Aura (2005) and La Señal (2007), which was also his directorial debut.  He starred in the Academy Award winning film The Secret in Their Eyes (2009)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mqTbReiUrm3ih8Osi1K7Lqk5hlN.jpg", url:"https://themoviedb.org/person/69310"}}, {tmdbId:"93647", properties:{bornIn:"La Plata, Argentina", imdbId:"0897845", born:date('1969-06-19'), name:"Soledad Villamil", bio:"From Wikipedia, the free encyclopedia. \n\nSoledad Villamil (b.  La Plata, June 19, 1969) is an Argentine film and television actress and singer. \n\nDescription above from the Wikipedia article Soledad Villamil, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ojLw8ifWdVB5zk21u8rgbBkhsxD.jpg", url:"https://themoviedb.org/person/93647"}}, {tmdbId:"28508", properties:{imdbId:"0241696", born:date('1937-04-07'), name:"Ulises Dumont", bio:"From Wikipedia, the free encyclopedia  Ulises Dumont (April 7, 1937 – November 29, 2008) was a prolific Argentine film actor, credited with over 80 appearances in film and countless others in theatre and television from 1964 until his death in 2008.   Description above from the Wikipedia article Ulises Dumont, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2008-11-29'), url:"https://themoviedb.org/person/28508"}}, {tmdbId:"132449", properties:{bornIn:"Buenos Aires, Argentina", imdbId:"0087249", born:date('1958-02-28'), name:"Eduardo Blanco", url:"https://themoviedb.org/person/132449"}}] AS row
