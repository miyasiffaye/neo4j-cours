UNWIND [{tmdbId:"17678", properties:{bornIn:"Belton, Texas, USA", imdbId:"2199632", born:date('1982-09-21'), name:"Rudy Youngblood", bio:"Native American, of Comanche, Cree and Yaqui descent. Native name is Tee-Dee-Nae. Previously worked at construction jobs. Was selected from a general casting call to play the leading role of Jaguar Paw in the film Apocalypto (2006) by director Mel Gibson. Learned the Yucatec Maya language for his role in Apocalypto (2006). A Native dancer who has performed with the American Indian Dance Theater...", url:"https://themoviedb.org/person/17678"}}, {tmdbId:"17679", properties:{imdbId:"2199664", born:date('1985-08-14'), name:"Dalia Hernández", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9nA8P6CrQtwpQ8ejbnmDBaQNgPf.jpg", url:"https://themoviedb.org/person/17679"}}, {tmdbId:"17680", properties:{imdbId:"1372610", name:"Jonathan Brewer", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nE55aace8Y7VHDjiLsoYXjruBjP.jpg", url:"https://themoviedb.org/person/17680"}}, {tmdbId:"17681", properties:{imdbId:"1955464", name:"Morris Birdyellowhead", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rU5fuWNz8ZeVxa4aDZTkFQgJE6v.jpg", url:"https://themoviedb.org/person/17681"}}, {tmdbId:"26259", properties:{bornIn:"Brighton, England, UK", imdbId:"0269923", born:date('1946-11-25'), name:"Michael Feast", url:"https://themoviedb.org/person/26259"}}, {tmdbId:"34195", properties:{bornIn:"Bristol, Tennessee, USA", imdbId:"1724323", born:date('1979-07-16'), name:"Jayma Mays", bio:"Jayma Suzette Mays (born July 16, 1979) is an American television and film actress, and singer.  Mays' most prominent roles include that of Emma Pillsbury on the American television series Glee, recurring appearances on Ugly Betty and on Heroes as Charlie Andrews. \n\nDescription above from the Wikipedia article Jayma Mays, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n8tY5eVXje0vXTws66YAdEeHMy5.jpg", url:"https://themoviedb.org/person/34195"}}, {tmdbId:"122387", properties:{imdbId:"1987830", name:"Antti Satama", url:"https://themoviedb.org/person/122387"}}, {tmdbId:"122391", properties:{imdbId:"2024292", name:"Tiina Routamaa", url:"https://themoviedb.org/person/122391"}}, {tmdbId:"66213", properties:{imdbId:"1994659", born:date('1978-11-12'), name:"Samuli Torssonen", bio:"Samuli Torssonen (born 12 November 1978)[1] is a Finnish film writer, director, actor and producer, best known as the creator of the viral Star Wreck sci-fi series.   He was a producer and special-effects supervisor of the movie Iron Sky...", url:"https://themoviedb.org/person/66213"}}, {tmdbId:"76667", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0427358", born:date('1978-10-18'), name:"Wesley Jonathan", bio:"From Wikipedia, the free encyclopedia. \n\nWesley Jonathan Waples (born October 18, 1978), known professionally as Wesley Jonathan, is an American actor.  He is best known for his starring role as Jamal Grant on the NBC Saturday morning dramedy series City Guys, and as the dimwitted Gary Thorpe on The WB sitcom What I Like About You...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tUYWFvYJdv5hXWdJ1WakHw13RIC.jpg", url:"https://themoviedb.org/person/76667"}}, {tmdbId:"302415", properties:{imdbId:"1813440", born:date('1984-10-30'), name:"Eva Marcille", bio:"Eva Marcille Pigford (born October 30, 1984), known professionally as Eva Marcille, is an American actress, TV host and fashion model, who most recently played the role of Tyra Hamilton on the soap opera The Young and the Restless.  She started her career by winning the third cycle of America's Next Top Model.  She was previously credited by her birth name, \"Eva Pigford\", but changed her name for acting purposes...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8HJ17542CS8kvfb2ta5C7tAnBj4.jpg", url:"https://themoviedb.org/person/302415"}}, {tmdbId:"76669", properties:{bornIn:"Columbus, Georgia, U.S.", imdbId:"0103750", born:date('1972-06-02'), name:"Wayne Brady", bio:"Wayne Alphonso Brady (born June 2, 1972) is an Emmy Award winning actor, singer, comedian and television personality, known for his work as a regular on the American version of the improvisational comedy television series Whose Line Is It Anyway?, and as the host of the daytime talk show The Wayne Brady Show.  He was the original host of FOX's Don't Forget the Lyrics!, and currently hosts the 2009 revival of Let's Make a Deal...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/n4A2iMUm23JwTLsf7TFQpFm1bH9.jpg", url:"https://themoviedb.org/person/76669"}}, {tmdbId:"59620", properties:{bornIn:"Gravesend, Kent, England", imdbId:"2605345", born:date('1986-02-02'), name:"Gemma Arterton", bio:"English actress Gemma Arterton won her first professional role while she was still at drama school, in the BBC television drama Capturing Mary written and directed by Stephen Poliakoff.  Arterton made her stage debut as Rosaline in Shakespeare's Globe Theatre's production of Love's Labour's Lost in July 2007 before graduating later that year.   Also, Gemma made her big screen debut in the 2007 film St Trinian's as Head Girl Kelly...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/Alfm28oyHNiYweNCUaMmrVjVMAT.jpg", url:"https://themoviedb.org/person/59620"}}, {tmdbId:"17380", properties:{bornIn:"Taipei, Taiwan，China", imdbId:"1727100", born:date('1979-01-18'), name:"Jay Chou", bio:"Jay Chou (born January 18, 1979) is a Taiwanese musician, singer-songwriter, music and film producer, actor and director who has won the World Music Award four times.  He is well-known for composing all his own songs and songs for other singers.  In 1998 he was discovered in a talent contest where he displayed his piano and song-writing skills.  Over the next two years, he was hired to compose for popular Mandarin singers...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9wkudnDDSHC0fSTRIrsoEphGuOM.jpg", url:"https://themoviedb.org/person/17380"}}, {tmdbId:"53936", properties:{bornIn:"New York City - New York - USA", imdbId:"0246686", born:date('1984-04-25'), name:"Melonie Diaz", bio:"From Wikipedia, the free encyclopedia\n\nMelonie Diaz (born April 25, 1984) is an American actress who has been appeared in many independent films, including four shown at the 2008 Sundance Film Festival. \n\nDescription above from the Wikipedia article Melonie Diaz, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/t8q0kql4WeNsztoetbbD5JkrZzj.jpg", url:"https://themoviedb.org/person/53936"}}, {tmdbId:"76139", properties:{bornIn:"Birmingham, Alabama, USA", imdbId:"0004994", born:date('1947-04-02'), name:"Emmylou Harris", bio:"From Wikipedia, the free encyclopedia\n\nEmmylou Harris (born April 2, 1947 in Birmingham, Alabama) is an American singer-songwriter and musician...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/yR1AqJZu86kovV6PrRVCmxyjmU3.jpg", url:"https://themoviedb.org/person/76139"}}, {tmdbId:"1637506", properties:{name:"Ben Keith", url:"https://themoviedb.org/person/1637506"}}, {tmdbId:"1903962", properties:{name:"Spooner Oldham", url:"https://themoviedb.org/person/1903962"}}, {tmdbId:"47793", properties:{imdbId:"2073007", name:"George Babluani", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1zkZzhvecJJPN3iL8WyPCYuNaNP.jpg", url:"https://themoviedb.org/person/47793"}}, {tmdbId:"15482", properties:{bornIn:"Paris, France", imdbId:"0714534", born:date('1958-05-05'), name:"Aurélien Recoing", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qFWdIxvq6csxuso0PSiOV6rx49i.jpg", url:"https://themoviedb.org/person/15482"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"47796", properties:{imdbId:"0094445", name:"Pascal Bongard", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bZXt06EFZQQxqdS8ZirC5Y6Oef0.jpg", url:"https://themoviedb.org/person/47796"}}, {tmdbId:"47797", properties:{imdbId:"0880774", name:"Fred Ulysse", url:"https://themoviedb.org/person/47797"}}, {tmdbId:"2307357", properties:{imdbId:"1838836", name:"J.J. Johnson", url:"https://themoviedb.org/person/2307357"}}, {tmdbId:"59685", properties:{imdbId:"2212502", name:"Gary Commock", url:"https://themoviedb.org/person/59685"}}, {tmdbId:"47538", properties:{bornIn:"Nashville, Tennessee, USA", imdbId:"1648515", name:"Polly Adams", url:"https://themoviedb.org/person/47538"}}, {tmdbId:"59686", properties:{imdbId:"0019832", name:"Opal Alladin", url:"https://themoviedb.org/person/59686"}}, {tmdbId:"71375", properties:{bornIn:"Los Angeles, California, USA", imdbId:"2403277", born:date('1989-11-22'), name:"Alden Ehrenreich", bio:"Alden Caleb Ehrenreich (born November 22, 1989) is an American actor.  He made his feature-film debut in Francis Ford Coppola's Tetro in 2009, and also appeared in Coppola's subsequent film, Twixt (2011).  In 2013, he appeared in Woody Allen's Blue Jasmine and Park Chan-wook's Stoker...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hPbiRySz3k5XEZ3DwJtExnNTKiG.jpg", url:"https://themoviedb.org/person/71375"}}, {tmdbId:"29222", properties:{bornIn:"San Luis Obispo, California, USA", imdbId:"1374980", born:date('1987-10-18'), name:"Zac Efron", bio:"Zachary David Alexander Efron (born October 18, 1987) is an American actor, singer and dancer.  He began acting professionally in the early 2000s, and rose to prominence in the late 2000s for his leading role as Troy Bolton in the High School Musical franchise.  During this time, he also starred in the musical film Hairspray and the comedy film 17 Again...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6oXNHv7gAyXXYFpF943pKRsTtqQ.jpg", url:"https://themoviedb.org/person/29222"}}, {tmdbId:"67600", properties:{bornIn:"West Deal, New Jersey, USA", imdbId:"864308", born:date('1985-07-02'), name:"Ashley Tisdale", bio:"From Wikipedia, the free encyclopedia. \n\nAshley Michelle Tisdale (born July 2, 1985) is an American actress and singer who rose to prominence portraying the candy-counter girl Maddie Fitzpatrick in Disney Channel's The Suite Life of Zack & Cody and the female antagonist Sharpay Evans in the High School Musical film series.  The High School Musical series became a successful franchise which included two television films, a feature movie, a spin-off and numerous soundtrack albums...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ot6ib67jxvKVG1JCBl0ROPGtdeP.jpg", url:"https://themoviedb.org/person/67600"}}, {tmdbId:"67601", properties:{bornIn:"Springfield, Missouri, USA", imdbId:"1727317", born:date('1984-11-23'), name:"Lucas Grabeel", bio:"From Wikipedia, the free encyclopedia. \n\nLucas Stephen Grabeel (born November 23, 1984) is an American actor, singer, dancer, songwriter, director and producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tyhpSWU7YDKntONxqC83Ifat2w6.jpg", url:"https://themoviedb.org/person/67601"}}, {tmdbId:"12056", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0416551", name:"Hawthorne James", bio:"From Wikipedia, the free encyclopedia. \n\nHawthorne James is an American actor and director, best known for his role as Big Red Davis in the 1991 film The Five Heartbeats.  He is also known for his role as Sam, the injured bus driver, in Speed (1994 film).  James was born James Hawthorne in Chicago, Illinois, the son of A. M.  Alene and Robert Hawthorne. \n\nDescription above from the Wikipedia article Hawthorne James, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9QvR5gBQkxY7HSFkHegFHxeZXb0.jpg", url:"https://themoviedb.org/person/12056"}}, {tmdbId:"130618", properties:{bornIn:"San Fernando Valley, California, USA", imdbId:"0683739", born:date('1979-07-28'), name:"Gabriel Pimentel", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iapDYQu3gQyxutcjyyyhH3U4se6.jpg", url:"https://themoviedb.org/person/130618"}}, {tmdbId:"138970", properties:{bornIn:"Dzerzhinsk, Gorky Oblast, Russian SFSR, USSR [now Nizhny Novgorod Oblast, Russia]", imdbId:"1143016", born:date('1977-12-19'), name:"Irina Voronina", bio:"​From Wikipedia, the free encyclopedia.   \n\nIrina Voronina ( born December 19, 1977 in Dzerzhinsk, Russia) is a Russian model and Playboy Playmate for January 2001. \n\nDescription above from the Wikipedia article Irina Voronina, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vtJSIxEdGBxcW0xOj7pd28Qktsl.jpg", url:"https://themoviedb.org/person/138970"}}, {tmdbId:"15998", properties:{bornIn:"Haverhill, Massachusetts, USA", imdbId:"0750826", born:date('1924-04-14'), name:"Joseph Ruskin", bio:"From Wikipedia, the free encyclopedia. \n\nJoseph Ruskin (born April 14, 1924) is an American character actor. \n\nRuskin is one of only 4 actors or actresses to have starred in both the original Star Trek (1966) (up to and including Star Trek VI: The Undiscovered Country (1991)) and then in one of the spin offs.  Along with Majel Barrett, Clint Howard and Jack Donner, he is one of only four actors to appear in both the original Star Trek series and Star Trek: Enterprise (2001)...", died:date('2013-12-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/CmELizKF9uR62w5zhiB5Gl65RV.jpg", url:"https://themoviedb.org/person/15998"}}, {tmdbId:"45747", properties:{bornIn:"Tilburg, Noord-Brabant, Netherlands", imdbId:"0818715", born:date('1958-02-11'), name:"Jaap Spijkers", bio:"Jaap Spijkers is a Dutch actor know for his work in stage, television and film productions...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/thi1QOTdsGmUW13e6aXkQrQmDFs.jpg", url:"https://themoviedb.org/person/45747"}}, {tmdbId:"45748", properties:{imdbId:"0726397", name:"Mark Rietman", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xxVqR3iww6ZUfViSje6VUkYuL2T.jpg", url:"https://themoviedb.org/person/45748"}}, {tmdbId:"84615", properties:{imdbId:"2409783", born:date('1986-01-01'), name:"Tanner Cohen", bio:"From Wikipedia, the free encyclopedia. \n\nTanner Cohen is an American stage, film and television actor, and singer. \n\nDescription above from the Wikipedia article Tanner Cohen, licensed under CC-BY-SA, full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/84615"}}, {tmdbId:"15855", properties:{bornIn:"Cincinnati, Ohio, ", imdbId:"0732133", born:date('1953-10-06'), name:"Wendy Robie", bio:"Wendy Robie (born October 6, 1953) is an American actress known for playing eccentric, mentally disturbed characters in television and on film.  She is especially known for her role as Nadine Hurley in David Lynch's Twin Peaks and as Mommy in Wes Craven's The People Under the Stairs. \n\nHer most recent film is the musical indie Were the World Mine. \n\nDescription above from the Wikipedia article Wendy Robie, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/g8SGLWjiYasqg4dQhqhLEQbmiJO.jpg", url:"https://themoviedb.org/person/15855"}}, {tmdbId:"84616", properties:{imdbId:"2676018", name:"Judy McLane", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gyuJwcsFfEZdvy34A4q7pcM22WA.jpg", url:"https://themoviedb.org/person/84616"}}, {tmdbId:"84617", properties:{bornIn:"New York City, New York, USA", imdbId:"0931958", born:date('1989-07-31'), name:"Zelda Williams", bio:"From Wikipedia, the free encyclopedia. \n\nZelda Rae Williams (born July 31, 1989) is an American actress and the daughter of actor and comedian Robin Williams.  She was named after Princess Zelda of the Legend of Zelda series of video games.  Her first big role was that of Melissa Loggia, the main character's teenage love interest in the 2004 film House of D.  In 2007, she was chosen as one of People Magazine's 100 Most Beautiful People...", url:"https://themoviedb.org/person/84617"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"20402", properties:{bornIn:"Sydney, New South Wales, Australia", imdbId:"0573037", born:date('1968-07-27'), name:"Julian McMahon", bio:"Julian McMahon (born July 27, 1968) is an Australian actor.  He is best known for his roles on Charmed and Nip/Tuck...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/PirhJFimrT5iK0qru4SzlwLW4G.jpg", url:"https://themoviedb.org/person/20402"}}, {tmdbId:"61098", properties:{imdbId:"2182034", born:date('2000-05-10'), name:"Shyann McClure", url:"https://themoviedb.org/person/61098"}}, {tmdbId:"58412", properties:{imdbId:"1212588", born:date('1995-10-08'), name:"Courtney Taylor Burness", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rOhI4S5EHfQjPBJzmyAEWZe5fRO.jpg", url:"https://themoviedb.org/person/58412"}}, {tmdbId:"37059", properties:{bornIn:"Omaha, Nebraska, USA", imdbId:"0194900", born:date('1980-04-17'), name:"Nicholas D'Agosto", bio:"Nicholas D'Agosto is an American television and film actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eIDgFGvvC1hxN2BjtPzZH97pObL.jpg", url:"https://themoviedb.org/person/37059"}}, {tmdbId:"84223", properties:{bornIn:"Portland, Maine, USA", imdbId:"0447695", born:date('1985-08-09'), name:"Anna Kendrick", bio:"Anna Kendrick (born August 9, 1985) is an American film and stage actress best known for the role of Natalie Keener in the 2009 film Up in the Air.  Her other work includes the films Camp (2003), Rocket Science (2007) and Scott Pilgrim vs.  the World (2010) and the Broadway musical High Society (1998) and also stars in The Twilight Saga.  Kendrick is a Tony, Drama Desk, Screen Actors Guild, BAFTA, Golden Globe, Independent Spirit and an Academy Award nominee for Best Supporting Actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cyGjHMJO7C6kQTq36n9hkLThY4G.jpg", url:"https://themoviedb.org/person/84223"}}, {tmdbId:"929511", properties:{bornIn:"Baltimore, Maryland, USA", imdbId:"2064295", born:date('1983-12-08'), name:"Utkarsh Ambudkar", bio:"Utkarsh Ambudkar (born December 8, 1983, Baltimore, Maryland) is an American actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wqb2EjDcJ5AKlZQuH7zV9jURs9B.jpg", url:"https://themoviedb.org/person/929511"}}, {tmdbId:"79803", properties:{imdbId:"2468438", name:"Candace Hammer", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5IkBMeh0CFggM4Ax7YhNyb7zAyB.jpg", url:"https://themoviedb.org/person/79803"}}, {tmdbId:"929136", properties:{bornIn:"San Francisco, California, Stati Uniti", imdbId:"4223385", born:date('1997-12-14'), name:"Thomas Horn", bio:"​-From Wikipedia, the free encyclopedia: Thomas Horn (born 1997) is an American actor best known for his role in the American drama film Extremely Loud and Incredibly Close (2011).  In 2010, Horn won on Jeopardy!, during Kids Week, earning $31,800 after wagering $12,000 during final Jeopardy.  Producer Scott Rudin was among those viewers impressed by Horn, subsequently offering him an audition for the role of Oskar Schell in Extremely Loud and Incredibly Close...", url:"https://themoviedb.org/person/929136"}}, {tmdbId:"937681", properties:{bornIn:"Melbourne, Victoria, Australia", imdbId:"0129807", born:date('1933-09-14'), name:"Zoe Caldwell", died:date('2020-02-16'), url:"https://themoviedb.org/person/937681"}}, {tmdbId:"938967", properties:{imdbId:"2603042", name:"Stew Albert", url:"https://themoviedb.org/person/938967"}}, {tmdbId:"938968", properties:{bornIn:"Lahore, Pakistan", imdbId:"0019503", born:date('1943-10-21'), name:"Tariq Ali", bio:"Tariq Ali Khan is a British political activist, writer, journalist, historian, filmmaker, and public intellectual.  He is a member of the editorial committee of the New Left Review and Sin Permiso, and contributes to The Guardian, CounterPunch, and the London Review of Books.  He read PPE at Exeter College, Oxford...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rSiIqyrrmqG4DgXRg9SUVk1kAH7.jpg", url:"https://themoviedb.org/person/938968"}}, {tmdbId:"13716", properties:{bornIn:"Washington, D.C., USA", imdbId:"0077012", born:date('1944-02-14'), name:"Carl Bernstein", url:"https://themoviedb.org/person/13716"}}, {tmdbId:"54247", properties:{bornIn:"East Brunswick, New Jersey, USA", imdbId:"1683094", born:date('1979-05-12'), name:"Aaron Yoo", bio:"Aaron Yoo is an American film and television actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fL5SEE5RSac93swa5fXjhA2Hhw5.jpg", url:"https://themoviedb.org/person/54247"}}, {tmdbId:"3185", properties:{bornIn:"Montréal, Québec, Canada", imdbId:"0169552", born:date('1934-09-21'), name:"Leonard Cohen", bio:"From Wikipedia, the free encyclopedia. \n\nLeonard Norman Cohen, CC GOQ (September 21, 1934 – November 7, 2016) was a Canadian singer, songwriter, poet, novelist, and painter.  His work mostly explored religion, politics, isolation, sexuality, and personal relationships. [2] Cohen was inducted into both the Canadian Music Hall of Fame and the Canadian Songwriters Hall of Fame as well as the Rock and Roll Hall of Fame.  He was a Companion of the Order of Canada, the nation's highest civilian honor...", died:date('2016-11-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cRHWtGOa7IOJWayAQM3FBLCM82x.jpg", url:"https://themoviedb.org/person/3185"}}, {tmdbId:"218947", properties:{bornIn:"Montréal, Québec, Canada", imdbId:"0906543", born:date('1976-05-08'), name:"Martha Wainwright", bio:"Martha Wainwright (born May 8, 1976) is a Canadian-American folk-rock singer-songwriter.  She is the daughter of American folk singer and actor Loudon Wainwright III and Canadian folk singer-songwriter Kate McGarrigle.  She was raised in a musical family along with her older brother, Rufus Wainwright, in Montreal, Quebec, Canada...", url:"https://themoviedb.org/person/218947"}}, {tmdbId:"154771", properties:{bornIn:"East Dereham, Norfolk, England", imdbId:"0651347", born:date('1970-12-14'), name:"Beth Orton", bio:"Beth Orton (born Elizabeth Caroline Orton, 14 December 1970) is a BRIT Award–winning English singer-songwriter, known for her 'folktronica' sound, which mixes elements of folk and electronica.  She was initially recognised for her collaborations with William Orbit and the Chemical Brothers in the mid 1990s.  However, these were not Orton's first recordings, she had released a solo album, Superpinkymandy, in 1993...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nSoGA6PfMPgUpOr0s6fZdLkBSKX.jpg", url:"https://themoviedb.org/person/154771"}}, {tmdbId:"107170", properties:{bornIn:"Sheffield, Yorkshire, England, UK", imdbId:"1006741", born:date('1963-09-19'), name:"Jarvis Cocker", bio:"Jarvis Branson Cocker is an English musician, actor and presenter.  As the founder, frontman, lyricist, and sole consistent member of the band Pulp, he became a figurehead of the Britpop genre of the mid-1990s...", url:"https://themoviedb.org/person/107170"}}, {tmdbId:"102984", properties:{bornIn:"Viña del Mar, Chile", imdbId:"1322140", born:date('1961-06-06'), name:"Tom Araya", url:"https://themoviedb.org/person/102984"}}, {tmdbId:"1172542", properties:{imdbId:"1616374", name:"Gavin Baddeley", url:"https://themoviedb.org/person/1172542"}}, {tmdbId:"1172543", properties:{imdbId:"1678599", name:"Blasphemer", url:"https://themoviedb.org/person/1172543"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"112235", properties:{bornIn:"Richmond, Virginia, USA", imdbId:"2205857", born:date('1971-02-21'), name:"Randy Blythe", bio:"David Randall \"Randy\" Blythe is the vocalist of American heavy metal band Lamb of God and side-project band Halo of Locusts.  He is known as D.  Randall Blythe on Lamb of God's albums.  Randy Blythe joined Lamb of God (at the time known as Burn the Priest) in 1995.  His vocal style consists of deep 'growled' vocals, shrill screams, and recently baritone singing...", url:"https://themoviedb.org/person/112235"}}, {tmdbId:"83002", properties:{bornIn:"Southern California, California, USA", imdbId:"1567113", born:date('1977-03-24'), name:"Jessica Chastain", bio:"Jessica Chastain (born March 24, 1977) is an American theater, film and television actress.  She played guest roles in several television shows before making her feature film debut with the 2008 independent film Jolene. \n\nIn 2011, Chastain gained wide public recognition for her starring roles in seven film releases; for her performance in The Help she received Best Supporting Actress nominations at the Academy Award, Golden Globe, BAFTA, and Screen Actors Guild Award ceremonies...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lodMzLKSdrPcBry6TdoDsMN3Vge.jpg", url:"https://themoviedb.org/person/83002"}}, {tmdbId:"1715121", properties:{name:"Hunter McCracken", url:"https://themoviedb.org/person/1715121"}}, {tmdbId:"74541", properties:{bornIn:"Manhattan, New York City, New York, USA", imdbId:"1015684", born:date('1976-03-14'), name:"Corey Stoll", bio:"Corey Daniel Stoll (born March 14, 1976) is an American stage and screen actor.  He received a Drama Desk Award nomination as Outstanding Featured Actor in a Play for Intimate Apparel, opposite Tony winner and Oscar nominee Viola Davis.  He graduated from Oberlin College in 1998.  He studied drama at Long Lake Camp For The Arts from 1988 through 1992...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gYcQ0HOk83ox1QdjpKQWLJjrVFV.jpg", url:"https://themoviedb.org/person/74541"}}, {tmdbId:"589130", properties:{imdbId:"0289429", name:"Matt Foyer", url:"https://themoviedb.org/person/589130"}}, {tmdbId:"589131", properties:{imdbId:"0092868", name:"John Bolen", url:"https://themoviedb.org/person/589131"}}, {tmdbId:"550448", properties:{imdbId:"0524261", name:"Ralph Lucas", bio:"Ralph Lucas is a very funny guy.  He proudly announces on his resumé that he can do anything.  Mostly comedic in nature, Ralph is well known as Detective Anton Varescu in the popular interactive dinner theater show, \"Dial M Murder Mysteries. \"\n\nHe is very proud of his Cyd Charisse and Fred Astaire impressions from \"The Bandwagon. \" \"I play both parts,\" he explains.  He confesses that his Cyd Charisse kicks have gotten a little less flashy but that his Fred Astaire is still, \"right on...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tm91I4R0jkW6XoKmkmTYMyeUzb3.jpg", url:"https://themoviedb.org/person/550448"}}, {tmdbId:"88340", properties:{imdbId:"1338869", name:"Chad Fifer", url:"https://themoviedb.org/person/88340"}}, {tmdbId:"16507", properties:{imdbId:"1620989", born:date('1968-11-21'), name:"Antonio Tarver", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/r8E2Fw6mu3g4del7uadNmPft53o.jpg", url:"https://themoviedb.org/person/16507"}}, {tmdbId:"16502", properties:{bornIn:" Belfast, Northern Ireland, UK", imdbId:"0400625", born:date('1970-01-01'), name:"Geraldine Hughes", bio:"From Wikipedia, the free encyclopedia\n\nGeraldine Hughes (born 1970) is a Northern Irish film, television and stage, actress.  She was born in West Belfast and lived in the Divis flats for a time.  She won a private scholarship and attended university in America. \n\nShe is best known for her portrayal of \"Little Marie\" in 2006's Rocky Balboa.  Hughes also wrote and performed a one-woman show entitled Belfast Blues in New York City and appeared on television on ER and Profiler, among others...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kBatdBpLl7h1vYnCOw6hRkjbspF.jpg", url:"https://themoviedb.org/person/16502"}}, {tmdbId:"19724", properties:{bornIn:"Louisville, Kentucky, USA", born:date('1937-07-18'), name:"Hunter S. Thompson", bio:"Hunter Stockton Thompson was an American journalist and author.  He is credited as the creator of Gonzo journalism, a style of reporting where reporters involve themselves in the action to such a degree that they become central figures of their stories.  He is known also for his unrepentant lifelong use of alcohol, LSD, mescaline, and cocaine (among other substances); his love of firearms; his inveterate hatred of Richard Nixon; and his iconoclastic contempt for authoritarianism...", died:date('2005-02-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8JUOMOSYHeMNO2ub2zFc0EWFeTc.jpg", url:"https://themoviedb.org/person/19724"}}, {tmdbId:"2640025", properties:{imdbId:"8470931", name:"Joe Cairo", url:"https://themoviedb.org/person/2640025"}}, {tmdbId:"154829", properties:{bornIn:"Framingham -  Massachusetts - USA", imdbId:"1069180", born:date('1975-08-15'), name:"Craig Gellis", bio:"Craig Gellis was is an actor and producer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/khZP4LGKZiUqsP2I5IvCAQ5cYSF.jpg", url:"https://themoviedb.org/person/154829"}}, {tmdbId:"163968", properties:{imdbId:"0178324", name:"Rich Cooper", url:"https://themoviedb.org/person/163968"}}, {tmdbId:"216802", properties:{imdbId:"1363122", name:"Caroline Brazier", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iW87NQ1x6c8d992Qz5S2JSQJSVi.jpg", url:"https://themoviedb.org/person/216802"}}, {tmdbId:"20191", properties:{bornIn:"Marshfield, Wisconsin, USA", imdbId:"1504678", born:date('1979-03-30'), name:"Jose Pablo Cantillo", bio:"​From Wikipedia, the free encyclopedia.   \n\nJose Pablo Cantillo (born March 30, 1979) is an American actor of Costa Rican descent.  Jose Pablo Cantillo (known as 'Joey' in his HS days) grew up in Terre Haute, Indiana, and attended Terre Haute South Vigo High School where he was a tennis standout for all 4 years, leading the Terre Haute South Braves to a State Runner-Up finish in 1996.  He attended Indiana University, and graduated in 2002 with a double major in Finance and Marketing...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qtNesvN1bAQ779gJBt3LYDsm8f7.jpg", url:"https://themoviedb.org/person/20191"}}, {tmdbId:"1276460", properties:{imdbId:"2046701", name:"Sean Farrell", url:"https://themoviedb.org/person/1276460"}}, {tmdbId:"1115", properties:{bornIn:"Kirkby, Lancashire, England, UK", imdbId:"0334318", born:date('1973-08-03'), name:"Stephen Graham", bio:"Stephen Graham (born 3 August 1973) is a British film and television actor, best known for playing Andrew \"Combo\" Gascoigne in This Is England and Scrum in the Pirates of the Caribbean feature films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rkavERf9KK4Yvs8V4HWrTaUwoHX.jpg", url:"https://themoviedb.org/person/1115"}}, {tmdbId:"70517", properties:{bornIn:"Grimsby, England, UK", imdbId:"2129938", born:date('1992-02-11'), name:"Thomas Turgoose", bio:"Thomas Turgoose is an English actor.  He is best known for playing Shaun in the film and TV spin-offs \"This Is England\"...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3PsCUvclNzVrjDGg69Q3blw83ei.jpg", url:"https://themoviedb.org/person/70517"}}, {tmdbId:"70518", properties:{bornIn:"Oldham, Lancashire, England, UK", imdbId:"0366846", born:date('1972-03-12'), name:"Jo Hartley", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/A8JMDj5yddYr5Pl7a35YPBGc2CS.jpg", url:"https://themoviedb.org/person/70518"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"70519", properties:{bornIn:"Nottingham, Nottinghamshire, England, UK", imdbId:"0793532", born:date('1983-08-18'), name:"Andrew Shim", bio:"From Wikipedia, the free encyclopedia. \n\nAndrew Shim (born 18 August 1983 in Miami, Florida) is a British actor best known for his appearances in the films of Shane Meadows, especially This Is England. \n\nDescription above from the Wikipedia article Andrew Shim, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tFU1ag9fxzTyfasgOGd7pQmtjRE.jpg", url:"https://themoviedb.org/person/70519"}}, {tmdbId:"8602", properties:{bornIn:"São Paulo, São Paulo, Brazil", imdbId:"0103797", born:date('1983-04-15'), name:"Alice Braga", bio:"Alice Braga Moraes (born April 15, 1983) is a Brazilian actress.  She has appeared in several films in her native Brazil, most notably as Angélica in 2002's highly acclaimed City of God and as Karina in 2005's Lower City.  She has also starred in the Hollywood movies I Am Legend (2007), Repo Men and Predators (both 2010)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/u0xdvpkvz5NQqZ4aylYu5Id68mV.jpg", url:"https://themoviedb.org/person/8602"}}, {tmdbId:"49918", properties:{bornIn:"Glen Rock, Bergen, New Jersey, USA", imdbId:"2253071", born:date('1997-01-01'), name:"Charlie Tahan", bio:"​From Wikipedia, the free encyclopedia. \n\nCharles \"Charlie\" Tahan (born December 1997) is an American child actor.  Tahan was born and raised in Glen Rock, New Jersey.  His sister is actress Daisy Tahan, and he has an older brother named Willie as well.  Tahan portrayed Ethan in I Am Legend, appeared in Burning Bright, and co-starred with Zac Efron in the 2010 film Charlie St.  Cloud.  He also has a recurring role as Calvin Arliss in Law & Order: Special Victims Unit...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sr50dwXp0V6UVBsmvuBILd4pFKD.jpg", url:"https://themoviedb.org/person/49918"}}, {tmdbId:"17605", properties:{bornIn:"Hackney, London, England, UK", imdbId:"0252961", born:date('1972-09-06'), name:"Idris Elba", bio:"Idris Elba (born 6 September 1972) is a British television, theatre, and film actor who has starred in both British and American productions.  One of his first acting roles was in the soap opera Family Affairs.  Since then he has worked in a variety of TV and movie projects including Ultraviolet, The Wire, No Good Deed and Zootopia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/be1bVF7qGX91a6c5WeRPs5pKXln.jpg", url:"https://themoviedb.org/person/17605"}}, {tmdbId:"62220", properties:{bornIn:" Philadelphia, Pennsylvania, USA", imdbId:"1659348", born:date('1982-01-07'), name:"Lauren Cohan", bio:"Lauren Cohan (born January 7, 1982) is a British American actress and model, best known for her role as Maggie Greene on The Walking Dead (2011–present).  She is also known for her recurring roles on the television series Supernatural (2007–2008), Chuck (2011) and The Vampire Diaries (2010–2012) and in the comedy film Van Wilder: The Rise of Taj (2006), the psychological thriller The Boy & played DC Comics character, Martha Wayne in Batman v Superman: Dawn of Justice (2016)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2LamrIKwEPm4i654fNzN8t1vrgf.jpg", url:"https://themoviedb.org/person/62220"}}, {tmdbId:"62221", properties:{imdbId:"2126655", name:"Daniel Percival", url:"https://themoviedb.org/person/62221"}}, {tmdbId:"62222", properties:{imdbId:"1063230", name:"Glen Barry", url:"https://themoviedb.org/person/62222"}}, {tmdbId:"24977", properties:{bornIn:"Vitoria, Euskadi, España", imdbId:"0253216", born:date('1960-10-10'), name:"Karra Elejalde", bio:"From Wikipedia, the free encyclopedia\n\nCarlos Elejalde Garai (born 10 October 1960 in Vitoria-Gasteiz) is a Spanish actor.  He has appeared in more than forty films since 1987...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kHODqgc2c7RaZz9Sp7cedgadvzG.jpg", url:"https://themoviedb.org/person/24977"}}, {tmdbId:"125286", properties:{imdbId:"1508630", name:"Candela Fernández", url:"https://themoviedb.org/person/125286"}}, {tmdbId:"125287", properties:{bornIn:"San Sebastián, Spain", imdbId:"0324409", born:date('1983-07-20'), name:"Bárbara Goenaga", bio:"Bárbara Goenaga was born on July 20, 1983 in Donostia-San Sebastián, Guipúzcoa, País Vasco (Spain).  She is an actress, known for TimeCrimes (2007), Silvia's Gift (2003) and Pikadero (2015)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eUbFr8VmhFDdftWowacw2tLgb1g.jpg", url:"https://themoviedb.org/person/125287"}}, {tmdbId:"58224", properties:{bornIn:"Fairfax - Virginia - USA", imdbId:"0837177", born:date('1975-09-18'), name:"Jason Sudeikis", bio:"Daniel Jason Sudeikis (born September 18, 1975) is an American actor and comedian best known for his work on Saturday Night Live...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zaxEnovPoqzkBIs5RIxfO9wS47h.jpg", url:"https://themoviedb.org/person/58224"}}, {tmdbId:"51856", properties:{bornIn:"Ft. Wayne, Indiana, USA", imdbId:"0278979", born:date('1974-03-07'), name:"Jenna Fischer", bio:"Regina Marie \"Jenna\" Fischer (born March 7, 1974) is an American actress.  She is most widely known for her Emmy-nominated portrayal of Pam Halpert (née Beesly) on the NBC situation comedy and mockumentary The Office, and has also appeared in several films, including Blades of Glory, Walk Hard: The Dewey Cox Story and The Promotion. \n\nDescription above from the Wikipedia article Jenna Fischer, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tMq4qJ8bbZqJqde9BSrAWe06vQP.jpg", url:"https://themoviedb.org/person/51856"}}, {tmdbId:"87436", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0152986", born:date('1981-08-01'), name:"Brett Chukerman", url:"https://themoviedb.org/person/87436"}}, {tmdbId:"2168531", properties:{name:"Aldevina Da Silva", url:"https://themoviedb.org/person/2168531"}}, {tmdbId:"2168532", properties:{name:"Pieter Van Nieuwenhuyze", url:"https://themoviedb.org/person/2168532"}}, {tmdbId:"54693", properties:{bornIn:"Scottsdale, Arizona, USA", imdbId:"1297015", born:date('1988-11-06'), name:"Emma Stone", bio:"Emily Jean \"Emma\" Stone is an American actress.  The recipient of numerous accolades, including an Academy Award and a Golden Globe Award, she was the world's highest-paid actress in 2017. \n\nBorn and raised in Scottsdale, Arizona, Stone began acting as a child, in a theater production of The Wind in the Willows in 2000...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2hwXbPW2ffnXUe1Um0WXHG0cTwb.jpg", url:"https://themoviedb.org/person/54693"}}, {tmdbId:"52997", properties:{bornIn:"Weymouth - Massachusetts - USA", imdbId:"1117791", born:date('1971-02-04'), name:"Rob Corddry", bio:"Robert William \"Rob\" Corddry (born February 4, 1971) is an American actor and comedian best known for his work as a former correspondent on The Daily Show with Jon Stewart and for his starring role in the comedy film Hot Tub Time Machine.  He is also the creator and star of Childrens Hospital, which is currently airing new episodes on the Adult Swim network...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qAUNlNxSkDVEFHGnXgDNpyxC2vm.jpg", url:"https://themoviedb.org/person/52997"}}, {tmdbId:"21675", properties:{imdbId:"0174780", name:"Jack Conley", bio:"Jack Conley is an American actor with an established career as a guest actor on a long list of television series.  His wife Francesca Casale is also an actor, working primarily in theater. \n\nDescription above from the Wikipedia article Jack Conley (actor), licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/78bceHx2BdTJLhhomIbpQKm15TR.jpg", url:"https://themoviedb.org/person/21675"}}, {tmdbId:"51100", properties:{bornIn:"Casablanca, Morocco", imdbId:"0255362", born:date('1971-04-19'), name:"Gad Elmaleh", bio:"From Wikipedia, the free encyclopedia\n\nGad Elmaleh (born April 19, 1971) is a French-Moroccan stand-up comedian and actor.  His latest show is called Papa est en haut (Dad is upstairs).  He has starred in several feature films, including Coco, Hors de prix, and La Doublure. \n\nDescription above from the Wikipedia article Gad Elmaleh, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/buxyxlrFoXpcbeiYRKZn84EUiBm.jpg", url:"https://themoviedb.org/person/51100"}}, {tmdbId:"51101", properties:{bornIn:" France", imdbId:"0010562", born:date('1950-09-24'), name:"Marie-Christine Adam", bio:"From Wikipedia, the free encyclopedia\n\n​Marie-Christine Adam (born 24 September 1950) is a French actress. \n\nDescription above from the Wikipedia article Marie-Christine Adam, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ve1H7xsP5V4gg98EWWNvX4fGQhN.jpg", url:"https://themoviedb.org/person/51101"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"43301", properties:{bornIn:"Canada ", imdbId:"0589334", born:date('1950-05-07'), name:"Sherry Miller", bio:"From Wikipedia, the free encyclopedia\n\nSherry Miller (born 7 May 1950) is a Canadian actress best known for her role as Jane Oliver on the Canadian drama E. N. G.  (1990), Jennifer Taylor on the Showtime television show Queer As Folk (2000–2005) and Dorothy O'Sullivan on The Best Years (2007–2009). \n\nDescription above from the Wikipedia article Sherry Miller, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8loCxWNAAF7m3C3kFAREKqO7mBc.jpg", url:"https://themoviedb.org/person/43301"}}, {tmdbId:"183201", properties:{bornIn:"Hastings, East Sussex, England, UK", imdbId:"0283409", born:date('1948-08-05'), name:"Barbara Flynn", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/15KpTNIJ6JQrgaD6ASfVEDRZybp.jpg", url:"https://themoviedb.org/person/183201"}}, {tmdbId:"62861", properties:{bornIn:"Mill Valley, California, USA", imdbId:"1676221", born:date('1978-08-18'), name:"Andy Samberg", bio:"David A.  J.  \"Andy\" Samberg (born August 18, 1978) is an American actor, comedian, writer, producer, and musician.  He is a member of the comedy music group The Lonely Island and was a cast member on Saturday Night Live (2005–2012), where he and his fellow group members have been credited with popularizing the SNL Digital Shorts...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/y6VcPyshsr6SMx97fg515NoNGRr.jpg", url:"https://themoviedb.org/person/62861"}}, {tmdbId:"448998", properties:{imdbId:"2899650", name:"Alex Fisher", url:"https://themoviedb.org/person/448998"}}, {tmdbId:"448999", properties:{imdbId:"2857359", name:"Peter Clayton-Luce", url:"https://themoviedb.org/person/448999"}}, {tmdbId:"1294849", properties:{imdbId:"2944939", name:"Caryn Peterson", url:"https://themoviedb.org/person/1294849"}}, {tmdbId:"1294850", properties:{bornIn:"Nigeria", imdbId:"2944951", name:"Adeola Ariyo", url:"https://themoviedb.org/person/1294850"}}, {tmdbId:"1294851", properties:{imdbId:"2944946", name:"Christine Tomlinson", url:"https://themoviedb.org/person/1294851"}}, {tmdbId:"59258", properties:{bornIn:"Silver Spring, Maryland, U.S.A.", imdbId:"0085400", born:date('1948-08-30'), name:"Lewis Black", bio:"From Wikipedia, the free encyclopedia\n\nLewis Niles Black (born August 30, 1948) is an American stand-up comedian, author, playwright, social critic and actor.  He is known for his comedy style, which often includes simulating a mental breakdown, or an increasingly angry rant, ridiculing history, politics, religion, trends and cultural phenomena...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w29RsqphdfcG76jw0dHuGNtZOIA.jpg", url:"https://themoviedb.org/person/59258"}}, {tmdbId:"196316", properties:{bornIn:"Ridgewood - New Jersey - USA", imdbId:"0126244", born:date('1969-12-23'), name:"Martha Byrne", bio:"Martha Byrne  is an actress and producer...", url:"https://themoviedb.org/person/196316"}}, {tmdbId:"2570333", properties:{name:"Jennine Babo", url:"https://themoviedb.org/person/2570333"}}, {tmdbId:"23498", properties:{bornIn:"Vancouver, British Columbia, Canada", imdbId:"1573253", born:date('1992-05-07'), name:"Alexander Ludwig", bio:"Alexander Ludwig (born May 7, 1992) is a Canadian actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/unP5YUgEdECL2gMLs0zCNya6is6.jpg", url:"https://themoviedb.org/person/23498"}}, {tmdbId:"1255914", properties:{imdbId:"0509523", name:"Jason Liebrecht", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ueIj8v99OSfqzgK3kJ7tJk9N6gx.jpg", url:"https://themoviedb.org/person/1255914"}}, {tmdbId:"35013", properties:{bornIn:"Oxford, Oxfordshire, England, UK", imdbId:"0654648", born:date('1976-04-01'), name:"David Oyelowo", bio:"David Oyelowo was born in Oxford in 1976.  His family originates from Nigeria.  David studied Theatre Studies for A level and his teacher suggested he should become an actor.  After A levels David enrolled for a year on an Art foundation course.  In December 2000 David became the first black actor to play an English monarch for the RSC taking the title role in Henry VI.  His performance won him the 'Ian Charleson' Award 2001 for best newcomer in a classical play...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eh25JUVPb2YBSUr4IvGhDQxRuN.jpg", url:"https://themoviedb.org/person/35013"}}, {tmdbId:"2479795", properties:{name:"Jake Tusing", url:"https://themoviedb.org/person/2479795"}}, {tmdbId:"2479793", properties:{name:"Megan Krizmanich", url:"https://themoviedb.org/person/2479793"}}, {tmdbId:"2479794", properties:{name:"Colin Clemens", url:"https://themoviedb.org/person/2479794"}}, {tmdbId:"2479796", properties:{name:"Mitch Reinholt", url:"https://themoviedb.org/person/2479796"}}, {tmdbId:"1615234", properties:{name:"Lou Engle", url:"https://themoviedb.org/person/1615234"}}, {tmdbId:"19007", properties:{imdbId:"2358684", name:"Becky Fischer", bio:"From Wikipedia, the free encyclopedia. \n\nBecky Fischer (born 1951) is a Pentecostal children's pastor best known for her role in the 2006 documentary Jesus Camp. \n\nFischer is a third-generation Pentecostal on her father's side and a fourth-generation Pentecostal on her mother's side.  Her grandfather was an ordained minister with the Assemblies of God for 75 years...", url:"https://themoviedb.org/person/19007"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"132169", properties:{name:"Ted Haggard", url:"https://themoviedb.org/person/132169"}}, {tmdbId:"19008", properties:{imdbId:"1893465", born:date('1953-10-24'), name:"Mike Papantonio", bio:"From Wikipedia, the free encyclopedia. \n\nJames Michael Papantonio (born October 24, 1953), popularly known as Mike Papantonio, is an American attorney and radio talk show host.  A prominent trial lawyer, he co-hosts Ring of Fire, a nationally-syndicated weekly radio program, with Robert F.  Kennedy, Jr. , and David Bender...", url:"https://themoviedb.org/person/19008"}}, {tmdbId:"56253", properties:{bornIn:"Sacramento, California", imdbId:"0815418", born:date('1969-08-16'), name:"Paul Soter", bio:"From Wikipedia, the free encyclopedia\n\nPaul Soter (born August 16, 1969) is an American actor, writer, and director, and one of the members of the Broken Lizard comedy group.  As a child, he lived in Sacramento, Anchorage, Phoenix, and Denver.  He graduated from Colgate University and was a member of the Beta Theta Pi fraternity.  He was also part of the troupe Charred Goosebeak while there, with the other Lizards...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/avsOygcEmFUB5INWGoexgaTJ2u0.jpg", url:"https://themoviedb.org/person/56253"}}, {tmdbId:"35390", properties:{imdbId:"2728857", name:"Bimbo Hart", url:"https://themoviedb.org/person/35390"}}, {tmdbId:"35391", properties:{imdbId:"2728862", name:"Alastair MacIntosh", url:"https://themoviedb.org/person/35391"}}, {tmdbId:"20376", properties:{bornIn:"San Diego, California, USA", imdbId:"2105255", born:date('1984-08-28'), name:"Sarah Roemer", bio:"Sarah Christine Roemer (born August 28, 1984) is an American model and actress.  She is best known for her roles in the films Disturbia, Asylum, and Fired Up. \n\nDescription above from the Wikipedia article Sarah Roemer, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ktO3mPeLl8x5Vfrv9fQMYjeZ16Y.jpg", url:"https://themoviedb.org/person/20376"}}, {tmdbId:"59860", properties:{bornIn:"London, England, UK", imdbId:"1404408", born:date('1982-02-06'), name:"Alice Eve", bio:"Eve was born in London, England, the daughter of actors Trevor Eve and Sharon Maughan.  She has two younger brothers, Jack and George, and was raised in the United Kingdom and Los Angeles, United States.  She attended Bedales School and then took her A-Levels at Westminster School in London.  During her gap year, she studied at the Beverly Hills Playhouse and then read English at St Catherine's College, Oxford...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oa2NGm0g2Xee9wR1VDDcn08Vf5b.jpg", url:"https://themoviedb.org/person/59860"}}, {tmdbId:"1231720", properties:{imdbId:"1654810", name:"Reverend Gadget", url:"https://themoviedb.org/person/1231720"}}, {tmdbId:"52783", properties:{bornIn:"Los Angeles, California, USA", imdbId:"1377375", born:date('1981-08-25'), name:"Rachel Bilson", bio:"Rachel Sarah Bilson (born August 25, 1981 height 5' 2\" (1,57 m)) is an American actress.  Bilson grew up in a California show business family, and made her television debut in 2003, subsequently becoming well-known for playing Summer Roberts on the prime time drama series The O. C.  Bilson made her film debut in the 2006 film The Last Kiss and starred in the 2008 action/science fiction film Jumper...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jlacH60rFke82EfuvFqgjcxPIx0.jpg", url:"https://themoviedb.org/person/52783"}}, {tmdbId:"112543", properties:{imdbId:"2328228", name:"Grace Thorsen", url:"https://themoviedb.org/person/112543"}}, {tmdbId:"2622412", properties:{name:"Taylor Sharpe", url:"https://themoviedb.org/person/2622412"}}, {tmdbId:"11769", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"0001646", born:date('1965-12-14'), name:"Ted Raimi", bio:"​From Wikipedia, the free encyclopedia. \n\nTheodore \"Ted\" Raimi  (born December 14, 1965) is an American actor, perhaps best known for his roles as Lieutenant Tim O'Neill in seaQuest DSV and Joxer the Mighty in Xena: Warrior Princess/Hercules: The Legendary Journeys.  Raimi is the younger brother of Spider-Man director Sam Raimi, who directed him in Xena and Hercules, as well as in the Spider-Man movies...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cpfbM9b6UK0EDIg1jF1v5KBkXA3.jpg", url:"https://themoviedb.org/person/11769"}}, {tmdbId:"1218217", properties:{imdbId:"0185099", born:date('1951-12-18'), name:"John Henry Cox", bio:"John Henry Cox was born December 18, 1951.  He is an actor, known for  West New York (1996), My Own Love Song (2010), and House of Cards  (2014). \n\nHis parents, Lois and Henry Cox, were a teacher and a  Southern Baptist minister, descended from generations of Irish and  Danish farmers. \n\nWhile attending high school in Casa Grande, Arizona, Cox played football and acted in nearly every play the school put on...", url:"https://themoviedb.org/person/1218217"}}, {tmdbId:"72208", properties:{bornIn:"New York City, New York, USA", imdbId:"1006024", born:date('1981-01-25'), name:"Alicia Keys", bio:"Alicia Augello Cook (born January 25, 1981), known professionally as Alicia Keys, is an American singer-songwriter.  A classically-trained pianist, Keys was composing songs by age 12.  She was signed at 15 years old by Columbia Records, and then, after disputes with the label, by Arista Records.  Her debut album, Songs in A Minor, was released with J Records in 2001...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cRCvl44F17HymANBzwR1EswfJxI.jpg", url:"https://themoviedb.org/person/72208"}}, {tmdbId:"2677", properties:{bornIn:"Tehran, Iran", imdbId:"1587232", born:date('1975-03-30'), name:"Bahar Soomekh", bio:"Bahar Soomekh (born March 30, 1975) is an Iranian-born American actress and environmental activist.  She is best known for her roles in the films Crash and Saw III. \n\nSoomekh began her acting career by guest-starring on several television series including JAG and 24 abd later appeared in a few films, including Crash and Syriana.  In 2006, Bahar was noted for her roles in Mission: Impossible III and Saw III...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/io2P3EF5lwHci3BGYfkrmUegW8G.jpg", url:"https://themoviedb.org/person/2677"}}, {tmdbId:"232514", properties:{bornIn:"Blumenau, Santa Catarina, Brazil", imdbId:"2599442", born:date('1979-04-25'), name:"Paula Braun", url:"https://themoviedb.org/person/232514"}}, {tmdbId:"1328646", properties:{bornIn:"São Paulo, São Paulo, Brazil", imdbId:"0023524", born:date('1978-08-03'), name:"Susana Alves", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lVdy1mMJyNL1ZdRsm8hSgJXSwPQ.jpg", url:"https://themoviedb.org/person/1328646"}}, {tmdbId:"78411", properties:{imdbId:"1560396", name:"Emma Karwandy", url:"https://themoviedb.org/person/78411"}}, {tmdbId:"83225", properties:{bornIn:"Farmington Hills - Michigan - USA", imdbId:"1148573", born:date('1973-02-09'), name:"Colin Egglesfield", bio:"From Wikipedia, the free encyclopedia. \n\nColin Egglesfield (born February 9, 1973) is an American actor.  He is best known for his portrayal as Dr.  Josh Madden in the long-running soap opera All My Children, as well as Auggie Kirkpatrick in The CW's short-lived teen drama Melrose Place...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qFbtolbvCE0JK5pHxz777rPNh6Z.jpg", url:"https://themoviedb.org/person/83225"}}, {tmdbId:"1265996", properties:{imdbId:"2657069", name:"Stacey LaBerge", url:"https://themoviedb.org/person/1265996"}}] AS row
