UNWIND [{tmdbId:"94482", properties:{imdbId:"2828435", born:date('1999-03-27'), name:"Natasha Calis", bio:"Actress / Artist...", url:"https://themoviedb.org/person/94482"}}, {tmdbId:"52869", properties:{bornIn:"San Antonio, Texas, USA", imdbId:"1956478", born:date('1996-11-22'), name:"Madison Davenport", bio:"Madison Danielle Davenport (born November 22, 1996) is an American teen actress and singer, best known for her role as Quillo in Over the Hedge.  Davenport has also starred in Kit Kittredge: An American Girl as Kit's best friend Ruthie Smithens...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/r5rHOGWNFH2cADzNu5aYnEt0DG6.jpg", url:"https://themoviedb.org/person/52869"}}, {tmdbId:"2144", properties:{bornIn:"Queens, New York City, New York, USA", imdbId:"0068551", born:date('1942-08-07'), name:"Tobin Bell", bio:"An American film and television character actor.  After years of work doing stand-ins and background work on films, he got his first major acting job in Mississippi Burning (1988) and went on to star in made-for-television films and guest star in television shows throughout the 1990s.  Bell is best known as the villain John \"Jigsaw\" Kramer of the Saw film series...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6T1ml4hwDoACbLUBpd8aO6Bi3yN.jpg", url:"https://themoviedb.org/person/2144"}}, {tmdbId:"2681", properties:{bornIn:"Toronto, Ontario, Canada", imdbId:"0461712", born:date('1988-03-25'), name:"Erik Knudsen", bio:"Erik Knudsen is a Canadian actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/li49Q9HabcLKrC1BfxBYrYkKsUX.jpg", url:"https://themoviedb.org/person/2681"}}, {tmdbId:"234479", properties:{bornIn:"\tToronto, Ontario, Canada", imdbId:"2023672", born:date('1999-08-22'), name:"Dakota Goyo", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xHfxZDILa8JRZu5OoaXKiDa781o.jpg", url:"https://themoviedb.org/person/234479"}}, {tmdbId:"19034", properties:{bornIn:"Fort Saskatchewan, Alberta, Canada", imdbId:"1431940", born:date('1979-08-03'), name:"Evangeline Lilly", bio:"Nicole Evangeline Lilly is a Canadian actress.  She gained popular acclaim for her first leading role as Kate Austen in the ABC series Lost, which garnered her a nomination for the Golden Globe Award for Best Actress in a Drama Series and won her a Screen Actors Guild Award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4wWBoEWUkdsE8dp46zvDLf9jefC.jpg", url:"https://themoviedb.org/person/19034"}}, {tmdbId:"1324", properties:{imdbId:"0123305", name:"Victoria Burrows", url:"https://themoviedb.org/person/1324"}}, {tmdbId:"78659", properties:{bornIn:"USA", imdbId:"1744979", name:"Derek Magyar", bio:"​From Wikipedia, the free encyclopedia. \n\nDerek Magyar is an American actor of Hungarian origin.  He is best known as the director and producer of the film \"Flying Lessons\", as the lead character \"X\" in the film \"Boy Culture\", and as Commander Kelby during the fourth season of Star Trek Enterprise  He graduated from the California Institute of the Arts in 2003 and has appeared in several TV shows and movies...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/dBv8UhhYdDlRS0ri6vl8mQCGUVa.jpg", url:"https://themoviedb.org/person/78659"}}, {tmdbId:"78660", properties:{imdbId:"2415024", name:"George Jonson", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w5ibVDmFu7WIrMIUEAQ2Ir9gGXl.jpg", url:"https://themoviedb.org/person/78660"}}, {tmdbId:"45418", properties:{bornIn:"Pasadena, California, USA", imdbId:"0826992", born:date('1974-03-07'), name:"Darryl Stephens", bio:"​From Wikipedia, the free encyclopedia. \n\nDarryl Joseph Stephens (born March 7, 1974, Pasadena, California) is an American actor.  He is best known for playing Noah Nicholson on the television dramedy Noah's Arc...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ywGeMd8w0hRZR96pvsPUo1yxNen.jpg", url:"https://themoviedb.org/person/45418"}}, {tmdbId:"1121519", properties:{imdbId:"3735190", name:"Harriet Minto-Day", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ooKgMEg0UGYnxpAfroRm3msCJSK.jpg", url:"https://themoviedb.org/person/1121519"}}, {tmdbId:"33182", properties:{bornIn:"Auckland - New Zealand", imdbId:"0481092", born:date('1963-09-10'), name:"Jay Laga'aia", bio:"Jay Laga'aia is a New Zealand-Australian actor and singer.  He is best known internationally for his role as Captain Typho in the films Star Wars Episode II: Attack of the Clones and Star Wars Episode III: Revenge of the Sith...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qVe5pz15VIypXZoI7tMvzXZrMPI.jpg", url:"https://themoviedb.org/person/33182"}}, {tmdbId:"272408", properties:{imdbId:"0960946", name:"Damien Garvey", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jLVN1BX9d8H7ubfRvve8pxtwBGK.jpg", url:"https://themoviedb.org/person/272408"}}, {tmdbId:"31507", properties:{imdbId:"0008231", born:date('1962-11-28'), name:"Rose Abdoo", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/28EzTtPYjeZR4I7qUMzeikYHPvk.jpg", url:"https://themoviedb.org/person/31507"}}, {tmdbId:"20373", properties:{bornIn:"Winter Park, Florida, USA", imdbId:"0444223", born:date('1985-02-19'), name:"Arielle Kebbel", bio:"Arielle Caroline Kebbel (born February 19, 1985) is an American model and actress.  Arielle is perhaps best known for her roles in The Uninvited, American Pie Presents: Band Camp, John Tucker Must Die, Vampires Suck, The Vampire Diaries, Aquamarine and The Grudge 2.  She is often considered as a Scream Queen.  She currently plays Paige Thomas on Life Unexpected...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bZI3BjpQWKgqFmVhIwBmq3khGoj.jpg", url:"https://themoviedb.org/person/20373"}}, {tmdbId:"20329", properties:{bornIn:"Tokyo, Japan", imdbId:"1232416", born:date('1972-07-27'), name:"Takako Fuji", url:"https://themoviedb.org/person/20329"}}, {tmdbId:"52605", properties:{bornIn:"Corpus Christi, Texas, USA", imdbId:"0519456", born:date('1975-03-15'), name:"Eva Longoria", bio:"Eva Longoria is an American film and television actress and director, best known for portraying leading character Gabrielle Solis on the ABC television series \"Desperate Housewives\".  She received a nomination for the 2006 Golden Globe Award for Best Actress in a Comedy Series for her performance on this show...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ywz9n9lVkxUklJKUHDQxENAVOek.jpg", url:"https://themoviedb.org/person/52605"}}, {tmdbId:"53247", properties:{bornIn:"USA", imdbId:"0286331", born:date('1970-01-01'), name:"Chaka Forman", url:"https://themoviedb.org/person/53247"}}, {tmdbId:"55062", properties:{bornIn:"Hyderabad, India", imdbId:"0007102", born:date('1970-11-04'), name:"Tabu", bio:"From Wikipedia, the free encyclopedia. \n\nTabu (born Tabassum Hashmi) is an Indian film actress.  She has mainly acted in Hindi films, though she has also starred in Telugu, Tamil, Malayalam and Bengali language films, as well as one American film.  She has won the National Film Award for Best Actress twice, and she holds the record for the most wins of Filmfare's Critics Award for Best Female Performer, with four...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j7qgNVrpxgjGj5fHOAZIhfCKz7a.jpg", url:"https://themoviedb.org/person/55062"}}, {tmdbId:"74428", properties:{bornIn:"Delhi, Louisiana, USA", imdbId:"0005210", born:date('1967-05-01'), name:"Tim McGraw", bio:"Samuel Timothy \"Tim\" McGraw (born May 1, 1967) is an American country singer and actor.  Many of McGraw's albums and singles have topped the country music charts, leading him to achieve total album sales in excess of 40 million units.  He is married to country singer Faith Hill and is the son of former baseball player Tug McGraw. \n\nMcGraw had 11 consecutive albums debut at Number One on the Billboard albums charts.  Twenty-one singles hit No.  1 on the Billboard Hot Country Songs chart...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/prKoPyWZDQYHZeTmFqvMW0EFWDB.jpg", url:"https://themoviedb.org/person/74428"}}] AS row
