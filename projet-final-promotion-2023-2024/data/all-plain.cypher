UNWIND [{tmdbId:"47096", properties:{bornIn:"Hammersmith, London, England, UK", imdbId:"0002032", born:date('1944-03-01'), name:"Roger Daltrey", bio:"Roger Harry Daltrey, CBE (born 1 March 1944), is an English singer-songwriter and actor, best known as the founder and lead singer of English rock band The Who.  He has maintained a musical career as a solo artist and has also worked in the film industry, acting in a large number of films, theatre and television roles and also producing films...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5hXMDGmnHLYrbSZp82CECz0m1I8.jpg", url:"https://themoviedb.org/person/47096"}}, {tmdbId:"11370", properties:{bornIn:"Pinner, Middlesex, England, UK", imdbId:"0005056", born:date('1947-03-25'), name:"Elton John", bio:"An English singer, pianist and composer. \n\nHe has made appearances in numerous films such as \"Born to Boogie\" (1972) with Marc Bolan and Ringo Starr;  \"Tommy\" (1975) as the Pinball Wizard; \"Spice World\" (1997); \"The Country Bears\" (2002).  And in the autobiographies \"Elton John: Tantrums & Tiaras\" (1997) and \"Elton John: Me, Myself & I\" (2007)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9G3k29OWPyZtScEDZEAsFJpqiM7.jpg", url:"https://themoviedb.org/person/11370"}}, {tmdbId:"3753", properties:{bornIn:"La Spezia - Liguria - Italy", imdbId:"0316284", born:date('1942-08-01'), name:"Giancarlo Giannini", bio:"From Wikipedia, the free encyclopedia\n\nGiancarlo Giannini (born 1 August 1942) is an Italian actor and dubber. \n\nGiannini was born La Spezia, Liguria, Italy.  He studied at the Accademia Nazionale d'Arte Drammatica in Rome, and made his film debut in a small part in Fango sulla metropoli in 1965.  He appeared in supporting roles in Anzio and The Secret of Santa Vittoria, and starred in the original version of Swept Away...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iIVdQSANRFxY7gB0Co1zkazUcXm.jpg", url:"https://themoviedb.org/person/3753"}}, {tmdbId:"25810", properties:{bornIn:"Milan, Lombardy, Italy", imdbId:"0577423", born:date('1941-09-18'), name:"Mariangela Melato", bio:"From Wikipedia, the free encyclopedia\n\nMariangela Melato (19 September 1941 – 11 January 2013) was an Italian cinema and theatre actress. \n\nBorn in Milan, the daughter of a traffic policeman and a seamstress, Melato from a young age studied painting at the Academy of Brera, drawing posters and working as a window dresser at La Rinascente to pay for her acting lessons with Esperia Sperani...", died:date('2013-01-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/skpCWeBKIU1vwOxLGuIxl5VniQK.jpg", url:"https://themoviedb.org/person/25810"}}, {tmdbId:"40887", properties:{bornIn:"Palermo, Sicily, Italy", imdbId:"0759477", born:date('1944-03-29'), name:"Riccardo Salvino", url:"https://themoviedb.org/person/40887"}}, {tmdbId:"1014911", properties:{bornIn:"Napoli, Italy", imdbId:"0199774", born:date('1937-03-13'), name:"Isa Danieli", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xUETwTcqaEdc4jEO5JzZBxbrGsA.jpg", url:"https://themoviedb.org/person/1014911"}}, {tmdbId:"131568", properties:{imdbId:"0478043", name:"Josef Köstlinger", url:"https://themoviedb.org/person/131568"}}, {tmdbId:"131569", properties:{imdbId:"0882091", name:"Irma Urrila", url:"https://themoviedb.org/person/131569"}}, {tmdbId:"131570", properties:{bornIn:"Sweden", imdbId:"0353320", born:date('1945-11-25'), name:"Håkan Hagegård", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xG4ZXhOkSZLj9AteSp4lgLiNWMw.jpg", url:"https://themoviedb.org/person/131570"}}, {tmdbId:"131571", properties:{imdbId:"0259287", name:"Elisabeth Erikson", url:"https://themoviedb.org/person/131571"}}, {tmdbId:"21503", properties:{bornIn:"Beijing, China", imdbId:"0297686", born:date('1941-08-27'), name:"Tatsuya Fuji", bio:"​From Wikipedia, the free encyclopedia\n\nTatsuya Fuji (藤 竜也 Fuji Tatsuya, born 27 August 1941) is a Japanese film actor.  He has appeared in 50 films since 1964, and was the first Japanese actor to appear in full-frontal nudity with explicit sexual scenes in a non-pornographic Japanese film, In the Realm of the Senses, which was released worldwide in 1976, but has yet to be shown in Japan itself...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vfQBWOKFztXYexzNmKmaFJ8hT0E.jpg", url:"https://themoviedb.org/person/21503"}}, {tmdbId:"46239", properties:{bornIn:"Yokohama, Japan", imdbId:"0559405", born:date('1952-05-18'), name:"Eiko Matsuda", died:date('2011-03-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/iAkw70zEammVeKlr99OyyEHb1gj.jpg", url:"https://themoviedb.org/person/46239"}}, {tmdbId:"142535", properties:{bornIn:"Kumamoto, Kumamoto Prefecture, Japan", imdbId:"0620026", born:date('1945-09-20'), name:"Aoi Nakajima", died:date('1991-05-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/er3uRBQaEMh1pk9NvQKK6MlJNpl.jpg", url:"https://themoviedb.org/person/142535"}}, {tmdbId:"136880", properties:{bornIn:"Setagaya, Tokyo Prefecture, Japan", imdbId:"0559483", born:date('1939-10-03'), name:"Yasuko Matsui", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9sZnYPud5kP8jQO476A4Zd5emxI.jpg", url:"https://themoviedb.org/person/136880"}}, {tmdbId:"48575", properties:{bornIn:"Espegærde, Denmark", imdbId:"0851408", born:date('1912-07-11'), name:"Aino Taube", died:date('1990-06-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bEjAsxRypkJdjwDbgWUqAu3QQX8.jpg", url:"https://themoviedb.org/person/48575"}}, {tmdbId:"103707", properties:{bornIn:"Trinidad, West Indies", imdbId:"0831288", born:date('1943-10-07'), name:"Austin Stoker", bio:"​From Wikipedia, the free encyclopedia. \n\nAustin Stoker (born October 7, 1943) is an American actor known for his role as Lt.  Ethan Bishop, the police officer in charge of the besieged Precinct 9, Division 13, in John Carpenter's Howard Hawks-inspired, 1976 film, Assault on Precinct 13.  This was one of the few heroic starring roles for an African-American actor in an action film of the 1970s outside of the blaxploitation genre. \n\nStoker was born in Port of Spain, Trinidad and Tobago...", url:"https://themoviedb.org/person/103707"}}, {tmdbId:"105624", properties:{bornIn:"Winston-Salem, North Carolina, USA", imdbId:"0430944", born:date('1937-12-09'), name:"Darwin Joston", bio:"​From Wikipedia, the free encyclopedia. \n\nFrancis Darwin Solomon (December 9, 1937 – June 1, 1998) was an American actor known professionally as Darwin Joston (sometimes credited as Darwin Jostin during the early years of his career)...", died:date('1998-06-01'), url:"https://themoviedb.org/person/105624"}}, {tmdbId:"109944", properties:{imdbId:"0956633", name:"Laurie Zimmer", bio:"​From Wikipedia, the free encyclopedia. \n\nLaurie Zimmer (also credited as Laura Fanning) is an American former actress best known for her role as Leigh, the courageous secretary of the besieged police station, Precinct 9, Division 13, in John Carpenter's 1976, Howard Hawks-inspired, action film, Assault on Precinct 13...", url:"https://themoviedb.org/person/109944"}}, {tmdbId:"83810", properties:{bornIn:"The Bronx, New York City, New York, USA", imdbId:"0607558", born:date('1929-02-14'), name:"Vic Morrow", bio:"From Wikipedia, the free encyclopedia\n\nVictor \"Vic\" Morrow (February 14, 1929 – July 23, 1982) was an American actor, whose credits include a starring role in the 1960s TV series Combat!, prominent roles in a handful of other television and cinema dramas, and numerous guest roles on television.  He and two children died when a stunt helicopter crashed on them during the filming of Twilight Zone: The Movie...", died:date('1982-07-23'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/duaATq73iRIdLrbE80fnAHPISsA.jpg", url:"https://themoviedb.org/person/83810"}}, {tmdbId:"14108", properties:{bornIn:"New York City, New York, USA", imdbId:"0887696", born:date('1934-03-09'), name:"Joyce Van Patten", bio:"Joyce Van Patten (born March 9, 1934) is an American stage, film and television actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vbt3LzgBiQ7UhL5tDwn1wV4ndBd.jpg", url:"https://themoviedb.org/person/14108"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"46946", properties:{bornIn:"Brooklyn, New York, U.S.", imdbId:"0004767", born:date('1934-12-30'), name:"Joseph Bologna", bio:"From Wikipedia, the free encyclopedia. \n\nJoseph Bologna (born December 30, 1934) was an American actor, director and writer. \n\nDescription above from the Wikipedia article Joseph Bologna, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2017-08-13'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tgW1L3IkPziuwaE5anHMaoKBrfT.jpg", url:"https://themoviedb.org/person/46946"}}, {tmdbId:"8893", properties:{bornIn:"Manhattan, New York City, New York, USA", imdbId:"0000330", born:date('1944-02-13'), name:"Stockard Channing", bio:"Stockard Channing (born February 13, 1944) is an American stage, film and television actress.  She is known for her portrayal of First Lady Abbey Bartlet in the NBC television series The West Wing; for playing Betty Rizzo in the film Grease; and for her role in both the stage and screen versions of Six Degrees of Separation. \n\nDescription above from the Wikipedia article Stockard Channing, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/58hWS7ho1dzjj0Vxumcp4yII9F2.jpg", url:"https://themoviedb.org/person/8893"}}, {tmdbId:"4778", properties:{bornIn:"Hope, Arkansas, USA", imdbId:"0227039", born:date('1939-10-13'), name:"Melinda Dillon", bio:"Melinda Rose Dillon (born October 13, 1939) is an American actress, perhaps best known for her roles in Close Encounters of the Third Kind and the holiday classic A Christmas Story. \n\nDescription above from the Wikipedia article Melinda Dillon, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fefn6cQaU05EuklP25foT4xOc7I.jpg", url:"https://themoviedb.org/person/4778"}}, {tmdbId:"42003", properties:{bornIn:"Birmingham, Alabama, U.S.", imdbId:"0834373", born:date('1947-05-18'), name:"Gail Strickland", bio:"From Wikipedia, the free encyclopedia. \n\nGail Strickland (born May 18, 1947) is an American character actress. \n\nStrickland was born in Birmingham, Alabama, the daughter of Theodosia and Lynn Strickland, who owned a tire shop.  She had featured roles in 1970s films such as Bound for Glory, The Drowning Pool and Norma Rae...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wsL6Ck2Qaz91gvoklTtTnlBEHdd.jpg", url:"https://themoviedb.org/person/42003"}}, {tmdbId:"55093", properties:{bornIn:"Brooklyn, New York City, New York, USA", imdbId:"0000281", born:date('1960-09-22'), name:"Scott Baio", bio:"Scott Vincent James Baio is an American actor, best known for his roles as Chachi Arcola on the sitcom Happy Days and its spin-off Joanie Loves Chachi, and as the title character on the sitcom Charles in Charge...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/32ILGuWTLLlZDc5HGJBhbJjrtTf.jpg", url:"https://themoviedb.org/person/55093"}}, {tmdbId:"1021872", properties:{imdbId:"0240967", name:"Florrie Dugger", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9BL5rYBG6Z7oaS8fYg2TJAt2DkQ.jpg", url:"https://themoviedb.org/person/1021872"}}, {tmdbId:"55095", properties:{imdbId:"0144320", name:"John Cassisi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hRKQM1BzVyDovQTVSR9j6DxOtM3.jpg", url:"https://themoviedb.org/person/55095"}}, {tmdbId:"16555", properties:{bornIn:"Chattanooga, Tennessee, USA", imdbId:"0571853", born:date('1931-09-12'), name:"Bill McKinney", bio:"Bill McKinney wass an American character actor whose most famous role was the sadistic mountain man who abused and then sodomized Bobby Trippe (Ned Beatty) in the movie Deliverance.  McKinney is also recognizable for his performances in seven Clint Eastwood films, most notably as Union cavalry commander Captain \"Redlegs\" Terrill in The Outlaw Josey Wales.  Most of Bill McKinney's colleagues perceived him as big, brutal and dangerous.  At first glance.  Still, he was only 5' 10\" (1,78 m)...", died:date('2011-12-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/teDs0ySfApuDUaO86OfRiiQRZwz.jpg", url:"https://themoviedb.org/person/16555"}}, {tmdbId:"42176", properties:{bornIn:"Philadelphia, Pennsylvania, U.S.", imdbId:"0357557", born:date('1943-11-20'), name:"Veronica Hamel", bio:"Veronica Hamel was born on November 20, 1943 in Philadelphia, Pennsylvania, USA.  She is an actress and producer, known for Hill Street Blues (1981), Cannonball! (1976) and Lost (2004).  She was previously married to Michael Irving...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/d2Bg2EZ9HsQuXOFd7nvfJXaiVPN.jpg", url:"https://themoviedb.org/person/42176"}}, {tmdbId:"83104", properties:{bornIn:"Newark, New Jersey, USA", imdbId:"0407283", born:date('1948-05-12'), name:"Darrow Igus", url:"https://themoviedb.org/person/83104"}}, {tmdbId:"55206", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0422221", born:date('1951-09-21'), name:"Otis Day", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cmW5wk9yeQscybjDqtxmxM4wXcS.jpg", url:"https://themoviedb.org/person/55206"}}, {tmdbId:"126352", properties:{bornIn:"Chicago - Illinois - USA", imdbId:"0818953", born:date('1939-10-15'), name:"James Spinks", died:date('1996-07-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6kpobWJqvy5ZeNknoUDmhzu3hNf.jpg", url:"https://themoviedb.org/person/126352"}}, {tmdbId:"84878", properties:{bornIn:"New York City, New York, USA", imdbId:"0267279", born:date('1946-08-14'), name:"Antonio Fargas", bio:"From Wikipedia, the free encyclopedia. \n\nAntonio Juan Fargas (born August 14, 1946) is an American actor famous for his roles in 1970s blaxploitation movies, as well as his portrayal of Huggy Bear in the 1970s TV series Starsky and Hutch...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tolJfiTpIsVfqijPZ2UroUswwyr.jpg", url:"https://themoviedb.org/person/84878"}}, {tmdbId:"27563", properties:{bornIn:"Palo Alto, California, USA", imdbId:"0001388", born:date('1953-09-10'), name:"Amy Irving", bio:"Amy Davis Irving (born September 10, 1953) is an American actress, known for her roles in the films Crossing Delancey, The Fury, Carrie, and Yentl as well as acclaimed roles on Broadway and Off-Broadway.  She has been nominated for an Academy Award, two Golden Globes, and has won an Obie award and the 1980 Golden Raspberry Award for Worst Supporting Actress.  She is also known for marrying director Steven Spielberg; they divorced in 1989, with Irving receiving a settlement of 100 million dollars...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4SMrIcyYmJecUzIsipIrO4vGXxQ.jpg", url:"https://themoviedb.org/person/27563"}}, {tmdbId:"45415", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0001411", born:date('1951-02-16'), name:"William Katt", bio:"From Wikipedia, the free encyclopedia. \n\nWilliam Theodore Katt (born February 16, 1951) is an American film and television actor, best known as the star of The Greatest American Hero.  He is also known for playing Tommy Ross, the ill-fated prom date of Carrie White in the film version of Carrie and Paul Drake Jr.  in the Perry Mason TV movies.  His mother is Barabra Hale who played Della Street in the TV series Perry Mason ...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gfNMkpm33MsN2Q07JWIHI4UFas3.jpg", url:"https://themoviedb.org/person/45415"}}, {tmdbId:"224520", properties:{bornIn:"Rome, Lazio, Italy", imdbId:"0545690", born:date('1955-07-17'), name:"Francesca Marciano", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sJVIIu3x4s5j59uZeoDQiiwg2I1.jpg", url:"https://themoviedb.org/person/224520"}}, {tmdbId:"128020", properties:{imdbId:"0147167", born:date('1940-12-09'), name:"Gianni Cavina", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gi35uqBHKvf7wpDtn74VIKq0vbt.jpg", url:"https://themoviedb.org/person/128020"}}, {tmdbId:"1210595", properties:{imdbId:"0686230", name:"Giulio Pizzirani", url:"https://themoviedb.org/person/1210595"}}, {tmdbId:"107781", properties:{bornIn:"Barcelona, Barcelona, Catalonia, Spain", imdbId:"0709654", born:date('1942-11-18'), name:"Mónica Randall", bio:"Mónica Randall (November 18, 1942 - ) is a Spanish film actress. \n\nRandall has made some 110 appearances in film and TV since 1963.  She appeared in numerous western films in the 1960s in films such as One Hundred Thousand Dollars for Ringo and has made regular TV appearances since the 1970s. \n\nDescription above from the Wikipedia article Mónica Randall, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/u4ehUPsyCrGtgBYiRxL6FzWIM0z.jpg", url:"https://themoviedb.org/person/107781"}}, {tmdbId:"144764", properties:{bornIn:"Don Benito, Extremadura, Spain", imdbId:"0157242", born:date('1926-04-24'), name:"Florinda Chico", bio:"From Wikipedia, the free encyclopedia. \n\nFlorinda Chico Martín Mora (24 April 1926[1] – 19 February 2011) was a Spanish actress of film, theater and television. \n\nDescription above from the Wikipedia article Florinda Chico, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2011-02-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gLHKNQ7Yjk1zf9PThm3k8tnZYL5.jpg", url:"https://themoviedb.org/person/144764"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"24976", properties:{bornIn:"Madrid, España", imdbId:"0868479", born:date('1966-07-12'), name:"Ana Torrent", bio:"From Wikipedia, the free encyclopedia. \n\nAna Torrent Bertrán de Lis  (born 12 July 1966) is a Spanish film actress. \n\nTorrent's debut came in 1973 with the starring role as \"Ana\" in the film El espíritu de la colmena (The Spirit of the Beehive) directed by Víctor Erice, when she was seven years old.  This was followed by another memorable role in which she played the lead character's younger self in Cría cuervos (Raise Ravens) (1976) by director Carlos Saura...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/20fCWHV6CckcpwiSlAplJCSzBZj.jpg", url:"https://themoviedb.org/person/24976"}}, {tmdbId:"66221", properties:{bornIn:"Madison, Wisconsin, USA", imdbId:"0002033", born:date('1946-02-21'), name:"Tyne Daly", bio:"Ellen Tyne Daly is an American stage and screen actress, widely known for her work as Detective Lacey in the television series Cagney & Lacey.  She has won six Emmy Awards for her television work and a Tony Award, and is a 2011 American Theatre Hall of Fame inductee. \n\nDaly began her career on stage in summer stock in New York, and made her Broadway debut in the play That Summer – That Fall in 1967...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5rx2yNR7WGFu9raNIMcUYDV4U3k.jpg", url:"https://themoviedb.org/person/66221"}}, {tmdbId:"6718", properties:{bornIn:"Boston, Massachusetts, USA", imdbId:"0620756", born:date('1943-12-21'), name:"Jack Nance", bio:"From Wikipedia, the free encyclopedia. \n\nMarvin John Nance (December 21, 1943 – December 30, 1996), known professionally as Jack Nance and occasionally credited as John Nance, was an American actor of stage and screen, primarily starring in offbeat or avant-garde productions.  He was known for his work with director David Lynch, particularly for his roles in Eraserhead, Blue Velvet and Twin Peaks...", died:date('1996-12-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fN9LyZnztco8Tk7NpV0JiGnFkIy.jpg", url:"https://themoviedb.org/person/6718"}}, {tmdbId:"14794", properties:{bornIn:"Yuba City, California, USA", imdbId:"0829270", born:date('1941-02-27'), name:"Charlotte Stewart", bio:"​From Wikipedia, the free encyclopedia. \n\nCharlotte Stewart  (born February 27, 1941 in Yuba City, California, USA) is an American film and television actress. \n\nShe is most famous for her role as the schoolmarm 'Miss Beadle' on Little House on the Prairie and her work with director David Lynch...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2q8O8fpP5e0yvKJkrR45qbHCq6n.jpg", url:"https://themoviedb.org/person/14794"}}, {tmdbId:"14795", properties:{bornIn:"Minneapolis, Minnesota, USA", imdbId:"0430543", born:date('1919-05-29'), name:"Allen Joseph", died:date('2012-11-30'), url:"https://themoviedb.org/person/14795"}}, {tmdbId:"14796", properties:{bornIn:"Berkeley, California, USA", imdbId:"0060931", born:date('1918-05-21'), name:"Jeanne Bates", bio:"Jeanne Bates began her acting career while a student at San Mateo Junior College, appearing on radio soap operas in San Francisco.  She played the lead in an airwave mystery series, Lew X.  Lansworth's \"Whodunit\" (Bates' scream was the show's \"signature\"), which became so successful that it (and Bates) moved to Hollywood in 1941.  Bates and Lansworth married in 1943...", died:date('2007-11-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4p6uYdrCopWWvjLmPlkA8b2HaO1.jpg", url:"https://themoviedb.org/person/14796"}}, {tmdbId:"1213742", properties:{bornIn:"Buffalo - New York - USA", imdbId:"0622262", born:date('1948-08-21'), name:"Stephen Nathan", url:"https://themoviedb.org/person/1213742"}}, {tmdbId:"8434", properties:{bornIn:"Van Nuys, Los Angeles, California, USA", imdbId:"0930286", born:date('1947-08-22'), name:"Cindy Williams", bio:"From Wikipedia, the free encyclopedia\n\nCynthia Jane \"Cindy\" Williams (born August 22, 1947) is an American actress best known for starring in the television situation-comedy series Laverne & Shirley, in the role of \"Shirley Feeney\".  Although praised for her portrayal of Shirley, she left the show after the 2nd episode of the show's eighth and final season.  She is also known for her role as Laurie Henderson in the classic film American Graffiti...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ztnTWASRq1Z4IJ9T3wPa1vuNVdm.jpg", url:"https://themoviedb.org/person/8434"}}, {tmdbId:"157971", properties:{bornIn:"New Jersey, USA", imdbId:"0009996", born:date('1956-08-02'), name:"Leslie Ackerman", url:"https://themoviedb.org/person/157971"}}, {tmdbId:"18860", properties:{bornIn:"New York City, New York, USA", imdbId:"0076453", born:date('1923-10-30'), name:"Herschel Bernardi", bio:"From Wikipedia, the free encyclopedia\n\nHerschel Bernardi (30 October 1923, New York City – 9 May 1986, Los Angeles, California) was an American film, Broadway, and television actor. \n\nHe is best known for his starring roles on Broadway including Fiddler on the Roof (as Tevye), Zorba, and Bajour, but he also acted in many television shows, including Harbor Command and The Eleventh Hour (both with Wendell Corey), as well as State Trooper, Peter Gunn.  He was the lead in the CBS sitcom Arnie...", died:date('1986-05-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pPYFw70kVxHNszAozK3ZxYMpGrv.jpg", url:"https://themoviedb.org/person/18860"}}, {tmdbId:"4776", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0614526", born:date('1938-05-05'), name:"Michael Murphy", bio:"Michael Murphy is an American film and television actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/owOyg2EfHHvcHdqXApw1TebtWyd.jpg", url:"https://themoviedb.org/person/4776"}}, {tmdbId:"556528", properties:{imdbId:"3098949", name:"Norman Yarborough", url:"https://themoviedb.org/person/556528"}}, {tmdbId:"556529", properties:{imdbId:"3097106", name:"Houston Elmore", url:"https://themoviedb.org/person/556529"}}, {tmdbId:"556530", properties:{imdbId:"3098211", name:"Phil Sparks", url:"https://themoviedb.org/person/556530"}}, {tmdbId:"1069", properties:{bornIn:"New Haven - Connecticut - USA", imdbId:"0225191", born:date('1940-04-21'), name:"George DiCenzo", died:date('2010-08-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8L9fr5601BbUs3UzoCEELnxEKVm.jpg", url:"https://themoviedb.org/person/1069"}}, {tmdbId:"52023", properties:{bornIn:" Dallas, Texas, USA", imdbId:"0706883", born:date('1945-11-16'), name:"Steve Railsback", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qFuDoZWoqFZUk1GdqFNLGG2sK8c.jpg", url:"https://themoviedb.org/person/52023"}}, {tmdbId:"81442", properties:{imdbId:"0938114", name:"Nancy Wolfe", url:"https://themoviedb.org/person/81442"}}, {tmdbId:"12150", properties:{bornIn:"Vienna, Austria", imdbId:"0001703", born:date('1930-12-08'), name:"Maximilian Schell", bio:"Was an Austrian-born Swiss actor  who won the Academy Award for Best Actor for his role in Judgment at Nuremberg in 1961.  He is also a writer, director and producer of several films.  Description above from the Wikipedia article Maximilian Schell, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2014-02-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lNSJxVuuFJ4BHwOZ56xCg1GVikK.jpg", url:"https://themoviedb.org/person/12150"}}, {tmdbId:"2758", properties:{bornIn:" Brooklyn, New York, USA", imdbId:"0137046", born:date('1929-03-11'), name:"Timothy Carey", bio:"Wikipedia:\n\nTimothy Agoglia Carey (born March 11, 1929, Brooklyn, New York – died May 11, 1994, Los Angeles, California) was an American film and television actor. \n\nCarey wrote, produced, directed and starred in the 1962 feature The World's Greatest Sinner which was scored by Frank Zappa.  Although it did not have wide commercial release, the film has achieved cult status through repeated screenings at the \"midnight movies\" in Los Angeles in the 1960s...", died:date('1994-05-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6eJdhHSfD3G7bheZNDxWkQ0llLi.jpg", url:"https://themoviedb.org/person/2758"}}, {tmdbId:"5950", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"0001025", born:date('1935-01-22'), name:"Seymour Cassel", bio:"Seymour Joseph Cassel (January 22, 1935 – April 7, 2019) was an American actor.  He received an Academy Award nomination for Best Supporting Actor for Faces (1968). \n\nDescription above from the Wikipedia article  Seymour Cassel, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2019-04-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3xAx3mu2VxpTIgdYe9RmSpyVwjH.jpg", url:"https://themoviedb.org/person/5950"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"121481", properties:{bornIn:"New York, New York", imdbId:"0680732", born:date('1953-07-26'), name:"Robert Phillips", url:"https://themoviedb.org/person/121481"}}, {tmdbId:"28164", properties:{bornIn:"Pittsburgh, Pennsylvania, USA", imdbId:"0001301", born:date('1935-04-21'), name:"Charles Grodin", bio:"Charles Grodin (born April 21, 1935) is an American actor, comedian, author and former cable talk show host...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xEwOpsUr2pOGdyke0TZBTm1CBYX.jpg", url:"https://themoviedb.org/person/28164"}}, {tmdbId:"4431", properties:{bornIn:"Cloquet, Minnesota, USA", imdbId:"0001448", born:date('1949-04-20'), name:"Jessica Lange", bio:"Jessica Lange (born April 20, 1949 in Cloquet, Minnesota) is an American screen and stage actress.  Most recently, she debuted also as a photographer. \n\nDespite for being considered as one of the most respected actresses of her generation, she has not become part of the Hollywood mainstream scene.  In contrast to her fellow Meryl Streep, Lange has continued to work with moderate commercial success outside of the spotlight, while appearing often in independent films following the millennium...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xybRNUGzzJuilStFGmIOSy0WFwQ.jpg", url:"https://themoviedb.org/person/4431"}}, {tmdbId:"40886", properties:{imdbId:"0142535", born:date('1950-05-18'), name:"Mircha Carven", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j9eNgtlDuCsBUfTQFNdJUZKSfR4.jpg", url:"https://themoviedb.org/person/40886"}}, {tmdbId:"235940", properties:{imdbId:"0179063", name:"Paola Corazzi", url:"https://themoviedb.org/person/235940"}}, {tmdbId:"235941", properties:{imdbId:"0148609", name:"Giorgio Cerioni", url:"https://themoviedb.org/person/235941"}}, {tmdbId:"1113137", properties:{imdbId:"0537707", name:"Giovanna Mainardi", url:"https://themoviedb.org/person/1113137"}}, {tmdbId:"65284", properties:{bornIn:"Penticton, British Columbia, Canada", imdbId:"0807252", born:date('1921-06-08'), name:"Alexis Smith", bio:"​From Wikipedia, the free encyclopedia\n\nAlexis Smith (June 8, 1921 – June 9, 1993) was a Canadian-born stage, film, and television actress.  She appeared in several major Hollywood movies in the 1940s and had a notable career on Broadway in the 1970s, winning a Tony Award in 1972...", died:date('1993-06-09'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/resOg8zxAUqexZBubMunnh68efq.jpg", url:"https://themoviedb.org/person/65284"}}, {tmdbId:"125649", properties:{bornIn:" Brooklyn, New York", imdbId:"0795837", born:date('1936-11-12'), name:"Mort Shuman", bio:"Mort Shuman (12 November  1936 – 2 November 1991) was an American singer, pianist, songwriter and actor...", died:date('1991-11-03'), url:"https://themoviedb.org/person/125649"}}, {tmdbId:"12518", properties:{bornIn:"New York City, New York, United States", imdbId:"0430151", born:date('1937-07-19'), name:"Richard Jordan", bio:"From Wikipedia, the free encyclopedia. \n\nRichard Jordan (July 19, 1937 – August 30, 1993) was an American stage, screen and film actor.  A long-time member of the New York Shakespeare Festival, he performed in many Off Broadway and Broadway plays.  His films include Logan's Run, Les Misérables, Raise the Titanic!, The Friends of Eddie Coyle, The Yakuza, The Bunker, Dune, The Secret of My Success, The Hunt for Red October, Posse and Gettysburg...", died:date('1993-08-30'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xQli652ZOmkSVSUBmJFVDB0JBH2.jpg", url:"https://themoviedb.org/person/12518"}}, {tmdbId:"24368", properties:{bornIn:"Woodbury, New Jersey, USA", imdbId:"0001975", born:date('1925-05-02'), name:"Roscoe Lee Browne", bio:"From Wikipedia, the free encyclopedia\n\nRoscoe Lee Browne (May 2, 1925 – April 11, 2007) was an American actor and director, known for his rich voice and dignified bearing. \n\nDescription above from the Wikipedia article Roscoe Lee Browne, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2007-04-11'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rD6WGpgrPjHVZ76D3UY7D2HKKSF.jpg", url:"https://themoviedb.org/person/24368"}}, {tmdbId:"7487", properties:{bornIn:"Brixton, London, England, UK", imdbId:"0000309", born:date('1947-01-08'), name:"David Bowie", bio:"David Robert Jones (8 January 1947 – 10 January 2016), known professionally as David Bowie, was an English singer, songwriter and actor.  He was a figure in popular music for over five decades, regarded by critics and musicians as an innovator, particularly for his work in the 1970s.  His career was marked by reinvention and visual presentation, his music and stagecraft significantly influencing popular music...", died:date('2016-01-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7OIa363iSLG43x9Sb9HojUANwbh.jpg", url:"https://themoviedb.org/person/7487"}}, {tmdbId:"99885", properties:{bornIn:"Santa Clara - California - USA", imdbId:"0516049", born:date('1948-09-13'), name:"Kathleen Lloyd", bio:"Kathleen Lloyd (born September 13, 1948) is an American actress most noted as the leading lady in 1976's The Missouri Breaks opposite Marlon Brando and Jack Nicholson.  Lloyd made more than eighty screen appearances between 1970 and 2003, almost all in television series, including a recurring role as Assistant District Attorney Carol Baldwin on Magnum, P. I.  between 1983 and 1988...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1ltrA2vLvG6et8iRIqxuCY7pnyj.jpg", url:"https://themoviedb.org/person/99885"}}, {tmdbId:"39015", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0107281", born:date('1932-09-03'), name:"Eileen Brennan", bio:"​From Wikipedia, the free encyclopedia. \n\nEileen Brennan  (3 September 1932 - 28 July 2013) was an American actress of film, television, and theater.  Brennan is best known for her role in for her role as Doreen Lewis in Private Benjamin for which she received an Oscar nomination for Best Supporting Actress.  She reprised the role in the TV adaption and won a Golden Globe Award and an Emmy Award for her performance...", died:date('2013-07-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/26N7rnHshUpI3FFrdpwx3GcYIUQ.jpg", url:"https://themoviedb.org/person/39015"}}, {tmdbId:"1930", properties:{bornIn:"New Orleans, Louisiana, USA", imdbId:"0001986", born:date('1924-09-30'), name:"Truman Capote", bio:"From Wikipedia, the free encyclopedia. \n\nTruman Capote (September 30, 1924 – August 25, 1984) was an American author and comedian, many of whose short stories, novels, plays, and nonfiction are recognized literary classics, including the novella Breakfast at Tiffany's (1958) and true crime novel In Cold Blood (1966), which he labeled a \"nonfiction novel. \" At least 20 films and television dramas have been produced from Capote novels, stories and screenplays...", died:date('1984-08-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kmhddndt7hI38aN6NzbhPcnjKSh.jpg", url:"https://themoviedb.org/person/1930"}}, {tmdbId:"41220", properties:{bornIn:"New York City, New York, USA", imdbId:"0168394", born:date('1930-03-21'), name:"James Coco", bio:"James Coco was an American character actor...", died:date('1987-02-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sJRnrOeQfhP3r541nSTQqGKSHWx.jpg", url:"https://themoviedb.org/person/41220"}}, {tmdbId:"66223", properties:{bornIn:"Madison, Alabama, USA", imdbId:"0516800", born:date('1947-05-28'), name:"Sondra Locke", bio:"An American actress, singer and film director.  She made her film debut in The Heart Is a Lonely Hunter (1968), for which she was nominated for an Academy Award for Best Supporting Actress.  From 1976 to 1983, she appeared in six films with then partner Clint Eastwood, starting with The Outlaw Josey Wales, and ending with the fourth Dirty Harry film, Sudden Impact, where she played a serial killer seeking revenge for a past rape...", died:date('2018-11-03'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/kVSqS93rJfQ1ozmzhI5w92aWPVo.jpg", url:"https://themoviedb.org/person/66223"}}, {tmdbId:"67513", properties:{bornIn:"Brooklyn, New York, U.S.", imdbId:"0831471", born:date('1929-03-30'), name:"Shirley Stoler", bio:"​From Wikipedia, the free encyclopedia  Shirley Stoler (March 30, 1929 – February 17, 1999) was an American actress best known for her roles in The Honeymoon Killers and Lina Wertmuller's Seven Beauties.   Description above from the Wikipedia article Shirley Stoler, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1999-02-17'), url:"https://themoviedb.org/person/67513"}}, {tmdbId:"33929", properties:{bornIn:"Naples, Italy", imdbId:"0278457", born:date('1928-07-26'), name:"Elena Fiore", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cWZ2s7QKXLm9s7TOC6Vjck0VIzN.jpg", url:"https://themoviedb.org/person/33929"}}, {tmdbId:"57399", properties:{bornIn:"Wandsworth, London, England, UK", imdbId:"0001153", born:date('1954-03-17'), name:"Lesley-Anne Down", bio:"From Wikipedia, the free encyclopedia. \n\nLesley-Anne Down (born 17 March 1954) is an English actress who is best known for her roles as Georgina Worsley in the ITV drama series Upstairs, Downstairs; Olivia Blake in the NBC soap opera Sunset Beach and Madeline Fabray LaMotte Main in North and South. \n\nSince March 2003, she has portrayed Jacqueline Payne Marone in the CBS soap opera The Bold and the Beautiful...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wOVUqUYVzlXNeLnMD55EKYO9xVP.jpg", url:"https://themoviedb.org/person/57399"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"21944", properties:{bornIn:"Manchester, England, UK", imdbId:"0477297", born:date('1930-07-18'), name:"Burt Kwouk", bio:"Burt Kwouk OBE (born 18 July 1930), born Herbert Kwouk, is an English-born actor of Chinese descent, known for many television appearances and for his role as Cato in the Pink Panther films. \n\nDescription above from the Wikipedia article Burt Kwouk, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2016-05-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/30lVKb2Sg4Lwexy8UjpVmU94Ccf.jpg", url:"https://themoviedb.org/person/21944"}}, {tmdbId:"3094", properties:{bornIn:"Lake Success, New York, USA", imdbId:"0001735", born:date('1946-04-25'), name:"Talia Shire", bio:"Talia Shire (born April 25, 1946) is an American actress most known for her roles as Adrian Balboa in the Rocky series and Connie Corleone in The Godfather films. \n\nDescription above from the Wikipedia article Talia Shire, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/RkFJejmEKM80ly6fPSN7octO5c.jpg", url:"https://themoviedb.org/person/3094"}}, {tmdbId:"4521", properties:{bornIn:"New York City, New York, USA", imdbId:"0949350", born:date('1940-04-30'), name:"Burt Young", bio:"​From Wikipedia, the free encyclopedia. \n\nBurt Young (born April 30, 1940) is an American actor, painter, and author.  He is best-known for his Academy Award-nominated role as Sylvester Stallone's brother-in-law and friend Paulie in the Rocky film series...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sHe7o1ZkJV5r0WDzkm28xnsNtAu.jpg", url:"https://themoviedb.org/person/4521"}}, {tmdbId:"1101", properties:{bornIn:"New Orleans, Louisiana, USA", imdbId:"0001835", born:date('1948-01-14'), name:"Carl Weathers", bio:"An American actor, as well as former professional football player in the United States and Canada.  He is best known for playing Apollo Creed in the Rocky series of films.  He also played Dillon in the first Predator movie, Chubbs Peterson in Happy Gilmore and Little Nicky, and played a fictionalized version of himself in the television series Arrested Development...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bz1L3KmaA1ufewiZ0KK6ygIX21q.jpg", url:"https://themoviedb.org/person/1101"}}, {tmdbId:"21997", properties:{bornIn:"Bergreichenstein, Sudetenland [now Kasperské Hory, Czech Republic]", imdbId:"0704624", born:date('1941-07-20'), name:"Kurt Raab", bio:"Kurt Raab (20 July 1941 – 28 June 1988) was a West German stage and film actor, as well as a screenwriter and playwright.  Raab is best remembered for his work with German film director Rainer Werner Fassbinder, with whom he collaborated on 31 film projects...", died:date('1988-06-28'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wVtzUW8bi4Xmupsjoms369qjIKG.jpg", url:"https://themoviedb.org/person/21997"}}, {tmdbId:"36841", properties:{bornIn:"Hohenschwangau, Germany", imdbId:"0006742", born:date('1928-08-07'), name:"Helen Vita", died:date('2001-02-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vkY8Y2CvNVpz7U4Nz9wHOFdIm1n.jpg", url:"https://themoviedb.org/person/36841"}}, {tmdbId:"32422", properties:{bornIn:"Bremen, Germany", imdbId:"0818204", born:date('1939-02-16'), name:"Volker Spengler", died:date('2020-02-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3bICHmC975KOQm5ZwOzHmzJN1J5.jpg", url:"https://themoviedb.org/person/32422"}}, {tmdbId:"51812", properties:{bornIn:"Hamilton, South Lanarkshire", imdbId:"0932116", born:date('1936-09-14'), name:"Nicol Williamson", bio:"​From Wikipedia, the free encyclopedia\n\nNicol Williamson (born September 14, 1938) is a British actor who was described by English playwright John Osborne as \"the greatest actor since Marlon Brando\". \n\nDescription above from the Wikipedia article Nicol Williamson, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2011-12-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aPCIIJdQagzBTiRwrGHRZBrGjzG.jpg", url:"https://themoviedb.org/person/51812"}}, {tmdbId:"20362", properties:{bornIn:"New York City, New York, USA", imdbId:"0001049", born:date('1944-04-30'), name:"Jill Clayburgh", bio:"From Wikipedia, the free encyclopedia. \n\nJill Clayburgh (April 30, 1944 – November 5, 2010) was an American actress.  She received Academy Award nominations for her roles in An Unmarried Woman and Starting Over. \n\nDescription above from the Wikipedia article Jill Clayburgh, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2010-11-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ruTMoRcRwdAdTHXl78SQX1tpeHA.jpg", url:"https://themoviedb.org/person/20362"}}, {tmdbId:"93327", properties:{imdbId:"0186603", name:"Gemma Craven", url:"https://themoviedb.org/person/93327"}}, {tmdbId:"55688", properties:{bornIn:"Gorebridge, Midlothian, Scotland, UK", imdbId:"0188950", born:date('1934-02-12'), name:"Annette Crosbie", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1ZuyTZbVJRfJ6HxxHL0XcL9GKYo.jpg", url:"https://themoviedb.org/person/55688"}}, {tmdbId:"45465", properties:{bornIn:"London, England, UK", imdbId:"0262725", born:date('1888-02-08'), name:"Edith Evans", bio:"From Wikipedia, the free encyclopedia\n\nDame Edith Mary Evans, DBE (8 February 1888 – 14 October 1976) was a British actress.  She was known for her work on the British stage.  She also appeared in a number of films, for which she received three Academy Award nominations, plus a BAFTA and a Golden Globe award...", died:date('1976-10-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8tHthF12uzg8YPC3F8nSGxu06ty.jpg", url:"https://themoviedb.org/person/45465"}}, {tmdbId:"2048", properties:{bornIn:"Goose Creek, Texas, USA", imdbId:"0000997", born:date('1944-06-29'), name:"Gary Busey", bio:"William Gary Busey (born June 29, 1944), best known as Gary Busey, is an American film and stage actor and artist.  He has appeared in over 120 films, as well as making regular appearances on Gunsmoke, Walker, Texas Ranger, Law & Order, and Entourage.  He received an Academy Award nomination for Best Actor in 1978 for his role in The Buddy Holly Story. \n\nDescription above from the Wikipedia article Gary Busey, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fWI7fGVQ2MLXatjRUZggSolMtP8.jpg", url:"https://themoviedb.org/person/2048"}}, {tmdbId:"84915", properties:{bornIn:" Buffalo, New York", imdbId:"0164339", born:date('1939-01-04'), name:"Oliver Clark", bio:"​From Wikipedia, the free encyclopedia.   \n\nOliver Clark (born January 4, 1939) is an American character actor. \n\nClark was born Richard Mardirosian in Buffalo, New York, the son of Afro (née Karahos) and Matthew Mardirosian.  He is of Armenian heritage. [citation needed] His brother, Tom Mardirosian, is also an actor.  Clark made numerous appearances in film and television, particularly in the 1970s and 1980s.  Two of his best-known characters were John Doe#6 on the NBC drama St...", url:"https://themoviedb.org/person/84915"}}, {tmdbId:"49509", properties:{bornIn:"Munich", imdbId:"0770670", born:date('1899-09-02'), name:"Clemens Scheitz", bio:"Clemens Scheitz was born in Munich, where his father was a tailor and he had an interest in physics and was a self-taught pianist.  He earned a living through concert performances, piano lessons, small acting roles, and as an inventor.  As a young man, he appeared in a 1922 silent film directed by Adolf Wenter and starring Victor Colani, entitled \"The Prince Regatta. \" He also supplied music for the Herzog film \"Woyzeck...", died:date('1980-10-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w1fLlGu04lCY4DWzj2CdR4Q1X4Z.jpg", url:"https://themoviedb.org/person/49509"}}, {tmdbId:"27585", properties:{bornIn:"Berlin, Germany", imdbId:"0902455", born:date('1940-08-25'), name:"Wilhelm von Homburg", died:date('2004-03-10'), url:"https://themoviedb.org/person/27585"}}, {tmdbId:"1041", properties:{bornIn:"New York, New York", imdbId:"0007958", born:date('1945-05-01'), name:"Diahnne Abbott", bio:"Diahnne Abbott was born on May 1, 1945 in New York City, New York, USA.  She is an actress, known for Taxi Driver (1976), The King of Comedy (1982) and Love Streams (1984).  She was previously married to Robert De Niro...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9fHTqXGGtOxWHmo4dHSXmgN3YPY.jpg", url:"https://themoviedb.org/person/1041"}}, {tmdbId:"2561", properties:{bornIn:"Brooklyn, New York, United States", imdbId:"0034519", born:date('1934-11-05'), name:"Victor Argo", bio:"​From Wikipedia, the free encyclopedia.   \n\nVictor Argo (November 5, 1934 – April 7, 2004) was a Puerto Rican - American actor who usually played the part of a tough bad guy in his movies. \n\nDescription above from the Wikipedia article Victor Argo, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2004-04-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jECzBVSnzqUxLXSuscEpVFPxFxm.jpg", url:"https://themoviedb.org/person/2561"}}, {tmdbId:"1043", properties:{imdbId:"0034082", name:"Gino Ardito", url:"https://themoviedb.org/person/1043"}}, {tmdbId:"22384", properties:{bornIn:"Newark, New Jersey, USA", imdbId:"0025309", born:date('1939-12-27'), name:"John Amos", bio:"Early life  Amos was born John Amos, Jr.  in Newark, New Jersey, the son of Annabelle P.  and John A.  Amos, Sr. , who was an auto mechanic. [1] He graduated from East Orange (NJ) High School in 1958.  He enrolled at Long Beach City College and graduated from Colorado State University with a degree in sociology. [2] Amos also played on the Colorado State Rams football team. [3] Amos was a Golden Gloves boxing champion...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/b2zYGkMG28wYDHC9CunfYAeoeMQ.jpg", url:"https://themoviedb.org/person/22384"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"58074", properties:{bornIn:"St. Ann, Jamaica W.I.", imdbId:"0801672", born:date('1938-04-28'), name:"Madge Sinclair", bio:"From Wikipedia, the free encyclopedia. \n\nMadge Dorita Sinclair (28 April 1938 – 20 December 1995) was a Jamaican American character actress. \n\nDescription above from the Wikipedia article Madge Sinclair, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1995-12-20'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sqizCAjOUowXQXquA5lqNnhQKWy.jpg", url:"https://themoviedb.org/person/58074"}}, {tmdbId:"10409", properties:{bornIn:"Houston, Texas, USA", imdbId:"0001167", born:date('1949-07-07'), name:"Shelley Duvall", bio:"From Wikipedia, the free encyclopedia. \n\nShelley Alexis Duvall (born July 7, 1949) is an American film and television actress best known for her roles in 3 Women, Popeye, Thieves Like Us and The Shining. \n\nShe began her career in the 1970s films of Robert Altman, followed by roles in movies by Woody Allen, Stanley Kubrick, Terry Gilliam and Tim Burton.  She is also an Emmy-nominated producer, responsible for Faerie Tale Theatre and other kid-friendly programming...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qONqnWQ6RJ181STY3rYwkwXFACg.jpg", url:"https://themoviedb.org/person/10409"}}, {tmdbId:"20604", properties:{bornIn:"Norwood, Ohio, USA", imdbId:"0750023", born:date('1931-08-15'), name:"Janice Rule", bio:"Janice Rule (August 15, 1931 – October 17, 2003) was an American actress. \n\nDescription above from the Wikipedia article Janice Rule, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2003-10-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mnHpFVDiO8FSf5XMo9gBoJTtrBs.jpg", url:"https://themoviedb.org/person/20604"}}, {tmdbId:"166790", properties:{bornIn:"West Hollywood, California, USA", imdbId:"0287279", born:date('1936-11-05'), name:"Robert Fortier", bio:"Robert Fortier was a dancer, actor, boat-builder, sailor and a commercial fisherman.  A character actor and dancer with stage experience from Broadway in \"Pal Joey\" (1952) and \"Me and Juliet\" (1953).  Robert Fortier appeared in 47 feature films and TV-productions from 1950 to 1985.  He frequently worked with director Robert Altman...", died:date('2005-01-01'), url:"https://themoviedb.org/person/166790"}}, {tmdbId:"30585", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0882853", born:date('1939-11-18'), name:"Brenda Vaccaro", bio:"Brenda Buell Vaccaro (born November 18, 1939) is an American stage, television and film actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oTaUQjl7YBbXnvUR4BdQAouKMlb.jpg", url:"https://themoviedb.org/person/30585"}}, {tmdbId:"2310", properties:{bornIn:"Zürich, Switzerland", imdbId:"0004486", born:date('1941-03-22'), name:"Bruno Ganz", bio:"Bruno Ganz debuted at the theatre in 1961 and gained there a good reputation as a solid, young actor.  In 1970 he founded with 'Peter Stein' the theatre company \"Schaubuehne\" of Berlin.  His debut at the movies was early and unsuccessful in 1960.  Only in 1975 after \"Sommergaeste (1975)\" he could show his talent as a reflexive actor with tendencies towards introspection...", died:date('2019-02-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/8bhS1PObqe8OOVcyIRxV5Rcdufd.jpg", url:"https://themoviedb.org/person/2310"}}, {tmdbId:"24298", properties:{bornIn:"Paris, France", imdbId:"0086116", born:date('1930-10-23'), name:"Gérard Blain", died:date('2000-12-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pPYuPqx8NrieLkNpZhUKej5s3tx.jpg", url:"https://themoviedb.org/person/24298"}}, {tmdbId:"19131", properties:{bornIn:"St. Louis, Missouri, USA", imdbId:"0556850", born:date('1942-04-03'), name:"Marsha Mason", bio:"From Wikipedia, the free encyclopedia\n\nMarsha Mason (born April 3, 1942) is an American actress and television director. \n\nShe received four Academy Award nominations as Best Actress for her performances in Cinderella Liberty, The Goodbye Girl, Chapter Two, and Only When I Laugh.  She is also known for starring in the 1986 film Heartbreak Ridge. \n\nDescription above from the Wikipedia article Marsha Mason, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2IkzpW9eYT0m1jhssQryvmN4gS6.jpg", url:"https://themoviedb.org/person/19131"}}, {tmdbId:"182515", properties:{bornIn:"Houston, Texas, USA", born:date('1964-06-21'), name:"Susan Swift", url:"https://themoviedb.org/person/182515"}}, {tmdbId:"17183", properties:{bornIn:"Northridge, California, USA", imdbId:"0355097", born:date('1961-07-14'), name:"Jackie Earle Haley", bio:"Jackie Earle Haley (born Jack E.  Haley; July 14, 1961) is an American film actor.  Establishing himself from child actor to adult Academy Award-nominee, he is perhaps best known for his roles as Moocher in Breaking Away, Kelly Leak in The Bad News Bears, pedophile Ronnie McGorvey in Little Children, the vigilante Rorschach in Watchmen, as horror icon Freddy Krueger in the remake of A Nightmare on Elm Street, released on April 30, 2010, and most recently as Guerrero in Fox's drama Human Target...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qVPNzBEm9xF4YX1SwkXhxgsuqCt.jpg", url:"https://themoviedb.org/person/17183"}}, {tmdbId:"123898", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0047815", born:date('1962-03-15'), name:"Jimmy Baio", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/usgdRY2Wxowjj8Z4ZyaSkoqEo4M.jpg", url:"https://themoviedb.org/person/123898"}}, {tmdbId:"25282", properties:{bornIn:"Basel, Switzerland", imdbId:"0445715", born:date('1945-01-28'), name:"Marthe Keller", bio:"​From Wikipedia, the free encyclopedia.   \n\nMarthe Keller (born 28 January 1945; Basel, Switzerland) is a Swiss actress and opera director.  She studied ballet as a child, but stopped after a skiing accident at age 16.  She changed to acting, and worked in Berlin at the Schiller Theatre and the Berliner Ensemble. \n\nKeller's earliest film appearances were in Funeral in Berlin (1966, uncredited) and the German film Wilder Reiter GmbH (1967)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zRSAz0UNz5AS7B1tdizwZyodXnx.jpg", url:"https://themoviedb.org/person/25282"}}, {tmdbId:"986093", properties:{bornIn:"Beemster, Noord-Holland, Netherlands", imdbId:"0904151", born:date('1931-04-22'), name:"Siem Vroom", died:date('1986-06-06'), url:"https://themoviedb.org/person/986093"}}, {tmdbId:"1921880", properties:{name:"Marlies van Alcmaer", url:"https://themoviedb.org/person/1921880"}}, {tmdbId:"1486667", properties:{name:"Erik van 't Wout", url:"https://themoviedb.org/person/1486667"}}, {tmdbId:"14121", properties:{bornIn:"Nuremberg, Germany", imdbId:"0007234", born:date('1910-02-27'), name:"Wolfgang Preiss", bio:"From Wikipedia, the free encyclopedia. \n\nWolfgang Preiss (27 February 1910 at Nuremberg - 27 November 2002 at Baden-Baden) was a German theatre, film and television actor. \n\nThe son of a teacher, in the early 1930s Preiss studied philosophy, German and drama.  He also took private acting classes with Hans Schlenck, making his stage début in Munich in 1932.  He went to appear in various theatre productions in Heidelberg, Königsberg, Bonn, Bremen, Stuttgart and Berlin...", died:date('2002-11-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oIWvhCWDMOeyMBBwLJIzSo4L4uN.jpg", url:"https://themoviedb.org/person/14121"}}, {tmdbId:"10500", properties:{bornIn:"Neuilly-sur-Seine, France", imdbId:"0000962", born:date('1957-08-18'), name:"Carole Bouquet", bio:"From Wikipedia, the free encyclopedia. \n\nCarole Bouquet  (born 18 August 1957) is a French actress and fashion model, who has appeared in more than 40 films since 1977.  Bouquet was born in Neuilly-sur-Seine, France. \n\nShe is best known internationally for her role as the Bond girl Melina Havelock in the 1981 movie For Your Eyes Only, but she also acted in a number of mainstream European films throughout the 1980s and continues to do so in France...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nCyI95wVvhXFH1GiornFHsL9YOx.jpg", url:"https://themoviedb.org/person/10500"}}, {tmdbId:"3822", properties:{bornIn:"Madrid, Spain", imdbId:"0596807", born:date('1955-10-05'), name:"Ángela Molina", bio:"Ángela Molina (born 5 October 1955) is a Spanish actress, and a daughter of Antonio Molina, Spanish singer and actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lDgn3RDLstHXE4HI2zsKnbJsr2f.jpg", url:"https://themoviedb.org/person/3822"}}, {tmdbId:"8437", properties:{bornIn:"Lakewood, Ohio, USA", imdbId:"0000414", born:date('1944-12-11'), name:"Teri Garr", bio:"Teri Ann Garr (born December 11, 1944) is a retired American actress, dancer and singer.  She frequently appeared in comedic roles throughout her career, which spans four decades and includes over 140 credits in film and television Her accolades include one Academy Award nomination, a BAFTA Award nomination, and one National Board of Review Award. \n\nBorn in Lakewood, Ohio, Garr was raised in North Hollywood.  She is the third child of a comedic-actor father and a studio costumer mother...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mijb8YYGNcPakjWscAaz3JbmfLe.jpg", url:"https://themoviedb.org/person/8437"}}, {tmdbId:"76494", properties:{bornIn:"Chandler, Arizona, USA", imdbId:"0719294", born:date('1926-04-14'), name:"Liz Renay", died:date('2007-01-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/80PMBKp8veUZ5Hp7pxsz29RfNzb.jpg", url:"https://themoviedb.org/person/76494"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"76495", properties:{imdbId:"0523056", name:"Susan Lowe", url:"https://themoviedb.org/person/76495"}}, {tmdbId:"10373", properties:{bornIn:"San Francisco, California", imdbId:"0557298", born:date('1918-05-28'), name:"Edith Massey", bio:"From Wikipedia, the free encyclopedia. \n\nEdith Massey (May 28, 1918 – October 24, 1984) was an American actress and singer.  Massey was best known for her appearances in a series of movies by director John Waters.  Due to her work with Waters, she is considered one of the Dreamlanders, Waters' ensemble of regular cast and crew members...", died:date('1984-10-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/k697uNS3lamMNdeGhUZaroWyY33.jpg", url:"https://themoviedb.org/person/10373"}}, {tmdbId:"30613", properties:{bornIn:"San Mateo, California, USA", imdbId:"0001018", born:date('1949-08-08'), name:"Keith Carradine", bio:"From Wikipedia, the free encyclopedia\n\nKeith Ian Carradine (born August 8, 1949) is an American actor who has had success on stage, film and television.  In addition, he is a Golden Globe and Oscar winning songwriter.  As a member of the Carradine family, he is part of an acting \"dynasty\" that began with his father, John Carradine...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pFChLHGcQrw0pSseRYQofQ3FN4N.jpg", url:"https://themoviedb.org/person/30613"}}, {tmdbId:"22109", properties:{bornIn:"Bradford, Yorkshire, England, UK", imdbId:"0278752", born:date('1953-10-27'), name:"Peter Firth", bio:"​Peter Firth is a British film and television actor best known for the films Tess, Equus and The Hunt for Red October, and for playing spymaster Harry Pearce in the BBC TV series Spooks and its movie spin-off Spooks: The Greater Good...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/o7zbRKlhY8v9mhxyBvAwou7l200.jpg", url:"https://themoviedb.org/person/22109"}}, {tmdbId:"13329", properties:{bornIn:"Bangor, County Down, Northern Ireland, UK", imdbId:"0086780", born:date('1930-09-23'), name:"Colin Blakely", bio:"​From Wikipedia, the free encyclopedia. \n\nColin George Blakely  (23 September 1930 – 7 May 1987) was a Northern Irish character actor.  He was considered an actor of great range...", died:date('1987-05-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/lXm7BsoFx50zPgajpzTMBBhsvpr.jpg", url:"https://themoviedb.org/person/13329"}}, {tmdbId:"23709", properties:{bornIn:"Brigg, Lindsey, Lincolnshire, England, UK", imdbId:"0687506", born:date('1929-10-28'), name:"Joan Plowright", bio:"Joan Ann Plowright, Lady Olivier, DBE (born 28 October 1929), better known as Dame Joan Plowright, is an English actress, whose career has spanned over sixty years.  Throughout her career she has won two Golden Globe Awards and a Tony Award and has been nominated for an Academy Award, an Emmy, and two BAFTA Awards.  Joan Plowright is also one of only four actresses to have won two Golden Globes in the same year...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/un5wsOnz22Rvl82niE0LGAVxggQ.jpg", url:"https://themoviedb.org/person/23709"}}, {tmdbId:"37366", properties:{bornIn:"St. Louis, Missouri, USA", imdbId:"0000304", born:date('1959-01-22'), name:"Linda Blair", bio:"From Wikipedia, the free encyclopedia. \n\nLinda Denise Blair (born January 22, 1959) is an American actress.  Blair is best known for her role as the possessed child, Regan, in the 1973 acclaimed blockbuster The Exorcist, for which she was nominated for an Academy Award and two Golden Globes, winning one.  She reprised her role in 1977's Exorcist II: The Heretic, a controversial sequel which had a poor response with both audiences and critics...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3jswDdLDsmSAO4ZtVPwyKAp6D5d.jpg", url:"https://themoviedb.org/person/37366"}}, {tmdbId:"7071", properties:{bornIn:"Birmingham, Alabama, USA", imdbId:"0001221", born:date('1934-07-22'), name:"Louise Fletcher", bio:"​From Wikipedia, the free encyclopedia. \n\nLouise Fletcher (born July 22, 1934) is an American actress best known for her role as Nurse Ratched in One Flew over the Cuckoo's Nest for which she won the Academy Award for Best Actress and as Kai Winn Adami in Star Trek: Deep Space Nine.  She also guest starred on the science fiction television series Heroes.  She also received Emmy nominations for her guest starring roles in Picket Fences and Joan of Arcadia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hN15em5LqXqDe1QgDa6lXK9fx3z.jpg", url:"https://themoviedb.org/person/7071"}}, {tmdbId:"1726956", properties:{name:"Benjean", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eveTEv0HJU1g678BouYRyJia8m8.jpg", url:"https://themoviedb.org/person/1726956"}}, {tmdbId:"1152490", properties:{imdbId:"0890461", name:"Art Vasil", url:"https://themoviedb.org/person/1152490"}}, {tmdbId:"41230", properties:{bornIn:"Baltimore, Maryland, USA", imdbId:"0040014", born:date('1930-03-30'), name:"John Astin", bio:"Dark haired, usually mustachioed US actor with a cheeky grin who achieved pop culture status through his portrayal of the kooky patriarch \"Gomez Addams\" in the hit TV series The Addams Family (1964).   John Astin standing at a height of 5' 11\" (1. 8 m) was born March 30, 1930 (Aries), in Baltimore, MD as John Allen Astin to Allen V.  Astin and Margaret Astin with a brother Alexander Astin.  He is an American actor, voice actor and director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xczlYoJJblfyoOudcn7riLqsbXW.jpg", url:"https://themoviedb.org/person/41230"}}, {tmdbId:"12025", properties:{imdbId:"0446763", born:date('1910-01-12'), name:"Patsy Kelly", bio:"Patsy Kelly was born on January 12, 1910 in Brooklyn, New York, USA as  Bridget Sarah Veronica Rose Kelly.  She was an actress, known for Rosemary's Baby (1968), Freaky Friday (1976) and The Naked Kiss (1964).  She died on September 24, 1981 in Woodland Hills, Los Angeles, California, USA...", died:date('1981-09-24'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/db5cPvgnfhfqlv4q3YnhQxJ0cWz.jpg", url:"https://themoviedb.org/person/12025"}}, {tmdbId:"46099", properties:{bornIn:"Nichols, New York, USA", imdbId:"0697733", born:date('1913-01-26'), name:"William Prince", bio:"​From Wikipedia, the free encyclopedia.   \n\nWilliam LeRoy Prince (January 26, 1913 – October 8, 1996) was an American actor who appeared in numerous soap operas and made dozens of guest appearances on primetime series as well as playing villains in movies like The Gauntlet and Spontaneous Combustion. \n\nDescription above from the Wikipedia article William Prince, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1996-10-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/pxzpxrMHSA4C8kOGcSuERRQsyVw.jpg", url:"https://themoviedb.org/person/46099"}}, {tmdbId:"77224", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0191944", born:date('1967-08-13'), name:"Quinn Cummings", bio:"​From Wikipedia, the free encyclopedia\n\nQuinn Cummings (born August 13, 1967) is an American inventor, businesswoman, television and film actress, and author best known for her Oscar-nominated role in Neil Simon's The Goodbye Girl and her humorous memoir \"Notes From The Underwire\". \n\nDescription above from the Wikipedia article Quinn Cummings, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tA3GZAJRnzzlW5gCnmPUTk60pFB.jpg", url:"https://themoviedb.org/person/77224"}}, {tmdbId:"41243", properties:{bornIn:"Silver City, New Mexico, United States", imdbId:"0070801", born:date('1938-09-17'), name:"Paul Benedict", bio:"From Wikipedia, the free encyclopedia. \n\nPaul Benedict (September 17, 1938 – December 1, 2008) was an American actor who made numerous appearances in television and movies beginning in the 1960s.  He was known for his roles as The Number Painter on the popular PBS children's show Sesame Street, and as the quirky English neighbor \"Harry Bentley\" on the CBS sitcom The Jeffersons.  Often mistakenly credited as Charlie Bucket's school teacher (the uncredited role of Mr...", died:date('2008-12-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/3N5vbiVkSvtY0SbWhFmndt9jWTZ.jpg", url:"https://themoviedb.org/person/41243"}}, {tmdbId:"14888", properties:{bornIn:"San Antonio, Texas, U.S.A.", imdbId:"0569226", born:date('1950-07-11'), name:"Bruce McGill", bio:"From Wikipedia, the free encyclopedia\n\nBruce Travis McGill (born July 11, 1950) is an American actor who has an extensive list of credits in film and television.  He is perhaps best known for his role as Jack Dalton on the television series MacGyver and as D-Day in National Lampoon's Animal House. \n\nDescription above from the Wikipedia article Bruce McGill, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/tkGIAezUvjntJFDsOAmaan5nXfw.jpg", url:"https://themoviedb.org/person/14888"}}, {tmdbId:"66288", properties:{bornIn:"New Haven, Connecticut, USA", imdbId:"0089348", born:date('1924-03-25'), name:"Roberts Blossom", bio:"Character actor and poet...", died:date('2011-07-08'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bDeis0UZpsyzNgnpp1Wt1lC4j7d.jpg", url:"https://themoviedb.org/person/66288"}}, {tmdbId:"76411", properties:{bornIn:"Fremont, Nebraska, USA", imdbId:"0813940", born:date('1940-04-15'), name:"Julie Sommars", url:"https://themoviedb.org/person/76411"}}, {tmdbId:"26890", properties:{bornIn:"Paris - France", imdbId:"0547462", born:date('1919-09-09'), name:"Jacques Marin", bio:"Jacques Marin, né le 9 septembre 1919 à Paris et mort le 10 janvier 2001 à Cannes, inhumé au cimetière du Grand Jas (Cannes), est un acteur français. \n\n Ancien élève du Conservatoire national supérieur d'art dramatique de Paris, sa carrière cinématographique démarre vraiment en 1951 grâce à son rôle dans Jeux interdits.   Il tourne pas moins de 16 films avec son ami Jean Gabin...", died:date('2001-01-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/2f6OWfSbuAZTESq39GMrPLFEW8E.jpg", url:"https://themoviedb.org/person/26890"}}, {tmdbId:"9599", properties:{bornIn:"Des Moines, Iowa, USA", imdbId:"0001458", born:date('1926-04-30'), name:"Cloris Leachman", bio:"Cloris Leachman is an American stage, film and television actress.  She has won eight Primetime Emmy Awards - more than any other performer, one Daytime Emmy Award, and an Academy Award for Best Supporting Actress in the 1971 film The Last Picture Show...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/btosClScoBCcTjgv1ilIr9TaYvW.jpg", url:"https://themoviedb.org/person/9599"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"136913", properties:{bornIn:"New York, New York, U.S.A.", imdbId:"0588817", born:date('1942-09-16'), name:"Linda Miller", bio:"Linda Mae Miller (née Gleason) is an American film and television actress and the daughter of actor Jackie Gleason...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/t4fVj6FM8UYZNUJ5KK6OCFlVC30.jpg", url:"https://themoviedb.org/person/136913"}}, {tmdbId:"136914", properties:{bornIn:"Brooklyn, New York, USA", imdbId:"0166931", born:date('1914-11-02'), name:"Mildred Clinton", died:date('2010-12-18'), url:"https://themoviedb.org/person/136914"}}, {tmdbId:"136247", properties:{bornIn:"West Orange - New Jersey - USA", imdbId:"0791974", born:date('1957-07-07'), name:"Paula E. Sheppard", bio:"Paula E.  Sheppard was born on July 7, 1957 in West Orange, New Jersey, USA.  She is an actress, known for Liquid Sky (1982) and Alice Sweet Alice (1976)...", url:"https://themoviedb.org/person/136247"}}, {tmdbId:"136915", properties:{imdbId:"0573197", name:"Niles McMaster", url:"https://themoviedb.org/person/136915"}}, {tmdbId:"132765", properties:{bornIn:"New York City, New York, USA", born:date('1959-01-16'), name:"Kimiko Ikegami", bio:"From Wikipedia, the free encyclopedia. \n\nKimiko Ikegami (born January 16, 1959) is a Japanese actress.  Born in Manhattan, New York City, she moved to Kyoto at age 3.  Kimiko graduated from Horikoshi High School in Nakano, Tokyo and subsequently attended Tamagawa University.  She is closely related to the Bandō Mitsugorō kabuki actors: her grandfather was the eighth, her uncle the ninth (later Bandō Minosuke VII), her cousin (Bandō Yasosuke V) the tenth to take that name...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fh0niMrOdw2Stj1AybHNpydCT9T.jpg", url:"https://themoviedb.org/person/132765"}}, {tmdbId:"132769", properties:{bornIn:"Tokyo, Japan", imdbId:"0423101", born:date('1960-06-02'), name:"Miki Jinbo", url:"https://themoviedb.org/person/132769"}}, {tmdbId:"132766", properties:{bornIn:"Hatogaya, Saitama, Japan", imdbId:"0643178", born:date('1960-09-06'), name:"Kumiko Ohba", url:"https://themoviedb.org/person/132766"}}, {tmdbId:"132768", properties:{imdbId:"0559384", name:"Ai Matsubara", url:"https://themoviedb.org/person/132768"}}, {tmdbId:"8183", properties:{bornIn:"Pasadena, California, USA", imdbId:"0000599", born:date('1954-11-19'), name:"Kathleen Quinlan", bio:"Kathleen Denise Quinlan is an Americanstage and film  actress.  She made her feature film debut in Mel Stuart's \"One Is a Lonely Number\" (1972) follwed by George Lucas \"American Graffiti\" (1973) and made her definite breakthrough in \"I Never Promised You a Rose Garden\" (1977) as Deborah Blake...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/w93KLi08Mi7IQCojz7D49g9WccE.jpg", url:"https://themoviedb.org/person/8183"}}, {tmdbId:"90163", properties:{bornIn:"Little Rock, Arkansas, USA", imdbId:"0681319", born:date('1934-07-30'), name:"Ben Piazza", died:date('1991-09-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/io4ieCby2cPioQaAbnTFVniKu2D.jpg", url:"https://themoviedb.org/person/90163"}}, {tmdbId:"13327", properties:{bornIn:"Shelford, Cambridge, Cambridgeshire, England, UK", imdbId:"0202638", born:date('1928-05-23'), name:"Nigel Davenport", bio:"Nigel Davenport was an English stage, television, and screen actor...", died:date('2013-10-25'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/v7ebqfzimSOjRc1vFGgTCSP1P6a.jpg", url:"https://themoviedb.org/person/13327"}}, {tmdbId:"10938", properties:{bornIn:"Bluefields, Nicaragua", imdbId:"0000324", born:date('1945-12-31'), name:"Barbara Carrera", bio:"​From Wikipedia, the free encyclopedia.   \n\nBarbara Carrera (born Barbara Kingsbury on December 31, 1945) is a Nicaraguan-born American film and television actress as well as a former model.  She is best known for her roles as Bond girl Fatima Blush in Never Say Never Again and as Angelica Nero on the television series Dallas. \n\nDescription above from the Wikipedia article Barbara Carrera , licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bRmCQCSzTV6HQjGqGI8eS7Maxjo.jpg", url:"https://themoviedb.org/person/10938"}}, {tmdbId:"383", properties:{bornIn:"Broomhill, Sheffield, England, UK", imdbId:"0001589", born:date('1943-05-05'), name:"Michael Palin", bio:"From Wikipedia, the free encyclopedia\n\nMichael Edward Palin, CBE FRGS (born 5 May 1943) is an English comedian, actor, writer and television presenter best known for being one of the members of the comedy group Monty Python and for his travel documentaries.  Palin wrote most of his comedic material with Terry Jones.  Before Monty Python, they had worked on other shows such as The Ken Dodd Show, The Frost Report and Do Not Adjust Your Set...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7qCp6M2NxMWpUmO2t6IqHGNlBjz.jpg", url:"https://themoviedb.org/person/383"}}, {tmdbId:"40948", properties:{bornIn:"Rangoon, Burma, Indian Empire", imdbId:"0179154", born:date('1925-02-28'), name:"Harry H. Corbett", bio:"From Wikipedia, the free encyclopedia\n\nHarry H.  Corbett OBE (28 February 1925 – 21 March 1982) was an English actor. \n\nCorbett was best known for his starring role in the popular and long-running BBC Television sitcom Steptoe and Son in the 1960s and 70s.  Early in his career he was dubbed \"the English Marlon Brando\" by some sections of the British press. \n\nDescription above from the Wikipedia article Harry H.  Corbett, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1982-03-21'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/foBIa9BpKOO9WP8mp9uwwJWmNLA.jpg", url:"https://themoviedb.org/person/40948"}}, {tmdbId:"14264", properties:{bornIn:"Bedford, Bedfordshire, England, UK", imdbId:"0494452", born:date('1912-04-05'), name:"John Le Mesurier", bio:"From Wikipedia, the free encyclopedia\n\nJohn Le Mesurier (born John Elton Le Mesurier Halliley, 5 April 1912 – 15 November 1983) was a BAFTA Award-winning English actor.  He is most famous for his role as Sergeant Arthur Wilson in the popular 1970s BBC comedy Dad's Army. \n\nDescription above from the Wikipedia article John Le Mesurier, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('1983-11-15'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/g1rRFVloFMOkxaIvj8Ja1CliTkP.jpg", url:"https://themoviedb.org/person/14264"}}, {tmdbId:"94713", properties:{bornIn:"Stoke Newington, London, England, UK", imdbId:"0593803", born:date('1926-01-14'), name:"Warren Mitchell", bio:"Warren Mitchell (born Warren Misell; 14 January 1926 – 14 November 2015) was an English actor.  He was a BAFTA TV Award winner and a two-time winner of the Laurence Olivier Award.   His most fondly remembered role is that of the Johnny Speight comic creation of Alf Garnett which he played on and off from 1965 to 1992 with the sitcoms Til Death Us Do Part and In Sickness and in Health...", died:date('2015-11-14'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mMFruuo24m0A8LgVXjE6cUDrGFx.jpg", url:"https://themoviedb.org/person/94713"}}, {tmdbId:"13476", properties:{bornIn:"Sydney - Australia", imdbId:"0132752", born:date('1953-05-24'), name:"Nell Campbell", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/j1tjyn77295ep9kF9IwwDWaYpGn.jpg", url:"https://themoviedb.org/person/13476"}}, {tmdbId:"126534", properties:{bornIn:"Kings Heath, Birmingham, England, UK", imdbId:"0929679", born:date('1958-05-18'), name:"Toyah Willcox", bio:"​From Wikipedia, the free encyclopedia. \n\nToyah Ann Willcox  (born 18 May 1958 in Kings Heath, Birmingham) is an English actress and singer...", url:"https://themoviedb.org/person/126534"}}, {tmdbId:"79647", properties:{bornIn:"East Sussex, England", imdbId:"0429810", born:date('1955-06-23'), name:"Jordan", bio:"Known as Jordan, Seaford born Pamela Rooke was the Vivienne Westwood model, punk performer, band manager and actress credited with helping to create the W10 London punk aesthetic.  She made a cameo appearance in Derek Jarman's debut film Sebastiane, and played the lead role in his follow-up film Jubilee as the punk \"anti-historian\" Amyl Nitrate, after the drug Amyl Nitrite...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/f16f7LD7FQvnZt4cxBcpp0KqNdZ.jpg", url:"https://themoviedb.org/person/79647"}}, {tmdbId:"52615", properties:{imdbId:"0426973", born:date('1945-05-22'), name:"Marilyn Joi", bio:"Marilyn Joi is an American actress who appeared in a number of exploitation films during the 1970s.  She starred in several films by Al Adamson and played the henchwoman Velvet in Ilsa, Harem Keeper of the Oil Sheiks.  Her most famous role is Cleopatra Schwartz in Kentucky Fried Movie...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fa2h0WOeNAGnyyPtYKpZIhvzOJQ.jpg", url:"https://themoviedb.org/person/52615"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"55244", properties:{imdbId:"0434675", born:date('1938-01-23'), name:"Saul Kahan", died:date('2003-10-30'), url:"https://themoviedb.org/person/55244"}}, {tmdbId:"55617", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0325843", name:"Marcy Goldman", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4GdOJykQX4kqQPgVT98PvobQ6C9.jpg", url:"https://themoviedb.org/person/55617"}}, {tmdbId:"187052", properties:{bornIn:"St Helens, Lancashire, UK", imdbId:"0358850", name:"Olivia Hamnett", died:date('2001-11-02'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/cKFgiP2C8txyJTdRxGOTBAFJ1AK.jpg", url:"https://themoviedb.org/person/187052"}}, {tmdbId:"110003", properties:{imdbId:"0663737", name:"Frederick Parslow", url:"https://themoviedb.org/person/110003"}}, {tmdbId:"10437", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"0005499", born:date('1939-09-01'), name:"Lily Tomlin", bio:"Mary Jean \"Lily\" Tomlin (born September 1, 1939) is an American actress, comedian, writer and producer.  She has won multiple awards from many quarters, including Tony Awards, Emmy Awards, and a Grammy Award and has also been nominated for an Academy Award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zp2DDnaUenDDeoRJjrSCSDtYtxH.jpg", url:"https://themoviedb.org/person/10437"}}, {tmdbId:"17695", properties:{bornIn:"Revere, Massachusetts, USA", imdbId:"0534409", born:date('1922-05-18'), name:"Bill Macy", bio:"Bill Macy (born Wolf Martin Garber) was an American actor best known for portraying the long-suffering husband of the title character on the 1970s television situation comedy Maude...", died:date('2019-10-17'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gs6oJkNvogz8mr1azGiPBNY0yyw.jpg", url:"https://themoviedb.org/person/17695"}}, {tmdbId:"26660", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0453006", born:date('1922-03-31'), name:"Richard Kiley", died:date('1999-03-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1s24x1TsT8DxBKGksTeeaCmKYvU.jpg", url:"https://themoviedb.org/person/26660"}}, {tmdbId:"64871", properties:{bornIn:"Great Falls, Montana, USA", imdbId:"0524853", born:date('1908-05-25'), name:"Barbara Luddy", died:date('1979-04-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jXXbYWessv2MgXPu6fPg0B6sXDi.jpg", url:"https://themoviedb.org/person/64871"}}, {tmdbId:"90802", properties:{bornIn:"Roswell, New Mexico, USA", imdbId:"0000135", born:date('1943-12-31'), name:"John Denver", bio:"From Wikipedia, the free encyclopedia\n\nHenry John Deutschendorf Jr.  (December 31, 1943 – October 12, 1997), known professionally as John Denver, was an American singer-songwriter, record producer, actor, activist, and humanitarian, whose greatest commercial success was as a solo singer. \n\nAfter traveling and living in numerous locations while growing up in his military family, Denver began his music career with folk music groups during the late 1960s...", died:date('1997-10-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eu9H6vXW50lLm7LzJCqCWQicSDk.jpg", url:"https://themoviedb.org/person/90802"}}, {tmdbId:"27208", properties:{bornIn:"Basiliano, Udine", imdbId:"0031511", born:date('1935-08-03'), name:"Omero Antonutti", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mW2yOcIASJSSjxtJUukxYlXezNL.jpg", url:"https://themoviedb.org/person/27208"}}, {tmdbId:"73977", properties:{bornIn:"Roma", imdbId:"0545877", born:date('1948-04-01'), name:"Saverio Marconi", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7qC9dlMhknIYjxItdXbKyhZQIBe.jpg", url:"https://themoviedb.org/person/73977"}}, {tmdbId:"225392", properties:{imdbId:"0584942", born:date('1943-01-28'), name:"Marcella Michelangeli", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/CJmAdpMCTWE9i64ymDcvhet8KW.jpg", url:"https://themoviedb.org/person/225392"}}, {tmdbId:"1002713", properties:{imdbId:"0287154", name:"Fabrizio Forte", url:"https://themoviedb.org/person/1002713"}}, {tmdbId:"553509", properties:{bornIn:"Melbourne, Australia", imdbId:"0714761", born:date('1941-10-25'), name:"Helen Reddy", bio:"From Wikipedia, the free encyclopedia.   Helen Reddy (born October 25, 1941) is an Australian-American singer and actress.  In the 1970s, she enjoyed international success, especially in the United States, where she placed fifteen singles in the Top 40 of the Billboard Hot 100.  Three of those fifteen songs reached #1, including her signature hit \"I Am Woman. \"  Description above from the Wikipedia article Helen Reddy, licensed under CC-BY-SA,full list of contributors on Wikipedia...", url:"https://themoviedb.org/person/553509"}}, {tmdbId:"40945", properties:{bornIn:"Rothwell, Northamptonshire, England", imdbId:"0197715", born:date('1935-08-15'), name:"Jim Dale", bio:"​From Wikipedia, the free encyclopedia.   \n\nJim Dale, MBE (born James Smith, 15 August 1935) is an English actor, voice artist, singer and songwriter.  He is best known in the United Kingdom for his many appearances in the Carry On series of films and in the US for narrating the Harry Potter audiobook series, for which he received two Grammy Awards, and the ABC series Pushing Daisies.  In the 1970s Dale was a member of Laurence Olivier's National Theatre Company...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jY39nfl69anaIrHcCLQUyOKOccz.jpg", url:"https://themoviedb.org/person/40945"}}, {tmdbId:"30044", properties:{bornIn:"Gothenburg, Sweden", imdbId:"0004149", born:date('1941-02-13'), name:"Bo Svenson", bio:"​From Wikipedia, the free encyclopedia.   \n\nBo Svenson (born February 13, 1941) is a Swedish-born American actor, known for his roles in American genre films of the 1970s and 1980s.   In the late 1960s, Svenson had a recurring role in the hit TV series Here Come the Brides as Lumberjack Olaf \"Big Swede\" Gustavsen. \n\nSvenson appeared in the 1973 made-for-TV movie Frankenstein, in which he plays the Creature...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/x3u2yAK3nQh8adEn5f3Xdchd8q5.jpg", url:"https://themoviedb.org/person/30044"}}, {tmdbId:"91624", properties:{bornIn:"Clermont, Florida, USA", imdbId:"0393848", born:date('1950-11-29'), name:"Peter Hooten", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bPsntOAiUa6zi5gSU3MKaiLUk0I.jpg", url:"https://themoviedb.org/person/91624"}}, {tmdbId:"9811", properties:{bornIn:"Gary, Indiana, USA", imdbId:"0004365", born:date('1938-03-05'), name:"Fred Williamson", bio:"​From Wikipedia, the free encyclopedia.   \n\nFred \"The Hammer\" Williamson (born March 5, 1938) is an American actor, architect, and former professional American football defensive back who played mainly in the American Football League during the 1960s. \n\nDescription above from the Wikipedia article Fred Williamson, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/1SwLHk3ktZSBJXz3sqU18emmk9e.jpg", url:"https://themoviedb.org/person/9811"}}, {tmdbId:"91625", properties:{imdbId:"0673692", name:"Michael Pergolani", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7in8O9h0CjmSHSsEXEFScK2iDCD.jpg", url:"https://themoviedb.org/person/91625"}}, {tmdbId:"92969", properties:{bornIn:"Westport, Connecticut, USA", imdbId:"0001032", born:date('1952-04-22'), name:"Marilyn Chambers", bio:"Marylin Chambers was an American actress, known for her roles in a few erotic and classified films X from the 1970s...", died:date('2009-04-12'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ilY4leBaqMiMAhDjaOsa8GkS4I7.jpg", url:"https://themoviedb.org/person/92969"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"103870", properties:{bornIn:"Bay-de-Verde, Newfoundland, Canada", imdbId:"0601210", born:date('1946-01-01'), name:"Frank Moore", bio:"Frank Moore is a Canadian film and television actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aDonlIASBuom6Y6DPLqAxVFvtpq.jpg", url:"https://themoviedb.org/person/103870"}}, {tmdbId:"103871", properties:{imdbId:"0753447", name:"Howard Ryshpan", url:"https://themoviedb.org/person/103871"}}, {tmdbId:"64930", properties:{bornIn:"Oak Park, Illinois, USA", imdbId:"0627878", born:date('1929-09-05'), name:"Bob Newhart", bio:"From Wikipedia, the free encyclopedia\n\nGeorge Robert Newhart (born September 5, 1929), known professionally as Bob Newhart, is an American stand-up comedian and actor.  Noted for his deadpan and slightly stammering delivery, Newhart came to prominence in the 1960s when his album of comedic monologues The Button-Down Mind of Bob Newhart was a worldwide bestseller and reached #1 on the Billboard pop music charts—it remains the 20th best-selling album in history...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vAHAfHo6TMJSCIzy0AkdEIzkxgn.jpg", url:"https://themoviedb.org/person/64930"}}, {tmdbId:"8891", properties:{bornIn:"Englewood, New Jersey, USA", imdbId:"0000237", born:date('1954-02-18'), name:"John Travolta", bio:"An American actor, film producer, dancer, and singer.  He first became known in the 1970s, after appearing on the television series Welcome Back, Kotter and starring in the box office successes Saturday Night Fever and Grease.  Travolta's career re-surged in the 1990s, with his role in Pulp Fiction, and he has since continued starring in Hollywood films, including Face/Off, Ladder 49 and Wild Hogs.  Travolta has twice been nominated for the Academy Award for Best Actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/JSt3skdZpGPJYJixCZqH599WdI.jpg", url:"https://themoviedb.org/person/8891"}}, {tmdbId:"67787", properties:{bornIn:"Beverly Hills, California, Stati Uniti", imdbId:"0331186", born:date('1945-01-28'), name:"Karen Lynn Gorney", url:"https://themoviedb.org/person/67787"}}, {tmdbId:"62014", properties:{bornIn:"Los Angeles, California, USA ", imdbId:"0587944", born:date('1958-02-06'), name:"Barry Miller", bio:"From Wikipedia, the free encyclopedia. \n\nBarry L.  Miller (born February 6, 1958) is an American actor.  He won Broadway's 1985 Tony Award as Best Actor (Featured Role - Play) for his performance as 'Arnold Epstein' in Biloxi Blues. \n\nMiller was born in Los Angeles, California.  Miller's father is Sidney Miller, an actor, director, and writer, and his mother was the agent Iris Burton.  Miller's former stepmother is actress Dorothy Green...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/eLOORGPgyq6JkkOGKQlrWK3awb6.jpg", url:"https://themoviedb.org/person/62014"}}, {tmdbId:"67788", properties:{imdbId:"0129955", born:date('1950-03-30'), name:"Joseph Cali", url:"https://themoviedb.org/person/67788"}}, {tmdbId:"37916", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0694470", born:date('1953-09-13'), name:"Taryn Power", bio:"Taryn Power (September 13, 1953 - June 26, 2020) was an American actress...", died:date('2020-06-26'), url:"https://themoviedb.org/person/37916"}}, {tmdbId:"1219997", properties:{bornIn:"Bristol, England, UK", imdbId:"1338099", born:date('1933-01-01'), name:"Margaret Whiting", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/oeDcu1Zk7Q98N7r7CqAYrM4oJHr.jpg", url:"https://themoviedb.org/person/1219997"}}, {tmdbId:"6678", properties:{bornIn:"Vancouver, British Columbia, Canada", imdbId:"0648920", born:date('1946-01-24'), name:"Michael Ontkean", bio:"From Wikipedia, the free encyclopedia. \n\nMichael Leonard Ontkean (born 24 January 1946) is a Canadian actor.  He is best known for the 1970s crime drama The Rookies, the film Slap Shot (1977), and the cult-favorite TV series Twin Peaks (1990 - 1991)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mVXYWAvnjUfe5HS0WzdoX1rurMz.jpg", url:"https://themoviedb.org/person/6678"}}, {tmdbId:"35", properties:{bornIn:"Pasadena, California, USA", imdbId:"0000398", born:date('1946-11-06'), name:"Sally Field", bio:"Sally Margaret Field (born November 6, 1946) is an American actress and director.  She is the recipient of various accolades, including two Academy Awards, three Primetime Emmy Awards, two Golden Globe Awards, and a Screen Actors Guild Award, and she has been nominated for a Tony Award and two BAFTA Awards. \n\nDescription above from the Wikipedia article Sally  Field, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/36qWnokCU1VOdSyrmGbTxzGou44.jpg", url:"https://themoviedb.org/person/35"}}, {tmdbId:"67764", properties:{bornIn:" Atlanta, Georgia, USA", imdbId:"0715274", born:date('1937-03-20'), name:"Jerry Reed", bio:"​From Wikipedia, the free encyclopedia. \n\nJerry Reed Hubbard  (March 20, 1937 – September 1, 2008), known professionally as Jerry Reed, was an American country music singer, innovative guitarist, songwriter, and actor who appeared in more than a dozen films.  His signature songs included \"Guitar Man,\" \"A Thing Called Love,\" \"Alabama Wild Man,\" \"Amos Moses\", \"When You're Hot, You're Hot\" (won a Grammy Award for Best Male Country Vocal Performance), \"Ko-Ko Joe\", \"Lord, Mr...", died:date('2008-09-01'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ksdN08nDrgQs4HX3VlyhK8t5M5f.jpg", url:"https://themoviedb.org/person/67764"}}, {tmdbId:"40595", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0377947", born:date('1936-08-15'), name:"Mike Henry", bio:"Mike Henry is a former American football linebacker and film and television actor, best known for playing the main role as Tarzan in the 1960s movies Tarzan and the Valley of Gold (1966), Tarzan and the Great River (1967), and Tarzan and the Jungle Boy (1968)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ivTRuqlErfqp4tXooiRqthqEjil.jpg", url:"https://themoviedb.org/person/40595"}}, {tmdbId:"585", properties:{bornIn:"Breukelen, Utrecht, Netherlands", imdbId:"0000442", born:date('1944-01-23'), name:"Rutger Hauer", bio:"Rutger Oelsen Hauer (23 January 1944 - 19 July 2019) was a Dutch film actor.  He was well known for his roles in Flesh + Blood, Blind Fury, Blade Runner, The Hitcher, Nighthawks, Sin City, Ladyhawke, The Blood of Heroes and Batman Begins. \n\nHauer was born in Breukelen, Netherlands, to drama teachers Arend and Teunke, and grew up in Amsterdam.  Since his parents were very occupied with their careers, he and his three sisters (one older, two younger) were raised mostly by nannies...", died:date('2019-07-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aNvyDYD0YscuwMfgy15wb5gRKph.jpg", url:"https://themoviedb.org/person/585"}}, {tmdbId:"1924", properties:{bornIn:"Amsterdam, Noord-Holland, Netherlands", imdbId:"0469103", born:date('1944-12-05'), name:"Jeroen Krabbé", bio:"Jeroen Krabbé  (born December 5, 1944) is a Dutch actor and film director...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/jxZBZGqBDeKFPZ6dLRC8Pc8zynC.jpg", url:"https://themoviedb.org/person/1924"}}, {tmdbId:"9125", properties:{imdbId:"0671854", born:date('1949-07-03'), name:"Susan Penhaligon", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/78B2xiTgKZCYFnPOe2qIsQWBxv2.jpg", url:"https://themoviedb.org/person/9125"}}, {tmdbId:"32364", properties:{bornIn:"Saint-Mandé, Val-de-Marne, France", imdbId:"0187337", born:date('1929-10-06'), name:"Bruno Cremer", bio:"Bruno Jean Marie Cremer (6 October 1929 – 7 August 2010) was a French actor best known for portraying Jules Maigret on French television, from 1991 to 2005.  . . . \n\nSource: Article \"Bruno Cremer\" from Wikipedia in english, licensed under CC-BY-SA 3. 0...", died:date('2010-08-07'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/nJKNyrnUKN3WtbX4ERaShXVkBsd.jpg", url:"https://themoviedb.org/person/32364"}}, {tmdbId:"20115", properties:{bornIn:"Rabat, Morocco", imdbId:"0024849", born:date('1935-08-02'), name:"Amidou", bio:"From Wikipedia\n\nHamidou Benmessaoud (Arabic: حميدو بنمسعود‎; 2 August 1935 – 19 September 2013), best known as Amidou, was a Moroccan-French film, television and stage actor. \n\nBorn in Rabat, at 17 Amidou moved to Paris to attend the CNSAD.  In 1968 he made his debut on stage, in Jean Genet's Les paravents. \n\nAmidou is probably best known for his association with director Claude Lelouch, with whom he has shot eleven films, including the Lelouch's film debut Le propre de l'homme (1960)...", died:date('2013-09-19'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7BoS21iVv9R3WiPJWxwiUUqkqvz.jpg", url:"https://themoviedb.org/person/20115"}}, {tmdbId:"10458", properties:{bornIn:"Queens, New York USA", imdbId:"0000819", born:date('1947-08-27'), name:"Barbara Bach", bio:"Barbara Ann Goldbach was born to Howard and Marjorie Goldbach in Queens, New York.  Her father was a policeman.  Barbara is the oldest of five children.  She met her first husband Augusto Gregorini in New York while she worked as a model and he was visiting from Italy for a business trip in 1966.  Barbara followed him to Italy to be with him.  In 1968, they married.  They had two children, Francesca (b.  1969) and Gian Andrea (b.  1972)...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vatmATSQfdi1JFu6g2VImlS7GQb.jpg", url:"https://themoviedb.org/person/10458"}}, {tmdbId:"10460", properties:{bornIn:"Detroit, Michigan, USA", imdbId:"0001423", born:date('1939-09-13'), name:"Richard Kiel", bio:"Richard Dawson Kiel (born September 13, 1939) was an American actor best known for his role as the steel-toothed Jaws in the James Bond movies The Spy Who Loved Me (1977) and Moonraker (1979) as well as the video game Everything or Nothing, and Mr.  Larson in Happy Gilmore.  He was 7 feet 1. 5  inches (2. 18 m) tall in his prime but now due to injury and age, he is slightly under 7 feet tall...", died:date('2014-09-10'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/wop4KV2ywl6gdYnCUs1OthtGylM.jpg", url:"https://themoviedb.org/person/10460"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"2", properties:{bornIn:"Concord, California, USA", imdbId:"0000434", born:date('1951-09-25'), name:"Mark Hamill", bio:"Mark Richard Hamill (born September 25, 1951) is an American actor, voice artist, producer, director, and writer...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/fk8OfdReNltKZqOk2TZgkofCUFq.jpg", url:"https://themoviedb.org/person/2"}}, {tmdbId:"3", properties:{bornIn:"Chicago, Illinois, USA", imdbId:"0000148", born:date('1942-07-13'), name:"Harrison Ford", bio:"Legendary Hollywood Icon Harrison Ford was born on July 13, 1942 in Chicago, Illinois.   His family history includes a strong lineage of actors, radio personalities, and models.   Harrison attended public high school in Park Ridge, Illinois where he was a member of the school Radio Station WMTH.  Harrison worked as the lead voice for sports reporting at WMTH for several years.   Acting wasn’t a major interest to Ford until his junior year at Ripon College when he first took an acting class...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5M7oN3sznp99hWYQ9sX0xheswWX.jpg", url:"https://themoviedb.org/person/3"}}, {tmdbId:"4", properties:{bornIn:"Beverly Hills, Los Angeles, California, USA", imdbId:"0000402", born:date('1956-10-21'), name:"Carrie Fisher", bio:"Carrie Frances Fisher (21 October 1956 - 27 December 2016) was an American actress, novelist, screenwriter, and lecturer.  She is most famous for her portrayal of Princess Leia Organa in the original Star Wars trilogy, her bestselling novel Postcards from the Edge, for which she wrote the screenplay to the film of the same name, and her autobiography Wishful Drinking...", died:date('2016-12-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/rfJtncHewKVnHjqpIZvjn24ESeC.jpg", url:"https://themoviedb.org/person/4"}}, {tmdbId:"34043", properties:{bornIn:"Villa di Chiavenna, Italy", imdbId:"0143743", born:date('1948-09-04'), name:"Stefania Casini", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aSg1jmYTV4nUhm6noY6ocP6hGUT.jpg", url:"https://themoviedb.org/person/34043"}}, {tmdbId:"24608", properties:{bornIn:"Turin, Italy", imdbId:"0117885", born:date('1947-05-25'), name:"Flavio Bucci", bio:"From Wikipedia, the free encyclopedia.   Flavio Bucci (born 25 May 1947) is an Italian actor.  He has appeared in 76 films and television shows since 1971.  He is best known for playing Daniel, the blind pianist, in Dario Argento's Suspiria. \n\nDescription above from the Wikipedia article Flavio Bucci, licensed under CC-BY-SA, full list of contributors on Wikipedia...", died:date('2020-02-18'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/gXaFFXpO6gxa78a6X39t7nf3Ics.jpg", url:"https://themoviedb.org/person/24608"}}, {tmdbId:"54153", properties:{bornIn:"Aries, Panamá", imdbId:"0098395", born:date('1956-04-03'), name:"Miguel Bosé", bio:"From Wikipedia, the free encyclopedia.   Luis Miguel González Borloni (born April 3, 1956) is a Latin Grammy-winning Spanish/Italian musician and actor. \n\nDescription above from the Wikipedia article Miguel Bosé, licensed under CC-BY-SA, full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9QcXIOoOG38Hxb5FXXq7WqMRK3S.jpg", url:"https://themoviedb.org/person/54153"}}, {tmdbId:"79952", properties:{bornIn:"Riga, Latvia", imdbId:"0000864", born:date('1948-01-28'), name:"Mikhail Baryshnikov", bio:"Mikhail Nikolaevich Baryshnikov (born January 27, 1948) is a Soviet-born Russian American dancer, choreographer, and actor, often cited alongside Vaslav Nijinsky and Rudolf Nureyev as one of the greatest ballet dancers of the 20th century.  After a promising start in the Kirov Ballet in Leningrad, he defected to Canada in 1974 for more opportunities in western dance...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/phF0evzvCvJhCrj4wUXd6Pnke9g.jpg", url:"https://themoviedb.org/person/79952"}}, {tmdbId:"109010", properties:{imdbId:"0919934", name:"Jesse Welles", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/xLBN6tMXsMk6sD88hjr0JWJAxic.jpg", url:"https://themoviedb.org/person/109010"}}, {tmdbId:"2557", properties:{bornIn:"Barre, Vermont, USA", imdbId:"0739087", born:date('1943-02-08'), name:"Richard Romanus", bio:"From Wikipedia, the free encyclopedia. \n\nRichard Romanus (born February 28, 1943) is an American actor of Lebanese descent.  Among other roles, he has appeared in Martin Scorsese's Mean Streets, and provided voices for Ralph Bakshi's animated films Wizards and Hey Good Lookin'.  He played Lorraine Bracco's ex-husband, later husband again, in three episodes of The Sopranos from 1999–2002. \n\nRomanus was born in Barre, Vermont, the son of Eileen (née Maloof) and Dr.  Raymond Romanos...", url:"https://themoviedb.org/person/2557"}}, {tmdbId:"36074", properties:{bornIn:"Tokyo", imdbId:"0949097", born:date('1935-08-09'), name:"Kazuko Yoshiyuki", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/t620yx1BpERIZy3CmPFyIIXUgA3.jpg", url:"https://themoviedb.org/person/36074"}}, {tmdbId:"118989", properties:{bornIn:"Kyoto, Kyoto Prefecture, Japan", imdbId:"0848796", born:date('1928-08-31'), name:"Takahiro Tamura", died:date('2006-05-16'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aZxgF6ddzcKjfLInOJAEucFLv88.jpg", url:"https://themoviedb.org/person/118989"}}, {tmdbId:"227628", properties:{bornIn:"Changchun, Jilin, China", imdbId:"0442940", born:date('1941-07-21'), name:"Takuzô Kawatani", bio:"Japanese actor...", died:date('1995-12-22'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hqxRejlR3dc9vvLwxm9Apvvkzxs.jpg", url:"https://themoviedb.org/person/227628"}}, {tmdbId:"7520", properties:{bornIn:" Los Angeles, California, USA", imdbId:"0634282", born:date('1911-12-30'), name:"Jeanette Nolan", died:date('1998-06-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/qKldTH1vE5FYRDWmpSMqy1OSd5e.jpg", url:"https://themoviedb.org/person/7520"}}, {tmdbId:"239181", properties:{imdbId:"0639804", name:"Seamus O'Brien", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/44HJOI4aeUhvYwSPwaPtXJBzeuW.jpg", url:"https://themoviedb.org/person/239181"}}, {tmdbId:"239182", properties:{imdbId:"0470769", name:"Viju Krem", url:"https://themoviedb.org/person/239182"}}, {tmdbId:"239183", properties:{imdbId:"0268994", name:"Dan Fauci", url:"https://themoviedb.org/person/239183"}}, {tmdbId:"42157", properties:{bornIn:"Los Angeles, California, USA", imdbId:"0000893", born:date('1949-09-16'), name:"Ed Begley Jr.", bio:"​From Wikipedia, the free encyclopedia\n\nEdward James \"Ed\" Begley, Jr.  (born September 16, 1949) is an American actor and environmentalist.  Begley is perhaps best known for his role as Dr.  Mark Craig's intern, Dr.  Victor Ehrlich, on the television series St.  Elsewhere, for which he received six consecutive Emmy Award nominations.  He currently has a reality show about green living called Living With Ed on Planet Green with his wife, actress Rachelle Carson...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mmGS9QQLlTfe3aT8WERMLsIBnZU.jpg", url:"https://themoviedb.org/person/42157"}}, {tmdbId:"19403", properties:{imdbId:"0417641", born:date('1928-02-11'), name:"Conrad Janis", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/zo5bQ5FxP7XXQriKo9c0T7fVBNo.jpg", url:"https://themoviedb.org/person/19403"}}, {tmdbId:"12270", properties:{bornIn:"Brunoy, France", imdbId:"0785664", born:date('1928-01-24'), name:"Michel Serrault", died:date('2007-07-29'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/aaSFvOVwf5tQObbRfdh2mmJuFLQ.jpg", url:"https://themoviedb.org/person/12270"}}, {tmdbId:"38510", properties:{bornIn:"Paris, France, EU", imdbId:"0491275", born:date('1957-10-12'), name:"Rémi Laurent", died:date('1989-11-14'), url:"https://themoviedb.org/person/38510"}}] AS row
CREATE (n:Person{tmdbId: row.tmdbId}) SET n += row.properties SET n:Actor;
UNWIND [{tmdbId:"3392", properties:{bornIn:"New Brunswick, New Jersey, USA", imdbId:"0000140", born:date('1944-09-25'), name:"Michael Douglas", bio:"Michael Kirk Douglas (born September 25, 1944) is an American actor and producer, primarily in movies and television.  He has won three Golden Globes and two Academy Awards; first as producer of 1975's Best Picture, One Flew Over the Cuckoo's Nest, and as Best Actor in 1987 for his role in Wall Street.  Douglas received the AFI Life Achievement Award in 2009.  He is the eldest of actor Kirk Douglas's four sons.  Douglas has been the announcer for NBC Nightly News since 2007...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/4iA9QztvUnhf3YS2U0Z3lieTknc.jpg", url:"https://themoviedb.org/person/3392"}}, {tmdbId:"44845", properties:{bornIn:"Ocala, Florida, USA", imdbId:"0039051", born:date('1939-08-30'), name:"Elizabeth Ashley", bio:"From Wikipedia, the free encyclopedia.   \n\nElizabeth Ashley (born August 30, 1939) is an American actress who first came to prominence as the ingenue in the Broadway play Take Her, She's Mine, which earned her a Tony Award as Best Featured Actress in a Play...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/AtWsVmCyUd6RTgULq6OvcthSi5K.jpg", url:"https://themoviedb.org/person/44845"}}, {tmdbId:"27566", properties:{bornIn:"St. Louis, Missouri, USA", imdbId:"0587340", born:date('1948-03-23'), name:"Penelope Milford", bio:"Penelope Dale Milford (born March 23, 1948) is an American actress.  She is best known for her role as Vi Munson in Coming Home (1978), for which she was nominated for the Academy Award for Best Supporting Actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/l3kHEv4FpiKDPASb9zcAiFZFAw2.jpg", url:"https://themoviedb.org/person/27566"}}, {tmdbId:"66609", properties:{bornIn:"São Paulo, São Paulo, Brazil", imdbId:"0779963", born:date('1962-03-06'), name:"Jonathan Scott-Taylor", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/6kHpyRNqfQuhOogP1N2oTqq9gc9.jpg", url:"https://themoviedb.org/person/66609"}}, {tmdbId:"2962", properties:{bornIn:"Houston, Texas, USA", imdbId:"0289343", born:date('1941-11-01'), name:"Robert Foxworth", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/bBg01x7PFToWlMVhZBjfEbP9pOD.jpg", url:"https://themoviedb.org/person/2962"}}, {tmdbId:"15069", properties:{imdbId:"0256361", born:date('1946-01-01'), name:"David Emge", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/82TWgmmCIIdiuKXD2MoUUoFyLzI.jpg", url:"https://themoviedb.org/person/15069"}}, {tmdbId:"15070", properties:{bornIn:"Indianapolis, Indiana, USA", imdbId:"0286010", born:date('1948-02-29'), name:"Ken Foree", bio:"From Wikipedia, the free encyclopedia.   Kentotis Alvin \"Ken\" Foree (born February 29, 1948) is an American actor probably most famous as the hero Peter in Dawn of the Dead and Kenan & Kel as Roger, Kenan's dad. \n\nDescription above from the Wikipedia article Ken Foree, licensed under CC-BY-SA,full list of contributors on Wikipedia...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5u9Ou7RHx1vDe8SQFhX3Euxe2Ae.jpg", url:"https://themoviedb.org/person/15070"}}, {tmdbId:"15071", properties:{imdbId:"0718203", born:date('1948-09-05'), name:"Scott H. Reiniger", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/hoY44xf8CumZqpTsOxBwPOKpnMo.jpg", url:"https://themoviedb.org/person/15071"}}, {tmdbId:"15072", properties:{imdbId:"0743417", born:date('1950-08-15'), name:"Gaylen Ross", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/7FiaZJKgCCRNhOUrVQ39H9j7csi.jpg", url:"https://themoviedb.org/person/15072"}}, {tmdbId:"1205", properties:{bornIn:"Philadelphia, Pennsylvania, USA", imdbId:"0000152", born:date('1949-08-31'), name:"Richard Gere", bio:"Richard Tiffany Gere (born August 31, 1949) is an American actor and producer.  He began in films in the 1970s, playing a supporting role in Looking for Mr.  Goodbar (1977) and a starring role in Days of Heaven (1978).  He came to prominence with his role in the film American Gigolo (1980), which established him as a leading man and a sex symbol...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/abarbt6DRlVeAVM96uTGly2vUo8.jpg", url:"https://themoviedb.org/person/1205"}}, {tmdbId:"69054", properties:{bornIn:"New York City, New York, USA", imdbId:"0000724", born:date('1949-02-08'), name:"Brooke Adams", bio:"From Wikipedia, the free encyclopedia. \n\nBrooke Adams (born February 8, 1949) is an American actress...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/faaePkpuCz5S29jR8VGzelbYbWV.jpg", url:"https://themoviedb.org/person/69054"}}, {tmdbId:"9880", properties:{bornIn:"Fort Sheridan, Illinois, USA", imdbId:"0001731", born:date('1943-11-05'), name:"Sam Shepard", bio:"Sam Shepard (born November 5, 1943) was an American playwright, actor, and television and film director.  He is author of several books of short stories, essays, and memoirs, and received the Pulitzer Prize for Drama in 1979 for his play Buried Child.  Shepard was nominated for an Academy Award for Best Supporting Actor for his portrayal of pilot Chuck Yeager in The Right Stuff (1983)...", died:date('2017-07-27'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/mVR3Le1rSGIbQmld3Ve42RVFcyI.jpg", url:"https://themoviedb.org/person/9880"}}, {tmdbId:"3011", properties:{bornIn:"New York, New York, U.S.A.", imdbId:"0544371", born:date('1961-08-20'), name:"Linda Manz", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/9k41wTEBBg4g9JBoYF7qwmOmaOF.jpg", url:"https://themoviedb.org/person/3011"}}, {tmdbId:"15200", properties:{bornIn:"London, United Kingdom", imdbId:"0000945", born:date('1946-12-14'), name:"Jane Birkin", bio:"​From Wikipedia, the free encyclopedia\n\nJane Mallory Birkin, OBE (born 14 December 1946) is an English-born actress and singer who lives in France.  She is best known as the muse of Serge Gainsbourg who wrote several of her albums, and for her work on screen collaborating with such directors as Jacques Rivette, Agnès Varda and Jacques Doillon.  In recent years she has written her own album, directed a film and become an outspoken proponent of democracy in Burma...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/snSO3HmSdV38MVCfkVLOuXsh0C8.jpg", url:"https://themoviedb.org/person/15200"}}, {tmdbId:"47879", properties:{bornIn:"Old Bethpage, Long Island, New York, USA", imdbId:"0001698", born:date('1949-08-25'), name:"John Savage", bio:"John Savage (born John Youngs) is an American film actor, producer, production manager, and composer. \n\nSavage has appeared in more than 200 feature films, short films, recurring roles in television series and guest appearances in episodes of television series.  One of Savage's first notable roles is as Claude Bukowski in the 1979 film Hair.  His first major film role was as Steven Pushkov in the multiple Oscar-winning 1978 film The Deer Hunter...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/sVhvlTxebRJPQBwD0UYpI8IAonn.jpg", url:"https://themoviedb.org/person/47879"}}, {tmdbId:"4690", properties:{bornIn:"Queens, New York USA", imdbId:"0000686", born:date('1943-03-31'), name:"Christopher Walken", bio:"Christopher Walken (born Ronald Walken, March 31, 1943) is an American actor...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ApgDL7nudR9T2GpjCG4vESgymO2.jpg", url:"https://themoviedb.org/person/4690"}}, {tmdbId:"27396", properties:{bornIn:"Maringá, Paraná, Brazil", imdbId:"0000968", born:date('1950-06-08'), name:"Sonia Braga", bio:"Sônia Maria Campos Braga (born 8 June 1950) is a Brazilian actress.  She has been nominated for both a Golden Globe Award and an Emmy Award...", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/ibx0KwWT4ecaCeSROV4QEbP9TMf.jpg", url:"https://themoviedb.org/person/27396"}}, {tmdbId:"55836", properties:{bornIn:"Juazeiro do Norte, Ceará, Brazil", imdbId:"0929093", born:date('1945-08-20'), name:"José Wilker", died:date('2014-04-05'), poster:"https://image.tmdb.org/t/p/w440_and_h660_face/5UzQ5DnLrIoG3aolyRid2sKuNwv.jpg", url:"https://themoviedb.org/person/55836"}}, {tmdbId:"228056", properties:{bornIn:"Ubá, Minas Gerais, Brazil", imdbId:"0579202", born:date('1931-04-02'), name:"Mauro Mendonça", poster:"https://image.tmdb.org/t/p/w440_and_h660_face/vBnaG6uQ4L0krA8Ea1rd9u0UaDe.jpg", url:"https://themoviedb.org/person/228056"}}, {tmdbId:"1180406", properties:{imdbId:"0109370", name:"Dinorah Brillanti", url:"https://themoviedb.org/person/1180406"}}] AS row
